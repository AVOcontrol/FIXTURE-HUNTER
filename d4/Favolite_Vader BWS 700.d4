  <History Date="08-01-20" Author="Nic Morris" Comment="Created (poor documentation)" Version="1" />
  <History Date="10-01-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="10-01-20" Author="Nic Morris" Comment="Revised to 2-point framing system in response to manufacturer feedback." Version="3" />
  <History Date="25-02-20" Author="Nic Morris" Comment="Revised colour functions in line with latest documentation in response to manufacturer request." Version="4" />
  <History Date="27-02-20" Author="Nic Morris" Comment="Fixed colour scroll condition." Version="5" />
  <History Date="31-08-22" Author="Nic Morris" Comment="Created from Viking Lighting VK600 Edge (very poor documentation)" Version="6" />
  <History Date="02-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="7" />
  <History Date="30-01-23" Author="Nic Morris" Comment="Created from LCPRO Vader Profile (effectively identical except only 27 channel mode and just one prism.  poor documentation)" Version="8" />
  <History Date="01-02-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="9" />
  <History Date="19-09-23" Author="Nic Morris" Comment="Added 28 channel mode (based on screenshot of channels from Chamsys online library.  appears to add an animation rotation control.  no manual or other proof available that this is real.  product page says 38 channels...)" Version="10" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4738729a-f03f-4879-b977-b4e1fd0530c0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="2" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="3,4,5,6" If="'Colour1Func'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Colour" Display="'%.f%%',0~100" Dmx="0~63" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~221" Colour="0,0,0" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="222~239" Colour="0,0,0" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="6" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="240~255" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="2" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="3,4,5,6" If="'Gobo1Func'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Gobo" Display="'%.f%%',0~100" Dmx="0~71" />
      <Function ID="2" Name="Index" Display="'%.f%%',0~100" Dmx="72~143" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="144~199" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="6" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Index Index" Display="'Index Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Index Spin" Display="'Index Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Index" ID="2" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="3,4,5,6" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Gobo" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Index" Display="'%.f%%',0~100" Dmx="64~135" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="136~195" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="6" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="196~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~123" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="124~187" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1 %.f%%',0~100" Dmx="4~67" />
      <Function ID="3" Name="Program 2" Display="'Program 2 %.f%%',0~100" Dmx="68~99" />
      <Function ID="4" Name="Program 3" Display="'Program 3 %.f%%',0~100" Dmx="100~131" />
      <Function ID="5" Name="Program 4" Display="'Program 4 %.f%%',0~100" Dmx="132~175" />
      <Function ID="6" Name="Program 5" Display="'Program 5 %.f%%',0~100" Dmx="176~247" />
      <Function ID="7" Name="Random 1" Display="'Random 1'" Dmx="248~251" />
      <Function ID="8" Name="Random 2" Display="'Random 2'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Refresh Rate 1200 (dimmer auto delay)" Display="'Refresh Rate 1200 (dimmer auto delay)'" Dmx="0~0" />
      <Function ID="2" Name="(dimmer no delay)" Display="'(dimmer no delay)'" Dmx="64~127" />
      <Function ID="3" Name="Refresh Rate 300 (dimmer auto delay)" Display="'Refresh Rate 300 (dimmer auto delay)'" Dmx="128~191" />
      <Function ID="4" Name="(dimmer auto dela" Display="'(dimmer auto dela'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~123" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="124~187" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="128~0" />
      <Function ID="2" Name="Movement 1" Display="'Movement 1 %.f%%',100~0" Dmx="136~173" />
      <Function ID="3" Name="Movement 2" Display="'Movement 2 %.f%%',0~100" Dmx="174~211" />
      <Function ID="4" Name="Movement 3" Display="'Movement 3 %.f%%',0~100" Dmx="212~249" />
      <Function ID="5" Name="Closed" Display="'Closed'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~239" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="255~240" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="20~29" />
    </Attribute>
    <Attribute ID="Animation1" Name="Animation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

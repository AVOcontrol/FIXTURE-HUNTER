  <AtlaBase TypeID="209ef64c-82e1-418b-a2b1-15e0063bfe72" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~45" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~86" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="87~127" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~168" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="169~209" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="210~250" Colour="0,255,255" />
      <Function ID="8" Name="Red, Green + Blue" Display="'Red, Green + Blue'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zone_Control" Name="Zone Control" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Zones" Display="'All Zones'" Dmx="0~0" />
      <Function ID="2" Name="Zone 1" Display="'Zone 1'" Dmx="63~125" />
      <Function ID="3" Name="Zones 2" Display="'Zones 2'" Dmx="126~188" />
      <Function ID="4" Name="Zones 3" Display="'Zones 3'" Dmx="189~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~24" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="25~44" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="45~64" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="65~84" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="85~104" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="105~124" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="125~144" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="145~164" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="165~184" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="185~204" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="205~224" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="225~244" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Motor_Spd" Name="Motor Spd" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="2~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="672eb2ae-b47f-410c-93c8-3a173a20a093">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="The Puck QFX" ShortName="Puck QFX" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="21-11-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="2~8" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="9~17" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="18~25" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="26~33" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="34~42" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="43~51" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="52~58" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="59~67" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="68~76" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="77~85" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="86~94" Colour="255,255,255" />
      <Function ID="13" Name="G+B+W" Display="'G+B+W'" Dmx="95~103" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="104~110" Colour="255,255,255" />
      <Function ID="15" Name="R+G+W" Display="'R+G+W'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="121~127" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" />
      <Function ID="2" Name="Col Snap" Display="'Col Snap'" Dmx="17~95" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="96~175" />
      <Function ID="4" Name="R+W Flash" Display="'R+W Flash'" Dmx="176~195" />
      <Function ID="5" Name="G+W Flash" Display="'G+W Flash'" Dmx="196~215" />
      <Function ID="6" Name="B+W Flash" Display="'B+W Flash'" Dmx="216~235" />
      <Function ID="7" Name="W+W Flash" Display="'W+W Flash'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_FX" Name="Pixel FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~20" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="21~30" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="31~40" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="41~50" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="51~60" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="61~70" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="71~80" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="81~90" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="91~100" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="101~110" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="111~120" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="121~130" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="131~139" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="140~148" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="149~158" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="159~168" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="169~178" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="179~187" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="188~197" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="198~207" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="208~217" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="218~226" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="227~236" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="237~255" />
    </Attribute>
    <Attribute ID="Pixel_Col" Name="Pixel Col" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_Spd" Name="Pixel Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Sensitivity" Name="Sensitivity" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~127" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Program1" Name="Program" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Program" Display="'Program %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

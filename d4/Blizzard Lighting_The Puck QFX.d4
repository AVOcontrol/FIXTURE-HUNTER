  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="UKBLPFX1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red1" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White1" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Red2" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="6" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="7" Wheel="42" />
      <Attribute ID="White2" ChannelOffset="8" Wheel="39" />
      <Attribute ID="Red3" ChannelOffset="9" Wheel="70" />
      <Attribute ID="Green3" ChannelOffset="10" Wheel="71" />
      <Attribute ID="Blue3" ChannelOffset="11" Wheel="72" />
      <Attribute ID="White3" ChannelOffset="12" Wheel="69" />
      <Attribute ID="Red4" ChannelOffset="13" Wheel="100" />
      <Attribute ID="Green4" ChannelOffset="14" Wheel="101" />
      <Attribute ID="Blue4" ChannelOffset="15" Wheel="102" />
      <Attribute ID="White4" ChannelOffset="16" Wheel="99" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="White" Wheel="9" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

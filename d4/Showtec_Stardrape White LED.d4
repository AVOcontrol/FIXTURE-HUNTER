<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stardrape White LED" ShortName="StardrapeW" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="26-07-16" Author="Nic Morris" Comment="Created" />
  <History Date="31-07-16" Author="Nic Morris" Comment="Changed master dimmer to locate at zero so that the program macros work as priority." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~23" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="24~37" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="38~51" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="52~65" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="66~79" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="80~93" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="94~107" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="108~121" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="122~135" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="136~149" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="150~163" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="164~177" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="178~191" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="192~205" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="206~219" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="220~233" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Program" ChannelOffset="3" Wheel="23" />
        <Attribute ID="Program_Spd" ChannelOffset="4" Wheel="24" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="8" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade_Macro" Name="Blade Macro" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Square" Display="'Square'" Dmx="11~20" />
      <Function ID="3" Name="Rectangle" Display="'Rectangle'" Dmx="21~30" />
      <Function ID="4" Name="Isosceles Triangle" Display="'Isosceles Triangle'" Dmx="31~40" />
      <Function ID="5" Name="Trapezoidal" Display="'Trapezoidal'" Dmx="41~50" />
      <Function ID="6" Name="The Fan (Facing Up)" Display="'The Fan (Facing Up)'" Dmx="51~60" />
      <Function ID="7" Name="Parallelogram" Display="'Parallelogram'" Dmx="61~70" />
      <Function ID="8" Name="Right Angle Trapezoid" Display="'Right Angle Trapezoid'" Dmx="71~80" />
      <Function ID="9" Name="The Fan (Down)" Display="'The Fan (Down)'" Dmx="81~90" Iris="0~0" Zoom="0~0" />
      <Function ID="10" Name="Triangle" Display="'Triangle'" Dmx="91~100" Iris="0~0" Zoom="0~0" />
      <Function ID="11" Name="Prismatic" Display="'Prismatic'" Dmx="101~110" Iris="0~0" Zoom="0~0" />
      <Function ID="12" Name="The Stripes" Display="'The Stripes'" Dmx="111~120" Iris="0~0" Zoom="0~0" />
      <Function ID="13" Name="Bar" Display="'Bar'" Dmx="121~130" Iris="0~0" Zoom="0~0" />
      <Function ID="14" Name="Upper Left Quadrant" Display="'Upper Left Quadrant'" Dmx="131~140" Iris="0~0" Zoom="0~0" />
      <Function ID="15" Name="Semicircle (Up)" Display="'Semicircle (Up)'" Dmx="141~150" Iris="0~0" Zoom="0~0" />
      <Function ID="16" Name="Upper Right Quadrant" Display="'Upper Right Quadrant'" Dmx="151~160" Iris="0~0" Zoom="0~0" />
      <Function ID="17" Name="Right Semicircle" Display="'Right Semicircle'" Dmx="161~170" Iris="0~0" Zoom="0~0" />
      <Function ID="18" Name="Right Lower Quadrant" Display="'Right Lower Quadrant'" Dmx="171~180" Iris="0~0" Zoom="0~0" />
      <Function ID="19" Name="Semicircle (Down)" Display="'Semicircle (Down)'" Dmx="181~190" Iris="0~0" Zoom="0~0" />
      <Function ID="20" Name="The Lower Left Quadrant" Display="'The Lower Left Quadrant'" Dmx="191~200" Iris="0~0" Zoom="0~0" />
      <Function ID="21" Name="Left Semicircle" Display="'Left Semicircle'" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_Mac_Zoom" Name="Blade Mac Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="11~100" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="1~63" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="64~127" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
      <Function ID="5" Name="90° Swing" Display="'90° Swing %.f%%',0~100" Dmx="192~207" />
      <Function ID="6" Name="180° Swing" Display="'180° Swing %.f%%',0~100" Dmx="208~223" />
      <Function ID="7" Name="270° Swing" Display="'270° Swing %.f%%',0~100" Dmx="224~239" />
      <Function ID="8" Name="360° Swing" Display="'360° Swing %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect'" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~130" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~131" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost 1" Display="'Frost 1'" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Frost 2" Display="'Frost 2'" Dmx="101~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~159" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="169~191" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="7m" Display="'7m'" Dmx="10~19" />
      <Function ID="3" Name="10m" Display="'10m'" Dmx="20~29" />
      <Function ID="4" Name="15m" Display="'15m'" Dmx="30~39" />
      <Function ID="5" Name="20m" Display="'20m'" Dmx="40~49" />
      <Function ID="6" Name="25m" Display="'25m'" Dmx="50~59" />
      <Function ID="7" Name="30m" Display="'30m'" Dmx="60~69" />
      <Function ID="8" Name="40m" Display="'40m'" Dmx="70~79" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="50m" Display="'50m'" Dmx="80~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="180~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="120~179" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="49~10" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="89~50" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo_Macro" Name="Gobo Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
  </Control>

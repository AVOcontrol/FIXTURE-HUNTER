        <Swatch>baa82b3d-7236-4db4-9432-c2bba0929d1f</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="72~79" WheelPosition="5">
        <Swatch>7dbe8919-c445-4a49-9a6a-bb607ebb8cb8</Swatch>

      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Virtual_Strobe" Name="Virtual Strobe" Description="" Group="I">

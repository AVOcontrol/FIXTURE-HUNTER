  <Thumbnail>f4a70f17-1d99-46e0-859f-0d0fd8a45ae6</Thumbnail>
  <History Date="18-11-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="20-11-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dd06c623-3d22-40f7-9b16-1b75b334d960" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_1" Name="Auto 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_2" Name="Auto 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Line_Dimmer" Name="Line Dimmer" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Line 1" Display="'Line 1 %.f%%',0~100" Dmx="20~127" />
      <Function ID="3" Name="Line 2" Display="'Line 2 %.f%%',0~100" Dmx="128~235" />
      <Function ID="4" Name="Line 1+2" Display="'Line 1+2 %.f%%',0~100" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="46~75" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="76~105" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="106~135" Colour="0,0,255" />
      <Function ID="5" Name="Red Green" Display="'Red Green'" Dmx="136~165" Colour="0,0,0" />
      <Function ID="6" Name="Red Blue" Display="'Red Blue'" Dmx="166~195" Colour="0,0,0" />
      <Function ID="7" Name="Green Blue" Display="'Green Blue'" Dmx="196~225" Colour="0,0,0" />
      <Function ID="8" Name="Red Green Blue" Display="'Red Green Blue'" Dmx="226~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (A001), 8 DMX" Channels="8" Id="e12ce7cb-2136-4f84-9a79-096afc5ae743">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="aa1b3af6-3699-4939-b79e-9f8db7bde295" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Auto_1" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Auto_2" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="Mode 2 (d001), 14 DMX" Channels="14" Id="c1f474bc-e959-4809-a5a8-295079961eb0">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

  <Mode Name="Cell" Channels="1" Hidden="True" Id="694eb3b8-180f-4e73-9fe5-dfdedb44c7a3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

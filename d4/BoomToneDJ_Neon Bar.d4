        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Auto_1" ChannelOffset="12" Wheel="22" />
        <Attribute ID="Auto_2" ChannelOffset="13" Wheel="23" />
        <Attribute ID="Auto_Spd" ChannelOffset="14" Wheel="24" />

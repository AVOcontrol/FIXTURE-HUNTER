<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Follow Spot 100 LED" ShortName="FollowSpot" Company="Eliminator Lighting">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>eb060fe8-36dc-4a34-a4cf-6ae4bdba3506</Thumbnail>
  <History Date="28-12-18" Author="Nic Morris" Comment="Created (charts have errors)" />
  <History Date="05-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="523d7bf5-de1c-40ef-973e-a4ea8a31b3cc" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" Colour="128,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="192~223" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="224~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="EMFS100L" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="19ec2842-afaf-4654-84ed-7eb78a46df57" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:7" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:6" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:6" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:6" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="eb060fe8-36dc-4a34-a4cf-6ae4bdba3506"></Swatch>
  </swatchLibrary>
</Fixture>
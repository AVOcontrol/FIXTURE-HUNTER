  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="UKCMSTRM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Derby_Shut" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Derby_Col" ChannelOffset="2" Wheel="7" />
      <Attribute ID="White_LED" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Laser_Col" ChannelOffset="7" Wheel="8" />

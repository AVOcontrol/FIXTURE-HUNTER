    <Attribute ID="Col_Spd" Name="Col Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Derby_Shut" Name="Derby Shut" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Derby_Rot" Name="Derby Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="5~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="White_LED" Name="White LED" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Program 1" Display="'Program 1 %.f%%',0~100" Dmx="10~29" Colour="255,255,255" />
      <Function ID="3" Name="Program 2" Display="'Program 2 %.f%%',0~100" Dmx="30~49" Colour="255,255,255" />
      <Function ID="4" Name="Program 3" Display="'Program 3 %.f%%',0~100" Dmx="50~69" Colour="255,255,255" />

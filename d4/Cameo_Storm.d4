      <Function ID="6" Name="Program 5" Display="'Program 5 %.f%%',0~100" Dmx="90~109" Colour="255,255,255" />
      <Function ID="7" Name="Program 6" Display="'Program 6 %.f%%',0~100" Dmx="110~129" Colour="255,255,255" />
      <Function ID="8" Name="Program 7" Display="'Program 7 %.f%%',0~100" Dmx="130~149" Colour="255,255,255" />
      <Function ID="9" Name="Program 8" Display="'Program 8 %.f%%',0~100" Dmx="150~169" Colour="255,255,255" />
      <Function ID="10" Name="Program 9" Display="'Program 9 %.f%%',0~100" Dmx="170~189" Colour="255,255,255" />
      <Function ID="11" Name="Program 10" Display="'Program 10 %.f%%',0~100" Dmx="190~209" Colour="255,255,255" />
      <Function ID="12" Name="All On" Display="'All On'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Col" Name="Laser Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="G/R Alt" Display="'G/R Alt'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="R On/ G Flash" Display="'R On/ G Flash'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="G On/ R Flash" Display="'G On/ R Flash'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="R/G Flash" Display="'R/G Flash'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Laser Shut" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Laser Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="5~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

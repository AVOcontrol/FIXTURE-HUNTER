      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Effect" Display="'Effect %.f%%',0~100" Dmx="56~71" WheelPosition="14" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="160~166" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="167~172" WheelPosition="2" />

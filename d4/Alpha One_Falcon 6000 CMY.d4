  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Manual Fan On">
      <Set Channel="Control:8" Delay="1000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

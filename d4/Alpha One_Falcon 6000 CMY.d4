    <AtlaBase ModeID="458955f0-482d-4d05-91dc-5738383a96a5" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Elec_Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Mech_Shutter" ChannelOffset="11" Wheel="5" />

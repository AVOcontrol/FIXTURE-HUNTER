  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-11-13" Author="Peter Budd" Comment="Created" />
  <History Date="15-11-13" Author="Peter Budd" Comment="Created from the COLORDash Par Hex 12." />
  <History Date="29-01-14" Author="Nic Morris" Comment="Fixed virtual dimmer in Cell, VDim mode." />
  <History Date="29-01-14" Author="Nic Morris" Comment="Added RGBA and RGBW cell for 68 DMX mode" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="27-01-16" Author="Nic Morris" Comment="Changed dimmer to 16bit in response to customer bug report (necessary for virtual master of 16bit c-mix)." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's to 68 DMX modes." />
  <History Date="26-09-17" Author="Nic Morris" Comment="Changed name from COLORDash Hex 8 to COLORdash Batten-Hex 8" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Added vdim to 53 channel mode." />
  <History Date="28-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />

      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Saltus Step" Display="'Saltus Step'" Dmx="50~99" />
      <Function ID="3" Name="Gradual" Display="'Gradual'" Dmx="100~149" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="150~199" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="200~249" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

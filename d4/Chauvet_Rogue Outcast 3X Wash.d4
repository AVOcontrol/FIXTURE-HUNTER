<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Rogue Outcast 3X Wash" ShortName="RgOc 3X Ws" Company="Chauvet" Version="5">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>5693d639-912d-423e-b3de-9761d35dad59</Thumbnail>
  <History Date="29-10-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="04-01-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised P/T speed to locate at zero in response to customer bug report (not clear in manual)." Version="2" />
  <History Date="21-03-22" Author="Nic Morris" Comment="Changed RGBW Masters to default at zero.  Added product thumbnail." Version="3" />
  <History Date="21-03-22" Author="Nic Morris" Comment="Added more detailed ranges to colour and BG Col.  Changed CTO display range to Kelvin.  Changed gobo and auto to discreet functions." Version="3" />
  <History Date="21-03-22" Author="Nic Morris" Comment="Swapped pan/tilt reset and macros and revised auto spd function ranges in line with rev 4 charts." Version="3" />
  <History Date="29-08-23" Author="Nic Morris" Comment="Added vdim to 62 and 107 channel modes in response to customer request." Version="4" />
  <History Date="03-09-25" Author="Nic Morris" Comment="Created from Chauvet Rogue R3 Wash (CTC ranges look wrong)" Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6361e918-35da-4ea1-b795-eff587dc33c3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

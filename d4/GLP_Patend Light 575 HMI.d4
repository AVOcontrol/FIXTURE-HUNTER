      <Attribute ID="Speed1" ChannelOffset="6" Wheel="29" />
      <Attribute ID="Special" ChannelOffset="7" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Green" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:3" />
      <Palette ID="4" Name="Dark Blue" Number="4" Page="1" SetControl="Colour1:4" />
      <Palette ID="5" Name="Yellow" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Pink" Number="6" Page="1" SetControl="Colour1:6" />
      <Palette ID="7" Name="Turquoise" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="8" Name="Orange" Number="8" Page="1" SetControl="Colour1:8" />
      <Palette ID="9" Name="Cyan" Number="9" Page="1" SetControl="Colour1:9" />
      <Palette ID="10" Name="Magenta" Number="10" Page="1" SetControl="Colour1:10" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />

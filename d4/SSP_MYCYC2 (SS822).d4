<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MYCYC2 (SS822)" ShortName="MYCYC2" Company="SSP" Version="5">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="25-07-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="26-07-18" Author="Nic Morris" Comment="Fixed critical issue that was breaking the library (PIXEL.2 mode referenced UV and CyanAdditive attributes that didn't exist)" Version="2" />
  <History Date="28-07-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="22-06-19" Author="Nic Morris" Comment="Added default RDM mode ID's (note SSP and PIXEL.1 modes won't work without proper Personality ID's)." Version="4" />
  <History Date="02-03-26" Author="Nic Morris" Comment="Created from Silver Star MYCYC2 (SS822XAL) (identical, unsurprisingly)" Version="5" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="11~30" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="31~50" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="51~70" Colour="255,255,255" />
      <Function ID="5" Name="3500K" Display="'3500K'" Dmx="71~90" Colour="255,255,255" />
      <Function ID="6" Name="4000K" Display="'4000K'" Dmx="91~110" Colour="255,255,255" />
      <Function ID="7" Name="4200K" Display="'4200K'" Dmx="111~130" Colour="255,255,255" />
      <Function ID="8" Name="4500K" Display="'4500K'" Dmx="131~150" Colour="255,255,255" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="151~170" Colour="255,255,255" />
      <Function ID="10" Name="6000K" Display="'6000K'" Dmx="171~190" Colour="255,255,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="191~210" Colour="255,255,255" />
      <Function ID="12" Name="7200K" Display="'7200K'" Dmx="211~230" Colour="255,255,255" />
      <Function ID="13" Name="8000K" Display="'8000K'" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~29" />
      <Function ID="3" Name="Dim1" Display="'Dim1'" Dmx="30~69" />
      <Function ID="4" Name="Dim2" Display="'Dim2'" Dmx="70~129" />
      <Function ID="5" Name="Dim3" Display="'Dim3'" Dmx="130~189" />
      <Function ID="6" Name="Dim4" Display="'Dim4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="L106" Display="'L106'" Dmx="10~20" Colour="255,255,255" />
      <Function ID="3" Name="R05" Display="'R05'" Dmx="21~30" Colour="255,255,255" />

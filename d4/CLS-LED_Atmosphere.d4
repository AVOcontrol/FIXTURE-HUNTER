  <Mode Name="Segments+Control, 13 DMX" Channels="13">
    <Import PearlRef="CU_ATMOSALL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red1" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green1" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue1" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Red2" ChannelOffset="5" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Green2" ChannelOffset="6" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="Blue2" ChannelOffset="7" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Red3" ChannelOffset="8" Wheel="70" VirtualControl="Dimmer" />
      <Attribute ID="Green3" ChannelOffset="9" Wheel="71" VirtualControl="Dimmer" />
      <Attribute ID="Blue3" ChannelOffset="10" Wheel="72" VirtualControl="Dimmer" />
      <Attribute ID="Red4" ChannelOffset="11" Wheel="100" VirtualControl="Dimmer" />
      <Attribute ID="Green4" ChannelOffset="12" Wheel="101" VirtualControl="Dimmer" />
      <Attribute ID="Blue4" ChannelOffset="13" Wheel="102" VirtualControl="Dimmer" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="RGB cell, 3 DMX" X="1" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="RGB cell, 3 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="8" ModeLink="RGB cell, 3 DMX" X="1" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="11" ModeLink="RGB cell, 3 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Control, 1 DMX" Channels="1">
    <Import PearlRef="CU_ATMOSCTR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

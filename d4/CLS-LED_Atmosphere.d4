<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Atmosphere LED-Panel" ShortName="Atmo sphre" Company="CLS-LED">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="27-04-07" Author="D.Milligan" Comment="Created" />
  <History Date="27-04-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Fixed Attribute ID's" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Removed non-vdim modes" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Fixed power on and locate" />
  <History Date="10-09-11" Author="Nic Morris" Comment="Added palettes.  Added pixel mapper compatibility.  Added channel count to mode name." />
  <History Date="03-11-11" Author="John Rogers" Comment="Edited Cell layout of Segments+Control, 13 DMX mode." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Single" Display="'Single'" Dmx="0~60" />
      <Function ID="2" Name="Two Horiz" Display="'Two Horiz'" Dmx="61~121" />
      <Function ID="3" Name="Odd/Even" Display="'Odd/Even'" Dmx="122~182" />
      <Function ID="4" Name="Two Vert" Display="'Two Vert'" Dmx="183~243" />
      <Function ID="5" Name="Four Col" Display="'Four Col'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />

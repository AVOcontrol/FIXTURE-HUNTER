  <History Date="22-05-19" Author="Nic Morris" Comment="Created from Unknown 14x3W LED Pixel Bar Light (identical)" Version="3" />
  <History Date="23-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="03-07-19" Author="Nic Morris" Comment="Revised all modes with separate white and RGB cells." Version="5" />

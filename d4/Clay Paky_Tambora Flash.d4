      <Function ID="10" Name="Dim Curve 5" Display="'Dim Curve 5'" Dmx="56~57" />
      <Function ID="11" Name="Raw Col Gamma 1" Display="'Raw Col Gamma 1'" Dmx="58~62" />
      <Function ID="12" Name="Raw Col Gamma 1.5" Display="'Raw Col Gamma 1.5'" Dmx="63~67" />
      <Function ID="13" Name="Raw Col Gamma 2.2" Display="'Raw Col Gamma 2.2'" Dmx="68~72" />
      <Function ID="14" Name="Reverse Mapping Off" Display="'Reverse Mapping Off'" Dmx="85~86" />
      <Function ID="15" Name="Reverse Mapping On" Display="'Reverse Mapping On'" Dmx="87~88" />
      <Function ID="16" Name="CW Reverse Mapping Off" Display="'CW Reverse Mapping Off'" Dmx="89~90" />
      <Function ID="17" Name="CW Reverse Mapping On" Display="'CW Reverse Mapping On'" Dmx="91~92" />
      <Function ID="18" Name="Pixel Mapping Off" Display="'Pixel Mapping Off'" Dmx="93~97" />
      <Function ID="19" Name="Pixel Mapping On (RGB)" Display="'Pixel Mapping On (RGB)'" Dmx="98~102" />
      <Function ID="20" Name="Pixel Mapping On (RGBW)" Display="'Pixel Mapping On (RGBW)'" Dmx="103~107" />
      <Function ID="21" Name="Red Shift On" Display="'Red Shift On'" Dmx="108~112" />
      <Function ID="22" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="113~117" />
      <Function ID="23" Name="CW Engine Disable" Display="'CW Engine Disable'" Dmx="118~120" />
      <Function ID="24" Name="CW Engine Enable" Display="'CW Engine Enable'" Dmx="121~122" />
      <Function ID="25" Name="PWM 600Hz" Display="'PWM 600Hz'" Dmx="168~188" />
      <Function ID="26" Name="PWM 1200Hz" Display="'PWM 1200Hz'" Dmx="189~199" />
      <Function ID="27" Name="PWM 2000Hz" Display="'PWM 2000Hz'" Dmx="200~210" />
      <Function ID="28" Name="PWM 4000Hz" Display="'PWM 4000Hz'" Dmx="211~221" />
      <Function ID="29" Name="PWM 6000Hz" Display="'PWM 6000Hz'" Dmx="222~232" />
      <Function ID="30" Name="PWM 25000Hz" Display="'PWM 25000Hz'" Dmx="233~243" />
      <Function ID="31" Name="Display Off" Display="'Display Off'" Dmx="244~248" />
      <Function ID="32" Name="Display On" Display="'Display On'" Dmx="249~253" />
      <Function ID="33" Name="Recall Default Function" Display="'Recall Default Function'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Effect_Mode" Name="Effect Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Effect_Rot" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="6~130" Update="Effect_Rot" />
      <Function ID="3" Name="Dynamic" Display="'Dynamic'" Dmx="131~255" Update="Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" />
      <Function ID="2" Name="Effect 2" Display="'Effect 2'" Dmx="16~31" />
      <Function ID="3" Name="Effect 3" Display="'Effect 3'" Dmx="32~47" />
      <Function ID="4" Name="Effect 4" Display="'Effect 4'" Dmx="48~63" />
      <Function ID="5" Name="Effect 5" Display="'Effect 5'" Dmx="64~79" />
      <Function ID="6" Name="Effect 6" Display="'Effect 6'" Dmx="80~95" />
      <Function ID="7" Name="Effect 7" Display="'Effect 7'" Dmx="96~111" />
      <Function ID="8" Name="Effect 8" Display="'Effect 8'" Dmx="112~127" />
      <Function ID="9" Name="Effect 9" Display="'Effect 9'" Dmx="128~143" />
      <Function ID="10" Name="Effect 10" Display="'Effect 10'" Dmx="144~159" />
      <Function ID="11" Name="Effect 11" Display="'Effect 11'" Dmx="160~175" />
      <Function ID="12" Name="Effect 12" Display="'Effect 12'" Dmx="176~191" />
      <Function ID="13" Name="Effect 13" Display="'Effect 13'" Dmx="192~207" />
      <Function ID="14" Name="Effect 14" Display="'Effect 14'" Dmx="208~223" />
      <Function ID="15" Name="Effect 15" Display="'Effect 15'" Dmx="224~239" />
      <Function ID="16" Name="Effect 16" Display="'Effect 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Effect_Mode'==2" />
      <Condition Name="Speed" ID="3,4,5" If="'Effect_Mode'==3" />
      <Else ID="1" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~124" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="125~130" />
      <Function ID="5" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="131~255" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Fade" Name="Effect Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="130~6" />
      <Function ID="3" Name="Wake" Display="'Wake %.1f%%',0.0~100.0" Dmx="255~131" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Strobe_Effect" Name="Strobe Effect" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up/Down" Display="'Ramp Up/Down'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Master_Shutter" Name="Master Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
  </Control>

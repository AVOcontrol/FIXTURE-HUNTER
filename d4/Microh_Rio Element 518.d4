      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="R+B" Display="'R+B'" Dmx="10~63" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="64~127" />
      <Function ID="4" Name="G+B" Display="'G+B'" Dmx="128~191" />

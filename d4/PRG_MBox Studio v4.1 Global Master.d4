      <Set Channel="Control:34" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Rescan Media Library">
      <Set Channel="Control:35" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Mapping Output Enable">
      <Set Channel="Control:37" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Mapping Output Disable">
      <Set Channel="Control:38" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Mapping Masking Off">
      <Set Channel="Control:39" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Mapping Masking On">
      <Set Channel="Control:40" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Quit MBox Application">
      <Set Channel="Control:41" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Shutdown Computer">
      <Set Channel="Control:42" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Restart Computer">
      <Set Channel="Control:43" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Restart MBox Application">
      <Set Channel="Control:44" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Restart Daemon Application">
      <Set Channel="Control:45" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

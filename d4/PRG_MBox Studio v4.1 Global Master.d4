<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MBox Studio v4.1 Global Master" ShortName="MBoxGlobal" Company="PRG">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-04-17" Author="Nic Morris" Comment="Created" />
  <History Date="08-04-17" Author="Nic Morris" Comment="Revised Light Horiz and Vert functions to ensure correct default values." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Intensity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Control_Select" />
      <Function ID="2" Name="Output Stats HUD" Display="'Output Stats HUD'" Dmx="10~19" Update="Control_Select" />
      <Function ID="3" Name="Performance HUD" Display="'Performance HUD'" Dmx="20~29" Update="Control_Select" />
      <Function ID="4" Name="Version HUD" Display="'Version HUD'" Dmx="30~39" Update="Control_Select" />
      <Function ID="5" Name="Lt/Mstr/Shut/Key HUD" Display="'Lt/Mstr/Shut/Key HUD'" Dmx="40~49" Update="Control_Select" />
      <Function ID="6" Name="Txt HUD Lyrs 1-6" Display="'Txt HUD Lyrs 1-6'" Dmx="50~54" Update="Control_Select" />
      <Function ID="7" Name="Txt HUD Lyrs 7-12" Display="'Txt HUD Lyrs 7-12'" Dmx="55~59" Update="Control_Select" />
      <Function ID="8" Name="Lyr FX HUD Lyrs 1-6" Display="'Lyr FX HUD Lyrs 1-6'" Dmx="60~64" Update="Control_Select" />
      <Function ID="9" Name="Lyr FX HUD Lyrs 7-12" Display="'Lyr FX HUD Lyrs 7-12'" Dmx="65~69" Update="Control_Select" />
      <Function ID="10" Name="Raw Ctrl In HUD UniA" Display="'Raw Ctrl In HUD UniA'" Dmx="70~71" Update="Control_Select" />
      <Function ID="11" Name="Raw Ctrl In HUD UniB" Display="'Raw Ctrl In HUD UniB'" Dmx="72~73" Update="Control_Select" />
      <Function ID="12" Name="Raw Ctrl In HUD UniC" Display="'Raw Ctrl In HUD UniC'" Dmx="74~75" Update="Control_Select" />
      <Function ID="13" Name="SADI Stats" Display="'SADI Stats'" Dmx="76~77" Update="Control_Select" />
      <Function ID="14" Name="Shw PxMap Ctxt View" Display="'Shw PxMap Ctxt View'" Dmx="80~89" Update="Control_Select" />
      <Function ID="15" Name="Shw TC HUD Cntr" Display="'Shw TC HUD Cntr'" Dmx="110~111" Update="Control_Select" />
      <Function ID="16" Name="Shw TC HUD TR" Display="'Shw TC HUD TR'" Dmx="112~113" Update="Control_Select" />
      <Function ID="17" Name="Shw TC HUD TL" Display="'Shw TC HUD TL'" Dmx="114~115" Update="Control_Select" />
      <Function ID="18" Name="Shw TC HUD BR" Display="'Shw TC HUD BR'" Dmx="116~117" Update="Control_Select" />
      <Function ID="19" Name="Shw TC HUD BL" Display="'Shw TC HUD BL'" Dmx="118~119" Update="Control_Select" />
      <Function ID="20" Name="Run Script" Display="'Run Script'" Dmx="201~201" Update="Control_Select" />
      <Function ID="21" Name="Change PxMap File" Display="'Change PxMap File'" Dmx="202~202" Update="Control_Select" />
      <Function ID="22" Name="Cancel Keyboard HUD" Display="'Cancel Keyboard HUD'" Dmx="203~203" Update="Control_Select" />
      <Function ID="23" Name="Shw Obj Mesh" Display="'Shw Obj Mesh'" Dmx="220~220" Update="Control_Select" />
      <Function ID="24" Name="Shw Edg-Blnd Guides" Display="'Shw Edg-Blnd Guides'" Dmx="222~222" Update="Control_Select" />
      <Function ID="25" Name="Shw Single Mix" Display="'Shw Single Mix'" Dmx="224~224" Update="Control_Select" />
      <Function ID="26" Name="Shw All Mix" Display="'Shw All Mix'" Dmx="225~225" Update="Control_Select" />
      <Function ID="27" Name="Shw Output Mix Only" Display="'Shw Output Mix Only'" Dmx="226~226" Update="Control_Select" />
      <Function ID="28" Name="Shw Keystone Mesh" Display="'Shw Keystone Mesh'" Dmx="227~227" Update="Control_Select" />
      <Function ID="29" Name="File Share On" Display="'File Share On'" Dmx="230~230" Update="Control_Select" />
      <Function ID="30" Name="File Share Off" Display="'File Share Off'" Dmx="231~231" Update="Control_Select" />
      <Function ID="31" Name="Remote Mgmt On" Display="'Remote Mgmt On'" Dmx="232~232" Update="Control_Select" />
      <Function ID="32" Name="Remote Mgmt Off" Display="'Remote Mgmt Off'" Dmx="233~233" Update="Control_Select" />
      <Function ID="33" Name="Backup Mode On" Display="'Backup Mode On'" Dmx="234~234" Update="Control_Select" />
      <Function ID="34" Name="Backup Mode Off" Display="'Backup Mode Off'" Dmx="235~235" Update="Control_Select" />
      <Function ID="35" Name="Rescan Media Library" Display="'Rescan Media Library'" Dmx="240~240" Update="Control_Select" />
      <Function ID="36" Name="Audio Offset" Display="'Audio Offset'" Dmx="241~241" Update="Control_Select" />
      <Function ID="37" Name="PxMap Output Enable" Display="'PxMap Output Enable'" Dmx="244~244" Update="Control_Select" />
      <Function ID="38" Name="PxMap Output Disable" Display="'PxMap Output Disable'" Dmx="245~245" Update="Control_Select" />
      <Function ID="39" Name="PxMap Masking Off" Display="'PxMap Masking Off'" Dmx="246~246" Update="Control_Select" />
      <Function ID="40" Name="PxMap Masking On" Display="'PxMap Masking On'" Dmx="247~247" Update="Control_Select" />
      <Function ID="41" Name="Quit MBox App" Display="'Quit MBox App'" Dmx="250~250" Update="Control_Select" />
      <Function ID="42" Name="Shutdown Computer" Display="'Shutdown Computer'" Dmx="251~251" Update="Control_Select" />
      <Function ID="43" Name="Restart Computer" Display="'Restart Computer'" Dmx="252~252" Update="Control_Select" />
      <Function ID="44" Name="Restart MBox App" Display="'Restart MBox App'" Dmx="253~253" Update="Control_Select" />
      <Function ID="45" Name="Restart Daemon App" Display="'Restart Daemon App'" Dmx="254~254" Update="Control_Select" />
      <Function ID="46" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Control_Select" />
    </Attribute>
    <Attribute ID="Control_Select" Name="Control Select" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Show Object Mesh" ID="2,3" If="'Control'==23" />
      <Condition Name="Show Single Mix" ID="4" If="'Control'==25" />
      <Condition Name="Show Keystone Mesh" ID="5,6" If="'Control'==28" />
      <Condition Name="Audio Offset" ID="7,8,9,10" If="'Control'==36" />
      <Else ID="1" />
      <Function ID="1" Name="Index" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="3" Name="Layer" Display="'Layer %.f',1~24" Dmx="1~24" />
      <Function ID="4" Name="Mix Index" Display="''" Dmx="0~255" />
      <Function ID="5" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="6" Name="Output" Display="'Output %.f',1~32" Dmx="1~32" />
      <Function ID="7" Name="Default" Display="'Default'" Dmx="127~127" />
      <Function ID="8" Name="Late" Display="'Late %.1f%%',-100.0~0.0" Dmx="0~126" />
      <Function ID="9" Name="Default" Display="'Default'" Dmx="127~127" />
      <Function ID="10" Name="Ahead" Display="'Ahead %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pixel_Map_Int" Name="Pixel Map Int" Description="" Group="I" Size="0">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Master_Volume" Name="Master Volume" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Light_Int" Name="Light Int" Description="" Group="I" Size="0">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Light Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Light Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Light Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Light_Ambience" Name="Light Ambience" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Spread" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Light_Horiz" Name="Light Horiz" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Bearing -" Display="'Bearing - %.2f%%',100.00~0.00" Dmx="0~32766" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32767~32767" />
      <Function ID="3" Name="Bearing +" Display="'Bearing + %.2f%%',0.00~100.00" Dmx="32768~65535" />
    </Attribute>
    <Attribute ID="Light_Vert" Name="Light Vert" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Elevation -" Display="'Elevation - %.2f%%',100.00~0.00" Dmx="0~32766" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32767~32767" />
      <Function ID="3" Name="Elevation +" Display="'Elevation + %.2f%%',0.00~100.00" Dmx="32768~65535" />
    </Attribute>
  </Control>
  <Mode Name="50 DMX" Channels="50">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pixel_Map_Int" Wheel="5" />
        <Attribute ID="Light_Int" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Light_Ambience" Wheel="19" />
        <Attribute ID="Light_Horiz" Wheel="2" />
        <Attribute ID="Light_Vert" Wheel="3" />
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Control" ChannelOffset="2" Wheel="28" />
        <Attribute ID="Control_Select" ChannelOffset="3" Wheel="29" />
        <Attribute ID="Master_Volume" ChannelOffset="5" Wheel="25" />
      </Master>
      <Cell ID="Cell1" Name="Light 1" ChannelOffset="6" ModeLink="Light" X="0" Y="0">
        <AttributeLink SourceId="Light_Int" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Light_Ambience" TargetId="Light_Ambience" />
        <AttributeLink SourceId="Light_Horiz" TargetId="Light_Horiz" />
        <AttributeLink SourceId="Light_Vert" TargetId="Light_Vert" />
      </Cell>
      <Cell ID="Cell2" Name="Light 2" ChannelOffset="15" ModeLink="Light" X="0" Y="1">
        <AttributeLink SourceId="Light_Int" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Light_Ambience" TargetId="Light_Ambience" />
        <AttributeLink SourceId="Light_Horiz" TargetId="Light_Horiz" />
        <AttributeLink SourceId="Light_Vert" TargetId="Light_Vert" />
      </Cell>
      <Cell ID="Cell3" Name="Light 3" ChannelOffset="24" ModeLink="Light" X="0" Y="2">
        <AttributeLink SourceId="Light_Int" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Light_Ambience" TargetId="Light_Ambience" />
        <AttributeLink SourceId="Light_Horiz" TargetId="Light_Horiz" />
        <AttributeLink SourceId="Light_Vert" TargetId="Light_Vert" />
      </Cell>
      <Cell ID="Cell4" Name="Light 4" ChannelOffset="33" ModeLink="Light" X="0" Y="3">
        <AttributeLink SourceId="Light_Int" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Light_Ambience" TargetId="Light_Ambience" />
        <AttributeLink SourceId="Light_Horiz" TargetId="Light_Horiz" />
        <AttributeLink SourceId="Light_Vert" TargetId="Light_Vert" />
      </Cell>
      <Cell ID="Cell5" Name="Light 5" ChannelOffset="42" ModeLink="Light" X="0" Y="4">
        <AttributeLink SourceId="Light_Int" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Light_Ambience" TargetId="Light_Ambience" />
        <AttributeLink SourceId="Light_Horiz" TargetId="Light_Horiz" />
        <AttributeLink SourceId="Light_Vert" TargetId="Light_Vert" />
      </Cell>
      <Cell ID="Cell6" Name="Pixel Map" ChannelOffset="4" ModeLink="Pixel Map" X="0" Y="5">
        <AttributeLink SourceId="Pixel_Map_Int" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Light" Channels="9" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Light_Ambience" ChannelOffset="5" Wheel="19" />
      <Attribute ID="Light_Horiz" ChannelOffset="6,7" Wheel="2" />
      <Attribute ID="Light_Vert" ChannelOffset="8,9" Wheel="3" />
    </Include>
  </Mode>
  <Mode Name="Pixel Map" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Run Script">
      <Set Channel="Control:20" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Change Pixel Mapping File">
      <Set Channel="Control:21" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Cancel Keyboard HUD">
      <Set Channel="Control:22" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="File Sharing On">
      <Set Channel="Control:29" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="File Sharing Off">
      <Set Channel="Control:30" Delay="500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Remote Management On">
      <Set Channel="Control:31" Delay="500" />

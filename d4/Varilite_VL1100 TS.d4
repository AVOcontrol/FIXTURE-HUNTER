      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="81~87" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="165~171" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="249~255" />
      <Function ID="5" Name="Reset Colour" Display="'Reset Colour'" Dmx="100~104" />
      <Function ID="6" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="113~117" />
      <Function ID="7" Name="Reset Focus" Display="'Reset Focus'" Dmx="126~130" />
      <Function ID="8" Name="Reset Beam" Display="'Reset Beam'" Dmx="138~142" />
    </Attribute>
  </Control>

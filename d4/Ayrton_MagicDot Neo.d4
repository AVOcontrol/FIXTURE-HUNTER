      <Function ID="25" Name="Reset P/T" Display="'Reset P/T'" Dmx="91~93" />
      <Function ID="26" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="94~96" />
      <Function ID="27" Name="Tungsten Simulation 500W" Display="'Tungsten Simulation 500W'" Dmx="97~99" />
      <Function ID="28" Name="Tungsten Simulation 1000W" Display="'Tungsten Simulation 1000W'" Dmx="100~102" />
      <Function ID="29" Name="Tungsten Simulation 2500W" Display="'Tungsten Simulation 2500W'" Dmx="103~105" />
      <Function ID="30" Name="Tungsten Simulation 5000W" Display="'Tungsten Simulation 5000W'" Dmx="106~107" />
      <Function ID="31" Name="Tungsten Simulation Off" Display="'Tungsten Simulation Off'" Dmx="108~109" />
    </Attribute>
    <Attribute ID="Liquid_FX" Name="Liquid FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Liquid_FX_Spd" Name="Liquid FX Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~131" />

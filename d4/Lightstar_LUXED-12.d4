  <AtlaBase TypeID="3e871142-0309-4ef0-a3e1-9a511a1e370b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Strobe" Display="'%.f Hz',1~50" Dmx="0~50" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'Duration %.f%%',1~99" Dmx="1~99" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode(Wall)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Wall" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Mode(Rank)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rank" Display="''" Dmx="50~99" />
    </Attribute>
    <Attribute ID="Mode(Individual)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Individual" Display="''" Dmx="100~149" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Aura_Mode" Name="Aura Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer'" Dmx="0~0" />

    </Attribute>
    <Attribute ID="Mode_Spd" Name="Mode Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="50~99" />
      <Function ID="3" Name="Auto Run 1" Display="'Auto Run 1'" Dmx="100~149" />
      <Function ID="4" Name="Auto Run 2" Display="'Auto Run 2'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~250" />

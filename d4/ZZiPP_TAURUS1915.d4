    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2700~8000" Dmx="1~255" Colour="255,240,200" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="5~24" Colour="0,0,0" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="25~49" Colour="0,0,0" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="50~74" Colour="0,0,0" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="75~99" Colour="0,0,0" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="100~124" Colour="0,0,0" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="125~149" Colour="0,0,0" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="150~174" Colour="0,0,0" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="175~199" Colour="0,0,0" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="200~224" Colour="0,0,0" />

  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="16~45" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="46~75" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="76~105" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="106~135" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="136~165" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="166~195" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="196~225" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~250" />
    </Attribute>
    <Attribute ID="LED_Macro" Name="LED Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="LED_Macro_Spd" Name="LED Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~225" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="B+W" Display="'B+W'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="R+W" Display="'R+W'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="Change" Display="'Change %.f%%',0~100" Dmx="151~200" Colour="255,255,255" />
      <Function ID="17" Name="Transition" Display="'Transition %.f%%',0~100" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
  </Control>

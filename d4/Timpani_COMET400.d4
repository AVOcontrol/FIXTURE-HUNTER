<Fixture Name="COMET400" ShortName="COMET400" Company="Timpani">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>3b0d2442-8fb3-41e5-b60a-dbeab9623635</Thumbnail>
  <History Date="17-07-15" Author="Nic Morris" Comment="Created" />
  <History Date="01-08-16" Author="Nic Morris" Comment="Created from Timpani NOVA300 (documentation is a mess)" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Revised mappings in response to customer bug report in line with personalities on the Timpani site (documentation is wrong)." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added Reset Effect function to control attribute in line with Timpani personalities." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Revised macro delays to match those in the Timpani personalities." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added prism 2 functions to prism and revised prism rot functions in line with Timpani personality." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Changed frost to single range in line with Timpani personality." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Changed autofocus to reserved in standard mode in line with Timpani personality." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Revised colour and gobo functions in line with Timpani personality (completely different to documentation)." />
  <History Date="23-08-16" Author="Nic Morris" Comment="Reinstated AutoFocus in Standard mode according to orginal documentation in response to customer request." />
  <History Date="23-06-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added channel counts to mode names." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="99f048f5-d344-415f-b236-099ef25d6152" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />

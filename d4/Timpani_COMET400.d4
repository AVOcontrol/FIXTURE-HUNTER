      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="5" Name="Reset Col" Display="'Reset Col'" Dmx="150~189" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="7" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
      <Function ID="8" Name="Full Power" Display="'Full Power'" Dmx="25~29" />
      <Function ID="9" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="10" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="11" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="12" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="13" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="90~99" />
      <Function ID="14" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="100~109" />

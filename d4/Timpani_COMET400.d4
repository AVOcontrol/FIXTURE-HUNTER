      <Function ID="13" Name="CTB" Display="'CTB'" Dmx="181~185" Colour="230,230,255" />
      <Function ID="14" Name="Light Blue" Display="'Light Blue'" Dmx="186~189" Colour="0,128,255" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~129" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="190~220" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="221~225" Colour="255,255,255" />

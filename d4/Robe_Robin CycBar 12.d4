  <Macro>
    <Macro Name="RGBW Mode">
      <Set Channel="Control:2,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="CMY Mode">
      <Set Channel="Control:3,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Col Cal ON">
      <Set Channel="Control:4,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Col Cal OFF">
      <Set Channel="Control:5,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control:6,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Dim Square">
      <Set Channel="Control:7,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="W Count ON">
      <Set Channel="Control:8,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="W Count OFF">
      <Set Channel="Control:9,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:10,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">

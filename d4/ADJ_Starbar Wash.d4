    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="10~109" Update="Shutter" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="110~209" Update="Shutter" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="210~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4" />
      <Condition Name="Speed" ID="5" If="'Program'==2||'Program'==3" />
      <Condition Name="Sound" ID="6,7" If="'Program'==4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~109" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="210~255" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="110~209" />
      <Function ID="5" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="7" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">

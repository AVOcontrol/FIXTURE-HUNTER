<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Rayzor 760" ShortName="Rayzor 760" Company="Elation" Version="10">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>70f789c2-afc3-4886-a600-f8276e111b53</Thumbnail>
  <History Date="03-04-19" Author="Nic Morris" Comment="Created (limited information. missing CTC and FX tables. guessed pixel layout. note number of modes, mode names and channel counts in 'Elation Rayzor760 DMX Layout Rev4' chart provided currently do not correlate with Capture)" Version="1" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Revised zoom and added enable/reset zoom limit control functions and macros in line with 'Elation Rayzor760 DMX-traits V3' document." Version="2" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Revised pixel layout in line with 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="3" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Added colour function names in line with v1.1.1F charts from 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="4" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Added FX functions in line with v1.1.1F charts from 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="5" />
  <History Date="01-05-19" Author="Nic Morris" Comment="Added Atlabase mode ID's to Standard, RGB Pixels and Extended modes (V4).  Multi-part not currently supported.  SparkLED not in latest charts (the documentation is a nightmare)" Version="6" />
  <History Date="30-05-21" Author="Nic Morris" Comment="Updated in line with latest charts." Version="7" />
  <History Date="22-09-21" Author="Nic Morris" Comment="Added missing CTC link in Standard, 25 DMX mode." Version="8" />
  <History Date="25-10-25" Author="Nic Morris" Comment="Moved everything except dimmer from cell to master in Standard mode to solve problem with inverts not applying from master." Version="9" />
  <History Date="15-04-26" Author="Nic Morris" Comment="Added physical pan/tilt ranges." Version="10" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="223bf904-6ae5-4021-8c19-5f0ff3c6ff47" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC C-Mix" Display="'%.fK',2000~10000" Dmx="11~171" Colour="255,240,200" />
      <Function ID="3" Name="10000K" Display="'10000K'" Dmx="172~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>

    </Attribute>
    <Attribute ID="Depict" Name="Depict" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Depict Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Distortion" Name="Distortion" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Horiz Waves" Display="'Horiz Waves %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Vert Waves" Display="'Vert Waves %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Expert, 18 DMX" Channels="18">

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="11~35" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="36~60" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="61~85" Colour="255,255,255" />
      <Function ID="5" Name="3400K" Display="'3400K'" Dmx="86~110" Colour="255,255,255" />
      <Function ID="6" Name="3600K" Display="'3600K'" Dmx="111~135" Colour="255,255,255" />
      <Function ID="7" Name="3800K" Display="'3800K'" Dmx="136~160" Colour="255,255,255" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="161~185" Colour="255,255,255" />
      <Function ID="9" Name="4200K" Display="'4200K'" Dmx="186~210" Colour="255,255,255" />
      <Function ID="10" Name="All LED" Display="'All LED'" Dmx="211~235" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
  </Control>

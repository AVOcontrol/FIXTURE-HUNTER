      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />

  <History Date="11-04-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="21-04-23" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request (adds CMix Ctrl Zone control)" Version="1" />
  <History Date="11-12-23" Author="Nic Morris" Comment="Added product thumbnail.  Removed mode 3 in line with release charts (v1.3)" Version="2" />
  <History Date="13-03-24" Author="Nic Morris" Comment="Revised implementation so that the master controls used reserved ID's in response to manufacturer request/ feedback.  This has the compromise of no virtual dimmer on the cells.  Added multi-part patch options as an alternative that do." Version="4" />
  <History Date="13-03-24" Author="Nic Morris" Comment="Added Atlabase ID's" Version="4" />
  <History Date="13-03-24" Author="Nic Morris" Comment="Removed mode 1 Atlabase ID as it is simulating as CMY" Version="5" />
  <History Date="15-03-24" Author="Nic Morris" Comment="Added RGB Atlabase ID for mode 1." Version="6" />
  <History Date="27-09-24" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (removes KlingNet control functions/macros and adds user colour functions to virtual colour)" Version="7" />
  <History Date="07-09-25" Author="Nic Morris" Comment="Added CMY mode." Version="8" />
  <History Date="14-11-25" Author="Nic Morris" Comment="Changed amber and lime to default at full." Version="9" />
  <History Date="19-11-25" Author="Nic Morris" Comment="Updated in line with v1.9 charts in response to manufacturer request." Version="10" />
  <Manual Filename="" Summary="" />

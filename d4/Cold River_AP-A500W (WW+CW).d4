  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ae99684c-7ee4-4111-ae2b-224409f604ed" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump 1" Display="'Jump 1'" Dmx="6~20" />
      <Function ID="3" Name="Jump 2" Display="'Jump 2'" Dmx="21~35" />
      <Function ID="4" Name="Jump 3" Display="'Jump 3'" Dmx="36~50" />
      <Function ID="5" Name="Jump 4" Display="'Jump 4'" Dmx="51~65" />
      <Function ID="6" Name="Jump 5" Display="'Jump 5'" Dmx="66~80" />
      <Function ID="7" Name="Jump 6" Display="'Jump 6'" Dmx="81~95" />
      <Function ID="8" Name="Jump 7" Display="'Jump 7'" Dmx="96~110" />
      <Function ID="9" Name="Jump 8" Display="'Jump 8'" Dmx="111~125" />
      <Function ID="10" Name="Jump 9" Display="'Jump 9'" Dmx="126~140" />
      <Function ID="11" Name="Jump 10" Display="'Jump 10'" Dmx="141~155" />
      <Function ID="12" Name="Jump 11" Display="'Jump 11'" Dmx="156~170" />
      <Function ID="13" Name="Jump 12" Display="'Jump 12'" Dmx="171~185" />
      <Function ID="14" Name="Jump 13" Display="'Jump 13'" Dmx="186~200" />
      <Function ID="15" Name="Fade" Display="'Fade'" Dmx="201~210" />
      <Function ID="16" Name="Pulse" Display="'Pulse'" Dmx="211~240" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

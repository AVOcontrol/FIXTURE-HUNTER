  <AtlaBase TypeID="e6512fe6-9067-4837-a265-0ccf9fb33f44" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO Mix" Display="'%.fK',2700~20000" Dmx="255~1" Colour="255,240,200" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourMacros" Name="Colour Macros" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="1~2" Colour="0,0,0" />
      <Function ID="3" Name="White 2700K Halogen Mode" Display="'White 2700K Halogen Mode'" Dmx="3~3" Colour="0,0,0" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="4~5" Colour="0,0,0" />
      <Function ID="5" Name="White 3200K Halogen Mode" Display="'White 3200K Halogen Mode'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="7~9" Colour="0,0,0" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="10~12" Colour="0,0,0" />
      <Function ID="8" Name="White 8000K" Display="'White 8000K'" Dmx="13~15" Colour="0,0,0" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="10" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="17~55" Colour="0,0,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />
      <Function ID="12" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="57~95" Colour="0,128,255" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="14" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="97~134" Colour="0,255,0" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="255,255,0" />
      <Function ID="16" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="136~174" Colour="255,255,0" />
      <Function ID="17" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="18" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="176~214" Colour="255,0,0" />
      <Function ID="19" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="20" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="216~246" Colour="255,0,255" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="247~247" Colour="0,0,255" />
      <Function ID="22" Name="Rainbow Fade" Display="'Rainbow Fade'" Dmx="248~248" Colour="0,0,0" />
      <Function ID="23" Name="Rainbow Effect" Display="'Rainbow Effect'" Dmx="249~249" Colour="0,0,0" />
      <Function ID="24" Name="Zone Effect" Display="'Zone Effect %.f',1~6" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Z3 Strobe %" Display="'Zone 3 Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="6" Name="Zone FX Fwd" Display="'Zone FX Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="7" Name="Zone FX Rev" Display="'Zone FX Rev %.f%%',0~100" Dmx="127~112" Intensity="0~0" />
      <Function ID="8" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="159~144" Intensity="0~0" />
      <Function ID="10" Name="Rnd Zn" Display="'Rnd Zn %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="11" Name="Rnd Zn Strb" Display="'Rnd Zn Strb %.f%%',0~100" Dmx="191~176" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">

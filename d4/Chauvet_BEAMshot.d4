      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="171~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />

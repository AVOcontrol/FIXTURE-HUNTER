    <Attribute ID="Playmode" Name="Playmode" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Play List" Display="'Play List'" Dmx="0~0" />
      <Function ID="2" Name="Loop" Display="'Loop'" Dmx="1~1" />

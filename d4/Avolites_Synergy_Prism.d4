<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Synergy Prism" ShortName="Prism" Company="Avolites" Version="23">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="09-02-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="07-05-21" Author="Lawrence Gow" Comment="Synergy-fied the personality. Mode is now hidden, renamed model to 'Synergy Prism One'" Version="3" />
  <History Date="03-06-21" Author="Lawrence Gow" Comment="Added File as an update attribute to all Folder functions." Version="5" />
  <History Date="20-07-21" Author="Lawrence Gow" Comment="Renamed from 'Prism One' to 'Prism'" Version="8" />
  <History Date="23-10-21" Author="Nic Morris" Comment="Added stop and pause playmode functions." Version="10" />
  <History Date="17-01-22" Author="Nic Morris" Comment="Renamed Brightness to Dimmer." Version="12" />
  <History Date="18-01-22" Author="Nic Morris" Comment="Updated play mode functions to latest spec." Version="13" />
  <History Date="31-08-22" Author="Nic Morris" Comment="Updated in line with latest spec (adds mute and retrigger controls)." Version="14" />
  <History Date="09-09-22" Author="Nic Morris" Comment="Temporarily removed mute and retrigger controls and reverted mode name in an attempt to fix compatibility." Version="15" />
  <History Date="30-09-22" Author="Nic Morris" Comment="Reinstated mute and retrigger controls and reverted mode name to 32 DMX for compatibility." Version="16" />
  <History Date="06-01-23" Author="Nic Morris" Comment="Changed Playmode to default at Loop." Version="17" />
  <History Date="05-04-24" Author="Nic Morris" Comment="Renamed In Frame and Out Frame to Trim In and Trim Out respectively." Version="18" />
  <History Date="21-02-25" Author="Nic Morris" Comment="Updated in line with latest charts (adds xFade Duration through Blend Amount)." Version="19" />
  <History Date="19-01-26" Author="Nic Morris" Comment="Updated in line with v2.1 charts (adds Clear control and Timecode play mode)." Version="21" />
  <History Date="30-06-26" Author="Nic Morris" Comment="Updated in line with v2.2 charts (adds effect controls - function ranges will be populated dynamically via Synergy.  adjusted wheel allocations to accommodate)" Version="22" />
  <Manual Filename="" Summary="" />

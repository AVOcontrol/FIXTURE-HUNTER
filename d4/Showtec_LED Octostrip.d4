<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Octostrip" ShortName="Octostrip" Company="Showtec" Version="8">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>fdadea22-2c9d-4cb6-bb76-aa47a6fdb13c</Thumbnail>
  <History Date="27-03-08" Author="Ion Balan" Comment="Created" Version="1" />
  <History Date="27-03-08" Author="Gregory Haynes" Comment="Checked" Version="2" />
  <History Date="08-06-09" Author="David Hunt" Comment="Added virtual dimmer" Version="3" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="4" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="5" />
  <History Date="08-08-16" Author="Nic Morris" Comment="Added missing modes.  Added Atlabase ID's." Version="6" />
  <History Date="04-03-17" Author="Nic Morris" Comment="Removed strobe function wheel display text." Version="7" />
  <History Date="08-09-20" Author="Nic Morris" Comment="Removed multi-strip modes (technically this is a PSU which can control varying numbers of strips)" Version="8" />
  <History Date="08-09-20" Author="Nic Morris" Comment="Removed manufacturer shortcode from display name.  Added product thumbnail." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="aa87bf80-64f4-42e5-9a7b-858b6e3bc3f1" />
  <Control>
    <Attribute ID="Rainbow" Name="Rainbow" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Rainbow" Display="'Rainbow %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Sound_Active" Name="Sound Active" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="1~30" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="31~60" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="61~90" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="91~120" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="121~150" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="151~180" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="181~210" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="211~240" />
      <Function ID="10" Name="Sound Active" Display="'Sound Active'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1x Octostrip, 6 DMX" Channels="6">
    <Import PearlRef="SHLEDOCT" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="da2aeb69-aa15-4f73-8409-3e440c3d8754" />
    <Include>
      <Attribute ID="Rainbow" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Sound_Active" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="fdadea22-2c9d-4cb6-bb76-aa47a6fdb13c"></Swatch>
  </swatchLibrary>
</Fixture>
  <History Date="05-07-18" Author="Nic Morris" Comment="Created" />
  <History Date="10-07-18" Author="Nic Morris" Comment="Changed manufacturer name from Fun Generation to FunGeneration.  Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="97b64484-1d3b-408c-91a4-375ec7231062" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="50~59" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="60~69" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="70~79" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~89" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="90~99" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="100~109" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="110~119" />
      <Function ID="9" Name="White" Display="'White'" Dmx="120~129" />
      <Function ID="10" Name="Program 1" Display="'Program 1'" Dmx="140~149" />
      <Function ID="11" Name="Program 2" Display="'Program 2'" Dmx="150~159" />
      <Function ID="12" Name="Program 3" Display="'Program 3'" Dmx="160~169" />
      <Function ID="13" Name="Program 4" Display="'Program 4'" Dmx="170~179" />
      <Function ID="14" Name="Program 5" Display="'Program 5'" Dmx="180~189" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKFGPB31" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="230" PanMaxSpeed="0" TiltMaxSpeed="0" />

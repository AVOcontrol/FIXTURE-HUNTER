      <Function ID="33" Name="Colour Fade" Display="'Colour Fade'" Dmx="224~240" Colour="255,255,255" />
      <Function ID="34" Name="Colour Chase" Display="'Colour Chase'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stnd Chase" Display="'Stnd Chase'" Dmx="0~0" />
      <Function ID="2" Name="Bright Chase" Display="'Bright Chase'" Dmx="21~41" />
      <Function ID="3" Name="Mood Chase" Display="'Mood Chase'" Dmx="42~62" />
      <Function ID="4" Name="Rnd Spect Chase" Display="'Rnd Spect Chase'" Dmx="63~83" />
      <Function ID="5" Name="Rnd Seq Chase" Display="'Rnd Seq Chase'" Dmx="84~104" />
      <Function ID="6" Name="Dynamic Chase" Display="'Dynamic Chase'" Dmx="105~125" />
      <Function ID="7" Name="R-GB" Display="'R-GB'" Dmx="126~146" />
      <Function ID="8" Name="G-BR" Display="'G-BR'" Dmx="147~167" />
      <Function ID="9" Name="B-R" Display="'B-R'" Dmx="168~188" />
      <Function ID="10" Name="Y-B" Display="'Y-B'" Dmx="189~209" />
      <Function ID="11" Name="R-G" Display="'R-G'" Dmx="210~230" />
      <Function ID="12" Name="Y-G" Display="'Y-G'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="ISO_iColor4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9a2613c3-d776-4c50-a7bb-e74163f1cca7" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Effect" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="RGBY, 4 DMX" Channels="4">
    <Import PearlRef="ISOiColRGBY" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8fbeec62-8d2c-493b-921c-e12694648760" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="YellowAdditive" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
    </Include>
  </Mode>

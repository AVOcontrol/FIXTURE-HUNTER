      <Function ID="26" Name="Colour 26" Display="'Colour 26'" Dmx="175~181" Colour="255,255,255" />
      <Function ID="27" Name="Colour 27" Display="'Colour 27'" Dmx="182~188" Colour="255,255,255" />
      <Function ID="28" Name="Colour 28" Display="'Colour 28'" Dmx="189~195" Colour="255,255,255" />
      <Function ID="29" Name="Colour 29" Display="'Colour 29'" Dmx="196~202" Colour="255,255,255" />
      <Function ID="30" Name="Colour 30" Display="'Colour 30'" Dmx="203~209" Colour="255,255,255" />

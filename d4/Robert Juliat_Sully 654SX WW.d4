  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c3828a48-5a7a-43f4-b16e-d722bfeb1d43" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master" Name="Master" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.1fms',1.0~20.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Strobe Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Response Time" Display="'Response Time %.fms',100~4000" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RDM Off" Display="'RDM Off'" Dmx="1~10" />
      <Function ID="3" Name="RDM On" Display="'RDM On'" Dmx="11~20" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="21~30" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (Dimmer8B), 1 DMX" Channels="1" Id="a483ed33-7ede-4b18-9a08-cd27d555d20e">

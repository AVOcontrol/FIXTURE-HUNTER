      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="0,0,0" />
      <Function ID="15" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />

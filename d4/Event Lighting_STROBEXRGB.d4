    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Red+Green" Display="'Red+Green'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="96~127" Colour="0,255,0" />
      <Function ID="5" Name="Green+Blue" Display="'Green+Blue'" Dmx="128~159" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="160~191" Colour="0,0,255" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="192~223" Colour="255,0,255" />
      <Function ID="8" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

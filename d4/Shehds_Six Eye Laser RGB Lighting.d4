  <History Date="12-09-22" Author="Nic Morris" Comment="Created (very poor documentation)" Version="0" />
  <History Date="01-06-24" Author="Nic Morris" Comment="Created from Unknown Six-eye swing laser lamp (poor documentation.  effectively identical.  assumed pan and tilt speed controls are mislabelled in the 19 channel mode charts.  control function ranges missing - left reset for now)" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="005abaef-b461-4296-93dc-46d26123ffd2" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Laser_FX" Name="Laser FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="15~27" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="28~39" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="40~51" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="52~63" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="64~75" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="76~87" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="88~99" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="100~111" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="112~123" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="124~135" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="136~147" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="148~159" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="160~171" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="172~183" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="184~195" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="196~207" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="208~219" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="220~231" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="232~243" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Laser_FX_Spd" Name="Laser FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="16~45" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="46~75" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="76~105" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="106~135" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="136~165" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="166~195" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="196~225" />
      <Function ID="9" Name="Sound 1" Display="'Sound 1'" Dmx="226~240" />
      <Function ID="10" Name="Sound 2" Display="'Sound 2'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_All" Name="Pan All" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="56~80" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="81~105" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="106~130" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="131~155" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="156~180" Update="Auto_Spd" />
      <Function ID="7" Name="Sound 1" Display="'Sound 1'" Dmx="181~205" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6'" Dmx="206~230" Update="Auto_Spd" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="231~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==7||'Auto'==9" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

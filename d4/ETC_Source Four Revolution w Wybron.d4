    </Attribute>
    <Attribute ID="Bay_1_Function" Name="Bay 1 Function" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="14~26" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="27~39" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED PAR 36 12x3W RGBW (F7000251)" ShortName="P36 12x3W" Company="Flash Butrym">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>db214288-b76b-4399-b9d1-8182350d1598</Thumbnail>
  <History Date="21-09-18" Author="Nic Morris" Comment="Created" />
  <History Date="25-09-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="26-09-18" Author="Nic Morris" Comment="Changed speed to default at zero for compatibility (Capture have interpreted as shutter).  Says 'Speed' in charts but could well be wrong." />
  <History Date="28-09-18" Author="Nic Morris" Comment="Added 7 DMX mode in response to customer information." />
  <History Date="29-09-18" Author="Nic Morris" Comment="Added Atlabase ID for 7 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2e60622a-cd19-4fe2-ba32-02e8008d8f34" />
  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~50" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="51~100" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="101~150" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="151~200" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="40~49" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~59" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~69" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="70~79" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="80~89" Colour="0,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="90~99" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="9" Name="R+G" Display="'R+G'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="11" Name="R+W" Display="'R+W'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="12" Name="G+B" Display="'G+B'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="13" Name="G+W" Display="'G+W'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="14" Name="B+W" Display="'B+W'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="15" Name="R+G+W" Display="'R+G+W'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="16" Name="R+B+W" Display="'R+B+W'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="17" Name="G+B+W" Display="'G+B+W'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="18" Name="R+G+B" Display="'R+G+B'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="19" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Transition" Display="'Transition'" Dmx="51~100" Update="Shutter" />
      <Function ID="3" Name="Gradient" Display="'Gradient'" Dmx="101~150" Update="Shutter" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="151~200" Update="Shutter" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3,4" If="'Auto'&gt;1" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKFBP362" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1968ff9c-6eea-4b89-b29d-ac38f3f79caa" />
    <Include>
      <Attribute ID="Macro" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c1af872d-92bb-4f04-971d-762f6c9aaf67" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="db214288-b76b-4399-b9d1-8182350d1598"></Swatch>

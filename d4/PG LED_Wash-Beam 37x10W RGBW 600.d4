  <History Date="21-09-10" Author="John Rogers" Comment="Created from Robe_Robin 600E Wash.d4" Version="1" />
  <History Date="09-11-10" Author="John Rogers" Comment="Tested against fixture." Version="2" />
  <History Date="07-01-11" Author="John Rogers" Comment="Added Physical Movement info." Version="3" />
  <History Date="12-01-11" Author="John Rogers" Comment="Added Robe updates including new modes." Version="4" />
  <History Date="31-03-11" Author="John Rogers" Comment="Updated Macros." Version="5" />
  <History Date="19-10-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Removed shutter update from colour." Version="6" />
  <History Date="19-10-11" Author="Nic Morris" Comment="Increased wheel resolution.  Shortened names for Expert LCD.  Reordered shutter." Version="7" />
  <History Date="19-10-11" Author="Nic Morris" Comment="Added missing macros.  Added pixel mapper compatibility." Version="8" />
  <History Date="07-11-11" Author="John Rogers" Comment="Removed Virtual Dimmer from Cells." Version="9" />
  <History Date="07-12-11" Author="John Rogers" Comment="Edited Colour Macro Zone Effects to Value range." Version="10" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." Version="11" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="12" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="13" />
  <History Date="06-01-17" Author="Nic Morris" Comment="Fixed channel count in cell mode name and changed to hidden." Version="14" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Revised control functions and macros." Version="15" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Changed Colour Macros to Virtual Col and aligned functions with product range for compatibility." Version="16" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Revised Virtual Col index functions for full field control." Version="17" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Aligned shutter functions (where possible) across product range for compatibility." Version="18" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added vdim to cells." Version="19" />
  <History Date="23-08-22" Author="Nic Morris" Comment="Updated in line with v1.7 charts (adds mode 6)" Version="20" />
  <History Date="08-03-25" Author="Nic Morris" Comment="Created from Robe Robin 600 LED Wash (documentation is titled 'ROBIN 600 LedWash and charts are a copy of the Robe documentation)" Version="21" />
  <History Date="14-03-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="22" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3dfbb1aa-a439-411b-8cb3-a1e32226d146" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC C-Mix" Display="'CTC C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Virtual_Col" Name="Virtual Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="1~2" Colour="0,0,0" />
      <Function ID="3" Name="White 2700K Halogen" Display="'White 2700K Halogen'" Dmx="3~3" Colour="0,0,0" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="4~5" Colour="0,0,0" />
      <Function ID="5" Name="White 3200K Halogen" Display="'White 3200K Halogen'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="7~9" Colour="0,0,0" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="10~12" Colour="0,0,0" />
      <Function ID="8" Name="White 8000K" Display="'White 8000K'" Dmx="13~15" Colour="0,0,0" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="10" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="16~56" Colour="0,0,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />
      <Function ID="12" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="56~96" Colour="0,128,255" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="14" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="96~135" Colour="0,255,0" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="255,255,0" />
      <Function ID="16" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="135~175" Colour="255,255,0" />
      <Function ID="17" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="18" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="175~215" Colour="255,0,0" />
      <Function ID="19" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="20" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="215~247" Colour="255,0,255" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="247~247" Colour="0,0,255" />
      <Function ID="22" Name="Rainbow w/fade" Display="'Rainbow w/fade'" Dmx="248~248" Colour="0,0,0" />
      <Function ID="23" Name="Rainbow no fade" Display="'Rainbow no fade'" Dmx="249~249" Colour="0,0,0" />
      <Function ID="24" Name="Zone Effect" Display="'Zone Effect %.f',1~6" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Z3 Strobe %" Display="'Zone 3 Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="5" Name="Rnd All Zn" Display="'Rnd All Zn %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="6" Name="Rnd Zn" Display="'Rnd Zn %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="7" Name="Rnd Zn Strb" Display="'Rnd Zn Strb %.f%%',100~0" Dmx="176~191" Intensity="0~0" />
      <Function ID="8" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
      <Function ID="10" Name="Zone FX Fwd" Display="'Zone FX Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="11" Name="Zone FX Rev" Display="'Zone FX Rev %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

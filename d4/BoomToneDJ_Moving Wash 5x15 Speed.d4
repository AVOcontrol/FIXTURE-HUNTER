      <Attribute ID="Amber" ChannelOffset="11" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="7" />
      <Attribute ID="Dim_Mode" ChannelOffset="13" Wheel="26" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

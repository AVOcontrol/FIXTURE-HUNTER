    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Delay ON" Display="'Delay ON'" Dmx="1~25" />
      <Function ID="3" Name="Delay OFF" Display="'Delay OFF'" Dmx="26~50" />
      <Function ID="4" Name="Rainbow" Display="'Rainbow'" Dmx="51~90" />
      <Function ID="5" Name="Momentum Change" Display="'Momentum Change'" Dmx="91~130" />
      <Function ID="6" Name="Col Change" Display="'Col Change'" Dmx="131~170" />
      <Function ID="7" Name="Signal Strength Change" Display="'Signal Strength Change'" Dmx="171~210" />
      <Function ID="8" Name="Auto" Display="'Auto'" Dmx="211~250" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

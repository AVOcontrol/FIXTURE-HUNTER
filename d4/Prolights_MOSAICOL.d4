<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MOSAICOL" ShortName="MOSAICOL" Company="Prolights" Version="8">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Created (confusing charts)" Version="1" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Revised 35 DMX mode with 16bit focus and zoom (original charts were wrong)" Version="2" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Revised Record Scenes mode in line with latest charts in response to manufacturer request." Version="3" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added fixed colour names and swatches." Version="4" />
  <History Date="28-04-20" Author="Nic Morris" Comment="Added 44 channel mode in line with latest charts in response to manufacturer request (note prism and animation don't make sense and look wrong)" Version="5" />
  <History Date="30-04-20" Author="Nic Morris" Comment="Added 44 DMX Atlabase ID." Version="6" />
  <History Date="30-04-20" Author="Nic Morris" Comment="Revised in line with corrected charts in response to manufacturer request." Version="7" />
  <History Date="07-03-22" Author="Nic Morris" Comment="Created from Prolights MOSAICOXL (remarkably different - despite many of the functions being the same their DMX ranges are not)" Version="8" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~151" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="14~20" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Congo Blue" Display="'Congo Blue'" Dmx="28~34" WheelPosition="2" Colour="180,0,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="42~48" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="56~62" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="70~76" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="CTO 2700K" Display="'CTO 2700K'" Dmx="84~90" WheelPosition="6" Colour="255,240,200" />
      <Function ID="8" Name="CTO 3200K" Display="'CTO 3200K'" Dmx="98~104" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="7~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ C Blu" Display="'D Rd/ C Blu'" Dmx="21~27" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="C Blu/ Yel" Display="'C Blu/ Yel'" Dmx="35~41" WheelPosition="2" Colour="180,0,255" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="49~55" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="63~69" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Mag/ 2700K" Display="'Mag/ 2700K'" Dmx="77~83" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="2700/ 3200K" Display="'2700/ 3200K'" Dmx="91~97" WheelPosition="6" Colour="255,240,200" />
      <Function ID="16" Name="3200K/ Op" Display="'3200K/ Op'" Dmx="105~111" WheelPosition="7" Colour="255,240,200" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~111" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="183~184" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="112~182" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="183~184" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="185~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="4~7" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="8~11" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="12~15" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="16~19" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="20~23" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="24~27" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="28~31" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="179~189" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="190~200" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="201~211" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="212~222" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="223~233" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="234~244" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="245~255" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="104~106" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="32~103" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="104~106" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="107~178" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="48830~32896" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="65535~49601" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="48830~32896" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="65535~49601" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

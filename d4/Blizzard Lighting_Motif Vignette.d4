    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="21~60" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="101~140" Intensity="0~0" />
      <Function ID="4" Name="Async" Display="'Async %.f%%',0~100" Dmx="6~20" Intensity="0~0" />
      <Function ID="5" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="61~100" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="141~180" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="181~220" Intensity="0~0" />
      <Function ID="8" Name="Square" Display="'Square %.f%%',0~100" Dmx="221~255" Intensity="0~0" />
    </Attribute>

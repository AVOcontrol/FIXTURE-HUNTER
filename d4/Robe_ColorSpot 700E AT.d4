    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Animation_Rot" />
      <Function ID="2" Name="Horiz Index" Display="'Horiz Index'" Dmx="32~47" Update="Animation_Rot" />
      <Function ID="3" Name="Vert Index" Display="'Vert Index'" Dmx="48~63" Update="Animation_Rot" />
      <Function ID="4" Name="Horiz Continuous" Display="'Horiz Continuous'" Dmx="64~79" Update="Animation_Rot" />
      <Function ID="5" Name="Vert Continuous" Display="'Vert Continuous'" Dmx="80~95" Update="Animation_Rot" />
      <Function ID="6" Name="Horiz Pulse" Display="'Horiz Pulse'" Dmx="96~111" Update="Animation_Rot" />

      <Condition Name="Scroll" ID="32,33,34,35" If="'Gobo1Func'==4" />
      <Condition Name="Random" ID="36,37,38" If="'Gobo1Func'==5" />
      <Else ID="39" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Animation'==2||'Animation'==3||'Animation'==8" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Animation'==4||'Animation'==5||'Animation'==9" />
      <Condition Name="Pulse" ID="7" If="'Animation'==6||'Animation'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="4" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="128~129" />
      <Function ID="6" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ColorSpot 700E AT" ShortName="ColSp70EAT" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-11-06" Author="D.Milligan" Comment="Created" />
  <History Date="04-12-06" Author="D.Milligan" Comment="Checked" />
  <History Date="06-02-07" Author="D.Milligan" Comment="Updated to current charts" />
  <History Date="06-02-07" Author="D.Milligan" Comment="Checked" />
  <History Date="17-01-08" Author="Gregory Haynes" Comment="Changed CTO locate and increased macro times" />
  <History Date="11-03-08" Author="Gregory Haynes" Comment="Flipped CTO direction &amp; set shutter closed in macros" />
  <History Date="15-10-08" Author="David Hunt" Comment="Updated Palettes and macros" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="13-03-09" Author="Jonathan Moreton" Comment="Added Palettes, Changed shutter power on value " />
  <History Date="04-08-09" Author="David Hunt" Comment="Added Mode 6" />
  <History Date="24-08-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="31-07-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution.  Added function index." />
  <History Date="31-07-11" Author="Nic Morris" Comment="Inverted some ranges for better wheel control.  Reordered shutter functions." />
  <History Date="31-07-11" Author="Nic Morris" Comment="Renamed gobo shake functions.  Fixed 16bit raw ranges.  Added extra func options for Gobo2" />
  <History Date="31-07-11" Author="Nic Morris" Comment="Inverted zoom." />
  <History Date="20-11-12" Author="Peter Budd" Comment="Changed shutter to Open rather than Open Full" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information." />
  <History Date="24-11-14" Author="Peter Budd" Comment="Updated Colour wheel fixed open range." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Revised P/T speed range mapping.  Unified control attribute and macros across all versions." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Removed shutter from lamp and reset macros.  Added missing macros.  Revised physical pan range from 530 to 540." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Renamed closed shutter function from Closed 350W to Closed for compatibility." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Revised index function names, adjusted ranges for full field control and increased 16bit wheel resolution." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Fixed 16bit raw colour range for v1.1 modes.  Changed v1.1 colour open values.  Recreated palettes." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Consolidated 'music' into random conditions as they are random functions." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Fixed iris random pulse ranges and revised function names.  Added missing Atlabase ID's to Mode 1 and Mode 2." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="21075" ModelID="6" />
  </RDM>

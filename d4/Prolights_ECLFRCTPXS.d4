  <History Date="08-11-23" Author="Nic Morris" Comment="Created (assumed tint is the same as green shift)" Version="0" />
  <History Date="14-11-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="33" />
  <History Date="15-11-23" Author="Nic Morris" Comment="Removed LED Freq 600Hz control function and macro in response to manufacturer request (error in manual)" Version="34" />
  <History Date="08-09-25" Author="Nic Morris" Comment="Created from Prolights ECLFRCTPLIP (note EXTENDED mode refers to controls that have no details)" Version="35" />
  <History Date="10-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="40" />
  <History Date="16-02-26" Author="Nic Morris" Comment="Changed colour component order in modes 36,37 and 38 in line with latest documentation in response to manufacturer request." Version="41" />

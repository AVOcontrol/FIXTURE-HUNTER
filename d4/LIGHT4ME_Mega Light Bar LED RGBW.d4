  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="110dd8b5-16e6-4f97-bbe7-e28c3e02893b" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="1~10" Update="Auto_Spd" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="11~20" Update="Auto_Spd" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="21~30" Update="Auto_Spd" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="31~40" Update="Auto_Spd" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="41~50" Update="Auto_Spd" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="51~60" Update="Auto_Spd" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="61~70" Update="Auto_Spd" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="71~80" Update="Auto_Spd" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="81~90" Update="Auto_Spd" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="91~100" Update="Auto_Spd" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="101~110" Update="Auto_Spd" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="111~120" Update="Auto_Spd" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="121~130" Update="Auto_Spd" />
      <Function ID="15" Name="Program 15" Display="'Program 15'" Dmx="131~140" Update="Auto_Spd" />
      <Function ID="16" Name="Program 16" Display="'Program 16'" Dmx="141~150" Update="Auto_Spd" />
      <Function ID="17" Name="Program 17" Display="'Program 17'" Dmx="151~160" Update="Auto_Spd" />
      <Function ID="18" Name="Program 18" Display="'Program 18'" Dmx="161~170" Update="Auto_Spd" />
      <Function ID="19" Name="Program 19" Display="'Program 19'" Dmx="171~180" Update="Auto_Spd" />
      <Function ID="20" Name="Program 20" Display="'Program 20'" Dmx="181~190" Update="Auto_Spd" />
      <Function ID="21" Name="Program 21" Display="'Program 21'" Dmx="191~200" Update="Auto_Spd" />
      <Function ID="22" Name="Program 22" Display="'Program 22'" Dmx="201~210" Update="Auto_Spd" />
      <Function ID="23" Name="Program 23" Display="'Program 23'" Dmx="211~220" Update="Auto_Spd" />
      <Function ID="24" Name="Program 24" Display="'Program 24'" Dmx="221~230" Update="Auto_Spd" />
      <Function ID="25" Name="Program 25" Display="'Program 25'" Dmx="231~240" Update="Auto_Spd" />
      <Function ID="26" Name="Sound" Display="'Sound'" Dmx="241~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==26" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 3 DMX" Channels="3">
    <Import PearlRef="UKL4MLB1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Function ID="21" Name="Colour Flow 1" Display="'Colour Flow 1'" Dmx="168~175" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Colour Flow 2" Display="'Colour Flow 2'" Dmx="176~183" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Colour Flow 3" Display="'Colour Flow 3'" Dmx="184~191" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Colour Flow 4" Display="'Colour Flow 4'" Dmx="192~199" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Colour Flow 5" Display="'Colour Flow 5'" Dmx="200~207" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Colour Flow 6" Display="'Colour Flow 6'" Dmx="208~215" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Colour Flow 7" Display="'Colour Flow 7'" Dmx="216~223" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Colour Flow 8" Display="'Colour Flow 8'" Dmx="224~231" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Colour Flow 9" Display="'Colour Flow 9'" Dmx="232~239" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Colour Flow 10" Display="'Colour Flow 10'" Dmx="240~247" Update="Dimmer, Master_Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="42~84" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="85~127" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="128~170" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="171~213" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="214~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Col_Mac_Dim" Name="Col Mac Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Pix 4 Batten" ShortName="Mini Pix 4" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="23-01-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="40~47" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="48~55" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="56~63" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="64~71" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red4" Name="Red 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green4" Name="Green 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue4" Name="Blue 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="LJMPX4B1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>

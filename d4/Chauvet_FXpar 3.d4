<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FXpar 3" ShortName="FXpar 3" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="14-01-17" Author="Nic Morris" Comment="Created" />
  <History Date="10-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="488f09bf-c711-456a-b641-c4767637173f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="RGB_SMD" Name="RGB SMD" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~21" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="22~37" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="38~53" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="54~69" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="70~101" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="102~117" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="118~133" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="9" Name="Auto 1" Display="'Auto 1'" Dmx="134~149" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="10" Name="Auto 2" Display="'Auto 2'" Dmx="150~165" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="11" Name="Auto 3" Display="'Auto 3'" Dmx="166~181" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="12" Name="Auto 4" Display="'Auto 4'" Dmx="182~197" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="13" Name="Auto 5" Display="'Auto 5'" Dmx="198~213" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="14" Name="Auto 6" Display="'Auto 6'" Dmx="214~229" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="15" Name="Auto 7" Display="'Auto 7'" Dmx="230~245" Update="RGB_SMD_Strobe" Colour="255,255,255" />
      <Function ID="16" Name="Auto 8" Display="'Auto 8'" Dmx="246~255" Update="RGB_SMD_Strobe" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="RGB_SMD_Strobe" Name="RGB SMD Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4,5" If="'RGB_SMD'&gt;1&amp;&amp;'RGB_SMD'&lt;9" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="White_SMD" Name="White SMD" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="2" Name="All On" Display="'All On'" Dmx="6~30" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="31~55" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="56~80" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="81~105" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="106~130" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5'" Dmx="131~155" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6'" Dmx="156~180" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="9" Name="Auto 7" Display="'Auto 7'" Dmx="181~205" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="10" Name="Auto 8" Display="'Auto 8'" Dmx="206~230" Update="White_SMD_Strobe" Colour="255,255,255" />
      <Function ID="11" Name="Auto 9" Display="'Auto 9'" Dmx="231~255" Update="White_SMD_Strobe" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White_SMD_Strobe" Name="White SMD Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4,5" If="'White_SMD'&gt;1" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~30" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~55" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="56~80" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="81~105" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="106~130" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="131~155" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="156~180" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="181~205" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="206~230" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="CHFXPR39" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5f24aefe-ffee-41de-ab64-c6404ded239a" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="UV" ChannelOffset="4" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="RGB_SMD" ChannelOffset="6" Wheel="8" />
      <Attribute ID="RGB_SMD_Strobe" ChannelOffset="7" Wheel="5" />
      <Attribute ID="White_SMD" ChannelOffset="8" Wheel="9" />
      <Attribute ID="White_SMD_Strobe" ChannelOffset="9" Wheel="6" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="CHFXPR33" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c78ca0c2-dd19-43da-a8cc-b0331c069eb9" />
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="24" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
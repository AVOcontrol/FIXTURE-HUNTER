  <History Date="14-11-19" Author="Nic Morris" Comment="Created (note a single fixture has 240 pixels and requires 720 channels.  charts suggest RGB controls span universe boundaries.  this has been poorly thought through and is never going to work)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~50" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="51~90" />
      <Function ID="4" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="91~140" />
    </Attribute>
    <Attribute ID="FG_Program" Name="FG Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="1~20" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="21~40" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="41~60" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="61~65" />
      <Function ID="6" Name="Multi-Colour" Display="'Multi-Colour'" Dmx="66~80" />
      <Function ID="7" Name="Colour Fade 1" Display="'Colour Fade 1'" Dmx="81~100" />
      <Function ID="8" Name="Colour Fade 2" Display="'Colour Fade 2'" Dmx="101~120" />
      <Function ID="9" Name="Colour Fade 3" Display="'Colour Fade 3'" Dmx="121~140" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Offset" Name="Program Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Delay" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FG_Program1" Name="BG Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="1~20" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="21~40" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="41~60" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="61~65" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Test" Name="Test" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Test 1 (White)" Display="'Test 1 (White)'" Dmx="21~30" />
      <Function ID="3" Name="Test 2 (Colour Fade)" Display="'Test 2 (Colour Fade)'" Dmx="31~40" />
      <Function ID="4" Name="Test 3 (Colour Scroll)" Display="'Test 3 (Colour Scroll)'" Dmx="41~50" />
      <Function ID="5" Name="Test 4 (Red)" Display="'Test 4 (Red)'" Dmx="51~60" />
      <Function ID="6" Name="Test 5 (Green)" Display="'Test 5 (Green)'" Dmx="61~70" />
      <Function ID="7" Name="Test 6 (Blue)" Display="'Test 6 (Blue)'" Dmx="71~80" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="20-01-14" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="20~199" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="200~204" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="205~209" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="210~214" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="215~219" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="220~224" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="225~229" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Generic" Name="Auto Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RGB Snap" Display="'RGB Snap'" Dmx="10~23" />
      <Function ID="3" Name="7 Colour Snap" Display="'7 Colour Snap'" Dmx="24~38" />
      <Function ID="4" Name="RGB Fade" Display="'RGB Fade'" Dmx="39~53" />
      <Function ID="5" Name="7 Colour Fade" Display="'7 Colour Fade'" Dmx="54~68" />
      <Function ID="6" Name="Macro Fade" Display="'Macro Fade'" Dmx="69~83" />
      <Function ID="7" Name="Chase 1" Display="'Chase 1'" Dmx="84~98" />
      <Function ID="8" Name="Chase 2" Display="'Chase 2'" Dmx="99~113" />
      <Function ID="9" Name="Chase 3" Display="'Chase 3'" Dmx="114~128" />
      <Function ID="10" Name="Chase 4" Display="'Chase 4'" Dmx="129~143" />
      <Function ID="11" Name="Chase 5" Display="'Chase 5'" Dmx="144~158" />
      <Function ID="12" Name="Chase 6" Display="'Chase 6'" Dmx="159~173" />
      <Function ID="13" Name="Chase 7" Display="'Chase 7'" Dmx="174~188" />
      <Function ID="14" Name="Chase 8" Display="'Chase 8'" Dmx="189~203" />
      <Function ID="15" Name="Chase 9" Display="'Chase 9'" Dmx="204~218" />
      <Function ID="16" Name="Auto" Display="'Auto'" Dmx="219~233" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Generic1" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~48" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="49~88" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="89~128" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="129~168" />
      <Function ID="6" Name="White ON" Display="'White ON'" Dmx="169~208" />
      <Function ID="7" Name="White OFF" Display="'White OFF'" Dmx="209~255" />
    </Attribute>
  </Control>

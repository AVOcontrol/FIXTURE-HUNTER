      <Function ID="22" Name="Mag/ UV" Display="'Mag/ UV'" Dmx="64~67" WheelPosition="6" Colour="255,0,255" />
      <Function ID="23" Name="UV/ CTO" Display="'UV/ CTO'" Dmx="72~75" WheelPosition="7" Colour="180,0,255" />

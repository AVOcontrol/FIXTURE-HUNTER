      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="98~112" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="113~127" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="128~142" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="143~157" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="158~172" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="173~187" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="188~202" />
      <Function ID="15" Name="Chase 14" Display="'Chase 14'" Dmx="203~217" />
      <Function ID="16" Name="Chase 15" Display="'Chase 15'" Dmx="218~232" />
      <Function ID="17" Name="Chase 16" Display="'Chase 16'" Dmx="233~247" />
      <Function ID="18" Name="Full On" Display="'Full On'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">

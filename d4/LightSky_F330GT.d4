      <Set Channel="Function:9" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">
      <Set Channel="Function:10" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display Invert">
      <Set Channel="Function:11" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display Normal">
      <Set Channel="Function:12" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Low Power">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:4" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Dark Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />

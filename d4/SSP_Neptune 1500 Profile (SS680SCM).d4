  <History Date="18-10-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added default RDM personality and software ID's for compatibility." Version="6" />
  <History Date="05-03-19" Author="Nic Morris" Comment="Revised animation ranges in line with latest charts in response to manufacturer request." Version="7" />
  <History Date="05-03-19" Author="Nic Morris" Comment="Changed CTO to default at 6800K (0 DMX)" Version="8" />
  <History Date="05-05-19" Author="Nic Morris" Comment="Created from Silver Star Pluto 600 (SS660SC)" Version="9" />
  <History Date="07-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />

  <Thumbnail>5177e05e-e1f9-4040-82c3-456f024d17ce</Thumbnail>
  <History Date="16-06-26" Author="Nic Morris" Comment="Created (silly number of modes.  included separate Main and SparQle patch only.  the resulting number of permutations for the Main+SparQle auto-follow is impractical with more than 1000 modes.  Even without this there are 150)" Version="0" />
  <History Date="16-06-26" Author="Nic Morris" Comment="(for auto-follow patch the appropriate Main followed by SparQle modes)" Version="13" />
  <History Date="18-06-26" Author="Nic Morris" Comment="Added control mode (the fixture has an option to address this independently)" Version="14" />
  <History Date="20-06-26" Author="Nic Morris" Comment="Added Atlabase ID's (note 'By4' grouping not currently included.  use 'All' grouping versions insead - they are identical)" Version="15" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e7d3612e-f72c-4e27-a821-8f3b859be49c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Moving Head Gobo Light" ShortName="Mini Gobo" Company="Unknown" Version="3">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="18-11-19" Author="Nic Morris" Comment="Created (very poor documentation.  exact product name unclear from request and vague on closest matching product page)" Version="1" />
  <History Date="19-11-19" Author="Nic Morris" Comment="Fixed wheel mapping conflict." Version="2" />
  <History Date="03-06-24" Author="Nic Morris" Comment="Created from UKing LED Moving Head Light 50W+RGBW Circle" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~49" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="60~69" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="70~79" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="130~139" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="120~129" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="110~119" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="100~109" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="90~99" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Pk/ L Blu" Display="'Pk/ L Blu'" Dmx="80~89" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="140~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="8~63" WheelPosition="0" />
      <Function ID="3" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="64~127" WheelPosition="0" />
      <Function ID="4" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 3" Display="'Auto 3'" Dmx="60~84" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="85~109" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="110~134" />
      <Function ID="5" Name="Auto 0" Display="'Auto 0'" Dmx="135~159" />
      <Function ID="6" Name="Sound 3" Display="'Sound 3'" Dmx="160~184" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="185~209" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="210~234" />
      <Function ID="9" Name="Sound 0" Display="'Sound 0'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Light_Strips" Name="Light Strips" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="5~109" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="110~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="7b1665f4-b39d-49e1-8341-bac49ad3d788">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Auto" ChannelOffset="10" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
      <Attribute ID="Light_Strips" ChannelOffset="12" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10" Id="17974fe5-d26a-440f-b5b3-74c30d6e990c">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
      <Attribute ID="Light_Strips" ChannelOffset="10" Wheel="23" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary />
</Fixture>
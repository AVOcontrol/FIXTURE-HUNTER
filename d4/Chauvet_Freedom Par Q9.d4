    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="4~7" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="8~11" Colour="0,0,255" />
      <Function ID="4" Name="Amber" Display="'Amber'" Dmx="12~15" Colour="255,100,0" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="16~19" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="20~23" Colour="255,255,255" />
      <Function ID="7" Name="R+A" Display="'R+A'" Dmx="24~27" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="28~31" Colour="255,255,255" />
      <Function ID="9" Name="G+A" Display="'G+A'" Dmx="32~35" Colour="255,255,255" />
      <Function ID="10" Name="B+A" Display="'B+A'" Dmx="36~39" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="40~43" Colour="255,255,255" />

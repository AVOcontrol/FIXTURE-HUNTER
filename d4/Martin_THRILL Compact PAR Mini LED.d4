      <Function ID="33" Name="Colour 32" Display="'Colour 32'" Dmx="166~170" Colour="0,0,0" />
      <Function ID="34" Name="Colour 33" Display="'Colour 33'" Dmx="171~175" Colour="0,0,0" />
      <Function ID="35" Name="Colour 34" Display="'Colour 34'" Dmx="176~180" Colour="0,0,0" />
      <Function ID="36" Name="Colour 35" Display="'Colour 35'" Dmx="181~185" Colour="0,0,0" />
      <Function ID="37" Name="Colour 36" Display="'Colour 36'" Dmx="186~190" Colour="0,0,0" />
      <Function ID="38" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="39" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="40" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="41" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="42" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="43" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="44" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="255,255,255" />
      <Function ID="45" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="255,255,255" />
      <Function ID="46" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c1e3394d-4c7a-468b-9bf0-546cf909d708" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

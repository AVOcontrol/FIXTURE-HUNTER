  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ea5a2361-fdad-4303-8e47-970c31e6ea28" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 10000K" Display="'White 10000K'" Dmx="17~24" Colour="255,255,255" />
      <Function ID="3" Name="White 7200K" Display="'White 7200K'" Dmx="25~32" Colour="255,255,255" />
      <Function ID="4" Name="White 5600K" Display="'White 5600K'" Dmx="33~40" Colour="255,255,255" />
      <Function ID="5" Name="White 3200K" Display="'White 3200K'" Dmx="41~48" Colour="255,255,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="49~56" Colour="0,255,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="57~64" Colour="255,255,0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="65~72" Colour="255,0,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="73~80" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="81~88" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="89~96" Colour="0,0,255" />
      <Function ID="12" Name="Light Blue" Display="'Light Blue'" Dmx="97~104" Colour="0,128,255" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="105~112" Colour="255,100,0" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="113~120" Colour="255,128,0" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="121~128" Colour="255,150,150" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />

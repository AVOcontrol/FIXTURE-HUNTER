  <History Date="18-05-18" Author="Nic Morris" Comment="Revised Atlabase ID's.  Added channel counts to mode names.  Added product thumbnail." Version="5" />
  <History Date="13-03-20" Author="Nic Morris" Comment="Created from Dialighting Mini Spot 150 (no colour names - guessed)" Version="6" />
  <History Date="14-03-20" Author="Nic Morris" Comment="Fixed colour scroll conditions." Version="7" />
  <History Date="21-06-22" Author="Nic Morris" Comment="Created from JMAZ Lighting Attco Spot 150 (gobo wheel images missing slot numbers - gobo 2 images are the same so left unchanged, gobo 1 images different so removed)" Version="8" />
  <History Date="24-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cbdab605-58d2-4f31-900e-5ed54be847ce" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="28~34" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="42~48" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="56~62" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Rosy Red" Display="'Rosy Red'" Dmx="70~76" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Deep Blue" Display="'Deep Blue'" Dmx="84~90" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Deep Yellow" Display="'Deep Yellow'" Dmx="98~104" WheelPosition="7" Colour="200,200,0" />
      <Function ID="9" Name="Orange" Display="'Orange'" Dmx="112~118" WheelPosition="8" Colour="255,100,0" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="7~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Blu" Display="'Rd/ Blu'" Dmx="21~27" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="35~41" WheelPosition="2" Colour="0,0,255" />
      <Function ID="13" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="49~55" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Yel/ R Rd" Display="'Yel/ R Rd'" Dmx="63~69" WheelPosition="4" Colour="255,255,0" />
      <Function ID="15" Name="R Rd/ D Blu" Display="'R Rd/ D Blu'" Dmx="77~83" WheelPosition="5" Colour="255,0,255" />
      <Function ID="16" Name="D Blu/ D Yel" Display="'D Blu/ D Yel'" Dmx="91~97" WheelPosition="6" Colour="0,0,180" />
      <Function ID="17" Name="D Yel/ Org" Display="'D Yel/ Org'" Dmx="105~111" WheelPosition="7" Colour="200,200,0" />
      <Function ID="18" Name="Org/ Op" Display="'Org/ Op'" Dmx="119~127" WheelPosition="8" Colour="255,100,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />

      <Function ID="14" Name="Rnd All Rings" Display="'Rnd All Rings %.f%%',0~100" Dmx="157~177" Intensity="0~0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="178~181" Intensity="0~0" />

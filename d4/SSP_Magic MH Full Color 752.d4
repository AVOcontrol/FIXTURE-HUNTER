      <Function ID="8" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="82~102" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="103~106" Intensity="0~0" />
      <Function ID="10" Name="Burst 1" Display="'Burst 1 %.f%%',0~100" Dmx="107~127" Intensity="0~0" />

      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="31~51" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="52~56" Intensity="0~0" />

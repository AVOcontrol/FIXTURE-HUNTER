    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Full" Display="'Full'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="21~30" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="31~40" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="41~50" Colour="0,0,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="61~70" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="71~80" Colour="255,0,255" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="81~90" Colour="255,255,0" />
      <Function ID="10" Name="Yellow-Green" Display="'Yellow-Green'" Dmx="91~100" Colour="180,180,0" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="101~110" Colour="0,128,255" />
      <Function ID="12" Name="Midnight Blue" Display="'Midnight Blue'" Dmx="111~120" Colour="0,0,180" />
      <Function ID="13" Name="Purple" Display="'Purple'" Dmx="121~130" Colour="128,0,255" />
      <Function ID="14" Name="Light Purple" Display="'Light Purple'" Dmx="131~140" Colour="180,0,180" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="141~150" Colour="255,150,150" />
      <Function ID="16" Name="Light Red" Display="'Light Red'" Dmx="151~160" Colour="255,100,100" />
      <Function ID="17" Name="Orange" Display="'Orange'" Dmx="161~170" Colour="255,128,0" />
      <Function ID="18" Name="No Colour" Display="'No Colour'" Dmx="171~180" Colour="255,255,255" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="181~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="S">

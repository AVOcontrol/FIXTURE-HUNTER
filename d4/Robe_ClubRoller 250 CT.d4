    </Attribute>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" Clear="1:0" />
      <Condition Name="Dimmer" ID="1" If="'Shutter_Func'==1" />
      <Condition Name="Shutter" ID="2" If="'Shutter_Func'==2" />
      <Condition Name="Control" ID="3,4,5,6" If="'Shutter_Func'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Dimmer" Display="'%.f%%',0~100" Dmx="0~95" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="96~127" Intensity="0~0" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="128~139" Intensity="0~0" />
      <Function ID="4" Name="Prog time trig" Display="'Prog time trig'" Dmx="140~191" Intensity="0~0" />
      <Function ID="5" Name="Prog aud trig" Display="'Prog aud trig'" Dmx="192~223" Intensity="0~0" />
      <Function ID="6" Name="Rand aud trig" Display="'Rand aud trig'" Dmx="224~255" Intensity="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I" Size="0">

  <Thumbnail>f720d018-8f0e-46d1-aa1e-f2ecf8dd3089</Thumbnail>
  <History Date="05-09-24" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Reflector_Rot" Name="Reflector Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standby" Display="'Standby'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="8~125" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="126~129" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~247" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Bounce" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Shutter" Display="'Shutter %.f%%',0~100" Dmx="8~100" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 1" Display="'Colour 1'" Dmx="101~110" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 2" Display="'Colour 2'" Dmx="111~120" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 3" Display="'Colour 3'" Dmx="121~130" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 4" Display="'Colour 4'" Dmx="131~140" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 5" Display="'Colour 5'" Dmx="141~150" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 6" Display="'Colour 6'" Dmx="151~160" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Colour 7" Display="'Colour 7'" Dmx="161~170" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="11" Name="Shutter" Display="'Shutter %.f%%',0~100" Dmx="8~100" WheelPosition="1" Colour="0,0,0" />
      <Function ID="12" Name="1/ 2" Display="'1/ 2'" Dmx="171~182" WheelPosition="2" Colour="0,0,0" />
      <Function ID="13" Name="2/ 3" Display="'2/ 3'" Dmx="183~194" WheelPosition="3" Colour="0,0,0" />
      <Function ID="14" Name="3/ 4" Display="'3/ 4'" Dmx="195~206" WheelPosition="4" Colour="0,0,0" />
      <Function ID="15" Name="4/ 5" Display="'4/ 5'" Dmx="207~218" WheelPosition="5" Colour="0,0,0" />
      <Function ID="16" Name="5/ 6" Display="'5/ 6'" Dmx="219~230" WheelPosition="6" Colour="0,0,0" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="18" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="231~250" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="46~87" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="88~129" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="130~171" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="172~213" />
      <Function ID="6" Name="Show 0 (Random 1-4)" Display="'Show 0 (Random 1-4)'" Dmx="214~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 5 DMX" Channels="5" Id="d89d31d6-b8e9-49ed-bf96-bfe080bc4791">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Reflector_Rot" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Show" ChannelOffset="5" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:4:100" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="f720d018-8f0e-46d1-aa1e-f2ecf8dd3089"></Swatch>
  </swatchLibrary>
</Fixture>
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="65~74" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Jump" Display="'Jump'" Dmx="75~97" Colour="255,255,255" />
      <Function ID="10" Name="Change Slow" Display="'Change Slow'" Dmx="98~120" Colour="255,255,255" />
      <Function ID="11" Name="Change Gradual" Display="'Change Gradual'" Dmx="121~143" Colour="255,255,255" />
      <Function ID="12" Name="Col Change Spd 1" Display="'Col Change Spd 1'" Dmx="144~166" Colour="255,255,255" />
      <Function ID="13" Name="Col Change Spd 2" Display="'Col Change Spd 2'" Dmx="167~189" Colour="255,255,255" />

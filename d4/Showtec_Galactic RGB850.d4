<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Galactic RGB850" ShortName="RGB850" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="19-03-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black Out" Display="'Black Out'" Dmx="0~0" Update="Patterns, Shutter" />
      <Function ID="2" Name="PRG" Display="'PRG'" Dmx="74~110" Update="Patterns, Shutter" />
      <Function ID="3" Name="ILD" Display="'ILD'" Dmx="111~147" Update="Patterns, Shutter" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="148~165" Update="Patterns, Shutter" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="166~184" Update="Patterns, Shutter" />
      <Function ID="6" Name="Music 1" Display="'Music 1'" Dmx="185~202" Update="Patterns, Shutter" />
      <Function ID="7" Name="Music 2" Display="'Music 2'" Dmx="203~221" Update="Patterns, Shutter" />
      <Function ID="8" Name="DMX" Display="'DMX'" Dmx="222~255" Update="Patterns, Shutter" />
    </Attribute>
    <Attribute ID="Patterns" Name="Patterns" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Folders" ID="2" If="'Control'==2||'Control'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Patterns" Display="'Patterns %.f',0~255" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Folders" Display="'Folders %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Shows" ID="4" If="'Control'==2||'Control'==3" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" Intensity="0~0" />
      <Function ID="4" Name="Shows" Display="'Shows %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="X_Move" Name="X Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rand Spd" Display="'Rand Spd %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Rand Sound" Display="'Rand Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y_Move" Name="Y Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rand Spd" Display="'Rand Spd %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Rand Sound" Display="'Rand Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'%.f%%',0~100" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="101~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom In " Display="'Zoom In  %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Zoom Out/In" Display="'Zoom Out/In %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X_Roll" Name="X Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Continuous" Display="'Continuous %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Y_Roll" Name="Y Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Continuous" Display="'Continuous %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Z_Roll" Name="Z Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="181~217" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="CCW Spin" Display="'CCW Spin %.f%%',0~100" Dmx="218~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Clip" Name="Clip" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Clip Out" Display="'Clip Out %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Clip In" Display="'Clip In %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Clip Out/In" Display="'Clip Out/In %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Clip On" Display="'Clip On %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Clip Off" Display="'Clip Off %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Wave Speed" Display="'Wave Speed %.1f%%',0.0~100.0" Dmx="10~199" />
      <Function ID="3" Name="Wave Size" Display="'Wave Size %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="WRGB Fixed" Display="'WRGB Fixed'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="BYPC Fixed" Display="'BYPC Fixed'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="7 Colours Fixed" Display="'7 Colours Fixed'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="WRGB Loop" Display="'WRGB Loop'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="BYPC Loop" Display="'BYPC Loop'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="7 Colours Loop" Display="'7 Colours Loop'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Original" Display="'Original'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dots" Name="Dots" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Bright Points" Display="'Bright Points'" Dmx="64~127" />
      <Function ID="3" Name="Blanking" Display="'Blanking'" Dmx="128~191" />
      <Function ID="4" Name="Points" Display="'Points'" Dmx="192~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SHRGB850" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Patterns" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="X_Move" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Y_Move" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="12" Wheel="8" />
      <Attribute ID="X_Roll" ChannelOffset="7" Wheel="13" />
      <Attribute ID="Y_Roll" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Z_Roll" ChannelOffset="9" Wheel="15" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Wave" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Clip" ChannelOffset="10" Wheel="25" />
      <Attribute ID="Dots" ChannelOffset="13" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
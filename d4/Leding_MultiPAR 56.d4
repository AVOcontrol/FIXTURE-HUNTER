  <History Date="23-02-22" Author="Nic Morris" Comment="Created (note SSP charts have two controls assigned to offset 5.  assumed is 7 channels totat instead of 6)." Version="0" />
  <History Date="01-03-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0aa15912-7be2-4e9d-bc76-f1e0021c57f7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~40" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="41~50" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~60" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~70" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="71~80" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="81~90" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="91~100" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="101~110" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="111~120" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~181" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
  </Control>

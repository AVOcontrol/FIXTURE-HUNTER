<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SPC061" ShortName="SPC061" Company="ElectroConcept">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="05-08-19" Author="Nic Morris" Comment="Created (limited information.  documentation is a mess - d-p1 chart says 9 channels but only lists 8.  specs say 5 and 29 channel options)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1 %.f%%',0~100" Dmx="31~50" />
      <Function ID="3" Name="Program 2" Display="'Program 2 %.f%%',0~100" Dmx="51~70" />
      <Function ID="4" Name="Program 3" Display="'Program 3 %.f%%',0~100" Dmx="71~90" />
      <Function ID="5" Name="Program 4" Display="'Program 4 %.f%%',0~100" Dmx="91~110" />
      <Function ID="6" Name="Program 5" Display="'Program 5 %.f%%',0~100" Dmx="111~130" />
      <Function ID="7" Name="Program 6" Display="'Program 6 %.f%%',0~100" Dmx="131~150" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="151~170" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="171~190" />
      <Function ID="10" Name="Sound 3" Display="'Sound 3 %.f%%',0~100" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="d-p1, 8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Program" ChannelOffset="8" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="4" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="5" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="6" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="7" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="d-p2, 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

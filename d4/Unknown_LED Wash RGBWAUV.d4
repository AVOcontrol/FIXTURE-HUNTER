    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="8~127" Colour="255,255,255" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18">

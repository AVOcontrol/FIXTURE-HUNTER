    </Attribute>
    <Attribute ID="CTO_2" Name="CTO 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200-3400K" Display="'3200-3400K %.fK',3200~3400" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="3800-4100K" Display="'3800-4100K %.fK',3800~4100" Dmx="21~30" Colour="0,0,0" />
      <Function ID="4" Name="5300-5600K" Display="'5300-5600K %.fK',5300~5600" Dmx="31~40" Colour="0,0,0" />
      <Function ID="5" Name="6200-6500K" Display="'6200-6500K %.fK',6200~6500" Dmx="41~50" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="121~130" Colour="200,0,0" />
      <Function ID="3" Name="Medium Blue" Display="'Medium Blue'" Dmx="131~140" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="141~150" Colour="0,255,0" />
      <Function ID="5" Name="Lavender" Display="'Lavender'" Dmx="151~160" Colour="255,180,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="161~170" Colour="255,150,0" />
      <Function ID="7" Name="CTO" Display="'CTO'" Dmx="171~180" Colour="255,200,150" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="181~190" Colour="0,0,255" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~116" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="223~193" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~225" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">

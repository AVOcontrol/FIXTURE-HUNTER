  <AtlaBase TypeID="b2b57e9d-5685-4a04-a129-e8aae2f46713" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:6000" PowerOn="1:6000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3200~6000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Reserved5" Name="Reserved 6" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Reserved6" Name="Reserved 7" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

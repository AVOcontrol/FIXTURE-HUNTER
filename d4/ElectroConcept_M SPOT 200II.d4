      <Function ID="16" Name="Ppl/ Yel" Display="'Ppl/ Yel'" Dmx="55~59" WheelPosition="5" Colour="128,0,255" />
      <Function ID="17" Name="Yel/ P Grn" Display="'Yel/ P Grn'" Dmx="65~69" WheelPosition="6" Colour="255,255,0" />
      <Function ID="18" Name="P Grn/ Cy" Display="'P Grn/ Cy'" Dmx="75~79" WheelPosition="7" Colour="128,255,0" />
      <Function ID="19" Name="Cy/ Pk" Display="'Cy/ Pk'" Dmx="85~89" WheelPosition="8" Colour="0,255,255" />
      <Function ID="20" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="95~99" WheelPosition="9" Colour="255,150,150" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="100~182" Colour="0,0,0" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="24" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="183~255" Colour="0,0,0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />

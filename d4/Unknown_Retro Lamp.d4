  <Mode Name="Dim cell" Channels="1" Hidden="True" Id="0d08d15d-5f17-4381-b3c2-e3895dc16194">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Retro Lamp" ShortName="Retro Lamp" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="23-11-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="RGBA Effect 1" Display="'RGBA Effect 1'" Dmx="5~11" Update="Auto_Spd" />
      <Function ID="3" Name="RGBA Effect 2" Display="'RGBA Effect 2'" Dmx="12~18" Update="Auto_Spd" />
      <Function ID="4" Name="RGBA Effect 3" Display="'RGBA Effect 3'" Dmx="19~25" Update="Auto_Spd" />
      <Function ID="5" Name="RGBA Effect 4" Display="'RGBA Effect 4'" Dmx="26~32" Update="Auto_Spd" />
      <Function ID="6" Name="RGBA Effect 5" Display="'RGBA Effect 5'" Dmx="33~39" Update="Auto_Spd" />
      <Function ID="7" Name="RGBA Effect 6" Display="'RGBA Effect 6'" Dmx="40~46" Update="Auto_Spd" />
      <Function ID="8" Name="RGBA Effect 7" Display="'RGBA Effect 7'" Dmx="47~53" Update="Auto_Spd" />
      <Function ID="9" Name="RGBA Effect 8" Display="'RGBA Effect 8'" Dmx="54~60" Update="Auto_Spd" />
      <Function ID="10" Name="RGBA Effect 9" Display="'RGBA Effect 9'" Dmx="61~67" Update="Auto_Spd" />
      <Function ID="11" Name="RGBA Effect 10" Display="'RGBA Effect 10'" Dmx="68~74" Update="Auto_Spd" />
      <Function ID="12" Name="A Effect 1" Display="'A Effect 1'" Dmx="75~81" Update="Auto_Spd" />
      <Function ID="13" Name="A Effect 2" Display="'A Effect 2'" Dmx="82~88" Update="Auto_Spd" />
      <Function ID="14" Name="A Effect 3" Display="'A Effect 3'" Dmx="89~95" Update="Auto_Spd" />
      <Function ID="15" Name="A Effect 4" Display="'A Effect 4'" Dmx="96~102" Update="Auto_Spd" />
      <Function ID="16" Name="A Effect 5" Display="'A Effect 5'" Dmx="103~109" Update="Auto_Spd" />
      <Function ID="17" Name="A Effect 6" Display="'A Effect 6'" Dmx="110~116" Update="Auto_Spd" />
      <Function ID="18" Name="A Effect 7" Display="'A Effect 7'" Dmx="117~123" Update="Auto_Spd" />
      <Function ID="19" Name="A Effect 8" Display="'A Effect 8'" Dmx="124~130" Update="Auto_Spd" />
      <Function ID="20" Name="A Effect 9" Display="'A Effect 9'" Dmx="131~137" Update="Auto_Spd" />
      <Function ID="21" Name="A Effect 10" Display="'A Effect 10'" Dmx="138~144" Update="Auto_Spd" />
      <Function ID="22" Name="RGB Effect 1" Display="'RGB Effect 1'" Dmx="145~151" Update="Auto_Spd" />
      <Function ID="23" Name="RGB Effect 2" Display="'RGB Effect 2'" Dmx="152~158" Update="Auto_Spd" />
      <Function ID="24" Name="RGB Effect 3" Display="'RGB Effect 3'" Dmx="159~165" Update="Auto_Spd" />
      <Function ID="25" Name="RGB Effect 4" Display="'RGB Effect 4'" Dmx="166~172" Update="Auto_Spd" />
      <Function ID="26" Name="RGB Effect 5" Display="'RGB Effect 5'" Dmx="173~179" Update="Auto_Spd" />
      <Function ID="27" Name="RGB Effect 6" Display="'RGB Effect 6'" Dmx="180~186" Update="Auto_Spd" />
      <Function ID="28" Name="RGB Effect 7" Display="'RGB Effect 7'" Dmx="187~193" Update="Auto_Spd" />
      <Function ID="29" Name="RGB Effect 8" Display="'RGB Effect 8'" Dmx="194~200" Update="Auto_Spd" />
      <Function ID="30" Name="RGB Effect 9" Display="'RGB Effect 9'" Dmx="201~207" Update="Auto_Spd" />
      <Function ID="31" Name="RGB Effect 10" Display="'RGB Effect 10'" Dmx="208~214" Update="Auto_Spd" />
      <Function ID="32" Name="RGBA Loop Effect" Display="'RGBA Loop Effect'" Dmx="215~239" Update="Auto_Spd" />
      <Function ID="33" Name="Sound 1" Display="'Sound 1'" Dmx="240~244" Update="Auto_Spd" />
      <Function ID="34" Name="Sound 2" Display="'Sound 2'" Dmx="245~249" Update="Auto_Spd" />
      <Function ID="35" Name="Sound 3" Display="'Sound 3'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1,2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;32" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="e383d155-cd89-4978-9105-17dfe0354c56">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="RGB" ChannelOffset="5" ModeLink="RGB cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Golden" ChannelOffset="8" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

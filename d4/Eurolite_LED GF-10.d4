<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED GF-10" ShortName="LED GF-10" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="31-08-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Movement" Name="Movement" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mirror+Col/Gobo" Display="'Mirror+Col/Gobo'" Dmx="0~0" />
      <Function ID="2" Name="Mirror Only" Display="'Mirror Only'" Dmx="64~127" />
      <Function ID="3" Name="Col/Gobo Only" Display="'Col/Gobo Only'" Dmx="128~191" />
      <Function ID="4" Name="No Movement" Display="'No Movement'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="EX_GF-10" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Movement" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
</Fixture>
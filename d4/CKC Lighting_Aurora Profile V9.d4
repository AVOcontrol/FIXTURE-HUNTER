      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="141~155" WheelPosition="4" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="156~170" WheelPosition="5" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="171~185" WheelPosition="6" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="186~192" WheelPosition="0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="223~193" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~225" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~128" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="192~192" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="192~192" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="255~193" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

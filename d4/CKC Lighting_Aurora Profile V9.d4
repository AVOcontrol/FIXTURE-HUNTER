  <Thumbnail>9252e62c-5647-400a-86bc-25e39146d4e1</Thumbnail>
  <History Date="27-10-21" Author="Nic Morris" Comment="Created (charts are a mess. fixed colour ranges are missing)" Version="0" />
  <History Date="30-10-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="25-08-22" Author="Nic Morris" Comment="Updated in line with latest charts (adds CTO mode control functions and macros)." Version="3" />
  <History Date="25-08-22" Author="Nic Morris" Comment="Note as the CTO mode is a fixture-level/macro option it is not possible to support this directly dynamically.  Instead a CTO Mode control has been added - this must be set manually to match the mode." Version="3" />
  <History Date="25-08-22" Author="Nic Morris" Comment="The CTO mode switching is not currently supported in Capture and will not be simulated." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="666a19e5-41d4-4bbb-ab1f-894c7999f93b" />

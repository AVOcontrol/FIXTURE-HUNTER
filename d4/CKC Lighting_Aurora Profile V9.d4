    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4,5,6,7,8,9" />
      <Condition Name="Mode 2" ID="10" If="'CTO_Mode'==2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',1800~10000" Dmx="18~100" Colour="255,240,200" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="101~120" Colour="255,255,255" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="121~140" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="141~160" Colour="255,255,255" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="161~180" Colour="255,255,255" />
      <Function ID="7" Name="7500K" Display="'7500K'" Dmx="181~200" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="201~220" Colour="255,255,255" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="10" Name="CTO C-Mix" Display="'%.fK',1800~6500" Dmx="255~0" Colour="255,255,255" />
    </Attribute>

    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Low Power" Display="'Low Power'" Dmx="30~50" />
      <Function ID="3" Name="Full Power" Display="'Full Power'" Dmx="60~80" />
      <Function ID="4" Name="Lamp Off" Display="'Lamp Off'" Dmx="100~105" />
      <Function ID="5" Name="Reset Col" Display="'Reset Col'" Dmx="120~129" />
      <Function ID="6" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="130~139" />
      <Function ID="7" Name="Reset Prism" Display="'Reset Prism'" Dmx="140~149" />
      <Function ID="8" Name="Reset Col/Gobo/Prism" Display="'Reset Col/Gobo/Prism'" Dmx="150~159" />
      <Function ID="9" Name="Lamp On" Display="'Lamp On'" Dmx="200~205" />
      <Function ID="10" Name="Reset All" Display="'Reset All'" Dmx="240~255" />
    </Attribute>
  </Control>

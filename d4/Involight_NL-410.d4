<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="NL-410" ShortName="NL-410" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="31-07-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Program 1" Display="'Program 1'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Motor_Spd" Name="Motor Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Motor_Time" Name="Motor Time" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~20" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="21~41" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="42~62" Colour="255,255,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="63~83" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="84~104" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="105~125" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="126~146" Colour="255,255,255" />
      <Function ID="8" Name="A+B" Display="'A+B'" Dmx="147~167" Colour="255,255,255" />
      <Function ID="9" Name="W+A" Display="'W+A'" Dmx="168~188" Colour="255,255,255" />
      <Function ID="10" Name="R+G+B" Display="'R+G+B'" Dmx="189~209" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="210~230" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="231~251" Colour="255,255,255" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="IVNL4105" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Macro_Spd" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Motor_Spd" ChannelOffset="4" Wheel="26" />
      <Attribute ID="Motor_Time" ChannelOffset="5" Wheel="27" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="IVNL4104" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Motor_Spd" ChannelOffset="3" Wheel="26" />
      <Attribute ID="Motor_Time" ChannelOffset="4" Wheel="27" />
    </Include>
  </Mode>
</Fixture>
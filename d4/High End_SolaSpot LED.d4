<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SolaSpot LED" ShortName="SolaSpot" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-09-10" Author="John Rogers" Comment="Created" />
  <History Date="24-09-10" Author="John Rogers" Comment="Fixed Yellow colour mix to go from 255 to 0." />
  <History Date="27-09-10" Author="John Rogers" Comment="Fixed CTO mix to go from 255 to 0." />
  <History Date="27-09-10" Author="John Rogers" Comment="Edited Closed function in Shutter to start and end at DMX 0 for use in macros." />
  <History Date="28-09-10" Author="John Rogers" Comment="Changed order of fixed colour wheel." />
  <History Date="28-09-10" Author="John Rogers" Comment="Edits made to numerous Func channels, Conditions updated accordingly." />
  <History Date="28-09-10" Author="John Rogers" Comment="Edited DMX ranges in the Control channel to match updates from High End." />
  <History Date="18-10-11" Author="John Rogers" Comment="Added Indigo attributes." />
  <History Date="02-04-12" Author="Peter Budd" Comment="Created seperate spot and indigo highlight modes." />
  <History Date="03-01-13" Author="Peter Budd" Comment="Created from High End Intellaspot XT-1" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="01-01-17" Author="Nic Morris" Comment="Changed 28 DMX mode name to match channel count (was '41 DMX')" />
  <History Date="01-01-17" Author="Nic Morris" Comment="Added Raw DMX options to Func attributes.  Tidied conditions and functions.  Increased wheel resolution." />
  <History Date="01-01-17" Author="Nic Morris" Comment="Fixed 16 bit raw range.  Changed Indigo Dim range to percentage.  Recreated palettes.  Added highlight/lowlight." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19538" ModelID="0" />
  </RDM>
  <AtlaBase TypeID="d29b0b17-6b34-4b28-9200-05d00acbc7bd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Scan" Display="'Scan'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="80~95" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1||'Colour1Func'==5" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==3||'Colour1Func'==4||'Colour1Func'==6" />
      <Condition Name="Index" ID="12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~47" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="48~79" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="80~111" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="112~143" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="144~175" Colour="255,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="176~207" Colour="255,128,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="208~239" Colour="0,255,255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="240~255" Colour="255,255,255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="11" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
      <Function ID="12" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="48~63" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="16~31" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="32~47" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Slow Scan" Display="'Slow Scan'" Dmx="64~79" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Fast Scan" Display="'Fast Scan'" Dmx="80~95" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="96~111" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Scroll" ID="9,10" If="'Gobo1Func'==3||'Gobo1Func'==4||'Gobo1Func'==7" />
      <Condition Name="Index" ID="11" If="" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="64~95" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="96~127" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="224~255" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll CW" Display="'Scroll CW'" Dmx="16~31" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="32~47" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scan" Display="'Scan'" Dmx="48~63" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="64~79" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo2" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="9,10" If="'Gobo2Func'==2||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~47" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="48~79" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="80~111" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="112~143" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="144~175" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="176~207" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="208~239" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2RotFunc" Name="Gobo 2 Rot Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="16~31" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="32~47" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="64~79" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CCW" Display="'Anim CCW'" Dmx="80~95" Update="Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2RotFunc'==1" />
      <Condition Name="Spin" ID="2,3" If="'Gobo2RotFunc'&gt;1&amp;&amp;'Gobo2RotFunc'&lt;6" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.2f%%',0.00~100.00" Dmx="1028~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="32~47" Update="Prism_Rot" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="48~63" Update="Prism_Rot" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="64~79" Update="Prism_Rot" />
      <Function ID="5" Name="Anim CCW" Display="'Anim CCW'" Dmx="80~95" Update="Prism_Rot" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Prism_Func'==1" />
      <Condition Name="Prism" ID="2,3" If="'Prism_Func'&gt;1&amp;&amp;'Prism_Func'&lt;6" />
      <Else ID="4" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="ShutterFunc" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="32~63" Update="Shutter" Intensity="0~0" />
      <Function ID="3" Name="Sync Rnd" Display="'Sync Rnd'" Dmx="64~95" Update="Shutter" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="24~229" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="MotorSpeed" Name="Motor Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f Sec',253.0~0.0" Dmx="4~255" />
      <Function ID="2" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display Off" Display="'Display Off'" Dmx="20~28" />
      <Function ID="3" Name="Display On" Display="'Display On'" Dmx="40~48" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="60~68" />
      <Function ID="5" Name="Lamp On" Display="'Lamp On'" Dmx="80~88" />
      <Function ID="6" Name="Lamp Off" Display="'Lamp Off'" Dmx="90~98" />
      <Function ID="7" Name="Shutdown" Display="'Shutdown'" Dmx="120~130" />
      <Function ID="8" Name="Reset P/T" Display="'Reset P/T'" Dmx="131~140" />
      <Function ID="9" Name="Reset Colour" Display="'Reset Colour'" Dmx="141~150" />
      <Function ID="10" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="151~160" />
      <Function ID="11" Name="Reset Int" Display="'Reset Int'" Dmx="161~170" />
      <Function ID="12" Name="Reset Other" Display="'Reset Other'" Dmx="171~180" />
      <Function ID="13" Name="Audio Sync" Display="'Audio Sync'" Dmx="181~190" />
    </Attribute>
    <Attribute ID="Indigo_Highlight" Name="Indigo Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Track Strobe" Display="'Track Strobe %.f%%',0~100" Dmx="16~41" />
      <Function ID="3" Name="Independent" Display="'Independent'" Dmx="128~143" />
      <Function ID="4" Name="Ind Strobe" Display="'Ind Strobe %.f%%',0~100" Dmx="144~169" />
    </Attribute>
    <Attribute ID="Indigo_Dim" Name="Indigo Dim" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

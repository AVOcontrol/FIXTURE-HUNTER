<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Strobe 3000" ShortName="Strobe 3K" Company="Timpani">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="27-11-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes %.f%%',0~100" Dmx="215~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKTPS3K1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="5" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKTPS3K3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKTPS3K4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Effect" ChannelOffset="4" Wheel="23" />

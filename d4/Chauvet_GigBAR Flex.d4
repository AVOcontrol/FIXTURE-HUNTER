  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8483fe78-26df-4d12-9653-3e3615b25f0e" />
  <Control>
    <Attribute ID="Auto" Name="Auto Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.1f%%',0.0~100.0" Dmx="119~10" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.1f%%',0.0~100.0" Dmx="229~120" />
      <Function ID="4" Name="Sound 1" Display="'Sound 1'" Dmx="230~234" />
      <Function ID="5" Name="Sound 2" Display="'Sound 2'" Dmx="235~239" />
      <Function ID="6" Name="Show" Display="'Show'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto Par" Display="'Auto Par'" Dmx="10~26" />
      <Function ID="3" Name="Auto Derby" Display="'Auto Derby'" Dmx="27~43" />
      <Function ID="4" Name="Auto Strobe" Display="'Auto Strobe'" Dmx="44~60" />
      <Function ID="5" Name="Auto Par+Derby" Display="'Auto Par+Derby'" Dmx="61~77" />
      <Function ID="6" Name="Auto Par+Strobe" Display="'Auto Par+Strobe'" Dmx="78~94" />
      <Function ID="7" Name="Auto Derby+Strobe" Display="'Auto Derby+Strobe'" Dmx="95~111" />
      <Function ID="8" Name="Auto All" Display="'Auto All'" Dmx="112~128" />
      <Function ID="9" Name="Sound Par" Display="'Sound Par'" Dmx="129~145" />
      <Function ID="10" Name="Sound Derby" Display="'Sound Derby'" Dmx="146~162" />
      <Function ID="11" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="163~179" />
      <Function ID="12" Name="Sound Par+Derby" Display="'Sound Par+Derby'" Dmx="180~196" />
      <Function ID="13" Name="Sound Par+Strobe" Display="'Sound Par+Strobe'" Dmx="197~213" />
      <Function ID="14" Name="Sound Derby+Strobe" Display="'Sound Derby+Strobe'" Dmx="214~230" />
      <Function ID="15" Name="Sound All" Display="'Sound All'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="8 DMX" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~239" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Derby_Rot" Name="Derby Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="PAR_Strobe" Name="PAR Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="127~127" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Derby_Col" Name="Derby Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~74" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="75~99" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="100~124" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="125~149" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="150~174" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="175~199" Colour="255,255,255" />
      <Function ID="9" Name="1 Col Auto" Display="'1 Col Auto'" Dmx="200~224" Colour="255,255,255" />
      <Function ID="10" Name="2 Col Auto" Display="'2 Col Auto'" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Derby_Strobe" Name="Derby Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Strobe_Pattern" Name="Strobe Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~29" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="30~49" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="50~69" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="70~89" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="90~109" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="110~129" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="130~149" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="150~169" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="170~189" />
      <Function ID="11" Name="All Strobe" Display="'All Strobe'" Dmx="190~209" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Strobe_Shutter" Name="Strobe Spd" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Dimmer" Name="White Strb Dim" Description="" Group="I" Size="0">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="UV_Strobe_Dim" Name="UV Strb Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="UV_Strb_Spd" Name="UV Strb Spd" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~54" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="55~255" />
    </Attribute>
    <Attribute ID="White_Strb_Spd" Name="White Strb Spd" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~54" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="55~255" />
    </Attribute>
  </Control>

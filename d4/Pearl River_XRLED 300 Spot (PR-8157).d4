      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="143~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="144~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="53199~0" GoboSpin="0~0" GoboOrientation="0~0" />

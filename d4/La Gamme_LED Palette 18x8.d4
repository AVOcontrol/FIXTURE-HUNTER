  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="(Unknown 1)" Display="'(Unknown 1)'" Dmx="10~19" Update="Shutter" />
      <Function ID="3" Name="(Unknown 2)" Display="'(Unknown 2)'" Dmx="20~29" Update="Shutter" />
      <Function ID="4" Name="(Unknown 3)" Display="'(Unknown 3)'" Dmx="30~39" Update="Shutter" />

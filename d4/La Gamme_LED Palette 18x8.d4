      <Function ID="8" Name="(Unknown 7)" Display="'(Unknown 7)'" Dmx="70~79" Update="Shutter" />
      <Function ID="9" Name="(Unknown 8)" Display="'(Unknown 8)'" Dmx="80~89" Update="Shutter" />
      <Function ID="10" Name="(Unknown 9)" Display="'(Unknown 9)'" Dmx="90~99" Update="Shutter" />

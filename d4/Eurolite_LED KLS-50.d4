  <History Date="26-10-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="83e8c986-c34f-4525-9430-0bda248596cb" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~29" Update="Red, Green" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="30~49" Update="Red, Green" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="50~69" Update="Red, Green" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="70~89" Update="Red, Green" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="90~109" Update="Red, Green" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="110~129" Update="Red, Green" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="130~149" Update="Red, Green" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="150~169" Update="Red, Green" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="170~189" Update="Red, Green" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="190~209" Update="Red, Green" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="210~229" Update="Red, Green" />
      <Function ID="13" Name="Program 0" Display="'Program 0'" Dmx="230~249" Update="Red, Green" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Running" ID="2" If="'Program'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade" ID="2" If="'Program'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~225" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="v59 Camera" ShortName="v59 Camera" Company="LightConverse">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="07-03-18" Author="Nic Morris" Comment="Created (default value for FOV doesn't make sense - 82 deg does not = DMX 80)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Center_X" Name="Center X" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Center_Y" Name="Center Y" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Distance" Name="Distance" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Z-Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:36" PowerOn="1:0" />
      <Function ID="1" Name="Ambient" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Left" Display="'Left'" Dmx="16~16" />
      <Function ID="3" Name="Right" Display="'Right'" Dmx="32~32" />
      <Function ID="4" Name="L+R = Stop" Display="'L+R = Stop'" Dmx="48~48" />
      <Function ID="5" Name="Up" Display="'Up'" Dmx="64~64" />
      <Function ID="6" Name="U+L" Display="'U+L'" Dmx="80~80" />
      <Function ID="7" Name="U+R" Display="'U+R'" Dmx="96~96" />
      <Function ID="8" Name="U+L+R = Up" Display="'U+L+R = Up'" Dmx="112~112" />
      <Function ID="9" Name="Down" Display="'Down'" Dmx="128~128" />
      <Function ID="10" Name="D+L" Display="'D+L'" Dmx="144~144" />
      <Function ID="11" Name="D+R" Display="'D+R'" Dmx="160~160" />
      <Function ID="12" Name="D+L+R = Down" Display="'D+L+R = Down'" Dmx="176~176" />
      <Function ID="13" Name="U+D = Down" Display="'U+D = Down'" Dmx="192~192" />
      <Function ID="14" Name="U+D+L = D+L" Display="'U+D+L = D+L'" Dmx="208~208" />
      <Function ID="15" Name="U+D+R = D+R" Display="'U+D+R = D+R'" Dmx="224~224" />
      <Function ID="16" Name="All = D" Display="'All = D'" Dmx="240~240" />
    </Attribute>
    <Attribute ID="Smoke" Name="Smoke" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Smoke" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FOV" Name="FOV" Description="" Group="S">
      <Locate Locate="1:82" PowerOn="1:82" />
      <Function ID="1" Name="FOV" Display="'%.1f°',1.0~156.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ROLL" Name="ROLL" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Roll" Display="'%.1f°',-360.0~360.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Wind" Name="Wind" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Wind" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gamma" Name="Gamma" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Gamma" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Exposure" Name="Exposure" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Exposure" Display="'%.1f%%',10.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="22 DMX" Channels="22">
    <Import PearlRef="UKLCV59C" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,12" Wheel="3" />
      <Attribute ID="Center_X" ChannelOffset="3,13" Wheel="19" />
      <Attribute ID="Center_Y" ChannelOffset="4,14" Wheel="20" />
      <Attribute ID="Distance" ChannelOffset="5,15" Wheel="21" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Rotate" ChannelOffset="7" Wheel="49" />
      <Attribute ID="Smoke" ChannelOffset="8" Wheel="22" />
      <Attribute ID="FOV" ChannelOffset="9" Wheel="25" />
      <Attribute ID="ROLL" ChannelOffset="10" Wheel="26" />
      <Attribute ID="Cyan" ChannelOffset="16" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="17" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="18" Wheel="12" />
      <Attribute ID="Wind" ChannelOffset="19" Wheel="23" />
      <Attribute ID="Gamma" ChannelOffset="20" Wheel="7" />
      <Attribute ID="Exposure" ChannelOffset="21" Wheel="4" />
      <Attribute ID="Iris" ChannelOffset="22" Wheel="50" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
</Fixture>
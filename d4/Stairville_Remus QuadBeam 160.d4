<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Remus QuadBeam 160" ShortName="QuadBm160" Company="Stairville" Version="2">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>fbff6526-3d50-49d8-835b-208fb70083ef</Thumbnail>
  <History Date="01-07-24" Author="Nic Morris" Comment="Created (poor documentation.  colour macros are not defined properly)" Version="0" />
  <History Date="03-07-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="04-07-24" Author="Nic Morris" Comment="Changed 8 channel mode to 7 channels in response to customer feedback (documentation is wrong)" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c8de5c32-980a-45b2-bc9a-53ae907be338" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Pulse" Display="'Rnd Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Impulse" Display="'Impulse %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="11~125" Colour="255,255,255" />
      <Function ID="3" Name="Col Change Stop" Display="'Col Change Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="4" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="5" Name="Slow Col Change" Display="'Slow Col Change %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~8000" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~3000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2" Id="367b4ef2-7314-4d9c-ba58-a52f9986d311">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="34c7e2d9-4843-46ca-aca6-3990c9a30537" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO1" ChannelOffset="2" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3" Id="c8797998-28bb-4efe-9d79-1bb2276b71ed">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2b2cb29c-8504-4dd4-8d36-a2e245adf827" />

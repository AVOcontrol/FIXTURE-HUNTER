    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="AutoFade" ID="1,2" If="'Macros'==1" />
      <Else ID="3,4" />
      <Function ID="1" Name="RGB Mix" Display="'RGB Mix'" Dmx="0~0" />
      <Function ID="2" Name="Colour Fade Speed" Display="'Colour Fade   Speed %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Macro Speed" Display="'Macro Speed   %.1f%%',0.0~100.0" Dmx="0~242" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="243~255" />
    </Attribute>

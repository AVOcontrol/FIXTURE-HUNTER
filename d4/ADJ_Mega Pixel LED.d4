<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mega Pixel Led" ShortName="Mega PLed" Company="ADJ" Version="11">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="12-02-09" Author="Jonathan Moreton" Comment="Created" Version="1" />
  <History Date="16-02-09" Author="David Hunt" Comment="Checked" Version="2" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Added Red1,Green1,Blue1 and replaced first cell in multi-cell modes." Version="3" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Fixed v-dim in 24 DMX mode.  Fixed power on and locate.  Increased wheel resolution." Version="4" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." Version="5" />
  <History Date="04-02-14" Author="Gregory Haynes" Comment="Added new cell modes without Pearl reference to avoid Visualiser multi-patching. Changed cells for all but the 24 channel mode to not have virtual dimmer." Version="6" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="7" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="8" />
  <History Date="06-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID to 3 DMX mode." Version="9" />
  <History Date="07-08-16" Author="Nic Morris" Comment="Fixed Cell + vDim mapping (previously started at offset 2 breaking the 24 DMX mode)." Version="10" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Mega Pixel LED.d4 to ADJ_Mega Pixel LED.d4." Version="11" />
  <Manual Filename="" Summary="" />

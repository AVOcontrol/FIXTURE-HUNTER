    <Attribute ID="Macros" Name="Macros" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="AutoFade" Display="'AutoFade'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="29~56" Update="Speed" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="57~85" Update="Speed" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="86~113" Update="Speed" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="114~141" Update="Speed" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="142~170" Update="Speed" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="171~198" Update="Speed" />

  <History Date="28-07-25" Author="Nic Morris" Comment="Added Ring FX functions and updated Spot Colour functions with names and swatches, added highlight/lowlight and colour palettes in response to customer feedback." Version="4" />
  <History Date="08-04-26" Author="Nic Morris" Comment="Split the spot and ring elements into cells in the 22 channel mode in response to customer feedback (the dimmer only affects the spot element)" Version="5" />

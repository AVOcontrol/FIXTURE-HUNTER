      <Function ID="13" Name="Light Blue" Display="'Light Blue'" Dmx="120~124" WheelPosition="12" Colour="50,150,255" />
      <Function ID="14" Name="CTO" Display="'CTO'" Dmx="130~134" WheelPosition="13" Colour="255,200,150" />
      <Function ID="15" Name="CTB" Display="'CTB'" Dmx="140~144" WheelPosition="14" Colour="200,225,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />

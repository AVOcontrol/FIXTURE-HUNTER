  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-02-18" Author="Nic Morris" Comment="Inverted P/T Speed in attempt to fix customer bug report.  Added product image." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="465ecdec-bd19-4d28-9910-a08840cea894" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="B+W" Display="'B+W'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="G+W" Display="'G+W'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="G+B+W" Display="'G+B+W'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="R+G+W" Display="'R+G+W'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="151~160" Colour="255,255,255" />
      <Function ID="17" Name="Snap" Display="'Snap %.f%%',0~100" Dmx="161~200" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="201~240" Colour="255,255,255" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="150~200" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="UKBLSBM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="3fced3cc-16e9-4be9-bb17-f9adfcc8a507" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="9" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="UKBLSBM2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

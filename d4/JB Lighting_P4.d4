      <Function ID="12" Name="CTB" Display="'CTB'" Dmx="44~44" WheelPosition="11" Colour="230,230,255" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="48~48" WheelPosition="12" Colour="255,240,200" />
      <Function ID="14" Name="Blue" Display="'Blue'" Dmx="52~52" WheelPosition="13" Colour="0,0,255" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="2~2" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="6~6" WheelPosition="1" Colour="255,0,0" />

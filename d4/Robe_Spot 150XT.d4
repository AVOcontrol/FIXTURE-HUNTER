      <Function ID="13" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="96~107" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="108~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

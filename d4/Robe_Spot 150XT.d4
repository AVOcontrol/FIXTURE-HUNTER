      <Function ID="17" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="132~143" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="144~155" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="156~167" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="168~179" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />

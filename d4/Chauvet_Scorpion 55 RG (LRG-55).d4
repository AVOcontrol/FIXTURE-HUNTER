  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Pattern_Sel, Dynamic_Spd, Static_Size" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic'" Dmx="11~120" Update="Pattern_Sel, Dynamic_Spd, Static_Size" />
      <Function ID="3" Name="Static" Display="'Static'" Dmx="121~250" Update="Pattern_Sel, Dynamic_Spd, Static_Size" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Pattern_Sel, Dynamic_Spd, Static_Size" />
    </Attribute>

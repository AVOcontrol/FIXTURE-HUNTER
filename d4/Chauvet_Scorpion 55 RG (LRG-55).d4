    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Speed" Name="Scan Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dynamic_Spd" Name="Dynamic Spd" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Dynamic Patterns" ID="2" If="'Mode'==2" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Static_Size" Name="Static Size" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Static Patterns" ID="2" If="'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Green &amp; Red On" Display="'Green &amp; Red On'" Dmx="0~0" Colour="255,255,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="101~200" Colour="0,255,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="201~255" Colour="255,0,0" />
    </Attribute>

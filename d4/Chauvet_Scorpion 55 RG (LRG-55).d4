  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="CH_ScLRG55" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern_Sel" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Scan_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dynamic_Spd" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Static_Size" ChannelOffset="7" Wheel="15" />
    </Include>
  </Mode>

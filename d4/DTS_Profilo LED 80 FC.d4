  <History Date="26-07-17" Author="Nic Morris" Comment="Created" />
  <History Date="17-04-18" Author="Nic Morris" Comment="Created from DTS Scena LED 80 FC (identical)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e7196f22-7d2d-42c9-a88f-48d8e4e63c33" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="120~149" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="150~179" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="180~204" />
      <Function ID="7" Name="Independent" Display="'Independent %.f%%',0~100" Dmx="205~229" />
      <Function ID="8" Name="Colour FX" Display="'Colour FX %.f%%',0~100" Dmx="230~234" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White_Preset" Name="White Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Recall" ID="1,2,3,4,5" If="'White_Func'==1" />
      <Condition Name="Create" ID="6,7,8,9,10" If="'White_Func'==2" />
      <Else ID="11,12,13" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full (RGB Full)" Display="'Full (RGB Full)'" Dmx="56~105" Colour="255,255,255" />
      <Function ID="3" Name="White DTS" Display="'White DTS'" Dmx="106~155" Colour="255,255,255" />
      <Function ID="4" Name="Custom Recall" Display="'Custom Recall'" Dmx="156~205" Colour="255,255,255" />
      <Function ID="5" Name="CTO Enabled" Display="'CTO Enabled'" Dmx="206~255" Colour="255,255,255" />
      <Function ID="6" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="7" Name="Full (RGB Full)" Display="'Full (RGB Full)'" Dmx="56~105" Colour="255,255,255" />
      <Function ID="8" Name="White DTS" Display="'White DTS'" Dmx="106~155" Colour="255,255,255" />
      <Function ID="9" Name="Custom Create" Display="'Custom Create'" Dmx="156~205" Colour="255,255,255" />
      <Function ID="10" Name="CTO Enabled" Display="'CTO Enabled'" Dmx="206~255" Colour="255,255,255" />
      <Function ID="11" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="12" Name="Full (RGB Full)" Display="'Full (RGB Full)'" Dmx="56~105" Colour="255,255,255" />
      <Function ID="13" Name="White DTS" Display="'White DTS'" Dmx="106~155" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="MacroStd" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="15~29" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="30~44" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="45~59" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="60~74" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="75~89" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="90~104" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="105~119" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="120~134" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="135~149" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="150~164" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="165~179" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="180~194" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="195~209" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="210~224" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="225~239" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="White_Func" Name="White Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Recall" Display="'Recall'" Dmx="0~0" Update="White_Preset" Colour="0,0,0" />
      <Function ID="2" Name="Create" Display="'Create'" Dmx="80~160" Update="White_Preset" Colour="0,0,0" />
      <Function ID="3" Name="Store" Display="'Store'" Dmx="161~255" Update="White_Preset" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="MacroExt" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="15~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~30" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="31~38" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="39~46" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="47~54" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="55~62" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="63~70" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="71~78" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="79~86" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="87~94" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="95~102" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="103~110" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="111~118" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="119~126" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="127~134" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="135~142" />
      <Function ID="18" Name="Scroll" Display="'Scroll'" Dmx="143~206" />
      <Function ID="19" Name="Random" Display="'Random'" Dmx="207~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func1'==1||'Gobo1Func1'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func1'==3||'Gobo1Func1'==4" />
      <Condition Name="Scroll" ID="16,17" If="'Gobo1Func1'==5||'Gobo1Func1'==6" />
      <Else ID="18" />

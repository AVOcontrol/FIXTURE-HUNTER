      <Function ID="5" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="150~169" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="170~229" />
      <Function ID="7" Name="No Function" Display="'No Function'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Gobo1Func1" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" GoboSpin="0~0" GoboOrientation="0~0" />

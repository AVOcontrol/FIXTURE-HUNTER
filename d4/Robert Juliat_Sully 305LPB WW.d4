  <History Date="16-06-23" Author="Nic Morris" Comment="Created (it is not clear what 'Master' is in the followspot modes)" Version="0" />
  <History Date="17-06-23" Author="Nic Morris" Comment="Removed followspot modes.  Added Atlabase ID's." Version="4" />
  <History Date="30-06-24" Author="Nic Morris" Comment="Changed name from Sully 305L WW to Sully 305LF WW." Version="5" />
  <History Date="30-06-24" Author="Nic Morris" Comment="Created from Robert Juliat Sully 305LF WW" Version="6" />

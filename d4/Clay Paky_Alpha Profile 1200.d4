<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Profile 1200" ShortName="AlPro1200" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>28af3e97-6c12-4e10-99e6-443ecbe5cbcb</Thumbnail>
  <History Date="04-01-07" Author="D.Milligan" Comment="Created" />
  <History Date="04-01-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="12-05-09" Author="David Hunt" Comment="Corrected DMX values" />
  <History Date="20-01-10" Author="John Rogers" Comment="Added Vector Modes and Shutter and Beam palettes." />
  <History Date="15-03-10" Author="John Rogers" Comment="Edited Pan locate value to 40%." />
  <History Date="20-07-10" Author="John Rogers" Comment="Edited blade Attribute IDs." />
  <History Date="05-01-11" Author="John Rogers" Comment="Edited Colour Function numbers." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Fixed iris range" />
  <History Date="06-04-14" Author="Nic Morris" Comment="Standardised conditionals.  Added colour function index.  Increased wheel resolution." />
  <History Date="06-04-14" Author="Nic Morris" Comment="Standardised shutter and changed power on value.  Inverted iris wheel direction and changed locate to open." />
  <History Date="06-04-14" Author="Nic Morris" Comment="Changed colour11 split functions to text only.  Standardised scroll and spin ranges." />
  <History Date="06-04-14" Author="Nic Morris" Comment="Fixed Gobo2Rot raw 16 bit range.  Fixed duplicate ID's in else conditions." />
  <History Date="06-04-14" Author="Nic Morris" Comment="Changed pan to locate at 50 percent in response to customer bug report." />
  <History Date="06-04-14" Author="Nic Morris" Comment="Changed reset functions to text only.  Recreated macros and palettes" />
  <History Date="06-04-14" Author="Nic Morris" Comment="Added missing effect func to 16 bit modes." />
  <History Date="10-04-14" Author="Nic Morris" Comment="Fixed duplicate range in gobo rotate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-06-17" Author="Nic Morris" Comment="Temporarily changed RainOFF Atlabase ID's to match RainON (previously were RGB versions)." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Changed mode names to reflect settings more clearly." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Fixed colour index range in RainON modes.  Added discreet colour index functions." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Revised speed controls.  Recreated palettes.  Moved blade controls into beam group and wheel slot." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Inverted zoom." />
  <History Date="13-06-17" Author="Nic Morris" Comment="Revised Atlabase ID's for RainOFF modes." />
  <History Date="06-03-19" Author="Nic Morris" Comment="Added gobo swatches" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="17ad355e-4e68-4a00-9b0b-28a4a8592ebb" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="23,24" If="'Colour1Func'==4" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~18" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="36~36" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="54~54" WheelPosition="3" Colour="238,130,238" />

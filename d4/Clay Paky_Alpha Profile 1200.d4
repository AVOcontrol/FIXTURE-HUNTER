      <Function ID="11" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="63~63" WheelPosition="3" Colour="238,130,238" />
      <Function ID="12" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="81~81" WheelPosition="4" Colour="0,255,0" />
      <Function ID="13" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="99~99" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="117~117" WheelPosition="6" Colour="0,0,255" />
      <Function ID="15" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="18~36" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel - Vlt" Display="'Yel - Vlt %.f%%',0~100" Dmx="36~54" WheelPosition="2" Colour="255,255,0" />
      <Function ID="18" Name="Vlt - Grn" Display="'Vlt - Grn %.f%%',0~100" Dmx="54~72" WheelPosition="3" Colour="238,130,238" />
      <Function ID="19" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="72~90" WheelPosition="4" Colour="0,255,0" />
      <Function ID="20" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="90~108" WheelPosition="5" Colour="255,128,0" />
      <Function ID="21" Name="Blu - Op" Display="'Blu - Op %.f%%',0~100" Dmx="108~127" WheelPosition="6" Colour="0,0,255" />
      <Function ID="22" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

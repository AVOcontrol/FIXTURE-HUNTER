      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="90~90" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="108~108" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="9~9" WheelPosition="0" Colour="255,255,255" />

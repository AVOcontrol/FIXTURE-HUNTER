  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3088de39-cc31-4212-b5d7-fe7a17c6aadd" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="7,8,9,10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Shake" ID="14,15,16,17,18,19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Condition Name="Random" ID="24,25" If="'Colour1Func'==5" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~7" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="8~11" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="12~15" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="16~19" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="CTO 4000K" Display="'CTO 4000K'" Dmx="20~23" WheelPosition="5" Colour="255,240,200" />
      <Function ID="7" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="24~41" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Rd - Grn" Display="'Rd - Grn %.f%%',0~100" Dmx="41~58" WheelPosition="1" Colour="255,0,0" />
      <Function ID="9" Name="Grn - Blu" Display="'Grn - Blu %.f%%',0~100" Dmx="58~75" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="Blu - Yel" Display="'Blu - Yel %.f%%',0~100" Dmx="75~92" WheelPosition="3" Colour="0,0,255" />
      <Function ID="11" Name="Yel - CTO" Display="'Yel - CTO %.f%%',0~100" Dmx="92~109" WheelPosition="4" Colour="255,255,0" />
      <Function ID="12" Name="CTO - Op" Display="'CTO - Op %.f%%',0~100" Dmx="109~126" WheelPosition="5" Colour="255,240,200" />
      <Function ID="13" Name="Index" Display="'Index %.f%%',0~100" Dmx="24~126" Colour="0,0,0" />
      <Function ID="14" Name="Op Shake" Display="'Op Shake %.f%%',0~100" Dmx="128~137" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Rd Shake" Display="'Rd Shake %.f%%',0~100" Dmx="138~147" WheelPosition="1" Colour="255,0,0" />
      <Function ID="16" Name="Grn Shake" Display="'Grn Shake %.f%%',0~100" Dmx="148~157" WheelPosition="2" Colour="0,255,0" />
      <Function ID="17" Name="Blu Shake" Display="'Blu Shake %.f%%',0~100" Dmx="158~167" WheelPosition="3" Colour="0,0,255" />
      <Function ID="18" Name="Yel Shake" Display="'Yel Shake %.f%%',0~100" Dmx="168~177" WheelPosition="4" Colour="255,255,0" />
      <Function ID="19" Name="CTO Shake" Display="'CTO Shake %.f%%',0~100" Dmx="178~187" WheelPosition="5" Colour="255,240,200" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="215~216" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~214" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="215~216" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="217~239" Colour="0,0,0" />
      <Function ID="24" Name="Stop" Display="'Stop'" Dmx="240~240" Colour="0,0,0" />
      <Function ID="25" Name="Random" Display="'Random %.f%%',0~100" Dmx="241~255" Colour="0,0,0" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Random Index" Display="'Random Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="8" Name="Random Spin" Display="'Random Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="5,6,7,8" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Random" ID="13,14" If="'Gobo1Func'==7||'Gobo1Func'==8" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>a8785bc8-7d3d-4438-97d4-5334b08c87b4</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~11" WheelPosition="1">
        <Swatch>170a5c9b-58e7-4da7-99a7-b0d09bba465e</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="12~17" WheelPosition="2">
        <Swatch>6da0b9f1-7a25-4619-b55c-8602563d3e94</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="18~23" WheelPosition="3">
        <Swatch>9e965aac-9ee7-49e7-9266-c01fcda5076d</Swatch>
      </Function>
      <Function ID="5" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="128~143" WheelPosition="0">
        <Swatch>a8785bc8-7d3d-4438-97d4-5334b08c87b4</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="144~159" WheelPosition="1">
        <Swatch>170a5c9b-58e7-4da7-99a7-b0d09bba465e</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="160~175" WheelPosition="2">
        <Swatch>6da0b9f1-7a25-4619-b55c-8602563d3e94</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="176~191" WheelPosition="3">
        <Swatch>9e965aac-9ee7-49e7-9266-c01fcda5076d</Swatch>
      </Function>
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~215" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="216~239" />
      <Function ID="13" Name="Stop" Display="'Stop'" Dmx="240~240" />
      <Function ID="14" Name="Random" Display="'Random %.f%%',0~100" Dmx="241~255" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="3:100" PowerOn="3:100" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5||'Gobo1Func'==7" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6||'Gobo1Func'==8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32767" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49151~49152" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32768~49150" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49151~49152" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49513~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Animation_Func" Name="Animation Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Animation" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Animation" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="0~0" Update="Animation" />
      <Function ID="4" Name="Custom" Display="'Custom'" Dmx="0~0" Update="Animation" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Animation_Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Animation_Func'==2" />
      <Condition Name="Bounce" ID="6" If="'Animation_Func'==3" />
      <Condition Name="Custom" ID="7,8,9,10,11,12,13,14" If="'Animation_Func'==4" />
      <Else ID="15" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~16383" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="24575~24576" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="16384~24574" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32768~32768" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="24577~32767" />
      <Function ID="6" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="7" Name="Slot 1" Display="'Slot 1'" Dmx="49152~51199" />
      <Function ID="8" Name="Slot 2" Display="'Slot 2'" Dmx="51200~53247" />
      <Function ID="9" Name="Slot 3" Display="'Slot 3'" Dmx="53248~55295" />
      <Function ID="10" Name="Slot 4" Display="'Slot 4'" Dmx="55296~57343" />
      <Function ID="11" Name="Slot 5" Display="'Slot 5'" Dmx="57344~59391" />
      <Function ID="12" Name="Slot 6" Display="'Slot 6'" Dmx="59392~61439" />
      <Function ID="13" Name="Slot 7" Display="'Slot 7'" Dmx="61440~63487" />
      <Function ID="14" Name="Slot 8" Display="'Slot 8'" Dmx="63488~65535" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />

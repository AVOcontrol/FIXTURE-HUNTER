    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="4~6" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="7~8" />
      <Function ID="4" Name="FWD" Display="'FWD %.f%%',0~100" Dmx="9~70" />
      <Function ID="5" Name="REV" Display="'REV %.f%%',0~100" Dmx="71~131" />
      <Function ID="6" Name="FWD Strobe" Display="'FWD Strobe %.f%%',0~100" Dmx="132~193" />
      <Function ID="7" Name="REV Strobe" Display="'REV Strobe %.f%%',0~100" Dmx="194~255" />

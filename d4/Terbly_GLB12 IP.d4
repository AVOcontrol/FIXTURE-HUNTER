<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GLB12 IP" ShortName="GLB12 IP" Company="Terbly" Version="24">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="03-04-19" Author="Nic Morris" Comment="Created (limited information. missing CTC and FX tables. guessed pixel layout. note number of modes, mode names and channel counts in 'Elation Rayzor760 DMX Layout Rev4' chart provided currently do not correlate with Capture)" Version="1" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Revised zoom and added enable/reset zoom limit control functions and macros in line with 'Elation Rayzor760 DMX-traits V3' document." Version="2" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Revised pixel layout in line with 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="3" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Added colour function names in line with v1.1.1F charts from 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="4" />
  <History Date="30-04-19" Author="Nic Morris" Comment="Added FX functions in line with v1.1.1F charts from 'ELATION RAYZOR 760 - DMX CHANNELS CONSOLE PATCHING GUIDELINES' document." Version="5" />
  <History Date="01-05-19" Author="Nic Morris" Comment="Added Atlabase mode ID's to Standard, RGB Pixels and Extended modes (V4).  Multi-part not currently supported.  SparkLED not in latest charts (the documentation is a nightmare)" Version="6" />
  <History Date="28-05-21" Author="Nic Morris" Comment="Created from Elation Rayzor 760" Version="7" />
  <History Date="10-08-22" Author="Nic Morris" Comment="Created from Elation Proteus Rayzor 760" Version="8" />
  <History Date="02-09-22" Author="Nic Morris" Comment="Created from Elation Proteus Rayzor Blade S (charts contain errors.  pixel plus mode is missing channels 18 to 65 and 72 to 135.  made best guess)." Version="14" />
  <History Date="11-10-22" Author="Nic Morris" Comment="Created from Elation Proteus Rayzor Blade L" Version="20" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="RGBW_Shutter" Name="RGBW Shutter" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COB LED Blinder Tri" ShortName="LED Blind" Company="Neo Neon">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="06-03-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="15~57" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="58~105" Intensity="0~0" />
      <Function ID="5" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="106~153" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="154~201" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="202~249" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="30~59" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="60~89" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="90~119" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="120~149" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="150~179" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="180~209" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="210~239" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer2" Name="Dimmer 2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer3" Name="Dimmer 3" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer4" Name="Dimmer 4" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="NNLEDBL4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer1" ChannelOffset="1" Wheel="34" />
      <Attribute ID="Dimmer2" ChannelOffset="2" Wheel="35" />
      <Attribute ID="Dimmer3" ChannelOffset="3" Wheel="36" />
      <Attribute ID="Dimmer4" ChannelOffset="4" Wheel="64" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Dimmer cell, 1 DMX" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Dimmer cell, 1 DMX" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Dimmer cell, 1 DMX" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Dimmer cell, 1 DMX" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="NNLEDBL9" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer1" ChannelOffset="3" Wheel="34" />
      <Attribute ID="Dimmer2" ChannelOffset="4" Wheel="35" />
      <Attribute ID="Dimmer3" ChannelOffset="5" Wheel="36" />
      <Attribute ID="Dimmer4" ChannelOffset="6" Wheel="64" />
      <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
      <Attribute ID="Fade" ChannelOffset="9" Wheel="26" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
        <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
        <Attribute ID="Fade" ChannelOffset="9" Wheel="26" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Dimmer cell, 1 DMX" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Dimmer cell, 1 DMX" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Dimmer cell, 1 DMX" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="Dimmer cell, 1 DMX" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dimmer cell, 1 DMX" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b4256118-6ff8-45db-add5-6cdeec1dd70f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lens_Rot" Name="Lens Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="101~133" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~195" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="195~134" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="Pastel Red" Display="'Pastel Red'" Dmx="51~60" Colour="255,100,100" />
      <Function ID="7" Name="Pastel Green" Display="'Pastel Green'" Dmx="61~70" Colour="128,255,0" />
      <Function ID="8" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="71~80" Colour="0,128,255" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="81~90" Colour="255,255,0" />
      <Function ID="10" Name="Cyan" Display="'Cyan'" Dmx="91~100" Colour="0,255,255" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="101~110" Colour="255,0,255" />
      <Function ID="12" Name="Pastel Yellow" Display="'Pastel Yellow'" Dmx="111~120" Colour="255,255,128" />
      <Function ID="13" Name="Pastel Cyan" Display="'Pastel Cyan'" Dmx="121~130" Colour="128,255,255" />
      <Function ID="14" Name="Pastel Magenta" Display="'Pastel Magenta'" Dmx="131~140" Colour="255,128,255" />
      <Function ID="15" Name="White (RGBW)" Display="'White (RGBW)'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="151~200" Colour="255,255,255" />
      <Function ID="17" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="201~247" Colour="255,255,255" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom_Macro" Name="Zoom Macro" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="10~39" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="40~69" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="70~99" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="100~129" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="130~159" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="160~189" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="190~219" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~60" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="61~100" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="101~140" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="141~180" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fast Speed" Display="'Fast Speed'" Dmx="51~100" />
      <Function ID="3" Name="Slow Speed" Display="'Slow Speed'" Dmx="151~200" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="201~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin BMFL Spot" ShortName="BMFL Spot" Company="Robe" Version="29">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>6cfe8a9f-3f51-47d8-9491-3b264ea83acf</Thumbnail>
  <History Date="05-03-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="08-03-14" Author="Nic Morris" Comment="Updated to latest documentation" Version="2" />
  <History Date="14-05-14" Author="Nic Morris" Comment="Re-saving to fix Iris 16-bit values in response to manufacturer report." Version="3" />
  <History Date="14-05-14" Author="Nic Morris" Comment="Updated to latest documentation (0.91) and added physical P/T limits." Version="4" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Added graphic display on/off control functions and associated macros in line with 0.92 spec." Version="5" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Updated graphic rot and gobo rot ranges and locate in line with 0.92 spec." Version="6" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Upated graphic anim functions to 0.92 spec." Version="7" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Updated frost functions to 0.92 spec." Version="8" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Added Zap function to shutter in line with 0.92 spec." Version="9" />
  <History Date="15-07-14" Author="Nic Morris" Comment="Updated control to 0.93 spec and added macros.  Updated prism rot function and locate values to 0.93 spec" Version="10" />
  <History Date="15-07-14" Author="Nic Morris" Comment="Updated shutter reducted power mode to read '1100W' in line with 0.93 spec." Version="11" />
  <History Date="18-08-14" Author="Nic Morris" Comment="Updated in line with 0.94 spec." Version="12" />
  <History Date="29-08-14" Author="Nic Morris" Comment="Updated in line with 0.96 spec." Version="13" />
  <History Date="14-10-15" Author="Gregory Haynes" Comment="Added Open/No Scroll functions to Gobo and Colour conditions" Version="14" />
  <History Date="29-10-15" Author="Nic Morris" Comment="Changed fixed colour wheels to locate at zero (index) in attempt to fix OW bug report." Version="15" />
  <History Date="15-04-16" Author="Nic Morris" Comment="Renamed control function and associated macro from 'silent' to 'quiet' in response to manufacturer request." Version="16" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="17" />
  <History Date="08-11-16" Author="Nic Morris" Comment="Added Home Pos control functions and macros in line with v1.3 documentation in response to manufacturer request." Version="18" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Reverted colour locate back to fixed in attempt to fix exchange issues.  Changed colour open to locate at zero." Version="19" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Renamed 'Graphic Position' to 'Graphic Pos' to comply with 14 char attribute name limit." Version="20" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Corrected colour 1 blue index value.  Revised Colour Macro in line with latest spec and moved into colour group and wheel slot." Version="21" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Revised colour index ranges so that each can achieve a complete transition." Version="22" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Added conditional options to prism rot in response to manufacturer information." Version="23" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Changed zoom to locate at 50%." Version="24" />
  <History Date="12-08-17" Author="Nic Morris" Comment="Added LightMaster (LM)/ RoboSpot (RS) control functions and macros in reponse to manufacturer request." Version="25" />
  <History Date="01-09-17" Author="Nic Morris" Comment="Minor revision to LM/RS control function and macro names." Version="26" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Added product thumbnail" Version="27" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Added gobo swatches" Version="28" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="29" />
  <Manual Filename="" Summary="" />

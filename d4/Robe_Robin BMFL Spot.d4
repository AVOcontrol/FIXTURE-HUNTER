      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~32896" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33153~65535" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1989d127-516a-4e69-9c0a-3ee05ba95fee" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~80" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="81~160" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="161~240" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Dimmer" Display="'Reset Dimmer'" Dmx="8~15" />
      <Function ID="3" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="16~23" />
      <Function ID="4" Name="Dim Linear" Display="'Dim Linear'" Dmx="24~31" />
      <Function ID="5" Name="Dim Square" Display="'Dim Square'" Dmx="32~39" />
      <Function ID="6" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="40~47" />
      <Function ID="7" Name="Dim Spd Off" Display="'Dim Spd Off'" Dmx="48~55" />
      <Function ID="8" Name="Dim Spd 1" Display="'Dim Spd 1'" Dmx="56~63" />
      <Function ID="9" Name="Dim Spd 2" Display="'Dim Spd 2'" Dmx="64~71" />
      <Function ID="10" Name="Dim Spd 3" Display="'Dim Spd 3'" Dmx="72~79" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~87" />
      <Function ID="12" Name="Fan On" Display="'Fan On'" Dmx="88~95" />
      <Function ID="13" Name="Fan Off" Display="'Fan Off'" Dmx="96~103" />
      <Function ID="14" Name="Fan Silent" Display="'Fan Silent'" Dmx="104~111" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Starcolor 135" ShortName="Starcol135" Company="BeamZ" Version="3">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="04-06-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="06-06-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0fe4918c-c0df-49da-b47c-9b5a6db397a2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'All Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="21~30" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~40" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="41~50" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="51~60" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="61~70" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="71~80" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="81~90" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="91~100" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="101~110" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="111~120" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="No Curve" Display="'No Curve'" Dmx="6~55" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="56~105" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="106~155" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="156~205" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Macro1" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Macro_Spd1" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="51~100" Update="Macro_Spd1" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="101~109" Update="Macro_Spd1" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="110~119" Update="Macro_Spd1" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="120~129" Update="Macro_Spd1" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="130~139" Update="Macro_Spd1" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="140~149" Update="Macro_Spd1" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="150~159" Update="Macro_Spd1" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="160~169" Update="Macro_Spd1" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="170~179" Update="Macro_Spd1" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="180~189" Update="Macro_Spd1" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="190~199" Update="Macro_Spd1" />
    </Attribute>
    <Attribute ID="Macro_Spd1" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Col" ID="2" If="'Macro1'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="c8cc6546-11ca-4620-baaa-4a9b792c5894">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

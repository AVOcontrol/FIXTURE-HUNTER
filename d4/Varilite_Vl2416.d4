  <History Date="16-12-02" Author="D.Shelton" Comment="Updated referencing of 16-bit channels" Version="2" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" Version="3" />
  <History Date="10-06-03" Author="D.Shelton" Comment="Updated Personality" Version="4" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" Version="5" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" Version="6" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. Dimmer - (Power On) 0" Version="7" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. CYM - No control (Locate)" Version="8" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Beam Shape - No info on whether functions are correct but works on console" Version="9" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 5. Control - Lamp on is legended as control" Version="10" />
  <History Date="16-02-04" Author="Oliver Waits" Comment="Edited - Colour Mix IDs started on 2" Version="11" />
  <History Date="16-02-04" Author="Oliver Waits" Comment="Edited - Added Macros" Version="12" />
  <History Date="15-10-04" Author="Phil Rogers" Comment="Edited - Revised timing tables to incude proper values" Version="13" />
  <History Date="07-07-06" Author="Ed" Comment="Fixed Colour mixing attributes to all be CMIXES" Version="14" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" Version="15" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" Version="16" />
  <History Date="02-07-07" Author="D.Milligan" Comment="Inverted CMY after discussions with PRG" Version="17" />
  <History Date="01-02-10" Author="John Rogers" Comment="Added palettes." Version="18" />
  <History Date="02-07-11" Author="Nic Morris" Comment="Standardised highlight.  Standardised and fixed shutter." Version="19" />
  <History Date="02-07-11" Author="Nic Morris" Comment="Standardised and fixed beam shaper spin" Version="20" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="21" />
  <History Date="16-07-22" Author="Nic Morris" Comment="Normalised the CMY controls in response to customer feedback (tested against real-world fixtures).  Not sure why PRG had said they are inverted (the documentation is vague)." Version="22" />
  <History Date="16-07-22" Author="Nic Morris" Comment="Standardised dimmer function name (was intensity).  Added shutter and frost palettes.  Added product thumbnail." Version="22" />

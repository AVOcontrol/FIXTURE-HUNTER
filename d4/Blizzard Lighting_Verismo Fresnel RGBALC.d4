    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2400-2700K" Display="'2400-2700K %.fK',2400~2700" Dmx="1~96" Colour="255,240,200" />
      <Function ID="3" Name="2700K" Display="'2700K'" Dmx="97~98" Colour="255,240,200" />
      <Function ID="4" Name="2700-3000K" Display="'2700-3000K %.fK',2700~3000" Dmx="99~112" Colour="255,240,200" />
      <Function ID="5" Name="3000K" Display="'3000K'" Dmx="113~114" Colour="255,240,200" />
      <Function ID="6" Name="3000-3200K" Display="'3000-3200K %.fK',3000~3200" Dmx="115~126" Colour="255,240,200" />
      <Function ID="7" Name="3200K" Display="'3200K'" Dmx="127~129" Colour="255,240,200" />
      <Function ID="8" Name="3200-3800K" Display="'3200-3800K %.fK',3200~3800" Dmx="130~169" Colour="255,240,200" />
      <Function ID="9" Name="3800K" Display="'3800K'" Dmx="170~171" Colour="255,240,200" />
      <Function ID="10" Name="3800-4900K" Display="'3800-4900K %.fK',3800~4900" Dmx="172~218" Colour="255,240,200" />
      <Function ID="11" Name="4900K" Display="'4900K'" Dmx="219~220" Colour="255,240,200" />
      <Function ID="12" Name="4900-5200K" Display="'4900-5200K %.fK',4900~5200" Dmx="221~226" Colour="255,240,200" />
      <Function ID="13" Name="5200K" Display="'5200K'" Dmx="227~228" Colour="255,240,200" />
      <Function ID="14" Name="5200-6500K" Display="'5200-6500K %.fK',5200~6500" Dmx="229~254" Colour="255,240,200" />
      <Function ID="15" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Low" Display="'Low'" Dmx="31~60" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="61~90" />
      <Function ID="4" Name="High" Display="'High'" Dmx="91~255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

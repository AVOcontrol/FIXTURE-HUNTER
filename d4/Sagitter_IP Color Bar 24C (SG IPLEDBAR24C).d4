<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IP Color Bar 24C (SG IPLEDBAR24C)" ShortName="IPColBr24C" Company="Sagitter" Version="3">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>ccb7c0f1-4933-4602-bb19-d381f7ccf6a2</Thumbnail>
  <History Date="23-04-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-04-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="04-08-21" Author="Nic Morris" Comment="Added 7 channel mode in response to customer feedback (not currently listed in digital documentation)" Version="2" />
  <History Date="04-08-21" Author="Nic Morris" Comment="Note channel 7 in 7 channel mode refers to the 3 channel mode for details but these don't provide any function that would allow colour mixing.  Added an open range and made best guess." Version="2" />
  <History Date="06-08-21" Author="Nic Morris" Comment="Added Atlabase ID for 7 channel mode." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="596cb9e9-58b7-450e-beaa-f31c94b339c0" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Update="Shutter1" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="10~19" Update="Shutter1" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="20~29" Update="Shutter1" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="30~39" Update="Shutter1" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~49" Update="Shutter1" Colour="255,255,255" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="50~59" Update="Shutter1" Colour="255,255,255" />
      <Function ID="7" Name="B+W" Display="'B+W'" Dmx="60~69" Update="Shutter1" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="70~79" Update="Shutter1" Colour="255,255,255" />
      <Function ID="9" Name="G+W" Display="'G+W'" Dmx="80~89" Update="Shutter1" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="90~99" Update="Shutter1" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="100~109" Update="Shutter1" Colour="255,255,255" />
      <Function ID="12" Name="G+B+W" Display="'G+B+W'" Dmx="110~119" Update="Shutter1" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="120~129" Update="Shutter1" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="130~139" Update="Shutter1" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="140~149" Update="Shutter1" Colour="255,255,255" />
      <Function ID="16" Name="CFade" Display="'CFade'" Dmx="150~159" Update="Shutter1" Colour="255,255,255" />
      <Function ID="17" Name="Meteor" Display="'Meteor'" Dmx="160~169" Update="Shutter1" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade'" Dmx="170~179" Update="Shutter1" Colour="255,255,255" />
      <Function ID="19" Name="Change" Display="'Change'" Dmx="180~189" Update="Shutter1" Colour="255,255,255" />
      <Function ID="20" Name="Flow1" Display="'Flow1'" Dmx="190~199" Update="Shutter1" Colour="255,255,255" />
      <Function ID="21" Name="Flow2" Display="'Flow2'" Dmx="200~209" Update="Shutter1" Colour="255,255,255" />
      <Function ID="22" Name="Flow3" Display="'Flow3'" Dmx="210~219" Update="Shutter1" Colour="255,255,255" />
      <Function ID="23" Name="Flow4" Display="'Flow4'" Dmx="220~229" Update="Shutter1" Colour="255,255,255" />
      <Function ID="24" Name="Flow5" Display="'Flow5'" Dmx="230~239" Update="Shutter1" Colour="255,255,255" />
      <Function ID="25" Name="Flow6" Display="'Flow6'" Dmx="240~255" Update="Shutter1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3,4" If="'Colour_Macro'&gt;15||'Colour_Macro1'&gt;16" />
      <Else ID="1,2" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="9~255" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter1" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="9~9" Update="Shutter1" Colour="255,0,0" />

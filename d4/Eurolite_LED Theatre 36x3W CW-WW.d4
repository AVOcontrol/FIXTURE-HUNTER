  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1772abb9-0728-4094-a4e7-23ddfa8b30d0" />
  <Control>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Temp 1" Display="'Col Temp 1'" Dmx="1~15" Colour="255,255,255" />
      <Function ID="3" Name="Col Temp 2" Display="'Col Temp 2'" Dmx="16~30" Colour="255,255,255" />
      <Function ID="4" Name="Col Temp 3" Display="'Col Temp 3'" Dmx="31~45" Colour="255,255,255" />
      <Function ID="5" Name="Col Temp 4" Display="'Col Temp 4'" Dmx="46~60" Colour="255,255,255" />
      <Function ID="6" Name="Col Temp 5" Display="'Col Temp 5'" Dmx="61~75" Colour="255,255,255" />
      <Function ID="7" Name="Col Temp 6" Display="'Col Temp 6'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="8" Name="Col Temp 7" Display="'Col Temp 7'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="9" Name="Col Temp 8" Display="'Col Temp 8'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="10" Name="Col Temp 9" Display="'Col Temp 9'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="11" Name="Col Temp 10" Display="'Col Temp 10'" Dmx="136~150" Colour="255,255,255" />
      <Function ID="12" Name="Col Temp 11" Display="'Col Temp 11'" Dmx="151~165" Colour="255,255,255" />
      <Function ID="13" Name="Col Temp 12" Display="'Col Temp 12'" Dmx="166~180" Colour="255,255,255" />
      <Function ID="14" Name="Col Temp 13" Display="'Col Temp 13'" Dmx="181~195" Colour="255,255,255" />
      <Function ID="15" Name="Col Temp 14" Display="'Col Temp 14'" Dmx="196~210" Colour="255,255,255" />
      <Function ID="16" Name="Col Temp 15" Display="'Col Temp 15'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="17" Name="Col Temp 16" Display="'Col Temp 16'" Dmx="226~240" Colour="255,255,255" />
      <Function ID="18" Name="Col Temp 17" Display="'Col Temp 17'" Dmx="241~255" Colour="255,255,255" />

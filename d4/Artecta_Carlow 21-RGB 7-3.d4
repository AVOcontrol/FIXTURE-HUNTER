    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="30~59" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="60~89" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="90~119" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="120~149" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="150~179" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="180~209" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="210~255" />

      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="144~150" WheelPosition="10" />
      <Function ID="26" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="151~157" WheelPosition="11" />

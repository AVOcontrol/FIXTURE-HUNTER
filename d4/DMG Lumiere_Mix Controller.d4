<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mix Controller" ShortName="Mix Ctrl" Company="DMG Lumiere">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="29-10-18" Author="Nic Morris" Comment="Created (note CTC and Green/ Magenta functions not defined and there are two CRMX unlink control functions)" />
  <History Date="29-10-18" Author="Nic Morris" Comment="FX DMX ranges are not properly defined in the charts and look wrong.  Used best guess for safest values." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

  <AtlaBase TypeID="c2237c7d-5782-4458-bd89-f202824985cd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M" Name="G/M" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.f%%',99~1" Dmx="21~119" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',1~99" Dmx="146~244" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xFade_CCT-&gt;Col" Name="xFade CCT-&gt;Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Hue" Display="'%.f°',1~360" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Lightning" ID="3,4,5" If="'FX_Selection'==2" />
      <Function ID="1" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="255~255" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="4" Name="Trigger" Display="'Trigger'" Dmx="10~69" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="70~255" />
    </Attribute>
    <Attribute ID="FX_Selection" Name="FX Selection" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="2" Name="Lightning" Display="'Lightning'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="4" Name="Fire" Display="'Fire'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="5" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="7" Name="Cop Car" Display="'Cop Car'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="8" Name="Party Lights" Display="'Party Lights'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="9" Name="Fireworks" Display="'Fireworks'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
    </Attribute>
    <Attribute ID="FX_Param_2" Name="FX Param 2" Description="" Group="E">
      <Locate Locate="2:2700" PowerOn="2:2700" />
      <Else ID="1" />
      <Condition Name="Paparazzi" ID="2" If="'FX_Selection'==1" />
      <Condition Name="Lightning" ID="3" If="'FX_Selection'==2" />
      <Condition Name="TV" ID="4,5,6" If="'FX_Selection'==3" />
      <Condition Name="Fire" ID="7,8,9" If="'FX_Selection'==4" />
      <Condition Name="Faulty Bulb" ID="10,11" If="'FX_Selection'==5" />
      <Condition Name="Pulsing" ID="12,13" If="'FX_Selection'==6" />
      <Condition Name="Cop Car" ID="14,15,16,17,18" If="'FX_Selection'==7" />
      <Condition Name="Party Lights" ID="19" If="'FX_Selection'==8" />
      <Condition Name="Fireworks" ID="20,21,22" If="'FX_Selection'==9" />
      <Function ID="1" Name="No Effect" Display="''" Dmx="0~0" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Update="FX_Param_3, FX_Param_4, FX_Param_5" />

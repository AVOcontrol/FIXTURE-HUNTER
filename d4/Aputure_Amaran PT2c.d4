      <Function ID="14" Name="Col Combination: Red" Display="'Col Combination: Red'" Dmx="0~0" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="15" Name="Col Combination: Blue" Display="'Col Combination: Blue'" Dmx="10~19" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="16" Name="Col Combination: Red+Blue" Display="'Col Combination: Red+Blue'" Dmx="20~29" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="17" Name="Col Combination: Blue+White" Display="'Col Combination: Blue+White'" Dmx="30~39" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="18" Name="Col Combination: Red+Blue+White" Display="'Col Combination: Red+Blue+White'" Dmx="40~49" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="19" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="20" Name="Col Combination: CCT" Display="'Col Combination: CCT'" Dmx="0~0" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="21" Name="Col Combination: HUE" Display="'Col Combination: HUE'" Dmx="10~19" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="22" Name="Col Combination: CCT+HUE" Display="'Col Combination: CCT+HUE'" Dmx="20~29" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Vega Halo 90" ShortName="VegaHalo90" Company="Lightmaxx" Version="3">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>244ab314-cb8e-4eb5-890a-26b85ca37588</Thumbnail>
  <History Date="01-06-18" Author="Nic Morris" Comment="Created (note 16 channel mode not included as charts incomplete.  charts also have some range conflicts)" Version="1" />
  <History Date="05-06-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="07-08-26" Author="Nic Morris" Comment="Added 16 channel mode." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="30934a0a-69fd-437b-a6c5-73870edc6191" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="14~22" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="32~40" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="50~58" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="68~76" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="86~94" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="104~112" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="122~130" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Op/ 1" Display="'Op/ 1'" Dmx="5~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="1/ 2" Display="'1/ 2'" Dmx="23~31" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="2/ 3" Display="'2/ 3'" Dmx="41~49" WheelPosition="2" Colour="0,0,0" />
      <Function ID="12" Name="3/ 4" Display="'3/ 4'" Dmx="59~67" WheelPosition="3" Colour="0,0,0" />
      <Function ID="13" Name="4/ 5" Display="'4/ 5'" Dmx="77~85" WheelPosition="4" Colour="0,0,0" />
      <Function ID="14" Name="5/ 6" Display="'5/ 6'" Dmx="95~103" WheelPosition="5" Colour="0,0,0" />
      <Function ID="15" Name="6/ 7" Display="'6/ 7'" Dmx="113~121" WheelPosition="6" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="195~199" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~194" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="195~199" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Gobo1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~28" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="29~49" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="50~70" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="71~91" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="92~112" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="113~133" WheelPosition="6" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="134~194" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="130~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~134" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~47" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="48~87" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="88~127" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="128~167" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="168~207" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="208~247" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~32" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="33~58" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="59~84" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="85~110" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="111~136" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="137~162" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="163~188" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="189~214" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="215~240" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>

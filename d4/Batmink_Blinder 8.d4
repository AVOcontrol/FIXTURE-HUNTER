<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Blinder 8" ShortName="Blinder8" Company="Batmink">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="21-12-07" Author="Ion Balan" Comment="Created" />
  <History Date="21-12-07" Author="Ion Balan" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="09-09-11" Author="Nic Morris" Comment="Aligned attribute ID numbers with attribute name numbers.  Added Red,Green,Blue and replaced in single cell modes." />
  <History Date="09-09-11" Author="Nic Morris" Comment="Added palettes.  Added pixel mapper compatibility." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Changed cell layout to be more like a 4-cell blinder might be." />
  <History Date="22-01-13" Author="Peter Budd" Comment="Removed virtual dimmer from RGB Cell, 3 DMX" />
  <History Date="22-01-13" Author="Peter Budd" Comment="Created from Batmink Blinder 4" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" />
      <Function ID="2" Name="8 Cell" Display="'8 Cell'" Dmx="16~31" />
      <Function ID="3" Name="4 Cell" Display="'4 Cell'" Dmx="32~65" />
      <Function ID="4" Name="2 Cell" Display="'2 Cell'" Dmx="66~99" />
      <Function ID="5" Name="1 Cell" Display="'1 Cell'" Dmx="100~149" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="150~199" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Program 1" Display="'Program 1'" Dmx="0~22" Colour="0,0,0" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="23~45" Colour="0,0,0" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="46~68" Colour="0,0,0" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="69~91" Colour="0,0,0" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="92~114" Colour="0,0,0" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="115~137" Colour="0,0,0" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="138~160" Colour="0,0,0" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="161~183" Colour="0,0,0" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="184~206" Colour="0,0,0" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="207~229" Colour="0,0,0" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="230~252" Colour="0,0,0" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="253~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',1.0~20.0" Dmx="16~200" Intensity="0~0" />
      <Function ID="3" Name="Strobe S" Display="'Strobe S'" Dmx="201~210" Intensity="0~0" />
      <Function ID="4" Name="Strobe M" Display="'Strobe M'" Dmx="210~220" Intensity="0~0" />
      <Function ID="5" Name="Strobe F" Display="'Strobe F'" Dmx="221~230" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="231~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green1" Description="" Group="C">

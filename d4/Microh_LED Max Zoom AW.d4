    </Physical>
    <AtlaBase ModeID="5e9179ea-77e4-41a6-b1e0-92f573b0a847" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="White_1" ChannelOffset="2" Wheel="7" />

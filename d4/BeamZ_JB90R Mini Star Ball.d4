    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Auto Program" Display="'Auto Program'" Dmx="9~9" />
      <Function ID="3" Name="Auto Gradual" Display="'Auto Gradual'" Dmx="10~72" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump'" Dmx="73~134" />
      <Function ID="5" Name="RGB Jump" Display="'RGB Jump'" Dmx="135~197" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="198~220" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="221~250" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="251~255" />
    </Attribute>
  </Control>

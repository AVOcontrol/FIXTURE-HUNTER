  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Master" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'Duration %.1fms',1.0~20.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Time" Display="'Time %.fms',100~4000" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RDM Disabled" Display="'RDM Disabled'" Dmx="1~10" />
      <Function ID="3" Name="RDM Enabled" Display="'RDM Enabled'" Dmx="11~20" />
      <Function ID="4" Name="Fan Silent" Display="'Fan Silent'" Dmx="101~110" />
      <Function ID="5" Name="Fan Normal" Display="'Fan Normal'" Dmx="110~120" />
      <Function ID="6" Name="Fan Full" Display="'Fan Full'" Dmx="121~130" />
    </Attribute>
  </Control>

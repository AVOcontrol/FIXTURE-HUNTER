<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RAZOR440" ShortName="RAZOR440" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="03-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="15-08-16" Author="Nic Morris" Comment="Added open and no scroll functions to gobo11 and gobo21 shake and scroll conditions." />
  <History Date="11-10-16" Author="Nic Morris" Comment="Updated to release spec (completely different!)" />
  <History Date="12-10-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1857f70a-026c-41b9-bd47-7fa5e0e6b175" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="247~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="14" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==4" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="0" Colour="255,255,255" />
      <Function ID="2" Name="Congo" Display="'Congo'" Dmx="10~14" Update="0" Colour="180,0,255" />
      <Function ID="3" Name="Cobalt Blue" Display="'Cobalt Blue'" Dmx="20~24" Update="0" Colour="0,0,180" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="30~34" Update="0" Colour="255,150,150" />
      <Function ID="5" Name="Aquamarine" Display="'Aquamarine'" Dmx="40~44" Update="0" Colour="0,255,128" />
      <Function ID="6" Name="CTB" Display="'CTB'" Dmx="50~54" Update="0" Colour="230,230,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~63" Update="0" Colour="0,255,255" />
      <Function ID="8" Name="Op/ Con" Display="'Op/ Con'" Dmx="5~9" Update="0" Colour="255,255,255" />
      <Function ID="9" Name="Con/ C Blu" Display="'Con/ C Blu'" Dmx="15~19" Update="0" Colour="180,0,255" />
      <Function ID="10" Name="C Blu/ Pk" Display="'C Blu/ Pk'" Dmx="25~29" Update="0" Colour="0,0,180" />
      <Function ID="11" Name="Pk/ Aq" Display="'Pk/ Aq'" Dmx="35~39" Update="0" Colour="255,150,150" />
      <Function ID="12" Name="Aq/ CTB" Display="'Aq/ CTB'" Dmx="45~49" Update="0" Colour="0,255,128" />
      <Function ID="13" Name="CTB/ Cy" Display="'CTB/ Cy'" Dmx="55~59" Update="0" Colour="230,230,255" />
      <Function ID="14" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="128~255" Update="0" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Update="0" Colour="255,255,255" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="95~64" Update="0" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Update="0" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="127~96" Update="0" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />

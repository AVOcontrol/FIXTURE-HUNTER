      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="28~31" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="32~35" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="36~39" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="40~43" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="44~47" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="48~51" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="52~55" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="56~59" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />

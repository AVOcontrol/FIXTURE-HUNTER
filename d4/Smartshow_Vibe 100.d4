    <Attribute ID="Parameter_1" Name="Parameter 1" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Else ID="1" />
      <Condition Name="Hue" ID="2" If="'Program'==1" />
      <Condition Name="BeatAccent" ID="3,4" If="'Program'==3||'Program'==4||'Program'==5||'Program'==6||'Program'==7||'Program'==8||'Program'==9||'Program'==10||'Program'==11||'Program'==12||'Program'==13||'Program'==14||'Program'==15||'Program'==16||'Program'==18||'Program'==19||'Program'==21||'Program'==25||'Program'==26||'Program'==31||'Program'==32||'Program'==40||'Program'==42||'Program'==43||'Program'==44" />
      <Condition Name="DoubleUp" ID="5,6" If="'Program'==17||'Program'==20||'Program'==23||'Program'==39||'Program'==45" />
      <Condition Name="BlendSpacing" ID="7,8" If="'Program'==22" />
      <Condition Name="ExpandShrink" ID="9,10" If="'Program'==24" />
      <Condition Name="WhiteLeader" ID="11,12" If="'Program'==27" />
      <Condition Name="Direction" ID="13,14" If="'Program'==28" />
      <Condition Name="InvertRight" ID="15,16" If="'Program'==29||'Program'==30||'Program'==35||'Program'==36||'Program'==37||'Program'==38" />
      <Condition Name="Speed (1-5)" ID="17" If="'Program'==33" />
      <Condition Name="Height" ID="18" If="'Program'==34" />
      <Condition Name="UseAlternates" ID="19" If="'Program'==46" />
      <Condition Name="Red" ID="20" If="'Program'==47" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Hue" Display="'%.f°',0~359" Dmx="0~255" />
      <Function ID="3" Name="No Accent" Display="'No Accent'" Dmx="0~0" />
      <Function ID="4" Name="White Accent on Beat" Display="'White Accent on Beat'" Dmx="255~255" />
      <Function ID="5" Name="DoubleUp Off" Display="'DoubleUp Off'" Dmx="0~0" />
      <Function ID="6" Name="DoubleUp On" Display="'DoubleUp On'" Dmx="255~255" />
      <Function ID="7" Name="BlendSpacing Short" Display="'BlendSpacing Short'" Dmx="0~0" />
      <Function ID="8" Name="BlendSpacing Long" Display="'BlendSpacing Long'" Dmx="255~255" />
      <Function ID="9" Name="Expand From Center" Display="'Expand From Center'" Dmx="0~0" />
      <Function ID="10" Name="Shrink Towards Center" Display="'Shrink Towards Center'" Dmx="255~255" />
      <Function ID="11" Name="WhiteLeader Off" Display="'WhiteLeader Off'" Dmx="0~0" />
      <Function ID="12" Name="WhiteLeader On" Display="'WhiteLeader On'" Dmx="255~255" />
      <Function ID="13" Name="Up" Display="'Up'" Dmx="0~0" />
      <Function ID="14" Name="Down" Display="'Down'" Dmx="255~255" />
      <Function ID="15" Name="InvertRight Off" Display="'InvertRight Off'" Dmx="0~0" />
      <Function ID="16" Name="InvertRight On" Display="'InvertRight On'" Dmx="255~255" />
      <Function ID="17" Name="Speed (1-5)" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="18" Name="Height" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="19" Name="UseAlternates" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="20" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Parameter_2" Name="Parameter 2" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Else ID="1" />
      <Condition Name="Saturation" ID="2" If="'Program'==1" />

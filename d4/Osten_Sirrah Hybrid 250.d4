<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sirrah Hybrid 250" ShortName="SrahHyb250" Company="Osten" Version="8">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>4c7bca45-2635-48d5-9dc4-2108f94fb685</Thumbnail>
  <History Date="17-10-23" Author="Nic Morris" Comment="Created (poor documentation.  there appear to be two sets of charts for different fixtures - one set is incomplete and conflicts with the first.  ignored incomplete conflicting set)" Version="0" />
  <History Date="15-05-24" Author="Nic Morris" Comment="Created from Unknown 320W LED BSW (identical.  gobo 1 and colour wheel drawings are missing slot numbers and cannot be used)" Version="1" />
  <History Date="18-05-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="10-03-25" Author="Nic Morris" Comment="Created from Viking Lighting VK250 Poki (identical. hopeless documentation.  same problem with two sets of charts)" Version="3" />
  <History Date="13-03-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="23-04-25" Author="Nic Morris" Comment="Created from PSL RANGER 320 (identical)" Version="5" />
  <History Date="20-07-25" Author="Nic Morris" Comment="Created from Uplus Lighting 320 LED BSW (identical except some of the colour ranges which just look strange and are probably wrong.  gobo image resolution is too low and have slot numbers stamped over them so would be unusable anyway)" Version="6" />
  <History Date="24-09-25" Author="Nic Morris" Comment="Created from Phocea Light Lyre Fusion 250W LED (identical except colour ranges.  gobo images are missing slot numbers and therefore cannot be used)" Version="7" />
  <History Date="27-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <Manual Filename="" Summary="" />

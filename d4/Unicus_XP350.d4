      <Function ID="21" Name="L Blu/ Org" Display="'L Blu/ Org'" Dmx="59~63" WheelPosition="6" Colour="0,128,255" />
      <Function ID="22" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="68~72" WheelPosition="7" Colour="255,128,0" />
      <Function ID="23" Name="Grn/ B Yel" Display="'Grn/ B Yel'" Dmx="77~81" WheelPosition="8" Colour="0,255,0" />
      <Function ID="24" Name="B Yel/ M Blu" Display="'B Yel/ M Blu'" Dmx="86~90" WheelPosition="9" Colour="180,180,0" />
      <Function ID="25" Name="M Blu/ Amb" Display="'M Blu/ Amb'" Dmx="95~99" WheelPosition="10" Colour="0,0,255" />
      <Function ID="26" Name="Amb/ Ppl" Display="'Amb/ Ppl'" Dmx="104~108" WheelPosition="11" Colour="255,100,0" />

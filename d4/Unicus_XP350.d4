      <Function ID="11" Name="Medium Blue" Display="'Medium Blue'" Dmx="91~94" WheelPosition="10" Colour="0,0,255" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="100~103" WheelPosition="11" Colour="255,100,0" />
      <Function ID="13" Name="Purple" Display="'Purple'" Dmx="109~112" WheelPosition="12" Colour="128,0,255" />
      <Function ID="14" Name="3200K Warm White" Display="'3200K Warm White'" Dmx="118~121" WheelPosition="13" Colour="255,240,200" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Blu" Display="'Rd/ Blu'" Dmx="14~18" WheelPosition="1" Colour="255,0,0" />

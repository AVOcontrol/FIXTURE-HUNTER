      <Function ID="6" Name="Rose Red" Display="'Rose Red'" Dmx="46~49" WheelPosition="5" Colour="255,0,127" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="55~58" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="64~67" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="73~76" WheelPosition="8" Colour="0,255,0" />

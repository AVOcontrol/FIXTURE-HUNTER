      <Function ID="18" Name="L Yel/ L Grn" Display="'L Yel/ L Grn'" Dmx="32~36" WheelPosition="3" Colour="255,255,128" />
      <Function ID="19" Name="L Grn/ R Rd" Display="'L Grn/ R Rd'" Dmx="41~45" WheelPosition="4" Colour="128,255,0" />

      <Function ID="13" Name="Cy/ Pk" Display="'Cy/ Pk'" Dmx="107~109" WheelPosition="5" Colour="0,255,255" />
      <Function ID="14" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="116~118" WheelPosition="6" Colour="255,150,150" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~128" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~193" Colour="0,0,0" />

  <AtlaBase TypeID="92ed9125-86d1-4d6f-9022-e2dd5f47ccdc" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="26~225" Intensity="0~0" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1'" Dmx="226~239" Intensity="0~0" />
      <Function ID="5" Name="Macro 2" Display="'Macro 2'" Dmx="240~241" Intensity="0~0" />
      <Function ID="6" Name="Macro 3" Display="'Macro 3'" Dmx="242~246" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CMY_Macro" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~35" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="36~54" Colour="255,255,0" />

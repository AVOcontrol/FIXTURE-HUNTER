    <Attribute ID="Gobo2Rot1" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func1'==1||'Gobo2Func1'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func1'==2||'Gobo2Func1'==4||'Gobo2Func1'==5" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="514~32639" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33410" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33667~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="8-Facet Index" Display="'8-Facet Index'" Dmx="17~49" Update="Prism_Rot" />
      <Function ID="3" Name="8-Facet Spin" Display="'8-Facet Spin'" Dmx="50~75" Update="Prism_Rot" />
      <Function ID="4" Name="16-Facet Index" Display="'16-Facet Index'" Dmx="76~105" Update="Prism_Rot" />
      <Function ID="5" Name="16-Facet Spin" Display="'16-Facet Spin'" Dmx="106~127" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism 1 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Prism'==2||'Prism'==4" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==3||'Prism'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="2~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~130" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Frost1" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="1~189" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="190~211" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="212~233" />
      <Function ID="5" Name="(Missing)" Display="'(Missing)'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" />
      <Function ID="6" Name="Macro" Display="'Macro'" Dmx="192~246" />
    </Attribute>
    <Attribute ID="Prism_2_Rot1" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="129~191" />

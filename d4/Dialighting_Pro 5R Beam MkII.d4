      <Function ID="30" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="224~230" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="31" Name="Gobo 13 Shake" Display="'Gobo 13 Shake  %.f%%',0~100" Dmx="231~236" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />

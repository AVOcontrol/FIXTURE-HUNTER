  <History Date="28-04-25" Author="Nic Morris" Comment="Created (charts only.  can't find product online)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="6~100" />
      <Function ID="3" Name="Gradient" Display="'Gradient'" Dmx="101~150" />
      <Function ID="4" Name="Pulse Change" Display="'Pulse Change'" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CT" Name="CT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CT C-Mix" Display="'%.fK',2000~8000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Preset" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Primary Red" Display="'Primary Red'" Dmx="6~21" Colour="255,0,0" />
      <Function ID="3" Name="Light Orange" Display="'Light Orange'" Dmx="22~37" Colour="255,128,0" />
      <Function ID="4" Name="Golden Yellow" Display="'Golden Yellow'" Dmx="38~53" Colour="255,255,0" />
      <Function ID="5" Name="Straw Yellow" Display="'Straw Yellow'" Dmx="54~69" Colour="255,250,230" />
      <Function ID="6" Name="Lemon Yellow" Display="'Lemon Yellow'" Dmx="70~85" Colour="255,255,0" />
      <Function ID="7" Name="Primary Green" Display="'Primary Green'" Dmx="86~101" Colour="0,255,0" />
      <Function ID="8" Name="Peacock Blue" Display="'Peacock Blue'" Dmx="102~117" Colour="0,255,128" />
      <Function ID="9" Name="Pea Green" Display="'Pea Green'" Dmx="118~133" Colour="128,255,0" />
      <Function ID="10" Name="Sky Blue" Display="'Sky Blue'" Dmx="134~149" Colour="0,0,255" />
      <Function ID="11" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="150~165" Colour="0,0,255" />
      <Function ID="12" Name="Light Blue" Display="'Light Blue'" Dmx="166~181" Colour="0,128,255" />
      <Function ID="13" Name="Purple Rose" Display="'Purple Rose'" Dmx="182~197" Colour="128,0,255" />
      <Function ID="14" Name="Light Purple Rose" Display="'Light Purple Rose'" Dmx="198~213" Colour="255,0,127" />
      <Function ID="15" Name="Rose Pink" Display="'Rose Pink'" Dmx="214~229" Colour="255,0,127" />
      <Function ID="16" Name="Violet Blue" Display="'Violet Blue'" Dmx="230~245" Colour="180,0,255" />
      <Function ID="17" Name="Thunder Orange" Display="'Thunder Orange'" Dmx="246~255" Colour="255,128,0" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="86fec04c-0915-4788-be9a-a6c1010d4021">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0a616563-2278-41ec-afc0-a1a9a8347fc7" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="11,12" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="13,14" Wheel="3" />

    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~11" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="12~23" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~35" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~47" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="48~59" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="60~71" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="72~80" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="81~95" Colour="255,255,255" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="96~107" Colour="0,0,0" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="108~119" Colour="0,0,0" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="120~131" Colour="0,0,0" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="132~143" Colour="0,0,0" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="144~155" Colour="0,0,0" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="156~167" Colour="0,0,0" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="168~179" Colour="0,0,0" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="180~191" Colour="0,0,0" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="192~203" Colour="0,0,0" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="204~215" Colour="0,0,0" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="216~227" Colour="0,0,0" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="228~239" Colour="0,0,0" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="240~251" Colour="0,0,0" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="252~255" Colour="0,0,0" />

      <Function ID="2" Name="Black" Display="'Black'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Scale_Mode" Name="Scale Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />

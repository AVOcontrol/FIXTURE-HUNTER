      <Function ID="2" Name="Zoom to Fit" Display="'Zoom to Fit'" Dmx="86~172" />
      <Function ID="3" Name="Stretch" Display="'Stretch'" Dmx="173~255" />
    </Attribute>
    <Attribute ID="Border_Width" Name="Border Width" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Border Width" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ramp_in_Time" Name="Ramp in Time" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

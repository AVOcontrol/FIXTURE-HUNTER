<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="onePATT" ShortName="onePATT" Company="Robe" Version="17">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>1e7e82ed-2a6c-4acd-acf2-ac94df02baed</Thumbnail>
  <History Date="21-02-17" Author="Nic Morris" Comment="Created (guessed cell layout)" Version="1" />
  <History Date="21-02-17" Author="Nic Morris" Comment="Editable version.  Remove Red, Green, Blue, White, Virtual Col, CTO and Active Zone from Modes 2-6." Version="2" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Added mode 7 in line with final release charts (v1.0)" Version="3" />
  <History Date="25-03-17" Author="Nic Morris" Comment="Revised Virtual Col function names" Version="4" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Shortened Patt Transition to Patt Trans to comply with 14 char limit." Version="5" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Rolled back Pete's changes in response to customer bug report (all original modes were broken except 1 and 7)." Version="6" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Added new multi-part mode 6 options to replace previous versions." Version="7" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Added Atlabase ID's (note multipart modes are not currently supported)" Version="8" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Changed name from Pixel Patt to pixelPATT.  Added channel counts to mode names." Version="9" />
  <History Date="01-11-17" Author="Nic Morris" Comment="Moved mode 2 BG controls from cell to master.  Linked mode 3-6 cells to main RGBW controls." Version="10" />
  <History Date="01-11-17" Author="Nic Morris" Comment="Removed unused master attributes.  Fixed wheel mapping conflict in modes 2-6" Version="11" />
  <History Date="01-11-17" Author="Nic Morris" Comment="Revised Modes 1 and 2 with cell for BG dimmer for HTP." Version="12" />
  <History Date="27-02-18" Author="Nic Morris" Comment="Updated to v1.1 specs in response to manufacturer request (adds Kling-Net control functions and macros)" Version="13" />
  <History Date="27-02-18" Author="Nic Morris" Comment="Added product thumbnail" Version="14" />
  <History Date="22-03-18" Author="Nic Morris" Comment="Created from Robe pixelPATT (charts are for the PATT Driver which is used for the onePATT, pixelPATT and PATT 2017 fixtures and therefore they are all identical)" Version="15" />
  <History Date="09-05-18" Author="Nic Morris" Comment="Flattened cell layout in response to OW request." Version="16" />
  <History Date="18-04-24" Author="Nic Morris" Comment="Added multipart patch options for modes 3-7 with single pixels." Version="17" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d951a812-7248-4ced-988e-683289f44ed7" />

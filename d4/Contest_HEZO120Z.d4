      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~57" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="58~107" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="108~157" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="158~207" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

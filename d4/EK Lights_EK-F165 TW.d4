<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-F165 TW" ShortName="EK-F165 TW" Company="EK Lights" Version="8">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="21-01-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="26-03-18" Author="Nic Morris" Comment="Added 5 DMX m2 and 12 DMX modes in line with manual REV.003-02/18 in response to manufacturer request." Version="2" />
  <History Date="26-03-18" Author="Nic Morris" Comment="Fixed first CTO range and added a 'No Function' range at 255 set as default." Version="3" />
  <History Date="30-03-18" Author="Nic Morris" Comment="Added Atlabase ID's to 5 DMX m2 and 12 DMX modes." Version="4" />
  <History Date="30-07-19" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (yet more changes.  adds modes and revises ranges)" Version="5" />
  <History Date="31-07-19" Author="Nic Morris" Comment="Added remaining Atlabase mode ID's." Version="6" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Changed CTO to a single linear range and added 'Open' function in 12 and 19 channel modes in response to manufacturer request (contrary to documentation)" Version="7" />
  <History Date="21-11-20" Author="Nic Morris" Comment="Created from Prolights ECLIPSEFRESNELTW" Version="8" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Amber" Name="Orange" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Orange C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,150,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="UV" Name="Royal Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="R-Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~10000" Dmx="0~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f°',-25.0~25.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~10000" Dmx="0~252" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Dim_Spd" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>

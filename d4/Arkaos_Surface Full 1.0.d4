<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Surface Full 1.0" ShortName="SrfaceFull" Company="Arkaos" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="07-09-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3" />
      <Function ID="2" Name="HSV Change" Display="'HSV Change'" Dmx="1~1" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="HSV Change" ID="2" If="'Effect'==2" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="HSV Change" ID="2" If="'Effect'==2" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="HSV Change" ID="2" If="'Effect'==2" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Value" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Col_Blend_Mode" Name="Col Blend Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Add" Display="'Add'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Subtract" Display="'Subtract'" Dmx="10~19" Colour="255,255,255" />
      <Function ID="3" Name="Reverse Subtract" Display="'Reverse Subtract'" Dmx="20~29" Colour="255,255,255" />
      <Function ID="4" Name="Multiply" Display="'Multiply'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="5" Name="Screen" Display="'Screen'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Mask" Display="'Mask'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="7" Name="Replace" Display="'Replace'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="8" Name="Fill" Display="'Fill'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Blend_Int" Name="Col Blend Int" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic" Name="Surface Blend" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blend" Display="'Blend'" Dmx="0~0" />
      <Function ID="2" Name="Add" Display="'Add'" Dmx="10~19" />
      <Function ID="3" Name="Subtract" Display="'Subtract'" Dmx="20~29" />
      <Function ID="4" Name="Reverse Subtract" Display="'Reverse Subtract'" Dmx="30~39" />
      <Function ID="5" Name="Replace" Display="'Replace'" Dmx="40~49" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="SurfaceBlndInt" Name="SurfaceBlndInt" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Effect" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Effect_Param_1" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Effect_Param_2" ChannelOffset="3" Wheel="24" />
      <Attribute ID="Effect_Param_3" ChannelOffset="4" Wheel="52" />
      <Attribute ID="Effect_Param_4" ChannelOffset="5" Wheel="53" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="Col_Blend_Mode" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Col_Blend_Int" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Generic" ChannelOffset="11" Wheel="19" />
      <Attribute ID="SurfaceBlndInt" ChannelOffset="12" Wheel="5" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
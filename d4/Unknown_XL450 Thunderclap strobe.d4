  <History Date="02-09-25" Author="Nic Morris" Comment="Created (hopeless documentation.  no pixel layout.  made best guess)" Version="0" />
  <History Date="03-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dc2b1c9e-ac3f-41e9-bc0c-275933099fc5" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="RGB_FX_Func" />
      <Function ID="2" Name="Colour Mix" Display="'Colour Mix'" Dmx="6~63" Update="RGB_FX_Func" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="64~127" Update="RGB_FX_Func" />
      <Function ID="4" Name="Mixed" Display="'Mixed'" Dmx="128~191" Update="RGB_FX_Func" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="192~255" Update="RGB_FX_Func" />
    </Attribute>
    <Attribute ID="RGB_FX_Func" Name="RGB FX Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Colour Mix" ID="2" If="'RGB_FX'==2" />
      <Condition Name="Auto" ID="3,4" If="'RGB_FX'==3" />
      <Condition Name="Mixed" ID="5" If="'RGB_FX'==4" />
      <Condition Name="Sound" ID="6" If="'RGB_FX'==5" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Auto with Light Off" Display="'Auto with Light Off'" Dmx="0~0" />
      <Function ID="4" Name="Col Jump" Display="'Col Jump %.1f%%',0.0~100.0" Dmx="4~255" />
      <Function ID="5" Name="Mixed Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Sound Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_FX_Spd" Name="RGB FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White_FX" Name="White FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="White_FX_Spd" Name="White FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

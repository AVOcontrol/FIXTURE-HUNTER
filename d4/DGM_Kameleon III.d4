<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kameleon III" ShortName="Kameleon 3" Company="DGM">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="14-07-11" Author="Nic Morris" Comment="Created" />
  <History Date="29-11-12" Author="Peter Budd" Comment="Created from the DGM Kameleon" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Generic" Name="Preset Chase" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~127" />
      <Function ID="2" Name="Colour Chase" Display="'Colour Chase'" Dmx="128~191" />
      <Function ID="3" Name="Random Colour Chase" Display="'Random Colour Chase'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Generic1" Name="Preset Fade" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~127" />
      <Function ID="2" Name="Fade Program" Display="'Fade Program'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" Colour="0,0,0" />
      <Function ID="2" Name="Red 100/Grn 20" Display="'Red 100/Grn 20'" Dmx="8~15" Colour="255,51,0" />
      <Function ID="3" Name="Red 100/Gn 40" Display="'Red 100/Gn 40'" Dmx="16~23" Colour="255,102,0" />
      <Function ID="4" Name="Red 100/Grn 60" Display="'Red 100/Grn 60'" Dmx="24~31" Colour="255,153,0" />
      <Function ID="5" Name="Red 100/Grn 80" Display="'Red 100/Grn 80'" Dmx="32~39" Colour="255,204,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="40~47" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="48~55" Colour="0,255,0" />
      <Function ID="8" Name="Grn 100/Blue 20" Display="'Grn 100/Blue 20'" Dmx="56~63" Colour="0,255,51" />
      <Function ID="9" Name="Grn 100/Blue 40" Display="'Grn 100/Blue 40'" Dmx="64~71" Colour="0,255,102" />
      <Function ID="10" Name="Grn 100/Blue 60" Display="'Grn 100/Blue 60'" Dmx="72~79" Colour="0,255,153" />
      <Function ID="11" Name="Grn 100/Blue 80" Display="'Grn 100/Blue 80'" Dmx="80~87" Colour="0,255,204" />
      <Function ID="12" Name="Cyan" Display="'Cyan'" Dmx="88~95" Colour="0,255,255" />
      <Function ID="13" Name="Red 20/Blue 100" Display="'Red 20/Blue 100'" Dmx="96~103" Colour="0,0,255" />
      <Function ID="14" Name="Red 20/Blue 100" Display="'Red 20/Blue 100'" Dmx="104~111" Colour="51,0,255" />
      <Function ID="15" Name="Red 40/Blue 100" Display="'Red 40/Blue 100'" Dmx="112~119" Colour="102,0,255" />
      <Function ID="16" Name="Red 60/Blue 100" Display="'Red 60/Blue 100'" Dmx="120~127" Colour="153,0,255" />
      <Function ID="17" Name="Red 80/Blue 100" Display="'Red 80/Blue 100'" Dmx="128~135" Colour="204,0,255" />
      <Function ID="18" Name="Magenta" Display="'Magenta'" Dmx="136~143" Colour="255,0,255" />
      <Function ID="19" Name="Rd 100/Grn 25/Bl 100" Display="'Rd 100/Grn 25/Bl 100'" Dmx="144~151" Colour="255,64,255" />
      <Function ID="20" Name="Rd 100/Grn 50/Bl 100" Display="'Rd 100/Grn 50/Bl 100'" Dmx="152~159" Colour="255,128,255" />
      <Function ID="21" Name="Rd 100/Grn 75/Bl 100" Display="'Rd 100/Grn 75/Bl 100'" Dmx="160~167" Colour="255,191,255" />
      <Function ID="22" Name="Rd 100/Grn 100/Bl 100" Display="'Rd 100/Grn 100/Bl 100'" Dmx="168~175" Colour="255,255,255" />
      <Function ID="23" Name="Rd 100/Grn 100/Bl 25" Display="'Rd 100/Grn 100/Bl 25'" Dmx="176~183" Colour="255,255,64" />
      <Function ID="24" Name="Rd 100/Grn 100/Bl 50" Display="'Rd 100/Grn 100/Bl 50'" Dmx="184~191" Colour="255,255,128" />
      <Function ID="25" Name="Rd 100/Grn 100/Bl 75" Display="'Rd 100/Grn 100/Bl 75'" Dmx="192~199" Colour="255,255,191" />
      <Function ID="26" Name="Open" Display="'Open'" Dmx="200~207" Colour="255,255,255" />
      <Function ID="27" Name="Rd 20/Grn 100/Bl 100" Display="'Rd 20/Grn 100/Bl 100'" Dmx="208~215" Colour="51,255,255" />
      <Function ID="28" Name="Rd 40/Grn 100/Bl 100" Display="'Rd 40/Grn 100/Bl 100'" Dmx="216~223" Colour="102,255,255" />
      <Function ID="29" Name="Rd 60/Grn 100/Bl 100" Display="'Rd 60/Grn 100/Bl 100'" Dmx="224~231" Colour="153,255,255" />
      <Function ID="30" Name="Rd 80/Grn 100/Bl 100" Display="'Rd 80/Grn 100/Bl 100'" Dmx="232~239" Colour="204,255,255" />
      <Function ID="31" Name="Rd 20/Grn 100/Bl 100" Display="'Rd 20/Grn 100/Bl 100'" Dmx="240~247" Colour="51,255,255" />
      <Function ID="32" Name="Rd 50/Grn 50/Bl 50" Display="'Rd 50/Grn 50/Bl 50'" Dmx="248~255" Colour="128,128,128" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 2 DMX" Channels="2">
    <Import PearlRef="UK_DGMKM31" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 3 DMX" Channels="3">
    <Import PearlRef="UK_DGMKM32" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 5 DMX" Channels="5">
    <Import PearlRef="UK_DGMKM33" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="Mode 4, 8 DMX" Channels="8">
    <Import PearlRef="UK_DGMKM34" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Generic1" ChannelOffset="6" Wheel="29" />
      <Attribute ID="Generic" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
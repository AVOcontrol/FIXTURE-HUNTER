      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="59~64" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="65~69" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="70~74" WheelPosition="13" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="186~190" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="191~195" WheelPosition="2" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="196~201" WheelPosition="3" />
      <Function ID="19" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="202~206" WheelPosition="4" />
      <Function ID="20" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="207~211" WheelPosition="5" />
      <Function ID="21" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="212~217" WheelPosition="6" />
      <Function ID="22" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="218~222" WheelPosition="7" />
      <Function ID="23" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="223~227" WheelPosition="8" />
      <Function ID="24" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="228~233" WheelPosition="9" />
      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="234~238" WheelPosition="10" />

    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="2" Name="Variable" Display="'Variable %.1f%%',0.0~100.0" Dmx="247~128" />

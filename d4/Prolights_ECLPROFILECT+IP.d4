<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ECLPROFILECT+IP" ShortName="EPCT+IP" Company="Prolights" Version="5">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="28-12-20" Author="Nic Morris" Comment="Created (note col mix control documentation is vague.  according to manufacturer in HS mode col mix 1 = hue, col mix 2 = nothing and col mix 3 = saturation.  Dynamic col mix mode via macro is not currently supported)" Version="0" />
  <History Date="05-01-21" Author="Nic Morris" Comment="Revised with single UNO and DUO modes in line with latest Capture implementation." Version="1" />
  <History Date="26-04-21" Author="Robin Sanders" Comment="Prolights_ECLPROFILECT+ (5°).d4 renamed to Prolights_ECLPROFILECT+ (5).d4" Version="2" />
  <History Date="03-05-21" Author="Nic Morris" Comment="Added RAW and XY modes in line with latest charts in response to manufacturer request." Version="3" />
  <History Date="06-05-21" Author="Nic Morris" Comment="Added Atlabase ID's for RAW and XY modes." Version="4" />
  <History Date="17-02-22" Author="Nic Morris" Comment="Created from Prolights ECLPROFILECT+ (5°) (very confusing documentation.  note charts have range conflicts)" Version="5" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:7205" PowerOn="1:7205" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="+ Mag" Display="'+ Mag %.1f%%',25.0~0.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Balanced" Display="'Balanced'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~25.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">

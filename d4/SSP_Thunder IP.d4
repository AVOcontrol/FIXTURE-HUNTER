  <History Date="26-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="33" />
  <History Date="20-03-26" Author="Nic Morris" Comment="Created from Osten Photon Strobe IP (nothing original to see here.  yet another shameless copy.  identical.  DMX charts are clearly taken straight from the Chauvet documentation)" Version="34" />

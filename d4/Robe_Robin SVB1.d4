<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin SVB1" ShortName="SVB1" Company="Robe" Version="22">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>fbfa3eb3-3edb-4682-9925-83982f010989</Thumbnail>
  <History Date="02-07-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="18-09-24" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <History Date="27-09-24" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request (significant changes to all modes.  revises pixel layout)" Version="6" />
  <History Date="11-10-24" Author="Nic Morris" Comment="Removed invalid palettes.  Updated in line with v1.4 charts in response to manufacturer request (adds mode 4)" Version="7" />
  <History Date="14-10-24" Author="Nic Morris" Comment="Moved DLC to cell in mode 4 for compatibility." Version="9" />
  <History Date="07-05-25" Author="Nic Morris" Comment="Replaced v1.5 version in response to manufacturer request.  Bumped version number so this appears more recent." Version="10" />
  <History Date="10-08-25" Author="Nic Morris" Comment="Corrected mode 4 DLC channel mapping." Version="13" />
  <History Date="10-08-25" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (renames DLC to ScreenPix, changes reserved to Pattern FX, adds more control functions/macros, adds more shutter functions, adds ScreenPix FX)" Version="14" />
  <History Date="10-10-25" Author="Nic Morris" Comment="Moved white strobe dimmer to a cell in modes 2, 3 and 4 in response to customer feedback to align with published v1.4 version.  Updated Atlabase mode ID's to 1.7 versions." Version="19" />
  <History Date="14-10-25" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds SPix FX Spd control to mode 4 and revises SPix FX functions)" Version="20" />
  <History Date="31-10-25" Author="Nic Morris" Comment="Updated in line with v1.9 charts in response to manufacturer request (adds Center Pixel Intensity control functions/macros)" Version="21" />
  <History Date="10-11-25" Author="Nic Morris" Comment="Updated in line with v2.0 charts in response to manufacturer request (removes some screenpix FX)" Version="22" />
  <Manual Filename="" Summary="" />

    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0s" Display="'0s'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.f Sec',1~250" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Interval" Name="Interval" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0s" Display="'0s'" Dmx="0~0" />
      <Function ID="2" Name="Inverval" Display="'%.f Sec',10~2500" Dmx="6~255" />
    </Attribute>
  </Control>

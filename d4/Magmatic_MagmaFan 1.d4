      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',20.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Fan1" Name="Fan" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="1" />

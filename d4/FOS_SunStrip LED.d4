    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tungsten Speed Mode" Display="'Tungsten Speed Mode'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="3" Name="Tungsten Effect" Display="'Tungsten Effect'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

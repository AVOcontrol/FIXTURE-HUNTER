  <Thumbnail>7b48b17a-ff88-45bc-a801-89a89a12a99b</Thumbnail>
  <History Date="29-03-24" Author="Nic Morris" Comment="Created (poor and confusing documentation.  assumed 24 and 28 channel modes are 8x RGB rather than 24x dimmer as suggested by charts...)" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="76b1a456-6552-444d-84d8-851fea48363f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Chase Mode" ID="2" If="'Mode'==2" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="26~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Chase Mode" Display="'Chase Mode'" Dmx="1~13" Update="Shutter" />
      <Function ID="3" Name="Sound A0 (Cycle All Mode A)" Display="'Sound A0 (Cycle All Mode A)'" Dmx="14~27" Update="Shutter" />
      <Function ID="4" Name="Sound A1-A8" Display="'Sound A1-A8 %.f%%',0~100" Dmx="28~139" Update="Shutter" />
      <Function ID="5" Name="Sound B0 (Cycle All Mode B)" Display="'Sound B0 (Cycle All Mode B)'" Dmx="140~153" Update="Shutter" />
      <Function ID="6" Name="Sound B1-B8" Display="'Sound B1-B8 %.f%%',0~100" Dmx="154~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

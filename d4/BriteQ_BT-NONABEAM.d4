  <Macro>
    <Macro Name="Pixel Order A">
      <Set Channel="Control1:3" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Order B">
      <Set Channel="Control1:4" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Order C">
      <Set Channel="Control1:5" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Pixel Order D">
      <Set Channel="Control1:6" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control1:7" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Full">
      <Set Channel="Control1:8" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control1:9" Delay="6000" />
      <Set Channel="Control1:1" Delay="0" />
    </Macro>

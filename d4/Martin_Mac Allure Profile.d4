    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin (0°)" Display="'No Spin (0°)'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="601~32130" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32131~32895" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64515" />
      <Function ID="6" Name="No Spin (90°)" Display="'No Spin (90°)'" Dmx="64516~65535" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">

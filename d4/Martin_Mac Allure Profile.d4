<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mac Allure Profile" ShortName="Allure Pro" Company="Martin" Version="6">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>1a0a5944-3a3c-467d-b6d7-69adff62bdc4</Thumbnail>
  <History Date="23-02-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-04-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="16-06-19" Author="Nic Morris" Comment="Revised FX function ranges for Single LED Chase thru Vertical Swoosh in attempt to resolve customer bug report." Version="3" />
  <History Date="16-06-19" Author="Nic Morris" Comment="(Previously Single LED Chase thru Spli Col Index 90° were swapped with Atomic Chase thru Vertical Swoosh)" Version="4" />
  <History Date="16-06-19" Author="Nic Morris" Comment="(note charts in latest manual only list Pixel Rainbow Wave thru Vertical Swoosh.  The remaining functions and swapped ranges came direct from Martin.  Leaving for now as don't and therefore mostly harmless...)" Version="5" />
  <History Date="13-08-21" Author="Nic Morris" Comment="Revised FX functions again in response to customer feedback (tested against fixture).  It seems likely this was originally incorrectly based on the Martin Mac Quantum Profile." Version="6" />
  <History Date="13-08-21" Author="Nic Morris" Comment="(Same as manual with Pixel Rainbow Wave thru Vertical Swoosh except for Iris Prism Combo at 89 which apparently does do something)" Version="6" />
  <History Date="13-08-21" Author="Nic Morris" Comment="(also note Center Outer Chase Duo apparently does not appear to do anything but left for now as is documented)" Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="974fde17-22e5-4fd2-af62-a41b89084c97" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2000~10000" Dmx="11~171" Colour="255,240,200" />
    </Attribute>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="01000693-d543-4d7b-bb52-39740c5426c1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="10~29" Update="Program_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="30~49" Update="Program_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="50~69" Update="Program_Spd" />
      <Function ID="5" Name="Sudden" Display="'Sudden'" Dmx="70~89" Update="Program_Spd" />
      <Function ID="6" Name="Red On+White Strobe" Display="'Red On+White Strobe'" Dmx="90~109" Update="Program_Spd" />
      <Function ID="7" Name="Green On+White Strobe" Display="'Green On+White Strobe'" Dmx="110~129" Update="Program_Spd" />
      <Function ID="8" Name="Blue On+White Strobe" Display="'Blue On+White Strobe'" Dmx="130~149" Update="Program_Spd" />
      <Function ID="9" Name="Amber On+White Strobe" Display="'Amber On+White Strobe'" Dmx="150~169" Update="Program_Spd" />
      <Function ID="10" Name="UV On+White Strobe" Display="'UV On+White Strobe'" Dmx="170~255" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Program'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Dimmer 1" Display="'Dimmer 1'" Dmx="20~39" />
      <Function ID="3" Name="Dimmer 2" Display="'Dimmer 2'" Dmx="40~59" />
      <Function ID="4" Name="Dimmer 3" Display="'Dimmer 3'" Dmx="60~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="7c667dec-0dc8-49aa-8657-3ed826d9195f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5c70ff3a-dd28-4aa2-8f28-20a4552d481b" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="UV" ChannelOffset="6" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Dim_Mode" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="11 DMX" Channels="11" Id="ae4eb384-3f05-47ef-928d-7047d161e279">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c85acedc-e869-4418-bcb0-1d4070db36b2" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="40" />
      <Attribute ID="Amber" ChannelOffset="7" Wheel="41" />
      <Attribute ID="UV" ChannelOffset="8" Wheel="42" />
      <Attribute ID="Program" ChannelOffset="9" Wheel="22" />

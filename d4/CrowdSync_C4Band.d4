  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Steady On" Display="'Steady On'" Dmx="0~0" />
      <Function ID="2" Name="Flash 6Hz" Display="'Flash 6Hz'" Dmx="16~31" />
      <Function ID="3" Name="Flash 10Hz" Display="'Flash 10Hz'" Dmx="32~47" />
      <Function ID="4" Name="Flash 14Hz" Display="'Flash 14Hz'" Dmx="48~63" />
      <Function ID="5" Name="Flash 20Hz" Display="'Flash 20Hz'" Dmx="64~79" />
      <Function ID="6" Name="Flash 25Hz" Display="'Flash 25Hz'" Dmx="80~95" />
      <Function ID="7" Name="Random Flash X2" Display="'Random Flash X2'" Dmx="96~111" />
      <Function ID="8" Name="Random Flash X4" Display="'Random Flash X4'" Dmx="112~127" />
      <Function ID="9" Name="Random Fade OFF X1" Display="'Random Fade OFF X1'" Dmx="128~143" />
      <Function ID="10" Name="Random Fade OFF X2" Display="'Random Fade OFF X2'" Dmx="144~159" />
      <Function ID="11" Name="Random Fade ON X1" Display="'Random Fade ON X1'" Dmx="160~175" />
      <Function ID="12" Name="Random Fade ON X2" Display="'Random Fade ON X2'" Dmx="176~191" />
      <Function ID="13" Name="Random Snap OFF X1" Display="'Random Snap OFF X1'" Dmx="192~207" />
      <Function ID="14" Name="Random Snap OFF X4" Display="'Random Snap OFF X4'" Dmx="208~223" />
      <Function ID="15" Name="Standby/Sleep" Display="'Standby/Sleep'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Steady ON" Display="'Steady ON'" Dmx="0~0" />
      <Function ID="2" Name="Flash" Display="'Flash'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="255~2" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="5" Name="Rnd Op Fast" Display="'Rnd Op Fast'" Dmx="62708~63222" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Rnd Op Slow" Display="'Rnd Op Slow'" Dmx="63479~63993" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Rnd Cl Fast" Display="'Rnd Cl Fast'" Dmx="64250~64764" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Rnd Cl Slow" Display="'Rnd Cl Slow'" Dmx="65021~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Function ID="3" Name="Strobe" Display="'Strobe'" Dmx="16~23" Update="Speed" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Single Right" Display="'Single Right'" Dmx="24~31" Update="Speed" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Single Left" Display="'Single Left'" Dmx="32~39" Update="Speed" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Single Y" Display="'Single Y'" Dmx="40~47" Update="Speed" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Single X" Display="'Single X'" Dmx="48~55" Update="Speed" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Double Right" Display="'Double Right'" Dmx="56~63" Update="Speed" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Double Left" Display="'Double Left'" Dmx="64~71" Update="Speed" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Double Y" Display="'Double Y'" Dmx="72~79" Update="Speed" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Double X" Display="'Double X'" Dmx="80~87" Update="Speed" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Cascade Right" Display="'Cascade Right'" Dmx="88~95" Update="Speed" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Cascade Left" Display="'Cascade Left'" Dmx="96~103" Update="Speed" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Cascade Y" Display="'Cascade Y'" Dmx="104~111" Update="Speed" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Cascade In" Display="'Cascade In'" Dmx="112~119" Update="Speed" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Cascade Out" Display="'Cascade Out'" Dmx="120~127" Update="Speed" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Cascade Y" Display="'Cascade Y'" Dmx="128~135" Update="Speed" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Half Right" Display="'Half Right'" Dmx="136~143" Update="Speed" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Half Left" Display="'Half Left'" Dmx="144~151" Update="Speed" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Half Y" Display="'Half Y'" Dmx="152~159" Update="Speed" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Even Odd" Display="'Even Odd'" Dmx="160~167" Update="Speed" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Squiggle Right" Display="'Squiggle Right'" Dmx="168~175" Update="Speed" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Squiggle Left" Display="'Squiggle Left'" Dmx="176~183" Update="Speed" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Squiggle Y" Display="'Squiggle Y'" Dmx="184~191" Update="Speed" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Individual Off Y" Display="'Individual Off Y'" Dmx="192~199" Update="Speed" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Toggle X" Display="'Toggle X'" Dmx="200~207" Update="Speed" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Toggle Y" Display="'Toggle Y'" Dmx="208~215" Update="Speed" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="28" Name="Full Random" Display="'Full Random'" Dmx="216~223" Update="Speed" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="29" Name="Individual Random" Display="'Individual Random'" Dmx="224~231" Update="Speed" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="30" Name="Individual Mode Select" Display="'Individual Mode Select'" Dmx="232~239" Update="Speed" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="31" Name="Individual Head Select" Display="'Individual Head Select'" Dmx="240~247" Update="Speed" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Auto Mode" Display="'Auto Mode'" Dmx="248~255" Update="Speed" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Sound Active" Display="'Sound Active'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="2">
    <Import PearlRef="UK_XLSRXPOD" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Gobo1" ChannelOffset="1" Wheel="14" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
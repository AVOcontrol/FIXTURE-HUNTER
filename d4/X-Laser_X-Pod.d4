  <History Date="13-04-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~7" Update="Speed" GoboSpin="0~0" GoboOrientation="0~0" />

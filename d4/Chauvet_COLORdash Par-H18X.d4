    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~11" Colour="255,0,0" />
      <Function ID="3" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="12~29" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="30~30" Colour="255,255,0" />
      <Function ID="5" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="31~49" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="50~50" Colour="0,255,0" />
      <Function ID="7" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="51~69" Colour="0,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="70~70" Colour="0,255,255" />
      <Function ID="9" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="71~89" Colour="0,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="90~90" Colour="0,0,255" />
      <Function ID="11" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="91~109" Colour="0,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="110~110" Colour="255,0,255" />
      <Function ID="13" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="111~129" Colour="255,0,255" />
      <Function ID="14" Name="Red" Display="'Red'" Dmx="130~130" Colour="255,0,0" />
      <Function ID="15" Name="Rd - RGB" Display="'Rd - RGB %.f%%',0~100" Dmx="131~149" Colour="255,0,0" />
      <Function ID="16" Name="RGB" Display="'RGB'" Dmx="150~150" Colour="255,255,255" />
      <Function ID="17" Name="RGB - Blu" Display="'RGB - Blu %.f%%',0~100" Dmx="151~169" Colour="255,255,255" />
      <Function ID="18" Name="Blue" Display="'Blue'" Dmx="170~170" Colour="0,0,255" />
      <Function ID="19" Name="RGB" Display="'RGB'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="20" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="21" Name="CTO C-Mix" Display="'CTO C-Mix %.f%%',0~100" Dmx="201~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White 1" Display="'Warm White 1'" Dmx="6~25" Colour="255,240,200" />
      <Function ID="3" Name="Warm White 2" Display="'Warm White 2'" Dmx="26~50" Colour="255,240,200" />
      <Function ID="4" Name="Warm White 3" Display="'Warm White 3'" Dmx="51~75" Colour="255,240,200" />
      <Function ID="5" Name="Neutral White 1" Display="'Neutral White 1'" Dmx="76~100" Colour="255,255,255" />
      <Function ID="6" Name="Neutral White 2" Display="'Neutral White 2'" Dmx="101~125" Colour="255,255,255" />
      <Function ID="7" Name="Neutral White 3" Display="'Neutral White 3'" Dmx="126~150" Colour="255,255,255" />
      <Function ID="8" Name="Daylight 1" Display="'Daylight 1'" Dmx="151~175" Colour="230,230,255" />
      <Function ID="9" Name="Daylight 2" Display="'Daylight 2'" Dmx="176~200" Colour="230,230,255" />
      <Function ID="10" Name="Daylight 3" Display="'Daylight 3'" Dmx="201~225" Colour="230,230,255" />
      <Function ID="11" Name="Daylight 4" Display="'Daylight 4'" Dmx="226~250" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim LED" Display="'Dim LED'" Dmx="6~127" />
      <Function ID="3" Name="Dim Halogen" Display="'Dim Halogen'" Dmx="128~191" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="192~200" />
      <Function ID="5" Name="Fan Max" Display="'Fan Max'" Dmx="201~209" />
      <Function ID="6" Name="Fan Silent" Display="'Fan Silent'" Dmx="210~218" />
      <Function ID="7" Name="LED 800Hz" Display="'LED 800Hz'" Dmx="219~223" />
      <Function ID="8" Name="LED 1200Hz" Display="'LED 1200Hz'" Dmx="224~228" />
      <Function ID="9" Name="LED 2000Hz" Display="'LED 2000Hz'" Dmx="229~233" />
      <Function ID="10" Name="LED 3600Hz" Display="'LED 3600Hz'" Dmx="234~238" />
      <Function ID="11" Name="LED 12kHz" Display="'LED 12kHz'" Dmx="239~243" />
      <Function ID="12" Name="LED 25kHz" Display="'LED 25kHz'" Dmx="244~249" />

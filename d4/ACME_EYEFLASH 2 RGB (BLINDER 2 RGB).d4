      <Function ID="27" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="196~202" Colour="255,255,0" />
      <Function ID="28" Name="Deep Amber" Display="'Deep Amber'" Dmx="203~210" Colour="255,100,0" />
      <Function ID="29" Name="Chrome Orange" Display="'Chrome Orange'" Dmx="211~217" Colour="255,128,0" />
      <Function ID="30" Name="Orange" Display="'Orange'" Dmx="218~225" Colour="255,128,0" />
      <Function ID="31" Name="Gold Amber" Display="'Gold Amber'" Dmx="226~232" Colour="255,128,0" />
      <Function ID="32" Name="Millennium Gold" Display="'Millennium Gold'" Dmx="233~240" Colour="255,128,0" />
      <Function ID="33" Name="Deep Gold Amber" Display="'Deep Gold Amber'" Dmx="241~247" Colour="255,128,0" />
      <Function ID="34" Name="Flame Red" Display="'Flame Red'" Dmx="248~255" Colour="255,0,0" />
    </Attribute>
  </Control>

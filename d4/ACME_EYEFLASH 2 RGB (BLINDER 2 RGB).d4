      <Function ID="17" Name="Steel Blue" Display="'Steel Blue'" Dmx="121~127" Colour="230,230,255" />
      <Function ID="18" Name="Lighter Blue" Display="'Lighter Blue'" Dmx="128~135" Colour="0,128,255" />
      <Function ID="19" Name="Light Blue" Display="'Light Blue'" Dmx="136~142" Colour="0,128,255" />
      <Function ID="20" Name="Medium Blue Green" Display="'Medium Blue Green'" Dmx="143~150" Colour="0,255,128" />
      <Function ID="21" Name="Dark Green" Display="'Dark Green'" Dmx="151~157" Colour="0,180,0" />
      <Function ID="22" Name="Primary Green" Display="'Primary Green'" Dmx="158~165" Colour="0,255,0" />
      <Function ID="23" Name="Moss Green" Display="'Moss Green'" Dmx="166~172" Colour="0,255,0" />

      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="180~199" WheelPosition="1" Colour="0,255,0" />
      <Function ID="11" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="160~179" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="140~159" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="120~139" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="100~119" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Mag/ L Blu" Display="'Mag/ L Blu'" Dmx="80~99" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" WheelPosition="7" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

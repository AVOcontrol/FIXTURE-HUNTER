    </Attribute>
    <Attribute ID="Derby_Shutter" Name="Derby Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Derby_Spd" Name="Derby Spd" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Low" Display="'Low'" Dmx="10~29" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="30~49" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="High" Display="'High'" Dmx="50~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

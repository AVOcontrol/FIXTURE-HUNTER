      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="10~49" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="50~89" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="90~129" />

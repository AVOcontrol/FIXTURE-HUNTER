      <Function ID="13" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="60~64" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Mag/ Org" Display="'Mag/ Org'" Dmx="65~69" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Org/ Cy" Display="'Org/ Cy'" Dmx="70~74" WheelPosition="6" Colour="255,150,0" />
      <Function ID="16" Name="Cy/ Op" Display="'Cy/ Op'" Dmx="75~79" WheelPosition="7" Colour="0,255,255" />

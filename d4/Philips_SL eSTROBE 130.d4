  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="45a9d4e4-4b5e-41f0-8a6d-c24d340170ba" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up/ Down" Display="'Ramp Up/ Down'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Ring 1" Display="'Ring 1'" Dmx="172~173" />
      <Function ID="7" Name="Ring 2" Display="'Ring 2'" Dmx="174~175" />
      <Function ID="8" Name="Ring 3" Display="'Ring 3'" Dmx="176~179" />
      <Function ID="9" Name="Ring 4" Display="'Ring 4'" Dmx="180~182" />
      <Function ID="10" Name="Checker Pattern A" Display="'Checker Pattern A'" Dmx="183~184" />
      <Function ID="11" Name="Checker Pattern B" Display="'Checker Pattern B'" Dmx="185~186" />
      <Function ID="12" Name="Random Zones" Display="'Random Zones'" Dmx="187~214" />
      <Function ID="13" Name="Circle Zome Chase CW" Display="'Circle Zome Chase CW'" Dmx="215~235" />
      <Function ID="14" Name="Circle Zone Chase CCW" Display="'Circle Zone Chase CCW'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="10~19" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="20~29" />
      <Function ID="4" Name="Flicker" Display="'Flicker'" Dmx="30~39" />
      <Function ID="5" Name="Flash" Display="'Flash'" Dmx="40~49" />
      <Function ID="6" Name="Police" Display="'Police'" Dmx="50~59" />
      <Function ID="7" Name="Welding" Display="'Welding'" Dmx="60~69" />
      <Function ID="8" Name="Fire" Display="'Fire'" Dmx="70~79" />
      <Function ID="9" Name="Candle" Display="'Candle'" Dmx="80~89" />
      <Function ID="10" Name="Television" Display="'Television'" Dmx="90~99" />
      <Function ID="11" Name="Dissolve" Display="'Dissolve'" Dmx="100~109" />
    </Attribute>
    <Attribute ID="Effect_Dimmer" Name="Effect Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />

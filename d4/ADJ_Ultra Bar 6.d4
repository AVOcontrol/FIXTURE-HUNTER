    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Control'==3" />
      <Condition Name="Sensitivity" ID="4" If="'Control'==4" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer Mode" Display="'Dimmer Mode'" Dmx="0~0" Update="Colour_Macro, Shutter" />
      <Function ID="2" Name="Colour Macro Mode" Display="'Colour Macro Mode'" Dmx="52~102" Update="Colour_Macro, Shutter" />
      <Function ID="3" Name="Program Mode" Display="'Program Mode'" Dmx="103~204" Update="Colour_Macro, Shutter" />
      <Function ID="4" Name="Sound Mode" Display="'Sound Mode'" Dmx="205~255" Update="Colour_Macro, Shutter" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

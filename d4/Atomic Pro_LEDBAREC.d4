<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LEDBAREC" ShortName="LEDBAREC" Company="Atomic Pro" Version="0">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="01-07-24" Author="Nic Morris" Comment="Created (no proof of manufacturer/model)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="11~30" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="31~50" />
      <Function ID="4" Name="Dream" Display="'Dream'" Dmx="51~70" />
      <Function ID="5" Name="Auto 1" Display="'Auto 1'" Dmx="71~90" />
      <Function ID="6" Name="Auto 2" Display="'Auto 2'" Dmx="91~110" />
      <Function ID="7" Name="Auto 3" Display="'Auto 3'" Dmx="111~130" />
      <Function ID="8" Name="Auto 4" Display="'Auto 4'" Dmx="131~150" />
      <Function ID="9" Name="Auto 5" Display="'Auto 5'" Dmx="151~170" />
      <Function ID="10" Name="Auto 6" Display="'Auto 6'" Dmx="171~190" />
      <Function ID="11" Name="Auto 7" Display="'Auto 7'" Dmx="191~210" />
      <Function ID="12" Name="Auto 8" Display="'Auto 8'" Dmx="211~230" />
      <Function ID="13" Name="Auto 9" Display="'Auto 9'" Dmx="231~250" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="56~59" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="60~69" WheelPosition="1" />

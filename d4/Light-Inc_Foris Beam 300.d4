      <Palette ID="7" Name="Aquamarine" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Blue" Number="6" Page="1" SetControl="Colour1:11,Colour1Func:1" />
      <Palette ID="9" Name="Dark Blue" Number="0" Page="1" SetControl="Colour1:15,Colour1Func:1" />

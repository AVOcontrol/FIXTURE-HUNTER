      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="64~127" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="128~191" />
      <Function ID="4" Name="Prism 1+2" Display="'Prism 1+2'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="1~63" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="127~64" />
      <Function ID="5" Name="Rot 90°" Display="'Rot 90° %.f%%',0~100" Dmx="192~207" />
      <Function ID="6" Name="Rot 180°" Display="'Rot 180° %.f%%',0~100" Dmx="208~223" />
      <Function ID="7" Name="Rot 270°" Display="'Rot 270° %.f%%',0~100" Dmx="224~239" />
      <Function ID="8" Name="Rot 360°" Display="'Rot 360° %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Prism_Macro" Name="Prism Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="8-Facet Prism Free Switch" Display="'8-Facet Prism Free Switch %.f%%',0~100" Dmx="55~16" />
      <Function ID="3" Name="24-Facet Prism Free Switch" Display="'24-Facet Prism Free Switch %.f%%',0~100" Dmx="95~56" />
      <Function ID="4" Name="8+24 Facet Prism Free Switch" Display="'8+24 Facet Prism Free Switch %.f%%',0~100" Dmx="135~96" />
      <Function ID="5" Name="8+24 Facet Prism to Free Switch" Display="'8+24 Facet Prism to Free Switch %.f%%',0~100" Dmx="175~136" />
      <Function ID="6" Name="24+8 Facet Prism to Free Switch" Display="'24+8 Facet Prism to Free Switch %.f%%',0~100" Dmx="215~176" />
      <Function ID="7" Name="8+24 Facet Prism Interlock Switch" Display="'8+24 Facet Prism Interlock Switch %.f%%',0~100" Dmx="255~216" />
    </Attribute>
    <Attribute ID="Frost/Colorful" Name="Frost/Colorful" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="64~127" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Colourful" Display="'Colourful'" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="25~99" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="100~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16" Id="f9aa550a-c3d9-4abd-87e9-de84292cac2f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="782eae03-e6cd-4d4c-9d10-993f79bb10c8" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="22" />
      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Prism_Macro" ChannelOffset="7" Wheel="24" />
      <Attribute ID="Frost/Colorful" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Pan" ChannelOffset="10,11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12,13" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="14" Wheel="25" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="28" />
      <Attribute ID="Lamp" ChannelOffset="16" Wheel="29" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />

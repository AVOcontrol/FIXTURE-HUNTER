      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="226~229" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="200~225" GoboSpin="0~0" GoboOrientation="0~0" />

      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6">
        <Swatch>4b757a94-1aed-4bdb-af47-4825aa0b0c56</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~77" WheelPosition="7">
        <Swatch>8defee86-a8bf-4c66-8ebd-8b16d33b460e</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>ba7286f1-719a-48cc-be24-820051977548</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="78~93" WheelPosition="1">

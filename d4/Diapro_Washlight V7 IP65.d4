<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Washlight V7 IP65" ShortName="WsLight V7" Company="Diapro">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="26-07-17" Author="Nic Morris" Comment="Created" />
  <History Date="27-07-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="27-07-17" Author="Nic Morris" Comment="Fixed shutter locate." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="848ca09a-51f4-4795-b54c-e9042e9f1935" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~24" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" />
      <Function ID="12" Name="Sine Pls" Display="'Sine Pls %.f%%',0~100" Dmx="244~230" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~70" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="71~100" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="101~130" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="131~160" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="161~190" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="191~220" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="Color, 3 DMX" Channels="3">
    <Import PearlRef="UKDPWV7C" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2d506c73-1602-4942-a491-acd83f7d4917" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Flash, 4 DMX" Channels="4">
    <Import PearlRef="UKDPWV7F" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8f3ffbfd-5b18-4187-94cd-b77bedeb6877" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Stage, 7 DMX" Channels="7">
    <Import PearlRef="UKDPWV7S" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5fc68520-9bb1-45ac-8fd3-2d28a3d2e51e" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
      <Attribute ID="ID" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="White_Macro" Name="White Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Studio White 3200K" Display="'Studio White 3200K'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="Studio White 3400K" Display="'Studio White 3400K'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="Studio White 4500K" Display="'Studio White 4500K'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="Studio White 4900K" Display="'Studio White 4900K'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="Studio White 5600K" Display="'Studio White 5600K'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>

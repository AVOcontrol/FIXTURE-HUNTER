      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="80~89" WheelPosition="8" />
      <Function ID="10" Name="Auto Colour 1" Display="'Auto Colour 1'" Dmx="90~102" />
      <Function ID="11" Name="Auto Colour 2" Display="'Auto Colour 2'" Dmx="103~115" />
      <Function ID="12" Name="Auto Colour 3" Display="'Auto Colour 3'" Dmx="116~128" />
      <Function ID="13" Name="Auto Colour 4" Display="'Auto Colour 4'" Dmx="129~141" />
      <Function ID="14" Name="Auto Colour 5" Display="'Auto Colour 5'" Dmx="142~154" />
      <Function ID="15" Name="Auto Colour 6" Display="'Auto Colour 6'" Dmx="155~167" />

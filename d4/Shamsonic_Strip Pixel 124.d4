  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Function_1" Name="Function 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Function_2" Name="Function 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Function_Spd" Name="Function Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shunt" Name="Shunt" Description="" Group="I" Merge="HTP">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="1st Line Dimming" Display="'1st Line Dimming %.1f%%',0.0~100.0" Dmx="20~127" />
      <Function ID="3" Name="2nd Line Dimming" Display="'2nd Line Dimming %.1f%%',0.0~100.0" Dmx="128~235" />
      <Function ID="4" Name="Both Line Brightness" Display="'Both Line Brightness %.f%%',0~100" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="46~75" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="76~105" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="106~135" Colour="0,0,255" />
      <Function ID="5" Name="Red Gren" Display="'Red Gren'" Dmx="136~165" Colour="255,255,255" />
      <Function ID="6" Name="Red Blue" Display="'Red Blue'" Dmx="166~195" Colour="255,255,255" />
      <Function ID="7" Name="Green Blue" Display="'Green Blue'" Dmx="196~225" Colour="255,255,255" />
      <Function ID="8" Name="Red Green Blue" Display="'Red Green Blue'" Dmx="226~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="A001, 8 DMX" Channels="8" Id="f8e51cfb-d045-4633-a3b9-635ac1d3e413">

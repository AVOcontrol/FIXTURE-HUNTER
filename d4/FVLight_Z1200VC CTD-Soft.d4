<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Z1200VC CTD-Soft" ShortName="Z1200VCCTD" Company="FVLight" Version="3">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>eac06a9d-698a-4cd9-a5fb-2121aff5658f</Thumbnail>
  <History Date="02-07-23" Author="Nic Morris" Comment="Created (confusing charts.  assume there is a selectable 8 or 16bit mode on the fixture.  gels are not defined.  light strobe effect green-magenta control contains range conflicts)" Version="0" />
  <History Date="02-07-23" Author="Nic Morris" Comment="(mode control invoves dynamic resolution switching which is not currently supported.  implemented as separate modes for now)" Version="0" />
  <History Date="04-07-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7b72af21-bd17-4deb-9801-c13fedd79c09" />
  <Control>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="3" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~195" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~6500" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green-Magenta" Name="Green-Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="- Green" Display="'- Green %.2f',1.00~0.00" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="+ Green" Display="'+ Green %.2f',0.00~1.00" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT(Gel)" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="5600K" Display="'5600K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Manufacturer" Name="Manufacturer" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R" Display="'R'" Dmx="0~0" Update="Series_Name" Colour="255,255,255" />
      <Function ID="2" Name="L" Display="'L'" Dmx="255~255" Update="Series_Name" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Series_Name" Name="Series Name" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4" />
      <Condition Name="L" ID="5,6,7,8,9" If="'Manufacturer'==2" />
      <Function ID="1" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Filters" Display="'Colour Filters'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Sto Selection" Display="'Sto Selection'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Cine Filters" Display="'Cine Filters'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="Colour Filters" Display="'Colour Filters'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="7" Name="600 Series" Display="'600 Series'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="8" Name="Cosmetic" Display="'Cosmetic'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="9" Name="700 Series" Display="'700 Series'" Dmx="128~159" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Name" Name="Gel Name" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CCT(Ext.Kelvin)" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2400~9900" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="x_Coordinate" Name="x Coordinate" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="x" Display="'%.2f',0.00~80.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="y_Coordinate" Name="y Coordinate" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DIAMOND19TW" ShortName="D19TW" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="09-01-15" Author="Nic Morris" Comment="Changed RGB Pixel to RGB and RGB to RGB Master so that it works with pixel mapper in response to manufacturer bug report." />
  <History Date="09-01-15" Author="Nic Morris" Comment="Applied cell layout in response to manufacturer information." />
  <History Date="11-03-15" Author="Nic Morris" Comment="Revised basic shutter ranges in line with revised documentation in response to manufacturer bug report." />
  <History Date="19-09-15" Author="Nic Morris" Comment="Inverted zoom (checked on actual fixture - documentation is incorrect)" />
  <History Date="21-09-15" Author="Nic Morris" Comment="Created from Prolights Diamond19" />
  <History Date="21-09-15" Author="Nic Morris" Comment="Created from Prolights Diamond19CC" />
  <History Date="18-10-15" Author="Ermanno Valvason" Comment="Updated strobe ranges in basic mode. Updated standard mode without PT fine. Corrected Whites names." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="06-01-17" Author="Nic Morris" Comment="Added Atlabase ID to Standard mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e049a74b-9de6-4884-b786-4d3913b48ab8" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FWD" Display="'Pulse FWD'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll FW" Display="'Scroll FW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll REV" Display="'Scroll REV'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="15:1" PowerOn="15:1" />
      <Condition Name="CTC" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="11,12,13,14" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="14,15" />
      <Function ID="1" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="224~227" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="228~231" Colour="255,255,255" />
      <Function ID="4" Name="3800K" Display="'3800K'" Dmx="232~235" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="236~239" Colour="255,255,255" />
      <Function ID="6" Name="4600K" Display="'4600K'" Dmx="240~243" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="244~247" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="248~251" Colour="255,255,255" />
      <Function ID="9" Name="6300K" Display="'6300K'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="11" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="12" Name="Warm White" Display="'Warm White'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="13" Name="Cool White" Display="'Cool White'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="14" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="Cool White" Display="'Cool White'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WW_Master" Name="WW Master" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,200" />
    </Attribute>
    <Attribute ID="CW_Master" Name="CW Master" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="CTO" Display="'CTO %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="CTB" Display="'CTB %.1f%%',0.0~100.0" Dmx="0~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="5" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="6" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="7" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="13">
    <Import PearlRef="PGD19TW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="69fba5ca-230f-4ceb-9bee-c3e466ce97c6" />
    <Include>
      <Attribute ID="Shutter_Func" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="9" Wheel="37" />
      <Attribute ID="WarmWhite" ChannelOffset="10" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="304756a7-77b1-40c4-b875-5bf2e726a085" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="WarmWhite" Wheel="10" />
        <Attribute ID="ColdWhite" Wheel="11" />
        <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="P/T_Func" ChannelOffset="6" Wheel="26" />
        <Attribute ID="Shutter_Func" ChannelOffset="7" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
        <Attribute ID="Colour1Func" ChannelOffset="10" Wheel="7" />
        <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
        <Attribute ID="Colour2" ChannelOffset="12" Wheel="37" />
        <Attribute ID="WW_Master" ChannelOffset="13" Wheel="40" />
        <Attribute ID="CW_Master" ChannelOffset="14" Wheel="41" />
        <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
        <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="16" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="18" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Basic 8bit" Channels="12">
    <Import PearlRef="PGD19TW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="52cd05ea-93c5-40e9-9ecc-dc77bd74933f" />
    <Include>
      <Attribute ID="Shutter1" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" ChannelOffset="6" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="8" Wheel="37" />
      <Attribute ID="WarmWhite" ChannelOffset="9" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="10" Wheel="11" />

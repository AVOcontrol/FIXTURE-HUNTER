      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="151~160" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="171~180" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="181~190" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="191~200" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="201~210" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="211~220" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="221~230" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="231~240" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="241~250" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~19" WheelPosition="1" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="20~29" WheelPosition="2" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="30~39" WheelPosition="3" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="40~49" WheelPosition="4" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="50~59" WheelPosition="5" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="60~69" WheelPosition="6" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="70~79" WheelPosition="7" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="80~89" WheelPosition="8" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="90~99" WheelPosition="9" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="100~109" WheelPosition="10" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="110~119" WheelPosition="11" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="120~129" WheelPosition="12" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="130~139" WheelPosition="13" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="140~149" WheelPosition="14" />
      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="150~159" WheelPosition="15" />
      <Function ID="17" Name="Colour 16" Display="'Colour 16'" Dmx="160~169" WheelPosition="16" />
      <Function ID="18" Name="Colour 17" Display="'Colour 17'" Dmx="170~179" WheelPosition="17" />
      <Function ID="19" Name="Colour 18" Display="'Colour 18'" Dmx="180~189" WheelPosition="18" />
      <Function ID="20" Name="Colour 19" Display="'Colour 19'" Dmx="190~199" WheelPosition="19" />
      <Function ID="21" Name="Colour 20" Display="'Colour 20'" Dmx="200~209" WheelPosition="20" />
      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="210~219" WheelPosition="21" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="220~229" WheelPosition="22" />
      <Function ID="24" Name="Colour 23" Display="'Colour 23'" Dmx="230~239" WheelPosition="23" />
      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="240~249" WheelPosition="24" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="250~255" WheelPosition="25" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="44 DMX" Channels="44">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Macro" ChannelOffset="1" Wheel="52" />
        <Attribute ID="Macro_Spd" ChannelOffset="2" Wheel="53" />
        <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="22" />

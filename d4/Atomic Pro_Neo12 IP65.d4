<Fixture Name="Neo12 IP65" ShortName="Neo12 IP65" Company="Atomic Pro" Version="9">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>c0779c34-aea4-40b7-9556-0ef93f2d0ca2</Thumbnail>
  <History Date="28-05-26" Author="Nic Morris" Comment="Created (hopeless documentation.  mostly nonsense.  tilt macro chart doesn't exist.  no pixel layout - made best guess)" Version="0" />
  <History Date="29-05-26" Author="Nic Morris" Comment="(note charts and specifications have a 204 channel mode but the charts are incomplete and don't make sense.  assumed is 206 channels for now...)" Version="8" />
  <History Date="30-05-26" Author="Nic Morris" Comment="Added missing Atlabase ID for 206 channel mode." Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1289fd11-eaea-44b0-ad63-c3d7a94ee0ae" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Macro" Name="Tilt Macro" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="5~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour_Temp" Name="Colour Temp" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2700~19000" Dmx="255~1" Colour="0,0,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700Hz" Display="'White 2700Hz'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="White 3200Hz" Display="'White 3200Hz'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="White 4200Hz" Display="'White 4200Hz'" Dmx="5~6" Colour="255,255,255" />
      <Function ID="5" Name="White 5600Hz" Display="'White 5600Hz'" Dmx="7~8" Colour="255,255,255" />
      <Function ID="6" Name="White 8000Hz" Display="'White 8000Hz'" Dmx="9~10" Colour="255,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="11~11" Colour="0,0,255" />
      <Function ID="8" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="12~48" Colour="0,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="49~49" Colour="0,255,255" />
      <Function ID="10" Name="Cy - Grn" Display="'Cy - Grn %.f%%',0~100" Dmx="50~86" Colour="0,255,255" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="87~87" Colour="0,255,0" />
      <Function ID="12" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="88~124" Colour="0,255,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="125~125" Colour="255,255,0" />
      <Function ID="14" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="126~162" Colour="255,255,0" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="163~163" Colour="255,0,0" />
      <Function ID="16" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="164~200" Colour="255,0,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="201~201" Colour="255,0,255" />
      <Function ID="18" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="202~238" Colour="255,0,255" />
      <Function ID="19" Name="Blue" Display="'Blue'" Dmx="239~239" Colour="0,0,255" />
      <Function ID="20" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="11~239" Colour="0,0,0" />
      <Function ID="21" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="247~240" Colour="0,0,0" />
      <Function ID="22" Name="Col Snap" Display="'Col Snap %.f%%',0~100" Dmx="255~248" Colour="0,0,0" />
    </Attribute>

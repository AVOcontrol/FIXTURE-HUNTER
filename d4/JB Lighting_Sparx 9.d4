      <Function ID="30" Name="Set 3 Rnd Op Pls" Display="'Set 3 Rnd Op Pls'" Dmx="69~69" />
      <Function ID="31" Name="Set 3 Rnd Flash Slow" Display="'Set 3 Rnd Flash Slow'" Dmx="70~70" />
      <Function ID="32" Name="Set 3 Rnd Cl Pls" Display="'Set 3 Rnd Cl Pls'" Dmx="71~71" />
      <Function ID="33" Name="Set 3 Random Rnd Flash Fast" Display="'Set 3 Random Rnd Flash Fast'" Dmx="72~72" />

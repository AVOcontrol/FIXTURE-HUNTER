      <Function ID="35" Name="Set 3 Random Rnd Flash Slow" Display="'Set 3 Random Rnd Flash Slow'" Dmx="74~74" />
      <Function ID="36" Name="Set 3 Random Rnd Cl Pls" Display="'Set 3 Random Rnd Cl Pls'" Dmx="75~75" />

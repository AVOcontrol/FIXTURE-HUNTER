  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Unknown" Name="Unknown" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~7" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="23~37" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="38~52" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="53~67" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="68~82" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="83~97" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="98~112" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="113~127" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="128~142" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="143~157" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="158~172" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="173~187" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="188~202" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="203~217" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="218~232" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="233~247" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Axis" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Z-Axis" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y/Z_Speed" Name="Y/Z Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14" Id="b4edc675-af64-44d8-9599-0ff938feb582">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Unknown" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Chase" ChannelOffset="8" Wheel="52" />
      <Attribute ID="Chase_Spd" ChannelOffset="9" Wheel="53" />
      <Attribute ID="Tilt" ChannelOffset="10,11" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="12" Wheel="2" />
      <Attribute ID="Y/Z_Speed" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

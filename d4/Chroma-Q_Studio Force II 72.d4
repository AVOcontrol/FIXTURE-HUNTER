  <History Date="25-01-21" Author="Nic Morris" Comment="Updated control channel functions and macros in line with latest charts." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="de56ee97-85c7-4c97-ba11-b1c57e88390b" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Kelvin" Name="Kelvin" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Warm-&gt;Cold" Display="'Warm-&gt;Cold %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="64~64" Colour="255,255,255" />
      <Function ID="4" Name="4400K" Display="'4400K'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="192~192" Colour="255,255,255" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="-Grn-&gt; +Grn" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Q-Fade" Name="Q-Fade" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="KH-&gt;RGBW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="DMX Smoothing Off" Display="'DMX Smoothing Off'" Dmx="11~12" />
      <Function ID="3" Name="DMX Smoothing Normal" Display="'DMX Smoothing Normal'" Dmx="13~14" />
      <Function ID="4" Name="Fan Off" Display="'Fan Off'" Dmx="41~42" />
      <Function ID="5" Name="Fan Low" Display="'Fan Low'" Dmx="43~44" />
      <Function ID="6" Name="Fan Full" Display="'Fan Full'" Dmx="45~46" />
      <Function ID="7" Name="Fan Auto" Display="'Fan Auto'" Dmx="47~48" />
      <Function ID="8" Name="RGBW White Normal" Display="'RGBW White Normal'" Dmx="55~56" />
      <Function ID="9" Name="RGBW Autowhite" Display="'RGBW Autowhite'" Dmx="57~58" />
      <Function ID="10" Name="PWM 750" Display="'PWM 750'" Dmx="71~72" />
      <Function ID="11" Name="PWM 1500" Display="'PWM 1500'" Dmx="73~74" />
      <Function ID="12" Name="PWM 3000" Display="'PWM 3000'" Dmx="75~76" />
      <Function ID="13" Name="PWM 6000" Display="'PWM 6000'" Dmx="77~78" />
      <Function ID="14" Name="PWM 12000" Display="'PWM 12000'" Dmx="79~80" />
      <Function ID="15" Name="PWM 24000" Display="'PWM 24000'" Dmx="81~82" />
      <Function ID="16" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="151~152" />
      <Function ID="17" Name="No DMX BO" Display="'No DMX BO'" Dmx="153~154" />
      <Function ID="18" Name="No DMX Look" Display="'No DMX Look'" Dmx="157~158" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

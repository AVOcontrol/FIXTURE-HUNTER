  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="29-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Storage" Name="Storage" Description="" Group="G">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Store A" Display="'Store A %.f',1~60" Dmx="0~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Store B" Display="'Store B %.f',1~60" Dmx="121~240" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Fade_Percent" Name="Fade Time" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cross-Fade" Name="Cross-Fade" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Cross-fade" Display="'Cross-fade'" Dmx="0~63" />
      <Function ID="2" Name="White-fade" Display="'White-fade'" Dmx="64~127" />
      <Function ID="3" Name="Black-fade" Display="'Black-fade'" Dmx="128~191" />
      <Function ID="4" Name="Color-fade" Display="'Color-fade'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

  <AtlaBase TypeID="3a3b3c04-fa97-43e7-92ee-55b3f9bddb75" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.f%%',100~0" Dmx="0~225" />
      <Function ID="2" Name="BO P/T" Display="'BO P/T'" Dmx="226~235" />
      <Function ID="3" Name="BO Col Gobo" Display="'BO Col Gobo'" Dmx="236~245" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="6,7,8,9" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="11,12,13,14,15" If="'Colour1Func'==3" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~24" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,0,0" />
      <Function ID="3" Name="Deep Yellow" Display="'Yellow'" Dmx="50~74" Colour="180,180,0" />
      <Function ID="4" Name="CTO" Display="'CTO'" Dmx="75~99" Colour="255,240,200" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="100~127" Colour="128,0,255" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="255,255,255" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="255,255,255" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="11" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~24" Colour="255,255,255" />
      <Function ID="12" Name="Red" Display="'Red %.f%%',0~100" Dmx="25~49" Colour="255,0,0" />
      <Function ID="13" Name="Deep Yellow" Display="'Yellow %.f%%',0~100" Dmx="50~74" Colour="180,180,0" />
      <Function ID="14" Name="CTO" Display="'CTO %.f%%',0~100" Dmx="75~99" Colour="255,240,200" />
      <Function ID="15" Name="Purple" Display="'Purple %.f%%',0~100" Dmx="100~127" Colour="128,0,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

  <History Date="26-01-23" Author="Nic Morris" Comment="Created (extremely poor documentation.  mostly nonsense.  no pixel layout.  no product specs or details.  no product name.  no idea what it is.  just made something up!)" Version="0" />
  <History Date="30-09-24" Author="Nic Morris" Comment="Created from Unknown LED Bar 2" Version="1" />
  <History Date="01-10-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="08-04-25" Author="Nic Morris" Comment="Created from Unknown 12 LED 3 in 1 Wall Washer Light (effectively identical.  no pixel layout)" Version="3" />

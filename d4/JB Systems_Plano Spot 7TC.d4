  <History Date="15-01-12" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-07-16" Author="Nic Morris" Comment="Created from JB Systems Plano Spot (mode 3 dimmer ranges slightly different)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="84277280-bc3e-4028-a270-e2f5fe0a8812" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Mode 1" ID="1,2,3,4" If="'Mode1'==1" />
      <Condition Name="Mode 2" ID="5" If="'Mode2'==2" />
      <Condition Name="Mode 3" ID="6,7" If="'Mode3'==3" />
      <Condition Name="Mode 4" ID="8,9,10" If="'Mode4'==4" />
      <Else ID="11" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~190" Intensity="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="191~200" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="5" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="6" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~160" Intensity="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~255" Intensity="0~0" />
      <Function ID="8" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="9" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="128~199" Intensity="0~0" />
      <Function ID="10" Name="Colour Macro" Display="'Colour Macro'" Dmx="200~255" Intensity="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode1" Name="Mode" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1" Display="'Mode 1'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Mode 2" Display="'Mode 2'" Dmx="0~0" Update="Dimmer" />
      <Function ID="3" Name="Mode 3" Display="'Mode 3'" Dmx="0~0" Update="Dimmer" />
      <Function ID="4" Name="Mode 4" Display="'Mode 4'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Mode2" Name="Mode" Description="" Group="S" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Mode 1" Display="'Mode 1'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Mode 2" Display="'Mode 2'" Dmx="0~0" Update="Dimmer" />
      <Function ID="3" Name="Mode 3" Display="'Mode 3'" Dmx="0~0" Update="Dimmer" />
      <Function ID="4" Name="Mode 4" Display="'Mode 4'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Mode3" Name="Mode" Description="" Group="S" Size="0">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Mode 1" Display="'Mode 1'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Mode 2" Display="'Mode 2'" Dmx="0~0" Update="Dimmer" />
      <Function ID="3" Name="Mode 3" Display="'Mode 3'" Dmx="0~0" Update="Dimmer" />
      <Function ID="4" Name="Mode 4" Display="'Mode 4'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Mode4" Name="Mode" Description="" Group="S" Size="0">
      <Locate Locate="4" PowerOn="4" />

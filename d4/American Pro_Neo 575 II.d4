      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.2f%%',0.00~100.00" Dmx="224~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 17 DMX" Channels="17">
    <Import PearlRef="AR_Neo5752S" DiamondRef="" WysiwygRef="" />

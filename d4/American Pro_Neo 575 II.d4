      <Function ID="17" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" />
      <Function ID="18" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" />
      <Function ID="19" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" />
      <Function ID="20" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="191~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',100~0" Dmx="192~223" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="224~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="0~191" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',100~0" Dmx="192~223" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="224~254" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Full Frost" Display="'Full Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Col/Gobo Fixed" Display="'Col/Gobo Fixed'" Dmx="0~0" />
      <Function ID="2" Name="Col Index" Display="'Col Index'" Dmx="20~29" />
      <Function ID="3" Name="Col/Gobo Index" Display="'Col/Gobo Index'" Dmx="30~39" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="6" Name="Reset_All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="8" Name="Reset Colour" Display="'Reset Colour'" Dmx="88~90" />
      <Function ID="9" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="91~93" />
      <Function ID="10" Name="Reset Intensity" Display="'Reset Intensity'" Dmx="94~96" />
      <Function ID="11" Name="Reset Other" Display="'Reset Other'" Dmx="97~99" />
      <Function ID="12" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="13" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="14" Name="Program 3" Display="'Program 3'" Dmx="140~159" />

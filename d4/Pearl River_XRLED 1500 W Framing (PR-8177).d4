      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="11~72" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="73~136" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="137~206" />

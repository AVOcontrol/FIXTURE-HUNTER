<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Panel" ShortName="LED Panel" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="04-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2c268160-da3f-438e-b1b0-440b75c85149" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Mode 1" ID="1,2,3,4,5" If="'Mode_1'==1" />
      <Condition Name="Mode 3" ID="6,7" If="'Mode_3'==1" />
      <Condition Name="Mode 4" ID="8,9,10" If="'Mode_4'==1" />
      <Else ID="11" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="8~190" Intensity="0~0" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="0~7" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="191~200" Intensity="0~0" />
      <Function ID="6" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~160" Intensity="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~255" Intensity="0~0" />
      <Function ID="8" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="9" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="128~199" Intensity="0~0" />
      <Function ID="10" Name="Colour Macro" Display="'Colour Macro %.f%%',0~100" Dmx="200~255" Intensity="0~0" />
      <Function ID="11" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode_1" Name="Mode 1" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Mode_3" Name="Mode 3" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Mode_4" Name="Mode 4" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="4">
    <Import PearlRef="AMELPNL1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d0edf93c-987c-45f3-8463-7b97f2409e4f" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Mode_1" Wheel="28" />
    </Include>
  </Mode>

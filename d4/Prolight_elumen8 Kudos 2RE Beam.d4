      <Function ID="12" Name="3200K" Display="'3200K'" Dmx="94~98" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="103~106" WheelPosition="12" Colour="255,100,0" />
      <Function ID="14" Name="5600K" Display="'5600K'" Dmx="111~115" WheelPosition="13" Colour="230,230,255" />
      <Function ID="15" Name="Deep Blue" Display="'Deep Blue'" Dmx="120~123" WheelPosition="14" Colour="0,0,200" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />

      <Function ID="26" Name="Blu/ 3200" Display="'Blu/ 3200'" Dmx="90~93" WheelPosition="10" Colour="0,0,255" />
      <Function ID="27" Name="3200/ Amb" Display="'3200/ Amb'" Dmx="99~102" WheelPosition="11" Colour="255,240,200" />
      <Function ID="28" Name="Amb/ 5600" Display="'Amb/ 5600'" Dmx="107~110" WheelPosition="12" Colour="255,100,0" />
      <Function ID="29" Name="5600/ D Blu" Display="'5600/ D Blu'" Dmx="116~119" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="D Blu/ Op" Display="'D Blu/ Op'" Dmx="124~127" WheelPosition="14" Colour="0,0,200" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="191~255" Colour="0,0,0" />

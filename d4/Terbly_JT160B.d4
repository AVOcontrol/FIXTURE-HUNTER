      <Function ID="9" Name="Azure" Display="'Azure'" Dmx="80~89" WheelPosition="8" Colour="0,255,255" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="90~99" WheelPosition="9" Colour="150,0,255" />
      <Function ID="11" Name="Navy Blue" Display="'Navy Blue'" Dmx="100~109" WheelPosition="10" Colour="0,0,200" />
      <Function ID="12" Name="Dark Yellow" Display="'Dark Yellow'" Dmx="110~119" WheelPosition="11" Colour="200,200,0" />
      <Function ID="13" Name="UV" Display="'UV'" Dmx="120~127" WheelPosition="12" Colour="50,0,200" />
      <Function ID="14" Name="Op - 1" Display="'Op - 1 %.f%%',0~100" Dmx="0~10" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="1 - 2" Display="'1 - 2 %.f%%',0~100" Dmx="10~20" WheelPosition="1" Colour="0,0,0" />
      <Function ID="16" Name="2 - 3" Display="'2 - 3 %.f%%',0~100" Dmx="20~30" WheelPosition="2" Colour="0,0,0" />

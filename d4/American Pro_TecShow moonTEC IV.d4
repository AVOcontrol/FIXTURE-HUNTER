<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TecShow moonTEC IV" ShortName="moonTEC IV" Company="American Pro">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="20-06-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" />
      <Function ID="2" Name="Static" Display="'Static %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="100~239" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R" Display="'R'" Dmx="0~17" Colour="255,255,255" />
      <Function ID="2" Name="G" Display="'G'" Dmx="18~34" Colour="255,255,255" />
      <Function ID="3" Name="B" Display="'B'" Dmx="35~51" Colour="255,255,255" />
      <Function ID="4" Name="W" Display="'W'" Dmx="52~68" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="69~85" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="86~102" Colour="255,255,255" />
      <Function ID="7" Name="R+W" Display="'R+W'" Dmx="103~119" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="120~136" Colour="255,255,255" />
      <Function ID="9" Name="G+W" Display="'G+W'" Dmx="137~153" Colour="255,255,255" />
      <Function ID="10" Name="B+W" Display="'B+W'" Dmx="154~170" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="171~187" Colour="255,255,255" />
      <Function ID="12" Name="R+G+W" Display="'R+G+W'" Dmx="188~204" Colour="255,255,255" />
      <Function ID="13" Name="R+B+W" Display="'R+B+W'" Dmx="205~221" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="222~238" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="239~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="ARTSMTIV" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Effect" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Effect_Spd" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>
</Fixture>
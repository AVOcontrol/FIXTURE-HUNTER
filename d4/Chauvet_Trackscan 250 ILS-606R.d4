      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="535ed4e2-0cc9-4879-8728-a023aa304119" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="3" Wheel="15" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="2" Name="Amber" Number="2" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="5" Name="Light Green" Number="0" Page="1" SetControl="Colour1:10,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour11:1,Colour1Func1:1" />

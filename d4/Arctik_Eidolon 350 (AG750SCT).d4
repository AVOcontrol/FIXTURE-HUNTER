      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="28~29" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="30~31" Colour="255,255,255" />
      <Function ID="8" Name="5400K" Display="'5400K'" Dmx="32~33" Colour="255,255,255" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="34~35" Colour="255,255,255" />
      <Function ID="10" Name="6000K" Display="'6000K'" Dmx="36~37" Colour="255,255,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="38~39" Colour="255,255,255" />
      <Function ID="12" Name="6800K" Display="'6800K'" Dmx="40~41" Colour="255,255,255" />
      <Function ID="13" Name="L106" Display="'L106'" Dmx="42~43" Colour="255,255,255" />
      <Function ID="14" Name="L194" Display="'L194'" Dmx="44~45" Colour="255,255,255" />
      <Function ID="15" Name="L019" Display="'L019'" Dmx="46~47" Colour="255,255,255" />
      <Function ID="16" Name="R08" Display="'R08'" Dmx="48~49" Colour="255,255,255" />
      <Function ID="17" Name="L213" Display="'L213'" Dmx="50~51" Colour="255,255,255" />
      <Function ID="18" Name="R80" Display="'R80'" Dmx="52~53" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Laser" ShortName="Laser" Company="FX Lab">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="17-02-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="OFF" Display="'OFF'" Dmx="0~0" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="50~99" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="100~149" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="0~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="100~199" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="200~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Rot_Speed" Name="Rot Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Twinkle_Speed" Name="Twinkle Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red + Green" Display="'Red + Green'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="100~199" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKFXLBLZ" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Rot_Speed" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Twinkle_Speed" ChannelOffset="4" Wheel="22" />
    </Include>
  </Mode>
</Fixture>
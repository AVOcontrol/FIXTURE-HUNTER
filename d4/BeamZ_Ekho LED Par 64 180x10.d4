      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~100" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="101~150" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="151~200" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="201~250" />
      <Function ID="7" Name="Sound 3" Display="'Sound 3'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

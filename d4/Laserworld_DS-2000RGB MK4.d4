  <History Date="17-03-19" Author="Nic Morris" Comment="Added 34 DMX mode." Version="2" />
  <History Date="12-02-20" Author="Nic Morris" Comment="Updated in line with firmware version 202002xx in response to manufacturer request (mode select 1+2, trapezoid x+y and barrel distortion x+y)" Version="3" />
  <History Date="25-03-20" Author="Nic Morris" Comment="Changed colour to default to Original and renamed Open to Enable C-Mix" Version="4" />
  <History Date="14-10-20" Author="Nic Morris" Comment="Added swatches to professional mode pattern functions." Version="5" />
  <History Date="14-10-20" Author="Nic Morris" Comment="Changed professional mode pattern control attribute ID to File and added dummy Folder control for compatibility." Version="6" />
  <History Date="06-09-25" Author="Nic Morris" Comment="Created from Laserworld ShowNET" Version="7" />

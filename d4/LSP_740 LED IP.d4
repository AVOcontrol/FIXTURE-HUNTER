  <AtlaBase TypeID="7d2df4d4-3c11-4c43-8b20-c1943b803979" />
  <Control>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="4~39" />
      <Function ID="3" Name="Pulse" Display="'Pulse'" Dmx="40~75" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse'" Dmx="76~111" />
      <Function ID="5" Name="Gradient" Display="'Gradient'" Dmx="112~147" />
      <Function ID="6" Name="Jump" Display="'Jump'" Dmx="148~183" />
      <Function ID="7" Name="Pulse" Display="'Pulse'" Dmx="184~219" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',3200~7500" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="A" Display="'A'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="Y1" Display="'Y1'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="Y2" Display="'Y2'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="G" Display="'G'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="T" Display="'T'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="C" Display="'C'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="B" Display="'B'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="L" Display="'L'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="M1" Display="'M1'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="M2" Display="'M2'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="P" Display="'P'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="CTO, 3200K" Display="'CTO, 3200K'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="CTO, 5600K" Display="'CTO, 5600K'" Dmx="224~239" Colour="255,255,255" />
      <Function ID="16" Name="CTO, 7200K" Display="'CTO, 7200K'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Saturation" Display="'Saturation %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
  </Control>

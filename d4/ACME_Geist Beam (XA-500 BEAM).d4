  <History Date="10-01-20" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="14-01-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="12-05-20" Author="Nic Morris" Comment="Updated in line with latest charts (16bit focus and channel assignment adjustments)" Version="3" />
  <History Date="13-05-20" Author="Nic Morris" Comment="Revised Atlabase ID's to new new modes." Version="4" />
  <History Date="26-05-20" Author="Nic Morris" Comment="Inverted gobo 1 image order, removed colour 'soften' and revised index range in line with latest charts in response to manufacturer request." Version="5" />
  <History Date="03-06-20" Author="Nic Morris" Comment="Revised fixed colour names in line with latest documentation in response to manufacturer request." Version="6" />
  <History Date="09-06-20" Author="Nic Morris" Comment="Corrected macros" Version="7" />
  <History Date="09-06-20" Author="Nic Morris" Comment="Revised fixed colour names (yet again!)" Version="8" />
  <History Date="30-08-22" Author="Nic Morris" Comment="Updated in line with latest documentation (adds CTO control to both modes and switches dim curve control functions around).  Added macros for non-reset control functions." Version="9" />
  <History Date="01-09-22" Author="Nic Morris" Comment="Revised Atlabase mode IDs to updated version." Version="10" />
  <Manual Filename="" Summary="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sparx 12" ShortName="Sparx 12" Company="JB Lighting" Version="14">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>a8d36830-832b-4c2e-89c5-9376a8ffac3a</Thumbnail>
  <History Date="11-05-18" Author="Nic Morris" Comment="Created (very limited information.  channels only.  initially implemented as multi-part patch)" Version="1" />
  <History Date="21-12-18" Author="Nic Morris" Comment="Added mode 1 (still very limited and messy information)" Version="2" />
  <History Date="23-05-19" Author="Nic Morris" Comment="Complete rewrite in line with DMX chart v1.07, Software &gt;= 1.00 (doesn't bear much resemblence to the intial documentation)" Version="3" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Note charts have Cooling Standard control function at different values depending on mode.  Looks like an error.)" Version="4" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Mode 1 and 2 charts have P/T Speed and Effect Speed but with no channel assignments)" Version="5" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Effect Mode ranges are vague.  Effects have duplicates that look like errors.  Made best guess/reasonable assumption)" Version="6" />
  <History Date="23-05-19" Author="Nic Morris" Comment="Implemented Mode 4 as multi-part patch only for now.  I feel this would be impractical in a single mode at the moment.  This will not simulate in the integrated Capture Visualiser." Version="7" />
  <History Date="24-05-19" Author="Nic Morris" Comment="Note Pattern RGBW controls not currently used.  Left for now as option to link to pattern cell RGBW instead of main RGBW in Modes 1 and 2." Version="8" />
  <History Date="25-05-19" Author="Nic Morris" Comment="Changed mode 4 layer masters to use xfade layer control instead of xfade fx/pixel." Version="9" />
  <History Date="25-05-19" Author="Nic Morris" Comment="Fixed shutter wheel display units.  It is not clear how this broke." Version="10" />
  <History Date="12-10-22" Author="Nic Morris" Comment="Created from JB Lighting Sparx 18" Version="11" />
  <Manual Filename="" Summary="" />

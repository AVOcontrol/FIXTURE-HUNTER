  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'CTO C-Mix %.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="9252~9252" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="13107~13107" Colour="255,255,255" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="23130~23130" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="31611~31611" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.2f%%',0.00~100.00" Dmx="32382~257" Colour="255,255,255" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="32639~32896" Colour="0,0,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta %.2f%%',0.00~100.00" Dmx="33153~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="XFade" Name="XFade" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="XFade" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Fan_Mode" Name="Fan Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Flex" Display="'Flex'" Dmx="0~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="51~101" />
      <Function ID="3" Name="Slow" Display="'Slow'" Dmx="102~152" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="153~203" />
      <Function ID="5" Name="FLX2" Display="'FLX2'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation1" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="-ve" Display="'-ve %.2f%%',-100.00~0.00" Dmx="257~32125" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="32382~32639" Colour="255,255,255" />
      <Function ID="4" Name="+ve" Display="'+ve %.2f%%',0.00~100.00" Dmx="32896~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="4x100W White 2 in 1 LED COB Blind" ShortName="4x100Blind" Company="Unknown" Version="4">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="04-04-19" Author="Nic Morris" Comment="Created (poor documentation.  guessed pixel layout)" Version="1" />
  <History Date="09-03-20" Author="Nic Morris" Comment="Created from Unknown 4mole CW-WW" Version="2" />
  <History Date="11-03-20" Author="Nic Morris" Comment="Added Atlabase ID's (poor documentation.  contains one incomplete 10 channel mode and one incomplete 14 channel mode.  no pixel layout.  made best guess...)" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Light Selection" Display="'Light Selection'" Dmx="11~22" />
      <Function ID="3" Name="Col Gradate 1" Display="'Col Gradate 1'" Dmx="23~34" />
      <Function ID="4" Name="Col Gradate 2" Display="'Col Gradate 2'" Dmx="35~46" />
      <Function ID="5" Name="Col Gradate 3" Display="'Col Gradate 3'" Dmx="47~58" />
      <Function ID="6" Name="Col Gradate 4" Display="'Col Gradate 4'" Dmx="59~70" />
      <Function ID="7" Name="Col Gradate 5" Display="'Col Gradate 5'" Dmx="71~82" />
      <Function ID="8" Name="Col Gradate 6" Display="'Col Gradate 6'" Dmx="83~94" />
      <Function ID="9" Name="Col Gradate 7" Display="'Col Gradate 7'" Dmx="95~106" />
      <Function ID="10" Name="Col Gradate 8" Display="'Col Gradate 8'" Dmx="107~118" />
      <Function ID="11" Name="Col Gradate 1-8 Loop" Display="'Col Gradate 1-8 Loop'" Dmx="119~130" />
      <Function ID="12" Name="Col Jump Change 1" Display="'Col Jump Change 1'" Dmx="131~142" />
      <Function ID="13" Name="Col Jump Change 2" Display="'Col Jump Change 2'" Dmx="143~154" />
      <Function ID="14" Name="Col Jump Change 3" Display="'Col Jump Change 3'" Dmx="155~166" />
      <Function ID="15" Name="Col Jump Change 4" Display="'Col Jump Change 4'" Dmx="167~178" />
      <Function ID="16" Name="Col Jump Change 5" Display="'Col Jump Change 5'" Dmx="179~190" />
      <Function ID="17" Name="Col Jump Change 6" Display="'Col Jump Change 6'" Dmx="191~202" />
      <Function ID="18" Name="Col Jump Change 7" Display="'Col Jump Change 7'" Dmx="203~214" />
      <Function ID="19" Name="Col Jump Change 8" Display="'Col Jump Change 8'" Dmx="215~226" />
      <Function ID="20" Name="Col Jump Change 9" Display="'Col Jump Change 9'" Dmx="227~238" />
      <Function ID="21" Name="Col Pulse Change" Display="'Col Pulse Change'" Dmx="239~250" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10" Id="48437f33-baa7-42d7-a6dd-9054fb4a46c7">

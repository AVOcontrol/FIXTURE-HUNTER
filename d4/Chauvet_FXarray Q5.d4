<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FXarray Q5" ShortName="FXarray Q5" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="14-01-17" Author="Nic Morris" Comment="Created" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from FXArray Q5 to FXarray Q5" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Revised shutter function names (changed 'Open' to 'Sound')" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~75" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="76~110" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="111~145" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="146~180" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="181~215" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="SMD_Col" Name="SMD Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~21" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="22~37" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="38~53" Colour="255,255,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="54~69" Colour="255,255,255" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="70~101" Colour="255,255,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="102~117" Colour="255,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="118~133" Colour="255,255,255" />
      <Function ID="9" Name="Auto 1" Display="'Auto 1'" Dmx="134~149" Colour="255,255,255" />
      <Function ID="10" Name="Auto 2" Display="'Auto 2'" Dmx="150~165" Colour="255,255,255" />
      <Function ID="11" Name="Auto 3" Display="'Auto 3'" Dmx="166~181" Colour="255,255,255" />
      <Function ID="12" Name="Auto 4" Display="'Auto 4'" Dmx="182~197" Colour="255,255,255" />
      <Function ID="13" Name="Auto 5" Display="'Auto 5'" Dmx="198~213" Colour="255,255,255" />
      <Function ID="14" Name="Auto 6" Display="'Auto 6'" Dmx="214~229" Colour="255,255,255" />
      <Function ID="15" Name="Auto 7" Display="'Auto 7'" Dmx="230~245" Colour="255,255,255" />
      <Function ID="16" Name="Auto 8" Display="'Auto 8'" Dmx="246~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="SMD_Strobe" Name="SMD Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="30 DMX" Channels="30">

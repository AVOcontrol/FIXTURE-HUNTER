  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a40dfaca-d9d8-4fd2-9291-1a499cabb01e" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="15~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Strobe" ID="1,2" If="'Program'==1||'Program1'==1" />
      <Condition Name="Sound" ID="3,4" If="'Program'==28||'Program1'==9" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="5" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~114" Update="Shutter" />
      <Function ID="5" Name="Auto 1" Display="'Auto 1'" Dmx="115~119" Update="Shutter" />
      <Function ID="6" Name="Auto 2" Display="'Auto 2'" Dmx="120~124" Update="Shutter" />
      <Function ID="7" Name="Auto 3" Display="'Auto 3'" Dmx="125~129" Update="Shutter" />
      <Function ID="8" Name="Auto 4" Display="'Auto 4'" Dmx="130~134" Update="Shutter" />
      <Function ID="9" Name="Auto 5" Display="'Auto 5'" Dmx="135~139" Update="Shutter" />
      <Function ID="10" Name="Auto 6" Display="'Auto 6'" Dmx="140~144" Update="Shutter" />
      <Function ID="11" Name="Auto 7" Display="'Auto 7'" Dmx="145~149" Update="Shutter" />
      <Function ID="12" Name="Auto 8" Display="'Auto 8'" Dmx="150~154" Update="Shutter" />
      <Function ID="13" Name="Auto 9" Display="'Auto 9'" Dmx="155~159" Update="Shutter" />
      <Function ID="14" Name="Auto 10" Display="'Auto 10'" Dmx="160~164" Update="Shutter" />
      <Function ID="15" Name="Auto 11" Display="'Auto 11'" Dmx="165~169" Update="Shutter" />

      <Function ID="22" Name="Auto 18" Display="'Auto 18'" Dmx="200~204" Update="Shutter" />
      <Function ID="23" Name="Auto 19" Display="'Auto 19'" Dmx="205~209" Update="Shutter" />
      <Function ID="24" Name="Auto 20" Display="'Auto 20'" Dmx="210~214" Update="Shutter" />
      <Function ID="25" Name="Auto 21" Display="'Auto 21'" Dmx="215~219" Update="Shutter" />
      <Function ID="26" Name="Auto 22" Display="'Auto 22'" Dmx="220~224" Update="Shutter" />
      <Function ID="27" Name="Auto 23" Display="'Auto 23'" Dmx="225~229" Update="Shutter" />
      <Function ID="28" Name="Sound" Display="'Sound'" Dmx="230~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Program1" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~114" Update="Shutter" />
      <Function ID="5" Name="Auto Chase" Display="'Auto Chase'" Dmx="115~127" Update="Shutter" />
      <Function ID="6" Name="Auto Fade" Display="'Auto Fade'" Dmx="128~159" Update="Shutter" />
      <Function ID="7" Name="Auto 3-Col Snap" Display="'Auto 3-Col Snap'" Dmx="160~191" Update="Shutter" />
      <Function ID="8" Name="Auto 7-Col Snap" Display="'Auto 7-Col Snap'" Dmx="192~223" Update="Shutter" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

      <Function ID="8" Name="8000-10000" Display="'%.fK',8000~10000" Dmx="216~255" Colour="255,255,255" />
      <Function ID="9" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="1~13" Colour="255,0,0" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="14~27" Colour="0,255,0" />
      <Function ID="12" Name="Blue" Display="'Blue'" Dmx="28~41" Colour="0,0,255" />
      <Function ID="13" Name="White" Display="'White'" Dmx="42~55" Colour="255,255,255" />
      <Function ID="14" Name="Pastel Red" Display="'Pastel Red'" Dmx="56~69" Colour="255,100,100" />
      <Function ID="15" Name="Pastel Green" Display="'Pastel Green'" Dmx="70~83" Colour="128,255,0" />
      <Function ID="16" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="84~97" Colour="0,128,255" />
      <Function ID="17" Name="Cyan" Display="'Cyan'" Dmx="98~111" Colour="0,255,255" />

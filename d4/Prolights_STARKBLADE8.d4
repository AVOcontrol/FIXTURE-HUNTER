      <Function ID="23" Name="Full White" Display="'Full White'" Dmx="182~195" Colour="255,255,255" />
      <Function ID="24" Name="Full-3200K" Display="'Full-3200K %.f%%',0~100" Dmx="196~225" Colour="255,255,255" />
      <Function ID="25" Name="3200-4200K" Display="'3200-4200K %.f%%',0~100" Dmx="226~235" Colour="255,255,255" />
      <Function ID="26" Name="4200-5600K" Display="'4200-5600K %.f%%',0~100" Dmx="236~255" Colour="255,255,255" />
      <Function ID="27" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />

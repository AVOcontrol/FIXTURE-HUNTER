  <Mode Name="V.2006, 13 DMX" Channels="13">
    <Import PearlRef="CHQS3003" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="530" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="687beb62-6fbc-4daf-8c25-ed53c6d4bb44" />

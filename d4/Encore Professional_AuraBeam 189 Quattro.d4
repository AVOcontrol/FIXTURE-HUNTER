      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="88~91" WheelPosition="11" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="96~99" WheelPosition="12" Colour="0,0,0" />

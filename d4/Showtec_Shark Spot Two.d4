  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e50b9664-5143-4726-b162-a65faeae2567" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~249" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="100~149" />
      <Function ID="5" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="150~199" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~39" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="48~55" WheelPosition="3" Colour="0,255,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~71" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="80~87" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="96~103" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="112~119" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="8~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="24~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Cy" Display="'Yel/ Cy'" Dmx="40~47" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Cy/ Grn" Display="'Cy/ Grn'" Dmx="56~63" WheelPosition="3" Colour="0,255,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="72~79" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="88~95" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Mag/ Blu" Display="'Mag/ Blu'" Dmx="104~111" WheelPosition="6" Colour="255,0,255" />
      <Function ID="16" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="120~127" WheelPosition="7" Colour="0,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~194" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="189~128" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>aba08f71-8530-479b-9a90-d2ceedac6705</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~30" WheelPosition="1">
        <Swatch>3b2bf46d-5cf9-49fe-8e6a-e1a82bc8ec19</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="31~45" WheelPosition="2">
        <Swatch>e5eb8b8a-3713-4417-b18f-9db396f70d2f</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="46~60" WheelPosition="3">
        <Swatch>be9067c4-c383-4f9f-8ac3-e678fde82377</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="61~75" WheelPosition="4">
        <Swatch>ce7f2923-b78b-443d-8188-251c95f3fcae</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="76~90" WheelPosition="5">
        <Swatch>765939ac-11a0-4a4a-bbd1-b195f0c608bd</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="91~105" WheelPosition="6">
        <Swatch>bfeeb540-5ac8-469d-a619-e21d8cd4dbb4</Swatch>
      </Function>
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>aba08f71-8530-479b-9a90-d2ceedac6705</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="106~119" WheelPosition="1">
        <Swatch>3b2bf46d-5cf9-49fe-8e6a-e1a82bc8ec19</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="120~133" WheelPosition="2">
        <Swatch>e5eb8b8a-3713-4417-b18f-9db396f70d2f</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="134~147" WheelPosition="3">
        <Swatch>be9067c4-c383-4f9f-8ac3-e678fde82377</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="148~161" WheelPosition="4">
        <Swatch>ce7f2923-b78b-443d-8188-251c95f3fcae</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="162~175" WheelPosition="5">
        <Swatch>765939ac-11a0-4a4a-bbd1-b195f0c608bd</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="176~189" WheelPosition="6">
        <Swatch>bfeeb540-5ac8-469d-a619-e21d8cd4dbb4</Swatch>
      </Function>
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="221~190" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll %.f%%',0~100" Dmx="222~223" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="189~193" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~194" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="189~193" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="188~128" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~41" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="42~67" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="68~93" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="94~115" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="116~141" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="142~167" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="168~193" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="194~209" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="210~219" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="19x40W LED Zoom Wash" ShortName="19x40W Zm" Company="Unknown" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="31-05-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="07-06-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b1cc0c3e-75ed-43b9-bf4b-6c9f32a2f3d2" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="80~100" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~11" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Lightning" Display="'Rnd Lightning %.f%%',0~100" Dmx="204~190" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="20~29" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Colour="0,255,0" />
      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="40~49" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Colour="0,0,255" />
      <Function ID="7" Name="B+R" Display="'B+R'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="R+G+W" Display="'R+G+W'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="R+B+W" Display="'R+B+W'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="14" Name="Rainbow Effect 1" Display="'Rainbow Effect 1'" Dmx="128~165" Colour="255,255,255" />
      <Function ID="15" Name="Rainbow Effect 2" Display="'Rainbow Effect 2'" Dmx="167~202" Colour="255,255,255" />
      <Function ID="16" Name="Rainbow Effect 3" Display="'Rainbow Effect 3'" Dmx="203~239" Colour="255,255,255" />
      <Function ID="17" Name="Rnd Rainbow" Display="'Rnd Rainbow'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~30" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="31~45" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="46~60" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="61~75" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="76~90" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="91~105" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="106~120" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="121~135" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="136~150" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="151~165" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="166~180" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="181~195" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="196~210" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="211~225" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="226~240" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Normal, 17 DMX" Channels="17" Id="0c47d1f4-c893-4375-af61-b2d08efa1f43">

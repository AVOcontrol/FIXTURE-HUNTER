  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="02-01-17" Author="Nic Morris" Comment="Removed Atlabase ID - channel count doesn't match.  There are at least 3 different charts/manuals for this." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="64~127" />
      <Function ID="3" Name="Automatic" Display="'Automatic'" Dmx="128~191" />
      <Function ID="4" Name="Laser Off" Display="'Laser Off'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Point Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Speed1" Name="Line Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="LZ_ELD100_G" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Speed1" ChannelOffset="4" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
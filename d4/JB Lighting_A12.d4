      <Function ID="9" Name="Random" Display="'Random %.1f',0.0~5.0" Dmx="225~239" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 1" Display="'Gobo 1 %.1f',0.0~5.0" Dmx="17~31" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2" Display="'Gobo 2 %.1f',0.0~5.0" Dmx="49~63" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3" Display="'Gobo 3 %.1f',0.0~5.0" Dmx="81~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 4" Display="'Gobo 4 %.1f',0.0~5.0" Dmx="113~127" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 5" Display="'Gobo 5 %.1f',0.0~5.0" Dmx="145~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6" Display="'Gobo 6 %.1f',0.0~5.0" Dmx="177~191" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 7" Display="'Gobo 7 %.1f',0.0~5.0" Dmx="209~223" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Random" Display="'Random %.1f',0.0~5.0" Dmx="241~255" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />

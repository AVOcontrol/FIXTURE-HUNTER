    <Attribute ID="PatternFunc" Name="Pattern Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern" Display="'Pattern'" Dmx="0~0" Update="Pattern" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern Fade" Display="'Pattern Fade'" Dmx="0~0" Update="Pattern" GoboSpin="0~0" GoboOrientation="0~0" />

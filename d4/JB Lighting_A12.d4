    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pattern" ID="1,2,3,4,5,6,7,8,9" If="'PatternFunc'==1" />
      <Condition Name="Pattern Fade" ID="10,11,12,13,14,15,16,17,18" If="'PatternFunc'==2" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1 %.1f',0.0~5.0" Dmx="1~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2 %.1f',0.0~5.0" Dmx="33~47" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3 %.1f',0.0~5.0" Dmx="65~79" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

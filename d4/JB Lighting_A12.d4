<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="A12" ShortName="A12" Company="JB Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="19-09-11" Author="John Rogers" Comment="Created to preliminary specifications. This file will need updating at a later date." />
  <History Date="28-10-11" Author="Gregory Haynes" Comment="Changed channel order to match current specs." />
  <History Date="18-11-11" Author="John Rogers" Comment="Edited Shutter locate value to Open." />
  <History Date="22-02-12" Author="Peter Budd" Comment="Edited added S8, S16, C8, and C16 modes and cell, added Colour, Pattern, P/T Speed, and effect speed." />
  <History Date="13-08-12" Author="Peter Budd" Comment="Corrected channel assignment in 38 channel mode" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Added physical p/t limits" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Changed shutter fade and random fade from fixed to percentage ranges." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Changed zoom range to 8-48 degrees in line with documentation." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed 38 DMX, 16bit mode in response to customer bug report and in line with documentation." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed colour 1 and colour 2 attributes (legacy from removed mode)." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed Speed 1 and Speed 2 attributes (legacy)." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Fixed cell mapping in 38 DMX mode in response to customer bug report and in line with documentation." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Fixed and added macros.  Fixed shutter palettes." />
  <History Date="07-04-14" Author="Nic Morris" Comment="Shortened shutter function names to fit in Expert LCD" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Added colour function index.  Inverted speed wheel direction." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="22-06-16" Author="Nic Morris" Comment="Revised control functions and macros.  Chaned pattern functions to variable ranges." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fc94c962-3577-41f0-9065-e411fc8970f1" />

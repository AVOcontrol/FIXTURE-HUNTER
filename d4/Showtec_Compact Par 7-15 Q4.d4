    <Attribute ID="Red_-_&gt;_RGBW" Name="Red - &gt; RGBW" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Xfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="23~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fade In" Display="'Fade In'" Dmx="52~101" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="102~152" />
      <Function ID="4" Name="Fade Out" Display="'Fade Out'" Dmx="153~203" />
      <Function ID="5" Name="Colour Flow" Display="'Colour Flow'" Dmx="204~254" />
      <Function ID="6" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Speed 0" Display="'Speed 0'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="51~101" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="102~152" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="153~203" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

      <Function ID="7" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="111~130" Colour="255,0,255" />
      <Function ID="8" Name="Red/Grn/Bl" Display="'Red/Grn/Bl %.f%%',0~100" Dmx="131~150" Colour="255,0,0" />
      <Function ID="9" Name="Bl/Rd/Grn" Display="'Bl/Rd/Grn %.f%%',0~100" Dmx="151~170" Colour="255,255,255" />
      <Function ID="10" Name="RGB" Display="'RGB %.f%%',0~100" Dmx="171~200" Colour="255,255,255" />
      <Function ID="11" Name="CTO 1" Display="'CTO 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="12" Name="CTO 2" Display="'CTO 2'" Dmx="206~210" Colour="255,255,255" />

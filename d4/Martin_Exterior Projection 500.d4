    <AtlaBase ModeID="4918a02c-0967-4175-a471-8096240210a9" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="6,7" Wheel="15" />
      <Attribute ID="Gobo_Anim" ChannelOffset="8" Wheel="24" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Prism_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Focus" ChannelOffset="11,12" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>

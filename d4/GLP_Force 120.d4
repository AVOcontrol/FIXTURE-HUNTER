  <Thumbnail>d88ebef6-641a-48f4-93d6-1289bcb684d5</Thumbnail>
  <History Date="03-02-18" Author="Nic Morris" Comment="Created (based on charts provided by manufacturer.  channel order is different in docs on website)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="4~128" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="129~132" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~239" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="16~47" />
      <Function ID="5" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="48~79" />
      <Function ID="6" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="80~111" />
      <Function ID="7" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="112~143" />
      <Function ID="8" Name="Pause" Display="'Pause %.f%%',0~100" Dmx="144~199" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="16~23" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="24~31" Colour="255,128,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="32~39" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="40~47" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="48~55" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="56~63" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="64~71" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="72~79" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="80~87" Colour="180,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="88~95" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="96~103" Colour="255,150,150" />
      <Function ID="14" Name="CTC 3200K" Display="'CTC 3200K'" Dmx="104~111" Colour="255,240,200" />
      <Function ID="15" Name="CTC 5600K" Display="'CTC 5600K'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="CTC 7200K" Display="'CTC 7200K'" Dmx="120~127" Colour="230,230,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="129~223" Colour="255,255,255" />
      <Function ID="19" Name="Random" Display="'Random %.f%%',0~100" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="PWM 582Hz" Display="'PWM 582Hz'" Dmx="100~102" />

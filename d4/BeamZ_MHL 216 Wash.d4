    </Attribute>
    <Attribute ID="White1" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red %.f%%',0~100" Dmx="8~72" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="73~136" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="137~200" Colour="0,0,255" />
      <Function ID="5" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="201~228" Colour="0,0,0" />
      <Function ID="6" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="229~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White %.f%%',0~100" Dmx="8~72" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White %.f%%',0~100" Dmx="73~136" Colour="255,255,255" />
      <Function ID="4" Name="Amber" Display="'Amber %.f%%',0~100" Dmx="137~200" Colour="255,255,255" />
      <Function ID="5" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="201~228" Colour="0,0,0" />
      <Function ID="6" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="229~255" Colour="0,0,0" />
    </Attribute>
  </Control>

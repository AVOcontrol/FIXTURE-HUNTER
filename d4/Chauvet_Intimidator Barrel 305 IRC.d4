        <Swatch>d551d929-1e57-4e57-8b9f-8395fa1f54a4</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="111~104" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>1fcf5b20-2ad2-4255-81ba-4ef0b4a942fb</Swatch>

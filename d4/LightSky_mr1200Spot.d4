      <Attribute ID="Prism_Rot" ChannelOffset="13" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Vector" ChannelOffset="15" Wheel="29" />
      <Attribute ID="PT_Speed" ChannelOffset="16" Wheel="30" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8" Delay="11000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:7" Delay="11000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
  </Macro>
</Fixture>
<Fixture Name="HSX" ShortName="HSX" Company="Cineo">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>81aa0d03-1b02-4829-9aa4-1fb382455c6a</Thumbnail>
  <History Date="17-07-18" Author="Nic Morris" Comment="Created" />
  <History Date="23-07-18" Author="Nic Morris" Comment="Changed from two single channel modes to one mode with a pending dimmer so that it can exist on one handle/user no." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Variable" Display="'Variable %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="34~34" Colour="255,255,255" />
      <Function ID="4" Name="4300K" Display="'4300K'" Dmx="107~107" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="195~195" Colour="255,255,255" />
      <Function ID="6" Name="6000K" Display="'6000K'" Dmx="221~221" Colour="255,255,255" />
      <Function ID="7" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="1+1 patch @CCT addr then dim at dim addr" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="0" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="81aa0d03-1b02-4829-9aa4-1fb382455c6a"></Swatch>
  </swatchLibrary>
</Fixture>
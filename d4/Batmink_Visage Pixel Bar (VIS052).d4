  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="7 Col Dream" Display="'7 Col Dream'" Dmx="17~33" Colour="0,0,0" />
      <Function ID="3" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="34~50" Colour="0,0,0" />
      <Function ID="4" Name="7 Col Jump" Display="'7 Col Jump'" Dmx="51~67" Colour="0,0,0" />
      <Function ID="5" Name="7 Col Flow" Display="'7 Col Flow'" Dmx="68~84" Colour="0,0,0" />
      <Function ID="6" Name="7 Col DFlow" Display="'7 Col DFlow'" Dmx="85~101" Colour="0,0,0" />
      <Function ID="7" Name="Flow+Dream 1" Display="'Flow+Dream 1'" Dmx="102~118" Colour="0,0,0" />
      <Function ID="8" Name="Flow+Dream 2" Display="'Flow+Dream 2'" Dmx="119~135" Colour="0,0,0" />
      <Function ID="9" Name="Section Flow 1" Display="'Section Flow 1'" Dmx="136~152" Colour="0,0,0" />
      <Function ID="10" Name="Section Flow 2" Display="'Section Flow 2'" Dmx="153~169" Colour="0,0,0" />
      <Function ID="11" Name="Section Flow 3" Display="'Section Flow 3'" Dmx="170~186" Colour="0,0,0" />
      <Function ID="12" Name="Seven Col Mix" Display="'Seven Col Mix'" Dmx="187~203" Colour="0,0,0" />
      <Function ID="13" Name="Two Col Flow 1" Display="'Two Col Flow 1'" Dmx="204~220" Colour="0,0,0" />
      <Function ID="14" Name="Two Col Flow 2" Display="'Two Col Flow 2'" Dmx="221~237" Colour="0,0,0" />
      <Function ID="15" Name="Auto-Run" Display="'Auto-Run'" Dmx="238~255" Colour="0,0,0" />
    </Attribute>

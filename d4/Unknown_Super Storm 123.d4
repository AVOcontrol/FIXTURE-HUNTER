        <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
        <Attribute ID="Colour_Macro" ChannelOffset="24" Wheel="9" />
        <Attribute ID="Control" ChannelOffset="25" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Head 1" ChannelOffset="12" ModeLink="PT cell" X="0" Y="0" />
      <Cell ID="Cell2" Name="Head 2" ChannelOffset="14" ModeLink="PT cell" X="0" Y="1" />
      <Cell ID="Cell3" Name="Head 3" ChannelOffset="16" ModeLink="PT cell" X="0" Y="2" />
      <Cell ID="Cell4" Name="Head 4" ChannelOffset="18" ModeLink="PT cell" X="0" Y="3" />

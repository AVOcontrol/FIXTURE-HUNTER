  <AtlaBase TypeID="b419af26-0c50-4244-af97-708e97306ea6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~20" Colour="255,255,255" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="31~200" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="21~120" />
      <Function ID="3" Name="Program" Display="'Program %.f%%',0~100" Dmx="121~220" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',10~209" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',210~255" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Function ID="7" Name="Rainbow 6" Display="'Rainbow 6'" Dmx="168~199" Colour="255,255,255" />
      <Function ID="8" Name="Rainbow 7" Display="'Rainbow 7'" Dmx="200~231" Colour="255,255,255" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="232~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

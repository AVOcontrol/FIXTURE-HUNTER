    <Attribute ID="Effect_2_Func" Name="Effect 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect2, Eff2Param1, Eff2Param2, Eff2Param3, Eff2Param4, Eff2Param5" />
      <Function ID="2" Name="General" Display="'General'" Dmx="0~0" Update="Effect2, Eff2Param1, Eff2Param2, Eff2Param3, Eff2Param4, Eff2Param5" />

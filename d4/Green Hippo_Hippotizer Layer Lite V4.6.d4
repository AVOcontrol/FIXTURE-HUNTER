    <Attribute ID="Effect1Level" Name="Effect 1 Level" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Eff1Param1" Name="Eff 1 Param 1" Description="" Group="G">
      <Locate Locate="67:128" PowerOn="67:128" />

  <History Date="03-09-16" Author="Nic Morris" Comment="Created" />
  <History Date="11-07-18" Author="Nic Morris" Comment="Created from FunGeneration PicoWash 40 Pixel Quad LED" />
  <History Date="12-07-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="38566d90-98f1-4a07-9134-0acf76126cf4" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="60~69" Update="Auto_Spd" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="70~79" Update="Auto_Spd" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="9" Name="White" Display="'White'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="10" Name="Program 1" Display="'Program 1'" Dmx="140~149" Update="Auto_Spd" />
      <Function ID="11" Name="Program 2" Display="'Program 2'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="12" Name="Program 3" Display="'Program 3'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="13" Name="Program 4" Display="'Program 4'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="14" Name="Program 5" Display="'Program 5'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="15" Name="Program 6" Display="'Program 6'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="16" Name="Program 7" Display="'Program 7'" Dmx="200~209" Update="Auto_Spd" />
      <Function ID="17" Name="Program 8" Display="'Program 8'" Dmx="210~219" Update="Auto_Spd" />
      <Function ID="18" Name="Program 9" Display="'Program 9'" Dmx="220~229" Update="Auto_Spd" />
      <Function ID="19" Name="Reset" Display="'Reset'" Dmx="234~236" Update="Auto_Spd" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==20" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

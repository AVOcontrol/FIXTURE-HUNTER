      <Function ID="25" Name="Open" Display="'Open'" Dmx="96~99" WheelPosition="0" />
      <Function ID="26" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky) %.f%%',0~100" Dmx="100~121" WheelPosition="1" />
      <Function ID="27" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals) %.f%%',0~100" Dmx="122~142" WheelPosition="2" />
      <Function ID="28" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out) %.f%%',0~100" Dmx="143~163" WheelPosition="3" />
      <Function ID="29" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons) %.f%%',0~100" Dmx="164~184" WheelPosition="4" />
      <Function ID="30" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl) %.f%%',0~100" Dmx="185~205" WheelPosition="5" />
      <Function ID="31" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars) %.f%%',0~100" Dmx="206~226" WheelPosition="6" />
      <Function ID="32" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks) %.f%%',0~100" Dmx="227~247" WheelPosition="7" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

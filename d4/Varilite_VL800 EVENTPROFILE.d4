    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op - VL Rd" Display="'Op - VL Rd %.f%%',0~100" Dmx="0~48" Colour="255,255,255" />
      <Function ID="3" Name="VL Red" Display="'VL Red'" Dmx="48~48" Colour="255,0,0" />
      <Function ID="4" Name="VL Rd - D Blu" Display="'VL Rd - D Blu %.f%%',0~100" Dmx="48~80" Colour="255,0,0" />
      <Function ID="5" Name="Dark Blue" Display="'Dark Blue'" Dmx="80~80" Colour="0,0,180" />
      <Function ID="6" Name="D Blu - Yel" Display="'D Blu - Yel %.f%%',0~100" Dmx="80~112" Colour="0,0,180" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="112~112" Colour="255,255,0" />
      <Function ID="8" Name="Yel - K Grn" Display="'Yel - K Grn %.f%%',0~100" Dmx="112~144" Colour="255,255,0" />
      <Function ID="9" Name="Kelly Green" Display="'Kelly Green'" Dmx="144~144" Colour="0,255,0" />
      <Function ID="10" Name="K Grn - Amb" Display="'K Grn - Amb %.f%%',0~100" Dmx="144~176" Colour="0,255,0" />
      <Function ID="11" Name="Amber" Display="'Amber'" Dmx="176~176" Colour="255,100,0" />
      <Function ID="12" Name="Amb - C Blu" Display="'Amb - C Blu %.f%%',0~100" Dmx="176~208" Colour="255,100,0" />
      <Function ID="13" Name="Congo Blue" Display="'Congo Blue'" Dmx="208~208" Colour="180,0,255" />
      <Function ID="14" Name="C Blu - Op" Display="'C Blu - Op %.f%%',0~100" Dmx="208~224" Colour="180,0,255" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Ctrl" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear Short" Display="'Linear Short'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Linear Normal" Display="'Linear Normal'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="15~11" Colour="0,0,0" />
      <Function ID="4" Name="No Scroll" Display="'No Scroll'" Dmx="16~20" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="21~25" Colour="0,0,0" />
      <Function ID="6" Name="Shake Short" Display="'Shake Short %.f%%',0~100" Dmx="26~56" Colour="255,255,255" />
      <Function ID="7" Name="Shake Normal" Display="'Shake Normal %.f%%',0~100" Dmx="57~87" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Fixed Spin" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Mega Step" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==3" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="6~10" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="11~15" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="16~20" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="21~25" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="26~30" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="31~35" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks)'" Dmx="36~40" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="41~45" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="46~50" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="51~55" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="56~60" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="61~65" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="66~70" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="71~75" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks)'" Dmx="76~80" WheelPosition="7" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="81~85" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="86~90" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="91~95" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="96~100" WheelPosition="3" />
      <Function ID="21" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="101~105" WheelPosition="4" />
      <Function ID="22" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="106~110" WheelPosition="5" />
      <Function ID="23" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="111~115" WheelPosition="6" />
      <Function ID="24" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks)'" Dmx="116~120" WheelPosition="7" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==3" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>

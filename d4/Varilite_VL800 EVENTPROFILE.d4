      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Gobo_Speed" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func1'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func1'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func1'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="VL Red" Display="'VL Red'" Dmx="9~9" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Dark Blue" Display="'Dark Blue'" Dmx="15~15" WheelPosition="2" Colour="0,0,180" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="21~21" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Kelly Green" Display="'Kelly Green'" Dmx="27~27" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="33~33" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Congo Blue" Display="'Congo Blue'" Dmx="39~39" WheelPosition="6" Colour="180,0,255" />
      <Function ID="8" Name="Op - VL Rd" Display="'Op - VL Rd %.f%%',0~100" Dmx="45~58" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="VL Rd - D Blu" Display="'VL Rd - D Blu %.f%%',0~100" Dmx="58~79" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="D Blu - Yel" Display="'D Blu - Yel %.f%%',0~100" Dmx="79~100" WheelPosition="2" Colour="0,0,180" />
      <Function ID="11" Name="Yel - K Grn" Display="'Yel - K Grn %.f%%',0~100" Dmx="100~121" WheelPosition="3" Colour="255,255,0" />
      <Function ID="12" Name="K Grn - Amb" Display="'K Grn - Amb %.f%%',0~100" Dmx="121~142" WheelPosition="4" Colour="0,255,0" />
      <Function ID="13" Name="Amb - C Blu" Display="'Amb - C Blu %.f%%',0~100" Dmx="142~163" WheelPosition="5" Colour="255,100,0" />
      <Function ID="14" Name="C Blu - Op" Display="'C Blu - Op %.f%%',0~100" Dmx="163~177" WheelPosition="6" Colour="180,0,255" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="253~253" WheelPosition="0" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="211~180" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="212~217" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="218~249" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func1" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" />
      <Function ID="4" Name="Twist" Display="'Twist'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo11, Gobo1Rot1" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func1'==1" />
      <Condition Name="Fixed Spin" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func1'==2" />
      <Condition Name="Mega Step" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func1'==3" />
      <Condition Name="Twist" ID="25,26,27,28,29,30,31,32" If="'Gobo1Func1'==4" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="4~7" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="8~11" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="12~15" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="16~19" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="20~23" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="24~27" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks)'" Dmx="28~31" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="32~35" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="36~39" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="40~43" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="44~47" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="48~51" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="52~55" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="56~59" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 (On the Rocks)" Display="'Gobo 7 (On the Rocks)'" Dmx="60~63" WheelPosition="7" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="64~67" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 (Night Sky)" Display="'Gobo 1 (Night Sky)'" Dmx="68~71" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 (Circle of Ovals)" Display="'Gobo 2 (Circle of Ovals)'" Dmx="72~75" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 (Bricked Out)" Display="'Gobo 3 (Bricked Out)'" Dmx="76~79" WheelPosition="3" />
      <Function ID="21" Name="Gobo 4 (Neurons)" Display="'Gobo 4 (Neurons)'" Dmx="80~83" WheelPosition="4" />
      <Function ID="22" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="84~87" WheelPosition="5" />
      <Function ID="23" Name="Gobo 6 (Crossed-Bars)" Display="'Gobo 6 (Crossed-Bars)'" Dmx="88~91" WheelPosition="6" />

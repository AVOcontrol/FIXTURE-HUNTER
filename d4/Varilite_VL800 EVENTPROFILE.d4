      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func1'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo2Func1'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo2Func1'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1 (Leafy Breakup)" Display="'Gobo 1 (Leafy Breakup)'" Dmx="1~1" WheelPosition="1" />

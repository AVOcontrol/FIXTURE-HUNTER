      <Function ID="11" Name="R+B" Display="'R+B'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="R+G+UV" Display="'R+G+UV'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="R+B+UV" Display="'R+B+UV'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="G+B+UV" Display="'G+B+UV'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="All On" Display="'All On'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="160~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Derby_Colour" Name="Derby Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />

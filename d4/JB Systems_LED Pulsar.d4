<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Pulsar" ShortName="LED Pulsar" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="08-03-14" Author="Nic Morris" Comment="Created" />
  <History Date="22-04-16" Author="Gregory Haynes" Comment="Added short name" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0873d485-00fa-43fd-9954-6f4696afdfb4" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~131" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="232~239" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~24" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="25~41" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="42~57" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="58~74" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="75~91" Colour="255,255,0" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="92~107" Colour="255,0,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="108~124" Colour="255,100,100" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="125~141" Colour="0,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="142~157" Colour="100,255,100" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="158~174" Colour="100,100,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="175~191" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="192~207" Colour="255,255,100" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="208~224" Colour="255,100,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="225~240" Colour="100,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="JBLPULS1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2499bf1a-72c3-451d-8f62-4bc0575bca5f" />
    <Include>
      <Attribute ID="Chase" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="JBLPULS6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="516a28e4-3a7f-4931-9807-511ca08ea8e7" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Chase" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
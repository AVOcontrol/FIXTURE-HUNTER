      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="224~181" GoboSpin="0~0" GoboOrientation="0~0" />

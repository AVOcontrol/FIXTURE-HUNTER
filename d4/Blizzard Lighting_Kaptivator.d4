      <Function ID="2" Name="Anim" Display="'Anim %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">

      <Function ID="2" Name="Left" Display="'Left %.f%%',0~100" Dmx="128~160" />
      <Function ID="3" Name="Right" Display="'Right %.f%%',0~100" Dmx="161~192" />
      <Function ID="4" Name="Left/ Right" Display="'Left/ Right %.f%%',0~100" Dmx="193~224" />
      <Function ID="5" Name="Jumping" Display="'Jumping %.f%%',0~100" Dmx="225~239" />
      <Function ID="6" Name="Prism" Display="'Prism %.f%%',0~100" Dmx="240~247" />

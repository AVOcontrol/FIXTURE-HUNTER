  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~63" />
      <Function ID="2" Name="Sound Beam" Display="'Sound Beam'" Dmx="64~95" />
      <Function ID="3" Name="Sound Single" Display="'Sound Single'" Dmx="96~127" />
      <Function ID="4" Name="Auto Beam" Display="'Auto Beam'" Dmx="128~159" />
      <Function ID="5" Name="Auto Single" Display="'Auto Single'" Dmx="160~191" />

      <Function ID="4" Name="Red, Amber" Display="'Red, Amber'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="Red, 75% Green, Amber" Display="'Red, 75% Green, Amber'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="Red, Green" Display="'Red, Green'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="Green, White" Display="'Green, White'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="Green, UV" Display="'Green, UV'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="Green, Blue" Display="'Green, Blue'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="Blue, UV" Display="'Blue, UV'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="Blue" Display="'Blue'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="UV" Display="'UV'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="UV, 50% Red" Display="'UV, 50% Red'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="UV, Amber" Display="'UV, Amber'" Dmx="151~160" Colour="255,255,255" />
      <Function ID="17" Name="UV, Amber, Red" Display="'UV, Amber, Red'" Dmx="161~170" Colour="255,255,255" />
      <Function ID="18" Name="UV, Red" Display="'UV, Red'" Dmx="171~180" Colour="255,255,255" />
      <Function ID="19" Name="Red, White, Amber" Display="'Red, White, Amber'" Dmx="181~190" Colour="255,255,255" />
      <Function ID="20" Name="White, Amber" Display="'White, Amber'" Dmx="191~200" Colour="255,255,255" />
      <Function ID="21" Name="White" Display="'White'" Dmx="201~210" Colour="255,255,255" />
      <Function ID="22" Name="White, Blue" Display="'White, Blue'" Dmx="211~220" Colour="255,255,255" />
      <Function ID="23" Name="R, G, B, W, A, UV" Display="'R, G, B, W, A, UV'" Dmx="221~230" Colour="255,255,255" />
      <Function ID="24" Name="Sequence" Display="'Sequence %.f%%',0~100" Dmx="231~240" Colour="255,255,255" />
      <Function ID="25" Name="Transition" Display="'Transition %.f%%',0~100" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~20" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="21~30" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="31~40" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="41~50" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="51~60" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="61~70" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="71~80" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="81~90" />
      <Function ID="10" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="91~230" />
      <Function ID="11" Name="Reset" Display="'Reset'" Dmx="231~240" />
    </Attribute>
  </Control>

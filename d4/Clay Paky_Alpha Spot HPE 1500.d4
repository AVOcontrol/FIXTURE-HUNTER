<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot HPE 1500" ShortName="ASpHPE1500" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ba0a4689-99cf-477a-be70-349c29db4c50</Thumbnail>
  <History Date="17-09-09" Author="David Hunt" Comment="Created" />
  <History Date="19-11-09" Author="John Rogers" Comment="Extensive update in line with Clay Paky documentation." />
  <History Date="01-04-10" Author="John Rogers" Comment="Added static gobo wheel attribute to both modes." />
  <History Date="06-08-10" Author="John Rogers" Comment="Edited Colour Macros." />
  <History Date="24-03-11" Author="Gregory Haynes" Comment="Edited Focus and Gobo 2 against fixture." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="28-06-15" Author="Nic Morris" Comment="Increased wheel resolution in attempt to fix customer bug report.  Standardised conditionals." />
  <History Date="28-06-15" Author="Nic Morris" Comment="Removed invalid conditions from Gobo 2 Rot.  Inverted speed wheel directions." />
  <History Date="20-04-16" Author="Nic Morris" Comment="Changed Animation Gobo to locate at zero in attempt to fix customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-06-17" Author="Nic Morris" Comment="Changed Atlabase ID's to CMY versions.  Revised mode names to reflect settings more clearly." />
  <History Date="09-06-17" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Changed fixed colour CTO to pink.  Standardised shutter." />
  <History Date="09-06-17" Author="Nic Morris" Comment="Revised colour index ranges to all full field control.  Added colour function index." />
  <History Date="09-06-17" Author="Nic Morris" Comment="Changed gobo 2 to 8bit.  Inverted zoom.  Revised macro effects with discreet functions." />
  <History Date="09-06-17" Author="Nic Morris" Comment="Revised function functions.  Revised speed controls.  Recreated palettes." />
  <History Date="09-06-17" Author="Nic Morris" Comment="Fixed gobo wheel 1 gobo 7 and 8 ranges." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Fixed colour macro random range." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added RDM ID's.  Added product thumbnail." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="96" />
  </RDM>
  <AtlaBase TypeID="00181cb0-45e8-4932-834c-2c17b1eeb092" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="39~39" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="58~58" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Aquamarine" Display="'Aquamarine'" Dmx="77~77" WheelPosition="4" Colour="0,255,128" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="97~97" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="117~117" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~20" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Rd - Pk" Display="'Rd - Pk %.f%%',0~100" Dmx="20~39" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="Pk - Grn" Display="'Pk - Grn %.f%%',0~100" Dmx="39~58" WheelPosition="2" Colour="255,150,150" />
      <Function ID="11" Name="Grn - Aq" Display="'Grn - Aq %.f%%',0~100" Dmx="58~77" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="Aq - Org" Display="'Aq - Org %.f%%',0~100" Dmx="77~97" WheelPosition="4" Colour="0,255,128" />
      <Function ID="13" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="97~117" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Blu - Op" Display="'Blu - Op'" Dmx="117~127" WheelPosition="6" Colour="0,0,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:39" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:32" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset no P/T">
      <Set Channel="Control:31" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:35" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Control:36" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:33" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo/Effect">
      <Set Channel="Control:34" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Beam">
      <Set Channel="Control:37" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Iris/Frames">
      <Set Channel="Control:38" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Standby Mode On">
      <Set Channel="Control:2,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Standby Mode Off">
      <Set Channel="Control:3,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Pressure Test On">
      <Set Channel="Control:4,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Pressure Test Off">
      <Set Channel="Control:5,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Wired DMX">
      <Set Channel="Control:6,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Wireless DMX">
      <Set Channel="Control:7,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:8,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:9,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Quiet Mode: Fans On w/BO">
      <Set Channel="Control:10,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Quiet Mode: Fans Off w/BO">
      <Set Channel="Control:11,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Dim Super Square">
      <Set Channel="Control:12,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="P/T Speed Mode">
      <Set Channel="Control:13,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />

      <Attribute ID="Tilt_Spin" ChannelOffset="6" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="9,10" Wheel="1" />
      <Attribute ID="Dim_Mode" ChannelOffset="11" Wheel="26" />
      <Attribute ID="Focus" ChannelOffset="12,13" Wheel="21" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="14,15" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="16,17" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="18,19" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="20,21" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="22" Wheel="9" />
      <Attribute ID="Colour_Speed" ChannelOffset="23" Wheel="27" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="24" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="25,26" Wheel="15" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="27,28" Wheel="17" />
      <Attribute ID="Prism_1/2" ChannelOffset="29" Wheel="23" />
      <Attribute ID="Prism_1/2_Rot" ChannelOffset="30,31" Wheel="24" />
      <Attribute ID="Prism_3/4" ChannelOffset="32" Wheel="53" />

      <Function ID="6" Name="Rand Fast" Display="'Rand Fast'" Dmx="239~251" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Shutter" Name="BG Shutter" Description="" Group="I">

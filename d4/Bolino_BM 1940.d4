      <Function ID="47" Name="Bumping 3" Display="'Bumping 3'" Dmx="59~59" Update="Shape_Speed, Shape_Offset" />
      <Function ID="48" Name="Vert Pix Scr" Display="'Vert Pix Scr'" Dmx="60~60" Update="Shape_Speed, Shape_Offset" />
      <Function ID="49" Name="Rand Vert Sect" Display="'Rand Vert Sect'" Dmx="61~61" Update="Shape_Speed, Shape_Offset" />
      <Function ID="50" Name="Rand Cent Sect" Display="'Rand Cent Sect'" Dmx="62~62" Update="Shape_Speed, Shape_Offset" />
      <Function ID="51" Name="Rand Ring 2" Display="'Rand Ring 2'" Dmx="63~63" Update="Shape_Speed, Shape_Offset" />
      <Function ID="52" Name="Rand Ring 1+3" Display="'Rand Ring 1+3'" Dmx="65~65" Update="Shape_Speed, Shape_Offset" />
      <Function ID="53" Name="Rand Ring 2+3" Display="'Rand Ring 2+3'" Dmx="66~66" Update="Shape_Speed, Shape_Offset" />
      <Function ID="54" Name="Sgl Pix R1" Display="'Sgl Pix R1'" Dmx="67~67" Update="Shape_Speed, Shape_Offset" />
      <Function ID="55" Name="Sgl Pix R2" Display="'Sgl Pix R2'" Dmx="68~68" Update="Shape_Speed, Shape_Offset" />
      <Function ID="56" Name="Spiral" Display="'Spiral'" Dmx="70~70" Update="Shape_Speed, Shape_Offset" />
      <Function ID="57" Name="Reserved" Display="'Reserved'" Dmx="71~255" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==11||'Shape'==12" />
      <Condition Name="Rainbow" ID="10,11,12,13" If="'Shape'==13||'Shape'==14" />
      <Condition Name="Speed" ID="14,15,16,17" If="'Shape'&gt;14&amp;&amp;'Shape'&lt;57" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="8" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="11" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="12" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="13" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
      <Function ID="14" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="15" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="17" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
    </Attribute>
    <Attribute ID="Shape_Fade" Name="Shape Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Snap" Display="'Snap'" Dmx="0~0" />
      <Function ID="2" Name="Gamma" Display="'Gamma %.1f%%',0.0~100.0" Dmx="16~245" />
      <Function ID="3" Name="Auto Smooth" Display="'Auto Smooth'" Dmx="246~255" />

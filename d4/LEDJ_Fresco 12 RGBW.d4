  <AtlaBase TypeID="4c3b4c16-7685-4bb7-8127-99c50675ae8a" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Update="Shutter1" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="10~19" Update="Shutter1" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="20~29" Update="Shutter1" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="30~39" Update="Shutter1" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="40~49" Update="Shutter1" Colour="255,255,255" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="50~59" Update="Shutter1" Colour="255,255,255" />
      <Function ID="7" Name="BW" Display="'BW'" Dmx="60~69" Update="Shutter1" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="70~79" Update="Shutter1" Colour="255,255,255" />
      <Function ID="9" Name="GW" Display="'GW'" Dmx="80~89" Update="Shutter1" Colour="255,255,255" />
      <Function ID="10" Name="RB" Display="'RB'" Dmx="90~99" Update="Shutter1" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="100~109" Update="Shutter1" Colour="255,255,255" />
      <Function ID="12" Name="GBW" Display="'GBW'" Dmx="110~119" Update="Shutter1" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="120~129" Update="Shutter1" Colour="255,255,255" />
      <Function ID="14" Name="RBW" Display="'RBW'" Dmx="130~139" Update="Shutter1" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="140~149" Update="Shutter1" Colour="255,255,255" />
      <Function ID="16" Name="CFade" Display="'CFade'" Dmx="150~159" Update="Shutter1" Colour="255,255,255" />
      <Function ID="17" Name="Meteor" Display="'Meteor'" Dmx="160~169" Update="Shutter1" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade'" Dmx="170~179" Update="Shutter1" Colour="255,255,255" />
      <Function ID="19" Name="Change" Display="'Change'" Dmx="180~189" Update="Shutter1" Colour="255,255,255" />
      <Function ID="20" Name="Flow 1" Display="'Flow 1'" Dmx="190~199" Update="Shutter1" Colour="255,255,255" />
      <Function ID="21" Name="Flow 2" Display="'Flow 2'" Dmx="200~209" Update="Shutter1" Colour="255,255,255" />
      <Function ID="22" Name="Flow 3" Display="'Flow 3'" Dmx="210~219" Update="Shutter1" Colour="255,255,255" />
      <Function ID="23" Name="Flow 4" Display="'Flow 4'" Dmx="220~229" Update="Shutter1" Colour="255,255,255" />
      <Function ID="24" Name="Flow 5" Display="'Flow 5'" Dmx="230~239" Update="Shutter1" Colour="255,255,255" />
      <Function ID="25" Name="Flow 6" Display="'Flow 6'" Dmx="240~255" Update="Shutter1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;15" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

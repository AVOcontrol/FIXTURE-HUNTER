      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="71~73" Colour="0,0,0" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="74~76" Colour="0,0,0" />
      <Function ID="24" Name="Colour 23" Display="'Colour 23'" Dmx="77~79" Colour="0,0,0" />
      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="80~82" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="83~85" Colour="0,0,0" />
      <Function ID="27" Name="Colour 26" Display="'Colour 26'" Dmx="86~88" Colour="0,0,0" />
      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="89~91" Colour="0,0,0" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="92~94" Colour="0,0,0" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="95~97" Colour="0,0,0" />
      <Function ID="31" Name="Colour 30" Display="'Colour 30'" Dmx="98~100" Colour="0,0,0" />
      <Function ID="32" Name="Colour 31" Display="'Colour 31'" Dmx="101~105" Colour="0,0,0" />
      <Function ID="33" Name="Colour 32" Display="'Colour 32'" Dmx="106~110" Colour="0,0,0" />
      <Function ID="34" Name="Colour 33" Display="'Colour 33'" Dmx="111~115" Colour="0,0,0" />
      <Function ID="35" Name="Colour 34" Display="'Colour 34'" Dmx="116~120" Colour="0,0,0" />
      <Function ID="36" Name="Colour 35" Display="'Colour 35'" Dmx="121~125" Colour="0,0,0" />
      <Function ID="37" Name="Jump Stop" Display="'Jump Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="38" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="39" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~31" Colour="255,255,255" />
      <Function ID="3" Name="3500K" Display="'3500K'" Dmx="32~93" Colour="255,255,255" />
      <Function ID="4" Name="4000K" Display="'4000K'" Dmx="94~95" Colour="255,255,255" />
      <Function ID="5" Name="5000K" Display="'5000K'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="6" Name="6000K" Display="'6000K'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="7" Name="7000K" Display="'7000K'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="8" Name="7500K" Display="'7500K'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="9" Name="8000K" Display="'8000K'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="47~49" Colour="0,0,0" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="50~52" Colour="0,0,0" />
      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="53~55" Colour="0,0,0" />
      <Function ID="17" Name="Colour 16" Display="'Colour 16'" Dmx="56~58" Colour="0,0,0" />
      <Function ID="18" Name="Colour 17" Display="'Colour 17'" Dmx="59~61" Colour="0,0,0" />

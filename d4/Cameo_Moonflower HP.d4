  <Thumbnail>ded2fb9a-e3af-4f79-a251-1b96fd56e708</Thumbnail>
  <History Date="15-08-15" Author="Nic Morris" Comment="Created" />
  <History Date="14-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added Atlabase ID's." />
  <History Date="14-11-18" Author="Nic Morris" Comment="Changed shutter open to default at zero in attempt to fix customer bug report (manufacturer's charts define as 0-1)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="349a87c1-5519-4aef-8fb8-36594c115450" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="Red/ Grn" Display="'Red/ Grn'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="Red/ Blu" Display="'Red/ Blu'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="Red/ White" Display="'Red/ White'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="Grn/ White" Display="'Grn/ White'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="Blu/ White" Display="'Blu/ White'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="R/ G/ B" Display="'R/ G/ B'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="R/ G/ W" Display="'R/ G/ W'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="R/ B/ W" Display="'R/ B/ W'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="G/ B/ W" Display="'G/ B/ W'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="R/ G/ B/ W" Display="'R/ G/ B/ W'" Dmx="224~239" Colour="255,255,255" />
      <Function ID="16" Name="Auto" Display="'Auto'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="120~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed1" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMMFH2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="14eb25bc-1c6a-42d4-b3ef-6dfe69561ccf" />
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKCMMFH5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fc6932cc-a74c-4fb9-bcc9-70c174c48369" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Speed1" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="ded2fb9a-e3af-4f79-a251-1b96fd56e708"></Swatch>

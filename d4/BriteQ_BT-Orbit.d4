  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6db0e2fc-122a-403b-8edb-8becffc25a41" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~14" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="40~44" />
      <Function ID="4" Name="P/T Fast" Display="'P/T Fast'" Dmx="45~49" />
      <Function ID="5" Name="P/T Slow" Display="'P/T Slow'" Dmx="50~54" />
      <Function ID="6" Name="Dim Fast" Display="'Dim Fast'" Dmx="80~84" />
      <Function ID="7" Name="Dim Smooth" Display="'Dim Smooth'" Dmx="90~94" />
      <Function ID="8" Name="Display On" Display="'Display On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~24" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cls Pls" Display="'Rnd Cls Pls %.f%%',0~100" Dmx="164~150" Intensity="0~0" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" Intensity="0~0" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Sine Wave" Display="'Sine Wave %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">

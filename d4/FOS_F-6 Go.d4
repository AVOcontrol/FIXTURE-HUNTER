  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="12ca27e3-7d84-4495-bbcc-047bde82b909" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Strobe 3" Display="'Strobe 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Strobe 4" Display="'Strobe 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Strobe 5" Display="'Strobe 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Strobe 6" Display="'Strobe 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="2~45" />
      <Function ID="3" Name="Col Change" Display="'Col Change'" Dmx="46~115" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="116~185" />
      <Function ID="5" Name="Col Pulse" Display="'Col Pulse'" Dmx="186~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="185" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="24e6c886-c640-4584-a75b-7a48de488b22" />
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="City Painter 18000" ShortName="CPnt 18000" Company="Showtec" Version="16">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>658cfc0a-e509-46ed-8279-7d3797d28560</Thumbnail>
  <History Date="29-03-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Added Macro dependant conditionals.  Changed shutter locate and power on to open." Version="2" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed ID power on and locate to All IDs." Version="3" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed dimmer speed non-linear to explicit values." Version="4" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed HSV attribute groups and wheel mapping.  Added v-dim to PIXEL mode." Version="5" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado 3P Tour." Version="6" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado Ridge IP" Version="7" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed Value and replaced with Dimmer for HTP" Version="8" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." Version="9" />
  <History Date="30-05-12" Author="Peter Budd" Comment="Created from Colorado Range IP" Version="10" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="11" />
  <History Date="12-01-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed fixed colour macros to variable range." Version="12" />
  <History Date="12-01-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel counts to mode names." Version="13" />
  <History Date="12-01-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" Version="14" />
  <History Date="12-01-18" Author="Nic Morris" Comment="Changed name from City Painter 18000 to City Painter 18000 LED.  Added missing ID channel to TOUR mode." Version="15" />
  <History Date="27-03-20" Author="Nic Morris" Comment="Fixed missing cells dimmer links in TOUR mode." Version="16" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b2ef3941-0dbb-40ab-a036-7d881770dde9" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />

    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Emergency" Display="'Emergency'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="2" Name="Fire" Display="'Fire'" Dmx="16~31" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="3" Name="Fireworks" Display="'Fireworks'" Dmx="32~47" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="4" Name="Hue Burst" Display="'Hue Burst'" Dmx="48~63" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="5" Name="Lightning" Display="'Lightning'" Dmx="64~79" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="6" Name="Paparazzi" Display="'Paparazzi'" Dmx="80~95" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="7" Name="Party Lites" Display="'Party Lites'" Dmx="96~111" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="8" Name="Pulsing" Display="'Pulsing'" Dmx="112~127" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="9" Name="Squares" Display="'Squares'" Dmx="128~143" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="10" Name="Strobe" Display="'Strobe'" Dmx="144~159" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="11" Name="TV/ Monitor" Display="'TV/ Monitor'" Dmx="160~171" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pulses" ID="1,2,3,4,5" If="'Effect'==1" />
      <Condition Name="Hue" ID="6" If="'Effect'==2||'Effect'==4||'Effect'==8||'Effect'==9||'Effect'==10" />
      <Condition Name="Frequency" ID="7" If="'Effect'==3" />
      <Condition Name="Rate" ID="8" If="'Effect'==5||'Effect'==7||'Effect'==11" />
      <Else ID="9" />
      <Function ID="1" Name="1 Pulse" Display="'1 Pulse'" Dmx="0~0" />
      <Function ID="2" Name="2 Pulses" Display="'2 Pulses'" Dmx="13107~25957" />
      <Function ID="3" Name="3 Pulses" Display="'3 Pulses'" Dmx="26214~39321" />
      <Function ID="4" Name="4 Pulses" Display="'4 Pulses'" Dmx="39578~52171" />
      <Function ID="5" Name="5 Pulses" Display="'5 Pulses'" Dmx="52428~65535" />
      <Function ID="6" Name="Hue" Display="'%.2f°',0.00~359.00" Dmx="0~65535" />
      <Function ID="7" Name="Frequency" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="8" Name="Rate" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Emergency Cols" ID="1,2,3,4,5,6,7" If="'Effect'==1" />
      <Condition Name="Saturation" ID="8" If="'Effect'==2||'Effect'==4||'Effect'==8||'Effect'==9||'Effect'==10" />
      <Condition Name="Fireworks Cols" ID="9,10,11,12,13" If="'Effect'==3" />
      <Condition Name="CCT" ID="14" If="'Effect'==5||'Effect'==6" />
      <Condition Name="Type" ID="15,16,17" If="'Effect'==7" />
      <Condition Name="Motion" ID="18" If="'Effect'==11" />
      <Else ID="19" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" Update="Effect_Param_3" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="9509~18761" Update="Effect_Param_3" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="19018~28013" Update="Effect_Param_3" />
      <Function ID="4" Name="Blue+Red" Display="'Blue+Red'" Dmx="28270~37265" Update="Effect_Param_3" />
      <Function ID="5" Name="Blue+Amber" Display="'Blue+Amber'" Dmx="37522~46517" Update="Effect_Param_3" />
      <Function ID="6" Name="Blue+White" Display="'Blue+White'" Dmx="46774~55769" Update="Effect_Param_3" />
      <Function ID="7" Name="Blue+Red+WH" Display="'Blue+Red+WH'" Dmx="56026~65535" Update="Effect_Param_3" />
      <Function ID="8" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Update="Effect_Param_3" />
      <Function ID="9" Name="RWB" Display="'RWB'" Dmx="0~0" Update="Effect_Param_3" />
      <Function ID="10" Name="RGB" Display="'RGB'" Dmx="13107~25957" Update="Effect_Param_3" />
      <Function ID="11" Name="6 CLR" Display="'6 CLR'" Dmx="26214~39321" Update="Effect_Param_3" />
      <Function ID="12" Name="12 CLR" Display="'12 CLR'" Dmx="39578~52171" Update="Effect_Param_3" />
      <Function ID="13" Name="Random" Display="'Random'" Dmx="52428~65535" Update="Effect_Param_3" />
      <Function ID="14" Name="CCT C-Mix" Display="'%.2fK',2700.00~6000.00" Dmx="0~65535" Update="Effect_Param_3" />
      <Function ID="15" Name="Pulsing" Display="'Pulsing'" Dmx="0~0" Update="Effect_Param_3" />
      <Function ID="16" Name="Chase" Display="'Chase'" Dmx="22102~43690" Update="Effect_Param_3" />
      <Function ID="17" Name="Blend" Display="'Blend'" Dmx="43947~65535" Update="Effect_Param_3" />
      <Function ID="18" Name="Motion" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Update="Effect_Param_3" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Update="Effect_Param_3" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E" Size="2">
      <Locate Locate="21:0" PowerOn="21:0" />
      <Condition Name="Rate" ID="1" If="'Effect'==2" />
      <Condition Name="Sustain" ID="2,3,4" If="'Effect'==3" />
      <Condition Name="Gap" ID="5" If="'Effect'==4" />
      <Condition Name="Flash Type" ID="6,7,8,9" If="'Effect'==6" />
      <Condition Name="Colours" ID="10,11,12,13,14" If="'Effect_Param_2'==15||'Effect_Param_2'==16" />
      <Condition Name="Ramp Time" ID="15" If="'Effect'==8" />
      <Condition Name="On Time" ID="16" If="'Effect'==9" />
      <Condition Name="Frequency" ID="17" If="'Effect'==10" />
      <Condition Name="Range" ID="18,19,20" If="'Effect'==11" />
      <Else ID="21" />
      <Function ID="1" Name="Rate" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Short Decay" Display="'Short Decay'" Dmx="0~0" />
      <Function ID="3" Name="Med Decay" Display="'Med Decay'" Dmx="22102~43690" />
      <Function ID="4" Name="Long Decay" Display="'Long Decay'" Dmx="43947~65535" />
      <Function ID="5" Name="Gap" Display="'%.2fms',40.00~400.00" Dmx="0~65535" />
      <Function ID="6" Name="50ms" Display="'50ms'" Dmx="0~0" />
      <Function ID="7" Name="100ms" Display="'100ms'" Dmx="16448~32125" />
      <Function ID="8" Name="150ms" Display="'150ms'" Dmx="32896~48573" />
      <Function ID="9" Name="Bulb" Display="'Bulb'" Dmx="49087~65535" />
      <Function ID="10" Name="Red, WH, Blue" Display="'Red, WH, Blue'" Dmx="0~0" />
      <Function ID="11" Name="Red, Green, Blue" Display="'Red, Green, Blue'" Dmx="13107~25957" />
      <Function ID="12" Name="6 Colour" Display="'6 Colour'" Dmx="26214~39321" />
      <Function ID="13" Name="12 Colour" Display="'12 Colour'" Dmx="39578~52171" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="52428~65535" />
      <Function ID="15" Name="Ramp Spd" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
      <Function ID="16" Name="On Spd" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
      <Function ID="17" Name="Frequency" Display="'%.2f RPM',30.00~1000.00" Dmx="0~65535" />
      <Function ID="18" Name="Small Range" Display="'Small Range'" Dmx="0~0" />
      <Function ID="19" Name="Medium Range" Display="'Medium Range'" Dmx="22102~43690" />
      <Function ID="20" Name="Large Range" Display="'Large Range'" Dmx="43947~65535" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E" Size="2">
      <Locate Locate="9:0" PowerOn="9:0" />
      <Condition Name="Depth" ID="1" If="'Effect'==2" />
      <Condition Name="Rest" ID="2" If="'Effect'==4" />
      <Condition Name="On Time" ID="3" If="'Effect'==8" />
      <Condition Name="Off Time" ID="4" If="'Effect'==9" />

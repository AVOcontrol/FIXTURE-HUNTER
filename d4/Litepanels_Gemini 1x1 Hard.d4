<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Gemini 1x1 Hard" ShortName="Gem1x1Hard" Company="Litepanels" Version="39">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>591899a5-49af-435f-8cd9-65a6595fef7b</Thumbnail>
  <History Date="02-06-18" Author="Nic Morris" Comment="Created (very confusing documentation.  messy DMX implementation.  8bit ranges are not equivalent to 16bit and implementation has mode set by channel - this is a very bad idea)" Version="1" />
  <History Date="05-06-18" Author="Nic Morris" Comment="Split into daylight and tungsten versions for Capture.  Added Atlabase ID's." Version="2" />
  <History Date="06-02-19" Author="Nic Morris" Comment="Update to FW Rev B2 in line with v2.10 chart (revises Gel mode CCT, fan functions and adds gels 46-54)" Version="3" />
  <History Date="07-02-19" Author="Nic Morris" Comment="Swapped gel ID wheel slots to be more human (10s then 1s).  Added numeric gel option." Version="4" />
  <History Date="11-03-20" Author="Nic Morris" Comment="Updated in line with v3.3 charts (firmware rev C2 and later, 20/2/20.  note gel v2 details are missing)" Version="5" />
  <History Date="11-03-20" Author="Nic Morris" Comment="Added RDM ID's" Version="6" />
  <History Date="13-03-20" Author="Nic Morris" Comment="Changed name from Gemini (Daylight) to Gemini 1x1 Soft RGBWW LED Panel in line with Atlabase as they have unhelpfully removed the original fixtures and broken all the links." Version="7" />
  <History Date="13-03-20" Author="Nic Morris" Comment="Revised original Atlabase IDs and added IDs to new modes." Version="8" />
  <History Date="13-03-20" Author="Nic Morris" Comment="Renamed all of the xMode controls to Mode in response to manufacturer request." Version="9" />
  <History Date="15-07-20" Author="Brad" Comment="Edited" Version="10" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Checked.  Revises Hue and CCT display range in line with latest charts.  Adds discreet functions to Gel Select in v2 modes.  Adds missing if statement to effect param 2 rate condition." Version="11" />
  <History Date="16-12-20" Author="Nic Morris" Comment="(cont.) Corrects typo in Pulsing effect.  Revises effect param 4 reset, on and off time display ranges.  Revises Crossfade function name.  Revises gel category function 2 name.  Changed white wheel allocation." Version="11" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Further revision to gel category 2 function name.  Roll back change to white wheel allocation for compatibility.  Remove unused Get Select attribute (previously assigned to gel v2 modes)." Version="11" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Increased hue resolution to 2dp.  Corrected hue, frequency and rate condition if statements in effect param 1.  Revised effect param 4 rest and off time display ranges in line with latest charts." Version="11" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Revised effect param 5 rest display range in line with latest charts." Version="11" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Revised Gel v2 (8bit) channel mapping inline with latest charts." Version="12" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Changed effect param conditions so that if party lites is selected colours only appears on param 3 if Pulsing or Chase is selected on param 2 in response to manufacturer feedback." Version="12" />
  <History Date="16-12-20" Author="Nic Morris" Comment="Revised product image.  Changed CCT display resolution to 0dp in response to manufacturer feedback." Version="12" />
  <History Date="10-01-21" Author="Nic Morris" Comment="Revised in line with FW Rev B2, Jan 5th 2021 charts in response to manufacturer request (adds fan control to CCT+HSI and CCT+RGBW modes)" Version="13" />
  <History Date="18-01-21" Author="Nic Morris" Comment="Updated gel v2 in line with latest documentation in response to manufacturer request (merge from Arri Lighting SkyPanel S30-C (v4.x). Previous information was incorrect)." Version="14" />
  <History Date="22-07-23" Author="Nic Morris" Comment="Created from Litepanels Gemini 1x1 Soft RGBWW LED Panel (note effects in supreme mode don't make sense.  assumed first colour parameter is effect select with colour parameter 2-6 being the effect parameters 1-5)" Version="18" />
  <History Date="25-07-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="39" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="426" ModelID="514" />
  </RDM>

      <Function ID="2" Name="Daylight" Display="'Daylight'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Manufacturer" Name="Manufacturer" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R Type Gels" Display="'R Type Gels'" Dmx="0~0" Update="Category" Colour="255,255,255" />
      <Function ID="2" Name="L Type Gels" Display="'L Type Gels'" Dmx="255~255" Update="Category" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Category" Name="Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="LEE" ID="6,7,8,9,10" If="'Manufacturer'==2" />

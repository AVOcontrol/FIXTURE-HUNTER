      <Function ID="3" Name="On Time" Display="'%.2fms',25.00~1000.00" Dmx="0~65535" />
      <Function ID="4" Name="Off Time" Display="'%.2fms',25.00~5000.00" Dmx="0~65535" />
      <Function ID="5" Name="Duty" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="6" Name="Warm" Display="'Warm'" Dmx="0~0" />
      <Function ID="7" Name="Neutral" Display="'Neutral'" Dmx="22102~43690" />
      <Function ID="8" Name="Cool" Display="'Cool'" Dmx="43947~65535" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />

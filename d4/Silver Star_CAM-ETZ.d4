  <Thumbnail>3a7046f1-5b74-4b8f-9558-8e180dbd254d</Thumbnail>
  <History Date="23-07-10" Author="Jonathan Moreton" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="16-11-14" Author="Nic Morris" Comment="Added Arc1+S mode" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="02-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="02-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="02-02-18" Author="Nic Morris" Comment="Revised Atlabase ID's and added missing mode ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0d4967ec-f03a-4b96-9074-075da4ea20af" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~20.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Green, Red" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" Update="Green, Red" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" Update="Green, Red" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="30~39" Update="Green, Red" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="40~49" Update="Green, Red" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="50~59" Update="Green, Red" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="60~69" Update="Green, Red" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="70~79" Update="Green, Red" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="80~89" Update="Green, Red" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="90~99" Update="Green, Red" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="100~109" Update="Green, Red" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="110~119" Update="Green, Red" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="120~129" Update="Green, Red" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="130~139" Update="Green, Red" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="140~149" Update="Green, Red" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="150~159" Update="Green, Red" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="160~169" Update="Green, Red" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="170~179" Update="Green, Red" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="180~189" Update="Green, Red" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="190~199" Update="Green, Red" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="200~255" Update="Green, Red" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Non Linear" Display="'Non Linear %.1f%%',0.0~100.0" Dmx="30~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Tour, 10 DMX" Channels="10">
    <Import PearlRef="SS_CAMETZT" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="dd248ea4-11e7-433a-a2a0-d7d695fd4d9b" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="37" />
      <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="9" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Arc.1, 3 DMX" Channels="3">
    <Import PearlRef="SS_CAMETZA1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cd472537-feaa-4b97-987e-f63ec48931d7" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>

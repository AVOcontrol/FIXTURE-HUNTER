<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Blinder 2 (BL200)" ShortName="Blinder 2" Company="V-Show" Version="4">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>d4318a39-87bd-4cbf-8381-fe278aee1f26</Thumbnail>
  <History Date="30-11-21" Author="Nic Morris" Comment="Created (documentation is vague.  it is not clear if there are two individually controllable cells or if it's WW/CW.  gone with the former for now)" Version="0" />
  <History Date="12-10-24" Author="Nic Morris" Comment="Updated in line with latest documentation (adds 2 and 6 channel modes).  Changed 4 channel mode to CW/WW." Version="1" />
  <History Date="15-10-24" Author="Nic Morris" Comment="Added Atlabase ID for 2 channel mode and revised ID for 6 channel mode.  Documentation is very confusing." Version="2" />
  <History Date="04-02-25" Author="Nic Morris" Comment="Added alternative 6 channel mode.  The manufacturer has seems to have made an incredible mess in documenting what is such a simple fixture." Version="3" />
  <History Date="05-02-25" Author="Nic Morris" Comment="Changed all modes from CW/WW to 2-cell implementation in response to customer feedback." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1dddf044-3dbf-4923-81a7-e5a5cdc14dd2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="6~100" />
      <Function ID="3" Name="Gradient" Display="'Gradient'" Dmx="101~150" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="151~200" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

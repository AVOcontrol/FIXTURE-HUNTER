<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hydro Wash X19" ShortName="HydroWsX19" Company="ADJ" Version="7">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>4e5ffbee-0379-448f-85aa-41afbca01d0a</Thumbnail>
  <History Date="17-10-19" Author="Nic Morris" Comment="Created (conflicting specifications - three different tilt ranges depending on where you look.  no pixel layout)" Version="1" />
  <History Date="11-11-20" Author="Nic Morris" Comment="Created from American DJ Hydro Wash X7 (no pixel layout)" Version="2" />
  <History Date="12-11-20" Author="Nic Morris" Comment="Fixed 16 channel mode." Version="3" />
  <History Date="10-08-21" Author="Nic Morris" Comment="Updated in line with documentation v1.3/ software v1.2 (adds 26 channel mode, adds pixel layout, revises zoom wheel direction)" Version="4" />
  <History Date="11-08-21" Author="Nic Morris" Comment="Added Atlabase ID for 26 DMX mode." Version="5" />
  <History Date="25-10-22" Author="Nic Morris" Comment="Updated in line with latest documentation (v1.6) (adds 20 and 30 channel modes.  note zoom wheel direction seems to have changed again)" Version="6" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Hydro Wash X19.d4 to ADJ_Hydro Wash X19.d4." Version="7" />
  <Manual Filename="" Summary="" />

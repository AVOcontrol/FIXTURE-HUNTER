<Fixture Name="LX106" ShortName="LX106" Company="Luxibel">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Fixed power on and locate.  Changed HSV attribute groups." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Simplified conditional statements.  Fixed shutter palettes." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Increased wheel resolutions.  Added missing IDs to ID Address" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Added virtual dimmers." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Removed value attribute.  Replaced with dimmer for HTP" />
  <History Date="07-03-12" Author="Peter Budd" Comment="Created from COLRado 1 Tour" />
  <History Date="24-05-13" Author="Peter Budd" Comment="Created from the Chauvet COLORado 1 Quad Tour." />
  <History Date="13-10-13" Author="Peter Budd" Comment="Created from the Prolights LumiPar 18Q Pro." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7b8de594-6eae-462d-b39c-479ffca36901" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green" Display="'Red/Green %.f%%',0~100" Dmx="11~30" Colour="255,0,0" />
      <Function ID="3" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="31~50" Colour="255,255,0" />
      <Function ID="4" Name="Green/Blue" Display="'Green/Blue %.f%%',0~100" Dmx="51~70" Colour="0,255,0" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green %.f%%',0~100" Dmx="71~90" Colour="0,255,255" />
      <Function ID="6" Name="Blue/Red" Display="'Blue/Red %.f%%',0~100" Dmx="91~110" Colour="0,0,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue %.f%%',0~100" Dmx="111~130" Colour="255,0,255" />
      <Function ID="8" Name="Red/Grn/Bl" Display="'Red/Grn/Bl %.f%%',0~100" Dmx="131~150" Colour="255,0,0" />
      <Function ID="9" Name="Blue/Rd/Grn" Display="'Blue/Rd/Grn %.f%%',0~100" Dmx="151~170" Colour="255,255,255" />
      <Function ID="10" Name="RGB" Display="'RGB %.f%%',0~100" Dmx="171~200" Colour="255,255,255" />
      <Function ID="11" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="12" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="13" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="14" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="15" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="16" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="17" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="18" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="19" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="20" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="21" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~20.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~51" Update="Macro_Speed" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="52~101" Update="Macro_Speed" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="102~152" Update="Macro_Speed" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="153~203" Update="Macro_Speed" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="204~254" Update="Macro_Speed" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="255~255" Update="Macro_Speed" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Macro 1" ID="1" If="'Macro'&gt;1" />
      <Else ID="2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Inactive" Display="'Inactive'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Dimmer_Speed" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Linear Dimmer" Display="'Linear Dimmer'" Dmx="52~101" />
      <Function ID="3" Name="Dim 1" Display="'Dim 1'" Dmx="102~152" />
      <Function ID="4" Name="Dim 2" Display="'Dim 2'" Dmx="153~203" />
      <Function ID="5" Name="Dim 3" Display="'Dim 3'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~255" Intensity="0~0" />
    </Attribute>
  </Control>

  <History Date="04-06-22" Author="Nic Morris" Comment="Created (very poor documentation.  mostly nonsense.  control names don't match up with functions.  made best guess)" Version="0" />
  <History Date="22-10-23" Author="Nic Morris" Comment="Created from Unknown Laser RGB 5W (equally hopeless documentation.  identical except adds 10 channel mode)" Version="1" />
  <History Date="31-01-25" Author="Nic Morris" Comment="Created from Unknown Laser Pantoufle (also hopeless documentation.  effectively identical)" Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="G">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Horiz Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Vert Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Fixed Multi-Col" Display="'Fixed Multi-Col'" Dmx="1~7" Colour="0,0,0" />
      <Function ID="3" Name="White" Display="'White'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="16~23" Colour="255,0,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="24~31" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="32~39" Colour="0,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="40~47" Colour="0,255,255" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="48~55" Colour="0,0,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="56~63" Colour="255,150,150" />
      <Function ID="10" Name="7 Col Change (1)" Display="'7 Col Change (1) %.f%%',0~100" Dmx="64~95" Colour="0,0,0" />
      <Function ID="11" Name="RGB Col Change" Display="'RGB Col Change %.f%%',0~100" Dmx="96~127" Colour="0,0,0" />
      <Function ID="12" Name="7 Col Change (2)" Display="'7 Col Change (2) %.f%%',0~100" Dmx="128~159" Colour="0,0,0" />
      <Function ID="13" Name="Multi-Col Flow" Display="'Multi-Col Flow %.f%%',0~100" Dmx="160~191" Colour="0,0,0" />
      <Function ID="14" Name="Full Col Flow" Display="'Full Col Flow %.f%%',0~100" Dmx="192~223" Colour="0,0,0" />
      <Function ID="15" Name="Col Drawing" Display="'Col Drawing %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Scan_Spd" Name="Scan Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line Scan Spd" Display="'Line Scan Spd %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Point Scan Spd" Display="'Point Scan Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pattern/Effect" Name="Pattern/Effect" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Library 1" Display="'Library 1'" Dmx="0~0" />
      <Function ID="2" Name="Library 2" Display="'Library 2'" Dmx="8~15" />
      <Function ID="3" Name="Effect Library" Display="'Effect Library'" Dmx="16~23" />
      <Function ID="4" Name="Static Library" Display="'Static Library'" Dmx="24~255" />
    </Attribute>
    <Attribute ID="Trigger" Name="Trigger" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default Auto Spd" Display="'Default Auto Spd'" Dmx="0~0" />

      <Function ID="2" Name="Auto L-R" Display="'Auto L-R %.f%%',0~100" Dmx="128~159" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Auto R-L" Display="'Auto R-L %.f%%',0~100" Dmx="160~223" Iris="0~0" Zoom="0~0" />

      <Function ID="18" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="19" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="176~180" WheelPosition="1" />
      <Function ID="20" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="181~185" WheelPosition="2" />

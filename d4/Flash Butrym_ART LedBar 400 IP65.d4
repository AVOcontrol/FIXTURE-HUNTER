    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Smooth Fade" Display="'Smooth Fade %.f%%',0~100" Dmx="6~70" Colour="255,255,255" />
      <Function ID="3" Name="Chase" Display="'Chase %.f%%',0~100" Dmx="71~130" Colour="255,255,255" />

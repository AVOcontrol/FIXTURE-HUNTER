  <Mode Name="Mode 2, 10 DMX" Channels="10">
    <Import PearlRef="MMREVQD" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

  <History Date="08-03-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="12-03-12" Author="Peter Budd" Comment="Created from Showtec Indigo 2000" Version="2" />
  <History Date="12-10-12" Author="Peter Budd" Comment="Created from the Chauvet Q-Spot 360 LED" Version="3" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Changed name from SS 628 SC to Indigo 3000XS (SS628SC).  Added product thumbnail." Version="4" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Added highlight/lowlight.  Added colour function index.  Standardised conditionals." Version="5" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Reordered gobo 2 shake functions.  Recreated palettes." Version="6" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Corrected split colour function names and changed from varibale to fixed." Version="7" />
  <History Date="16-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="17-01-19" Author="Nic Morris" Comment="Fixed gobo 2 func scroll condition.  Inverted gobo and prism CW wheel directions." Version="9" />
  <History Date="24-04-26" Author="Nic Morris" Comment="Created from Silver Star Indigo 3000XS (SS628SC) (effectively identical, unsurprisingly)" Version="10" />
  <History Date="17-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="11" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7afd4713-52d4-4d2d-ac75-f052bf1e8bb9" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="30~39" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="40~49" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="70~79" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="200~219" WheelPosition="0" Colour="255,0,0" />
      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="180~199" WheelPosition="1" Colour="0,255,0" />
      <Function ID="11" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="160~179" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="140~159" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="120~139" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="100~119" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Mag/ L Blu" Display="'Mag/ L Blu'" Dmx="80~99" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>0990f0c1-cfab-44b1-a2b1-c0a2e70b7c46</Swatch>

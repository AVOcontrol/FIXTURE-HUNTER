    </Physical>
    <Include>
      <Attribute ID="Black_Level" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Contrast" ChannelOffset="2" Wheel="8" />
      <Attribute ID="xHue" ChannelOffset="3" Wheel="9" />

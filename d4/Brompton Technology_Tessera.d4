  <History Date="28-08-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Swapped freeze and blackout mapping in preset mode in response to customer feedback (manufacturer confirmed current documentation is incorrect)" Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red Gain" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red Gain" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green Gain" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green Gain" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue Gain" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue Gain" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Intensity Gain" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity Gain" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X Offset" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X Offset" Display="'%.2f',-1920.00~1920.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y Offset" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y Offset" Display="'%.2f',-1080.00~1080.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Rot_Offset" Name="Rot Offset" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rot Offset" Display="'%.2f°',-180.00~180.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Black_Level" Name="Black Level" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Black Level" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Contrast" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.f°',-180~180" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red_Shadow" Name="Red Shadow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red Shadow" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green_Shadow" Name="Green Shadow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green Shadow" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue_Shadow" Name="Blue Shadow" Description="" Group="C">

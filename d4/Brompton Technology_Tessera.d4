    </Attribute>
    <Attribute ID="Red_Hilight" Name="Red Hilight" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red Hilight" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green_Hilight" Name="Green Hilight" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green Hilight" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue_Hilight" Name="Blue Hilight" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue Hilight" Display="'%.1f',-100.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Test_Pattern" Name="Test Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal Video" Display="'Normal Video'" Dmx="0~0" />
      <Function ID="2" Name="Brompton Glyph Pattern" Display="'Brompton Glyph Pattern'" Dmx="10~19" />
      <Function ID="3" Name="Brompton Glyph Overlay" Display="'Brompton Glyph Overlay'" Dmx="20~29" />
      <Function ID="4" Name="White Test Pattern" Display="'White Test Pattern'" Dmx="30~39" />
      <Function ID="5" Name="Red Test Pattern" Display="'Red Test Pattern'" Dmx="40~49" />
      <Function ID="6" Name="Green Test Pattern" Display="'Green Test Pattern'" Dmx="50~59" />
      <Function ID="7" Name="Blue Test Pattern" Display="'Blue Test Pattern'" Dmx="60~69" />
      <Function ID="8" Name="Cyan Test Pattern" Display="'Cyan Test Pattern'" Dmx="70~79" />
      <Function ID="9" Name="Magenta Test Pattern" Display="'Magenta Test Pattern'" Dmx="80~89" />
      <Function ID="10" Name="Yellow Test Pattern" Display="'Yellow Test Pattern'" Dmx="90~99" />
      <Function ID="11" Name="Black Test Pattern" Display="'Black Test Pattern'" Dmx="100~109" />
      <Function ID="12" Name="Grid Test Pattern" Display="'Grid Test Pattern'" Dmx="110~119" />
      <Function ID="13" Name="Scrolling Grid Test Pattern" Display="'Scrolling Grid Test Pattern'" Dmx="120~129" />
      <Function ID="14" Name="Checkerboard Test Pattern" Display="'Checkerboard Test Pattern'" Dmx="130~139" />
      <Function ID="15" Name="Scrolling Checkerboard Test Pattern" Display="'Scrolling Checkerboard Test Pattern'" Dmx="140~149" />
      <Function ID="16" Name="Gradient Test Pattern" Display="'Gradient Test Pattern'" Dmx="150~159" />
      <Function ID="17" Name="Scrolling Gradient Test Pattern" Display="'Scrolling Gradient Test Pattern'" Dmx="160~169" />
      <Function ID="18" Name="Colour Bars Test Pattern" Display="'Colour Bars Test Pattern'" Dmx="170~179" />
      <Function ID="19" Name="Gamma Test Pattern" Display="'Gamma Test Pattern'" Dmx="180~189" />
      <Function ID="20" Name="Strobe Test Pattern" Display="'Strobe Test Pattern'" Dmx="190~199" />
      <Function ID="21" Name="SMPTE Bars Test Pattern" Display="'SMPTE Bars Test Pattern'" Dmx="200~209" />
      <Function ID="22" Name="Scrolling SMPTE Test Pattern" Display="'Scrolling SMPTE Test Pattern'" Dmx="210~219" />
      <Function ID="23" Name="Custom Test Pattern" Display="'Custom Test Pattern'" Dmx="220~229" />
      <Function ID="24" Name="45° Grid Test Pattern" Display="'45° Grid Test Pattern'" Dmx="230~239" />
      <Function ID="25" Name="Scrolling 45° Grid Test Pattern" Display="'Scrolling 45° Grid Test Pattern'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Freeze" Name="Freeze" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Freeze" Display="'Freeze'" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Blackout" Name="Blackout" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Preset" Name="Preset" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Preset" Display="'Preset %.f',1~127" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Colour Mode, 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Group, 10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

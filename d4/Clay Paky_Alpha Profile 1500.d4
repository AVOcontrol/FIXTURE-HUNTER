      <Function ID="11" Name="Grn/ Aq" Display="'Grn/ Aq %.f%%',0~100" Dmx="58~77" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="Aq/ Org" Display="'Aq/ Org %.f%%',0~100" Dmx="77~97" WheelPosition="4" Colour="0,255,128" />
      <Function ID="13" Name="Org/ Blu" Display="'Org/ Blu %.f%%',0~100" Dmx="97~117" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="117~127" WheelPosition="6" Colour="0,0,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />

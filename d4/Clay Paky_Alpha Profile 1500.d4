<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Profile 1500" ShortName="AlPro1500" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>8dd840a8-1082-498d-8bb9-556db3e7fbcb</Thumbnail>
  <History Date="17-09-09" Author="David Hunt" Comment="Created" />
  <History Date="23-11-09" Author="John Rogers" Comment="Extensive update in line with Clay Paky documentation." />
  <History Date="19-07-10" Author="John Rogers" Comment="Edited blade Attribute IDs." />
  <History Date="16-09-11" Author="Karel Bartak" Comment="Edited Macro Effects and Autofocus." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-06-17" Author="Nic Morris" Comment="Changed Atlabase ID's to CMY versions.  Revised mode names to reflect settings more clearly." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Added physical Pan/Tilt limits.  Standardised conditionals.  Increased wheel resolution." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Added colour function index.  Revised colour index ranges for full field control." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Revised colour macro with discreet function ranges.  Standardised shutter." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Fixed 16bit raw display range.  Revised function functions.  Recreated palettes." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Revised speed controls.  Inverted zoom." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added RDM ID's.  Added product thumbnail." />
  <History Date="20-02-19" Author="Nic Morris" Comment="Added gobo swatches" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="128" />
  </RDM>
  <AtlaBase TypeID="e7061525-4b79-453f-9e80-b100e9785a3b" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

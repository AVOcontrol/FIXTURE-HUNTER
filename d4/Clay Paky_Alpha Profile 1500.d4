    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="39~39" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="58~58" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Aquamarine" Display="'Aquamarine'" Dmx="77~77" WheelPosition="4" Colour="0,255,128" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="97~97" WheelPosition="5" Colour="255,128,0" />

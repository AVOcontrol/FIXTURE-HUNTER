  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>1c74dd06-dd1b-4c91-b055-f9ab35557675</Thumbnail>
  <History Date="16-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added Atlabase ID's (currently missing PIXEL mode)" Version="2" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Added missing Atlabase ID to PIXEL mode." Version="3" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Fixed CMY mode (RGB amd CMY were both in the master which caused a wheel mapping conflict and compatibility problems)" Version="4" />
  <History Date="03-08-19" Author="Nic Morris" Comment="Added ring RGB and dimmer and renamed fan control functions and macros in line with latest charts in response to manufacturer request." Version="5" />
  <History Date="03-08-19" Author="Nic Morris" Comment="Revised Atlabase ID's to use 'V2' (it isn't a version 2!)" Version="6" />
  <History Date="06-04-21" Author="Nic Morris" Comment="Created from Silver Star Neptune 400 FX Wash (SS671XCEM) (identical)" Version="7" />
  <History Date="08-04-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="07-11-24" Author="Nic Morris" Comment="Created from Showtec Polar 340 WashFX" Version="9" />

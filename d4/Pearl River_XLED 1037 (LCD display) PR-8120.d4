<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="XLED 1037 (LCD display) PR-8120" ShortName="XLED 1037" Company="Pearl River">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>a92d27bb-5d31-4adf-8ffd-a3f5c9eb772d</Thumbnail>
  <History Date="19-12-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-04-18" Author="Nic Morris" Comment="Added product thumbnail.  Revised mode names." />
  <History Date="09-08-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added vdim to Extended mode cells." />
  <History Date="13-08-19" Author="Nic Morris" Comment="Inverted RGBW controls (description in charts is wrong)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ed9c00c1-257a-4555-8c2b-a09701bfdcba" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="16~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Animation" Display="'Animation %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~63" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="64~95" Colour="0,0,255" />
      <Function ID="5" Name="Colour 1" Display="'Colour 1'" Dmx="96~127" Colour="0,0,0" />
      <Function ID="6" Name="Colour 2" Display="'Colour 2'" Dmx="128~159" Colour="0,0,0" />
      <Function ID="7" Name="Colour 3" Display="'Colour 3'" Dmx="160~191" Colour="0,0,0" />
      <Function ID="8" Name="White" Display="'White'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="50~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 17 DMX" Channels="17">
    <Import PearlRef="PR8120SH" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e0e9b297-025c-4bd3-9fae-e2f273848244" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="12,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="14,15" Wheel="3" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="40" />
      <Attribute ID="Zoom" ChannelOffset="10,11" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="4" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="16" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended, 26 DMX" Channels="26">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="734c9ba5-f895-4924-9625-9f74399a3f60" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Shutter" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
        <Attribute ID="Effect" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Colour1Func" Wheel="7" />
        <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Zoom" ChannelOffset="19,20" Wheel="19" />
        <Attribute ID="Pan" ChannelOffset="21,22" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="23,24" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="25" Wheel="25" />
        <Attribute ID="Control" ChannelOffset="26" Wheel="28" />
        <Attribute ID="Master_Dimmer" ChannelOffset="2,3" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="RGBW cell, 4 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="RGBW cell, 4 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="RGBW cell, 4 DMX" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="RGBW cell, 4 DMX" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="10" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

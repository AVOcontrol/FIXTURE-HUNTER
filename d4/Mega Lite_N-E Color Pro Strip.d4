<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="N-E Color Pro Strip" ShortName="NEColProSt" Company="Mega Lite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="15-06-10" Author="John Rogers" Comment="Created" />
  <History Date="26-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added v-dim.  Added pixel mapper compatibility." />
  <History Date="04-12-12" Author="Peter Budd" Comment="Added Mode H and Mode L" />
  <History Date="23-07-13" Author="Peter Budd" Comment="Corrected shutter on Mode L." />
  <History Date="09-09-13" Author="Peter Budd" Comment="Changed open range of the shutter channel to 0 on user request." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="111~179" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="162~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macros" Name="Macros" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~9" />
      <Function ID="2" Name="Colour Fade" Display="'Colour Fade'" Dmx="10~50" />
      <Function ID="3" Name="RGB Fade" Display="'RGB Fade'" Dmx="51~91" />
      <Function ID="4" Name="Fade Chase" Display="'Fade Chase'" Dmx="92~132" />
      <Function ID="5" Name="Snap Chase" Display="'Snap Chase'" Dmx="133~173" />
      <Function ID="6" Name="Macros" Display="'Macros %.f',174~214" Dmx="174~214" />
      <Function ID="7" Name="Random Macros" Display="'Random Macros %.f',215~255" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

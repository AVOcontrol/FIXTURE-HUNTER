      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~24" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="25~49" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="50~74" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="75~99" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="100~124" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="125~149" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="150~174" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="175~199" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="200~224" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="225~249" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" />

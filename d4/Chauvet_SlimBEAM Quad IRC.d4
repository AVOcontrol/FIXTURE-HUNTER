  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;12" />
      <Condition Name="Sensitivity" ID="4,5" If="'Auto'==12" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="0~0" Intensity="0~0" />
      <Function ID="5" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~32" Update="Shutter" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~54" Update="Shutter" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="55~76" Update="Shutter" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="77~98" Update="Shutter" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="99~120" Update="Shutter" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="121~142" Update="Shutter" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="143~164" Update="Shutter" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="165~186" Update="Shutter" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="187~208" Update="Shutter" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="209~230" Update="Shutter" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="231~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="806Hz-Auto" Display="'806Hz-Auto'" Dmx="0~0" />
      <Function ID="2" Name="806Hz-Fast" Display="'806Hz-Fast'" Dmx="32~63" />
      <Function ID="3" Name="1562Hz-Auto" Display="'1562Hz-Auto'" Dmx="64~95" />
      <Function ID="4" Name="1562Hz-Fast" Display="'1562Hz-Fast'" Dmx="96~127" />
      <Function ID="5" Name="5000Hz-Auto" Display="'5000Hz-Auto'" Dmx="128~159" />
      <Function ID="6" Name="5000Hz-Fast" Display="'5000Hz-Fast'" Dmx="160~191" />
      <Function ID="7" Name="8333Hz-Auto" Display="'8333Hz-Auto'" Dmx="192~223" />
      <Function ID="8" Name="8333Hz-Fast" Display="'8333Hz-Fast'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="2~239" Colour="255,255,255" />
      <Function ID="3" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe Half" Display="'Strobe Half %.f%%',0~100" Dmx="132~175" />
      <Function ID="3" Name="Strobe Full" Display="'Strobe Full %.f%%',0~100" Dmx="176~247" />
      <Function ID="4" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="248~251" />
      <Function ID="5" Name="Rnd Async" Display="'Rnd Async %.f%%',0~100" Dmx="252~255" />

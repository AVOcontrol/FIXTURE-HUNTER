    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="58~59" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="109~110" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="111~159" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="160~161" Intensity="0~0" />
      <Function ID="8" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="162~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade'" Dmx="10~50" Colour="0,0,0" />
      <Function ID="3" Name="Fade RGB" Display="'Fade RGB'" Dmx="51~91" Colour="0,0,0" />
      <Function ID="4" Name="Fade Chase" Display="'Fade Chase'" Dmx="92~132" Colour="0,0,0" />
      <Function ID="5" Name="Snap Chase" Display="'Snap Chase'" Dmx="133~173" Colour="0,0,0" />
      <Function ID="6" Name="Macros" Display="'Macros'" Dmx="174~214" Colour="0,0,0" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="215~255" Colour="0,0,0" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MY-S1200" ShortName="MY-S1200" Company="Denkriser">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="(created by customer - no documentation seen)" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Changed pan and tilt to 16bit.  Inverted P/T speed wheel direction.  Increased wheel resolution." />
  <History Date="12-09-15" Author="Nic Morris" Comment="Fixed shutter power on and locate.  Added a reserved channel to compensate for gaps in mapping." />
  <History Date="12-09-15" Author="Nic Morris" Comment="Standardised mode name.  Added pearl ref.  Added palettes.  Added conditions.  Standardised gobo functions" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~2" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~17" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~33" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="49~50" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~65" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="79~80" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~97" Colour="0,0,255" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="111~112" Colour="0,255,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="126~126" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="8" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="40~50" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="70~90" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="100~120" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="135~155" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="165~175" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="200~215" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="129~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="8" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="40~55" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="70~85" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="100~120" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="135~150" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="165~185" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="200~215" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_2_Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="1~60" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="65~125" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="130~140" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="145~150" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="155~165" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="170~190" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="195~214" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="217~235" />
      <Function ID="10" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="255~240" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'Focus %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="2~125" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="130~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~25" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="35~60" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="65~95" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="100~120" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="130~155" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="165~185" Intensity="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="195~220" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="230~255" Intensity="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo_2, Gobo_2_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo_2, Gobo_2_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo_2, Gobo_2_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo_2, Gobo_2_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo_2, Gobo_2_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="UKDRS12" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="15" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="16" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="9" Wheel="15" />
      <Attribute ID="Gobo_2" ChannelOffset="10" Wheel="17" />
      <Attribute ID="Gobo_2_Rot" ChannelOffset="11" Wheel="18" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Focus" ChannelOffset="13" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="12" Wheel="22" />
      <Attribute ID="Effect" ChannelOffset="14" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Reserved" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:2,Gobo_2:1,Gobo2Func:2" />
      <Palette ID="8" Name="Gobo 1" Number="18" Page="1" SetControl="Gobo_2:2,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
      <Palette ID="9" Name="Gobo 2" Number="19" Page="1" SetControl="Gobo_2:3,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
      <Palette ID="10" Name="Gobo 3" Number="20" Page="1" SetControl="Gobo_2:4,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
      <Palette ID="11" Name="Gobo 4" Number="0" Page="1" SetControl="Gobo_2:5,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
      <Palette ID="12" Name="Gobo 5" Number="0" Page="1" SetControl="Gobo_2:6,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
      <Palette ID="13" Name="Gobo 6" Number="0" Page="1" SetControl="Gobo_2:7,Gobo2Func:2,Gobo1:1,Gobo1Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5112777f-073a-456a-802f-0c8649f741b9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="8~24" Colour="255,0,0" />
      <Function ID="3" Name="G" Display="'G'" Dmx="25~41" Colour="0,255,0" />
      <Function ID="4" Name="B" Display="'B'" Dmx="42~57" Colour="0,0,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="58~74" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="75~90" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="91~107" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="108~123" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="124~140" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="141~156" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="157~173" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="174~189" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="190~206" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="207~222" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="223~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~22" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="23~37" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="38~52" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="53~67" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="68~82" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="83~97" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="98~112" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="113~127" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="128~142" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="143~157" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="158~172" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="173~187" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="188~202" />
      <Function ID="15" Name="Show 14" Display="'Show 14'" Dmx="203~217" />
      <Function ID="16" Name="Show 15" Display="'Show 15'" Dmx="218~232" />
      <Function ID="17" Name="Show 16" Display="'Show 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="249~255" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LED Col Change" Display="'LED Col Change'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.1f%%',0.0~100.0" Dmx="15~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

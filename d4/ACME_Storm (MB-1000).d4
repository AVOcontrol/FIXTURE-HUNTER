      <Function ID="12" Name="Macro 11" Display="'Macro 11 %.f%%',0~100" Dmx="176~191" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12 %.f%%',0~100" Dmx="192~207" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13 %.f%%',0~100" Dmx="208~223" />

  <AtlaBase TypeID="541f7f19-229a-4aed-a72c-69d6ba55f15b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="225~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Speed 1" Display="'Speed 1'" Dmx="0~0" />
      <Function ID="2" Name="Speed 2" Display="'Speed 2'" Dmx="50~99" />
      <Function ID="3" Name="Speed 3" Display="'Speed 3'" Dmx="100~149" />
      <Function ID="4" Name="Speed 4" Display="'Speed 4'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~29" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~54" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="55~79" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~104" Colour="255,255,255" />
      <Function ID="6" Name="Colour 1" Display="'Colour 1'" Dmx="105~129" Colour="0,0,0" />
      <Function ID="7" Name="Colour 2" Display="'Colour 2'" Dmx="130~154" Colour="0,0,0" />
      <Function ID="8" Name="Colour 3" Display="'Colour 3'" Dmx="155~174" Colour="0,0,0" />
      <Function ID="9" Name="Colour 4" Display="'Colour 4'" Dmx="175~179" Colour="0,0,0" />
      <Function ID="10" Name="Colour 5" Display="'Colour 5'" Dmx="180~184" Colour="0,0,0" />
      <Function ID="11" Name="Colour 6" Display="'Colour 6'" Dmx="185~189" Colour="0,0,0" />
      <Function ID="12" Name="Colour 7" Display="'Colour 7'" Dmx="190~194" Colour="0,0,0" />
      <Function ID="13" Name="Colour 8" Display="'Colour 8'" Dmx="195~199" Colour="0,0,0" />
      <Function ID="14" Name="Colour 9" Display="'Colour 9'" Dmx="200~204" Colour="0,0,0" />
      <Function ID="15" Name="Colour 10" Display="'Colour 10'" Dmx="205~209" Colour="0,0,0" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="211~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~99" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="EXTMH16" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="190" PanMaxSpeed="0" TiltMaxSpeed="0" />

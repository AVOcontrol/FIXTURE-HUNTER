  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>3ee654ed-0d26-41ec-b8d2-ee4e0febcd61</Thumbnail>
  <History Date="04-03-17" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-01-18" Author="Nic Morris" Comment="Added compatibility for 50 DMX mode R20 export.  Added product thumbnail." Version="2" />
  <History Date="09-04-19" Author="Nic Morris" Comment="Split for Capture and added Atlabase ID's to supported modes.  Revised product thumbnail." Version="3" />
  <History Date="09-04-19" Author="Nic Morris" Comment="Added split patch options for 14, 26 and 50 DMX modes." Version="4" />
  <History Date="16-04-19" Author="Nic Morris" Comment="Added Atlabase ID's to 14/26/50 DMX split part modes and revised 192 DMX single strip mode ID." Version="5" />
  <History Date="22-07-22" Author="Nic Morris" Comment="Added 208 DMX Single Strip Master and 208 DMX Single strip modes as alternative to the combined parts which cannot currently be patched in Titan)" Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="21fd47c3-55fe-4aaa-b7c9-c828dbcff25d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

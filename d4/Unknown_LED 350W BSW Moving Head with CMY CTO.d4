      <Function ID="11" Name="Open" Display="'Open'" Dmx="90~99" WheelPosition="0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="100~109" WheelPosition="1" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="110~119" WheelPosition="2" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="120~129" WheelPosition="3" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="130~139" WheelPosition="4" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="140~149" WheelPosition="5" />

    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~24" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="25~29" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~34" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="35~44" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="45~49" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="50~54" />
      <Function ID="8" Name="RGB (White)" Display="'RGB (White)'" Dmx="55~60" />
      <Function ID="9" Name="White" Display="'White'" Dmx="61~90" />
      <Function ID="10" Name="Effect 1" Display="'Effect 1'" Dmx="91~95" />
      <Function ID="11" Name="Effect 2" Display="'Effect 2'" Dmx="96~120" />
      <Function ID="12" Name="Effect 3" Display="'Effect 3'" Dmx="121~150" />
      <Function ID="13" Name="Effect 4" Display="'Effect 4'" Dmx="151~180" />
      <Function ID="14" Name="Effect 5" Display="'Effect 5'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

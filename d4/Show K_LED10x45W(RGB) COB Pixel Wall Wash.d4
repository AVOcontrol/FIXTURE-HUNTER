  <History Date="04-06-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="05-06-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6dee5621-66bc-4576-a657-d7de65b5872a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~22" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="23~37" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="38~52" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="53~67" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="68~82" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="83~97" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="98~112" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="113~127" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="128~142" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="143~157" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="158~172" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="173~187" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="188~202" />
      <Function ID="15" Name="Show 14" Display="'Show 14'" Dmx="203~217" />
      <Function ID="16" Name="Show 15" Display="'Show 15'" Dmx="218~232" />
      <Function ID="17" Name="Show 16" Display="'Show 16'" Dmx="233~247" />
      <Function ID="18" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

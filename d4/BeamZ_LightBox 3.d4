    </Attribute>
    <Attribute ID="Par_Colour" Name="Par Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~39" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~79" Colour="0,255,0" />

      <Function ID="8" Name="CTC 2" Display="'CTC 2'" Dmx="28~31" Colour="255,200,150" />
      <Function ID="9" Name="CTC 3" Display="'CTC 3'" Dmx="32~35" Colour="255,200,150" />
      <Function ID="10" Name="Minus Green" Display="'Minus Green'" Dmx="36~39" Colour="200,220,255" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="40~43" Colour="255,0,0" />
      <Function ID="12" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="44~167" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="212~212" Colour="0,0,0" />
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="168~211" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="212~212" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="213~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

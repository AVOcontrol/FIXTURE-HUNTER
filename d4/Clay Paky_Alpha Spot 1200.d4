<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot 1200" ShortName="AlphSp1200" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>8c32a9eb-d4ae-49ec-9e1c-d98c176cb599</Thumbnail>
  <History Date="29-05-09" Author="David Hunt" Comment="Removed History tags and updated to match latest spec" />
  <History Date="15-03-10" Author="John Rogers" Comment="Edited Pan locate value to 40%" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="01-05-12" Author="Peter Budd" Comment="Corrected Graphic Disc" />
  <History Date="17-06-15" Author="Peter Budd" Comment="Added Vector Off modes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Added missing atlabase ID's to Rain ON modes.  Increased wheel resolution." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Standardised conditionals.  Fixed colour index range.  Fixed 16 bit raw range." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed duplicate functions in else conditions.  Added function index.  Added highlight/lowlight" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Changed name from AlphaSpot 1200 to Alpha Spot 1200" />
  <History Date="16-12-16" Author="Nic Morris" Comment="Added missing Vect OFF modes.  Added Atlabase ID's to all Vect OFF and Rain OFF modes." />
  <History Date="25-06-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly.  Renamed and revised effect control." />
  <History Date="25-06-17" Author="Nic Morris" Comment="Inverted zoom.  Standardised shutter.  Changed split col to fixed values and added separate index function ranges." />
  <History Date="25-06-17" Author="Nic Morris" Comment="Standardised zoom and focus power on and locate.  Recreated palettes" />
  <History Date="06-03-19" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches." />
  <Manual Filename="\manuals\fixtures\clay paky" Summary="" />
  <AtlaBase TypeID="2057ebe7-358e-4c50-8942-072b858dccf4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

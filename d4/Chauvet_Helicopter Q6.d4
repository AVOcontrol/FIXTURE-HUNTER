<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Helicopter Q6" ShortName="Heli Q6" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-04-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pod_Colour" Name="Pod Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red %.f%%',0~100" Dmx="13~66" Colour="255,0,0" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="67~75" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green %.f%%',0~100" Dmx="76~129" Colour="0,255,0" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="130~138" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="139~192" Colour="0,0,255" />
      <Function ID="7" Name="No Function" Display="'No Function'" Dmx="193~201" Colour="255,255,255" />
      <Function ID="8" Name="White" Display="'White %.f%%',0~100" Dmx="202~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Pod Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pod_Strobe" Name="Pod Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~240" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="1~80" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="81~160" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="SMD_Auto" Name="SMD Auto" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="1~25" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="26~51" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="52~77" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="78~103" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="104~129" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="130~155" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="156~181" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="182~207" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="208~233" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="SMD_Auto_Spd" Name="SMD Auto Spd" Description="" Group="G">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="Red + Green" Display="'Red + Green'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="Rd On, Grn Strobe" Display="'Rd On, Grn Strobe'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="Grn On, Rd Strobe" Display="'Grn On, Rd Strobe'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="Rd/ Grn Alt Strobe" Display="'Rd/ Grn Alt Strobe'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Pods" Display="'Pods'" Dmx="6~41" />
      <Function ID="3" Name="Laser" Display="'Laser'" Dmx="42~77" />
      <Function ID="4" Name="SMD Strobes" Display="'SMD Strobes'" Dmx="78~113" />
      <Function ID="5" Name="Pods + Laser" Display="'Pods + Laser'" Dmx="114~149" />
      <Function ID="6" Name="Pods + SMD Strobes" Display="'Pods + SMD Strobes'" Dmx="150~185" />
      <Function ID="7" Name="Laser + SMD Strobes" Display="'Laser + SMD Strobes'" Dmx="186~221" />
      <Function ID="8" Name="All" Display="'All'" Dmx="222~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pod_Colour" Wheel="7" />
        <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
        <Attribute ID="Pod_Strobe" ChannelOffset="8" Wheel="4" />
        <Attribute ID="SMD_Auto" ChannelOffset="9" Wheel="13" />
        <Attribute ID="SMD_Auto_Spd" ChannelOffset="10" Wheel="14" />
        <Attribute ID="Laser" ChannelOffset="11" Wheel="8" />
        <Attribute ID="Laser_Strobe" ChannelOffset="12" Wheel="5" />
        <Attribute ID="Laser_Rot" ChannelOffset="13" Wheel="19" />
        <Attribute ID="Rotation" ChannelOffset="14" Wheel="20" />
        <Attribute ID="Auto" ChannelOffset="15" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="16" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Pod_Colour" TargetId="Pod_Colour" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="CHHELIQ6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Rotation" ChannelOffset="3" Wheel="20" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pod_Colour" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
</Fixture>
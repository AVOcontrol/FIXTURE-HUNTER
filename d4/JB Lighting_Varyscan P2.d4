      <Attribute ID="Reserved" ChannelOffset="8" Wheel="58" />
      <Attribute ID="Reserved1" ChannelOffset="10" Wheel="59" />
      <Attribute ID="Reserved2" ChannelOffset="11" Wheel="60" />
      <Attribute ID="Reserved3" ChannelOffset="16" Wheel="88" />
      <Attribute ID="Reserved4" ChannelOffset="19" Wheel="89" />

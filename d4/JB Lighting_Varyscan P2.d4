      <Attribute ID="Move_in_Dark" ChannelOffset="22" Wheel="27" />
    </Include>
  </Mode>
  <Mode Name="Hog Mode, 22 DMX" Channels="22">
    <Import PearlRef="VS_VScnP2HM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="430" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="14a3dbe4-2356-44d7-9241-32b9e306ec1d" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="15" Wheel="38" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="12" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="13" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="17" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="18" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
      <Attribute ID="Reserved" ChannelOffset="8" Wheel="58" />
      <Attribute ID="Reserved1" ChannelOffset="10" Wheel="59" />
      <Attribute ID="Reserved2" ChannelOffset="11" Wheel="60" />
      <Attribute ID="Reserved3" ChannelOffset="16" Wheel="88" />

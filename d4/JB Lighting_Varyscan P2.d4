<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Varyscan P2" ShortName="Vary ScnP2" Company="JB Lighting">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>7d0ccb26-70c3-4513-a947-220da5bc31ac</Thumbnail>
  <History Date="15-12-06" Author="D.Milligan" Comment="Created" />
  <History Date="15-12-06" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="18-09-18" Author="Nic Morris" Comment="Changed name from VaryscanP2 to Varyscan P2.  Added channel counts to mode names." />
  <History Date="18-09-18" Author="Nic Morris" Comment="Added product thumbnail.  Standardised conditionals.  Added function index.  Increased wheel resolution." />
  <History Date="18-09-18" Author="Nic Morris" Comment="Added highlight/lowlight.  Added palettes.  Changed split colours from variable to fixed ranges and revised DMX ranges." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6f265b8f-b61c-4315-a07b-d7df21b1d20f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="232~239" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="240~247" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="112~125" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="128~142" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~158" Intensity="0~0" />
      <Function ID="6" Name="O Fade" Display="'O Fade %.f%%',0~100" Dmx="160~174" Intensity="0~0" />
      <Function ID="7" Name="C Fade" Display="'C Fade %.f%%',100~0" Dmx="176~190" Intensity="0~0" />
      <Function ID="8" Name="O Random" Display="'O Random %.f%%',0~100" Dmx="192~206" Intensity="0~0" />
      <Function ID="9" Name="C Random" Display="'C Random %.f%%',100~0" Dmx="208~222" Intensity="0~0" />
      <Function ID="10" Name="Rnd Fade" Display="'Rnd Fade %.f%%',0~100" Dmx="224~238" Intensity="0~0" />
      <Function ID="11" Name="Rnd Fade" Display="'Rnd Fade %.f%%',100~0" Dmx="240~254" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="7,8,9,10,11,12" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~31" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="32~47" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~63" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="80~127" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="135~128" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="143~136" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="151~144" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="159~152" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="175~160" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="191~176" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="223~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',100~0" Dmx="192~222" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="223~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="225~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~11" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~19" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="24~27" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~35" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~43" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~51" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="56~59" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="12~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="20~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="28~31" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="36~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="44~47" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Cy" Display="'Blu/ Cy'" Dmx="52~55" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Cy/ Op" Display="'Cy/ Op'" Dmx="60~63" WheelPosition="7" Colour="0,255,255" />
      <Function ID="17" Name="Index" Display="'%.f%%',0~100" Dmx="64~191" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~222" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Macro" Display="'Macro'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour2Func'==1" />
      <Condition Name="Macro" ID="7,8" If="'Colour2Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTB" Display="'CTB'" Dmx="16~31" Colour="230,230,255" />
      <Function ID="3" Name="CTO" Display="'CTO'" Dmx="32~47" Colour="255,240,200" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="48~63" Colour="255,150,150" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="64~79" Colour="0,255,255" />
      <Function ID="6" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="80~127" Colour="220,240,255" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Macro " Display="'Macro %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="192~222" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="223~224" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Reserved4" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="EffectSpeed" Name="Effect Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Move_in_Dark" Name="Move in Dark" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="BO w P/T" Display="'BO w P/T'" Dmx="96~127" />
      <Function ID="3" Name="BO w G/C/P" Display="'BO w G/C/P'" Dmx="128~159" />
      <Function ID="4" Name="BO w G/C/P/F" Display="'BO w G/C/P/F'" Dmx="160~191" />
      <Function ID="5" Name="BO G/C/P/P/T" Display="'BO G/C/P/P/T'" Dmx="192~223" />
      <Function ID="6" Name="BO G/C/P/F/P/T" Display="'BO G/C/P/F/P/T'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="JB Mode, 22 DMX" Channels="22">
    <Import PearlRef="VS_VScnP2JM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="430" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="370f39d1-c6d4-4335-ad00-62634c2aa0e4" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="15" Wheel="38" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="12" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="13" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="17" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="18" Wheel="24" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f20a0788-24a0-478b-a454-89419dd91aac" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Break" Display="'Break %.f%%',0~100" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~21" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="30~37" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="46~53" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="62~69" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="78~85" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="94~101" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="110~117" WheelPosition="7" Colour="255,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="6~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="22~29" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Org/ Yel" Display="'Org/ Yel'" Dmx="38~45" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="54~61" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Cy" Display="'Grn/ Cy'" Dmx="70~77" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Cy/ Blu" Display="'Cy/ Blu'" Dmx="86~93" WheelPosition="5" Colour="0,255,255" />
      <Function ID="15" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="102~109" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="118~125" WheelPosition="7" Colour="255,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="126~128" Colour="255,255,255" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour2Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Amber" Display="'Amber'" Dmx="14~21" WheelPosition="1" Colour="255,100,0" />
      <Function ID="3" Name="Yellow Warm" Display="'Yellow Warm'" Dmx="30~37" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Lavender" Display="'Lavender'" Dmx="46~53" WheelPosition="3" Colour="255,128,255" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="62~69" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Turquoise" Display="'Turquoise'" Dmx="78~85" WheelPosition="5" Colour="0,255,128" />
      <Function ID="7" Name="Warm White" Display="'Warm White'" Dmx="94~101" WheelPosition="6" Colour="255,240,200" />
      <Function ID="8" Name="Cold White" Display="'Cold White'" Dmx="110~117" WheelPosition="7" Colour="230,230,255" />
      <Function ID="9" Name="Op/ Amb" Display="'Op/ Amb'" Dmx="6~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Amb/ Yel W" Display="'Amb/ Yel W'" Dmx="22~29" WheelPosition="1" Colour="255,100,0" />
      <Function ID="11" Name="Yel W/ Lav" Display="'Yel W/ Lav'" Dmx="38~45" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Lav/ Lime" Display="'Lav/ Lime'" Dmx="54~61" WheelPosition="3" Colour="255,128,255" />
      <Function ID="13" Name="Lime/ Tq" Display="'Lime/ Tq'" Dmx="70~77" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Tq/ WW" Display="'Tq/ WW'" Dmx="86~93" WheelPosition="5" Colour="0,255,128" />
      <Function ID="15" Name="WW/ CW" Display="'WW/ CW'" Dmx="102~109" WheelPosition="6" Colour="255,240,200" />
      <Function ID="16" Name="CW/ Op" Display="'CW/ Op'" Dmx="118~125" WheelPosition="7" Colour="230,230,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="126~128" Colour="255,255,255" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />

  <History Date="05-06-14" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="ILD show" Display="'ILD show'" Dmx="1~40" />
      <Function ID="3" Name="LIST show" Display="'LIST show'" Dmx="41~80" />
      <Function ID="4" Name="ILD sound" Display="'ILD sound'" Dmx="81~100" />
      <Function ID="5" Name="LIST sound" Display="'LIST sound'" Dmx="101~120" />
      <Function ID="6" Name="AUTO show" Display="'AUTO show'" Dmx="121~160" />
      <Function ID="7" Name="MUSIC show" Display="'MUSIC show'" Dmx="161~200" />
      <Function ID="8" Name="DMX mode" Display="'DMX mode'" Dmx="201~240" />
      <Function ID="9" Name="DMX sound" Display="'DMX sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sensitivity" Display="'Sensitivity %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern Out 1" Display="'Pattern Out 1'" Dmx="1~49" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pattern Out Fold 1" Display="'Pattern Out Fold 1'" Dmx="50~99" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Pattern Out 2" Display="'Pattern Out 2'" Dmx="100~149" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Pattern Out Fold 2" Display="'Pattern Out Fold 2'" Dmx="150~199" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Pattern Out Reentrant" Display="'Pattern Out Reentrant'" Dmx="200~255" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~128" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~63" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Morph" Display="'Morph %.1f%%',0.0~100.0" Dmx="64~159" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Shrinking" Display="'Shrinking %.1f%%',0.0~100.0" Dmx="160~191" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Enlarging" Display="'Enlarging %.1f%%',0.0~100.0" Dmx="192~223" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Animate" Display="'Animate %.1f%%',0.0~100.0" Dmx="224~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Morph" Display="'Morph %.f%%',0~100" Dmx="64~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="192~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="224~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Morph" Display="'Morph %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Morph" Display="'Morph %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Pan_Move" Name="Pan Move" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pan" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Morph" Display="'Morph %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Tilt_Move" Name="Tilt Move" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Tilt" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Morph" Display="'Morph %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Redraw" Name="Redraw" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~23" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="24~31" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="32~39" Colour="0,0,255" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="40~47" Colour="255,150,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="48~55" Colour="0,255,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Cell" Channels="11" Hidden="True">

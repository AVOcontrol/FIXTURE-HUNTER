<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Blinder 400" ShortName="Blinder400" Company="Vello">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-09-17" Author="Nic Morris" Comment="Created (usual rubbish documetation - 12 channel mode makes no sense - 2x RGBW in a 2x2 cell warm white fixture)" />
  <History Date="09-09-17" Author="Nic Morris" Comment="Removed 12 DMX mode. Added Atlabase ID's." />
  <History Date="11-11-17" Author="Nic Morris" Comment="Created from Rico 4x100W LED Blinder Light WW (RK-BL004)" />
  <History Date="15-11-17" Author="Nic Morris" Comment="Revised Atlabase ID's to Vello version (probably identical)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e2ad2e93-acbf-471f-8f76-d0faa2b57041" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="LED 1 Intensity" Display="'LED 1 Intensity'" Dmx="10~19" />
      <Function ID="3" Name="LED 2 Intensity" Display="'LED 2 Intensity'" Dmx="20~29" />
      <Function ID="4" Name="LED 3 Intensity" Display="'LED 3 Intensity'" Dmx="30~39" />
      <Function ID="5" Name="LED 4 Intensity" Display="'LED 4 Intensity'" Dmx="40~49" />
      <Function ID="6" Name="LED 1+2 Intensity" Display="'LED 1+2 Intensity'" Dmx="50~59" />
      <Function ID="7" Name="LED 2+3 Intensity" Display="'LED 2+3 Intensity'" Dmx="60~69" />
      <Function ID="8" Name="LED 3+4 Intensity" Display="'LED 3+4 Intensity'" Dmx="70~79" />
      <Function ID="9" Name="LED 1+4 Intensity" Display="'LED 1+4 Intensity'" Dmx="80~89" />
      <Function ID="10" Name="LED 2+3+4 Intensity" Display="'LED 2+3+4 Intensity'" Dmx="90~99" />
      <Function ID="11" Name="LED 1+3+4 Intensity" Display="'LED 1+3+4 Intensity'" Dmx="100~109" />
      <Function ID="12" Name="LED 1+2+4 Intensity" Display="'LED 1+2+4 Intensity'" Dmx="110~119" />
      <Function ID="13" Name="LED 1+2+3 Intensity" Display="'LED 1+2+3 Intensity'" Dmx="120~129" />
      <Function ID="14" Name="LED 1+2+3+4 Intensity" Display="'LED 1+2+3+4 Intensity'" Dmx="130~139" />
      <Function ID="15" Name="LED 2+3+4 Intensity" Display="'LED 2+3+4 Intensity'" Dmx="140~149" />
      <Function ID="16" Name="LED 1+3+4 Intensity" Display="'LED 1+3+4 Intensity'" Dmx="150~159" />
      <Function ID="17" Name="LED 1+2+4 Intensity" Display="'LED 1+2+4 Intensity'" Dmx="160~169" />
      <Function ID="18" Name="LED 2+3+4 Intensity" Display="'LED 2+3+4 Intensity'" Dmx="170~179" />
      <Function ID="19" Name="LED 1+3 Full, LED 2+4 50%" Display="'LED 1+3 Full, LED 2+4 50%'" Dmx="180~189" />
      <Function ID="20" Name="LED 2+4 Full, LED 1+3 50%" Display="'LED 2+4 Full, LED 1+3 50%'" Dmx="190~199" />
      <Function ID="21" Name="LED 1+3+4 Full, LED 2 50%" Display="'LED 1+3+4 Full, LED 2 50%'" Dmx="200~209" />
      <Function ID="22" Name="LED 1+2 Full, LED 3+4 50%" Display="'LED 1+2 Full, LED 3+4 50%'" Dmx="210~219" />
      <Function ID="23" Name="LED 2+4 Full, LED 1+3 50%" Display="'LED 2+4 Full, LED 1+3 50%'" Dmx="220~229" />
      <Function ID="24" Name="Auto" Display="'Auto'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="A.001, 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="78810ba7-e58f-4d7e-a140-d151d03ee4b0" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Dimmer cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Dimmer cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Dimmer cell" X="0" Y="1">

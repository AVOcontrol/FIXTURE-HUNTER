      <Function ID="23" Name="Macro 15" Display="'Macro 15'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="24" Name="Macro 16" Display="'Macro 16'" Dmx="230~239" Colour="0,0,0" />
      <Function ID="25" Name="Sound Activated" Display="'Sound Activated'" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

  <History Date="19-03-10" Author="John Rogers" Comment="Created" />
  <History Date="17-09-11" Author="Nic Morris" Comment="Removed RGB 1 2 and 3 4 and standardised.  Increased wheel resolution." />
  <History Date="17-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added v-dim.  Added pixel mapper compatibility." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Program" Name="Program Select" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~9" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="0,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Colour="0,0,0" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="40~49" Colour="0,0,0" />
      <Function ID="6" Name="Dark Blue" Display="'Deep Blue'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Colour="0,0,0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="9" Name="Macro 1" Display="'Macro 1'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="10" Name="Macro 2" Display="'Macro 2'" Dmx="90~99" Colour="0,0,0" />
      <Function ID="11" Name="Macro 3" Display="'Macro 3'" Dmx="100~109" Colour="0,0,0" />
      <Function ID="12" Name="Macro 4" Display="'Macro 4'" Dmx="110~119" Colour="0,0,0" />
      <Function ID="13" Name="Macro 5" Display="'Macro 5'" Dmx="120~129" Colour="0,0,0" />
      <Function ID="14" Name="Macro 6" Display="'Macro 6'" Dmx="130~139" Colour="0,0,0" />
      <Function ID="15" Name="Macro 7" Display="'Macro 7'" Dmx="140~149" Colour="0,0,0" />
      <Function ID="16" Name="Macro 8" Display="'Macro 8'" Dmx="150~159" Colour="0,0,0" />
      <Function ID="17" Name="Macro 9" Display="'Macro 9'" Dmx="160~169" Colour="0,0,0" />
      <Function ID="18" Name="Macro 10" Display="'Macro 10'" Dmx="170~179" Colour="0,0,0" />
      <Function ID="19" Name="Macro 11" Display="'Macro 11'" Dmx="180~189" Colour="0,0,0" />

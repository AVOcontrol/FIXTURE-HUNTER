    <AtlaBase ModeID="8c529c80-cce8-4576-857a-4785d3b7fffc" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="2 DMX m2" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

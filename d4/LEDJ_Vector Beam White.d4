  <AtlaBase TypeID="7a6f6b93-09ae-44f2-b5c5-48f23f1493b3" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'Tilt %.1f%%',0.0~100.0" Dmx="0~180" />
      <Function ID="2" Name="Static 180°" Display="'Static 180°'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="LED Macro" Display="'LED Macro'" Dmx="10~19" />
      <Function ID="3" Name="Show 1" Display="'Show 1'" Dmx="20~29" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="30~39" />
      <Function ID="5" Name="Show 3" Display="'Show 3'" Dmx="40~49" />
      <Function ID="6" Name="Show 4" Display="'Show 4'" Dmx="50~59" />
      <Function ID="7" Name="Show 5" Display="'Show 5'" Dmx="60~69" />
      <Function ID="8" Name="Show 6" Display="'Show 6'" Dmx="70~79" />
      <Function ID="9" Name="Show 7" Display="'Show 7'" Dmx="80~89" />
      <Function ID="10" Name="Show 8" Display="'Show 8'" Dmx="90~99" />
      <Function ID="11" Name="Show 9" Display="'Show 9'" Dmx="100~109" />
      <Function ID="12" Name="Show 10" Display="'Show 10'" Dmx="110~119" />
      <Function ID="13" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

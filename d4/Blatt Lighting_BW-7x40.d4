  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="3" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="150~159" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Aura_FX" Name="Aura FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="FX 1" Display="'FX 1'" Dmx="1~24" />
      <Function ID="3" Name="FX 2" Display="'FX 2'" Dmx="25~49" />
      <Function ID="4" Name="FX 3 Red" Display="'FX 3 Red'" Dmx="50~99" />
      <Function ID="5" Name="FX 4 Green" Display="'FX 4 Green'" Dmx="100~149" />
      <Function ID="6" Name="FX 5 Blue" Display="'FX 5 Blue'" Dmx="150~199" />
      <Function ID="7" Name="FX 6 RGB" Display="'FX 6 RGB'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour 1" Display="'Colour 1'" Dmx="0~0" Colour="0,0,0" />

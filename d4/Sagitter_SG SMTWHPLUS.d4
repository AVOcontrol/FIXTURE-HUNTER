    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~25" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="26~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~76" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="77~101" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="102~127" Colour="255,100,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="128~152" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="153~178" Colour="255,0,255" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="179~203" Colour="255,255,0" />
      <Function ID="10" Name="Warm White" Display="'Warm White'" Dmx="204~229" Colour="255,240,200" />
      <Function ID="11" Name="Full On" Display="'Full On'" Dmx="230~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Slow" Display="'Auto Slow %.f%%',0~100" Dmx="1~84" />
      <Function ID="3" Name="Auto Fast" Display="'Auto Fast %.f%%',0~100" Dmx="85~169" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="26~50" Colour="0,255,0" />

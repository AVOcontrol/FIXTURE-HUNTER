      <Function ID="4" Name="White" Display="'White'" Dmx="77~101" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="102~127" Colour="255,100,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="128~152" Colour="0,255,255" />

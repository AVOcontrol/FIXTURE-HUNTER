  <Mode Name="Extended" Channels="33">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ea341162-387c-40c6-b4a6-aafe92678088" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
        <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="Pan_Spin" ChannelOffset="6" Wheel="19" />
        <Attribute ID="Tilt_Spin" ChannelOffset="7" Wheel="20" />
        <Attribute ID="All_Ring_Red" Wheel="41" />
        <Attribute ID="All_Ring_Green" Wheel="42" />
        <Attribute ID="All_Ring_Blue" Wheel="70" />
        <Attribute ID="White" ChannelOffset="11" Wheel="40" />
        <Attribute ID="Shutter" ChannelOffset="12" Wheel="5" />
        <Attribute ID="Dimmer" ChannelOffset="13" Wheel="1" />
        <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="9" />
        <Attribute ID="Colour1" ChannelOffset="15" Wheel="8" />
        <Attribute ID="Col_Preset_Dim" ChannelOffset="16" Wheel="34" />
        <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
        <Attribute ID="Ring_Shutter" ChannelOffset="30" Wheel="6" />
        <Attribute ID="Dimmer1" ChannelOffset="31" Wheel="35" />
        <Attribute ID="Effect" ChannelOffset="32" Wheel="22" />
        <Attribute ID="Effect_Spd" ChannelOffset="33" Wheel="23" />
        <Attribute ID="Ring_Master" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Ring 1" ChannelOffset="18" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="All_Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="All_Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="All_Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="Ring_Master" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Ring 2" ChannelOffset="21" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="All_Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="All_Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="All_Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="Ring_Master" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Ring 3" ChannelOffset="24" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="All_Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="All_Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="All_Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="Ring_Master" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Ring 4" ChannelOffset="27" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="All_Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="All_Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="All_Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="Ring_Master" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />

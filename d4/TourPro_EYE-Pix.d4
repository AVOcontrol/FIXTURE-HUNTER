<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EYE-Pix" ShortName="EYE-Pix" Company="TourPro">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="17-03-16" Author="Nic Morris" Comment="Created" />
  <History Date="06-06-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added physical pan/tilt ranges." />
  <History Date="07-06-19" Author="Nic Morris" Comment="Changed Extended mode implementation so that the RGBW masters are main RGBW and the ring controls are linked to separate master controls adding vdim." />
  <History Date="07-06-19" Author="Nic Morris" Comment="Renamed 'Strobe' control to 'Ring Shutter'." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c2213f31-d763-4435-8c86-df03dde259f4" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="0~231" Colour="255,255,255" />
      <Function ID="2" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="232~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="5~9" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="10~14" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="15~19" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="20~24" Colour="255,255,255" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="25~29" Colour="255,255,255" />
      <Function ID="7" Name="8000K" Display="'8000K'" Dmx="30~34" Colour="255,255,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="35~39" Colour="255,255,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="40~44" Colour="255,0,255" />
      <Function ID="10" Name="Cyan" Display="'Cyan'" Dmx="45~49" Colour="0,255,255" />
      <Function ID="11" Name="Salmon" Display="'Salmon'" Dmx="50~54" Colour="255,150,150" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="55~59" Colour="0,255,128" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="60~64" Colour="128,255,0" />
      <Function ID="14" Name="Steel Blue" Display="'Steel Blue'" Dmx="65~69" Colour="220,240,255" />
      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="70~74" Colour="255,128,0" />
      <Function ID="16" Name="Straw" Display="'Straw'" Dmx="75~79" Colour="255,250,230" />
      <Function ID="17" Name="Pale Lavender" Display="'Pale Lavender'" Dmx="80~84" Colour="255,128,255" />
      <Function ID="18" Name="Pink" Display="'Pink'" Dmx="85~89" Colour="255,150,150" />
      <Function ID="19" Name="Red" Display="'Red'" Dmx="90~94" Colour="255,0,0" />
      <Function ID="20" Name="Green" Display="'Green'" Dmx="95~99" Colour="0,255,0" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="100~104" Colour="0,0,255" />
      <Function ID="22" Name="White" Display="'White'" Dmx="105~109" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Preset_Dim" Name="Col Preset Dim" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~84" />
    </Attribute>
    <Attribute ID="Ring_Shutter" Name="Ring Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="32~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer 2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~38" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="39~69" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="70~100" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="101~131" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="132~162" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="163~193" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="194~224" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="All_Ring_Red" Name="All Ring Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="All_Ring_Green" Name="All Ring Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="All_Ring_Blue" Name="All Ring Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Ring_Master" Name="Ring Master" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="17">

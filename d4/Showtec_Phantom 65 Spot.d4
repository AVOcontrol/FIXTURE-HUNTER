<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Phantom 65 Spot" ShortName="Phtm 65 Sp" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>5e5f8456-a6e7-4bdc-8840-09a36138f8db</Thumbnail>
  <History Date="19-06-17" Author="Nic Morris" Comment="Created" />
  <History Date="21-06-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="13-03-18" Author="Nic Morris" Comment="Revised colour, gobo and control functions in line with latest charts in response to customer bug report." />
  <History Date="13-03-18" Author="Nic Morris" Comment="Added colour palettes.  Added highlight/lowlight.  Added product thumbnail.  Added gobo swatches." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a9191a4c-e275-4153-9fb6-8c2e6cffd138" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~250" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="132~167" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="168~203" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="204~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~13" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="14~20" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~27" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="28~34" WheelPosition="4" Colour="0,128,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="35~41" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="42~48" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Light Green" Display="'Light Green'" Dmx="49~55" WheelPosition="7" Colour="128,255,0" />
      <Function ID="9" Name="UV" Display="'UV'" Dmx="56~64" WheelPosition="8" Colour="180,0,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="65~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="72~78" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="79~85" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ L Blu" Display="'Grn/ L Blu'" Dmx="86~92" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="L Blu/ Org" Display="'L Blu/ Org'" Dmx="93~99" WheelPosition="4" Colour="0,128,255" />
      <Function ID="15" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="100~106" WheelPosition="5" Colour="255,128,0" />
      <Function ID="16" Name="Pk/ L Grn" Display="'Pk/ L Grn'" Dmx="107~113" WheelPosition="6" Colour="255,150,150" />
      <Function ID="17" Name="L Grn/ UV" Display="'L Grn/ UV'" Dmx="114~120" WheelPosition="7" Colour="128,255,0" />
      <Function ID="18" Name="UV/ Op" Display="'UV/ Op'" Dmx="121~127" WheelPosition="8" Colour="180,0,255" />
      <Function ID="19" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~64" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>af118682-c55e-469b-968b-2d5192bd55e3</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1">
        <Swatch>b488abb9-512d-46b6-aafe-9022e29f215a</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2">
        <Swatch>b3e03886-e3d5-4806-9ccf-df5c15864083</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3">
        <Swatch>7a16d95f-daf2-4eaf-9f02-aad6eccd4b31</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4">
        <Swatch>4256f309-41cc-4ebf-bd60-75cf61d9d3e6</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5">
        <Swatch>25fe239b-6762-40ae-87dd-9a1b2071bc07</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6">
        <Swatch>a05141bd-f528-4f17-a7b4-6657264e1378</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7">
        <Swatch>20be545e-cb20-484c-9143-68fab963c552</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>af118682-c55e-469b-968b-2d5192bd55e3</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="1">
        <Swatch>b488abb9-512d-46b6-aafe-9022e29f215a</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="2">
        <Swatch>b3e03886-e3d5-4806-9ccf-df5c15864083</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="3">
        <Swatch>7a16d95f-daf2-4eaf-9f02-aad6eccd4b31</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4">
        <Swatch>4256f309-41cc-4ebf-bd60-75cf61d9d3e6</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="5">
        <Swatch>25fe239b-6762-40ae-87dd-9a1b2071bc07</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="6">
        <Swatch>a05141bd-f528-4f17-a7b4-6657264e1378</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="7">
        <Swatch>20be545e-cb20-484c-9143-68fab963c552</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="119~8" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="120~231" />
      <Function ID="5" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="8~27" />
      <Function ID="3" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="28~47" />
      <Function ID="4" Name="P/T/G in Dark" Display="'P/T/G in Dark'" Dmx="48~67" />
      <Function ID="5" Name="Col in Dark" Display="'Col in Dark'" Dmx="68~107" />
      <Function ID="6" Name="C/G in Dark" Display="'C/G in Dark'" Dmx="108~127" />
      <Function ID="7" Name="All in Dark" Display="'All in Dark'" Dmx="128~147" />
      <Function ID="8" Name="Reset Pan" Display="'Reset Pan'" Dmx="148~157" />
      <Function ID="9" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="158~167" />
      <Function ID="10" Name="Reset Col" Display="'Reset Col'" Dmx="168~177" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="178~187" />
      <Function ID="12" Name="Reset Prism" Display="'Reset Prism'" Dmx="188~197" />
      <Function ID="13" Name="Reset All" Display="'Reset All'" Dmx="198~207" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~23" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="24~39" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="40~55" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="56~71" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="72~87" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="88~103" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="104~119" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="120~135" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="136~151" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="152~167" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="168~183" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="184~199" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="200~215" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="216~231" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="232~247" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="SHPH65S1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a3924327-4e03-46ac-91e3-0e7166651195" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="7" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SHPH65S2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8bc3517f-0f6b-44f0-b7b3-2efac23b2a2b" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="10" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
      <Attribute ID="Auto" ChannelOffset="13" Wheel="23" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Col">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Prism">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:13" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Light Green" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="10" Name="Light Blue" Number="7" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="11" Name="UV" Number="9" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="12" Name="UV" Number="10" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="UV" Number="8" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="15" Name="UV" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PAN2x1x30" ShortName="PAN2x1x30" Company="Event Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="13-10-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-06-16" Author="Nic Morris" Comment="Created from HMF Pixel Matrix" />
  <History Date="05-06-16" Author="Nic Morris" Comment="Created from Event Lighting PAN4x4x30" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green" Display="'Red/Green %.f%%',0~100" Dmx="20~39" Colour="255,0,0" />
      <Function ID="3" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="40~59" Colour="255,255,0" />
      <Function ID="4" Name="Green/Blue" Display="'Green/Blue %.f%%',0~100" Dmx="60~79" Colour="0,255,0" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green %.f%%',0~100" Dmx="80~99" Colour="0,255,255" />
      <Function ID="6" Name="Blue/Red" Display="'Blue/Red %.f%%',0~100" Dmx="100~119" Colour="0,0,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue %.f%%',0~100" Dmx="120~139" Colour="255,0,255" />
      <Function ID="8" Name="Red/GB" Display="'Red/GB %.f%%',0~100" Dmx="140~159" Colour="255,0,0" />
      <Function ID="9" Name="Blue/RG" Display="'Blue/RG %.f%%',0~100" Dmx="160~179" Colour="0,0,255" />
      <Function ID="10" Name="RGB" Display="'RGB'" Dmx="180~199" Colour="255,255,255" />
      <Function ID="11" Name="White 1" Display="'White 1'" Dmx="200~204" Colour="255,255,255" />
      <Function ID="12" Name="White 2" Display="'White 2'" Dmx="205~209" Colour="255,255,255" />
      <Function ID="13" Name="White 3" Display="'White 3'" Dmx="210~214" Colour="255,255,255" />
      <Function ID="14" Name="White 4" Display="'White 4'" Dmx="215~219" Colour="255,255,255" />
      <Function ID="15" Name="White 5" Display="'White 5'" Dmx="220~224" Colour="255,255,255" />
      <Function ID="16" Name="White 6" Display="'White 6'" Dmx="225~229" Colour="255,255,255" />
      <Function ID="17" Name="White 7" Display="'White 7'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="18" Name="White 8" Display="'White 8'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="19" Name="White 9" Display="'White 9'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="20" Name="White 10" Display="'White 10'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="21" Name="White 11" Display="'White 11'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~255.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Dim 1" Display="'Dim 1'" Dmx="10~48" />
      <Function ID="3" Name="Dim 2" Display="'Dim 2'" Dmx="49~88" />
      <Function ID="4" Name="Dim 3" Display="'Dim 3'" Dmx="89~128" />
      <Function ID="5" Name="Dim 4" Display="'Dim 4'" Dmx="129~168" />
      <Function ID="6" Name="White Mode On" Display="'White Mode On'" Dmx="169~208" />
      <Function ID="7" Name="White Mode Off" Display="'White Mode Off'" Dmx="209~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />

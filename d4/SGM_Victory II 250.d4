  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0a778e1e-462a-40be-8d63-fed4c7a8189e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="20~29" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Magenta" Display="'Magenta'" Dmx="40~49" WheelPosition="2" Colour="255,0,255" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="60~69" WheelPosition="3" Colour="0,255,255" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="80~89" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="100~109" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="120~129" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="140~149" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op/ Yel" Display="'Op/ Yel'" Dmx="10~19" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="30~39" WheelPosition="1" Colour="255,255,0" />
      <Function ID="11" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="50~59" WheelPosition="2" Colour="255,0,255" />
      <Function ID="12" Name="Cy/ Org" Display="'Cy/ Org'" Dmx="70~79" WheelPosition="3" Colour="0,255,255" />
      <Function ID="13" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="90~99" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="110~119" WheelPosition="5" Colour="0,255,0" />
      <Function ID="15" Name="Blu/ Rd" Display="'Blu/ Rd'" Dmx="130~139" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Rd/ Op" Display="'Rd/ Op'" Dmx="150~159" WheelPosition="7" Colour="255,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="160~244" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="245~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>c99cc227-b9f6-4697-866b-f15e8fc31cbc</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="20~39">
        <Swatch>a93efbc1-7d2c-4a8b-998c-666e446ca002</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="40~59">
        <Swatch>77a2cbcb-ce3f-43f8-bee9-7c63738c0d24</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="60~79">
        <Swatch>cd2960f1-b710-4db6-b268-756734830c4a</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="80~99">
        <Swatch>c3046d51-e364-4b50-b998-dc7e7cbb2e73</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="100~119">
        <Swatch>5cdd2138-fc4b-4045-88fe-2b07569fa934</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="120~139">
        <Swatch>28c41ad3-24a8-4715-afdf-ddbbfb4156ea</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="140~159">
        <Swatch>8512fa97-a4dc-4ebc-a428-a87256d13d82</Swatch>
      </Function>
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="160~229" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="230~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~149" />
      <Function ID="4" Name="Shutter Sync Sound Low Freq" Display="'Shutter Sync Sound Low Freq'" Dmx="150~159" />
      <Function ID="5" Name="Flash Sync Sound Low Freq" Display="'Flash Sync Sound Low Freq'" Dmx="160~172" />
      <Function ID="6" Name="Flash Sync Sound High Freq" Display="'Flash Sync Sound High Freq'" Dmx="173~185" />
      <Function ID="7" Name="Open+Auto Shade Gobos" Display="'Open+Auto Shade Gobos'" Dmx="186~198" />
      <Function ID="8" Name="Open+Auto Shade Colours" Display="'Open+Auto Shade Colours'" Dmx="199~211" />
      <Function ID="9" Name="Open+Auto Shade Gobo+Col" Display="'Open+Auto Shade Gobo+Col'" Dmx="212~224" />
      <Function ID="10" Name="Open+Low Speed Gobo Change" Display="'Open+Low Speed Gobo Change'" Dmx="225~237" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="113~142" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~112" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="113~142" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="143~255" />
    </Attribute>
    <Attribute ID="Palette" Name="Palette" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Conversion" Display="'Col Conversion'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="Frost" Display="'Frost'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="Col Conversion+Frost" Display="'Col Conversion+Frost'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="50~79" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="80~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Histeresis" Display="'Lamp Histeresis'" Dmx="50~234" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="235~255" />
    </Attribute>
  </Control>

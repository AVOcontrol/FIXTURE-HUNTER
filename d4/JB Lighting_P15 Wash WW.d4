    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~5" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="8~9" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="12~13" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="16~17" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="20~21" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="24~25" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="HCRI" Display="'HCRI'" Dmx="28~29" WheelPosition="7" Colour="255,255,255" />
      <Function ID="9" Name="CTB" Display="'CTB'" Dmx="32~33" WheelPosition="8" Colour="200,200,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="2~3" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="6~7" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="10~11" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="14~15" WheelPosition="3" Colour="255,0,255" />
      <Function ID="14" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="18~19" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Org/ D Bl" Display="'Org/ D Bl'" Dmx="22~23" WheelPosition="5" Colour="255,100,0" />
      <Function ID="16" Name="D Bl/ HCRI" Display="'D Bl/ HCRI'" Dmx="26~27" WheelPosition="6" Colour="0,0,180" />

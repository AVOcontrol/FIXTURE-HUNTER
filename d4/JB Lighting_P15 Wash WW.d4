      <Function ID="19" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~223" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

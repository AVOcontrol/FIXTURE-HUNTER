  <History Date="30-03-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="05-10-18" Author="Nic Morris" Comment="updated in line with v1.2 charts (revised beam shaper functions)" Version="2" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="3" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="21075" ModelID="251" />
  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="20~24" />
      <Function ID="5" Name="Display Off" Display="'Display Off'" Dmx="25~29" />
      <Function ID="6" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="40~44" />
      <Function ID="7" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="45~49" />
      <Function ID="8" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="50~54" />
      <Function ID="9" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="55~59" />
      <Function ID="10" Name="Dim Square" Display="'Dim Square'" Dmx="60~64" />
      <Function ID="11" Name="Dim Linear" Display="'Dim Linear'" Dmx="65~69" />
      <Function ID="12" Name="Fan Auto" Display="'Fan Auto'" Dmx="70~74" />
      <Function ID="13" Name="Fan High" Display="'Fan High'" Dmx="75~79" />
      <Function ID="14" Name="Parking Position On" Display="'Parking Position On'" Dmx="120~124" />
      <Function ID="15" Name="Parking Position Off" Display="'Parking Position Off'" Dmx="125~129" />
      <Function ID="16" Name="Reset no P/T" Display="'Reset no P/T'" Dmx="130~139" />
      <Function ID="17" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="18" Name="Reset Zoom/Bm Shaper" Display="'Reset Zoom/Bm Shaper'" Dmx="150~159" />
      <Function ID="19" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="159~144" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Shaper" Name="Beam Shaper" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 12 DMX" Channels="12" Id="f97cb7d5-2b14-437a-88b5-f5eaf4c4c689">
    <Import PearlRef="RORTRCW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="220" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <RDM>
      <Version SoftwareID="-1" PersonalityID="1" />
    </RDM>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Zoom" ChannelOffset="7,8" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="11,12" Wheel="1" />
      <Attribute ID="Beam_Shaper" ChannelOffset="9" Wheel="20" />
    </Include>
  </Mode>
  <Macro>

  <History Date="06-05-22" Author="Nic Morris" Comment="Created (documentation also appears to contain charts for a spot fixture.  assumed these are an error and ignored)" Version="0" />
  <History Date="10-05-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0aea4710-9758-47a4-aaf1-0a845ffb05d0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~99" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~249" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="100~199" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~19" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="20~29" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="30~39" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="40~49" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="60~69" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="90~99" Colour="0,0,0" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="100~109" Colour="0,0,0" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="110~119" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="120~129" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="130~139" Colour="0,0,0" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="140~149" Colour="0,0,0" />
      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="150~159" Colour="0,0,0" />
      <Function ID="17" Name="Colour 16" Display="'Colour 16'" Dmx="160~169" Colour="0,0,0" />
      <Function ID="18" Name="Colour 17" Display="'Colour 17'" Dmx="170~179" Colour="0,0,0" />
      <Function ID="19" Name="Colour 18" Display="'Colour 18'" Dmx="180~189" Colour="0,0,0" />
      <Function ID="20" Name="Colour 19" Display="'Colour 19'" Dmx="190~199" Colour="0,0,0" />
      <Function ID="21" Name="Colour 20" Display="'Colour 20'" Dmx="200~209" Colour="0,0,0" />
      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="210~219" Colour="0,0,0" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="24" Name="Colour 23" Display="'Colour 23'" Dmx="230~239" Colour="0,0,0" />
      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="240~249" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Cyan_Func" Name="Cyan Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Enable Cyan C-Mix" Display="'Enable Cyan C-Mix'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~127" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="128~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Magenta_Func" Name="Magenta Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Enable Magenta C-Mix" Display="'Enable Magenta C-Mix'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="10~127" Colour="255,128,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="128~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Yellow_Func" Name="Yellow Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Enable Yellow C-Mix" Display="'Enable Yellow C-Mix'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="10~127" Colour="255,240,200" />
      <Function ID="3" Name="CTB" Display="'CTB'" Dmx="128~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="121~160" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="161~200" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="201~240" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="241~255" />
    </Attribute>
  </Control>

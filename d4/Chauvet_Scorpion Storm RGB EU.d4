      <Function ID="5" Name="G Sound" Display="'G Sound'" Dmx="255~255" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~4" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~5" Iris="0~0" Zoom="0~0" />

      <Function ID="22" Name="R+G+B Alt" Display="'R+G+B Alt'" Dmx="231~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Channel_5" Name="Channel 5" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Mode 1" ID="2,3,4,5" If="'Control'==4" />
      <Condition Name="Mode 2" ID="6,7,8" If="'Control'==5" />

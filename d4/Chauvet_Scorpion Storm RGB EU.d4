      <Function ID="3" Name="B On" Display="'B On'" Dmx="5~10" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="B Strobe" Display="'B Strobe %.1f%%',0.0~100.0" Dmx="11~254" Iris="0~0" Zoom="0~0" />

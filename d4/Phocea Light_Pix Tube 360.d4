    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Base Tint" Display="'Base Tint %.1f%%',0.0~100.0" Dmx="2~255" Colour="255,255,255" />

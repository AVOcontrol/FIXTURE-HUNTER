    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="11~214" />
      <Function ID="3" Name="All Effects" Display="'All Effects'" Dmx="215~220" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="221~255" />

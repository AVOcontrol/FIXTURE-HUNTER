      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Fade_Scroll" Name="Fade Scroll" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R+B" Display="'R+B'" Dmx="10~63" Colour="255,255,255" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="4" Name="G+B" Display="'G+B'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="5" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="192~239" Colour="255,255,255" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
  </Control>

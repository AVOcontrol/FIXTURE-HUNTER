<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Magic 1" ShortName="Magic 1" Company="BeamZ" Version="1">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>d0f3ed32-4dcc-46f1-b249-d9ec7cd85604</Thumbnail>
  <History Date="16-12-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="20-12-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b923ddfd-9807-4a82-b8d5-37d036253789" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Magic_Colour" Name="Magic Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red, Blue, CTO" Display="'Red, Blue, CTO'" Dmx="10~44" Colour="0,0,0" />
      <Function ID="3" Name="Red, White, CTO" Display="'Red, White, CTO'" Dmx="45~79" Colour="0,0,0" />
      <Function ID="4" Name="Blue, Green, Pink" Display="'Blue, Green, Pink'" Dmx="80~114" Colour="0,0,0" />
      <Function ID="5" Name="Red, Blue, White, CTO" Display="'Red, Blue, White, CTO'" Dmx="115~149" Colour="0,0,0" />
      <Function ID="6" Name="Green, Blue, White, CTO, Pink" Display="'Green, Blue, White, CTO, Pink'" Dmx="150~184" Colour="0,0,0" />
      <Function ID="7" Name="Red, Green, Blue, CTO, Pink" Display="'Red, Green, Blue, CTO, Pink'" Dmx="185~219" Colour="0,0,0" />
      <Function ID="8" Name="All On" Display="'All On'" Dmx="220~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All On" Display="'All On'" Dmx="0~0" />
      <Function ID="2" Name="UV" Display="'UV'" Dmx="37~73" />
      <Function ID="3" Name="White" Display="'White'" Dmx="74~110" />
      <Function ID="4" Name="Magic" Display="'Magic'" Dmx="111~147" />
      <Function ID="5" Name="UV+White" Display="'UV+White'" Dmx="148~184" />
      <Function ID="6" Name="UV+Magic" Display="'UV+Magic'" Dmx="185~221" />
      <Function ID="7" Name="White+Magic" Display="'White+Magic'" Dmx="222~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Magic_Rot" Name="Magic Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="255~10" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="51~200" />
      <Function ID="3" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8ca307c9-383e-4f89-bc50-53a5b5312144" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Magic_Colour" ChannelOffset="3" Wheel="7" />
        <Attribute ID="Master_Dimmer" ChannelOffset="4" Wheel="6" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
        <Attribute ID="Magic_Rot" ChannelOffset="6" Wheel="19" />
        <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="UV" ChannelOffset="1" ModeLink="Dim cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="White" ChannelOffset="2" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dim cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="d0f3ed32-4dcc-46f1-b249-d9ec7cd85604"></Swatch>
  </swatchLibrary>
</Fixture>
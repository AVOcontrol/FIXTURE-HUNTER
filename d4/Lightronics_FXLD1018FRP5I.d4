    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green (1)" Display="'Red/Green (1)'" Dmx="33~65" Colour="255,255,255" />
      <Function ID="3" Name="Red/Green (2)" Display="'Red/Green (2)'" Dmx="66~96" Colour="255,255,255" />
      <Function ID="4" Name="Green/Blue (1)" Display="'Green/Blue (1)'" Dmx="97~129" Colour="255,255,255" />
      <Function ID="5" Name="Green/Blue (2)" Display="'Green/Blue (2)'" Dmx="130~160" Colour="255,255,255" />
      <Function ID="6" Name="Red/Blue (1)" Display="'Red/Blue (1)'" Dmx="161~191" Colour="255,255,255" />
      <Function ID="7" Name="Red/Blue (2)" Display="'Red/Blue (2)'" Dmx="192~224" Colour="255,255,255" />
      <Function ID="8" Name="R/G/B/A/W" Display="'R/G/B/A/W'" Dmx="225~254" Colour="255,255,255" />
      <Function ID="9" Name="All On" Display="'All On'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="R+B" Display="'R+B'" Dmx="10~63" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="64~127" />
      <Function ID="4" Name="G+B" Display="'G+B'" Dmx="128~191" />
      <Function ID="5" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="192~255" />
    </Attribute>
  </Control>

  <History Date="22-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b859d641-d10b-48a2-a6d4-0fa1a3821513" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="10~19" Update="Effect_Spd" />
      <Function ID="3" Name="Pulse" Display="'Pulse'" Dmx="20~29" Update="Effect_Spd" />
      <Function ID="4" Name="Col Jump" Display="'Col Jump'" Dmx="30~39" Update="Effect_Spd" />
      <Function ID="5" Name="Gradient" Display="'Gradient'" Dmx="40~49" Update="Effect_Spd" />
      <Function ID="6" Name="Pulse Change" Display="'Pulse Change'" Dmx="50~59" Update="Effect_Spd" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="60~69" Update="Effect_Spd" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="70~79" Update="Effect_Spd" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="80~89" Update="Effect_Spd" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="90~99" Update="Effect_Spd" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="100~109" Update="Effect_Spd" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="110~119" Update="Effect_Spd" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="120~129" Update="Effect_Spd" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="130~139" Update="Effect_Spd" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="140~149" Update="Effect_Spd" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="150~159" Update="Effect_Spd" />
      <Function ID="17" Name="Auto 11" Display="'Auto 11'" Dmx="160~169" Update="Effect_Spd" />
      <Function ID="18" Name="Auto 12" Display="'Auto 12'" Dmx="170~179" Update="Effect_Spd" />
      <Function ID="19" Name="Auto 13" Display="'Auto 13'" Dmx="180~189" Update="Effect_Spd" />
      <Function ID="20" Name="Auto 14" Display="'Auto 14'" Dmx="190~199" Update="Effect_Spd" />
      <Function ID="21" Name="Auto 15" Display="'Auto 15'" Dmx="200~209" Update="Effect_Spd" />
      <Function ID="22" Name="Auto 16" Display="'Auto 16'" Dmx="210~229" Update="Effect_Spd" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="230~233" Update="Effect_Spd" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="234~237" Update="Effect_Spd" />
      <Function ID="25" Name="Sound 3" Display="'Sound 3'" Dmx="238~241" Update="Effect_Spd" />
      <Function ID="26" Name="Sound 4" Display="'Sound 4'" Dmx="242~245" Update="Effect_Spd" />
      <Function ID="27" Name="Sound 5" Display="'Sound 5'" Dmx="246~249" Update="Effect_Spd" />
      <Function ID="28" Name="Sound 6" Display="'Sound 6'" Dmx="250~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Col" ID="2" If="'Effect'==2" />
      <Condition Name="Sound" ID="3" If="'Effect'&gt;22" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Colour" Name="Effect Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~159" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="192~223" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

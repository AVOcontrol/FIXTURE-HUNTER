  <History Date="31-12-23" Author="Nic Morris" Comment="Corrected error with autofocus distance display range (previously was text only)" Version="2" />
  <History Date="12-03-26" Author="Nic Morris" Comment="Created from JB Lighting P9 BeamSpot" Version="3" />
  <History Date="20-03-26" Author="Nic Morris" Comment="Minor correction to CTC display range (was 20-130K instead of 2000-13000K)" Version="6" />
  <History Date="12-06-26" Author="Nic Morris" Comment="Revised mode 2 channel mapping.  The documentation contains a channel overview and a detailed version which are currently contradictory.  Previously it was based on the detailed version but the manufacturer has confirmed the overview version is correct)" Version="7" />

      <Function ID="7" Name="Pixel Rnd" Display="'Pixel Rnd %.f%%',0~100" Dmx="203~242" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

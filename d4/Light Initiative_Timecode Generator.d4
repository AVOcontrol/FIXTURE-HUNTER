    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="127~127" />
      <Function ID="3" Name="Playback" Display="'Playback'" Dmx="128~128" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="254~254" />
    </Attribute>
    <Attribute ID="Hours" Name="Hours" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hours +" Display="'Hours + %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Minutes" Name="Minutes" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Minutes +" Display="'Minutes + %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Seconds" Name="Seconds" Description="" Group="S">

  <Control>
    <Attribute ID="Show_ID" Name="Show ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Show ID 0" Display="'Show ID 0'" Dmx="0~15" />
      <Function ID="2" Name="Show ID 1" Display="'Show ID 1'" Dmx="16~30" />
      <Function ID="3" Name="Show ID 2" Display="'Show ID 2'" Dmx="31~45" />

      <Function ID="12" Name="Rose" Display="'Rose'" Dmx="110~114" WheelPosition="11" Colour="255,0,127" />
      <Function ID="13" Name="Fluorescent" Display="'Fluorescent'" Dmx="120~124" WheelPosition="12" Colour="255,255,255" />
      <Function ID="14" Name="Brown" Display="'Brown'" Dmx="130~134" WheelPosition="13" Colour="255,240,200" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="25~29" WheelPosition="2" Colour="255,255,0" />
      <Function ID="18" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="19" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="45~49" WheelPosition="4" Colour="0,255,0" />
      <Function ID="20" Name="Org/ Y Grn" Display="'Org/ Y Grn'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="21" Name="Y Grn/ Org" Display="'Y Grn/ Org'" Dmx="65~69" WheelPosition="6" Colour="180,180,0" />
      <Function ID="22" Name="Org/ L Blu" Display="'Org/ L Blu'" Dmx="75~79" WheelPosition="7" Colour="255,128,0" />
      <Function ID="23" Name="L Blu/ Fch" Display="'L Blu/ Fch'" Dmx="85~89" WheelPosition="8" Colour="0,128,255" />
      <Function ID="24" Name="Fch/ L O Ppl" Display="'Fch/ L O Ppl'" Dmx="95~99" WheelPosition="9" Colour="180,0,180" />
      <Function ID="25" Name="L O Ppl/ Rs" Display="'L O Ppl/ Rs'" Dmx="105~109" WheelPosition="10" Colour="128,0,255" />
      <Function ID="26" Name="Rs/ Fl" Display="'Rs/ Fl'" Dmx="115~119" WheelPosition="11" Colour="255,0,127" />
      <Function ID="27" Name="Fl/ Brn" Display="'Fl/ Brn'" Dmx="125~129" WheelPosition="12" Colour="255,255,255" />
      <Function ID="28" Name="Brn/ Op" Display="'Brn/ Op'" Dmx="135~139" WheelPosition="13" Colour="255,240,200" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~197" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="198~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />

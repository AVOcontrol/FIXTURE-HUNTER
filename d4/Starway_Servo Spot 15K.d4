      <Function ID="29" Name="Dark Blue" Display="'Deep Blue'" Dmx="84~86" WheelPosition="10" Colour="0,0,180" />
      <Function ID="30" Name="D Bl/ Aq" Display="'D Bl/ Aq'" Dmx="87~89" WheelPosition="11" Colour="0,0,180" />
      <Function ID="31" Name="Aquamarine" Display="'Aquamarine'" Dmx="90~92" WheelPosition="12" Colour="0,255,128" />
      <Function ID="32" Name="Aq/ Congo" Display="'Aq/ Congo'" Dmx="93~95" WheelPosition="13" Colour="0,255,128" />

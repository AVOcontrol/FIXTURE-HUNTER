      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="216~223" Colour="0,0,0" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="224~231" Colour="0,0,0" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="232~239" Colour="0,0,0" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="240~247" Colour="0,0,0" />
      <Function ID="32" Name="Random" Display="'Random %.f%%',0~100" Dmx="248~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="C/G Normal" Display="'C/G Normal'" Dmx="0~0" />
      <Function ID="2" Name="Col Any Pos" Display="'Col Any Pos'" Dmx="20~29" />
      <Function ID="3" Name="C/G Any Pos" Display="'C/G Any Pos'" Dmx="30~39" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="8" Name="Reset Col" Display="'Reset Col'" Dmx="88~90" />
      <Function ID="9" Name="Safe" Display="'Safe'" Dmx="91~93" />
      <Function ID="10" Name="Reset Int" Display="'Reset Int'" Dmx="94~96" />
      <Function ID="11" Name="Reset Other" Display="'Reset Other'" Dmx="97~99" />
      <Function ID="12" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="13" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="14" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="15" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="16" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="17" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="18" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="12" If="'Colour1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4112~7967" Colour="0,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="8224~12079" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="12336~16191" Colour="0,0,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="16448~20303" Colour="0,0,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="20560~24415" Colour="0,0,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="24672~28527" Colour="0,0,0" />
      <Function ID="8" Name="CTB" Display="'CTB'" Dmx="28784~32639" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW    %.2f%%',0.00~100.00" Dmx="49858~65535" Colour="0,0,0" />
      <Function ID="12" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
  </Control>

      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="128~190" />
      <Function ID="3" Name="Gradual" Display="'Gradual'" Dmx="191~250" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

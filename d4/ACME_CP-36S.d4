      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="55~61" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="62~69" Colour="0,0,0" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="70~77" Colour="0,0,0" />

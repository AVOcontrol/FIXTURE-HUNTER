<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Four Head Snowstorm Light" ShortName="4HeadSnwSt" Company="Unknown" Version="2">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="03-07-24" Author="Nic Morris" Comment="Created (hopeless documentation.  64 channel mode not documented properly - channel offsets for RGBW 9 don't make sense - assumed it is actually 12x RGBW as per product image.  charts are missing 2 channels in both modes.  part number looks like UKing)" Version="0" />
  <History Date="21-11-24" Author="Nic Morris" Comment="Updated in line with latest documentation (adds 16 channel mode.  utter nonsense.  other modes are not detailed.  left for now)" Version="1" />
  <History Date="24-07-26" Author="Nic Morris" Comment="Created from FODEXAZY ZQ02239 (hopeless documentation)" Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="16 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~127" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~249" />
    </Attribute>
    <Attribute ID="LED_FX" Name="LED FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="6~128" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="P/T_FX" Name="P/T FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="16~128" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="FX_Spd" Name="FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red_Laser" Name="Red Laser" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red Laser" Display="'Red Laser %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Red Laser Strobe" Display="'Red Laser Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Green_Laser" Name="Green Laser" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green Laser" Display="'Green Laser %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Green Laser Strobe" Display="'Green Laser Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_FX1" Name="LED FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="6~128" />
    </Attribute>
    <Attribute ID="P/T_FX1" Name="P/T FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="16~128" />
    </Attribute>
    <Attribute ID="FX_Spd1" Name="FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Red Laser" Display="'Red Laser'" Dmx="3~23" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Green Laer" Display="'Green Laer'" Dmx="24~43" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Reddish-Green Laser" Display="'Reddish-Green Laser'" Dmx="44~63" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Red Laser Strobe" Display="'Red Laser Strobe %.f%%',0~100" Dmx="64~127" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Green Laser Strobe" Display="'Green Laser Strobe %.f%%',0~100" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Red-Green Laser Strobe" Display="'Red-Green Laser Strobe %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dummy" Display="''" Dmx="0~0" Update="Pan" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~249" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>

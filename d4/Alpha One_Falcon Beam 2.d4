    <Attribute ID="Elec_Strobe" Name="Elec Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="104~107" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="158~166" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="108~132" />

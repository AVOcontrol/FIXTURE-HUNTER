      <Function ID="5" Name="Reset Pan" Display="'Reset Pan'" Dmx="155~160" />
      <Function ID="6" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="165~170" />
      <Function ID="7" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="175~180" />

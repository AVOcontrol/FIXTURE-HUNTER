      <Function ID="6" Name="R079 (Bright Blue)" Display="'R079 (Bright Blue)'" Dmx="95~115" Colour="0,0,255" />
      <Function ID="7" Name="R010 (Medium Yellow)" Display="'R010 (Medium Yellow)'" Dmx="116~136" Colour="255,255,0" />
      <Function ID="8" Name="R089 (Moss Green)" Display="'R089 (Moss Green)'" Dmx="137~157" Colour="0,255,0" />
      <Function ID="9" Name="R049 (Medium Purple)" Display="'R049 (Medium Purple)'" Dmx="158~178" Colour="128,0,255" />
      <Function ID="10" Name="R073 (Peacock Blue)" Display="'R073 (Peacock Blue)'" Dmx="179~199" Colour="0,255,200" />
      <Function ID="11" Name="R032 (Medium Salmon Pink)" Display="'R032 (Medium Salmon Pink)'" Dmx="200~220" Colour="255,150,150" />
      <Function ID="12" Name="R067 (Light Sky Blue)" Display="'R067 (Light Sky Blue)'" Dmx="221~241" Colour="0,128,255" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="242~255" Colour="255,255,255" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

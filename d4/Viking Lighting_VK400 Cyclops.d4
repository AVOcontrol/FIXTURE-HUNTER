<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VK400 Cyclops" ShortName="Cyclops" Company="Viking Lighting" Version="0">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="23-07-21" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="xWhite" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'White C-Mix %.1f%%',0.0~100.0" Dmx="0~250" Colour="255,255,255" />
      <Function ID="2" Name="White Blinder" Display="'White Blinder'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xAmber" Name="Amber" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~207" />
      <Function ID="3" Name="Random 1" Display="'Random 1 %.f%%',0~100" Dmx="208~223" />
      <Function ID="4" Name="Random 2" Display="'Random 2 %.f%%',0~100" Dmx="224~239" />
      <Function ID="5" Name="Random 3" Display="'Random 3 %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Special_FX_1" Name="Special FX 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="11~80" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="81~160" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="161~240" />
    </Attribute>
    <Attribute ID="Special_FX_2" Name="Special FX 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="xWhite" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="xAmber" ChannelOffset="3" Wheel="41" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="2" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="xWhite" TargetId="xWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="4" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1,2" Wheel="4" />
        <Attribute ID="xWhite" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="xAmber" ChannelOffset="4" Wheel="41" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="3" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="xWhite" TargetId="xWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="5" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="xWhite" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="xAmber" ChannelOffset="3" Wheel="41" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
        <Attribute ID="Special_FX_1" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Special_FX_2" ChannelOffset="9" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="2" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="xWhite" TargetId="xWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="4" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1,2" Wheel="4" />
        <Attribute ID="xWhite" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="xAmber" ChannelOffset="4" Wheel="41" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Special_FX_1" ChannelOffset="9" Wheel="22" />
        <Attribute ID="Special_FX_2" ChannelOffset="10" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="3" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="xWhite" TargetId="xWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="5" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="White cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="xWhite" ChannelOffset="1" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
</Fixture>
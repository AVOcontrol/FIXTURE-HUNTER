<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Selador Desire D60 Studio Daylight" ShortName="D60 DayLt" Company="ETC">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="29-08-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5d7f64b8-62d6-48fc-b9b3-90a2dd748b58" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~254" />
      <Function ID="3" Name="Max" Display="'Max'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="Direct, 3 DMX" Channels="3">
    <Import PearlRef="ETC60SD1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f6705657-3114-4a1a-8f74-6e41048c248f" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Fan" ChannelOffset="3" Wheel="28" />
    </Include>
  </Mode>

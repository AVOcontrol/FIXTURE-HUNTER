      <Set Channel="Control:31" Delay="12000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Prerig INIT Off">
      <Set Channel="Control:32" Delay="12000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Prerig INIT On">
      <Set Channel="Control:33" Delay="12000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Silence Movements Off">
      <Set Channel="Control:34" Delay="12000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Silence Movements On">
      <Set Channel="Control:35" Delay="12000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Spd Med">

      <Function ID="12" Name="7200K" Display="'7200K'" Dmx="211~230" Colour="255,255,255" />
      <Function ID="13" Name="8000K" Display="'8000K'" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f Hz',0.0~25.0" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~29" />
      <Function ID="3" Name="Dim 1" Display="'Dim 1'" Dmx="30~69" />
      <Function ID="4" Name="Dim 2" Display="'Dim 2'" Dmx="70~129" />
      <Function ID="5" Name="Dim 3" Display="'Dim 3'" Dmx="130~189" />
      <Function ID="6" Name="Dim 4" Display="'Dim 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Live" Display="'Live'" Dmx="10~80" />
      <Function ID="3" Name="Studio" Display="'Studio'" Dmx="81~160" />
      <Function ID="4" Name="Power" Display="'Power'" Dmx="161~240" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

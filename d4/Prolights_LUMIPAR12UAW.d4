    <AtlaBase ModeID="7d45c532-f871-4e32-89e3-0a1f8aa36c2b" />
    <Include>
      <Attribute ID="Amber" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>

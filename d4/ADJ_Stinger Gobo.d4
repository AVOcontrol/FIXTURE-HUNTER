  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="35785fb8-082c-4342-87ba-f380dfcafb7c" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Macro/Show_Spd" />
      <Function ID="2" Name="LED" Display="'LED'" Dmx="10~44" Update="Macro/Show_Spd" />
      <Function ID="3" Name="Strobe" Display="'Strobe'" Dmx="45~79" Update="Macro/Show_Spd" />
      <Function ID="4" Name="Laser" Display="'Laser'" Dmx="80~114" Update="Macro/Show_Spd" />
      <Function ID="5" Name="LED+Laser" Display="'LED+Laser'" Dmx="115~149" Update="Macro/Show_Spd" />
      <Function ID="6" Name="LED+Strobe" Display="'LED+Strobe'" Dmx="150~184" Update="Macro/Show_Spd" />
      <Function ID="7" Name="Laser+Strobe" Display="'Laser+Strobe'" Dmx="185~219" Update="Macro/Show_Spd" />
      <Function ID="8" Name="LED+Laser+Strobe" Display="'LED+Laser+Strobe'" Dmx="220~255" Update="Macro/Show_Spd" />
    </Attribute>
    <Attribute ID="Macro/Show_Spd" Name="Macro/Show Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Show" ID="5,6" If="'Show'&gt;1" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="15 Col Change" Display="'15 Col Change'" Dmx="10~198" />
      <Function ID="3" Name="Single Fade" Display="'Single Fade %.f%%',0~100" Dmx="199~225" />
      <Function ID="4" Name="Mixed Fade" Display="'Mixed Fade %.f%%',0~100" Dmx="226~255" />
      <Function ID="5" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~247" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="RGBW_Strobe" Name="RGBW Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~244" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Motor_Control" Name="Motor Control" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Position" Display="'Position'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="17~255" />
    </Attribute>
    <Attribute ID="LED_Control" Name="LED Control" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LED Off" Display="'LED Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="LED Chase" Display="'LED Chase'" Dmx="135~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Chase/Strb" Name="LED Chase/Strb" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Chase+Strobe" Display="'Chase+Strobe %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~43" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="44~77" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="78~127" />
      <Function ID="5" Name="Chase Spd" Display="'Chase Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Pattern" Name="Laser Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="12~255" />
    </Attribute>
    <Attribute ID="Laser_Pat_Size" Name="Laser Pat Size" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Size" Display="'Size %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Small-&gt;Big" Display="'Small-&gt;Big %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Big-&gt;Small" Display="'Big-&gt;Small %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Laser_Pat_Rot" Name="Laser Pat Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Laser_X-Pos" Name="Laser X-Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Y-Pos" Name="Laser Y-Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Path" Name="Laser Path" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Path" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser_Path_Spd" Name="Laser Path Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

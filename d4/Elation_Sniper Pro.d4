      <Condition Name="Anim" ID="26,27,28" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="29,30,31,32" If="'Colour1Func'==4" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~14" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="20~24" WheelPosition="2" Colour="0,0,0" />

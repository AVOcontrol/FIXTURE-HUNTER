  <Mode Name="LED part (patch 2/2)" Channels="15" Id="071ef28e-c4c5-4052-b783-004281f8b86e">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

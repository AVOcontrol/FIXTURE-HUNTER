      <Attribute ID="Focus" ChannelOffset="11" Wheel="20" />
      <Attribute ID="Auto/Sound" ChannelOffset="12" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Ring_Colour" ChannelOffset="14" Wheel="9" />

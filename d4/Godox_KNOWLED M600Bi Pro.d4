    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="2" Name="Flash" Display="'Flash'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="3" Name="Lightning" Display="'Lightning'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />

      <Function ID="13" Name="Preset" Display="'Preset'" Dmx="120~255" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="FX_Param_1, FX_Param_2, FX3, FX_Param_3" />
    </Attribute>

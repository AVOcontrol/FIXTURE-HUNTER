<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="WM250S2" ShortName="WM250S2" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="25-04-08" Author="Gregory Haynes" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="30-04-12" Author="Peter Budd" Comment="Edited changed filename from Unknown(Generic) to Unknown" />
  <History Date="01-12-16" Author="Nic Morris" Comment="Merged prism and prism rot to fix mapping conflict." />
  <History Date="01-12-16" Author="Nic Morris" Comment="Standardised conditionals.  Added palettes." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe         %.f%%',0~100" Dmx="72~50" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse     %.f%%',0~100" Dmx="99~80" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse    %.f%%',0~100" Dmx="119~100" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe     %.f%%',0~100" Dmx="187~128" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="196~191" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="202~197" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="218~255" Intensity="0~0" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="23,24,25" If="'Colour1Func'==4" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="25600~28927" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="28928~31999" Colour="255,0,0" />
      <Function ID="3" Name="Orchid" Display="'Orchid'" Dmx="32000~35071" Colour="180,0,180" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="35072~38143" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="38144~41215" Colour="0,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="41216~44287" Colour="255,150,150" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="44288~47359" Colour="255,128,0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="47360~50431" Colour="255,0,255" />
      <Function ID="9" Name="Rose" Display="'Rose'" Dmx="50432~53247" Colour="255,0,127" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd %.1f%%',0.0~100.0" Dmx="0~2815" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Orc" Display="'Rd/ Orc %.1f%%',0.0~100.0" Dmx="2816~5631" Colour="255,0,0" />
      <Function ID="12" Name="Orc/ Yel" Display="'Orc/ Yel %.1f%%',0.0~100.0" Dmx="5632~8447" Colour="180,0,180" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn %.1f%%',0.0~100.0" Dmx="8448~11263" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Pk" Display="'Grn/ Pk %.1f%%',0.0~100.0" Dmx="11264~14079" Colour="0,255,0" />
      <Function ID="15" Name="Pk/ Org" Display="'Pk/ Org %.1f%%',0.0~100.0" Dmx="14080~16895" Colour="255,150,150" />
      <Function ID="16" Name="Org/ Mag" Display="'Org/ Mag %.1f%%',0.0~100.0" Dmx="16896~19711" Colour="255,128,0" />
      <Function ID="17" Name="Mag/ Rs" Display="'Mag/ Rs %.1f%%',0.0~100.0" Dmx="19712~22527" Colour="255,0,255" />
      <Function ID="18" Name="Rs/ Op" Display="'Rs/ Op %.1f%%',0.0~100.0" Dmx="22528~25599" Colour="255,0,127" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="25600~25600" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="53248~58111" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="25600~25600" Colour="255,255,255" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="58112~62975" Colour="0,0,0" />
      <Function ID="23" Name="Fast" Display="'Fast'" Dmx="62976~63743" Colour="0,0,0" />
      <Function ID="24" Name="Medium" Display="'Medium'" Dmx="63744~64511" Colour="0,0,0" />
      <Function ID="25" Name="Slow" Display="'Slow'" Dmx="64512~65535" Colour="0,0,0" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Fixed Spin" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Shake" ID="15,16,17,18,19,20,21" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="22,23,24,25" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="7~12" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="13~18" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="19~24" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="25~30" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="31~36" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="37~42" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="43~50" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1" Display="'Gobo 1'" Dmx="51~58" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2" Display="'Gobo 2'" Dmx="59~66" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3" Display="'Gobo 3'" Dmx="67~74" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4" Display="'Gobo 4'" Dmx="75~82" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5" Display="'Gobo 5'" Dmx="83~90" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6" Display="'Gobo 6'" Dmx="91~104" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Open" Display="'Open %.f%%',0~100" Dmx="209~195" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="194~180" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="179~165" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="164~150" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="149~135" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="134~120" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="119~105" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="43~43" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="232~210" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="No Scroll" Display="'No Scroll'" Dmx="43~43" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~233" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32767~768" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="64768~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="64767~32768" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="245~3" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Menu" Display="'Menu Control'" Dmx="246~251" />
      <Function ID="4" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="5~19" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="20~139" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~198" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="197~140" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="242~3" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Menu" Display="'Menu Control'" Dmx="243~251" />
      <Function ID="4" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 16bit" Channels="12">
    <Import PearlRef="UK_WM250S2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="7,8" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="9,10" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="4" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="6" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="12" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="UK_WM250S2E" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="12,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="14,15" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4,5" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="7,8" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Speed" ChannelOffset="10" Wheel="26" />
      <Attribute ID="PT_Speed" ChannelOffset="16" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:10" Delay="5000" />
      <Set Channel="Shutter:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Orchid" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="10" Name="Orchid" Number="7" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="11" Name="Orchid" Number="9" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="15" Name="Orchid" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:8,Gobo1Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:9,Gobo1Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:10,Gobo1Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:11,Gobo1Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:12,Gobo1Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:13,Gobo1Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:14,Gobo1Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
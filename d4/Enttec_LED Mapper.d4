  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="18-08-17" Author="Nic Morris" Comment="Created (limited documentation)" Version="1" />
  <History Date="28-04-19" Author="Nic Morris" Comment="Added discreet modifier functions and added effect functions in line with V.1.0.0.413 (note all values appear to be provided in percent.  these may not be accurate enough)" Version="2" />

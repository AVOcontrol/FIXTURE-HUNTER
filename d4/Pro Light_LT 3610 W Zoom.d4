      <Function ID="33" Name="White 11" Display="'White 11'" Dmx="251~255" />
      <Function ID="34" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">

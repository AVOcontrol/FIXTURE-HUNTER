      <Function ID="8" Name="Colour Chase" Display="'Colour Chase'" Dmx="127~144" />
      <Function ID="9" Name="Paparazzi" Display="'Paparazzi'" Dmx="145~162" />
      <Function ID="10" Name="Lightning" Display="'Lightning'" Dmx="163~180" />
      <Function ID="11" Name="Explosion" Display="'Explosion'" Dmx="181~198" />
      <Function ID="12" Name="TV" Display="'TV'" Dmx="199~216" />
      <Function ID="13" Name="Clouds Passing" Display="'Clouds Passing'" Dmx="217~234" />
      <Function ID="14" Name="Strobe" Display="'Strobe'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour/Mode" Name="Colour/Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour1/Mode1" Display="'Colour1/Mode1'" Dmx="0~0" />

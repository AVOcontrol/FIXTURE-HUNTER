    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red+50% White" Display="'Red+50% White'" Dmx="11~15" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="16~21" Colour="255,255,255" />
      <Function ID="4" Name="Red+Amber" Display="'Red+Amber'" Dmx="22~27" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="28~33" Colour="255,255,255" />
      <Function ID="6" Name="Red+75% Green+Amber" Display="'Red+75% Green+Amber'" Dmx="34~39" Colour="255,255,255" />
      <Function ID="7" Name="Red+Green" Display="'Red+Green'" Dmx="40~45" Colour="255,255,255" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="46~51" Colour="255,255,255" />
      <Function ID="9" Name="Green+White" Display="'Green+White'" Dmx="52~57" Colour="255,255,255" />
      <Function ID="10" Name="Green+UV" Display="'Green+UV'" Dmx="58~63" Colour="255,255,255" />
      <Function ID="11" Name="Green+Blue" Display="'Green+Blue'" Dmx="64~69" Colour="255,255,255" />
      <Function ID="12" Name="Blue+UV" Display="'Blue+UV'" Dmx="70~75" Colour="255,255,255" />
      <Function ID="13" Name="Blue" Display="'Blue'" Dmx="76~81" Colour="255,255,255" />
      <Function ID="14" Name="UV" Display="'UV'" Dmx="82~89" Colour="255,255,255" />
      <Function ID="15" Name="UV+50% Red" Display="'UV+50% Red'" Dmx="90~95" Colour="255,255,255" />
      <Function ID="16" Name="UV+Amber" Display="'UV+Amber'" Dmx="96~101" Colour="255,255,255" />
      <Function ID="17" Name="UV+Amber+Red" Display="'UV+Amber+Red'" Dmx="102~107" Colour="255,255,255" />
      <Function ID="18" Name="UV+Red" Display="'UV+Red'" Dmx="108~113" Colour="255,255,255" />
      <Function ID="19" Name="Red+White+Amber" Display="'Red+White+Amber'" Dmx="114~119" Colour="255,255,255" />
      <Function ID="20" Name="White+Amber" Display="'White+Amber'" Dmx="120~125" Colour="255,255,255" />
      <Function ID="21" Name="White" Display="'White'" Dmx="126~131" Colour="255,255,255" />
      <Function ID="22" Name="White+Blue" Display="'White+Blue'" Dmx="132~137" Colour="255,255,255" />
      <Function ID="23" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="138~143" Colour="255,255,255" />
      <Function ID="24" Name="Step" Display="'Step %.f%%',0~100" Dmx="144~199" Colour="255,255,255" />
      <Function ID="25" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~20" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="21~30" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="31~40" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="41~50" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="51~60" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="61~70" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="71~80" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="81~90" />
      <Function ID="10" Name="Sound (Sensitivity)" Display="'Sound (Sensitivity) %.1f%%',0.0~100.0" Dmx="91~230" />
      <Function ID="11" Name="Reset" Display="'Reset'" Dmx="231~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">

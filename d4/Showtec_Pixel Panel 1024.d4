      <Function ID="31" Name="Program 30 (Random 1-29)" Display="'Program 30 (Random 1-29)'" Dmx="248~255" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Program 30 (Random 1-29)" ID="2" If="'Program'==31" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Interval" Display="'%.1f Sec',30.0~3.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Dir" Name="Program Dir" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="255~255" />
    </Attribute>

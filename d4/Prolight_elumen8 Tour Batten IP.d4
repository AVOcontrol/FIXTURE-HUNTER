  <AtlaBase TypeID="eba78e34-e2bf-43e2-a185-9e7022327566" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="8~15" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="16~23" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="24~31" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="32~39" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="40~47" />
      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="48~55" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="56~63" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="64~71" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="72~79" />
      <Function ID="11" Name="Program 9" Display="'Program 9'" Dmx="80~87" />
      <Function ID="12" Name="Program 10" Display="'Program 10'" Dmx="88~95" />
      <Function ID="13" Name="Program 11" Display="'Program 11'" Dmx="96~103" />
      <Function ID="14" Name="Program 12" Display="'Program 12'" Dmx="104~111" />
      <Function ID="15" Name="Program 13" Display="'Program 13'" Dmx="112~119" />
      <Function ID="16" Name="Program 14" Display="'Program 14'" Dmx="120~127" />
      <Function ID="17" Name="Program 15" Display="'Program 15'" Dmx="128~135" />
      <Function ID="18" Name="Program 16" Display="'Program 16'" Dmx="136~143" />
      <Function ID="19" Name="Auto" Display="'Auto'" Dmx="144~151" />
    </Attribute>
    <Attribute ID="Program_Speed" Name="Program Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Fade" Name="Program Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Mode" Name="Program Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="52~127" />
      <Function ID="3" Name="Forward" Display="'Forward'" Dmx="128~191" />
      <Function ID="4" Name="Backward" Display="'Backward'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Program_Dimmer" Name="Program Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

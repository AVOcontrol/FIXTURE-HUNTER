  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="df8f6bdd-d193-4f30-a5f9-0de9f620b536" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~199" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="10~29" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="30~49" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="50~69" Colour="255,255,255" />
      <Function ID="5" Name="UV" Display="'UV'" Dmx="70~89" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="90~109" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="110~129" Colour="255,255,255" />
      <Function ID="8" Name="R+UV" Display="'R+UV'" Dmx="130~149" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="150~169" Colour="255,255,255" />
      <Function ID="10" Name="G+UV" Display="'G+UV'" Dmx="170~189" Colour="255,255,255" />
      <Function ID="11" Name="B+UV" Display="'B+UV'" Dmx="190~209" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="13" Name="R+G+UV" Display="'R+G+UV'" Dmx="220~229" Colour="255,255,255" />
      <Function ID="14" Name="R+B+UV" Display="'R+B+UV'" Dmx="230~239" Colour="255,255,255" />
      <Function ID="15" Name="G+B+UV" Display="'G+B+UV'" Dmx="240~249" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+UV" Display="'R+G+B+UV'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

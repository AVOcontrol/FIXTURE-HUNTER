    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="4~60" />
      <Function ID="3" Name="Op Pulse" Display="'Op Pulse %.f%%',0~100" Dmx="61~120" />
      <Function ID="4" Name="Sound 1" Display="'Sound 1'" Dmx="121~180" />
      <Function ID="5" Name="Sound 2" Display="'Sound 2'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Auto_Dimming" Name="Auto Dimming" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
  </Control>

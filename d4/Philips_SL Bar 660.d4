<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SL Bar 660" ShortName="SL Bar 660" Company="Philips">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-02-13" Author="Peter Budd" Comment="Created" />
  <History Date="13-02-13" Author="Peter Budd" Comment="Created from Philips SL Bar 640" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Renamed shutter functions to distinguish between open and close pulse ranges." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed PL-Curve control range.  Renamed random colour scroll and inverted range." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Changed timing attribute to percentage range.  Set all timing attributes to locate at 255." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Increased wheel resolution of all 16 bit colour attributes." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed shutter palettes.  Added macros.  Added simple modes.  Added HSIC modes." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="26-11-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="16-12-17" Author="Nic Morris" Comment="Changed intensity attribute ID to ColourIntensity for compatibility." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="20545" />
  </RDM>
  <AtlaBase TypeID="34128e38-922f-4149-9d5c-a3ef795c5809" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">

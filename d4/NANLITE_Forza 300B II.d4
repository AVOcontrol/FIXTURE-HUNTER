  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ebc01c8d-dcb8-4d30-8b55-c62545114d2f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="-80 Green" Display="'-80 Green'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.f',79~1" Dmx="21~99" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="100~165" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f',1~79" Dmx="166~244" Colour="0,0,0" />
      <Function ID="6" Name="+80 Green" Display="'+80 Green'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Smart" Display="'Smart'" Dmx="0~0" />
      <Function ID="2" Name="Full Speed" Display="'Full Speed'" Dmx="64~127" />
      <Function ID="3" Name="Low Speed" Display="'Low Speed'" Dmx="128~191" />
      <Function ID="4" Name="Fan Off" Display="'Fan Off'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
      <Function ID="3" Name="Rnd Slow" Display="'Rnd Slow'" Dmx="6~6" />
      <Function ID="4" Name="Rnd Med" Display="'Rnd Med'" Dmx="5~5" />
      <Function ID="5" Name="Rnd Fast" Display="'Rnd Fast'" Dmx="4~4" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

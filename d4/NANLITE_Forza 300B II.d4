      <Function ID="9" Name="Candle/Fire Effect" Display="'Candle/Fire Effect'" Dmx="127~144" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />
      <Function ID="10" Name="Bab Bulb Effect" Display="'Bab Bulb Effect'" Dmx="145~162" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />
      <Function ID="11" Name="Firework Effect" Display="'Firework Effect'" Dmx="163~180" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />
      <Function ID="12" Name="Explosion Effect" Display="'Explosion Effect'" Dmx="181~198" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />

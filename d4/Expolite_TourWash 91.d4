<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TourWash 91" ShortName="TourWash91" Company="Expolite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="20-07-12" Author="Sebastian Beutel" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~5" Colour="0,0,0" />
      <Function ID="2" Name="Full Power" Display="'Full Power'" Dmx="6~10" Colour="0,0,0" />
      <Function ID="3" Name="Red-Yell" Display="'Red-Yell %.f%%',0~100" Dmx="11~30" Colour="0,0,0" />
      <Function ID="4" Name="Yell-Green" Display="'Yell-Green %.f%%',0~100" Dmx="31~50" Colour="0,0,0" />
      <Function ID="5" Name="Green-Cyan" Display="'Green-Cyan %.f%%',0~100" Dmx="51~70" Colour="0,0,0" />
      <Function ID="6" Name="Cyan-Blue" Display="'Cyan-Blue %.f%%',0~100" Dmx="71~90" Colour="0,0,0" />
      <Function ID="7" Name="Blue-Mag" Display="'Blue-Mag %.f%%',0~100" Dmx="91~110" Colour="0,0,0" />
      <Function ID="8" Name="Mag-Red" Display="'Mag-Red %.f%%',0~100" Dmx="111~130" Colour="0,0,0" />
      <Function ID="9" Name="Red-White" Display="'Red-White %.f%%',0~100" Dmx="131~150" Colour="0,0,0" />
      <Function ID="10" Name="White-Blue" Display="'White-Blue %.f%%',0~100" Dmx="151~170" Colour="0,0,0" />
      <Function ID="11" Name="Full White" Display="'Full White'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="12" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="13" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="14" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="15" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="16" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="17" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="18" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="19" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="20" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="21" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="22" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f%%',0.0~20.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~19" />
      <Function ID="2" Name="P/T Black On" Display="'P/T Black On'" Dmx="20~39" />
      <Function ID="3" Name="P/T Black Off" Display="'P/T Black Off'" Dmx="40~59" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~79" />
      <Function ID="5" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="6" Name="Fan Normal" Display="'Fan Normal'" Dmx="100~119" />
      <Function ID="7" Name="Fan Fast" Display="'Fan Fast'" Dmx="120~139" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="140~149" />
      <Function ID="9" Name="Auto 2" Display="'Auto 2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="180~199" />
      <Function ID="13" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="14" Name="No Function" Display="'No Function'" Dmx="220~235" />
      <Function ID="15" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="16" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="17" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="18" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="19" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~9" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Nonlin 1" Display="'Nonlin 1 %.f%%',0~100" Dmx="30~69" />
      <Function ID="4" Name="Nonlin 2" Display="'Nonlin 2 %.f%%',0~100" Dmx="70~129" />
      <Function ID="5" Name="Nonlin 3" Display="'Nonlin 3 %.f%%',0~100" Dmx="130~189" />
      <Function ID="6" Name="Nonlin 4" Display="'Nonlin 4 %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="WarmWhite" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="WWhite C-Mix" Display="'WWhite C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="ColdWhite" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CWhite C-Mix" Display="'CWhite C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

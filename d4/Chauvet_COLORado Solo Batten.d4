    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~209" Colour="255,255,255" />
      <Function ID="3" Name="Full" Display="'Full'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1800K" Display="'1800K'" Dmx="11~28" Colour="255,255,255" />
      <Function ID="3" Name="2200K" Display="'2200K'" Dmx="29~46" Colour="255,255,255" />
      <Function ID="4" Name="2700K" Display="'2700K'" Dmx="47~64" Colour="255,255,255" />
      <Function ID="5" Name="3000K" Display="'3000K'" Dmx="65~82" Colour="255,255,255" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="83~100" Colour="255,255,255" />
      <Function ID="7" Name="3500K" Display="'3500K'" Dmx="101~118" Colour="255,255,255" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="119~136" Colour="255,255,255" />
      <Function ID="9" Name="4200K" Display="'4200K'" Dmx="137~154" Colour="255,255,255" />
      <Function ID="10" Name="4500K" Display="'4500K'" Dmx="155~172" Colour="255,255,255" />
      <Function ID="11" Name="5600K" Display="'5600K'" Dmx="173~190" Colour="255,255,255" />
      <Function ID="12" Name="6000K" Display="'6000K'" Dmx="191~208" Colour="255,255,255" />
      <Function ID="13" Name="6500K" Display="'6500K'" Dmx="209~226" Colour="255,255,255" />
      <Function ID="14" Name="7200K" Display="'7200K'" Dmx="227~244" Colour="255,255,255" />
      <Function ID="15" Name="8000K" Display="'8000K'" Dmx="245~255" Colour="255,255,255" />

      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="190~211" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="212~233" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Function ID="14" Name="Gobo 12" Display="'Gobo 12'" Dmx="60~64" WheelPosition="13" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="185~190" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="65~74" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="75~84" WheelPosition="2" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="85~94" WheelPosition="3" />

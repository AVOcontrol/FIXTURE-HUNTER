      <Function ID="24" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="145~154" WheelPosition="9" />
      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="155~164" WheelPosition="10" />

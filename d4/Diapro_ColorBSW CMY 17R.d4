    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="48830~49858" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48573" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48830~49858" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="50115~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism Index" Display="'Prism Index'" Dmx="5~63" Update="Prism_Rot" />
      <Function ID="3" Name="Prism Spin 1" Display="'Prism Spin 1'" Dmx="64~127" Update="Prism_Rot" />
      <Function ID="4" Name="Prism Spin 2" Display="'Prism Spin 2'" Dmx="128~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Prism'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==3||'Prism'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="0~179" />

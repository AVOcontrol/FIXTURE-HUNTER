  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="be1b7a82-f0e9-4c6a-b565-b82ff3fceeff" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="23~45" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="46~68" Colour="255,255,255" />
      <Function ID="4" Name="3600K" Display="'3600K'" Dmx="69~91" Colour="255,255,255" />
      <Function ID="5" Name="4500K" Display="'4500K'" Dmx="92~114" Colour="255,255,255" />
      <Function ID="6" Name="5000K" Display="'5000K'" Dmx="115~137" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="138~160" Colour="255,255,255" />
      <Function ID="8" Name="6200K" Display="'6200K'" Dmx="161~183" Colour="255,255,255" />
      <Function ID="9" Name="6800K" Display="'6800K'" Dmx="184~206" Colour="255,255,255" />
      <Function ID="10" Name="7500K" Display="'7500K'" Dmx="207~229" Colour="255,255,255" />
      <Function ID="11" Name="8500K" Display="'8500K'" Dmx="230~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="51~57" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="58~64" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="65~71" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="72~78" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="79~85" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="86~92" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="93~99" />
      <Function ID="9" Name="Flash" Display="'Flash'" Dmx="100~149" />
      <Function ID="10" Name="Fade" Display="'Fade'" Dmx="150~199" />
      <Function ID="11" Name="Pulse" Display="'Pulse'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

      <Function ID="5" Name="6-Facet Linear Spin" Display="'6-Facet Linear Spin'" Dmx="16~19" Update="Prism_1_Rot" />
      <Function ID="6" Name="Cylindrical Spin" Display="'Cylindrical Spin'" Dmx="20~23" Update="Prism_1_Rot" />
      <Function ID="7" Name="8-Facet 12° Circular Spin" Display="'8-Facet 12° Circular Spin'" Dmx="24~27" Update="Prism_1_Rot" />

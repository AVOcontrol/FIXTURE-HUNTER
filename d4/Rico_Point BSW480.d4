    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_1_Rot" />
      <Function ID="2" Name="6-Facet Linear Index" Display="'6-Facet Linear Index'" Dmx="4~7" Update="Prism_1_Rot" />
      <Function ID="3" Name="Cylindrical Index" Display="'Cylindrical Index'" Dmx="8~11" Update="Prism_1_Rot" />

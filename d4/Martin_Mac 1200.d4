  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="177~50" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="178~207" Intensity="0~0" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
      <Function ID="6" Name="Safe" Display="'Safe'" Dmx="218~227" Intensity="0~0" />
      <Function ID="7" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" Intensity="0~0" />
      <Function ID="8" Name="Safe" Display="'Safe'" Dmx="238~247" Intensity="0~0" />
      <Function ID="9" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="6,7,8,9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==3" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="179~184" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="173~178" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="167~172" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="161~166" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Op/ 1" Display="'Op/ 1 %.f%%',0~100" Dmx="0~39" WheelPosition="0" Colour="255,255,255" />
      <Function ID="7" Name="1/ 2" Display="'1/ 2 %.f%%',0~100" Dmx="40~79" WheelPosition="1" Colour="0,0,0" />
      <Function ID="8" Name="2/ 3" Display="'2/ 3 %.f%%',0~100" Dmx="80~119" WheelPosition="2" Colour="0,0,0" />
      <Function ID="9" Name="3/ 4" Display="'3/ 4 %.f%%',0~100" Dmx="120~160" WheelPosition="3" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~192" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="14,15" If="'Gobo1Func'==3" />
      <Else ID="16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="183~186" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="179~182" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="175~178" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="171~174" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="167~170" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="163~166" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Op/ 1" Display="'Op/ 1 %.f%%',0~100" Dmx="0~30" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="1/ 2" Display="'1/ 2 %.f%%',0~100" Dmx="31~57" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="2/ 3" Display="'2/ 3 %.f%%',0~100" Dmx="58~82" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="3/ 4" Display="'3/ 4 %.f%%',0~100" Dmx="83~105" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="4/ 5" Display="'4/ 5 %.f%%',0~100" Dmx="106~125" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="5/ 6" Display="'5/ 6 %.f%%',0~100" Dmx="126~161" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="15" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="255~192" GoboSpin="0~0" GoboOrientation="0~0" />

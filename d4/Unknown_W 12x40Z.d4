      <Function ID="7" Name="4500K" Display="'4500K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="8" Name="5000K" Display="'5000K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />

      <Function ID="13" Name="8000K" Display="'8000K'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~31" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="32~47" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="48~63" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="64~79" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="80~95" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="96~111" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="112~127" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="128~143" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="144~159" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="160~175" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="176~191" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="192~207" />

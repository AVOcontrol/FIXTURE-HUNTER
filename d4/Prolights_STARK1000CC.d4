    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="5" Name="Display Off" Display="'Display Off'" Dmx="56~63" />
      <Function ID="6" Name="Display On" Display="'Display On'" Dmx="64~71" />
      <Function ID="7" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
      <Function ID="8" Name="Theatre Mode Off" Display="'Theatre Mode Off'" Dmx="96~103" />
      <Function ID="9" Name="Theatre Mode On" Display="'Theatre Mode On'" Dmx="104~111" />
      <Function ID="10" Name="New Mode" Display="'New Mode'" Dmx="144~151" />
      <Function ID="11" Name="Old Mode" Display="'Old Mode'" Dmx="152~159" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 17 DMX" Channels="17">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="233" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="045958af-c26a-4f18-b3e5-c6c15f4c1372" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Dim_Fade" ChannelOffset="8" Wheel="26" />

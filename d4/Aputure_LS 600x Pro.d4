<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LS 600x Pro" ShortName="LS600x Pro" Company="Aputure" Version="2">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>eca65e07-55e0-4187-b24b-43b2628388e6</Thumbnail>
  <History Date="08-04-22" Author="Nic Morris" Comment="Created (vague documentation.  ranges are not detailed.  Mode 3 suggests 6 controls but only 5 channel offsets.  assumed offsets are wrong and used 6)" Version="0" />
  <History Date="13-04-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="10-06-22" Author="Nic Morris" Comment="Updated in line with latest documentation." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c8f61b82-674b-4711-a20e-3d0c17b6eb4d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lighting" Display="'Lighting'" Dmx="0~0" />
      <Function ID="2" Name="Effects" Display="'Effects'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="FX_Sel" Name="FX Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="Effect_Param, FX_Param" />
      <Function ID="2" Name="Fireworks" Display="'Fireworks'" Dmx="20~39" Update="Effect_Param, FX_Param" />
      <Function ID="3" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="40~59" Update="Effect_Param, FX_Param" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="60~79" Update="Effect_Param, FX_Param" />
      <Function ID="5" Name="TV" Display="'TV'" Dmx="80~99" Update="Effect_Param, FX_Param" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="100~119" Update="Effect_Param, FX_Param" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="120~139" Update="Effect_Param, FX_Param" />
      <Function ID="8" Name="Explosion" Display="'Explosion'" Dmx="140~159" Update="Effect_Param, FX_Param" />
      <Function ID="9" Name="Fire" Display="'Fire'" Dmx="160~179" Update="Effect_Param, FX_Param" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param, FX_Param" />
    </Attribute>
    <Attribute ID="FX_Frequency" Name="FX Frequency" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="20~39" />
      <Function ID="3" Name="3" Display="'3'" Dmx="40~59" />
      <Function ID="4" Name="4" Display="'4'" Dmx="60~79" />
      <Function ID="5" Name="5" Display="'5'" Dmx="80~99" />
      <Function ID="6" Name="6" Display="'6'" Dmx="100~119" />
      <Function ID="7" Name="7" Display="'7'" Dmx="120~139" />
      <Function ID="8" Name="8" Display="'8'" Dmx="140~159" />
      <Function ID="9" Name="9" Display="'9'" Dmx="160~179" />
      <Function ID="10" Name="10" Display="'10'" Dmx="180~199" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="200~219" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Param" Name="FX Param" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Lightning" ID="2,3,4" If="'FX_Sel'==4" />
      <Condition Name="Explosion" ID="5,6" If="'FX_Sel'==8" />
      <Else ID="1" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="Trigger" Display="'Trigger'" Dmx="11~127" />
      <Function ID="4" Name="Loop" Display="'Loop'" Dmx="128~255" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="6" Name="Trigger" Display="'Trigger'" Dmx="11~127" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (Lighting), 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f3ab9bf6-1762-46a4-8a20-213118d6ad43" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="Mode 2 (Effects), 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0fb5c676-5532-48a1-9966-83fd2d9e5fdc" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="7" />
      <Attribute ID="FX_Sel" ChannelOffset="3" Wheel="22" />
      <Attribute ID="FX_Frequency" ChannelOffset="4" Wheel="23" />
      <Attribute ID="FX_Param" ChannelOffset="5" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="Mode 3 (Lighting+Effects), 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="151e2343-74de-4755-aa33-c0b4b4ddb268" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Mode" ChannelOffset="3" Wheel="28" />
      <Attribute ID="FX_Sel" ChannelOffset="4" Wheel="22" />
      <Attribute ID="FX_Frequency" ChannelOffset="5" Wheel="23" />
      <Attribute ID="FX_Param" ChannelOffset="6" Wheel="24" />
    </Include>
  </Mode>
  <swatchLibrary>

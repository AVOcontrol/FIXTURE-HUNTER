<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Costume Controller" ShortName="Costume" Company="Light Initiative">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="20-06-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show_ID" Name="Show ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Show ID 0" Display="'Show ID 0'" Dmx="0~15" />
      <Function ID="2" Name="Show ID 1" Display="'Show ID 1'" Dmx="16~30" />
      <Function ID="3" Name="Show ID 2" Display="'Show ID 2'" Dmx="31~45" />
      <Function ID="4" Name="Show ID 3" Display="'Show ID 3'" Dmx="46~60" />
      <Function ID="5" Name="Show ID 4" Display="'Show ID 4'" Dmx="61~75" />
      <Function ID="6" Name="Show ID 5" Display="'Show ID 5'" Dmx="76~90" />
      <Function ID="7" Name="Show ID 6" Display="'Show ID 6'" Dmx="91~105" />
      <Function ID="8" Name="Show ID 7" Display="'Show ID 7'" Dmx="106~120" />
      <Function ID="9" Name="Show ID 8" Display="'Show ID 8'" Dmx="121~135" />
      <Function ID="10" Name="Show ID 9" Display="'Show ID 9'" Dmx="136~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Live" Display="'Live'" Dmx="0~0" />
      <Function ID="2" Name="Record" Display="'Record'" Dmx="85~85" />
      <Function ID="3" Name="Playback" Display="'Playback'" Dmx="128~128" />
      <Function ID="4" Name="Prime" Display="'Prime'" Dmx="240~240" />
      <Function ID="5" Name="Quick Record" Display="'Quick Record'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Assign_PB_Dim" Name="Assign PB Dim" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Intensity" Display="'Full Intensity'" Dmx="0~10" />
      <Function ID="2" Name="Assign Ch" Display="'Assign Ch %.f',11~60" Dmx="11~60" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKLICOSC" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show_ID" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Control" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Reserved" ChannelOffset="3" Wheel="58" />
      <Attribute ID="Assign_PB_Dim" ChannelOffset="4" Wheel="30" />
    </Include>
  </Mode>
</Fixture>
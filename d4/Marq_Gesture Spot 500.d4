  </Mode>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="UKMQGS52" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

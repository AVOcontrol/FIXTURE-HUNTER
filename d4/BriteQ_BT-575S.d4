      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="132~185" WheelPosition="1" Intensity="0~0" />
      <Function ID="5" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="186~239" WheelPosition="1" Intensity="0~0" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="240~247" Intensity="0~0" />

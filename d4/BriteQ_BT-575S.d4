<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-575S" ShortName="BT-575S" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="16-11-12" Author="Peter Budd" Comment="Created" />
  <History Date="29-11-16" Author="Nic Morris" Comment="Increased wheel resolution.  Fixed duplicate ID's in else conditions.  Fixed 8 DMX gobo function index." />
  <History Date="29-11-16" Author="Nic Morris" Comment="Renamed 8 DMX gobo scroll functions.  Changed 8 DMX to use 'Gobo Rot' instead of 'Gobo 2 Rot'." />
  <History Date="29-11-16" Author="Nic Morris" Comment="Combined dimmer functions for both modes using conditions to preserve dimmer ID properties and moved 8 DMX dimmer to first function for compatibility." />
  <History Date="29-11-16" Author="Nic Morris" Comment="Added highlight/lowlight.  Changed name from BT 575 S to BT-575S" />
  <History Date="29-11-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0f9b8b5c-1d0b-4c05-af3e-a4c019be3278" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="8 DMX" ID="2,3,4,5,6,7,8,9" If="'Gobo1Rot'&gt;1||'Gobo1Rot'&lt;5" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="4" Name="Prism 1" Display="'Prism 1'" Dmx="16~31" Intensity="0~0" />
      <Function ID="5" Name="P1 CW" Display="'P1 CW %.f%%',100~0" Dmx="32~55" Intensity="0~0" />
      <Function ID="6" Name="P1 CCW" Display="'P1 CCW %.f%%',0~100" Dmx="56~79" Intensity="0~0" />
      <Function ID="7" Name="Prism 2" Display="'Prism 2'" Dmx="80~102" Intensity="0~0" />
      <Function ID="8" Name="P2 CW" Display="'P2 CW %.f%%',100~0" Dmx="103~103" Intensity="0~0" />
      <Function ID="9" Name="P2 CCW" Display="'P2 CCW %.f%%',0~100" Dmx="104~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />

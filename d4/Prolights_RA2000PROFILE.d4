<Fixture Name="RA2000PROFILE" ShortName="RA2000" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>87c0c13f-0378-4378-916a-c7c45b0b7939</Thumbnail>
  <History Date="03-03-18" Author="Nic Morris" Comment="Created" />
  <History Date="05-11-18" Author="Nic Morris" Comment="Added 38 and 39 channel modes.  Revised fixed colour names, ranges and swatches." />
  <History Date="05-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added physical pan/tilt ranges.  Changed name from RA3000 Profile to RA3000PROFILE" />
  <History Date="08-11-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="18-03-19" Author="Nic Morris" Comment="Created from Prolights RA3000PROFILE (identical except one additional gobo)" />
  <History Date="19-05-19" Author="Nic Morris" Comment="Added product thumbnail.  Added 44 channel mode.  Revised Dim Spd functions in line with latest charts." />
  <History Date="22-05-19" Author="Nic Morris" Comment="Added extra control functions and macros in line with latest charts in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="250~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~82" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="175~244" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="94~163" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />

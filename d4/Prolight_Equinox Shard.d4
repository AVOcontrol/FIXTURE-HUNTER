    <AtlaBase ModeID="e5d50ae2-5bf5-4643-8989-8662c9af9d02" />
    <Include>
      <Attribute ID="Show" ChannelOffset="1" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="PTEQSHD4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="76e2993b-1423-4163-b5ed-a5e28906d9ec" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">

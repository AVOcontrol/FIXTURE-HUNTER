  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0131c92d-e68c-458a-baf7-716367106ebb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="51~67" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="68~84" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="85~101" Colour="255,255,255" />
      <Function ID="7" Name="R+W" Display="'R+W'" Dmx="102~118" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="G+W" Display="'G+W'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="B+W" Display="'B+W'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="R+G+W" Display="'R+G+W'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="R+B+W" Display="'R+B+W'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="PTEQSHD1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

      <Function ID="9" Name="4x Alternate" Display="'4x Alternate'" Dmx="81~90" />
      <Function ID="10" Name="Singel Dot Criss-Cross" Display="'Singel Dot Criss-Cross'" Dmx="91~100" />
      <Function ID="11" Name="Ring Chase On/ All Off" Display="'Ring Chase On/ All Off'" Dmx="101~110" />
      <Function ID="12" Name="Ring Chase On/ Ring Chase Off" Display="'Ring Chase On/ Ring Chase Off'" Dmx="111~120" />
      <Function ID="13" Name="Ring Chase On/ Ring Chase Off Rev" Display="'Ring Chase On/ Ring Chase Off Rev'" Dmx="121~130" />
      <Function ID="14" Name="Rnd Single Dots" Display="'Rnd Single Dots'" Dmx="131~140" />
      <Function ID="15" Name="Left/ Right Halves" Display="'Left/ Right Halves'" Dmx="141~150" />
      <Function ID="16" Name="Top/ Bottom Halves" Display="'Top/ Bottom Halves'" Dmx="151~160" />
      <Function ID="17" Name="X to X" Display="'X to X'" Dmx="161~170" />
      <Function ID="18" Name="Random FX" Display="'Random FX'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Strobe_Spd" Name="Strobe Spd" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.f%%',100~0" Dmx="209~110" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="100~109" />
      <Function ID="3" Name="REV" Display="'REV %.f%%',0~100" Dmx="99~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Laser_Sel" Name="Laser Sel" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="31~40" />
      <Function ID="5" Name="Red Strobe" Display="'Red Strobe'" Dmx="41~50" />
      <Function ID="6" Name="Red Rnd Strobe" Display="'Red Rnd Strobe'" Dmx="51~60" />
      <Function ID="7" Name="Red Strobe/ Green On" Display="'Red Strobe/ Green On'" Dmx="61~70" />
      <Function ID="8" Name="Green Strobe" Display="'Green Strobe'" Dmx="71~80" />
      <Function ID="9" Name="Green Rnd Strobe" Display="'Green Rnd Strobe'" Dmx="81~90" />
      <Function ID="10" Name="Green Strobe/ Red On" Display="'Green Strobe/ Red On'" Dmx="91~100" />
      <Function ID="11" Name="Red/ Green Alternate Strobe" Display="'Red/ Green Alternate Strobe'" Dmx="101~110" />
      <Function ID="12" Name="Red/ Green Rnd Strobe" Display="'Red/ Green Rnd Strobe'" Dmx="111~120" />
      <Function ID="13" Name="Sound Red" Display="'Sound Red'" Dmx="211~220" />
      <Function ID="14" Name="Sound Green" Display="'Sound Green'" Dmx="221~230" />
      <Function ID="15" Name="Sound Alternate Red/ Green" Display="'Sound Alternate Red/ Green'" Dmx="231~240" />
      <Function ID="16" Name="Random" Display="'Random'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="G">

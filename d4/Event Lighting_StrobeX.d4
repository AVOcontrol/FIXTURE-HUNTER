<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="StrobeX" ShortName="StrobeX" Company="Event Lighting">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Created" />
  <History Date="27-07-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="46094df4-5e13-42d1-b88c-13b563538ed6" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="129~171" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="172~214" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Block 1 only" Display="'Block 1 only'" Dmx="6~15" />
      <Function ID="3" Name="Block 2 only" Display="'Block 2 only'" Dmx="16~25" />
      <Function ID="4" Name="Block 3 only" Display="'Block 3 only'" Dmx="26~35" />
      <Function ID="5" Name="Block 4 only" Display="'Block 4 only'" Dmx="36~45" />
      <Function ID="6" Name="Block 1,2,4 only" Display="'Block 1,2,4 only'" Dmx="46~55" />
      <Function ID="7" Name="Block 1,3 only" Display="'Block 1,3 only'" Dmx="56~65" />
      <Function ID="8" Name="Block 3,4 only" Display="'Block 3,4 only'" Dmx="66~75" />
      <Function ID="9" Name="Auto Chase 1" Display="'Auto Chase 1'" Dmx="76~91" />
      <Function ID="10" Name="Auto Chase 2" Display="'Auto Chase 2'" Dmx="92~107" />
      <Function ID="11" Name="Auto Chase 3" Display="'Auto Chase 3'" Dmx="108~123" />
      <Function ID="12" Name="Auto Combination" Display="'Auto Combination'" Dmx="124~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Chase 1" Display="'Auto Chase 1'" Dmx="76~91" />
      <Function ID="3" Name="Auto Chase 2" Display="'Auto Chase 2'" Dmx="92~107" />
      <Function ID="4" Name="Auto Chase 3" Display="'Auto Chase 3'" Dmx="108~123" />
      <Function ID="5" Name="Auto Combination" Display="'Auto Combination'" Dmx="124~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="S4, 4 DMX" Channels="4">

  <AtlaBase TypeID="7102d95b-ff92-4827-b1a1-8c9d3845257f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe'" Dmx="205~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="5~54" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse'" Dmx="55~104" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse'" Dmx="105~154" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="155~204" />
    </Attribute>
    <Attribute ID="Shutter_Speed" Name="Shutter Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~14" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~24" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="25~34" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="35~44" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="45~54" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="55~64" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="65~74" Colour="255,255,255" />
      <Function ID="9" Name="Skip" Display="'Skip %.1f%%',0.0~100.0" Dmx="75~199" Colour="255,255,255" />
      <Function ID="10" Name="Random" Display="'Random %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Fade" Name="Colour Fade" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="8~39" Colour="255,0,0" />
      <Function ID="3" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="40~71" Colour="255,255,0" />
      <Function ID="4" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="72~103" Colour="0,255,0" />
      <Function ID="5" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="104~135" Colour="0,255,255" />
      <Function ID="6" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="136~167" Colour="0,0,255" />
      <Function ID="7" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="168~199" Colour="255,0,255" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~199" Colour="0,0,0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="5~34" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="35~69" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="70~104" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="105~139" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="140~174" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="175~209" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Shade" Name="Effect Shade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

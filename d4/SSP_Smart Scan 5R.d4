      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" GoboSpin="0~0" GoboOrientation="0~0" />

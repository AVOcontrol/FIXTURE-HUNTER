    </Attribute>
    <Attribute ID="Patt_Z_Rot" Name="Patt Z Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="245~135" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_XY_Rot" Name="Patt XY Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Horiz" Display="'Horiz %.1f%%',100.0~0.0" Dmx="10~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="121~134" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Vert" Display="'Vert %.1f%%',0.0~100.0" Dmx="245~135" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="255~128" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Horiz_Move" Name="Horiz Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Move" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Vert_Move" Name="Vert Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Move" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Beam_Rot" Name="Beam Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Beam_Shake" Name="Beam Shake" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~7" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~127" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="3~103" Intensity="0~0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="104~107" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="208~212" Intensity="0~0" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
      <Function ID="7" Name="Stop" Display="'Stop'" Dmx="252~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~39" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="80~89" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="90~99" />
      <Function ID="6" Name="Reset Colour" Display="'Reset Colour'" Dmx="100~109" />
      <Function ID="7" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="110~119" />
      <Function ID="8" Name="Reset Int" Display="'Reset Int'" Dmx="120~129" />
      <Function ID="9" Name="Reset Other" Display="'Reset Other'" Dmx="130~139" />
      <Function ID="10" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="140~149" />
      <Function ID="11" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="150~159" />
      <Function ID="12" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="160~169" />
      <Function ID="13" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="170~179" />
      <Function ID="14" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="180~189" />
      <Function ID="15" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="190~199" />
      <Function ID="16" Name="Reset System" Display="'Reset System'" Dmx="200~219" />
      <Function ID="17" Name="No Function" Display="'No Function'" Dmx="220~255" />
    </Attribute>
  </Control>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="UKSSP5R1" DiamondRef="" WysiwygRef="" />

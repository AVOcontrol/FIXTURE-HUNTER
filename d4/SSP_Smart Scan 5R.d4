      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="82~88" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="89~96" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="97~103" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="104~110" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="111~118" WheelPosition="15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="119~125" WheelPosition="16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="126~132" WheelPosition="17" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="133~133" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="134~194" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="195~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" GoboSpin="0~0" GoboOrientation="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CS-800S RGB/CS-250S RGB" ShortName="CS-800SRGB" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="24-08-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~63" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="64~127" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="128~191" />
      <Function ID="4" Name="DMX Mode" Display="'DMX Mode'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Rotation" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="21~60" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="61~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Auto CW to CCW" Display="'Auto CW to CCW %.f%%',0~100" Dmx="101~220" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Sound CW to CCW" Display="'Sound CW to CCW %.f%%',0~100" Dmx="221~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue/Green" Display="'Blue/Green'" Dmx="0~16" Colour="0,255,255" />
      <Function ID="2" Name="Red/Blue" Display="'Red/Blue'" Dmx="17~33" Colour="255,0,255" />
      <Function ID="3" Name="Red/Green" Display="'Red/Green'" Dmx="34~50" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Red/Green/Blue" Display="'Red/Green/Blue'" Dmx="68~84" Colour="255,255,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="85~101" Colour="0,255,0" />
      <Function ID="7" Name="Red/Green/Blue" Display="'Red/Green/Blue'" Dmx="102~239" Colour="255,255,255" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~240" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="241~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Jitter" Name="Jitter" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Jitter" Display="'Jitter %.f%%',0~100" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="LZ_CS800RGB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Rot" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Jitter" ChannelOffset="6" Wheel="29" />
    </Include>
  </Mode>
</Fixture>
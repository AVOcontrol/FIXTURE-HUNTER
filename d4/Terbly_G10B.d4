  <History Date="18-08-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel count to mode names." Version="5" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added colour names, swatches palettes and highlight/lowlight." Version="6" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added product thumbnail" Version="7" />

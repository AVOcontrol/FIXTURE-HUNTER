  <History Date="05-12-06" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="07-03-13" Author="Peter Budd" Comment="Edited shutter open range to 255 and added lamp on macro." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="07-11-14" Author="Sebastian Beutel" Comment="Locate/Power On Speed 100%" />
  <History Date="31-12-14" Author="Nic Morris" Comment="Standardised conditionals.  Increased wheel resolution.  Added colour funciton index." />
  <History Date="31-12-14" Author="Nic Morris" Comment="Removed 'Colour2Func' update from 'Colour1Func'." />
  <History Date="31-12-14" Author="Nic Morris" Comment="Fixed gobo 1 rot and prism raw ranges.  Added palettes" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="26476" />

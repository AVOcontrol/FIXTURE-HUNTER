  <Thumbnail>b580962b-5442-460a-9952-0e1ed27f7485</Thumbnail>
  <History Date="16-07-19" Author="Nic Morris" Comment="Created (control channel implementation is poorly considered)" />
  <History Date="18-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="19-07-19" Author="Nic Morris" Comment="Changed white and amber to locate at full.  Fixed vdim in 6 DMX 1px 16bit mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="69f07299-415e-4de1-b7a2-d8079814e4d4" />
  <Control>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="170~253" />
      <Function ID="3" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="2~85" />
      <Function ID="4" Name="Rnd Async" Display="'Rnd Async %.f%%',0~100" Dmx="86~169" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red Shift On" Display="'Red Shift On'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="6~10" />
      <Function ID="3" Name="Dim Delay" Display="'%.fms',0~1500" Dmx="27~127" />
      <Function ID="4" Name="Pixorder Standard" Display="'Pixorder Standard'" Dmx="134~139" />
      <Function ID="5" Name="Pixorder Inverted" Display="'Pixorder Inverted'" Dmx="140~145" />
      <Function ID="6" Name="Fan Silent" Display="'Fan Silent'" Dmx="152~157" />
      <Function ID="7" Name="Fan Auto" Display="'Fan Auto'" Dmx="158~161" />
      <Function ID="8" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~173" />
      <Function ID="9" Name="Dim Square" Display="'Dim Square'" Dmx="174~179" />
      <Function ID="10" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="180~185" />
      <Function ID="11" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="186~191" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="198~203" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX (1px)" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

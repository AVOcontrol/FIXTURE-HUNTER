<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Torrent Flux" ShortName="Tor Flux" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="12-12-15" Author="Nic Morris" Comment="Revised dimmer function ranges in response to customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fe3b99eb-ef18-4c99-9b2e-6a02cc4e8233" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~10" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="25~5" Intensity="0~0" />
      <Function ID="3" Name="Rnd All" Display="'Rnd All %.f%%',0~100" Dmx="177~157" Intensity="0~0" />
      <Function ID="4" Name="Rnd Ind" Display="'Rnd Ind %.f%%',0~100" Dmx="202~182" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="51~31" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="77~57" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="102~82" Intensity="0~0" />
      <Function ID="8" Name="Burst 1" Display="'Burst 1 %.f%%',0~100" Dmx="127~107" Intensity="0~0" />
      <Function ID="9" Name="Burst 2" Display="'Burst 2 %.f%%',0~100" Dmx="152~132" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~249" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~253" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~10" Intensity="0~0" />
    </Attribute>
  </Control>

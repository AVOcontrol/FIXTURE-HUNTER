<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="X-Driver-8RGBW" ShortName="AL_X8RGBW" Company="Acclaim Lighting">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="20-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="24" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~2" Colour="255,0,0" />
      <Function ID="3" Name="Red + Grn" Display="'Red + Grn %.f%%',0~100" Dmx="3~33" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="34~34" Colour="255,255,0" />
      <Function ID="5" Name="Green + Rd" Display="'Green + Rd %.f%%',0~100" Dmx="35~65" Colour="0,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="66~69" Colour="0,255,0" />
      <Function ID="7" Name="Green + Bl" Display="'Green + Bl %.f%%',0~100" Dmx="70~100" Colour="0,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="101~101" Colour="0,255,255" />
      <Function ID="9" Name="Blue + Grn" Display="'Blue + Grn %.f%%',0~100" Dmx="102~132" Colour="0,0,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="133~136" Colour="0,0,255" />
      <Function ID="11" Name="Blue + Rd" Display="'Blue + Rd %.f%%',0~100" Dmx="137~167" Colour="0,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="168~168" Colour="255,0,255" />
      <Function ID="13" Name="Red + Bl" Display="'Red + Bl %.f%%',0~100" Dmx="169~199" Colour="255,0,0" />
      <Function ID="14" Name="Red + Grn + Bl" Display="'Red + Grn + Bl %.f%%',0~100" Dmx="200~206" Colour="255,0,0" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="207~207" Colour="255,128,255" />
      <Function ID="16" Name="Blue + Rd + Grn" Display="'Blue + Rd + Grn %.f%%',0~100" Dmx="208~210" Colour="255,150,150" />
      <Function ID="17" Name="Light Cyan" Display="'Light Cyan'" Dmx="211~211" Colour="128,255,255" />
      <Function ID="18" Name="Green + Rd + Bl" Display="'Green + Rd + Bl %.f%%',0~100" Dmx="212~228" Colour="128,255,255" />
      <Function ID="19" Name="Rd + Grn + Bl" Display="'Rd + Grn + Bl'" Dmx="229~229" Colour="0,255,0" />
      <Function ID="20" Name="Rd + Grn + Bl" Display="'Rd + Grn + Bl %.f%%',0~100" Dmx="230~232" Colour="255,100,0" />
      <Function ID="21" Name="Rd + Bl + Grn" Display="'Rd + Bl + Grn'" Dmx="233~233" Colour="255,0,255" />
      <Function ID="22" Name="Bl + Rd + Grn" Display="'Bl + Rd + Grn %.f%%',0~100" Dmx="234~251" Colour="0,0,255" />
      <Function ID="23" Name="Bl + Grn + Rd" Display="'Bl + Grn + Rd %.f%%',0~100" Dmx="252~254" Colour="0,255,255" />
      <Function ID="24" Name="Open" Display="'Open'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX, 8bit" Channels="1">
    <Import PearlRef="UK_AL8RGBW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="UK_AL8RGBW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
      <Attribute ID="White" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="UK_AL8RGBW3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="UK_AL8RGBW4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
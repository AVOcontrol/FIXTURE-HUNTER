      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="8~63" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="64~127" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="128~255" />

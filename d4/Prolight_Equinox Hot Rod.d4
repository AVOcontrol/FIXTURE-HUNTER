      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1 %.f%%',0~100" Dmx="8~67" />
      <Function ID="3" Name="Show 2" Display="'Show 2 %.f%%',0~100" Dmx="68~127" />
      <Function ID="4" Name="Show 3" Display="'Show 3 %.f%%',0~100" Dmx="128~187" />
      <Function ID="5" Name="Show 4" Display="'Show 4 %.f%%',0~100" Dmx="188~247" />
      <Function ID="6" Name="Random" Display="'Random %.f%%',0~100" Dmx="248~255" />
    </Attribute>
  </Control>

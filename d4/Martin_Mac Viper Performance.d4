<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mac Viper Performance" ShortName="Viper Perf" Company="Martin" Version="17">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>402ad5cd-3a04-45a2-a33e-e4f9282128dc</Thumbnail>
  <History Date="18-07-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="02-08-12" Author="Peter Budd" Comment="Updated to spec" Version="2" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Edited corrected Gobo 2 Func" Version="3" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Edited corrected iris locate to 0%" Version="4" />
  <History Date="28-01-13" Author="Peter Budd" Comment="Corrected Gobo function channels." Version="5" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." Version="6" />
  <History Date="24-07-13" Author="Peter Budd" Comment="Created from the Mac Viper Profile." Version="7" />
  <History Date="30-06-14" Author="stephen harris" Comment="Edited to update gobo rot resolution so 16bit rather than 0-255 on wheels" Version="8" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Increased wheel resolution for Gobo 1 Rot spin ranges, shutter strobe, zoom, focus, effect and prism rot ranges." Version="9" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Changed Gobo 1 Rot raw range to 65535.  Fixed Colour Func update so that raw colour function would work." Version="10" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Changed shutter pulse palettes to random to match associated functions." Version="11" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Changed Blade All Rot range to +/- 55 degrees." Version="12" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Changed gobo shake ranges from fixed to percentage.  Fixed spelling of 'continuous' in effect." Version="13" />
  <History Date="01-07-14" Author="Nic Morris" Comment="Standardised gobo scroll wheel direction.  Added colour function index." Version="14" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="15" />
  <History Date="08-11-17" Author="Nic Morris" Comment="Inverted zoom" Version="16" />
  <History Date="16-07-24" Author="Nic Morris" Comment="Added 35 channel 'Extended (Reduced)' mode which is the same as the Extended mode but without the reserved channels at the end.  This is not documented and technically wrong." Version="17" />
  <History Date="16-07-24" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches." Version="17" />
  <History Date="16-07-24" Author="Nic Morris" Comment="Revised colour and gobo function names.  Renamed split get to index and standardised colour functions.  Changed CTO display range to Kelvin.  Added missing macros." Version="17" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19792" />
  </RDM>

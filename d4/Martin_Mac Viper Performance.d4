  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="201~210" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:6000" PowerOn="1:6000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3200~6000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="22,23,24,25" If="'Colour1Func'==4" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="182~192" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="161~163" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="164~166" WheelPosition="2" Colour="0,200,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="167~169" WheelPosition="3" Colour="255,128,0" />
      <Function ID="5" Name="1/2 Minus Green" Display="'1/2 Minus Green'" Dmx="170~172" WheelPosition="4" Colour="255,200,255" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="173~175" WheelPosition="5" Colour="255,100,255" />
      <Function ID="7" Name="Deep Blue" Display="'Deep Blue'" Dmx="176~178" WheelPosition="6" Colour="200,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="179~181" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op - Blu" Display="'Op - Blu %.f%%',0~100" Dmx="0~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Blu - Grn" Display="'Blu - Grn %.f%%',0~100" Dmx="15~30" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="30~45" WheelPosition="2" Colour="0,200,0" />
      <Function ID="12" Name="Org - HMG" Display="'Org - HMG %.f%%',0~100" Dmx="45~60" WheelPosition="3" Colour="255,128,0" />
      <Function ID="13" Name="HMG - Mag" Display="'HMG - Mag %.f%%',0~100" Dmx="60~75" WheelPosition="4" Colour="255,200,255" />
      <Function ID="14" Name="Mag - D Blu" Display="'Mag - D Blu %.f%%',0~100" Dmx="75~90" WheelPosition="5" Colour="255,100,255" />
      <Function ID="15" Name="D Blu - Rd" Display="'D Blu - Rd %.f%%',0~100" Dmx="90~105" WheelPosition="6" Colour="200,0,255" />
      <Function ID="16" Name="Rd - Op" Display="'Rd - Op %.f%%',0~100" Dmx="105~120" WheelPosition="7" Colour="255,0,0" />
      <Function ID="17" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~120" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="22" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="23" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="24" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="0,0,0" />
      <Function ID="25" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="0,0,0" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5,6" If="'Gobo1Func'==1" />
      <Condition Name="Fixed Spin" ID="7,8,9,10,11,12" If="'Gobo1Func'==2" />
      <Condition Name="Shake Index" ID="13,14,15,16,17,18" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==4" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>cf4829ee-68d6-474a-9e3b-17892c7a39ae</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Ray Brush)" Display="'Gobo 1 (Ray Brush)'" Dmx="10~14" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">

    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Fixed Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Fixed Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="601~32130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32131~32895" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64515" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="64516~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Animation_Rot" />
      <Function ID="2" Name="Indexed" Display="'Indexed'" Dmx="11~20" Update="Animation_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="31~40" Update="Animation_Rot" />
      <Function ID="4" Name="Position 1" Display="'Position 1'" Dmx="41~50" Update="Animation_Rot" />
      <Function ID="5" Name="Position 2" Display="'Position 2'" Dmx="51~60" Update="Animation_Rot" />
      <Function ID="6" Name="Position 3" Display="'Position 3'" Dmx="61~70" Update="Animation_Rot" />
      <Function ID="7" Name="Position 4" Display="'Position 4'" Dmx="71~80" Update="Animation_Rot" />
      <Function ID="8" Name="Position 5" Display="'Position 5'" Dmx="81~90" Update="Animation_Rot" />
      <Function ID="9" Name="Position 6" Display="'Position 6'" Dmx="91~100" Update="Animation_Rot" />
      <Function ID="10" Name="Position 7" Display="'Position 7'" Dmx="101~110" Update="Animation_Rot" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Indexed" ID="2" If="'Animation'==2" />
      <Condition Name="Continuos" ID="3,4,5,6,7" If="'Animation'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin 0°" Display="'No Spin 0°'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="5" Name="No Spin (Current Position)" Display="'No Spin (Current Position)'" Dmx="127~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="253~230" />
      <Function ID="7" Name="No Spin 90°" Display="'No Spin 90°'" Dmx="254~255" />
    </Attribute>

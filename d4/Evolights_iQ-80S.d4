      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="196~209" Colour="255,128,0" />
      <Function ID="16" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="210~223" Colour="255,128,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="224~237" Colour="255,0,255" />
      <Function ID="18" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="238~255" Colour="255,0,255" />
      <Function ID="19" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />

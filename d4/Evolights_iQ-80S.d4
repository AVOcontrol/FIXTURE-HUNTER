    <Attribute ID="Gobo11" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func1'==1" />
      <Condition Name="Fixed B/O" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func1'==2" />

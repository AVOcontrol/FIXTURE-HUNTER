      <Condition Name="Index" ID="20" If="'Colour1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op/ Red" Display="'Op/ Red'" Dmx="14~27" Colour="255,255,255" />

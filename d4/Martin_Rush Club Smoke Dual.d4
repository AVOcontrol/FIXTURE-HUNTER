    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Prime" Display="'Prime'" Dmx="51~100" />
      <Function ID="3" Name="Heater Off/ Shutdown" Display="'Heater Off/ Shutdown'" Dmx="151~200" />
      <Function ID="4" Name="Heater On" Display="'Heater On'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Head 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">

  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="7000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3" Delay="7000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Reset:2" Delay="7000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="7000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="7000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:9,Colour1Func:1" />

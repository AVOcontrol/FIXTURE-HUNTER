      <Attribute ID="Reset" ChannelOffset="15" Wheel="30" />
      <Attribute ID="Lamp" ChannelOffset="16" Wheel="29" />
      <Attribute ID="PT_Speed" ChannelOffset="17" Wheel="25" />

  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="-1" TiltMaxSpeed="-1" />
    </Physical>
    <AtlaBase ModeID="a25fa291-0d8e-4516-8763-8526c5bef87b" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Reserved" ChannelOffset="7" Wheel="59" />

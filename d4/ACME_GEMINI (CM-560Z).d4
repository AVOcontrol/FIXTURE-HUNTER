<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GEMINI (CM-560Z)" ShortName="GEMINI" Company="ACME" Version="8">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>a0761f4b-6802-4ee4-af9f-2e410310c06b</Thumbnail>
  <History Date="10-03-21" Author="Nic Morris" Comment="Created (poor documentation)" Version="0" />
  <History Date="12-03-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="31-03-21" Author="Nic Morris" Comment="Revised flash dimmer, duration and rate locate values in response to manufacturer request." Version="2" />
  <History Date="06-04-21" Author="Nic Morris" Comment="Implemented flash dimmers as cells to achieve HTP dimmer behaviour in response to manufacturer feedback." Version="3" />
  <History Date="30-06-21" Author="Nic Morris" Comment="Changed name from CM-560Z to GEMINI (CM-560Z).  Updated in line with latest documentation in response to manufacturer request (revises pixel function names and adds pixel, pixel spd and colour controls to mode 1)" Version="4" />
  <History Date="01-07-21" Author="Nic Morris" Comment="Revised Atlabase ID for 58 channel mode." Version="5" />
  <History Date="25-08-21" Author="Nic Morris" Comment="Added modes 5 and 6 in line with latest information in response to manufacturer request (not currently detailed in the manua)." Version="6" />
  <History Date="25-08-21" Author="Nic Morris" Comment="(note there is no mode 4 detailed.  pixel speed is listed twice in mode 5 - named second one effect 2 spd)." Version="6" />
  <History Date="26-08-21" Author="Nic Morris" Comment="Added Atlabase ID's for modes 5 and 6." Version="7" />
  <History Date="10-11-22" Author="Nic Morris" Comment="Added mode 7 in line with latest documentation in response to manufacturer request (mode 4 is still missing and pixel speed is still listed twice in mode 5.  no pixel layout)" Version="8" />
  <Manual Filename="" Summary="" />

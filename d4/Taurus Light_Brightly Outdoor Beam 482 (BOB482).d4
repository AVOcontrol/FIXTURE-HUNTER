      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="75~79" WheelPosition="15" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="181~185" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="186~190" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="191~195" WheelPosition="3" />
      <Function ID="21" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="196~200" WheelPosition="4" />

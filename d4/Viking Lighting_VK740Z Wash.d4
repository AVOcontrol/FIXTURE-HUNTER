      <Attribute ID="Dim_Mode" ChannelOffset="8" Wheel="26" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Red" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="40" />
      <Attribute ID="Static_Macro" ChannelOffset="14" Wheel="22" />
      <Attribute ID="Moving_Macro" ChannelOffset="15" Wheel="23" />
      <Attribute ID="Macro_Spd" ChannelOffset="16" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

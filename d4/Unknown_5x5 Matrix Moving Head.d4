    <Attribute ID="FX_Control" Name="FX Control" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Numbers" Display="'Numbers'" Dmx="50~74" />
      <Function ID="3" Name="Letters" Display="'Letters'" Dmx="75~99" />
      <Function ID="4" Name="Static FX" Display="'Static FX'" Dmx="100~124" />
      <Function ID="5" Name="Dynamic FX" Display="'Dynamic FX'" Dmx="125~149" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="150~199" />

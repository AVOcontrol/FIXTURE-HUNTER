    <Attribute ID="Numbers" Name="Numbers" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="0-9" Display="'0-9 %.f%%',0~100" Dmx="0~89" />
      <Function ID="2" Name="Punctuation" Display="'Punctuation %.1f%%',0.0~100.0" Dmx="90~234" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="235~235" />
    </Attribute>
    <Attribute ID="Letters" Name="Letters" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="A-Z" Display="'A-Z %.1f%%',0.0~100.0" Dmx="0~234" />

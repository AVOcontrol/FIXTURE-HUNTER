    <Attribute ID="Static_FX" Name="Static FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Static Gobos" Display="'Static Gobos %.1f%%',0.0~100.0" Dmx="0~234" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="235~235" />

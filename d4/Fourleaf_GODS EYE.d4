      <Function ID="7" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="43~47" />
      <Function ID="8" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="48~52" />
      <Function ID="9" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="53~55" />
      <Function ID="10" Name="S-Curve 1" Display="'S-Curve 1'" Dmx="58~62" />
      <Function ID="11" Name="S-Curve 2" Display="'S-Curve 2'" Dmx="63~67" />
      <Function ID="12" Name="S-Curve 3" Display="'S-Curve 3'" Dmx="68~72" />
      <Function ID="13" Name="Col Bal Off" Display="'Col Bal Off'" Dmx="73~77" />
      <Function ID="14" Name="Col Bal On" Display="'Col Bal On'" Dmx="78~82" />
      <Function ID="15" Name="PWM 600Hz" Display="'PWM 600Hz'" Dmx="168~188" />
      <Function ID="16" Name="PWM 1200Hz" Display="'PWM 1200Hz'" Dmx="189~199" />
      <Function ID="17" Name="PWM 2400Hz" Display="'PWM 2400Hz'" Dmx="200~210" />
      <Function ID="18" Name="PWM 4800Hz" Display="'PWM 4800Hz'" Dmx="211~221" />
      <Function ID="19" Name="PWM 9600Hz" Display="'PWM 9600Hz'" Dmx="222~232" />
      <Function ID="20" Name="Reset Default" Display="'Reset Default'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~255" />
    </Attribute>
  </Control>

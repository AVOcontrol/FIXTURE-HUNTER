<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SG IPLEDPIXB" ShortName="IP PIXB" Company="Sagitter">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-03-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="W" Display="'W'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="R+W" Display="'R+W'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="G+W" Display="'G+W'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="B+W" Display="'B+W'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="R+B+W" Display="'R+B+W'" Dmx="224~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto_Speed" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Module_Select" Name="Module Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1,2,3 ON" Display="'1,2,3 ON'" Dmx="0~0" />
      <Function ID="2" Name="1 ON" Display="'1 ON'" Dmx="5~34" />
      <Function ID="3" Name="2 ON" Display="'2 ON'" Dmx="35~64" />
      <Function ID="4" Name="3 ON" Display="'3 ON'" Dmx="65~94" />
      <Function ID="5" Name="1,2 ON" Display="'1,2 ON'" Dmx="95~124" />
      <Function ID="6" Name="1,3 ON" Display="'1,3 ON'" Dmx="125~154" />
      <Function ID="7" Name="2,3 ON" Display="'2,3 ON'" Dmx="155~184" />
      <Function ID="8" Name="1,2,3 ON" Display="'1,2,3 ON'" Dmx="185~214" />
      <Function ID="9" Name="1,2,3 OFF" Display="'1,2,3 OFF'" Dmx="215~244" />
      <Function ID="10" Name="Convert to 11CH-2" Display="'Convert to 11CH-2'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter 1" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter 2" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter3" Name="Shutter 3" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Generic3" Name="Dim Speed 1" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic4" Name="Dim Speed 2" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic5" Name="Dim Speed 3" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

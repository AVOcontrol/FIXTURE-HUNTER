      <Function ID="15" Name="D Rd/ D Blu" Display="'D Rd/ D Blu'" Dmx="13~17" WheelPosition="1" Colour="180,0,0" />
      <Function ID="16" Name="D Blu/ Yel" Display="'D Blu/ Yel'" Dmx="23~27" WheelPosition="2" Colour="0,0,180" />

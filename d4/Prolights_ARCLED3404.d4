    <Attribute ID="Pixel_Select" Name="Pixel Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Pix 1 Static" Display="'Pix 1 Static'" Dmx="10~19" />
      <Function ID="3" Name="Pix 2 Static" Display="'Pix 2 Static'" Dmx="20~29" />
      <Function ID="4" Name="Pix 3 Static" Display="'Pix 3 Static'" Dmx="30~39" />
      <Function ID="5" Name="Pix 4 Static" Display="'Pix 4 Static'" Dmx="40~49" />
      <Function ID="6" Name="Pix 1, 2 Static" Display="'Pix 1, 2 Static'" Dmx="50~59" />
      <Function ID="7" Name="Pix 1, 3 Static" Display="'Pix 1, 3 Static'" Dmx="60~69" />
      <Function ID="8" Name="Pix 1, 4 Static" Display="'Pix 1, 4 Static'" Dmx="70~79" />
      <Function ID="9" Name="Pix 2, 3 Static" Display="'Pix 2, 3 Static'" Dmx="80~89" />
      <Function ID="10" Name="Pix 2, 4 Static" Display="'Pix 2, 4 Static'" Dmx="90~99" />
      <Function ID="11" Name="Pix 3, 4 Static" Display="'Pix 3, 4 Static'" Dmx="100~109" />

      <Function ID="13" Name="Pix 1, 2, 4 Static" Display="'Pix 1, 2, 4 Static'" Dmx="120~129" />
      <Function ID="14" Name="Pix 1, 3, 4 Static" Display="'Pix 1, 3, 4 Static'" Dmx="130~139" />
      <Function ID="15" Name="Pix 2, 3, 4 Static" Display="'Pix 2, 3, 4 Static'" Dmx="140~149" />
      <Function ID="16" Name="Pix 1, 2, 3, 4 Static" Display="'Pix 1, 2, 3, 4 Static'" Dmx="150~159" />
      <Function ID="17" Name="Left - Right" Display="'Left - Right %.f%%',0~100" Dmx="160~179" />
      <Function ID="18" Name="Right - Left" Display="'Right - Left %.f%%',0~100" Dmx="180~199" />
      <Function ID="19" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="200~219" />
      <Function ID="20" Name="Random" Display="'Random %.f%%',0~100" Dmx="220~239" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">

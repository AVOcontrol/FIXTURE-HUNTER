  <AtlaBase TypeID="88d3fb39-36a9-4442-ac4b-8f5cfb8c3b08" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Functions" Name="Functions" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="36~45" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="46~55" />
      <Function ID="4" Name="Col Selection" Display="'Col Selection'" Dmx="56~65" />
      <Function ID="5" Name="Col Jump" Display="'Col Jump'" Dmx="66~75" />
      <Function ID="6" Name="Gradient" Display="'Gradient'" Dmx="76~85" />
      <Function ID="7" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="86~245" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Pattern_Sel" Name="Pattern Sel" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern/Spd" Name="Pattern/Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Cartoon Auto" Display="'Cartoon Auto'" Dmx="10~59" />
      <Function ID="3" Name="Beam Auto" Display="'Beam Auto'" Dmx="60~109" />
      <Function ID="4" Name="Beam Auto" Display="'Beam Auto'" Dmx="110~159" />
      <Function ID="5" Name="Cartoon Auto" Display="'Cartoon Auto'" Dmx="160~209" />
      <Function ID="6" Name="DMX" Display="'DMX'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="10~15" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="16~23" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="24~31" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="40~47" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~55" Colour="0,0,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="56~63" Colour="255,0,255" />
      <Function ID="9" Name="Change" Display="'Change %.f%%',0~100" Dmx="64~127" Colour="255,255,255" />
      <Function ID="10" Name="Multi" Display="'Multi %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="11" Name="Fading" Display="'Fading %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">

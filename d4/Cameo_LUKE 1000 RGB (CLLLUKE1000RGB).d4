      <Function ID="2" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="128~159" />
      <Function ID="3" Name="Bounce 2" Display="'Bounce 2 %.f%%',0~100" Dmx="160~191" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="223~192" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="224~255" />

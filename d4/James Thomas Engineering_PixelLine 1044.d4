<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PixelLine 1044" ShortName="Pixel 1044" Company="James Thomas Engineering">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-02-05" Author="Dave Trounce" Comment="Error 1: Invert Chase Speed and Chase xFade?" />
  <History Date="15-02-05" Author="Dave Trounce" Comment="Error 2: Ex-61 channels 55-62 seem to be odd" />
  <History Date="17-02-05" Author="Phil" Comment="Inverted legends on cross fade and speed." />
  <History Date="18-02-05" Author="Phil" Comment="Fixed Speed locate values." />
  <History Date="21-03-05" Author="Phil" Comment="Fixed Ex-61 mode - worked with MInt off, but not on. Adding extra mode." />
  <History Date="12-04-06" Author="Ed Spencer" Comment="Moved all Speeds into special group" />
  <History Date="30-04-07" Author="D.Milligan" Comment="Fixed Colour Picker in Max 2 mode" />
  <History Date="17-07-07" Author="D.Milligan" Comment="Removed RGB OnClear value" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from James Thomas to James Thomas Engineering" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed attribute IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Palettes" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Mode" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Wheel assignment Numbers" />
  <History Date="11-06-09" Author="David Hunt" Comment="Changed Speed from type special to type effect" />
  <History Date="02-09-09" Author="Jonathan Moreton" Comment="changed Pearl Ref for Max 2 Mode" />
  <History Date="11-11-09" Author="Gregory" Comment="Fixed preset palettes" />
  <History Date="27-08-10" Author="John Rogers" Comment="Added GenRGBLTP as Classic Pearl Reference for 1 Cell + VDim mode." />
  <History Date="12-02-11" Author="Nic Morris" Comment="Removed AllRed,AllGreen,AllBlue as were obsolete" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Removed non-vdim mode.  Added vdim to non dim modes" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Fixed highlight, power on and locate" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Removed clear values" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Increased wheel resolutions" />
  <History Date="14-06-11" Author="Nic Morris" Comment="Added pixel mapper compatibility.  Fixed palettes." />
  <History Date="30-08-11" Author="Nic Morris" Comment="Removed dimmer attribute link from multi-cell modes with master intensity." />
  <History Date="30-08-11" Author="Nic Morris" Comment="Changed 18 Cells + Dimmer to use cells with virtual dimmers." />
  <History Date="11-05-12" Author="Gregory Haynes" Comment="Removed virtual dimmer from cells in modes where there is a master dimmer" />
  <History Date="10-10-12" Author="Peter Budd" Comment="Edited added 9 Cell + EFD mode" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="26-10-17" Author="Nic Morris" Comment="Revised mode names.  Added missing RGB channels to EF D mode.  Added Atlabase ID's." />
  <History Date="26-10-17" Author="Nic Morris" Comment="Added missing MINT oN mode options.  Revised all pixel modes to use vdim and added master dimmer where appropriate." />
  <History Date="26-10-17" Author="Nic Morris" Comment="Revised FX function names, added missing functions and unified across the two effect controls." />
  <History Date="26-10-17" Author="Nic Morris" Comment="Changed name from Pixel Line 1044 to PixelLine 1044" />
  <History Date="30-10-17" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <Manual Filename="/manual/MartinMAC 500.pdf" Summary="Created:Martin, 18/05/2001" />

  <History Date="30-12-21" Author="Nic Morris" Comment="Added combined modes.  Added Atlabase IDs (currently combined modes only)" Version="2" />
  <History Date="31-12-21" Author="Nic Morris" Comment="Created from Sportsbeams Chromabeams LED 350" Version="6" />
  <History Date="05-01-22" Author="Nic Morris" Comment="Added Atlabase IDs (currently combined modes only)" Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="40404306-6059-45e7-a3cb-f37068d50e15" />
  <Control>
    <Attribute ID="Red" Name="Red/Param 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CTO" ID="2" If="'Mode7DMXCombined'==2" />
      <Condition Name="No Function" ID="3" If="'Mode7DMXCombined'==1" />
      <Else ID="1" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="3" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green/Param 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Dimmer" ID="2" If="'Mode7DMXCombined'==2" />
      <Condition Name="No Function" ID="3" If="'Mode7DMXCombined'==1" />
      <Else ID="1" />
      <Function ID="2" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue/Param 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Mode7DMXCombined'&lt;3" />
      <Else ID="1" />
      <Function ID="2" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White/Param 4" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Hue" ID="2" If="'Mode7DMXCombined'==1" />
      <Condition Name="No Function" ID="3" If="'Mode7DMXCombined'==2" />
      <Else ID="1" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber/Param 5" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Saturation" ID="2" If="'Mode7DMXCombined'==1" />
      <Condition Name="No Function" ID="3" If="'Mode7DMXCombined'==2" />
      <Else ID="1" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="No Function" ID="2" If="'Mode7DMXCombined'&gt;1" />
      <Else ID="1" />
      <Function ID="2" Name="No Function" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue/CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTO" ID="2" If="'Mode4DMXCombined'==2" />
      <Else ID="1" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="No Function" ID="2" If="'Mode4DMXCombined'==2" />
      <Else ID="1" />
      <Function ID="2" Name="No Function" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Mode4DMXM1" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="4 DMX (Mode 1)" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Mode4DMXM2" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="4 DMX (Mode 2)" Display="''" Dmx="32~63" />
    </Attribute>
    <Attribute ID="Mode7DMXM1" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="7 DMX (Mode 1)" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Mode7DMXM2" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="7 DMX (Mode 2)" Display="''" Dmx="32~63" />
    </Attribute>
    <Attribute ID="Mode7DMXM3" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="7 DMX (Mode 3)" Display="''" Dmx="64~96" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode4DMXCombined" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1 (HSB)" Display="'Mode 1 (HSB)'" Dmx="0~0" Update="Hue, Saturation" />
      <Function ID="2" Name="Mode 2 (CCT)" Display="'Mode 2 (CCT)'" Dmx="32~63" Update="Hue, Saturation" />
    </Attribute>
    <Attribute ID="Mode7DMXCombined" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1 (HSB)" Display="'Mode 1 (HSB)'" Dmx="0~0" Update="Red, Green, Blue, White, Amber, Dimmer" />
      <Function ID="2" Name="Mode 2 (CCT)" Display="'Mode 2 (CCT)'" Dmx="32~63" Update="Red, Green, Blue, White, Amber, Dimmer" />
      <Function ID="3" Name="Mode 3 (RGBWA)" Display="'Mode 3 (RGBWA)'" Dmx="64~96" Update="Red, Green, Blue, White, Amber, Dimmer" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="XR3000 Spot CMY" ShortName="XR 3KSpCMY" Company="DTS">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="26-11-10" Author="John Rogers" Comment="Created" />
  <History Date="10-12-10" Author="John Rogers" Comment="Added detailed DMX ranges for Gobo and Colour wheels." />
  <History Date="09-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="04-07-12" Author="Peter Budd" Comment="Updated shutter locate value" />
  <History Date="28-03-13" Author="Peter Budd" Comment="Corrected 22 DMX range by adding new colour and iris attributes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-05-16" Author="Gregory Haynes" Comment="Fixed Else condition in Gobo1Rot and renamed Gobo attributes to Gobo 1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dceb9f06-f4b9-4887-a11a-9fb1cf5a2772" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~39" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="60~79" Intensity="0~0" />
      <Function ID="4" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~7.0" Dmx="80~139" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~179" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="180~219" Intensity="0~0" />
      <Function ID="7" Name="Col Gobo BO" Display="'Colour &amp; Gobo Blackout'" Dmx="220~227" Intensity="0~0" />
      <Function ID="8" Name="P/T BO" Display="'Pan/Tilt      Blackout'" Dmx="228~233" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="234~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour_Mode'==1" />
      <Condition Name="Split Gel" ID="9,10,11,12,13,14,15,16,17" If="'Colour_Mode'==2" />
      <Condition Name="Index" ID="18,19" If="'Colour_Mode'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour_Mode'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="32~63" Colour="255,209,179" />
      <Function ID="3" Name="Congo" Display="'Congo'" Dmx="64~95" Colour="0,0,128" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="96~127" Colour="255,128,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="160~191" Colour="255,0,0" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="192~223" Colour="0,0,240" />
      <Function ID="8" Name="Amber" Display="'Amber'" Dmx="224~255" Colour="255,128,64" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~27" Colour="255,255,255" />
      <Function ID="10" Name="Op/CTO" Display="'Op/CTO %.f%%',0~100" Dmx="28~55" Colour="255,255,255" />
      <Function ID="11" Name="CTO/Congo" Display="'CTO/Congo %.f%%',0~100" Dmx="56~83" Colour="255,209,179" />
      <Function ID="12" Name="Congo/Orange" Display="'Congo/Orange %.f%%',0~100" Dmx="84~111" Colour="0,0,128" />
      <Function ID="13" Name="Orange/Green" Display="'Orange/Green %.f%%',0~100" Dmx="112~139" Colour="255,128,0" />
      <Function ID="14" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="140~167" Colour="0,255,0" />
      <Function ID="15" Name="Red/Dk Bl" Display="'Red/Dk Bl %.f%%',0~100" Dmx="168~195" Colour="255,0,0" />
      <Function ID="16" Name="Dk Bl/Amber" Display="'Dk Bl/Amber %.f%%',0~100" Dmx="196~223" Colour="0,0,240" />
      <Function ID="17" Name="Amber/Op" Display="'Amber/Op %.f%%',0~100" Dmx="224~255" Colour="255,128,64" />
      <Function ID="18" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="19" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="0,0,0" />
      <Function ID="20" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="10~127" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="128~137" Colour="255,255,255" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="138~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="64~127" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="128~191" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="192~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />

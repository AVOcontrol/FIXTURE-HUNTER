    </Attribute>
    <Attribute ID="Shape_Sel" Name="Shape Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shape" Display="'No Shape'" Dmx="0~0" Update="Shape_Spd" />
      <Function ID="2" Name="Pixel 1 " Display="'Pixel 1'" Dmx="8~8" Update="Shape_Spd" />
      <Function ID="3" Name="Ring 1" Display="'Ring 1'" Dmx="9~9" Update="Shape_Spd" />
      <Function ID="4" Name="Ring 2" Display="'Ring 2'" Dmx="10~10" Update="Shape_Spd" />
      <Function ID="5" Name="Ring 1 + Ring 2" Display="'Ring 1 + Ring 2'" Dmx="11~11" Update="Shape_Spd" />

      <Function ID="10" Name="Filled Ring" Display="'Filled Ring'" Dmx="16~16" Update="Shape_Spd" />
      <Function ID="11" Name="Open/Close 1" Display="'Open/Close 1'" Dmx="17~17" Update="Shape_Spd" />
      <Function ID="12" Name="Open/Close 2" Display="'Open/Close 2'" Dmx="18~18" Update="Shape_Spd" />

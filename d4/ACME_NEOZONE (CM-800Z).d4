      <Function ID="7" Name="Pixel 1 + Ring 2" Display="'Pixel 1 + Ring 2'" Dmx="13~13" Update="Shape_Spd" />
      <Function ID="8" Name="Ring 1 + Ring 2" Display="'Ring 1 + Ring 2'" Dmx="14~14" Update="Shape_Spd" />

      </Function>
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Stepped" Display="'Stepped %.f%%',0~100" Dmx="199~180" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~228" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="229~255" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

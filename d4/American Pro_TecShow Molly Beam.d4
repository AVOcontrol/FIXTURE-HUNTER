  <Thumbnail>969f4ac6-d971-4bca-8464-e730e025cc76</Thumbnail>
  <History Date="07-04-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="09-04-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="29-04-25" Author="Nic Morris" Comment="Created from KIMU 200W Beam Light+Strip (identical)" Version="2" />
  <History Date="30-04-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7fb1df7a-ba97-421b-bd65-382c694d581a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="3,4" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="5,6,7,8" If="'Colour1Func'==3" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.f%%',0~100" Dmx="10~79" Colour="0,0,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="Split Col" Display="'Split Col %.f%%',0~100" Dmx="80~139" Colour="0,0,0" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~197" Colour="0,0,0" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="198~255" Colour="0,0,0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="3,4" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="5,6,7,8" If="'Gobo1Func'==3" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="6~71" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="4" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="72~143" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="144~199" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="8" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="100~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colourful" Name="Colourful" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colourful" Display="'Colourful'" Dmx="127~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="30~59" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="60~89" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="90~119" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="120~149" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="150~179" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="180~209" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="210~239" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto Detect Pan" Display="'Auto Detect Pan'" Dmx="21~100" />
      <Function ID="3" Name="Auto Detect Tilt" Display="'Auto Detect Tilt'" Dmx="101~200" />
      <Function ID="4" Name="Auto Detect P/T" Display="'Auto Detect P/T'" Dmx="201~249" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Strip_FX" Name="Strip FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="5~74" />
      <Function ID="3" Name="Effect" Display="'Effect'" Dmx="75~248" />
      <Function ID="4" Name="Random Effect" Display="'Random Effect'" Dmx="249~255" />
    </Attribute>
    <Attribute ID="Strip_FX_Spd" Name="Strip FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15" Id="6662e254-58b3-4971-a568-5c4a2f07d6fb">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="200" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="79208a0c-7e63-47f1-88d6-1f4b7d8d63da" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Colour1Func" Wheel="7" />

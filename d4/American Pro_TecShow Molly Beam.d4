      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Colourful" ChannelOffset="11" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="12" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Strip_FX" ChannelOffset="14" Wheel="52" />
      <Attribute ID="Strip_FX_Spd" ChannelOffset="15" Wheel="53" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13" Id="60268562-7c0c-469b-89e4-583de3d87916">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="200" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cf3a8d6f-57f0-42a6-9306-9aa85bdf464a" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />

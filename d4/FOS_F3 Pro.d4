  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter_Mode" Name="Shutter Mode" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe (1)" Display="'Strobe (1)'" Dmx="129~171" />
      <Function ID="4" Name="Strobe (2)" Display="'Strobe (2)'" Dmx="215~244" />
      <Function ID="5" Name="Ramp Up" Display="'Ramp Up'" Dmx="172~214" />
      <Function ID="6" Name="Ramp Down" Display="'Ramp Down'" Dmx="17~42" />
      <Function ID="7" Name="Ramp Up Down" Display="'Ramp Up Down'" Dmx="86~128" />
      <Function ID="8" Name="Pulse" Display="'Pulse'" Dmx="43~85" />
    </Attribute>
    <Attribute ID="Shutter_Spd" Name="Shutter Spd" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="5~50" Colour="0,0,0" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="51~100" Colour="0,0,0" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="101~150" Colour="0,0,0" />
      <Function ID="5" Name="Macro Combined" Display="'Macro Combined'" Dmx="151~200" Colour="0,0,0" />

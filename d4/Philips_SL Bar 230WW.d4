  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer1" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Program" Display="'Program %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade_Time" Name="Fade Time" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade Time" Display="'Fade Time %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lamp_Mode" Name="Lamp Mode" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lamp Mode" Display="'Lamp Mode %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Play_Mode" Name="Play Mode" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Play Mode" Display="'Play Mode %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Cell" Channels="1" Hidden="True">

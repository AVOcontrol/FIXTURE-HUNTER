<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Legend 412Z" ShortName="Legend412Z" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-11-11" Author="Nic Morris" Comment="Created" />
  <History Date="26-01-12" Author="Nic Morris" Comment="Fixed P/T Macro in response to customer and manufacturer.  Original documentation was wrong." />
  <History Date="17-02-12" Author="Peter Budd" Comment="Edited added extra strobe ranges" />
  <History Date="15-11-13" Author="Peter Budd" Comment="Created from the Chauvet Legend 412." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="02-02-15" Author="Nic Morris" Comment="Added master dimmer to 31 dmx mode in response to customer bug report" />
  <History Date="02-02-15" Author="Nic Morris" Comment="Inverted PT Speed wheel direction." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-03-17" Author="Nic Morris" Comment="Added 'Zoom Presets' function to control attribute in line with charts rev. 4." />
  <History Date="16-03-17" Author="Nic Morris" Comment="Moved Colour Macro and Col Mac Spd into effect group and wheel slot." />
  <History Date="16-03-17" Author="Nic Morris" Comment="Added vdim to 27 DMX cells.  Changed dimmer to master dimmer in 27 DMX and 34 DMX modes.  Added dimmer links to cells." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="371e2f8b-02ae-4bc5-a3a8-12c92c80e7ea" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~39" Intensity="0~0" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="40~59" Intensity="0~0" />
      <Function ID="5" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="60~79" Intensity="0~0" />
      <Function ID="6" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="80~99" Intensity="0~0" />
      <Function ID="7" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="100~119" Intensity="0~0" />
      <Function ID="8" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="120~139" Intensity="0~0" />
      <Function ID="9" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="140~159" Intensity="0~0" />
      <Function ID="10" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="160~179" Intensity="0~0" />
      <Function ID="11" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="180~199" Intensity="0~0" />
      <Function ID="12" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="200~219" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="20~29" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="30~39" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="40~49" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="50~59" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="60~69" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="70~79" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="80~89" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="90~99" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="100~109" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="110~119" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="120~129" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="130~139" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="140~149" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="150~159" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="160~169" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="170~179" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="180~189" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="190~199" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="200~209" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="210~219" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="220~229" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="230~239" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="8~69" />
      <Function ID="3" Name="Reset All" Display="'Reset All'" Dmx="70~129" />
      <Function ID="4" Name="Move in Dark" Display="'Move in Dark'" Dmx="130~190" />
      <Function ID="5" Name="Zoom Presets" Display="'Zoom Presets'" Dmx="191~205" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="36~42" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="8" Name="RGB Chase" Display="'RGB Chase'" Dmx="43~49" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="9" Name="B/Cy/Mag Chase" Display="'B/Cy/Mag Chase'" Dmx="50~57" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="10" Name="M/Y/Wht Chase" Display="'M/Y/Wht Chase'" Dmx="58~64" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="11" Name="Y/M Chase" Display="'Y/M Chase'" Dmx="65~71" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="12" Name="Black/Blue Chase" Display="'Black/Blue Chase'" Dmx="72~78" Update="Col_Mac_Spd" Colour="255,255,255" />

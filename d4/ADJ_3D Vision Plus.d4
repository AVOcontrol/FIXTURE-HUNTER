      <Function ID="16" Name="R/Cy Fade" Display="'R/Cy Fade'" Dmx="100~106" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="17" Name="G/M Fade" Display="'G/M Fade'" Dmx="107~113" Update="Col_Mac_Spd" Colour="255,255,255" />

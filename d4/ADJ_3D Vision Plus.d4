      <Function ID="20" Name="Sound Green" Display="'Sound Green'" Dmx="128~134" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="21" Name="Sound Blue" Display="'Sound Blue'" Dmx="135~141" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="22" Name="Sound Yellow" Display="'Sound Yellow'" Dmx="142~148" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="23" Name="Sound Cyan" Display="'Sound Cyan'" Dmx="149~155" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="24" Name="Sound Magenta" Display="'Sound Magenta'" Dmx="156~162" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="25" Name="Sound RGB Chase" Display="'Sound RGB Chase'" Dmx="163~169" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="26" Name="Sound B/C/M Chase" Display="'Sound B/C/M Chase'" Dmx="170~177" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="27" Name="Sound M/Y/Wht Chase" Display="'Sound M/Y/Wht Chase'" Dmx="178~184" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="28" Name="Sound Y/M Chase" Display="'Sound Y/M Chase'" Dmx="185~191" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="29" Name="Sound Black/Blue Chase" Display="'Sound Black/Blue Chase'" Dmx="192~198" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="30" Name="Sound RGB Fade" Display="'Sound RGB Fade'" Dmx="199~205" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="31" Name="Sound RGBYCMW Fade" Display="'Sound RGBYCMW Fade'" Dmx="206~212" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="32" Name="Sound Y/B Chase" Display="'Sound Y/B Chase'" Dmx="213~219" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="33" Name="Sound R/Cy Chase" Display="'Sound R/Cy Chase'" Dmx="220~226" Update="Col_Mac_Spd" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="WH180W LED Wall Wash" ShortName="WH180W" Company="BeamZ">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>01dd1dd1-2657-4a89-9328-854da81fd83b</Thumbnail>
  <History Date="07-02-19" Author="Nic Morris" Comment="Created (documentation is a mess)" />
  <History Date="09-02-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="65df722c-61d4-4a2d-8345-795f04a1eaca" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="206~255" />
      <Function ID="3" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="6~55" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="56~105" />
      <Function ID="5" Name="Equal" Display="'Equal %.f%%',0~100" Dmx="106~155" />
      <Function ID="6" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="156~205" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Fade 1" Display="'Fade 1'" Dmx="11~40" Update="Auto_Spd" />
      <Function ID="3" Name="Fade 2" Display="'Fade 2'" Dmx="41~70" Update="Auto_Spd" />
      <Function ID="4" Name="Fade 3" Display="'Fade 3'" Dmx="71~100" Update="Auto_Spd" />
      <Function ID="5" Name="Skip 1" Display="'Skip 1'" Dmx="101~130" Update="Auto_Spd" />
      <Function ID="6" Name="Skip 2" Display="'Skip 2'" Dmx="131~160" Update="Auto_Spd" />
      <Function ID="7" Name="Skip 3" Display="'Skip 3'" Dmx="161~190" Update="Auto_Spd" />
      <Function ID="8" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="191~220" Update="Auto_Spd" />
      <Function ID="9" Name="Sound Skip" Display="'Sound Skip'" Dmx="221~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'&gt;7" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="21~40" />
      <Function ID="3" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="41~60" />
      <Function ID="4" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="61~80" />
      <Function ID="5" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="81~100" />
      <Function ID="6" Name="High Temp Half Power Off" Display="'High Temp Half Power Off'" Dmx="150~155" />
      <Function ID="7" Name="High Temp Half Power On" Display="'High Temp Half Power On'" Dmx="200~205" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cf010115-78f4-404c-b3c0-7c33cdac3fc4" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6b49251a-54a8-43d9-9d30-256af6722cb9" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
        <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="4" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="25ed424d-bdd3-4df7-8b78-45c6cd45ee56" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="7" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="4" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="High Temp Half Power Off">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="High Temp Half Power On">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <swatchLibrary>
    <Swatch id="01dd1dd1-2657-4a89-9328-854da81fd83b"></Swatch>
  </swatchLibrary>
</Fixture>
    <AtlaBase ModeID="0bf865b1-5215-4e9a-bfab-295c08a522b8" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="ColdWhite" Wheel="10" />
        <Attribute ID="WarmWhite" Wheel="11" />

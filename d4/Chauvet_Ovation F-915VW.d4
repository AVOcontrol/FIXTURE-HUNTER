      <Function ID="10" Name="Dim Spd Mode 1" Display="'Dim Spd Mode 1'" Dmx="72~79" />
      <Function ID="11" Name="Dim Spd Mode 2" Display="'Dim Spd Mode 2'" Dmx="80~87" />
      <Function ID="12" Name="Dim Spd Mode 3" Display="'Dim Spd Mode 3'" Dmx="88~95" />
      <Function ID="13" Name="Fan Auto" Display="'Fan Auto'" Dmx="96~103" />
      <Function ID="14" Name="Fan On" Display="'Fan On'" Dmx="104~111" />
      <Function ID="15" Name="Fan Off" Display="'Fan Off'" Dmx="112~119" />
      <Function ID="16" Name="Fan Silent" Display="'Fan Silent'" Dmx="120~127" />

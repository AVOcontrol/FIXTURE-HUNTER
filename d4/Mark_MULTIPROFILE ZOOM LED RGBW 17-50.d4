      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="50~99" />
      <Function ID="3" Name="Col Change w/xFade" Display="'Col Change w/xFade'" Dmx="100~149" />
      <Function ID="4" Name="Col Change w/Fade" Display="'Col Change w/Fade'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

  <History Date="12-07-13" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Removed colour index functions at manufacturer request and changed prism to locate at zero in attempt to fix bug report." Version="2" />
  <History Date="14-04-16" Author="Nic Morris" Comment="Added missing Raw DMX option from Gobo 1 Func in response to manufacturer bug report." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="4" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created from Terbly PT320B" Version="5" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created from Terbly PT322S" Version="6" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created from Terbly G9B" Version="7" />
  <History Date="26-05-16" Author="Nic Morris" Comment="Fixed colour locate and colour else functions in response to manufacturer bug report." Version="8" />
  <History Date="26-05-16" Author="Nic Morris" Comment="Changed zoom, focus and frost wheel locations in response to manufacturer request." Version="9" />
  <History Date="02-06-16" Author="Nic Morris" Comment="Added AutoFocus discreet functions in line with revised documentation in response to manufacturer request." Version="10" />
  <History Date="15-08-17" Author="Nic Morris" Comment="Added highlight/lowlight.  Added colour swatches.  Recreated palettes." Version="11" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Added product thumbnail.  Revised colours in response to manufacturer request (charts are wrong)." Version="12" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Added gobo swatches" Version="13" />
  <History Date="04-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="15" />

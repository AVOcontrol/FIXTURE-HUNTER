  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="I">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Patt_Group, Pattern, Text_Colour, Text_Drawing, Text_Zoom, Text_Zoom_Spd, Text_Y_Rot, Text_X_Rot, Text_Z_Rot, Text_Wave_Spd, Text_Wave_Freq, Text_Wave_Size,Text_Y_Rot_Spd,Text_X_Rot_Spd,Text_Z_Rot_Spd, Text_X_Pos, Text_Y_Pos, Text_X_Pos_Spd, Text_Y_Pos_Spd" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~49" Update="Patt_Group, Pattern, Text_Colour, Text_Drawing, Text_Zoom, Text_Zoom_Spd, Text_Y_Rot, Text_X_Rot, Text_Z_Rot, Text_Wave_Spd, Text_Wave_Freq, Text_Wave_Size,Text_Y_Rot_Spd,Text_X_Rot_Spd,Text_Z_Rot_Spd, Text_X_Pos, Text_Y_Pos, Text_X_Pos_Spd, Text_Y_Pos_Spd" />

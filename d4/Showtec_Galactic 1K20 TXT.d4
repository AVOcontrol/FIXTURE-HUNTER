      <Function ID="4" Name="Text" Display="'Text'" Dmx="100~149" Update="Patt_Group, Pattern, Text_Colour, Text_Drawing, Text_Zoom, Text_Zoom_Spd, Text_Y_Rot, Text_X_Rot, Text_Z_Rot, Text_Wave_Spd, Text_Wave_Freq, Text_Wave_Size,Text_Y_Rot_Spd,Text_X_Rot_Spd,Text_Z_Rot_Spd, Text_X_Pos, Text_Y_Pos, Text_X_Pos_Spd, Text_Y_Pos_Spd" />
      <Function ID="5" Name="BG Pattern" Display="'BG Pattern'" Dmx="150~199" Update="Patt_Group, Pattern, Text_Colour, Text_Drawing, Text_Zoom, Text_Zoom_Spd, Text_Y_Rot, Text_X_Rot, Text_Z_Rot, Text_Wave_Spd, Text_Wave_Freq, Text_Wave_Size,Text_Y_Rot_Spd,Text_X_Rot_Spd,Text_Z_Rot_Spd, Text_X_Pos, Text_Y_Pos, Text_X_Pos_Spd, Text_Y_Pos_Spd" />

  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',100.0~0.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="15" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="16" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="2" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="50~59" />
      <Function ID="3" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="60~69" />
      <Function ID="4" Name="BO P/T" Display="'BO P/T'" Dmx="70~79" />
      <Function ID="5" Name="Disable BO P/T" Display="'Disable BO P/T'" Dmx="80~89" />
      <Function ID="6" Name="Theatre Mode ON" Display="'Theatre Mode  ON'" Dmx="90~99" />
      <Function ID="7" Name="Theatre Mode OFF" Display="'Theatre Mode  OFF'" Dmx="100~109" />
      <Function ID="17" Name="Zoom Wash" Display="'Zoom Wash'" Dmx="110~114" />
      <Function ID="18" Name="Zoom Beam" Display="'Zoom Beam'" Dmx="115~119" />
      <Function ID="8" Name="Reserved" Display="'Reserved %.f',120~139" Dmx="120~139" />
      <Function ID="9" Name="Reset PT" Display="'Reset PT'" Dmx="140~149" />
      <Function ID="10" Name="Reserved" Display="'Reserved %.f',150~179" Dmx="150~179" />
      <Function ID="11" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="12" Name="Reserved" Display="'Reserved %.f',190~199" Dmx="190~199" />
      <Function ID="13" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="14" Name="Reserved" Display="'Reserved %.f',210~255" Dmx="210~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White1" Name="White 1" Description="" Group="C" Size="2">

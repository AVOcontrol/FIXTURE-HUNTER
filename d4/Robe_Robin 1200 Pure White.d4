  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="31-03-11" Author="John Rogers" Comment="Created" />
  <History Date="26-04-11" Author="John Rogers" Comment="Edited Colour Macro to become LED Zone Effects channel in response to Robe." />
  <History Date="09-09-11" Author="John Rogers" Comment="Edited Zone Effects to locate to DMX 0." />
  <History Date="29-10-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Changed Control Safe function to text only." />
  <History Date="29-10-11" Author="Nic Morris" Comment="Added pixel mapper compatibility.  Added missing macros." />
  <History Date="08-03-12" Author="Peter Budd" Comment="Created from Robe Robin 600 Pure White" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information." />
  <History Date="27-08-13" Author="Peter Budd" Comment="Updated to latest Robe Specification." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />

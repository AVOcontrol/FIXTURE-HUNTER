<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AuraProfile 200WW LED" ShortName="AuraPro200" Company="Encore Professional">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-04-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Curve 1" Display="'Curve 1'" Dmx="0~0" />
      <Function ID="2" Name="Curve 2" Display="'Curve 2'" Dmx="64~127" />
      <Function ID="3" Name="Curve 3" Display="'Curve 3'" Dmx="128~191" />
      <Function ID="4" Name="Curve 4" Display="'Curve 4'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKEPA200" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dim_Spd" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
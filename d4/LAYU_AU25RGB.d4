  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" Update="Pattern/Folder, Shutter/File" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="50~99" Update="Pattern/Folder, Shutter/File" />
      <Function ID="3" Name="PRG" Display="'PRG'" Dmx="100~149" Update="Pattern/Folder, Shutter/File" />
      <Function ID="4" Name="ILD" Display="'ILD'" Dmx="150~199" Update="Pattern/Folder, Shutter/File" />
      <Function ID="5" Name="Manual" Display="'Manual'" Dmx="200~255" Update="Pattern/Folder, Shutter/File" />
    </Attribute>
    <Attribute ID="Pattern/Folder" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="PRG/ILD" ID="2" If="'Mode'==3||'Mode'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter/File" Name="Shutter/File" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="PRG/ILD" ID="4" If="'Mode'==3||'Mode'==4" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" />
      <Function ID="4" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Preset" Display="'Preset'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="11~16" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="10" Name="WRGB" Display="'WRGB'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="11" Name="BYPC" Display="'BYPC'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="12" Name="WRGBYPC" Display="'WRGBYPC'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="13" Name="WRGB" Display="'WRGB'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="14" Name="BYPC 1" Display="'BYPC 1'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="15" Name="BYPC 2" Display="'BYPC 2'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="16" Name="Subsection" Display="'Subsection'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Grating" Name="Grating" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="No Grating" Display="'No Grating'" Dmx="0~0" />
      <Function ID="2" Name="Multi-Pattern Anim" Display="'Multi-Pattern Anim'" Dmx="52~102" />
      <Function ID="3" Name="1D Grating" Display="'1D Grating'" Dmx="103~154" />
      <Function ID="4" Name="3D Plane" Display="'3D Plane'" Dmx="155~205" />
      <Function ID="5" Name="3D Line" Display="'3D Line'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Move Circle" Display="'Move Circle %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Jump Circle" Display="'Jump Circle %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Move Circle" Display="'Move Circle %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Jump Circle" Display="'Jump Circle %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.f%%',0~100" Dmx="11~87" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="88~150" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="X-Roll" Name="X-Roll" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Y-Roll" Name="Y-Roll" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Z-Roll" Name="Z-Roll" Description="" Group="B">

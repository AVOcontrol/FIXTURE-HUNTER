      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="129~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Change" Display="'No Change'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Auto +" Display="'Auto + %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Auto Circle" Display="'Auto Circle %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Bounce +" Display="'Bounce + %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Bounce -" Display="'Bounce - %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Light Dot" Display="'Light Dot'" Dmx="64~127" />
      <Function ID="3" Name="Segment" Display="'Segment'" Dmx="128~191" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

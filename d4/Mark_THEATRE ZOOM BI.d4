  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8858b2ba-efe6-486e-bc27-6ccedb399abc" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3000~5600" Dmx="255~11" Colour="255,240,200" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="6~55" />
      <Function ID="3" Name="Fastest" Display="'Fastest'" Dmx="56~105" />
      <Function ID="4" Name="Fast" Display="'Fast'" Dmx="106~155" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="156~205" />
      <Function ID="6" Name="Slowest" Display="'Slowest'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3" Id="c1fa8aed-b4ab-4636-9a4d-2d4b0c15f547">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

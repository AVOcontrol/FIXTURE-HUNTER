  <History Date="17-08-21" Author="Nic Morris" Comment="Created from ACME FLASHDOT (STROBE 3)" Version="2" />
  <History Date="18-08-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="12-03-22" Author="Nic Morris" Comment="Created from ACME Strobe 4 (equally confusing documentation.  no explanations as to what all the various controls relate to.  no pixel layout.  all guessed)" Version="4" />

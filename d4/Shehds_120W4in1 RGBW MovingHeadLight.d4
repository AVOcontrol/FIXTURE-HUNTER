  <AtlaBase TypeID="0d2746c9-f4cd-4298-9135-561ad0704fb7" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Wash_Shutter" Name="Wash Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~251" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3000~7000" Dmx="255~1" Colour="0,0,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Effect" Name="Col Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Gradient Effect" Display="'Col Gradient Effect'" Dmx="1~25" />
      <Function ID="3" Name="Col Jump Effect" Display="'Col Jump Effect'" Dmx="26~51" />
      <Function ID="4" Name="Col Rainbow Effect" Display="'Col Rainbow Effect'" Dmx="52~77" />
      <Function ID="5" Name="Col Gradient Effect 1" Display="'Col Gradient Effect 1'" Dmx="78~103" />
      <Function ID="6" Name="Col Gradient Effect 2" Display="'Col Gradient Effect 2'" Dmx="104~129" />
      <Function ID="7" Name="Col Gradient Effect 3" Display="'Col Gradient Effect 3'" Dmx="130~155" />
      <Function ID="8" Name="Col Gradient Effect 4" Display="'Col Gradient Effect 4'" Dmx="156~181" />
      <Function ID="9" Name="Col Gradient Effect 5" Display="'Col Gradient Effect 5'" Dmx="182~207" />
      <Function ID="10" Name="Col Gradient Effect 6" Display="'Col Gradient Effect 6'" Dmx="208~233" />
      <Function ID="11" Name="Col Gradient Effect 7" Display="'Col Gradient Effect 7'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Col_Effect_Spd" Name="Col Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~199" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="200~205" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Aux_Shutter" Name="Aux Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="RGB_Effect" Name="RGB Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect Mode 1" Display="'Effect Mode 1'" Dmx="1~63" />
      <Function ID="3" Name="Effect Mode 2" Display="'Effect Mode 2'" Dmx="64~127" />
      <Function ID="4" Name="Effect Mode 3" Display="'Effect Mode 3'" Dmx="128~191" />
      <Function ID="5" Name="Effect Mode 4" Display="'Effect Mode 4'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="RGB_Effect_Spd" Name="RGB Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

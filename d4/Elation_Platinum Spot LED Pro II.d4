<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Platinum Spot LED Pro II" ShortName="PlatSpPro2" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="05-07-10" Author="Jonathan Moreton" Comment="Created" />
  <History Date="05-01-11" Author="Nic Morris" Comment="Adapted from Platinum Spot 5R" />
  <History Date="03-05-11" Author="Nic Morris" Comment="Standardised func names.  Fixed raw ranges.  Added raw to Gobo2Func." />
  <History Date="03-05-11" Author="Nic Morris" Comment="Adjusted wheel resolutions.  Fixed power on and locate." />
  <History Date="10-05-11" Author="Nic Morris" Comment="Removed percentage value from macro return function." />
  <History Date="10-05-11" Author="Nic Morris" Comment="Increased macro delay in attempt to resolve reported bug.  There are no details from manuf." />
  <History Date="09-08-12" Author="Peter Budd" Comment="Created Platinum Spot 15R Pro" />
  <History Date="26-03-13" Author="Peter Budd" Comment="Created from the Elation Platinum Beam 15R Pro" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Fixed typo in Gobo1, Gobo 7 shake.  Increased focus and iris wheel resolution for 16bit." />
  <History Date="20-12-13" Author="Nic Morris" Comment="Inverted iris range for more logical wheel mapping.  Adjusted locate value to suit." />
  <History Date="20-12-13" Author="Nic Morris" Comment="Moved colour func index next to fixed and added function index." />
  <History Date="20-12-13" Author="Nic Morris" Comment="Inverted P/T speed wheel direction.  Removed Prism Rot update from Prism Func" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Removed Index func from Prism Func.  Reordered shutter functions." />
  <History Date="20-12-13" Author="Nic Morris" Comment="Added colour func to highlight and lowlight.  Fixed palettes." />
  <History Date="20-12-13" Author="Nic Morris" Comment="Created from Elation Platinum Spot LED Pro (add pulses to iris and named reserved control functions)" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="20ea4aef-7b49-42db-bf1d-041932452d04" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Condition Name="Index" ID="14,15,16,17,18,19,20,21" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3855" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4112~7967" WheelPosition="1" Colour="255,0,0" />

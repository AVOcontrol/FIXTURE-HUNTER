      <Function ID="14" Name="Open" Display="'Open %.1f%%',0.0~100.0" Dmx="0~3855" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Red" Display="'Red %.1f%%',0.0~100.0" Dmx="4112~7967" WheelPosition="1" Colour="255,0,0" />
      <Function ID="16" Name="Blue" Display="'Blue %.1f%%',0.0~100.0" Dmx="8224~12079" WheelPosition="2" Colour="0,0,255" />

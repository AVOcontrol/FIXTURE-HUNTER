    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="8~15" />
      <Function ID="3" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="16~23" />
      <Function ID="4" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="24~31" />
      <Function ID="5" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="32~39" />
      <Function ID="6" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="40~47" />
      <Function ID="7" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="48~55" />
      <Function ID="8" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="9" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="10" Name="Reset Colour" Display="'Reset Colour'" Dmx="112~119" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="12" Name="Reset Gobo Rot" Display="'Reset Gobo Rot'" Dmx="128~135" />
      <Function ID="13" Name="Reset Prism" Display="'Reset Prism'" Dmx="136~143" />
      <Function ID="14" Name="Reset Focus" Display="'Reset Focus'" Dmx="144~151" />
      <Function ID="15" Name="Reset All" Display="'Reset All'" Dmx="152~159" />
      <Function ID="16" Name="Reset Iris" Display="'Reset Iris'" Dmx="160~167" />
      <Function ID="17" Name="P/T Ramp Speed Up ON" Display="'P/T Ramp Speed Up ON'" Dmx="240~247" />
      <Function ID="18" Name="P/T Ramp Speed Up OFF" Display="'P/T Ramp Speed Up OFF'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="9" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour2Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="8~15" Colour="255,240,200" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="16~23" Colour="230,230,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" Colour="0,255,0" />
      <Function ID="5" Name="UV" Display="'UV'" Dmx="32~39" Colour="180,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~47" Colour="255,128,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="48~55" Colour="255,150,150" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="56~63" Colour="0,128,255" />
      <Function ID="9" Name="Index" Display="'%.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Frost" Display="'No Frost'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="8~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>

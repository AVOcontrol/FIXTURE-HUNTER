  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~50" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="51~247" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="248~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20,21" If="'Colour1Func'==3" />
      <Else ID="21,22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~8" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="9~16" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="17~24" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="25~32" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="33~40" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="41~48" Colour="255,128,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="49~56" Colour="0,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="57~63" Colour="255,150,150" />
      <Function ID="9" Name="Open/Red" Display="'Open/Red'" Dmx="128~121" Colour="255,255,255" />
      <Function ID="10" Name="Red/Yellow" Display="'Red/Yellow'" Dmx="120~113" Colour="255,0,0" />
      <Function ID="11" Name="Yellow/Purple" Display="'Yellow/Purple'" Dmx="112~104" Colour="255,255,0" />
      <Function ID="12" Name="Purple/Green" Display="'Purple/Green'" Dmx="103~91" Colour="128,0,255" />
      <Function ID="13" Name="Green/Orange" Display="'Green/Orange'" Dmx="90~89" Colour="0,255,0" />
      <Function ID="14" Name="Orange/Light Blue" Display="'Orange/Light Blue'" Dmx="88~80" Colour="255,128,0" />
      <Function ID="15" Name="Light Blue/Pink" Display="'Light Blue/Pink'" Dmx="79~72" Colour="0,128,255" />
      <Function ID="16" Name="Pink/Open" Display="'Pink/Open'" Dmx="71~64" Colour="255,150,150" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="129~189" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="190~249" Colour="0,0,0" />
      <Function ID="21" Name="Random" Display="'Random'" Dmx="250~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="0~55" Intensity="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="56~207" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="208~255" Intensity="0~0" />

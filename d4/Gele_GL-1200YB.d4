      <Function ID="5" Name="Spray" Display="'Spray'" Dmx="53~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="64~73" GoboSpin="0~0" GoboOrientation="0~0" />

  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:1" Delay="7000" />
      <Set Channel="Reset:0" Delay="0" />
    </Macro>

      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="114~150" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="151~255" GoboSpin="0~0" GoboOrientation="0~0" />

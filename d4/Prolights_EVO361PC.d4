<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EVO361PC" ShortName="EVO361PC" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-06-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-08-16" Author="Nic Morris" Comment="Revised cool white and warm white attribute ID's and locate values." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="225d58ec-0253-4d1f-ba30-01d90012ee89" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 1" Display="'White 1'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="White 2" Display="'White 2'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="White 3" Display="'White 3'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="White 4" Display="'White 4'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="White 5" Display="'White 5'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" Intensity="0~0" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
  </Control>
  <Mode Name="UNO" Channels="1">
    <Import PearlRef="PG361PC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ee1916bc-fdf7-4ad0-8501-3079275a9649" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="DOS" Channels="2">
    <Import PearlRef="PG361PC2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e4e4d75e-050e-41dd-bf91-5c0d72251bed" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="STD.W" Channels="5">
    <Import PearlRef="PG361PC3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1d63669c-a9b9-4cfc-b21f-180c499d88e3" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="STD.P" Channels="10">
    <Import PearlRef="PG361PC4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="528a0313-9644-4d53-8df5-10f33fd1a210" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="3,4" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="5,6" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
      <Function ID="22" Name="Colour 5" Display="'Colour 5'" Dmx="64~79" Colour="0,0,0" />
      <Function ID="23" Name="Colour 6" Display="'Colour 6'" Dmx="80~95" Colour="0,0,0" />

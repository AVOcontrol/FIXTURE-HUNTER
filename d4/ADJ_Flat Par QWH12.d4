      <Function ID="15" Name="Light Magenta" Display="'Light Magenta'" Dmx="208~223" Colour="255,128,255" />
      <Function ID="16" Name="Light Cyan" Display="'Cyan'" Dmx="224~239" Colour="128,255,255" />
      <Function ID="17" Name="RGBW" Display="'RGBW'" Dmx="240~255" Colour="255,255,255" />
      <Function ID="18" Name="Colour 1" Display="'Colour 1'" Dmx="0~15" Colour="0,0,0" />
      <Function ID="19" Name="Colour 2" Display="'Colour 2'" Dmx="16~31" Colour="0,0,0" />

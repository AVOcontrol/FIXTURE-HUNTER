      <Function ID="25" Name="Colour 8" Display="'Colour 8'" Dmx="112~127" Colour="0,0,0" />
      <Function ID="26" Name="Colour 9" Display="'Colour 9'" Dmx="128~143" Colour="0,0,0" />
      <Function ID="27" Name="Colour 10" Display="'Colour 10'" Dmx="144~159" Colour="0,0,0" />
      <Function ID="28" Name="Colour 11" Display="'Colour 11'" Dmx="160~175" Colour="0,0,0" />

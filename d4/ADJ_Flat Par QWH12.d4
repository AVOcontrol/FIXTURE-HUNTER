    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~51" Update="Colour_Macro, Shutter" Colour="0,0,0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro'" Dmx="52~102" Update="Colour_Macro, Shutter" Colour="0,0,0" />
      <Function ID="3" Name="Col Change" Display="'Col Change'" Dmx="103~153" Update="Colour_Macro, Shutter" Colour="0,0,0" />

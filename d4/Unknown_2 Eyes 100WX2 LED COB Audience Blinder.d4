  <Mode Name="Cell" Channels="4" Hidden="True" Id="291dd1ea-5b79-47f4-a9a0-35514dde3376">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

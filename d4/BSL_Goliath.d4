      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Fixed BO" Display="'Fixed BO'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />

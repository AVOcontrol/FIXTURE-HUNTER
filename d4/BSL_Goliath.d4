      <Function ID="12" Name="Amb/ L Blu" Display="'Amb/ L Blu'" Dmx="99~107" Colour="255,150,0" />
      <Function ID="13" Name="Light Blue" Display="'Light Blue'" Dmx="108~116" Colour="100,150,255" />
      <Function ID="14" Name="L Blu/ Grn" Display="'L Blu/ Grn'" Dmx="117~125" Colour="100,150,255" />
      <Function ID="15" Name="Green" Display="'Green'" Dmx="126~134" Colour="0,255,0" />

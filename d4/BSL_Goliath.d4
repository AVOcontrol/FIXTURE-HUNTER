      <Function ID="26" Name="Org/ Blue" Display="'Org/ Blue'" Dmx="225~233" Colour="255,128,0" />
      <Function ID="27" Name="Blue" Display="'Blue'" Dmx="234~242" Colour="0,0,255" />
      <Function ID="28" Name="Blue/ Op" Display="'Blue/ Op'" Dmx="243~251" Colour="0,0,255" />
      <Function ID="29" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />

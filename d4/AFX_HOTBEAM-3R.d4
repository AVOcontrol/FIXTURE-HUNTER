      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="148~152" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Azure" Display="'Azure'" Dmx="153~157" WheelPosition="6" Colour="0,128,255" />

      <Function ID="14" Name="UV" Display="'UV'" Dmx="186~189" WheelPosition="13" Colour="0,0,255" />
      <Function ID="15" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="D Rd - D Bl" Display="'D Rd - D Bl %.f%%',0~100" Dmx="9~17" WheelPosition="1" Colour="180,0,0" />

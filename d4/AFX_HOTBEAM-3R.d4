      <Function ID="28" Name="UV - Op" Display="'UV - Op %.f%%',0~100" Dmx="119~127" WheelPosition="13" Colour="0,0,255" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="216~217" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="190~215" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="216~217" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="218~243" Colour="0,0,0" />

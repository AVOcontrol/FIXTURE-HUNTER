    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Low Power" Display="'Low Power'" Dmx="20~24" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="5" Name="Reset Other" Display="'Reset Other'" Dmx="160~169" />

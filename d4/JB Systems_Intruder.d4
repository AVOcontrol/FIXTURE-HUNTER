      <Function ID="9" Name="Magenta Wave" Display="'Magenta Wave'" Dmx="182~207" />
      <Function ID="10" Name="Cyan Wave" Display="'Cyan Wave'" Dmx="208~233" />
      <Function ID="11" Name="White Wave" Display="'White Wave'" Dmx="234~255" />

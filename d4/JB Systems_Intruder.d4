    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="6~97" Colour="255,255,255" />
      <Function ID="3" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="98~148" Colour="255,255,255" />
      <Function ID="4" Name="Change" Display="'Change %.f%%',0~100" Dmx="149~199" Colour="255,255,255" />

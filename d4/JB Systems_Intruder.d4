      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1800K" Display="'1800K'" Dmx="10~50" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="51~91" Colour="255,255,255" />
      <Function ID="4" Name="4000K" Display="'4000K'" Dmx="92~132" Colour="255,255,255" />

  <History Date="11-03-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="23-03-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="22-03-25" Author="Nic Morris" Comment="Created from CKC Lighting V20 (identical.  no gobo images.  left the same for now)" Version="2" />
  <History Date="17-04-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="29-05-25" Author="Nic Morris" Comment="Created from CKC Lighting V20 IP" Version="4" />
  <History Date="02-09-25" Author="Nic Morris" Comment="Changed manufacturer name from NXT to NXT Lights and updated in line with latest documentation in response to manufacturer request." Version="5" />
  <History Date="02-09-25" Author="Nic Morris" Comment="(adds fan ultra silent control function/macro and revises numerous control/function macro ranges.  adds physical pan/tilt ranges, gobo names and minor revision to various scroll and spin wheel directions)" Version="5" />
  <History Date="28-04-26" Author="Nic Morris" Comment="Updated in line with 2026 V2.0 charts in response to manufacturer request (revises colour function DMX ranges, adds tint, blade macro, blade macro speed and reserved controls, revises control functions/macros.  changes various controls to 16bit)" Version="6" />
  <History Date="26-05-26" Author="Nic Morris" Comment="Updated Atlabase IDs to v2." Version="7" />

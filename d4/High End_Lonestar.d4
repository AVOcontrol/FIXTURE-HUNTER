      </Function>
      <Function ID="4" Name="Gobo 3 (Fracked)" Display="'Gobo 3 (Fracked)'" Dmx="48~63" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>b7ac3611-6fe8-49a0-bb71-e5e522e9affc</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Broken Tunnel)" Display="'Gobo 4 (Broken Tunnel)'" Dmx="64~79" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>9d918537-5b20-477d-9734-5d2af4e75a8e</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Seashell)" Display="'Gobo 5 (Seashell)'" Dmx="80~95" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>1a2a2656-2794-498a-84e3-6756918534e2</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Glacial)" Display="'Gobo 6 (Glacial)'" Dmx="96~111" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>259cf051-5217-4214-83cf-cabf837a8512</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Shower)" Display="'Gobo 7 (Shower)'" Dmx="112~127" WheelPosition="7">
        <Swatch>bc0b1c36-f684-4483-9e28-e7dcfda2b03e</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8 (Ice)" Display="'Gobo 8 (Ice)'" Dmx="128~143" WheelPosition="8">
        <Swatch>af596351-efa7-4848-9498-778ecfab7023</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 9 (Branch Out)" Display="'Gobo 9 (Branch Out)'" Dmx="144~159" WheelPosition="9">
        <Swatch>13143874-c525-4667-88e6-b7857bca9e60</Swatch>
      </Function>
      <Function ID="11" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_1_Rot_Fnc" Name="Gobo Rot Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="16~31" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="32~47" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="48~63" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CCW" Display="'Anim CCW'" Dmx="64~79" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo_1_Rot_Fnc'==1" />
      <Condition Name="Spin" ID="2,3" If="'Gobo_1_Rot_Fnc'&gt;1&amp;&amp;'Gobo_1_Rot_Fnc'&lt;6" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="2048~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

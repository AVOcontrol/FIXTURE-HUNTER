      <Function ID="2" Name="Disable" Display="'Disable'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display OFF" Display="'Display OFF'" Dmx="32~47" />
      <Function ID="3" Name="Display ON" Display="'Display ON'" Dmx="48~63" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="80~95" />
      <Function ID="5" Name="Shutdown" Display="'Shutdown'" Dmx="96~111" />
      <Function ID="6" Name="Disable P/T" Display="'Disable P/T'" Dmx="112~127" />
      <Function ID="7" Name="Dim Mode 2.4 kHz" Display="'Dim Mode 2.4 kHz'" Dmx="128~143" />
      <Function ID="8" Name="Dim Mode 16 kHz" Display="'Dim Mode 16 kHz'" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="16~207" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="208~223" />
      <Function ID="4" Name="Studio" Display="'Studio'" Dmx="224~239" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

    <Attribute ID="Prism_1_Rot" Name="Prism 1 Rot" Description="" Group="E" Size="2">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Condition Name="Index" ID="1" If="'Prism_1'==2" />

    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_1_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="16~31" Update="Prism_1_Rot" />

      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_2_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="16~31" Update="Prism_2_Rot" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW'" Dmx="32~47" Update="Prism_2_Rot" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW'" Dmx="48~63" Update="Prism_2_Rot" />
      <Function ID="5" Name="Anim CW" Display="'Anim CW'" Dmx="64~79" Update="Prism_2_Rot" />
      <Function ID="6" Name="Anim CCW" Display="'Anim CCW'" Dmx="80~95" Update="Prism_2_Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_2_Rot" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E" Size="2">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Condition Name="Index" ID="1" If="'Prism_2'==2" />
      <Condition Name="Spin" ID="2,3" If="'Prism_2'&gt;2&amp;&amp;'Prism_2'&lt;7" />
      <Else ID="4" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="1028~65535" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Frost_Light" Name="Frost Light" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Frost_Medium" Name="Frost Medium" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">

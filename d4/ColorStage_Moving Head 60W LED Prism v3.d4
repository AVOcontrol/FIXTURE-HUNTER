      <Function ID="24" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="110~114" WheelPosition="11" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="120~187" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="188~255" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">

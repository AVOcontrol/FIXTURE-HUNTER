      <Function ID="15" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="65~69" WheelPosition="2" />
      <Function ID="16" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="70~74" WheelPosition="3" />
      <Function ID="17" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="75~79" WheelPosition="4" />

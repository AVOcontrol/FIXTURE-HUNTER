      <Function ID="10" Name="Rnd Pulse" Display="'Rnd Pulse %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Exposure" Display="'Exposure %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

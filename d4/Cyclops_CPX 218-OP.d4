      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Temp Up Dim" Display="'Col Temp Up Dim'" Dmx="32~63" />
      <Function ID="3" Name="Col Temp Down Dim" Display="'Col Temp Down Dim'" Dmx="64~95" />
      <Function ID="4" Name="Col Temp Up/Down Dim" Display="'Col Temp Up/Down Dim'" Dmx="96~127" />
      <Function ID="5" Name="Col Temp Fade" Display="'Col Temp Fade'" Dmx="128~159" />
      <Function ID="6" Name="Loop Change" Display="'Loop Change'" Dmx="160~191" />
      <Function ID="7" Name="Up/Down Loop" Display="'Up/Down Loop'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1:21" PowerOn="1:21" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>

      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="60~69" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Sky Blue" Display="'Sky Blue'" Dmx="70~79" WheelPosition="7" Colour="0,150,255" />
      <Function ID="9" Name="Purple-Pink" Display="'Purple-Pink'" Dmx="80~89" WheelPosition="8" Colour="200,0,200" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="90~99" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="100~109" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="110~119" WheelPosition="2" Colour="0,255,0" />
      <Function ID="13" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="120~129" WheelPosition="3" Colour="0,0,255" />
      <Function ID="14" Name="Org/ R Rd" Display="'Org/ R Rd'" Dmx="130~139" WheelPosition="4" Colour="255,150,0" />
      <Function ID="15" Name="R Rd/ Yel" Display="'R Rd/ Yel'" Dmx="140~149" WheelPosition="5" Colour="255,0,255" />
      <Function ID="16" Name="Yel/ S Blu" Display="'Yel/ S Blu'" Dmx="150~159" WheelPosition="6" Colour="255,255,0" />

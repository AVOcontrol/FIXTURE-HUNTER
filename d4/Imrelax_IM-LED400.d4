      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="180~215" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="221~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

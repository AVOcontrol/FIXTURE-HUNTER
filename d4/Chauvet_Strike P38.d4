  <Macro>
    <Macro Name="Preset">
      <Set Channel="Dim_Spd:1" Delay="4000" />
      <Set Channel="Dim_Spd:1" Delay="0" />
    </Macro>
    <Macro Name="Linear">
      <Set Channel="Dim_Spd:2" Delay="4000" />
      <Set Channel="Dim_Spd:1" Delay="0" />
    </Macro>
    <Macro Name="Fast">
      <Set Channel="Dim_Spd:3" Delay="4000" />
      <Set Channel="Dim_Spd:1" Delay="0" />
    </Macro>
    <Macro Name="Med">
      <Set Channel="Dim_Spd:4" Delay="4000" />
      <Set Channel="Dim_Spd:1" Delay="0" />
    </Macro>
    <Macro Name="Slow">
      <Set Channel="Dim_Spd:5" Delay="4000" />
      <Set Channel="Dim_Spd:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />

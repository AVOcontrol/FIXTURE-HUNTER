<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Four Leaf Four Maple Leaf Retro Lamp" ShortName="4LeafRetro" Company="BSM" Version="1">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="02-04-26" Author="Nic Morris" Comment="Created (very poor documentation.  mostly nonsense)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Index Spd" Display="'Index Spd %.f%%',0~100" Dmx="49~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="50~152" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="153~255" />
    </Attribute>
    <Attribute ID="Bee_Eye_Motor" Name="Bee Eye Motor" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~59" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="60~119" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="179~120" />
      <Function ID="4" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Golden_FX" Name="Golden FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="50~99" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="100~149" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="150~199" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="50~99" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="100~149" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="150~199" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Bee_Eye_FX" Name="Bee Eye FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="50~99" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="100~149" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="150~199" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Golden" Name="Golden" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="25~44" />
      <Function ID="3" Name="2" Display="'2'" Dmx="45~64" />
      <Function ID="4" Name="3" Display="'3'" Dmx="65~84" />
      <Function ID="5" Name="4" Display="'4'" Dmx="85~104" />
      <Function ID="6" Name="1+2" Display="'1+2'" Dmx="105~124" />
      <Function ID="7" Name="1+3" Display="'1+3'" Dmx="125~144" />
      <Function ID="8" Name="1+4" Display="'1+4'" Dmx="145~164" />
      <Function ID="9" Name="2+3" Display="'2+3'" Dmx="165~184" />
      <Function ID="10" Name="2+4" Display="'2+4'" Dmx="185~204" />
      <Function ID="11" Name="3+4" Display="'3+4'" Dmx="205~224" />
      <Function ID="12" Name="1+2+3+4" Display="'1+2+3+4'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="RGB_Colour" Name="RGB Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="30~59" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="60~89" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="90~119" Colour="0,0,255" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green'" Dmx="120~149" Colour="0,0,0" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue'" Dmx="150~179" Colour="0,0,0" />
      <Function ID="7" Name="Green+Blue" Display="'Green+Blue'" Dmx="180~209" Colour="0,0,0" />
      <Function ID="8" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="210~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Bee_Eye_Col" Name="Bee Eye Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~39" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~59" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~79" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~99" Colour="0,0,0" />
      <Function ID="6" Name="Red+Green" Display="'Red+Green'" Dmx="100~119" Colour="0,0,0" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="120~139" Colour="0,0,0" />
      <Function ID="8" Name="Red+White" Display="'Red+White'" Dmx="140~159" Colour="0,0,0" />
      <Function ID="9" Name="Green+Blue" Display="'Green+Blue'" Dmx="160~179" Colour="0,0,0" />
      <Function ID="10" Name="Green+White" Display="'Green+White'" Dmx="180~199" Colour="0,0,0" />
      <Function ID="11" Name="Blue+White" Display="'Blue+White'" Dmx="200~219" Colour="0,0,0" />
      <Function ID="12" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="220~239" Colour="0,0,0" />
      <Function ID="13" Name="Red+Green+Blue+White" Display="'Red+Green+Blue+White'" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

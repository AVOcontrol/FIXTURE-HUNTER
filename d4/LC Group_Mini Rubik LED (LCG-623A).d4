      <Function ID="14" Name="R+G Chase" Display="'R+G Chase'" Dmx="227~236" />
      <Function ID="15" Name="G+B Chase" Display="'G+B Chase'" Dmx="237~246" />
      <Function ID="16" Name="R+G+B Chase" Display="'R+G+B Chase'" Dmx="247~255" />

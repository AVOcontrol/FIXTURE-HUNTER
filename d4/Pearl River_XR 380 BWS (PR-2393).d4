      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Diffuser" Display="'Diffuser %.1f%%',0.0~100.0" Dmx="17~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display On" Display="'Display On'" Dmx="20~24" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="25~29" />
      <Function ID="4" Name="Lamp Half Power" Display="'Lamp Half Power'" Dmx="35~39" />
      <Function ID="5" Name="Lamp Full Power" Display="'Lamp Full Power'" Dmx="40~44" />
      <Function ID="6" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="90~94" />
      <Function ID="7" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="95~99" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="9" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="10" Name="Reset Colour" Display="'Reset Colour'" Dmx="150~159" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="160~169" />
      <Function ID="12" Name="Reset Int" Display="'Reset Int'" Dmx="170~179" />
      <Function ID="13" Name="Reset Zoom/Frost/Focus/Prism" Display="'Reset Zoom/Frost/Focus/Prism'" Dmx="180~189" />
      <Function ID="14" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="15" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
  </Control>

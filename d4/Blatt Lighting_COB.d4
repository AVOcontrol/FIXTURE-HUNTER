  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="36aa92b7-d1df-4337-83b0-f79f621fdbe3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="51~100" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="101~150" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="151~200" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a408d543-8de5-4b5b-9e42-e46475cd433e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="40" />
      <Attribute ID="Amber" ChannelOffset="9" Wheel="41" />
      <Attribute ID="UV" ChannelOffset="10" Wheel="42" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8aa908aa-f650-4737-bcd9-9ae4365847e7" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="UV" ChannelOffset="6" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

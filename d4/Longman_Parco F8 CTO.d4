<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Parco F8 CTO" ShortName="Pco F8 CTO" Company="Longman">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="11-09-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="CW C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White1" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="WW C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~31" Colour="255,255,255" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="White Fade" Display="'White Fade'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="Pulse Auto" Display="'Pulse Auto'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="Colour Jump" Display="'Colour Jump'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="Multi Jump" Display="'Multi Jump'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~5" />
      <Function ID="2" Name="Curve 0" Display="'Curve 0'" Dmx="6~55" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="56~105" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="106~155" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="156~205" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="LOPF8CTO" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="37" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="White1" ChannelOffset="4" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="38" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
      <Attribute ID="Dim_Spd" ChannelOffset="9" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
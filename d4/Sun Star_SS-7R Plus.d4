      <Palette ID="13" Name="Gobo 12" Number="0" Page="1" SetControl="Gobo1:13,Gobo1Func:1" />
      <Palette ID="14" Name="Gobo 13" Number="0" Page="1" SetControl="Gobo1:14,Gobo1Func:1" />
      <Palette ID="15" Name="Gobo 14" Number="0" Page="1" SetControl="Gobo1:15,Gobo1Func:1" />
      <Palette ID="16" Name="Gobo 15" Number="0" Page="1" SetControl="Gobo1:16,Gobo1Func:1" />
      <Palette ID="17" Name="Gobo 16" Number="0" Page="1" SetControl="Gobo1:17,Gobo1Func:1" />
      <Palette ID="18" Name="Gobo 17" Number="0" Page="1" SetControl="Gobo1:18,Gobo1Func:1" />
    </Group>
    <Group Name="Position">

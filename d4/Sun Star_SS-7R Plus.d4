      <Function ID="31" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="225~229" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Gobo 13 Shake" Display="'Gobo 13 Shake  %.f%%',0~100" Dmx="230~234" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="33" Name="Gobo 14 Shake" Display="'Gobo 14 Shake %.f%%',0~100" Dmx="235~239" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="34" Name="Gobo 15 Shake" Display="'Gobo 15 Shake %.f%%',0~100" Dmx="240~244" WheelPosition="15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="35" Name="Gobo 16 Shake" Display="'Gobo 16 Shake %.f%%',0~100" Dmx="245~249" WheelPosition="16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="36" Name="Gobo 17 Shake" Display="'Gobo 17 Shake  %.f%%',0~100" Dmx="250~255" WheelPosition="17" />
      <Function ID="37" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="38" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="72~113" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="39" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="40" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="118~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="41" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="192~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effect" Display="'Reset Effect'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="10~100" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Col_Speed" Name="Col Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Beam_Speed" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo_Speed" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="UKSS7R+" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="10,11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12,13" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Frost" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Reserved" ChannelOffset="7" Wheel="58" />
      <Attribute ID="Macro" ChannelOffset="14" Wheel="52" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="16" Wheel="30" />
      <Attribute ID="PT_Speed" ChannelOffset="17" Wheel="25" />
      <Attribute ID="Col_Speed" ChannelOffset="18" Wheel="26" />
      <Attribute ID="Beam_Speed" ChannelOffset="19" Wheel="27" />
      <Attribute ID="Gobo_Speed" ChannelOffset="20" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Effect">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />

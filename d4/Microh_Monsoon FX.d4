    <Include>
      <Attribute ID="LED_Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Laser_Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
      <Attribute ID="LED_Rot" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Laser_Rot" ChannelOffset="9" Wheel="20" />

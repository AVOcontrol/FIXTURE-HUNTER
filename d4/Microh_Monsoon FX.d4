  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="10~24" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="25~39" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="40~54" />

      <Function ID="7" Name="Picture 6" Display="'Picture 6 %.f%%',0~100" Dmx="60~69" />
      <Function ID="8" Name="Picture 7" Display="'Picture 7 %.f%%',0~100" Dmx="70~79" />
      <Function ID="9" Name="Picture 8" Display="'Picture 8 %.f%%',0~100" Dmx="80~89" />
      <Function ID="10" Name="Picture 9" Display="'Picture 9 %.f%%',0~100" Dmx="90~99" />
      <Function ID="11" Name="Picture 10" Display="'Picture 10 %.f%%',0~100" Dmx="100~109" />
      <Function ID="12" Name="On" Display="'On'" Dmx="110~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="2" Name="R On" Display="'R On'" Dmx="10~49" />
      <Function ID="3" Name="G On" Display="'G On'" Dmx="50~89" />
      <Function ID="4" Name="R+G On" Display="'R+G On'" Dmx="90~129" />

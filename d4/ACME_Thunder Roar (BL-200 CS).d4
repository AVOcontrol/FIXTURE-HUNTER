<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Thunder Roar (BL-200 CS)" ShortName="Thndr Roar" Company="ACME" Version="10">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>e12ce8ce-40dc-41a4-bd76-48ceb493fd72</Thumbnail>
  <History Date="06-01-20" Author="Nic Morris" Comment="Created (charts are a mess)" Version="1" />
  <History Date="07-01-20" Author="Nic Morris" Comment="Revised effect functions in line with latest charts in response to manufacturer request." Version="2" />
  <History Date="09-01-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="14-01-20" Author="Nic Morris" Comment="Changed shutter and duration locate values in response to manufacturer request.  The shutter locate value is very strange and suggests the functions themselves are wrong." Version="4" />
  <History Date="14-01-20" Author="Nic Morris" Comment="Added RDM ID's. Note mode IDs not available.  Most of the modes do not have unique channel counts so this will currently only work for the 4, 12, 68 and 72 DMX modes." Version="5" />
  <History Date="17-07-20" Author="Nic Morris" Comment="Yet another update in line with latest charts in response to manufacturer request." Version="6" />
  <History Date="18-07-20" Author="Nic Morris" Comment="Added 9 channel and revised 10 channel mode Atlabase ID's.  The 68 channel mode seems to have disappeared." Version="7" />
  <History Date="21-07-20" Author="Nic Morris" Comment="Added missing Atlabase ID to 68 channel mode." Version="8" />
  <History Date="27-07-20" Author="Nic Morris" Comment="Moved strobe part into cell in pixel modes in attempt to solve manufacturer request." Version="9" />
  <History Date="05-08-20" Author="Nic Morris" Comment="Fixed duplicate cell ID in 16 Pixel mode that was causing patch to fail." Version="10" />
  <History Date="05-08-20" Author="Nic Morris" Comment="Changed name from Stage Color IP (BL-200 CS) to Thunder Roar (BL-200 CS) in response to manufacturer request." Version="10" />
  <Manual Filename="" Summary="" />

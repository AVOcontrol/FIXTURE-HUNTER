    </Attribute>
    <Attribute ID="Ring_LED_Show" Name="Ring LED Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1 %.f%%',0~100" Dmx="16~55" />
      <Function ID="3" Name="Show 2" Display="'Show 2 %.f%%',0~100" Dmx="56~95" />
      <Function ID="4" Name="Show 3" Display="'Show 3 %.f%%',0~100" Dmx="96~135" />
      <Function ID="5" Name="Show 4" Display="'Show 4 %.f%%',0~100" Dmx="136~175" />
      <Function ID="6" Name="Show 5" Display="'Show 5 %.f%%',0~100" Dmx="176~215" />
      <Function ID="7" Name="Show 6" Display="'Show 6 %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Macro_Figure" Name="Macro Figure" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Macro Figure" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Inclination" Name="Inclination" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Inclination" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Radius_X" Name="Radius X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Radius X" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Radius_Y" Name="Radius Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Radius Y" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Radius" Name="Radius" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Radius" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="30~39" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="40~49" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="50~59" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="60~69" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="7" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="210~219" />
      <Function ID="8" Name="Dim Spd Smooth" Display="'Dim Spd Smooth'" Dmx="220~229" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

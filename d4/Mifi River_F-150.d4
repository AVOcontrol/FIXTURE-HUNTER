      <Function ID="2" Name="8-Facet Circular" Display="'8-Facet Circular'" Dmx="50~99" />
      <Function ID="3" Name="6-Facet Linear" Display="'6-Facet Linear'" Dmx="100~149" />
      <Function ID="4" Name="Frost" Display="'Frost'" Dmx="150~255" />

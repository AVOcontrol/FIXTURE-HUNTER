    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~13" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="14~27" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="28~41" />
      <Function ID="5" Name="White" Display="'White'" Dmx="42~55" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="56~69" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="70~83" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="84~97" />
      <Function ID="9" Name="White" Display="'White'" Dmx="98~100" />
      <Function ID="10" Name="Fade Col" Display="'Fade Col %.f%%',0~100" Dmx="101~150" />
      <Function ID="11" Name="Switch Col" Display="'Switch Col %.f%%',0~100" Dmx="151~200" />
      <Function ID="12" Name="Fade In/Out" Display="'Fade In/Out %.f%%',0~100" Dmx="201~250" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

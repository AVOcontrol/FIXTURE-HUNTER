<Fixture Name="COLORado 1 Tri Tour" ShortName="CR1TriTour" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>523d2151-b12b-4a35-81b7-25933b813722</Thumbnail>
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="25-02-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution" />
  <History Date="28-03-11" Author="Nic Morris" Comment="Removed shutter palettes.  Added missing ID functions." />
  <History Date="28-03-11" Author="Nic Morris" Comment="Changed Hue and Saturation to Colour Group.  Changed Value to Dimmer." />
  <History Date="28-03-11" Author="Nic Morris" Comment="Moved Hue and Sat to Colour wheels.  Simplified Macro Speed conditional logic." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="07-12-14" Author="Nic Morris" Comment="Created from Chauvet COLORado 1 Tri Tour" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="19-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="05-09-18" Author="Nic Morris" Comment="Merged versions.  Added product thumbnail." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6f00f4b5-8238-4fee-90e2-1fdbf3aeb972" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Macro'&gt;1&amp;&amp;'Macro'&lt;12" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Macro'&gt;1&amp;&amp;'Macro'&lt;12" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="21~30" Update="Red, Green" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~40" Update="Red, Green" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="41~50" Update="Red, Green" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="51~60" Update="Red, Green" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="61~70" Update="Red, Green" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="71~80" Update="Red, Green" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="81~90" Update="Red, Green" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="91~100" Update="Red, Green" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="101~110" Update="Red, Green" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="111~120" Update="Red, Green" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" Update="Red, Green" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" Update="Red, Green" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" Update="Red, Green" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" Update="Red, Green" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" Update="Red, Green" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" Update="Red, Green" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" Update="Red, Green" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" Update="Red, Green" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" Update="Red, Green" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_Speed" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

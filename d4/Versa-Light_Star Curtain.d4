<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Star Curtain" ShortName="StrCurtain" Company="Versa-Light" Version="0">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="04-07-24" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program_1-15" Name="Program 1-15" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="White Raindrop" Display="'White Raindrop'" Dmx="16~31" />
      <Function ID="3" Name="7 Col Diagonal Corrugation" Display="'7 Col Diagonal Corrugation'" Dmx="32~47" />
      <Function ID="4" Name="Col Diamond Chast (L-R)" Display="'Col Diamond Chast (L-R)'" Dmx="48~63" />
      <Function ID="5" Name="Arrow Close Up to the Centre (L-R)" Display="'Arrow Close Up to the Centre (L-R)'" Dmx="64~79" />
      <Function ID="6" Name="Raindrops" Display="'Raindrops'" Dmx="80~95" />
      <Function ID="7" Name="Col LED Lines Chase (L-R)" Display="'Col LED Lines Chase (L-R)'" Dmx="96~111" />
      <Function ID="8" Name="All Col Change + Chase (L-R)" Display="'All Col Change + Chase (L-R)'" Dmx="112~127" />
      <Function ID="9" Name="All Col Change + Chase (R-L)" Display="'All Col Change + Chase (R-L)'" Dmx="128~143" />
      <Function ID="10" Name="Col Ripples Moving (R-L)" Display="'Col Ripples Moving (R-L)'" Dmx="144~159" />
      <Function ID="11" Name="Col Ripples Moving (L-R)" Display="'Col Ripples Moving (L-R)'" Dmx="160~175" />
      <Function ID="12" Name="Windmill CW Spin" Display="'Windmill CW Spin'" Dmx="176~191" />
      <Function ID="13" Name="Windmill CCW Spin" Display="'Windmill CCW Spin'" Dmx="192~207" />
      <Function ID="14" Name="Whirlpool CW Spin" Display="'Whirlpool CW Spin'" Dmx="208~223" />
      <Function ID="15" Name="White Raindrops Piled Up + Turn Blue" Display="'White Raindrops Piled Up + Turn Blue'" Dmx="224~239" />
      <Function ID="16" Name="7 Col Squares Move + Strobe" Display="'7 Col Squares Move + Strobe'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_16-30" Name="Program 16-30" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Lozenge Extend from Centre" Display="'Lozenge Extend from Centre'" Dmx="16~31" />
      <Function ID="3" Name="Lozenge Close up to the Centre (L-R)" Display="'Lozenge Close up to the Centre (L-R)'" Dmx="32~47" />
      <Function ID="4" Name="Audio Signal Analyzing" Display="'Audio Signal Analyzing'" Dmx="48~63" />
      <Function ID="5" Name="All LEDs on and move from L-R, Change Col" Display="'All LEDs on and move from L-R, Change Col'" Dmx="64~79" />
      <Function ID="6" Name="Raindrops Moving from L-R" Display="'Raindrops Moving from L-R'" Dmx="80~95" />
      <Function ID="7" Name="Diamond Spread from Centre" Display="'Diamond Spread from Centre'" Dmx="96~111" />
      <Function ID="8" Name="Diamond Shrinking to the Centre" Display="'Diamond Shrinking to the Centre'" Dmx="112~127" />
      <Function ID="9" Name="Single Col Diamond Spread from Centre" Display="'Single Col Diamond Spread from Centre'" Dmx="128~143" />
      <Function ID="10" Name="Single Col Diamond Shrinking to Centre" Display="'Single Col Diamond Shrinking to Centre'" Dmx="144~159" />
      <Function ID="11" Name="Col Arrow Moving (L-R)" Display="'Col Arrow Moving (L-R)'" Dmx="160~175" />
      <Function ID="12" Name="Col Arrow Moving (Up-Down)" Display="'Col Arrow Moving (Up-Down)'" Dmx="176~191" />
      <Function ID="13" Name="Single Arrow Close Up to Centre Change Col" Display="'Single Arrow Close Up to Centre Change Col'" Dmx="192~207" />
      <Function ID="14" Name="Single Diamond Close Up to Centre Change Col" Display="'Single Diamond Close Up to Centre Change Col'" Dmx="208~223" />
      <Function ID="15" Name="2 Red Arrows Close Up to Centre" Display="'2 Red Arrows Close Up to Centre'" Dmx="224~239" />
      <Function ID="16" Name="Col Rain" Display="'Col Rain'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="dbe347d1-d8ad-4060-a231-b8b013b2bd3e">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Program_1-15" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Program_16-30" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Program_Spd" ChannelOffset="8" Wheel="24" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

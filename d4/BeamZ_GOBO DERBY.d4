  <History Date="30-05-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="56b6b30d-1228-434c-ab56-063ed4750afc" />
  <Control>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Derby_Strobe" Name="Derby Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Derby_Colour" Name="Derby Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="40~49" Colour="255,100,0" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="8" Name="B+A" Display="'B+A'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="R+A" Display="'R+A'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="11" Name="G+A" Display="'G+A'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="B+G+A" Display="'B+G+A'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="R+B+A" Display="'R+B+A'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="R+G+A" Display="'R+G+A'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B" Display="'R+G+B'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="All On" Display="'All On'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="160~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV_Strobe" Name="UV Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="xWhite" Name="White" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~19" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Derby+UV+White Strobe" Display="'Auto Derby+UV+White Strobe'" Dmx="10~19" />
      <Function ID="3" Name="Auto Derby+UV" Display="'Auto Derby+UV'" Dmx="20~29" />
      <Function ID="4" Name="Auto Derby+White Strobe" Display="'Auto Derby+White Strobe'" Dmx="30~39" />
      <Function ID="5" Name="Auto UV+White Strobe" Display="'Auto UV+White Strobe'" Dmx="40~49" />
      <Function ID="6" Name="Auto Derby" Display="'Auto Derby'" Dmx="50~59" />
      <Function ID="7" Name="Auto UV" Display="'Auto UV'" Dmx="60~69" />
      <Function ID="8" Name="Auto White Strobe" Display="'Auto White Strobe'" Dmx="70~79" />
      <Function ID="9" Name="Sound Derby+UV+White Strobe" Display="'Sound Derby+UV+White Strobe'" Dmx="80~89" />
      <Function ID="10" Name="Sound Derby+UV" Display="'Sound Derby+UV'" Dmx="90~99" />
      <Function ID="11" Name="Sound Derby+White Strobe" Display="'Sound Derby+White Strobe'" Dmx="100~109" />
      <Function ID="12" Name="Sound UV+White Strobe" Display="'Sound UV+White Strobe'" Dmx="110~119" />
      <Function ID="13" Name="Sound Derby" Display="'Sound Derby'" Dmx="120~129" />
      <Function ID="14" Name="Sound UV" Display="'Sound UV'" Dmx="130~139" />
      <Function ID="15" Name="Sound White Strobe" Display="'Sound White Strobe'" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

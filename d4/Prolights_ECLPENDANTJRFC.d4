      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />

    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',25.0~0.0" Dmx="0~127" Colour="255,255,255" />

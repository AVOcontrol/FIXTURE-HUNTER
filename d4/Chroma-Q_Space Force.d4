  <Thumbnail>8b082133-1cbe-4490-b017-8947e239516a</Thumbnail>
  <History Date="10-03-18" Author="Nic Morris" Comment="Created" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Revised CTO function to display colour temperature in response to customer feedback (not documented)" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Revised existing mode name and added mode 2" />
  <History Date="22-03-19" Author="Nic Morris" Comment="Added mode 2 Atlabase ID." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a8e87a68-8b75-4560-9d1f-6528dc41720f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fade Off" Display="'Fade Off'" Dmx="11~12" />
      <Function ID="3" Name="Fade On" Display="'Fade On'" Dmx="13~14" />
      <Function ID="4" Name="PWM 750" Display="'PWM 750'" Dmx="71~72" />
      <Function ID="5" Name="PWM 1500" Display="'PWM 1500'" Dmx="73~74" />
      <Function ID="6" Name="PWM 3000" Display="'PWM 3000'" Dmx="75~76" />
      <Function ID="7" Name="PWM 6000" Display="'PWM 6000'" Dmx="77~78" />
      <Function ID="8" Name="PWM 12000" Display="'PWM 12000'" Dmx="79~80" />
      <Function ID="9" Name="PWM 24000" Display="'PWM 24000'" Dmx="81~82" />
      <Function ID="10" Name="PWM 48000" Display="'PWM 48000'" Dmx="83~84" />
      <Function ID="11" Name="PWM 96000" Display="'PWM 96000'" Dmx="85~86" />
      <Function ID="12" Name="RDM On" Display="'RDM On'" Dmx="141~142" />
      <Function ID="13" Name="RDM Off" Display="'RDM Off'" Dmx="143~144" />
      <Function ID="14" Name="No DMX: Hold" Display="'No DMX: Hold'" Dmx="151~152" />
      <Function ID="15" Name="No DMX: Blackout" Display="'No DMX: Blackout'" Dmx="153~154" />
      <Function ID="16" Name="No DMX: Look" Display="'No DMX: Look'" Dmx="157~158" />
      <Function ID="17" Name="Save User Default" Display="'Save User Default'" Dmx="244~245" />
      <Function ID="18" Name="Restore User Default" Display="'Restore User Default'" Dmx="246~247" />
      <Function ID="19" Name="Reset Factory Default" Display="'Reset Factory Default'" Dmx="248~249" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (INT-CCT), 2 DMX" Channels="2">
    <Import PearlRef="CQSPACEF" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d49f1584-81fe-47a5-b3c6-d5672b16784c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 2 (INT-CCT-EXTD), 3 DMX" Channels="3">

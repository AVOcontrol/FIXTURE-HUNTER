      <Palette ID="5" Name="Gobo 4 (Line Horizontally)" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5 (Lines in Circle)" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6 (3 Dots)" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />

      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">

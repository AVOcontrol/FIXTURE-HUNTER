<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Star-Color 240 Wash Light" ShortName="StarCol240" Company="BeamZ">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ff3a9cf7-883b-4639-9b00-e1c8edacdae2</Thumbnail>
  <History Date="17-05-19" Author="Nic Morris" Comment="Created" />
  <History Date="21-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ff1fd6d9-25ea-4439-bab0-cce0ed57fb7f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~90" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Col Trans 1" Display="'Col Trans 1'" Dmx="91~100" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="Col Trans 2" Display="'Col Trans 2'" Dmx="101~110" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="Col Trans 3" Display="'Col Trans 3'" Dmx="111~120" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="Col Trans 4" Display="'Col Trans 4'" Dmx="121~130" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="Col Trans 5" Display="'Col Trans 5'" Dmx="131~140" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="Col Trans 6" Display="'Col Trans 6'" Dmx="141~150" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="Col Trans 7" Display="'Col Trans 7'" Dmx="151~160" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Col Trans 8" Display="'Col Trans 8'" Dmx="161~170" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Col Trans 9" Display="'Col Trans 9'" Dmx="171~180" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="Col Trans 10" Display="'Col Trans 10'" Dmx="181~190" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="All LED" Display="'All LED'" Dmx="191~200" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="White 1" Display="'White 1'" Dmx="201~205" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="White 2" Display="'White 2'" Dmx="206~210" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="White 3" Display="'White 3'" Dmx="211~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="White 4" Display="'White 4'" Dmx="216~220" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="White 5" Display="'White 5'" Dmx="221~225" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="White 6" Display="'White 6'" Dmx="226~230" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="White 7" Display="'White 7'" Dmx="231~235" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="White 8" Display="'White 8'" Dmx="236~240" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="White 9" Display="'White 9'" Dmx="241~245" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="White 10" Display="'White 10'" Dmx="246~250" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="White 11" Display="'White 11'" Dmx="251~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;2&amp;&amp;'Colour_Macro'&lt;13" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="30~39" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="40~49" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="50~59" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="60~69" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="70~79" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="80~89" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="90~99" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="100~109" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="50~99" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="100~149" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="150~199" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="STG, 11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6b1e5a1d-9339-49bd-8cb3-693d157f3aa7" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="37" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="10" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>

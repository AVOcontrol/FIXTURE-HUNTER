  <History Date="13-11-19" Author="Nic Morris" Comment="Created (seems strange the 8-Bit Color mode has a white control.  control function ranges unclear)" Version="1" />
  <History Date="14-11-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="14-06-21" Author="Nic Morris" Comment="Removed white control from 8-Bit Color mode in line with latest documentation in response to customer feedback (original documentation was incorrect)." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d5d85f52-c37d-4fb7-bd17-59f1e47585bd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />

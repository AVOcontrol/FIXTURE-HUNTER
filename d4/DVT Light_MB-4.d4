      <Function ID="8" Name="Sawtooth Running Light" Display="'Sawtooth Running Light'" Dmx="28~31" />
    </Attribute>
    <Attribute ID="Macro_Overlay" Name="Macro Overlay" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Overlay" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Range" Name="Macro Range" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Range" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Level" Name="Macro Level" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Duration" Display="'No Duration'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'Duration %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro1" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Flicker/Glitter" Display="'Flicker/Glitter'" Dmx="4~7" />
      <Function ID="3" Name="Random Pixel" Display="'Random Pixel'" Dmx="8~11" />
    </Attribute>
  </Control>

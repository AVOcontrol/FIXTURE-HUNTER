  <AtlaBase TypeID="10f76269-59c9-494b-a581-f2234671abf7" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="119~20" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="189~120" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="220~234" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="235~249" />
      <Function ID="7" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="204~190" />
      <Function ID="8" Name="Flicker" Display="'Flicker'" Dmx="205~219" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Raw" Display="'Raw'" Dmx="5~9" Colour="255,240,200" />
      <Function ID="3" Name="2000-10000K" Display="'2000-10000K %.fK',2000~10000" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

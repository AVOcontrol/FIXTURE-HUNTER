  <History Date="12-06-25" Author="Nic Morris" Comment="Created (poor documentation.  majority of function ranges missing)" Version="0" />
  <History Date="21-04-26" Author="Nic Morris" Comment="Updated with colour, gobo and fx mode functions in response to customer feedback (not documented).  Added product thumbnail." Version="2" />
  <History Date="25-04-26" Author="Nic Morris" Comment="Changed Atlabase mode IDs to 'version 2' to facilitate aligning with the colour and gobo values provided (version 1 has different values which were provided by the fixture manufacturer)" Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4851db47-21e6-483b-ae13-afbd020ced45" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~249" />
      <Function ID="5" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="108~207" />

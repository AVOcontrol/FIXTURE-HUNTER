<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LAS2000RGB" ShortName="LAS2000RGB" Company="Ibiza Light" Version="0">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>1d5b94f0-2dd6-4ecc-8de6-000044ee5f07</Thumbnail>
  <History Date="12-01-23" Author="Nic Morris" Comment="Created (note there should also be a 34 channel mode but documentation not available)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Power" Name="Power" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Gallery" Name="Gallery" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Gallery" Display="'1 Gallery'" Dmx="0~0" />
      <Function ID="2" Name="2 Gallery" Display="'2 Gallery'" Dmx="16~31" />
      <Function ID="3" Name="3 Gallery" Display="'3 Gallery'" Dmx="32~239" />
      <Function ID="4" Name="40 Gallery" Display="'40 Gallery'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Scenes" Name="Scenes" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Scene" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="96~127" Colour="0,255,0" />
      <Function ID="5" Name="Blue Violet" Display="'Blue Violet'" Dmx="128~159" Colour="180,0,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="160~190" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="191~223" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Power" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Gallery" ChannelOffset="3" Wheel="13" />
      <Attribute ID="Scenes" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="7" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="RGB" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:2" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="8" Name="RGB" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="10" Name="Blue Violet" Number="7" Page="1" SetControl="Colour1:5" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:7" />
      <Palette ID="12" Name="Blue Violet" Number="10" Page="1" SetControl="Colour1:5" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Blue Violet" Number="8" Page="1" SetControl="Colour1:5" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="1d5b94f0-2dd6-4ecc-8de6-000044ee5f07"></Swatch>
  </swatchLibrary>
</Fixture>
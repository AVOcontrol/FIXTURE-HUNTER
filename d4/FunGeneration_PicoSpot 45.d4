  <History Date="22-01-25" Author="Nic Morris" Comment="Created (poor documentation)" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3bf8cc9f-d056-488a-b302-2930b0ca2ce6" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~21" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="22~32" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="33~43" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="44~54" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="55~65" Colour="0,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="66~76" Colour="0,255,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="77~87" Colour="128,0,255" />
      <Function ID="9" Name="Colour Selection 6+" Display="'Colour Selection 6+ %.f%%',0~100" Dmx="88~175" Colour="255,255,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="176~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gobo" Display="'Gobo %.1f%%',0.0~100.0" Dmx="0~124" />
      <Function ID="2" Name="Gobo Shake" Display="'Gobo Shake %.1f%%',0.0~100.0" Dmx="125~249" />
      <Function ID="3" Name="Gobo Wheel" Display="'Gobo Wheel'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="White" Display="'White'" Dmx="50~59" />
      <Function ID="3" Name="Scene 2 (empty)" Display="'Scene 2 (empty)'" Dmx="60~69" />
      <Function ID="4" Name="Scene 3 (empty)" Display="'Scene 3 (empty)'" Dmx="70~79" />
      <Function ID="5" Name="Scene 4 (empty)" Display="'Scene 4 (empty)'" Dmx="80~89" />
      <Function ID="6" Name="Scene 5 (empty)" Display="'Scene 5 (empty)'" Dmx="90~99" />
      <Function ID="7" Name="Scene 6 (empty)" Display="'Scene 6 (empty)'" Dmx="100~109" />
      <Function ID="8" Name="Scene 7 (empty)" Display="'Scene 7 (empty)'" Dmx="110~119" />
      <Function ID="9" Name="Scene 8 (empty)" Display="'Scene 8 (empty)'" Dmx="120~129" />
      <Function ID="10" Name="Scene 9 (empty)" Display="'Scene 9 (empty)'" Dmx="130~139" />
      <Function ID="11" Name="Program 1" Display="'Program 1'" Dmx="140~149" />
      <Function ID="12" Name="Program 2" Display="'Program 2'" Dmx="150~159" />
      <Function ID="13" Name="Program 3" Display="'Program 3'" Dmx="160~169" />
      <Function ID="14" Name="Program 4" Display="'Program 4'" Dmx="170~179" />
      <Function ID="15" Name="Program 5" Display="'Program 5'" Dmx="180~189" />
      <Function ID="16" Name="Program 6" Display="'Program 6'" Dmx="190~199" />
      <Function ID="17" Name="Program 7" Display="'Program 7'" Dmx="200~209" />
      <Function ID="18" Name="Program 8 (empty)" Display="'Program 8 (empty)'" Dmx="210~219" />
      <Function ID="19" Name="Program 9 (empty)" Display="'Program 9 (empty)'" Dmx="220~229" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

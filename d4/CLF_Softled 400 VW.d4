      <Function ID="6" Name="6000 K" Display="'6000 K'" Dmx="111~135" Colour="255,255,255" />
      <Function ID="7" Name="User 1" Display="'User 1'" Dmx="136~160" Colour="255,255,255" />
      <Function ID="8" Name="User 2" Display="'User 2'" Dmx="161~185" Colour="255,255,255" />
      <Function ID="9" Name="User 3" Display="'User 3'" Dmx="186~210" Colour="255,255,255" />
      <Function ID="10" Name="User 4" Display="'User 4'" Dmx="211~235" Colour="255,255,255" />
      <Function ID="11" Name="User 5" Display="'User 5'" Dmx="236~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

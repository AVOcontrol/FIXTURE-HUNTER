      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Preset_CT" Name="Preset CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200 K" Display="'3200 K'" Dmx="11~35" Colour="255,255,255" />
      <Function ID="3" Name="4000 K" Display="'4000 K'" Dmx="36~60" Colour="255,255,255" />
      <Function ID="4" Name="5000 K" Display="'5000 K'" Dmx="61~85" Colour="255,255,255" />

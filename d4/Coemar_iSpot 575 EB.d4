    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="11~20" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="21~136" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="137~139" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="255~140" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="8~27" WheelPosition="1" Colour="255,100,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="28~47" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="48~67" WheelPosition="3" Colour="100,255,100" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="68~87" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="88~107" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="108~127" WheelPosition="6" Colour="0,255,0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Org/ Rd" Display="'Org/ Rd %.f%%',0~100" Dmx="8~27" WheelPosition="1" Colour="255,100,0" />
      <Function ID="10" Name="Rd/ L Grn" Display="'Rd/ L Grn %.f%%',0~100" Dmx="28~47" WheelPosition="2" Colour="255,0,0" />
      <Function ID="11" Name="L Grn/ Blu" Display="'L Grn/ Blu %.f%%',0~100" Dmx="48~67" WheelPosition="3" Colour="100,255,100" />

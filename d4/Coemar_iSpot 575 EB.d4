      <Function ID="12" Name="L Mag/ Cy" Display="'L Mag/ Cy %.f%%',0~100" Dmx="68~87" WheelPosition="4" Colour="255,100,255" />
      <Function ID="13" Name="Cy/ Mag" Display="'Cy/ Mag %.f%%',0~100" Dmx="88~107" WheelPosition="5" Colour="0,255,255" />
      <Function ID="14" Name="Mag/ Op" Display="'Mag/ Op %.f%%',0~100" Dmx="108~127" WheelPosition="6" Colour="255,0,255" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />

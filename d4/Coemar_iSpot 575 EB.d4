      <Function ID="9" Name="Lamp On" Display="'Lamp On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="8~27" WheelPosition="1" Colour="255,225,200" />
      <Function ID="3" Name="Light Cyan" Display="'Light Cyan'" Dmx="28~47" WheelPosition="2" Colour="150,255,255" />
      <Function ID="4" Name="Amber" Display="'Amber'" Dmx="48~67" WheelPosition="3" Colour="255,75,0" />
      <Function ID="5" Name="Light Magenta" Display="'Light Magenta'" Dmx="68~87" WheelPosition="4" Colour="255,100,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="88~107" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="108~127" WheelPosition="6" Colour="255,0,255" />

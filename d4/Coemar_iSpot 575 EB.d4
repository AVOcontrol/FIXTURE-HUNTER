  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" Version="4" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. M Speed - Invert legends so 100%-0% for vector + tracking ranges" Version="5" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Dimmer - (Power On) Not 0" Version="6" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Shutter - Invert legend so 100%-0% for range 128-184" Version="7" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 5. Zoom - Step position so no scroll needed" Version="8" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 6. Gobo 1 + 2 Rot - Invert legends for ranges 101-176 = 0-100%, 180-255 = 100%-0" Version="9" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 7. Prism - Invert DMX range 140-255 + legending" Version="10" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 8. Colour 1 + 2 - Invert legend for range 128-190 100%-0" Version="11" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 9. E/C Pos - No preset positions for functions" Version="12" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 10. Effect - Scrolling range incorrect. Should be 31-249" Version="13" />
  <History Date="26-05-04" Author="Greg Brown" Comment="Above Errors Corrected" Version="14" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Vector and Tracking are inverted on MSpeed channel" Version="15" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Close pulse is inverted on Shutter channel" Version="16" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Focus should power on and locate at 50%" Version="17" />
  <History Date="11-08-05" Author="Ed" Comment="Error: gobo func is behaving in a bizzare fashion" Version="18" />
  <History Date="11-08-05" Author="Ed" Comment="Error: CW and CCW are inverted on Gobo1 rot" Version="19" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Gobo 2 needs its own function wheel" Version="20" />
  <History Date="11-08-05" Author="Ed" Comment="Error: CW and CCW inverted on Gobo 2 rot" Version="21" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Scroll CCW wrong on colour wheel 1. Function wheel also needs updating" Version="22" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Effect wheel should be on effect page" Version="23" />
  <History Date="11-08-05" Author="Ed" Comment="Fixed all above errors" Version="24" />

      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="G/C_Pos, Colour2, Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="G/C_Pos, Colour2, Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="G/C_Pos, Colour2, Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="G/C_Pos, Colour2, Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="G/C_Pos, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="G/C_Pos, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="G/C_Pos, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="G/C_Pos, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="G/C_Pos" Name="G/C Pos" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="G/C Fixed" ID="1" If="'Gobo1Func'==1&amp;&amp;'Colour1Func'==1" />
      <Condition Name="G Index/C Fixed" ID="2" If="'Gobo1Func'==2&amp;&amp;'Colour1Func'==1" />
      <Condition Name="G Fixed/C Index" ID="3" If="'Gobo1Func'==1&amp;&amp;'Colour1Func'==2" />
      <Condition Name="G/C Index" ID="4" If="'Gobo1Func'==2&amp;&amp;'Colour1Func'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="G/C Fixed" Display="'G/C Fixed'" Dmx="0~0" />
      <Function ID="2" Name="G Index/C Fixed" Display="'G Index/C Fixed'" Dmx="11~125" />
      <Function ID="3" Name="G Fixed/C Index" Display="'G Fixed/C Index'" Dmx="126~139" />
      <Function ID="4" Name="G/C Index" Display="'G/C Index'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

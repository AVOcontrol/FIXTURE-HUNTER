  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Ultra Fast" Display="'Ultra Fast'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Tracking" Display="'Tracking %.f%%',0~100" Dmx="247~128" />
      <Function ID="5" Name="Tracking" Display="'Tracking'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~66" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="69~125" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="128~184" Intensity="0~0" />
      <Function ID="6" Name="Random" Display="'Rnd %.f%%',0~100" Dmx="188~244" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="129~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="130~189" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="190~192" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Pls w/Strobe" Display="'Pls w/Strobe %.f%%',0~100" Dmx="193~251" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="252~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Iris Lens" Display="'Iris'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="21 Beam Size" Display="'21'" Dmx="96~171" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="25 Beam Size" Display="'25'" Dmx="172~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="15,16" If="'Gobo1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6ad7bfed-fe73-4656-9171-f8d4c396867b</Swatch>

      <Function ID="14" Name="6/ Op" Display="'6/ Op'" Dmx="167~179" WheelPosition="6" Colour="0,0,0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="180~187" WheelPosition="0" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="188~219" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />

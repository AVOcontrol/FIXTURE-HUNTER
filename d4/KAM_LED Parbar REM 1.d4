<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Parbar REM 1" ShortName="ParbarREM1" Company="KAM">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="29-11-11" Author="Gregory Haynes" Comment="Created from Colour Storm Tri" />
  <History Date="11-07-13" Author="Peter Budd" Comment="Created from the LedJ Colour Storm RGB." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="C-Mix" Display="'C-Mix'" Dmx="0~9" Colour="0,0,0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="10~29" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="30~49" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="50~69" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="70~89" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="90~109" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="110~129" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="130~149" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="150~169" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="170~189" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="190~209" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="210~229" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="230~249" Colour="0,0,0" />
      <Function ID="14" Name="All Modes" Display="'All Modes'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red4" Name="Red 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green4" Name="Green 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue4" Name="Blue 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="KA_PrBrREM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red1" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Red2" ChannelOffset="7" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="8" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="9" Wheel="42" />
      <Attribute ID="Red3" ChannelOffset="10" Wheel="70" />
      <Attribute ID="Green3" ChannelOffset="11" Wheel="71" />
      <Attribute ID="Blue3" ChannelOffset="12" Wheel="72" />
      <Attribute ID="Red4" ChannelOffset="13" Wheel="100" />
      <Attribute ID="Green4" ChannelOffset="14" Wheel="101" />
      <Attribute ID="Blue4" ChannelOffset="15" Wheel="102" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="RGB cell, 3 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="RGB cell, 3 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="RGB cell, 3 DMX" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="RGB cell, 3 DMX" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="RGB cell, 3 DMX" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>

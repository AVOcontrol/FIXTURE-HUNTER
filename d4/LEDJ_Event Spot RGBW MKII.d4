      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~10" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">

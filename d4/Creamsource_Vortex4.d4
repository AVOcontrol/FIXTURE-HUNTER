      <Function ID="21" Name="(Preset) Blue/Red Burst" Display="'(Preset) Blue/Red Burst'" Dmx="80~89" />
      <Function ID="22" Name="(Preset) BlueRed Rapid" Display="'(Preset) BlueRed Rapid'" Dmx="90~99" />
      <Function ID="23" Name="(Preset) Blue/Red/White Rapid" Display="'(Preset) Blue/Red/White Rapid'" Dmx="100~109" />

      <Condition Name="Television" ID="30" If="'Effect'==10" />
      <Condition Name="Paparazzi" ID="31,32" If="'Effect'==11" />
      <Condition Name="Party" ID="33,34,35" If="'Effect'==12" />
      <Else ID="36" />
      <Function ID="1" Name="Sync" Display="'Sync %.1f%%',0.0~100.0" Dmx="0~255" />

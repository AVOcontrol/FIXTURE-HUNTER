      <Function ID="20" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="21" Name="(Col Combination) Blue" Display="'(Col Combination) Blue'" Dmx="0~0" />
      <Function ID="22" Name="(Col Combination) Blue, Red" Display="'(Col Combination) Blue, Red'" Dmx="15~29" />
      <Function ID="23" Name="(Col Combination) Blue, White" Display="'(Col Combination) Blue, White'" Dmx="30~44" />

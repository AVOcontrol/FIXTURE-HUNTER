  <History Date="09-09-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="13-09-20" Author="Nic Morris" Comment="Corrected xFade CCT-Col DMX end value in response to customer feedback (was set to 255 in 16bit)" Version="3" />
  <History Date="15-01-21" Author="Nic Morris" Comment="Created from Creamsource SpaceX (note mode 31 is not currently supported.  modes 23 and 29 charts missing channels - assume mistake and bunched up)" Version="4" />
  <History Date="30-10-21" Author="Nic Morris" Comment="Updated in line with v1.2 (adds v1.2 multi zone modes, calibrate sync effect and revises flash frames effect params." Version="11" />
  <History Date="20-03-23" Author="Nic Morris" Comment="Created from Creamsource Vortex8" Version="13" />
  <History Date="02-07-23" Author="Nic Morris" Comment="Updated in line with latest firmware (DMX table 2.5, document revision A).  Changes reserved to control channel and adds modes 38-67." Version="15" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="db0fc9ed-8819-4000-a6ee-73f6a8aa62e9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2200" PowerOn="1:2200" />

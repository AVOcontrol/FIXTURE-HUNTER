    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="36:0" PowerOn="36:0" />
      <Condition Name="Strobe/Col Cycle" ID="1,2" If="'Effect'==2||'Effect'==7" />
      <Condition Name="Random" ID="3" If="'Effect'==3" />
      <Condition Name="Flash Frames" ID="4" If="'Effect'==4" />
      <Condition Name="Dual Level" ID="5,6" If="'Effect'==5" />
      <Condition Name="Timed Flash" ID="7,8" If="'Effect'==6" />
      <Condition Name="Candle+Fire" ID="9" If="'Effect'==8" />

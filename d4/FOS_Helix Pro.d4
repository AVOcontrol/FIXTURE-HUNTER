<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Helix Pro" ShortName="Helix Pro" Company="FOS">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>1fbaed85-9464-4338-9fb1-58e707a4fa6d</Thumbnail>
  <History Date="13-06-12" Author="Peter Budd" Comment="Created" />
  <History Date="23-08-12" Author="Peter Budd" Comment="Created from Terbly OV370Z-R" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Elation Platinum Wash ZXF Pro XL" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Clay Paky A.leda K20" />
  <History Date="30-10-12" Author="Peter Budd" Comment="Edited extended mode to include cell layout. Added RGBW master channels and added attribute links to RGBW cells" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Increased 16-bit functions to 2dp.  Standardised shutted function order." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Added detailed functions to Colour Macro and Function attributes." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Fixed shape mode.  Added Extended RGBW mode." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Created from Clay Paky A.leda Wash K10" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="02-03-14" Author="Nic Morris" Comment="Added 'Full' mode and brought in line with latest spec." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Updated Shape strobe, Back strobe and back select to latest spec." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Updated shapes." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Added shape offset conditional functions for new shapes." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Revised wheel mappings and attribute groups." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Fixed lens rot CW spin range.  Changed lens rot spin display to value 1dp to provide full resolution." />
  <History Date="02-01-15" Author="Nic Morris" Comment="Updated to 11.2014 spec" />
  <History Date="24-11-15" Author="Nic Morris" Comment="Fixed extended mapping" />
  <History Date="18-02-16" Author="Nic Morris" Comment="Created from Clay Paky A.leda B-EYE K10" />
  <History Date="19-02-16" Author="Nic Morris" Comment="Changed name from HELIOS to HELIX" />
  <History Date="06-01-20" Author="Nic Morris" Comment="Created from FOS HELIX (hopeless documentation - littered with errors.  made best guess.  no pixel layout - assumed same as Clay Paky)" />
  <History Date="09-01-20" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="10-01-20" Author="Nic Morris" Comment="Changed RGB masters to locate at zero." />
  <Manual Filename=" Summary=" Summary="" />
  <AtlaBase TypeID="b7c3b0a4-53c8-49f8-a4dd-4b21b8fcac45" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

      <Function ID="2" Name="Static Shapes" Display="'Static Shapes %.f%%',0~100" Dmx="8~13" WheelPosition="0" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="14~14" WheelPosition="0" />

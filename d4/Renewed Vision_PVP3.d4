    </Attribute>
    <Attribute ID="Transition" Name="Transition" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Opacity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Opacity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blend_Mode" Name="Blend Mode" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blend Mode" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control_Type1" Name="Control Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Clear" Display="'Clear'" Dmx="1~5" />
      <Function ID="3" Name="Mute" Display="'Mute'" Dmx="6~10" />
      <Function ID="4" Name="Unmute" Display="'Unmute'" Dmx="11~15" />
      <Function ID="5" Name="Hide" Display="'Hide'" Dmx="16~20" />
      <Function ID="6" Name="Unhide" Display="'Unhide'" Dmx="21~25" />
      <Function ID="7" Name="Play" Display="'Play'" Dmx="26~30" />
      <Function ID="8" Name="Pause" Display="'Pause'" Dmx="31~35" />
      <Function ID="9" Name="Go to Beginning" Display="'Go to Beginning'" Dmx="36~40" />
      <Function ID="10" Name="Go to End" Display="'Go to End'" Dmx="41~45" />
      <Function ID="11" Name="Jump Back" Display="'Jump Back'" Dmx="46~50" />

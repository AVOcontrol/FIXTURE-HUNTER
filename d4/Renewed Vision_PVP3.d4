  <History Date="05-01-20" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Folder" Name="Playlist" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Playlist" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="File" Name="Cue" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cue" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Target_Layer" Name="Target Layer" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Target Layer" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control_Type" Name="Control Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Clear" Display="'Clear'" Dmx="1~5" />
      <Function ID="3" Name="Mute" Display="'Mute'" Dmx="6~10" />
      <Function ID="4" Name="Unmute" Display="'Unmute'" Dmx="11~15" />
      <Function ID="5" Name="Hide" Display="'Hide'" Dmx="21~25" />
      <Function ID="6" Name="Unhide" Display="'Unhide'" Dmx="26~30" />
      <Function ID="7" Name="Play" Display="'Play'" Dmx="31~35" />
      <Function ID="8" Name="Pause" Display="'Pause'" Dmx="36~40" />
      <Function ID="9" Name="Previous Playlist" Display="'Previous Playlist'" Dmx="41~45" />
      <Function ID="10" Name="Next Playlist" Display="'Next Playlist'" Dmx="46~50" />
      <Function ID="11" Name="Remove Effects" Display="'Remove Effects'" Dmx="60~65" />
      <Function ID="12" Name="Mask" Display="'Mask'" Dmx="66~70" />
      <Function ID="13" Name="Effects Preset" Display="'Effects Preset'" Dmx="71~75" />
      <Function ID="14" Name="Transition" Display="'Transition'" Dmx="76~80" />
      <Function ID="15" Name="Output On" Display="'Output On'" Dmx="81~85" />
      <Function ID="16" Name="Output Off" Display="'Output Off'" Dmx="86~90" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control_Value" Name="Control Value" Description="" Group="G">

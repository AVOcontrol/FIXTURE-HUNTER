  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="23-09-24" Author="Nic Morris" Comment="Created (confusing documentation.  many function ranges not defined, not defined fully or contain range conflicts.  it is not clear what the various controls relate to.  made best guess)" Version="0" />
  <History Date="27-09-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="06-11-24" Author="Nic Morris" Comment="Created from Sebo Super Cyclone Max (identical)" Version="7" />
  <History Date="08-11-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="19-05-25" Author="Nic Morris" Comment="Created from Color Imagination CRAZYBAR 66M (CM66) (conflicting tilt ranges.  documentation suffers from all the same problems - looks identical except with the brand name changed)" Version="9" />
  <History Date="20-05-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="34a51770-5240-4569-a29a-f0a08fc29953" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

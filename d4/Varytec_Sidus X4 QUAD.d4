  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5e861a7c-a36b-4d57-889e-875609a77e52" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="10~174" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="175~189" Colour="0,0,0" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="190~204" Colour="0,0,0" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="205~219" Colour="0,0,0" />
      <Function ID="6" Name="8500K" Display="'8500K'" Dmx="220~234" Colour="0,0,0" />
      <Function ID="7" Name="10000K" Display="'10000K'" Dmx="235~249" Colour="0,0,0" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto " Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~40" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="41~50" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~60" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~70" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="71~80" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="81~90" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="91~100" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="101~110" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="111~120" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Spd 1" Display="'Dim Spd 1'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd 2" Display="'Dim Spd 2'" Dmx="50~99" />
      <Function ID="3" Name="Dim Spd 3" Display="'Dim Spd 3'" Dmx="100~149" />
      <Function ID="4" Name="Dim Spd 4" Display="'Dim Spd 4'" Dmx="150~199" />
      <Function ID="5" Name="Dim Spd 5" Display="'Dim Spd 5'" Dmx="200~255" />
    </Attribute>
  </Control>

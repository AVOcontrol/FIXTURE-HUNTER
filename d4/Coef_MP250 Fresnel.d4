      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7905f1f8-7e0a-4021-8688-a5ff20b73273" />
    <Include>
      <Attribute ID="Shutter1" ChannelOffset="1" Wheel="4" />

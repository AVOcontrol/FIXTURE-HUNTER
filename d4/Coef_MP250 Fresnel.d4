  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="5" Name="Wood" Number="0" Page="1" SetControl="Colour1:12,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour2:2,Colour2Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour2:2,Colour2Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1,Colour2Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
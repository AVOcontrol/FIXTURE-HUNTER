<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Freedom Par Tri-6" ShortName="Free Tri-6" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-03-16" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added missing Atlabase ID to 4 DMX mode." />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added vdim to 4 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1c85cf14-8e43-4127-8731-d27956f2bb7b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="4 DMX 1" ID="2,3" If="'Effect'&gt;1&amp;&amp;'Effect'&lt;18" />
      <Condition Name="4 DMX 2" ID="4" If="'Effect'&gt;17" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="4 DMX" ID="2,3" If="'Effect'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~249" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~120" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="121~180" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="181~240" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Mode" Display="'RGB Mode'" Dmx="207~215" Update="Red, Green" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Red, Green" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="9~28" Update="Red, Green" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="29~48" Update="Red, Green" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="49~68" Update="Red, Green" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="69~88" Update="Red, Green" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="89~108" Update="Red, Green" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="109~128" Update="Red, Green" />
      <Function ID="9" Name="R+G+B" Display="'R+G+B'" Dmx="129~143" Update="Red, Green" />
      <Function ID="10" Name="Chase 1" Display="'Chase 1'" Dmx="144~152" Update="Red, Green" />
      <Function ID="11" Name="Chase 2" Display="'Chase 2'" Dmx="153~161" Update="Red, Green" />
      <Function ID="12" Name="Chase 3" Display="'Chase 3'" Dmx="162~170" Update="Red, Green" />
      <Function ID="13" Name="Chase 4" Display="'Chase 4'" Dmx="171~179" Update="Red, Green" />
      <Function ID="14" Name="Chase 5" Display="'Chase 5'" Dmx="180~188" Update="Red, Green" />
      <Function ID="15" Name="Chase 6" Display="'Chase 6'" Dmx="189~197" Update="Red, Green" />
      <Function ID="16" Name="Chase 7" Display="'Chase 7'" Dmx="198~206" Update="Red, Green" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Red, Green" />
      <Function ID="18" Name="Snap" Display="'Snap'" Dmx="216~224" Update="Red, Green" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="225~233" Update="Red, Green" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="CHFPTR69" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

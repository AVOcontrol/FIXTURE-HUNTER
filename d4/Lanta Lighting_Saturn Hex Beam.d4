<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Saturn Hex Beam" ShortName="St Hx Beam" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="29-11-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~10" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="11~21" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="22~32" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="33~43" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="44~54" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="55~65" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="66~76" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="77~87" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="88~98" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="99~109" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="110~120" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="121~131" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="132~142" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="143~153" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="154~164" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="165~175" Colour="0,0,0" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="176~177" Colour="0,0,0" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="178~188" Colour="0,0,0" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="189~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="LH_SatnHxBm" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
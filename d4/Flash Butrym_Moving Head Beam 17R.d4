      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="117~127" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="128~191" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_1_Rot" Name="Prism 1 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

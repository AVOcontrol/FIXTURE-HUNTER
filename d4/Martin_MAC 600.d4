  <AtlaBase TypeID="9818bb15-6382-4b66-a209-7aaffc0c8e29" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="112~50" Intensity="0~0" />
      <Function ID="4" Name="Open Low" Display="'Open Low'" Dmx="116~122" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="187~128" Intensity="0~0" />
      <Function ID="6" Name="Safe" Display="'Safe'" Dmx="20~49" Intensity="0~0" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" Intensity="0~0" />
      <Function ID="9" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="6,7,8,9,10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="15,16" If="'Colour1Func'==4" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="176~180" WheelPosition="1" Colour="185,217,216" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="171~175" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="166~170" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="161~165" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="7" Name="Op - CTC" Display="'Op - CTC %.f%%',0~100" Dmx="0~40" WheelPosition="1" Colour="0,0,0" />
      <Function ID="8" Name="CTC - Rd" Display="'CTC - Rd %.f%%',0~100" Dmx="40~80" WheelPosition="2" Colour="0,0,0" />
      <Function ID="9" Name="Rd - Grn" Display="'Rd - Grn %.f%%',0~100" Dmx="80~120" WheelPosition="3" Colour="0,0,0" />
      <Function ID="10" Name="Grn - Blu" Display="'Grn - Blu %.f%%',0~100" Dmx="120~160" WheelPosition="4" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="186~214" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="215~243" Colour="0,0,0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="16" Name="Rand" Display="'Rand %.f%%',0~100" Dmx="255~244" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="BeamShape1" Name="Beam Shaper 1" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Shaper" Display="'Shaper %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="BeamShape2" Name="Beam Shaper 2" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Shaper" Display="'Shaper %.1f%%',0.0~100.0" Dmx="3~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="245~3" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="246~248" />
      <Function ID="4" Name="P/T Fast" Display="'P/T Fast'" Dmx="249~251" />
      <Function ID="5" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="239~3" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Studio Off" Display="'Studio Off'" Dmx="240~242" />
      <Function ID="4" Name="Studio On" Display="'Studio On'" Dmx="243~245" />
      <Function ID="5" Name="Shortcut Off" Display="'Shortcut Off'" Dmx="246~248" />
      <Function ID="6" Name="Shortcut On" Display="'Shortcut On'" Dmx="249~252" />
      <Function ID="7" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
  </Control>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d9f2cbcb-bd27-42b8-b606-52b8d956cd31" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:3000" PowerOn="1:3000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3000~6000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~60" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~80" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="81~100" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="101~120" />
      <Function ID="7" Name="Sound 1" Display="'Sound 1'" Dmx="121~147" />
      <Function ID="8" Name="Sound 2" Display="'Sound 2'" Dmx="148~174" />
      <Function ID="9" Name="Sound 3" Display="'Sound 3'" Dmx="175~201" />
      <Function ID="10" Name="Sound 4" Display="'Sound 4'" Dmx="202~228" />
      <Function ID="11" Name="Sound 5" Display="'Sound 5'" Dmx="229~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1 (Fast)" Display="'Curve 1 (Fast)'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~181" />
      <Function ID="6" Name="Curve 4 (Slow)" Display="'Curve 4 (Slow)'" Dmx="190~255" />
    </Attribute>
  </Control>

      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="6~54" />
      <Function ID="4" Name="Random All" Display="'Random All %.f%%',0~100" Dmx="153~201" />

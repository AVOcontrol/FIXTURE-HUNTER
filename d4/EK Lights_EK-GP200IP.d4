<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-GP200IP" ShortName="EK-GP200IP" Company="EK Lights" Version="4">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="21-01-18" Author="Nic Morris" Comment="Created (missing gobos swatches - no slot numbers)" Version="1" />
  <History Date="23-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="16-12-18" Author="Nic Morris" Comment="Added 16 channel mode." Version="3" />
  <History Date="31-08-20" Author="Nic Morris" Comment="Created from Prolights MOSAICO (colours not detailed.  assumed identical)" Version="4" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="8~11" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Dark Blue" Display="'Dark Blue'" Dmx="16~19" WheelPosition="2" Colour="0,0,180" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="24~27" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~35" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Light Orange" Display="'Light Orange'" Dmx="40~43" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="48~51" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="56~59" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ D Blu" Display="'D Rd/ D Blu'" Dmx="12~15" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="D Blu/ Yel" Display="'D Blu/ Yel'" Dmx="20~23" WheelPosition="2" Colour="0,0,180" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="28~31" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ L Org" Display="'Grn/ L Org'" Dmx="36~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="L Org/ Mag" Display="'L Org/ Mag'" Dmx="44~47" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Mag/ UV" Display="'Mag/ UV'" Dmx="52~55" WheelPosition="6" Colour="255,0,255" />
      <Function ID="16" Name="UV/ Op" Display="'UV/ Op'" Dmx="60~63" WheelPosition="7" Colour="180,0,255" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="64~94" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="97~127" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour2Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour2Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour2Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="8~11" WheelPosition="1" Colour="255,240,200" />
      <Function ID="3" Name="Jade" Display="'Jade'" Dmx="16~19" WheelPosition="2" Colour="0,255,200" />
      <Function ID="4" Name="CTB" Display="'CTB'" Dmx="24~27" WheelPosition="3" Colour="230,230,255" />
      <Function ID="5" Name="Pink" Display="'Pink'" Dmx="32~35" WheelPosition="4" Colour="255,150,150" />
      <Function ID="6" Name="Light Green" Display="'Light Green'" Dmx="40~43" WheelPosition="5" Colour="128,255,0" />
      <Function ID="7" Name="Dark Orange" Display="'Dark Orange'" Dmx="48~51" WheelPosition="6" Colour="255,100,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="56~59" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Op/ CTO" Display="'Op/ CTO'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="CTO/ Jd" Display="'CTO/ Jd'" Dmx="12~15" WheelPosition="1" Colour="255,240,200" />
      <Function ID="11" Name="Jd/ CTB" Display="'Jd/ CTB'" Dmx="20~23" WheelPosition="2" Colour="0,255,200" />
      <Function ID="12" Name="CTB/ Pk" Display="'CTB/ Pk'" Dmx="28~31" WheelPosition="3" Colour="230,230,255" />
      <Function ID="13" Name="Pk/ L Grn" Display="'Pk/ L Grn'" Dmx="36~39" WheelPosition="4" Colour="255,150,150" />
      <Function ID="14" Name="L Grn/ D Org" Display="'L Grn/ D Org'" Dmx="44~47" WheelPosition="5" Colour="128,255,0" />
      <Function ID="15" Name="D Org/ Cy" Display="'D Org/ Cy'" Dmx="52~55" WheelPosition="6" Colour="255,100,0" />
      <Function ID="16" Name="Cy/ Op" Display="'Cy/ Op'" Dmx="60~63" WheelPosition="7" Colour="0,255,255" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="64~94" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="97~127" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~10" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="11~15" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="16~20" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="21~25" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="26~30" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="31~35" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="36~40" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="41~55" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="56~70" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="71~85" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="86~100" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="101~115" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="116~130" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="131~145" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="200~201" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="146~199" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="200~201" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="202~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="222~225" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="192~221" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="222~225" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="226~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Prism1" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism Index" Display="'Prism Index'" Dmx="21~127" Update="Prism_Rot" />
      <Function ID="3" Name="Prism Spin" Display="'Prism Spin'" Dmx="128~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Prism1'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism1'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="4~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Animation1" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Animation" Display="'Animation %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="221~192" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="222~225" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="255~226" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="60~69" />
      <Function ID="3" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="70~79" />
      <Function ID="4" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="80~89" />
      <Function ID="5" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="90~99" />
      <Function ID="6" Name="Reset Col 1" Display="'Reset Col 1'" Dmx="100~109" />
      <Function ID="7" Name="Reset Col 2" Display="'Reset Col 2'" Dmx="110~119" />
      <Function ID="8" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~129" />
      <Function ID="9" Name="Reset Prism" Display="'Reset Prism'" Dmx="130~139" />
      <Function ID="10" Name="Reset Focus" Display="'Reset Focus'" Dmx="140~149" />
      <Function ID="11" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="150~159" />
      <Function ID="12" Name="Reset Frost" Display="'Reset Frost'" Dmx="160~169" />
      <Function ID="13" Name="Reset Effect" Display="'Reset Effect'" Dmx="170~179" />
      <Function ID="14" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />

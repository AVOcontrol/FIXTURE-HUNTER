  </Mode>
  <Mode Name="Scenes Record, 12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="4" Wheel="38" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="6" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Frost" ChannelOffset="8" Wheel="21" />

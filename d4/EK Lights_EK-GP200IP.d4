      <Attribute ID="Prism1" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="8" Wheel="24" />
      <Attribute ID="Frost" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="11" Wheel="19" />
      <Attribute ID="Animation1" ChannelOffset="12" Wheel="52" />

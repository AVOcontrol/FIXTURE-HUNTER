<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mega Storm" ShortName="Mega Storm" Company="AUVI" Version="31">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>953c7e7f-c438-4694-95c8-245c882a0eb1</Thumbnail>
  <History Date="03-02-17" Author="Nic Morris" Comment="Created (note function ranges in percentage values only which do not convert precisely)" Version="1" />
  <History Date="03-02-17" Author="Nic Morris" Comment="NOTE THIS WILL BREAK IF OPENED IN PERSONALITY BUILDER!" Version="2" />
  <History Date="23-05-17" Author="Nic Morris" Comment="Revised in line with V1.16-22-14 charts" Version="3" />
  <History Date="07-08-17" Author="Nic Morris" Comment="Updated to v1.35 FW (renamed existing modes, added new, revised shutter &amp; control functions - note chart errors in control function ranges)." Version="4" />
  <History Date="11-08-17" Author="Nic Morris" Comment="Added Atlabase ID's for modes 1, 5 and 4." Version="5" />
  <History Date="19-08-17" Author="Nic Morris" Comment="Added vdim to pixel cell linked to pixel dimmer in master + replaced pixel dimmer w/pixel master in 68ch mode in attempt to fix customer bug report." Version="6" />
  <History Date="24-08-17" Author="Nic Morris" Comment="Changed all dimmers to locate at full." Version="7" />
  <History Date="24-08-17" Author="Nic Morris" Comment="Added split mode 2 options." Version="8" />
  <History Date="01-10-18" Author="Nic Morris" Comment="Updated in line with software version 1.70-68-18.  Added missing macros.  Added product thumbnail." Version="9" />
  <History Date="02-10-18" Author="Nic Morris" Comment="Fixed spelling of 'Aggressive'." Version="10" />
  <History Date="02-10-18" Author="Nic Morris" Comment="Clarification of the history tag on 03-02-17 regarding breaking if opened in Personality Builder:" Version="11" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) If this personality is opened in an earlier version of Personality Builder than 3.1.4.5 it will remove some or all of the cell links." Version="12" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) if this is then saved/used in a show it will not prevent the personality from working but it will prevent" Version="13" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) the ability to control cell controls from the master fixture (notably including the locate function)" Version="14" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) and may cause issues with other console functions such as record by fixture and tracking." Version="15" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) Therefore, if this occurs (or has occurred) the links should be reinstated.  This should be done using" Version="16" />
  <History Date="02-10-18" Author="Nic Morris" Comment="version 3.1.4.5 (or later if available) of Personality Builder." Version="17" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) Ideally this Personality should be opened in Personality Builder version 3.1.4.5 or later where the cell links will be preserved correctly." Version="18" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) You can check the current version of Personality Builder on a console by going to the Tools menu and selecting 'About'." Version="19" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) on a PC right-click on the Personality Builder.exe application, select 'Properties' and then the 'Details' tab." Version="20" />
  <History Date="04-08-22" Author="Nic Morris" Comment="Added mode 3 mulitpart patch options." Version="21" />
  <History Date="04-08-22" Author="Nic Morris" Comment="Added mode 4 multipart patch options." Version="22" />
  <History Date="28-07-23" Author="Nic Morris" Comment="(re)Created from GLP JDC1.  Effectively identical.  Completely different to original documentation.  All control ranges are missing." Version="23" />
  <History Date="19-08-23" Author="Nic Morris" Comment="Created from XBlack Solo Strobe R (effectively identical)" Version="24" />
  <History Date="24-03-24" Author="Nic Morris" Comment="Created from Flash Butrym ART StrobeFX 1000 IP65 (hopeless documentation.  wholely inadequate for the complexity of the fixture)" Version="25" />
  <History Date="03-04-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="27" />
  <History Date="28-08-24" Author="Nic Morris" Comment="Revised 11 channel mode mapping in line with latest charts in response to manufacturer request." Version="28" />
  <History Date="17-06-26" Author="Nic Morris" Comment="Created from LED LA STRIKE (identical.  charts only.  vague.  majority of function ranges missing.  no pixel layout)" Version="29" />
  <History Date="19-07-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="30" />
  <History Date="20-07-26" Author="Nic Morris" Comment="Corrected 11 channel mode mapping to match charts." Version="31" />
  <Manual Filename="" Summary="" />

    <Attribute ID="Movement" Name="Movement" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="L/R" Display="'L/R %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="121~134" />

  <Control>
    <Attribute ID="All_Pan" Name="All Pan" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="All_Pan_Spin" Name="All Pan Spin" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Normal Speed" Display="'Normal Speed %.f%%',0~100" Dmx="49~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~154" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="152~153" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="151~50" />
    </Attribute>

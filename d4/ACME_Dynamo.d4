<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dynamo" ShortName="Dynamo" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="27-03-16" Author="Kade Behm" Comment="Created" />
  <History Date="28-03-16" Author="Nic Morris" Comment="Increased wheel resolution.  Shortened some gobo function names." />
  <History Date="07-04-16" Author="Nic Morris" Comment="Fixed creation date format" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="17-07-16" Author="Nic Morris" Comment="Added missing Atlabase mode ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="52843c31-1ae1-452a-9c56-3198f99c2916" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Gobo" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="3" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="12~23" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="24~34" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="B/ R/ G" Display="'B/ R/ G'" Dmx="35~46" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="47~58" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="59~69" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="R/ Y/ G/ B" Display="'R/ Y/ G/ B'" Dmx="70~81" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="82~93" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="94~104" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Blue/ Mag" Display="'Blue/ Mag'" Dmx="105~116" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="White" Display="'White'" Dmx="117~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="5" PowerOn="1" Clear="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.1f%%',0.0~100.0" Dmx="132~247" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Scan, 4 DMX" Channels="4">
    <Import PearlRef="AMEDYNS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="60e13f00-73ef-426a-8b99-eacdd7cb8c9e" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Gobo" ChannelOffset="4" Wheel="13" />
    </Include>
  </Mode>
  <Mode Name="Barrel, 4 DMX" Channels="4">
    <Import PearlRef="AMEDYNB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="60e13f00-73ef-426a-8b99-eacdd7cb8c9e" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Gobo" ChannelOffset="4" Wheel="13" VirtualControl="Shutter" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
  <History Date="07-09-14" Author="Nic Morris" Comment="Created" />
  <History Date="23-01-16" Author="Nic Morris" Comment="Created from Prolights ONYX" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d2dff979-2df3-4f12-a3fa-8c74639f276f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Function" Name="P/T Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Strobe" Display="'Strobe'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~15" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="Fixed w/ BO" Display="'Fixed w/ BO'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Colour1Func'&lt;4" />
      <Condition Name="Scroll" ID="3" If="'Colour1Func'==4||'Colour1Func'==5" />
      <Condition Name="Index" ID="4" If="'Colour1Func'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="17~255" Colour="255,255,255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~15" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed w/ BO" Display="'Fixed w/ BO'" Dmx="16~31" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="80~95" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Index" Display="'Index'" Dmx="64~79" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Gobo1Func'&lt;4" />
      <Condition Name="Scroll" ID="3" If="'Gobo1Func'==4||'Gobo1Func'==5" />
      <Condition Name="Index" ID="4" If="'Gobo1Func'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.1f%%',0.0~100.0" Dmx="14~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~4" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Col" Display="'Reset Col'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="7" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="8" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
      <Function ID="10" Name="Reset Shutter" Display="'Reset Shutter'" Dmx="40~47" />
      <Function ID="11" Name="Lamp Off" Display="'Lamp Off'" Dmx="72~79" />
      <Function ID="12" Name="Lamp On" Display="'Lamp On'" Dmx="80~87" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="0~44" Colour="255,255,255" />
      <Function ID="2" Name="Fixed w/ BO" Display="'Fixed w/ BO %.f%%',0~100" Dmx="45~89" Colour="255,255,255" />
      <Function ID="3" Name="Bounce" Display="'Bounce %.1f%%',0.0~100.0" Dmx="90~223" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="239~224" Colour="255,255,255" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="0~35" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed w/ BO" Display="'Fixed w/ BO %.f%%',0~100" Dmx="36~71" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="72~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="239~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

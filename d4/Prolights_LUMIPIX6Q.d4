<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LUMIPIX6Q" ShortName="LUMIPIX6Q" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="11-09-13" Author="Matt Benson" Comment="Created" />
  <History Date="03-01-14" Author="Nic Morris" Comment="Changed dimmer to 8 bit in 8 DMX mode in line with fixture manual." />
  <History Date="03-01-14" Author="Nic Morris" Comment="Added virtual dimmer to cells and attribute links between cells and master." />
  <History Date="03-01-14" Author="Nic Morris" Comment="Standardised shutter function names and reordered.  Increased wheel resolution." />
  <History Date="03-01-14" Author="Nic Morris" Comment="Standardised white attribute wheel allocation.  Renamed cell mode and set to hidden." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID to 4 DMX mode.  Removed classic pearl ref from cell." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Moved auto and auto spd into effect group and wheel slot." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2309a0c3-716b-478f-b924-0a2f2bcb6ff1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="11~30" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="31~50" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="51~70" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="71~90" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="91~110" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="111~130" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="131~150" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="151~170" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="171~190" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="191~210" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="211~230" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="231~250" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
  </Control>

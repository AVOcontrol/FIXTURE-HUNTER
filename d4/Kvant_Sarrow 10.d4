    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="LED" ChannelOffset="1" ModeLink="DS cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="Laser" ChannelOffset="3" ModeLink="DS cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

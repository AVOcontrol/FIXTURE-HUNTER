  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Grouping" Name="Grouping" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Within" Display="'Within %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Between" Display="'Between %.f%%',0~100" Dmx="102~206" />
      <Function ID="3" Name="Even" Display="'Even %.f%%',0~100" Dmx="209~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Fan" Name="Colour Fan" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Range" Name="Colour Range" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Range" Display="'Range %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="2" Name="Full Spectrum" Display="'Full Spectrum'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Colour_Step" Name="Colour Step" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="255~255" />
      <Function ID="2" Name="Smoothing" Display="'Smoothing %.1f%%',0.0~100.0" Dmx="250~0" />
    </Attribute>
    <Attribute ID="Intensity_FX" Name="Intensity FX" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="1~63" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~191" />
      <Function ID="5" Name="Step" Display="'Step %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Intensity_Fan" Name="Intensity Fan" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Look_Select" Name="Look Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Look" Display="'Look %.f',1~31" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

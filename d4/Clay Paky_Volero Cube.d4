    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Static" ID="2" If="'Pattern_Mode'==2" />

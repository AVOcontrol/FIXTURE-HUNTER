      <Function ID="2" Name="Draw" Display="'Draw %.1f%%',0.0~100.0" Dmx="6~127" Intensity="0~0" />
      <Function ID="3" Name="Draw/ Erase" Display="'Draw/ Erase %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">

      <Function ID="3" Name="Move FW" Display="'Move FW %.f%%',100~0" Dmx="191~128" />
      <Function ID="4" Name="Move REV" Display="'Move REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Horiz_Flip" Name="Horiz Flip" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Vert_Flip" Name="Vert Flip" Description="" Group="E">

      <Function ID="2" Name="Dots" Display="'Dots %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Draw" Name="Draw" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~49" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="50~99" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="100~149" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~5" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="11~15" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="16~20" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="21~25" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="26~30" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="31~35" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="36~40" Colour="128,0,255" />
      <Function ID="9" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="41~110" Colour="255,255,255" />
      <Function ID="10" Name="Col Mix" Display="'Col Mix %.f%%',0~100" Dmx="111~180" Colour="255,255,255" />
      <Function ID="11" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="181~250" Colour="255,255,255" />
      <Function ID="12" Name="Auto Static" Display="'Auto Static'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="101~128" />
      <Function ID="3" Name="Move FW" Display="'Move FW %.f%%',100~0" Dmx="191~129" />
      <Function ID="4" Name="Move REV" Display="'Move REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~105" />

      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dots" Name="Dots" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Auto_Zoom" Name="Auto Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~4" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="5~85" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">

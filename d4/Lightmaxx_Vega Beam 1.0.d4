      <Condition Name="Scroll" ID="29,30,31,32" If="'Colour1Func'==3" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~14" WheelPosition="1" Colour="0,0,0" />

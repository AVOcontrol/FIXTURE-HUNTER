<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iW Fixture" ShortName="iW" Company="Color Kinetics">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="10-07-06" Author="Ed" Comment="Created" />
  <History Date="10-07-06" Author="Ed" Comment="Checked" />
  <History Date="23-04-17" Author="Nic Morris" Comment="Revised with reserved attribute ID's.  Added virtual dimmer." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="WarmWhite" Name="Warm" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Warm C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Cool C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="NoFunc" Name="No Func" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="NoFunc" ChannelOffset="3" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
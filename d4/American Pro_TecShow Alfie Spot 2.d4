<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TecShow Alfie Spot 2" ShortName="Alfie Sp 2" Company="American Pro" Version="3">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>ef0b2c91-97d7-4ff1-8d6b-399467c53bfb</Thumbnail>
  <History Date="17-11-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="18-11-20" Author="Nic Morris" Comment="Revised colour and gobo functions in line with latest information." Version="1" />
  <History Date="19-11-20" Author="Nic Morris" Comment="Added gobo swatches.  Added Atlabase ID's." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f235f795-842a-4422-b942-a8a7982d6394" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="64~79" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="80~95" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="96~111" Colour="0,255,255" />
      <Function ID="8" Name="Amber" Display="'Amber'" Dmx="112~127" Colour="255,100,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>16352f15-2dfc-4adb-bb98-e017a9485bf8</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1">
        <Swatch>e42ee4de-626f-4616-98ec-1019e7c037a0</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2">
        <Swatch>f43122b7-7275-4630-8b10-530a21af01b0</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3">
        <Swatch>76117a16-e9c5-471a-960b-684cbf5ab95f</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4">
        <Swatch>0e58233a-8a62-4ad1-8f80-bd25a244285f</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5">
        <Swatch>2825c731-3657-4c9f-ab75-7170693856b9</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6">
        <Swatch>762d31c1-2695-4c52-b23d-7eb7a4597e50</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7">
        <Swatch>53ac087d-784c-4407-9125-29a47f8804ea</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>16352f15-2dfc-4adb-bb98-e017a9485bf8</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="144~159" WheelPosition="1">
        <Swatch>e42ee4de-626f-4616-98ec-1019e7c037a0</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="160~175" WheelPosition="2">
        <Swatch>f43122b7-7275-4630-8b10-530a21af01b0</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="176~191" WheelPosition="3">
        <Swatch>76117a16-e9c5-471a-960b-684cbf5ab95f</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="192~207" WheelPosition="4">
        <Swatch>0e58233a-8a62-4ad1-8f80-bd25a244285f</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="208~223" WheelPosition="5">
        <Swatch>2825c731-3657-4c9f-ab75-7170693856b9</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="224~239" WheelPosition="6">
        <Swatch>762d31c1-2695-4c52-b23d-7eb7a4597e50</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="240~255" WheelPosition="7">
        <Swatch>53ac087d-784c-4407-9125-29a47f8804ea</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="64~127" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~127" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="136~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="32~47" />
      <Function ID="4" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="48~63" />
      <Function ID="5" Name="All in Dark" Display="'All in Dark'" Dmx="64~79" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="80~95" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="96~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="75b588e7-b856-4b19-9566-516028e808e4" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cf96c08d-4817-4224-8a01-02fdad1e811c" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:3:100" />
    </Group>
  </Palettes>

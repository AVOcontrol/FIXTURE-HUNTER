  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ff2983de-6c40-49fe-9c50-00c501d2d634" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 1" Display="'White 1'" Dmx="11~28" Colour="255,255,255" />
      <Function ID="3" Name="White 2" Display="'White 2'" Dmx="29~46" Colour="255,255,255" />
      <Function ID="4" Name="White 3" Display="'White 3'" Dmx="47~64" Colour="255,255,255" />
      <Function ID="5" Name="White 4" Display="'White 4'" Dmx="65~82" Colour="255,255,255" />
      <Function ID="6" Name="White 5" Display="'White 5'" Dmx="83~100" Colour="255,255,255" />
      <Function ID="7" Name="White 6" Display="'White 6'" Dmx="101~118" Colour="255,255,255" />
      <Function ID="8" Name="White 7" Display="'White 7'" Dmx="119~136" Colour="255,255,255" />
      <Function ID="9" Name="White 8" Display="'White 8'" Dmx="137~154" Colour="255,255,255" />
      <Function ID="10" Name="White 9" Display="'White 9'" Dmx="155~172" Colour="255,255,255" />
      <Function ID="11" Name="White 10" Display="'White 10'" Dmx="173~190" Colour="255,255,255" />
      <Function ID="12" Name="White 11" Display="'White 11'" Dmx="191~208" Colour="255,255,255" />
      <Function ID="13" Name="White 12" Display="'White 12'" Dmx="209~226" Colour="255,255,255" />
      <Function ID="14" Name="White 13" Display="'White 13'" Dmx="227~244" Colour="255,255,255" />
      <Function ID="15" Name="White 14" Display="'White 14'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />

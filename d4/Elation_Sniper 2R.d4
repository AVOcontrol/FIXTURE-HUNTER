      <Function ID="27" Name="PcBl/M Pk" Display="'PcBl/M Pk'" Dmx="48~49" WheelPosition="10" Colour="0,255,128" />
      <Function ID="28" Name="M Pk/ Ppl" Display="'M Pk/ Ppl'" Dmx="52~53" WheelPosition="11" Colour="255,150,230" />
      <Function ID="29" Name="Ppl/ P Yell" Display="'Ppl/ P Yell'" Dmx="57~58" WheelPosition="12" Colour="128,0,255" />
      <Function ID="30" Name="P Yell/ C Bl" Display="'P Yell/ C Bl'" Dmx="61~62" WheelPosition="13" Colour="255,255,128" />
      <Function ID="31" Name="Index" Display="'Index %.f%%',0~100" Dmx="68~128" Colour="255,255,255" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="129~190" Colour="0,0,0" />

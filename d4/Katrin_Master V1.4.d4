  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="ViewPoint" Name="ViewPoint Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="2D" Display="'2D'" Dmx="0~127" />
      <Function ID="2" Name="3D" Display="'3D'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="TestMode" Name="Test Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Work" Display="'Work'" Dmx="0~127" />
      <Function ID="2" Name="Test Info" Display="'Test Info'" Dmx="128~143" />
      <Function ID="3" Name="Test Line" Display="'Test Line'" Dmx="144~159" />
      <Function ID="4" Name="Test Wire" Display="'Test Wire'" Dmx="160~175" />
    </Attribute>
    <Attribute ID="MaskType" Name="Mask Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Ellipse" Display="'Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Circle" Display="'Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Rectangle" Display="'Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Square" Display="'Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Vertical" Display="'Vertical'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Horizontal" Display="'Horizontal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Transparent Ellipse" Display="'Transparent Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Transparent Circle" Display="'Transparent Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Transparent Rectangle" Display="'Transparent Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Transparent Square" Display="'Transparent Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Transparent Y" Display="'Transparent Y'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Transparent X" Display="'Transparent X'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mask_Zoom" Name="Mask Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Mask_Focus" Name="Mask Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="ViewPan" Name="Viewpoint Pan" Description="" Group="S" Size="2">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="View_Tilt" Name="Viewpoint Tilt" Description="" Group="S" Size="2">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Generic2" Name="Viewpoint Roll" Description="" Group="S" Size="2">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Roll" Display="'Roll %.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:10" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Keystone_TL_X" Name="Keystone TL X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="TL X" Display="'TL X %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_TL_Y" Name="Keystone TL Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="TL Y" Display="'TL Y %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_TR_X" Name="Keystone TR X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="TR X" Display="'TR X %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_TR_Y" Name="Keystone TR Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="TR Y" Display="'TR Y %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_BR_X" Name="Keystone BR X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="BR X" Display="'BR X %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_BR_Y" Name="Keystone BR Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="BR Y" Display="'BR Y %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_BL_X" Name="Keystone BL X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="BL X" Display="'BL X %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_BL_Y" Name="Keystone BL Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="BL Y" Display="'BL Y %.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Effect1, Effect2, Effect3" />
      <Function ID="2" Name="Gamma" Display="'Gamma'" Dmx="1~1" Update="Effect1, Effect2, Effect3" />
      <Function ID="3" Name="Hue" Display="'Hue'" Dmx="2~2" Update="Effect1, Effect2, Effect3" />
      <Function ID="4" Name="Brightness" Display="'Brightness'" Dmx="3~3" Update="Effect1, Effect2, Effect3" />
      <Function ID="5" Name="RGB" Display="'RGB'" Dmx="4~4" Update="Effect1, Effect2, Effect3" />
      <Function ID="6" Name="Gamma RGB" Display="'Gamma RGB'" Dmx="5~5" Update="Effect1, Effect2, Effect3" />
      <Function ID="7" Name="Grayscale" Display="'Grayscale'" Dmx="6~6" Update="Effect1, Effect2, Effect3" />
      <Function ID="8" Name="Sepia" Display="'Sepia'" Dmx="7~7" Update="Effect1, Effect2, Effect3" />
      <Function ID="9" Name="Detect Edges" Display="'Detect Edges'" Dmx="8~8" Update="Effect1, Effect2, Effect3" />
      <Function ID="10" Name="Reserved" Display="'Reserved %.f',9~255" Dmx="9~255" Update="Effect1, Effect2, Effect3" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect Par 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Condition Name="Detect Edges" ID="4" If="'Effect'==9" />
      <Else ID="5" />
      <Function ID="1" Name="Black" Display="'Black %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Brightness" Display="'Brightness %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Amount X" Display="'Amount X %.f%%',0~100" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect2" Name="Effect Par 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Condition Name="Detect Edges" ID="4" If="'Effect'==9" />
      <Else ID="5" />
      <Function ID="1" Name="White" Display="'White %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Contrast" Display="'Contrast %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Amount Y" Display="'Amount Y %.f%%',0~100" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect3" Name="Effect Par 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Else ID="4" />
      <Function ID="1" Name="Gamma" Display="'Gamma %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Saturation" Display="'Saturation %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom1" Name="Lens Throw" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0.7:1" Display="'0.7:1'" Dmx="18~18" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="0.8:1" Display="'0.8:1'" Dmx="20~20" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="1.0:1" Display="'1.0:1'" Dmx="25~25" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="1.2:1" Display="'1.2:1'" Dmx="31~31" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="1.4:1" Display="'1.4:1'" Dmx="36~36" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="1.8:1" Display="'1.8:1'" Dmx="46~46" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="2.5:1" Display="'2.5:1'" Dmx="64~64" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="4.5:1" Display="'4.5:1'" Dmx="115~115" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="7.3:1" Display="'7.3:1'" Dmx="186~186" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Generic" Name="Blending" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Test" Display="'Test'" Dmx="0~0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Master, 30 DMX" Channels="30">

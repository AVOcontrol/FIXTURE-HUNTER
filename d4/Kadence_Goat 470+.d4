      <Function ID="9" Name="Lav/ 3200K" Display="'Lav/ 3200K'" Dmx="116~139" WheelPosition="2" Colour="255,128,255" />
      <Function ID="10" Name="3200/ 2500K" Display="'3200/ 2500K'" Dmx="163~185" WheelPosition="3" Colour="255,240,200" />
      <Function ID="11" Name="2500/ B Wood" Display="'2500/ B Wood'" Dmx="209~231" WheelPosition="4" Colour="255,240,200" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">

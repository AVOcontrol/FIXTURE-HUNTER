      <Function ID="2" Name="UV Filter" Display="'UV Filter'" Dmx="47~69" WheelPosition="1" Colour="180,0,255" />
      <Function ID="3" Name="Lavender" Display="'Lavender'" Dmx="93~115" WheelPosition="2" Colour="255,128,255" />
      <Function ID="4" Name="CTO 3200K" Display="'CTO 3200K'" Dmx="140~162" WheelPosition="3" Colour="255,240,200" />
      <Function ID="5" Name="CTO 2500K" Display="'CTO 2500K'" Dmx="186~208" WheelPosition="4" Colour="255,240,200" />

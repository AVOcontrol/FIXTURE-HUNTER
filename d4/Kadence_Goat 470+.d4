<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Goat 470+" ShortName="Goat 470+" Company="Kadence" Version="6">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="21-11-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added RDM ID's (note no personality ID's but should be ok as only one mode)" Version="2" />
  <History Date="21-07-19" Author="Nic Morris" Comment="Updated in line with 05/2019 charts in response to customer bug report (revises shutter, anim rot, gobo scroll and function ranges/macros/palettes, inverts zoom, adds fixed colour names/swatches)" Version="3" />
  <History Date="21-07-19" Author="Nic Morris" Comment="Added physical pan/tilt ranges.  Added gobo swatches." Version="4" />
  <History Date="31-07-19" Author="Nic Morris" Comment="Corrected shutter pulse DMX end value." Version="5" />
  <History Date="31-03-26" Author="Nic Morris" Comment="Created from Clay Paky Sharpy Plus (identical.  documentation is a blatent copy)" Version="6" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bad06a80-f9e4-4df8-8275-e9be05ad1bad" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~249" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Curve Linear" Display="'Dim Curve Linear'" Dmx="8~15" />
      <Function ID="3" Name="Dim Curve Gamma 2.0" Display="'Dim Curve Gamma 2.0'" Dmx="16~23" />
      <Function ID="4" Name="Dim Curve Gamma 2.2" Display="'Dim Curve Gamma 2.2'" Dmx="24~31" />
      <Function ID="5" Name="Dim Curve S-Curve" Display="'Dim Curve S-Curve'" Dmx="32~39" />
      <Function ID="6" Name="Dim Speed Auto" Display="'Dim Speed Auto'" Dmx="40~47" />
      <Function ID="7" Name="Dim Speed Slow" Display="'Dim Speed Slow'" Dmx="48~55" />
      <Function ID="8" Name="Dim Speed Medium" Display="'Dim Speed Medium'" Dmx="56~63" />
      <Function ID="9" Name="Dim Speed Fast" Display="'Dim Speed Fast'" Dmx="64~71" />
      <Function ID="10" Name="PWM 1.1KHz" Display="'PWM 1.1KHz'" Dmx="104~111" />
      <Function ID="11" Name="PWM 1.2KHz" Display="'PWM 1.2KHz'" Dmx="112~119" />
      <Function ID="12" Name="PWM 1.3KHz" Display="'PWM 1.3KHz'" Dmx="120~127" />
      <Function ID="13" Name="PWM 1.4KHz" Display="'PWM 1.4KHz'" Dmx="128~135" />
      <Function ID="14" Name="PWM 1.5KHz" Display="'PWM 1.5KHz'" Dmx="136~143" />
      <Function ID="15" Name="PWM 1.6KHz" Display="'PWM 1.6KHz'" Dmx="144~151" />
      <Function ID="16" Name="Calibration Disabled" Display="'Calibration Disabled'" Dmx="152~159" />
      <Function ID="17" Name="Calibration Enabled" Display="'Calibration Enabled'" Dmx="160~167" />
      <Function ID="18" Name="Fan Silent" Display="'Fan Silent'" Dmx="168~175" />
      <Function ID="19" Name="Fan Auto" Display="'Fan Auto'" Dmx="176~183" />
      <Function ID="20" Name="Fan Full" Display="'Fan Full'" Dmx="184~191" />
      <Function ID="21" Name="Display Auto Off" Display="'Display Auto Off'" Dmx="192~199" />
      <Function ID="22" Name="Display On" Display="'Display On'" Dmx="200~207" />
      <Function ID="23" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="224~231" />
      <Function ID="24" Name="Reset All" Display="'Reset All'" Dmx="250~250" />
    </Attribute>
  </Control>
  <Mode Name="Dimmer, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="408be935-39a5-4808-b102-38bfd31bf1f9" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Basic, 3 DMX" Channels="3">

  <Thumbnail>91c36b8c-fbe7-47fa-a656-851a8105c9a5</Thumbnail>
  <History Date="08-12-16" Author="Nic Morris" Comment="Created" />
  <History Date="15-11-19" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request." />
  <History Date="15-11-19" Author="Nic Morris" Comment="Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f Hz',1.0~25.0" Dmx="101~180" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.1f Hz',1.0~25.0" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Cyclone_Rot" Name="Cyclone Rot" Description="" Group="B">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f RPM',100.0~0.0" Dmx="255~128" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f RPM',0.0~100.0" Dmx="127~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Beam (No Smoothing)" Display="'Beam (No Smoothing)'" Dmx="0~0" />
      <Function ID="2" Name="Beam (Smoothing)" Display="'Beam (Smoothing)'" Dmx="6~10" />
      <Function ID="3" Name="Test Pattern" Display="'Test Pattern'" Dmx="11~20" />
      <Function ID="4" Name="2 Beams" Display="'2 Beams'" Dmx="21~30" />
      <Function ID="5" Name="4 Beams" Display="'4 Beams'" Dmx="31~40" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="41~50" />
      <Function ID="7" Name="Cone" Display="'Cone'" Dmx="51~60" />
      <Function ID="8" Name="Square" Display="'Square'" Dmx="61~70" />
      <Function ID="9" Name="Triangle" Display="'Triangle'" Dmx="71~80" />
      <Function ID="10" Name="Flat Scan Horiz" Display="'Flat Scan Horiz'" Dmx="81~90" />
      <Function ID="11" Name="Flat Scan Vert" Display="'Flat Scan Vert'" Dmx="91~100" />
      <Function ID="12" Name="2-Side Triangle" Display="'2-Side Triangle'" Dmx="101~110" />
      <Function ID="13" Name="3-Side Spiral" Display="'3-Side Spiral'" Dmx="111~120" />
      <Function ID="14" Name="4-Side Spiral" Display="'4-Side Spiral'" Dmx="121~130" />
      <Function ID="15" Name="5-Side Spiral" Display="'5-Side Spiral'" Dmx="131~140" />
      <Function ID="16" Name="Snail Shell" Display="'Snail Shell'" Dmx="141~150" />
      <Function ID="17" Name="2 Vert Flat Scan" Display="'2 Vert Flat Scan'" Dmx="151~160" />
      <Function ID="18" Name="3 Vert Flat Scan" Display="'3 Vert Flat Scan'" Dmx="161~170" />
      <Function ID="19" Name="4 Vert Flat Scan" Display="'4 Vert Flat Scan'" Dmx="171~180" />
      <Function ID="20" Name="Hot Beam Cone" Display="'Hot Beam Cone'" Dmx="181~190" />
      <Function ID="21" Name="Hot Beam Square" Display="'Hot Beam Square'" Dmx="191~200" />
      <Function ID="22" Name="Hot Beam Triangle" Display="'Hot Beam Triangle'" Dmx="201~210" />
      <Function ID="23" Name="Hot Beam 2 Side Triangle" Display="'Hot Beam 2 Side Triangle'" Dmx="211~220" />
      <Function ID="24" Name="Hot Beam Flat Scan" Display="'Hot Beam Flat Scan'" Dmx="221~230" />
      <Function ID="25" Name="3 Flat + Hot Beam" Display="'3 Flat + Hot Beam'" Dmx="231~240" />
      <Function ID="26" Name="Moving Hot Beam Flat Scan" Display="'Moving Hot Beam Flat Scan'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Zoom Up" Display="'Zoom Up %.f%%',0~100" Dmx="101~140" />
      <Function ID="3" Name="Zoom Dn" Display="'Zoom Dn %.f%%',0~100" Dmx="141~180" />
      <Function ID="4" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="181~220" />
      <Function ID="5" Name="Random" Display="'Random %.f%%',0~100" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f RPM',100.0~0.0" Dmx="255~128" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f RPM',0.0~100.0" Dmx="127~0" />
    </Attribute>
    <Attribute ID="Scan_Rate" Name="Scan Rate" Description="" Group="S">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Rate" Display="'%.2fkpps',0.00~20.00" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Safety" Name="Safety" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable" Display="'Disable'" Dmx="0~0" />
      <Function ID="2" Name="Enable" Display="'Enable'" Dmx="123~123" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="Module, 8 DMX" Channels="8">
    <Import PearlRef="UKERCYC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Master, 6 DMX" Channels="6">
    <Import PearlRef="UKERCYC2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Cyclone_Rot" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Macro" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Rotation" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Scan_Rate" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Safety" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Safety:3" Delay="6000" />
      <Set Channel="Safety:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

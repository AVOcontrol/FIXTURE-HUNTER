  <History Date="23-07-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="25-07-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="27-01-25" Author="Nic Morris" Comment="Update in line with latest charts (adds 8 channel mode with 16bit dimmer)" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e459abbb-17bb-4ccf-8000-a484522cbbd0" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Response" Name="Dim Response" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="LED" Display="'LED'" Dmx="6~127" />
      <Function ID="3" Name="Halogen" Display="'Halogen'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="ee295829-2235-4d58-8db1-4f588c41fa15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

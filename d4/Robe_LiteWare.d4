  <AtlaBase TypeID="e9fb7a8f-c049-45a6-aea3-ecb93dfb8059" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RGBW mode" Display="'RGBW mode'" Dmx="30~39" />
      <Function ID="3" Name="CMY mode" Display="'CMY mode'" Dmx="40~49" />
      <Function ID="4" Name="Col Cal ON" Display="'Col Cal ON'" Dmx="110~114" />
      <Function ID="5" Name="Col Cal OFF" Display="'Col Cal OFF'" Dmx="115~119" />
      <Function ID="6" Name="Effect FW" Display="'Effect FW %.f%%',0~100" Dmx="130~145" />
      <Function ID="7" Name="Effect REV" Display="'Effect REV %.f%%',100~0" Dmx="146~161" />
      <Function ID="8" Name="Alarm ON" Display="'Alarm ON'" Dmx="50~59" />
      <Function ID="9" Name="Alarm OFF" Display="'Alarm OFF'" Dmx="60~69" />
      <Function ID="10" Name="Display ON" Display="'Display ON'" Dmx="70~79" />
      <Function ID="11" Name="Display OFF" Display="'Display OFF'" Dmx="80~89" />
      <Function ID="12" Name="Dim Linear" Display="'Dim Linear'" Dmx="90~99" />
      <Function ID="13" Name="Dim Square" Display="'Dim Square'" Dmx="100~109" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Tungsten" Display="'2700K Tungsten'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Tungsten" Display="'3200K Tungsten'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
      <Function ID="10" Name="Rainbow w/fade" Display="'Rainbow w/fade'" Dmx="248~248" Colour="255,255,255" />
      <Function ID="11" Name="Rainbow w/o fade" Display="'Rainbow w/o fade'" Dmx="249~249" Colour="255,255,255" />
      <Function ID="12" Name="Effect 1" Display="'Effect 1'" Dmx="250~250" Colour="255,255,255" />
      <Function ID="13" Name="Effect 2" Display="'Effect 2'" Dmx="251~251" Colour="255,255,255" />
      <Function ID="14" Name="Effect 3" Display="'Effect 3'" Dmx="252~252" Colour="255,255,255" />
      <Function ID="15" Name="Effect 4" Display="'Effect 4'" Dmx="253~253" Colour="255,255,255" />
      <Function ID="16" Name="Effect 5" Display="'Effect 5'" Dmx="254~254" Colour="255,255,255" />
      <Function ID="17" Name="Random" Display="'Random'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (RGB)" Channels="9" Id="5c3855df-b7ce-4764-9762-8ca308a42126">

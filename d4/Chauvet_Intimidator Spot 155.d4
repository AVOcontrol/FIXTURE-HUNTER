      <Function ID="13" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="76~81" WheelPosition="2" Colour="255,0,255" />
      <Function ID="14" Name="Grn/ Rd" Display="'Grn/ Rd'" Dmx="82~87" WheelPosition="3" Colour="0,255,0" />
      <Function ID="15" Name="Rd/ Cy" Display="'Rd/ Cy'" Dmx="88~93" WheelPosition="4" Colour="255,0,0" />
      <Function ID="16" Name="Cy/ Org" Display="'Cy/ Org'" Dmx="94~99" WheelPosition="5" Colour="0,255,255" />
      <Function ID="17" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="100~105" WheelPosition="6" Colour="255,128,0" />

      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="30~35" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="36~41" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="42~47" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Light Green" Display="'Light Green'" Dmx="48~53" WheelPosition="8" Colour="128,255,0" />

      <Function ID="12" Name="Rd - Aq" Display="'Rd - Aq %.f%%',0~100" Dmx="72~79" WheelPosition="1" Colour="255,0,0" />
      <Function ID="13" Name="Aq- Grn" Display="'Aq- Grn %.f%%',0~100" Dmx="79~86" WheelPosition="2" Colour="0,255,200" />

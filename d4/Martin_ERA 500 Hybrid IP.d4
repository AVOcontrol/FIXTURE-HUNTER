      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==3" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~12" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Aquamarine" Display="'Aquamarine'" Dmx="13~18" WheelPosition="2" Colour="0,255,200" />

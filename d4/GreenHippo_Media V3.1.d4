    <Attribute ID="Effect1Level" Name="Effect 1 Level" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Open" ID="2" If="'Effect1'==1||'Effect1'==14||'Effect1'==63||'Effect1'==38||'Effect1'==83" />
      <Else ID="1" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" />
    </Attribute>

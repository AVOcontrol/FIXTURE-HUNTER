    <Attribute ID="Effect2Level" Name="Effect 2 Level" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Open" ID="2" If="'Effect2'==1||'Effect2'==14||'Effect2'==63||'Effect2'==38||'Effect2'==83" />
      <Else ID="1" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Eff2Param1" Name="Eff 2 Param 1" Description="" Group="E">
      <Locate Locate="3" PowerOn="3" />
      <Condition Name="Radial Blur" ID="2" If="'Effect2'==3" />

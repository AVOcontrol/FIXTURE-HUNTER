<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Spider Mobile DMX" ShortName="Spider" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="30-10-16" Author="Nic Morris" Comment="Created (two tilts but only one tilt LSB)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Fine" Name="Tilt Fine" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~30" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~50" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="51~70" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="71~90" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="91~110" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="111~130" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="131~150" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="151~170" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="171~190" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="191~210" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="211~230" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1,4" Wheel="2" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Tilt_Fine" ChannelOffset="5" Wheel="28" />
        <Attribute ID="PT_Speed" ChannelOffset="6" Wheel="25" />
        <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
        <Attribute ID="Auto" ChannelOffset="9" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="23" />
        <Attribute ID="Red" ChannelOffset="11" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="12" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="13" Wheel="12" />
        <Attribute ID="White" ChannelOffset="14" Wheel="7" />
      </Master>
      <Cell ID="Cell1" Name="Tilt 1" ChannelOffset="2" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="3" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>

      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="3" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell3" Name="LED 1" ChannelOffset="11" ModeLink="Col cell" X="0" Y="2">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell4" Name="LED 2" ChannelOffset="12" ModeLink="Col cell" X="0" Y="3">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell5" Name="LED 3" ChannelOffset="13" ModeLink="Col cell" X="0" Y="4">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell6" Name="LED 4" ChannelOffset="14" ModeLink="Col cell" X="0" Y="5">

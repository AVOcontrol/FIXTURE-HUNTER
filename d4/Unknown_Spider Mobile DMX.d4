      <Cell ID="Cell7" Name="LED 5" ChannelOffset="15" ModeLink="Col cell" X="0" Y="6">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell8" Name="LED 6" ChannelOffset="16" ModeLink="Col cell" X="0" Y="7">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell9" Name="LED 7" ChannelOffset="17" ModeLink="Col cell" X="0" Y="8">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
      <Cell ID="Cell10" Name="LED 8" ChannelOffset="18" ModeLink="Col cell" X="0" Y="9">
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
      </Cell>
    </Cells>
  </Mode>

    <Attribute ID="Effect_1_Adjust" Name="Effect 1 Adjust" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Trigger Delay" ID="2" If="'Effect1'==8" />
      <Condition Name="Speed" ID="3" If="'Effect1'==9||'Effect1'==10||'Effect1'==11||'Effect1'==12||'Effect1'==14||'Effect1'==15||'Effect1'==16||'Effect1'==17||'Effect1'==18||'Effect1'==31||'Effect1'==32||'Effect1'==33||'Effect1'==34||'Effect1'==36||'Effect1'==37" />
      <Condition Name="Colour Offset" ID="4" If="'Effect1'==20||'Effect1'==26||'Effect1'==28" />
      <Condition Name="Amount" ID="5" If="'Effect1'==22||'Effect1'==23" />
      <Condition Name="Strength" ID="6" If="'Effect1'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Delay" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

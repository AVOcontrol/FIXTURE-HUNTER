      <Function ID="39" Name="Reserved" Display="'Reserved %.f',220~255" Dmx="220~255" Update="Effect_2_Adjust" />
    </Attribute>
    <Attribute ID="Effect_2_Adjust" Name="Effect 2 Adjust" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Trigger Delay" ID="2" If="'Effect2'==8" />
      <Condition Name="Speed" ID="3" If="'Effect2'==9||'Effect2'==10||'Effect2'==11||'Effect2'==12||'Effect2'==14||'Effect2'==15||'Effect2'==16||'Effect2'==17||'Effect2'==18||'Effect2'==31||'Effect2'==32||'Effect2'==33||'Effect2'==34||'Effect2'==36||'Effect2'==37" />
      <Condition Name="Colour Offset" ID="4" If="'Effect2'==20||'Effect2'==26||'Effect2'==28" />
      <Condition Name="Amount" ID="5" If="'Effect2'==22||'Effect2'==23" />
      <Condition Name="Strength" ID="6" If="'Effect2'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Delay" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Amount" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Strength" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Sync" Name="Effect Sync" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sync" Display="'No Sync'" Dmx="0~0" />
      <Function ID="2" Name="Sync" Display="'Sync'" Dmx="50~50" />
      <Function ID="3" Name="Sync Shift" Display="'Sync Shift'" Dmx="51~169" />
      <Function ID="4" Name="Sync Random" Display="'Sync Random'" Dmx="170~209" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="210~255" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SUNRISE4" ShortName="SUNRISE4" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="06-09-14" Author="Nic Morris" Comment="Created" />
  <History Date="22-10-14" Author="Nic Morris" Comment="Fixed wheel mapping." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="17-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="17-08-16" Author="Nic Morris" Comment="Moved auto and auto speed into effect group and wheel slot." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="20b5a548-0b8c-411b-98b1-e9fa8acbc32e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="11~40" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="41~80" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="81~120" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="121~170" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="171~220" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Speed Off" Display="'Speed Off'" Dmx="52~101" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="102~150" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="151~203" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">

    <Attribute ID="Effect_1_Mod_1" Name="Effect 1 Mod 1" Description="" Group="E">
      <Locate Locate="75:0" PowerOn="75:0" />
      <Condition Name="CMY" ID="1" If="'Effect1'==2||'Effect1'==3||'Effect1'==4" />
      <Condition Name="RGB" ID="2" If="'Effect1'==5||'Effect1'==6||'Effect1'==7||'Effect1'==8||'Effect1'==9||'Effect1'==10||'Effect1'==11||'Effect1'==12||'Effect1'==13||'Effect1'==15||'Effect1'==16||'Effect1'==17||'Effect1'==27||'Effect1'==28||'Effect1'==29||'Effect1'==30||'Effect1'==31||'Effect1'==32||'Effect1'==40||'Effect1'==48||'Effect1'==102||'Effect1'==103||'Effect1'==104||'Effect1'==105" />
      <Condition Name="RGB Swap CMY" ID="3" If="'Effect1'==18" />
      <Condition Name="RGB Swap MYC" ID="4" If="'Effect1'==19" />
      <Condition Name="RGB Swap YCM" ID="5" If="'Effect1'==20" />
      <Condition Name="Edge Detect" ID="6" If="'Effect1'==21||'Effect1'==22" />
      <Condition Name="Texture" ID="7" If="'Effect1'==23||'Effect1'==24||'Effect1'==25" />
      <Condition Name="Texture Asy" ID="8" If="'Effect1'==26" />
      <Condition Name="Scan Line" ID="9" If="'Effect1'==33" />
      <Condition Name="Transparent Wipes" ID="10" If="'Effect1'==34" />
      <Condition Name="Pixel Twist" ID="11" If="'Effect1'==35||'Effect1'==36" />
      <Condition Name="Magnify" ID="12" If="'Effect1'==37||'Effect1'==38" />
      <Condition Name="Cartoon" ID="13" If="'Effect1'==39" />
      <Condition Name="Mirror" ID="14" If="'Effect1'==41" />
      <Condition Name="RGB Swap BGR" ID="15" If="'Effect1'==42" />
      <Condition Name="RGB Swap RBG" ID="16" If="'Effect1'==43" />
      <Condition Name="RGB Swap GRB" ID="17" If="'Effect1'==44" />

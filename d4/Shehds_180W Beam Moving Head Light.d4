      <Attribute ID="Macro" ChannelOffset="13" Wheel="53" />
      <Attribute ID="Macro_Spd" ChannelOffset="14" Wheel="54" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ACTOR 3.18" ShortName="ACTOR 3.18" Company="zactrack" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="08-07-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="09-07-25" Author="Nic Morris" Comment="Changed height display from m (2dp)  to mm (0dp) in response to customer feedback." Version="1" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Height" Name="Height" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable Height Offset" Display="'Disable Height Offset'" Dmx="0~0" />
      <Function ID="2" Name="Target Height" Display="'%.fmm',-2000~2000" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Speed_Preset" Name="Speed Preset" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Slow" Display="'Slow'" Dmx="0~0" />
      <Function ID="2" Name="Medium" Display="'Medium'" Dmx="86~170" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Smart_Beam" Name="Smart Beam" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable Smart Beam" Display="'Disable Smart Beam'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Smart Beam Diameter" Display="'Smart Beam Diameter %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Freeze_Filter" Name="Freeze Filter" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Freeze Intensity" Display="'Freeze Intensity %.1f%%',0.0~100.0" Dmx="0~254" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Freeze Position" Display="'Freeze Position'" Dmx="255~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Actor_Mode" Name="Actor Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Active 3D" Display="'Active 3D'" Dmx="0~0" />
      <Function ID="2" Name="Force 2D (Active 2D)" Display="'Force 2D (Active 2D)'" Dmx="20~20" />
      <Function ID="3" Name="Dimmer 0%" Display="'Dimmer 0%'" Dmx="175~175" />
      <Function ID="4" Name="Inactive" Display="'Inactive'" Dmx="254~254" />
    </Attribute>
    <Attribute ID="Actor_Fallback" Name="Actor Fallback" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Inactive" Display="'Inactive'" Dmx="41~81" />
      <Function ID="3" Name="Force Active (Auto Source)" Display="'Force Active (Auto Source)'" Dmx="82~122" />
      <Function ID="4" Name="Force Active 1" Display="'Force Active 1'" Dmx="123~123" />
      <Function ID="5" Name="Force Active 2" Display="'Force Active 2'" Dmx="124~124" />
      <Function ID="6" Name="Force Active 3" Display="'Force Active 3'" Dmx="125~125" />
      <Function ID="7" Name="Force Active 4" Display="'Force Active 4'" Dmx="126~126" />
      <Function ID="8" Name="Force Active 5" Display="'Force Active 5'" Dmx="127~127" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 3 DMX" Channels="3" Id="1ed5fe5f-f291-4b0a-9547-13b848482e41">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Height" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Speed_Preset" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Smart_Beam" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="Standard, 5 DMX" Channels="5" Id="6ea008a4-e8f1-4929-b463-eae518efe9e9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Height" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Speed_Preset" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Smart_Beam" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Freeze_Filter" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Actor_Mode" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Extended, 10 DMX" Channels="10" Id="9bba948e-e099-4082-bab2-619a41bdac20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Height" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Speed_Preset" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Smart_Beam" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Freeze_Filter" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Actor_Mode" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Actor_Fallback" ChannelOffset="6" Wheel="26" />
      <Attribute ID="Reserved" ChannelOffset="7" Wheel="28" />
      <Attribute ID="Reserved1" ChannelOffset="8" Wheel="29" />
      <Attribute ID="Reserved2" ChannelOffset="9" Wheel="30" />
      <Attribute ID="Reserved3" ChannelOffset="10" Wheel="58" />
    </Include>
  </Mode>
</Fixture>
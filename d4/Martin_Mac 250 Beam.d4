  <AtlaBase TypeID="72c6de5f-a4df-4e2b-a211-945f676a888d" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="72~50" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="99~80" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="119~100" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="187~128" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls Slow" Display="'Rnd Op Pls Slow'" Dmx="194~196" Intensity="0~0" />
      <Function ID="8" Name="Rnd Op Pls Fast" Display="'Rnd Op Pls Fast'" Dmx="191~193" Intensity="0~0" />
      <Function ID="9" Name="Rnd Cl Pls Slow" Display="'Rnd Cl Pls Slow'" Dmx="200~202" Intensity="0~0" />
      <Function ID="10" Name="Rnd Cl Pls Fast" Display="'Rnd Cl Pls Fast'" Dmx="197~199" Intensity="0~0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="203~207" Intensity="0~0" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
      <Function ID="13" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" Intensity="0~0" />
      <Function ID="14" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Gobo1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Gobo1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Gobo1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="245~3" />
      <Function ID="3" Name="Tracking PTSP NORM" Display="'Tracking PTSP NORM'" Dmx="246~248" />
      <Function ID="4" Name="Tracking PTSP FAST" Display="'Tracking PTSP FAST'" Dmx="249~251" />
      <Function ID="5" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Effects_Spd" Name="Effects Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1, Cyan, Magenta, Yellow" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1, Cyan, Magenta, Yellow" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1, Cyan, Magenta, Yellow" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Gobo1, Cyan, Magenta, Yellow" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Cyan, Magenta, Yellow" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==3" />
      <Condition Name="Random" ID="19,20" If="'Gobo1Func'==4" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="1 (Aperture 15)" Display="'1 (Aperture 15)'" Dmx="51400~52171" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="2 (Aperture 10)" Display="'2 (Aperture 10)'" Dmx="50372~51143" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="3 (2 Dots)" Display="'3 (2 Dots)'" Dmx="49344~50115" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="4 (3 Dots)" Display="'4 (3 Dots)'" Dmx="48316~49087" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="5 (2 Bars)" Display="'5 (2 Bars)'" Dmx="47288~48059" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="6 (Cone)" Display="'6 (Cone)'" Dmx="46260~47031" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Open-Ap 15" Display="'Open-Ap 15 %.2f%%',0.00~100.00" Dmx="0~6939" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Ap 15-Ap 10" Display="'Ap 15-Ap 10 %.2f%%',0.00~100.00" Dmx="6939~13364" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Ap10-2 Dots" Display="'Ap10-2 Dots %.2f%%',0.00~100.00" Dmx="13364~20046" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="2 Dots-3 Dots" Display="'2 Dots-3 Dots %.2f%%',0.00~100.00" Dmx="20046~26471" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="3-Dots-2 Bars" Display="'3-Dots-2 Bars %.2f%%',0.00~100.00" Dmx="26471~33153" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="2-Bars-Cone" Display="'2-Bars-Cone %.2f%%',0.00~100.00" Dmx="33153~39321" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Cone-Open" Display="'Cone-Open %.2f%%',0.00~100.00" Dmx="39321~46003" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="53456~58082" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.2f%%',0.00~100.00" Dmx="58339~62965" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="20" Name="Random" Display="'Random %.1f%%',0.0~100.0" Dmx="65535~63222" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX, 8bit" Channels="13">

  <Mode Name="19 DMX, 16bit" Channels="19">
    <Import PearlRef="MT_Mac250B2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~5" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="6" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="7" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Response LED" Display="'Dim Response LED'" Dmx="6~18" />
      <Function ID="3" Name="Dim Response Halogen" Display="'Dim Response Halogen'" Dmx="19~31" />
      <Function ID="4" Name="DTW (Redshift) On" Display="'DTW (Redshift) On'" Dmx="32~44" />
      <Function ID="5" Name="DTW (Redshift) Off" Display="'DTW (Redshift) Off'" Dmx="45~57" />
      <Function ID="6" Name="Display On" Display="'Display On'" Dmx="58~70" />
      <Function ID="7" Name="Display Off" Display="'Display Off'" Dmx="71~83" />
      <Function ID="8" Name="Dim Curve Linear" Display="'Dim Curve Linear'" Dmx="84~96" />
      <Function ID="9" Name="Dim Curve Exp" Display="'Dim Curve Exp'" Dmx="97~109" />
      <Function ID="10" Name="Dim Curve Log" Display="'Dim Curve Log'" Dmx="110~122" />
      <Function ID="11" Name="Dim Curve S-Curve" Display="'Dim Curve S-Curve'" Dmx="123~135" />
      <Function ID="12" Name="PWM 800Hz" Display="'PWM 800Hz'" Dmx="136~148" />
      <Function ID="13" Name="PWM 1200Hz" Display="'PWM 1200Hz'" Dmx="149~161" />
      <Function ID="14" Name="PWM 2000Hz" Display="'PWM 2000Hz'" Dmx="162~174" />
      <Function ID="15" Name="PWM 3600Hz" Display="'PWM 3600Hz'" Dmx="175~187" />
      <Function ID="16" Name="PWM 12kHz" Display="'PWM 12kHz'" Dmx="188~200" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ilumo Zoom LED Spot" ShortName="Zm LED Spt" Company="Lumonic">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="06-11-12" Author="Peter Budd" Comment="Created" />
  <History Date="10-07-13" Author="Peter Budd" Comment="Updated to firmware version 3.6." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="23-10-17" Author="Nic Morris" Comment="Changed name from Zoom LED Spot to Ilumo Zoom LED Spot" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Added Atlabase ID's to modes 1-4 and 9-13.  Increased wheel resolution." />
  <History Date="23-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." />
  <History Date="31-10-17" Author="Nic Morris" Comment="Added remaining Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="43deaf43-2301-41ae-9d8e-5f1833b6cb0b" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="HSIC" ID="2" If="'Control'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="HSIC" ID="2" If="'Control'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Raw RGB" Display="'Raw RGB'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Calibrate RGB" Display="'Calibrate RGB'" Dmx="41~80" Update="Red, Green" />
      <Function ID="3" Name="CIE" Display="'CIE'" Dmx="81~120" Update="Red, Green" />
      <Function ID="4" Name="White Col" Display="'White Col'" Dmx="121~160" Update="Red, Green" />
      <Function ID="5" Name="Palette" Display="'Palette'" Dmx="161~200" Update="Red, Green" />
      <Function ID="6" Name="HSIC" Display="'HSIC'" Dmx="201~255" Update="Red, Green" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CIE_X" Name="CIE X" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CIE_Y" Name="CIE Y" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CrossFade" Name="Cross Fade" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cross Fade" Display="'Cross Fade %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Red_Adj" Name="Red Adj" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Colour="255,255,255" />
      <Function ID="2" Name="- Red" Display="'- Red %.1f%%',0.0~100.0" Dmx="2~127" Colour="255,0,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Red" Display="'+ Red %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Adj" Name="Green Adj" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Colour="255,255,255" />
      <Function ID="2" Name="- Green" Display="'- Green %.1f%%',0.0~100.0" Dmx="2~127" Colour="0,255,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Adj" Name="Blue Adj" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Colour="255,255,255" />
      <Function ID="2" Name="- Blue" Display="'- Blue %.1f%%',0.0~100.0" Dmx="2~127" Colour="0,0,255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Blue" Display="'+ Blue %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Adj" Name="White Adj" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Colour="255,255,255" />
      <Function ID="2" Name="- White" Display="'- White %.1f%%',0.0~100.0" Dmx="2~127" Colour="255,255,255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ White" Display="'+ White %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

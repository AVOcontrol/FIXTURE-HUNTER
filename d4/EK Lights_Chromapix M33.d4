<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Chromapix M33" ShortName="Chroma M33" Company="EK Lights">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="02-04-19" Author="Nic Morris" Comment="Created (guessed pixel layout)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" Update="Chase_Spd" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="11~34" Update="Chase_Spd" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="35~58" Update="Chase_Spd" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="59~82" Update="Chase_Spd" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="83~106" Update="Chase_Spd" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="107~130" Update="Chase_Spd" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="131~154" Update="Chase_Spd" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="155~178" Update="Chase_Spd" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="179~202" Update="Chase_Spd" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="203~226" Update="Chase_Spd" />
      <Function ID="11" Name="Chase 10 (1-9)" Display="'Chase 10 (1-9)'" Dmx="227~250" Update="Chase_Spd" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Chase_Spd" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2,3" If="'Chase'==12" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~58" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="59~106" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="107~154" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="155~202" />
      <Function ID="6" Name="Macro 5 (1-4)" Display="'Macro 5 (1-4)'" Dmx="203~250" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Colour 1" Display="'Colour 1'" Dmx="201~205" WheelPosition="1" Colour="0,0,0" />
      <Function ID="5" Name="Colour 2" Display="'Colour 2'" Dmx="206~210" WheelPosition="2" Colour="0,0,0" />
      <Function ID="6" Name="Colour 3" Display="'Colour 3'" Dmx="211~215" WheelPosition="3" Colour="0,0,0" />
      <Function ID="7" Name="Colour 4" Display="'Colour 4'" Dmx="216~220" WheelPosition="4" Colour="0,0,0" />
      <Function ID="8" Name="Colour 5" Display="'Colour 5'" Dmx="221~225" WheelPosition="5" Colour="0,0,0" />
      <Function ID="9" Name="Colour 6" Display="'Colour 6'" Dmx="226~230" WheelPosition="6" Colour="0,0,0" />
      <Function ID="10" Name="Colour 7" Display="'Colour 7'" Dmx="231~235" WheelPosition="7" Colour="0,0,0" />
      <Function ID="11" Name="Colour 8" Display="'Colour 8'" Dmx="236~240" WheelPosition="8" Colour="0,0,0" />
      <Function ID="12" Name="Colour 9" Display="'Colour 9'" Dmx="241~245" WheelPosition="9" Colour="0,0,0" />
      <Function ID="13" Name="Colour 10" Display="'Colour 10'" Dmx="246~250" WheelPosition="10" Colour="0,0,0" />
      <Function ID="14" Name="Colour 11" Display="'Colour 11'" Dmx="251~255" WheelPosition="11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

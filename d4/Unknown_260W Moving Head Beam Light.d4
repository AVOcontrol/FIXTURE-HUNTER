      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Gobo_Shake" ChannelOffset="7" Wheel="15" />
      <Attribute ID="Reserved" ChannelOffset="14" Wheel="30" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="28" />
      <Attribute ID="Lamp" ChannelOffset="16" Wheel="29" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

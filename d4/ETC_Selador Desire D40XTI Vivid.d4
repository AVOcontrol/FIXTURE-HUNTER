    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="YellowAdditive" ChannelOffset="2" Wheel="40" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="41" />

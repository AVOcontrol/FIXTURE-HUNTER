  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="211bdfad-8f4a-4be2-9a85-3f9aa049f2a7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Speed 4" Display="'Speed 4'" Dmx="0~0" />
      <Function ID="2" Name="Speed 3" Display="'Speed 3'" Dmx="21~40" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="41~60" />
      <Function ID="4" Name="Speed 1" Display="'Speed 1'" Dmx="61~80" />
      <Function ID="5" Name="Speed Off" Display="'Speed Off'" Dmx="81~99" />
      <Function ID="6" Name="Program 1" Display="'Program 1'" Dmx="100~109" />
      <Function ID="7" Name="Program 2" Display="'Program 2'" Dmx="110~119" />
      <Function ID="8" Name="Program 3" Display="'Program 3'" Dmx="120~129" />
      <Function ID="9" Name="Program 4" Display="'Program 4'" Dmx="130~139" />
      <Function ID="10" Name="Program 5" Display="'Program 5'" Dmx="140~149" />
      <Function ID="11" Name="Program 6" Display="'Program 6'" Dmx="150~159" />
      <Function ID="12" Name="Program 7" Display="'Program 7'" Dmx="160~169" />
      <Function ID="13" Name="Program 8" Display="'Program 8'" Dmx="170~179" />
      <Function ID="14" Name="Program 9" Display="'Program 9'" Dmx="180~189" />
      <Function ID="15" Name="Program 10" Display="'Program 10'" Dmx="190~199" />
      <Function ID="16" Name="Sound Col" Display="'Sound Col'" Dmx="200~240" />
      <Function ID="17" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="241~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 5 DMX" Channels="5">
    <Import PearlRef="UKEXLVPS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b4567478-dcbc-49aa-b29d-b9c3c851d882" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />

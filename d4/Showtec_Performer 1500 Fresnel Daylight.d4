  <AtlaBase TypeID="6b66cacb-93d0-4ce3-97b9-33b6a63dbecb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="White" Name="Natural White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="4000K" Display="'4000K'" Dmx="11~35" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="36~60" Colour="255,255,255" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="61~85" Colour="255,255,255" />
      <Function ID="5" Name="5000K" Display="'5000K'" Dmx="86~110" Colour="255,255,255" />
      <Function ID="6" Name="5200K" Display="'5200K'" Dmx="111~135" Colour="255,255,255" />
      <Function ID="7" Name="5400K" Display="'5400K'" Dmx="136~160" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="161~185" Colour="255,255,255" />
      <Function ID="9" Name="6000K" Display="'6000K'" Dmx="186~210" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
  </Control>

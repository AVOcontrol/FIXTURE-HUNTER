    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~0" />
      <Function ID="2" Name="1/3 Speed, Slow" Display="'1/3 Speed, Slow'" Dmx="129~170" />
      <Function ID="3" Name="1/2 Speed, Med" Display="'1/2 Speed, Med'" Dmx="171~211" />
      <Function ID="4" Name="Fastest Speed" Display="'Fastest Speed'" Dmx="212~255" />

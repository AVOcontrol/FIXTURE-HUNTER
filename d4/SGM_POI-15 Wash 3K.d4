  <Thumbnail>1947d4f0-2c31-4ef0-b614-8692ef2eb4a9</Thumbnail>
  <History Date="23-05-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="28-05-25" Author="Nic Morris" Comment="Split for Capture.  Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5f7c708d-14b2-42a6-ac1a-496b12cdab94" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="151~16" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~244" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="152~175" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="176~199" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RAW" Display="'RAW'" Dmx="1~4" Colour="255,255,255" />
      <Function ID="3" Name="CTC" Display="'%.fK',2000~10000" Dmx="5~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Path" Name="Colour Path" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="SGM Standard" Display="'SGM Standard'" Dmx="0~0" />
      <Function ID="2" Name="SGM VersaPath" Display="'SGM VersaPath'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CTC RGB" Display="'CTC RGB'" Dmx="0~0" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="2" Name="xy (CIE 1931)" Display="'xy (CIE 1931)'" Dmx="5~9" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="3" Name="HSI" Display="'HSI'" Dmx="10~14" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="4" Name="CMY" Display="'CMY'" Dmx="15~19" Update="Red, Green, Blue" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="+/-_Green" Name="+/- Green" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.1f%%',100.0~0.0" Dmx="5~125" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="126~134" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~100.0" Dmx="135~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Frequency" Display="'Frequency %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Gamma Filtered" Display="'Gamma Filtered'" Dmx="0~0" />
      <Function ID="2" Name="Gamma Raw" Display="'Gamma Raw'" Dmx="5~9" />
      <Function ID="3" Name="Gamma Halogen" Display="'Gamma Halogen'" Dmx="10~14" />
      <Function ID="4" Name="Linear Filtered" Display="'Linear Filtered'" Dmx="15~19" />
      <Function ID="5" Name="Linear Raw" Display="'Linear Raw'" Dmx="20~24" />
      <Function ID="6" Name="Linear Halogen" Display="'Linear Halogen'" Dmx="25~29" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="HSI" ID="2" If="'Colour_Mode'==3" />
      <Condition Name="xy Control (CIE 1931)" ID="3" If="'Colour_Mode'==2" />
      <Condition Name="CMY" ID="4" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="3" Name="x" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="4" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="HSI" ID="2" If="'Colour_Mode'==3" />
      <Condition Name="xy Control (CIE 1931)" ID="3" If="'Colour_Mode'==2" />
      <Condition Name="CMY" ID="4" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="3" Name="y" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="4" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Else ID="1" />
      <Condition Name="HSI" ID="2" If="'Colour_Mode'==3" />
      <Condition Name="CMY" ID="3" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
      <Function ID="2" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
      <Function ID="3" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

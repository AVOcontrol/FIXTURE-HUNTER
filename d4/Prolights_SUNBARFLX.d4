      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="89~128" />
      <Function ID="8" Name="Spikers" Display="'Spikers %.f%%',0~100" Dmx="215~254" />
    </Attribute>
    <Attribute ID="Master_Duratn" Name="Master Duratn" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~990" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Rate" Name="Master Rate" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Rate" Display="'Rate %.1f%%',0.0~100.0" Dmx="6~250" />
    </Attribute>
    <Attribute ID="Frost" Name="Smart Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="23-09-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-09-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="07-06-21" Author="Nic Morris" Comment="Updated in line with 05/2021 chart (firmware v1.2).  Note shutter functions look wrong - left unchanged.  Effect ranges not documented properly and don't make sense - made best guess." Version="3" />
  <History Date="09-06-21" Author="Nic Morris" Comment="Updated Atlabase ID's to latest version." Version="4" />
  <History Date="16-02-22" Author="Nic Morris" Comment="Updated in line with 01/2022 chart (adds extra set custom col cal functions and revises reverse mapping function DMX ranges and macros)" Version="5" />
  <History Date="24-05-22" Author="Nic Morris" Comment="Created from Clay Paky Tambora Batten (effect ranges and documentation suffer from the same problem.  no pixel layout)" Version="7" />
  <History Date="04-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />
  <History Date="31-01-25" Author="Nic Morris" Comment="Created from Clay Paky Tambora Linear 100 (no pixel layout.  guessed)" Version="11" />
  <History Date="03-02-25" Author="Nic Morris" Comment="Added missing Atlabase ID's (the advanced mode no longer appears to exist)" Version="16" />

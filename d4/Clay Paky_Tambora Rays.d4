  <AtlaBase TypeID="338a781f-619c-461c-a61d-32c2f5634daa" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2700~8000" Dmx="255~10" Colour="255,240,200" />
      <Function ID="3" Name="8000K" Display="'8000K'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="4" Name="7000K" Display="'7000K'" Dmx="54~54" Colour="255,255,255" />
      <Function ID="5" Name="6000K" Display="'6000K'" Dmx="99~99" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="117~117" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="144~144" Colour="255,255,255" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="188~188" Colour="255,255,255" />
      <Function ID="9" Name="3200K" Display="'3200K'" Dmx="224~224" Colour="255,255,255" />
      <Function ID="10" Name="2700K" Display="'2700K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour_xFade" Name="Colour xFade" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="xFade" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="2~3" />
      <Function ID="3" Name="SLN" Display="'SLN'" Dmx="4~5" />
      <Function ID="4" Name="Theatre" Display="'Theatre'" Dmx="6~7" />
      <Function ID="5" Name="Constant" Display="'Constant'" Dmx="8~9" />
      <Function ID="6" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="38~42" />
      <Function ID="7" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="43~47" />
      <Function ID="8" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="48~52" />
      <Function ID="9" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="53~55" />
      <Function ID="10" Name="Dim Curve 5" Display="'Dim Curve 5'" Dmx="56~57" />
      <Function ID="11" Name="Raw Col Gamma 1" Display="'Raw Col Gamma 1'" Dmx="58~62" />
      <Function ID="12" Name="Raw Col Gamma 1.5" Display="'Raw Col Gamma 1.5'" Dmx="63~67" />
      <Function ID="13" Name="Raw Col Gamma 2.2" Display="'Raw Col Gamma 2.2'" Dmx="68~72" />
      <Function ID="14" Name="Reverse Mapping Off" Display="'Reverse Mapping Off'" Dmx="85~86" />
      <Function ID="15" Name="Reverse Mapping On" Display="'Reverse Mapping On'" Dmx="87~88" />
      <Function ID="16" Name="Pixel Mapping Off" Display="'Pixel Mapping Off'" Dmx="93~97" />
      <Function ID="17" Name="Pixel Mapping On (RGB)" Display="'Pixel Mapping On (RGB)'" Dmx="98~102" />
      <Function ID="18" Name="Pixel Mapping On (RGBW)" Display="'Pixel Mapping On (RGBW)'" Dmx="103~107" />
      <Function ID="19" Name="PWM Freq 600Hz" Display="'PWM Freq 600Hz'" Dmx="168~188" />
      <Function ID="20" Name="PWM Freq 1200Hz" Display="'PWM Freq 1200Hz'" Dmx="189~199" />
      <Function ID="21" Name="PWM Freq 2000Hz" Display="'PWM Freq 2000Hz'" Dmx="200~210" />
      <Function ID="22" Name="PWM Freq 4000Hz" Display="'PWM Freq 4000Hz'" Dmx="211~221" />
      <Function ID="23" Name="PWM Freq 6000Hz" Display="'PWM Freq 6000Hz'" Dmx="222~232" />
      <Function ID="24" Name="PWM Freq 25000Hz" Display="'PWM Freq 25000Hz'" Dmx="233~243" />
      <Function ID="25" Name="Display Off" Display="'Display Off'" Dmx="244~248" />
      <Function ID="26" Name="Display On" Display="'Display On'" Dmx="249~253" />
      <Function ID="27" Name="Recall Default Function" Display="'Recall Default Function'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Effect_Mode" Name="Effect Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Effect_Rot" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="6~130" Update="Effect_Rot" />
      <Function ID="3" Name="Dynamic" Display="'Dynamic'" Dmx="131~255" Update="Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" />
      <Function ID="2" Name="Effect 2" Display="'Effect 2'" Dmx="16~31" />
      <Function ID="3" Name="Effect 3" Display="'Effect 3'" Dmx="32~47" />
      <Function ID="4" Name="Effect 4" Display="'Effect 4'" Dmx="48~63" />
      <Function ID="5" Name="Effect 5" Display="'Effect 5'" Dmx="64~79" />
      <Function ID="6" Name="Effect 6" Display="'Effect 6'" Dmx="80~95" />
      <Function ID="7" Name="Effect 7" Display="'Effect 7'" Dmx="96~111" />
      <Function ID="8" Name="Effect 8" Display="'Effect 8'" Dmx="112~127" />
      <Function ID="9" Name="Effect 9" Display="'Effect 9'" Dmx="128~143" />
      <Function ID="10" Name="Effect 10" Display="'Effect 10'" Dmx="144~159" />
      <Function ID="11" Name="Effect 11" Display="'Effect 11'" Dmx="160~175" />
      <Function ID="12" Name="Effect 12" Display="'Effect 12'" Dmx="176~191" />
      <Function ID="13" Name="Effect 13" Display="'Effect 13'" Dmx="192~207" />
      <Function ID="14" Name="Effect 14" Display="'Effect 14'" Dmx="208~223" />
      <Function ID="15" Name="Effect 15" Display="'Effect 15'" Dmx="224~239" />
      <Function ID="16" Name="Effect 16" Display="'Effect 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Index" ID="2" If="'Effect_Mode'==2" />
      <Condition Name="Speed" ID="3,4,5" If="'Effect_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~124" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="125~130" />
      <Function ID="5" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Effect_Fade" Name="Effect Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="130~6" />
      <Function ID="3" Name="Wake" Display="'Wake %.1f%%',0.0~100.0" Dmx="255~131" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master_Shutter" Name="Master Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
  </Control>

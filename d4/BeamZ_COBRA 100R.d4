      <Function ID="15" Name="Custom Effect 5" Display="'Custom Effect 5 %.f%%',0~100" Dmx="205~217" Colour="0,0,0" />
      <Function ID="16" Name="Custom Effect 6" Display="'Custom Effect 6 %.f%%',0~100" Dmx="218~230" Colour="0,0,0" />
      <Function ID="17" Name="Custom Effect 7" Display="'Custom Effect 7 %.f%%',0~100" Dmx="231~244" Colour="0,0,0" />
      <Function ID="18" Name="Custom Effect 8" Display="'Custom Effect 8 %.f%%',0~100" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Custom_BG_Col" Name="Custom BG Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red %.f%%',0~100" Dmx="8~25" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="26~43" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="44~51" Colour="0,0,255" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green %.f%%',0~100" Dmx="52~69" Colour="255,255,255" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue %.f%%',0~100" Dmx="70~87" Colour="255,255,255" />
      <Function ID="7" Name="Green+Blue" Display="'Green+Blue %.f%%',0~100" Dmx="88~105" Colour="255,255,255" />
      <Function ID="8" Name="Red+Green+Blue" Display="'Red+Green+Blue %.f%%',0~100" Dmx="106~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="50~200" />

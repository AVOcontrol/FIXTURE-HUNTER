  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~250" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="11~80" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="81~140" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="141~200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="3000K" Display="'3000K'" Dmx="14~22" WheelPosition="1" Colour="255,240,200" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="32~40" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Dark Blue" Display="'Dark Blue'" Dmx="50~58" WheelPosition="3" Colour="0,0,180" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="68~76" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="86~94" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="104~112" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Bright Blue" Display="'Bright Blue'" Dmx="122~130" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Op/ 3000" Display="'Op/ 3000'" Dmx="5~13" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="3000/ Rd" Display="'3000/ Rd'" Dmx="23~31" WheelPosition="1" Colour="255,240,200" />
      <Function ID="11" Name="Rd/ D Blu" Display="'Rd/ D Blu'" Dmx="41~49" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="D Blu/ Grn" Display="'D Blu/ Grn'" Dmx="59~67" WheelPosition="3" Colour="0,0,180" />
      <Function ID="13" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="77~85" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Mag/ Yel" Display="'Mag/ Yel'" Dmx="95~103" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Yel/ B Blu" Display="'Yel/ B Blu'" Dmx="113~121" WheelPosition="6" Colour="255,255,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~195" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />

  <History Date="18-11-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d4eb9176-813e-4d6e-9093-698fd1e75f4d" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="4 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="135~239" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="135~239" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="3~14" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~44" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="45~59" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="60~74" Colour="255,255,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="75~89" Colour="128,0,255" />
      <Function ID="8" Name="Turquoise" Display="'Turquoise'" Dmx="90~104" Colour="0,255,128" />
      <Function ID="9" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="105~119" Colour="255,255,255" />
      <Function ID="10" Name="Auto Red" Display="'Auto Red %.f%%',0~100" Dmx="120~149" Colour="255,255,255" />
      <Function ID="11" Name="Auto Green" Display="'Auto Green %.f%%',0~100" Dmx="150~179" Colour="255,255,255" />
      <Function ID="12" Name="Auto Blue" Display="'Auto Blue %.f%%',0~100" Dmx="180~209" Colour="255,255,255" />
      <Function ID="13" Name="Auto White" Display="'Auto White %.f%%',0~100" Dmx="210~239" Colour="255,255,255" />
      <Function ID="14" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 1 (Fast)" Display="'Show 1 (Fast)'" Dmx="3~101" />
      <Function ID="3" Name="Show 1 (Slow)" Display="'Show 1 (Slow)'" Dmx="102~152" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="153~203" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="48156202-30f6-4667-b40e-d281b9b27df4" />
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
      <Attribute ID="Tilt_Speed" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Dummy" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="39 DMX" Channels="39">

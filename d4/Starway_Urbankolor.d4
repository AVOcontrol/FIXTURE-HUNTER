<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Urbankolor" ShortName="UrbanKolor" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="18-06-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe'" Dmx="16~151" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse Slow" Display="'Open Pulse Slow'" Dmx="152~159" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse Med" Display="'Open Pulse Med'" Dmx="160~167" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse Fast" Display="'Open Pulse Fast'" Dmx="168~175" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse Slow" Display="'Close Pulse Slow'" Dmx="176~183" Intensity="0~0" />
      <Function ID="8" Name="Close Pulse Med" Display="'Close Pulse Med'" Dmx="184~190" Intensity="0~0" />
      <Function ID="9" Name="Close Pulse Fast" Display="'Close Pulse Fast'" Dmx="191~199" Intensity="0~0" />
      <Function ID="10" Name="Rnd Strobe Slow" Display="'Rnd Strobe Slow'" Dmx="200~207" Intensity="0~0" />
      <Function ID="11" Name="Rnd Strobe Med" Display="'Rnd Strobe Med'" Dmx="208~215" Intensity="0~0" />
      <Function ID="12" Name="Rnd Strobe Fast" Display="'Rnd Strobe Fast'" Dmx="216~223" Intensity="0~0" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="20~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Rainbow Slow" Display="'Rainbow Slow'" Dmx="8~15" Colour="0,0,0" />
      <Function ID="3" Name="Rainbow Med" Display="'Rainbow Med'" Dmx="16~23" Colour="0,0,0" />
      <Function ID="4" Name="Rainbow Fast" Display="'Rainbow Fast'" Dmx="24~31" Colour="0,0,0" />
      <Function ID="5" Name="Rainbow T Slow" Display="'Rainbow T Slow'" Dmx="32~39" Colour="0,0,0" />
      <Function ID="6" Name="Rainbow T Med" Display="'Rainbow T Med'" Dmx="40~47" Colour="0,0,0" />
      <Function ID="7" Name="Rainbow T Fast" Display="'Rainbow T Fast'" Dmx="48~55" Colour="0,0,0" />
      <Function ID="8" Name="Rainbow T V Fast" Display="'Rainbow T V Fast'" Dmx="56~63" Colour="0,0,0" />
      <Function ID="9" Name="Rainbow Random" Display="'Rainbow Random'" Dmx="64~70" Colour="0,0,0" />
      <Function ID="10" Name="Register Colours" Display="'Register Colours'" Dmx="71~71" Colour="0,0,0" />
      <Function ID="11" Name="Random Slow" Display="'Random Slow'" Dmx="72~79" Colour="0,0,0" />
      <Function ID="12" Name="Random Fast" Display="'Random Fast'" Dmx="80~87" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="White_Balance" Name="White Balance" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White Bal Disabled" Display="'White Bal Disabled'" Dmx="0~63" />
      <Function ID="2" Name="White Bal Enabled" Display="'White Bal Enabled'" Dmx="64~189" />
      <Function ID="3" Name="White Bal Disabled" Display="'White Bal Disabled'" Dmx="190~250" />
      <Function ID="4" Name="Store White Bal" Display="'Store White Bal'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="SW_UrbanCol" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="8" />
      <Attribute ID="White_Balance" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
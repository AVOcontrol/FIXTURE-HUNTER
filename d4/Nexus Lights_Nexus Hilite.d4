<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Nexus Hilite" ShortName="Hilite" Company="Nexus Lights" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="19-05-26" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Single Flash" Display="'Single Flash'" Dmx="5~9" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~250" />
      <Function ID="5" Name="Rnd All" Display="'Rnd All %.f%%',0~100" Dmx="160~199" />
      <Function ID="6" Name="Rnd Pix" Display="'Rnd Pix %.f%%',0~100" Dmx="130~159" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="10~39" />
      <Function ID="8" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="40~69" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="70~99" />
      <Function ID="10" Name="Double Flash" Display="'Double Flash %.f%%',0~100" Dmx="100~129" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open (Selected White Point)" Display="'Open (Selected White Point)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="1800-10000K" Display="'1800-10000K %.fK',1800~10000" Dmx="255~11" Colour="0,0,0" />
      <Function ID="3" Name="10000K" Display="'10000K'" Dmx="10~10" Colour="0,0,0" />
      <Function ID="4" Name="8000K" Display="'8000K'" Dmx="70~70" Colour="0,0,0" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="115~115" Colour="0,0,0" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="141~141" Colour="0,0,0" />
      <Function ID="7" Name="4000K" Display="'4000K'" Dmx="189~189" Colour="0,0,0" />
      <Function ID="8" Name="3500K" Display="'3500K'" Dmx="204~204" Colour="0,0,0" />
      <Function ID="9" Name="3200K" Display="'3200K'" Dmx="213~213" Colour="0,0,0" />
      <Function ID="10" Name="3000K" Display="'3000K'" Dmx="218~218" Colour="0,0,0" />
      <Function ID="11" Name="2700K" Display="'2700K'" Dmx="227~227" Colour="0,0,0" />
      <Function ID="12" Name="2300K" Display="'2300K'" Dmx="239~239" Colour="0,0,0" />
      <Function ID="13" Name="1800K" Display="'1800K'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="M/G_Shift" Name="M/G Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off (No Correction)" Display="'Off (No Correction)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Plus Magenta" Display="'Full Plus Magenta'" Dmx="10~10" Colour="0,0,0" />
      <Function ID="3" Name="+ Magenta" Display="'+ Magenta %.f%%',99~1" Dmx="11~124" Colour="0,0,0" />
      <Function ID="4" Name="Neutral/ No Effect" Display="'Neutral/ No Effect'" Dmx="125~140" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',1~99" Dmx="141~254" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CQC" Name="CQC" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="High Brightness-&gt;High CRI" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (Normal), 8 DMX" Channels="8" Id="a6e36f8a-d9e7-4322-8ae9-39d60baa315f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="CTC" ChannelOffset="6" Wheel="7" />
      <Attribute ID="M/G_Shift" ChannelOffset="7" Wheel="8" />
      <Attribute ID="CQC" ChannelOffset="8" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Legend="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Legend="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Legend="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Legend="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Legend="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Legend="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Legend="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Legend="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Legend="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Legend="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:4:100" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:7:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:7:100" />
      <Palette ID="8" Name="Closed" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Fresnel 2K HD" ShortName="Fr 2K HD" Company="Expolite" Version="1">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="30-09-24" Author="Nic Morris" Comment="Created" Version="0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Profile 700" ShortName="Al-Pro 700" Company="Clay Paky" Version="22">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>1705745b-772e-4560-9122-8aa1b9788072</Thumbnail>
  <History Date="17-09-09" Author="David Hunt" Comment="Created" Version="1" />
  <History Date="23-11-09" Author="John Rogers" Comment="Extensive update in line with Clay Paky documentation." Version="2" />
  <History Date="19-07-10" Author="John Rogers" Comment="Edited blade Attribute IDs." Version="3" />
  <History Date="16-09-11" Author="Karel Bartak" Comment="Edited Macro Effects and Autofocus." Version="4" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="5" />
  <History Date="20-04-12" Author="Peter Budd" Comment="Edited changed blade channel allocation in line with clay paky request." Version="6" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="7" />
  <History Date="20-07-16" Author="Nic Morris" Comment="Changed Atlabase ID's from RGB to CMY" Version="8" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Standardised conditionals.  Fixed duplicate functions in else conditions." Version="9" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Added split gel colour options.  Shortened index colour function names to fit in displays." Version="10" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Added colour function index.  Changed CTB to CTO.  Revised colour index DMX ranges for full field control." Version="11" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Revised colour macros with discreet functions.  Standardised shutter." Version="12" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised gobo attribute ID's and removed non-existant ID's from Gobo1Func update." Version="13" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Fixed 16 bit raw display ranges.  Removed prism and prism rot from gobo update." Version="14" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Revised function functions.  Revised speed functions.  Renamed Autofocus to Autofocus Adj." Version="15" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Revised autofocus functions.  Recreated palettes." Version="16" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Fixed colour no scroll display range (was percentage).  Inverted zoom." Version="17" />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly." Version="18" />
  <History Date="14-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's." Version="19" />
  <History Date="06-03-19" Author="Nic Morris" Comment="Added gobo swatches" Version="20" />
  <History Date="08-09-20" Author="Nic Morris" Comment="Updated Atlabase mode ID's to latest version." Version="21" />
  <History Date="08-08-21" Author="Nic Morris" Comment="Fixed attribute ID references in lamp macros.  Added Lamp On macro for compatibility (equivalent to Lamp On Full)." Version="22" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="288" />
  </RDM>

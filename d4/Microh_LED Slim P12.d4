  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b6daa95a-4a87-4236-920f-dc66c9121fa9" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" Update="Shutter" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Update="Shutter" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Update="Shutter" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Update="Shutter" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="64~79" Update="Shutter" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="80~95" Update="Shutter" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="96~111" Update="Shutter" />
      <Function ID="8" Name="White" Display="'White'" Dmx="112~127" Update="Shutter" />
      <Function ID="9" Name="Fade 1" Display="'Fade 1'" Dmx="128~135" Update="Shutter" />
      <Function ID="10" Name="Fade 2" Display="'Fade 2'" Dmx="136~143" Update="Shutter" />
      <Function ID="11" Name="Fade 3" Display="'Fade 3'" Dmx="144~151" Update="Shutter" />
      <Function ID="12" Name="Fade 4" Display="'Fade 4'" Dmx="152~159" Update="Shutter" />
      <Function ID="13" Name="Fade 5" Display="'Fade 5'" Dmx="160~167" Update="Shutter" />
      <Function ID="14" Name="Fade 6" Display="'Fade 6'" Dmx="168~175" Update="Shutter" />
      <Function ID="15" Name="Fade 7" Display="'Fade 7'" Dmx="176~183" Update="Shutter" />
      <Function ID="16" Name="Fade 8" Display="'Fade 8'" Dmx="184~191" Update="Shutter" />
      <Function ID="17" Name="Change 1" Display="'Change 1'" Dmx="192~199" Update="Shutter" />
      <Function ID="18" Name="Change 2" Display="'Change 2'" Dmx="200~207" Update="Shutter" />
      <Function ID="19" Name="Change 3" Display="'Change 3'" Dmx="208~215" Update="Shutter" />
      <Function ID="20" Name="Change 4" Display="'Change 4'" Dmx="216~223" Update="Shutter" />
      <Function ID="21" Name="Change 5" Display="'Change 5'" Dmx="224~231" Update="Shutter" />
      <Function ID="22" Name="Change 6" Display="'Change 6'" Dmx="232~239" Update="Shutter" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="240~247" Update="Shutter" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="248~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="4 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~189" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;8&amp;&amp;'Mode'&lt;23" />
      <Condition Name="Sensitivity" ID="4" If="'Mode'&gt;22" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="MMSLP123" DiamondRef="" WysiwygRef="" />
    <Physical>

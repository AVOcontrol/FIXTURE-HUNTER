      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="206~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">

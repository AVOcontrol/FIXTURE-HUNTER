        <Swatch>90b2ea27-e806-498c-91cb-072e908c7735</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="90~99" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>e0715350-e46b-4fdc-abcc-26d1474fcc42</Swatch>
      </Function>
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>bed1e412-59db-4227-ad76-d0221aa6cdf3</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="220~234" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ac41457c-f44e-40bf-8621-bb537c5b3691</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="205~219" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>bac8c711-d250-4eb7-82c1-d992969d84d7</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="190~204" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>233778ee-5f6c-4418-9bea-10c01f8afef9</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="175~189" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>46b3dbe6-68e5-4268-b2c6-d91f58eaece4</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~174" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>0c5fc5d6-9af3-470a-94c6-c15957da69f9</Swatch>
      </Function>
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="145~159" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>072b6fb9-07be-4707-bf29-d2c2005cb86e</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="130~144" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>2a5be076-e235-44db-a6fd-f6258cb31040</Swatch>
      </Function>
      <Function ID="19" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="115~129" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>90b2ea27-e806-498c-91cb-072e908c7735</Swatch>
      </Function>
      <Function ID="20" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="100~114" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>e0715350-e46b-4fdc-abcc-26d1474fcc42</Swatch>
      </Function>
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="235~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>bed1e412-59db-4227-ad76-d0221aa6cdf3</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ef5a6f03-67c6-4423-9606-1e788e110cfa</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>b675b597-c834-4c86-8605-c480f416687e</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>a2948ddc-9fb0-4655-9df0-2276926654ce</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>c1cdc70b-219e-4b07-ba1c-43a7ad6119cc</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>8f9d58c2-c1eb-4e75-8b54-f855cb76ed77</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>53f9cb29-f5da-4745-b81a-dbad3c86caf4</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>261ed9fa-43f7-428e-988a-c5b3273f0c12</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>bed1e412-59db-4227-ad76-d0221aa6cdf3</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="200~219" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ef5a6f03-67c6-4423-9606-1e788e110cfa</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="180~199" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>b675b597-c834-4c86-8605-c480f416687e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="160~179" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>a2948ddc-9fb0-4655-9df0-2276926654ce</Swatch>

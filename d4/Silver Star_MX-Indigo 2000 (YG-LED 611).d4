      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="140~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>c1cdc70b-219e-4b07-ba1c-43a7ad6119cc</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="120~139" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>8f9d58c2-c1eb-4e75-8b54-f855cb76ed77</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="100~119" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>53f9cb29-f5da-4745-b81a-dbad3c86caf4</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="80~99" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0">

      <Function ID="17" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="18" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="19" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />

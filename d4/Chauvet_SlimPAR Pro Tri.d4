    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'%.1f Hz',0.0~20.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~51" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="52~101" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="102~152" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="153~203" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="204~254" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_Speed" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default Linear" Display="'Default Linear'" Dmx="0~51" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Non Linear 1" Display="'Non Linear 1'" Dmx="102~152" />
      <Function ID="4" Name="Non Linear 2" Display="'Non Linear 2'" Dmx="153~203" />
      <Function ID="5" Name="Non Linear 3" Display="'Non Linear 3'" Dmx="204~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Xeon Ultimate" ShortName="Xeon Ult" Company="Swefog">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="03-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="23-12-15" Author="Nic Morris" Comment="Changed manufacturer from Unknown to Swefog" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="UK_SWXnUlt" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
  <History Date="01-11-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="03-11-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="17-02-21" Author="Nic Morris" Comment="Created from Aputure LS 300x" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="afeac6dd-8689-4bc5-a19e-3bddf5908b9f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~0" />
      <Function ID="2" Name="FX" Display="'FX'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="20~39" />
      <Function ID="3" Name="3" Display="'3'" Dmx="40~59" />
      <Function ID="4" Name="4" Display="'4'" Dmx="60~79" />
      <Function ID="5" Name="5" Display="'5'" Dmx="80~99" />
      <Function ID="6" Name="6" Display="'6'" Dmx="100~119" />
      <Function ID="7" Name="7" Display="'7'" Dmx="120~139" />
      <Function ID="8" Name="8" Display="'8'" Dmx="140~159" />
      <Function ID="9" Name="9" Display="'9'" Dmx="160~179" />
      <Function ID="10" Name="10" Display="'10'" Dmx="180~199" />
      <Function ID="11" Name="R" Display="'R'" Dmx="200~219" />
    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="FX_Param" />
      <Function ID="2" Name="Fireworks" Display="'Fireworks'" Dmx="20~39" Update="FX_Param" />
      <Function ID="3" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="40~59" Update="FX_Param" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="60~79" Update="FX_Param" />
      <Function ID="5" Name="TV" Display="'TV'" Dmx="80~99" Update="FX_Param" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="100~119" Update="FX_Param" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="120~139" Update="FX_Param" />
      <Function ID="8" Name="Explosion" Display="'Explosion'" Dmx="140~159" Update="FX_Param" />
    </Attribute>
    <Attribute ID="FX_Param" Name="FX Param" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Lightning" ID="2,3,4" If="'FX'==4" />
      <Condition Name="Explosion" ID="5,6" If="'FX'==8" />
      <Else ID="1" />
      <Function ID="2" Name="Start Point" Display="'Start Point'" Dmx="0~0" />
      <Function ID="3" Name="Single Trigger" Display="'Single Trigger'" Dmx="1~127" />
      <Function ID="4" Name="Cycle" Display="'Cycle'" Dmx="128~255" />
      <Function ID="5" Name="Start Point" Display="'Start Point'" Dmx="0~0" />
      <Function ID="6" Name="Single Trigger" Display="'Single Trigger'" Dmx="1~127" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e0d8fff4-6c49-44b9-9f48-555447788186" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Mode" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Frequency" ChannelOffset="3" Wheel="28" />
      <Attribute ID="FX" ChannelOffset="4" Wheel="22" />
      <Attribute ID="FX_Param" ChannelOffset="5" Wheel="23" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="f5837f8a-8569-4d3e-9145-8957be655f81"></Swatch>
    <Swatch id="2f72ac70-a183-4dce-b77e-3a9ccc4cbd95"></Swatch>
  </swatchLibrary>
</Fixture>
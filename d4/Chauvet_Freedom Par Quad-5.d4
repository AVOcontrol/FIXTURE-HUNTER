<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Freedom Par Quad-5" ShortName="Free ParQ5" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="23-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="37090cb1-1b64-4f63-85ac-35cebfbae869" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Run Speed" ID="2,3" If="'Colour_Macro'&gt;17&amp;&amp;'Colour_Macro'&lt;26" />
      <Condition Name="Snap Speed" ID="4" If="'Colour_Macro'==26" />
      <Condition Name="Fade Speed" ID="5" If="'Colour_Macro'==27" />
      <Condition Name="No Function" ID="6" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;18" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
      <Function ID="4" Name="Snap Speed" Display="'Snap Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="5" Name="Fade Speed" Display="'Fade Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="6" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Flash Speed" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;25" />
      <Condition Name="No Function" ID="4" If="'Colour_Macro'&gt;24" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Flash Speed" Display="'Flash Speed %.1f%%',0.0~100.0" Dmx="0~249" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="255,255,255" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGBA Mode" Display="'RGBA Mode'" Dmx="207~215" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~8" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="9~17" Update="Red, Green, Blue, Amber" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="18~26" Update="Red, Green, Blue, Amber" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="27~35" Update="Red, Green, Blue, Amber" Colour="0,0,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="36~44" Update="Red, Green, Blue, Amber" Colour="255,100,0" />
      <Function ID="7" Name="R+G" Display="'R+G'" Dmx="45~53" Update="Red, Green, Blue, Amber" Colour="255,255,0" />
      <Function ID="8" Name="R+B" Display="'R+B'" Dmx="54~62" Update="Red, Green, Blue, Amber" Colour="255,0,255" />
      <Function ID="9" Name="R+A" Display="'R+A'" Dmx="63~71" Update="Red, Green, Blue, Amber" Colour="255,128,0" />
      <Function ID="10" Name="G+B" Display="'G+B'" Dmx="72~80" Update="Red, Green, Blue, Amber" Colour="0,255,255" />
      <Function ID="11" Name="B+A" Display="'B+A'" Dmx="81~89" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="90~98" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="13" Name="G+A" Display="'G+A'" Dmx="99~107" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="14" Name="R+G+A" Display="'R+G+A'" Dmx="108~116" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="15" Name="R+B+A" Display="'R+B+A'" Dmx="117~125" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="16" Name="G+B+A" Display="'G+B+A'" Dmx="126~134" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="17" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="135~143" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="18" Name="Color Change 1" Display="'Color Change 1'" Dmx="144~152" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="19" Name="Color Change 2" Display="'Color Change 2'" Dmx="153~161" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="20" Name="Color Chase 1" Display="'Color Chase 1'" Dmx="162~170" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="21" Name="Color Chase 2" Display="'Color Chase 2'" Dmx="171~179" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="22" Name="Color Chase 3" Display="'Color Chase 3'" Dmx="180~188" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="23" Name="Color Chase 4" Display="'Color Chase 4'" Dmx="189~197" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="24" Name="Color Change 3" Display="'Color Change 3'" Dmx="198~206" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="25" Name="Auto Run" Display="'Auto Run'" Dmx="234~255" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="26" Name="Color Snap" Display="'Color Snap'" Dmx="216~224" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
      <Function ID="27" Name="Color Fade" Display="'Color Fade'" Dmx="225~233" Update="Red, Green, Blue, Amber" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CHFPQ54" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="29a09dc0-9557-4650-b250-25e43f7628c1" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="CHFPQ55" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="946473bd-ac81-4bf0-8cb9-b7ad66472bca" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
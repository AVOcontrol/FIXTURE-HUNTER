      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="14" Name="Col Change" Display="'Col Change'" Dmx="170~174" Colour="0,0,0" />
      <Function ID="15" Name="Col Change DMX" Display="'Col Change DMX'" Dmx="175~179" Colour="0,0,0" />
      <Function ID="16" Name="Twinkle" Display="'Twinkle'" Dmx="180~184" Colour="0,0,0" />
      <Function ID="17" Name="Twinkle DMX" Display="'Twinkle DMX'" Dmx="185~189" Colour="0,0,0" />
      <Function ID="18" Name="Col Fade" Display="'Col Fade'" Dmx="190~194" Colour="0,0,0" />
      <Function ID="19" Name="Col Fade DMX" Display="'Col Fade DMX'" Dmx="195~199" Colour="0,0,0" />
      <Function ID="20" Name="No Function" Display="'No Function'" Dmx="200~219" Colour="0,0,0" />
      <Function ID="21" Name="Reset" Display="'Reset'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="22" Name="Col Macro" Display="'Col Macro'" Dmx="230~234" Colour="0,0,0" />
      <Function ID="23" Name="Col Macro DMX" Display="'Col Macro DMX'" Dmx="235~239" Colour="0,0,0" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="240~244" Colour="0,0,0" />
      <Function ID="25" Name="Sound DMX" Display="'Sound DMX'" Dmx="245~249" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
      <Function ID="3" Name="Tracking" Display="'Tracking'" Dmx="236~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="UK_WTIn3108" DiamondRef="" WysiwygRef="" />
    <Physical>

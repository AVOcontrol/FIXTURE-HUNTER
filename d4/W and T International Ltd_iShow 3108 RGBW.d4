      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="90~99" Colour="0,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="100~109" Colour="128,0,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="9" Name="3200K" Display="'3200K'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="10" Name="5600K" Display="'5600K'" Dmx="130~139" Colour="255,255,255" />

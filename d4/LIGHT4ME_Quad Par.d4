      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="252~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Program_2" Name="Program 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Program 20" Display="'Program 20'" Dmx="1~18" Update="Shutter" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Co2" ShortName="LED Co2" Company="StageFX">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="21-10-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~29" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="30~59" Colour="0,255,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="60~89" Colour="255,0,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="90~119" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="120~149" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="150~179" Colour="128,0,255" />
      <Function ID="7" Name="Sky Blue" Display="'Sky Blue'" Dmx="180~209" Colour="0,128,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Co2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKSFXCO2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Off" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:3" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:5" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:2" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="8" Name="Sky Blue" Number="6" Page="1" SetControl="Colour1:7" />
      <Palette ID="9" Name="Sky Blue" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:6" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:6" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:6" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
  </Palettes>
</Fixture>
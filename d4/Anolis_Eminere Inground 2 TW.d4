      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" />

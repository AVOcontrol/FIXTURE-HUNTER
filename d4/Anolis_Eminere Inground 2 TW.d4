  <Mode Name="Mode 19 (TW Pixels), 4 DMX" Channels="4" Id="bf42245b-3a0f-4a67-904f-38adf416bc99">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

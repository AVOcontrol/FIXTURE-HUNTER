<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Equinox Gyrocopter" ShortName="Gyrocopter" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~37" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="38~52" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="53~67" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="68~82" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="83~97" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="98~112" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~142" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="143~157" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="158~172" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="218~232" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="15~35" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="36~56" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="57~76" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="78~97" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="98~117" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="118~138" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="139~159" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="160~179" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="180~200" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="201~220" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="221~241" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="242~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~249" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="8~24" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="25~41" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="42~57" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="58~74" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="75~90" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="91~107" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="108~123" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="124~140" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="141~156" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="157~173" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="174~189" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="190~206" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="207~222" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="223~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="PTEQGYRO" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="360" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="P/T_Macro" ChannelOffset="3" Wheel="22" />

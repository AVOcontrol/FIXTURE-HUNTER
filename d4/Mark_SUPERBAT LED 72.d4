    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="White+Red" Display="'White+Red'" Dmx="9~50" />
      <Function ID="3" Name="Col Change" Display="'Col Change'" Dmx="51~100" />
      <Function ID="4" Name="Col Change w/ fade to black" Display="'Col Change w/ fade to black'" Dmx="101~150" />
      <Function ID="5" Name="Colour Mix" Display="'Colour Mix'" Dmx="151~200" />
      <Function ID="6" Name="Sound Col Change" Display="'Sound Col Change'" Dmx="201~220" />
      <Function ID="7" Name="Sound Col Strobe" Display="'Sound Col Strobe'" Dmx="221~240" />
      <Function ID="8" Name="Sound Pulse" Display="'Sound Pulse'" Dmx="241~255" />
    </Attribute>
  </Control>

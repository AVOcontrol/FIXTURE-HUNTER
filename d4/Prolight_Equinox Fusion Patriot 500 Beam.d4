      <Function ID="11" Name="3000K" Display="'3000K'" Dmx="50~54" WheelPosition="10" Colour="255,240,200" />
      <Function ID="12" Name="7000K" Display="'7000K'" Dmx="55~59" WheelPosition="11" Colour="230,230,255" />
      <Function ID="13" Name="Deep Blue" Display="'Deep Blue'" Dmx="60~64" WheelPosition="12" Colour="0,0,200" />
      <Function ID="14" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="120~124" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="115~119" WheelPosition="1" Colour="255,0,0" />

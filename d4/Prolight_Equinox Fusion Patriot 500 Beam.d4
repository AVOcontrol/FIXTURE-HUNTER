      <Function ID="22" Name="L Grn/ Blu" Display="'L Grn/ Blu'" Dmx="80~84" WheelPosition="8" Colour="0,200,0" />
      <Function ID="23" Name="Blu/ 3000" Display="'Blu/ 3000'" Dmx="75~79" WheelPosition="9" Colour="0,0,255" />
      <Function ID="24" Name="3000/ 7000" Display="'3000/ 7000'" Dmx="70~74" WheelPosition="10" Colour="255,240,200" />

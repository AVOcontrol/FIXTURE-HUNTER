      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="27" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="125~192" Colour="0,0,0" />

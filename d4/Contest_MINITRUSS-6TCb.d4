  <History Date="07-02-18" Author="Nic Morris" Comment="Created" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0b2ad011-9e0e-4968-9cc0-1fdcece19603" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;11&amp;&amp;'Colour_Macro'&lt;25" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==25" />
      <Condition Name="4 DMX" ID="4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~189" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Update="Dimmer" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="21~30" Update="Dimmer" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="31~40" Update="Dimmer" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="41~51" Update="Dimmer" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="52~61" Update="Dimmer" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="62~71" Update="Dimmer" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="72~81" Update="Dimmer" Colour="255,150,150" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="82~92" Update="Dimmer" Colour="255,0,255" />
      <Function ID="10" Name="Cool White" Display="'Cool White'" Dmx="93~102" Update="Dimmer" Colour="230,230,255" />
      <Function ID="11" Name="Warm White" Display="'Warm White'" Dmx="103~112" Update="Dimmer" Colour="255,240,200" />
      <Function ID="12" Name="Colour 1" Display="'Colour 1'" Dmx="113~122" Update="Dimmer" WheelPosition="1" Colour="0,0,0" />
      <Function ID="13" Name="Colour 2" Display="'Colour 2'" Dmx="123~133" Update="Dimmer" WheelPosition="2" Colour="0,0,0" />
      <Function ID="14" Name="Colour 3" Display="'Colour 3'" Dmx="134~143" Update="Dimmer" WheelPosition="3" Colour="0,0,0" />
      <Function ID="15" Name="Colour 4" Display="'Colour 4'" Dmx="144~153" Update="Dimmer" WheelPosition="4" Colour="0,0,0" />
      <Function ID="16" Name="Colour 5" Display="'Colour 5'" Dmx="154~163" Update="Dimmer" WheelPosition="5" Colour="0,0,0" />
      <Function ID="17" Name="Colour 6" Display="'Colour 6'" Dmx="164~174" Update="Dimmer" WheelPosition="6" Colour="0,0,0" />
      <Function ID="18" Name="Colour 7" Display="'Colour 7'" Dmx="175~184" Update="Dimmer" WheelPosition="7" Colour="0,0,0" />
      <Function ID="19" Name="Colour 8" Display="'Colour 8'" Dmx="185~194" Update="Dimmer" WheelPosition="8" Colour="0,0,0" />
      <Function ID="20" Name="Colour 9" Display="'Colour 9'" Dmx="195~204" Update="Dimmer" WheelPosition="9" Colour="0,0,0" />
      <Function ID="21" Name="Colour 10" Display="'Colour 10'" Dmx="205~215" Update="Dimmer" WheelPosition="10" Colour="0,0,0" />
      <Function ID="22" Name="Colour 11" Display="'Colour 11'" Dmx="216~225" Update="Dimmer" WheelPosition="11" Colour="0,0,0" />
      <Function ID="23" Name="Colour 12" Display="'Colour 12'" Dmx="226~235" Update="Dimmer" WheelPosition="12" Colour="0,0,0" />
      <Function ID="24" Name="Colour 13" Display="'Colour 13'" Dmx="236~245" Update="Dimmer" WheelPosition="13" Colour="0,0,0" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="246~255" Update="Dimmer" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="COM6TCB2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

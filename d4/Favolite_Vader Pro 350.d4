  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour/Gobo">
      <Set Channel="Control:4" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="88~95" Colour="0,0,0" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="104~221" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="222~238" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="239~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="10~174" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="175~189" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="190~204" Colour="255,255,255" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="205~219" Colour="255,255,255" />
      <Function ID="6" Name="8500K" Display="'8500K'" Dmx="220~234" Colour="255,255,255" />
      <Function ID="7" Name="10000K" Display="'10000K'" Dmx="235~249" Colour="255,255,255" />
      <Function ID="8" Name="Factory Defaults" Display="'Factory Defaults'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" />

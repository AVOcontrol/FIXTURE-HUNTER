<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 EP 1080 Event Panel" ShortName="EP 1080" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-12-15" Author="Nic Morris" Comment="Created" />
  <History Date="11-06-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="65d82834-23d0-4fb8-8ccc-05a900842c81" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~30" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="31~46" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="47~62" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="63~78" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="79~94" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="95~110" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="111~126" Colour="255,255,255" />
      <Function ID="9" Name="Macro" Display="'Macro'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="10" Name="Macro" Display="'Macro %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="11" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Mode 1" ID="2,3,4,5" If="'Dummy1'==1" />
      <Condition Name="Mode 3" ID="6,7" If="'Dummy2'==1" />
      <Condition Name="Mode 4" ID="8,9,10" If="'Dummy3'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="191~200" Intensity="0~0" />
      <Function ID="6" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~160" Intensity="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~255" Intensity="0~0" />
      <Function ID="8" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="9" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="128~199" Intensity="0~0" />
      <Function ID="10" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="200~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~15" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~23" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="24~30" Colour="0,0,0" />

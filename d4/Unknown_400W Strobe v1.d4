  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="3" Name="Ramp Dn" Display="'Ramp Dn'" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up/Dn" Display="'Ramp Up/Dn'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" />
      <Function ID="3" Name="Spikes" Display="'Spikes'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">

  <AtlaBase TypeID="f22e5b7a-7a04-46e5-9eec-f604ca04e2eb" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Deep Blue'" Dmx="8~15" WheelPosition="1" Colour="0,0,180" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="24~31" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="40~47" WheelPosition="5" Colour="255,0,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="48~55" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="56~63" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Op/ D Blu" Display="'Op/ D Blu'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Blu/ Yel" Display="'D Blu/ Yel'" Dmx="72~79" WheelPosition="1" Colour="0,0,180" />
      <Function ID="11" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="80~87" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Pk/ Grn" Display="'Pk/ Grn'" Dmx="88~95" WheelPosition="3" Colour="255,150,150" />
      <Function ID="13" Name="Grn/ Rd" Display="'Grn/ Rd'" Dmx="96~103" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Rd/ L Blu" Display="'Rd/ L Blu'" Dmx="104~111" WheelPosition="5" Colour="255,0,0" />
      <Function ID="15" Name="L Blu/ Org" Display="'L Blu/ Org'" Dmx="112~119" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="Org/ Op" Display="'Org/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,128,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="xUV" Name="UV" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xWhite" Name="White" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1+2+3+4" Display="'1+2+3+4'" Dmx="1~17" Colour="255,255,255" />
      <Function ID="3" Name="2" Display="'2'" Dmx="18~35" Colour="255,255,255" />
      <Function ID="4" Name="3" Display="'3'" Dmx="36~53" Colour="255,255,255" />
      <Function ID="5" Name="4" Display="'4'" Dmx="54~71" Colour="255,255,255" />
      <Function ID="6" Name="1" Display="'1'" Dmx="72~89" Colour="255,255,255" />
      <Function ID="7" Name="2+3" Display="'2+3'" Dmx="90~107" Colour="255,255,255" />
      <Function ID="8" Name="1+4" Display="'1+4'" Dmx="108~125" Colour="255,255,255" />
      <Function ID="9" Name="3+4" Display="'3+4'" Dmx="126~143" Colour="255,255,255" />
      <Function ID="10" Name="1+2" Display="'1+2'" Dmx="144~161" Colour="255,255,255" />
      <Function ID="11" Name="2+4" Display="'2+4'" Dmx="162~179" Colour="255,255,255" />
      <Function ID="12" Name="1+3" Display="'1+3'" Dmx="180~197" Colour="255,255,255" />
      <Function ID="13" Name="2+3+4" Display="'2+3+4'" Dmx="198~215" Colour="255,255,255" />
      <Function ID="14" Name="1+2+3" Display="'1+2+3'" Dmx="216~233" Colour="255,255,255" />
      <Function ID="15" Name="1+2+4" Display="'1+2+4'" Dmx="234~251" Colour="255,255,255" />
      <Function ID="16" Name="1+3+4" Display="'1+3+4'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Derby" Name="Derby" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Derbly+White+UV" Display="'Derbly+White+UV'" Dmx="0~0" />
      <Function ID="2" Name="UV" Display="'UV'" Dmx="43~84" />
      <Function ID="3" Name="White" Display="'White'" Dmx="85~126" />
      <Function ID="4" Name="Derby" Display="'Derby'" Dmx="127~169" />
      <Function ID="5" Name="White+UV" Display="'White+UV'" Dmx="170~211" />
      <Function ID="6" Name="Derby+UV" Display="'Derby+UV'" Dmx="212~253" />
      <Function ID="7" Name="Derby+White" Display="'Derby+White'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="12~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="7~146" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="147~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="49~10" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="99~50" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="149~100" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="150~199" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="200~250" />
      <Function ID="7" Name="Sound 3" Display="'Sound 3'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">

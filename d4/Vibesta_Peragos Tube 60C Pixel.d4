      <Else ID="15,16" />
      <Function ID="1" Name="2" Display="'2'" Dmx="0~0" Update="Sat/GM" />
      <Function ID="2" Name="3" Display="'3'" Dmx="2056~4089" Update="Sat/GM" />
      <Function ID="3" Name="4" Display="'4'" Dmx="4090~6123" Update="Sat/GM" />

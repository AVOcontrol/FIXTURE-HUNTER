      <Function ID="19" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" />
      <Function ID="20" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" />
      <Function ID="21" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" />

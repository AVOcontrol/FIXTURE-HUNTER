    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Pulse" Display="'Pulse'" Dmx="0~0" Update="Effect" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Spin" ID="1,2,3,4" If="'Effect_Func'==1" />
      <Condition Name="Random" ID="5,6,7" If="'Effect_Func'==2" />
      <Condition Name="Pulse" ID="8,9,10" If="'Effect_Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="63~1" />

      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="83~90" Colour="0,255,255" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="91~97" Colour="255,150,150" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="98~105" Colour="255,255,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="106~112" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="113~120" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="121~127" Colour="0,0,255" />
      <Function ID="12" Name="Off" Display="'Off'" Dmx="128~135" Colour="0,0,0" />
      <Function ID="13" Name="Red" Display="'Red'" Dmx="136~169" Colour="255,0,0" />
      <Function ID="14" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="170~175" Colour="255,0,0" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="176~188" Colour="255,255,0" />
      <Function ID="16" Name="Yel - Org" Display="'Yel - Org %.f%%',0~100" Dmx="189~199" Colour="255,255,0" />
      <Function ID="17" Name="Orange" Display="'Orange'" Dmx="200~255" Colour="255,128,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

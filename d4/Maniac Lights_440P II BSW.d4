    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="16~60" Colour="0,0,255" />
      <Function ID="3" Name="Purple" Display="'Purple'" Dmx="61~67" Colour="128,0,255" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="68~75" Colour="255,0,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="440P II BSW" ShortName="440PII BSW" Company="Maniac Lights" Version="5">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="23-04-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-04-24" Author="Nic Morris" Comment="Added colour macro function ranges in response to customer feedback." Version="2" />
  <History Date="26-04-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="22-05-26" Author="Nic Morris" Comment="Changed the 'Blue' colour macro function to a variable range and set the function index of middle no scroll/spin functions in colour/gobo controls to 0 so they act as a defaut (when changing from 'Open')  in response to customer feedback." Version="4" />
  <History Date="22-05-26" Author="Nic Morris" Comment="Also removed gobo wheel 1 slot 1 and renamed gobo functions accordingly in response to customer feedback (this is contrary to the documentation)" Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1a5161a1-9906-49c3-9100-7bac30f2bf44" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~127" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">

  </Control>
  <Mode Name="XYZ (16-bit), 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="X" ChannelOffset="1,2" Wheel="25" />
      <Attribute ID="Y" ChannelOffset="3,4" Wheel="26" />
      <Attribute ID="Z" ChannelOffset="5,6" Wheel="27" />
    </Include>
  </Mode>

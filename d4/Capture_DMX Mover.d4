<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DMX Mover" ShortName="DMX Mover" Company="Capture" Version="4">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="31-01-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="02-03-11" Author="John Rogers" Comment="Added XYZ modes in response to Vangelis." Version="2" />
  <History Date="01-04-11" Author="John Rogers" Comment="Edited locate values in response to Vangelis." Version="3" />
  <History Date="08-03-21" Author="Nic Morris" Comment="Renamed from XYZ Mover to DMX Mover.  Added missing modes." Version="4" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="X" Name="X" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Y" Name="Y" Description="" Group="P" Size="2">

  <Thumbnail>655b2cdc-4ecd-4137-9f17-92036b295e58</Thumbnail>
  <History Date="01-02-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-03-15" Author="Nic Morris" Comment="Added missing prism function ranges and removed animation functions in response to customer bug report." Version="2" />
  <History Date="30-03-15" Author="Nic Morris" Comment="Revised blades in line with latest documentation in response to customer bug report." Version="3" />
  <History Date="30-03-15" Author="Nic Morris" Comment="Revised animation functions in line with latest documentation in response to customer bug report." Version="4" />
  <History Date="19-09-15" Author="Nic Morris" Comment="Revised blades against actual fixture." Version="5" />
  <History Date="27-09-15" Author="Nic Morris" Comment="Revised fixed colour function names against physical fixture." Version="6" />
  <History Date="27-09-15" Author="Nic Morris" Comment="Added stop function to animation in line with latest spec (1.0.7)" Version="7" />
  <History Date="27-09-15" Author="Nic Morris" Comment="Updated control functions and macros to latest spec (1.0.7)" Version="8" />
  <History Date="02-12-15" Author="Nic Morris" Comment="Increased macro delay and tested with actual fixture." Version="9" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="10" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed Blade All Rot to a single range for Attribute Editor compatibility." Version="11" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Added gobo names.  Moved indigo into cell for HTP control." Version="12" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed AutoFocus to 8bit and added separate AutoFocus Adj control." Version="13" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed indigo func to default at independent dimmer." Version="14" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Fixed CMY random condition.  Shortened Gobo 1 Rot Func name to comply with 14char limit." Version="15" />
  <History Date="26-01-18" Author="Nic Morris" Comment="Created from High End SolaSpot Pro 1500 (identical - no gobo images available)" Version="16" />
  <History Date="21-02-18" Author="Nic Morris" Comment="Created from High End SolaFrame 2000" Version="17" />
  <History Date="14-04-19" Author="Nic Morris" Comment="Created from High End SolaFrame 750 (note documentation contains errors.  gobo slot 7 name differs between charts and data sheet with images)" Version="18" />
  <History Date="15-04-19" Author="Nic Morris" Comment="Corrected gobo ranges." Version="19" />
  <History Date="27-10-20" Author="Nic Morris" Comment="Created from High End SolaHyBeam 2000" Version="20" />
  <History Date="28-10-20" Author="Nic Morris" Comment="Changed AtlaBase Mode ID to revision B." Version="23" />

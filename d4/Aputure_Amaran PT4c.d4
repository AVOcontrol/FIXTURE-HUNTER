    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Lightning" ID="3,4,5" If="'FX_Selection'==2" />
      <Function ID="1" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="255~255" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="4" Name="Trigger" Display="'Trigger'" Dmx="10~69" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="70~255" />
    </Attribute>
    <Attribute ID="FX_Selection" Name="FX Selection" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="2" Name="Lightning" Display="'Lightning'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="4" Name="Fire" Display="'Fire'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="5" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="7" Name="Cop Car" Display="'Cop Car'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="8" Name="Party Lights" Display="'Party Lights'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
      <Function ID="9" Name="Fireworks" Display="'Fireworks'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4" />
    </Attribute>

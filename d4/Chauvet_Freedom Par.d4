<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Freedom Par" ShortName="FreedomPar" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="20-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Revised Atlabase Model ID (wrong fixture), fixed 4 DMX ID and added 3 DMX ID." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1b9ad265-b81b-4e46-9bb9-17857effd633" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="22" PowerOn="22" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Update="Green, Red" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Green, Red" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Update="Green, Red" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Update="Green, Red" Colour="0,0,255" />
      <Function ID="5" Name="Red + Green" Display="'Red + Green'" Dmx="40~49" Update="Green, Red" Colour="255,255,0" />
      <Function ID="6" Name="Red + Blue" Display="'Red + Blue'" Dmx="50~59" Update="Green, Red" Colour="255,0,255" />
      <Function ID="7" Name="Blue + Green" Display="'Blue + Green'" Dmx="60~69" Update="Green, Red" Colour="0,255,255" />
      <Function ID="8" Name="Red + Green + Blue" Display="'Red + Green + Blue'" Dmx="70~79" Update="Green, Red" Colour="255,255,255" />
      <Function ID="9" Name="Change 1" Display="'Change 1'" Dmx="80~89" Update="Green, Red" Colour="0,0,0" />
      <Function ID="10" Name="Change 2" Display="'Change 2'" Dmx="90~99" Update="Green, Red" Colour="0,0,0" />
      <Function ID="11" Name="Effect 1" Display="'Effect 1'" Dmx="100~109" Update="Green, Red" Colour="0,0,0" />
      <Function ID="12" Name="Effect 2" Display="'Effect 2'" Dmx="110~119" Update="Green, Red" Colour="0,0,0" />
      <Function ID="13" Name="Effect 3" Display="'Effect 3'" Dmx="120~129" Update="Green, Red" Colour="0,0,0" />
      <Function ID="14" Name="Effect 4" Display="'Effect 4'" Dmx="130~139" Update="Green, Red" Colour="0,0,0" />
      <Function ID="15" Name="Effect 5" Display="'Effect 5'" Dmx="140~149" Update="Green, Red" Colour="0,0,0" />
      <Function ID="16" Name="Effect 6" Display="'Effect 6'" Dmx="150~159" Update="Green, Red" Colour="0,0,0" />
      <Function ID="17" Name="Effect 7" Display="'Effect 7'" Dmx="160~169" Update="Green, Red" Colour="0,0,0" />
      <Function ID="18" Name="Effect 8" Display="'Effect 8'" Dmx="170~179" Update="Green, Red" Colour="0,0,0" />
      <Function ID="19" Name="Change 3" Display="'Change 3'" Dmx="180~189" Update="Green, Red" Colour="0,0,0" />
      <Function ID="20" Name="Change 4" Display="'Change 4'" Dmx="190~199" Update="Green, Red" Colour="0,0,0" />
      <Function ID="21" Name="Change 5" Display="'Change 5'" Dmx="200~209" Update="Green, Red" Colour="0,0,0" />
      <Function ID="22" Name="RGB Mode" Display="'RGB Mode'" Dmx="210~219" Update="Green, Red" Colour="0,0,0" />
      <Function ID="23" Name="Color Mode" Display="'Color Mode'" Dmx="220~229" Update="Green, Red" Colour="0,0,0" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="230~255" Update="Green, Red" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Auto" ID="2,3" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;22" />
      <Condition Name="Speed" ID="4" If="'Colour_Macro'==23" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Automatic" Display="'Automatic %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2,3" If="'Colour_Macro'&lt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',100.0~0.0" Dmx="0~249" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="CH_FreePAR3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1d3a131e-185e-4ec3-83b0-73c0e279bf24" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="CH_FreePAR4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="3535aa15-d107-42ad-9ede-91947ac259c3" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
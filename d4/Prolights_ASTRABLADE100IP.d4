    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~44" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="131~170" />
      <Function ID="4" Name="Rnd Single Pix" Display="'Rnd Single Pix %.f%%',0~100" Dmx="173~212" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="47~86" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="89~128" />
      <Function ID="7" Name="Spikers" Display="'Spikers %.f%%',0~100" Dmx="215~254" />

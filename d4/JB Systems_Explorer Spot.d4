      <Attribute ID="Show" ChannelOffset="15" Wheel="52" />
      <Attribute ID="P/T_Macro" ChannelOffset="16" Wheel="53" />
      <Attribute ID="P/T_Mac_Spd" ChannelOffset="17" Wheel="54" />
      <Attribute ID="Control" ChannelOffset="18" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effect">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Fast">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Smooth">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark On">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark On">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark Off">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark On">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark Off">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />

    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="ColdWhite" ChannelOffset="4" Wheel="9" />

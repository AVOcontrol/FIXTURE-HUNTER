      <Function ID="4" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="41~50" />
      <Function ID="5" Name="Reset Beam" Display="'Reset Beam'" Dmx="51~60" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="61~70" />
    </Attribute>
  </Control>

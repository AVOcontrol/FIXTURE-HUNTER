<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED CLS-20 HCL" ShortName="CLS-20 HCL" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-01-16" Author="Nic Morris" Comment="Created (documentation re. dimmer looks incorrect)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="40~47" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="A" Display="'A'" Dmx="48~55" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="56~63" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="RG" Display="'RG'" Dmx="64~71" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="RB" Display="'RB'" Dmx="72~79" Update="Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="GB" Display="'GB'" Dmx="80~87" Update="Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="88~95" Update="Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="RGBA" Display="'RGBA'" Dmx="96~103" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="RGBWA" Display="'RGBWA'" Dmx="104~111" Update="Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="RGBW" Display="'RGBW'" Dmx="112~119" Update="Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="WA" Display="'WA'" Dmx="120~127" Update="Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="RGBWAUV" Display="'RGBWAUV'" Dmx="128~135" Update="Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="9 and 22 DMX" ID="2,3,4" If="'Colour_Macro'&gt;1||'Colour_Macro'&lt;28" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~135" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="136~223" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'Sensitivity %.f%%',0~100" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Set Red" Display="'Set Red'" Dmx="151~165" />
      <Function ID="3" Name="Set Green" Display="'Set Green'" Dmx="166~180" />
      <Function ID="4" Name="Set Blue" Display="'Set Blue'" Dmx="181~195" />
      <Function ID="5" Name="Set White" Display="'Set White'" Dmx="196~210" />
      <Function ID="6" Name="Set Amber" Display="'Set Amber'" Dmx="211~225" />
      <Function ID="7" Name="Set UV" Display="'Set UV'" Dmx="226~250" />
      <Function ID="8" Name="Record" Display="'Record'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="EXCLS201" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

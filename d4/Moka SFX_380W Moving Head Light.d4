    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Spot" Display="'Spot'" Dmx="5~9" WheelPosition="1" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="2" />

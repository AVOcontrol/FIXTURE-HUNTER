      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="90~99" WheelPosition="3" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="100~109" WheelPosition="4" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="110~119" WheelPosition="5" />

      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="136~143" Update="Effect_Rot" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="144~151" Update="Effect_Rot" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="152~159" Update="Effect_Rot" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="160~167" Update="Effect_Rot" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="168~175" Update="Effect_Rot" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="176~183" Update="Effect_Rot" />
      <Function ID="25" Name="Program 17" Display="'Program 17'" Dmx="184~191" Update="Effect_Rot" />
      <Function ID="26" Name="Program 18" Display="'Program 18'" Dmx="192~199" Update="Effect_Rot" />
      <Function ID="27" Name="Program 19" Display="'Program 19'" Dmx="200~207" Update="Effect_Rot" />
      <Function ID="28" Name="Program 20" Display="'Program 20'" Dmx="208~215" Update="Effect_Rot" />
      <Function ID="29" Name="Program 21" Display="'Program 21'" Dmx="216~223" Update="Effect_Rot" />
      <Function ID="30" Name="Program 22" Display="'Program 22'" Dmx="224~231" Update="Effect_Rot" />
      <Function ID="31" Name="Program 23" Display="'Program 23'" Dmx="232~239" Update="Effect_Rot" />
      <Function ID="32" Name="Program 24" Display="'Program 24'" Dmx="240~247" Update="Effect_Rot" />
      <Function ID="33" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Effect'==33" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKEPPB42" DiamondRef="" WysiwygRef="" />
    <Physical>

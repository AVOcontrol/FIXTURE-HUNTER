  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a85e1823-1527-446b-8a0b-3b97d257da82" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Effect_Rot" />

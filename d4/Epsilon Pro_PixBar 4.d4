      <Function ID="7" Name="RB" Display="'RB'" Dmx="40~47" Update="Effect_Rot" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="48~55" Update="Effect_Rot" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="56~63" Update="Effect_Rot" />

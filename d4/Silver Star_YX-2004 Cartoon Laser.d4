<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="YX-2004 Cartoon Laser" ShortName="SS_YX204CL" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="08-02-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Music" Display="'Music'" Dmx="0~63" Update="Picture, Roll, DotRot, Move, Stretch, Draw_Speed, Size" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="64~127" Update="Picture, Roll, DotRot, Move, Stretch, Draw_Speed, Size" />
      <Function ID="3" Name="Manual (Music)" Display="'Manual (Music)'" Dmx="128~191" Update="Picture, Roll, DotRot, Move, Stretch, Draw_Speed, Size" />
      <Function ID="4" Name="Manual (Auto)" Display="'Manual (Auto)'" Dmx="192~255" Update="Picture, Roll, DotRot, Move, Stretch, Draw_Speed, Size" />
    </Attribute>
    <Attribute ID="Blanking" Name="Blanking" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blanking" Display="'Blanking %.f%%',0~100" Dmx="0~63" Intensity="0~0" />
      <Function ID="2" Name="Fluxion Blanking" Display="'Fluxion Blanking %.f%%',0~100" Dmx="64~127" Intensity="0~0" />
      <Function ID="3" Name="No Blanking" Display="'No Blanking %.f%%',0~100" Dmx="128~191" Intensity="0~0" />
      <Function ID="4" Name="Closed" Display="'Closed %.f%%',0~100" Dmx="192~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Picture" Name="Picture" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Manual" ID="1" If="'Control'&gt;2" />
      <Else ID="2" />
      <Function ID="1" Name="Picture" Display="'Picture %.f',0~85" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Roll" Name="Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Manual" ID="1,2,3,4" If="'Control'&gt;2" />
      <Else ID="5" />
      <Function ID="1" Name="No Roll" Display="'No Roll %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Horizontal" Display="'Horizontal %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Vertical" Display="'Vertical %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Horizontal + Vertical" Display="'Horizontal + Vertical %.f%%',0~100" Dmx="192~255" />
      <Function ID="5" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="DotRot" Name="Dot Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Manual" ID="1,2" If="'Control'&gt;2" />
      <Else ID="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Disabled" Display="'Disabled'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Move" Name="Move" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Manual" ID="1,2,3,4" If="'Control'&gt;2" />
      <Else ID="5" />
      <Function ID="1" Name="No Move" Display="'No Move'" Dmx="0~63" />
      <Function ID="2" Name="Horizontal" Display="'Horizontal %.1f%%',0.0~100.0" Dmx="64~127" />
      <Function ID="3" Name="Vertical" Display="'Vertical %.1f%%',0.0~100.0" Dmx="128~191" />
      <Function ID="4" Name="Horizontal and Vertical" Display="'Horizontal and Vertical %.1f%%',0.0~100.0" Dmx="192~255" />
      <Function ID="5" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Stretch" Name="Stretch" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Manual" ID="1,2,3,4" If="'Control'&gt;2" />
      <Else ID="5" />
      <Function ID="1" Name="No Stretch" Display="'No Stretch'" Dmx="0~63" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Horizontal" Display="'Horizontal %.1f%%',0.0~100.0" Dmx="64~126" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Vertical" Display="'Vertical %.1f%%',0.0~100.0" Dmx="127~191" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Horizontal + Vertical" Display="'Horizontal + Vertical %.1f%%',0.0~100.0" Dmx="192~255" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Disabled" Display="'Disabled'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:11" PowerOn="1:11" />
      <Function ID="1" Name="Speed" Display="'%.f',0~11" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Draw_Speed" Name="Draw Speed" Description="" Group="S">
      <Locate Locate="1:11" PowerOn="1:11" />
      <Condition Name="Manual" ID="1" If="'Control'&gt;2" />
      <Else ID="2" />
      <Function ID="1" Name="Speed" Display="'%.f',0~11" Dmx="0~255" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Manual" ID="1" If="'Control'&gt;2" />
      <Else ID="2" />
      <Function ID="1" Name="Size" Display="'Size %.f',0~25" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="SS_YX204CL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Blanking" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Move" ChannelOffset="6" Wheel="2" />
      <Attribute ID="Picture" ChannelOffset="3" Wheel="14" />
      <Attribute ID="DotRot" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Stretch" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Size" ChannelOffset="10" Wheel="21" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Roll" ChannelOffset="4" Wheel="29" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
      <Attribute ID="Draw_Speed" ChannelOffset="9" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
    </Attribute>
    <Attribute ID="RGB_Colour" Name="RGB Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~45" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~83" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="84~121" Colour="0,0,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="122~159" Colour="255,255,255" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="160~197" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="198~235" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="236~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

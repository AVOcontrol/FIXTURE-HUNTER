<Fixture Name="FR-150W LED" ShortName="FR-150W" Company="Cyclops">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>65586072-6af4-4d5f-9406-0b0e02aaf58a</Thumbnail>
  <History Date="18-07-19" Author="Nic Morris" Comment="Created" />
  <History Date="20-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a215a378-19b0-4f08-9702-cef7d35b97ce" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Speed 0 (no delay)" Display="'Dim Speed 0 (no delay)'" Dmx="0~0" />
      <Function ID="2" Name="Dim Speed 1" Display="'Dim Speed 1'" Dmx="51~100" />
      <Function ID="3" Name="Dim Speed 2" Display="'Dim Speed 2'" Dmx="101~150" />
      <Function ID="4" Name="Dim Speed 3" Display="'Dim Speed 3'" Dmx="151~200" />
      <Function ID="5" Name="Dim Speed 4 (slowest)" Display="'Dim Speed 4 (slowest)'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c867a488-78d3-4132-b4df-bc002801e155" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">

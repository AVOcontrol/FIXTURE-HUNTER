    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2000~13000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Green -" Display="'Green - %.1f%%',100.0~1.0" Dmx="127~1" Colour="0,0,0" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="Green +" Display="'Green + %.1f%%',1.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Sparkle" Name="Sparkle" Description="" Group="E">

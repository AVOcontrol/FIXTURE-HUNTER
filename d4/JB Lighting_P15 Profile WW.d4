    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~5" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="8~9" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="12~13" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="16~17" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="20~21" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="24~25" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="28~29" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="CTB" Display="'CTB'" Dmx="32~33" WheelPosition="8" Colour="200,200,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="2~3" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="6~7" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="10~11" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="14~15" WheelPosition="3" Colour="255,0,255" />
      <Function ID="14" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="18~19" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Org/ D Bl" Display="'Org/ D Bl'" Dmx="22~23" WheelPosition="5" Colour="255,100,0" />
      <Function ID="16" Name="D Bl/ Pk" Display="'D Bl/ Pk'" Dmx="26~27" WheelPosition="6" Colour="0,0,180" />
      <Function ID="17" Name="Pk/ CTB" Display="'Pk/ CTB'" Dmx="30~31" WheelPosition="7" Colour="255,150,150" />
      <Function ID="18" Name="CTB/ Op" Display="'CTB/ Op'" Dmx="34~63" WheelPosition="8" Colour="200,200,255" />
      <Function ID="19" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~223" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />

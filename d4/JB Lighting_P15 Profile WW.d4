  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:45" Delay="3000" />
      <Set Channel="Control:1:8" Delay="0" />
    </Macro>
    <Macro Name="Display Backlight Off">
      <Set Channel="Control:6" Delay="3000" />
      <Set Channel="Control:1:8" Delay="0" />
    </Macro>
    <Macro Name="Display Backlight On">
      <Set Channel="Control:7" Delay="3000" />
      <Set Channel="Control:1:8" Delay="0" />
    </Macro>
    <Macro Name="Display Backlight Auto">
      <Set Channel="Control:8" Delay="3000" />
      <Set Channel="Control:1:8" Delay="0" />
    </Macro>
    <Macro Name="Display Standard">
      <Set Channel="Control:9" Delay="3000" />

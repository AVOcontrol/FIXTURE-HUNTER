    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~35" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="36~71" Colour="255,255,255" />

  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="25~64" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="110~124" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="70~84" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="90~104" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="130~144" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="150~164" />
      <Function ID="9" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="170~184" />
      <Function ID="10" Name="Rnd Burst" Display="'Rnd Burst %.f%%',0~100" Dmx="190~204" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="210~224" />
      <Function ID="12" Name="Sine Pulse" Display="'Sine Pulse %.f%%',0~100" Dmx="230~244" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Cal Auto" Display="'Cal Auto'" Dmx="90~94" />
      <Function ID="3" Name="Cal Manual" Display="'Cal Manual'" Dmx="95~99" />
      <Function ID="4" Name="Cal Off" Display="'Cal Off'" Dmx="100~104" />
      <Function ID="5" Name="Dim Standard" Display="'Dim Standard'" Dmx="110~114" />
      <Function ID="6" Name="Dim Smooth" Display="'Dim Smooth'" Dmx="120~124" />
      <Function ID="7" Name="PWM 600Hz" Display="'PWM 600Hz'" Dmx="130~134" />
      <Function ID="8" Name="PWM 1200Hz" Display="'PWM 1200Hz'" Dmx="135~139" />
      <Function ID="9" Name="PWM 2400Hz" Display="'PWM 2400Hz'" Dmx="140~144" />
      <Function ID="10" Name="PWM 4800Hz" Display="'PWM 4800Hz'" Dmx="145~149" />
      <Function ID="11" Name="Wireless DMX On" Display="'Wireless DMX On'" Dmx="155~159" />
      <Function ID="12" Name="Wireless DMX Off" Display="'Wireless DMX Off'" Dmx="165~169" />

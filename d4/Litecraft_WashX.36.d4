      <Function ID="14" Name="Cal DMX" Display="'Cal DMX'" Dmx="240~244" />
      <Function ID="15" Name="Display On" Display="'Display On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2500~10000" Dmx="10~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~70" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="71~100" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="101~130" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="131~160" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="161~190" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="191~220" />
      <Function ID="9" Name="Auto Cycle" Display="'Auto Cycle'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />

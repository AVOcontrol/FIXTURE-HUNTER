  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-08-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b43b09cc-9ca9-4bf8-8b01-b20ae3513368" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="31~61" Colour="255,255,255" />
      <Function ID="3" Name="Cool White" Display="'Cool White'" Dmx="62~92" Colour="255,255,255" />
      <Function ID="4" Name="Amber" Display="'Amber'" Dmx="93~123" Colour="255,255,255" />
      <Function ID="5" Name="WW+CW" Display="'WW+CW'" Dmx="124~154" Colour="255,255,255" />
      <Function ID="6" Name="WW+A" Display="'WW+A'" Dmx="155~185" Colour="255,255,255" />
      <Function ID="7" Name="CW+A" Display="'CW+A'" Dmx="186~216" Colour="255,255,255" />
      <Function ID="8" Name="WW+CW+A" Display="'WW+CW+A'" Dmx="217~247" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="32~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:3200" PowerOn="1:3200" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',1800~3200" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~26" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="27~43" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="44~60" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="61~76" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="77~93" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="94~110" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="111~126" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="127~143" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="144~160" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="161~176" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="177~193" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="194~210" />
    </Attribute>
    <Attribute ID="Program_Speed" Name="Program Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Fade" Name="Program Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

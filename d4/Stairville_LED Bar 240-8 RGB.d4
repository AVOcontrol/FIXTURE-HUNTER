<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Bar 240-8 RGB" ShortName="LED Bar248" Company="Stairville">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="30-10-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="08-04-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5c716e29-51c4-4817-8f2f-857297406c8f" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="3" Name="Red+Green" Display="'Red+Green'" Dmx="16~23" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="5" Name="Green+Blue" Display="'Green+Blue'" Dmx="32~39" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="40~47" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="7" Name="Blue+Red" Display="'Blue+Red'" Dmx="48~55" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="56~63" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="9" Name="Auto" Display="'Auto %.f',64~231" Dmx="64~231" Update="Macro_Control" Colour="255,255,255" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="232~255" Update="Macro_Control" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro_Control" Name="Macro Control" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Condition Name="Speed" ID="1" If="'Colour_Macro'==9" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==10" />
      <Else ID="3" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~255.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~255.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="''" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="SVLB2482" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="67cd1900-573f-44d0-8873-8e0d19e69466" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Macro_Control" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SVLB2483" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

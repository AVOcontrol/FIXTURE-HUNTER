  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Speed/Time" Display="'Speed/Time %.1f%%',0.0~100.0" Dmx="255~1" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="RGB mode" Display="'RGB mode'" Dmx="30~39" />
      <Function ID="5" Name="CMY mode" Display="'CMY mode'" Dmx="40~49" />
      <Function ID="6" Name="P/T Speed mode" Display="'P/T Speed mode'" Dmx="50~59" />
      <Function ID="7" Name="P/T Time mode" Display="'P/T Time mode'" Dmx="60~69" />
      <Function ID="8" Name="Move in Dark ENABLE" Display="'Move in Dark ENABLE'" Dmx="70~79" />
      <Function ID="9" Name="Move in Dark DISABLE" Display="'Move in Dark DISABLE'" Dmx="80~89" />
      <Function ID="10" Name="Reset No P/T" Display="'Reset No P/T'" Dmx="130~139" />
      <Function ID="11" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="12" Name="Reset Beam" Display="'Reset Beam'" Dmx="180~189" />
      <Function ID="13" Name="Reset Beam Trimmer" Display="'Reset Beam Trimmer'" Dmx="190~199" />
      <Function ID="14" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="15" Name="Disable Theatre Mode" Display="'Disable Theatre Mode'" Dmx="240~240" />
      <Function ID="16" Name="Theatre Mode Auto" Display="'Theatre Mode Auto'" Dmx="241~241" />
      <Function ID="17" Name="Theatre Mode Fan" Display="'Theatre Mode Fan %.f%%',0~100" Dmx="242~255" />
      <Function ID="18" Name="Reserved" Display="'Reserved %.f',20~29" Dmx="20~29" />
      <Function ID="19" Name="Reserved" Display="'Reserved %.f',90~129" Dmx="90~129" />
      <Function ID="20" Name="Reserved" Display="'Reserved %.f',150~179" Dmx="150~179" />
      <Function ID="21" Name="Reserved" Display="'Reserved'" Dmx="210~239" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="White" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Fixed" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="24,25,26" If="'Colour1Func'==4" />
      <Else ID="27" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="0,0,0" />
      <Function ID="3" Name="2700K (Halogen)" Display="'2700K (Halogen)'" Dmx="3~3" Colour="0,0,0" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="0,0,0" />
      <Function ID="5" Name="3200K (Halogen)" Display="'3200K (Halogen)'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="0,0,0" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="0,0,0" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="0,0,0" />
      <Function ID="9" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,0" />
      <Function ID="11" Name="Lt Blue" Display="'Lt Blue'" Dmx="56~56" Colour="0,0,0" />
      <Function ID="12" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,0,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="0,0,0" />
      <Function ID="14" Name="Red" Display="'Red'" Dmx="175~175" Colour="0,0,0" />
      <Function ID="15" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="0,0,0" />
      <Function ID="16" Name="Blue" Display="'Blue'" Dmx="247~247" Colour="0,0,0" />
      <Function ID="17" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Blue + Green%" Display="'Blue + Green %.f%%',0~100" Dmx="17~55" Colour="0,0,0" />
      <Function ID="19" Name="Green - Blue %" Display="'Green - Blue %.f%%',0~100" Dmx="57~95" Colour="0,0,0" />
      <Function ID="20" Name="Green + Red %" Display="'Green + Red %.f%%',0~100" Dmx="97~134" Colour="0,0,0" />
      <Function ID="21" Name="Red - Green %" Display="'Red - Green %.f%%',0~100" Dmx="136~174" Colour="0,0,0" />
      <Function ID="22" Name="Red + Blue %" Display="'Red + Blue %.f%%',0~100" Dmx="176~214" Colour="0,0,0" />
      <Function ID="23" Name="Blue - Red %" Display="'Blue - Red %.f%%',0~100" Dmx="216~246" Colour="0,0,0" />
      <Function ID="24" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="25" Name="Scroll + Fade" Display="'Scroll + Fade %.f/4',1~4" Dmx="248~251" Colour="0,0,0" />
      <Function ID="26" Name="Scroll" Display="'Scroll %.f/4',1~4" Dmx="252~255" Colour="0,0,0" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Update="Colour_Macro" Colour="0,0,0" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour_Macro" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour_Macro" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour_Macro" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour_Macro" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

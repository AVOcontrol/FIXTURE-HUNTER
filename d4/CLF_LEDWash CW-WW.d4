<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LEDWash CW-WW" ShortName="Wash CW-WW" Company="CLF">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="13-05-14" Author="Nic Morris" Comment="Created" />
  <History Date="28-06-14" Author="Nic Morris" Comment="Adjusted shutter and CTO ranges in response to distributor bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c65adfa6-7d36-4928-b498-68e1f2b8a897" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cool_White" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="White 1" Display="'White 1'" Dmx="11~40" Colour="255,255,255" />
      <Function ID="3" Name="White 2" Display="'White 2'" Dmx="41~70" Colour="255,255,255" />
      <Function ID="4" Name="White 3" Display="'White 3'" Dmx="71~100" Colour="255,255,255" />
      <Function ID="5" Name="White 4" Display="'White 4'" Dmx="101~130" Colour="255,255,255" />
      <Function ID="6" Name="White 5" Display="'White 5'" Dmx="131~160" Colour="255,255,255" />
      <Function ID="7" Name="White 6" Display="'White 6'" Dmx="161~190" Colour="255,255,255" />
      <Function ID="8" Name="White 7" Display="'White 7'" Dmx="191~220" Colour="255,255,255" />
      <Function ID="9" Name="White 8" Display="'White 8'" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~9" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="UKCLFWW7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c686817a-359a-4c0b-85ae-36b91839b2c4" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Cool_White" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Warm_White" ChannelOffset="3" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Dim_Speed" ChannelOffset="6" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCLFWW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7a16e179-27a2-4e0a-9379-fe3b60f05a38" />

      <Function ID="6" Name="Col Change" Display="'Col Change'" Dmx="131~170" />
      <Function ID="7" Name="Col Fade" Display="'Col Fade'" Dmx="171~210" />
      <Function ID="8" Name="Auto" Display="'Auto'" Dmx="211~250" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

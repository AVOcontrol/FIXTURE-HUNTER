  <History Date="04-12-15" Author="Nic Morris" Comment="Created" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="30~39" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="40~49" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="50~59" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="60~69" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="70~79" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="80~89" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="90~99" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="100~109" />
      <Function ID="12" Name="Program 1" Display="'Program 1'" Dmx="110~119" />
      <Function ID="13" Name="Program 2" Display="'Program 2'" Dmx="120~129" />
      <Function ID="14" Name="Program 3" Display="'Program 3'" Dmx="130~139" />
      <Function ID="15" Name="Program 4" Display="'Program 4'" Dmx="140~149" />
      <Function ID="16" Name="Program 5" Display="'Program 5'" Dmx="150~159" />
      <Function ID="17" Name="Program 6" Display="'Program 6'" Dmx="160~169" />
      <Function ID="18" Name="Program 7" Display="'Program 7'" Dmx="170~179" />
      <Function ID="19" Name="Program 8" Display="'Program 8'" Dmx="180~189" />
      <Function ID="20" Name="Program 9" Display="'Program 9'" Dmx="190~199" />
      <Function ID="21" Name="Program 10" Display="'Program 10'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="50~99" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="100~149" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="150~199" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="STAG, 11 DMX" Channels="11">
    <Import PearlRef="UKVT1881" DiamondRef="" WysiwygRef="" />

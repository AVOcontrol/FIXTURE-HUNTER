  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." Version="3" />
  <History Date="11-07-17" Author="Nic Morris" Comment="Changed RGB masters to power on and locate at zero in attempt to fix customer bug report." Version="4" />
  <History Date="07-03-20" Author="Nic Morris" Comment="Added product thumbnail.  Inverted zoom display range in response to customer feedback (documentation is wrong)" Version="5" />
  <History Date="07-03-20" Author="Nic Morris" Comment="Fixed display name." Version="5" />
  <History Date="16-02-22" Author="Nic Morris" Comment="Updated in line with latest documentation (adds Single Tour mode, renames Gobo and revises BG Col Macro ranges).  Added vdim to Single Standard and Single Advanced mode cells." Version="6" />
  <History Date="29-04-24" Author="Nic Morris" Comment="Added RDM ID's (note personality IDs not provided - single basic and movement standard both have identical channel counts and therefore probably won't work discover correctly)" Version="8" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Fireball 4x4" ShortName="Firebl 4x4" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="07-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~22" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="23~37" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="38~52" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="53~67" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="68~82" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="83~97" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="98~112" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="113~127" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="128~142" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="143~157" />
      <Function ID="12" Name="Show 11" Display="'Show 11'" Dmx="158~172" />
      <Function ID="13" Name="Show 12" Display="'Show 12'" Dmx="173~187" />
      <Function ID="14" Name="Show 13" Display="'Show 13'" Dmx="188~202" />
      <Function ID="15" Name="Show 14" Display="'Show 14'" Dmx="203~217" />
      <Function ID="16" Name="Show 15" Display="'Show 15'" Dmx="218~232" />
      <Function ID="17" Name="Show 16" Display="'Show 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="LHFB4X41" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="20~39" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="40~59" />
      <Function ID="4" Name="Fan Auto " Display="'Fan Auto'" Dmx="60~79" />
      <Function ID="5" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="6" Name="Fan Normal" Display="'Fan Normal'" Dmx="100~119" />
      <Function ID="7" Name="Fan Fast" Display="'Fan Fast'" Dmx="120~139" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="140~149" />
      <Function ID="9" Name="Auto 2 " Display="'Auto 2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="180~189" />
      <Function ID="13" Name="Sound 2" Display="'Sound 2'" Dmx="190~199" />
      <Function ID="14" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="15" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="16" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="17" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="18" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="19" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
  </Control>

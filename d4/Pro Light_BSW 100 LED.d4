      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~55" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="56~105" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="106~155" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="156~205" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset no P/T" Display="'Reset no P/T'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

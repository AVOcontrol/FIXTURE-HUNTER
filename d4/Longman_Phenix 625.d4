    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="21~30" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="31~40" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Square Smooth" Display="'Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Inv Square Smooth" Display="'Inv Square Smooth'" Dmx="71~80" />
      <Function ID="9" Name="S-Curve Smooth" Display="'S-Curve Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Preset" Display="'Preset'" Dmx="91~255" />
    </Attribute>
    <Attribute ID="ID_Function" Name="ID Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable" Display="'Disable'" Dmx="0~0" />
      <Function ID="2" Name="Enable" Display="'Enable'" Dmx="10~20" />
      <Function ID="3" Name="Div 10 Enable" Display="'Div 10 Enable'" Dmx="21~30" />
    </Attribute>
    <Attribute ID="ID_Address" Name="ID Address" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

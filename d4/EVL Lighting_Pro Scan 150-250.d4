  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5,Control1:4" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:10,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="3" Name="Dark Yellow" Number="3" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="4" Name="Dark Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="5" Name="Dark Yellow" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour11:1,Colour1Func:1" />

      <Palette ID="10" Name="Light Blue" Number="7" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour11:3,Colour1Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:10,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour11:1,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour11:3,Colour1Func:1,Colour1:1,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a456e457-4db7-4dfb-b795-099bd4977e41" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Maximum" Display="'Maximum'" Dmx="128~247" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Pan_FPR" Name="Pan FPR" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="540° (Standard Path)" Display="'540° (Standard Path)'" Dmx="0~0" />
      <Function ID="2" Name="360° (1 Turn)" Display="'360° (1 Turn)'" Dmx="11~20" />
      <Function ID="3" Name="720° (2 Turns)" Display="'720° (2 Turns)'" Dmx="21~30" />
      <Function ID="4" Name="1080° (3 Turns)" Display="'1080° (3 Turns)'" Dmx="31~40" />
      <Function ID="5" Name="1440° (4 Turns)" Display="'1440° (4 Turns)'" Dmx="41~50" />
      <Function ID="6" Name="1800° (5 Turns)" Display="'1800° (5 Turns)'" Dmx="51~60" />
      <Function ID="7" Name="2160° (6 Turns)" Display="'2160° (6 Turns)'" Dmx="61~70" />
      <Function ID="8" Name="2520° (7 Turns)" Display="'2520° (7 Turns)'" Dmx="71~80" />
      <Function ID="9" Name="2880° (8 Turns)" Display="'2880° (8 Turns)'" Dmx="81~90" />
      <Function ID="10" Name="3240° (9 Turns)" Display="'3240° (9 Turns)'" Dmx="91~100" />
      <Function ID="11" Name="3600° (10 Turns)" Display="'3600° (10 Turns)'" Dmx="101~110" />
      <Function ID="12" Name="360° (Smart Path)" Display="'360° (Smart Path)'" Dmx="111~120" />
      <Function ID="13" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="121~182" />
      <Function ID="14" Name="No Spin" Display="'No Spin'" Dmx="183~193" />
      <Function ID="15" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="180~204" Intensity="0~0" />
      <Function ID="5" Name="Rnd Ind" Display="'Rnd Ind %.f%%',0~100" Dmx="205~229" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="120~149" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="150~179" Intensity="0~0" />

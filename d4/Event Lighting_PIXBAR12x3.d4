      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="4 Col Switch" Display="'4 Col Switch'" Dmx="10~29" />
      <Function ID="3" Name="15 Col Switch" Display="'15 Col Switch'" Dmx="30~50" />
      <Function ID="4" Name="Macro" Display="'Macro'" Dmx="51~71" />
      <Function ID="5" Name="Auto 1" Display="'Auto 1'" Dmx="72~92" />
      <Function ID="6" Name="Auto 2" Display="'Auto 2'" Dmx="93~113" />
      <Function ID="7" Name="Auto 3" Display="'Auto 3'" Dmx="114~134" />
      <Function ID="8" Name="Auto 4" Display="'Auto 4'" Dmx="135~155" />
      <Function ID="9" Name="Auto 5" Display="'Auto 5'" Dmx="156~176" />
      <Function ID="10" Name="Auto 6" Display="'Auto 6'" Dmx="177~197" />
      <Function ID="11" Name="Auto 7" Display="'Auto 7'" Dmx="198~218" />
      <Function ID="12" Name="Auto 8" Display="'Auto 8'" Dmx="219~239" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

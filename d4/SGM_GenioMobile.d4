    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~3" />
      <Function ID="2" Name="Speed" Display="'Speed %.f Sec',243~7" Dmx="4~219" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1 %.f Sec',6~6" Dmx="220~223" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2 %.f Sec',5~5" Dmx="224~227" />

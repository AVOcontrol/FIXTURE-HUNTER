      <Function ID="3" Name="CCT" Display="'CCT %.f%%',0~100" Dmx="206~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

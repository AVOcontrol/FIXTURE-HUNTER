  <Thumbnail>053d90d2-6d46-4d3e-b2ed-7a430bfdd36c</Thumbnail>
  <History Date="17-10-23" Author="Nic Morris" Comment="Created (colour functions don't make any sense - they suggest that the colour ranges can be two things at once which is impossible.  the implementation appears to be flawed.  left colour as raw for now)" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e1fb7438-7941-4637-aed6-2d362b7552e7" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="F3" Display="'F3'" Dmx="16~16" Colour="255,255,255" />
      <Function ID="3" Name="F4" Display="'F4'" Dmx="32~32" Colour="255,255,255" />
      <Function ID="4" Name="F5" Display="'F5'" Dmx="48~48" Colour="255,255,255" />
      <Function ID="5" Name="F1" Display="'F1'" Dmx="64~64" Colour="255,255,255" />
      <Function ID="6" Name="F1+F3" Display="'F1+F3'" Dmx="80~80" Colour="255,255,255" />
      <Function ID="7" Name="F1+F4" Display="'F1+F4'" Dmx="96~96" Colour="255,255,255" />
      <Function ID="8" Name="F1+F5" Display="'F1+F5'" Dmx="112~112" Colour="255,255,255" />
      <Function ID="9" Name="F2" Display="'F2'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="10" Name="F2+F3" Display="'F2+F3'" Dmx="144~144" Colour="255,255,255" />
      <Function ID="11" Name="F2+F4" Display="'F2+F4'" Dmx="160~160" Colour="255,255,255" />
      <Function ID="12" Name="F2+F5" Display="'F2+F5'" Dmx="176~176" Colour="255,255,255" />
      <Function ID="13" Name="F1+F2" Display="'F1+F2'" Dmx="192~192" Colour="255,255,255" />
      <Function ID="14" Name="F1, F2 + F3" Display="'F1, F2 + F3'" Dmx="208~208" Colour="255,255,255" />
      <Function ID="15" Name="F1, F2 + F4" Display="'F1, F2 + F4'" Dmx="224~224" Colour="255,255,255" />
      <Function ID="16" Name="F1, F2 + F5" Display="'F1, F2 + F5'" Dmx="240~240" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Lens_Effects" Name="Lens Effects" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Wide Angle Filter" Display="'Wide Angle Filter'" Dmx="64~64" />
      <Function ID="3" Name="Narrow Horizontal Shaping" Display="'Narrow Horizontal Shaping'" Dmx="128~128" />
      <Function ID="4" Name="Wide Vertical Shaping" Display="'Wide Vertical Shaping'" Dmx="192~192" />
    </Attribute>
    <Attribute ID="Frost_Effects" Name="Frost Effects" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="64~64" />
      <Function ID="3" Name="Narrow Vertical Shaping" Display="'Narrow Vertical Shaping'" Dmx="128~128" />
      <Function ID="4" Name="Wide Horizontal Shaping" Display="'Wide Horizontal Shaping'" Dmx="192~192" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~127" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="128~247" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="MSpeed" Name="MSpeed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" />
      <Function ID="2" Name="Controller Crossfade" Display="'Controller Crossfade'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="64~64" />
      <Function ID="3" Name="Shutdown" Display="'Shutdown'" Dmx="128~128" />
    </Attribute>
    <Attribute ID="Checksum" Name="Checksum" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="0541d3c7-9044-418a-8bf4-c2462bf8b114">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="21bd03d5-0ad8-46e2-bf81-502ae12d6a01" />
    <Include>
      <Attribute ID="Colour1Func" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Lens_Effects" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Frost_Effects" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="MSpeed" ChannelOffset="10" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
      <Attribute ID="Checksum" ChannelOffset="12" Wheel="29" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Shutdown">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:4:100" />
      <Palette ID="8" Name="Closed" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="053d90d2-6d46-4d3e-b2ed-7a430bfdd36c"></Swatch>

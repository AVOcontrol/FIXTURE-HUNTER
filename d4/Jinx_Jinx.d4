<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Jinx" ShortName="Jinx" Company="Jinx">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="31-08-17" Author="Sebastian Beutel" Comment="Created" />
  <History Date="04-09-17" Author="Nic Morris" Comment="Added limit 32 functions.  Minor revisions to DMX ranges." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Scene_Left" Name="Scene Left" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Scene" Display="'Scene %.f',1~255" Dmx="1~255" />
      <Function ID="3" Name="Limit 32" Display="'Limit 32 %.f',1~32" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Scene_Right" Name="Scene Right" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Scene" Display="'Scene %.f',1~255" Dmx="1~255" />
      <Function ID="3" Name="Limit 32" Display="'Limit 32 %.f',1~32" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Chase_Sel" Name="Chase Sel" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.f',1~255" Dmx="1~255" />
      <Function ID="3" Name="Limit 32" Display="'Limit 32 %.f',1~32" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Cross_Mode" Name="Cross Mode" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Progressive" Display="'Progressive'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="21~41" WheelPosition="1" />
      <Function ID="3" Name="Left Shape" Display="'Left Shape'" Dmx="42~62" WheelPosition="2" />
      <Function ID="4" Name="Right Shape" Display="'Right Shape'" Dmx="63~83" WheelPosition="3" />
      <Function ID="5" Name="Left Int." Display="'Left Int.'" Dmx="84~104" WheelPosition="4" />
      <Function ID="6" Name="Right Int." Display="'Right Int.'" Dmx="105~125" WheelPosition="5" />
      <Function ID="7" Name="Left Overlay" Display="'Left Overlay'" Dmx="126~146" WheelPosition="6" />
      <Function ID="8" Name="Right Overlay" Display="'Right Overlay'" Dmx="147~167" WheelPosition="7" />
      <Function ID="9" Name="L. Over. Border" Display="'L. Over. Border'" Dmx="168~188" WheelPosition="8" />
      <Function ID="10" Name="R. Over. Border" Display="'R. Over. Border'" Dmx="189~209" WheelPosition="9" />
      <Function ID="11" Name="Move L/R" Display="'Move L/R'" Dmx="210~230" WheelPosition="5" />
      <Function ID="12" Name="Move U/D" Display="'Move U/D'" Dmx="231~255" WheelPosition="6" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="G">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="255~1" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 7 DMX" Channels="7">
    <Import PearlRef="UKJXJINX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Scene_Left" ChannelOffset="1" Wheel="13" />
      <Attribute ID="Scene_Right" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Chase_Sel" ChannelOffset="3" Wheel="17" />
      <Attribute ID="Cross_Mode" ChannelOffset="4" Wheel="15" />
      <Attribute ID="Crossfade" ChannelOffset="5" Wheel="18" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
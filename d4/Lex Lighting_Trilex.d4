      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt1" Name="Tilt 2" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt2" Name="Tilt 3" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="UK_LXTrilex" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Tilt1" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Tilt2" ChannelOffset="3" Wheel="6" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Colour11" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Colour12" ChannelOffset="7" Wheel="9" />
      <Attribute ID="PT_Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
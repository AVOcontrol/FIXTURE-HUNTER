  <History Date="03-09-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="17" />
  <History Date="07-09-21" Author="Nic Morris" Comment="Added missing Ext.Kelvin Single Pixel mode Atlabase IDs." Version="18" />

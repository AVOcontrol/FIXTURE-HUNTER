  <Thumbnail>3f75b7f7-8642-4702-9d76-09d9c2787fee</Thumbnail>
  <History Date="12-07-13" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Removed colour index functions at manufacturer request and changed prism to locate at zero in attempt to fix bug report." Version="2" />
  <History Date="14-04-16" Author="Nic Morris" Comment="Added missing Raw DMX option from Gobo 1 Func in response to manufacturer bug report." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="4" />
  <History Date="29-06-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Increased 16bit wheel resolution.  Fixed 16bit raw display range." Version="5" />
  <History Date="29-06-17" Author="Nic Morris" Comment="Standardised Gobo 1 conditionals.  Renamed gobo index functions to show their transition more accurately." Version="6" />
  <History Date="29-06-17" Author="Nic Morris" Comment="Standardised shutter." Version="7" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added colour function names, swatches, palettes and highlight/lowlight." Version="8" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." Version="9" />
  <History Date="31-12-17" Author="Nic Morris" Comment="Added gobo swatches" Version="10" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="11" />
  <Manual Filename="" Summary="" />

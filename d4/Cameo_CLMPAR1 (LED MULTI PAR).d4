<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CLMPAR1 (LED MULTI PAR)" ShortName="CLMPAR1" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="16-11-14" Author="Nic Morris" Comment="Created" />
  <History Date="19-09-17" Author="Nic Morris" Comment="Created from CLMPAR2 (identical)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="2" Name="RGB Mix" Display="'RGB Mix'" Dmx="11~21" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~32" Update="Dimmer, Red" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="33~43" Update="Dimmer, Red" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="44~54" Update="Dimmer, Red" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="55~65" Update="Dimmer, Red" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="66~76" Update="Dimmer, Red" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="77~87" Update="Dimmer, Red" Colour="128,0,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="88~98" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="10" Name="Dream" Display="'Dream'" Dmx="99~109" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="11" Name="Meteor" Display="'Meteor'" Dmx="110~120" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="12" Name="Fade" Display="'Fade'" Dmx="121~131" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="13" Name="Change" Display="'Change'" Dmx="132~142" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="14" Name="Flow 1" Display="'Flow 1'" Dmx="143~153" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="15" Name="Flow 2" Display="'Flow 2'" Dmx="154~164" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="16" Name="Flow 3" Display="'Flow 3'" Dmx="165~175" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="17" Name="Flow 4" Display="'Flow 4'" Dmx="176~186" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="18" Name="Flow 5" Display="'Flow 5'" Dmx="187~197" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="19" Name="Flow 6" Display="'Flow 6'" Dmx="198~208" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="20" Name="Flow 7" Display="'Flow 7'" Dmx="209~219" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="21" Name="Flow 8" Display="'Flow 8'" Dmx="220~230" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="22" Name="Flow 9" Display="'Flow 9'" Dmx="231~241" Update="Dimmer, Red" Colour="255,255,255" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="242~255" Update="Dimmer, Red" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;9" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Select" ID="2" If="'Colour_Macro'==21||'Colour_Macro'==22" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Col Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="UKCMMP11" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
  <AtlaBase TypeID="e318c7b4-bb3e-4d90-ac36-860eab7fda39" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Pan FW" Display="'Pan FW'" Dmx="32~47" />
      <Function ID="4" Name="Pan REV" Display="'Pan REV'" Dmx="48~63" />
      <Function ID="5" Name="Tilt FW" Display="'Tilt FW'" Dmx="64~79" />
      <Function ID="6" Name="Tilt REV" Display="'Tilt REV'" Dmx="80~95" />
      <Function ID="7" Name="P/T FW" Display="'P/T FW'" Dmx="96~111" />
      <Function ID="8" Name="P/T REV" Display="'P/T REV'" Dmx="112~127" />
      <Function ID="9" Name="Pan FW/ Tilt REV" Display="'Pan FW/ Tilt REV'" Dmx="128~143" />
      <Function ID="10" Name="Pan REV/ Tilt FW" Display="'Pan REV/ Tilt FW'" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FWD" Display="'Pulse FWD'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
      <Function ID="5" Name="Effect" Display="'Effect'" Dmx="64~95" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="6" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="32~47" />
      <Function ID="7" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="48~63" />
      <Function ID="8" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="96~111" />
      <Function ID="9" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="112~127" />
      <Function ID="10" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="160~175" />
      <Function ID="11" Name="Effect 6" Display="'Effect 6 %.f%%',0~100" Dmx="176~191" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="14:0" PowerOn="14:0" />
      <Condition Name="CTC" ID="1,2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Speed" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="8,9,10,11,12,13" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="14" />
      <Function ID="1" Name="2000-2700K" Display="'2000-2700K %.1f%%',0.0~100.0" Dmx="0~155" Colour="255,255,255" />
      <Function ID="2" Name="2700-3200K" Display="'2700-3200K'" Dmx="156~175" Colour="255,255,255" />
      <Function ID="3" Name="3200-4200K" Display="'3200-4200K'" Dmx="176~195" Colour="255,255,255" />
      <Function ID="4" Name="4200-5600K" Display="'4200-5600K'" Dmx="196~215" Colour="255,255,255" />
      <Function ID="5" Name="5600-8000K" Display="'5600-8000K'" Dmx="216~235" Colour="255,255,255" />
      <Function ID="6" Name="8000-10000K" Display="'8000-10000K'" Dmx="235~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="8" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="13" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

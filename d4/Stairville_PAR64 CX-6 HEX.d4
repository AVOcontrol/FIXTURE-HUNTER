    </Physical>
    <AtlaBase ModeID="a467629a-901d-431b-b71f-54f56bc74690" />
    <Include>
      <Attribute ID="Auto1" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="6" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="UV" ChannelOffset="7" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0c62f158-e19d-4531-bb88-8e91a33c6d16" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="41" />
      <Attribute ID="UV" ChannelOffset="6" Wheel="42" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>

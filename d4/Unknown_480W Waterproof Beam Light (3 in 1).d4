      <Function ID="19" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="90~94" WheelPosition="7" />
      <Function ID="20" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="95~99" WheelPosition="8" />
      <Function ID="21" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="100~104" WheelPosition="9" />
      <Function ID="22" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="105~109" WheelPosition="10" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="24" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~183" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="26" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="182~110" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="80~89" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="90~99" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="100~109" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="110~119" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="120~129" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="130~139" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="140~149" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="201~255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="150~200" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="188~195" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~187" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="188~195" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="196~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Small Motor" Display="'Reset Small Motor'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="10~100" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="101~255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18" Id="fce018bc-ded1-4672-965a-17843ee6152f">

    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" VirtualControl="Dimmer" />

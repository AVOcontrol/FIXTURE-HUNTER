  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0e3af379-2d70-4b18-9f61-70dea9d42407" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="5:100" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red C-Mix" Display="'Red C-Mix %.f%%',0~100" Dmx="4~66" Colour="255,0,0" />
      <Function ID="3" Name="Green C-Mix" Display="'Green C-Mix %.f%%',0~100" Dmx="67~129" Colour="0,255,0" />
      <Function ID="4" Name="Blue C-Mix" Display="'Blue C-Mix %.f%%',0~100" Dmx="130~192" Colour="0,0,255" />
      <Function ID="5" Name="White C-Mix" Display="'White C-Mix %.f%%',0~100" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Spot_Strobe" Name="Spot Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~240" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="1~80" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="81~160" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Strobe_FX" Name="Strobe FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="1~25" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="26~51" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="52~77" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="78~103" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="104~129" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="130~155" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="156~181" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="182~207" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="208~233" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Strobe_FX_Spd" Name="Strobe FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red On" Display="'Red On'" Dmx="10~49" />
      <Function ID="3" Name="Green On" Display="'Green On'" Dmx="50~89" />
      <Function ID="4" Name="Red+Green On" Display="'Red+Green On'" Dmx="90~129" />
      <Function ID="5" Name="Red On+Green Flash" Display="'Red On+Green Flash'" Dmx="130~169" />
      <Function ID="6" Name="Red Flash+Green On" Display="'Red Flash+Green On'" Dmx="170~209" />
      <Function ID="7" Name="Red+Green Flash" Display="'Red+Green Flash'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Spot" Display="'Spot'" Dmx="6~41" />
      <Function ID="3" Name="Laser" Display="'Laser'" Dmx="42~77" />
      <Function ID="4" Name="Strobe" Display="'Strobe'" Dmx="78~113" />
      <Function ID="5" Name="Spot+Laser" Display="'Spot+Laser'" Dmx="114~149" />
      <Function ID="6" Name="Spot+Strobe" Display="'Spot+Strobe'" Dmx="150~185" />
      <Function ID="7" Name="Laser+Strobe" Display="'Laser+Strobe'" Dmx="186~221" />
      <Function ID="8" Name="Spot+Strobe+Laser" Display="'Spot+Strobe+Laser'" Dmx="222~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~255" GoboSpin="0~0" GoboOrientation="0~0" />

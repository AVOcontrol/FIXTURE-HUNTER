      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="6~15" WheelPosition="1" Colour="255,255,0" />

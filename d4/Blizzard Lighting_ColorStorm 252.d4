      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Col Macro" Display="'Col Macro'" Dmx="0~0" Update="Mode_Func" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="18~35" Update="Mode_Func" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="36~53" Update="Mode_Func" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="54~71" Update="Mode_Func" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="72~89" Update="Mode_Func" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="90~107" Update="Mode_Func" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="108~125" Update="Mode_Func" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="126~143" Update="Mode_Func" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="144~161" Update="Mode_Func" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="162~179" Update="Mode_Func" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="180~197" Update="Mode_Func" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="198~215" Update="Mode_Func" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="216~233" Update="Mode_Func" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Mode_Func" />
    </Attribute>
    <Attribute ID="Mode_Func" Name="Mode Func" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;14" />
      <Condition Name="Sensitivity" ID="3" If="'Mode'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Macro" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED DMX Tube" ShortName="LED Tube" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="05-12-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~13" Update="Red, Green, Blue" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="14~27" Update="Red, Green, Blue" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="28~41" Update="Red, Green, Blue" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="42~55" Update="Red, Green, Blue" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="56~69" Update="Red, Green, Blue" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="70~83" Update="Red, Green, Blue" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="84~97" Update="Red, Green, Blue" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="98~111" Update="Red, Green, Blue" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="112~125" Update="Red, Green, Blue" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="126~139" Update="Red, Green, Blue" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="140~153" Update="Red, Green, Blue" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="154~167" Update="Red, Green, Blue" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="168~181" Update="Red, Green, Blue" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="182~195" Update="Red, Green, Blue" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="196~209" Update="Red, Green, Blue" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="210~223" Update="Red, Green, Blue" />
      <Function ID="17" Name="Auto" Display="'Auto'" Dmx="224~237" Update="Red, Green, Blue" />
      <Function ID="18" Name="Sound 1-step" Display="'Sound 1-step'" Dmx="238~251" Update="Red, Green, Blue" />
      <Function ID="19" Name="Sound 5-sec" Display="'Sound 5-sec'" Dmx="252~255" Update="Red, Green, Blue" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Program'&gt;1&amp;&amp;'Program'&lt;18" />
      <Condition Name="Sensitivity" ID="3,4" If="'Program'&gt;17" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="4" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Strobe" ID="2,3" If="'Program'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Color Sort" ID="2" If="'Program'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Color Sort" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="EXDMXTUB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Program" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
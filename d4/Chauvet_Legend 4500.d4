  <History Date="08-04-09" Author="Jonathan Moreton" Comment="Created from Chauvet Legend 6500" />
  <History Date="08-04-09" Author="David Hunt" Comment="Checked" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Fixed wheel mapping in response to bug report.  Revised mode names with channel counts." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Revised colour macro functions from fixed functions to variable index range.  Inverted P/T speed." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1eb8a33f-58ca-47c3-96bd-387a1a1c5d37" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~165" Colour="0,0,0" />
      <Function ID="3" Name="RGB Full" Display="'RGB Full'" Dmx="191~200" Colour="0,0,0" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="White 9500K" Display="'White 9500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="20~39" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="40~59" />
      <Function ID="4" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="5" Name="Fan Normal" Display="'Fan Normal'" Dmx="100~119" />
      <Function ID="6" Name="Fan Fast" Display="'Fan Fast'" Dmx="120~139" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="150~159" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="160~169" />
      <Function ID="9" Name="Test" Display="'Test'" Dmx="170~179" />
      <Function ID="10" Name="Custom" Display="'Custom'" Dmx="180~189" />
      <Function ID="11" Name="Reset" Display="'Reset'" Dmx="200~219" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 10 DMX" Channels="10">
    <Import PearlRef="CH_leg4500B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6a0ee4f5-367f-40dc-a44d-4d4e192ffdef" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Advanced, 14 DMX" Channels="14">
    <Import PearlRef="CH_leg4500A" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6b3a1865-9359-46fd-bcd2-ae74a4068412" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="10" Wheel="8" />
      <Attribute ID="Dim_Speed" ChannelOffset="13" Wheel="26" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Auto 1">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Auto 2">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Test">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Custom">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

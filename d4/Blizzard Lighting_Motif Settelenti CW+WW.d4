  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d3698126-3d3b-484b-88f5-cbb7376b5671" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Wash CW" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Wash WW" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Wash_White_Mac" Name="Wash White Mac" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2600K" Display="'2600K'" Dmx="10~31" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="32~53" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="54~75" Colour="255,255,255" />
      <Function ID="5" Name="3800K" Display="'3800K'" Dmx="76~97" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="98~119" Colour="255,255,255" />
      <Function ID="7" Name="4600K" Display="'4600K'" Dmx="120~141" Colour="255,255,255" />
      <Function ID="8" Name="5000K" Display="'5000K'" Dmx="142~163" Colour="255,255,255" />
      <Function ID="9" Name="5400K" Display="'5400K'" Dmx="164~185" Colour="255,255,255" />
      <Function ID="10" Name="5800K" Display="'5800K'" Dmx="186~207" Colour="255,255,255" />
      <Function ID="11" Name="6200K" Display="'6200K'" Dmx="208~229" Colour="255,255,255" />
      <Function ID="12" Name="6500K" Display="'6500K'" Dmx="230~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~37" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="38~65" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="66~93" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="94~121" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="122~149" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="150~177" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="178~205" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="206~233" />
      <Function ID="10" Name="Auto 1-8" Display="'Auto 1-8'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="SMD Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="SMD Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="SMD Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="SMD_Col_Macro" Name="SMD Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~10" Colour="255,0,0" />
      <Function ID="3" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="11~49" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="50~50" Colour="255,255,0" />
      <Function ID="5" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="51~89" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="90~90" Colour="0,255,0" />
      <Function ID="7" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="91~129" Colour="0,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="130~130" Colour="0,255,255" />
      <Function ID="9" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="131~169" Colour="0,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="170~170" Colour="0,0,255" />
      <Function ID="11" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="171~209" Colour="0,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="210~210" Colour="255,0,255" />
      <Function ID="13" Name="Mag - RGB Full" Display="'Mag - RGB Full %.f%%',0~100" Dmx="211~254" Colour="255,0,255" />
      <Function ID="14" Name="RGB Full" Display="'RGB Full'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="15" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

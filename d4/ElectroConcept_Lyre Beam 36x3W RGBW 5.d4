  <AtlaBase TypeID="d9ea35c8-5db0-45c8-8b27-befd97fef050" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Custom_Col_Dim" Name="Custom Col Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Control Relay On" Display="'Control Relay On'" Dmx="1~25" />
      <Function ID="3" Name="Control Relay Off" Display="'Control Relay Off'" Dmx="26~50" />
      <Function ID="4" Name="Col Program" Display="'Col Program'" Dmx="51~90" />
      <Function ID="5" Name="Col Change Pulse" Display="'Col Change Pulse'" Dmx="91~130" />
      <Function ID="6" Name="Col Change Random" Display="'Col Change Random'" Dmx="131~170" />
      <Function ID="7" Name="Col Change Fade" Display="'Col Change Fade'" Dmx="171~210" />
      <Function ID="8" Name="Auto" Display="'Auto'" Dmx="211~250" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~170" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Colour 1" Display="'Colour 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="Colour 2" Display="'Colour 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="Colour 3" Display="'Colour 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="Colour 4" Display="'Colour 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="Colour 5" Display="'Colour 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="Colour 6" Display="'Colour 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="Colour 7" Display="'Colour 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="Colour 8" Display="'Colour 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="Colour 9" Display="'Colour 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="Colour 10" Display="'Colour 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="Colour 11" Display="'Colour 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="ID" Display="'ID %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
  </Control>

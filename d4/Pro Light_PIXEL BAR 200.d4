  <AtlaBase TypeID="e4f83c8e-73b2-4854-b21d-0eaf9c6a8965" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~13" Update="Auto_Spd" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="14~20" Update="Auto_Spd" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="21~27" Update="Auto_Spd" />

    <Import PearlRef="SVOT2069" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="646feb16-b8e1-4a90-84d6-843a2c5d209e" />
    <Include>
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="CW_Strobe" ChannelOffset="2" Wheel="4" />
      <Attribute ID="CW_Func" ChannelOffset="3" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="4" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="WW_Strobe" ChannelOffset="5" Wheel="5" />
      <Attribute ID="WW_Func" ChannelOffset="6" Wheel="8" />

  <History Date="23-02-17" Author="Nic Morris" Comment="Created (very confusing documentation)" />
  <History Date="28-01-20" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" />
  <History Date="28-01-20" Author="Nic Morris" Comment="Added virtual dimmer to 6 and 9 channel modes in attempt to fix customer issue." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fa106f53-479e-4fc6-8dc9-90c4a14de7cb" />
  <Control>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sound" ID="2" If="'CW_Func'==3||'Colour1Func'==4" />
      <Condition Name="No Function" ID="3" If="'CW_Func'==1||'CW_Func'==4||'CW_Func'==5||'CW_Func'==6||'Colour1Func'==1||'Colour1Func'==3||'Colour1Func'==5" />
      <Condition Name="Program" ID="4" If="'Colour1Func'==6" />
      <Condition Name="Strobe" ID="5" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
      <Function ID="2" Name="Sound" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CW_Strobe" Name="CW Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'CW_Func'==4||'CW_Func'==5||'CW_Func'==6" />
      <Condition Name="Intensity" ID="3" If="'CW_Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CW_Func" Name="CW Func" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="2" Name="Intensity" Display="'Intensity'" Dmx="31~70" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="71~110" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="4" Name="Fade Out" Display="'Fade Out'" Dmx="111~150" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="5" Name="Fade In" Display="'Fade In'" Dmx="151~190" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="6" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="191~230" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="231~255" Update="ColdWhite, CW_Strobe" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sound" ID="2" If="'WW_Func'==3||'Colour1Func'==4" />
      <Condition Name="No Function" ID="3" If="'WW_Func'==1||'WW_Func'==4||'WW_Func'==5||'WW_Func'==6||'Colour1Func'==1||'Colour1Func'==3||'Colour1Func'==5" />
      <Condition Name="Program" ID="5" If="'Colour1Func'==6" />
      <Condition Name="Strobe" ID="4" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="Sound" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="WW_Strobe" Name="WW Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'WW_Func'==4||'WW_Func'==5||'WW_Func'==6" />
      <Condition Name="Intensity" ID="3" If="'WW_Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WW_Func" Name="WW Func" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="2" Name="Intensity" Display="'Intensity'" Dmx="31~70" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="71~110" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="4" Name="Fade Out" Display="'Fade Out'" Dmx="111~150" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="5" Name="Fade In" Display="'Fade In'" Dmx="151~190" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="6" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="191~230" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="231~255" Update="WarmWhite, WW_Strobe" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sound" ID="2" If="'Amber_Func'==3||'Colour1Func'==4" />
      <Condition Name="No Function" ID="3" If="'Amber_Func'==1||'Amber_Func'==4||'Amber_Func'==5||'Amber_Func'==6||'Colour1Func'==1||'Colour1Func'==3||'Colour1Func'==5" />
      <Condition Name="Program" ID="4" If="'Colour1Func'==6" />
      <Condition Name="Strobe" ID="5" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
      <Function ID="2" Name="Sound" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Amber_Strobe" Name="Amber Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Amber_Func'==4||'Amber_Func'==5||'Amber_Func'==6" />
      <Condition Name="Intensity" ID="3" If="'Amber_Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Amber_Func" Name="Amber Func" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="2" Name="Intensity" Display="'Intensity'" Dmx="31~70" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="71~110" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="4" Name="Fade Out" Display="'Fade Out'" Dmx="111~150" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="5" Name="Fade In" Display="'Fade In'" Dmx="151~190" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="6" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="191~230" Update="Amber, Amber_Strobe" Colour="0,0,0" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="231~255" Update="Amber, Amber_Strobe" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer'" Dmx="11~50" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="3" Name="Sound 1" Display="'Sound 1'" Dmx="51~90" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="4" Name="Sound 2" Display="'Sound 2'" Dmx="91~130" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="5" Name="Fading" Display="'Fading'" Dmx="131~170" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="6" Name="Program" Display="'Program'" Dmx="171~210" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="211~255" Update="ColdWhite, WarmWhite, Amber, Speed, Effect" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour1Func'&gt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sound" ID="2" If="'Colour1Func'==3" />
      <Condition Name="Hue" ID="3" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Sound" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="43d25864-5069-44cc-8078-2ebd0b89e541" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="All Full" Display="'All Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="4" Name="White 1: 3200K" Display="'White 1: 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 2: 3400K" Display="'White 2: 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 3: 4200K" Display="'White 3: 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="White 4: 4900K" Display="'White 4: 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="White 5: 5600K" Display="'White 5: 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="White 6: 5900K" Display="'White 6: 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="White 7: 6500K" Display="'White 7: 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="11" Name="White 8: 7200K" Display="'White 8: 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="12" Name="White 9: 8000K" Display="'White 9: 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="White 10: 8500K" Display="'White 10: 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="14" Name="White 11: 10000K" Display="'White 11: 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~29" />
      <Function ID="3" Name="Speed 1 (Fastest)" Display="'Speed 1 (Fastest)'" Dmx="30~69" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="70~129" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="130~181" />
      <Function ID="6" Name="Speed 4 (Slowest)" Display="'Speed 4 (Slowest)'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="257~32639" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33153" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33410~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Radial Prism Index" Display="'Radial Prism Index'" Dmx="6~25" Update="Prism_Rot" />
      <Function ID="3" Name="Linear Prism Index" Display="'Linear Prism Index'" Dmx="26~50" Update="Prism_Rot" />
      <Function ID="4" Name="8-Facet Prism Index" Display="'8-Facet Prism Index'" Dmx="51~75" Update="Prism_Rot" />
      <Function ID="5" Name="Radial Zoom Prism Index" Display="'Radial Zoom Prism Index'" Dmx="76~100" Update="Prism_Rot" />
      <Function ID="6" Name="Oval Index" Display="'Oval Index'" Dmx="101~125" Update="Prism_Rot" />
      <Function ID="7" Name="Radial Prism Spin" Display="'Radial Prism Spin'" Dmx="126~150" Update="Prism_Rot" />
      <Function ID="8" Name="Linear Prism Spin" Display="'Linear Prism Spin'" Dmx="151~175" Update="Prism_Rot" />
      <Function ID="9" Name="8-Facet Prism Spin" Display="'8-Facet Prism Spin'" Dmx="176~200" Update="Prism_Rot" />
      <Function ID="10" Name="Radial Zoom Prism Spin" Display="'Radial Zoom Prism Spin'" Dmx="201~225" Update="Prism_Rot" />
      <Function ID="11" Name="Oval Spin" Display="'Oval Spin'" Dmx="226~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'&gt;6" />
      <Else ID="1" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="2~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">

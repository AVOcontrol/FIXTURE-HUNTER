      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade_4_Rot" Name="Frame 4 Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="4m (Main)" Display="'4m (Main)'" Dmx="1~7" />
      <Function ID="3" Name="6m (Main)" Display="'6m (Main)'" Dmx="8~15" />
      <Function ID="4" Name="8m (Main)" Display="'8m (Main)'" Dmx="16~23" />
      <Function ID="5" Name="10m (Main)" Display="'10m (Main)'" Dmx="24~31" />
      <Function ID="6" Name="12m (Main)" Display="'12m (Main)'" Dmx="32~39" />
      <Function ID="7" Name="14m (Main)" Display="'14m (Main)'" Dmx="40~47" />
      <Function ID="8" Name="16m (Main)" Display="'16m (Main)'" Dmx="48~55" />
      <Function ID="9" Name="18m (Main)" Display="'18m (Main)'" Dmx="56~63" />
      <Function ID="10" Name="4m (Gobo)" Display="'4m (Gobo)'" Dmx="64~71" />
      <Function ID="11" Name="6m (Gobo)" Display="'6m (Gobo)'" Dmx="72~79" />
      <Function ID="12" Name="8m (Gobo)" Display="'8m (Gobo)'" Dmx="80~87" />
      <Function ID="13" Name="10m (Gobo)" Display="'10m (Gobo)'" Dmx="88~95" />
      <Function ID="14" Name="12m (Gobo)" Display="'12m (Gobo)'" Dmx="96~103" />
      <Function ID="15" Name="14m (Gobo)" Display="'14m (Gobo)'" Dmx="104~111" />
      <Function ID="16" Name="16m (Gobo)" Display="'16m (Gobo)'" Dmx="112~119" />
      <Function ID="17" Name="18m (Gobo)" Display="'18m (Gobo)'" Dmx="120~127" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="192~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="193~213" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="214~234" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Prism/Iris/Frost" Display="'Reset Prism/Iris/Frost'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Frames" Display="'Reset Frames'" Dmx="40~47" />
      <Function ID="7" Name="Reset Zoom+Focus" Display="'Reset Zoom+Focus'" Dmx="48~55" />
      <Function ID="8" Name="Reset Colour" Display="'Reset Colour'" Dmx="56~63" />
      <Function ID="9" Name="Absolute Silence Off" Display="'Absolute Silence Off'" Dmx="64~71" />
      <Function ID="10" Name="Absolute Silence On" Display="'Absolute Silence On'" Dmx="72~79" />
      <Function ID="11" Name="Steady Off" Display="'Steady Off'" Dmx="80~87" />
      <Function ID="12" Name="Steady Mode 1" Display="'Steady Mode 1'" Dmx="88~95" />
      <Function ID="13" Name="Steady Mode 2" Display="'Steady Mode 2'" Dmx="96~103" />
      <Function ID="14" Name="Dim Linear" Display="'Dim Linear'" Dmx="104~111" />
      <Function ID="15" Name="Dim Square" Display="'Dim Square'" Dmx="112~119" />
      <Function ID="16" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="120~127" />
      <Function ID="17" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="128~135" />
      <Function ID="18" Name="Dim Mode Fast" Display="'Dim Mode Fast'" Dmx="136~143" />
      <Function ID="19" Name="Dim Mode Smooth" Display="'Dim Mode Smooth'" Dmx="144~151" />
    </Attribute>
    <Attribute ID="Animation1" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Insert" Display="'Insert %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="4~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
  </Control>

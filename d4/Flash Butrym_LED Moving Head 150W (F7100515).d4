      <Function ID="10" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="62~127" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~194" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />

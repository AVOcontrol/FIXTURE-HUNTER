  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="18-01-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="07-05-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (revises macro delay, adds head invert and removes wireless control functions/macros)" Version="3" />
  <History Date="04-09-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds modes 3 and 4)" Version="4" />
  <History Date="05-09-24" Author="Nic Morris" Comment="Added Atlabase IDs for modes 3 and 4." Version="5" />
  <History Date="09-09-24" Author="Nic Morris" Comment="Added vdim to mode 3 beam cells." Version="6" />
  <History Date="02-12-24" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds mode 5 and CCI Calibration + dimming start mode control functions/macros)" Version="7" />
  <History Date="03-12-24" Author="Nic Morris" Comment="Added Atlabase ID for 170 channel mode." Version="8" />
  <History Date="24-06-25" Author="Nic Morris" Comment="Updated in line wth latest charts (adds pan, tilt and pixel invert control functions/macros)" Version="9" />
  <History Date="20-09-25" Author="Nic Morris" Comment="Revised mode 5 pixel layout." Version="10" />
  <History Date="04-02-26" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds 18 channel mode. note charts contain details for non-existant channels)" Version="12" />
  <History Date="05-02-26" Author="Nic Morris" Comment="Added Atlabase ID for 18 channel mode." Version="13" />
  <History Date="02-03-26" Author="Nic Morris" Comment="Created from ACME Tornado (TB 5 IP INT) (hopeless documentation.  mostly nonsense.  vague.  effectively identical)" Version="14" />
  <History Date="06-03-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="15" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="05af30ed-5b8f-4974-9ad5-f32b09f169f4" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">

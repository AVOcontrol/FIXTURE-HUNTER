    <Attribute ID="Pixel_FX_Spd" Name="Pixel FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Pixel_FX'==2" />
      <Condition Name="Sound" ID="3" If="'Pixel_FX'==53" />

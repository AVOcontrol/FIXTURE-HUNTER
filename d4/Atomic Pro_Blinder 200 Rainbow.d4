  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="33555e4c-4843-480a-a6a0-8b7f48aef3ce" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_Colour" Name="Pixel Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~35" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="36~71" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="72~107" Colour="0,0,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="108~143" Colour="0,0,0" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="144~179" Colour="0,0,0" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="180~215" Colour="0,0,0" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="216~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WW_FX" Name="WW FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="WW_FX_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="1~50" Update="WW_FX_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="51~100" Update="WW_FX_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="101~150" Update="WW_FX_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="151~200" Update="WW_FX_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="201~255" Update="WW_FX_Spd" />
    </Attribute>
    <Attribute ID="WW_FX_Spd" Name="WW FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'WW_FX'==2" />
      <Condition Name="Sound" ID="3" If="'WW_FX'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sound" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_FX" Name="Pixel FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Pixel_FX_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="1~50" Update="Pixel_FX_Spd" />
      <Function ID="3" Name="Jump 1" Display="'Jump 1'" Dmx="51~53" Update="Pixel_FX_Spd" />
      <Function ID="4" Name="Jump 2" Display="'Jump 2'" Dmx="54~56" Update="Pixel_FX_Spd" />

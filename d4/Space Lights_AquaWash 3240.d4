      <Function ID="7" Name="Auto 5 (Col Convection)" Display="'Auto 5 (Col Convection)'" Dmx="60~69" />
      <Function ID="8" Name="Auto 6 (Rainbow Windmill)" Display="'Auto 6 (Rainbow Windmill)'" Dmx="70~79" />
      <Function ID="9" Name="Auto 7 (Pix Effect 1)" Display="'Auto 7 (Pix Effect 1)'" Dmx="80~89" />
      <Function ID="10" Name="Auto 8 (Pix Effect 2)" Display="'Auto 8 (Pix Effect 2)'" Dmx="90~99" />
      <Function ID="11" Name="Auto 9 (Pix Effect 3)" Display="'Auto 9 (Pix Effect 3)'" Dmx="100~109" />
      <Function ID="12" Name="Auto 10 (Pix Effect 4)" Display="'Auto 10 (Pix Effect 4)'" Dmx="110~119" />

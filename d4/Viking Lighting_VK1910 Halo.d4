<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VK1910 Halo" ShortName="VK1910 Hlo" Company="Viking Lighting">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="15-04-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Slow Strobe" Display="'Slow Strobe %.f%%',0~100" Dmx="128~190" Intensity="0~0" />
      <Function ID="3" Name="Fast Strobe" Display="'Fast Strobe %.f%%',0~100" Dmx="191~253" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="2~64" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="65~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan Full" Display="'Fan Full'" Dmx="60~64" />
      <Function ID="3" Name="Fan Auto" Display="'Fan Auto'" Dmx="70~74" />
      <Function ID="4" Name="LCD Norm" Display="'LCD Norm'" Dmx="80~84" />
      <Function ID="5" Name="LCD Invert" Display="'LCD Invert'" Dmx="90~94" />
      <Function ID="6" Name="LCD On" Display="'LCD On'" Dmx="100~104" />
      <Function ID="7" Name="LCD Off" Display="'LCD Off'" Dmx="110~114" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="120~124" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="4~67" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="68~131" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect3" Name="Effect 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect4" Name="Effect 4" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect5" Name="Effect 5" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Halo_Shutter" Name="Halo Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Slow Strobe" Display="'Slow Strobe %.f%%',0~100" Dmx="128~190" Intensity="0~0" />
      <Function ID="3" Name="Fast Strobe" Display="'Fast Strobe %.f%%',0~100" Dmx="191~253" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="2~64" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="65~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Halo_Dimmer" Name="Halo Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Halo_Macro" Name="Halo Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="4~67" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="68~131" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Halo_Red" Name="Halo Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Halo_Green" Name="Halo Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Halo_Blue" Name="Halo Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="14">
    <Import PearlRef="UKVK191S" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="212" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="14" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Macro" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended" Channels="25">
    <Import PearlRef="UKVK191X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="212" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Halo_Shutter" ChannelOffset="20" Wheel="5" />
      <Attribute ID="Halo_Dimmer" ChannelOffset="21" Wheel="6" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="14" Wheel="9" />
      <Attribute ID="Halo_Red" ChannelOffset="23" Wheel="40" />
      <Attribute ID="Halo_Green" ChannelOffset="24" Wheel="41" />
      <Attribute ID="Halo_Blue" ChannelOffset="25" Wheel="42" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Macro" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Effect1" ChannelOffset="15" Wheel="24" />
      <Attribute ID="Effect2" ChannelOffset="16" Wheel="52" />
      <Attribute ID="Effect3" ChannelOffset="17" Wheel="53" />
      <Attribute ID="Effect4" ChannelOffset="18" Wheel="54" />
      <Attribute ID="Effect5" ChannelOffset="19" Wheel="82" />
      <Attribute ID="Halo_Macro" ChannelOffset="22" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Macro" Wheel="22" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
        <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
        <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
        <Attribute ID="White" ChannelOffset="13" Wheel="8" />
        <Attribute ID="CTO" ChannelOffset="14" Wheel="9" />
        <Attribute ID="Effect1" ChannelOffset="15" Wheel="24" />
        <Attribute ID="Effect2" ChannelOffset="16" Wheel="52" />
        <Attribute ID="Effect3" ChannelOffset="17" Wheel="53" />
        <Attribute ID="Effect4" ChannelOffset="18" Wheel="54" />
        <Attribute ID="Effect5" ChannelOffset="19" Wheel="82" />
      </Master>
      <Cell ID="Cell1" Name="Beam" ChannelOffset="1" ModeLink="Beam" X="0" Y="0">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Macro" TargetId="Macro" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Halo" ChannelOffset="20" ModeLink="Halo" X="0" Y="1">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Macro" TargetId="Macro" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Beam" Channels="6" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="212" PanMaxSpeed="0" TiltMaxSpeed="0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-W07L12" ShortName="BT-W07L12" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="28-08-13" Author="Matt Benson" Comment="Created" />
  <History Date="02-02-14" Author="Nic Morris" Comment="Simplified shutter and shortened function names for Expert LCD.  Increased wheel resolution.  Simplified control." />
  <History Date="02-02-14" Author="Nic Morris" Comment="Fixed colour scroll.  Set cell mode to hidden.  Fixed wheel mapping." />
  <History Date="02-02-14" Author="Nic Morris" Comment="Changed colour mixing attributes to 8-bit.  Added links to cell mode." />
  <History Date="02-02-14" Author="Nic Morris" Comment="Removed classic reference from cell mode.  Added compatibility to extended mode and re-exported r20s." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-11-15" Author="Gregory Haynes" Comment="Removed duplicate Dimmer text from Dimmer attribute." />
  <History Date="19-09-16" Author="Nic Morris" Comment="Fixed RGB to power on and locate at full in response to customer bug report." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Changed manufacturer name from Briteq to BriteQ.  Added Atlabase ID's." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Revised control function names.  Added macros.  Standardised colour scroll function names." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Inverted strobe function wheel directions.  Inverted P/T mac spd.  Revised colour macro functions." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Added 1MSL and 4MSL modes.  Revised shutter and control functions for 9 and 28 channel modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="56f5364e-eaf2-4b9d-bc66-f5ea10df0516" />

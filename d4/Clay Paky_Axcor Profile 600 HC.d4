    <Attribute ID="Anim_Rot" Name="Anim Rot" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~124" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="125~130" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Plumens)" Display="'Gobo 1 (Plumens)'" Dmx="17~32" WheelPosition="1">
        <Swatch>3538bfa1-2616-458d-a5c4-aa5040f767db</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Water Lines)" Display="'Gobo 2 (Water Lines)'" Dmx="33~48" WheelPosition="2">
        <Swatch>4055d74a-bb68-4fa3-a3e4-a4e72566cd6e</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Multiple Cones)" Display="'Gobo 3 (Multiple Cones)'" Dmx="49~54" WheelPosition="3">
        <Swatch>2f344be6-a79e-4639-b93f-0a1d60e4f997</Swatch>
      </Function>

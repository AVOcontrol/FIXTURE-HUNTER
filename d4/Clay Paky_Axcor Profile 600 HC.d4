        <Swatch>64c65082-3d6b-43d5-91f9-a6c8f6c0170b</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Small Dots)" Display="'Gobo 5 (Small Dots)'" Dmx="82~97" WheelPosition="5">
        <Swatch>d84f42f3-6152-4da1-bf1e-976a1de7dc6a</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Broken Circle)" Display="'Gobo 6 (Broken Circle)'" Dmx="98~113" WheelPosition="6">
        <Swatch>c0a56290-0ced-4ec3-94a8-7fdd56911113</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Half Circle)" Display="'Gobo 7 (Half Circle)'" Dmx="114~129" WheelPosition="7">
        <Swatch>70dc2805-e5ad-4168-8a1c-afead1a6229b</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="130~147" WheelPosition="1">
        <Swatch>3538bfa1-2616-458d-a5c4-aa5040f767db</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="148~165" WheelPosition="2">
        <Swatch>4055d74a-bb68-4fa3-a3e4-a4e72566cd6e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="166~183" WheelPosition="3">
        <Swatch>2f344be6-a79e-4639-b93f-0a1d60e4f997</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="184~201" WheelPosition="4">
        <Swatch>64c65082-3d6b-43d5-91f9-a6c8f6c0170b</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="202~219" WheelPosition="5">
        <Swatch>d84f42f3-6152-4da1-bf1e-976a1de7dc6a</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="220~237" WheelPosition="6">
        <Swatch>c0a56290-0ced-4ec3-94a8-7fdd56911113</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="238~255" WheelPosition="7">
        <Swatch>70dc2805-e5ad-4168-8a1c-afead1a6229b</Swatch>
      </Function>
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />

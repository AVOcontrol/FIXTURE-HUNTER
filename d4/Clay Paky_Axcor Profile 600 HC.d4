<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Axcor Profile 600 HC" ShortName="AxPro600HC" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>e4870772-21c8-4d2d-b20a-be6bf2e830f5</Thumbnail>
  <History Date="21-12-16" Author="Nic Morris" Comment="Created (prelim - attributes only)" />
  <History Date="25-01-17" Author="Nic Morris" Comment="Updated with function ranges." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed Blade All Rot to locate at 50% and inverted Iris in response to customer request (non-standard implementation)." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added 'Uniform Beam' channel and revised frost channels to single ranges and renamed in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Swapped CW and CCW prism spin ranges in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised Colour names, ranges and Anim Rot ranges in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed animation function to variable range in attempt to fix customer bug report." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised blade assignment in line with Capture." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Unified macros across product range." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed colour index to discreet functions in line with other products in range." />
  <History Date="08-04-17" Author="Nic Morris" Comment="Created from Clay Paky Scenius Unico (note Draft charts - assumed colour ranges the same)" />
  <History Date="12-03-18" Author="Nic Morris" Comment="Updated in line with '02/2018' doc (revised fixed cols, functions + macros + added extended modes)" />
  <History Date="12-03-18" Author="Nic Morris" Comment="Added channel counts to mode names.  Added product thumbnail.  Added Atlabase ID's (currently missing extended modes)" />
  <History Date="12-03-18" Author="Nic Morris" Comment="Added gobo swatches." />
  <History Date="17-03-18" Author="Nic Morris" Comment="Added Atlabase ID's for Extended modes." />
  <History Date="02-08-18" Author="Nic Morris" Comment="Created from Clay Paky Axcor Profile 900 (note vector channel maps have errors)" />
  <History Date="11-01-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added RDM ID's (note no personality ID's.  this will probably fail as the modes do not have unique channel counts)" />
  <History Date="20-02-19" Author="Nic Morris" Comment="Created from Clay Paky Axcor Profile 600 (identical)" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="992" />
  </RDM>
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="13,14,15,16,17,18" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==4" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="21~21" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="42~42" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="CRI" Display="'CRI'" Dmx="63~63" WheelPosition="3" Colour="255,255,255" />
      <Function ID="5" Name="Gold Amber" Display="'Gold Amber'" Dmx="84~84" WheelPosition="4" Colour="255,100,0" />
      <Function ID="6" Name="Nay Blue" Display="'Nay Blue'" Dmx="106~106" WheelPosition="5" Colour="0,0,180" />
      <Function ID="7" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="11~11" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="D Rd/ Grn" Display="'D Rd/ Grn'" Dmx="32~32" WheelPosition="1" Colour="180,0,0" />
      <Function ID="9" Name="Grn/ CRI" Display="'Grn/ CRI'" Dmx="53~53" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="CRI/ G Amb" Display="'CRI/ G Amb'" Dmx="74~74" WheelPosition="3" Colour="255,255,255" />
      <Function ID="11" Name="G Amb/ N Blu" Display="'G Amb/ N Blu'" Dmx="95~95" WheelPosition="4" Colour="255,100,0" />
      <Function ID="12" Name="N Blu/ Op" Display="'N Blu/ Op'" Dmx="118~118" WheelPosition="5" Colour="0,0,180" />
      <Function ID="13" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~21" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="D Rd - Grn" Display="'D Rd - Grn %.f%%',0~100" Dmx="21~42" WheelPosition="1" Colour="180,0,0" />
      <Function ID="15" Name="Grn - CRI" Display="'Grn - CRI %.f%%',0~100" Dmx="42~63" WheelPosition="2" Colour="0,255,0" />
      <Function ID="16" Name="CRI - G Amb" Display="'CRI - G Amb %.f%%',0~100" Dmx="63~84" WheelPosition="3" Colour="255,255,255" />
      <Function ID="17" Name="G Amb - N Blu" Display="'G Amb - N Blu %.f%%',0~100" Dmx="84~106" WheelPosition="4" Colour="255,100,0" />
      <Function ID="18" Name="N Blu - Op" Display="'N Blu - Op %.f%%',0~100" Dmx="106~127" WheelPosition="5" Colour="0,0,180" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />

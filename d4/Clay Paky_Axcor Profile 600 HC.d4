    <Attribute ID="Gobo_Spd" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
      <Function ID="3" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Function_2" Name="Function 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Base Freq 4700Hz" Display="'Base Freq 4700Hz'" Dmx="12~12" />
      <Function ID="3" Name="Base Freq 6000Hz" Display="'Base Freq 6000Hz'" Dmx="13~13" />
      <Function ID="4" Name="Base Freq 7300Hz" Display="'Base Freq 7300Hz'" Dmx="14~14" />
      <Function ID="5" Name="Base Freq 8600Hz" Display="'Base Freq 8600Hz'" Dmx="15~15" />
      <Function ID="6" Name="Base Freq 10000Hz" Display="'Base Freq 10000Hz'" Dmx="16~16" />
      <Function ID="7" Name="Base Freq 12000Hz" Display="'Base Freq 12000Hz'" Dmx="17~17" />
      <Function ID="8" Name="Base Freq 15000Hz" Display="'Base Freq 15000Hz'" Dmx="18~18" />
      <Function ID="9" Name="Base Freq 17578Hz" Display="'Base Freq 17578Hz'" Dmx="19~19" />
      <Function ID="10" Name="Base Freq 20000Hz" Display="'Base Freq 20000Hz'" Dmx="20~20" />
      <Function ID="11" Name="Base Freq 22000Hz" Display="'Base Freq 22000Hz'" Dmx="21~21" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func1" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo11" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo11" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo11" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo11" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func1'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func1'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func1'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="9~17" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="18~26" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="27~35" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="36~44" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="45~53" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="54~62" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="63~71" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="160~173" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="174~187" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="188~201" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="202~214" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="215~228" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="229~242" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="243~255" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="118~159" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="113~72" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Plumens)" Display="'Gobo 1 (Plumens)'" Dmx="17~32" WheelPosition="1">
        <Swatch>3538bfa1-2616-458d-a5c4-aa5040f767db</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Water Lines)" Display="'Gobo 2 (Water Lines)'" Dmx="33~48" WheelPosition="2">
        <Swatch>4055d74a-bb68-4fa3-a3e4-a4e72566cd6e</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Multiple Cones)" Display="'Gobo 3 (Multiple Cones)'" Dmx="49~54" WheelPosition="3">
        <Swatch>2f344be6-a79e-4639-b93f-0a1d60e4f997</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Shattered)" Display="'Gobo 4 (Shattered)'" Dmx="55~81" WheelPosition="4">
        <Swatch>64c65082-3d6b-43d5-91f9-a6c8f6c0170b</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Small Dots)" Display="'Gobo 5 (Small Dots)'" Dmx="82~97" WheelPosition="5">
        <Swatch>d84f42f3-6152-4da1-bf1e-976a1de7dc6a</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Broken Circle)" Display="'Gobo 6 (Broken Circle)'" Dmx="98~113" WheelPosition="6">
        <Swatch>c0a56290-0ced-4ec3-94a8-7fdd56911113</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Half Circle)" Display="'Gobo 7 (Half Circle)'" Dmx="114~129" WheelPosition="7">
        <Swatch>70dc2805-e5ad-4168-8a1c-afead1a6229b</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>984ebd72-db2f-4ad8-a123-3c90b158fa37</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="130~147" WheelPosition="1">
        <Swatch>3538bfa1-2616-458d-a5c4-aa5040f767db</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="148~165" WheelPosition="2">
        <Swatch>4055d74a-bb68-4fa3-a3e4-a4e72566cd6e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="166~183" WheelPosition="3">
        <Swatch>2f344be6-a79e-4639-b93f-0a1d60e4f997</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="184~201" WheelPosition="4">
        <Swatch>64c65082-3d6b-43d5-91f9-a6c8f6c0170b</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="202~219" WheelPosition="5">
        <Swatch>d84f42f3-6152-4da1-bf1e-976a1de7dc6a</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="220~237" WheelPosition="6">
        <Swatch>c0a56290-0ced-4ec3-94a8-7fdd56911113</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="238~255" WheelPosition="7">
        <Swatch>70dc2805-e5ad-4168-8a1c-afead1a6229b</Swatch>
      </Function>
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48830" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo_1_Insert" Name="Gobo 1 Insert" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>

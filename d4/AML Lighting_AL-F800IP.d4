  <History Date="28-11-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="9" />
  <History Date="27-03-26" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (original charts were wrong.  changes open shutter to closed and adds open range, swaps CRI functions and revises gobo rotate)." Version="10" />

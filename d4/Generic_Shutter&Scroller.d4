<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Shutter&amp;Scroller" ShortName="UKS&amp;S" Company="Generic">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="12-03-08" Author="Ion Balan" Comment="Created" />
  <History Date="12-03-08" Author="Ion Balan" Comment="Checked" />
  <History Date="15-10-08" Author="Jonathan Moreton" Comment="Updated manufacturer name" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="30-04-12" Author="Peter Budd" Comment="Edited changed filename from Unknown(Generic) to Generic" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Col Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~128" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="129~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed1" Name="Shut Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="UKS&amp;S" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Speed1" ChannelOffset="4" Wheel="5" />
    </Include>
  </Mode>
</Fixture>
  <History Date="09-12-25" Author="Nic Morris" Comment="Created (charts only.  suggestion of other modes but incomplete)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="8~23" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="24~39" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="40~55" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="56~71" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="72~87" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="88~103" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="104~119" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="120~135" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="136~151" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="152~167" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="168~183" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="184~199" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="200~215" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="216~231" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="241~255" />
    </Attribute>
  </Control>
  <Mode Name="19 DMX" Channels="19" Id="12c34501-83f5-46f3-bea6-708849f25a53">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="185" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
        <Attribute ID="Pan_Spin" ChannelOffset="2" Wheel="19" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="6" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
        <Attribute ID="Effect" ChannelOffset="17" Wheel="22" />
        <Attribute ID="Effect_Spd" ChannelOffset="18" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="19" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Head 1 cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Head 2 cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Head 3 cell" X="0" Y="2">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

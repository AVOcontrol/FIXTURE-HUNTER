      <Condition Name="Strobe" ID="28,29,30,31,32,33,34,35,36" If="'Auto_Sel'==5" />
      <Condition Name="Mix" ID="37,38,39,40" If="'Auto_Sel'==6" />
      <Else ID="41" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~32" />

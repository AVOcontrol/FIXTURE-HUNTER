  <History Date="31-07-17" Author="Nic Morris" Comment="Created" />
  <History Date="04-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0a128629-ad62-40dd-bbba-495c64975fcb" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Spin" ID="2,3,4,5" If="'P/T_Func'==2||'P/T_Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="1028~32639" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33667" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33924~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Spin" ID="2,3,4,5" If="'P/T_Func'==3||'P/T_Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="1028~32639" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33667" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33924~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Pan, Tilt" />
      <Function ID="2" Name="Pan Spin" Display="'Pan Spin'" Dmx="66~130" Update="Pan, Tilt" />
      <Function ID="3" Name="Tilt Spin" Display="'Tilt Spin'" Dmx="131~195" Update="Pan, Tilt" />
      <Function ID="4" Name="P/T Spin" Display="'P/T Spin'" Dmx="196~255" Update="Pan, Tilt" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_Macro" Name="Pixel Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="16~35" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="36~55" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="56~75" />

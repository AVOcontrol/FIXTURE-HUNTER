      <Function ID="13" Name="Macro 12" Display="'Macro 12 %.f%%',0~100" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~99" />
      <Function ID="3" Name="Program" Display="'Program'" Dmx="100~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="ID 1" Display="'ID 1'" Dmx="10~19" />
      <Function ID="3" Name="ID 2" Display="'ID 2'" Dmx="20~29" />
      <Function ID="4" Name="ID 3" Display="'ID 3'" Dmx="30~39" />

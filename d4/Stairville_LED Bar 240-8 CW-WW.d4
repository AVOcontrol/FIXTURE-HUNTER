  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3e05fd0c-a627-470c-9182-f6fc44fd49ea" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="10~19" />
      <Function ID="3" Name="Warm White, Cold White" Display="'Warm White, Cold White'" Dmx="20~29" />
      <Function ID="4" Name="Cold White" Display="'Cold White'" Dmx="30~39" />
      <Function ID="5" Name="Program 2" Display="'Program 2'" Dmx="40~49" />
      <Function ID="6" Name="Program 3" Display="'Program 3'" Dmx="50~59" />
      <Function ID="7" Name="Program 4" Display="'Program 4'" Dmx="60~69" />
      <Function ID="8" Name="Program 5" Display="'Program 5'" Dmx="70~79" />
      <Function ID="9" Name="Program 6" Display="'Program 6'" Dmx="80~89" />
      <Function ID="10" Name="Program 7" Display="'Program 7'" Dmx="90~99" />
      <Function ID="11" Name="Program 8" Display="'Program 8'" Dmx="100~109" />
      <Function ID="12" Name="Program 9" Display="'Program 9'" Dmx="110~119" />
      <Function ID="13" Name="Program 10" Display="'Program 10'" Dmx="120~129" />
      <Function ID="14" Name="Program 11" Display="'Program 11'" Dmx="130~139" />
      <Function ID="15" Name="Program 12" Display="'Program 12'" Dmx="140~149" />
      <Function ID="16" Name="Program 13" Display="'Program 13'" Dmx="150~159" />
      <Function ID="17" Name="Program 14" Display="'Program 14'" Dmx="160~169" />
      <Function ID="18" Name="Program 15" Display="'Program 15'" Dmx="170~179" />
      <Function ID="19" Name="Program 16" Display="'Program 16'" Dmx="180~189" />
      <Function ID="20" Name="Program 17" Display="'Program 17'" Dmx="190~199" />
      <Function ID="21" Name="Program 18" Display="'Program 18'" Dmx="200~209" />
      <Function ID="22" Name="Program 19" Display="'Program 19'" Dmx="210~219" />
      <Function ID="23" Name="Program 20" Display="'Program 20'" Dmx="220~229" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Sound" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="SVB248W2" DiamondRef="" WysiwygRef="" />

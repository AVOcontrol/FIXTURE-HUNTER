      <Function ID="19" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="90~94" WheelPosition="6" />
      <Function ID="20" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="95~99" WheelPosition="7" />
      <Function ID="21" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="100~104" WheelPosition="8" />

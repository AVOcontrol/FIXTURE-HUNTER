    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~130" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="136~251" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="4" Name="Reset Small Motors" Display="'Reset Small Motors'" Dmx="100~149" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="150~199" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~255" />
    </Attribute>

      <Function ID="23" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="110~114" WheelPosition="10" />
      <Function ID="24" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="115~119" WheelPosition="11" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="186~190" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~191" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="186~190" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="185~120" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="150~64" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="151~154" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="235~155" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="151~154" />
      <Function ID="6" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="236~255" />

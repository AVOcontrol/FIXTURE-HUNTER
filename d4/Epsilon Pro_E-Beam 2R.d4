    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display ON" Display="'Display ON'" Dmx="102~112" />
      <Function ID="3" Name="Display OFF" Display="'Display OFF'" Dmx="113~123" />
      <Function ID="4" Name="Display Invert" Display="'Display Invert'" Dmx="124~134" />
      <Function ID="5" Name="Display Normal" Display="'Display Normal'" Dmx="135~145" />
      <Function ID="6" Name="Reset Effects" Display="'Reset Effects'" Dmx="185~191" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="192~198" />
      <Function ID="8" Name="Reset All" Display="'Reset All'" Dmx="199~211" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Low Power" Display="'Low Power'" Dmx="32~63" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="160~191" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">

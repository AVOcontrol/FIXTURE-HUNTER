      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="116~117" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="60~115" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="116~117" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="118~147" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="64~127" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="60 Shake" Display="'60 Shake'" Dmx="192~207" />
      <Function ID="5" Name="120 Shake" Display="'120 Shake'" Dmx="208~223" />
      <Function ID="6" Name="180 Shake" Display="'180 Shake'" Dmx="224~239" />

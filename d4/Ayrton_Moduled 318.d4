  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="31-08-05" Author="Ed" Comment="Created from 518" />
  <History Date="31-08-05" Author="Phil" Comment="Checked" />
  <History Date="23-06-06" Author="Ed" Comment="Brought in line with spec after eventually getting hold of one" />
  <History Date="26-06-06" Author="Ed" Comment="Inverted Dimmer" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="16-07-09" Author="David Hunt" Comment="Fixed range assignments" />
  <History Date="09-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Added Red,Green,Blue and replaced in single cell modes." />
  <History Date="09-09-11" Author="Nic Morris" Comment="Removed clear values.  Added palettes,  Added pixel mapper compatibility." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="23-03-17" Author="Nic Morris" Comment="Changed name from ModuLED 318 to Moduled 318" />
  <History Date="23-03-17" Author="Nic Morris" Comment="Added virtual dimmer to cells.  Changed dimmer to master dimmer to solve problems with inverted dimmer and virtual controls." />

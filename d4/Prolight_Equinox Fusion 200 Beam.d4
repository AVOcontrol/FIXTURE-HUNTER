  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:10" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark On">
      <Set Channel="Control:2" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark Off">
      <Set Channel="Control:3" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark On">
      <Set Channel="Control:4" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark Off">
      <Set Channel="Control:5" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark On">
      <Set Channel="Control:6" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark Off">

    </Attribute>
    <Attribute ID="Chase1" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Laser On" Display="'Laser On'" Dmx="30~99" />

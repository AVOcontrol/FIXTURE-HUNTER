      <Function ID="7" Name="Heart" Display="'Heart'" Dmx="104~104" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Stars" Display="'Stars'" Dmx="120~120" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

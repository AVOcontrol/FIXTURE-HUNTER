  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="26~42" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="43~58" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="59~74" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="75~90" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="91~107" Colour="0,255,255" />

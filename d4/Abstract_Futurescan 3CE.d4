      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="124~139" Colour="255,0,255" />
      <Function ID="9" Name="Neon Green" Display="'Neon Green'" Dmx="140~155" Colour="0,255,0" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="156~172" Colour="255,150,150" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="173~188" Colour="0,0,255" />
      <Function ID="12" Name="MultiCol" Display="'MultiCol'" Dmx="189~220" Colour="0,0,0" />
      <Function ID="13" Name="UV Blue" Display="'UV Blue'" Dmx="221~237" Colour="0,0,255" />
      <Function ID="14" Name="Pink" Display="'Pink'" Dmx="238~253" Colour="255,150,150" />
      <Function ID="15" Name="Neon Green" Display="'Neon Green'" Dmx="254~255" Colour="0,255,0" />
    </Attribute>

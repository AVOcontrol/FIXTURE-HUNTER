      <Function ID="12" Name="Deep Blue" Display="'Deep Blue'" Dmx="94~98" WheelPosition="11" Colour="0,0,200" />
      <Function ID="13" Name="Cyan" Display="'Cyan'" Dmx="103~106" WheelPosition="12" Colour="0,255,255" />
      <Function ID="14" Name="Green" Display="'Green'" Dmx="111~115" WheelPosition="13" Colour="0,255,0" />
      <Function ID="15" Name="Lavender" Display="'Lavender'" Dmx="120~123" WheelPosition="14" Colour="220,160,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ D Org" Display="'Rd/ D Org'" Dmx="13~17" WheelPosition="1" Colour="0,0,0" />
      <Function ID="18" Name="D Org/ L Grn" Display="'D Org/ L Grn'" Dmx="22~25" WheelPosition="2" Colour="0,0,0" />
      <Function ID="19" Name="L Grn/ Yel" Display="'L Grn/ Yel'" Dmx="30~34" WheelPosition="3" Colour="0,0,0" />
      <Function ID="20" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="39~42" WheelPosition="4" Colour="0,0,0" />
      <Function ID="21" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="47~51" WheelPosition="5" Colour="0,0,0" />
      <Function ID="22" Name="Org/ CTB" Display="'Org/ CTB'" Dmx="56~59" WheelPosition="6" Colour="0,0,0" />
      <Function ID="23" Name="CTB/ CTO" Display="'CTB/ CTO'" Dmx="64~68" WheelPosition="7" Colour="0,0,0" />
      <Function ID="24" Name="CTO/ Pk" Display="'CTO/ Pk'" Dmx="73~76" WheelPosition="8" Colour="0,0,0" />
      <Function ID="25" Name="Pk/ Mag" Display="'Pk/ Mag'" Dmx="82~85" WheelPosition="9" Colour="0,0,0" />
      <Function ID="26" Name="Mag/ D Blu" Display="'Mag/ D Blu'" Dmx="90~93" WheelPosition="10" Colour="0,0,0" />
      <Function ID="27" Name="D Blu/ Cy" Display="'D Blu/ Cy'" Dmx="99~102" WheelPosition="11" Colour="0,0,0" />
      <Function ID="28" Name="Cy/ Grn" Display="'Cy/ Grn'" Dmx="107~110" WheelPosition="12" Colour="0,0,0" />
      <Function ID="29" Name="Grn/ Lav" Display="'Grn/ Lav'" Dmx="116~119" WheelPosition="13" Colour="0,0,0" />
      <Function ID="30" Name="Lav/ Op" Display="'Lav/ Op'" Dmx="124~127" WheelPosition="14" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~202" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="203~255" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

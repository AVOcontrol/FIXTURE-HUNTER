      <Function ID="7" Name="All in Dark" Display="'All in Dark'" Dmx="48~55" />
      <Function ID="8" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="9" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="10" Name="Reset Col" Display="'Reset Col'" Dmx="112~119" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="12" Name="Reset Prism" Display="'Reset Prism'" Dmx="136~143" />

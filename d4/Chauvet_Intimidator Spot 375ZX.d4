  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8b4418c4-f259-4f12-81ab-f7691eb6b5f8" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="32~39" Colour="0,0,255" />
      <Function ID="6" Name="CTO" Display="'CTO'" Dmx="40~47" Colour="255,225,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="48~55" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="56~63" Colour="255,0,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="64~189" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="190~221" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>0193233d-06ff-435f-becf-1083606fc73f</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1">
        <Swatch>293abd21-a780-49d2-8e55-a275f7d4aebd</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2">
        <Swatch>7c2bd0d0-0ac9-4e2c-83dd-5dd8f9d84b68</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3">
        <Swatch>447c3e7a-b7d8-465c-a143-9657dd192b9e</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4">
        <Swatch>4e1373b5-75ce-4dc3-a380-db149ae6d6ba</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5">
        <Swatch>8860d1d1-439a-4b1b-a644-c0bf9f80e2c6</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6">
        <Swatch>4e7ef895-7919-428c-a5aa-b86a5604b7b8</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7">
        <Swatch>e3602198-68de-41a7-a1e6-716afbf54d86</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0">
        <Swatch>0193233d-06ff-435f-becf-1083606fc73f</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="1">
        <Swatch>293abd21-a780-49d2-8e55-a275f7d4aebd</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="2">
        <Swatch>7c2bd0d0-0ac9-4e2c-83dd-5dd8f9d84b68</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="3">
        <Swatch>447c3e7a-b7d8-465c-a143-9657dd192b9e</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4">
        <Swatch>4e1373b5-75ce-4dc3-a380-db149ae6d6ba</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="5">
        <Swatch>8860d1d1-439a-4b1b-a644-c0bf9f80e2c6</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="6">
        <Swatch>4e7ef895-7919-428c-a5aa-b86a5604b7b8</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="7">
        <Swatch>e3602198-68de-41a7-a1e6-716afbf54d86</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="189~128" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6,7" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="145~64" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="150~231" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="7" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="232~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="6-Facet" Display="'6-Facet'" Dmx="4~6" />
      <Function ID="3" Name="6-Facet CW" Display="'6-Facet CW %.f%%',100~0" Dmx="65~7" />
      <Function ID="4" Name="6-Facet CCW" Display="'6-Facet CCW %.f%%',0~100" Dmx="66~123" />
      <Function ID="5" Name="6-Facet" Display="'6-Facet'" Dmx="124~127" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="128~131" />
      <Function ID="7" Name="5-Facet" Display="'5-Facet'" Dmx="132~134" />
      <Function ID="8" Name="5-Facet CW" Display="'5-Facet CW %.f%%',100~0" Dmx="193~135" />
      <Function ID="9" Name="5-Facet CCW" Display="'5-Facet CCW %.f%%',0~100" Dmx="194~251" />
      <Function ID="10" Name="5-Facet" Display="'5-Facet'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">

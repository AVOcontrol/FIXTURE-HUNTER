      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="96~103" WheelPosition="12" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="104~111" WheelPosition="13" Colour="0,0,0" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="112~127" WheelPosition="14" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="188~195" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stinger II" ShortName="Stinger II" Company="ADJ" Version="2">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="01-02-17" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Stinger II.d4 to ADJ_Stinger II.d4." Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show_Mode" Name="Show Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="10~44" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="45~79" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="80~114" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="115~149" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="150~184" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="185~219" />
      <Function ID="8" Name="Random" Display="'Random'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Change" Display="'Change %.1f%%',0.0~100.0" Dmx="10~198" Colour="255,255,255" />
      <Function ID="3" Name="Fade 1" Display="'Fade 1 %.f%%',0~100" Dmx="199~225" Colour="255,255,255" />
      <Function ID="4" Name="Fade 2" Display="'Fade 2 %.f%%',0~100" Dmx="226~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~244" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="UV_LEDs" Name="UV LEDs" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV_LEDs_Spd" Name="UV LEDs Spd" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Strobing" Display="'Strobing %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Lasers" Name="Lasers" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" />
      <Function ID="4" Name="Red + Green" Display="'Red + Green'" Dmx="90~129" />
      <Function ID="5" Name="R+G Flicker" Display="'R+G Flicker'" Dmx="130~169" />
      <Function ID="6" Name="G+R Flicker" Display="'G+R Flicker'" Dmx="170~209" />
      <Function ID="7" Name="R+G Flicker Sync" Display="'R+G Flicker Sync'" Dmx="210~249" />
      <Function ID="8" Name="R+G Alt Flicker" Display="'R+G Alt Flicker'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~244" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="LED_Rot" Name="LED Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="127~10" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Show_Speed" Name="Show Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~247" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="ADJSTNG2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show_Mode" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Show_Speed" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="ADJSTNG9" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show_Mode" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
      <Attribute ID="LED_Strobe" ChannelOffset="3" Wheel="4" />
      <Attribute ID="UV_LEDs" ChannelOffset="4" Wheel="7" />
      <Attribute ID="UV_LEDs_Spd" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Lasers" ChannelOffset="6" Wheel="22" />

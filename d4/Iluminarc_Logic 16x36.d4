<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Logic 16x36" ShortName="Logic16x36" Company="Iluminarc">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="26-04-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~210" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Green, Red" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" Update="Green, Red" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~40" Update="Green, Red" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="41~50" Update="Green, Red" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~60" Update="Green, Red" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~70" Update="Green, Red" />
      <Function ID="7" Name="RGBL 1" Display="'RGBL 1'" Dmx="71~80" Update="Green, Red" />
      <Function ID="8" Name="RGBL 2" Display="'RGBL 2'" Dmx="81~90" Update="Green, Red" />
      <Function ID="9" Name="RGBL 3" Display="'RGBL 3'" Dmx="91~100" Update="Green, Red" />
      <Function ID="10" Name="RGBL 4" Display="'RGBL 4'" Dmx="101~110" Update="Green, Red" />
      <Function ID="11" Name="RGBL 5" Display="'RGBL 5'" Dmx="111~120" Update="Green, Red" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" Update="Green, Red" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" Update="Green, Red" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" Update="Green, Red" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" Update="Green, Red" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" Update="Green, Red" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" Update="Green, Red" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" Update="Green, Red" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" Update="Green, Red" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" Update="Green, Red" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" Update="Green, Red" />
    </Attribute>
    <Attribute ID="Auto_Speed" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zone_Sel" Name="Zone Sel" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Lines" Display="'All Lines'" Dmx="0~0" />
      <Function ID="2" Name="Line 1" Display="'Line 1'" Dmx="10~29" />
      <Function ID="3" Name="Line 2" Display="'Line 2'" Dmx="30~49" />
      <Function ID="4" Name="Line 3" Display="'Line 3'" Dmx="50~69" />
      <Function ID="5" Name="Line 4" Display="'Line 4'" Dmx="70~89" />
      <Function ID="6" Name="Line 5" Display="'Line 5'" Dmx="90~109" />
      <Function ID="7" Name="Line 6" Display="'Line 6'" Dmx="110~129" />
      <Function ID="8" Name="Line 7" Display="'Line 7'" Dmx="130~149" />
      <Function ID="9" Name="Line 8" Display="'Line 8'" Dmx="150~169" />
      <Function ID="10" Name="Line 9" Display="'Line 9'" Dmx="170~189" />
      <Function ID="11" Name="Line 10" Display="'Line 10'" Dmx="190~199" />
      <Function ID="12" Name="Line 11" Display="'Line 11'" Dmx="200~209" />
      <Function ID="13" Name="Line 12" Display="'Line 12'" Dmx="210~219" />
      <Function ID="14" Name="Line 13" Display="'Line 13'" Dmx="220~229" />
      <Function ID="15" Name="Line 14" Display="'Line 14'" Dmx="230~239" />
      <Function ID="16" Name="Line 15" Display="'Line 15'" Dmx="240~249" />
      <Function ID="17" Name="Line 16" Display="'Line 16'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="Effect" Channels="9">
    <Import PearlRef="UKIL6361" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>

    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="40~69" />
      <Function ID="3" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="80~89" />
      <Function ID="4" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="90~99" />

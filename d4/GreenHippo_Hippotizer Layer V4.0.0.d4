<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hippotizer Layer V4.0.0" ShortName="HippoLyr 4" Company="Green Hippo">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="08-02-07" Author="D.Milligan" Comment="Created" />
  <History Date="31-01-08" Author="Ion Balan" Comment="Updated to V 3.0.11" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="05-03-09" Author="Jonathan Moreton" Comment="Changed Raw Dmx to individual functions 0-255  Changed generator attributes to percentage" />
  <History Date="27-07-09" Author="David Hunt" Comment="Upgraded to V3.0.13" />
  <History Date="27-07-09" Author="Jonathan Moreton" Comment="Re ordered wheel mapping for effects" />
  <History Date="22-10-09" Author="Gregory Haynes" Comment="Changed parameters to Raw DMX, fixed Aspect Ratio channel, moved some wheels to reduce the number of pages and some other minor fixes." />
  <History Date="02-03-10" Author="John Rogers" Comment="Edited Zoom and Speed percentage ranges." />
  <History Date="14-07-10" Author="John Rogers" Comment="Effect 1 and 2 Parameters updated, Generator channels updated." />
  <History Date="18-10-10" Author="John Rogers" Comment="Removed Clar values from Bank and Clip channels." />
  <History Date="03-04-12" Author="Peter Budd" Comment="Created from V3" />
  <History Date="05-04-12" Author="Peter Budd" Comment="Edited updated locate values." />
  <History Date="05-04-12" Author="Peter Budd" Comment="Edited edited rotate locate values." />
  <History Date="27-04-12" Author="Peter Budd" Comment="Edited swapped speed and relay select." />
  <History Date="10-05-12" Author="Peter Budd" Comment="Edited changed live mask to values" />
  <History Date="26-09-12" Author="Peter Budd" Comment="Edited re-arranged wheel assignment." />
  <History Date="22-05-13" Author="Peter Budd" Comment="Updated to deal with V6 locate and raw DMX issues." />
  <History Date="05-01-14" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Media Layer V3.2" />
  <History Date="20-01-14" Author="Nic Morris" Comment="Updated generator" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="08-03-15" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Media Layer V3.2.1" />
  <History Date="06-11-17" Author="Nic Morris" Comment="Revised saturation ID for compatibility." />
  <History Date="02-05-19" Author="Nic Morris" Comment="Changed Bank and Clip attribute IDs to Folder and File respectively for compatibility." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mixer_Mode" Name="Mixer Mode" Description="" Group="I">
      <Locate Locate="13" PowerOn="13" />
      <Function ID="1" Name="Additive Dissolve" Display="'Additive Dissolve'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Subtractive Dissolve" Display="'Subtractive Dissolve'" Dmx="10~10" Intensity="0~0" />
      <Function ID="3" Name="Darken" Display="'Darken'" Dmx="20~20" Intensity="0~0" />
      <Function ID="4" Name="Lighten" Display="'Lighten'" Dmx="30~30" Intensity="0~0" />
      <Function ID="5" Name="Softlight" Display="'Softlight'" Dmx="40~40" Intensity="0~0" />
      <Function ID="6" Name="Softlight Inv" Display="'Softlight Inv'" Dmx="50~50" Intensity="0~0" />
      <Function ID="7" Name="Hardlight" Display="'Hardlight'" Dmx="60~60" Intensity="0~0" />
      <Function ID="8" Name="Overlay" Display="'Overlay'" Dmx="70~70" Intensity="0~0" />
      <Function ID="9" Name="Difference" Display="'Difference'" Dmx="80~80" Intensity="0~0" />
      <Function ID="10" Name="Multiply" Display="'Multiply'" Dmx="90~90" Intensity="0~0" />
      <Function ID="11" Name="Screen" Display="'Screen'" Dmx="100~100" Intensity="0~0" />
      <Function ID="12" Name="Opaque" Display="'Opaque'" Dmx="110~110" Intensity="0~0" />
      <Function ID="13" Name="Sprite" Display="'Sprite'" Dmx="120~120" Intensity="0~0" />
      <Function ID="14" Name="Luminance Key" Display="'Luminance Key'" Dmx="130~130" Intensity="0~0" />
      <Function ID="15" Name="Matte" Display="'Matte'" Dmx="140~140" Intensity="0~0" />
      <Function ID="16" Name="Alpha" Display="'Alpha'" Dmx="150~150" Intensity="0~0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Live_Mask" Name="Live Mask" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Mask" Display="'%.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Intensity="0~0" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Intensity="0~0" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Negative" Name="Negative" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="lmh_rgb" Name="Advanced RGB" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="red_low" Name="Red Low" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>

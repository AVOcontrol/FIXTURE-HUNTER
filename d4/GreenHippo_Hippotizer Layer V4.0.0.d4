    <Attribute ID="Effect1Level" Name="Effect 1 Level" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Eff1Param1" Name="Eff 1 Param 1" Description="" Group="E">
      <Locate Locate="67:0" PowerOn="67:0" />
      <Condition Name="Amount" ID="1" If="'Effect1'==2" />
      <Condition Name="Mask Select" ID="2" If="'Effect1'==4" />
      <Condition Name="Saturation" ID="3" If="'Effect1'==5" />
      <Condition Name="Size" ID="4" If="'Effect1'==6||'Effect1'==28||'Effect1'==33||'Effect1'==75||'Effect1'==98" />
      <Condition Name="Threshold" ID="5" If="'Effect1'==7" />
      <Condition Name="X" ID="6" If="'Effect1'==8||'Effect1'==12||'Effect1'==46||'Effect1'==74||'Effect1'==96" />
      <Condition Name="Left" ID="7" If="'Effect1'==9||'Effect1'==60" />
      <Condition Name="Hue" ID="8" If="'Effect1'==10||'Effect1'==26||'Effect1'==87" />
      <Condition Name="Squash X" ID="9" If="'Effect1'==11" />
      <Condition Name="Red" ID="10" If="'Effect1'==13||'Effect1'==19||'Effect1'==36" />
      <Condition Name="Shift A" ID="11" If="'Effect1'==14" />
      <Condition Name="Frequency" ID="12" If="'Effect1'==15||'Effect1'==53||'Effect1'==83" />
      <Condition Name="Width" ID="13" If="'Effect1'==16||'Effect1'==49||'Effect1'==85" />
      <Condition Name="Filter" ID="14" If="'Effect1'==17" />
      <Condition Name="Col 1" ID="15" If="'Effect1'==18" />
      <Condition Name="Bloom" ID="16" If="'Effect1'==20" />
      <Condition Name="Stripes" ID="17" If="'Effect1'==21" />
      <Condition Name="Mymul" ID="18" If="'Effect1'==22" />
      <Condition Name="K1" ID="19" If="'Effect1'==23" />
      <Condition Name="Zoom" ID="20" If="'Effect1'==24||'Effect1'==55" />
      <Condition Name="Colouredness" ID="21" If="'Effect1'==25" />
      <Condition Name="Rings" ID="22" If="'Effect1'==27" />
      <Condition Name="Bump" ID="23" If="'Effect1'==29" />
      <Condition Name="Density" ID="24" If="'Effect1'==30" />
      <Condition Name="Pixels" ID="25" If="'Effect1'==31" />
      <Condition Name="Flicker" ID="26" If="'Effect1'==32" />
      <Condition Name="Shift X" ID="27" If="'Effect1'==34||'Effect1'==80||'Effect1'==81||'Effect1'==99" />
      <Condition Name="Blue2Red" ID="28" If="'Effect1'==35" />
      <Condition Name="D1" ID="29" If="'Effect1'==37" />
      <Condition Name="Flora" ID="30" If="'Effect1'==38" />
      <Condition Name="Flip X" ID="31" If="'Effect1'==39" />
      <Condition Name="Leaves" ID="32" If="'Effect1'==40" />
      <Condition Name="Rot" ID="33" If="'Effect1'==41" />
      <Condition Name="Glass" ID="34" If="'Effect1'==42" />
      <Condition Name="Wave A" ID="35" If="'Effect1'==43" />
      <Condition Name="Cam" ID="36" If="'Effect1'==44||'Effect1'==139||'Effect1'==140" />
      <Condition Name="Anim Rot" ID="37" If="'Effect1'==45" />
      <Condition Name="Flower" ID="38" If="'Effect1'==47" />
      <Condition Name="Twist" ID="39" If="'Effect1'==48" />
      <Condition Name="Numwaves" ID="40" If="'Effect1'==50" />
      <Condition Name="Wave" ID="41" If="'Effect1'==51" />
      <Condition Name="Speed" ID="42" If="'Effect1'==52||'Effect1'==54||'Effect1'==57||'Effect1'==58||'Effect1'==70||'Effect1'==82||'Effect1'==86||'Effect1'==89||'Effect1'==97||'Effect1'==138" />
      <Condition Name="Direction" ID="43" If="'Effect1'==56" />
      <Condition Name="Vert" ID="44" If="'Effect1'==59" />
      <Condition Name="Gamma" ID="45" If="'Effect1'==61||'Effect1'==62||'Effect1'==63||'Effect1'==64||'Effect1'==65||'Effect1'==66||'Effect1'==67||'Effect1'==73||'Effect1'==77||'Effect1'==78||'Effect1'==84||'Effect1'==88" />

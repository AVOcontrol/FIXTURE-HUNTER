      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />

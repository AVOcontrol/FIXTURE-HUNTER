    <Attribute ID="Generator_Param_1" Name="Gen Par 1" Description="" Group="B">
      <Locate Locate="13:0" PowerOn="13:0" />
      <Condition Name="Red" ID="1" If="'Generator_Select'==1" />
      <Condition Name="Hue" ID="2" If="'Generator_Select'==2" />
      <Condition Name="X" ID="3" If="'Generator_Select'==3||'Generator_Select'==4||'Generator_Select'==25" />
      <Condition Name="Speed" ID="4" If="'Generator_Select'==5||'Generator_Select'==6||'Generator_Select'==7||'Generator_Select'==8||'Generator_Select'==9||'Generator_Select'==10||'Generator_Select'==11||'Generator_Select'==12||'Generator_Select'==17||'Generator_Select'==19||'Generator_Select'==20||'Generator_Select'==21||'Generator_Select'==22||'Generator_Select'==23||'Generator_Select'==26" />
      <Condition Name="Lightness" ID="5" If="'Generator_Select'==13||'Generator_Select'==15||'Generator_Select'==24" />
      <Condition Name="RotSpeed" ID="6" If="'Generator_Select'==14" />
      <Condition Name="Density" ID="7" If="'Generator_Select'==16" />
      <Condition Name="Hue 1" ID="8" If="'Generator_Select'==18" />
      <Condition Name="Tsec" ID="9" If="'Generator_Select'==27" />
      <Condition Name="Block 1" ID="10" If="'Generator_Select'==28" />
      <Condition Name="Bar Width" ID="11" If="'Generator_Select'==29" />
      <Condition Name="Scale" ID="12" If="'Generator_Select'==30" />
      <Else ID="13" />
      <Function ID="1" Name="Red" Display="'Red %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="X" Display="'X %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Lightness" Display="'Lightness %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="RotSpeed" Display="'RotSpeed %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Density" Display="'Density %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Hue 1" Display="'Hue 1 %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="Tsec" Display="'Tsec %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="10" Name="Block 1" Display="'Block 1 %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="11" Name="Bar Width" Display="'Bar Width %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="12" Name="Scale" Display="'Scale %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="13" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Generator_Param_2" Name="Gen Par 2" Description="" Group="B">
      <Locate Locate="15:0" PowerOn="15:0" />

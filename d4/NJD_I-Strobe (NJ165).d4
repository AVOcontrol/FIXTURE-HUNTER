<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="I-Strobe (NJ165)" ShortName="I-Strobe" Company="NJD" Version="1">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>9ad20ccd-9342-402e-838a-31c7291ae9a0</Thumbnail>
  <History Date="10-12-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1bf14b17-83d9-437b-8b1c-a1ba046573cd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Program'&gt;2&amp;&amp;'Program'&lt;7" />
      <Else ID="1" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Independent" Display="'Independent'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Combined" Display="'Combined'" Dmx="35~69" Update="Dimmer" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="70~104" Update="Dimmer" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="105~139" Update="Dimmer" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="140~174" Update="Dimmer" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="175~209" Update="Dimmer" />
      <Function ID="7" Name="Sound 1" Display="'Sound 1'" Dmx="210~244" Update="Dimmer" />
      <Function ID="8" Name="Sound 2" Display="'Sound 2'" Dmx="245~255" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6f50db29-edd5-47fa-821e-54bfcc2b0e4b" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Program" ChannelOffset="5" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="9ad20ccd-9342-402e-838a-31c7291ae9a0"></Swatch>
  </swatchLibrary>
</Fixture>
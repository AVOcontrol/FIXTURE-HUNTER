<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="18x18 RGBAWUV Bar" ShortName="18x18 Bar" Company="Duan Fei">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="14-08-18" Author="Nic Morris" Comment="Created (limited info.  charts from customer only)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Jumping" Display="'Jumping'" Dmx="36~45" Colour="255,255,255" />
      <Function ID="3" Name="Gradient" Display="'Gradient'" Dmx="46~55" Colour="255,255,255" />
      <Function ID="4" Name="Colour" Display="'Colour'" Dmx="56~65" Colour="255,255,255" />
      <Function ID="5" Name="Transition" Display="'Transition'" Dmx="66~75" Colour="255,255,255" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="76~85" Colour="255,255,255" />
      <Function ID="7" Name="Pattern 1" Display="'Pattern 1'" Dmx="86~95" Colour="255,255,255" />
      <Function ID="8" Name="Pattern 2" Display="'Pattern 2'" Dmx="96~105" Colour="255,255,255" />
      <Function ID="9" Name="Pattern 3" Display="'Pattern 3'" Dmx="106~115" Colour="255,255,255" />
      <Function ID="10" Name="Pattern 4" Display="'Pattern 4'" Dmx="116~125" Colour="255,255,255" />
      <Function ID="11" Name="Pattern 5" Display="'Pattern 5'" Dmx="126~135" Colour="255,255,255" />
      <Function ID="12" Name="Pattern 6" Display="'Pattern 6'" Dmx="136~145" Colour="255,255,255" />
      <Function ID="13" Name="Pattern 7" Display="'Pattern 7'" Dmx="146~155" Colour="255,255,255" />
      <Function ID="14" Name="Pattern 8" Display="'Pattern 8'" Dmx="156~165" Colour="255,255,255" />
      <Function ID="15" Name="Pattern 9" Display="'Pattern 9'" Dmx="166~175" Colour="255,255,255" />
      <Function ID="16" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~185" Colour="255,255,255" />
      <Function ID="17" Name="Pattern 11" Display="'Pattern 11'" Dmx="186~195" Colour="255,255,255" />
      <Function ID="18" Name="Pattern 12" Display="'Pattern 12'" Dmx="196~205" Colour="255,255,255" />
      <Function ID="19" Name="Pattern 13" Display="'Pattern 13'" Dmx="206~215" Colour="255,255,255" />
      <Function ID="20" Name="Pattern 14" Display="'Pattern 14'" Dmx="216~225" Colour="255,255,255" />
      <Function ID="21" Name="Pattern 15" Display="'Pattern 15'" Dmx="226~235" Colour="255,255,255" />
      <Function ID="22" Name="Pattern 16" Display="'Pattern 16'" Dmx="236~245" Colour="255,255,255" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="246~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="31~45" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="46~60" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3'" Dmx="61~75" />
      <Function ID="5" Name="Pattern 4" Display="'Pattern 4'" Dmx="76~90" />
      <Function ID="6" Name="Pattern 5" Display="'Pattern 5'" Dmx="91~105" />
      <Function ID="7" Name="Pattern 6" Display="'Pattern 6'" Dmx="106~120" />
      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="121~135" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="136~150" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="151~165" />
      <Function ID="11" Name="Pattern 10" Display="'Pattern 10'" Dmx="166~180" />
      <Function ID="12" Name="Pattern 11" Display="'Pattern 11'" Dmx="181~195" />
      <Function ID="13" Name="Pattern 12" Display="'Pattern 12'" Dmx="196~210" />
      <Function ID="14" Name="Pattern 13" Display="'Pattern 13'" Dmx="211~225" />
      <Function ID="15" Name="Pattern 14" Display="'Pattern 14'" Dmx="226~240" />
      <Function ID="16" Name="Pattern 15" Display="'Pattern 15'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="UKDF1818" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="37" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="10" Wheel="8" />
      <Attribute ID="UV" ChannelOffset="11" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
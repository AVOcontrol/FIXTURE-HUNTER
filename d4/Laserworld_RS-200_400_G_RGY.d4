<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RS- 200/400/G/RGY" ShortName="RS200 400 " Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Auto-Music Mode" Display="'Auto-Music Mode'" Dmx="0~63" />
      <Function ID="2" Name="Auto-mode" Display="'Auto-mode'" Dmx="64~127" />
      <Function ID="3" Name="Music-edit mode" Display="'Music-edit mode'" Dmx="128~191" />
      <Function ID="4" Name="Manual mode" Display="'Manual mode'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~63" Colour="0,0,0" />
      <Function ID="2" Name="Colour " Display="'Colour %.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~192" Colour="0,0,0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~63" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~127" Intensity="0~0" />
      <Function ID="3" Name="Fluxion blanking" Display="'Fluxion       blanking %.f%%',0~100" Dmx="128~192" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="193~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Select" Name="Pattern Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern Group 1" Display="'Pattern Group 1'" Dmx="0~42" />
      <Function ID="2" Name="Pattern Group 2" Display="'Pattern Group 2'" Dmx="43~85" />
      <Function ID="3" Name="Pattern Group 3" Display="'Pattern Group 3'" Dmx="86~128" />
      <Function ID="4" Name="Pattern Group 4" Display="'Pattern Group 4'" Dmx="129~171" />
      <Function ID="5" Name="Pattern Group 5" Display="'Pattern Group 5'" Dmx="172~214" />
      <Function ID="6" Name="Pattern group 6" Display="'Pattern Group 6 - Cartoons'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Patterns" Display="'Patterns %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~63" />
      <Function ID="2" Name="Rotate Horizontaly" Display="'Rot Horizontal %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Rotate Vertical" Display="'Rot Vertical  %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Rotate H &amp; V" Display="'Rotate H &amp; V  %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dot_Rotation" Name="Dot Rotation" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~63" />
      <Function ID="2" Name="Rotating" Display="'Rotating'" Dmx="64~127" />
      <Function ID="3" Name="Rotating &amp; Doting" Display="'Rotating &amp;    Dotting'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Move" Name="Move" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~63" />
      <Function ID="2" Name="Move Horizontally" Display="'Move Horiz    %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Move Vertically" Display="'Move Vertical %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Move H &amp; V" Display="'Move H &amp; V    %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Extend" Name="Extend" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~63" />
      <Function ID="2" Name="Extend Horizontally" Display="'Extend Horiz  %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Extend Vertically" Display="'Extend Vert   %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Extend H &amp; V" Display="'Extend H &amp; V  %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'%.1f%%',100.0~0.0" Dmx="86~169" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="170~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Drawing_Speed" Name="Drawing Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="100%" Display="'100%'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Single Laser G, 8bit" Channels="14">
    <Import PearlRef="LZ_RS24SGL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

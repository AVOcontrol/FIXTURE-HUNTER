  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default Auto Spd" Display="'Default Auto Spd'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="27~127" />
      <Function ID="3" Name="Sound Sensitivity" Display="'Sound Sensitivity %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Group" Name="Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern Group 1" Display="'Pattern Group 1'" Dmx="0~0" Update="Pattern/Effect" />
      <Function ID="2" Name="Pattern Group 2" Display="'Pattern Group 2'" Dmx="16~31" Update="Pattern/Effect" />
      <Function ID="3" Name="Pattern Group 3" Display="'Pattern Group 3'" Dmx="32~47" Update="Pattern/Effect" />
      <Function ID="4" Name="Pattern Group 4" Display="'Pattern Group 4'" Dmx="48~63" Update="Pattern/Effect" />
      <Function ID="5" Name="Pattern Group 5" Display="'Pattern Group 5'" Dmx="64~79" Update="Pattern/Effect" />
      <Function ID="6" Name="Pattern Group 6" Display="'Pattern Group 6'" Dmx="80~95" Update="Pattern/Effect" />
      <Function ID="7" Name="Pattern Group 7" Display="'Pattern Group 7'" Dmx="96~111" Update="Pattern/Effect" />
      <Function ID="8" Name="Pattern Group 8" Display="'Pattern Group 8'" Dmx="112~127" Update="Pattern/Effect" />
      <Function ID="9" Name="Effect Group 1" Display="'Effect Group 1'" Dmx="128~143" Update="Pattern/Effect" />
      <Function ID="10" Name="Effect Group 2" Display="'Effect Group 2'" Dmx="144~159" Update="Pattern/Effect" />

      </Cell>
      <Cell ID="Cell4" Name="Tilt 4" ChannelOffset="7" ModeLink="Tilt cell" X="0" Y="3">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>

  <AtlaBase TypeID="3135294e-d60b-4c09-ba00-7a606e03791e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~64" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Tungsten" Name="Tungsten" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Emulation Off" Display="'Emulation Off'" Dmx="0~0" />
      <Function ID="2" Name="Emulation On" Display="'Emulation On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

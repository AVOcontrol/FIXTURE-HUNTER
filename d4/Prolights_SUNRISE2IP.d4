      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="172~213" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="214~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

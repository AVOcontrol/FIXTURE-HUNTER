  <AtlaBase TypeID="3f4a2f8f-065b-485c-8696-230fa8057972" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',100.0~0.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="Reserved" Display="'Reserved'" Dmx="20~49" />
      <Function ID="5" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="50~59" />
      <Function ID="6" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="60~69" />
      <Function ID="7" Name="BO P/T" Display="'BO P/T'" Dmx="70~79" />
      <Function ID="8" Name="Disable BO P/T" Display="'Disable BO P/T'" Dmx="80~89" />
      <Function ID="9" Name="Theatre Mode ON" Display="'Theatre Mode  ON'" Dmx="90~99" />
      <Function ID="10" Name="Theatre Mode OFF" Display="'Theatre Mode  OFF'" Dmx="100~109" />
      <Function ID="11" Name="Zoom mode: Wash" Display="'Zoom mode: Wash'" Dmx="110~114" />
      <Function ID="12" Name="Zoom mode: Beam" Display="'Zoom mode: Beam'" Dmx="115~119" />
      <Function ID="13" Name="Reserved" Display="'Reserved %.f',110~139" Dmx="120~139" />
      <Function ID="14" Name="Reset_PT" Display="'Reset PT'" Dmx="140~149" />
      <Function ID="15" Name="Reserved" Display="'Reserved %.f',150~179" Dmx="150~179" />
      <Function ID="16" Name="Reset_Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="17" Name="Reserved" Display="'Reserved %.f',190~199" Dmx="190~199" />
      <Function ID="18" Name="Reset_All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="19" Name="Reserved" Display="'Reserved %.f',210~255" Dmx="210~255" />
    </Attribute>
    <Attribute ID="ColourMacros" Name="Colour Macros" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="2800 K" Display="'2800 K'" Dmx="1~2" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="3200 K" Display="'3200 K'" Dmx="3~4" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="3800 K" Display="'3800 K'" Dmx="5~6" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="4200 K" Display="'4200 K'" Dmx="7~8" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="4600 K" Display="'4600 K'" Dmx="9~10" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="5000 K" Display="'5000 K'" Dmx="11~12" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="5600 K" Display="'5600 K'" Dmx="13~14" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="6300 K" Display="'6300 K'" Dmx="15~16" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Warm - Cool" Display="'Warm - Cool %.f%%',0~100" Dmx="17~247" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Rainbow Fade" Display="'Rainbow Fade'" Dmx="248~248" Update="Shutter" Colour="0,0,0" />
      <Function ID="12" Name="Rainbow Effect" Display="'Rainbow Effect'" Dmx="249~249" Update="Shutter" Colour="0,0,0" />
      <Function ID="13" Name="Zone Effect" Display="'Zone Effect %.f',1~6" Dmx="250~255" Update="Shutter" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Z4 Strobe %" Display="'Zone 4 Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="5" Name="Zone Effects Fwd" Display="'Zone Effects Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="6" Name="Zone Effects Back" Display="'Zone Effects  Back %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="8" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
      <Function ID="9" Name="Rnd Zone" Display="'Rnd Zone %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="10" Name="Rnd Zone Strobe" Display="'Random Zone   Strobe %.f%%',100~0" Dmx="176~191" Intensity="0~0" />
      <Function ID="11" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:50" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,255" />

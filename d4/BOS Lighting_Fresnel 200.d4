  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="aeb9ec9b-107e-49d7-8b3c-a7797c4dc42f" />
  <Control>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:3200" PowerOn="1:3200" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',3200~5600" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1st Level Delay Function" Display="'1st Level Delay Function'" Dmx="0~0" />
      <Function ID="2" Name="2nd Level Delay Function" Display="'2nd Level Delay Function'" Dmx="64~127" />
      <Function ID="3" Name="3rd Level Delay Function" Display="'3rd Level Delay Function'" Dmx="128~191" />
      <Function ID="4" Name="4th Level Delay Function" Display="'4th Level Delay Function'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="e9448137-9bb6-44fb-b420-94df3c74fce6">

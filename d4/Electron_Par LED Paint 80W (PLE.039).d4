      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="2~19" Colour="255,255,255" />
      <Function ID="3" Name="Transient" Display="'Transient %.f%%',0~100" Dmx="20~39" Colour="255,255,255" />
      <Function ID="4" Name="Free" Display="'Free %.f%%',0~100" Dmx="40~59" Colour="255,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~79" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~99" Colour="128,0,255" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="100~119" Colour="128,255,0" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="120~139" Colour="255,128,0" />
      <Function ID="9" Name="Red On/Off" Display="'Red On/Off'" Dmx="140~159" Colour="255,0,0" />
      <Function ID="10" Name="Green On/Off" Display="'Green On/Off'" Dmx="160~179" Colour="0,255,0" />
      <Function ID="11" Name="Blue On/Off" Display="'Blue On/Off'" Dmx="180~199" Colour="0,0,255" />
      <Function ID="12" Name="Light Yellow On/Off" Display="'Light Yellow On/Off'" Dmx="200~219" Colour="255,255,128" />
      <Function ID="13" Name="Cyan On/Off" Display="'Cyan On/Off'" Dmx="220~229" Colour="0,255,255" />
      <Function ID="14" Name="White On/Off" Display="'White On/Off'" Dmx="230~249" Colour="255,255,255" />

      <Function ID="11" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="22~24" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Org/ Yel" Display="'Org/ Yel'" Dmx="28~30" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="34~36" WheelPosition="3" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="40~42" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="46~48" WheelPosition="5" Colour="0,0,255" />
      <Function ID="16" Name="Mag/ L Blu" Display="'Mag/ L Blu'" Dmx="52~54" WheelPosition="6" Colour="255,0,255" />

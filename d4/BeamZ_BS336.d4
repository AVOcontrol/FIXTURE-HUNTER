  <AtlaBase TypeID="ce66d5b1-02de-4d3b-a951-f8bd951fa9c8" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="RGB_FX_Spd" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="6~10" Update="RGB_FX_Spd" />
      <Function ID="3" Name="Breathing" Display="'Breathing'" Dmx="11~15" Update="RGB_FX_Spd" />
      <Function ID="4" Name="Jump Change" Display="'Jump Change'" Dmx="16~20" Update="RGB_FX_Spd" />
      <Function ID="5" Name="Gradient Change" Display="'Gradient Change'" Dmx="21~25" Update="RGB_FX_Spd" />
      <Function ID="6" Name="Pulse Change" Display="'Pulse Change'" Dmx="26~30" Update="RGB_FX_Spd" />
      <Function ID="7" Name="Auto 1 (Cycle Auto)" Display="'Auto 1 (Cycle Auto)'" Dmx="31~40" Update="RGB_FX_Spd" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="41~50" Update="RGB_FX_Spd" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="51~60" Update="RGB_FX_Spd" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="61~70" Update="RGB_FX_Spd" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="71~80" Update="RGB_FX_Spd" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="81~90" Update="RGB_FX_Spd" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="91~100" Update="RGB_FX_Spd" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="101~110" Update="RGB_FX_Spd" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="111~120" Update="RGB_FX_Spd" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="121~130" Update="RGB_FX_Spd" />
      <Function ID="17" Name="Auto 11" Display="'Auto 11'" Dmx="131~140" Update="RGB_FX_Spd" />
      <Function ID="18" Name="Auto 12" Display="'Auto 12'" Dmx="141~150" Update="RGB_FX_Spd" />
      <Function ID="19" Name="Auto 13" Display="'Auto 13'" Dmx="151~160" Update="RGB_FX_Spd" />
      <Function ID="20" Name="Auto 14" Display="'Auto 14'" Dmx="161~170" Update="RGB_FX_Spd" />
      <Function ID="21" Name="Auto 15" Display="'Auto 15'" Dmx="171~180" Update="RGB_FX_Spd" />
      <Function ID="22" Name="Auto 16" Display="'Auto 16'" Dmx="181~190" Update="RGB_FX_Spd" />
      <Function ID="23" Name="Auto 17" Display="'Auto 17'" Dmx="191~200" Update="RGB_FX_Spd" />
      <Function ID="24" Name="Auto 18" Display="'Auto 18'" Dmx="201~210" Update="RGB_FX_Spd" />
      <Function ID="25" Name="Auto 19" Display="'Auto 19'" Dmx="211~220" Update="RGB_FX_Spd" />
      <Function ID="26" Name="Auto 20" Display="'Auto 20'" Dmx="221~229" Update="RGB_FX_Spd" />
      <Function ID="27" Name="Sound 1" Display="'Sound 1'" Dmx="230~239" Update="RGB_FX_Spd" />
      <Function ID="28" Name="Sound 2" Display="'Sound 2'" Dmx="240~249" Update="RGB_FX_Spd" />
      <Function ID="29" Name="Sound 3" Display="'Sound 3'" Dmx="250~255" Update="RGB_FX_Spd" />
    </Attribute>
    <Attribute ID="RGB_FX_Spd" Name="RGB FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Col" ID="2" If="'RGB_FX'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour0" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_FX_Colour" Name="RGB FX Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~159" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="192~223" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White_FX" Name="White FX" Description="" Group="E">

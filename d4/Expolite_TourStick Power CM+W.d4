  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="18-07-12" Author="Peter Budd" Comment="Created" />
  <History Date="24-05-13" Author="Peter Budd" Comment="Edited" />
  <History Date="10-06-13" Author="Peter Budd" Comment="Created from the Miltec Batten2." />
  <History Date="02-08-13" Author="Peter Budd" Comment="Created from the Elation ELED QW Strip." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="100~109" Intensity="0~0" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="180~189" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green" Display="'Red/Green %.f%%',0~100" Dmx="11~30" Colour="255,0,0" />
      <Function ID="3" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="31~50" Colour="255,255,0" />
      <Function ID="4" Name="Green/Blue" Display="'Green/Blue %.f%%',0~100" Dmx="51~70" Colour="0,255,0" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green %.f%%',0~100" Dmx="71~90" Colour="0,255,255" />
      <Function ID="6" Name="Blue/Red" Display="'Blue/Red %.f%%',0~100" Dmx="91~110" Colour="0,0,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue %.f%%',0~100" Dmx="111~130" Colour="255,0,255" />
      <Function ID="8" Name="Red/GB" Display="'Red/GB %.f%%',0~100" Dmx="131~150" Colour="255,0,0" />
      <Function ID="9" Name="Blue/RG" Display="'Blue/RG %.f%%',0~100" Dmx="151~170" Colour="0,0,255" />
      <Function ID="10" Name="RGBW" Display="'RGBW'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="11" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="12" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />

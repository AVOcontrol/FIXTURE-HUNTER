<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DoppelBar Pix" ShortName="DpplBarPix" Company="Prost Lighting" Version="0">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>51fbdfa5-a3a1-49fb-b2b2-baac60e0540d</Thumbnail>
  <History Date="12-10-21" Author="Nic Morris" Comment="Created (confusing documentation.  it is not clear what Assistant dimming is.  no pixel layout information)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Aux-R Red 255" Display="'Aux-R Red 255'" Dmx="6~25" />
      <Function ID="3" Name="Aux-G Green 255" Display="'Aux-G Green 255'" Dmx="26~50" />
      <Function ID="4" Name="Aux-B Blue 255" Display="'Aux-B Blue 255'" Dmx="51~75" />
      <Function ID="5" Name="R red 255" Display="'R red 255'" Dmx="76~100" />
      <Function ID="6" Name="G green 255" Display="'G green 255'" Dmx="101~125" />
      <Function ID="7" Name="B blue 255" Display="'B blue 255'" Dmx="126~150" />
      <Function ID="8" Name="R+R-Aux red 255" Display="'R+R-Aux red 255'" Dmx="151~175" />
      <Function ID="9" Name="G+G-Aux Green 255" Display="'G+G-Aux Green 255'" Dmx="176~200" />
      <Function ID="10" Name="B+B-Aux blue 255" Display="'B+B-Aux blue 255'" Dmx="201~225" />
      <Function ID="11" Name="Full Bright" Display="'Full Bright'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Preset_FX" Name="Preset FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Preset_FX_Spd" Name="Preset FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="AssistantDim_1" Name="AssistantDim 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="AssistantDim_2" Name="AssistantDim 2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="110~139" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>65b0e761-a473-4587-adaf-0d74518f0460</Swatch>

      </Function>
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>4ce738a6-4d81-44a3-9f96-f84fc6125062</Swatch>

      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal" Display="'Normal'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:6000" PowerOn="1:6000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3200~6000" Dmx="255~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="21,22,23,24" If="'Colour1Func'==4" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="185~188" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="181~184" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="177~180" WheelPosition="3" Colour="255,128,0" />
      <Function ID="5" Name="Minus Green" Display="'Minus Green'" Dmx="173~176" WheelPosition="4" Colour="255,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="169~172" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Congo" Display="'Congo'" Dmx="165~168" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="161~164" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op - Blu" Display="'Op - Blu %.f%%',0~100" Dmx="0~20" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Blu - Grn" Display="'Blu - Grn %.f%%',0~100" Dmx="20~40" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="40~60" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Org - M Grn" Display="'Org - M Grn %.f%%',0~100" Dmx="60~80" WheelPosition="3" Colour="255,128,0" />
      <Function ID="13" Name="M Grn- Yel" Display="'M Grn- Yel %.f%%',0~100" Dmx="80~100" WheelPosition="4" Colour="0,255,128" />
      <Function ID="14" Name="Yel - Cgo" Display="'Yel - Cgo %.f%%',0~100" Dmx="100~120" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="Cgo - Rd" Display="'Cgo - Rd %.f%%',0~100" Dmx="120~140" WheelPosition="6" Colour="0,0,128" />
      <Function ID="16" Name="Rd - Op" Display="'Rd - Op %.f%%',0~100" Dmx="140~160" WheelPosition="7" Colour="255,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="22" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="23" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="0,0,0" />
      <Function ID="24" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="0,0,0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="6" PowerOn="6" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5" If="'Gobo1Func'==1" />
      <Condition Name="Fixed Spin" ID="6,7,8,9,10" If="'Gobo1Func'==2" />
      <Condition Name="Shake" ID="11,12,13,14,15" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Gobo1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>4ce738a6-4d81-44a3-9f96-f84fc6125062</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Eyeball)" Display="'Gobo 1 (Eyeball)'" Dmx="10~14" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>f7398b8c-2b38-466f-9f4a-875f6af880d5</Swatch>

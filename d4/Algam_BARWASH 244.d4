      <Function ID="10" Name="Colour Chase Effect 1" Display="'Colour Chase Effect 1'" Dmx="82~91" />
      <Function ID="11" Name="Colour Chase Effect 2" Display="'Colour Chase Effect 2'" Dmx="92~101" />

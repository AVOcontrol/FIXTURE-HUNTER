  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="13-05-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~30" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~40" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="41~50" />
      <Function ID="5" Name="White" Display="'White'" Dmx="51~60" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="61~70" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="71~80" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="81~90" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="91~100" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="101~110" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="111~120" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="121~130" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="131~140" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="141~150" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="151~160" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="161~170" />
      <Function ID="17" Name="Auto 1" Display="'Auto 1'" Dmx="171~180" />
      <Function ID="18" Name="Auto 2" Display="'Auto 2'" Dmx="181~190" />
      <Function ID="19" Name="Auto 3" Display="'Auto 3'" Dmx="191~200" />
      <Function ID="20" Name="Auto 4" Display="'Auto 4'" Dmx="201~210" />
      <Function ID="21" Name="Auto 5" Display="'Auto 5'" Dmx="211~220" />
      <Function ID="22" Name="No" Display="'No'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Stepless" Name="Pan Stepless" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="CW Spin" Display="'CW Spin %.1f%%',0.0~100.0" Dmx="6~130" />
      <Function ID="3" Name="CCW Spin" Display="'CCW Spin %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">

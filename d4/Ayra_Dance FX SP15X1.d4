    </Attribute>
    <Attribute ID="Colour_Preset" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~49" Colour="255,255,0" />
      <Function ID="6" Name="Salmon" Display="'Salmon'" Dmx="50~59" Colour="255,150,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~69" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="70~79" Colour="255,0,255" />
      <Function ID="9" Name="Green Yellow" Display="'Green Yellow'" Dmx="80~89" Colour="180,180,0" />
      <Function ID="10" Name="Orange" Display="'Orange'" Dmx="90~99" Colour="255,128,0" />
      <Function ID="11" Name="Turquoise" Display="'Turquoise'" Dmx="100~109" Colour="0,255,128" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="110~119" Colour="128,255,0" />
      <Function ID="13" Name="Dark Blue" Display="'Dark Blue'" Dmx="120~129" Colour="0,0,180" />
      <Function ID="14" Name="Lavender" Display="'Lavender'" Dmx="130~139" Colour="255,128,255" />
      <Function ID="15" Name="Light Blue" Display="'Light Blue'" Dmx="140~149" Colour="0,128,255" />
      <Function ID="16" Name="Dark Orange" Display="'Dark Orange'" Dmx="150~159" Colour="255,100,0" />
      <Function ID="17" Name="Pink" Display="'Pink'" Dmx="160~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Sound Fade" Display="'Sound Fade %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Sound Jump" Display="'Sound Jump %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
  </Control>

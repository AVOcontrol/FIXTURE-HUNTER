      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="50~59" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="70~79" Colour="0,255,255" />
      <Function ID="9" Name="Dark Orange" Display="'Dark Orange'" Dmx="80~89" Colour="255,100,0" />
      <Function ID="10" Name="Green Yellow" Display="'Green Yellow'" Dmx="90~99" Colour="180,180,0" />
      <Function ID="11" Name="Salmon" Display="'Salmon'" Dmx="100~109" Colour="255,150,150" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="110~119" Colour="0,255,128" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="120~129" Colour="128,255,0" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="130~139" Colour="255,128,0" />
      <Function ID="15" Name="Straw" Display="'Straw'" Dmx="140~149" Colour="255,250,230" />
      <Function ID="16" Name="Lavender" Display="'Lavender'" Dmx="150~159" Colour="255,128,255" />
      <Function ID="17" Name="Light Blue" Display="'Light Blue'" Dmx="160~169" Colour="0,128,255" />
      <Function ID="18" Name="Dark Blue" Display="'Dark Blue'" Dmx="170~179" Colour="0,0,180" />
      <Function ID="19" Name="Pink" Display="'Pink'" Dmx="180~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Blend" Display="'Col Blend %.1f%%',0.0~100.0" Dmx="10~129" />
      <Function ID="3" Name="Col Change" Display="'Col Change %.1f%%',0.0~100.0" Dmx="130~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="White 4300K" Display="'White 4300K'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="130~169" Colour="255,255,255" />

      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="96~175" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="176~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Half Power" Display="'Half Power'" Dmx="51~100" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="101~150" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="151~200" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="245~255" />

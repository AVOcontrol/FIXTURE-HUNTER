<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Color 1000" ShortName="StCol 1000" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-01-03" Author="D.Shelton" Comment="Created" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="20-08-03" Author="D.Shelton" Comment="Updated Pan/Tilt Channels" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. Pan + Tilt - 8 bit mode set as fine not course (Locate)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Frost Eff - No reference to eff positions at 86, 172, 255" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Pan F + Tilt F - 16 bit only" />
  <History Date="25-07-05" Author="D Trounce" Comment="Error: Frost channel needs to have beam shape as well as frost" />
  <History Date="25-07-05" Author="D Troucne" Comment="Error: 8 bit mode: Pan is not working correctly" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed pan and tilt problems: changed max resolution to 16 bit on both channels" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed frost to include beam shape" />
  <History Date="06-04-06" Author="Ed" Comment="Moved frost into Beam group" />
  <History Date="07-07-06" Author="Ed" Comment="Changed CMY Mixing attributes to proper CMIXes" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="12-06-17" Author="Nic Morris" Comment="Changed Atlabase ID's to CMY versions.  Revised mode names to reflect settings more clearly." />
  <History Date="12-06-17" Author="Nic Morris" Comment="Standardised highlight/lowlight.  Standardised shutter.  Increased wheel resolution.  Added palettes." />
  <Manual Filename="/manual/Clay Paky_Stage Color 1000.pdf" Summary="Creator:Clay Paky, 09-07-2001" />
  <AtlaBase TypeID="189fed25-f70e-4549-b783-0a7dc4c9cef6" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="26~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour " Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Blue w/hole" Display="'Blue w/hole'" Dmx="43~85" Colour="0,0,0" />
      <Function ID="3" Name="Yellow w/hole" Display="'Yellow w/hole'" Dmx="86~128" Colour="0,0,0" />
      <Function ID="4" Name="Green w/hole" Display="'Green w/hole'" Dmx="129~171" Colour="0,0,0" />
      <Function ID="5" Name="Magenta w/hole" Display="'Magenta w/hole'" Dmx="172~214" Colour="0,0,0" />
      <Function ID="6" Name="UV Filter" Display="'UV Filter'" Dmx="215~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Ovalizer 1" Display="'Ovalizer 1'" Dmx="86~86" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Ovalizer 2" Display="'Ovalizer 2'" Dmx="172~172" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Frost" Display="'Frost'" Dmx="255~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX (CMY)" Channels="9">
    <Import PearlRef="CPCol1000" DiamondRef="CPCol1000" WysiwygRef="" />
    <Physical>
      <Bulb Type="HMI 1200 lamp" Lumens="110000" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="43.9" />
      <Size Height="0.225" Width="0.435" Depth="1.230" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="54a5f86f-8c95-4839-8358-c930b75fbee0" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Frost" ChannelOffset="8" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="11 DMX (CMY)" Channels="11">
    <Import PearlRef="CPCol1000Hi" DiamondRef="CPCol1000Hi" WysiwygRef="" />
    <Physical>
      <Bulb Type="HMI 1200 lamp" Lumens="110000" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="43.9" />
      <Size Height="0.225" Width="0.435" Depth="1.230" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e050858b-183a-4c28-9293-d02c810c46fa" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5,10" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,11" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Frost" ChannelOffset="8" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
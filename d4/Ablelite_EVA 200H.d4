      <Function ID="2" Name="Op Pls Short" Display="'Op Pls Short'" Dmx="16~31" Update="Iris" />
      <Function ID="3" Name="Op Pls Long" Display="'Op Pls Long'" Dmx="32~47" Update="Iris" />
      <Function ID="4" Name="Cl Pls Short" Display="'Cl Pls Short'" Dmx="48~63" Update="Iris" />
      <Function ID="5" Name="Cl Pls Long" Display="'Cl Pls Long'" Dmx="64~79" Update="Iris" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Iris" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Index" ID="1" If="'Iris_Func'==1" />
      <Condition Name="Speed" ID="2" If="'Iris_Func'&gt;1&amp;&amp;'Iris_Func'&lt;6" />
      <Else ID="3" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Iris1" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="191~0" />
      <Function ID="2" Name="Op Pls Short" Display="'Op Pls Short %.f%%',0~100" Dmx="192~207" />
      <Function ID="3" Name="Op Pls Long" Display="'Op Pls Long %.f%%',0~100" Dmx="208~223" />
      <Function ID="4" Name="Cl Pls Short" Display="'Cl Pls Short %.f%%',0~100" Dmx="224~239" />
      <Function ID="5" Name="Cl Pls Long" Display="'Cl Pls Long %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Colour" Display="'Reset Colour'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="7" Name="Display Off" Display="'Display Off'" Dmx="56~63" />
      <Function ID="8" Name="Display On" Display="'Display On'" Dmx="64~71" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
  </Control>

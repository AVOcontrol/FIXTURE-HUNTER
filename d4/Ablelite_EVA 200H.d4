      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3" />
      <Condition Name="Index" ID="17" If="'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="18,19" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>fe548814-c1b3-4cb9-8a5d-10c1874ee5f6</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" WheelPosition="1">

      <Function ID="7" Name="CTO 400K" Display="'CTO 400K'" Dmx="42~48" Colour="255,240,200" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="49~55" Colour="0,255,255" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="56~62" Colour="255,0,255" />
      <Function ID="10" Name="Lime" Display="'Lime'" Dmx="63~64" Colour="0,200,0" />
      <Function ID="11" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />

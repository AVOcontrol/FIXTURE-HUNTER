    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" />
      <Function ID="5" Name="RGB Gradient" Display="'RGB Gradient'" Dmx="128~159" />
      <Function ID="6" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="160~191" />
      <Function ID="7" Name="4 Col Jump Change" Display="'4 Col Jump Change'" Dmx="192~223" />
      <Function ID="8" Name="Multi-Col Jump Change" Display="'Multi-Col Jump Change'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="DIMMER0" Display="'DIMMER0'" Dmx="6~55" />
      <Function ID="3" Name="DIMMER1" Display="'DIMMER1'" Dmx="56~105" />
      <Function ID="4" Name="DIMMER2" Display="'DIMMER2'" Dmx="106~155" />
      <Function ID="5" Name="DIMMER3" Display="'DIMMER3'" Dmx="156~205" />
      <Function ID="6" Name="DIMMER4" Display="'DIMMER4'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="RGB_Col_Mix" Name="RGB Col Mix" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

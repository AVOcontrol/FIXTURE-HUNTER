<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Star Cluster Ultimate" ShortName="Str Clster" Company="KAM">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="03-01-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Control" Description="" Group="S">
      <Locate Locate="5" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~54" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="55~109" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="110~164" />
      <Function ID="4" Name="Remote" Display="'Remote'" Dmx="165~219" />
      <Function ID="5" Name="Manual" Display="'Manual'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="0~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="101~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~70" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="71~140" Colour="0,255,0" />
      <Function ID="3" Name="Red + Green" Display="'Red + Green'" Dmx="141~255" Colour="255,255,0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="KA_StClsUlt" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Gobo1Rot" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="5 Head Rogue Moving Head Bar Light" ShortName="5 Head Bar" Company="WEN China">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="23-08-17" Author="Nic Morris" Comment="Created (poor documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~249" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~249" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="31 DMX" Channels="31">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Pan" ChannelOffset="3,4" Wheel="2" />
        <Attribute ID="Pan_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="Pan_Spin" ChannelOffset="6" Wheel="19" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Tilt_Speed" Wheel="26" />
        <Attribute ID="Tilt_Spin" Wheel="20" />
        <Attribute ID="Colour1" Wheel="8" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Tilt_Spin" TargetId="Tilt_Spin" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="12" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Tilt_Spin" TargetId="Tilt_Spin" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="17" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Tilt_Spin" TargetId="Tilt_Spin" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="22" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Tilt_Spin" TargetId="Tilt_Spin" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="27" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Tilt_Spin" TargetId="Tilt_Spin" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="5" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1,2" Wheel="3" />
      <Attribute ID="Tilt_Speed" ChannelOffset="3" Wheel="26" />
      <Attribute ID="Tilt_Spin" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
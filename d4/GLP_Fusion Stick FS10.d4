      <Condition Name="Scroll" ID="35,36,37,38,39" If="'Colour1Func'==2" />
      <Condition Name="White" ID="40,41,42,43,44,45" If="'Colour1Func'==3" />
      <Else ID="46" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Moroccan Pink" Display="'Moroccan Pink'" Dmx="6~10" Colour="255,150,150" />

  <Thumbnail>6b634d6e-eeb9-440a-9681-7c0533f2d4f4</Thumbnail>
  <History Date="05-10-18" Author="Nic Morris" Comment="Created (note changing DMX mode via control channel is not supported)" />
  <History Date="25-07-19" Author="Nic Morris" Comment="Created from Ehrgeiz Fusion 2 (GLP have aquired Ehrgeiz and rebranded this - manual linked from GLP product page is currently still Ehrgeiz Fusion 2 and therefore identical.  Assumed the same but with 10 cells instead of 20.  Suspect pattern functions may be wrong)" />
  <History Date="26-07-19" Author="Nic Morris" Comment="Corrected manufacturer name." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="06f98ebc-7ac7-46bb-a32c-69c60c0b475d" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />

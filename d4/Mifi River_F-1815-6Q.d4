  <AtlaBase TypeID="685a43cb-e476-4040-8b31-7c57636e9046" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Col Jump" Display="'Col Jump'" Dmx="36~45" Update="Effect" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="46~55" Update="Effect" />
      <Function ID="4" Name="Colour" Display="'Colour'" Dmx="56~65" Update="Effect" />
      <Function ID="5" Name="Jump" Display="'Jump'" Dmx="66~75" Update="Effect" />
      <Function ID="6" Name="Fade" Display="'Fade'" Dmx="76~85" Update="Effect" />
      <Function ID="7" Name="Effect 1" Display="'Effect 1'" Dmx="86~95" Update="Effect" />
      <Function ID="8" Name="Effect 2" Display="'Effect 2'" Dmx="96~105" Update="Effect" />
      <Function ID="9" Name="Effect 3" Display="'Effect 3'" Dmx="106~115" Update="Effect" />
      <Function ID="10" Name="Effect 4" Display="'Effect 4'" Dmx="116~125" Update="Effect" />
      <Function ID="11" Name="Effect 5" Display="'Effect 5'" Dmx="126~135" Update="Effect" />
      <Function ID="12" Name="Effect 6" Display="'Effect 6'" Dmx="136~145" Update="Effect" />
      <Function ID="13" Name="Effect 7" Display="'Effect 7'" Dmx="146~155" Update="Effect" />
      <Function ID="14" Name="Effect 8" Display="'Effect 8'" Dmx="156~165" Update="Effect" />
      <Function ID="15" Name="Effect 9" Display="'Effect 9'" Dmx="166~175" Update="Effect" />
      <Function ID="16" Name="Effect 10" Display="'Effect 10'" Dmx="176~185" Update="Effect" />
      <Function ID="17" Name="Effect 11" Display="'Effect 11'" Dmx="186~195" Update="Effect" />
      <Function ID="18" Name="Effect 12" Display="'Effect 12'" Dmx="196~205" Update="Effect" />
      <Function ID="19" Name="Effect 13" Display="'Effect 13'" Dmx="206~215" Update="Effect" />
      <Function ID="20" Name="Effect 14" Display="'Effect 14'" Dmx="216~225" Update="Effect" />
      <Function ID="21" Name="Effect 15" Display="'Effect 15'" Dmx="226~235" Update="Effect" />
      <Function ID="22" Name="Effect 16" Display="'Effect 16'" Dmx="236~245" Update="Effect" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="246~255" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Direction" ID="3,4" If="'Auto'&gt;6&amp;&amp;'Auto'&lt;23" />
      <Else ID="1,2" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~250" Dmx="6~255" />
      <Function ID="3" Name="Left" Display="'Left'" Dmx="0~0" />
      <Function ID="4" Name="Right" Display="'Right'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~54" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="55~154" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="155~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

      <Function ID="16" Name="1/ 2" Display="'1/ 2'" Dmx="64~68" WheelPosition="1" Colour="0,0,0" />
      <Function ID="17" Name="2/ 3" Display="'2/ 3'" Dmx="69~72" WheelPosition="2" Colour="0,0,0" />

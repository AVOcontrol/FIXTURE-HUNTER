  <Control>
    <Attribute ID="Play_Mode" Name="Play Mode" Description="" Group="S">
      <Locate Locate="3" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Speed/Power, Show/Size/Tm_1, Freq/Pattern_1, Col_Pattern_1, Trace_Rate_1, Pattern/Zoom_1, Flow/Y-Rot_1, Speed/X-Rot_1" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="63~127" Update="Speed/Power, Show/Size/Tm_1, Freq/Pattern_1, Col_Pattern_1, Trace_Rate_1, Pattern/Zoom_1, Flow/Y-Rot_1, Speed/X-Rot_1" />
      <Function ID="3" Name="Double Pattern" Display="'Double Pattern'" Dmx="128~191" Update="Speed/Power, Show/Size/Tm_1, Freq/Pattern_1, Col_Pattern_1, Trace_Rate_1, Pattern/Zoom_1, Flow/Y-Rot_1, Speed/X-Rot_1" />
      <Function ID="4" Name="Wave" Display="'Wave'" Dmx="192~255" Update="Speed/Power, Show/Size/Tm_1, Freq/Pattern_1, Col_Pattern_1, Trace_Rate_1, Pattern/Zoom_1, Flow/Y-Rot_1, Speed/X-Rot_1" />
    </Attribute>
    <Attribute ID="Speed/Power" Name="Speed/Power" Description="" Group="S">
      <Locate Locate="6" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Auto" ID="2" If="'Play_Mode'==2" />
      <Condition Name="Wave" ID="3,4" If="'Play_Mode'==4" />
      <Condition Name="Double Pattern" ID="5,6" If="'Play_Mode'==3" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="4" Name="Laser On" Display="'Laser On'" Dmx="255~255" />
      <Function ID="5" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="6" Name="Laser On" Display="'Laser On'" Dmx="255~255" />
    </Attribute>

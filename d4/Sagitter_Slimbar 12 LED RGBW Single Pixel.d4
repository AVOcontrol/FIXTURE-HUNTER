  <AtlaBase TypeID="4e386b14-ab9d-4bf8-a283-e40dfc9b81ee" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset Dimmer 1" Display="'Preset Dimmer 1'" Dmx="0~0" />
      <Function ID="2" Name="Preset Dimmer 2" Display="'Preset Dimmer 2'" Dmx="71~140" />
      <Function ID="3" Name="Preset Dimmer 3" Display="'Preset Dimmer 3'" Dmx="141~200" />
      <Function ID="4" Name="Preset Dimmer 4" Display="'Preset Dimmer 4'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~10" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="11~13" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="14~17" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="18~20" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="21~23" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="24~26" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="27~30" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="31~35" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="36~40" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="41~50" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="51~60" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="61~70" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="71~80" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="81~90" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="91~100" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="101~110" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 17" Display="'Auto 17'" Dmx="111~120" Update="Auto_Spd" />
      <Function ID="19" Name="Sound 1" Display="'Sound 1'" Dmx="121~130" Update="Auto_Spd" />
      <Function ID="20" Name="Sound 2" Display="'Sound 2'" Dmx="131~140" Update="Auto_Spd" />
      <Function ID="21" Name="Sound 3" Display="'Sound 3'" Dmx="141~150" Update="Auto_Spd" />
      <Function ID="22" Name="Sound 4" Display="'Sound 4'" Dmx="151~160" Update="Auto_Spd" />
      <Function ID="23" Name="Sound 5" Display="'Sound 5'" Dmx="161~170" Update="Auto_Spd" />
      <Function ID="24" Name="Sound 6" Display="'Sound 6'" Dmx="171~180" Update="Auto_Spd" />
      <Function ID="25" Name="Sound 7" Display="'Sound 7'" Dmx="181~200" Update="Auto_Spd" />
      <Function ID="26" Name="Sound 8" Display="'Sound 8'" Dmx="201~210" Update="Auto_Spd" />

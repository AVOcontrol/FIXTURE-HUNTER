  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="179713bb-437c-4d4e-955b-b855ae862b9c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~254" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~13" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="14~17" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="18~21" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="22~25" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="26~29" Colour="255,255,255" />
      <Function ID="7" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="30~33" Colour="255,255,255" />
      <Function ID="8" Name="RGBWA" Display="'RGBWA'" Dmx="34~37" Colour="255,255,255" />
      <Function ID="9" Name="R+G" Display="'R+G'" Dmx="38~41" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="42~45" Colour="255,255,255" />
      <Function ID="11" Name="R+W" Display="'R+W'" Dmx="46~49" Colour="255,255,255" />
      <Function ID="12" Name="R+A" Display="'R+A'" Dmx="50~53" Colour="255,255,255" />
      <Function ID="13" Name="R+UV" Display="'R+UV'" Dmx="54~57" Colour="255,255,255" />
      <Function ID="14" Name="G+B" Display="'G+B'" Dmx="58~61" Colour="255,255,255" />
      <Function ID="15" Name="G+W" Display="'G+W'" Dmx="62~65" Colour="255,255,255" />
      <Function ID="16" Name="G+A" Display="'G+A'" Dmx="66~69" Colour="255,255,255" />
      <Function ID="17" Name="G+UV" Display="'G+UV'" Dmx="70~73" Colour="255,255,255" />
      <Function ID="18" Name="B+W" Display="'B+W'" Dmx="74~77" Colour="255,255,255" />
      <Function ID="19" Name="R+G+B" Display="'R+G+B'" Dmx="78~81" Colour="255,255,255" />
      <Function ID="20" Name="R+G+W" Display="'R+G+W'" Dmx="82~85" Colour="255,255,255" />
      <Function ID="21" Name="R+B+W" Display="'R+B+W'" Dmx="86~89" Colour="255,255,255" />
      <Function ID="22" Name="G+B+W" Display="'G+B+W'" Dmx="90~93" Colour="255,255,255" />
      <Function ID="23" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="94~99" Colour="255,255,255" />
      <Function ID="24" Name="R+G+B+W+A Snap Scroll" Display="'R+G+B+W+A Snap Scroll'" Dmx="100~129" Colour="255,255,255" />
      <Function ID="25" Name="R+G+B Fade In/Out" Display="'R+G+B Fade In/Out'" Dmx="130~159" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W+A Fade In/Out" Display="'R+G+B+W+A Fade In/Out'" Dmx="160~239" Colour="255,255,255" />
      <Function ID="27" Name="Pixel Effect" Display="'Pixel Effect'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />

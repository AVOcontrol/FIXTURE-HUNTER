  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim LED" Display="'Dim LED'" Dmx="6~127" />
      <Function ID="3" Name="Dim Halogen" Display="'Dim Halogen'" Dmx="128~191" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="192~200" />
      <Function ID="5" Name="Fan Max" Display="'Fan Max'" Dmx="201~209" />
      <Function ID="6" Name="Fan Silent" Display="'Fan Silent'" Dmx="210~218" />
      <Function ID="7" Name="800Hz" Display="'800Hz'" Dmx="219~223" />
      <Function ID="8" Name="1200Hz" Display="'1200Hz'" Dmx="224~228" />
      <Function ID="9" Name="2000Hz" Display="'2000Hz'" Dmx="229~233" />
      <Function ID="10" Name="3600Hz" Display="'3600Hz'" Dmx="234~238" />
      <Function ID="11" Name="12kHz" Display="'12kHz'" Dmx="239~243" />
      <Function ID="12" Name="25kHz" Display="'25kHz'" Dmx="244~248" />

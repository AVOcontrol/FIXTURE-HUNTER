    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />
      <Function ID="2" Name="Half Speed" Display="'Half Speed'" Dmx="86~170" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="CCT_Mode" Name="CCT Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="86~170" />
      <Function ID="3" Name="Boost" Display="'Boost'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">

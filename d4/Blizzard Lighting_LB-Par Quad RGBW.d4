  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="65be2437-17ce-4a2a-bb13-cb01e2189919" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="RGB Jump" Display="'RGB Jump'" Dmx="10~19" />
      <Function ID="3" Name="RGB Pulse" Display="'RGB Pulse'" Dmx="20~29" />
      <Function ID="4" Name="RGB Fade" Display="'RGB Fade'" Dmx="30~39" />
      <Function ID="5" Name="RGBW Jump" Display="'RGBW Jump'" Dmx="40~49" />
      <Function ID="6" Name="RGBW Pulse" Display="'RGBW Pulse'" Dmx="50~59" />
      <Function ID="7" Name="RGBW Fade" Display="'RGBW Fade'" Dmx="60~69" />
      <Function ID="8" Name="7-Col Jump" Display="'7-Col Jump'" Dmx="70~79" />
      <Function ID="9" Name="7-Col Pulse" Display="'7-Col Pulse'" Dmx="80~89" />
      <Function ID="10" Name="7-Col Fade" Display="'7-Col Fade'" Dmx="90~99" />
      <Function ID="11" Name="MultiCol Jump" Display="'MultiCol Jump'" Dmx="100~109" />
      <Function ID="12" Name="MultiCol Pulse" Display="'MultiCol Pulse'" Dmx="110~119" />
      <Function ID="13" Name="MultiCol Fade" Display="'MultiCol Fade'" Dmx="120~129" />
      <Function ID="14" Name="Auto Loop" Display="'Auto Loop'" Dmx="130~139" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="32-Bit_Dim" Name="32-Bit Dim" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Mode 0" Display="'Mode 0'" Dmx="6~55" />
      <Function ID="3" Name="Mode 1" Display="'Mode 1'" Dmx="56~105" />
      <Function ID="4" Name="Mode 2" Display="'Mode 2'" Dmx="106~155" />
      <Function ID="5" Name="Mode 3" Display="'Mode 3'" Dmx="156~205" />
      <Function ID="6" Name="Mode 4" Display="'Mode 4'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKBLBQA4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

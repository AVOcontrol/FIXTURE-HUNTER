      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 11" Display="'Auto 11'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 12" Display="'Auto 12'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="19" Name="Auto 13" Display="'Auto 13'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="20" Name="Auto 14" Display="'Auto 14'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="21" Name="Auto 15" Display="'Auto 15'" Dmx="200~209" Update="Auto_Spd" />
      <Function ID="22" Name="Auto 16" Display="'Auto 16'" Dmx="210~229" Update="Auto_Spd" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="230~233" Update="Auto_Spd" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="234~237" Update="Auto_Spd" />
      <Function ID="25" Name="Sound 3" Display="'Sound 3'" Dmx="238~241" Update="Auto_Spd" />
      <Function ID="26" Name="Sound 4" Display="'Sound 4'" Dmx="242~245" Update="Auto_Spd" />
      <Function ID="27" Name="Sound 5" Display="'Sound 5'" Dmx="246~249" Update="Auto_Spd" />
      <Function ID="28" Name="Sound 6" Display="'Sound 6'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Colour" ID="2" If="'Auto'==2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;22" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Static Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Colour" Name="Auto Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~159" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="192~223" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

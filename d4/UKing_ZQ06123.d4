  <AtlaBase TypeID="10149d97-fa29-4468-82c6-4a583061b6c1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="10~19" Update="Auto_Spd" />
      <Function ID="3" Name="Breathing" Display="'Breathing'" Dmx="20~29" Update="Auto_Spd" />
      <Function ID="4" Name="Jump Change" Display="'Jump Change'" Dmx="30~39" Update="Auto_Spd" />
      <Function ID="5" Name="Gradient Change" Display="'Gradient Change'" Dmx="40~49" Update="Auto_Spd" />
      <Function ID="6" Name="Pulse Change" Display="'Pulse Change'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="60~69" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="70~79" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="120~129" Update="Auto_Spd" />

    <AtlaBase ModeID="74eae30f-7cf6-4aad-9326-33b70f366576" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="38" />
        <Attribute ID="Colour_Macro" ChannelOffset="10" Wheel="37" />

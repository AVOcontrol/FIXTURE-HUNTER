<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Amhaze Whisper" ShortName="AH Whisper" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="26-10-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Fan" Name="Fan" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Haze" Name="Haze" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Level" Display="'Level %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="CHAMHZEW" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Fan" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Haze" ChannelOffset="2" Wheel="22" />
    </Include>
  </Mode>
</Fixture>
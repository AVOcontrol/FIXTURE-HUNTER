    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Red" Colour="255,255,255" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="1~22" Update="Red" Colour="255,255,255" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="23~45" Update="Red" Colour="255,255,255" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="46~68" Update="Red" Colour="255,255,255" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="69~91" Update="Red" Colour="255,255,255" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="92~114" Update="Red" Colour="255,255,255" />
      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="115~137" Update="Red" Colour="255,255,255" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="138~160" Update="Red" Colour="255,255,255" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="161~183" Update="Red" Colour="255,255,255" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="184~206" Update="Red" Colour="255,255,255" />
      <Function ID="11" Name="Program 9" Display="'Program 9'" Dmx="207~229" Update="Red" Colour="255,255,255" />
      <Function ID="12" Name="Program 10" Display="'Program 10'" Dmx="230~252" Update="Red" Colour="255,255,255" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="253~255" Update="Red" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SHPQ4184" DiamondRef="" WysiwygRef="" />
    <Physical>

  <History Date="19-02-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Mode Linear" Display="'Dim Mode Linear'" Dmx="8~9" />
      <Function ID="3" Name="Dim Mode S-Curve" Display="'Dim Mode S-Curve'" Dmx="10~11" />
      <Function ID="4" Name="Dim Mode Square" Display="'Dim Mode Square'" Dmx="12~13" />
      <Function ID="5" Name="Dim Mode Inv Square" Display="'Dim Mode Inv Square'" Dmx="14~15" />
      <Function ID="6" Name="Dim Spd Auto" Display="'Dim Spd Auto'" Dmx="16~17" />
      <Function ID="7" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="18~19" />
      <Function ID="8" Name="Dim Spd Med" Display="'Dim Spd Med'" Dmx="20~21" />
      <Function ID="9" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="22~23" />
      <Function ID="10" Name="LED Freq 625Hz" Display="'LED Freq 625Hz'" Dmx="36~37" />
      <Function ID="11" Name="LED Freq 1282Hz" Display="'LED Freq 1282Hz'" Dmx="38~39" />
      <Function ID="12" Name="LED Freq 2500Hz" Display="'LED Freq 2500Hz'" Dmx="40~41" />
      <Function ID="13" Name="LED Freq 5000Hz" Display="'LED Freq 5000Hz'" Dmx="42~43" />
      <Function ID="14" Name="LED Freq 6400Hz" Display="'LED Freq 6400Hz'" Dmx="44~45" />
      <Function ID="15" Name="LED Freq 25KHz" Display="'LED Freq 25KHz'" Dmx="46~47" />
      <Function ID="16" Name="Fan Auto" Display="'Fan Auto'" Dmx="48~49" />
      <Function ID="17" Name="Fan Balanced" Display="'Fan Balanced'" Dmx="50~51" />
      <Function ID="18" Name="Fan Full" Display="'Fan Full'" Dmx="74~75" />
      <Function ID="19" Name="Display Flip Regular" Display="'Display Flip Regular'" Dmx="80~81" />
      <Function ID="20" Name="Display Flip Top Down" Display="'Display Flip Top Down'" Dmx="82~83" />
      <Function ID="21" Name="Display Backlight On" Display="'Display Backlight On'" Dmx="84~85" />
      <Function ID="22" Name="Display Backlight 10s" Display="'Display Backlight 10s'" Dmx="86~87" />
      <Function ID="23" Name="Display Backlight 20s" Display="'Display Backlight 20s'" Dmx="88~89" />
      <Function ID="24" Name="Display Backlight 30s" Display="'Display Backlight 30s'" Dmx="90~91" />
      <Function ID="25" Name="No DMX Blackout" Display="'No DMX Blackout'" Dmx="92~93" />
      <Function ID="26" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="94~95" />
      <Function ID="27" Name="No DMX Master Static" Display="'No DMX Master Static'" Dmx="96~97" />
      <Function ID="28" Name="No DMX Master Effect 1" Display="'No DMX Master Effect 1'" Dmx="98~99" />
      <Function ID="29" Name="No DMX Master Effect 2" Display="'No DMX Master Effect 2'" Dmx="100~101" />
      <Function ID="30" Name="No DMX Master Effect 3" Display="'No DMX Master Effect 3'" Dmx="102~103" />
      <Function ID="31" Name="No DMX Slave" Display="'No DMX Slave'" Dmx="104~105" />
      <Function ID="32" Name="Gobo Rot Off" Display="'Gobo Rot Off'" Dmx="106~107" />
      <Function ID="33" Name="Gobo Rot On" Display="'Gobo Rot On'" Dmx="108~109" />
      <Function ID="34" Name="Reset Gobo Rot" Display="'Reset Gobo Rot'" Dmx="110~111" />
      <Function ID="35" Name="Reset All" Display="'Reset All'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~49087" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
    </Attribute>
  </Control>
  <Mode Name="Uno, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

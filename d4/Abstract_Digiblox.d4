<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Digiblox" ShortName="Digiblox" Company="Abstract">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="07-05-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Trans_Motion" Name="Trans Motion" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~1" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Trans_Type" Name="Trans Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Stripe" Display="'Stripe'" Dmx="1~31" />
      <Function ID="3" Name="1 Direction Wipe" Display="'1 Direction Wipe'" Dmx="32~63" />
      <Function ID="4" Name="Split" Display="'Split'" Dmx="64~127" />
      <Function ID="5" Name="Bounce Wipe" Display="'Bounce Wipe'" Dmx="128~159" />
      <Function ID="6" Name="Bounce Split" Display="'Bounce Split'" Dmx="160~191" />
      <Function ID="7" Name="Multi Wipe" Display="'Multi Wipe'" Dmx="192~223" />
      <Function ID="8" Name="Dissolve" Display="'Dissolve'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Trans_Split" Name="Trans Split" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1x" Display="'1x'" Dmx="0~0" />
      <Function ID="2" Name="2x" Display="'2x'" Dmx="32~63" />
      <Function ID="3" Name="3x" Display="'3x'" Dmx="64~95" />
      <Function ID="4" Name="4x" Display="'4x'" Dmx="96~127" />
      <Function ID="5" Name="5x" Display="'5x'" Dmx="128~159" />
      <Function ID="6" Name="6x" Display="'6x'" Dmx="160~191" />
      <Function ID="7" Name="7x" Display="'7x'" Dmx="192~223" />
      <Function ID="8" Name="8x" Display="'8x'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Trans_Length" Name="Trans Length" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Length" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Soft_Edge" Name="Soft Edge" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Wdith" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red_Overlay" Name="Red Overlay" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Green_Overlay" Name="Green Overlay" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blue_Overlay" Name="Blue Overlay" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Int_Pulse" Name="Int Pulse" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Int_Pls_Fade" Name="Int Pls Fade" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Col_Scroll" Name="Col Scroll" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~1" Colour="0,0,0" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="255~128" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Spread" Name="Col Spread" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Smooth" Display="'Smooth %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="2" Name="Stepped" Display="'Stepped %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="FX_Red" Name="FX Red" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Green" Name="FX Green" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Blue" Name="FX Blue" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Strobe" Name="FX Strobe" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Rnd Seg" Display="'Rnd Seg %.f%%',0~100" Dmx="20~63" />
    </Attribute>
    <Attribute ID="FX_Motion" Name="FX Motion" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sparkle" ID="2" If="" />
      <Condition Name="Eq" ID="3" If="" />
      <Condition Name="Flame" ID="4" If="" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Rate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Decay" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Flicker" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Type" Name="FX Type" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="FX_Param_1, FX_Param_2" />
      <Function ID="2" Name="Sparkle" Display="'Sparkle'" Dmx="10~63" Update="FX_Param_1, FX_Param_2" />
      <Function ID="3" Name="Comet/ Rain" Display="'Comet/ Rain'" Dmx="64~127" Update="FX_Param_1, FX_Param_2" />
      <Function ID="4" Name="Trance" Display="'Trance'" Dmx="128~191" Update="FX_Param_1, FX_Param_2" />
      <Function ID="5" Name="Graphic EQ" Display="'Graphic EQ'" Dmx="192~223" Update="FX_Param_1, FX_Param_2" />
      <Function ID="6" Name="Flame/ Water" Display="'Flame/ Water'" Dmx="224~255" Update="FX_Param_1, FX_Param_2" />
    </Attribute>
    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sparkle" ID="2" If="'FX_Type'==2" />
      <Condition Name="Comet" ID="3" If="'FX_Type'==3" />
      <Condition Name="Size" ID="4" If="'FX_Type'&gt;3" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Length" Display="'Length %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Param_2" Name="FX Param 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Comet" ID="2" If="'FX_Type'==3" />
      <Condition Name="Trance" ID="3" If="'FX_Type'==4" />
      <Condition Name="EQ" ID="4" If="'FX_Type'==5" />
      <Condition Name="Flame" ID="5" If="'FX_Type'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Rate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Shift" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_FG/BG" Name="FX FG/BG" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Pixel" Display="'All Pixel'" Dmx="0~0" />
      <Function ID="2" Name="Overlay" Display="'Overlay'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="SHOW" Channels="24">
    <Import PearlRef="ABDGBLXS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Trans_Motion" ChannelOffset="4" Wheel="13" />
      <Attribute ID="Trans_Type" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Trans_Split" ChannelOffset="6" Wheel="15" />
      <Attribute ID="Trans_Length" ChannelOffset="7" Wheel="43" />
      <Attribute ID="Soft_Edge" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Red_Overlay" ChannelOffset="9" Wheel="16" />
      <Attribute ID="Green_Overlay" ChannelOffset="10" Wheel="17" />
      <Attribute ID="Blue_Overlay" ChannelOffset="11" Wheel="18" />
      <Attribute ID="Int_Pulse" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Int_Pls_Fade" ChannelOffset="13" Wheel="5" />
      <Attribute ID="Col_Scroll" ChannelOffset="14" Wheel="7" />
      <Attribute ID="Col_Spread" ChannelOffset="15" Wheel="8" />
      <Attribute ID="FX_Red" ChannelOffset="16" Wheel="22" />
      <Attribute ID="FX_Green" ChannelOffset="17" Wheel="23" />
      <Attribute ID="FX_Blue" ChannelOffset="18" Wheel="24" />
      <Attribute ID="FX_Strobe" ChannelOffset="19" Wheel="53" />
      <Attribute ID="FX_Motion" ChannelOffset="20" Wheel="52" />
      <Attribute ID="FX_Type" ChannelOffset="21" Wheel="54" />
      <Attribute ID="FX_Param_1" ChannelOffset="22" Wheel="82" />
      <Attribute ID="FX_Param_2" ChannelOffset="23" Wheel="83" />
      <Attribute ID="FX_FG/BG" ChannelOffset="24" Wheel="84" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Washlight CP" ShortName="WashLCP" Company="Amptown/Controlite">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="24-08-04" Author="" Comment="Created" />
  <History Date="26-08-04" Author="Tom" Comment="Checked" />
  <History Date="26-08-04" Author="Phil" Comment="Revised channels" />
  <History Date="29-09-04" Author="Phil Rogers" Comment="Changed manufacturer name (typo)" />
  <History Date="05-04-06" Author="Ed" Comment="Moved all Blade functions to beam group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="23-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:45" PowerOn="1:45" />
      <Function ID="1" Name="Focus" Display="'%.1f°',45.0~11.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~149" />
      <Function ID="2" Name="Display On" Display="'Display On'" Dmx="150~174" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="175~199" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="203~203" />
    </Attribute>
    <Attribute ID="Blade_Rot" Name="Blade Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_1" Name="Blade 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f%%',100~0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_2" Name="Blade 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f%%',100~0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_3" Name="Blade 3" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f%%',100~0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_4" Name="Blade 4" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f%%',100~0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="AMP_WashLCP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="2,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4,5" Wheel="3" />
      <Attribute ID="Yellow" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Magenta" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Cyan" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Blade_Rot" ChannelOffset="10" Wheel="22" />
      <Attribute ID="Blade_1" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Blade_2" ChannelOffset="12" Wheel="24" />
      <Attribute ID="Blade_3" ChannelOffset="13" Wheel="26" />
      <Attribute ID="Blade_4" ChannelOffset="14" Wheel="27" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
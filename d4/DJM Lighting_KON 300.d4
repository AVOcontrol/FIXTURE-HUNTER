  <Mode Name="52ch" Channels="52">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="120" />

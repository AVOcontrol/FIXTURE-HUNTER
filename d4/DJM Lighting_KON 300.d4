      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="7" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Reset" ChannelOffset="8" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

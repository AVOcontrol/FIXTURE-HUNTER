  <Mode Name="8ch" Channels="8">
    <Import PearlRef="K300_8CH" DiamondRef="K300_8CH" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="120" />
      <Weight Kg="5,7" />
      <Size Height="260" Width="100" Depth="510" />
      <Focus Type="Head" PanMax="0" TiltMax="220" PanMaxSpeed="0" TiltMaxSpeed="220" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1,2" Wheel="3" />
      <Attribute ID="Tilt_speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" VirtualControl="Dimmer" />

      <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Evo500,16 DMX, 16bit" Channels="11">
    <Import PearlRef="AEEvo500" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

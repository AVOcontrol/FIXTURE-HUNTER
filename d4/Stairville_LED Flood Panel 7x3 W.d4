<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Flood Panel 7x3 W" ShortName="Panel 7x3" Company="Stairville">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="05-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2948b1ad-2e91-4223-90b7-a5725b7e89ff" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Index" ID="2" If="'Colour_Macro'==2" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;2&amp;&amp;'Colour_Macro'&lt;12" />
      <Condition Name="Sensitivity" ID="4" If="'Colour_Macro'==12" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="1~24" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="3" Name="7 Colour Gradual" Display="'7 Colour Gradual'" Dmx="25~49" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="4" Name="3 Colour Gradual" Display="'3 Colour Gradual'" Dmx="50~74" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="5" Name="7 Colour Jump" Display="'7 Colour Jump'" Dmx="75~99" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="6" Name="3 Colour Jump" Display="'3 Colour Jump'" Dmx="100~124" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="7" Name="Fantasy 1" Display="'Fantasy 1'" Dmx="125~149" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="8" Name="Fantasy 2" Display="'Fantasy 2'" Dmx="150~174" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="9" Name="Red Gradual" Display="'Red Gradual'" Dmx="175~199" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="10" Name="Green Gradual" Display="'Green Gradual'" Dmx="200~224" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="11" Name="Blue Gradual" Display="'Blue Gradual'" Dmx="225~249" Update="Green, Blue, Red" Colour="255,255,255" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Green, Blue, Red" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Instant" Display="'Instant'" Dmx="0~0" />
      <Function ID="2" Name="Delay" Display="'Delay'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SVFP73W3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="533f66c0-44a5-4d24-ade0-ce6c91b46b7c" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SVFP73W4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fd402c39-65c0-4620-bee3-50e0b59e66e5" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="SVFP73W8" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="26284a4b-55f4-4dcc-97f5-c9edfa8c2716" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
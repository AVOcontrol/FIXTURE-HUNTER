  <History Date="03-08-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~4" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="5~26" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="27~53" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="54~80" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="81~107" Colour="255,255,255" />
      <Function ID="6" Name="UV" Display="'UV'" Dmx="108~134" Colour="255,255,255" />
      <Function ID="7" Name="A" Display="'A'" Dmx="135~161" Colour="255,255,255" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="162~187" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="188~215" Colour="255,255,255" />
      <Function ID="10" Name="R+B" Display="'R+B'" Dmx="216~241" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B+W+I+A" Display="'R+G+B+W+I+A'" Dmx="242~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~4" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="5~24" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="25~49" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="50~74" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="75~99" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="100~124" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="125~149" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="150~174" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="175~199" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="200~224" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="225~244" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="NNPBH815" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Parco Zoom 1215" ShortName="ParZm 1215" Company="Longman">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="26-10-17" Author="Nic Morris" Comment="Created" />
  <History Date="30-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="069e4045-dc74-48fd-8aa4-0c535b51a990" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="21~60" />
      <Function ID="3" Name="Async" Display="'Async %.f%%',0~100" Dmx="6~20" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="101~140" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="141~180" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="181~220" />
      <Function ID="7" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="61~100" />
      <Function ID="8" Name="Square" Display="'Square %.f%%',0~100" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="CT01" Display="'CT01'" Dmx="6~10" />
      <Function ID="3" Name="CT02" Display="'CT02'" Dmx="11~15" />
      <Function ID="4" Name="CT03" Display="'CT03'" Dmx="16~20" />
      <Function ID="5" Name="CT04" Display="'CT04'" Dmx="21~25" />
      <Function ID="6" Name="CT05" Display="'CT05'" Dmx="26~30" />
      <Function ID="7" Name="CT06" Display="'CT06'" Dmx="31~35" />
      <Function ID="8" Name="CT07" Display="'CT07'" Dmx="36~40" />
      <Function ID="9" Name="CT08" Display="'CT08'" Dmx="41~45" />
      <Function ID="10" Name="CT09" Display="'CT09'" Dmx="46~50" />
      <Function ID="11" Name="CT10" Display="'CT10'" Dmx="51~55" />
      <Function ID="12" Name="Auto 1" Display="'Auto 1'" Dmx="56~60" />
      <Function ID="13" Name="Auto 2" Display="'Auto 2'" Dmx="61~65" />
      <Function ID="14" Name="Auto 3" Display="'Auto 3'" Dmx="66~70" />
      <Function ID="15" Name="Auto 4" Display="'Auto 4'" Dmx="71~75" />
      <Function ID="16" Name="Auto 5" Display="'Auto 5'" Dmx="76~80" />
      <Function ID="17" Name="Chase 1" Display="'Chase 1'" Dmx="221~225" />
      <Function ID="18" Name="Chase 2" Display="'Chase 2'" Dmx="226~230" />
      <Function ID="19" Name="Chase 3" Display="'Chase 3'" Dmx="231~235" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Preset" Display="'Dim Preset'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="11~20" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="21~30" />
      <Function ID="4" Name="Dim Inv Sq" Display="'Dim Inv Sq'" Dmx="31~40" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Dim Linear Smooth" Display="'Dim Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Dim Square Smooth" Display="'Dim Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Dim Inv Sq Smooth" Display="'Dim Inv Sq Smooth'" Dmx="71~80" />
      <Function ID="9" Name="Dim S-Curve Smooth" Display="'Dim S-Curve Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="LOZ12151" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f58aff60-d9f0-49ed-aace-da2784a77b14" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Zoom" ChannelOffset="5" Wheel="19" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">

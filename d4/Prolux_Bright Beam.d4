      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="68~71" WheelPosition="17" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="160~166" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="167~172" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="173~179" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />

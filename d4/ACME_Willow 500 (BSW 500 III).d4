  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:31" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:25" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effect">
      <Set Channel="Control:26" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus On">
      <Set Channel="Control:2" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus Off">
      <Set Channel="Control:3" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

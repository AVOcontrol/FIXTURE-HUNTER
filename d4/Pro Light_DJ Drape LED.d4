  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program_1-15" Name="Program 1-15" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Falling Star" Display="'Falling Star'" Dmx="16~31" />
      <Function ID="3" Name="Diagonal Colour Bands" Display="'Diagonal Colour Bands'" Dmx="32~47" />
      <Function ID="4" Name="Colour Pattern Chase" Display="'Colour Pattern Chase'" Dmx="48~63" />
      <Function ID="5" Name="Inward Arrow (L–R)" Display="'Inward Arrow (L–R)'" Dmx="64~79" />
      <Function ID="6" Name="Colour Stack" Display="'Colour Stack'" Dmx="80~95" />
      <Function ID="7" Name="Multi-Colour Freeway" Display="'Multi-Colour Freeway'" Dmx="96~111" />
      <Function ID="8" Name="Color Wave (L–R)" Display="'Color Wave (L–R)'" Dmx="112~127" />
      <Function ID="9" Name="Color Wave (R–L)" Display="'Color Wave (R–L)'" Dmx="128~143" />
      <Function ID="10" Name="Colour Bar Chase (L–R)" Display="'Colour Bar Chase (L–R)'" Dmx="144~159" />
      <Function ID="11" Name="Colour Bar Chase (R–L)" Display="'Colour Bar Chase (R–L)'" Dmx="160~175" />
      <Function ID="12" Name="Windmill" Display="'Windmill'" Dmx="176~191" />
      <Function ID="13" Name="Fan" Display="'Fan'" Dmx="192~207" />
      <Function ID="14" Name="Whirlpool" Display="'Whirlpool'" Dmx="208~223" />
      <Function ID="15" Name="Falling Snow" Display="'Falling Snow'" Dmx="224~239" />
      <Function ID="16" Name="Multi Box Frenzy" Display="'Multi Box Frenzy'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_16-30" Name="Program 16-30" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Center Burst" Display="'Center Burst'" Dmx="16~31" />
      <Function ID="3" Name="Outer Burst" Display="'Outer Burst'" Dmx="32~47" />
      <Function ID="4" Name="EQ Effect" Display="'EQ Effect'" Dmx="48~63" />
      <Function ID="5" Name="Rolling Colour" Display="'Rolling Colour'" Dmx="64~79" />
      <Function ID="6" Name="Horizontal Stacking" Display="'Horizontal Stacking'" Dmx="80~95" />
      <Function ID="7" Name="Inner Zone" Display="'Inner Zone'" Dmx="96~111" />
      <Function ID="8" Name="Outer Zone" Display="'Outer Zone'" Dmx="112~127" />
      <Function ID="9" Name="Diamond Spread" Display="'Diamond Spread'" Dmx="128~143" />
      <Function ID="10" Name="Single Diamond Squeeze" Display="'Single Diamond Squeeze'" Dmx="144~159" />
      <Function ID="11" Name="Follow the Leader" Display="'Follow the Leader'" Dmx="160~175" />
      <Function ID="12" Name="Crisscross" Display="'Crisscross'" Dmx="176~191" />
      <Function ID="13" Name="X Factor" Display="'X Factor'" Dmx="192~207" />
      <Function ID="14" Name="Double Diamond Squeeze" Display="'Double Diamond Squeeze'" Dmx="208~223" />
      <Function ID="15" Name="Red X Factor" Display="'Red X Factor'" Dmx="224~239" />
      <Function ID="16" Name="Multicolour Rain" Display="'Multicolour Rain'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">

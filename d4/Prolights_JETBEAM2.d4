      <Function ID="14" Name="Dark Orange" Display="'Dark Orange'" Dmx="111~114" WheelPosition="13" Colour="255,100,0" />
      <Function ID="15" Name="UV" Display="'UV'" Dmx="119~122" WheelPosition="14" Colour="180,0,255" />
      <Function ID="16" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />

      <Function ID="29" Name="D Org/ UV" Display="'D Org/ UV'" Dmx="115~118" WheelPosition="13" Colour="255,100,0" />
      <Function ID="30" Name="UV/ Op" Display="'UV/ Op'" Dmx="123~127" WheelPosition="14" Colour="180,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="189~128" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />

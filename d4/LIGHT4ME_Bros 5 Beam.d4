    </Attribute>
    <Attribute ID="BG_Col_Spd" Name="BG Col Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour Select" ID="1,2,3,4,5,6,7,8" If="'BG_Colour'==1" />
      <Else ID="9" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="R" Display="'R'" Dmx="11~42" Colour="0,0,0" />
      <Function ID="3" Name="G" Display="'G'" Dmx="43~75" Colour="0,0,0" />
      <Function ID="4" Name="B" Display="'B'" Dmx="76~108" Colour="0,0,0" />

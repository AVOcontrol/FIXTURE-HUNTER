    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~14" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~24" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~34" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~44" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~54" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="9" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="25~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="11" Name="Yel/ Org" Display="'Yel/ Org'" Dmx="45~49" WheelPosition="4" Colour="255,255,0" />
      <Function ID="12" Name="Org/ Op" Display="'Org/ Op'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="60~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="High_Temp" Name="High Temp" Description="" Group="C">

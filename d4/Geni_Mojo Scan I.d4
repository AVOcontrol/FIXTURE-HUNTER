      <Function ID="9" Name="Dark Blue" Display="'Dark Blue'" Dmx="80~89" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="90~99" />
      <Function ID="11" Name="Red/ White / Orange" Display="'Red/ White / Orange'" Dmx="100~109" />
      <Function ID="12" Name="Green/ Yellow" Display="'Green/ Yellow'" Dmx="110~119" />

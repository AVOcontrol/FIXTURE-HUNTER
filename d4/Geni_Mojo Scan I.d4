  <AtlaBase TypeID="8440b79a-6a5e-4a2a-abc7-b62126a1d104" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="2" PowerOn="1:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~19" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="20~29" />
      <Function ID="4" Name="Dark Green" Display="'Dark Green'" Dmx="30~39" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~49" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="50~59" />

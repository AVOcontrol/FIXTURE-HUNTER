    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Shape/File" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Strobe/File" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="7" />

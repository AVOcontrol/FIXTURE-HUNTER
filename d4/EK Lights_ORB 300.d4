  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~80" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="81~160" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="161~240" />
    </Attribute>
  </Control>

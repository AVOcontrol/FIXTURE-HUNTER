  <History Date="22-02-22" Author="Nic Morris" Comment="Created (note strobe ranges in A4 mode looks wrong.  used single range instead)" Version="0" />
  <History Date="26-02-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="01-03-22" Author="Nic Morris" Comment="Swapped A4 and B4 mode AtlaBase mode IDs (originally the Capture implementation was swapped.  The fix was then to swap the name/ID which was a bit cheeky!)" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="edfca6ef-34c6-42ff-b85f-5f4a5e9dd1c7" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

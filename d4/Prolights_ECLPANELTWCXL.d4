  <History Date="01-08-22" Author="Nic Morris" Comment="Created (adapted from Arri Lighting SkyPanel S30-C (V4.x).  charts contain errors)" Version="0" />
  <History Date="06-08-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="28" />
  <History Date="29-08-22" Author="Nic Morris" Comment="Updated in line with latest charts (adds modes 33 and 34 and pixel modes.  revises S1, S2 and S3 RDM IDs.  Far too complicated.  Charts contain errors.)" Version="29" />

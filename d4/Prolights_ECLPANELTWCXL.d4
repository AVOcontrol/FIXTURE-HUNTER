  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d82ad6c0-7e4b-4c22-9312-fdfda774f03f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="CCT_Range" Name="CCT Range" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="2800-10000K" Display="'2800-10000K'" Dmx="0~0" Update="CTO" Colour="255,255,255" />
      <Function ID="2" Name="2200-15000K" Display="'2200-15000K'" Dmx="10~19" Update="CTO" Colour="255,255,255" />
      <Function ID="3" Name="1850-20000K" Display="'1850-20000K'" Dmx="20~29" Update="CTO" Colour="255,255,255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="CTO" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Condition Name="2800-10000K" ID="1" If="'CCT_Range'==1" />
      <Condition Name="2200-15000K" ID="2" If="'CCT_Range'==2" />
      <Condition Name="1850-20000K" ID="3" If="'CCT_Range'==3" />
      <Else ID="4" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2800.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.1fK',2200.0~15000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="CCT C-Mix" Display="'%.1fK',1850.0~20000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="GN_Saturation" Name="GN Saturation" Description="" Group="C" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="512~1023" Colour="0,0,0" />
      <Function ID="3" Name="-" Display="'- %.2f%%',99.00~1.00" Dmx="1024~32511" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="32512~33023" Colour="0,0,0" />
      <Function ID="5" Name="+" Display="'+ %.2f%%',1.00~99.00" Dmx="33024~64511" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="64512~65023" Colour="0,0,0" />
      <Function ID="7" Name="Neutral" Display="'Neutral'" Dmx="65024~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">

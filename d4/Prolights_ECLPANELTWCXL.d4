    <Attribute ID="Gel_Category1" Name="Gel Category" Description="" Group="C">
      <Locate Locate="6" PowerOn="6" />
      <Else ID="1,2,3,4,5" />
      <Condition Name="LEE" ID="6,7,8,9,10" If="'Gel_Type1'==1" />
      <Function ID="1" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Update="Gel1" Colour="255,255,255" />

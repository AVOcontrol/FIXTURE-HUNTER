      <Function ID="6" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Update="Gel1" Colour="255,255,255" />
      <Function ID="7" Name="Colour Filters" Display="'Colour Filters'" Dmx="10~19" Update="Gel1" Colour="255,255,255" />

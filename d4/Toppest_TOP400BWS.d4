      <Function ID="23" Name="CTO/ UV" Display="'CTO/ UV'" Dmx="105~109" WheelPosition="10" Colour="255,223,191" />
      <Function ID="24" Name="UV/ Op" Display="'UV/ Op'" Dmx="115~119" WheelPosition="11" Colour="63,63,255" />

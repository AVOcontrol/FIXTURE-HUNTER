      <Function ID="13" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="15" Name="Org/ Cy" Display="'Org/ Cy'" Dmx="25~29" WheelPosition="2" Colour="255,127,0" />
      <Function ID="16" Name="Cy/ Grn" Display="'Cy/ Grn'" Dmx="35~39" WheelPosition="3" Colour="63,255,255" />

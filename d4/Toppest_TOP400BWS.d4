      <Function ID="18" Name="L Yel/ CTB" Display="'L Yel/ CTB'" Dmx="55~59" WheelPosition="5" Colour="255,255,63" />
      <Function ID="19" Name="CTB/ Pk" Display="'CTB/ Pk'" Dmx="65~69" WheelPosition="6" Colour="191,255,255" />
      <Function ID="20" Name="Pk/ Mag" Display="'Pk/ Mag'" Dmx="75~79" WheelPosition="7" Colour="255,127,191" />
      <Function ID="21" Name="Mag/ Blu" Display="'Mag/ Blu'" Dmx="85~89" WheelPosition="8" Colour="255,0,255" />

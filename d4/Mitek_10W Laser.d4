  <History Date="04-06-22" Author="Nic Morris" Comment="Created (very poor documentation.  mostly nonsense.  control names don't match up with functions.  made best guess)" Version="0" />
  <History Date="22-10-23" Author="Nic Morris" Comment="Created from Unknown Laser RGB 5W (equally hopeless documentation.  identical except adds 10 channel mode)" Version="1" />
  <History Date="28-02-25" Author="Nic Morris" Comment="Created from Unknown Laser Pantoufle (note 34 channel mode documentation is missing channels 31-34.  assumed the same - otherwise identical except Pattern/Effect function ranges)" Version="2" />
  <History Date="13-03-25" Author="Nic Morris" Comment="Created from Pro Light RGB 10W" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="G">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Horiz Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Horiz Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Vert Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Vert Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="Fixed/Change" Display="'Fixed/Change %.f%%',0~100" Dmx="64~95" Colour="255,255,255" />
      <Function ID="3" Name="Change" Display="'Change %.f%%',0~100" Dmx="96~127" Colour="255,255,255" />
      <Function ID="4" Name="Change/Flow" Display="'Change/Flow %.f%%',0~100" Dmx="128~159" Colour="255,255,255" />
      <Function ID="5" Name="Flow (1)" Display="'Flow (1) %.f%%',0~100" Dmx="160~191" Colour="255,255,255" />
      <Function ID="6" Name="Flow (2)" Display="'Flow (2) %.f%%',0~100" Dmx="192~223" Colour="255,255,255" />
      <Function ID="7" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="224~255" Colour="255,255,255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Scan_Spd" Name="Scan Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line Scan Spd" Display="'Line Scan Spd %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Point Scan Spd" Display="'Point Scan Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pattern/Effect" Name="Pattern/Effect" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Trigger" Name="Trigger" Description="" Group="E">

    <Attribute ID="Alphanumeric" Name="Alphanumeric" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Gobo_Spd" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Numeric 1-0" Display="'Numeric 1-0 %.1f%%',0.0~100.0" Dmx="1~127" Update="Gobo_Spd" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Alpha A-Z" Display="'Alpha A-Z %.1f%%',0.0~100.0" Dmx="128~255" Update="Gobo_Spd" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Maps" Name="Gobo Maps" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Simple Cross" Display="'Simple Cross'" Dmx="11~20" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Simple Box" Display="'Simple Box'" Dmx="21~29" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Square Imploder" Display="'Square Imploder'" Dmx="30~38" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Square Exploder" Display="'Square Exploder'" Dmx="39~47" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Diamond Imploder" Display="'Diamond Imploder'" Dmx="48~56" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Diamond Exploder" Display="'Diamond Exploder'" Dmx="57~65" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="2-Line Spinner" Display="'2-Line Spinner'" Dmx="66~74" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Triangle Spinner" Display="'Triangle Spinner'" Dmx="75~83" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Tri-Downer" Display="'Tri-Downer'" Dmx="84~92" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Tri-Upper" Display="'Tri-Upper'" Dmx="93~101" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Bowtie Spinner" Display="'Bowtie Spinner'" Dmx="102~110" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="One-Liner" Display="'One-Liner'" Dmx="111~119" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Line Hop UP" Display="'Line Hop UP'" Dmx="120~128" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Line Hop DOWN" Display="'Line Hop DOWN'" Dmx="129~137" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Line Hop UP DOWN" Display="'Line Hop UP DOWN'" Dmx="138~146" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="T-Spin" Display="'T-Spin'" Dmx="147~155" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Upside Down T-Spin" Display="'Upside Down T-Spin'" Dmx="156~164" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Diamond Spoke Spin" Display="'Diamond Spoke Spin'" Dmx="165~173" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Line Hop LEFT" Display="'Line Hop LEFT'" Dmx="174~182" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Line Hop RIGHT" Display="'Line Hop RIGHT'" Dmx="183~191" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Line HOP LEFT RIGHT" Display="'Line HOP LEFT RIGHT'" Dmx="192~200" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Double Verticals" Display="'Double Verticals'" Dmx="201~209" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Double Horizontals" Display="'Double Horizontals'" Dmx="210~218" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Diagonal Right" Display="'Diagonal Right'" Dmx="219~227" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Diagonal Left" Display="'Diagonal Left'" Dmx="228~236" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Moving Squares" Display="'Moving Squares'" Dmx="237~246" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="28" Name="Clock" Display="'Clock'" Dmx="247~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Spd" Name="Gobo Spd" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="AlphaNumeric" ID="5,6,7,8" If="'Alphanumeric'&gt;1" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="150~202" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="203~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="0 degree" Display="'0 degree'" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="90 degree" Display="'90 degree'" Dmx="64~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="180 degree" Display="'180 degree'" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="270 degree" Display="'270 degree'" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

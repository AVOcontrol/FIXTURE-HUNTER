      <Function ID="14" Name="CTB 8000" Display="'CTB 8000'" Dmx="130~134" WheelPosition="13" Colour="230,230,255" />
      <Function ID="15" Name="CTO 260" Display="'CTO 260'" Dmx="140~144" WheelPosition="14" Colour="255,240,200" />

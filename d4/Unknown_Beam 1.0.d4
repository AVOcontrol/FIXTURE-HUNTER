      <Function ID="17" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="25~29" WheelPosition="2" Colour="255,255,0" />
      <Function ID="19" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="20" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="45~49" WheelPosition="4" Colour="0,255,0" />
      <Function ID="21" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="22" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="65~69" WheelPosition="6" Colour="255,0,255" />
      <Function ID="23" Name="Cy/ L Grn" Display="'Cy/ L Grn'" Dmx="75~79" WheelPosition="7" Colour="0,255,255" />
      <Function ID="24" Name="L Grn/ Amb" Display="'L Grn/ Amb'" Dmx="85~89" WheelPosition="8" Colour="128,255,0" />
      <Function ID="25" Name="Amb/ Pk" Display="'Amb/ Pk'" Dmx="95~99" WheelPosition="9" Colour="255,100,0" />
      <Function ID="26" Name="Pk/ D Blu" Display="'Pk/ D Blu'" Dmx="105~109" WheelPosition="10" Colour="255,150,150" />

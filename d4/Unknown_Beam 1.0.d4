      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="20" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="90~94" WheelPosition="1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-SP250" ShortName="EK-SP250" Company="EK Lights" Version="7">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-06-19" Author="Nic Morris" Comment="Updated to latest charts (completely different.  note pixel layout unavailable.  guessed).  Added product thumbnail." Version="2" />
  <History Date="03-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Changed name from ECLPANELTWC800 to ECLPANELTWC in response to manufacturer request." Version="4" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Revised CCT, Hue and Effect function ranges in line with latest charts in response to manufacturer request." Version="4" />
  <History Date="26-05-20" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWC" Version="5" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Changed CTC to a single variable range and added an 'Open' range to the 10 and 15 channel 'Theatre' modes in response to manufacturer request." Version="6" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="21-11-20" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWCJNR" Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f°',-25.0~25.0" Dmx="1~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="131~200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Amber Shift On" Display="'Amber Shift On'" Dmx="3~5" Colour="255,255,255" />
      <Function ID="3" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="xFade_CTC/RGBW" Name="xFade CTC/RGBW" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTC-&gt;RGBW" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTC1" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~30" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="31~55" Colour="255,255,255" />
      <Function ID="4" Name="3500K" Display="'3500K'" Dmx="56~80" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="81~105" Colour="255,255,255" />
      <Function ID="6" Name="4500K" Display="'4500K'" Dmx="106~130" Colour="255,255,255" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="131~155" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="156~180" Colour="255,255,255" />
      <Function ID="9" Name="6000K" Display="'6000K'" Dmx="181~205" Colour="255,255,255" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="206~230" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="11~20" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="21~30" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="31~40" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="41~50" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="51~60" />
      <Function ID="7" Name="Candle" Display="'Candle'" Dmx="61~70" />
      <Function ID="8" Name="Cop Car 1" Display="'Cop Car 1'" Dmx="71~80" />
      <Function ID="9" Name="Cop Car 2" Display="'Cop Car 2'" Dmx="81~90" />
      <Function ID="10" Name="Cop Car 3" Display="'Cop Car 3'" Dmx="91~100" />
      <Function ID="11" Name="Fire" Display="'Fire'" Dmx="101~110" />
      <Function ID="12" Name="Fireworks" Display="'Fireworks'" Dmx="111~120" />
      <Function ID="13" Name="Paparazzi" Display="'Paparazzi'" Dmx="121~130" />
      <Function ID="14" Name="Television" Display="'Television'" Dmx="131~140" />
      <Function ID="15" Name="Party" Display="'Party'" Dmx="141~150" />
      <Function ID="16" Name="Clouds" Display="'Clouds'" Dmx="151~160" />
      <Function ID="17" Name="Club" Display="'Club'" Dmx="161~170" />
      <Function ID="18" Name="Colour Chase" Display="'Colour Chase'" Dmx="171~180" />
      <Function ID="19" Name="Strobe" Display="'Strobe'" Dmx="181~190" />
      <Function ID="20" Name="Lighting" Display="'Lighting'" Dmx="191~200" />
      <Function ID="21" Name="Explosion" Display="'Explosion'" Dmx="201~210" />
      <Function ID="22" Name="Fluorescent" Display="'Fluorescent'" Dmx="211~220" />
      <Function ID="23" Name="Process" Display="'Process'" Dmx="221~230" />
      <Function ID="24" Name="Pulsing" Display="'Pulsing'" Dmx="231~240" />
      <Function ID="25" Name="Welding" Display="'Welding'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC2" Name="CTC" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="2800-3200K" Display="'%.fK',2800~3200" Dmx="0~30" Colour="255,255,255" />
      <Function ID="2" Name="3200-3500K" Display="'%.fK',3200~3500" Dmx="31~60" Colour="255,255,255" />
      <Function ID="3" Name="3500-4000K" Display="'%.fK',3500~4000" Dmx="61~90" Colour="255,255,255" />
      <Function ID="4" Name="4000-4500K" Display="'%.fK',4000~4500" Dmx="91~120" Colour="255,255,255" />
      <Function ID="5" Name="4500-5000K" Display="'%.fK',4500~5000" Dmx="121~150" Colour="255,255,255" />
      <Function ID="6" Name="5000-5600K" Display="'%.fK',5000~5600" Dmx="151~180" Colour="255,255,255" />
      <Function ID="7" Name="5600-6000K" Display="'%.fK',5600~6000" Dmx="181~210" Colour="255,255,255" />
      <Function ID="8" Name="6000-6500K" Display="'%.fK',6000~6500" Dmx="211~240" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue1" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f°',-25.0~0.0" Dmx="0~126" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="0" Display="'0'" Dmx="127~127" WheelPosition="0" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f°',0.0~25.0" Dmx="128~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC21" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~6500" Dmx="0~240" Colour="255,255,255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-GP 70 IP" ShortName="GP 70 IP" Company="EK Lights" Version="4">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="20-03-19" Author="Nic Morris" Comment="Removed 12 channel mode (original charts were wrong).  Actually populated the other modes." Version="2" />
  <History Date="31-08-20" Author="Nic Morris" Comment="Created from Prolights MOSAICOJR" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~11" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~19" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="24~27" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="32~35" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="40~43" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="48~51" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="56~59" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Op/ 1" Display="'Op/ 1'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="1/ 2" Display="'1/ 2'" Dmx="12~15" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="2/ 3" Display="'2/ 3'" Dmx="20~23" WheelPosition="2" Colour="0,0,0" />
      <Function ID="12" Name="3/ 4" Display="'3/ 4'" Dmx="28~31" WheelPosition="3" Colour="0,0,0" />
      <Function ID="13" Name="4/ 5" Display="'4/ 5'" Dmx="36~39" WheelPosition="4" Colour="0,0,0" />
      <Function ID="14" Name="5/ 6" Display="'5/ 6'" Dmx="44~47" WheelPosition="5" Colour="0,0,0" />
      <Function ID="15" Name="6/ 7" Display="'6/ 7'" Dmx="52~55" WheelPosition="6" Colour="0,0,0" />
      <Function ID="16" Name="7/ Op" Display="'7/ Op'" Dmx="60~63" WheelPosition="7" Colour="0,0,0" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="64~94" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="95~96" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="97~127" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~10" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="11~15" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="16~20" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="21~25" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="26~30" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="31~35" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="36~40" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="41~55" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="56~70" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="71~85" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="86~100" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="101~115" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="116~130" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="131~145" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="200~201" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="146~199" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="200~201" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="202~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~191" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="222~225" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="192~221" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="222~225" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="226~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="60~69" />
      <Function ID="3" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="70~79" />
      <Function ID="4" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="80~89" />
      <Function ID="5" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="90~99" />
      <Function ID="6" Name="Reset Colour" Display="'Reset Colour'" Dmx="100~109" />
      <Function ID="7" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="110~119" />
      <Function ID="8" Name="Reset Focus" Display="'Reset Focus'" Dmx="120~129" />
      <Function ID="9" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="130~139" />
      <Function ID="10" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="64~127" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="128~191" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="29~56" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="57~85" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="86~113" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="114~141" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="142~170" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="171~198" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="199~226" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="227~255" />
    </Attribute>
    <Attribute ID="Scene" Name="Scene" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scene" Display="'No Scene'" Dmx="0~0" />
      <Function ID="2" Name="Scene 1" Display="'Scene 1'" Dmx="8~15" />
      <Function ID="3" Name="Scene 2" Display="'Scene 2'" Dmx="16~23" />
      <Function ID="4" Name="Scene 3" Display="'Scene 3'" Dmx="24~30" />
      <Function ID="5" Name="Scene 4" Display="'Scene 4'" Dmx="31~38" />
      <Function ID="6" Name="Scene 5" Display="'Scene 5'" Dmx="39~46" />
      <Function ID="7" Name="Scene 6" Display="'Scene 6'" Dmx="47~54" />
      <Function ID="8" Name="Scene 7" Display="'Scene 7'" Dmx="55~61" />
      <Function ID="9" Name="Scene 8" Display="'Scene 8'" Dmx="62~69" />
      <Function ID="10" Name="Scene 9" Display="'Scene 9'" Dmx="70~77" />
      <Function ID="11" Name="Scene 10" Display="'Scene 10'" Dmx="78~85" />
      <Function ID="12" Name="Scene 11" Display="'Scene 11'" Dmx="86~92" />
      <Function ID="13" Name="Scene 12" Display="'Scene 12'" Dmx="93~100" />
      <Function ID="14" Name="Scene 13" Display="'Scene 13'" Dmx="101~108" />
      <Function ID="15" Name="Scene 14" Display="'Scene 14'" Dmx="109~115" />
      <Function ID="16" Name="Scene 15" Display="'Scene 15'" Dmx="116~123" />
      <Function ID="17" Name="Scene 16" Display="'Scene 16'" Dmx="124~131" />
      <Function ID="18" Name="Scene 17" Display="'Scene 17'" Dmx="132~139" />
      <Function ID="19" Name="Scene 18" Display="'Scene 18'" Dmx="140~146" />
      <Function ID="20" Name="Scene 19" Display="'Scene 19'" Dmx="147~154" />
      <Function ID="21" Name="Scene 20" Display="'Scene 20'" Dmx="155~162" />
      <Function ID="22" Name="Scene 21" Display="'Scene 21'" Dmx="163~170" />
      <Function ID="23" Name="Scene 22" Display="'Scene 22'" Dmx="171~177" />
      <Function ID="24" Name="Scene 23" Display="'Scene 23'" Dmx="178~185" />
      <Function ID="25" Name="Scene 24" Display="'Scene 24'" Dmx="186~193" />
      <Function ID="26" Name="Scene 25" Display="'Scene 25'" Dmx="194~200" />
      <Function ID="27" Name="Scene 26" Display="'Scene 26'" Dmx="201~208" />
      <Function ID="28" Name="Scene 27" Display="'Scene 27'" Dmx="209~216" />
      <Function ID="29" Name="Scene 28" Display="'Scene 28'" Dmx="217~224" />
      <Function ID="30" Name="Scene 29" Display="'Scene 29'" Dmx="225~231" />
      <Function ID="31" Name="Scene 30" Display="'Scene 30'" Dmx="232~239" />
      <Function ID="32" Name="Scene 31" Display="'Scene 31'" Dmx="240~247" />
      <Function ID="33" Name="Scene 32" Display="'Scene 32'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Record_Scenes" Name="Record Scenes" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Edit Scene Mode" Display="'Edit Scene Mode'" Dmx="11~128" />
      <Function ID="3" Name="Record Scene Mode" Display="'Record Scene Mode'" Dmx="129~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="6" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="6" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="7,8" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="9,10" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="6" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="7,8" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="9,10" Wheel="19" />
      <Attribute ID="Show" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Chase" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Scene" ChannelOffset="13" Wheel="24" />
      <Attribute ID="Record_Scenes" ChannelOffset="14" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Scenes Record, 7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="6" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Focus">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark On">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark On">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark Off">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Record Scene Mode">
      <Set Channel="Record_Scenes:3" Delay="6000" />
      <Set Channel="Record_Scenes:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:2" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:2" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">

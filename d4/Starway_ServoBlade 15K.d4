      <Locate Locate="1" PowerOn="1" Clear="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />

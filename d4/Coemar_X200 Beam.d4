      <Function ID="22" Name="Col 6/ Col 7" Display="'Col 6/ Col 7'" Dmx="56~59" WheelPosition="6" Colour="0,0,0" />
      <Function ID="23" Name="Col 7/ Col 8" Display="'Col 7/ Col 8'" Dmx="64~68" WheelPosition="7" Colour="0,0,0" />

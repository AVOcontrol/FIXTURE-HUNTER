  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4,Control:18" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Reset:2,Control:16" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3,Control:13" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2,Control:21" Delay="6000" />
      <Set Channel="Lamp:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3,Control:12" Delay="6000" />
      <Set Channel="Lamp:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Fast">
      <Set Channel="Function:2,Control:4" Delay="6000" />
      <Set Channel="Function:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Normal">
      <Set Channel="Function:3,Control:5" Delay="6000" />
      <Set Channel="Function:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Conventional">
      <Set Channel="Function:4,Control:2" Delay="6000" />
      <Set Channel="Function:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Function:5,Control:3" Delay="6000" />
      <Set Channel="Function:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark ON">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

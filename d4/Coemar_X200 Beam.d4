      <Function ID="29" Name="Col 13/ Col 14" Display="'Col 13/ Col 14'" Dmx="116~119" WheelPosition="13" Colour="0,0,0" />
      <Function ID="30" Name="Col 14/ Op" Display="'Col 14/ Op'" Dmx="124~127" WheelPosition="14" Colour="0,0,0" />
      <Function ID="31" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="32" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />

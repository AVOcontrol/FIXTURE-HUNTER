  <AtlaBase TypeID="ba9984c3-bd3d-4b23-ba68-bd667eb346ed" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~215" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Instant" Display="'Instant'" Dmx="0~0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="50~99" />
      <Function ID="3" Name="Soft" Display="'Soft'" Dmx="100~149" />
      <Function ID="4" Name="Smooth" Display="'Smooth'" Dmx="150~199" />
      <Function ID="5" Name="Very Smooth" Display="'Very Smooth'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_FX" Name="Beam FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static %.1f%%',0.0~100.0" Dmx="10~169" />
      <Function ID="3" Name="Dynamic" Display="'Dynamic %.f%%',0~100" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Beam_FX_Spd" Name="Beam FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Graphic_FX" Name="Graphic FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static 1" Display="'Static 1'" Dmx="0~0" />
      <Function ID="2" Name="Static 2" Display="'Static 2'" Dmx="10~19" />
      <Function ID="3" Name="Static 3" Display="'Static 3'" Dmx="20~29" />
      <Function ID="4" Name="Static 4" Display="'Static 4'" Dmx="30~39" />
      <Function ID="5" Name="Static 5" Display="'Static 5'" Dmx="40~49" />
      <Function ID="6" Name="Static 6" Display="'Static 6'" Dmx="50~59" />
      <Function ID="7" Name="Static 7" Display="'Static 7'" Dmx="60~69" />
      <Function ID="8" Name="Dynamic 1" Display="'Dynamic 1'" Dmx="70~79" />
      <Function ID="9" Name="Dynamic 2" Display="'Dynamic 2'" Dmx="80~89" />
      <Function ID="10" Name="Dynamic 3" Display="'Dynamic 3'" Dmx="90~99" />
      <Function ID="11" Name="Dynamic 4" Display="'Dynamic 4'" Dmx="100~109" />
      <Function ID="12" Name="Dynamic 5" Display="'Dynamic 5'" Dmx="110~119" />
      <Function ID="13" Name="Dynamic 6" Display="'Dynamic 6'" Dmx="120~255" />
    </Attribute>
    <Attribute ID="Graphic_FX_Spd" Name="Graphic FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:10000" PowerOn="1:10000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~10000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="50~99" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="100~149" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

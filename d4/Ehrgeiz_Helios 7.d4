    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan Auto" Display="'Fan Auto'" Dmx="11~15" />
      <Function ID="3" Name="Fan Silent" Display="'Fan Silent'" Dmx="16~20" />
      <Function ID="4" Name="Fan Standard" Display="'Fan Standard'" Dmx="21~25" />
      <Function ID="5" Name="Fan Full" Display="'Fan Full'" Dmx="26~30" />
      <Function ID="6" Name="Remote address low (1-256)" Display="'Remote address low (1-256)'" Dmx="36~40" />
      <Function ID="7" Name="Remote address high (257-512)" Display="'Remote address high (257-512)'" Dmx="46~50" />
      <Function ID="8" Name="Dim Smooth" Display="'Dim Smooth'" Dmx="56~60" />
      <Function ID="9" Name="Dim Fast" Display="'Dim Fast'" Dmx="61~65" />
      <Function ID="10" Name="Dim Linear" Display="'Dim Linear'" Dmx="71~75" />
      <Function ID="11" Name="Dim Theatrical" Display="'Dim Theatrical'" Dmx="76~80" />
      <Function ID="12" Name="Dim Square" Display="'Dim Square'" Dmx="81~85" />
      <Function ID="13" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="86~90" />
      <Function ID="14" Name="P/T Speed Slow" Display="'P/T Speed Slow'" Dmx="96~100" />
      <Function ID="15" Name="P/T Speed Normal" Display="'P/T Speed Normal'" Dmx="101~105" />
      <Function ID="16" Name="P/T Speed Fast" Display="'P/T Speed Fast'" Dmx="106~110" />
      <Function ID="17" Name="Pan Invert" Display="'Pan Invert'" Dmx="116~120" />
      <Function ID="18" Name="Pan Normal" Display="'Pan Normal'" Dmx="121~125" />
      <Function ID="19" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="126~130" />
      <Function ID="20" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="131~135" />
      <Function ID="21" Name="Pos Feedback On" Display="'Pos Feedback On'" Dmx="141~145" />
      <Function ID="22" Name="Pos Feedback Off" Display="'Pos Feedback Off'" Dmx="146~150" />
      <Function ID="23" Name="Reset Pan" Display="'Reset Pan'" Dmx="156~160" />
      <Function ID="24" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="161~165" />
      <Function ID="25" Name="Reset All" Display="'Reset All'" Dmx="171~175" />
      <Function ID="26" Name="Reset Fixture" Display="'Reset Fixture'" Dmx="176~180" />
    </Attribute>
    <Attribute ID="Remote_Address" Name="Remote Address" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Shutter" Name="Master Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f Hz',1.0~20.0" Dmx="200~239" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="16~47" Intensity="0~0" />
      <Function ID="5" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="48~79" Intensity="0~0" />
      <Function ID="6" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="80~111" Intensity="0~0" />
      <Function ID="7" Name="Rnd Pulse" Display="'Rnd Pulse %.f%%',0~100" Dmx="112~143" Intensity="0~0" />
      <Function ID="8" Name="Pause" Display="'Pause %.1f Sec',5.0~1.0" Dmx="144~199" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />

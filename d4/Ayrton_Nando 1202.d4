<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Nando 1202" ShortName="Nando 1202" Company="Ayrton" Version="3">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>e03ab2c9-30ac-48b3-b081-c78037353736</Thumbnail>
  <History Date="01-07-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="14-02-25" Author="Nic Morris" Comment="Updated in line with latest documentation (adds CRI 80 to CTO, adds more chase functions and changes white to lime - original documentation was RGBW)" Version="1" />
  <History Date="14-02-25" Author="Nic Morris" Comment="Revised Ring mode implementation so that the ring colour compenents are linked to 'Ring All' controls in the master and the master colour mixing controls work with the colour picker etc. in response to customer bug report." Version="1" />
  <History Date="14-02-25" Author="Nic Morris" Comment="Also changed the master dimmer to be a normal dimmer so that it behaves as HTP.  This comes with the compromise that the ring elements no longer have a virtual dimmer." Version="1" />
  <History Date="16-04-25" Author="Nic Morris" Comment="Added cell layout based on customer feedback (not documented)." Version="2" />
  <History Date="24-06-26" Author="Nic Morris" Comment="Created from Ayrton Nando 502 Wash (charts are very difficult to read.  Ayrton used to have good charts.  the new format is awful!  no pixel layout.  colour preset appendix is missing)" Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8dc95268-5818-4f7d-8c86-b9f04d683e53" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d13cd5a4-ae84-4680-805c-9563623855ff" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Inner_Colour" Name="Inner Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Inner_Shut/Spd" />
      <Function ID="2" Name="R" Display="'R'" Dmx="6~21" Update="Inner_Shut/Spd" />
      <Function ID="3" Name="G" Display="'G'" Dmx="22~37" Update="Inner_Shut/Spd" />
      <Function ID="4" Name="B" Display="'B'" Dmx="38~53" Update="Inner_Shut/Spd" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="54~69" Update="Inner_Shut/Spd" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="70~101" Update="Inner_Shut/Spd" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="102~117" Update="Inner_Shut/Spd" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="118~133" Update="Inner_Shut/Spd" />
      <Function ID="9" Name="Auto/ Sound 1" Display="'Auto/ Sound 1'" Dmx="134~149" Update="Inner_Shut/Spd" />
      <Function ID="10" Name="Auto/ Sound 2" Display="'Auto/ Sound 2'" Dmx="150~165" Update="Inner_Shut/Spd" />
      <Function ID="11" Name="Auto/ Sound 3" Display="'Auto/ Sound 3'" Dmx="166~181" Update="Inner_Shut/Spd" />
      <Function ID="12" Name="Auto/ Sound 4" Display="'Auto/ Sound 4'" Dmx="182~197" Update="Inner_Shut/Spd" />
      <Function ID="13" Name="Auto/ Sound 5" Display="'Auto/ Sound 5'" Dmx="198~213" Update="Inner_Shut/Spd" />
      <Function ID="14" Name="Auto/ Sound 6" Display="'Auto/ Sound 6'" Dmx="214~229" Update="Inner_Shut/Spd" />
      <Function ID="15" Name="Auto/ Sound 7" Display="'Auto/ Sound 7'" Dmx="230~245" Update="Inner_Shut/Spd" />
      <Function ID="16" Name="Auto/ Sound 8" Display="'Auto/ Sound 8'" Dmx="246~255" Update="Inner_Shut/Spd" />
    </Attribute>
    <Attribute ID="Inner_Shut/Spd" Name="Inner Shut/Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4,5" If="'Inner_Colour'&gt;8" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Outer_Ring" Name="Outer Ring" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Outer_Shut/Spd" />
      <Function ID="2" Name="Auto/ Sound 1" Display="'Auto/ Sound 1'" Dmx="6~30" Update="Outer_Shut/Spd" />
      <Function ID="3" Name="Auto/ Sound 2" Display="'Auto/ Sound 2'" Dmx="31~55" Update="Outer_Shut/Spd" />
      <Function ID="4" Name="Auto/ Sound 3" Display="'Auto/ Sound 3'" Dmx="56~80" Update="Outer_Shut/Spd" />
      <Function ID="5" Name="Auto/ Sound 4" Display="'Auto/ Sound 4'" Dmx="81~105" Update="Outer_Shut/Spd" />
      <Function ID="6" Name="Auto/ Sound 5" Display="'Auto/ Sound 5'" Dmx="106~130" Update="Outer_Shut/Spd" />
      <Function ID="7" Name="Auto/ Sound 6" Display="'Auto/ Sound 6'" Dmx="131~155" Update="Outer_Shut/Spd" />
      <Function ID="8" Name="Auto/ Sound 7" Display="'Auto/ Sound 7'" Dmx="156~180" Update="Outer_Shut/Spd" />
      <Function ID="9" Name="Auto/ Sound 8" Display="'Auto/ Sound 8'" Dmx="181~205" Update="Outer_Shut/Spd" />
      <Function ID="10" Name="Auto/ Sound 9" Display="'Auto/ Sound 9'" Dmx="206~230" Update="Outer_Shut/Spd" />
      <Function ID="11" Name="Auto/ Sound 10" Display="'Auto/ Sound 10'" Dmx="231~255" Update="Outer_Shut/Spd" />
    </Attribute>
    <Attribute ID="Outer_Shut/Spd" Name="Outer Shut/Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4,5" If="'Outer_Ring'&gt;2" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto/ Sound 1" Display="'Auto/ Sound 1'" Dmx="6~30" />
      <Function ID="3" Name="Auto/ Sound 2" Display="'Auto/ Sound 2'" Dmx="31~55" />
      <Function ID="4" Name="Auto/ Sound 3" Display="'Auto/ Sound 3'" Dmx="56~80" />
      <Function ID="5" Name="Auto/ Sound 4" Display="'Auto/ Sound 4'" Dmx="81~105" />
      <Function ID="6" Name="Auto/ Sound 5" Display="'Auto/ Sound 5'" Dmx="106~130" />
      <Function ID="7" Name="Auto/ Sound 6" Display="'Auto/ Sound 6'" Dmx="131~155" />
      <Function ID="8" Name="Auto/ Sound 7" Display="'Auto/ Sound 7'" Dmx="156~180" />
      <Function ID="9" Name="Auto/ Sound 8" Display="'Auto/ Sound 8'" Dmx="181~205" />
      <Function ID="10" Name="Auto/ Sound 9" Display="'Auto/ Sound 9'" Dmx="206~230" />
      <Function ID="11" Name="Auto/ Sound 10" Display="'Auto/ Sound 10'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">

    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~53" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="54~99" />

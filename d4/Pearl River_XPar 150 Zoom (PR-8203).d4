      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="16~31" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="32~47" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="48~63" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="64~79" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="80~95" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="96~111" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="112~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~143" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="144~159" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="160~175" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="176~191" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="192~207" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="208~223" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="224~239" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="User" Name="User" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~15" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="16~31" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="32~47" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="48~63" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="64~79" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="80~95" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="96~111" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="112~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~143" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="144~159" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="160~175" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="176~191" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="192~207" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="208~223" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="224~239" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Preset_Spd" Name="Preset Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 7 DMX" Channels="7">
    <Import PearlRef="PR8203ST" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="501f4e70-8c3a-4f83-b61b-339e6872a931" />
    <Include>
      <Attribute ID="Zoom" ChannelOffset="1" Wheel="19" />

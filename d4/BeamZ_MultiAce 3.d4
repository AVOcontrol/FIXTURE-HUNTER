  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="252360e3-9729-4d66-8aee-ace6b0197131" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="50~59" Colour="255,100,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="60~69" Colour="255,150,150" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="R+W" Display="'R+W'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="11" Name="G+B" Display="'G+B'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="B+W" Display="'B+W'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="W+A" Display="'W+A'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="A+P" Display="'A+P'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B" Display="'R+G+B'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="G+B+W" Display="'G+B+W'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="B+W+A" Display="'B+W+A'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="18" Name="W+A+P" Display="'W+A+P'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="19" Name="R+B+A" Display="'R+B+A'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="20" Name="B+W+A" Display="'B+W+A'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="21" Name="R+G+B+W+A+P" Display="'R+G+B+W+A+P'" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Motor" Name="Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="129~10" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
    </Attribute>
    <Attribute ID="xUV" Name="UV" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="SMD" Name="SMD" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~9" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="10~19" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="20~29" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="30~39" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="40~49" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5 %.f%%',0~100" Dmx="50~59" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6 %.f%%',0~100" Dmx="60~69" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="70~79" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="80~89" />
      <Function ID="10" Name="Sound 3" Display="'Sound 3 %.f%%',0~100" Dmx="90~99" />
      <Function ID="11" Name="Sound 4" Display="'Sound 4 %.f%%',0~100" Dmx="100~109" />
      <Function ID="12" Name="Sound 5" Display="'Sound 5 %.f%%',0~100" Dmx="110~119" />
      <Function ID="13" Name="Sound 6" Display="'Sound 6 %.1f%%',0.0~100.0" Dmx="120~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="936e1814-76de-42db-9885-f0fcb31da9f8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

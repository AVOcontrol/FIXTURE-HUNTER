      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Amber" Number="4" Page="1" SetControl="Colour1:6" />

  <History Date="25-08-17" Author="Nic Morris" Comment="Created (poor documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="50~99" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="100~149" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" WheelPosition="1" Colour="0,0,0" />
      <Function ID="2" Name="White" Display="'White'" Dmx="6~10" WheelPosition="0" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="11~15" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="16~20" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="21~25" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="26~30" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="31~35" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="36~40" Colour="128,0,255" />
      <Function ID="9" Name="7 Col Run" Display="'7 Col Run %.f%%',0~100" Dmx="41~110" Colour="255,255,255" />
      <Function ID="10" Name="7 Col Mix" Display="'7 Col Mix %.f%%',0~100" Dmx="111~180" Colour="255,255,255" />
      <Function ID="11" Name="7 Col Run" Display="'7 Col Run %.f%%',0~100" Dmx="181~250" Colour="255,255,255" />
      <Function ID="12" Name="7 Col Static" Display="'7 Col Static'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="101~128" />
      <Function ID="3" Name="FWD" Display="'FWD %.f%%',0~100" Dmx="191~129" />
      <Function ID="4" Name="REV" Display="'REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~105" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="106~127" />
      <Function ID="3" Name="FWD" Display="'FWD %.f%%',0~100" Dmx="191~128" />
      <Function ID="4" Name="REV" Display="'REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Flip_X" Name="Flip X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flip" Display="'Flip %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Flip_Y" Name="Flip Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flip" Display="'Flip %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="192~255" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Auto_Zoom" Name="Auto Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="5~85" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="86~170" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Dot" Name="Dot" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Dot" Display="'Dot %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Draw" Name="Draw" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Draw" Display="'Draw %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Draw/ Erase" Display="'Draw/ Erase %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="PTEQVIXN" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Y-Move" ChannelOffset="4" Wheel="3" />
      <Attribute ID="X-Move" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Flip_X" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Flip_Y" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Rotate" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Auto_Zoom" ChannelOffset="9" Wheel="50" />

  <History Date="18-01-18" Author="Nic Morris" Comment="Added missing swatch to gobo wheel 1 slot 5." Version="12" />
  <History Date="09-03-20" Author="Nic Morris" Comment="Created from Robe Robin MegaPointe (a lot of information missing or unusable.  assumed identical)" Version="13" />
  <History Date="10-03-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />
  <History Date="21-09-25" Author="Nic Morris" Comment="Created from XMLite MegaPlus480 (documentation is a mess.  colour names are all 'gobo' and gobo images are unusable.  assumed identical and left the same for now)" Version="15" />
  <History Date="25-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="16" />

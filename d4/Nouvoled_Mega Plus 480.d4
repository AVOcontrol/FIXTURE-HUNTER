      <Condition Name="Scroll" ID="45,46,47,48" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Condition Name="Random" ID="49,50,51" If="'Gobo2Func'==7||'Gobo2Func'==8" />

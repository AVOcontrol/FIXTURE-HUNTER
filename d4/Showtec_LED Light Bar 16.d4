<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Light Bar 16" ShortName="LiteBar 16" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-12-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="110b4d8f-1757-4f10-a6c4-64704bc9753c" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static Col" Display="'Static Col'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~19" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Progarm 2" Display="'Progarm 2'" Dmx="20~29" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="30~39" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="40~49" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="50~59" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="60~69" Update="Colour1" Colour="255,255,255" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="70~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="80~89" Update="Colour1" Colour="255,255,255" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="90~99" Update="Colour1" Colour="255,255,255" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="100~109" Update="Colour1" Colour="255,255,255" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="110~119" Update="Colour1" Colour="255,255,255" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="120~129" Update="Colour1" Colour="255,255,255" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="130~139" Update="Colour1" Colour="255,255,255" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="140~149" Update="Colour1" Colour="255,255,255" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="150~159" Update="Colour1" Colour="255,255,255" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="160~169" Update="Colour1" Colour="255,255,255" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="170~179" Update="Colour1" Colour="255,255,255" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="180~189" Update="Colour1" Colour="255,255,255" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="190~199" Update="Colour1" Colour="255,255,255" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="200~209" Update="Colour1" Colour="255,255,255" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="210~255" Update="Colour1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour" ID="1,2,3,4,5,6,7,8" If="'Colour_Macro'==1" />
      <Condition Name="Sound" ID="9" If="'Colour_Macro'==22" />
      <Else ID="10" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~39" Colour="255,255,255" />
      <Function ID="3" Name="Red+Green" Display="'Red+Green'" Dmx="40~79" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="80~119" Colour="255,255,255" />
      <Function ID="5" Name="Green+Blue" Display="'Green+Blue'" Dmx="120~159" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="160~199" Colour="255,255,255" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="200~239" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="240~255" Colour="255,255,255" />
      <Function ID="9" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="10" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="3~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 3 DMX" Channels="3">
    <Import PearlRef="SHLB161" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

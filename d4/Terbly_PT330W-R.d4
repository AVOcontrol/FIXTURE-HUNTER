  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:5" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:7" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Col">
      <Set Channel="Control:8" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Int">
      <Set Channel="Control:9" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:10" Delay="8000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

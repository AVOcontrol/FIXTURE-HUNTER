      <Function ID="17" Name="1/ 2" Display="'1/ 2'" Dmx="15~19" WheelPosition="1" Colour="0,0,0" />
      <Function ID="18" Name="2/ 3" Display="'2/ 3'" Dmx="25~29" WheelPosition="2" Colour="0,0,0" />

    <Attribute ID="Strobe_FX_Spd" Name="Strobe FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ambient_Master" Name="Ambient Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />

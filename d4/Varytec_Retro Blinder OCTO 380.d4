    </Attribute>
    <Attribute ID="Ambient_FX" Name="Ambient FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="100~255" />
    </Attribute>
    <Attribute ID="Ambient_FX_Spd" Name="Ambient FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

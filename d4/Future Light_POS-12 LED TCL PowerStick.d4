<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="POS-12 LED TCL PowerStick" ShortName="POS-12 TCL" Company="Future Light">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="28-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="02-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e94894b8-70d5-4ed8-91c5-6d0430aedde2" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;1" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~114" Update="Shutter" />
      <Function ID="5" Name="Chase" Display="'Chase'" Dmx="115~127" Update="Shutter" />
      <Function ID="6" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="128~159" Update="Shutter" />
      <Function ID="7" Name="3 Col Switch" Display="'3 Col Switch'" Dmx="160~191" Update="Shutter" />
      <Function ID="8" Name="7 Col Switch" Display="'7 Col Switch'" Dmx="192~223" Update="Shutter" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

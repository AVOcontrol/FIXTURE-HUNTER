  <History Date="23-01-26" Author="Nic Morris" Comment="Created (no cell layout.  guessed)" Version="0" />
  <History Date="26-01-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="03-08-26" Author="Nic Morris" Comment="Updated in line with latest charts in repsonse to manufacturer request." Version="2" />
  <History Date="04-08-26" Author="Nic Morris" Comment="Added Atlabase ID's for new modes." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c0b152c8-978f-4c40-a45b-e2c4314f0e69" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="WW 1" Display="'WW 1'" Dmx="51~55" Update="Effect_Spd" />
      <Function ID="3" Name="WW 2" Display="'WW 2'" Dmx="56~60" Update="Effect_Spd" />
      <Function ID="4" Name="WW 3" Display="'WW 3'" Dmx="61~64" Update="Effect_Spd" />
      <Function ID="5" Name="WW 4" Display="'WW 4'" Dmx="65~69" Update="Effect_Spd" />
      <Function ID="6" Name="CW 1" Display="'CW 1'" Dmx="70~73" Update="Effect_Spd" />
      <Function ID="7" Name="CW 2" Display="'CW 2'" Dmx="74~78" Update="Effect_Spd" />
      <Function ID="8" Name="CW 3" Display="'CW 3'" Dmx="79~82" Update="Effect_Spd" />
      <Function ID="9" Name="CW 4" Display="'CW 4'" Dmx="83~87" Update="Effect_Spd" />
      <Function ID="10" Name="WW" Display="'WW'" Dmx="88~91" Update="Effect_Spd" />
      <Function ID="11" Name="CW" Display="'CW'" Dmx="92~96" Update="Effect_Spd" />
      <Function ID="12" Name="White" Display="'White'" Dmx="97~100" Update="Effect_Spd" />
      <Function ID="13" Name="Jump" Display="'Jump'" Dmx="101~150" Update="Effect_Spd" />
      <Function ID="14" Name="Gradual" Display="'Gradual'" Dmx="151~200" Update="Effect_Spd" />
      <Function ID="15" Name="Pulse" Display="'Pulse'" Dmx="201~250" Update="Effect_Spd" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2,3" If="'Macro'==16" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sound Mode 1" Display="'Sound Mode 1'" Dmx="0~0" />
      <Function ID="3" Name="Sound Mode 2" Display="'Sound Mode 2'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

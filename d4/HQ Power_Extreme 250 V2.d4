<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Extreme 250 Version 2" ShortName="Ex250 V2" Company="HQ Power">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="13-12-07" Author="Ion Balan" Comment="Created" />
  <History Date="13-12-07" Author="Ion Balan" Comment="Checked" />
  <History Date="14-10-08" Author="Jonathan Moreton" Comment="Updated manufacturer name" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="12-03-12" Author="Peter Budd" Comment="Edited for version 6 and added auto-palettes." />
  <History Date="21-08-12" Author="Peter Budd" Comment="Created from HQ Power Extreme 250" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9a79fb64-2b5a-4b34-a711-eb2a9bafbb5f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="96~127" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="160~191" Colour="255,128,64" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="192~223" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="224~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="224~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="15~29" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~250" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="121~137" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="0~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~137" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="138~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="HQE250V2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="240" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="973b9b22-9992-4228-8039-303e56825a16" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Gobo1Rot" ChannelOffset="4" Wheel="14" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:4" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:4" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:4" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter" />
  </Palettes>
</Fixture>
    <AtlaBase ModeID="5abecc2a-4db5-4e21-ac82-e0ba72bb8683" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />

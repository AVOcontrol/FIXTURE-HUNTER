      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="44~47" WheelPosition="11" />
      <Function ID="13" Name="Dynamic Pattern" Display="'Dynamic Pattern'" Dmx="48~71" WheelPosition="12" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="15" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="160~166" WheelPosition="1" />
      <Function ID="16" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="167~172" WheelPosition="2" />
      <Function ID="17" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="173~179" WheelPosition="3" />
      <Function ID="18" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="180~185" WheelPosition="4" />
      <Function ID="19" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="186~191" WheelPosition="5" />

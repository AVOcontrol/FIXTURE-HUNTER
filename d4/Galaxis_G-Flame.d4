  <History Date="22-02-18" Author="Nic Morris" Comment="Created (documentation isn't great.  tried to ensure this is safe.  in particular safety will not arm on locate)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Flame" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Flame" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Safety" Name="Safety" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disarmed" Display="'Disarmed'" Dmx="0~0" />
      <Function ID="2" Name="Armed" Display="'Armed'" Dmx="200~200" />
    </Attribute>
  </Control>
  <Mode Name="Safety, 1 DMX" Channels="1">
    <Import PearlRef="UKGALGFS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Safety" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Flame, 1 DMX" Channels="1">
    <Import PearlRef="UKGALGFF" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="32c365de-aa5d-4b8f-9561-08d044c49351"></Swatch>
  </swatchLibrary>
</Fixture>
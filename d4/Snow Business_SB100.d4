<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SB100" ShortName="SB100" Company="Snow Business">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="26-06-19" Author="Gregory Haynes" Comment="Created" />
  <History Date="02-07-19" Author="Nic Morris" Comment="Fixed shutter power on value.  Moved air flow and flake size into intensity wheel slot and group to collect controls together." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Air Flow" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Air Flow" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Size" Name="Flake Size" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flake Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Size" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Reserved" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
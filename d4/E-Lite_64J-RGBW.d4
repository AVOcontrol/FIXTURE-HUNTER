  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="66335193-8268-4db9-a492-c50e19c1eff8" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="176~255" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="96~175" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~17" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="18~29" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="30~41" Colour="255,255,128" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="42~53" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="54~65" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="66~77" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="78~89" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="90~101" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="102~113" Colour="255,128,255" />
      <Function ID="11" Name="Violet" Display="'Violet'" Dmx="114~125" Colour="180,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="126~137" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="138~149" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="150~161" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="162~173" Colour="255,255,255" />
      <Function ID="16" Name="Cool White" Display="'Cool White'" Dmx="174~185" Colour="230,230,255" />
      <Function ID="17" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="186~220" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="36~55" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="56~75" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="76~95" Colour="255,255,255" />
      <Function ID="5" Name="3500K" Display="'3500K'" Dmx="96~115" Colour="255,255,255" />
      <Function ID="6" Name="4000K" Display="'4000K'" Dmx="116~135" Colour="255,255,255" />
      <Function ID="7" Name="4500K" Display="'4500K'" Dmx="136~155" Colour="255,255,255" />
      <Function ID="8" Name="5000K" Display="'5000K'" Dmx="156~175" Colour="255,255,255" />
      <Function ID="9" Name="5500K" Display="'5500K'" Dmx="176~195" Colour="255,255,255" />
      <Function ID="10" Name="6000K" Display="'6000K'" Dmx="196~215" Colour="255,255,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="216~235" Colour="255,255,255" />
      <Function ID="12" Name="7200K" Display="'7200K'" Dmx="236~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 1 (Col Jump)" Display="'Show 1 (Col Jump)'" Dmx="16~95" />
      <Function ID="3" Name="Show 2 (Col Strobe)" Display="'Show 2 (Col Strobe)'" Dmx="96~175" />
      <Function ID="4" Name="Show 3 (Col Fade)" Display="'Show 3 (Col Fade)'" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="24-10-03" Author="Greg Brown" Comment="Created" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 2. Pan F - (16 bit)" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 3. Tilt F - (16 bit)" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 4. R - (Power On) 0" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 5. E - (Power On) 0" />
  <History Date="10-02-04" Author="L.Gallagher" Comment="Error Found 6. B - (Power On) 0" />
  <History Date="12-07-04" Author="Phil Rogers" Comment="Above all fixed except macros - none found on DMX Protocol" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="27-10-11" Author="John Rogers" Comment="Added Virtual Dimmer and Palettes." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="19-04-17" Author="Nic Morris" Comment="Changed name from Eyecolor to EasyColor.  Standardised RGB function names." />
  <History Date="19-04-17" Author="Nic Morris" Comment="Changed RGB to power on and locate at full." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="16761" ModelID="0" />
  </RDM>
  <AtlaBase TypeID="19894f18-c5d2-415c-adbd-0d0891b81bb3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:50" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Rainbow" Name="Rainbow" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Rainbow" Display="'Rainbow %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="ATNEyeclrM1" DiamondRef="" WysiwygRef="" />
    <Physical>

    </Attribute>
    <Attribute ID="Effect_Spd" Name="Aura FX" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="L-&gt;R" Display="'L-&gt;R %.1f%%',100.0~0.0" Dmx="0~126" />

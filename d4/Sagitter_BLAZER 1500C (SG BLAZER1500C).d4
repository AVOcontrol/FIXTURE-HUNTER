      <Function ID="7" Name="Fan Fast" Display="'Fan Fast'" Dmx="56~63" />
      <Function ID="8" Name="Fan Normal" Display="'Fan Normal'" Dmx="64~71" />
      <Function ID="9" Name="Fan Slow" Display="'Fan Slow'" Dmx="72~79" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="88~95" />
    </Attribute>
    <Attribute ID="Aura_FX_Select" Name="Aura FX Select" Description="" Group="E">

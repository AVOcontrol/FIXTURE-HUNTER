      <Function ID="27" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="136~140" Colour="255,255,0" />
      <Function ID="28" Name="Deep Amber" Display="'Deep Amber'" Dmx="141~145" Colour="255,100,0" />

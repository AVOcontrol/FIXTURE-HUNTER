      <Function ID="2" Name="Section 1" Display="'Section 1'" Dmx="8~31" />
      <Function ID="3" Name="Section 2" Display="'Section 2'" Dmx="32~55" />
      <Function ID="4" Name="Section 3" Display="'Section 3'" Dmx="56~79" />
      <Function ID="5" Name="Section 4" Display="'Section 4'" Dmx="80~103" />
      <Function ID="6" Name="L-&gt;R" Display="'L-&gt;R %.f%%',100~0" Dmx="104~179" />

      <Function ID="11" Name="Blue-Green (2)" Display="'Blue-Green (2)'" Dmx="86~86" WheelPosition="10" Colour="0,255,128" />
      <Function ID="12" Name="CTO260" Display="'CTO260'" Dmx="94~94" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="CTO190" Display="'CTO190'" Dmx="103~103" WheelPosition="12" Colour="255,240,200" />
      <Function ID="14" Name="CTB8000" Display="'CTB8000'" Dmx="111~111" WheelPosition="13" Colour="230,230,255" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="120~120" WheelPosition="14" Colour="0,0,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~5" WheelPosition="0" Colour="255,255,255" />

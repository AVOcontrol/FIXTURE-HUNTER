      <Function ID="18" Name="Org/ BG1" Display="'Org/ BG1'" Dmx="22~22" WheelPosition="2" Colour="255,128,0" />
      <Function ID="19" Name="BG1/ Grn" Display="'BG1/ Grn'" Dmx="30~30" WheelPosition="3" Colour="0,255,200" />
      <Function ID="20" Name="Grn/ B Grn" Display="'Grn/ B Grn'" Dmx="39~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="21" Name="B Grn/ Lav" Display="'B Grn/ Lav'" Dmx="47~47" WheelPosition="5" Colour="128,255,0" />
      <Function ID="22" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="56~56" WheelPosition="6" Colour="255,128,255" />
      <Function ID="23" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="64~64" WheelPosition="7" Colour="255,150,150" />
      <Function ID="24" Name="Yel/ Ppl" Display="'Yel/ Ppl'" Dmx="73~73" WheelPosition="8" Colour="255,255,0" />
      <Function ID="25" Name="Ppl/ BG2" Display="'Ppl/ BG2'" Dmx="82~82" WheelPosition="9" Colour="128,0,255" />
      <Function ID="26" Name="BG2/ 260" Display="'BG2/ 260'" Dmx="90~90" WheelPosition="10" Colour="0,255,128" />

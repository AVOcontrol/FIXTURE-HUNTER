<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SMD Matrix Light" ShortName="SMD Matrix" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="03-10-24" Author="Nic Morris" Comment="Created (very poor documentation.  no pixel layout.  made best guess)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Lightniing" Display="'Lightniing %.f%%',0~100" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Fixed Col" Display="'Fixed Col %.1f%%',0.0~100.0" Dmx="8~127" Colour="0,0,0" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Sel" />
      <Function ID="2" Name="Letters" Display="'Letters'" Dmx="16~75" Update="Effect_Sel" />
      <Function ID="3" Name="Numbers" Display="'Numbers'" Dmx="76~135" Update="Effect_Sel" />
      <Function ID="4" Name="Static Pattern" Display="'Static Pattern'" Dmx="136~195" Update="Effect_Sel" />
      <Function ID="5" Name="Dynamic Pattern" Display="'Dynamic Pattern'" Dmx="196~255" Update="Effect_Sel" />
    </Attribute>
    <Attribute ID="Effect_Sel" Name="Effect Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Letters" ID="2,3" If="'Effect_Func'==2" />
      <Condition Name="Numbers" ID="4,5" If="'Effect_Func'==3" />
      <Condition Name="Static Pattern" ID="6,7" If="'Effect_Func'==4" />
      <Condition Name="Dynamic Pattern" ID="8,9" If="'Effect_Func'==5" />
      <Function ID="1" Name="No Effect" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Rand Letters" Display="'Rand Letters'" Dmx="0~0" />
      <Function ID="3" Name="Letter" Display="'Letter %.1f%%',0.0~100.0" Dmx="6~213" />
      <Function ID="4" Name="Rand Number" Display="'Rand Number'" Dmx="0~0" />
      <Function ID="5" Name="Number" Display="'Number %.1f%%',0.0~100.0" Dmx="6~115" />
      <Function ID="6" Name="Rand Number" Display="'Rand Number'" Dmx="0~0" />
      <Function ID="7" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="6~224" />
      <Function ID="8" Name="Rand Number" Display="'Rand Number'" Dmx="0~0" />
      <Function ID="9" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="6~105" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="0~8" />
      <Function ID="2" Name="Location Sel" Display="'Location Sel %.1f%%',0.0~100.0" Dmx="9~128" />
      <Function ID="3" Name="FWD" Display="'FWD %.f%%',100~0" Dmx="129~191" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="192~192" />
      <Function ID="5" Name="REV" Display="'REV %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Mobile" Name="Mobile" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Horiz Move" Display="'Horiz Move'" Dmx="0~0" />
      <Function ID="2" Name="Vert Move" Display="'Vert Move'" Dmx="255~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mirror" Name="Mirror" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Mirror" Display="'No Mirror'" Dmx="0~0" />
      <Function ID="2" Name="Horiz Mirror" Display="'Horiz Mirror'" Dmx="64~127" />
      <Function ID="3" Name="Vert Mirror" Display="'Vert Mirror'" Dmx="128~191" />
      <Function ID="4" Name="Horiz+Vert Mirror" Display="'Horiz+Vert Mirror'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="90°" Display="'90°'" Dmx="64~127" />
      <Function ID="3" Name="180°" Display="'180°'" Dmx="128~191" />
      <Function ID="4" Name="270°" Display="'270°'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

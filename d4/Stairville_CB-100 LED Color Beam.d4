<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CB-100 LED Color Beam" ShortName="CB-100" Company="Stairville" Version="2">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>6974a435-0df4-4224-b085-8dd1fe9353b3</Thumbnail>
  <History Date="30-04-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-02-23" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d1b147a3-30db-4e48-afe4-4aa35aeb2d8c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Deep Blue'" Dmx="8~15" WheelPosition="1" Colour="0,0,180" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="24~31" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="40~47" WheelPosition="5" Colour="255,0,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="48~55" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Orange Red" Display="'Orange Red'" Dmx="56~63" WheelPosition="7" Colour="255,100,0" />
      <Function ID="9" Name="Op/ Dk Bl" Display="'Op/ Dk Bl'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Dk Bl/ Yel" Display="'Dk Bl/ Yel'" Dmx="72~79" WheelPosition="1" Colour="0,0,180" />
      <Function ID="11" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="80~87" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Pk/ Grn" Display="'Pk/ Grn'" Dmx="88~95" WheelPosition="3" Colour="255,150,150" />
      <Function ID="13" Name="Grn/ Red" Display="'Grn/ Red'" Dmx="96~103" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Red/ Lt Bl" Display="'Red/ Lt Bl'" Dmx="104~111" WheelPosition="5" Colour="255,0,0" />
      <Function ID="15" Name="Lt Bl/ Org Rd" Display="'Lt Bl/ Org Rd'" Dmx="112~119" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="Org Rd/ Op" Display="'Org Rd/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,100,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~7" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~215" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Col in Dark" Display="'Col in Dark'" Dmx="11~60" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="61~110" />
      <Function ID="4" Name="Audio in Dark" Display="'Audio in Dark'" Dmx="111~160" />
      <Function ID="5" Name="Reset Col" Display="'Reset Col'" Dmx="161~210" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="211~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SVCB100" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c4d5ce62-ed00-4a89-b757-37b19ad67319" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Col">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="3" Name="Orange Red" Number="3" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Dark Blue" Number="7" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="11" Name="Dark Blue" Number="9" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="15" Name="Dark Blue" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="8" Name="Closed" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="6974a435-0df4-4224-b085-8dd1fe9353b3"></Swatch>
  </swatchLibrary>
</Fixture>
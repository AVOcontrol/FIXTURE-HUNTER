<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RGB LED PAR 56" ShortName="RGB LPAR56" Company="CLS-LED" Version="10">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="27-04-07" Author="D.Milligan" Comment="Created" Version="1" />
  <History Date="27-04-07" Author="D.Milligan" Comment="Checked" Version="2" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="3" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Added fixture type, added palettes" Version="4" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Removed non-vdim modes, fixed power on and locate" Version="5" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Edited dimmer so size is no longer 0 for version 6." Version="6" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="7" />
  <History Date="03-05-17" Author="Nic Morris" Comment="Added Atlabase ID's (used CLS LED Par56-V3 (Black))" Version="8" />
  <History Date="17-02-22" Author="Nic Morris" Comment="Added modes with BRG component order in response to customer feedback (this is contrary to the documentation)" Version="9" />
  <History Date="18-02-22" Author="Nic Morris" Comment="Added Atlabase IDs for BRG modes.  Corrected Mode 1 (BRG) mapping." Version="10" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="81e630d5-d00c-4387-b71f-c85380a0069b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="64~127" />
      <Function ID="3" Name="7 Col Chase" Display="'7 Col Chase'" Dmx="128~191" />
      <Function ID="4" Name="3 Col Chase" Display="'3 Col Chase'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="100~11" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="101~150" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="151~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 5 DMX" Channels="5">
    <Import PearlRef="CU_RGBPR561" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1a47457e-fa70-48b9-994b-98a4b92cba63" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 3 DMX" Channels="3">
    <Import PearlRef="CU_RGBPR562" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9a21f0cf-cdd7-4242-8756-f4db15c52017" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 1 (BRG), 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b784746b-7cbf-46b9-bfac-1d4446d07bd8" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Blue" ChannelOffset="2" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" VirtualControl="Dimmer" />

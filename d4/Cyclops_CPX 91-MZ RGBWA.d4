      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="180~199" />
      <Function ID="13" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="14" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="15" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="16" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="17" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="18" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dim Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Nonlin 1" Display="'Nonlin 1'" Dmx="30~69" />

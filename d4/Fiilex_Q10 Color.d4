    <Attribute ID="Green_Adjust8bit" Name="Green Adjust" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Mag-&gt;Grn" Display="'Mag-&gt;Grn %.f%%',-100~100" Dmx="10~255" Colour="255,255,255" />

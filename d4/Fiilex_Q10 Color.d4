      <Function ID="1" Name="No Function (Raw DMX)" Display="'No Function (Raw DMX) %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Param_5" Name="Colour Param 5" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CCT+HSI (Saturation)" ID="2" If="'Colour_Mode'==4" />

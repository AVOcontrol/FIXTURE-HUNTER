      <Function ID="12" Name="Effect 2" Display="'Effect 2'" Dmx="110~119" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="13" Name="Effect 3" Display="'Effect 3'" Dmx="120~129" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="14" Name="Effect 4" Display="'Effect 4'" Dmx="130~139" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="15" Name="Effect 5" Display="'Effect 5'" Dmx="140~149" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
    </Attribute>
    <Attribute ID="FX_Function_1" Name="FX Function 1" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Candle/Lightning/Paparazzi" ID="2,3,4" If="'FX_Selection'==2||'FX_Selection'==7||'FX_Selection'==8" />
      <Condition Name="Club Light" ID="5,6,7,8,9,10,11" If="'FX_Selection'==3" />

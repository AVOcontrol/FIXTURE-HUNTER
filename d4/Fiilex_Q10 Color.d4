    <Attribute ID="FX_Selection" Name="FX Selection" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="2" Name="Candle" Display="'Candle'" Dmx="10~19" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="3" Name="Club Light" Display="'Club Light'" Dmx="20~29" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="4" Name="Colour Chase" Display="'Colour Chase'" Dmx="30~39" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="5" Name="Cop Car" Display="'Cop Car'" Dmx="40~49" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="6" Name="Fireworks" Display="'Fireworks'" Dmx="50~59" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="7" Name="Lightning" Display="'Lightning'" Dmx="60~69" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="8" Name="Paparazzi" Display="'Paparazzi'" Dmx="70~79" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="9" Name="Strobe" Display="'Strobe'" Dmx="80~89" Update="FX_Function_1, FX_Function_2, FX_Function_3" />
      <Function ID="10" Name="Television" Display="'Television'" Dmx="90~99" Update="FX_Function_1, FX_Function_2, FX_Function_3" />

    <Attribute ID="Colour_Param_3" Name="Colour Param 3" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="RGBW (Blue)" ID="2" If="'Colour_Mode'==3" />
      <Condition Name="CCT+HSI/CCT+RGBW/CCT+xy (Crossfade)" ID="3" If="'Colour_Mode'==4||'Colour_Mode'==5||'Colour_Mode'==9" />
      <Condition Name="ICTHS (Hue)" ID="4" If="'Colour_Mode'==10" />
      <Condition Name="FX (Speed)" ID="5,6,7,8,9" If="'Colour_Param_1'==28||'Colour_Param_1'==29||'Colour_Param_1'==30||'Colour_Param_1'==32||'Colour_Param_1'==33||'Colour_Param_1'==34" />
      <Condition Name="FX (Cop Car)" ID="10,11,12,13" If="'Colour_Param_1'==31" />

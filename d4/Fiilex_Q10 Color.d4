      <Function ID="3" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="4" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />

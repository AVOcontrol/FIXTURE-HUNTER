    <Attribute ID="FX_Function_2" Name="FX Function 2" Description="" Group="E" Size="2">
      <Locate Locate="10:0" PowerOn="10:0" />
      <Condition Name="Speed" ID="1,2,3,4,5" If="'FX_Selection'==2||'FX_Selection'==3||'FX_Selection'==4||'FX_Selection'==6||'FX_Selection'==7||'FX_Selection'==8" />
      <Condition Name="Flash Pattern (Cop Car)" ID="6,7,8,9" If="'FX_Selection'==5" />
      <Condition Name="Saturation (Strobe)" ID="11" If="'FX_Selection'==9" />

      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f Hz',1.0~25.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour_Param_2" Name="Colour Param 2" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CCT/CCT+RGBW/CCT+xy/ICTHS/ICTRGBW/ICTxy (Green Adjust)" ID="2,3" If="'Colour_Mode'==1||'Colour_Mode'==5||'Colour_Mode'==9||'Colour_Mode'==10||'Colour_Mode'==11||'Colour_Mode'==12" />
      <Condition Name="HSI/CCT+HSI (Saturation)" ID="4" If="'Colour_Mode'==2||'Colour_Mode'==4" />
      <Condition Name="RGBW (Green)" ID="5" If="'Colour_Mode'==3" />
      <Condition Name="CIExy (Y)" ID="6" If="'Colour_Mode'==6" />
      <Condition Name="GEL (CCT)" ID="7,8" If="'Colour_Mode'==7" />
      <Condition Name="FX (Candle/Lightning/Paparazzi)" ID="9,10,11" If="'Colour_Param_1'==28||'Colour_Param_1'==33||'Colour_Param_1'==34" />
      <Condition Name="FX (Club Light)" ID="12,13,14,15,16,17,18" If="'Colour_Param_1'==29" />
      <Condition Name="FX (Colour Chase)" ID="19" If="'Colour_Param_1'==30" />

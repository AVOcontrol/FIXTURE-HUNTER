<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intimidator Beam LED 350" ShortName="IBm350" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="20-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="21-02-12" Author="Peter Budd" Comment="Edited renamed Bounce to Shake" />
  <History Date="06-08-12" Author="Peter Budd" Comment="Edited added Highlight and Lowlight values." />
  <History Date="21-08-12" Author="Peter Budd" Comment="Edited updated P/T Speed power on and locate values to 100%." />
  <History Date="01-10-12" Author="Peter Budd" Comment="Created from Chauvet Intimidator Spot LED 250" />
  <History Date="11-02-16" Author="Nic Morris" Comment="Removed 'QRG' from name.  Changed shutter power on to open." />
  <History Date="11-02-16" Author="Nic Morris" Comment="Added colour function index.  Standardised scroll directions.  Added missing raw option to gobo func." />
  <History Date="11-02-16" Author="Nic Morris" Comment="Inverted P/T speed wheel direction.  Renamed prism effect to frost." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="432aaf8c-78a7-4c2c-b0ba-5d36bec669c0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="9" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split Gel" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~6" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="7~13" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="14~20" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~27" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="28~34" WheelPosition="4" Colour="255,0,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="35~41" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="42~48" WheelPosition="6" Colour="0,255,0" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="49~55" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Dark Blue" Display="'Deep Blue'" Dmx="56~63" WheelPosition="8" Colour="0,0,180" />
      <Function ID="10" Name="Op/Yell" Display="'Op/Yell %.f%%',0~100" Dmx="64~70" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Yell/Pi" Display="'Yell/Pi %.f%%',0~100" Dmx="71~77" WheelPosition="1" Colour="255,255,0" />
      <Function ID="12" Name="Pi/Grn" Display="'Pi/Grn %.f%%',0~100" Dmx="78~84" WheelPosition="2" Colour="255,150,150" />
      <Function ID="13" Name="Grn/Rd" Display="'Grn/Rd %.f%%',0~100" Dmx="85~91" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Rd/Lt Bl" Display="'Rd/Lt Bl %.f%%',0~100" Dmx="92~98" WheelPosition="4" Colour="255,0,0" />
      <Function ID="15" Name="Lt Bl/Grn" Display="'Lt Bl/Grn %.f%%',0~100" Dmx="99~105" WheelPosition="5" Colour="255,100,100" />
      <Function ID="16" Name="Grn/Or" Display="'Grn/Or %.f%%',0~100" Dmx="106~112" WheelPosition="6" Colour="0,255,0" />
      <Function ID="17" Name="Or/Dk Bl" Display="'Or/Dk Bl %.f%%',0~100" Dmx="113~119" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="Dk Bl/Op" Display="'Dk Bl/Op %.f%%',0~100" Dmx="120~127" WheelPosition="8" Colour="0,0,180" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17" If="'Gobo1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~63" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="64~79" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~12" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="130~13" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~247" />
      <Function ID="5" Name="Frost" Display="'Frost'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~3" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~7" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="146~215" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="216~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Blackout on P/T" Display="'Blackout on P/T'" Dmx="8~15" />
      <Function ID="3" Name="Blackout on Colour" Display="'Blackout on Colour'" Dmx="16~23" />
      <Function ID="4" Name="Blackout on Gobo" Display="'Blackout on Gobo'" Dmx="24~31" />
      <Function ID="5" Name="No P/T BO" Display="'No P/T BO'" Dmx="32~39" />
      <Function ID="6" Name="No Col BO" Display="'No Col BO'" Dmx="40~47" />
      <Function ID="7" Name="No Gobo BO" Display="'No Gobo BO'" Dmx="48~55" />
      <Function ID="8" Name="Safe" Display="'Safe'" Dmx="56~95" />
      <Function ID="9" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="10" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="11" Name="Reset Colour" Display="'Reset Colour'" Dmx="112~119" />
      <Function ID="12" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="13" Name="Reset Prism" Display="'Reset Prism'" Dmx="128~135" />
      <Function ID="14" Name="Reset Focus" Display="'Reset Focus'" Dmx="136~143" />
      <Function ID="15" Name="Reset All" Display="'Reset All'" Dmx="144~159" />
      <Function ID="16" Name="Safe" Display="'Safe'" Dmx="160~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~23" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="24~39" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="40~55" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="56~71" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="72~87" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="88~103" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="104~119" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="120~135" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="136~151" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="152~167" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="168~183" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="184~199" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="200~215" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="216~231" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="232~247" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX, 16bit" Channels="14">
    <Import PearlRef="CH_IBm35014" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="842b0d09-4650-4e3b-b16d-b5dadc9bd1ba" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Reserved" ChannelOffset="8" Wheel="30" />
      <Attribute ID="Reserved1" ChannelOffset="10" Wheel="58" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Auto" ChannelOffset="14" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="CH_IBm3508" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fb41cf8b-dbb1-4b11-8e4e-248bdd3c6b7d" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Reserved" ChannelOffset="5" Wheel="30" />
      <Attribute ID="Reserved1" ChannelOffset="7" Wheel="58" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Prism">
      <Set Channel="Control:13" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Focus">
      <Set Channel="Control:14" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:15" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Dark Blue" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="10" Name="Dark Blue" Number="7" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="11" Name="Dark Blue" Number="9" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="13" Name="Light Red" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="15" Name="Dark Blue" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
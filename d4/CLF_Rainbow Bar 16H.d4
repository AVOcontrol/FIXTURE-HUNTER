      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="181~197" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="198~214" />
      <Function ID="14" Name="Fade" Display="'Fade'" Dmx="215~231" />

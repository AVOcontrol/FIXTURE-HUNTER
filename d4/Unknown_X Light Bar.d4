<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="X Light Bar" ShortName="XLight Bar" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="29-01-20" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Lift" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Lift" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Lift_Speed" Name="Lift Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="56~155" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="156~205" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="6~15" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="16~25" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="26~35" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="36~45" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="46~55" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="56~65" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="66~75" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="76~85" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="86~95" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="96~105" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="106~115" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="116~125" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="126~135" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="136~145" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="146~155" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="156~165" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="166~175" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="176~185" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="186~195" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="196~205" />
      <Function ID="22" Name="Program 21" Display="'Program 21'" Dmx="206~215" />
      <Function ID="23" Name="Program 22" Display="'Program 22'" Dmx="216~225" />
      <Function ID="24" Name="Program 23" Display="'Program 23'" Dmx="226~235" />
      <Function ID="25" Name="Program 24" Display="'Program 24'" Dmx="236~245" />
      <Function ID="26" Name="Program 25" Display="'Program 25'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="09-04-13" Author="John Rogers" Comment="Created from Sparklite LED." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="14-09-14" Author="Nic Morris" Comment="Fixed display name in response to customer bug report." />

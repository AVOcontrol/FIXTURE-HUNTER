    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />

    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~242" />
      <Function ID="2" Name="P/T Run Speed" Display="'P/T Run Speed'" Dmx="243~251" />
      <Function ID="3" Name="BO on P/T" Display="'BO on P/T'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Effect Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Beam" Display="'Beam'" Dmx="0~2" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="3~239" />
      <Function ID="3" Name="Intensity" Display="'Intensity'" Dmx="240~251" />
      <Function ID="4" Name="Colour" Display="'Colour'" Dmx="252~255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Astro 360 RGBW" ShortName="Astro 360" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="18-12-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Colour="255,255,255" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="1 ON" Display="'1 ON'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="2 ON" Display="'2 ON'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="1+2 ON" Display="'1+2 ON'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="1 ON" Display="'1 ON'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="2 ON" Display="'2 ON'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="1+2 ON" Display="'1+2 ON'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="1 ON" Display="'1 ON'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="2 ON" Display="'2 ON'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="1+2 ON" Display="'1+2 ON'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="1 ON" Display="'1 ON'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="2 ON" Display="'2 ON'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="1+2 ON" Display="'1+2 ON'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="SHAST361" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Rotate" ChannelOffset="3" Wheel="15" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="SHAST362" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="7" />
      <Attribute ID="Rotate" ChannelOffset="3" Wheel="15" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
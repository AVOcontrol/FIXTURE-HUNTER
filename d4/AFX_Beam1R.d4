    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="4" Name="Safe" Display="'Safe'" Dmx="80~99" />
      <Function ID="5" Name="Reset Other" Display="'Reset Other'" Dmx="100~149" />
      <Function ID="6" Name="Reset P/T" Display="'Reset P/T'" Dmx="150~199" />
      <Function ID="7" Name="Reset All" Display="'Reset All'" Dmx="200~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKAXBM1R" DiamondRef="" WysiwygRef="" />
    <Physical>

      <Function ID="22" Name="Yel Grn/ Yel" Display="'Yel Grn/ Yel'" Dmx="85~85" WheelPosition="8" Colour="180,180,0" />
      <Function ID="23" Name="Yel/ Brn" Display="'Yel/ Brn'" Dmx="95~95" WheelPosition="9" Colour="255,255,0" />
      <Function ID="24" Name="Brn/ Flr" Display="'Brn/ Flr'" Dmx="105~105" WheelPosition="10" Colour="255,240,200" />
      <Function ID="25" Name="Flr/ 8000" Display="'Flr/ 8000'" Dmx="115~115" WheelPosition="11" Colour="180,0,255" />
      <Function ID="26" Name="8000/ Op" Display="'8000/ Op'" Dmx="125~125" WheelPosition="12" Colour="230,230,255" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="28" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="130~200" Colour="0,0,0" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="201~255" Colour="0,0,0" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 36x4W LED Alu CW-WW" ShortName="e8 CW/WW" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="20-02-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="White" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White1" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear Halogen" Display="'Linear Halogen'" Dmx="16~45" />
      <Function ID="3" Name="Square Halogen" Display="'Square Halogen'" Dmx="46~75" />
      <Function ID="4" Name="Inverse Square Halogen" Display="'Inverse Square Halogen'" Dmx="76~105" />
      <Function ID="5" Name="S Curve Halogen" Display="'S Curve Halogen'" Dmx="106~135" />
      <Function ID="6" Name="Linear LED" Display="'Linear LED'" Dmx="136~165" />
      <Function ID="7" Name="Square LED" Display="'Square LED'" Dmx="166~195" />
      <Function ID="8" Name="Inverse Square LED" Display="'Inverse Square LED'" Dmx="196~225" />
      <Function ID="9" Name="S Curve LED" Display="'S Curve LED'" Dmx="226~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="PLE36WW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="White" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="White1" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="PLE36WW5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White" ChannelOffset="1" Wheel="7" />
      <Attribute ID="White1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="5" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="PLE36WW6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White" ChannelOffset="1" Wheel="7" />
      <Attribute ID="White1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
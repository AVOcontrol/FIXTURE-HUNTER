      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159">
        <Swatch>3e84eb46-53e1-4c48-8c59-808408750bd4</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191">
        <Swatch>36c28d4d-0b5b-4169-8911-6cc32cb1c51c</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223">
        <Swatch>d4d22b61-8540-4cc5-9888-cfbd09951a61</Swatch>
      </Function>

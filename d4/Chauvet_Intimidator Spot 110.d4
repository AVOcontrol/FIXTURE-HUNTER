      </Function>
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~89" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="90~109" />
      <Function ID="4" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="110~129" />
      <Function ID="5" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="130~149" />
      <Function ID="6" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="150~169" />
      <Function ID="7" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="170~189" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="16~35" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="36~55" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="56~75" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="76~95" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="96~115" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="116~135" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="136~155" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="156~175" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="176~195" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="196~215" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="216~235" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="32~63" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="64~95" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="96~127" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="128~159" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="160~191" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="192~223" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="224~255" WheelPosition="7" Colour="0,0,0" />
    </Attribute>
  </Control>

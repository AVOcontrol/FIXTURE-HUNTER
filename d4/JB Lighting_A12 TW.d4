      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1 %.f%%',0~100" Dmx="1~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2 %.f%%',0~100" Dmx="33~47" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3 %.f%%',0~100" Dmx="65~79" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

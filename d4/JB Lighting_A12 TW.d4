<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="A12 TW" ShortName="A12 TW" Company="JB Lighting" Version="23">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>fd8793a9-9316-4cd1-bc52-d6da3b5e1b0a</Thumbnail>
  <History Date="19-09-11" Author="John Rogers" Comment="Created to preliminary specifications. This file will need updating at a later date." Version="1" />
  <History Date="28-10-11" Author="Gregory Haynes" Comment="Changed channel order to match current specs." Version="2" />
  <History Date="18-11-11" Author="John Rogers" Comment="Edited Shutter locate value to Open." Version="3" />
  <History Date="22-02-12" Author="Peter Budd" Comment="Edited added S8, S16, C8, and C16 modes and cell, added Colour, Pattern, P/T Speed, and effect speed." Version="4" />
  <History Date="13-08-12" Author="Peter Budd" Comment="Corrected channel assignment in 38 channel mode" Version="5" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="6" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Added physical p/t limits" Version="7" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Changed shutter fade and random fade from fixed to percentage ranges." Version="8" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Changed zoom range to 8-48 degrees in line with documentation." Version="9" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed 38 DMX, 16bit mode in response to customer bug report and in line with documentation." Version="10" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed colour 1 and colour 2 attributes (legacy from removed mode)." Version="11" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Removed Speed 1 and Speed 2 attributes (legacy)." Version="12" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Fixed cell mapping in 38 DMX mode in response to customer bug report and in line with documentation." Version="13" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Fixed and added macros.  Fixed shutter palettes." Version="14" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Shortened shutter function names to fit in Expert LCD" Version="15" />
  <History Date="07-04-14" Author="Nic Morris" Comment="Added colour function index.  Inverted speed wheel direction." Version="16" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="17" />
  <History Date="22-06-16" Author="Nic Morris" Comment="Revised control functions and macros.  Chaned pattern functions to variable ranges." Version="18" />
  <History Date="19-12-21" Author="Nic Morris" Comment="Created from JB Lighting A12 (very confusing charts. overview channels don't match detailed version.  used detailed version and assumed extended and modes 1,2,3 should have two reserved controls at end)" Version="19" />
  <History Date="20-12-21" Author="Nic Morris" Comment="Changed dimmer to 16bit so that vdim functions correctly in 16bit cell." Version="23" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="41aee035-0b29-45e3-8857-5d58a5a3cde1" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">

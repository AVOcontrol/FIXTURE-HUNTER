      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==2" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="1~1" Colour="255,255,255" />

      <Function ID="9" Name="Random" Display="'Random %.f%%',0~100" Dmx="225~239" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Pattern 1" Display="'Pattern 1 %.f%%',0~100" Dmx="17~31" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Pattern 2" Display="'Pattern 2 %.f%%',0~100" Dmx="49~63" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Pattern 3" Display="'Pattern 3 %.f%%',0~100" Dmx="81~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Pattern 4" Display="'Pattern 4 %.f%%',0~100" Dmx="113~127" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Pattern 5" Display="'Pattern 5 %.f%%',0~100" Dmx="145~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />

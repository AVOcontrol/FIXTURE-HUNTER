      <Function ID="15" Name="6000K" Display="'6000K'" Dmx="48~51" Colour="255,255,255" />
      <Function ID="16" Name="4950K" Display="'4950K'" Dmx="52~55" Colour="255,255,255" />
      <Function ID="17" Name="4000K" Display="'4000K'" Dmx="56~59" Colour="255,255,255" />
      <Function ID="18" Name="4780K" Display="'4780K'" Dmx="60~63" Colour="255,255,255" />

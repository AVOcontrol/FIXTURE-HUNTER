<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="YG-LED317XWA" ShortName="LED317XWA" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>f3685fd7-17b7-47d9-ba68-da9d675a740f</Thumbnail>
  <History Date="10-05-10" Author="John Rogers" Comment="Created" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Added conditions to Red and Green.  Removed value and replaced with dimmer for HTP." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed ID functions.  Removed shutter palettes.  Fixed Block 2 mode name." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Changed hue and saturation to colour group and wheels.  Added fan macros." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Added v-dim.  Added pixel mapper compatibility." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Adapted from Chauvet COLORado Batten 72" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="03-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="05-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="05-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a4bcf1ac-20e9-4476-9713-b8166d32c4cc" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

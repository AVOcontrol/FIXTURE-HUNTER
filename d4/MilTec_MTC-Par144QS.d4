<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MTC-Par144QS" ShortName="Par144QS" Company="MilTec">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="18-07-12" Author="Peter Budd" Comment="Created" />
  <History Date="24-05-13" Author="Peter Budd" Comment="Updated locate values of shutter and colour macro to 0." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="65bd6032-01fd-4e68-ac76-50a695742f91" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="58~59" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="109~110" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="111~159" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="160~161" Intensity="0~0" />
      <Function ID="8" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="162~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Fade" Display="'Colour Fade'" Dmx="10~50" Colour="0,0,0" />
      <Function ID="3" Name="Col Fade RGB" Display="'Col Fade RGB'" Dmx="51~91" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade Chase" Display="'Col Fade Chase'" Dmx="92~132" Colour="0,0,0" />
      <Function ID="5" Name="Color Snap" Display="'Color Snap'" Dmx="133~173" Colour="0,0,0" />
      <Function ID="6" Name="Macros" Display="'Macros'" Dmx="174~214" Colour="0,0,0" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="215~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 4 DMX" Channels="4">
    <Import PearlRef="MI_P144QSM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

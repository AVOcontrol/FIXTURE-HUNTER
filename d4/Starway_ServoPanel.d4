<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Servo Panel" ShortName="ServoPanel" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="16-02-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="16-02-15" Author="Gab " Comment="Checked" />
  <History Date="16-02-15" Author="Gab " Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised P/T Speed.  Added reset macro" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed pattern functions to value 0dp as 1dp made no sense.  Changed colour macro function to percentage range." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Removed macro speed update from pattern mode as it did nothing.  Added missing raw DMX to pattern else condition" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed pattern locate and power on to match controlling condition" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed pattern and back colour macro to percentage range." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Moved RGBW to wheel mapping page 1.  Changed RGB power on to match locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="89bec794-0a04-4704-a2f6-9abd8cdc2dd2" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="225~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~79" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~99" />
      <Function ID="3" Name="Prog Int 1" Display="'Prog Int 1'" Dmx="100~119" />
      <Function ID="4" Name="Prog Int 2" Display="'Prog Int 2'" Dmx="120~139" />
      <Function ID="5" Name="Prog Int 3" Display="'Prog Int 3'" Dmx="140~159" />
      <Function ID="6" Name="Prog Int 4" Display="'Prog Int 4'" Dmx="160~179" />
      <Function ID="7" Name="Prog Int 5" Display="'Prog Int 5'" Dmx="180~199" />
      <Function ID="8" Name="Prog Int 6" Display="'Prog Int 6'" Dmx="200~219" />
      <Function ID="9" Name="Prog Int 7" Display="'Prog Int 7'" Dmx="220~239" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Pattern Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGBW Mode" Display="'RGBW Mode'" Dmx="0~12" Update="Generic1" Colour="255,255,255" />
      <Function ID="2" Name="Color Macro" Display="'Color Macro %.1f%%',0.0~100.0" Dmx="13~117" Update="Generic1" Colour="0,0,0" />
      <Function ID="3" Name="Character Mode" Display="'Character Mode'" Dmx="118~145" Update="Generic1" Colour="255,255,255" />
      <Function ID="4" Name="Pattern 1" Display="'Pattern 1'" Dmx="146~152" Update="Generic1" Colour="255,255,255" />
      <Function ID="5" Name="Pattern 2" Display="'Pattern 2'" Dmx="153~159" Update="Generic1" Colour="255,255,255" />
      <Function ID="6" Name="Pattern 3" Display="'Pattern 3'" Dmx="160~166" Update="Generic1" Colour="255,255,255" />
      <Function ID="7" Name="Pattern 4" Display="'Pattern 4'" Dmx="167~173" Update="Generic1" Colour="255,255,255" />
      <Function ID="8" Name="Pattern 5" Display="'Pattern 5'" Dmx="174~180" Update="Generic1" Colour="255,255,255" />
      <Function ID="9" Name="Pattern 6" Display="'Pattern 6'" Dmx="181~187" Update="Generic1" Colour="255,255,255" />
      <Function ID="10" Name="Pattern 7" Display="'Pattern 7'" Dmx="188~194" Update="Generic1" Colour="255,255,255" />
      <Function ID="11" Name="Pattern 8" Display="'Pattern 8'" Dmx="195~201" Update="Generic1" Colour="255,255,255" />
      <Function ID="12" Name="Pattern 9" Display="'Pattern 9'" Dmx="202~208" Update="Generic1" Colour="255,255,255" />
      <Function ID="13" Name="Pattern 10 " Display="'Pattern 10'" Dmx="209~215" Update="Generic1" Colour="255,255,255" />
      <Function ID="14" Name="Pattern 11" Display="'Pattern 11'" Dmx="216~222" Update="Generic1" Colour="255,255,255" />
      <Function ID="15" Name="Char scroll 1" Display="'Char scroll 1'" Dmx="223~229" Update="Generic1" Colour="255,255,255" />
      <Function ID="16" Name="Char scroll 2" Display="'Char scroll 2'" Dmx="230~236" Update="Generic1" Colour="255,255,255" />
      <Function ID="17" Name="Char scroll 3" Display="'Char scroll 3'" Dmx="237~255" Update="Generic1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Generic" Name="Macro Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic1" Name="Pattern" Description="" Group="S">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Condition 1" ID="1,2" If="'Colour_Macro'==3" />
      <Else ID="3" />
      <Function ID="1" Name="Character" Display="'Character %.f',0~56" Dmx="0~167" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.f',0~40" Dmx="168~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic2" Name="Pattern color" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Color Macro" Display="'Color Macro %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Rnd Col speed 1" Display="'Rnd Col speed 1 %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Rnd Col speed 2" Display="'Rnd Col speed 2 %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Generic3" Name="Back Color" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Color Macro" Display="'Color Macro %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Rnd Col speed 1" Display="'Rnd Col speed 1 %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Rnd Col speed 2" Display="'Rnd Col speed 2 %.f%%',0~100" Dmx="192~255" />
    </Attribute>
  </Control>

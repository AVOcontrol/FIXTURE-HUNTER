      <Function ID="11" Name="Yellow" Display="'Yellow'" Dmx="86~86" WheelPosition="10" Colour="255,255,0" />
      <Function ID="12" Name="CTO260" Display="'CTO260'" Dmx="94~94" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="CTO190" Display="'CTO190'" Dmx="103~103" WheelPosition="12" Colour="255,240,200" />

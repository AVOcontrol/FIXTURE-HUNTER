  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bfec2c12-61ac-46e4-a84b-162f4d098f33" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="26~30" Colour="255,100,0" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="31~35" Colour="180,0,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="36~40" Colour="255,255,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="41~45" Colour="0,255,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="46~50" Colour="255,128,255" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="51~55" Colour="128,255,0" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="56~60" Colour="255,0,255" />
      <Function ID="13" Name="Turquoise" Display="'Turquoise'" Dmx="61~65" Colour="0,255,128" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="66~70" Colour="255,128,0" />
      <Function ID="15" Name="Cold White" Display="'Cold White'" Dmx="71~75" Colour="230,230,255" />
      <Function ID="16" Name="Warm White" Display="'Warm White'" Dmx="76~80" Colour="255,240,200" />
      <Function ID="17" Name="Change" Display="'Change %.f%%',0~100" Dmx="81~150" Colour="255,255,255" />
      <Function ID="18" Name="Blend" Display="'Blend %.f%%',0~100" Dmx="151~220" Colour="255,255,255" />
      <Function ID="19" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="51~67" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="68~84" Colour="255,100,0" />
      <Function ID="6" Name="UV" Display="'UV'" Dmx="85~101" Colour="180,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="102~118" Colour="255,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="119~135" Colour="0,255,255" />
      <Function ID="9" Name="Lavender" Display="'Lavender'" Dmx="136~152" Colour="255,128,255" />
      <Function ID="10" Name="Light Green" Display="'Light Green'" Dmx="153~169" Colour="128,255,0" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="170~186" Colour="255,0,255" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="187~203" Colour="0,255,128" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="204~220" Colour="255,128,0" />
      <Function ID="14" Name="Cold White" Display="'Cold White'" Dmx="221~237" Colour="230,230,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="238~255" Colour="255,240,200" />
    </Attribute>
  </Control>

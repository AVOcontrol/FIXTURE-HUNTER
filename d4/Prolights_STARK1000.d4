      <Function ID="8" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="9" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="1~13" Colour="255,0,0" />
      <Function ID="11" Name="Rd-Grn" Display="'Rd-Grn %.f%%',0~100" Dmx="14~27" Colour="0,255,0" />

    <Attribute ID="Prism_Mac_Rot" Name="Prism Mac Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="2" If="'Prism_Macro'&gt;1&amp;&amp;'Prism_Macro'&lt;9" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism_Macro'&gt;8" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />

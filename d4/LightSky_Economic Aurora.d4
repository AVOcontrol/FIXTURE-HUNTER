      <Condition Name="Combined" ID="14,15,16,17,18,19" If="'Frost_Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="1~53" WheelPosition="1" />

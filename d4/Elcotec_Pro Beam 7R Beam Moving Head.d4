      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="35~39" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="40~44" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="45~49" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="50~54" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="55~59" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />

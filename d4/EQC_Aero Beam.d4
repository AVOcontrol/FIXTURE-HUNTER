<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Aero Beam" ShortName="Aero Beam" Company="EQC">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="14-11-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~249" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="No Macro" Display="'No Macro'" Dmx="20~29" />
      <Function ID="3" Name="No Macro" Display="'No Macro'" Dmx="30~39" />
      <Function ID="4" Name="No Macro" Display="'No Macro'" Dmx="40~79" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="80~99" />
      <Function ID="6" Name="Macro 1" Display="'Macro 1'" Dmx="100~119" />
      <Function ID="7" Name="Macro 2" Display="'Macro 2'" Dmx="120~139" />
      <Function ID="8" Name="Macro 3" Display="'Macro 3'" Dmx="140~159" />
      <Function ID="9" Name="Macro 4" Display="'Macro 4'" Dmx="160~179" />
      <Function ID="10" Name="Macro 5" Display="'Macro 5'" Dmx="180~199" />
      <Function ID="11" Name="Macro 6" Display="'Macro 6'" Dmx="200~219" />
      <Function ID="12" Name="Macro 7" Display="'Macro 7'" Dmx="220~239" />
      <Function ID="13" Name="Macro 8" Display="'Macro 8'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Pixel Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pixel_Macro" Name="Pixel Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~15" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="16~35" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="36~55" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="56~75" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="76~95" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="96~115" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="116~135" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="136~155" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="156~175" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="176~195" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="196~215" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="216~235" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="236~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="15">
    <Import PearlRef="UK_EQCAero1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer1" Wheel="5" />
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
        <Attribute ID="Pixel_Macro" ChannelOffset="15" Wheel="29" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="11" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="12" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="13" ModeLink="Cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="14" ModeLink="Cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer1" TargetId="Dimmer1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Mode 2" Channels="6">
    <Import PearlRef="UK_EQCAero2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
      <Attribute ID="Pixel_Macro" ChannelOffset="6" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer1" ChannelOffset="1" Wheel="5" />
    </Include>
  </Mode>
</Fixture>
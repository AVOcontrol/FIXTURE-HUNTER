  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~110" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="188~255" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="116~183" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="16~134" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 0" Display="'Show 0'" Dmx="1~16" />
      <Function ID="3" Name="Show 1" Display="'Show 1'" Dmx="17~33" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="34~50" />
      <Function ID="5" Name="Show 3" Display="'Show 3'" Dmx="51~67" />
      <Function ID="6" Name="Show 4" Display="'Show 4'" Dmx="68~84" />
      <Function ID="7" Name="Show 5" Display="'Show 5'" Dmx="85~101" />
      <Function ID="8" Name="Show 6" Display="'Show 6'" Dmx="102~118" />
      <Function ID="9" Name="Show 7" Display="'Show 7'" Dmx="119~135" />
      <Function ID="10" Name="Show 8" Display="'Show 8'" Dmx="136~152" />
      <Function ID="11" Name="Show 9" Display="'Show 9'" Dmx="153~169" />
      <Function ID="12" Name="Show 10" Display="'Show 10'" Dmx="170~186" />
      <Function ID="13" Name="Show 11" Display="'Show 11'" Dmx="187~203" />
      <Function ID="14" Name="Show 12" Display="'Show 12'" Dmx="204~220" />
      <Function ID="15" Name="Show 13" Display="'Show 13'" Dmx="221~237" />
      <Function ID="16" Name="Show 14" Display="'Show 14'" Dmx="238~255" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotation_Spd" Name="Rotation Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Max 2000C v2" ShortName="Max 2KC v2" Company="LightSky">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="13-11-07" Author="Gregory Haynes" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="31-08-15" Author="Nic Morris" Comment="Changed fixture name to avoid conflict in response to customer bug report." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="6~10" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~51" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Closed" Display="'Closed'" Dmx="52~56" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="57~67" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="68~250" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="251~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split_Func" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll_Func" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split_Func" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll_Func" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="23~24" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="39~40" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="55~56" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="71~72" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="87~88" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="103~104" Colour="0,0,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="119~120" Colour="255,0,255" />
      <Function ID="9" Name="Op/Rd" Display="'Op/Rd %.f%%',0~100" Dmx="8~23" Colour="255,255,255" />
      <Function ID="10" Name="Rd/Ye" Display="'Rd/Ye %.f%%',0~100" Dmx="24~39" Colour="255,0,0" />
      <Function ID="11" Name="Ye/Pu" Display="'Ye/Pu %.f%%',0~100" Dmx="40~55" Colour="255,255,0" />
      <Function ID="12" Name="Pu/Gr" Display="'Pu/Gr %.f%%',0~100" Dmx="56~71" Colour="128,0,255" />
      <Function ID="13" Name="Gr/Or" Display="'Gr/Or %.f%%',0~100" Dmx="72~87" Colour="0,255,0" />
      <Function ID="14" Name="Or/Bl" Display="'Or/Bl %.f%%',0~100" Dmx="88~103" Colour="255,128,0" />
      <Function ID="15" Name="Bl/Ma" Display="'Bl/Ma %.f%%',0~100" Dmx="104~119" Colour="0,0,255" />
      <Function ID="16" Name="Ma/Op" Display="'Ma/Op %.f%%',0~100" Dmx="120~127" Colour="255,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" Clear="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="4" PowerOn="4" Clear="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~20" Intensity="0~0" />
      <Function ID="2" Name="Opn Pls" Display="'Opn Pls %.f%%',0~100" Dmx="21~52" Intensity="0~0" />
      <Function ID="3" Name="Cls Pls" Display="'Cls Pls %.f%%',0~100" Dmx="53~84" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="85~115" Intensity="0~0" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="116~243" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~249" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Vector" Name="Vector Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~5" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="6~45" />
      <Function ID="3" Name="Zoom" Display="'Zoom'" Dmx="46~85" />
      <Function ID="4" Name="Colour" Display="'Colour'" Dmx="86~125" />
      <Function ID="5" Name="Gobo" Display="'Gobo'" Dmx="126~165" />
      <Function ID="6" Name="P/T" Display="'P/T'" Dmx="166~205" />
      <Function ID="7" Name="All" Display="'All'" Dmx="206~245" />
      <Function ID="8" Name="None" Display="'None'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake_Func" Display="'Shake'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6" If="'Gobo2Func'==1" />
      <Condition Name="Shake_Func" ID="7,8,9,10,11" If="'Gobo2Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="21~41" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="58~78" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="95~115" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="132~152" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="169~205" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="42~57" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="79~94" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="116~131" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="153~168" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="206~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func_Ind" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed_Func_Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake_Func_Ind" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake_Func_Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func_Ind" ID="1,2,3,4,5" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake_Func_Ind" ID="6,7,8" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="48~73" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="100~125" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="152~177" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="204~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="74~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="126~151" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="178~203" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed_Func_Ind" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Fixed_Func_Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.f°',0~360" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="5397~33924" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="34181~34181" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="36751~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Zoom_Func" Display="'Zoom'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Colour_Func" Display="'Colour'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Zoom_Func" ID="1,2" If="'Effect_Func'==1" />
      <Condition Name="Colour_Func" ID="1,3,4,5" If="'Effect_Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~41" />
      <Function ID="2" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="42~127" />
      <Function ID="3" Name="Up" Display="'Up'" Dmx="128~169" />
      <Function ID="4" Name="Down" Display="'Down'" Dmx="170~211" />
      <Function ID="5" Name="Other" Display="'Other'" Dmx="212~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Prism_Func" Display="'Prism'" Dmx="0~0" Update="Prism, Prism_Rot" />
      <Function ID="2" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Prism, Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism_Func" ID="1,2,3,4,5" If="'Prism_Func'==1" />
      <Else ID="6" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~47" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="48~99" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="100~151" />
      <Function ID="4" Name="Prism 3" Display="'Prism 3'" Dmx="152~203" />
      <Function ID="5" Name="Prism 4" Display="'Prism 4'" Dmx="204~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism_Func" ID="1,2,3,4" If="'Prism_Func'==1" />
      <Else ID="5" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~20" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="21~132" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="133~143" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="144~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX, 16bit" Channels="18">
    <Import PearlRef="LS_Max2000C" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="11" Wheel="17" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="12" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="13,14" Wheel="15" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="Effect_Func" Wheel="25" />
      <Attribute ID="Effect" ChannelOffset="16" Wheel="26" />
      <Attribute ID="Prism_Func" Wheel="22" />
      <Attribute ID="Prism" ChannelOffset="17" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="18" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="27" />
      <Attribute ID="Vector" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Iris:2" Delay="5000" />
      <Set Channel="Iris:1" Delay="1" />
    </Macro>
  </Macro>
</Fixture>
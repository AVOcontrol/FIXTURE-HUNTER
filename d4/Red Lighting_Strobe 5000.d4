<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Strobe 5000" ShortName="Rd Str5000" Company="Red Lighting">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="17-04-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="3:100" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Spring Strobe" Display="'Spring Strobe'" Dmx="2~5" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="2:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="RE_STRB5000" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
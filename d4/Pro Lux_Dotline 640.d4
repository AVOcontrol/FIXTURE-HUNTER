      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="129~158" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="159~187" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7 %.f%%',0~100" Dmx="188~255" />
    </Attribute>
  </Control>

  <Thumbnail>204266b9-8cd3-499f-9fa7-0bca702de5f5</Thumbnail>
  <History Date="04-05-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7e89cc46-91a4-4dc1-928c-f3877039360b" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="50~200" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24" If="'Colour1Func'==3" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="201~203" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="204~206" WheelPosition="2" Colour="0,128,255" />
      <Function ID="4" Name="Primary Green" Display="'Primary Green'" Dmx="207~209" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="CTO" Display="'CTO'" Dmx="210~212" WheelPosition="4" Colour="255,240,200" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="213~215" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="216~218" WheelPosition="6" Colour="230,230,255" />
      <Function ID="8" Name="Violet" Display="'Violet'" Dmx="219~221" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="12~12" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ L Blu" Display="'D Rd/ L Blu'" Dmx="36~36" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="L Blu/ P Grn" Display="'L Blu/ P Grn'" Dmx="60~60" WheelPosition="2" Colour="0,128,255" />
      <Function ID="12" Name="P Grn/ CTO" Display="'P Grn/ CTO'" Dmx="84~84" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="CTO/ Org" Display="'CTO/ Org'" Dmx="108~108" WheelPosition="4" Colour="255,240,200" />
      <Function ID="14" Name="Org/ CTB" Display="'Org/ CTB'" Dmx="132~132" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="CTB/ Vlt" Display="'CTB/ Vlt'" Dmx="156~156" WheelPosition="6" Colour="230,230,255" />
      <Function ID="16" Name="Vlt/ Op" Display="'Vlt/ Op'" Dmx="180~180" WheelPosition="7" Colour="180,0,255" />
      <Function ID="17" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~24" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="D Rd - L Blu" Display="'D Rd - L Blu %.f%%',0~100" Dmx="24~48" WheelPosition="1" Colour="180,0,0" />
      <Function ID="19" Name="L Blu - P Grn" Display="'L Blu - P Grn %.f%%',0~100" Dmx="48~72" WheelPosition="2" Colour="0,128,255" />
      <Function ID="20" Name="P Grn - CTO" Display="'P Grn - CTO %.f%%',0~100" Dmx="72~96" WheelPosition="3" Colour="0,255,0" />
      <Function ID="21" Name="CTO - Org" Display="'CTO - Org %.f%%',0~100" Dmx="96~120" WheelPosition="4" Colour="255,240,200" />
      <Function ID="22" Name="Org - CTB" Display="'Org - CTB %.f%%',0~100" Dmx="120~144" WheelPosition="5" Colour="255,128,0" />
      <Function ID="23" Name="CTB - Vlt" Display="'CTB - Vlt %.f%%',0~100" Dmx="144~168" WheelPosition="6" Colour="230,230,255" />
      <Function ID="24" Name="Vlt - Op" Display="'Vlt - Op %.f%%',0~100" Dmx="168~192" WheelPosition="7" Colour="180,0,255" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="9" PowerOn="9" />
      <Condition Name="Index" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>e6ffdcc8-6d78-4fef-971e-0c221aebba7a</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Grass Lines)" Display="'Gobo 1 (Grass Lines)'" Dmx="5~9" WheelPosition="1">
        <Swatch>83671a67-0266-4299-a5cf-d34239f542c3</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Organic Delight)" Display="'Gobo 2 (Organic Delight)'" Dmx="10~14" WheelPosition="2">
        <Swatch>b48883b0-3286-4596-b642-de8ddf72767c</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Brush It)" Display="'Gobo 3 (Brush It)'" Dmx="15~19" WheelPosition="3">
        <Swatch>de68a45b-62d3-4375-9bb8-07c6160e9ecd</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Light Lines)" Display="'Gobo 4 (Light Lines)'" Dmx="20~24" WheelPosition="4">
        <Swatch>79137659-bd1c-4909-9ad1-35e6e4bbb580</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Ripple Texture Glass)" Display="'Gobo 5 (Ripple Texture Glass)'" Dmx="25~29" WheelPosition="5">
        <Swatch>550ce438-863d-48cd-9e68-db15fada6209</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Lined Effect Glass)" Display="'Gobo 6 (Lined Effect Glass)'" Dmx="30~34" WheelPosition="6">
        <Swatch>19d6a67c-9387-429d-bdbf-e2acf01501e5</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Sequence It)" Display="'Gobo 7 (Sequence It)'" Dmx="35~39" WheelPosition="7">
        <Swatch>8e766ec1-ab35-4770-ad90-74bd35fb230b</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>e6ffdcc8-6d78-4fef-971e-0c221aebba7a</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 (Grass Lines)" Display="'Gobo 1 (Grass Lines)'" Dmx="40~44" WheelPosition="1">
        <Swatch>83671a67-0266-4299-a5cf-d34239f542c3</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 (Organic Delight)" Display="'Gobo 2 (Organic Delight)'" Dmx="45~49" WheelPosition="2">
        <Swatch>b48883b0-3286-4596-b642-de8ddf72767c</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 (Brush It)" Display="'Gobo 3 (Brush It)'" Dmx="50~54" WheelPosition="3">
        <Swatch>de68a45b-62d3-4375-9bb8-07c6160e9ecd</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 (Light Lines)" Display="'Gobo 4 (Light Lines)'" Dmx="55~59" WheelPosition="4">
        <Swatch>79137659-bd1c-4909-9ad1-35e6e4bbb580</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 (Ripple Texture Glass)" Display="'Gobo 5 (Ripple Texture Glass)'" Dmx="60~64" WheelPosition="5">
        <Swatch>550ce438-863d-48cd-9e68-db15fada6209</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 (Lined Effect Glass" Display="'Gobo 6 (Lined Effect Glass'" Dmx="65~69" WheelPosition="6">
        <Swatch>19d6a67c-9387-429d-bdbf-e2acf01501e5</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 (Sequence It)" Display="'Gobo 7 (Sequence It)'" Dmx="70~74" WheelPosition="7">
        <Swatch>8e766ec1-ab35-4770-ad90-74bd35fb230b</Swatch>
      </Function>
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin 0°" Display="'No Spin 0°'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="601~32130" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32131~32895" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64425" />
      <Function ID="6" Name="No Spin 90°" Display="'No Spin 90°'" Dmx="64426~65535" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="3-Facet Index" Display="'3-Facet Index'" Dmx="6~10" Update="Prism_Rot" />
      <Function ID="3" Name="Linear Index" Display="'Linear Index'" Dmx="11~15" Update="Prism_Rot" />
      <Function ID="4" Name="3-Facet Spin" Display="'3-Facet Spin'" Dmx="16~20" Update="Prism_Rot" />
      <Function ID="5" Name="Linear Spin" Display="'Linear Spin'" Dmx="21~25" Update="Prism_Rot" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Prism" ID="1" If="'Prism'==1" />
      <Condition Name="Index" ID="2" If="'Prism'==2||'Prism'==3" />
      <Condition Name="Spin" ID="3,4,5,6,7" If="'Prism'==4||'Prism'==5" />
      <Else ID="8" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin 0°" Display="'No Spin 0°'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="7" Name="No Spin 90°" Display="'No Spin 90°'" Dmx="254~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~14" />
      <Function ID="3" Name="Shortcut On" Display="'Shortcut On'" Dmx="40~44" />
      <Function ID="4" Name="Shortcut Off" Display="'Shortcut Off'" Dmx="45~49" />
      <Function ID="5" Name="Auto Blackout On" Display="'Auto Blackout On'" Dmx="50~54" />
      <Function ID="6" Name="Auto Blackout Off" Display="'Auto Blackout Off'" Dmx="55~59" />
      <Function ID="7" Name="Display On" Display="'Display On'" Dmx="60~64" />
      <Function ID="8" Name="Display Off" Display="'Display Off'" Dmx="65~69" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="MTEX1000" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="40984569-41a3-4a17-a207-7b835a37ab9f" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Cyan" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="9,10" Wheel="15" />
      <Attribute ID="Animation" ChannelOffset="11" Wheel="53" />
      <Attribute ID="Animation_Rot" ChannelOffset="12" Wheel="54" />
      <Attribute ID="Frost" ChannelOffset="13" Wheel="21" />
      <Attribute ID="Prism" ChannelOffset="14" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="15" Wheel="24" />
      <Attribute ID="Zoom" ChannelOffset="16,17" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="18,19" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Shortcut On">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Shortcut Off">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Auto Blackout On">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Auto Blackout Off">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:9,Gobo1Func:2" />
      <Palette ID="2" Name="Gobo 1 (Grass Lines)" Number="12" Page="1" SetControl="Gobo1:10,Gobo1Func:2" />
      <Palette ID="3" Name="Gobo 2 (Organic Delight)" Number="13" Page="1" SetControl="Gobo1:11,Gobo1Func:2" />
      <Palette ID="4" Name="Gobo 3 (Brush It)" Number="14" Page="1" SetControl="Gobo1:12,Gobo1Func:2" />
      <Palette ID="5" Name="Gobo 4 (Light Lines)" Number="15" Page="1" SetControl="Gobo1:13,Gobo1Func:2" />
      <Palette ID="6" Name="Gobo 5 (Ripple Texture Glass)" Number="16" Page="1" SetControl="Gobo1:14,Gobo1Func:2" />
      <Palette ID="7" Name="Gobo 6 (Lined Effect Glass" Number="17" Page="1" SetControl="Gobo1:15,Gobo1Func:2" />
      <Palette ID="8" Name="Gobo 7 (Sequence It)" Number="18" Page="1" SetControl="Gobo1:16,Gobo1Func:2" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />

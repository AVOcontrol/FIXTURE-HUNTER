      <Function ID="31" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="205~211" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="212~217" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />

      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="60~63" WheelPosition="15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="64~67" WheelPosition="16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="68~71" WheelPosition="17" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="72~113" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="118~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="160~166" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="167~172" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="173~179" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="180~185" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="28" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="186~191" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />

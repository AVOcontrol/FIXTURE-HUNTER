  <Mode Name="Mode 2, 20 DMX" Channels="20">
    <Import PearlRef="PG_Genesis2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="270" TiltMaxSpeed="250" />
    </Physical>

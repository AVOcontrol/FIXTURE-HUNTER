  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:2" Delay="9000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3" Delay="9000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Reset:4" Delay="9000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />

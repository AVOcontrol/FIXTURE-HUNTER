<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="JDC Burst 1" ShortName="JDC Burst1" Company="GLP" Version="24">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>283e3837-86a4-4c5e-9f4f-d7f0872b0ce5</Thumbnail>
  <History Date="20-02-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="22-02-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />
  <History Date="25-02-25" Author="Nic Morris" Comment="Added remaining Atlabase ID's." Version="15" />
  <History Date="29-04-25" Author="Nic Morris" Comment="Added modes for FW 0.2.0." Version="16" />
  <History Date="29-04-25" Author="Nic Morris" Comment="The revised firmware simplifies the segment options so that there is only 12x beam and just 12, 24 and 48x plate." Version="16" />
  <History Date="30-04-25" Author="Nic Morris" Comment="Updated Altbase ID's for FW 0.2.0 (note original version are no longer available and plate segments are only RGBW (documentation is unclear if there are still RGB options or not)" Version="18" />
  <History Date="13-05-25" Author="Nic Morris" Comment="Revised v0.2.0 implementation with separate combined and split options for modes 3-8.  Removed v0.2.0 RGB plate segment modes." Version="19" />
  <History Date="05-09-25" Author="Nic Morris" Comment="Updated in line with v0.3.4.0 (adds modes 9 and 10) (charts say to use controls from modes 1-8 but many do not exist)" Version="20" />
  <History Date="09-09-25" Author="Nic Morris" Comment="Added Atlabase ID for mode 10." Version="21" />
  <History Date="23-01-26" Author="Nic Morris" Comment="Added multi-part patch options for mode 9." Version="22" />
  <History Date="25-03-26" Author="Nic Morris" Comment="Changed Beam Master and Beam FX Dim to locate at zero in response to customer feedback (testing against fixture these both appear to set the intensity of all beam pixels regardless of the individual pixel levels.  Beam Pix Dim masters the level of the individual pixel intensities)" Version="23" />
  <History Date="04-08-26" Author="Nic Morris" Comment="Added multi-part patch options for mode 1." Version="24" />
  <Manual Filename="" Summary="" />

  <AtlaBase TypeID="8767e6a3-0637-4320-ad73-90706e535a7d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M" Name="G/M" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0 G" Display="'0 G'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="100 M" Display="'100 M'" Dmx="21~33" Colour="255,255,255" />
      <Function ID="3" Name="+ M" Display="'+ M %.f%%',99~1" Dmx="34~134" Colour="255,255,255" />
      <Function ID="4" Name="0 G" Display="'0 G'" Dmx="135~145" Colour="255,255,255" />
      <Function ID="5" Name="+ G" Display="'+ G %.f%%',1~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="100 G" Display="'100 G'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~359.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel" Name="Gel" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1700K" Display="'1700K'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="3" Name="2000K" Display="'2000K'" Dmx="26~30" Colour="255,255,255" />
      <Function ID="4" Name="2700K" Display="'2700K'" Dmx="31~35" Colour="255,255,255" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="36~40" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="41~45" Colour="255,255,255" />
      <Function ID="7" Name="Red (Hue 0°)" Display="'Red (Hue 0°)'" Dmx="46~50" Colour="255,0,0" />
      <Function ID="8" Name="Green (Hue 120°)" Display="'Green (Hue 120°)'" Dmx="51~55" Colour="0,255,0" />
      <Function ID="9" Name="Blue (Hue 240°)" Display="'Blue (Hue 240°)'" Dmx="56~60" Colour="0,0,255" />
      <Function ID="10" Name="Magenta (Hue 340°)" Display="'Magenta (Hue 340°)'" Dmx="61~65" Colour="255,0,255" />
      <Function ID="11" Name="Yellow (Hue 30°)" Display="'Yellow (Hue 30°)'" Dmx="66~70" Colour="255,255,0" />
      <Function ID="12" Name="Orange (Hue 170°)" Display="'Orange (Hue 170°)'" Dmx="71~75" Colour="255,128,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="21~25" />
      <Function ID="3" Name="Paparazzi" Display="'Paparazzi'" Dmx="26~30" />
      <Function ID="4" Name="Short-Circuit" Display="'Short-Circuit'" Dmx="31~35" />
      <Function ID="5" Name="Cop Car 1" Display="'Cop Car 1'" Dmx="36~40" />
      <Function ID="6" Name="Cop Car 2" Display="'Cop Car 2'" Dmx="41~45" />
      <Function ID="7" Name="Fire" Display="'Fire'" Dmx="46~50" />
      <Function ID="8" Name="Rainbow" Display="'Rainbow'" Dmx="51~55" />
      <Function ID="9" Name="Breath" Display="'Breath'" Dmx="56~60" />
      <Function ID="10" Name="Pixel Rainbow" Display="'Pixel Rainbow'" Dmx="61~65" />
      <Function ID="11" Name="Meteor 1" Display="'Meteor 1'" Dmx="66~70" />
      <Function ID="12" Name="Meteor 2" Display="'Meteor 2'" Dmx="71~75" />
      <Function ID="13" Name="Meteor 3" Display="'Meteor 3'" Dmx="76~80" />
      <Function ID="14" Name="Music 1" Display="'Music 1'" Dmx="81~85" />
      <Function ID="15" Name="Music 2" Display="'Music 2'" Dmx="86~90" />
      <Function ID="16" Name="Random 1" Display="'Random 1'" Dmx="91~95" />

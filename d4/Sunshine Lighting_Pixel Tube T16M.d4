      <Function ID="18" Name="Random 3" Display="'Random 3'" Dmx="101~105" />
      <Function ID="19" Name="Stars" Display="'Stars'" Dmx="106~110" />
      <Function ID="20" Name="Cop Light 3" Display="'Cop Light 3'" Dmx="111~115" />
      <Function ID="21" Name="Cop Light 4" Display="'Cop Light 4'" Dmx="116~120" />
      <Function ID="22" Name="Mode 2" Display="'Mode 2'" Dmx="121~125" />
      <Function ID="23" Name="Pile Up" Display="'Pile Up'" Dmx="126~130" />
      <Function ID="24" Name="Pile Up 2" Display="'Pile Up 2'" Dmx="131~135" />
      <Function ID="25" Name="Fire" Display="'Fire'" Dmx="136~140" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="50%" Display="'50%'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="21~255" />
    </Attribute>
    <Attribute ID="Effect_Colour" Name="Effect Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default (White)" Display="'Default (White)'" Dmx="0~0" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="21~50" />
      <Function ID="3" Name="Rainbow (0-359° cycle)" Display="'Rainbow (0-359° cycle)'" Dmx="51~80" />
      <Function ID="4" Name="Custom" Display="'Custom'" Dmx="81~110" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

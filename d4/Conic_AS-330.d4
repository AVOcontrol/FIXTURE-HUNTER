      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="85~169" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mobile Beat" ShortName="Mobile Bt" Company="X-Laser">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="13-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="13-04-12" Author="Peter Budd" Comment="Created from X-Laser X-Beam" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Sound Active" Display="'Sound Active'" Dmx="0~49" />
      <Function ID="2" Name="Auto Aerial" Display="'Auto Aerial'" Dmx="50~99" />
      <Function ID="3" Name="Auto Animation" Display="'Auto Animation'" Dmx="100~149" />
      <Function ID="4" Name="Manual to Sound" Display="'Manual to Sound'" Dmx="150~199" />
      <Function ID="5" Name="Full Manual" Display="'Full Manual'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~17" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~245" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="246~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="XAxisRot" Name="X-Axis Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="YAxisRot" Name="Y-Axis Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Rotation" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Auto Zoom Larger" Display="'Auto Zoom Larger %.1f%%',0.0~100.0" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto Zoom Smaller" Display="'Auto Zoom Smaller %.1f%%',0.0~100.0" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom + Speed" Display="'Zoom + Speed %.1f%%',0.0~100.0" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="PatternSize" Name="Pattern Size" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.f',1~255" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Beam Cohesion" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cohesion" Display="'Cohesion %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Drawing Mode" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Animated Drawing" Display="'Animated Drawing %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Animated Effects" Display="'Animated Effects %.f%%',0~100" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="2:100" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~5" Colour="0,0,0" />
      <Function ID="2" Name="Single Colour" Display="'Single Colour %.f%%',0~100" Dmx="6~40" Colour="0,0,0" />
      <Function ID="3" Name="Colour Effects" Display="'Colour Effects %.f%%',0~100" Dmx="41~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Single" Channels="12">
    <Import PearlRef="UK_XLXBEAMS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Pattern" ChannelOffset="3" Wheel="13" />
      <Attribute ID="XAxisRot" ChannelOffset="6" Wheel="22" />
      <Attribute ID="YAxisRot" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Gobo1Rot" ChannelOffset="8" Wheel="24" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Mode" ChannelOffset="12" Wheel="15" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="PatternSize" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Multi" Channels="11">
    <Import PearlRef="UK_XLXBEAMM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="XAxisRot" ChannelOffset="5" Wheel="22" />
      <Attribute ID="YAxisRot" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Gobo1Rot" ChannelOffset="7" Wheel="24" />
      <Attribute ID="Gobo1" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Mode" ChannelOffset="11" Wheel="15" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="19" />
      <Attribute ID="PatternSize" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Razorbeam" ShortName="Razorbeam" Company="Laser Grafix" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="31-10-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Scale" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Rate" Name="Scan Rate" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Scan Rate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Point" Display="'Point'" Dmx="0~0" />
      <Function ID="2" Name="2 Horiz Point" Display="'2 Horiz Point'" Dmx="5~10" />
      <Function ID="3" Name="2 Vert Point" Display="'2 Vert Point'" Dmx="11~16" />
      <Function ID="4" Name="3 Horiz Point" Display="'3 Horiz Point'" Dmx="17~22" />
      <Function ID="5" Name="3 Vert Point" Display="'3 Vert Point'" Dmx="23~28" />
      <Function ID="6" Name="4 Horiz Point" Display="'4 Horiz Point'" Dmx="29~34" />
      <Function ID="7" Name="4 Vert Point" Display="'4 Vert Point'" Dmx="35~40" />
      <Function ID="8" Name="5 Horiz Point" Display="'5 Horiz Point'" Dmx="41~46" />
      <Function ID="9" Name="5 Vert Point" Display="'5 Vert Point'" Dmx="47~52" />
      <Function ID="10" Name="6 Horiz Point" Display="'6 Horiz Point'" Dmx="53~58" />
      <Function ID="11" Name="6 Vert Point" Display="'6 Vert Point'" Dmx="59~64" />
      <Function ID="12" Name="7 Horiz Point" Display="'7 Horiz Point'" Dmx="65~70" />
      <Function ID="13" Name="7 Vert Point" Display="'7 Vert Point'" Dmx="71~76" />
      <Function ID="14" Name="Star Field" Display="'Star Field'" Dmx="77~82" />
      <Function ID="15" Name="Horiz Line" Display="'Horiz Line'" Dmx="83~88" />
      <Function ID="16" Name="Vert Line" Display="'Vert Line'" Dmx="89~94" />
      <Function ID="17" Name="Two Horiz Line" Display="'Two Horiz Line'" Dmx="95~100" />
      <Function ID="18" Name="Two Vert Line" Display="'Two Vert Line'" Dmx="101~106" />
      <Function ID="19" Name="Two Horiz Parallel Line" Display="'Two Horiz Parallel Line'" Dmx="107~112" />
      <Function ID="20" Name="Two Vert Parallel Line" Display="'Two Vert Parallel Line'" Dmx="113~118" />
      <Function ID="21" Name="Curve" Display="'Curve'" Dmx="119~124" />
      <Function ID="22" Name="Wave" Display="'Wave'" Dmx="125~130" />
      <Function ID="23" Name="Pointy Wave" Display="'Pointy Wave'" Dmx="131~136" />
      <Function ID="24" Name="Offset Cross" Display="'Offset Cross'" Dmx="137~142" />
      <Function ID="25" Name="Square" Display="'Square'" Dmx="143~148" />
      <Function ID="26" Name="Pointy Square" Display="'Pointy Square'" Dmx="149~154" />
      <Function ID="27" Name="Triangle" Display="'Triangle'" Dmx="155~160" />
      <Function ID="28" Name="Pointy Triangle" Display="'Pointy Triangle'" Dmx="161~166" />
      <Function ID="29" Name="Circle" Display="'Circle'" Dmx="167~172" />
      <Function ID="30" Name="Pointy Circle" Display="'Pointy Circle'" Dmx="173~178" />
      <Function ID="31" Name="Colour Test" Display="'Colour Test'" Dmx="245~245" />
      <Function ID="32" Name="Zone" Display="'Zone'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Visible_Points" Name="Visible Points" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Points in Pattern" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Anchor_Points" Name="Anchor Points" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" />
      <Function ID="2" Name="Sparse-&gt;Dense" Display="'Sparse-&gt;Dense %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Speed/Zone_X" />
      <Function ID="2" Name="Setup" Display="'Setup'" Dmx="200~249" Update="Speed/Zone_X" />
      <Function ID="3" Name="Playback" Display="'Playback'" Dmx="250~255" Update="Speed/Zone_X" />
    </Attribute>
    <Attribute ID="Speed/Zone_X" Name="Speed/Zone X" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Setup" ID="2" If="'Mode'==2" />
      <Function ID="1" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Size" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zone_Y" Name="Zone Y" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Size" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

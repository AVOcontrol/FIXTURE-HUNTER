      <Function ID="2" Name="Change Slow" Display="'Change Slow'" Dmx="11~45" />
      <Function ID="3" Name="Change Fast" Display="'Change Fast'" Dmx="46~80" />
      <Function ID="4" Name="Fade Slow" Display="'Fade Slow'" Dmx="81~115" />
      <Function ID="5" Name="Fade Fast" Display="'Fade Fast'" Dmx="116~150" />
      <Function ID="6" Name="Change (no P/T)" Display="'Change (no P/T)'" Dmx="151~185" />
      <Function ID="7" Name="Fade (no P/T)" Display="'Fade (no P/T)'" Dmx="186~220" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PIXBAR 500 PRO" ShortName="Pix 500pro" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-10-15" Author="Nic Morris" Comment="Created" />
  <History Date="17-10-15" Author="Nic Morris" Comment="Swapped shutter open and closed ranges in repsonse to customer bug report." />
  <History Date="17-10-15" Author="Nic Morris" Comment="Changed all fixed first functions to default at zero just in case." />
  <History Date="20-10-15" Author="Nic Morris" Comment="Added virtual dimmer to cells in response to customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-08-16" Author="Nic Morris" Comment="Added Atlabase ID's to 6 DMX modes." />
  <History Date="09-08-16" Author="Nic Morris" Comment="Removed 38 and 42 DMX modes (not valid for this fixture)" />
  <History Date="31-05-17" Author="Nic Morris" Comment="Created from Cameo PIXBAR 600 PRO" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bf7d943c-9fe1-466e-8ec1-2de0375fe5cd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" Intensity="0~0" />
      <Function ID="5" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" Intensity="0~0" />
      <Function ID="6" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" Intensity="0~0" />
      <Function ID="7" Name="Rnd Pulse" Display="'Rnd Pulse %.f%%',0~100" Dmx="11~33" Intensity="0~0" />
      <Function ID="8" Name="Break" Display="'Break %.f%%',0~100" Dmx="103~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="14~21" Colour="255,100,0" />
      <Function ID="4" Name="Yellow Warm" Display="'Yellow Warm'" Dmx="22~29" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="30~37" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="38~45" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="46~53" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="54~61" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="62~69" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="70~77" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="78~85" Colour="180,0,180" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="86~93" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="94~101" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="102~109" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Stop" Display="'Stop'" Dmx="126~128" Colour="255,255,255" />
      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="129~192" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="6~23" />
      <Function ID="3" Name="Meteor" Display="'Meteor'" Dmx="24~41" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="42~59" />
      <Function ID="5" Name="Jump" Display="'Jump'" Dmx="60~77" />
      <Function ID="6" Name="Flow 1" Display="'Flow 1'" Dmx="78~95" />
      <Function ID="7" Name="Flow 2" Display="'Flow 2'" Dmx="96~113" />
      <Function ID="8" Name="Flow 3" Display="'Flow 3'" Dmx="114~131" />
      <Function ID="9" Name="Flow 4" Display="'Flow 4'" Dmx="132~149" />
      <Function ID="10" Name="Flow 5" Display="'Flow 5'" Dmx="150~167" />
      <Function ID="11" Name="Flow 6" Display="'Flow 6'" Dmx="168~185" />
      <Function ID="12" Name="Flow 7" Display="'Flow 7'" Dmx="186~203" />
      <Function ID="13" Name="Flow 8" Display="'Flow 8'" Dmx="204~221" />
      <Function ID="14" Name="Flow 9" Display="'Flow 9'" Dmx="222~239" />
      <Function ID="15" Name="Flow 10" Display="'Flow 10'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

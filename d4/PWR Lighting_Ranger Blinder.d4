  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cebf7ff5-ab30-4bb1-8a10-88fe654ce8df" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~133" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Tungsten Effect" Display="'Tungsten Effect %.fms',100~3000" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~71" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="72~132" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="133~193" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Amber Dim Effect" Display="'Amber Dim Effect %.fms',300~500" Dmx="11~51" />
      <Function ID="3" Name="Round Up" Display="'Round Up %.fms',300~500" Dmx="52~92" />
      <Function ID="4" Name="Round Down" Display="'Round Down %.fms',300~500" Dmx="93~133" />
      <Function ID="5" Name="Round Up/Down" Display="'Round Up/Down %.fms',300~500" Dmx="134~174" />
      <Function ID="6" Name="2 Col Bounce" Display="'2 Col Bounce %.fms',300~500" Dmx="175~215" />
      <Function ID="7" Name="Rnd Effect" Display="'Rnd Effect %.fms',300~500" Dmx="216~255" />
    </Attribute>
  </Control>
  <Mode Name="Single, 1 DMX" Channels="1" Id="b142cf98-6f81-49be-9301-fa1ddb88af3d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

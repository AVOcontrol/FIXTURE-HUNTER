<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Reflection LEDko EXT FullSpectrum HD+" ShortName="LkEXTFSHD+" Company="Coemar" Version="12">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="17-05-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Revised shutter ranges so that 'no effect' = closed and 'stop strobe' = open in attempt to make it compatible with Capture." Version="3" />
  <History Date="09-10-18" Author="Nic Morris" Comment="Added v2.04 modes." Version="4" />
  <History Date="10-10-18" Author="Nic Morris" Comment="Added Atlabase ID's for v2.04 modes." Version="5" />
  <History Date="08-01-19" Author="Nic Morris" Comment="Created from Coemar Reflection LEDKO Full Spectrum Series 6" Version="6" />
  <History Date="05-09-20" Author="Nic Morris" Comment="Added RGB modes.  Added Atlabase ID's.  Added product thumbnail" Version="7" />
  <History Date="06-09-20" Author="Nic Morris" Comment="Corrected Atlabase model ID." Version="8" />
  <History Date="25-07-21" Author="Nic Morris" Comment="Added 600 Hz control function and macros." Version="9" />
  <History Date="24-08-22" Author="Nic Morris" Comment="Created from Coemar Reflection LEDko FullSpectrum 6 HD (documentation provided differs from that on the manufacturers website and doesn't look entirely genuine. note RGB tone colour names not detailed.  assumed identical)" Version="10" />
  <History Date="25-08-22" Author="Nic Morris" Comment="Changed name from Reflection LEDko EXT FullSpectrum RGBLA to Reflection LEDko EXT FullSpectrum HD+ in response to feedback." Version="11" />
  <History Date="25-08-22" Author="Nic Morris" Comment="(this is the name from the rear of the fixture although it is not quite the same as the one in the documentation)" Version="11" />
  <History Date="25-08-22" Author="Nic" Comment="Removed product thumbnail as it was for the wrong product." Version="11" />
  <History Date="27-08-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="12" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="824e4840-7c13-4ad4-b824-20a38f3c9052" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

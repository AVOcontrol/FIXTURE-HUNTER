    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="10~31" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="32~63" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="64~95" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="96~127" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="128~159" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="160~191" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="192~223" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Time" Name="Macro Time" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="xFade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

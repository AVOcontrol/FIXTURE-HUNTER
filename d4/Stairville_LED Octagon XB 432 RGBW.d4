    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="128~159" />
      <Function ID="6" Name="4 Col Chase" Display="'4 Col Chase'" Dmx="160~191" />
      <Function ID="7" Name="12 Col Chase" Display="'12 Col Chase'" Dmx="192~223" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~63" />
      <Function ID="2" Name="7 Col Chase" Display="'7 Col Chase'" Dmx="64~127" />
      <Function ID="3" Name="12 Col Chase" Display="'12 Col Chase'" Dmx="128~191" />
      <Function ID="4" Name="4 Col Chase" Display="'4 Col Chase'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~10" />
      <Function ID="2" Name="Fwd" Display="'Fwd %.f%%',100~0" Dmx="11~100" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="101~150" />
      <Function ID="4" Name="Rev" Display="'Rev %.f%%',0~100" Dmx="151~255" />
    </Attribute>
  </Control>

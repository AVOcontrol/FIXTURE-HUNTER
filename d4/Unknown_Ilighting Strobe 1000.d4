        <Attribute ID="Plate_Col_Mac" Wheel="7" />
        <Attribute ID="Reserved" ChannelOffset="18" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Beam" ChannelOffset="4" ModeLink="Beam cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Beam_Mode" TargetId="Beam_Mode" />
        <AttributeLink SourceId="Beam_Macro" TargetId="Beam_Macro" />

        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Plate_Shutter" TargetId="Plate_Shutter" />
        <AttributeLink SourceId="Plate_Macro" TargetId="Plate_Macro" />
        <AttributeLink SourceId="Plate_Mac_Spd" TargetId="Plate_Mac_Spd" />

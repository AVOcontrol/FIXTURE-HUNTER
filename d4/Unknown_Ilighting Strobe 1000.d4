  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" ChannelOffset="1,2" Wheel="3" />
        <Attribute ID="Master_Dimmer" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Beam_Mode" Wheel="22" />
        <Attribute ID="Beam_Macro" Wheel="23" />

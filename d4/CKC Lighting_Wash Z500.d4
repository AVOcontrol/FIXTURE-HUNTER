      <Function ID="18" Name="Led Freq 20000Hz" Display="'Led Freq 20000Hz'" Dmx="96~100" />
      <Function ID="19" Name="Led Freq 25000Hz" Display="'Led Freq 25000Hz'" Dmx="101~105" />
      <Function ID="20" Name="Reset P/T" Display="'Reset P/T'" Dmx="106~110" />
      <Function ID="21" Name="Reset Head" Display="'Reset Head'" Dmx="111~115" />
      <Function ID="22" Name="Reset All" Display="'Reset All'" Dmx="116~120" />
      <Function ID="23" Name="DTW On" Display="'DTW On'" Dmx="121~125" />
      <Function ID="24" Name="DTW Off" Display="'DTW Off'" Dmx="126~130" />
    </Attribute>
  </Control>

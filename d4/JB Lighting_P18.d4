      <Function ID="5" Name="Fire Effect Switch" Display="'Fire Effect Switch'" Dmx="0~0" Update="Animation" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Animation" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Animation" ID="1" If="'Animation_Func'==1" />
      <Condition Name="Water Effect Fade" ID="2,3,4,5" If="'Animation_Func'==2" />
      <Condition Name="Water Effect Switch" ID="6,7,8,9" If="'Animation_Func'==3" />
      <Condition Name="Fire Effect Fade" ID="10,11,12,13" If="'Animation_Func'==4" />
      <Condition Name="Fire Effect Switch" ID="14,15,16,17" If="'Animation_Func'==5" />
      <Else ID="18" />
      <Function ID="1" Name="No Animation" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="No Animation" Display="'No Animation'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Center Position" Display="'Center Position'" Dmx="1~1" WheelPosition="1" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="2~2" WheelPosition="2" />
      <Function ID="5" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="3~63" WheelPosition="3" />
      <Function ID="6" Name="No Animation" Display="'No Animation'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Center Position" Display="'Center Position'" Dmx="64~64" WheelPosition="1" />
      <Function ID="8" Name="Stop" Display="'Stop'" Dmx="65~65" WheelPosition="2" />
      <Function ID="9" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="66~127" WheelPosition="3" />
      <Function ID="10" Name="No Animation" Display="'No Animation'" Dmx="0~0" WheelPosition="0" />
      <Function ID="11" Name="Center Position" Display="'Center Position'" Dmx="128~128" WheelPosition="1" />
      <Function ID="12" Name="Stop" Display="'Stop'" Dmx="129~129" WheelPosition="2" />
      <Function ID="13" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="130~191" WheelPosition="3" />
      <Function ID="14" Name="No Animation" Display="'No Animation'" Dmx="0~0" WheelPosition="0" />
      <Function ID="15" Name="Center Position" Display="'Center Position'" Dmx="192~192" WheelPosition="1" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="193~193" WheelPosition="2" />
      <Function ID="17" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="194~255" WheelPosition="3" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="34438~35723" Colour="255,150,150" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="35980~37265" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="37522~38807" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="39064~40349" Colour="0,0,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="40606~41891" Colour="255,0,0" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="42148~43433" Colour="255,255,0" />
      <Function ID="8" Name="Amber/ UV" Display="'Amber/ UV'" Dmx="43690~44975" Colour="255,100,0" />
      <Function ID="9" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" Colour="0,0,0" />

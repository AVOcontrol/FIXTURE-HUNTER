      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2a5dc63c-58f6-41c5-97d0-7e15062e5754" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="SHPS9Q59" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1e8972ec-7883-4163-98c3-57d32e288239" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="23" />

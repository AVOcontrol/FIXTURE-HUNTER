      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="11" Name="Light Purple" Number="9" Page="1" SetControl="Colour2:4,Colour2Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="12" Name="Rose" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="14" Name="Light Purple" Number="8" Page="1" SetControl="Colour2:4,Colour2Func:1,Colour1:1,Colour1Func:1" />

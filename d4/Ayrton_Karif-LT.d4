  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:19,Control1:20" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:20,Control1:21" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:21,Control1:22" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />

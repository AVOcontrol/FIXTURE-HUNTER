<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Power Bank" ShortName="LED  PB" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="03-12-10" Author="Emma Thompson" Comment="Created" />
  <History Date="06-12-10" Author="John Rogers" Comment="Added all modes." />
  <History Date="28-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution." />
  <History Date="28-06-11" Author="Nic Morris" Comment="Fixed duplicate channel mapping in response to auto generated bug report." />
  <History Date="24-04-12" Author="Peter Budd" Comment="Added pixel mode." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="20-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's to Stage modes and changed cell to hidden." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Changed CYM attribute ID's to additive.  Fixed colour macro function names.  Revised highlight/lowligt.  Revised palettes." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Changed Magenta to Purple in line with documentation and used attribute ID UV." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Renamed 'Mode' to 'Control', renamed functions and added 'Control1' to fix as modes 1 or 2 respectively." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Revised ID functions.  Revised colour macro functions.  Revised Module functions.  Revised Effect range." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Added vdim to STAGE 1 (Mode 1)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a0497b3a-ccb0-4448-a194-aa2c44f565a5" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~29" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="30~39" Colour="255,85,0" />
      <Function ID="4" Name="Amber" Display="'Amber'" Dmx="40~49" Colour="255,170,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="50~69" Colour="255,255,0" />
      <Function ID="6" Name="Yellow-Green" Display="'Yellow-Green'" Dmx="70~79" Colour="170,255,0" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="80~89" Colour="85,255,0" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="90~109" Colour="0,255,0" />
      <Function ID="9" Name="Dark Green" Display="'Dark Green'" Dmx="110~119" Colour="0,170,85" />
      <Function ID="10" Name="Blue Green" Display="'Blue Green'" Dmx="120~129" Colour="0,85,170" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="130~149" Colour="0,0,255" />
      <Function ID="12" Name="Light Blue" Display="'Light Blue'" Dmx="150~159" Colour="0,85,255" />
      <Function ID="13" Name="Light Cyan" Display="'Light Cyan'" Dmx="160~169" Colour="0,170,255" />
      <Function ID="14" Name="Cyan" Display="'Cyan'" Dmx="170~189" Colour="0,255,255" />
      <Function ID="15" Name="Dark Cyan" Display="'Dark Cyan'" Dmx="190~199" Colour="42,170,255" />
      <Function ID="16" Name="Purple" Display="'Purple'" Dmx="200~219" Colour="128,0,255" />
      <Function ID="17" Name="Purple Green" Display="'Purple Green'" Dmx="220~229" Colour="62,124,193" />
      <Function ID="18" Name="RGB" Display="'RGB'" Dmx="230~249" Colour="255,255,255" />
      <Function ID="19" Name="White" Display="'White'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Module" />
      <Function ID="2" Name="Col Cycle 1" Display="'Col Cycle 1'" Dmx="5~34" Update="Module" />
      <Function ID="3" Name="Col Cycle 2" Display="'Col Cycle 2'" Dmx="35~64" Update="Module" />
      <Function ID="4" Name="Col Cycle 3" Display="'Col Cycle 3'" Dmx="65~94" Update="Module" />
      <Function ID="5" Name="Col Cycle 4" Display="'Col Cycle 4'" Dmx="95~124" Update="Module" />
      <Function ID="6" Name="Col Cycle 5" Display="'Col Cycle 5'" Dmx="125~154" Update="Module" />
      <Function ID="7" Name="Col Cycle 6" Display="'Col Cycle 6'" Dmx="155~184" Update="Module" />
      <Function ID="8" Name="Col Cycle 7" Display="'Col Cycle 7'" Dmx="185~214" Update="Module" />
      <Function ID="9" Name="Col Cycle 8" Display="'Col Cycle 8'" Dmx="215~244" Update="Module" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="IDs 1-20" Display="'IDs 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="IDs 21-66" Display="'IDs 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Module" Name="Module" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="10" If="'Control'==5" />
      <Else ID="1,2,3,4,5,6,7,8,9" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="5~34" />
      <Function ID="3" Name="2" Display="'2'" Dmx="35~64" />
      <Function ID="4" Name="3" Display="'3'" Dmx="65~94" />
      <Function ID="5" Name="1+2" Display="'1+2'" Dmx="95~124" />
      <Function ID="6" Name="2+3" Display="'2+3'" Dmx="125~154" />
      <Function ID="7" Name="1+3" Display="'1+3'" Dmx="155~184" />
      <Function ID="8" Name="All" Display="'All'" Dmx="185~214" />
      <Function ID="9" Name="All Off" Display="'All Off'" Dmx="215~255" />
      <Function ID="10" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~50" Dmx="5~255" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />

  <History Date="30-03-23" Author="Nic Morris" Comment="Created (very poor documentation.  16 channel mode is missing channels 14-16.  Can't be guessed)" Version="0" />
  <History Date="01-04-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="26-05-23" Author="Nic Morris" Comment="Created from Conic TBZ1240 (poor documentation)" Version="2" />
  <History Date="27-05-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="484a5a3e-0dc9-4865-9357-72f338ef9e1d" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~247" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="95~64" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="223~192" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="159~128" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="101~160" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="10~130" />
      <Function ID="3" Name="Random" Display="'Random %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGBW" Display="'RGBW'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="9~18" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="19~28" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="29~38" Colour="0,0,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="39~48" Colour="255,255,255" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="49~58" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="59~68" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="69~78" Colour="255,255,255" />
      <Function ID="9" Name="RGB" Display="'RGB'" Dmx="79~88" Colour="255,255,255" />
      <Function ID="10" Name="W" Display="'W'" Dmx="89~98" Colour="255,255,255" />
      <Function ID="11" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="99~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="9~38" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="39~68" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="69~98" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="99~128" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="129~158" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="159~187" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="188~255" />
    </Attribute>
    <Attribute ID="Effect_FG_Col" Name="Effect FG Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_BG_Col" Name="Effect BG Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

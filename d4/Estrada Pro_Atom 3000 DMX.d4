  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4b56a517-d565-4a1c-9df5-8f8f80f2b1f1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="1 Channel" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~249" Intensity="0~0" />
      <Function ID="4" Name="Blinder" Display="'Blinder'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Single Flash" Display="'Single Flash'" Dmx="0~0" />
      <Function ID="2" Name="Rate" Display="'Rate %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Effects" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up/Dn" Display="'Ramp Up/Dn %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="1 Channel" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1c126510-be5d-4388-a927-cfe95295f57c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Dummy" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="3 Channel" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="038c89c9-eed3-4752-8355-f50a8f488c0c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="4 Channel" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="856ae759-331b-4516-9942-2db7a74d43c5" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Effects" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
    </Include>
  </Mode>

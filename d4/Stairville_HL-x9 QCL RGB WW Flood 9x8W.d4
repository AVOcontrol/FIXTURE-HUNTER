  <AtlaBase TypeID="28cee9f0-d6eb-46c0-a6ad-da87abfd7d96" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="4 Col Chase" Display="'4 Col Chase'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="12 Col Chase" Display="'12 Col Chase'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect_Speed" Name="Effect Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="100~11" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="7 Col Change" Display="'7 Col Change'" Dmx="64~127" />
      <Function ID="3" Name="12 Col Change" Display="'12 Col Change'" Dmx="128~191" />
      <Function ID="4" Name="4 Col Change" Display="'4 Col Change'" Dmx="192~255" />
    </Attribute>
  </Control>

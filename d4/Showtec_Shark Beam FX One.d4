  <AtlaBase TypeID="d1fd082e-ba44-4fcd-a8da-d870f307fa5b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~250" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="R+W" Display="'R+W'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="G+W" Display="'G+W'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="B+W" Display="'B+W'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+G" Display="'R+G'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="G+B" Display="'G+B'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="R+B" Display="'R+B'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="G+B+W" Display="'G+B+W'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="Switch" Display="'Switch %.f%%',0~100" Dmx="151~200" Colour="255,255,255" />
      <Function ID="17" Name="Flow" Display="'Flow %.f%%',0~100" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam" Name="Beam" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Beam" Display="'Beam %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~195" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~134" />
      <Function ID="4" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="101~133" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~20" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="21~30" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="31~40" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="41~50" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="51~60" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="61~70" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="71~80" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="81~90" />
      <Function ID="10" Name="Sound Sens" Display="'Sound Sens %.1f%%',0.0~100.0" Dmx="91~230" />
      <Function ID="11" Name="Reset" Display="'Reset'" Dmx="231~240" />
    </Attribute>
  </Control>

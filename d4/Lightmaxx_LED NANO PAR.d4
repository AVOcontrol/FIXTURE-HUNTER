<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED NANO PAR" ShortName="NANO PAR" Company="Lightmaxx">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="09-10-17" Author="Nic Morris" Comment="Created" />
  <History Date="10-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="954c695a-4634-4bf0-bcf4-418fb0d8c5dc" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="11~50" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="51~100" />
      <Function ID="4" Name="Gradual" Display="'Gradual'" Dmx="101~150" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="151~200" />
      <Function ID="6" Name="Strobe" Display="'Strobe'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Cycle" Display="'Cycle'" Dmx="1~39" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="10" Name="Red Green" Display="'Red Green'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="11" Name="Red Blue" Display="'Red Blue'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="12" Name="Red White" Display="'Red White'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="13" Name="Green Blue" Display="'Green Blue'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="14" Name="Green White" Display="'Green White'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="15" Name="Blue White" Display="'Blue White'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="16" Name="Red Green White" Display="'Red Green White'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="17" Name="Red Blue White" Display="'Red Blue White'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="18" Name="Green Blue White" Display="'Green Blue White'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="19" Name="Red Green Blue" Display="'Red Green Blue'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="20" Name="Red Green Blue White" Display="'Red Green Blue White'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKLMNANO" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2451573b-812e-44c8-a8b5-f6439795dee3" />
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Auto_Spd" ChannelOffset="3" Wheel="23" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
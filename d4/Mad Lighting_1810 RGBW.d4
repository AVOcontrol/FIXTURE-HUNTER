<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="1810 RGBW" ShortName="1810 RGBW" Company="Mad Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="26-09-16" Author="Nic Morris" Comment="Created" />
  <History Date="28-09-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bea0f3a3-1805-4790-9655-cb6c713f37b1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Mode P" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~152" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="153~196" />
      <Function ID="5" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="197~242" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~196" />
      <Function ID="3" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="197~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade'" Dmx="2~19" />
      <Function ID="3" Name="Transient" Display="'Transient'" Dmx="20~39" />
      <Function ID="4" Name="Free" Display="'Free'" Dmx="40~59" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~79" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~99" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="100~119" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="120~139" />
      <Function ID="9" Name="Red Flash" Display="'Red Flash'" Dmx="140~159" />
      <Function ID="10" Name="Green Flash" Display="'Green Flash'" Dmx="160~179" />
      <Function ID="11" Name="Blue Flash" Display="'Blue Flash'" Dmx="180~199" />
      <Function ID="12" Name="Lt Yellow Flash" Display="'Lt Yellow Flash'" Dmx="200~219" />
      <Function ID="13" Name="Cyan Flash" Display="'Cyan Flash'" Dmx="220~229" />
      <Function ID="14" Name="White Flash" Display="'White Flash'" Dmx="230~249" />
      <Function ID="15" Name="All On" Display="'All On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="Mode A" Channels="4">
    <Import PearlRef="MAD1810A" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7fa1bb28-c799-4367-ac21-5121752cd8d5" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode P" Channels="5">
    <Import PearlRef="MAD1810P" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ce4ad6e6-a2d8-4278-980c-2c636f5941a7" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Dummy" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Mode F" Channels="7">
    <Import PearlRef="MAD1810F" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="86fef533-dcc8-44ef-81f7-92d4ee00a300" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Macro" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />

    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Scroll" ID="5" If="'Colour1Func'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="UV" Display="'UV'" Dmx="21~40" WheelPosition="1" Colour="50,0,200" />
      <Function ID="3" Name="UV+Blue" Display="'UV+Blue'" Dmx="41~60" WheelPosition="1" Colour="50,0,200" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="61~255" WheelPosition="2" Colour="0,0,255" />
      <Function ID="5" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Scroll" ID="5" If="'Colour1Func'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="21~40" WheelPosition="1" Colour="255,100,0" />
      <Function ID="3" Name="Orange+Red" Display="'Orange+Red'" Dmx="41~60" WheelPosition="1" Colour="255,100,0" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="61~255" WheelPosition="2" Colour="255,0,0" />
      <Function ID="5" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour3" Name="Colour 3" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Scroll" ID="5" If="'Colour1Func'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="21~40" WheelPosition="1" Colour="255,200,100" />
      <Function ID="3" Name="CTO+Green" Display="'CTO+Green'" Dmx="41~60" WheelPosition="1" Colour="255,200,100" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="61~255" WheelPosition="2" Colour="0,255,0" />
      <Function ID="5" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

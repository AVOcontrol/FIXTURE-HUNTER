<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iLED Ribalta 18x3W TRI" ShortName="18x3W TRI" Company="Gobos do Brasil" Version="1">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="12-06-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="16-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="973ff431-e2da-41be-8fb0-8ba3d25ee07a" />
  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Macro_Spd, Red" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="11~21" Update="Macro_Spd, Red" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~32" Update="Macro_Spd, Red" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="33~43" Update="Macro_Spd, Red" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="44~54" Update="Macro_Spd, Red" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="55~65" Update="Macro_Spd, Red" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="66~76" Update="Macro_Spd, Red" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="77~87" Update="Macro_Spd, Red" />
      <Function ID="9" Name="White" Display="'White'" Dmx="88~98" Update="Macro_Spd, Red" />
      <Function ID="10" Name="Dream" Display="'Dream'" Dmx="99~109" Update="Macro_Spd, Red" />
      <Function ID="11" Name="Meteor" Display="'Meteor'" Dmx="110~120" Update="Macro_Spd, Red" />
      <Function ID="12" Name="Fade" Display="'Fade'" Dmx="121~131" Update="Macro_Spd, Red" />
      <Function ID="13" Name="Change" Display="'Change'" Dmx="132~142" Update="Macro_Spd, Red" />
      <Function ID="14" Name="Flow 1" Display="'Flow 1'" Dmx="143~153" Update="Macro_Spd, Red" />
      <Function ID="15" Name="Flow 2" Display="'Flow 2'" Dmx="154~164" Update="Macro_Spd, Red" />
      <Function ID="16" Name="Flow 3" Display="'Flow 3'" Dmx="165~175" Update="Macro_Spd, Red" />
      <Function ID="17" Name="Flow 4" Display="'Flow 4'" Dmx="176~186" Update="Macro_Spd, Red" />
      <Function ID="18" Name="Flow 5" Display="'Flow 5'" Dmx="187~197" Update="Macro_Spd, Red" />
      <Function ID="19" Name="Flow 6" Display="'Flow 6'" Dmx="198~208" Update="Macro_Spd, Red" />
      <Function ID="20" Name="Flow 7" Display="'Flow 7'" Dmx="209~219" Update="Macro_Spd, Red" />
      <Function ID="21" Name="Flow 8" Display="'Flow 8'" Dmx="220~230" Update="Macro_Spd, Red" />
      <Function ID="22" Name="Flow 9" Display="'Flow 9'" Dmx="231~241" Update="Macro_Spd, Red" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="242~255" Update="Macro_Spd, Red" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="2" If="'Macro'&gt;9" />
      <Else ID="1" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Open" Display="''" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Macro'&gt;20" />
      <Else ID="1" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

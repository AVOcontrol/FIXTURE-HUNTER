      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="86~95" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="96~105" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="106~115" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="116~125" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="126~135" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="136~145" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="146~155" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="156~165" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="166~175" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="176~185" />
      <Function ID="18" Name="Auto 17" Display="'Auto 17'" Dmx="186~195" />
      <Function ID="19" Name="Auto 18" Display="'Auto 18'" Dmx="196~205" />
      <Function ID="20" Name="Auto 19" Display="'Auto 19'" Dmx="206~215" />
      <Function ID="21" Name="Auto 20" Display="'Auto 20'" Dmx="216~225" />
      <Function ID="22" Name="Auto 21" Display="'Auto 21'" Dmx="226~235" />
      <Function ID="23" Name="Auto 22" Display="'Auto 22'" Dmx="236~245" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

      <Function ID="20" Name="Effect Pattern 19" Display="'Effect Pattern 19'" Dmx="224~235" />
      <Function ID="21" Name="Effect Pattern 20" Display="'Effect Pattern 20'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="FX_Spd" Name="FX Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="3" Name="BWD" Display="'BWD %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="FX_Transition" Name="FX Transition" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Transition" Display="'%.2f Sec',0.00~5.00" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Halo Master" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter_Center" Name="Shutter Center" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />

      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Activate Standby" Display="'Activate Standby'" Dmx="26~100" />
      <Function ID="3" Name="Deactivate Standby" Display="'Deactivate Standby'" Dmx="101~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="a3a60aae-377b-4845-96b7-f199ba12caf0">

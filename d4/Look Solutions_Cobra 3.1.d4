    <Attribute ID="Curve" Name="Curve" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Continuous" Display="'Continuous'" Dmx="0~0" />
      <Function ID="2" Name="Flood" Display="'Flood'" Dmx="65~129" />

      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="0~35" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="36~71" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="72~107" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="108~143" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="144~179" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="180~215" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="216~255" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Rot_Func" Name="Gobo 1 Rot Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="16~31" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="32~47" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Anim CW" Display="'Anim CW'" Dmx="48~63" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CW w/ BO" Display="'Anim CW w/ BO'" Dmx="64~79" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Anim CCW" Display="'Anim CCW'" Dmx="80~95" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Anim CCW w/BO" Display="'Anim CCW w/BO'" Dmx="96~111" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo_Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo_Rot_Func'==1" />
      <Condition Name="Speed" ID="2" If="'Gobo_Rot_Func'&gt;1&amp;&amp;'Gobo_Rot_Func'&lt;8" />
      <Else ID="3" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">

  <History Date="07-08-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information." Version="2" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="3" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Changed name from L7-C to L7-C (3200K) in line with Capture options." Version="4" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added Atlabase ID's.  Increased wheel resolution." Version="5" />
  <History Date="12-08-16" Author="Nic Morris" Comment="Created from Arri Lighting L7-C (3200K)" Version="6" />
  <History Date="04-02-17" Author="Nic Morris" Comment="Harmonised Xfade to Col across range.  Added to highlight/lowlight" Version="7" />
  <History Date="18-10-17" Author="Nic Morris" Comment="Revised mode names.  Harmonised GN Saturation across range." Version="8" />
  <History Date="18-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." Version="9" />
  <History Date="26-11-20" Author="Nic Morris" Comment="Added Xfade value to highlight and lowlight." Version="10" />
  <History Date="14-07-23" Author="Nic Morris" Comment="Changed name back to L7-C in line with Capture (the ID for the 3200K version no longer appears to exist.  it is likely this was always wrong and there was only ever one version)." Version="11" />
  <History Date="14-07-23" Author="Nic Morris" Comment="Changed CCT display range to Kelvin.  Changed hue display range to degrees.  Added product thumbnail." Version="11" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="8377" ModelID="40" />

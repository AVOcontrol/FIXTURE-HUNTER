    <Attribute ID="Beam_FX_Spd" Name="Beam FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Direction" ID="2,3,4" If="'Beam_FX'&gt;4" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~0" />
      <Function ID="3" Name="Stop" Display="'Stop %.f',0~100" Dmx="128~128" />
      <Function ID="4" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>

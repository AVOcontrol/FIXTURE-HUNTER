<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hydrosonic 2000" ShortName="Hydro 2000" Company="JEM">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="15-02-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pump" Name="Pump" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Idle" Display="'Idle'" Dmx="0~29" />
      <Function ID="2" Name="Pump Out" Display="'Pump Out'" Dmx="30~59" />
      <Function ID="3" Name="Pump In" Display="'Pump In'" Dmx="60~89" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="90~109" />
      <Function ID="5" Name="Speed 1" Display="'Speed 1'" Dmx="110~129" />
      <Function ID="6" Name="Speed 2" Display="'Speed 2'" Dmx="130~149" />
      <Function ID="7" Name="Speed 3" Display="'Speed 3'" Dmx="150~169" />
      <Function ID="8" Name="Speed 4" Display="'Speed 4'" Dmx="170~189" />
      <Function ID="9" Name="Speed 5" Display="'Speed 5'" Dmx="190~209" />
      <Function ID="10" Name="Speed 6" Display="'Speed 6'" Dmx="210~229" />
      <Function ID="11" Name="Speed 7" Display="'Speed 7'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~39" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="40~75" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="76~111" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="112~147" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="148~183" />
      <Function ID="6" Name="Speed 5" Display="'Speed 5'" Dmx="184~219" />
      <Function ID="7" Name="Auto Sweep" Display="'Auto Sweep'" Dmx="220~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="JMHYDROS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pump" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
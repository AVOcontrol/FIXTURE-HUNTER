      <Function ID="14" Name="Light Bluish Violet" Display="'Light Bluish Violet'" Dmx="115~119" WheelPosition="13" Colour="180,0,255" />
      <Function ID="15" Name="CTB" Display="'CTB'" Dmx="124~127" WheelPosition="14" Colour="230,230,255" />
      <Function ID="16" Name="Op/Rd" Display="'Op/Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="14~17" WheelPosition="1" Colour="255,0,0" />

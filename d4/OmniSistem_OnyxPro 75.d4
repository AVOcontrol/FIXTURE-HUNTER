      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="42~44" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="48~50" WheelPosition="8" Colour="255,0,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="3~5" WheelPosition="0" Colour="255,255,255" />

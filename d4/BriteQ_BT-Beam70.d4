<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-Beam70" ShortName="BT-Beam70" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="05-04-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~28" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="29~42" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="43~56" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="57~70" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="71~84" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="85~98" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="99~112" Colour="0,128,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="113~127" Colour="255,150,150" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func1'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour1Func1'==2" />
      <Condition Name="Scroll" ID="18,19,20" If="'Colour1Func1'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~22" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="30~37" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="45~52" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="60~67" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="75~82" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="90~97" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="105~112" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="120~127" WheelPosition="8" Colour="255,150,150" />
      <Function ID="10" Name="Op/ Red" Display="'Op/ Red'" Dmx="8~14" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Red/ Org" Display="'Red/ Org'" Dmx="23~29" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Org/ Yel" Display="'Org/ Yel'" Dmx="38~44" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="53~59" WheelPosition="3" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="68~74" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="83~89" WheelPosition="5" Colour="0,0,255" />
      <Function ID="16" Name="Mag/ L Blu" Display="'Mag/ L Blu'" Dmx="98~104" WheelPosition="6" Colour="255,0,255" />
      <Function ID="17" Name="L Blu/ Pk" Display="'L Blu/ Pk'" Dmx="113~119" WheelPosition="7" Colour="0,128,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="64~73" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="74~82" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="83~91" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="92~100" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="101~109" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="110~118" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="119~127" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~69" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="4" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="90~99" />
      <Function ID="5" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="100~109" />
      <Function ID="6" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="110~119" />
      <Function ID="7" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="120~129" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX Col Norm" Channels="9">
    <Import PearlRef="UKBQBM71" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="8" Wheel="15" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="9 DMX Col Split" Channels="9">
    <Import PearlRef="UKBQBM72" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func1" Wheel="7" />
      <Attribute ID="Colour11" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="8" Wheel="15" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX Col Norm" Channels="11">
    <Import PearlRef="UKBQBM73" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="10" Wheel="15" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX Col Split" Channels="11">
    <Import PearlRef="UKBQBM74" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func1" Wheel="7" />
      <Attribute ID="Colour11" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="10" Wheel="15" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour11:1,Colour1Func1:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour11:1,Colour1Func1:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:2" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />

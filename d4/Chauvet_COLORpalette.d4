<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORpalette" ShortName="COLORpalet" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="30-08-07" Author="D.Milligan" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution." />
  <History Date="19-06-11" Author="Nic Morris" Comment="Added palettes.  Added v-dim.  Added pixel mapper compatibility." />
  <History Date="30-03-12" Author="Peter Budd" Comment="Edited dimmer so size is no longer 0 for version 6." />
  <History Date="13-08-12" Author="Peter Budd" Comment="Removed cells from 6 channel mode added cells to 27 channel mode." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="26-02-17" Author="Nic Morris" Comment="Added cell layouts.  Renamed Speed to Reserved.  Fixed dimmer wheel slot (was tilt)" />
  <History Date="26-02-17" Author="Nic Morris" Comment="Changed control channels to fix in relevant mode range.  Fixed 'Auto' mode channel count and renamed to 3 DMX." />
  <History Date="01-03-17" Author="Nic Morris" Comment="Added Atlabase ID to 3 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a972f942-5a16-4eaa-b40d-92db67a86f50" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

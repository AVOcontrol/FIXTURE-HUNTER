    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:13" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:23" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:24" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

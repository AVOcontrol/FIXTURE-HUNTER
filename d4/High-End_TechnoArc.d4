  <History Date="06-07-12" Author="Peter Budd" Comment="Created" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="24-10-18" Author="Nic Morris" Comment="Added product thumbnail.  Added physical pan/tilt ranges." />
  <History Date="24-10-18" Author="Nic Morris" Comment="Renamed CMY Func, inverted pure mix CMY functions in response to customer query and added cycle+random conditions." />
  <History Date="24-10-18" Author="Nic Morris" Comment="Standardised colour func options.  Increased wheel resolution.  Revised zoom bypass functions.  Inverted iris." />
  <History Date="24-10-18" Author="Nic Morris" Comment="Simplified shutter.  Fixed missing indigo dimmer cell link." />
  <Manual Filename="" Summary="" />

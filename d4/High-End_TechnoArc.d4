  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:4,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:5,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:6,Shutter:1" Delay="6000" />

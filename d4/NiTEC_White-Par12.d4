    <AtlaBase ModeID="ca9c69f5-1195-4505-b61a-2cd7ae0adff2" />
    <Include>
      <Attribute ID="Amber" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />

    <AtlaBase ModeID="1c85100e-d369-47bd-b916-3aae2a26f940" />
    <Include>
      <Attribute ID="Amber" ChannelOffset="1" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="12" />

    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Show" Display="'No Show'" Dmx="0~0" />
      <Function ID="2" Name="Show 0 (All Programs)" Display="'Show 0 (All Programs)'" Dmx="13~42" />
      <Function ID="3" Name="Show 1" Display="'Show 1'" Dmx="43~72" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="73~102" />
      <Function ID="5" Name="Show 3" Display="'Show 3'" Dmx="103~132" />
      <Function ID="6" Name="Show 4" Display="'Show 4'" Dmx="133~162" />
      <Function ID="7" Name="Show 5" Display="'Show 5'" Dmx="163~192" />
      <Function ID="8" Name="Show 6" Display="'Show 6'" Dmx="193~222" />
      <Function ID="9" Name="Show 7" Display="'Show 7'" Dmx="223~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off/On" Display="'Off/On'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
  </Control>

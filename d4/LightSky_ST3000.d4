  <History Date="08-02-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="11-02-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a4eb3263-5906-4654-9d0d-d8eee56bd379" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:7" PowerOn="1:7" />
      <Function ID="1" Name="Duration" Display="'%.fms',7~650" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_FX" Name="Strobe FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="6~47" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="48~91" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="92~133" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="134~175" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="176~217" />
    </Attribute>
    <Attribute ID="Aura_Shutter" Name="Aura Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Aura Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Aura Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Aura Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Aura_Macro" Name="Aura Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Macro" Name="Effect Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="3~15" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="16~28" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="29~41" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="42~54" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="55~67" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="68~80" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="81~93" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="94~106" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="107~119" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="120~132" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="133~145" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="146~158" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="159~171" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="172~184" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="185~197" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="198~210" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="211~223" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="224~236" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="237~249" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4feabd77-5849-41bb-a538-dc478ad7809c" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Duration" Wheel="6" />
        <Attribute ID="Rate" Wheel="5" />
        <Attribute ID="Strobe_FX" Wheel="22" />
        <Attribute ID="Aura_Shutter" Wheel="34" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Aura_Macro" Wheel="7" />
        <Attribute ID="Effect_Macro" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Strobe" ChannelOffset="1" ModeLink="Strobe cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Duration" TargetId="Duration" />
        <AttributeLink SourceId="Rate" TargetId="Rate" />
        <AttributeLink SourceId="Strobe_FX" TargetId="Strobe_FX" />
      </Cell>
      <Cell ID="Cell2" Name="Aura" ChannelOffset="5" ModeLink="Aura cell" X="0" Y="1">
        <AttributeLink SourceId="Aura_Shutter" TargetId="Aura_Shutter" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Aura_Macro" TargetId="Aura_Macro" />
        <AttributeLink SourceId="Effect_Macro" TargetId="Effect_Macro" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Strobe cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="6" />
      <Attribute ID="Rate" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Strobe_FX" ChannelOffset="4" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="Aura cell" Channels="6" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Aura_Shutter" ChannelOffset="1" Wheel="34" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Aura_Macro" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Effect_Macro" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

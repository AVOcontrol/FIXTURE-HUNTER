      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="50~56" WheelPosition="7">
        <Swatch>0fc9db79-1ede-4e13-a71d-716f4dc1a4d7</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="57~63" WheelPosition="8">
        <Swatch>700ae106-0a7f-4f35-9a95-4cf4bdf10ec8</Swatch>
      </Function>
      <Function ID="10" Name="Open Shake" Display="'Open Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="0">
        <Swatch>33471fae-af5f-482a-b4ad-211aba799f45</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="72~78" WheelPosition="1">
        <Swatch>ec8ce7f7-f973-4df8-b3cb-c8651d298fad</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="79~85" WheelPosition="2">
        <Swatch>55ea8b49-000e-4994-a43f-bb72efb59dff</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="86~92" WheelPosition="3">
        <Swatch>3908dee7-9d5e-4fa9-ba08-94c6d54858d7</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="93~99" WheelPosition="4">
        <Swatch>98513fc9-f6a0-4d7b-92a9-c53e0a56370d</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="100~106" WheelPosition="5">
        <Swatch>57a20c6a-4e29-46f7-a78c-cf1e6943b0c1</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="107~113" WheelPosition="6">
        <Swatch>96c6465b-5e84-40cd-bb14-e8b7a0d895db</Swatch>
      </Function>
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="114~120" WheelPosition="7">
        <Swatch>0fc9db79-1ede-4e13-a71d-716f4dc1a4d7</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="121~127" WheelPosition="8">
        <Swatch>700ae106-0a7f-4f35-9a95-4cf4bdf10ec8</Swatch>
      </Function>
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

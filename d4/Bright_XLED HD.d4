  <AtlaBase TypeID="8a2e3af7-bab2-425b-9cde-a36ad0eb2d02" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~119" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="128~183" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="192~247" />
    </Attribute>
    <Attribute ID="Rise_Time" Name="Rise Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Instant" Display="'Instant'" Dmx="0~0" />
      <Function ID="2" Name="Short" Display="'Short'" Dmx="32~63" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="64~95" />
      <Function ID="4" Name="Long" Display="'Long'" Dmx="96~127" />
      <Function ID="5" Name="Extra-Long" Display="'Extra-Long'" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Straw" Display="'Straw'" Dmx="0~0" Colour="255,250,230" />
      <Function ID="2" Name="Str - WW" Display="'Str - WW %.f%%',0~100" Dmx="0~20" Colour="255,250,230" />
      <Function ID="3" Name="Warm White" Display="'Warm White'" Dmx="20~20" Colour="255,240,200" />
      <Function ID="4" Name="WW - Wht" Display="'WW - Wht %.f%%',0~100" Dmx="20~40" Colour="255,240,200" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~40" Colour="255,255,255" />
      <Function ID="6" Name="Wht - CW" Display="'Wht - CW %.f%%',0~100" Dmx="40~60" Colour="255,255,255" />
      <Function ID="7" Name="Cool White" Display="'Cool White'" Dmx="60~60" Colour="230,230,255" />
      <Function ID="8" Name="CW - Blue" Display="'CW - Blue %.f%%',0~100" Dmx="60~80" Colour="230,230,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="80~80" Colour="0,0,255" />
      <Function ID="10" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="80~100" Colour="0,0,255" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="100~100" Colour="255,0,255" />
      <Function ID="12" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="100~120" Colour="255,0,255" />
      <Function ID="13" Name="Red" Display="'Red'" Dmx="120~120" Colour="255,0,0" />
      <Function ID="14" Name="Rd - Org" Display="'Rd - Org %.f%%',0~100" Dmx="120~140" Colour="255,0,0" />
      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="140~140" Colour="255,128,0" />
      <Function ID="16" Name="Org - Yel" Display="'Org - Yel %.f%%',0~100" Dmx="140~160" Colour="255,128,0" />
      <Function ID="17" Name="Yellow" Display="'Yellow'" Dmx="160~160" Colour="255,255,0" />
      <Function ID="18" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="160~180" Colour="255,255,0" />
      <Function ID="19" Name="Green" Display="'Green'" Dmx="180~180" Colour="0,255,0" />
      <Function ID="20" Name="Grn - Teal" Display="'Grn - Teal %.f%%',0~100" Dmx="180~200" Colour="0,255,0" />
      <Function ID="21" Name="Teal" Display="'Teal'" Dmx="200~200" Colour="0,255,200" />
      <Function ID="22" Name="Teal - Cy" Display="'Teal - Cy %.f%%',0~100" Dmx="200~220" Colour="0,255,200" />
      <Function ID="23" Name="Cyan" Display="'Cyan'" Dmx="220~220" Colour="0,255,255" />
      <Function ID="24" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="220~240" Colour="0,255,255" />
      <Function ID="25" Name="Blue" Display="'Blue'" Dmx="240~240" Colour="0,0,255" />
      <Function ID="26" Name="Blu - UV" Display="'Blu - UV %.f%%',0~100" Dmx="240~255" Colour="0,0,255" />
      <Function ID="27" Name="UV" Display="'UV'" Dmx="255~255" Colour="180,0,255" />
      <Function ID="28" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

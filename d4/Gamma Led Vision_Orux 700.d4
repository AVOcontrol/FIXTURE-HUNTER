    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="22~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="43~53" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="66~75" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="87~97" WheelPosition="4" Colour="0,255,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="109~119" WheelPosition="5" Colour="255,128,0" />

    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO C-Mix" Display="'CTO C-Mix %.fK',2500~10000" Dmx="255~20" Colour="0,0,0" />

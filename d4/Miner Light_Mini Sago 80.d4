<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Sago 80" ShortName="MiniSago80" Company="Miner Light" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>2e305101-1995-418a-9f12-0747f8da6150</Thumbnail>
  <History Date="02-10-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="05-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="da3c3955-a9f7-4411-9a70-3c0f00327ef1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="Pure White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Macro_Spd" />
      <Function ID="2" Name="Col Choose" Display="'Col Choose'" Dmx="1~62" Update="Macro_Spd" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="63~124" Update="Macro_Spd" />
      <Function ID="4" Name="Col Gradient" Display="'Col Gradient'" Dmx="125~186" Update="Macro_Spd" />
      <Function ID="5" Name="Col Pulse" Display="'Col Pulse'" Dmx="187~249" Update="Macro_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Macro_Spd" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Choose" ID="2" If="'Macro'==2" />
      <Condition Name="Sound" ID="3" If="'Macro'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Mode" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="A001, 6 DMX" Channels="6" Id="fc02d1ae-6a36-482c-9089-104a0d89f1fd">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5670c725-1ce8-4ba1-ba53-49f41bc2b6c1" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="White" ChannelOffset="2" Wheel="10" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Macro" ChannelOffset="5" Wheel="22" />
      <Attribute ID="Macro_Spd" ChannelOffset="6" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="d001, 2 DMX" Channels="2" Id="18000be6-b6ad-4a16-a566-c41a8d14760e">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a386d1a9-127a-427a-a24e-1551a2a31488" />
    <Include>
      <Attribute ID="White" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="2e305101-1995-418a-9f12-0747f8da6150"></Swatch>
  </swatchLibrary>
</Fixture>
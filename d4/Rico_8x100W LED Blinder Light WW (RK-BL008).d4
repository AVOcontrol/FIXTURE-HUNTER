<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="8x100W LED Blinder Light WW (RK-BL008)" ShortName="8x100W WW" Company="Rico">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-09-17" Author="Nic Morris" Comment="Created" />
  <History Date="09-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9d3178c1-0278-4625-986d-f6dc872e6f03" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d5e22dec-76d9-4216-b4e9-a0dcca2dfefd" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="8" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="9" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="10" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="11" ModeLink="Cell" X="1" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="12" ModeLink="Cell" X="1" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Step Mode" Display="'Step Mode %.1f%%',0.0~100.0" Dmx="2~128" />
      <Function ID="3" Name="Fade Mode" Display="'Fade Mode %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Pan Invert" Display="'Pan Invert'" Dmx="6~11" />
      <Function ID="3" Name="Pan Normal" Display="'Pan Normal'" Dmx="12~17" />
      <Function ID="4" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="18~23" />
      <Function ID="5" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="24~29" />
      <Function ID="6" Name="P/T Swapped" Display="'P/T Swapped'" Dmx="30~35" />
      <Function ID="7" Name="P/T Normal" Display="'P/T Normal'" Dmx="36~41" />
      <Function ID="8" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="42~47" />
      <Function ID="9" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="48~53" />
      <Function ID="10" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="54~59" />
      <Function ID="11" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="60~65" />
      <Function ID="12" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="66~71" />
      <Function ID="13" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="72~77" />
      <Function ID="14" Name="Fan Auto" Display="'Fan Auto'" Dmx="78~83" />
      <Function ID="15" Name="Fan Full" Display="'Fan Full'" Dmx="84~89" />
      <Function ID="16" Name="Fan Silent" Display="'Fan Silent'" Dmx="90~95" />
      <Function ID="17" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="96~101" />
      <Function ID="18" Name="No DMX Off" Display="'No DMX Off'" Dmx="102~107" />
      <Function ID="19" Name="Dim Linear" Display="'Dim Linear'" Dmx="108~113" />
      <Function ID="20" Name="Dim Square" Display="'Dim Square'" Dmx="114~119" />
      <Function ID="21" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="120~125" />
      <Function ID="22" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="126~131" />
      <Function ID="23" Name="PWM 600Hz" Display="'PWM 600Hz'" Dmx="132~137" />
      <Function ID="24" Name="PWM 1200Hz" Display="'PWM 1200Hz'" Dmx="138~143" />
      <Function ID="25" Name="PWM 2000Hz" Display="'PWM 2000Hz'" Dmx="144~149" />
      <Function ID="26" Name="PWM 4000Hz" Display="'PWM 4000Hz'" Dmx="150~155" />
      <Function ID="27" Name="PWM 6000Hz" Display="'PWM 6000Hz'" Dmx="156~161" />
      <Function ID="28" Name="PWM 15000Hz" Display="'PWM 15000Hz'" Dmx="162~167" />
      <Function ID="29" Name="Reset P/T" Display="'Reset P/T'" Dmx="168~173" />
      <Function ID="30" Name="Reset Iris/Prism" Display="'Reset Iris/Prism'" Dmx="174~179" />
      <Function ID="31" Name="Reset Colour" Display="'Reset Colour'" Dmx="180~185" />
      <Function ID="32" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="186~191" />
      <Function ID="33" Name="Reset Frost/Anim" Display="'Reset Frost/Anim'" Dmx="204~209" />
      <Function ID="34" Name="Reset All" Display="'Reset All'" Dmx="210~215" />
    </Attribute>
    <Attribute ID="Blade_3" Name="Frame B Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_3_Rot" Name="Frame B Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_2" Name="Frame R Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_2_Rot" Name="Frame R Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_1" Name="Frame T Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_1_Rot" Name="Frame T Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_4" Name="Frame L Pos" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_4_Rot" Name="Frame L Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_All_Rot" Name="Frame All Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frame_Macro" Name="Frame Macro" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~11565" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="32639~33410" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="11822~32382" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~32896" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33667~54227" />
      <Function ID="6" Name="Bounce" Display="'Bounce %.2f%%',0.00~100.00" Dmx="54484~65535" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
  </Control>

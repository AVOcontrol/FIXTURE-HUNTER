        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Macro" ChannelOffset="21" Wheel="22" />
        <Attribute ID="Macro_Spd" ChannelOffset="22" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="23" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="LED 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="0">

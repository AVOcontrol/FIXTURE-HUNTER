      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="207~215" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="216~224" Colour="0,0,0" />
      <Function ID="27" Name="Colour 26" Display="'Colour 26'" Dmx="225~233" Colour="0,0,0" />
      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="234~242" Colour="0,0,0" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="243~251" Colour="0,0,0" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="31" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="32" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro'" Dmx="1~24" Update="Red" />
      <Function ID="3" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="25~49" Update="Red" />
      <Function ID="4" Name="3 Col Fade" Display="'3 Col Fade'" Dmx="50~74" Update="Red" />
      <Function ID="5" Name="7 Col Jump" Display="'7 Col Jump'" Dmx="75~99" Update="Red" />
      <Function ID="6" Name="3 Col Jump" Display="'3 Col Jump'" Dmx="100~124" Update="Red" />
      <Function ID="7" Name="Dream 1" Display="'Dream 1'" Dmx="125~149" Update="Red" />
      <Function ID="8" Name="Dream 2" Display="'Dream 2'" Dmx="150~174" Update="Red" />
      <Function ID="9" Name="Red Fade" Display="'Red Fade'" Dmx="175~199" Update="Red" />
      <Function ID="10" Name="Green Fade" Display="'Green Fade'" Dmx="200~224" Update="Red" />
      <Function ID="11" Name="Blue Fade" Display="'Blue Fade'" Dmx="225~249" Update="Red" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Instant" Display="'Instant'" Dmx="0~0" />
      <Function ID="2" Name="Delayed" Display="'Delayed'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="ARTSFPT8" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_1_CCT" Name="Gel 1 CCT" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Col_Matching" Name="Gel 1 Col Match" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Best" Display="'Best'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Brightest" Display="'Brightest'" Dmx="128~170" Colour="0,0,0" />
      <Function ID="3" Name="No Colour Gel" Display="'No Colour Gel'" Dmx="171~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Type" Name="Gel 1 Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rosco" Display="'Rosco'" Dmx="0~0" Update="Gel_Category" Colour="255,255,255" />
      <Function ID="2" Name="Lee" Display="'Lee'" Dmx="128~255" Update="Gel_Category" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Category" Name="Gel 1 Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="LEE" ID="6,7,8,9,10" If="'Gel_Type'==2" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Color Correction" Display="'Color Correction'" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="2" Name="CalColor" Display="'CalColor'" Dmx="51~101" Update="Gel" Colour="255,255,255" />
      <Function ID="3" Name="Storaro Selection" Display="'Storaro Selection'" Dmx="102~152" Update="Gel" Colour="255,255,255" />
      <Function ID="4" Name="Roscolux" Display="'Roscolux'" Dmx="153~203" Update="Gel" Colour="255,255,255" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="204~255" Update="Gel" Colour="255,255,255" />
      <Function ID="6" Name="Color Correction" Display="'Color Correction'" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="7" Name="Color Filters" Display="'Color Filters'" Dmx="51~101" Update="Gel" Colour="255,255,255" />
      <Function ID="8" Name="600 Series" Display="'600 Series'" Dmx="102~152" Update="Gel" Colour="255,255,255" />
      <Function ID="9" Name="Cosmetic Filters" Display="'Cosmetic Filters'" Dmx="153~203" Update="Gel" Colour="255,255,255" />
      <Function ID="10" Name="700 Series" Display="'700 Series'" Dmx="204~255" Update="Gel" Colour="255,255,255" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FiberSource CMY 150" ShortName="FibreCMY" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="07-07-06" Author="Ed" Comment="Fixed Colour mixing attributes to all be CMIXES" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated Raw DMX function to have no range." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Removed duplicates of 30-03-12 history.  Increased dimmer wheel resolution." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Fixed control channel function ranges in response to customer bug report." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Added missing ranges to all random colour functions in response to customer bug report." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Fixed channel mapping in response to customer bug report.  Added hi/lo light.  Added palettes.  Remade macros." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Moved speed into special bank to match group.  Moved random colour from tilt slot to colour and changed group to colour." />
  <History Date="16-05-14" Author="Nic Morris" Comment="Inverted speed wheel direction and increased resolution." />
  <Manual Filename="\manuals\fixtures\martin" Summary="" />
  <RDM>
    <Device ManufacturerID="19792" />
  </RDM>
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~207" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="208~217" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" />
      <Function ID="4" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~2" />
      <Function ID="2" Name="Speed" Display="'F-S %.1f%%',0.0~100.0" Dmx="245~3" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="RandCol" Name="Random Color" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~14" Colour="0,0,0" />
      <Function ID="2" Name="CMYslow" Display="'CMY Slow'" Dmx="15~34" Colour="0,0,0" />
      <Function ID="3" Name="CMYmed" Display="'CMY Med'" Dmx="35~54" Colour="0,0,0" />
      <Function ID="4" Name="CMYfast" Display="'CMY Fast'" Dmx="55~74" Colour="0,0,0" />
      <Function ID="5" Name="MYslow" Display="'MY Slow'" Dmx="75~94" Colour="0,0,0" />
      <Function ID="6" Name="MYmed" Display="'MY Med'" Dmx="95~114" Colour="0,0,0" />
      <Function ID="7" Name="MYfast" Display="'MY fast'" Dmx="115~134" Colour="0,0,0" />
      <Function ID="8" Name="CMslow" Display="'CM slow'" Dmx="135~154" Colour="0,0,0" />
      <Function ID="9" Name="CMmed" Display="'CM Med'" Dmx="155~174" Colour="0,0,0" />
      <Function ID="10" Name="CMfast" Display="'CM Fast'" Dmx="175~194" Colour="0,0,0" />
      <Function ID="11" Name="CYslow" Display="'CY Slow'" Dmx="195~214" Colour="0,0,0" />
      <Function ID="12" Name="CYmed" Display="'CY Med'" Dmx="215~234" Colour="0,0,0" />
      <Function ID="13" Name="CYfast" Display="'CY Fast'" Dmx="235~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="MT_FibSrCMY" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="10.4" />
      <Size Height="199mm" Width="213mm" Depth="330mm" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Cyan" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="5" Wheel="12" />
      <Attribute ID="RandCol" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="7" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
  </Palettes>
</Fixture>
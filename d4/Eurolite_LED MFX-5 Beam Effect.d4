  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ec815726-f8ee-4a4f-ad78-fa3543398800" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="2~2" Colour="0,0,255" />
      <Function ID="3" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="3~40" Colour="0,0,255" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="41~41" Colour="0,255,255" />
      <Function ID="5" Name="Cy - Grn" Display="'Cy - Grn %.f%%',0~100" Dmx="42~80" Colour="0,255,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="81~81" Colour="0,255,0" />
      <Function ID="7" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="82~120" Colour="0,255,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="121~121" Colour="255,255,0" />
      <Function ID="9" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="122~160" Colour="255,255,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="161~161" Colour="255,0,0" />
      <Function ID="11" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="162~200" Colour="255,0,0" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="201~201" Colour="255,0,255" />
      <Function ID="13" Name="Mag - Wht" Display="'Mag - Wht %.f%%',0~100" Dmx="202~240" Colour="255,0,255" />
      <Function ID="14" Name="White" Display="'White'" Dmx="241~241" Colour="255,255,255" />
      <Function ID="15" Name="Wht - CTO" Display="'Wht - CTO %.f%%',0~100" Dmx="242~255" Colour="255,255,255" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="2~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Switch" Display="'Switch'" Dmx="64~127" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="128~191" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Tilt 1" Display="'Reset Tilt 1'" Dmx="41~80" />
      <Function ID="3" Name="Reset Tilt 2" Display="'Reset Tilt 2'" Dmx="81~120" />
      <Function ID="4" Name="Reset Tilt 3" Display="'Reset Tilt 3'" Dmx="121~160" />
      <Function ID="5" Name="Reset Tilt 4" Display="'Reset Tilt 4'" Dmx="161~200" />
      <Function ID="6" Name="Reset Tilt 5" Display="'Reset Tilt 5'" Dmx="201~240" />
      <Function ID="7" Name="Reset All" Display="'Reset All'" Dmx="241~255" />
    </Attribute>
  </Control>

  <AtlaBase TypeID="ba0861d7-67c6-4c20-a24d-1caf44d8e0e1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="10000K" Display="'10000K'" Dmx="17~24" Colour="255,240,200" />
      <Function ID="3" Name="7200K" Display="'7200K'" Dmx="25~32" Colour="255,240,200" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="33~40" Colour="230,230,255" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="41~48" Colour="230,230,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="49~56" Colour="0,255,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="57~64" Colour="255,255,0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="65~72" Colour="255,0,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="73~80" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="81~88" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="89~96" Colour="0,0,255" />
      <Function ID="12" Name="Aqua" Display="'Aqua'" Dmx="97~104" Colour="0,255,255" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="105~112" Colour="255,128,0" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="113~120" Colour="255,128,64" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="121~128" Colour="255,128,255" />
      <Function ID="16" Name="RGB Colour Cycle" Display="'RGB Colour Cycle'" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~47" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="48~80" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="No Movement" Display="'No Movement'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>

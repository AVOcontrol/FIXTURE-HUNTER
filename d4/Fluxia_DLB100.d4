<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DLB100" ShortName="DLB100" Company="Fluxia">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="08-08-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~6" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~13" Update="Speed" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="14~20" Update="Speed" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~27" Update="Speed" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="28~34" Update="Speed" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="35~41" Update="Speed" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="42~48" Update="Speed" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="49~55" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="56~62" Update="Speed" Colour="255,255,255" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="63~69" Update="Speed" Colour="255,255,255" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="70~76" Update="Speed" Colour="255,255,255" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="77~83" Update="Speed" Colour="255,255,255" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="84~90" Update="Speed" Colour="255,255,255" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="91~97" Update="Speed" Colour="255,255,255" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="98~104" Update="Speed" Colour="255,255,255" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="105~111" Update="Speed" Colour="255,255,255" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="112~118" Update="Speed" Colour="255,255,255" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="119~125" Update="Speed" Colour="255,255,255" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="126~132" Update="Speed" Colour="255,255,255" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="133~139" Update="Speed" Colour="255,255,255" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="140~146" Update="Speed" Colour="255,255,255" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="147~153" Update="Speed" Colour="255,255,255" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="154~160" Update="Speed" Colour="255,255,255" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="161~167" Update="Speed" Colour="255,255,255" />
      <Function ID="25" Name="Program 17" Display="'Program 17'" Dmx="168~174" Update="Speed" Colour="255,255,255" />
      <Function ID="26" Name="Program 18" Display="'Program 18'" Dmx="175~181" Update="Speed" Colour="255,255,255" />
      <Function ID="27" Name="Program 19" Display="'Program 19'" Dmx="182~188" Update="Speed" Colour="255,255,255" />
      <Function ID="28" Name="Program 20" Display="'Program 20'" Dmx="189~195" Update="Speed" Colour="255,255,255" />
      <Function ID="29" Name="Program 21" Display="'Program 21'" Dmx="196~202" Update="Speed" Colour="255,255,255" />
      <Function ID="30" Name="Program 22" Display="'Program 22'" Dmx="203~209" Update="Speed" Colour="255,255,255" />
      <Function ID="31" Name="Program 23" Display="'Program 23'" Dmx="210~216" Update="Speed" Colour="255,255,255" />
      <Function ID="32" Name="Program 24" Display="'Program 24'" Dmx="217~223" Update="Speed" Colour="255,255,255" />
      <Function ID="33" Name="Program 25" Display="'Program 25'" Dmx="224~230" Update="Speed" Colour="255,255,255" />
      <Function ID="34" Name="Program 26" Display="'Program 26'" Dmx="231~237" Update="Speed" Colour="255,255,255" />
      <Function ID="35" Name="Program 27" Display="'Program 27'" Dmx="238~244" Update="Speed" Colour="255,255,255" />
      <Function ID="36" Name="Program 28" Display="'Program 28'" Dmx="245~251" Update="Speed" Colour="255,255,255" />
      <Function ID="37" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Speed" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==37" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

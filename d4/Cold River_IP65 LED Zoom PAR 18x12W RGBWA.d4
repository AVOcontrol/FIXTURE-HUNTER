      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="41~60" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="61~80" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="81~100" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="101~120" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="121~140" />
      <Function ID="7" Name="Auto Jump" Display="'Auto Jump'" Dmx="141~160" />
      <Function ID="8" Name="Auto Fade" Display="'Auto Fade'" Dmx="161~180" />
      <Function ID="9" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="181~200" />
      <Function ID="10" Name="Auto Sound 1" Display="'Auto Sound 1'" Dmx="201~220" />
      <Function ID="11" Name="Auto Sound 2" Display="'Auto Sound 2'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

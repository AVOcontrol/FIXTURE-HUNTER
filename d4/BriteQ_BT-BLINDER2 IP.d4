  <AtlaBase TypeID="4bc2a5ba-c09f-4559-80c3-48ce7dfd84a0" />
  <Control>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="170~253" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="2~85" />
      <Function ID="5" Name="Rnd Pix" Display="'Rnd Pix %.f%%',0~100" Dmx="86~169" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red Shift On" Display="'Red Shift On'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="6~10" />
      <Function ID="3" Name="Dim Spd" Display="'Dim Spd %.f%%',0~100" Dmx="27~127" />
      <Function ID="4" Name="Pixel Order A" Display="'Pixel Order A'" Dmx="134~139" />
      <Function ID="5" Name="Pixel Order B" Display="'Pixel Order B'" Dmx="140~145" />
      <Function ID="6" Name="Fan Auto" Display="'Fan Auto'" Dmx="152~157" />
      <Function ID="7" Name="Fan Full" Display="'Fan Full'" Dmx="158~161" />
      <Function ID="8" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~173" />
      <Function ID="9" Name="Dim Square" Display="'Dim Square'" Dmx="174~179" />
      <Function ID="10" Name="Dim Inv Sq" Display="'Dim Inv Sq'" Dmx="180~185" />
      <Function ID="11" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="186~191" />
      <Function ID="12" Name="Load Default" Display="'Load Default'" Dmx="198~203" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red Shift On" Display="'Red Shift On'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="6~10" />
      <Function ID="3" Name="Pixel Order A" Display="'Pixel Order A'" Dmx="134~139" />
      <Function ID="4" Name="Pixel Order B" Display="'Pixel Order B'" Dmx="140~145" />
      <Function ID="5" Name="Fan Auto" Display="'Fan Auto'" Dmx="152~157" />
      <Function ID="6" Name="Fan Full" Display="'Fan Full'" Dmx="158~161" />
      <Function ID="7" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~173" />
      <Function ID="8" Name="Dim Square" Display="'Dim Square'" Dmx="174~179" />
      <Function ID="9" Name="Dim Inv Sq" Display="'Dim Inv Sq'" Dmx="180~185" />
      <Function ID="10" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="186~191" />
      <Function ID="11" Name="Load Default" Display="'Load Default'" Dmx="198~203" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />

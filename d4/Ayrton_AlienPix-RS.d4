<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AlienPix-RS" ShortName="AlienPx RS" Company="Ayrton">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="14-11-16" Author="Nic Morris" Comment="Created" />
  <History Date="22-03-17" Author="Nic Morris" Comment="Changed name from Alienpix-RS to AlienPix-RS" />
  <History Date="23-03-17" Author="Nic Morris" Comment="Standardised across product range." />
  <History Date="23-03-17" Author="Nic Morris" Comment="Revised cell ID's so that RGB control follows logical numeric sequence." />
  <History Date="29-03-17" Author="Nic Morris" Comment="Added v-dim to RGBW cells.  Combined RGBW and LED pan into centre cell for Extended modes." />
  <History Date="30-03-17" Author="Nic Morris" Comment="Tidied" />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added physical pan/tilt limits and revised layout in line with detailed information from manufacturer." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="16761" ModelID="2660" />
  </RDM>
  <AtlaBase TypeID="4a3ae372-e9e6-4029-8678-b03c590cbf78" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="80~85" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="86~90" />
      <Function ID="4" Name="Reset LED Tilt" Display="'Reset LED Tilt'" Dmx="91~99" />
      <Function ID="5" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="6" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="7" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="8" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="9" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="10" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="11" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
    </Attribute>
    <Attribute ID="LED_Pan" Name="LED Pan" Description="" Group="B" Size="0">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="LED_Tilt" Name="LED Tilt" Description="" Group="B" Size="0">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="LED_Pan_Spin" Name="LED Pan Spin" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="0~0" />
    </Attribute>
    <Attribute ID="LED_Tilt_Spin" Name="LED Tilt Spin" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />

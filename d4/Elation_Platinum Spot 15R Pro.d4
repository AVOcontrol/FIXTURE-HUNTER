<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Platinum Spot 15R Pro" ShortName="PlatSp15RP" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="05-07-10" Author="Jonathan Moreton" Comment="Created" />
  <History Date="05-01-11" Author="Nic Morris" Comment="Adapted from Platinum Spot 5R" />
  <History Date="03-05-11" Author="Nic Morris" Comment="Standardised func names.  Fixed raw ranges.  Added raw to Gobo2Func." />
  <History Date="03-05-11" Author="Nic Morris" Comment="Adjusted wheel resolutions.  Fixed power on and locate." />
  <History Date="10-05-11" Author="Nic Morris" Comment="Removed percentage value from macro return function." />
  <History Date="10-05-11" Author="Nic Morris" Comment="Increased macro delay in attempt to resolve reported bug.  There are no details from manuf." />
  <History Date="06-11-12" Author="Peter Budd" Comment="Edited changed colour speed to locate at 0, and called the range speed." />
  <History Date="02-04-14" Author="Nic Morris" Comment="Standardised shutter.  Fixed macros.  Inverted iris, Colour Speed and P/T speed wheel direction." />
  <History Date="28-06-14" Author="Nic Morris" Comment="Updated colour and gobo 1 ranges in line with revised manufacturer documentation." />
  <History Date="13-07-14" Author="Nic Morris" Comment="Added missing Gobo 8 to preset palettes in response to customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed name from Platinum Spot 15RPro to Platinum Spot 15R Pro" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Added gobo swatches.  Tidied." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a8e086da-bcfb-4559-afa1-c69854b4a39a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4883~9509" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="9766~14392" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="14649~19275" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="19532~24158" Colour="255,255,0" />

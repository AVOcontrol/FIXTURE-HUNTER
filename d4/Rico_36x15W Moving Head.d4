      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="13" Wheel="4" />

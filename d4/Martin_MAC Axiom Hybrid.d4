  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="30-05-16" Author="Nic Morris" Comment="Created" />
  <History Date="13-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="20-04-17" Author="Nic Morris" Comment="Updated in line with manual revision D (specifically Gobo 2 and control)." />
  <History Date="20-04-17" Author="Nic Morris" Comment="Fixed error on Colour CCW scroll range.  Changed colour index ranges to provide full field adjustment." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3f23ae7b-784b-4f61-8ee2-4d066c5fb48f" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="30~30" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~180" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="181~190" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />

      <Function ID="20" Name="Gobo 9 (Circles)" Display="'Gobo 9 (Circles)'" Dmx="72~80" WheelPosition="9" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="22" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="81~90" WheelPosition="1" />
      <Function ID="23" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="91~100" WheelPosition="2" />

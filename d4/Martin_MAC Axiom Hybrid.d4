      <Function ID="9" Name="Gobo 8 (Slice It)" Display="'Gobo 8 (Slice It)'" Dmx="32~35" WheelPosition="8" />
      <Function ID="10" Name="Gobo 9 (Circles)" Display="'Gobo 9 (Circles)'" Dmx="36~40" WheelPosition="9" />

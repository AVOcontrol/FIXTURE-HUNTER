      <Function ID="14" Name="Gobo 3 (Bite Me)" Display="'Gobo 3 (Bite Me)'" Dmx="49~52" WheelPosition="3" />
      <Function ID="15" Name="Gobo 4 (Laser Sq)" Display="'Gobo 4 (Laser Sq)'" Dmx="53~56" WheelPosition="4" />

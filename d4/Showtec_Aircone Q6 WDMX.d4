      <Function ID="21" Name="Colour 20" Display="'Colour 20'" Dmx="140~146" WheelPosition="20" Colour="0,0,0" />
      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="147~153" WheelPosition="21" Colour="0,0,0" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="154~160" WheelPosition="22" Colour="0,0,0" />
      <Function ID="24" Name="Colour 23" Display="'Colour 23'" Dmx="161~167" WheelPosition="23" Colour="0,0,0" />
      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="168~174" WheelPosition="24" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="175~181" WheelPosition="25" Colour="0,0,0" />
      <Function ID="27" Name="Colour 26" Display="'Colour 26'" Dmx="182~188" WheelPosition="26" Colour="0,0,0" />
      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="189~195" WheelPosition="27" Colour="0,0,0" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="196~202" WheelPosition="28" Colour="0,0,0" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="203~209" WheelPosition="29" Colour="0,0,0" />
      <Function ID="31" Name="Colour 30" Display="'Colour 30'" Dmx="210~216" WheelPosition="30" Colour="0,0,0" />
      <Function ID="32" Name="Colour 31" Display="'Colour 31'" Dmx="217~223" WheelPosition="31" Colour="0,0,0" />
      <Function ID="33" Name="Colour 32" Display="'Colour 32'" Dmx="224~230" WheelPosition="32" Colour="0,0,0" />
      <Function ID="34" Name="Colour 33" Display="'Colour 33'" Dmx="231~237" WheelPosition="33" Colour="0,0,0" />

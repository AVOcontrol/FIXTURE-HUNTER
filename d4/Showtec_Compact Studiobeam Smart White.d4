      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="145~151" Colour="0,0,0" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="152~158" Colour="0,0,0" />

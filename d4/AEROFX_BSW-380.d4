      <Condition Name="Shake" ID="5,6,7,8,9" If="'Gobo3Func'==2" />
      <Condition Name="Animation" ID="10,11,12" If="'Gobo3Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>d51f232a-0698-47db-b9b2-b252e3bd29b6</Swatch>

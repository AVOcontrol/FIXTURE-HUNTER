      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="9~24">
        <Swatch>41aed88d-ac4d-47b4-80cb-1879c8ca3b0b</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="25~40">

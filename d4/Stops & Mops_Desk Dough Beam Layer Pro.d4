    <Attribute ID="Rot_Func_X" Name="Gobo Rot X Fn" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="GoboRotX" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="255~255" Update="GoboRotX" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="GoboRotX" />
    </Attribute>
    <Attribute ID="GoboRotX" Name="Gobo Rot X" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Rot_Func_X'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Rot_Func_X'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="1~65535" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="32768~32768" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32768~32768" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32769~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>

      <Function ID="5" Name="2 Col Vignette" Display="'2 Col Vignette'" Dmx="5~5" Colour="0,0,0" />
      <Function ID="6" Name="2 Col Ring Edge" Display="'2 Col Ring Edge'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="7" Name="2 Col Ring Vignette" Display="'2 Col Ring Vignette'" Dmx="7~7" Colour="0,0,0" />
      <Function ID="8" Name="2 Col Square Edge" Display="'2 Col Square Edge'" Dmx="8~8" Colour="0,0,0" />

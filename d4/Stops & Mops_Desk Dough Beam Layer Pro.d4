      <Function ID="6" Name="Ocean" Display="'Ocean'" Dmx="5~5" Colour="0,180,180" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="6~6" Colour="0,0,255" />
      <Function ID="8" Name="Deep Blue" Display="'Deep Blue'" Dmx="7~7" Colour="0,0,180" />
      <Function ID="9" Name="Violet" Display="'Violet'" Dmx="8~8" Colour="128,0,255" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="9~9" Colour="255,150,150" />

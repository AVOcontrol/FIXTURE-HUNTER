<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Desk Dough Beam Layer Pro" ShortName="DDB Layer" Company="Stops &amp; Mops" Version="6">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="15-01-21" Author="Sebastian Beutel" Comment="Created - DMX protocol v0.4" Version="0" />
  <History Date="03-03-21" Author="Sebastian Beutel" Comment="Tested and edited with real fixture. Gobo Folder already named as in next version." Version="4" />
  <History Date="16-03-21" Author="Nic Morris" Comment="Minor revisions to attribute and function names.  Changed some of the 16bit ranges to start at 1 to achieve recommended default value." Version="6" />
  <History Date="16-03-21" Author="Nic Morris" Comment="Removed tbc functions (where relevant undefined values can be accessed using Raw functions).  Added palettes." Version="6" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blend_Mode" Name="Blend Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Interpolate" Display="'Interpolate'" Dmx="0~0" />
      <Function ID="2" Name="Replace" Display="'Replace'" Dmx="1~1" />
      <Function ID="3" Name="Add" Display="'Add'" Dmx="2~2" />
      <Function ID="4" Name="Subtract" Display="'Subtract'" Dmx="3~3" />
      <Function ID="5" Name="Multiply" Display="'Multiply'" Dmx="4~4" />
      <Function ID="6" Name="Invert" Display="'Invert'" Dmx="5~5" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Mode" Name="Strobe Mode" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="10~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe Sync" Display="'Strobe Sync'" Dmx="11~11" />
      <Function ID="4" Name="Strobe Sync Pulse" Display="'Strobe Sync Pulse'" Dmx="12~12" />
      <Function ID="5" Name="Strobe Sync Step" Display="'Strobe Sync Step'" Dmx="13~13" />
      <Function ID="6" Name="Strobe Random" Display="'Strobe Random'" Dmx="14~14" />
      <Function ID="7" Name="Strobe Random Pulse" Display="'Strobe Random Pulse'" Dmx="15~15" />
      <Function ID="8" Name="Strobe Random Step" Display="'Strobe Random Step'" Dmx="16~16" />
      <Function ID="9" Name="Chase Pulse Long" Display="'Chase Pulse Long'" Dmx="17~17" />
      <Function ID="10" Name="Chase Pulse Long Inv" Display="'Chase Pulse Long Inv'" Dmx="18~18" />
      <Function ID="11" Name="Chase Pulse Short" Display="'Chase Pulse Short'" Dmx="19~19" />
      <Function ID="12" Name="Chase Pulse Short Inv" Display="'Chase Pulse Short Inv'" Dmx="20~20" />
      <Function ID="13" Name="Chase Step" Display="'Chase Step'" Dmx="21~21" />
      <Function ID="14" Name="Chase Step Random" Display="'Chase Step Random'" Dmx="22~22" />
      <Function ID="15" Name="Chase Fade" Display="'Chase Fade'" Dmx="23~23" />
      <Function ID="16" Name="Chase Fade Random" Display="'Chase Fade Random'" Dmx="24~24" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Speed" Name="Strobe Speed" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="No Scroll" Display="'No Scroll'" Dmx="127~127" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Strobe_Group" Name="Strobe Group" Description="" Group="I">
      <Locate Locate="1:4" PowerOn="1:4" />
      <Function ID="1" Name="Group" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Wing" Name="Strobe Wing" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Wing" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

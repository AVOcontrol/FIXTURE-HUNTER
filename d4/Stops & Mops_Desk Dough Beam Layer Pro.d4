    <Attribute ID="Col_Variable_1" Name="Col Variable 1" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="REV" Display="'REV %.1f%%',100.0~0.0" Dmx="0~126" Colour="0,0,0" />

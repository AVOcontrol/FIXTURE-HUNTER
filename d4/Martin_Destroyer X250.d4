<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Destroyer X250" ShortName="Destroyer" Company="Martin" Version="2">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>edf7aab4-8ee4-4748-8914-e18b7b118a3c</Thumbnail>
  <History Date="14-10-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="20-10-20" Author="Nic Morris" Comment="Attempt to solve customer issue by changing shutter control attribute ID to Dimmer for HTP behaviour." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="579e3a97-bddd-4406-9d6c-c9c26f7fa162" />
  <Control>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="12~193" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Trigger_Mode" Name="Trigger Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="12~127" />
      <Function ID="3" Name="Controller" Display="'Controller %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="0~91" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="92~98" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="99~189" />
      <Function ID="4" Name="Random Slow" Display="'Random Slow'" Dmx="190~231" />
      <Function ID="5" Name="Random Fast" Display="'Random Fast'" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Trigger_Decay" Name="Trigger Decay" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0 sec" Display="'0 sec'" Dmx="0~0" />
      <Function ID="2" Name="Time" Display="'%.fms',200~9900" Dmx="5~252" />
      <Function ID="3" Name="Random" Display="'Random %.1f%%',0.0~100.0" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~20" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="21~36" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="37~52" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="53~68" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="69~84" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="85~100" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="101~116" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="117~132" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="133~148" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="149~164" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="165~180" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="181~196" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Slow Random Action" Display="'Slow Random Action'" Dmx="51~101" />
      <Function ID="3" Name="Med Random Action" Display="'Med Random Action'" Dmx="102~152" />
      <Function ID="4" Name="Fast Random Action" Display="'Fast Random Action'" Dmx="153~203" />
      <Function ID="5" Name="Random Speed and Action" Display="'Random Speed and Action'" Dmx="204~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a4d7797f-eb6a-442c-b2bc-06f0abe9ec49" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Trigger_Mode" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Rotation" ChannelOffset="3" Wheel="15" />
      <Attribute ID="Trigger_Decay" ChannelOffset="4" Wheel="26" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
    </Include>
  </Mode>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b9bbc73d-42f8-4b9f-9ada-99eae8974283" />
    <Include>
      <Attribute ID="Show" ChannelOffset="1" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Blackout" Number="11" Page="1" SetControl="Gobo1:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8" />
      <Palette ID="9" Name="Gobo 8" Number="19" Page="1" SetControl="Gobo1:9" />
      <Palette ID="10" Name="Gobo 9" Number="20" Page="1" SetControl="Gobo1:10" />
      <Palette ID="11" Name="Gobo 10" Number="0" Page="1" SetControl="Gobo1:11" />
      <Palette ID="12" Name="Gobo 11" Number="0" Page="1" SetControl="Gobo1:12" />
      <Palette ID="13" Name="Gobo 12" Number="0" Page="1" SetControl="Gobo1:13" />
      <Palette ID="14" Name="Random" Number="0" Page="1" SetControl="Gobo1:14" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Dimmer:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Dimmer:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Dimmer:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Dimmer:1" />
    </Group>

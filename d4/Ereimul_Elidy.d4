<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Elidy" ShortName="Elidy" Company="Ereimul">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="12-07-13" Author="Peter Budd" Comment="Created" />
  <History Date="21-03-16" Author="Nic Morris" Comment="Created from Chromlech Elidy (poor documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~66" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="67~69" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="70~131" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="132~193" Intensity="0~0" />
      <Function ID="6" Name="Rnd Pulse" Display="'Rnd Pulse %.f%%',0~100" Dmx="194~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Round White" Display="'Round White %.f%%',0~100" Dmx="0~64" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Round Black" Display="'Round Black %.f%%',0~100" Dmx="65~128" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Square White" Display="'Square White %.f%%',0~100" Dmx="129~191" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Square Black" Display="'Square Black %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Mix A/B" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="A / B" Display="'A / B %.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="A + B" Display="'A + B'" Dmx="128~128" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="B / A" Display="'B / A %.1f%%',0.0~100.0" Dmx="129~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Mix Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Crossfade" Display="'Crossfade'" Dmx="0~7" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Manual fade" Display="'Manual fade'" Dmx="8~15" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="White fade" Display="'White fade'" Dmx="16~23" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Black fade" Display="'Black fade'" Dmx="24~31" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Mask" Display="'Mask'" Dmx="32~39" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="A Nor B" Display="'A Nor B'" Dmx="40~47" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="B Nor A" Display="'B Nor A'" Dmx="48~55" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="XOR" Display="'XOR'" Dmx="56~63" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Reserved" Display="'Reserved %.f',64~255" Dmx="64~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo12" Name="Bank A" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Factory" Display="'Factory %.f',1~64" Dmx="3~194" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="User" Display="'User %.f',1~20" Dmx="195~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="BankARot" Name="Bank A Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="2~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~252" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="253~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo14" Name="Bank B" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Factory" Display="'Factory %.f',1~64" Dmx="3~194" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="User" Display="'User %.f',1~20" Dmx="195~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="BankBRot" Name="Bank B Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="2~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~252" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="253~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Symmetry" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Symmetry" Display="'No Symmetry'" Dmx="0~31" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Horizontal " Display="'Horizontal'" Dmx="32~63" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Vertical" Display="'Vertical'" Dmx="64~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="H+V" Display="'H+V'" Dmx="96~127" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="90 No Symm" Display="'90 No Symm'" Dmx="128~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="90 Horizontal" Display="'90 Horizontal'" Dmx="160~191" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="90 Vertical" Display="'90 Vertical'" Dmx="192~223" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="90 H+V" Display="'90 H+V'" Dmx="224~255" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~7" />
      <Function ID="2" Name="Negative" Display="'Negative'" Dmx="8~14" />
      <Function ID="3" Name="Symmetry" Display="'Symmetry'" Dmx="15~23" />
      <Function ID="4" Name="Blur" Display="'Blur'" Dmx="24~31" />
      <Function ID="5" Name="Index A" Display="'Index A'" Dmx="32~39" />
      <Function ID="6" Name="Index B" Display="'Index B'" Dmx="40~47" />
      <Function ID="7" Name="Iris Rdn FX 1" Display="'Iris Rdn FX 1'" Dmx="48~55" />
      <Function ID="8" Name="Iris Rdn FX 2" Display="'Iris Rdn FX 2'" Dmx="56~63" />
      <Function ID="9" Name="Iris Rdn FX 3" Display="'Iris Rdn FX 3'" Dmx="64~71" />
      <Function ID="10" Name="Iris Rdn FX 4" Display="'Iris Rdn FX 4'" Dmx="72~79" />
      <Function ID="11" Name="Iris Sq FX 1" Display="'Iris Sq FX 1'" Dmx="80~87" />
      <Function ID="12" Name="Iris Sq FX 2" Display="'Iris Sq FX 2'" Dmx="88~95" />
      <Function ID="13" Name="Iris Sq FX 3" Display="'Iris Sq FX 3'" Dmx="96~103" />
      <Function ID="14" Name="Iris Sq FX 4" Display="'Iris Sq FX 4'" Dmx="104~111" />
      <Function ID="15" Name="Reserved" Display="'Reserved %.f',112~255" Dmx="112~255" />
    </Attribute>
    <Attribute ID="Effect1" Name="FX Value" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Generic" Name="Fade Out" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Normal" Display="'Normal %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Fade Out + Low Eff" Display="'Fade Out + Low Eff %.1f%%',0.0~100.0" Dmx="128~254" />
      <Function ID="3" Name="Low Voltage Eff" Display="'Low Voltage Eff'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot1" Name="Bank Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="2~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="64~64" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="65~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="127~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo13" Name="Bank" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Factory" Display="'Factory %.f',1~64" Dmx="3~194" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="User" Display="'User %.f',1~20" Dmx="195~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

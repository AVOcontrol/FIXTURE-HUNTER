  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="03e21ecb-daea-40aa-92b5-1feb0f1d1930" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~250" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="132~167" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="168~203" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="204~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="9" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~13" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="14~20" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~27" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="28~34" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="35~41" WheelPosition="5" Colour="255,150,150" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="42~48" WheelPosition="6" Colour="128,255,0" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="49~55" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Dark Blue" Display="'Dark Blue'" Dmx="56~62" WheelPosition="8" Colour="0,0,180" />
      <Function ID="10" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="66~79" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="80~93" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="94~107" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="108~120" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Org - Pk" Display="'Org - Pk %.f%%',0~100" Dmx="121~134" WheelPosition="4" Colour="255,128,0" />
      <Function ID="15" Name="Pk - L Grn" Display="'Pk - L Grn %.f%%',0~100" Dmx="135~148" WheelPosition="5" Colour="255,150,150" />
      <Function ID="16" Name="L Grn - L Blu" Display="'L Grn - L Blu %.f%%',0~100" Dmx="149~161" WheelPosition="6" Colour="128,255,0" />
      <Function ID="17" Name="L Blu - D Blu" Display="'L Blu - D Blu %.f%%',0~100" Dmx="162~175" WheelPosition="7" Colour="0,128,255" />
      <Function ID="18" Name="D Blu - Op" Display="'D Blu - Op %.f%%',0~100" Dmx="176~189" WheelPosition="8" Colour="0,0,180" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~221" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>5a056f63-48b2-4e1e-984b-106f77e6c528</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1">
        <Swatch>7f194d6b-d22d-4306-991e-0b9abd8f56b3</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2">
        <Swatch>92d4eef5-53ba-4852-9531-10d46e0fe782</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3">
        <Swatch>58cf2fad-6d5b-40ce-8019-7d93ba93cfbd</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4">
        <Swatch>0915e30f-0fdb-405d-88de-c343525498b1</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5">
        <Swatch>c1e1a387-433b-4ca2-8750-17a72110bc61</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6">
        <Swatch>05fff48d-b5f5-4722-817a-96d76f97a5a1</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7">
        <Swatch>187ce145-67d7-4f76-8c70-e79840c5aec2</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>5a056f63-48b2-4e1e-984b-106f77e6c528</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="1">
        <Swatch>7f194d6b-d22d-4306-991e-0b9abd8f56b3</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="2">
        <Swatch>92d4eef5-53ba-4852-9531-10d46e0fe782</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="3">
        <Swatch>58cf2fad-6d5b-40ce-8019-7d93ba93cfbd</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4">
        <Swatch>0915e30f-0fdb-405d-88de-c343525498b1</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="5">
        <Swatch>c1e1a387-433b-4ca2-8750-17a72110bc61</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="6">
        <Swatch>05fff48d-b5f5-4722-817a-96d76f97a5a1</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="7">
        <Swatch>187ce145-67d7-4f76-8c70-e79840c5aec2</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="189~128" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6,7" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~63" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="145~64" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="146~149" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="150~231" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="7" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="232~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Prism" Display="'No Prism'" Dmx="0~0" Update="Prism" />
      <Function ID="2" Name="6-Facet Circular" Display="'6-Facet Circular'" Dmx="0~0" Update="Prism" />
      <Function ID="3" Name="5-Facet Linear" Display="'5-Facet Linear'" Dmx="0~0" Update="Prism" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Prism" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Prism" ID="1" If="'Prism_Func'==1" />
      <Condition Name="6-Facet Circular" ID="2,3,4,5" If="'Prism_Func'==2" />
      <Condition Name="5-Facet Linear" ID="6,7,8,9" If="'Prism_Func'==3" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Prism" Display="'Prism'" Dmx="4~6" WheelPosition="1" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="65~7" WheelPosition="2" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="66~123" WheelPosition="3" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Prism" Display="'Prism'" Dmx="132~134" WheelPosition="1" />
      <Function ID="8" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="193~135" WheelPosition="2" />
      <Function ID="9" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~251" WheelPosition="3" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="8~15" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="16~23" />
      <Function ID="4" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="24~31" />
      <Function ID="5" Name="P/T/C in Dark" Display="'P/T/C in Dark'" Dmx="32~39" />
      <Function ID="6" Name="P/T/G in Dark" Display="'P/T/G in Dark'" Dmx="40~47" />
      <Function ID="7" Name="All in Dark" Display="'All in Dark'" Dmx="48~55" />
      <Function ID="8" Name="All in Dark Off" Display="'All in Dark Off'" Dmx="56~95" />
      <Function ID="9" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="10" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="11" Name="Reset Colour" Display="'Reset Colour'" Dmx="112~119" />
      <Function ID="12" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="13" Name="Reset Prism" Display="'Reset Prism'" Dmx="136~143" />

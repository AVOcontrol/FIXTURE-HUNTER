<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Multi Acis III MKII" ShortName="MltAcis3 2" Company="BeamZ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="19-06-17" Author="Nic Morris" Comment="" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="LED_Colour" Name="LED Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="R+G" Display="'R+G'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="R+B" Display="'R+B'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="R+A" Display="'R+A'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="G+B" Display="'G+B'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="G+W" Display="'G+W'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="G+A" Display="'G+A'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="B+W" Display="'B+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="B+A" Display="'B+A'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="R+B+A" Display="'R+B+A'" Dmx="151~160" Colour="255,255,255" />
      <Function ID="17" Name="R+G+A" Display="'R+G+A'" Dmx="161~170" Colour="255,255,255" />
      <Function ID="18" Name="B+W+A" Display="'B+W+A'" Dmx="171~180" Colour="255,255,255" />
      <Function ID="19" Name="G+W+A" Display="'G+W+A'" Dmx="181~190" Colour="255,255,255" />
      <Function ID="20" Name="R+W+A" Display="'R+W+A'" Dmx="191~200" Colour="255,255,255" />
      <Function ID="21" Name="G+B+W+A" Display="'G+B+W+A'" Dmx="201~210" Colour="255,255,255" />
      <Function ID="22" Name="R+B+W+A" Display="'R+B+W+A'" Dmx="211~220" Colour="255,255,255" />
      <Function ID="23" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="221~230" Colour="255,255,255" />
      <Function ID="24" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="231~240" Colour="255,255,255" />
      <Function ID="25" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="241~250" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Rot" Name="LED Rot" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~11" Colour="0,0,0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~138" Colour="0,0,0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="139~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~100" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="101~200" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~11" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~138" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="139~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="LED 1" Display="'LED 1'" Dmx="11~20" />
      <Function ID="3" Name="LED 2" Display="'LED 2'" Dmx="21~30" />
      <Function ID="4" Name="LED 3" Display="'LED 3'" Dmx="31~40" />
      <Function ID="5" Name="LED 4" Display="'LED 4'" Dmx="41~50" />
      <Function ID="6" Name="LED 5" Display="'LED 5'" Dmx="51~60" />
      <Function ID="7" Name="LED 6" Display="'LED 6'" Dmx="61~70" />
      <Function ID="8" Name="LED 7" Display="'LED 7'" Dmx="71~80" />
      <Function ID="9" Name="LED 8" Display="'LED 8'" Dmx="81~90" />
      <Function ID="10" Name="LED 1+5" Display="'LED 1+5'" Dmx="91~100" />
      <Function ID="11" Name="LED 2+6" Display="'LED 2+6'" Dmx="101~110" />
      <Function ID="12" Name="LED 3+7" Display="'LED 3+7'" Dmx="111~120" />
      <Function ID="13" Name="LED 4+8" Display="'LED 4+8'" Dmx="121~130" />
      <Function ID="14" Name="LED 1+2" Display="'LED 1+2'" Dmx="131~140" />
      <Function ID="15" Name="LED 3+4" Display="'LED 3+4'" Dmx="141~150" />
      <Function ID="16" Name="LED 5+6" Display="'LED 5+6'" Dmx="151~160" />
      <Function ID="17" Name="LED 7+8" Display="'LED 7+8'" Dmx="161~170" />
      <Function ID="18" Name="LED 1+8" Display="'LED 1+8'" Dmx="171~180" />
      <Function ID="19" Name="LED 4+5" Display="'LED 4+5'" Dmx="181~190" />
      <Function ID="20" Name="LED 1+3+5+7" Display="'LED 1+3+5+7'" Dmx="191~200" />
      <Function ID="21" Name="LED 2+4+6+8" Display="'LED 2+4+6+8'" Dmx="201~210" />
      <Function ID="22" Name="LED 3+4+5+6" Display="'LED 3+4+5+6'" Dmx="211~220" />
      <Function ID="23" Name="LED 1+2+7+8" Display="'LED 1+2+7+8'" Dmx="221~230" />
      <Function ID="24" Name="LED 1+2+3+4" Display="'LED 1+2+3+4'" Dmx="231~240" />
      <Function ID="25" Name="LED 5+6+7+8" Display="'LED 5+6+7+8'" Dmx="241~250" />
      <Function ID="26" Name="All LED" Display="'All LED'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="11~200" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~11" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~138" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="139~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKBZMA34" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="LED_Colour" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Laser_Colour" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Rotate" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Strobe" ChannelOffset="4" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKBZMA38" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="LED_Colour" ChannelOffset="1" Wheel="7" />
      <Attribute ID="LED_Rot" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Laser_Colour" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Laser_Rot" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Strobe" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Auto" ChannelOffset="7" Wheel="52" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="53" />
    </Include>
  </Mode>
</Fixture>
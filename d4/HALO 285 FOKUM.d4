<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HALO 285" ShortName="Halo 285" Company="FOKUM">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="26-01-16" Author="KINSON" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~2" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="3~128" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="129~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:75" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Pan Reset" Display="'Pan Reset'" Dmx="50~69" />
      <Function ID="3" Name="Tilt Reset" Display="'Tilt Reset'" Dmx="70~89" />
      <Function ID="4" Name="Zoom Reset" Display="'Zoom Reset'" Dmx="90~109" />
      <Function ID="5" Name="Safe" Display="'Safe'" Dmx="110~200" />
      <Function ID="6" Name="System Reset" Display="'System Reset'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Auto" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Else ID="2" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="31~40" Colour="255,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="41~50" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="51~60" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="61~70" Colour="0,255,255" />
      <Function ID="9" Name="White RGB" Display="'White RGB'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="10" Name="4 color jump" Display="'4 color jump %.f%%',0~100" Dmx="81~123" Colour="0,0,0" />
      <Function ID="11" Name="4 color fade" Display="'4 color fade %.f%%',0~100" Dmx="124~166" Colour="0,0,0" />
      <Function ID="12" Name="16 color jump" Display="'16 color jump %.f%%',0~100" Dmx="167~209" Colour="0,0,0" />
      <Function ID="13" Name="15 color pulse" Display="'15 color pulse %.f%%',0~100" Dmx="210~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="RGB_mix" Name="RGB mix" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGB mix" Display="'RGB mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Back Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~2" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="3~128" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="129~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Back Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Back Col Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Back Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,3,4,5,6,7,8,9" If="'Colour2Func'==1" />
      <Condition Name="Auto" ID="10,11,12,13" If="'Colour2Func'==2" />
      <Else ID="2" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="31~40" Colour="255,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="41~50" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="51~60" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="61~70" Colour="0,255,255" />
      <Function ID="9" Name="White RGB" Display="'White RGB'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="10" Name="4 color jump" Display="'4 color jump %.f%%',0~100" Dmx="81~123" Colour="0,0,0" />
      <Function ID="11" Name="4 color fade" Display="'4 color fade %.f%%',0~100" Dmx="124~166" Colour="0,0,0" />
      <Function ID="12" Name="16 color jump" Display="'16 color jump %.f%%',0~100" Dmx="167~209" Colour="0,0,0" />
      <Function ID="13" Name="15 color pulse" Display="'15 color pulse %.f%%',0~100" Dmx="210~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red1" Name="Back Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Back Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Back Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Time1" Name="Dark time" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Time2" Name="Dark to bright" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Time3" Name="Bright to Dark" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Time4" Name="Bright time" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="PT Speed" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
  </Control>

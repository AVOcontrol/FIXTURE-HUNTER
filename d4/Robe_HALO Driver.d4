    <Attribute ID="Rotate" Name="Rotate" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="1~127" />

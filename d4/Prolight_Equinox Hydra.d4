  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Pattern" />
      <Function ID="2" Name="SD Card" Display="'SD Card'" Dmx="74~110" Update="Pattern" />
      <Function ID="3" Name="Animation" Display="'Animation'" Dmx="111~147" Update="Pattern" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="148~184" Update="Pattern" />
      <Function ID="5" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="185~221" Update="Pattern" />
      <Function ID="6" Name="Manual Pattern" Display="'Manual Pattern'" Dmx="222~255" Update="Pattern" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Animation" ID="2" If="'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Pos" Name="X-Pos" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto R-L" Display="'Auto R-L %.f%%',0~100" Dmx="126~155" />
      <Function ID="3" Name="Auto L-R" Display="'Auto L-R %.f%%',0~100" Dmx="156~185" />
      <Function ID="4" Name="Auto R-L" Display="'Auto R-L %.f%%',0~100" Dmx="186~225" />
      <Function ID="5" Name="Auto Jump" Display="'Auto Jump'" Dmx="226~245" />
      <Function ID="6" Name="Sound Jump" Display="'Sound Jump'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Pos" Name="Y-Pos" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto U-D" Display="'Auto U-D %.f%%',0~100" Dmx="126~155" />
      <Function ID="3" Name="Auto D-U" Display="'Auto D-U %.f%%',0~100" Dmx="156~185" />
      <Function ID="4" Name="Auto U-D" Display="'Auto U-D %.f%%',0~100" Dmx="186~225" />
      <Function ID="5" Name="Auto Jump" Display="'Auto Jump'" Dmx="226~245" />
      <Function ID="6" Name="Sound Jump" Display="'Sound Jump'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~100" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="101~150" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~180" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="218~255" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="181~217" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="0~70" />
      <Function ID="2" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="71~104" />
      <Function ID="3" Name="Auto CCW" Display="'Auto CCW %.f%%',0~100" Dmx="105~144" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="145~184" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="185~224" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="3" Name="Size" Display="'Size %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Violet" Display="'Violet'" Dmx="19~37" Colour="180,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="38~56" Colour="0,255,0" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="57~75" Colour="255,0,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="76~94" Colour="0,255,255" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="95~113" Colour="128,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="114~132" Colour="255,255,0" />
      <Function ID="8" Name="4 Col Static" Display="'4 Col Static'" Dmx="133~151" Colour="255,255,255" />
      <Function ID="9" Name="4 Col Static 2" Display="'4 Col Static 2'" Dmx="152~170" Colour="255,255,255" />
      <Function ID="10" Name="5 Col Static" Display="'5 Col Static'" Dmx="171~189" Colour="255,255,255" />
      <Function ID="11" Name="Flow 1" Display="'Flow 1'" Dmx="190~208" Colour="255,255,255" />
      <Function ID="12" Name="Flow 2" Display="'Flow 2'" Dmx="209~227" Colour="255,255,255" />
      <Function ID="13" Name="Flow 3" Display="'Flow 3'" Dmx="228~246" Colour="255,255,255" />
      <Function ID="14" Name="7 Col Static" Display="'7 Col Static'" Dmx="247~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Scan_Speed" Name="Scan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="PTEQHYDR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="X-Pos" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Y-Pos" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="X-Rot" ChannelOffset="7" Wheel="49" />
      <Attribute ID="Y-Rot" ChannelOffset="8" Wheel="50" />
      <Attribute ID="Rotate" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Drawing" ChannelOffset="10" Wheel="5" />
      <Attribute ID="Wave" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Colour1" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Scan_Speed" ChannelOffset="13" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Evolution Series ES-400RGY" ShortName="ES-400RGY" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="16-06-09" Author="David Hunt" Comment="Created" />
  <History Date="24-03-11" Author="Nic Morris" Comment="Fixed power on and locate.  Standardised func names.  Increased wheel resolution." />
  <History Date="24-03-11" Author="Nic Morris" Comment="Adapted from CS-400RGY" />
  <History Date="29-08-12" Author="Peter Budd" Comment="Created from CS-800RGB" />
  <History Date="15-07-13" Author="Peter Budd" Comment="Created from the Laserworld ES-400RGY." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~69" />
      <Function ID="2" Name="Sound Mode" Display="'Sound Mode'" Dmx="70~139" />
      <Function ID="3" Name="Animated Sound Mode" Display="'Animated Sound Mode'" Dmx="140~209" />
      <Function ID="4" Name="DMX Mode" Display="'DMX Mode'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y" Display="'Y %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X" Display="'X %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Increasing" Display="'Increasing    %.1f%%',0.0~100.0" Dmx="11~92" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Growing" Display="'Growing %.f%%',0~100" Dmx="93~146" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Shrinking" Display="'Shrinking %.f%%',0~100" Dmx="147~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Grow/Shrink" Display="'Grow/Shrink   %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="RotateY" Name="Rotate Y" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~150" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="151~255" />
    </Attribute>
    <Attribute ID="RotateX" Name="Rotate X" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~150" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="151~255" />
    </Attribute>
    <Attribute ID="RotateZ" Name="Rotate Z" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~180" />
      <Function ID="2" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="181~217" />
      <Function ID="3" Name="Auto CCW" Display="'Auto CCW %.f%%',0~100" Dmx="218~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~199" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="LZ_ES400RGY" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="4" Wheel="55" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="29" />
      <Attribute ID="RotateX" ChannelOffset="10" Wheel="25" />
      <Attribute ID="RotateY" ChannelOffset="11" Wheel="26" />
      <Attribute ID="RotateZ" ChannelOffset="12" Wheel="27" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
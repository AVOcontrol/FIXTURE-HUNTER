  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9d7229ea-a862-4846-ba36-54e20f06bcd6" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="31~60" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="61~155" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="167~224" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="2~19" />
      <Function ID="3" Name="Col Cut" Display="'Col Cut %.f%%',0~100" Dmx="20~39" />
      <Function ID="4" Name="Col Free" Display="'Col Free %.f%%',0~100" Dmx="49~59" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~79" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~99" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="100~119" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="120~139" />
      <Function ID="9" Name="Red Fade" Display="'Red Fade'" Dmx="140~159" />
      <Function ID="10" Name="Green Fade" Display="'Green Fade'" Dmx="160~179" />
      <Function ID="11" Name="Blue Fade" Display="'Blue Fade'" Dmx="180~199" />
      <Function ID="12" Name="Lt Yel Fade" Display="'Lt Yel Fade'" Dmx="200~219" />
      <Function ID="13" Name="Cyan Fade" Display="'Cyan Fade'" Dmx="220~229" />
      <Function ID="14" Name="White Fade" Display="'White Fade'" Dmx="230~249" />
      <Function ID="15" Name="Full On" Display="'Full On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="ModeP" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~152" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="153~196" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="197~242" />
      <Function ID="5" Name="RGB Dimmer" Display="'RGB Dimmer'" Dmx="243~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="ModeA, 4 DMX" Channels="4">
    <Import PearlRef="UKLHL18A" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="948a1e1c-4087-47c7-b505-d8bec522f26b" />
    <Include>

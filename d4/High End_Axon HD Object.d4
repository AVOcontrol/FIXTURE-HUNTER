      <Function ID="31" Name="Sync L10 Time + Rot" Display="'Sync L10 Time + Rot'" Dmx="30~30" />
      <Function ID="32" Name="Reserved" Display="'Reserved %.f',31~255" Dmx="31~255" />
    </Attribute>
    <Attribute ID="Black_Level" Name="Black Level" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Black -" Display="'Black - %.1f%%',100.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="Black +" Display="'Black + %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Contrast -" Display="'Contrast - %.1f%%',100.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Normal" Display="'Normal'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="Contrast +" Display="'Contrast + %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Axon HD Object" ShortName="Axon HD Ob" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="3D_Obj_File" Name="3D Obj File" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Safe" Display="'None'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Flat Plane" Display="'Flat Plane'" Dmx="1~1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Stock 3D Obj" Display="'Stock 3D Obj   %.f',2~149" Dmx="2~149" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="User 3D Obj" Display="'User 3D Obj    %.f',150~255" Dmx="150~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Media_Folder" Name="Media Folder" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'None'" Dmx="0~0" Update="Media_File" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="HES Folder" Display="'HES %.f',1~55" Dmx="1~55" Update="Media_File" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="User Folder" Display="'User %.f',1~183" Dmx="56~239" Update="Media_File" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Reserved" Display="'Reserved %.f',240~254" Dmx="240~254" Update="Media_File" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Video Capture" Display="'Video Capture'" Dmx="255~255" Update="Media_File" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Media_File" Name="Media File" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Video Capture" ID="3,4,5,6,7,8,9,10,11" If="'Media_Folder'==5" />
      <Else ID="1,2" />
      <Function ID="1" Name="Safe" Display="'None'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="File" Display="'File %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Device" Display="'No Device'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="SVideo" Display="'SVideo'" Dmx="1~1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="SD SDI" Display="'SD SDI'" Dmx="2~2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="SVideo 2" Display="'SVideo 2'" Dmx="3~3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="SD SDI 2" Display="'SD SDI 2'" Dmx="4~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="HD SDI 1" Display="'HD SDI 1'" Dmx="5~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="HD SDI 2" Display="'HD SDI 2'" Dmx="6~6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="HD SDI 3" Display="'HD SDI 3'" Dmx="7~7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="HD SDI 4" Display="'HD SDI 4'" Dmx="8~8" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="In_Frame" Name="In Frame" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="In" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Out_Frame" Name="Out Frame" Description="" Group="G" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Out" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Play_Mode" Name="Play Mode" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Play Loop" Display="'Play Loop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Play Once" Display="'Play Once'" Dmx="1~1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pause" Display="'Pause'" Dmx="2~2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Play Once if Int &gt;0" Display="'Play Once if Int &gt;0'" Dmx="3~3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Play Loop if Int &gt;0" Display="'Play Loop if Int &gt;0'" Dmx="4~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Pause &amp; Rwd" Display="'Pause &amp; Rwd'" Dmx="5~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Scrub sel In F" Display="'Display In    Frame'" Dmx="6~6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scrub sel Out F" Display="'Display Out   Frame'" Dmx="7~7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Sc In F w/Stats" Display="'Sc In F w/Stats'" Dmx="8~8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Sc O F w/Stats" Display="'Sc O F w/Stats'" Dmx="9~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Play Loop w/Audio" Display="'Play Loop w/Audio'" Dmx="10~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Play Once w/Audio" Display="'Play Once w/Audio'" Dmx="11~11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Play Once if Int &gt;0 w/Audio" Display="'Play Once if Int &gt;0 w/Audio'" Dmx="12~12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Play Loop if Int &gt;0 w/Audio" Display="'Play Loop if Int &gt;0 w/Audio'" Dmx="13~13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Reserved" Display="'Reserved %.f',14~255" Dmx="14~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Play_Speed" Name="Play Speed" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed - %.1f%%',100.0~0.0" Dmx="1~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Normal" Display="'Normal'" Dmx="128~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed + %.1f%%',0.0~100.0" Dmx="129~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Sync_Mode" Name="Sync Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Sync Layer 1 Time" Display="'Sync Layer 1 Time'" Dmx="1~1" />
      <Function ID="3" Name="Sync Layer 2 Time" Display="'Sync Layer 2 Time'" Dmx="2~2" />
      <Function ID="4" Name="Sync Layer 3 Time" Display="'Sync Layer 3 Time'" Dmx="3~3" />

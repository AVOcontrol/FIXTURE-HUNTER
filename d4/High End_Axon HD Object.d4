      <Function ID="20" Name="Sync Layer 9 Rot" Display="'Sync Layer 9 Rot'" Dmx="19~19" />
      <Function ID="21" Name="Sync Layer 10 Rot" Display="'Sync Layer 10 Rot'" Dmx="20~20" />
      <Function ID="22" Name="Sync L1 Time + Rot" Display="'Sync L1 Time + Rot'" Dmx="21~21" />
      <Function ID="23" Name="Sync L2 Time + Rot" Display="'Sync L2 Time + Rot'" Dmx="22~22" />
      <Function ID="24" Name="Sync L3 Time + Rot" Display="'Sync L3 Time + Rot'" Dmx="23~23" />
      <Function ID="25" Name="Sync L4 Time + Rot" Display="'Sync L4 Time + Rot'" Dmx="24~24" />
      <Function ID="26" Name="Sync L5 Time + Rot" Display="'Sync L5 Time + Rot'" Dmx="25~25" />

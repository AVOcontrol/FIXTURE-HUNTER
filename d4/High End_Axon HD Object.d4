      <Function ID="9" Name="Sync Layer 8 Time" Display="'Sync Layer 8 Time'" Dmx="8~8" />
      <Function ID="10" Name="Sync Layer 9 Time" Display="'Sync Layer 9 Time'" Dmx="9~9" />
      <Function ID="11" Name="Sync Layer 10 Time" Display="'Sync Layer 10 Time'" Dmx="10~10" />
      <Function ID="12" Name="Sync Layer 1 Rot" Display="'Sync Layer 1 Rot'" Dmx="11~11" />
      <Function ID="13" Name="Sync Layer 2 Rot" Display="'Sync Layer 2 Rot'" Dmx="12~12" />
      <Function ID="14" Name="Sync Layer 3 Rot" Display="'Sync Layer 3 Rot'" Dmx="13~13" />

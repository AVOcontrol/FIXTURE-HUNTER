      <Function ID="5" Name="3200-3500K" Display="'3200-3500K %.fK',3200~3500" Dmx="45~57" Colour="255,240,200" />
      <Function ID="6" Name="3500-3700K" Display="'3500-3700K %.fK',3500~3700" Dmx="58~70" Colour="255,240,200" />
      <Function ID="7" Name="3700-4000K" Display="'3700-4000K %.fK',3700~4000" Dmx="71~83" Colour="255,240,200" />

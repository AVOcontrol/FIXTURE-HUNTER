      <Function ID="18" Name="9000-9500K" Display="'9000-9500K %.fK',9000~9500" Dmx="214~226" Colour="255,240,200" />
      <Function ID="19" Name="9500-1000K" Display="'9500-1000K %.fK',9500~10000" Dmx="227~254" Colour="255,240,200" />
      <Function ID="20" Name="1000K" Display="'1000K'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~249" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="100~149" />
      <Function ID="5" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="150~199" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

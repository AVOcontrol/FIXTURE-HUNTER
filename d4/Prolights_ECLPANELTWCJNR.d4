  <History Date="26-05-20" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWC" Version="5" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Changed CTC to a single variable range and added an 'Open' range to the 10 and 15 channel 'Theatre' modes in response to manufacturer request." Version="6" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="31-12-21" Author="Nic Morris" Comment="Added Film modes in line with latest charts in response to manufacturer request.  Added 21 channel theatre mode.  Added product thumbnail." Version="7" />

      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="55~59" WheelPosition="11" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="60~64" WheelPosition="12" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="65~69" WheelPosition="13" Colour="0,0,0" />
      <Function ID="15" Name="Op/ 1" Display="'Op/ 1'" Dmx="70~74" WheelPosition="0" Colour="0,0,0" />
      <Function ID="16" Name="1/ 2" Display="'1/ 2'" Dmx="75~79" WheelPosition="1" Colour="0,0,0" />
      <Function ID="17" Name="2/ 3" Display="'2/ 3'" Dmx="80~84" WheelPosition="2" Colour="0,0,0" />

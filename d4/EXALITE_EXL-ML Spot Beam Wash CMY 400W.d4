<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EXL-ML Spot Beam Wash CMY 400W" ShortName="SBWCMY400W" Company="EXALITE" Version="9">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>69323d93-ae1e-4433-8168-fe713bc77bff</Thumbnail>
  <History Date="02-08-22" Author="Nic Morris" Comment="Created (poor documentation.  contains errors.  note additional information has 9 colours + open but charts are 8 + open)." Version="0" />
  <History Date="09-08-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="29-10-22" Author="Nic Morris" Comment="Created from Briwax BK-480W (poor documentation - channels 12/11 are missing - assumed identical)" Version="3" />
  <History Date="24-12-23" Author="Nic Morris" Comment="Created from Gamma Led Vision TX-6 Z (poor documentation.  Random strobe range is duplicated - assumed first is close pulse)" Version="5" />
  <History Date="24-12-23" Author="Nic Morris" Comment="(Channel 21 in the 22 channel mode and 24/25 in the 26 channel mode don't make sense.  Assumed is focus 8bit/16bit)" Version="5" />
  <History Date="05-01-24" Author="Nic Morris" Comment="Created from MEANReal ALED BSW CMY 480 (confusing charts.  note gobo 2 has 7 fixed slots but 8 shake - this is surely wrong.  Similarly the number of gobo images don't correlate with the number of slots in the DMX)" Version="6" />
  <History Date="10-01-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="7" />
  <History Date="19-01-24" Author="Nic Morris" Comment="Created from Flash Butrym SpotLITE (poor documentation)" Version="8" />
  <History Date="23-01-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d4317bb9-4ce7-4d92-b177-03a52e9bdfe1" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

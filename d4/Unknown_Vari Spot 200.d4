  <History Date="09-05-19" Author="Nic Morris" Comment="Created (poor documentation)" Version="1" />
  <History Date="11-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Created from Unknown LED 250W Zoom Moving Head 3-in-1 (identical.  awful documentation)" Version="3" />
  <History Date="20-03-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="11-09-21" Author="Nic Morris" Comment="Created from SULUS Refugee 250 BSW (effectively identical)" Version="5" />
  <History Date="12-09-21" Author="Nic Morris" Comment="Removed index/spin options from Gobo 1 Func." Version="6" />
  <History Date="17-08-23" Author="Nic Morris" Comment="Created from Gamma Led Vision TX5 Hybrid" Version="7" />
  <History Date="19-08-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a7e7ac46-6db9-42c6-9b84-45b172aa30bf" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="48~63" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="64~79" WheelPosition="4" Colour="50,0,200" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~95" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="96~111" WheelPosition="6" Colour="255,150,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="112~127" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Effect" Name="Colour Effect" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Fine" Display="'Colour Fine %.1f%%',0.0~100.0" Dmx="11~209" Colour="255,255,255" />
      <Function ID="3" Name="Colour Shake" Display="'Colour Shake %.f%%',0~100" Dmx="255~210" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>a4396f69-01f4-472c-bd40-7c7620318dcc</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="7~13" WheelPosition="1">
        <Swatch>6406f356-2a2e-4de2-af44-788306202edb</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="14~20" WheelPosition="2">
        <Swatch>b5b027ef-d50e-4786-bb90-8b1c053483ad</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="21~27" WheelPosition="3">
        <Swatch>5341a7e9-20f3-4526-af8c-e8c7314bcb79</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="28~34" WheelPosition="4">
        <Swatch>4ba0f12e-cd54-407f-aa9e-21b3ae98206e</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="35~41" WheelPosition="5">
        <Swatch>68999d17-43c4-4d59-9dbc-45bb9243c8e3</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="42~48" WheelPosition="6">
        <Swatch>13af7f6a-0a3d-427d-968d-b7ffe314d1d0</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="49~55" WheelPosition="7">
        <Swatch>d3d1dc24-cdad-4aeb-b0d2-41bdce5b3303</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="56~63" WheelPosition="8">
        <Swatch>a83bdd8b-3a29-4994-9fcf-2b8bc06d1b81</Swatch>
      </Function>
      <Function ID="10" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0">
        <Swatch>a4396f69-01f4-472c-bd40-7c7620318dcc</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="113~119" WheelPosition="1">
        <Swatch>6406f356-2a2e-4de2-af44-788306202edb</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="106~112" WheelPosition="2">
        <Swatch>b5b027ef-d50e-4786-bb90-8b1c053483ad</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="99~105" WheelPosition="3">
        <Swatch>5341a7e9-20f3-4526-af8c-e8c7314bcb79</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="92~98" WheelPosition="4">
        <Swatch>4ba0f12e-cd54-407f-aa9e-21b3ae98206e</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="85~91" WheelPosition="5">
        <Swatch>68999d17-43c4-4d59-9dbc-45bb9243c8e3</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="78~84" WheelPosition="6">
        <Swatch>13af7f6a-0a3d-427d-968d-b7ffe314d1d0</Swatch>
      </Function>
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="71~77" WheelPosition="7">
        <Swatch>d3d1dc24-cdad-4aeb-b0d2-41bdce5b3303</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="64~70" WheelPosition="8">
        <Swatch>a83bdd8b-3a29-4994-9fcf-2b8bc06d1b81</Swatch>
      </Function>
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>a4396f69-01f4-472c-bd40-7c7620318dcc</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~31" WheelPosition="1">
        <Swatch>a44f9de0-3624-4413-b46c-c1091f28c752</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="32~47" WheelPosition="2">
        <Swatch>8f2ceca3-1f4a-4790-b3b4-476ddbd867bc</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~63" WheelPosition="3">
        <Swatch>01200523-eadf-4994-bf35-b53809a988ea</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" WheelPosition="4">
        <Swatch>8cecd586-555c-4c6c-90ac-24390c1c0eed</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="80~95" WheelPosition="5">
        <Swatch>79dd4d47-8e7e-4439-b575-fe5a262be00f</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="96~111" WheelPosition="6">
        <Swatch>07df29f3-6e79-47ae-a292-60f709aecc27</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="112~127" WheelPosition="7">
        <Swatch>312fb64b-8f9b-460d-9261-1621fef6b595</Swatch>
      </Function>
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="6,7,8,9" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Fine 0-250°" Display="'Fine 0-250° %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Rot 0-90°" Display="'Rot 0-90° %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="Rot 0-250°" Display="'Rot 0-250° %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="Rot 0-360°" Display="'Rot 0-360° %.f%%',0~100" Dmx="156~175" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="7" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="215~176" />
      <Function ID="8" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="9" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="216~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index 0-250°" Display="'Index 0-250° %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Rot 0-90°" Display="'Rot 0-90° %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="Rot 0-250°" Display="'Rot 0-250° %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="Rot 0-360°" Display="'Rot 0-360° %.f%%',0~100" Dmx="156~175" />
      <Function ID="6" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="215~176" />
      <Function ID="7" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="5~127" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Effect" Display="'Effect'" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="8~131" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="132~249" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="250~253" />
    </Attribute>
  </Control>

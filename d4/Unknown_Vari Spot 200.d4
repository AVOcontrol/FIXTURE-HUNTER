      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour_Effect:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour_Effect:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour_Effect:1" />
      <Palette ID="9" Name="Cyan" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour_Effect:1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ES-800RGB" ShortName="ES-800RGB" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>6ce2ff8a-d7dd-4ffe-a8dd-8bca8a2164b2</Thumbnail>
  <History Date="16-06-09" Author="David Hunt" Comment="Created" />
  <History Date="24-03-11" Author="Nic Morris" Comment="Fixed power on and locate.  Standardised func names.  Increased wheel resolution." />
  <History Date="24-03-11" Author="Nic Morris" Comment="Adapted from CS-400RGY" />
  <History Date="29-08-12" Author="Peter Budd" Comment="Created from CS-800RGB" />
  <History Date="26-02-18" Author="Nic Morris" Comment="Changed colour to a single raw range in attempt to fix customer bug report (documentation is very poor)" />
  <History Date="26-02-18" Author="Nic Morris" Comment="Swapped pan/tilt and rotate X/rotate Y in line with latest charts.  Added macros." />
  <History Date="26-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound Mode" Display="'Sound Mode'" Dmx="70~139" />
      <Function ID="3" Name="Animated Sound Mode" Display="'Animated Sound Mode'" Dmx="140~209" />
      <Function ID="4" Name="DMX Mode" Display="'DMX Mode'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="1~167" />
      <Function ID="3" Name="Animated L-R" Display="'Animated L-R %.f%%',0~100" Dmx="168~188" />
      <Function ID="4" Name="Animated R-L" Display="'Animated R-L %.f%%',0~100" Dmx="189~209" />
      <Function ID="5" Name="Animated L-R-L" Display="'Animated L-R-L %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="1~167" />
      <Function ID="3" Name="Animated L-R" Display="'Animated L-R %.f%%',0~100" Dmx="168~188" />
      <Function ID="4" Name="Animated R-L" Display="'Animated R-L %.f%%',0~100" Dmx="189~209" />
      <Function ID="5" Name="Animated L-R-L" Display="'Animated L-R-L %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Increasing" Display="'Increasing    %.1f%%',0.0~100.0" Dmx="11~92" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Growing" Display="'Growing %.f%%',0~100" Dmx="93~146" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Shrinking" Display="'Shrinking %.f%%',0~100" Dmx="147~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Grow/Shrink" Display="'Grow/Shrink   %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="RotateY" Name="Rotate Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~150" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="151~255" />
    </Attribute>
    <Attribute ID="RotateX" Name="Rotate X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~150" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="151~255" />
    </Attribute>
    <Attribute ID="RotateZ" Name="Rotate Z" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="0~180" />
      <Function ID="2" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="181~217" />
      <Function ID="3" Name="Auto CCW" Display="'Auto CCW %.f%%',0~100" Dmx="218~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Pointspeed" Name="Pointspeed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="LZ_ES800RGB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="2" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="49" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pointspeed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="29" />
      <Attribute ID="RotateY" ChannelOffset="11" Wheel="20" />
      <Attribute ID="RotateX" ChannelOffset="10" Wheel="19" />
      <Attribute ID="RotateZ" ChannelOffset="12" Wheel="21" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <swatchLibrary>
    <Swatch id="6ce2ff8a-d7dd-4ffe-a8dd-8bca8a2164b2"></Swatch>
  </swatchLibrary>
</Fixture>
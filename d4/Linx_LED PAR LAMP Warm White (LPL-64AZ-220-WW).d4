    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="50%" Display="'50%'" Dmx="1~127" />
      <Function ID="3" Name="30%" Display="'30%'" Dmx="128~255" />

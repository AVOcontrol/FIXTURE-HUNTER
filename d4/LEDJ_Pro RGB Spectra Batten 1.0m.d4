<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pro RGB Spectra Batten 1.0m" ShortName="Pro Sp Bat" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="17-11-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="17-11-08" Author="David Hunt" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="09-05-11" Author="John Rogers" Comment="Edited manufacturer name." />
  <History Date="20-09-11" Author="Nic Morris" Comment="Removed conditionals to avoid problems in sub fixtures.  Added RGB1 and replaced first cell." />
  <History Date="20-09-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-01-17" Author="Nic Morris" Comment="Reinstated conditionals.  Renamed control to Colour Macro and moved from pan to colour wheel slot." />
  <History Date="06-01-17" Author="Nic Morris" Comment="Renamed from Spectra Batten to Pro RGB Spectra Batten 1.0m (Spectra Batten is a different fixture)." />
  <History Date="06-01-17" Author="Nic Morris" Comment="Revised Atlabase model ID (was wrong fixture) and added mode ID." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c6edf002-0470-4a78-8e10-5698b64dd402" />
  <Control>
    <Attribute ID="Control" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="2" Name="Multi-Cell" Display="'Multi-Cell'" Dmx="1~15" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="3" Name="Single-Cell" Display="'Single-Cell'" Dmx="16~31" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="32~47" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="48~63" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="64~79" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="80~95" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="96~111" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="112~127" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="128~143" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="11" Name="Colour Chase" Display="'Colour Chase'" Dmx="144~159" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="12" Name="Colour Flow" Display="'Colour Flow'" Dmx="160~175" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="13" Name="Colour Fade" Display="'Colour Fade'" Dmx="176~191" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="14" Name="Multi Colour Flow" Display="'Multi Colour Flow'" Dmx="192~207" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="15" Name="Fade Flow" Display="'Fade Flow'" Dmx="208~223" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Two Colour Flow" Display="'Two Colour Flow'" Dmx="224~239" Update="Red, Green, Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Sound Activated" Display="'Sound Activated'" Dmx="240~255" Update="Red, Green, Dimmer" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Control'&gt;10&amp;&amp;'Control'&lt;17" />
      <Condition Name="Sensitivity" ID="3" If="'Control'==17" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col 1 Sel" ID="2" If="'Control'==15||'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col 2 Sel" ID="2" If="'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ac89e7c1-8725-445d-bd14-13febdb591bf" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Control" ChannelOffset="1" Wheel="7" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="RGB cell, 3 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="RGB cell, 3 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="RGB cell, 3 DMX" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="RGB cell, 3 DMX" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
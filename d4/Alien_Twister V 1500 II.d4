    <AtlaBase ModeID="5d5e8197-c4f4-4533-87f7-60346b860056" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour_Macro" Wheel="7" />
        <Attribute ID="Col_Mac_Spd" Wheel="8" />

      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

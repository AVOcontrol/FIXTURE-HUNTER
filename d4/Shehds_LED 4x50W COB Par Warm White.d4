    <AtlaBase ModeID="e046a8b0-4029-4a90-85bd-134e4a50ea7e" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="CW 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">

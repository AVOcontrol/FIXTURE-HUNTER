<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FresneLED 250 TW" ShortName="F 250 TW" Company="Spotlight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-07-17" Author="Nic Morris" Comment="Created" />
  <History Date="13-07-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="89ae2045-3cf5-4670-b0cb-a1d245eb3b32" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="2700K" Display="'2700K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700-3200K" Display="'%.fK',2700~3200" Dmx="11~60" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="4" Name="3200-4000K" Display="'%.fK',3200~4000" Dmx="71~120" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="6" Name="4000-5600K" Display="'%.fK',4000~5600" Dmx="131~180" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="181~190" Colour="255,255,255" />
      <Function ID="8" Name="5600-6500K" Display="'%.fK',5600~6500" Dmx="191~240" Colour="255,255,255" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="CCT 3CH, 4 DMX" Channels="4">
    <Import PearlRef="SPF250T4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="290ed599-355e-41c8-bd65-47f09393d832" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Zoom" ChannelOffset="4" Wheel="19" />
    </Include>
  </Mode>

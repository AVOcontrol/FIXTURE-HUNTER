      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="65~80" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="81~96" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />

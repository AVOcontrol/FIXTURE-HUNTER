      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="105~112" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Op / 1" Display="'Op / 1'" Dmx="17~24" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="1/ 2" Display="'1/ 2'" Dmx="33~40" WheelPosition="1" Colour="0,0,0" />
      <Function ID="10" Name="2/ 3" Display="'2/ 3'" Dmx="49~56" WheelPosition="2" Colour="0,0,0" />

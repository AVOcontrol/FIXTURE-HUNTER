  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9bde8fc0-26f0-4cf1-b7bc-c64eb36d08cb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="40~59" Update="Shutter" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="60~79" Update="Shutter" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="80~99" Update="Shutter" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="160~179" Update="Shutter" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="180~199" Update="Shutter" />
      <Function ID="7" Name="Sound 3" Display="'Sound 3'" Dmx="200~219" Update="Shutter" />
      <Function ID="8" Name="Sound 4" Display="'Sound 4'" Dmx="220~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;5" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX (Dimming)" Channels="1">

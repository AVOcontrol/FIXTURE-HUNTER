      <Function ID="2" Name="Prism 1 (Index)" Display="'Prism 1 (Index)'" Dmx="4~7" Update="Prism_Rot" />
      <Function ID="3" Name="Prism 2 (Index)" Display="'Prism 2 (Index)'" Dmx="8~11" Update="Prism_Rot" />
      <Function ID="4" Name="Prism 3 (Index)" Display="'Prism 3 (Index)'" Dmx="12~15" Update="Prism_Rot" />
      <Function ID="5" Name="Prism 1 (Spin)" Display="'Prism 1 (Spin)'" Dmx="16~19" Update="Prism_Rot" />
      <Function ID="6" Name="Prism 2 (Spin)" Display="'Prism 2 (Spin)'" Dmx="20~23" Update="Prism_Rot" />
      <Function ID="7" Name="Prism 3 (Spin)" Display="'Prism 3 (Spin)'" Dmx="24~27" Update="Prism_Rot" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Gobo_Prism'==1" />
      <Condition Name="Prism 1 (Index)" ID="2" If="'Prism'==2||'Prism'==3||'Prism'==4" />
      <Condition Name="Prism 1 (Spin)" ID="3,4,5,6" If="'Prism'==5||'Prism'==6||'Prism'==7" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Rot" Name="Pattern Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Prism" Name="Beam Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Beam_Prism_Rot" />
      <Function ID="2" Name="Prism 1 Index" Display="'Prism 1 Index'" Dmx="4~7" Update="Beam_Prism_Rot" />
      <Function ID="3" Name="Prism 2 Index" Display="'Prism 2 Index'" Dmx="8~11" Update="Beam_Prism_Rot" />
      <Function ID="4" Name="Prism 1 Spin" Display="'Prism 1 Spin'" Dmx="20~23" Update="Beam_Prism_Rot" />
      <Function ID="5" Name="Prism 2 Spin" Display="'Prism 2 Spin'" Dmx="24~27" Update="Beam_Prism_Rot" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Beam_Prism_Rot" />
    </Attribute>
    <Attribute ID="Beam_Prism_Rot" Name="Beam Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Beam_Prism'==1" />
      <Condition Name="Index" ID="2" If="'Beam_Prism'==2||'Beam_Prism'==3" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Beam_Prism'==4||'Beam_Prism'==5" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

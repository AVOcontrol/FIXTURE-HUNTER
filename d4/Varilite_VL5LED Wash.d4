  <History Date="29-03-20" Author="Nic Morris" Comment="Created (charts contain range conflicts)" Version="0" />
  <History Date="30-03-20" Author="Nic Morris" Comment="Changed Smart Colour Blade Group 1 and 16 cells to link to Blade RGB instead of RGB as we cannot have RGB and CMY at the same time at the moment." Version="1" />
  <History Date="01-04-20" Author="Nic Morris" Comment="Revised pixel layout." Version="2" />
  <History Date="01-06-22" Author="Nic Morris" Comment="Fixed Smart Colour (Blade Group 1 and 16) modes (blade RGB controls were incorrectly assigned to channels)" Version="3" />

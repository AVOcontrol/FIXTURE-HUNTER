<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Nonabeam Move" ShortName="NonaBmMove" Company="CKC Lighting" Version="13">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>b48ecb96-9bc4-4e9c-87b9-3894fdf78a53</Thumbnail>
  <History Date="28-03-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="29-03-18" Author="Nic Morris" Comment="Changed cells to hidden." Version="2" />
  <History Date="03-04-18" Author="Nic Morris" Comment="Split 16bit WW/CW Master into two separate 8bit masters (not sure why I did that)" Version="3" />
  <History Date="03-04-18" Author="Nic Morris" Comment="Revised Warm White and Cold White ID's to exclude them from the colour picker." Version="4" />
  <History Date="03-04-18" Author="Nic Morris" Comment="Added alternative options for 27 channel mode." Version="5" />
  <History Date="03-04-18" Author="Nic Morris" Comment="Option 2 has the background as a cell.  This provides a way to have a single dimmer in the master linked to everything but compromises pixel mapping." Version="6" />
  <History Date="03-04-18" Author="Nic Morris" Comment="The white part/background part version is similar but will work with pixel mapping with the compromise of multi-part patch" Version="7" />
  <History Date="27-09-18" Author="Nic Morris" Comment="Added '(V1.01F)' suffix to existing and added V1.03 modes.  Added Atlabase ID's.  Added product thumbnail." Version="8" />
  <History Date="27-09-18" Author="Nic Morris" Comment="Fixed 9 DMX mapping.  Fixed missing cell links." Version="9" />
  <History Date="17-10-18" Author="Nic Morris" Comment="Corrected 29 channel mode mapping, removed old modes and renamed remaining in response to manufacturer request." Version="10" />
  <History Date="08-06-20" Author="Nic Morris" Comment="Created from BriteQ BT-NONABEAM" Version="11" />
  <History Date="02-01-22" Author="Nic Morris" Comment="Created from BriteQ BT-NONAMOVE (identical)" Version="12" />
  <History Date="03-01-22" Author="Nic Morris" Comment="Changed WW and CW Master to default at zero in line with Capture implementation (assumes they are HTP masters)." Version="13" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9cc16676-21a7-4ed6-aa3b-c86bd06e6234" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="220~0" />
      <Function ID="2" Name="Safe" Display="'Safe'" Dmx="255~255" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="249~249" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="xWarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="xColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="RGB_Strobe" Name="RGB Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="68~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="8~67" />
    </Attribute>
    <Attribute ID="Red" Name="Glow Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Glow Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Glow Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="68~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="8~67" />
    </Attribute>
    <Attribute ID="WW_Master" Name="WW Master" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="WW/CW_Dimmer" Name="WW/CW Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CW_Master" Name="CW Master" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CW/WW_Strobe1" Name="CW/WW Strobe" Description="" Group="I">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="170~253" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="2~85" />
      <Function ID="5" Name="Rnd Pix" Display="'Rnd Pix %.f%%',0~100" Dmx="86~169" />
    </Attribute>
    <Attribute ID="Glow_RGB_FX" Name="Glow RGB FX" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="11~16" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="17~22" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="23~28" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="29~34" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="35~40" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="41~46" Colour="128,0,255" />
      <Function ID="9" Name="R/B Switch" Display="'R/B Switch %.f%%',0~100" Dmx="47~82" Colour="255,255,255" />
      <Function ID="10" Name="R/G Switch" Display="'R/G Switch %.f%%',0~100" Dmx="83~118" Colour="255,255,255" />
      <Function ID="11" Name="B/G Switch" Display="'B/G Switch %.f%%',0~100" Dmx="119~154" Colour="255,255,255" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="155~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd" Display="'Dim Spd %.f%%',0~100" Dmx="8~108" />
      <Function ID="3" Name="Pixel Order A" Display="'Pixel Order A'" Dmx="115~120" />
      <Function ID="4" Name="Pixel Order B" Display="'Pixel Order B'" Dmx="121~126" />
      <Function ID="5" Name="Pixel Order C" Display="'Pixel Order C'" Dmx="127~132" />
      <Function ID="6" Name="Pixel Order D" Display="'Pixel Order D'" Dmx="133~138" />
      <Function ID="7" Name="Fan Auto" Display="'Fan Auto'" Dmx="145~150" />
      <Function ID="8" Name="Fan Full" Display="'Fan Full'" Dmx="151~156" />
      <Function ID="9" Name="Dim Linear" Display="'Dim Linear'" Dmx="163~168" />
      <Function ID="10" Name="Dim Square" Display="'Dim Square'" Dmx="169~174" />
      <Function ID="11" Name="Dim Inv Sq" Display="'Dim Inv Sq'" Dmx="175~180" />
      <Function ID="12" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="181~186" />
      <Function ID="13" Name="Load Factory" Display="'Load Factory'" Dmx="193~198" />
    </Attribute>
    <Attribute ID="Beam_FX" Name="Beam FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Meteor 1" Display="'Meteor 1 %.f%%',0~100" Dmx="4~39" />
      <Function ID="3" Name="Meteor 2" Display="'Meteor 2 %.f%%',0~100" Dmx="40~75" />
      <Function ID="4" Name="Flow 1" Display="'Flow 1 %.f%%',0~100" Dmx="76~111" />
      <Function ID="5" Name="Flow 2" Display="'Flow 2 %.f%%',0~100" Dmx="112~147" />
      <Function ID="6" Name="xFade CW-WW" Display="'xFade CW-WW %.f%%',0~100" Dmx="148~183" />
      <Function ID="7" Name="Change" Display="'Change %.f%%',0~100" Dmx="184~219" />
      <Function ID="8" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="220~255" />
    </Attribute>
  </Control>

  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="70~139" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="140~209" />
      <Function ID="4" Name="Manual" Display="'Manual'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Static" Display="'Static %.f%%',0~100" Dmx="0~33" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.1f%%',0.0~100.0" Dmx="34~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Spot_and_Line" Name="Spot and Line" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line-&gt;Spot" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~160" />
      <Function ID="2" Name="L-&gt;R" Display="'L-&gt;R'" Dmx="161~190" />
      <Function ID="3" Name="R-&gt;L" Display="'R-&gt;L'" Dmx="191~220" />
      <Function ID="4" Name="R+L in phase" Display="'R+L in phase'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />

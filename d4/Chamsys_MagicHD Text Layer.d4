<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MagicHD Text Layer" ShortName="Magic Text" Company="Chamsys">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="27-09-17" Author="Nic Morris" Comment="Updated in line with latest charts." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Position X" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Offset X -" Display="'Offset X - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32768~32768" />
      <Function ID="3" Name="Offset X +" Display="'Offset X + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Position Y" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Offset Y -" Display="'Offset Y - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32768~32768" />
      <Function ID="3" Name="Offset Y +" Display="'Offset Y + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Scale_X" Name="Scale X" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Scale X -" Display="'Scale X - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Scale X +" Display="'Scale X + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Scale_Y" Name="Scale Y" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Scale Y -" Display="'Scale Y - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Scale Y +" Display="'Scale Y + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Angle -" Display="'Angle - %.2f°',180.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Angle +" Display="'Angle + %.2f°',0.00~180.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="BG_Red" Name="BG Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="BG_Green" Name="BG Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="BG_Blue" Name="BG Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="BG_Transp" Name="BG Transp" Description="" Group="I">
      <Locate Locate="1:192" PowerOn="1:192" />
      <Function ID="1" Name="Transparency" Display="'%.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Text_Folder" Name="Text Folder" Description="" Group="G">
      <Locate Locate="1:5" PowerOn="1:5" />
      <Function ID="1" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Text_File" Name="Text File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Font" Name="Font" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Font" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Text_Lines" Name="Text Lines" Description="" Group="G">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Lines" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scroll_Dir" Name="Scroll Dir" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" />
      <Function ID="2" Name="Left" Display="'Left'" Dmx="1~1" />
      <Function ID="3" Name="Right" Display="'Right'" Dmx="2~2" />
      <Function ID="4" Name="Up" Display="'Up'" Dmx="3~3" />
      <Function ID="5" Name="Down" Display="'Down'" Dmx="4~4" />
      <Function ID="6" Name="Char/Line" Display="'Char/Line'" Dmx="5~5" />
      <Function ID="7" Name="Top Left" Display="'Top Left'" Dmx="6~6" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scroll_Speed" Name="Scroll Speed" Description="" Group="G" Size="2">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="REV x5-&gt;x1" Display="'REV x5-&gt;x1 %.2f%%',100.00~0.00" Dmx="0~26213" />
      <Function ID="2" Name="REV Normal" Display="'REV Normal'" Dmx="26214~26214" />
      <Function ID="3" Name="REV x1-&gt;x0" Display="'REV x1-&gt;x0 %.2f%%',100.00~0.00" Dmx="26215~32767" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="32768~32768" />
      <Function ID="5" Name="FWD x0-&gt;x1" Display="'FWD x0-&gt;x1 %.2f%%',0.00~100.00" Dmx="32769~39320" />
      <Function ID="6" Name="FWD Normal" Display="'FWD Normal'" Dmx="39321~39321" />
      <Function ID="7" Name="FWD x1-&gt;x5" Display="'FWD x1-&gt;x5 %.2f%%',0.00~100.00" Dmx="39322~65535" />
    </Attribute>
    <Attribute ID="Loop" Name="Loop" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="1~1" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="2~2" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scroll_Char" Name="Scroll Char" Description="" Group="G" Size="2">
      <Locate Locate="1:10005" PowerOn="1:10005" />
      <Function ID="1" Name="Position" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Scroll_Line" Name="Scroll Line" Description="" Group="G" Size="2">
      <Locate Locate="1:10005" PowerOn="1:10005" />
      <Function ID="1" Name="Position" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Scroll_Time" Name="Scroll Time" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0ms" Display="'0ms'" Dmx="0~0" />
      <Function ID="2" Name="1ms" Display="'1ms'" Dmx="7~13" />
      <Function ID="3" Name="Duration" Display="'%.fms',0~10000" Dmx="0~65535" />
      <Function ID="4" Name="1000ms" Display="'1000ms'" Dmx="6554~6560" />
      <Function ID="5" Name="9999ms" Display="'9999ms'" Dmx="65535~65535" />
    </Attribute>
    <Attribute ID="Border" Name="Border" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Border" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="32 DMX" Channels="33">
    <Import PearlRef="UKCHMHDT" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="BG_Transp" ChannelOffset="18" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="2,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4,5" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="12" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="13" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="14" Wheel="12" />
      <Attribute ID="BG_Red" ChannelOffset="15" Wheel="7" />
      <Attribute ID="BG_Green" ChannelOffset="16" Wheel="8" />
      <Attribute ID="BG_Blue" ChannelOffset="17" Wheel="9" />
      <Attribute ID="Scale_X" ChannelOffset="6,7" Wheel="19" />
      <Attribute ID="Scale_Y" ChannelOffset="8,9" Wheel="20" />
      <Attribute ID="Rotation" ChannelOffset="10,11" Wheel="21" />
      <Attribute ID="Text_Folder" ChannelOffset="19" Wheel="13" />
      <Attribute ID="Text_File" ChannelOffset="20" Wheel="14" />
      <Attribute ID="Font" ChannelOffset="21" Wheel="15" />
      <Attribute ID="Text_Lines" ChannelOffset="22" Wheel="16" />
      <Attribute ID="Scroll_Dir" ChannelOffset="23" Wheel="17" />
      <Attribute ID="Scroll_Speed" ChannelOffset="24,25" Wheel="18" />
      <Attribute ID="Loop" ChannelOffset="26" Wheel="46" />
      <Attribute ID="Scroll_Char" ChannelOffset="27,28" Wheel="47" />
      <Attribute ID="Scroll_Line" ChannelOffset="29,30" Wheel="48" />
      <Attribute ID="Scroll_Time" ChannelOffset="31,32" Wheel="76" />
      <Attribute ID="Border" ChannelOffset="33" Wheel="49" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />

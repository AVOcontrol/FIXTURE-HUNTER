<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="XP-15R SZ" ShortName="XP-15R SZ" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="06-02-13" Author="Peter Budd" Comment="Created" />
  <History Date="09-04-17" Author="Nic Morris" Comment="Revised classic pearl ref to valid shortcode." />
  <History Date="09-04-17" Author="Nic Morris" Comment="Changed name from Xperior 15R Spot to XP-15R SZ in line with other personalities from product range." />
  <History Date="09-04-17" Author="Nic Morris" Comment="Fixed colour ranges.  Fixed Gobo2Func update.  Added Gobo 1 Rot index function." />
  <History Date="09-04-17" Author="Nic Morris" Comment="Corrected Gobo 1 shake DMX ranges.  Added Gobo 2 shake discreet ranges." />
  <History Date="09-04-17" Author="Nic Morris" Comment="Inverted Iris and changed power on to match locate.  Increased wheel resolution.  Changed shutter to locate in open." />
  <History Date="09-04-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Recreated palettes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="22cec759-6928-4782-b793-b345cccc1c43" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">

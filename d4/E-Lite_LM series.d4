  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Pattern/X-Pos, Zoom/Y-Pos, Y-Roll/Shutter, X-Roll, Z-Rot, Pan, Tilt" />
      <Function ID="2" Name="Auto Slow Solid Beam Effect" Display="'Auto Slow Solid Beam Effect'" Dmx="32~63" Update="Pattern/X-Pos, Zoom/Y-Pos, Y-Roll/Shutter, X-Roll, Z-Rot, Pan, Tilt" />

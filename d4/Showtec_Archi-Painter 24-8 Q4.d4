<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Archi-Painter 24-8 Q4" ShortName="ArcPtr24-8" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="10~14" Colour="255,255,0" />
      <Function ID="4" Name="Fawn" Display="'Fawn'" Dmx="15~19" Colour="180,180,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~24" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="25~29" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="30~34" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="35~39" Colour="128,0,255" />
      <Function ID="9" Name="Rose" Display="'Rose'" Dmx="40~44" Colour="255,0,127" />
      <Function ID="10" Name="Amber" Display="'Amber'" Dmx="45~49" Colour="255,100,0" />
      <Function ID="11" Name="Pink" Display="'Pink'" Dmx="50~54" Colour="255,150,150" />
      <Function ID="12" Name="Tin Green" Display="'Tin Green'" Dmx="55~59" Colour="128,255,0" />
      <Function ID="13" Name="Baby Blue" Display="'Baby Blue'" Dmx="60~64" Colour="0,128,255" />
      <Function ID="14" Name="White 1" Display="'White 1'" Dmx="65~69" Colour="255,255,255" />
      <Function ID="15" Name="White 2" Display="'White 2'" Dmx="70~74" Colour="255,255,255" />
      <Function ID="16" Name="White 3" Display="'White 3'" Dmx="75~79" Colour="255,255,255" />
      <Function ID="17" Name="Program 2" Display="'Program 2'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="18" Name="Program 3" Display="'Program 3'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="19" Name="Program 4" Display="'Program 4'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="20" Name="Program 5" Display="'Program 5'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="21" Name="Program 6" Display="'Program 6'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="22" Name="Program 7" Display="'Program 7'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="23" Name="Program 8" Display="'Program 8'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="24" Name="Program 9" Display="'Program 9'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="25" Name="Program 10" Display="'Program 10'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="26" Name="Program 11" Display="'Program 11'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="27" Name="Program 12" Display="'Program 12'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="28" Name="Program 13" Display="'Program 13'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="29" Name="Program 14" Display="'Program 14'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="30" Name="Program 15" Display="'Program 15'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="31" Name="Program 16" Display="'Program 16'" Dmx="220~229" Colour="255,255,255" />
      <Function ID="32" Name="Program 17" Display="'Program 17'" Dmx="230~239" Colour="255,255,255" />
      <Function ID="33" Name="Program 18" Display="'Program 18'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="2">
    <Import PearlRef="SHAP2481" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="2" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Mode 2" Channels="4">
    <Import PearlRef="SHAP2482" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 3" Channels="6">
    <Import PearlRef="SHAP2483" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="Mode 4" Channels="8">
    <Import PearlRef="SHAP2484" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
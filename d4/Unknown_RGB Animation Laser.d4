      <Function ID="2" Name="Angle" Display="'Angle %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Size_A" Name="Size A" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.f%%',0~100" Dmx="1~63" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~191" />

      <Function ID="3" Name="Flow" Display="'Flow %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Laser_On/Off" Name="Laser On/Off" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DMX Manual Auto" Display="'DMX Manual Auto'" Dmx="0~0" />
      <Function ID="2" Name="Auto Cycle" Display="'Auto Cycle'" Dmx="64~127" />
      <Function ID="3" Name="DMX Manual Sound" Display="'DMX Manual Sound'" Dmx="128~191" />
      <Function ID="4" Name="Cycle Sound" Display="'Cycle Sound'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Rot" Name="Pattern Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Horiz_Rot" Name="Horiz Rot" Description="" Group="G">

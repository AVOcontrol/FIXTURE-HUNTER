      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Switch" Display="'Auto Switch'" Dmx="11~100" />
      <Function ID="3" Name="Auto Fade" Display="'Auto Fade'" Dmx="101~150" />
      <Function ID="4" Name="Sound Switch" Display="'Sound Switch'" Dmx="151~200" />
      <Function ID="5" Name="Sound Fade" Display="'Sound Fade'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Condition Name="Scroll" ID="31,32,33,34" If="'Colour1Func'==3" />
      <Else ID="35" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~14" WheelPosition="1" Colour="0,0,0" />

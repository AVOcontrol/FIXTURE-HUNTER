  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RGBW Mode" Display="'RGBW Mode'" Dmx="30~39" />
      <Function ID="3" Name="CMY Mode" Display="'CMY Mode'" Dmx="40~49" />
      <Function ID="4" Name="Col Cal ON" Display="'Col Cal ON'" Dmx="50~59" />
      <Function ID="5" Name="Col Cal OFF" Display="'Col Cal OFF'" Dmx="60~69" />
      <Function ID="6" Name="Dim Linear" Display="'Dim Linear'" Dmx="90~99" />
      <Function ID="7" Name="Dim Square" Display="'Dim Square'" Dmx="100~109" />
      <Function ID="8" Name="W Count ON" Display="'W Count ON'" Dmx="110~119" />
      <Function ID="9" Name="W Count OFF" Display="'W Count OFF'" Dmx="120~129" />
      <Function ID="10" Name="Display ON" Display="'Display ON'" Dmx="20~24" />
      <Function ID="11" Name="Display OFF" Display="'Display OFF'" Dmx="25~29" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Tung" Display="'2700K Tung'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Tung" Display="'3200K Tung'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
      <Function ID="10" Name="Scroll w/f" Display="'Scroll w/f %.f%%',0~100" Dmx="248~251" Colour="255,255,255" />
      <Function ID="11" Name="Scroll wo/f" Display="'Scroll wo/f %.f%%',0~100" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pixel_FX" Name="Pixel FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~90" Dmx="3~182" />
    </Attribute>
    <Attribute ID="Pixel_FX_Spd" Name="Pixel FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FW wo/f" Display="'FW wo/f %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="BW wo/f" Display="'BW wo/f %.f%%',100~0" Dmx="64~127" />
      <Function ID="3" Name="FW w/f" Display="'FW w/f %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="BW w/f" Display="'BW w/f %.f%%',100~0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />

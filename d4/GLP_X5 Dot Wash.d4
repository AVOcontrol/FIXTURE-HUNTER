  <Mode Name="Mode 3 (Normal), 12 DMX" Channels="12" Id="a7a55b79-b5ac-442c-9780-c288dc3a78f8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="4,5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6,7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8,9" Wheel="12" />
      <Attribute ID="CTC" ChannelOffset="10" Wheel="7" />
      <Attribute ID="M/G_Shift" ChannelOffset="11" Wheel="8" />

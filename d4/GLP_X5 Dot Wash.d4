<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="X5 Dot Wash" ShortName="X5DotWash" Company="GLP" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>9e2adad6-fab1-4768-a38c-8e217e6759be</Thumbnail>
  <History Date="03-08-26" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Single Flash" Display="'Single Flash'" Dmx="5~9" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~250" />
      <Function ID="5" Name="Rnd All" Display="'Rnd All %.f%%',0~100" Dmx="160~199" />
      <Function ID="6" Name="Rnd Pixel" Display="'Rnd Pixel %.f%%',0~100" Dmx="130~159" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="40~69" />
      <Function ID="8" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="70~99" />
      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="10~39" />
      <Function ID="10" Name="Double Flash" Display="'Double Flash'" Dmx="100~129" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC C-Mix" Display="'%.fK',2500~10000" Dmx="255~11" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="M/G_Shift" Name="M/G Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Correction" Display="'No Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full + Magenta" Display="'Full + Magenta'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="3" Name="+ Magenta" Display="'+ Magenta %.1f%%',99.0~1.0" Dmx="11~124" Colour="255,255,255" />
      <Function ID="4" Name="Netural" Display="'Netural'" Dmx="125~140" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.1f%%',1.0~99.0" Dmx="141~254" Colour="255,255,255" />
      <Function ID="6" Name="Full + Green" Display="'Full + Green'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CQC" Name="CQC" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="High Brightness-&gt;HCRI" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (Compressed), 6 DMX" Channels="6" Id="00e51993-2c75-43b2-b538-c2449fc7c730">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1,2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3,4" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="5,6" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

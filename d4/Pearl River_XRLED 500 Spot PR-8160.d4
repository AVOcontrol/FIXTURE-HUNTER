      <Attribute ID="Pan" ChannelOffset="18,19" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="20,21" Wheel="3" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="37" />
      <Attribute ID="Colour1Func" Wheel="7" />

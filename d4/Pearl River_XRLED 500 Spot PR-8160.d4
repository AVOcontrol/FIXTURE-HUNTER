  <Mode Name="Ext, 31 DMX" Channels="31">
    <Import PearlRef="PRXR50EX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="26,27" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="28,29" Wheel="3" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="37" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />

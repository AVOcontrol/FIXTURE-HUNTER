<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Colourwash 1000E" ShortName="CWash1000E" Company="Vello">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="15-05-07" Author="D.Milligan" Comment="Created" />
  <History Date="15-05-07" Author="D.Milligan" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Vello Lighting to Vello Professional Show Lighting" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Wheel assignment Numbers" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed manufacturer from 'Vello Professional Show Lighting' to 'Vello'" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Standardised conditionals.  Moved raw function into else condition.  Removed dupilcate ID's from else." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Added function index.  Changed split functions to text only.  Increased wheel resolution." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed dimmer function name from '8bit HTP' to 'Dimmer'" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Inverted speed wheel directions." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Added palettes.  Fixed wheel mapping conflict." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="7" PowerOn="7" />
      <Function ID="1" Name="Max" Display="'Max'" Dmx="0~5" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Min" Display="'Min'" Dmx="6~10" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Min-Max-Min" Display="'o&lt;O&gt;o %.f%%',0~100" Dmx="11~51" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Min" Display="'Min'" Dmx="52~56" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Max" Display="'Max'" Dmx="57~67" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="68~250" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="251~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="32~39" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~55" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="64~71" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="80~87" WheelPosition="5" Colour="128,0,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~103" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="112~119" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Op/Re" Display="'Op/Re'" Dmx="7~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Re/Bl" Display="'Re/Bl'" Dmx="23~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Bl/Gr" Display="'Bl/Gr'" Dmx="39~48" WheelPosition="2" Colour="0,0,255" />
      <Function ID="12" Name="Gr/Ye" Display="'Gr/Ye'" Dmx="55~64" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Ye/Pu" Display="'Ye/Pu'" Dmx="71~80" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Pu/Bl" Display="'Pu/Bl'" Dmx="87~96" WheelPosition="5" Colour="128,0,255" />
      <Function ID="15" Name="Bl/Or" Display="'Bl/Or'" Dmx="103~112" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Or/Op" Display="'Or/Op'" Dmx="119~127" WheelPosition="7" Colour="255,128,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~20" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="85~115" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="116~243" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="21~52" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="53~84" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="16bit" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="16bit" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="VectMode" Name="Vector Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~5" />
      <Function ID="2" Name="Reserved" Display="'Reserved'" Dmx="6~45" />
      <Function ID="3" Name="Reserved" Display="'Reserved'" Dmx="46~85" />
      <Function ID="4" Name="Colour" Display="'Colour'" Dmx="86~125" />
      <Function ID="5" Name="Nop" Display="'Nop'" Dmx="126~165" />
      <Function ID="6" Name="Pan/Tilt" Display="'Pan/Tilt'" Dmx="166~205" />
      <Function ID="7" Name="All" Display="'All'" Dmx="206~245" />
      <Function ID="8" Name="Safe" Display="'Safe'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="RotEffect" Name="Beam Rotation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'Cyan C-Mix %.1f%%',0.0~100.0" Dmx="0~200" Colour="0,255,255" />
      <Function ID="2" Name="Cyan" Display="'Cyan'" Dmx="201~205" Colour="0,255,255" />
      <Function ID="3" Name="&gt;&gt;&lt;&lt;" Display="'&gt;&gt;&lt;&lt; %.f%%',0~100" Dmx="206~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'Magenta C-Mix %.1f%%',0.0~100.0" Dmx="0~200" Colour="255,0,255" />
      <Function ID="2" Name="Magenta" Display="'Magenta'" Dmx="201~205" Colour="255,0,255" />
      <Function ID="3" Name="&gt;&gt;&lt;&lt;" Display="'&gt;&gt;&lt;&lt; %.f%%',0~100" Dmx="206~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'Yellow C-Mix %.1f%%',0.0~100.0" Dmx="0~200" Colour="255,255,0" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="201~205" Colour="255,255,0" />
      <Function ID="3" Name="&gt;&gt;&lt;&lt;" Display="'&gt;&gt;&lt;&lt; %.f%%',0~100" Dmx="206~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO Mix" Display="'CTO Mix %.1f%%',0.0~100.0" Dmx="0~200" Colour="255,240,200" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="201~205" Colour="255,240,200" />
      <Function ID="3" Name="&gt;&gt;&lt;&lt;" Display="'&gt;&gt;&lt;&lt; %.f%%',0~100" Dmx="206~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Speed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="VE_CW1000E" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="12" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="13" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="14" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="15" Wheel="9" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="RotEffect" ChannelOffset="11" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="VectMode" ChannelOffset="10" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="16" Wheel="26" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Theatre Wash (PR-3030)" ShortName="Theatre Ws" Company="Pearl River">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>fd23a353-6983-435f-81ee-1b0b11f59ca3</Thumbnail>
  <History Date="30-10-19" Author="Nic Morris" Comment="Created" />
  <History Date="01-11-19" Author="Nic Morris" Comment="Changed Atlabase mode ID to new version." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4b71a769-b408-493b-abfd-81acc94dccd0" />
  <Control>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" Highlight="3" Lowlight="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="45~89" Colour="255,255,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="90~134" Colour="255,255,0" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="135~179" Colour="0,255,255" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="180~224" Colour="255,0,0" />
      <Function ID="6" Name="Light Yellow" Display="'Light Yellow'" Dmx="225~255" Colour="255,255,128" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="50~99" Colour="255,150,150" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="100~149" Colour="0,0,255" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="150~199" Colour="255,128,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="200~249" Colour="0,255,0" />
      <Function ID="6" Name="Violet" Display="'Violet'" Dmx="250~255" Colour="180,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ab5baa19-bdf6-4845-b9d7-07962644177d" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Colour2" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:2,Colour2:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:5,Colour2:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour2:4,Colour1:2" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour2:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour2:5,Colour1:2" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour2:5,Colour1:2" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour2:5,Colour1:2" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:4,Colour2:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour2:3,Colour1:2" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour2:3,Colour1:2" />
      <Palette ID="11" Name="Violet" Number="9" Page="1" SetControl="Colour2:6,Colour1:2" />
      <Palette ID="12" Name="Violet" Number="10" Page="1" SetControl="Colour2:6,Colour1:2" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:5,Colour2:1" />
      <Palette ID="14" Name="Violet" Number="8" Page="1" SetControl="Colour2:6,Colour1:2" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour2:3,Colour1:2" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="fd23a353-6983-435f-81ee-1b0b11f59ca3"></Swatch>
  </swatchLibrary>
</Fixture>
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="100~100" Colour="255,150,150" />
      <Function ID="8" Name="White" Display="'White'" Dmx="120~120" Colour="255,255,255" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="150~175" Colour="255,255,255" />
      <Function ID="10" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="176~200" Colour="255,255,255" />
      <Function ID="11" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="201~225" Colour="255,255,255" />

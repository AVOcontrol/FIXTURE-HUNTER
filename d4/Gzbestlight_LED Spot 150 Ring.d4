<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Spot 150 Ring" ShortName="Sp150 Ring" Company="Gzbestlight" Version="1">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="05-10-21" Author="Nic Morris" Comment="Created (poor documentation.  gobo shake ranges say slow-fast but only have one DMX value)" Version="0" />
  <History Date="08-10-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="25918eab-f02b-4747-9932-9df95e66f5b3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~10" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~20" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~30" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~40" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~50" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="60~60" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="70~70" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="150~150" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="140~140" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="130~130" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="120~120" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="110~110" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="100~100" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Pk/ L Blu" Display="'Pk/ L Blu'" Dmx="90~90" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="L Blu/ Op" Display="'L Blu/ Op'" Dmx="80~80" WheelPosition="7" Colour="0,128,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="160~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />

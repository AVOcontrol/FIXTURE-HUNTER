      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="70~70" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="85~85" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="100~100" WheelPosition="7" />
      <Function ID="9" Name="Open Shake" Display="'Open Shake  %.f%%',0~100" Dmx="115~124" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="125~139" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="140~154" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="155~169" WheelPosition="3" />

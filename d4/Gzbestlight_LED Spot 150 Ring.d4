    <Attribute ID="LED_Ring" Name="LED Ring" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~5" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~20" Colour="0,255,0" />

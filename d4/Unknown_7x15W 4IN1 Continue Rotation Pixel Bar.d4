  <History Date="25-05-21" Author="Nic Morris" Comment="Created (poor documentation.  charts suggest there is no way to not have continuous spin)" Version="0" />
  <History Date="27-05-21" Author="Nic Morris" Comment="Changed name from 7x15W 4IN1 Continue Rotation Pixel Bar to PixelBlade 7 to match Capture.  Added Atlabase ID's." Version="1" />

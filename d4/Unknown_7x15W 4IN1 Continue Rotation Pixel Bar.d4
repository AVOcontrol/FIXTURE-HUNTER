    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~85" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="171~255" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="86~170" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="10~74" />
      <Function ID="3" Name="Dynamic 1" Display="'Dynamic 1 %.f%%',0~100" Dmx="75~110" />
      <Function ID="4" Name="Dynamic 2" Display="'Dynamic 2 %.f%%',0~100" Dmx="111~146" />
      <Function ID="5" Name="Dynamic 3" Display="'Dynamic 3 %.f%%',0~100" Dmx="147~182" />
      <Function ID="6" Name="Dynamic 4" Display="'Dynamic 4 %.f%%',0~100" Dmx="183~218" />

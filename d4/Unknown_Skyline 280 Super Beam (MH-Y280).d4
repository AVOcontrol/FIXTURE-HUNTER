      <Attribute ID="Frost" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Reserved" ChannelOffset="9" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13" Id="68f25b94-1afe-4244-b897-3ca82d48f627">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

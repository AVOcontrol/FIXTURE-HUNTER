    </Attribute>
    <Attribute ID="xRed" Name="Red" Description="" Group="C">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xGreen" Name="Green" Description="" Group="C">
      <Locate Locate="2" PowerOn="1" />

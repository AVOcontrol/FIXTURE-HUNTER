  <AtlaBase TypeID="fca47335-676e-4834-823c-40a8aff7db77" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~90" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="181~240" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="106~165" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="11~45" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="46~80" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="81~115" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="116~150" Colour="255,255,255" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="151~185" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="186~220" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="9~19" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="20~30" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="31~41" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="42~52" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="53~63" />

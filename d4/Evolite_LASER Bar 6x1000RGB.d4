      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="152~162" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="163~173" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="174~184" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="185~195" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="196~206" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="207~217" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="218~228" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="229~239" />
      <Function ID="23" Name="Auto" Display="'Auto'" Dmx="240~250" />
      <Function ID="24" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />

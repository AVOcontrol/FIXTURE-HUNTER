      <Attribute ID="Col_Mac_Spd" ChannelOffset="14" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="SWSVC4K2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="69cf7c43-6c07-4460-a09a-19dc556660f8" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6,7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Red" ChannelOffset="10,11" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="12,13" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="14,15" Wheel="12" />
      <Attribute ID="White" ChannelOffset="16,17" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="19" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
    </Include>

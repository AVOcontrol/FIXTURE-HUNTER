  <History Date="22-07-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="41d8bead-934c-48a5-a895-53c060aabb87" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Smooth" Display="'Smooth'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~10" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~90" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="91~170" />
      <Function ID="5" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Col Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="10000K" Display="'10000K'" Dmx="1~1" />
      <Function ID="3" Name="8000K" Display="'8000K'" Dmx="2~2" />
      <Function ID="4" Name="6500K" Display="'6500K'" Dmx="3~3" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="4~4" />
      <Function ID="6" Name="5000K" Display="'5000K'" Dmx="5~5" />
      <Function ID="7" Name="4500K" Display="'4500K'" Dmx="6~6" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="7~7" />
      <Function ID="9" Name="3200K" Display="'3200K'" Dmx="8~8" />
      <Function ID="10" Name="3000K" Display="'3000K'" Dmx="9~9" />
      <Function ID="11" Name="2700K" Display="'2700K'" Dmx="10~10" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~251" />
      <Function ID="13" Name="Scroll CW" Display="'Scroll CW'" Dmx="252~253" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Cal OFF" Display="'Cal OFF'" Dmx="10~19" />
      <Function ID="3" Name="Cal ON" Display="'Cal ON'" Dmx="20~29" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="40~49" />
      <Function ID="5" Name="Fan Silent" Display="'Fan Silent'" Dmx="50~59" />
      <Function ID="6" Name="Reset Pan" Display="'Reset Pan'" Dmx="100~109" />
      <Function ID="7" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="110~119" />
      <Function ID="8" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="120~129" />
      <Function ID="9" Name="Reset System" Display="'Reset System'" Dmx="130~139" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="SWSVC4K1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="08853bbc-8751-419c-b90d-f72a51b4b44e" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />

  <AtlaBase TypeID="1be12fe9-799d-4435-8547-b93c8c4ac16a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~9" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~39" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="40~69" Intensity="0~0" />
      <Function ID="5" Name="Auto Colour Change " Display="'Auto Colour   Change'" Dmx="70~99" Intensity="0~0" />
      <Function ID="6" Name="Chase 1" Display="'Chase 1'" Dmx="100~110" Intensity="0~0" />
      <Function ID="7" Name="Chase 2" Display="'Chase 2'" Dmx="111~121" Intensity="0~0" />
      <Function ID="8" Name="Chase 3" Display="'Chase 3'" Dmx="122~132" Intensity="0~0" />
      <Function ID="9" Name="Chase 4" Display="'Chase 4'" Dmx="133~143" Intensity="0~0" />
      <Function ID="10" Name="Chase 5" Display="'Chase 5'" Dmx="144~154" Intensity="0~0" />
      <Function ID="11" Name="Chase 6" Display="'Chase 6'" Dmx="155~165" Intensity="0~0" />
      <Function ID="12" Name="Chase 7" Display="'Chase 7'" Dmx="166~176" Intensity="0~0" />
      <Function ID="13" Name="Chase 8" Display="'Chase 8'" Dmx="177~187" Intensity="0~0" />
      <Function ID="14" Name="Chase 9" Display="'Chase 9'" Dmx="188~198" Intensity="0~0" />
      <Function ID="15" Name="Chase 10" Display="'Chase 10'" Dmx="199~209" Intensity="0~0" />
      <Function ID="16" Name="Chase 11" Display="'Chase 11'" Dmx="210~220" Intensity="0~0" />
      <Function ID="17" Name="Chase 12" Display="'Chase 12'" Dmx="221~231" Intensity="0~0" />
      <Function ID="18" Name="Chase 13" Display="'Chase 13'" Dmx="232~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

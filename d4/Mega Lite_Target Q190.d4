  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Fade All" Display="'Fade All %.f%%',0~100" Dmx="2~19" Colour="0,0,0" />
      <Function ID="3" Name="Snap All" Display="'Snap All %.f%%',0~100" Dmx="20~39" Colour="0,0,0" />
      <Function ID="4" Name="Random All" Display="'Random All %.f%%',0~100" Dmx="40~59" Colour="0,0,0" />
      <Function ID="5" Name="Red Chase" Display="'Red Chase %.f%%',0~100" Dmx="60~79" Colour="0,0,0" />
      <Function ID="6" Name="Green Chase" Display="'Green Chase %.f%%',0~100" Dmx="80~99" Colour="0,0,0" />
      <Function ID="7" Name="Blue Chase" Display="'Blue Chase %.f%%',0~100" Dmx="100~119" Colour="0,0,0" />
      <Function ID="8" Name="White Chase" Display="'White Chase %.f%%',0~100" Dmx="120~139" Colour="0,0,0" />
      <Function ID="9" Name="Effect 1" Display="'Effect 1'" Dmx="140~159" Colour="0,0,0" />
      <Function ID="10" Name="Effect 2" Display="'Effect 2'" Dmx="160~179" Colour="0,0,0" />
      <Function ID="11" Name="Effect 3" Display="'Effect 3'" Dmx="180~199" Colour="0,0,0" />
      <Function ID="12" Name="Effect 4" Display="'Effect 4'" Dmx="200~219" Colour="0,0,0" />
      <Function ID="13" Name="Effect 5" Display="'Effect 5'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="14" Name="Effect 6" Display="'Effect 6'" Dmx="230~249" Colour="0,0,0" />
      <Function ID="15" Name="Effect 7" Display="'Effect 7'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

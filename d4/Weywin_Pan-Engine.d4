<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pan-Engine" ShortName="Pan-Engine" Company="Weywin" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>bb2c695c-42c2-43f4-ad81-8d3417675fea</Thumbnail>
  <History Date="28-02-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~130" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="129~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="a9871a64-4101-4e54-925c-8f36b361ac7c">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Rotation" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="bb2c695c-42c2-43f4-ad81-8d3417675fea"></Swatch>
  </swatchLibrary>
</Fixture>
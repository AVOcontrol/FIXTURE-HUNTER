  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~51" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="52~103" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="104~155" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="156~207" />
      <Function ID="5" Name="DMX" Display="'DMX'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~30" Colour="255,255,255" />
      <Function ID="2" Name="Multi-Col" Display="'Multi-Col'" Dmx="31~61" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="62~92" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="93~123" Colour="255,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="124~154" Colour="255,255,255" />
      <Function ID="6" Name="Mulit-Col Chase" Display="'Mulit-Col Chase'" Dmx="155~185" Colour="255,255,255" />
      <Function ID="7" Name="Solid Chase" Display="'Solid Chase'" Dmx="186~247" Colour="255,255,255" />
      <Function ID="8" Name="Dotted Line" Display="'Dotted Line'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

  <Mode Name="RGBW cell" Channels="4" Hidden="True" Id="30442c64-00a3-46dc-9bce-8bb4d9665d07">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Normal" Display="'Dim Normal'" Dmx="5~9" />
      <Function ID="3" Name="Dim Incandescent" Display="'Dim Incandescent'" Dmx="10~14" />
      <Function ID="4" Name="Linear Curve" Display="'Linear Curve'" Dmx="30~34" />
      <Function ID="5" Name="Square Curve" Display="'Square Curve'" Dmx="35~39" />
      <Function ID="6" Name="S-Curve" Display="'S-Curve'" Dmx="40~44" />
      <Function ID="7" Name="PL-Curve" Display="'PL-Curve'" Dmx="45~49" />
      <Function ID="8" Name="Cal OFF" Display="'Cal OFF'" Dmx="70~74" />
      <Function ID="9" Name="Cal ON" Display="'Cal ON'" Dmx="75~79" />
      <Function ID="10" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~84" />
      <Function ID="11" Name="Fan Off" Display="'Fan Off'" Dmx="85~89" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Timing" Name="Timing" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Rotate_Mode" Name="Rotate Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Rotate" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="15~93" Update="Rotate" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="94~172" Update="Rotate" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Rotate" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Rotate_Mode'==1" />
      <Condition Name="Index" ID="2" If="'Rotate_Mode'==3" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Rotate_Mode'==2" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="124~131" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="132~255" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="124~131" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="0~123" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.f',1~32" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Pattern_Step" Name="Pattern Step" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Step" Display="'Step %.1f%%',0.0~100.0" Dmx="6~200" />
      <Function ID="3" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>

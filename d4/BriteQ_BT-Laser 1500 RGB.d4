  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="UKBQLAS2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fc7020c3-7fba-423a-9666-ac0d0929660f" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~73" />
      <Function ID="2" Name="PRG" Display="'PRG'" Dmx="74~110" />
      <Function ID="3" Name="ILD" Display="'ILD'" Dmx="111~147" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="148~165" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="166~184" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="185~202" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="203~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~73" Update="Gobo1, Shutter" />
      <Function ID="2" Name="PRG" Display="'PRG'" Dmx="74~110" Update="Gobo1, Shutter" />
      <Function ID="3" Name="ILD" Display="'ILD'" Dmx="111~147" Update="Gobo1, Shutter" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="148~165" Update="Gobo1, Shutter" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="166~184" Update="Gobo1, Shutter" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="185~202" Update="Gobo1, Shutter" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="203~221" Update="Gobo1, Shutter" />
      <Function ID="8" Name="DMX" Display="'DMX'" Dmx="222~255" Update="Gobo1, Shutter" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="SD card" ID="2" If="'Control'==2||'Control'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Patterns" Display="'Patterns %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folders" Display="'Folders %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="SD Card" ID="5" If="'Control'==2||'Control'==3" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="200~255" Intensity="0~0" />
      <Function ID="5" Name="Shows" Display="'Shows %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="X_Move" Name="X Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Moving" Display="'Moving %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rand Speed" Display="'Rand Speed'" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y_Move" Name="Y Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Moving" Display="'Moving %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rand Speed" Display="'Rand Speed'" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="101~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom In" Display="'Zoom In %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Zoom Bounce" Display="'Zoom Bounce %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Roll" Name="Y Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X_Roll" Name="X Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Z_Roll" Name="Z Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="181~217" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="218~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Clipping" Name="Clipping" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~10" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="11~74" />
      <Function ID="3" Name="Out" Display="'Out'" Dmx="75~104" />
      <Function ID="4" Name="In" Display="'In'" Dmx="105~144" />
      <Function ID="5" Name="Out and In" Display="'Out and In'" Dmx="145~184" />
      <Function ID="6" Name="On" Display="'On'" Dmx="185~224" />
      <Function ID="7" Name="Off" Display="'Off'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~9" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~199" />
      <Function ID="3" Name="Size" Display="'Size %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="WRGB Fixed" Display="'WRGB Fixed'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="BYPC Fixed" Display="'BYPC Fixed'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="7 Cols Fixed" Display="'7 Cols Fixed'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="WRGB Loop" Display="'WRGB Loop'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="BYPC Loop" Display="'BYPC Loop'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="7 Col Loop" Display="'7 Col Loop'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~63" />
      <Function ID="2" Name="Points" Display="'Points'" Dmx="64~127" />
      <Function ID="3" Name="Blanking" Display="'Blanking'" Dmx="128~191" />
      <Function ID="4" Name="Pattern" Display="'Pattern'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKBQLAS1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="14-06-10" Author="Jonathan Moreton" Comment="Added 24 Channel and 24 Channel vDim" />
  <History Date="12-09-11" Author="Nic Morris" Comment="Removed non-v-dim modes.  Renamed modes.  Increased wheel resolution." />

      </Function>
      <Function ID="15" Name="Gobo 11" Display="'Gobo 11'" Dmx="180~184" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>5f0143bc-3ee1-4517-9516-b41ec9049944</Swatch>
      </Function>
      <Function ID="16" Name="Open" Display="'Open'" Dmx="235~239" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>b0cf263d-1033-418f-8705-bb70a37bcf46</Swatch>
      </Function>
      <Function ID="17" Name="Open - 1" Display="'Open - 1 %.f%%',0~100" Dmx="15~30" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>b0cf263d-1033-418f-8705-bb70a37bcf46</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 1 - 2" Display="'Gobo 1 - 2 %.f%%',0~100" Dmx="30~45" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">

      <Function ID="13" Name="Gobo 9" Display="'Gobo 9'" Dmx="190~194" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>1fa9ed92-78a3-4706-890a-9c10ba86db54</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 10" Display="'Gobo 10'" Dmx="185~189" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0">

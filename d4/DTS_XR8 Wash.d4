<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="XR8 Wash" ShortName=" XR8 Wash" Company="DTS">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="12-12-06" Author="D.Milligan" Comment="Created" />
  <History Date="13-12-06" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-03-12" Author="Peter Budd" Comment="Added Colour Values to colour1" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="17-12-16" Author="Nic Morris" Comment="Standardised conditionals.  Fixed duplicate ID's in else conditions.  Added palettes." />
  <History Date="17-12-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3ceebf8f-0e79-4618-998e-76131e2c0806" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Max" Display="'Max'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="247~128" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" Clear="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="234~255" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="10~23" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="24~107" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="108~163" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="164~219" Intensity="0~0" />
      <Function ID="7" Name="C/M BO" Display="'C/M BO'" Dmx="220~227" Intensity="0~0" />
      <Function ID="8" Name="P/T BO" Display="'P/T BO'" Dmx="228~233" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="13~25" WheelPosition="1" Colour="230,230,255" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="26~38" WheelPosition="2" Colour="255,240,200" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="39~51" WheelPosition="3" Colour="154,48,241" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="65~77" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="91~103" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="117~129" WheelPosition="6" Colour="255,0,0" />
      <Function ID="8" Name="Dark Blue" Display="'Dark Blue'" Dmx="143~155" WheelPosition="7" Colour="0,0,160" />
      <Function ID="9" Name="Amber" Display="'Amber'" Dmx="169~181" WheelPosition="8" Colour="255,128,64" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Pu/Or" Display="'Pu/Or %.f%%',0~100" Dmx="51~65" WheelPosition="3" Colour="154,48,241" />
      <Function ID="12" Name="Or/Grn" Display="'Or/Grn %.f%%',0~100" Dmx="77~91" WheelPosition="4" Colour="255,128,0" />
      <Function ID="13" Name="Grn/Rd" Display="'Grn/Rd %.f%%',0~100" Dmx="103~117" WheelPosition="5" Colour="0,255,0" />
      <Function ID="14" Name="Rd/Dk Bl" Display="'Rd/Dk Bl %.f%%',0~100" Dmx="129~143" WheelPosition="6" Colour="255,0,0" />
      <Function ID="15" Name="Dk Bl/Am" Display="'Dk Bl/Am %.f%%',0~100" Dmx="155~169" WheelPosition="7" Colour="0,0,160" />
      <Function ID="16" Name="Am/Op" Display="'Am/Op %.f%%',0~100" Dmx="181~197" WheelPosition="8" Colour="255,128,64" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="225~228" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="198~224" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="225~228" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="229~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CMYSpeed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~8" />
      <Function ID="2" Name="Safe" Display="'Safe'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macros" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />

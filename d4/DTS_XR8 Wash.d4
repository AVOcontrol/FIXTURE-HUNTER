  <Mode Name="Mode 1" Channels="16">
    <Import PearlRef="DTS_XR8WM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="319" PanMaxSpeed="0" TiltMaxSpeed="0" />

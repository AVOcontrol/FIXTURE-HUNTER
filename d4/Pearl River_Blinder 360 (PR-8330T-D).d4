    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Effect" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Dimmer_1" ChannelOffset="5" Wheel="34" />
      <Attribute ID="Dimmer_2" ChannelOffset="6" Wheel="35" />
      <Attribute ID="Dimmer_3" ChannelOffset="7" Wheel="36" />
      <Attribute ID="Dimmer_4" ChannelOffset="8" Wheel="64" />
      <Attribute ID="Dimmer_5" ChannelOffset="9" Wheel="65" />
      <Attribute ID="Dimmer_6" ChannelOffset="10" Wheel="66" />
      <Attribute ID="Dimmer_7" ChannelOffset="11" Wheel="94" />
      <Attribute ID="Dimmer_8" ChannelOffset="12" Wheel="95" />
      <Attribute ID="Pan" ChannelOffset="13,14" Wheel="2" />
      <Attribute ID="Pan_Spin" ChannelOffset="15" Wheel="19" />
      <Attribute ID="Tilt" ChannelOffset="16,17" Wheel="3" />
      <Attribute ID="Tilt_Spin" ChannelOffset="18" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="19" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Master_Dimmer" ChannelOffset="2,3" Wheel="5" />
        <Attribute ID="Effect" ChannelOffset="4" Wheel="23" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Pan" ChannelOffset="13,14" Wheel="2" />
        <Attribute ID="Pan_Spin" ChannelOffset="15" Wheel="19" />
        <Attribute ID="Tilt" ChannelOffset="16,17" Wheel="3" />
        <Attribute ID="Tilt_Spin" ChannelOffset="18" Wheel="20" />
        <Attribute ID="PT_Speed" ChannelOffset="19" Wheel="25" />
        <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="Cell" X="2" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="8" ModeLink="Cell" X="3" Y="1">

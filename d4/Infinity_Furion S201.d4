      <Function ID="31" Name="Reset Colour" Display="'Reset Colour'" Dmx="180~185" />
      <Function ID="32" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="186~191" />
      <Function ID="33" Name="Reset All" Display="'Reset All'" Dmx="210~215" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour2Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Magenta" Display="'Magenta'" Dmx="7~13" Colour="255,0,255" />
      <Function ID="3" Name="CTO" Display="'CTO'" Dmx="14~20" Colour="255,240,200" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="21~27" Colour="0,255,255" />
      <Function ID="5" Name="Dark Yellow" Display="'Dark Yellow'" Dmx="28~34" Colour="180,180,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="35~41" Colour="0,0,255" />
      <Function ID="7" Name="Light Magenta" Display="'Light Magenta'" Dmx="42~48" Colour="255,128,255" />
      <Function ID="8" Name="Light Green" Display="'Light Green'" Dmx="49~59" Colour="128,255,0" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="60~187" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~224" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="219~188" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mega Bar RGB" ShortName="MegaBarRGB" Company="ADJ" Version="6">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="24-08-09" Author="David Hunt" Comment="Created from Mega Bar LED" Version="1" />
  <History Date="26-08-09" Author="Jonathan Moreton" Comment="Checked" Version="2" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="4" />
  <History Date="14-11-18" Author="Nic Morris" Comment="Fixed dimmer in response to customer bug report (ID was Dimmer1).  Added vdim to 3 DMX mode." Version="5" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Mega Bar RGB.d4 to ADJ_Mega Bar RGB.d4." Version="6" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.f',1~32" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour Mixing" Display="'Colour Mixing'" Dmx="128~159" />
      <Function ID="3" Name="3 Colour Change" Display="'3 Colour      Change'" Dmx="160~191" />
      <Function ID="4" Name="7 Colour Change" Display="'7 Colour      Change'" Dmx="192~223" />
      <Function ID="5" Name="Sound Active" Display="'Sound Active'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="ADJ_MBRGB1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="ADJ_MBRGB2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="ADJ_MBRGB3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="ADJ_MBRGB4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="ADJ_MBRGB5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="ADJ_MBRGB6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="ADJ_MBRGB7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
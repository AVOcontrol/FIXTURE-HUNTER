      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="42~47" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="48~59" WheelPosition="1" />

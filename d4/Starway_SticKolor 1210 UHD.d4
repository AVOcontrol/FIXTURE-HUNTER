  <AtlaBase TypeID="8e1a45f1-4f90-4a32-bc8a-63ba10a0b002" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="R" Display="'R'" Dmx="10~17" Update="Auto_Spd" />
      <Function ID="3" Name="G" Display="'G'" Dmx="18~25" Update="Auto_Spd" />
      <Function ID="4" Name="B" Display="'B'" Dmx="26~33" Update="Auto_Spd" />
      <Function ID="5" Name="W" Display="'W'" Dmx="34~41" Update="Auto_Spd" />
      <Function ID="6" Name="A" Display="'A'" Dmx="42~49" Update="Auto_Spd" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="50~57" Update="Auto_Spd" />
      <Function ID="8" Name="G+W+UV" Display="'G+W+UV'" Dmx="58~65" Update="Auto_Spd" />
      <Function ID="9" Name="G+A+UV" Display="'G+A+UV'" Dmx="66~73" Update="Auto_Spd" />
      <Function ID="10" Name="B+W+A" Display="'B+W+A'" Dmx="74~81" Update="Auto_Spd" />
      <Function ID="11" Name="B+W+UV" Display="'B+W+UV'" Dmx="82~89" Update="Auto_Spd" />
      <Function ID="12" Name="R+B+W+UV" Display="'R+B+W+UV'" Dmx="90~97" Update="Auto_Spd" />
      <Function ID="13" Name="R+B+A+UV" Display="'R+B+A+UV'" Dmx="98~105" Update="Auto_Spd" />
      <Function ID="14" Name="R+W+A+UV" Display="'R+W+A+UV'" Dmx="106~113" Update="Auto_Spd" />
      <Function ID="15" Name="G+B+W+A" Display="'G+B+W+A'" Dmx="114~121" Update="Auto_Spd" />
      <Function ID="16" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="122~129" Update="Auto_Spd" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="130~137" Update="Auto_Spd" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="138~145" Update="Auto_Spd" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="146~153" Update="Auto_Spd" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="154~161" Update="Auto_Spd" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="162~169" Update="Auto_Spd" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="170~177" Update="Auto_Spd" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="178~185" Update="Auto_Spd" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="186~193" Update="Auto_Spd" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="194~201" Update="Auto_Spd" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="202~209" Update="Auto_Spd" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="210~217" Update="Auto_Spd" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="218~225" Update="Auto_Spd" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="226~233" Update="Auto_Spd" />
      <Function ID="30" Name="Flow 10" Display="'Flow 10'" Dmx="234~241" Update="Auto_Spd" />
      <Function ID="31" Name="Sound" Display="'Sound'" Dmx="242~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==31" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

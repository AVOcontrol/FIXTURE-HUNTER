<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Blinder RGB LED 200" ShortName="BlndRGB200" Company="Unknown" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="26-08-23" Author="Nic Morris" Comment="Created (channels only.  doesn't make much sense without proper documentation)" Version="0" />
  <History Date="01-09-23" Author="Nic Morris" Comment="Revised in line with latest information." Version="1" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White_FX" Name="White FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="White_FX_Spd" />
      <Function ID="2" Name="Colour Sel" Display="'Colour Sel'" Dmx="1~50" Update="White_FX_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="51~100" Update="White_FX_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="101~150" Update="White_FX_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="151~200" Update="White_FX_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="201~255" Update="White_FX_Spd" />
    </Attribute>
    <Attribute ID="White_FX_Spd" Name="White FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Colour Sel" ID="2" If="'White_FX'==2" />
      <Condition Name="Sound" ID="3" If="'White_FX'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">

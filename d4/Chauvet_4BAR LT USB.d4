      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0,Red2:1:100,Red3:1:100,Red4:1:100,Green2:1:100,Green3:1:100,Green4:1:100,Blue2:1:0,Blue3:1:0,Blue4:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0,Red2:1:50,Red3:1:50,Red4:1:50,Green2:1:100,Green3:1:100,Green4:1:100,Blue2:1:0,Blue3:1:0,Blue4:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0,Red2:1:0,Red3:1:0,Red4:1:0,Green2:1:100,Green3:1:100,Green4:1:100,Blue2:1:0,Blue3:1:0,Blue4:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50,Red2:1:0,Red3:1:0,Red4:1:0,Green2:1:100,Green3:1:100,Green4:1:100,Blue2:1:50,Blue3:1:50,Blue4:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100,Red2:1:0,Red3:1:0,Red4:1:0,Green2:1:100,Green3:1:100,Green4:1:100,Blue2:1:100,Blue3:1:100,Blue4:1:100" />

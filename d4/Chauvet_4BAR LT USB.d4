      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0,Red2:1:100,Red3:1:100,Red4:1:100,Green2:1:0,Green3:1:0,Green4:1:0,Blue2:1:0,Blue3:1:0,Blue4:1:0" />

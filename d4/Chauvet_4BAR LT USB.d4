      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100,Red2:1:50,Red3:1:50,Red4:1:50,Green2:1:0,Green3:1:0,Green4:1:0,Blue2:1:100,Blue3:1:100,Blue4:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100,Red2:1:100,Red3:1:100,Red4:1:100,Green2:1:0,Green3:1:0,Green4:1:0,Blue2:1:100,Blue3:1:100,Blue4:1:100" />

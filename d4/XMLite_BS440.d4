      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism 1 Index" Display="'Prism 1 Index'" Dmx="6~25" Update="Prism_Rot" />
      <Function ID="3" Name="Prism 2 Index" Display="'Prism 2 Index'" Dmx="26~50" Update="Prism_Rot" />
      <Function ID="4" Name="Prism 3 Index" Display="'Prism 3 Index'" Dmx="51~75" Update="Prism_Rot" />
      <Function ID="5" Name="Prism 4 Index" Display="'Prism 4 Index'" Dmx="76~100" Update="Prism_Rot" />
      <Function ID="6" Name="Prism 5 Index" Display="'Prism 5 Index'" Dmx="101~125" Update="Prism_Rot" />
      <Function ID="7" Name="Prism 1 Spin" Display="'Prism 1 Spin'" Dmx="126~150" Update="Prism_Rot" />
      <Function ID="8" Name="Prism 2 Spin" Display="'Prism 2 Spin'" Dmx="151~175" Update="Prism_Rot" />
      <Function ID="9" Name="Prism 3 Spin" Display="'Prism 3 Spin'" Dmx="176~200" Update="Prism_Rot" />
      <Function ID="10" Name="Prism 4 Spin" Display="'Prism 4 Spin'" Dmx="201~225" Update="Prism_Rot" />
      <Function ID="11" Name="Prism 5 Spin" Display="'Prism 5 Spin'" Dmx="226~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="6:0" PowerOn="6:0" />
      <Condition Name="Index" ID="1" If="'Prism'&gt;1&amp;&amp;'Prism'&lt;7" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'&gt;6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="2~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="65~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="AutoFocus" Display="'AutoFocus %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="96~127" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="144~159" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="160~191" Intensity="0~0" />
      <Function ID="8" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

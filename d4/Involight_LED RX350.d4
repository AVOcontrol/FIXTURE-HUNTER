      <Function ID="7" Name="Yellow+White" Display="'Yellow+White'" Dmx="115~137" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="Red+Green" Display="'Red+Green'" Dmx="138~160" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="Red+Blue" Display="'Red+Blue'" Dmx="161~183" Update="Shutter" Colour="255,255,255" />

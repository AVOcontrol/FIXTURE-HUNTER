  <History Date="17-05-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="19-05-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0ee77f4c-84d4-4164-8944-00a61f80ab28" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~25" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="26~50" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="51~75" Colour="255,255,255" />
      <Function ID="5" Name="3500K" Display="'3500K'" Dmx="76~100" Colour="255,255,255" />
      <Function ID="6" Name="4000K" Display="'4000K'" Dmx="101~125" Colour="255,255,255" />
      <Function ID="7" Name="4500K" Display="'4500K'" Dmx="126~150" Colour="255,255,255" />
      <Function ID="8" Name="5000K" Display="'5000K'" Dmx="151~175" Colour="255,255,255" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="176~200" Colour="255,255,255" />
      <Function ID="10" Name="6000K" Display="'6000K'" Dmx="201~225" Colour="255,255,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="226~250" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Update="Auto_Spd" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Update="Auto_Spd" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" Update="Auto_Spd" />
      <Function ID="5" Name="Col Fade" Display="'Col Fade'" Dmx="128~159" Update="Auto_Spd" />
      <Function ID="6" Name="7 Col Snap" Display="'7 Col Snap'" Dmx="160~191" Update="Auto_Spd" />
      <Function ID="7" Name="18 Col Snap" Display="'18 Col Snap'" Dmx="192~223" Update="Auto_Spd" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="224~249" Update="Auto_Spd" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2,3" If="'Auto'&gt;7" />
      <Else ID="1" />
      <Function ID="2" Name="Sensitivity Off" Display="'Sensitivity Off'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5ba54e50-6ce1-4a90-a65d-722dec189b1d" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="7" />
      <Attribute ID="CTO" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Auto" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="11" Wheel="25" />
    </Include>
  </Mode>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d0765521-7653-417e-bcb7-da07b103d99a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="8~15" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~30" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="31~45" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="46~60" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="61~75" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="76~90" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="91~105" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="106~120" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="121~135" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="136~150" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="151~165" Colour="180,0,180" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="166~180" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="181~195" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="196~210" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="16" Name="Daylight White" Display="'Daylight White'" Dmx="226~230" Colour="230,230,255" />
      <Function ID="17" Name="UV" Display="'UV'" Dmx="231~255" Colour="180,0,255" />
    </Attribute>
    <Attribute ID="Scene" Name="Scene" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Preset Scene" Display="'No Preset Scene'" Dmx="0~0" />
      <Function ID="2" Name="Preset Scene 1" Display="'Preset Scene 1'" Dmx="16~25" />
      <Function ID="3" Name="Preset Scene 2" Display="'Preset Scene 2'" Dmx="26~35" />
      <Function ID="4" Name="Preset Scene 3" Display="'Preset Scene 3'" Dmx="36~45" />
      <Function ID="5" Name="Preset Scene 4" Display="'Preset Scene 4'" Dmx="46~55" />
      <Function ID="6" Name="Preset Scene 5" Display="'Preset Scene 5'" Dmx="56~65" />
      <Function ID="7" Name="Preset Scene 6" Display="'Preset Scene 6'" Dmx="66~75" />
      <Function ID="8" Name="Preset Scene 7" Display="'Preset Scene 7'" Dmx="76~85" />
      <Function ID="9" Name="Preset Scene 8" Display="'Preset Scene 8'" Dmx="86~95" />
      <Function ID="10" Name="Preset Scene 9" Display="'Preset Scene 9'" Dmx="96~105" />
      <Function ID="11" Name="Preset Scene 10" Display="'Preset Scene 10'" Dmx="106~115" />
      <Function ID="12" Name="Preset Scene 11" Display="'Preset Scene 11'" Dmx="116~125" />
      <Function ID="13" Name="Preset Scene 12" Display="'Preset Scene 12'" Dmx="126~135" />
      <Function ID="14" Name="Preset Scene 13" Display="'Preset Scene 13'" Dmx="136~145" />
      <Function ID="15" Name="Preset Scene 14" Display="'Preset Scene 14'" Dmx="146~155" />
      <Function ID="16" Name="Preset Scene 15" Display="'Preset Scene 15'" Dmx="156~165" />
      <Function ID="17" Name="Preset Scene 16" Display="'Preset Scene 16'" Dmx="166~175" />
      <Function ID="18" Name="Preset Scene 17" Display="'Preset Scene 17'" Dmx="176~185" />
      <Function ID="19" Name="Preset Scene 18" Display="'Preset Scene 18'" Dmx="186~195" />
      <Function ID="20" Name="Preset Scene 19" Display="'Preset Scene 19'" Dmx="196~205" />
      <Function ID="21" Name="Preset Scene 20" Display="'Preset Scene 20'" Dmx="206~215" />
      <Function ID="22" Name="Preset Scene 21" Display="'Preset Scene 21'" Dmx="216~225" />
      <Function ID="23" Name="Preset Scene 22" Display="'Preset Scene 22'" Dmx="226~235" />
      <Function ID="24" Name="Preset Scene 23" Display="'Preset Scene 23'" Dmx="236~245" />
      <Function ID="25" Name="Preset Scene 24" Display="'Preset Scene 24'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Scene_Spd" Name="Scene Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Profile" Name="Dim Profile" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Exponential" Display="'Exponential'" Dmx="51~101" />
      <Function ID="3" Name="Logarithmic" Display="'Logarithmic'" Dmx="102~152" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="153~203" />
      <Function ID="5" Name="Halogen" Display="'Halogen'" Dmx="204~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Gyro" ShortName="Gyro" Company="QTX Light">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="15-04-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Pan" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="11~62" Update="Pan" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="63~127" Update="Pan" />
      <Function ID="4" Name="DMX Gobo Select" Display="'DMX Gobo Select'" Dmx="128~192" Update="Pan" />
      <Function ID="5" Name="DMX Control Mode" Display="'DMX Control Mode'" Dmx="193~255" Update="Pan" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Gobo" ID="2" If="'Control'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Rotate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Gobo" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="42~83" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="84~125" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="126~167" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="168~209" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="210~251" Colour="255,150,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="252~254" Colour="0,255,255" />
      <Function ID="8" Name="Section" Display="'Section'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Section_Display" Name="Section Display" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Section_Length" Name="Section Length" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="UKQTXGYR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Section_Display" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Section_Length" ChannelOffset="6" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
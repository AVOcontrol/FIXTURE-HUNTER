  <AtlaBase TypeID="f9f13f2b-3155-4266-b06c-c1f06d75c12d" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:8" PowerOn="1:8" />
      <Function ID="1" Name="Dim Spd 1" Display="'Dim Spd 1 %.f',1~8" Dmx="0~7" />
      <Function ID="2" Name="Dim Spd 2" Display="'Dim Spd 2 %.f',1~8" Dmx="32~39" />
      <Function ID="3" Name="Dim Spd 3" Display="'Dim Spd 3 %.f',1~8" Dmx="64~71" />
      <Function ID="4" Name="Dim Spd 4" Display="'Dim Spd 4 %.f',1~8" Dmx="96~103" />
      <Function ID="5" Name="Dim Spd 5" Display="'Dim Spd 5 %.f',1~8" Dmx="128~135" />
      <Function ID="6" Name="Theatre Whisper" Display="'Theatre Whisper'" Dmx="160~160" />
      <Function ID="7" Name="Theatre Silent" Display="'Theatre Silent'" Dmx="161~161" />
      <Function ID="8" Name="Standard" Display="'Standard'" Dmx="162~162" />
      <Function ID="9" Name="Boost" Display="'Boost'" Dmx="163~163" />
      <Function ID="10" Name="Longlife" Display="'Longlife'" Dmx="164~164" />
      <Function ID="11" Name="50Hz" Display="'50Hz'" Dmx="208~215" />
      <Function ID="12" Name="60Hz" Display="'60Hz'" Dmx="216~223" />
      <Function ID="13" Name="FLEX" Display="'FLEX'" Dmx="224~227" />
      <Function ID="14" Name="High FLEX" Display="'High FLEX'" Dmx="228~231" />
      <Function ID="15" Name="Reset" Display="'Reset'" Dmx="240~247" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Op Pls &gt;20Hz" Display="'Op Pls &gt;20Hz %.f%%',0~100" Dmx="110~96" Intensity="0~0" />
      <Function ID="4" Name="Fade w/dim" Display="'Fade w/dim %.f%%',0~100" Dmx="112~125" Intensity="0~0" />
      <Function ID="5" Name="Op Pls &lt;20Hz" Display="'Op Pls &lt;20Hz %.f%%',0~100" Dmx="142~128" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="158~144" Intensity="0~0" />
      <Function ID="7" Name="Fade 0%" Display="'Fade 0 %.f%%',0~100" Dmx="174~160" Intensity="0~0" />
      <Function ID="8" Name="Fade 100%" Display="'Fade 100 %.f%%',0~100" Dmx="190~176" Intensity="0~0" />
      <Function ID="9" Name="Rnd 100%" Display="'Rnd 100 %.f%%',0~100" Dmx="206~192" Intensity="0~0" />
      <Function ID="10" Name="Rnd 0%" Display="'Rnd 0 %.f%%',0~100" Dmx="222~208" Intensity="0~0" />
      <Function ID="11" Name="Rnd Fd 0%" Display="'Rnd Fd 0 %.f%%',0~100" Dmx="238~224" Intensity="0~0" />
      <Function ID="12" Name="Rnd Fd 100%" Display="'Rnd Fd 100 %.f%%',0~100" Dmx="254~240" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~5" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="8~9" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="12~13" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="16~17" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="20~21" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="24~25" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="HCRI" Display="'HCRI'" Dmx="28~29" WheelPosition="7" Colour="0,255,128" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="2~3" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="6~7" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="10~11" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="14~15" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="18~19" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ D Bl" Display="'Org/ D Bl'" Dmx="22~23" WheelPosition="5" Colour="255,100,0" />
      <Function ID="15" Name="D Bl/ HCRI" Display="'D Bl/ HCRI'" Dmx="26~27" WheelPosition="6" Colour="0,0,180" />
      <Function ID="16" Name="HCIR/ Op" Display="'HCIR/ Op'" Dmx="30~31" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~223" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />

  <AtlaBase TypeID="f0ecdb31-9ea5-43f9-8721-0f1b631d3a96" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Purple" Display="'Purple'" Dmx="22~42" Colour="128,0,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="43~63" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="64~84" Colour="0,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="85~105" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="106~127" Colour="255,128,0" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="195~255" Colour="0,0,0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="189~194" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="188~128" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Empty" Name="Rotate" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="134~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="123~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="1~122" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="de291fdd-badc-431d-a00a-480223ba5db8" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Empty" ChannelOffset="3" Wheel="20" />
    </Include>
  </Mode>
  <Palettes>

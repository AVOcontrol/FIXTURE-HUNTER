<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Power Strobe 1500 DMX" ShortName="1500W Strb" Company="Stairville">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-04-14" Author="Nic Morris" Comment="Created (no manual.  channels could be wrong way around)." />
  <History Date="02-05-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="06-08-17" Author="Nic Morris" Comment="Revised channel mapping in response to customer bug report and in line with latest documentation." />
  <History Date="06-08-17" Author="Nic Morris" Comment="Changed name from Strobe 1500 DMX Power Strobe to Power Strobe 1500 DMX" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Revised Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bda8f685-3c3f-4542-96ff-03083b1750ec" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f Hz',1.0~12.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="SV1500PS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a9ab82d8-8687-4b90-b192-f484b98a8f3e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
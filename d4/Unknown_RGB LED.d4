    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2500K" Display="'2500K'" Dmx="32~63" Colour="0,0,0" />
      <Function ID="3" Name="2900K" Display="'2900K'" Dmx="64~95" Colour="0,0,0" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="96~127" Colour="0,0,0" />
      <Function ID="5" Name="4500K" Display="'4500K'" Dmx="128~159" Colour="0,0,0" />
      <Function ID="6" Name="5400K" Display="'5400K'" Dmx="160~191" Colour="0,0,0" />
      <Function ID="7" Name="6500K" Display="'6500K'" Dmx="192~223" Colour="0,0,0" />
      <Function ID="8" Name="7000K" Display="'7000K'" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">

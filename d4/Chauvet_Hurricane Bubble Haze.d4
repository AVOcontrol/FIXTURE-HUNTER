<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hurricane Bubble Haze" ShortName="BubbleHaze" Company="Chauvet" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>c570791f-cae8-490f-9572-4f73b81681b4</Thumbnail>
  <History Date="04-10-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Bubble" Name="Bubble" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Haze" Name="Haze" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Low" Display="'Low'" Dmx="11~100" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="101~200" />
      <Function ID="4" Name="High" Display="'High'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Cleaning" Name="Cleaning" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Bubble Cleaning On" Display="'Bubble Cleaning On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Fan" ChannelOffset="3" Wheel="6" />
        <Attribute ID="Cleaning" ChannelOffset="4" Wheel="25" />
        <Attribute ID="Bubble" Wheel="4" />
        <Attribute ID="Haze" Wheel="5" />
      </Master>
      <Cell ID="Cell1" Name="Bubble" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Bubble" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Haze" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Haze" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="c570791f-cae8-490f-9572-4f73b81681b4"></Swatch>
  </swatchLibrary>
</Fixture>
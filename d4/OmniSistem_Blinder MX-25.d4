  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="10-06-10" Author="John Rogers" Comment="Created" />
  <History Date="05-10-12" Author="Peter Budd" Comment="Edited added cells" />
  <History Date="11-10-12" Author="Peter Budd" Comment="Created from showtec matrix 5x5 blinder" />
  <History Date="10-02-18" Author="Nic Morris" Comment="Changed manufacturer from Omnisistem to OmniSistem.  Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cf193359-b2e5-4774-88ba-78432c091449" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Static_Macros" Name="Static Macros" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Dynamic_Macros" />
      <Function ID="2" Name="Program" Display="'Program %.f',1~146" Dmx="10~155" Update="Dynamic_Macros" />
      <Function ID="3" Name="No Effect" Display="'No Effect'" Dmx="156~249" Update="Dynamic_Macros" />
      <Function ID="4" Name="Macro" Display="'Macro'" Dmx="250~255" Update="Dynamic_Macros" />
    </Attribute>
    <Attribute ID="Dynamic_Macros" Name="Dynamic Macros" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Program" ID="5" If="'Static_Macros'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Number" Display="'Number %.f',1~30" Dmx="1~30" />
      <Function ID="3" Name="Character" Display="'Character %.f',1~26" Dmx="31~56" />
      <Function ID="4" Name="Scene" Display="'Scene %.f',1~199" Dmx="57~255" />
      <Function ID="5" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lamp1" Name="Lamp 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

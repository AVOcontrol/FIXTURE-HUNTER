<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MagicHD Output Layer" ShortName="Magic Out" Company="Chamsys">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="27-09-17" Author="Nic Morris" Comment="Updated to latest specs." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Position X" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Offset X -" Display="'Offset X - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32768~32768" />
      <Function ID="3" Name="Offset X +" Display="'Offset X + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Position Y" Description="" Group="P" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Offset Y -" Display="'Offset Y - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Centre" Display="'Centre'" Dmx="32768~32768" />
      <Function ID="3" Name="Offset Y +" Display="'Offset Y + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Scale_X" Name="Scale X" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Scale X -" Display="'Scale X - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Scale X +" Display="'Scale X + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Scale_Y" Name="Scale Y" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Scale Y -" Display="'Scale Y - %.2f%%',100.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Scale Y +" Display="'Scale Y + %.2f%%',0.00~100.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Angle -" Display="'Angle - %.2f°',-180.00~0.00" Dmx="0~32767" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="32768~32768" />
      <Function ID="3" Name="Angle +" Display="'Angle + %.2f°',0.00~180.00" Dmx="32769~65535" />
    </Attribute>
    <Attribute ID="Mirror/Flip" Name="Mirror/Flip" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Horizontal Flip" Display="'Horizontal Flip'" Dmx="1~1" />
      <Function ID="3" Name="Vertical Flip" Display="'Vertical Flip'" Dmx="2~2" />
      <Function ID="4" Name="H+V Flip" Display="'H+V Flip'" Dmx="3~3" />
      <Function ID="5" Name="Horizontal Mirror" Display="'Horizontal Mirror'" Dmx="4~5" />
      <Function ID="6" Name="H Mirror + V Flip" Display="'H Mirror + V Flip'" Dmx="6~7" />
      <Function ID="7" Name="Vertical Mirror" Display="'Vertical Mirror'" Dmx="8~9" />
      <Function ID="8" Name="V Mirror + H Flip" Display="'V Mirror + H Flip'" Dmx="10~11" />
      <Function ID="9" Name="H+V Mirror" Display="'H+V Mirror'" Dmx="12~15" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_FX" Name="Colour FX" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="2" Name="Black + White" Display="'Black + White'" Dmx="1~1" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="3" Name="RGB Mapping" Display="'RGB Mapping'" Dmx="2~2" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="4" Name="Posterise" Display="'Posterise'" Dmx="3~3" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="5" Name="Colourise" Display="'Colourise'" Dmx="4~4" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="6" Name="Mask" Display="'Mask'" Dmx="5~5" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="7" Name="Key" Display="'Key'" Dmx="6~6" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="8" Name="Hue Offset" Display="'Hue Offset'" Dmx="7~7" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="255,255,255" />
      <Function ID="9" Name="Hue Filter" Display="'Hue Filter'" Dmx="8~8" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
      <Function ID="10" Name="Invert" Display="'Invert'" Dmx="9~9" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
      <Function ID="11" Name="Curve 1" Display="'Curve 1'" Dmx="10~10" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
      <Function ID="12" Name="Curve 2" Display="'Curve 2'" Dmx="11~11" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
      <Function ID="13" Name="Curve 3" Display="'Curve 3'" Dmx="12~12" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Col_FX_Param_R, Col_FX_Param_G, Col_FX_Param_B" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_FX_Param_R" Name="Col FX Param R" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Mapping" ID="2,3,4,5,6,7,8,9,10" If="'Colour_FX'==3" />
      <Condition Name="Steps" ID="11" If="'Colour_FX'==4" />
      <Condition Name="Red" ID="12" If="'Colour_FX'==5" />
      <Condition Name="Mask" ID="13,14,15,16,17,18,19" If="'Colour_FX'==6" />
      <Condition Name="Hue" ID="20" If="'Colour_FX'==7||'Colour_FX'==9" />
      <Condition Name="Offset" ID="21" If="'Colour_FX'==8" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="6" Name="Intensity" Display="'Intensity'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="7" Name="Inverse R" Display="'Inverse R'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="8" Name="Inverse G" Display="'Inverse G'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="9" Name="Inverse B" Display="'Inverse B'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="10" Name="Inverse Intensity" Display="'Inverse Intensity'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="11" Name="Steps" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="12" Name="Red" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="13" Name="Transparency=Int" Display="'Transparency=Int'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Transparency=Int (inv Col)" Display="'Transparency=Int (inv Col)'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="15" Name="Transparency=Inv Int" Display="'Transparency=Inv Int'" Dmx="2~2" Colour="0,0,0" />
      <Function ID="16" Name="Transparency=Inv Int (inv Col)" Display="'Transparency=Inv Int (inv Col)'" Dmx="3~3" Colour="0,0,0" />
      <Function ID="17" Name="Transparency=Alpha" Display="'Transparency=Alpha'" Dmx="4~4" Colour="0,0,0" />
      <Function ID="18" Name="Transparency=Int (Col=Alpha)" Display="'Transparency=Int (Col=Alpha)'" Dmx="5~5" Colour="0,0,0" />
      <Function ID="19" Name="Transparency=Inv Int (Col=Alpha)" Display="'Transparency=Inv Int (Col=Alpha)'" Dmx="6~6" Colour="0,0,0" />
      <Function ID="20" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="21" Name="Offset" Display="'%.f°',0~360" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_FX_Param_G" Name="Col FX Param G" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Mapping" ID="2,3,4,5,6,7,8,9,10" If="'Colour_FX'==3" />
      <Condition Name="Steps" ID="11" If="'Colour_FX'==4" />
      <Condition Name="Green" ID="12" If="'Colour_FX'==5" />
      <Condition Name="Hue" ID="13,14" If="'Colour_FX'==6" />
      <Condition Name="Selectivity" ID="15" If="'Colour_FX'==7||'Colour_FX'==9" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="6" Name="Intensity" Display="'Intensity'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="7" Name="Inverse R" Display="'Inverse R'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="8" Name="Inverse G" Display="'Inverse G'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="9" Name="Inverse B" Display="'Inverse B'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="10" Name="Inverse Intensity" Display="'Inverse Intensity'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="11" Name="Steps" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="12" Name="Green" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="13" Name="Hue" Display="'Hue %.1f%%',0.0~100.0" Dmx="0~254" Colour="0,0,0" />
      <Function ID="14" Name="White" Display="'White'" Dmx="255~255" Colour="0,0,0" />
      <Function ID="15" Name="Selectivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Mask_Folder" Name="Mask Folder" Description="" Group="G">
      <Locate Locate="1:3" PowerOn="1:3" />
      <Function ID="1" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mask_File" Name="Mask File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mask_Invert" Name="Mask Invert" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Mask_Mirror" Name="Mask Mirror" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Horizontal Flip" Display="'Horizontal Flip'" Dmx="1~1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Vertical Flip" Display="'Vertical Flip'" Dmx="2~2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="H+V Flip" Display="'H+V Flip'" Dmx="3~3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Horizontal Mirror" Display="'Horizontal Mirror'" Dmx="4~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="H Mirror + V Flip" Display="'H Mirror + V Flip'" Dmx="6~7" />
      <Function ID="7" Name="Vertical Mirror" Display="'Vertical Mirror'" Dmx="8~9" />
      <Function ID="8" Name="V Mirror + H Flip" Display="'V Mirror + H Flip'" Dmx="10~11" />
      <Function ID="9" Name="H+V Mirror" Display="'H+V Mirror'" Dmx="12~15" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Keystone_TL_X" Name="Keystone A" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_TL_Y" Name="Keystone B" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_TR_X" Name="Keystone C" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_TR_Y" Name="Keystone D" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_BR_X" Name="Keystone E" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_BR_Y" Name="Keystone F" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_BL_X" Name="Keystone X" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Keystone_BL_Y" Name="Keystone Y" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="HUD_Control" Name="HUD Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Audio_Volume" Name="Audio Volume" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Physical_FX" Name="Physical FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="2" Name="Shake Gentle" Display="'Shake Gentle'" Dmx="1~1" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="2~2" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="3~3" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="5" Name="Scroll to Index" Display="'Scroll to Index'" Dmx="4~4" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="6" Name="Tile" Display="'Tile'" Dmx="5~5" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Phys_FX_1, Phys_FX_2, Phys_FX_3" />
    </Attribute>
    <Attribute ID="Phys_FX_1" Name="Phys FX 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Horiz Size" ID="2" If="'Physical_FX'==2||'Physical_FX'==3" />
      <Condition Name="Horiz Scroll" ID="3,4,5,6" If="'Physical_FX'==4" />
      <Condition Name="Horiz Index" ID="7" If="'Physical_FX'==5" />
      <Condition Name="Horiz Tiles" ID="8" If="'Physical_FX'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Horiz Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="0~0" />
      <Function ID="4" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="6" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="127~1" />
      <Function ID="7" Name="Horiz Index" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="8" Name="Horiz Tiles" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Phys_FX_2" Name="Phys FX 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Vert Size" ID="2" If="'Physical_FX'==2||'Physical_FX'==3" />
      <Condition Name="Vert Scroll" ID="3,4,5,6" If="'Physical_FX'==4" />
      <Condition Name="Vert Index" ID="7" If="'Physical_FX'==5" />
      <Condition Name="Vert Tiles" ID="8" If="'Physical_FX'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Vert Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="0~0" />
      <Function ID="4" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="6" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="127~1" />
      <Function ID="7" Name="Vert Index" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="8" Name="Vert Tiles" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Phys_FX_3" Name="Phys FX 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Rot Size" ID="2" If="'Physical_FX'==2||'Physical_FX'==3" />
      <Condition Name="Mirroring" ID="3,4,5,6" If="'Physical_FX'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Rot Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="None" Display="'None'" Dmx="0~0" />
      <Function ID="4" Name="Horiz Mirror Odd Tiles" Display="'Horiz Mirror Odd Tiles'" Dmx="64~127" />
      <Function ID="5" Name="Vert Mirror Odd Tiles" Display="'Vert Mirror Odd Tiles'" Dmx="128~191" />
      <Function ID="6" Name="H+V Mirror Odd Tiles" Display="'H+V Mirror Odd Tiles'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control_Func" Name="Control Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Turn Off" Display="'Turn Off'" Dmx="1~10" />
      <Function ID="3" Name="Standby" Display="'Standby'" Dmx="11~20" />
      <Function ID="4" Name="Turn On" Display="'Turn On'" Dmx="21~30" />

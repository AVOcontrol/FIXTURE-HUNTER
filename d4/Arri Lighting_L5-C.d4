  <History Date="07-08-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information." Version="2" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="3" />
  <History Date="20-03-15" Author="Nic Morris" Comment="Created from Arri Lighting L7-C" Version="4" />
  <History Date="04-02-17" Author="Nic Morris" Comment="Harmonised Xfade to Col across range.  Added to highlight/lowlight." Version="5" />
  <History Date="06-05-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="18-10-17" Author="Nic Morris" Comment="Revised mode names.  Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." Version="7" />
  <History Date="18-10-17" Author="Nic Morris" Comment="Removed non-existant magenta from palettes." Version="8" />
  <History Date="21-08-20" Author="Nic Morris" Comment="Added product thumbnail.  Revised CCT display range from percentage to Kelvin.  Minor correction to GN Saturation display ranges." Version="9" />
  <History Date="21-08-20" Author="Nic Morris" Comment="Revised Xfade to match SkyPanel." Version="9" />

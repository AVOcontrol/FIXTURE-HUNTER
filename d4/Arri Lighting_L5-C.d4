  <AtlaBase TypeID="6a91acb3-384a-4846-821c-7a76f688edfc" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT" Display="'%.1fK',2800.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="GN_Saturation" Name="GN Saturation" Description="" Group="C" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="2827~5140" Colour="255,0,255" />
      <Function ID="3" Name="-" Display="'- %.2f%%',-99.00~1.00" Dmx="5397~30583" Colour="255,0,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30840~37265" Colour="255,255,255" />
      <Function ID="5" Name="+" Display="'+ %.2f%%',1.00~99.00" Dmx="37522~62708" Colour="0,255,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="62965~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Xfade_CCT&gt;RGBW" Name="Xfade CCT&gt;RGBW" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:100" />
      <Function ID="1" Name="CCT-&gt;RGBW" Display="'CCT-&gt;RGBW %.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
      <Function ID="2" Name="CCT" Display="'CCT'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="RGBW" Display="'RGBW'" Dmx="65535~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">

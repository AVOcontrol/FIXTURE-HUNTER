  <History Date="16-05-23" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Colour" Display="'Fixed Colour'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Whole Col Change" Display="'Whole Col Change %.f%%',0~100" Dmx="70~79" Colour="255,255,255" />
      <Function ID="3" Name="Default Col" Display="'Default Col'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="4" Name="7 Colours" Display="'7 Colours'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="5" Name="Segment Col Choice" Display="'Segment Col Choice %.1f%%',0.0~100.0" Dmx="100~224" Colour="255,255,255" />
      <Function ID="6" Name="Dynamic Col Chase 1" Display="'Dynamic Col Chase 1'" Dmx="225~229" Colour="255,255,255" />
      <Function ID="7" Name="Dynamic Col Chase 2" Display="'Dynamic Col Chase 2'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="8" Name="Dynamic Col Chase 3" Display="'Dynamic Col Chase 3'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="9" Name="Dynamic Col Chase 4" Display="'Dynamic Col Chase 4'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="10" Name="Dynamic Col Chase 5" Display="'Dynamic Col Chase 5'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="11" Name="Dynamic Col Chase 6" Display="'Dynamic Col Chase 6'" Dmx="250~255" Colour="255,255,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Chase_Spd" Name="Col Chase Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="CW" Display="'CW %.1f%%',100.0~0.0" Dmx="127~10" Colour="0,0,0" />
      <Function ID="3" Name="CCW" Display="'CCW %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Group" Name="Pattern Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Group 1" Display="'Group 1'" Dmx="0~0" />
      <Function ID="2" Name="Group 2" Display="'Group 2'" Dmx="51~101" />
      <Function ID="3" Name="Group 3" Display="'Group 3'" Dmx="102~152" />
      <Function ID="4" Name="Group 4" Display="'Group 4'" Dmx="153~203" />
      <Function ID="5" Name="Group 5" Display="'Group 5'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="0~15" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="16~55" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="56~95" />
      <Function ID="4" Name="Cyclic" Display="'Cyclic %.f%%',0~100" Dmx="96~135" />
      <Function ID="5" Name="Anim Cyclic 1" Display="'Anim Cyclic 1 %.f%%',0~100" Dmx="136~175" />
      <Function ID="6" Name="Anim Cyclic 2" Display="'Anim Cyclic 2 %.f%%',0~100" Dmx="176~215" />
      <Function ID="7" Name="Anim Cyclic 3" Display="'Anim Cyclic 3 %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Centre_Rot" Name="Centre Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Horiz_Flip" Name="Horiz Flip" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flip Sel" Display="'Flip Sel %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Flip Spd" Display="'Flip Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Vert_Flip" Name="Vert Flip" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flip Sel" Display="'Flip Sel %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Flip Spd" Display="'Flip Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Horiz Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Sel" Display="'Sel %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Vert Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Sel" Display="'Sel %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Wave_FX" Name="Wave FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Wave" Display="'Wave %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Manual " Display="'Manual '" Dmx="2~63" />
      <Function ID="3" Name="Manual " Display="'Manual '" Dmx="64~127" />
      <Function ID="4" Name="Auto Increase" Display="'Auto Increase'" Dmx="128~153" />
      <Function ID="5" Name="Auto Decrease" Display="'Auto Decrease'" Dmx="154~179" />
      <Function ID="6" Name="Auto Increase to Decrease + Erase" Display="'Auto Increase to Decrease + Erase'" Dmx="180~205" />
      <Function ID="7" Name="Auto Increase to Decrease Cyclical" Display="'Auto Increase to Decrease Cyclical'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Inner_FX" Name="Inner FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Single" Display="'Single %.1f%%',0.0~100.0" Dmx="3~229" />
      <Function ID="3" Name="Random Auto" Display="'Random Auto'" Dmx="230~249" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="250~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Inner_FX_Spd" Name="Inner FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="DMX" Display="'DMX %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Col_Chase_Spd" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Pattern" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Pattern_Group" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Size" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Centre_Rot" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Horiz_Flip" ChannelOffset="9" Wheel="49" />
      <Attribute ID="Vert_Flip" ChannelOffset="10" Wheel="50" />
      <Attribute ID="Pan" ChannelOffset="11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12" Wheel="3" />
      <Attribute ID="Wave_FX" ChannelOffset="13" Wheel="22" />
      <Attribute ID="Drawing" ChannelOffset="14" Wheel="5" />
      <Attribute ID="Inner_FX" ChannelOffset="15" Wheel="23" />
      <Attribute ID="Inner_FX_Spd" ChannelOffset="16" Wheel="24" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="9ffb0233-b1e8-4ae8-9827-d630d499a801"></Swatch>

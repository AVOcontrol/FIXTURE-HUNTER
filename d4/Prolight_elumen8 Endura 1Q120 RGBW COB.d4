    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Col Macro" Display="'Col Macro %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="2" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="93ef8c64-5b50-4b46-9a50-c59763307b7f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard %.f%%',0~100" Dmx="206~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="6~55" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="56~105" />
      <Function ID="5" Name="Regular" Display="'Regular %.f%%',0~100" Dmx="106~155" />
      <Function ID="6" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="156~205" />
    </Attribute>
    <Attribute ID="Colour_Mixing" Name="Colour Mixing" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="2~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Preset" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~15" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~25" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="26~35" Colour="0,0,255" />
      <Function ID="5" Name="Lemon Green" Display="'Lemon Green'" Dmx="36~45" Colour="255,255,0" />
      <Function ID="6" Name="Yellow Green" Display="'Yellow Green'" Dmx="46~55" Colour="180,180,0" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="56~65" Colour="255,255,0" />
      <Function ID="8" Name="Tea Red" Display="'Tea Red'" Dmx="66~75" Colour="255,0,0" />
      <Function ID="9" Name="Light Orange" Display="'Light Orange'" Dmx="76~85" Colour="255,128,0" />
      <Function ID="10" Name="Rose Red" Display="'Rose Red'" Dmx="86~95" Colour="255,0,127" />
      <Function ID="11" Name="Pink" Display="'Pink'" Dmx="96~105" Colour="255,150,150" />
      <Function ID="12" Name="Pink Purple" Display="'Pink Purple'" Dmx="106~115" Colour="128,0,255" />
      <Function ID="13" Name="Light Purple" Display="'Light Purple'" Dmx="116~125" Colour="180,0,255" />
      <Function ID="14" Name="Powder Blue" Display="'Powder Blue'" Dmx="126~135" Colour="0,0,255" />
      <Function ID="15" Name="Light Blue" Display="'Light Blue'" Dmx="136~145" Colour="0,128,255" />
      <Function ID="16" Name="Sky Blue" Display="'Sky Blue'" Dmx="146~155" Colour="0,0,255" />
      <Function ID="17" Name="Light Cyan" Display="'Light Cyan'" Dmx="156~165" Colour="128,255,255" />
      <Function ID="18" Name="Turquoise" Display="'Turquoise'" Dmx="166~175" Colour="0,255,128" />
      <Function ID="19" Name="Aqua" Display="'Aqua'" Dmx="176~185" Colour="0,255,200" />
      <Function ID="20" Name="Light Green" Display="'Light Green'" Dmx="186~195" Colour="128,255,0" />
      <Function ID="21" Name="Cool White" Display="'Cool White'" Dmx="196~205" Colour="230,230,255" />
      <Function ID="22" Name="Light Cool White" Display="'Light Cool White'" Dmx="206~215" Colour="230,230,255" />
      <Function ID="23" Name="Pure White" Display="'Pure White'" Dmx="216~225" Colour="255,255,255" />
      <Function ID="24" Name="Purple White" Display="'Purple White'" Dmx="226~235" Colour="230,230,255" />
      <Function ID="25" Name="Rice White" Display="'Rice White'" Dmx="236~245" Colour="255,255,255" />
      <Function ID="26" Name="Warm White" Display="'Warm White'" Dmx="246~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Full Colours Fade" Display="'Full Colours Fade'" Dmx="11~40" />
      <Function ID="3" Name="R,G,B Fade" Display="'R,G,B Fade'" Dmx="41~70" />
      <Function ID="4" Name="R,G,B Fade+Full Bright White" Display="'R,G,B Fade+Full Bright White'" Dmx="71~100" />
      <Function ID="5" Name="7 Colours Jumping" Display="'7 Colours Jumping'" Dmx="101~130" />
      <Function ID="6" Name="R,G,B Colour Jumping" Display="'R,G,B Colour Jumping'" Dmx="131~160" />
      <Function ID="7" Name="Y,C,P Colour Jumping" Display="'Y,C,P Colour Jumping'" Dmx="161~190" />
      <Function ID="8" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="191~220" />
      <Function ID="9" Name="Sound Colour Chasing" Display="'Sound Colour Chasing'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Function" Name="Macro Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Standard" Display="'Dim Standard'" Dmx="0~0" />
      <Function ID="2" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="21~40" />
      <Function ID="3" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="41~60" />
      <Function ID="4" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="61~80" />
      <Function ID="5" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="81~100" />
      <Function ID="6" Name="High Temp Half Power Off" Display="'High Temp Half Power Off'" Dmx="150~155" />
      <Function ID="7" Name="High Temp Half Power On" Display="'High Temp Half Power On'" Dmx="200~205" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5" Id="9e1c8fce-3aae-485c-a4a2-19af8582dbfb">

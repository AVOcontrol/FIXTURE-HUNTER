  <Macro>
    <Macro Name="High Temp Half Power On">
      <Set Channel="Macro_Function:7" Delay="4000" />
      <Set Channel="Macro_Function:1" Delay="0" />
    </Macro>
    <Macro Name="High Temp Half Power Off">
      <Set Channel="Macro_Function:6" Delay="4000" />
      <Set Channel="Macro_Function:1" Delay="0" />
    </Macro>
  </Macro>

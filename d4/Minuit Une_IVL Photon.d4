  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2408b447-7c44-4abe-bf0e-7368d86ab16c" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="3" />
      <Function ID="1" Name="On - Normal Mode" Display="'On - Normal Mode'" Dmx="255~255" />
      <Function ID="2" Name="On - Fast Mode" Display="'On - Fast Mode'" Dmx="65~125" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="4" Name="Reset Motor" Display="'Reset Motor'" Dmx="24~36" />
      <Function ID="5" Name="Reset Source" Display="'Reset Source'" Dmx="37~51" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="52~64" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="15~27" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="28~227" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="E-Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Beam" Display="'1 Beam'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="2 Beams" Display="'2 Beams'" Dmx="28~55" WheelPosition="0" />
      <Function ID="3" Name="4 Beams" Display="'4 Beams'" Dmx="56~83" WheelPosition="0" />
      <Function ID="4" Name="8 Beams" Display="'8 Beams'" Dmx="84~111" WheelPosition="0" />
      <Function ID="5" Name="16 Beams" Display="'16 Beams'" Dmx="112~139" WheelPosition="0" />
      <Function ID="6" Name="32 Beams" Display="'32 Beams'" Dmx="140~167" WheelPosition="0" />
      <Function ID="7" Name="64 Beams" Display="'64 Beams'" Dmx="168~195" WheelPosition="0" />
      <Function ID="8" Name="128 Beams" Display="'128 Beams'" Dmx="196~223" WheelPosition="0" />
      <Function ID="9" Name="256 Beams" Display="'256 Beams'" Dmx="224~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="E-Gobo Index" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1Rot1" Name="E-Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin (Index)" Display="'No Spin (Index)'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="13~122" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="123~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~242" />
      <Function ID="5" Name="No Spin (Index)" Display="'No Spin (Index)'" Dmx="243~255" />
    </Attribute>
    <Attribute ID="E-Gobo_Size" Name="E-Gobo Size" Description="" Group="G" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom_Speed" Name="Zoom Speed" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sparx 7" ShortName="Sparx 7" Company="JB Lighting">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>0919a282-7421-4774-a9cd-da0cfcd39693</Thumbnail>
  <History Date="29-10-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="27-01-16" Author="Nic Morris" Comment="Added missing shutter functions.  Swapped smiley big and small in Mapping." />
  <History Date="27-01-16" Author="Nic Morris" Comment="Revised colour spread functions.  Revised Sparkle Rot.  Fixed colour function ranges." />
  <History Date="27-01-16" Author="Nic Morris" Comment="Revised P/T and Effect speed functions." />
  <History Date="27-01-16" Author="Nic Morris" Comment="Changed modes 1 and 2 from 3 cells to 2 cells, renamed, removed links to master and moved main channels to master." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="05-06-16" Author="Nic Morris" Comment="Revised mode 1 and mode 2 channel mappping in response to bug report." />
  <History Date="22-06-16" Author="Nic Morris" Comment="Changed control functions to variable ranges in line with manufacturer's documentation in response to bug report." />
  <History Date="22-06-16" Author="Nic Morris" Comment="Added missing macros.  Corrected control function range names.  Set control to default at DMX 071." />
  <History Date="22-06-16" Author="Nic Morris" Comment="Changed macros to return to control default (9:8)" />
  <History Date="15-12-16" Author="Nic Morris" Comment="Increased RGBW wheel resolution.  Reduced BO on Move Speed wheel resolution and revised range (slow-fast)" />
  <History Date="15-12-16" Author="Nic Morris" Comment="Added Mode 4" />
  <History Date="31-10-18" Author="Nic Morris" Comment="Added product thumbnail.  Added missing glow and pattern cell links to modes 1 and 2 (this also ensures they default at zero)" />
  <History Date="31-10-18" Author="Nic Morris" Comment="Changed mode 4 master RGBW to default at zero." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="009064b4-62e4-4d47-a97d-329ed9daefd4" />

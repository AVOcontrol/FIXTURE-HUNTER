  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="afce0af0-b2ce-42fa-8f26-7d490641a1f3" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~56" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="57~80" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="81~104" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="105~128" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="129~152" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="153~176" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="177~200" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="201~224" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="225~248" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="249~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~48" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="49~88" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="89~128" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="129~168" />
      <Function ID="6" Name="White Mode ON" Display="'White Mode ON'" Dmx="169~208" />
      <Function ID="7" Name="White Mode OFF" Display="'White Mode OFF'" Dmx="209~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="20~199" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="200~204" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="205~209" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="210~214" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="215~219" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="220~224" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="225~229" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
  </Control>

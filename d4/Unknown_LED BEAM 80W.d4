      <Function ID="14" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="65~69" WheelPosition="1" />
      <Function ID="15" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="70~74" WheelPosition="2" />

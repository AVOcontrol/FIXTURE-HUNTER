  </Mode>
  <Mode Name="7 DMX" Channels="7" Id="015be66b-c277-4027-b7be-5f9b771ad807">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

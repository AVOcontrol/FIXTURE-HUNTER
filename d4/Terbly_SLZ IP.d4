  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:10" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:11" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:12" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:13" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Shutter">
      <Set Channel="Control:14" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:15" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=2.0">
      <Set Channel="Control:4" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=2,2">
      <Set Channel="Control:5" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=2.4">
      <Set Channel="Control:6" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=2.6">
      <Set Channel="Control:7" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=2.8">
      <Set Channel="Control:8" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gamma=1.0">
      <Set Channel="Control:9" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Home Pos Before Power Off">
      <Set Channel="Control:23" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Home Pos Off">
      <Set Channel="Control:24" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:25" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:26" Delay="9000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="66~78" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="79~91" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="92~104" Colour="0,255,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="105~117" Colour="255,150,150" />
      <Function ID="10" Name="Light Pink" Display="'Light Pink'" Dmx="118~130" Colour="255,200,200" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="131~143" Colour="0,128,255" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="144~156" Colour="0,255,128" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="157~169" Colour="128,255,0" />
      <Function ID="14" Name="Dark Yellow" Display="'Dark Yellow'" Dmx="170~182" Colour="180,180,0" />
      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="183~195" Colour="255,128,0" />
      <Function ID="16" Name="Light Orange" Display="'Light Orange'" Dmx="196~208" Colour="255,128,0" />
      <Function ID="17" Name="Light Red" Display="'Light Red'" Dmx="209~221" Colour="255,100,100" />
      <Function ID="18" Name="CTO" Display="'CTO'" Dmx="222~234" Colour="255,240,200" />
      <Function ID="19" Name="CTB" Display="'CTB'" Dmx="235~247" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Ring_FX" Name="Ring FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Pattern" Display="'No Pattern'" Dmx="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="31~55" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="56~80" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3'" Dmx="81~105" />
      <Function ID="5" Name="Pattern 4" Display="'Pattern 4'" Dmx="106~130" />
      <Function ID="6" Name="Pattern 5" Display="'Pattern 5'" Dmx="131~155" />

      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="181~205" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="206~230" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Ring_FX_Rot" Name="Ring FX Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~44" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="45~125" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="126~129" />

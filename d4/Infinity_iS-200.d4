    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour2Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour2Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour2Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTB 1" Display="'CTB 1'" Dmx="8~15" WheelPosition="1" Colour="200,200,255" />
      <Function ID="3" Name="CTB 2" Display="'CTB 2'" Dmx="16~23" WheelPosition="2" Colour="200,200,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="UV" Display="'UV'" Dmx="32~39" WheelPosition="4" Colour="100,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~47" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Pink-Purple" Display="'Pink-Purple'" Dmx="48~55" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Bright Blue" Display="'Bright Blue'" Dmx="56~63" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Op/ CTB 1" Display="'Op/ CTB 1'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="CTB 1/ CTB 2" Display="'CTB 1/ CTB 2'" Dmx="72~79" WheelPosition="1" Colour="200,200,255" />
      <Function ID="11" Name="CTB 2/ Grn" Display="'CTB 2/ Grn'" Dmx="80~87" WheelPosition="2" Colour="200,200,255" />
      <Function ID="12" Name="Grn/ UV" Display="'Grn/ UV'" Dmx="88~95" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="UV/ Org" Display="'UV/ Org'" Dmx="96~103" WheelPosition="4" Colour="100,0,255" />
      <Function ID="14" Name="Org/ Pk Ppl" Display="'Org/ Pk Ppl'" Dmx="104~111" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Pk Ppl/B Blu" Display="'Pk Ppl/B Blu'" Dmx="112~119" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="B Blu/ Op" Display="'B Blu/ Op'" Dmx="120~127" WheelPosition="7" Colour="0,0,255" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>

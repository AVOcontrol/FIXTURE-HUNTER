<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iS-200" ShortName="iS-200" Company="Infinity">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="13-02-14" Author="Nic Morris" Comment="Created from Showtec_iS-100" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Updated in line with latest manufacturer information" />
  <History Date="13-08-14" Author="Nic Morris" Comment="Updated colours in line with manual in response to customer bug report." />
  <History Date="13-08-14" Author="Nic Morris" Comment="Added physical pan/ tilt limits." />
  <History Date="08-08-15" Author="Nic Morris" Comment="Changed manufacturer from Showtec to Infinity in response to manufacturer request" />
  <History Date="30-06-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="24-09-17" Author="Nic Morris" Comment="Changed name from IS-200 to iS-200.  Revised mode names.  Added colour function index." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ccdad6a8-9a2a-430e-a550-c8984548bdfc" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="146~215" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Light Yellow" Display="'Light Yellow'" Dmx="8~15" WheelPosition="1" Colour="255,255,100" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="16~23" WheelPosition="2" Colour="100,150,255" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="24~31" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="High Transp Red" Display="'High Transp Red'" Dmx="32~39" WheelPosition="4" Colour="255,0,0" />
      <Function ID="6" Name="Rose-Red" Display="'Rose-Red'" Dmx="40~47" WheelPosition="5" Colour="255,0,200" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~55" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="56~63" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ L Yel" Display="'Op/ L Yel'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="L Yel/ L Blu" Display="'L Yel/ L Blu'" Dmx="72~79" WheelPosition="1" Colour="255,255,100" />
      <Function ID="11" Name="L Blu/ L Grn" Display="'L Blu/ L Grn'" Dmx="80~87" WheelPosition="2" Colour="100,150,255" />
      <Function ID="12" Name="L Grn/ Rd" Display="'L Grn/ Rd'" Dmx="88~95" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Rd/ Rs Rd" Display="'Rd/ Rs Rd'" Dmx="96~103" WheelPosition="4" Colour="255,0,0" />
      <Function ID="14" Name="Rs Rd/ Blu" Display="'Rs Rd/ Blu'" Dmx="104~111" WheelPosition="5" Colour="255,0,200" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="112~119" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Panify" ShortName="Panify" Company="Clay Paky" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>ce9bffab-9f5a-4945-af82-2414f888c6f6</Thumbnail>
  <History Date="09-03-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
    <Attribute ID="Spin_Direction" Name="Spin Direction" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CW" Display="'CW'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="126~129" />
      <Function ID="3" Name="CCW" Display="'CCW'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fixture Address Overwrite Enable" Display="'Fixture Address Overwrite Enable'" Dmx="12~24" />
      <Function ID="3" Name="Fixture Address Overwrite Disable" Display="'Fixture Address Overwrite Disable'" Dmx="25~37" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="38~42" />
      <Function ID="5" Name="Display Off" Display="'Display Off'" Dmx="43~47" />
      <Function ID="6" Name="Reset Pan" Display="'Reset Pan'" Dmx="48~52" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Pan_Spin" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Spin_Direction" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fixture Address Overwrite Enable">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fixture Address Overwrite Disable">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="ce9bffab-9f5a-4945-af82-2414f888c6f6"></Swatch>
  </swatchLibrary>
</Fixture>
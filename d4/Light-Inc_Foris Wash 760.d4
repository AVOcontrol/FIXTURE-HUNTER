<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Foris Wash 760" ShortName="ForisWs760" Company="Light-Inc" Version="2">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>4164357e-144e-4c8e-a84c-924e56c172c4</Thumbnail>
  <History Date="09-06-26" Author="Nic Morris" Comment="Created (no pixel layout)" Version="0" />
  <History Date="09-06-26" Author="Nic Morris" Comment="Fix missing vdim in wash cells.  Change implementation of 65 channel mode so that the pixels are for the rings.  It is unclear in the manual what these channels relate to but Capture have used them for the rings, they are only RGB rather than RGBL and there appear to only be 7 wash emitters so this looks reasonable)" Version="2" />

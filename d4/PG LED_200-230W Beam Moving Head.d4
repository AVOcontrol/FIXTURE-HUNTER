      <Function ID="29" Name="Kly/ Am" Display="'Kly/ Am'" Dmx="135~135" WheelPosition="13" Colour="0,255,0" />
      <Function ID="30" Name="Am/ Op" Display="'Am/ Op'" Dmx="145~145" WheelPosition="14" Colour="255,255,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="150~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />

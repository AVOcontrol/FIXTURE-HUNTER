      <Function ID="24" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="200~219" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />

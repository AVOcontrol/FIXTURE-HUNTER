      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="80~99" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="100~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="120~139" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

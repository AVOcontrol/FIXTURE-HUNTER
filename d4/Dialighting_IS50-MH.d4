      <Function ID="10" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

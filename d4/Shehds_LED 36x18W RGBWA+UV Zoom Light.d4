    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Gradient Col Mode" Display="'Gradient Col Mode'" Dmx="6~127" Colour="0,0,0" />
      <Function ID="3" Name="Pulse Col Mode" Display="'Pulse Col Mode'" Dmx="128~191" Colour="0,0,0" />

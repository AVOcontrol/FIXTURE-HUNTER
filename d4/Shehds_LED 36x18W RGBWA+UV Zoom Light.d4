    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO %.f%%',0~100" Dmx="10~41" Colour="255,240,200" />
      <Function ID="3" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="42~255" Colour="0,0,0" />
    </Attribute>
  </Control>

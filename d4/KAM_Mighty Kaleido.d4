  <History Date="20-01-12" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~68" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="69~137" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="138~208" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="209~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCW" Display="'CCW %.1f%%',100.0~0.0" Dmx="0~190" />
      <Function ID="2" Name="CW" Display="'CW %.1f%%',0.0~100.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red + Green" Display="'Red + Green'" Dmx="0~34" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="35~68" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="69~103" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="KA_MTYKAL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Direction" ChannelOffset="2" Wheel="2" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
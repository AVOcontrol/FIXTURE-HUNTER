  <History Date="19-11-19" Author="Nic Morris" Comment="Created from BeamZ Star-Color 240 Wash Light" Version="3" />
  <History Date="21-11-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="29-10-22" Author="Nic Morris" Comment="Updated in line with latest documentation (changes ARC2, ARC2d and adds a 6 channel ARC2s mode)" Version="5" />

      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="8~67" Update="Gobo1" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Effect" Display="'Effect'" Dmx="68~127" Update="Gobo1" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

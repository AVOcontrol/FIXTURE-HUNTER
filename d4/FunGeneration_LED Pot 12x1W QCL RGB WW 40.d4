      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="85~101" Update="Colour_Macro" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="102~118" Update="Colour_Macro" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="119~135" Update="Colour_Macro" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="136~152" Update="Colour_Macro" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="153~169" Update="Colour_Macro" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="170~186" Update="Colour_Macro" />

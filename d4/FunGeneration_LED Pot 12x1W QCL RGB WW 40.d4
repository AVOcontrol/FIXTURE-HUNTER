    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Colour_Macro" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~16" Update="Colour_Macro" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="17~33" Update="Colour_Macro" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="34~50" Update="Colour_Macro" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="51~67" Update="Colour_Macro" />

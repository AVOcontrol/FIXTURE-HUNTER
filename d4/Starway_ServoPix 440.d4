      <Function ID="12" Name="8500K" Display="'8500K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="20~39" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="40~59" />

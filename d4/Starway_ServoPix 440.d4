<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ServoPix 440" ShortName="ServPix440" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>35c7af98-611f-44c6-8c92-ab6354588ecb</Thumbnail>
  <History Date="22-01-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="22-01-15" Author="Gabi de Moitelle" Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Increased wheel resolution.  Fixed PT Speed DMX range" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Fixed DMX range conflict in White Macro." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed hue and saturation to percentage ranges.  Changed RGBW and dimmer to 16 bit.  Removed extraneous attributes." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Added reset macro.  Changed zoom power on to match locate." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed name from ServoPix440 to ServoPix 440.  Fixed colour macro index DMX range." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Standardised." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static 123" Display="'Static 123'" Dmx="10~19" />
      <Function ID="3" Name="Static 456" Display="'Static 456'" Dmx="20~29" />
      <Function ID="4" Name="Static 789" Display="'Static 789'" Dmx="30~39" />
      <Function ID="5" Name="Static 147" Display="'Static 147'" Dmx="40~49" />
      <Function ID="6" Name="Static 258" Display="'Static 258'" Dmx="50~59" />
      <Function ID="7" Name="Static 369" Display="'Static 369'" Dmx="60~69" />
      <Function ID="8" Name="Static 159" Display="'Static 159'" Dmx="70~79" />
      <Function ID="9" Name="Static 357" Display="'Static 357'" Dmx="80~89" />
      <Function ID="10" Name="Square&amp;Dots 1" Display="'Square&amp;Dots 1'" Dmx="90~99" />
      <Function ID="11" Name="Square&amp;Dots 2" Display="'Square&amp;Dots 2'" Dmx="100~109" />
      <Function ID="12" Name="Vert Lines1" Display="'Vert Lines1'" Dmx="110~119" />
      <Function ID="13" Name="Vert lines 2" Display="'Vert lines 2'" Dmx="120~129" />
      <Function ID="14" Name="Hor Lines 1" Display="'Hor Lines 1'" Dmx="130~139" />
      <Function ID="15" Name="Hor Lines 2" Display="'Hor Lines 2'" Dmx="140~149" />
      <Function ID="16" Name="Shake" Display="'Shake'" Dmx="150~159" />
      <Function ID="17" Name="Bow Runner" Display="'Bow Runner'" Dmx="160~169" />
      <Function ID="18" Name="Anticlock" Display="'Anticlock'" Dmx="170~179" />
      <Function ID="19" Name="Clock" Display="'Clock'" Dmx="180~189" />
      <Function ID="20" Name="Star" Display="'Star'" Dmx="190~199" />
      <Function ID="21" Name="Antistar" Display="'Antistar'" Dmx="200~209" />
      <Function ID="22" Name="Dot Chase" Display="'Dot Chase'" Dmx="210~219" />
      <Function ID="23" Name="Anti Dot Chase" Display="'Anti Dot Chase'" Dmx="220~229" />
      <Function ID="24" Name="Rnd Dot" Display="'Rnd Dot'" Dmx="230~239" />
      <Function ID="25" Name="Rnd Lines" Display="'Rnd Lines'" Dmx="240~249" />
      <Function ID="26" Name="Rnd Dark Spot" Display="'Rnd Dark Spot'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~169" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="170~200" Colour="0,0,0" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="5900K" Display="'5900K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="7200K" Display="'7200K'" Dmx="231~235" Colour="0,0,0" />

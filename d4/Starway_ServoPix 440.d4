      <Function ID="8" Name="Auto1" Display="'Auto1'" Dmx="140~149" />
      <Function ID="9" Name="Auto2" Display="'Auto2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound1" Display="'Sound1'" Dmx="180~189" />
      <Function ID="13" Name="Sound2" Display="'Sound2'" Dmx="190~199" />

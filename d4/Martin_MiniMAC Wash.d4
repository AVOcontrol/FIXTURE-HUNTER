  <Macro>
    <Macro Name="Reset">
      <Set Channel="Colour1Func:1,Colour1:13,Dimmer:10" Delay="5000" />
      <Set Channel="Colour1:1,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Dimmer:12" Delay="6000" />
      <Set Channel="Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Dimmer:11" Delay="6000" />
      <Set Channel="Dimmer:1:0" Delay="0" />
    </Macro>
  </Macro>

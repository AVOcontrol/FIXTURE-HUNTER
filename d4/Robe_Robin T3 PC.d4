  <History Date="08-11-16" Author="Nic Morris" Comment="Revised Cyan and Lt Green attributes to use CyanAdditive and Lime reserved ID's." Version="8" />
  <History Date="25-01-17" Author="Peter Budd" Comment="Added Open ranges on Gobo Wheels, corrected blade rotate functions, re-implemented Nics V1.6 changes and added P/T Speed." Version="9" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (RoboSpot control functions/macros)" Version="10" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised colour macro function names.  Added gobo 1 index functions.  Revised gobo 1 scroll ranges." Version="11" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised mode names with channel counts.  Simplified frost and iris ranges.  Inverted zoom." Version="12" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised frame attribute ID's for correct alighnment with Attribute Editor controls." Version="13" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Recreated palettes with frost and iris." Version="14" />
  <History Date="24-10-17" Author="Nic Morris" Comment="Unification across product range." Version="15" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added product thumbnail" Version="16" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added gobo swatches" Version="17" />
  <History Date="06-09-18" Author="Nic Morris" Comment="Created from Robe Robin DL7S Profile" Version="18" />
  <History Date="11-09-18" Author="Nic Morris" Comment="Added R20" Version="19" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Updated in line with v1.3 charts." Version="20" />
  <History Date="19-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches.  Updated in line with v1.4 charts." Version="21" />
  <History Date="21-02-19" Author="Nic Morris" Comment="Created from Robe Robin T1 Profile (DMX protocol chart Version 0.9)" Version="22" />
  <History Date="16-05-19" Author="Nic Morris" Comment="Added product thumbnail.  Fixed CTC DMX ranges." Version="23" />
  <History Date="18-05-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="24" />
  <History Date="30-03-21" Author="Nic Morris" Comment="Created from Robe Robin T1 Wash" Version="25" />
  <History Date="14-06-21" Author="Nic Morris" Comment="Added product thumbnail" Version="26" />
  <History Date="27-05-22" Author="Nic Morris" Comment="Added Atlabase ID's. Updated in line with v1.1 charts (adds green correction functions and macros)" Version="27" />
  <History Date="27-06-25" Author="Nic Morris" Comment="Created from Robe Robin T2 Fresnel (note CTC ranges cannot be supported as they can change at a fixture level)" Version="28" />
  <History Date="28-08-25" Author="Nic Morris" Comment="Added full range option for frost and revised CTC functions (based on extended CTC range) in response to manufacturer request." Version="29" />
  <History Date="02-09-25" Author="Nic Morris" Comment="Added full range option for CTC in response to manufacturer request." Version="30" />
  <History Date="30-09-25" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (revises frost functions)" Version="31" />
  <History Date="14-11-25" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (adds/revisies and renames green correction functions/macros)" Version="33" />
  <History Date="21-11-25" Author="Nic Morris" Comment="Updated in line with v1.5 charts." Version="34" />
  <History Date="09-01-26" Author="Nic Morris" Comment="Updated in line with v1.6 charts in response to manufacturer request (changes mode 2 to 25 channels with 16bit dimmer.  adds static p/t reset and calibration control functions/macros).  Added Atlabase IDs and product thumbnail." Version="36" />
  <History Date="11-03-26" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (revises frost functions)" Version="37" />
  <History Date="11-03-26" Author="Nic Morris" Comment="Corrected CTC full range (was inverted)." Version="38" />
  <History Date="20-07-26" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds High function to LED Freq Sel channel)" Version="39" />

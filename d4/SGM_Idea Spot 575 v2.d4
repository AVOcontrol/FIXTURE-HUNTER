      <Attribute ID="Zoom_Focus" ChannelOffset="13" Wheel="19" />
      <Attribute ID="Iris" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
      <Attribute ID="Frost" ChannelOffset="16" Wheel="21" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:4" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:2,Gobo2:1,Gobo2Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:2,Gobo2:1,Gobo2Func:1" />

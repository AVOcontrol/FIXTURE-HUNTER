<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HALO" ShortName="HALO" Company="Lite Tek" Version="19">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>cc5987e9-5f8c-407c-bddb-cdfced1a9e81</Thumbnail>
  <History Date="20-09-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="06-10-11" Author="Nic Morris" Comment="Simplified shutter.  Fixed Aura Colour update and conditionals.  Added macros." Version="2" />
  <History Date="14-10-11" Author="John Rogers" Comment="Added 14 DMX mode." Version="3" />
  <History Date="25-11-11" Author="John Rogers" Comment="Added display name." Version="4" />
  <History Date="13-03-12" Author="Peter Budd" Comment="Unhid Cells called them Beam and Aura." Version="5" />
  <History Date="04-05-12" Author="Peter Budd" Comment="Added a physical pan tilt speed from the Robe 300LED Wash" Version="6" />
  <History Date="17-05-12" Author="Gregory Haynes" Comment="Renamed cells to 'Beam Part' and 'Aura Part'" Version="7" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Updated to bring P/T, Zoom, Effects and Control channels back into master fixture in 25 DMX mode." Version="8" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." Version="9" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="10" />
  <History Date="20-03-14" Author="Nic Morris" Comment="Changed 25 DMX pearl ref to match 14 DMX for vis" Version="11" />
  <History Date="01-07-14" Author="Peter Budd" Comment="Ended the cell with a number so the 25 DMX  mode will exchange in 7." Version="12" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="13" />
  <History Date="07-07-16" Author="Nic Morris" Comment="Removed broken condition from pan.  Removed aura cell attribute links." Version="14" />
  <History Date="14-04-21" Author="Nic Morris" Comment="Changed shutter open to 255 for improved compatibility.  Added product thumbnail." Version="15" />
  <History Date="30-08-22" Author="Nic Morris" Comment="Added Color Calib Off modes.  These simulate the white control separately unlike the original (Color Calib Off) modes where the white is not used and instead is calcluated from the RGB controls." Version="16" />
  <History Date="30-08-22" Author="Nic Morris" Comment="As this is a fixture level option it is currently impossible to know which mode the fixture is in meaning we need to use separate modes." Version="16" />
  <History Date="30-08-22" Author="Nic Morris" Comment="This necessitated renaming existing for clarity.  Took opportunity to use the Standard and Extended names in line with the latest documentation." Version="16" />
  <History Date="30-08-22" Author="Nic Morris" Comment="Re-added auta cell attribute links (for compatiblity with various software functions all cell attributes need to be linked to master attributes)." Version="16" />
  <History Date="30-08-22" Author="Nic Morris" Comment="Inverted zoom and strobe functions in line with latest charts (fast-&gt;slow).  Updated CTC to Kelvin and added open range.  Added shutter palettes." Version="16" />
  <History Date="21-02-23" Author="Nic Morris" Comment="Created from Martin MAC Aura (effects not documented - assumed identical)" Version="17" />
  <History Date="24-02-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="18" />
  <History Date="04-10-23" Author="Nic Morris" Comment="Created from V-Show AURA1915 (very poor documentation)" Version="19" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7b06d34d-55d2-4579-a105-6fff37c27f4b" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pulse" Display="'Rnd Op Pulse %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pulse" Display="'Rnd Cl Pulse %.f%%',0~100" Dmx="164~150" Intensity="0~0" />
      <Function ID="9" Name="Burst Pulse" Display="'Burst Pulse %.f%%',0~100" Dmx="184~170" Intensity="0~0" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Sine Wave" Display="'Sine Wave %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~14" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:10000" PowerOn="1:10000" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2500~10000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_3" Name="Effect 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_4" Name="Effect 4" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Sync" Name="Effect Sync" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14" Id="d2f39a87-6ddd-4c2c-b142-7c707262620a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="0" />
      <Size Height="0" Width="0" Depth="0" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4dad39c6-90d1-4e7b-9094-ada6fe6c10a2" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
      <Attribute ID="Colour1" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="40" />
      <Attribute ID="CTC" ChannelOffset="14" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="25 DMX" Channels="25" Id="a86168c9-46de-4608-9966-8fd800f411ab">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="0" />
      <Size Height="0" Width="0" Depth="0" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7d37e76e-c935-410e-8a64-aced335e30a0" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
        <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
        <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
        <Attribute ID="CTC" ChannelOffset="14" Wheel="9" />
        <Attribute ID="Effect_1" ChannelOffset="15" Wheel="22" />
        <Attribute ID="Effect_2" ChannelOffset="16" Wheel="23" />
        <Attribute ID="Effect_3" ChannelOffset="17" Wheel="24" />
        <Attribute ID="Effect_4" ChannelOffset="18" Wheel="52" />
        <Attribute ID="Effect_Sync" ChannelOffset="19" Wheel="53" />
      </Master>
      <Cell ID="Cell1" Name="Beam Part 1" ChannelOffset="1" ModeLink="Beam Cell, 15  DMX" X="0" Y="0">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell2" Name="Aura Part 2" ChannelOffset="20" ModeLink="Aura Part, 6 DMX" X="0" Y="1">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Beam Cell, 15  DMX" Channels="7" Hidden="True" Id="fb7e4fd9-10b3-4e66-8f5c-3ad72236aba1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

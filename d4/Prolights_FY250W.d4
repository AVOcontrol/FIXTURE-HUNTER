      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="9" />
      <Attribute ID="xSaturation" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="7" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
      <Attribute ID="Effect" ChannelOffset="15" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="PG_FY250W_B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5d54c49b-b7d9-4507-bf3c-c63200459bef" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" />
      <Attribute ID="xSaturation" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="7" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

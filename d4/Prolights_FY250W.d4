  <History Date="05-03-13" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="26-09-13" Author="Peter Budd" Comment="Created from the Chauvet Inimidator Wash LED 150." Version="2" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="3" />
  <History Date="13-08-16" Author="Nic Morris" Comment="Changed name from Fury FY250W to FY250W" Version="4" />
  <History Date="13-08-16" Author="Nic Morris" Comment="Increased wheel resolution." Version="5" />
  <History Date="13-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed saturation ID for compatibility." Version="7" />
  <History Date="10-08-22" Author="Nic Morris" Comment="Revised dimmer in response to customer feedback (documentation details as 8-132 = 0-&gt;100% but in reality it is inverted)." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8c919dfa-d076-44cf-8a49-def74c270115" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="2:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="132~8" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="134~239" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="240~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGBW" Display="'RGBW'" Dmx="8~21" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~35" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="36~49" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="50~63" Colour="0,255,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="64~77" Colour="255,255,255" />
      <Function ID="7" Name="Macro 1" Display="'Macro 1'" Dmx="78~91" Colour="0,0,0" />
      <Function ID="8" Name="Macro 2" Display="'Macro 2'" Dmx="92~105" Colour="0,0,0" />
      <Function ID="9" Name="Macro 3" Display="'Macro 3'" Dmx="106~119" Colour="0,0,0" />
      <Function ID="10" Name="Macro 4" Display="'Macro 4'" Dmx="120~133" Colour="0,0,0" />
      <Function ID="11" Name="Macro 5" Display="'Macro 5'" Dmx="134~147" Colour="0,0,0" />
      <Function ID="12" Name="Macro 6" Display="'Macro 6'" Dmx="148~161" Colour="0,0,0" />
      <Function ID="13" Name="Macro 7" Display="'Macro 7'" Dmx="162~175" Colour="0,0,0" />
      <Function ID="14" Name="Macro 8" Display="'Macro 8'" Dmx="176~189" Colour="0,0,0" />
      <Function ID="15" Name="Macro 9" Display="'Macro 9'" Dmx="190~203" Colour="0,0,0" />
      <Function ID="16" Name="Macro 10" Display="'Macro 10'" Dmx="204~217" Colour="0,0,0" />
      <Function ID="17" Name="Macro 11" Display="'Macro 11'" Dmx="218~231" Colour="0,0,0" />
      <Function ID="18" Name="Moveable" Display="'Moveable'" Dmx="232~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="8~27" />
      <Function ID="3" Name="Reset Pan" Display="'Reset Pan'" Dmx="148~167" />
      <Function ID="4" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="168~187" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="228~247" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~23" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="24~39" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="40~55" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="56~71" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="72~87" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="88~103" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="104~119" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="120~135" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="136~151" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="152~167" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="168~183" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="184~199" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="200~215" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="216~231" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="232~247" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="PG_FY250W_X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

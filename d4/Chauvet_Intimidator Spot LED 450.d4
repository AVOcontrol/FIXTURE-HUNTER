    </Include>
  </Mode>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="CH_ISL4508" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="530" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intimidator Spot LED 450" ShortName="I Spot 450" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="22-07-10" Author="Jonathan Moreton" Comment="Created from Q-Spot 150 LED" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="17-06-13" Author="Peter Budd" Comment="Created from the Chauvet Q-Spot 260 LED." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="72586896-05ff-4ab5-9045-caf2988d5866" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="8~15" Colour="0,0,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" Colour="255,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="24~31" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="40~47" Colour="255,0,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="48~55" Colour="0,128,255" />
      <Function ID="8" Name="Orange Red" Display="'Orange Red'" Dmx="56~63" Colour="255,0,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="64~66" Colour="255,255,255" />
      <Function ID="10" Name="Open/Blue" Display="'Open/Blue %.f%%',0~100" Dmx="67~78" Colour="255,255,255" />
      <Function ID="11" Name="Blue/Yell" Display="'Blue/Yell %.f%%',0~100" Dmx="79~92" Colour="0,0,255" />
      <Function ID="12" Name="Yell/Pink" Display="'Yell/Pink %.f%%',0~100" Dmx="93~107" Colour="255,255,0" />
      <Function ID="13" Name="Pink/Green" Display="'Pink/Green %.f%%',0~100" Dmx="108~120" Colour="255,150,150" />
      <Function ID="14" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="121~136" Colour="0,255,0" />
      <Function ID="15" Name="Red/Lt Blue" Display="'Red/Lt Blue %.f%%',0~100" Dmx="137~152" Colour="255,0,0" />
      <Function ID="16" Name="Lt Blue/Orange" Display="'Lt Blue/Orange %.f%%',0~100" Dmx="153~170" Colour="0,128,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="171~212" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="213~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="GoboRot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func" ID="1,2,3,4" If="'GoboFunc'==4||'GoboFunc'==2||'GoboFunc'==6" />
      <Condition Name="Fixed_Func_Ind" ID="6" If="'GoboFunc'==1||'GoboFunc'==3||'GoboFunc'==5" />
      <Else ID="5" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="61~158" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="159~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~60" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism_Func" ID="1,2" If="'Prism_Func'==1" />
      <Condition Name="Prism_Func_Spin" ID="3,4" If="'Prism_Func'==2" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~12" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="131~247" />
      <Function ID="4" Name="Spin" Display="'Spin %.f%%',100~0" Dmx="13~130" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~3" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~7" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="146~215" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="216~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="8~15" />
      <Function ID="3" Name="BO on Colour" Display="'BO on Colour'" Dmx="16~23" />
      <Function ID="4" Name="BO on Gobo" Display="'BO on Gobo'" Dmx="24~31" />
      <Function ID="5" Name="NO BO on P/T/Col" Display="'NO BO on P/T/Col'" Dmx="32~39" />
      <Function ID="6" Name="No BO on P/T/Gobo" Display="'No BO on P/T/Gobo'" Dmx="40~47" />
      <Function ID="7" Name="No BO on All" Display="'No BO on All'" Dmx="48~55" />
      <Function ID="8" Name="Safe" Display="'Safe'" Dmx="56~95" />
      <Function ID="9" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="10" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="11" Name="Reset Colour" Display="'Reset Colour'" Dmx="112~119" />
      <Function ID="12" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="13" Name="Reset Gobo Rotate" Display="'Reset Gobo Rotate'" Dmx="128~135" />
      <Function ID="14" Name="Reset Prism" Display="'Reset Prism'" Dmx="136~143" />
      <Function ID="15" Name="Reset Focus" Display="'Reset Focus'" Dmx="144~151" />
      <Function ID="16" Name="Reset" Display="'Reset'" Dmx="152~159" />
      <Function ID="17" Name="Safe" Display="'Safe'" Dmx="160~255" />
    </Attribute>
    <Attribute ID="GoboFunc" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="GoboRot, Gobo" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func_Ind" ID="1,2,3,4,5,6,7,8" If="'GoboFunc'==1||'GoboFunc'==2" />
      <Condition Name="Shake_Func_Ind" ID="9,10,11,12,13,14,15,16" If="'GoboFunc'==3||'GoboFunc'==4" />
      <Condition Name="Scroll_Func_Ind" ID="17,18,19,20" If="'GoboFunc'==6||'GoboFunc'==5" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="119~119" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Prism_Func" Display="'Prism'" Dmx="0~0" Update="Prism" />
      <Function ID="2" Name="Prism_Func_Spin" Display="'Prism Func    Spin'" Dmx="0~0" Update="Prism" />
      <Function ID="3" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Prism" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="PT_Macro" Name="P/T Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~7" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~23" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="24~39" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="40~55" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="56~71" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="72~87" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="88~103" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="104~119" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="120~135" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="136~151" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="152~167" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="168~183" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="184~199" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="200~215" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="216~231" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="232~247" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX, 16bit" Channels="14">
    <Import PearlRef="CH_ISL45014" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="530" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="96016eac-8d34-4a64-bafa-6c2d2bf32629" />
    <Include>

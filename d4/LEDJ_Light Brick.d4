      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="32~39" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="40~47" Colour="255,150,150" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="48~55" Colour="0,255,128" />
      <Function ID="8" Name="Cold White" Display="'Cold White'" Dmx="56~63" Colour="230,230,255" />
      <Function ID="9" Name="Yellow Green" Display="'Yellow Green'" Dmx="64~71" Colour="180,180,0" />
      <Function ID="10" Name="Light Pink" Display="'Light Pink'" Dmx="72~79" Colour="255,200,200" />

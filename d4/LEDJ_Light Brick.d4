      <Function ID="17" Name="Neutral White" Display="'Neutral White'" Dmx="128~135" Colour="255,240,200" />
      <Function ID="18" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="136~195" Colour="255,255,255" />
      <Function ID="19" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="196~255" Colour="255,255,255" />

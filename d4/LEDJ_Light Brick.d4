      <Function ID="12" Name="Golden Yellow" Display="'Golden Yellow'" Dmx="88~95" Colour="255,255,0" />
      <Function ID="13" Name="Light Blue" Display="'Light Blue'" Dmx="96~103" Colour="0,128,255" />
      <Function ID="14" Name="Light Pink" Display="'Light Pink'" Dmx="104~111" Colour="255,200,200" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="112~119" Colour="255,150,150" />

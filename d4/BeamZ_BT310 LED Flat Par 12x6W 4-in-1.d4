  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="28f92644-b25e-4e6a-96de-10d7a6e528c4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="40~49" Colour="255,100,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="50~59" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="70~79" Colour="0,255,255" />
      <Function ID="9" Name="Dark Orange" Display="'Dark Orange'" Dmx="80~89" Colour="255,100,0" />
      <Function ID="10" Name="Green Yellow" Display="'Green Yellow'" Dmx="90~99" Colour="180,180,0" />
      <Function ID="11" Name="Salmon" Display="'Salmon'" Dmx="100~109" Colour="255,150,150" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="110~119" Colour="0,255,128" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="120~129" Colour="128,255,0" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="130~139" Colour="255,128,0" />
      <Function ID="15" Name="Lavender" Display="'Lavender'" Dmx="140~149" Colour="255,128,255" />
      <Function ID="16" Name="Light Blue" Display="'Light Blue'" Dmx="150~159" Colour="0,128,255" />
      <Function ID="17" Name="Dark Blue" Display="'Dark Blue'" Dmx="160~169" Colour="0,0,180" />
      <Function ID="18" Name="Pink" Display="'Pink'" Dmx="170~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blend" Display="'Blend %.f%%',0~100" Dmx="10~69" Colour="255,255,255" />
      <Function ID="3" Name="Change" Display="'Change %.f%%',0~100" Dmx="70~129" Colour="255,255,255" />
      <Function ID="4" Name="Blend Sound" Display="'Blend Sound %.f%%',0~100" Dmx="130~189" Colour="255,255,255" />
      <Function ID="5" Name="Change Sound" Display="'Change Sound %.f%%',0~100" Dmx="190~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKBZ3101" DiamondRef="" WysiwygRef="" />
    <Physical>

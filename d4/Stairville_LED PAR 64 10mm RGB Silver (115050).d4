      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="72~79" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="80~87" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="88~95" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="96~103" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="104~111" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="112~119" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="120~127" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="128~135" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="136~143" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="144~151" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="152~159" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="160~167" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="168~175" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="176~183" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="184~191" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="192~199" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="200~207" />
      <Function ID="27" Name="Macro 26" Display="'Macro 26'" Dmx="208~215" />
      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="216~223" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="224~231" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="232~239" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="240~247" />
      <Function ID="32" Name="Macro 31" Display="'Macro 31'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;8" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour Mix" Display="'Colour Mix'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Fade Out" Display="'Fade Out'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Fade In" Display="'Fade In'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="96~127" Update="Shutter" />
      <Function ID="5" Name="Auto Mix" Display="'Auto Mix'" Dmx="128~159" Update="Shutter" />
      <Function ID="6" Name="3 Col Chase" Display="'3 Col Chase'" Dmx="160~191" Update="Shutter" />
      <Function ID="7" Name="7 Col Chase" Display="'7 Col Chase'" Dmx="192~223" Update="Shutter" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="SVP6410S" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="513edaaa-974c-40ad-9a69-4b7be1996b90" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Macro" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Mode" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

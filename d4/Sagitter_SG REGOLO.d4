<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SG REGOLO" ShortName="SG REGOLO" Company="Sagitter">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="10-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="4" Name="Strb All" Display="'Strb All %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="5" Name="Zone FX 1" Display="'Zone FX 1 %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="6" Name="Zone FX 2" Display="'Zone FX 2 %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="8" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
      <Function ID="9" Name="Rnd Strb 1" Display="'Rnd Strb 1 %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="10" Name="Rnd Strb 2" Display="'Rnd Strb 2 %.f%%',0~100" Dmx="176~191" Intensity="0~0" />
      <Function ID="11" Name="Rnd Strb All" Display="'Rnd Strb All %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~49" />
      <Function ID="2" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="3" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="4" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="5" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="6" Name="Theatre ON" Display="'Theatre ON'" Dmx="90~99" />
      <Function ID="7" Name="Theatre OFF" Display="'Theatre OFF'" Dmx="100~109" />
      <Function ID="8" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="9" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="10" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Hal" Display="'2700K Hal'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Hal" Display="'3200K Hal'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~31" />
      <Function ID="2" Name="Fine" Display="'Fine'" Dmx="32~127" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="128~223" />
      <Function ID="4" Name="Normal" Display="'Normal'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Aura_Col" Name="Aura Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~3" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="4~6" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Aura_Red" Name="Aura Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Aura_Green" Name="Aura Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Aura_Blue" Name="Aura Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 24 DMX" Channels="24">

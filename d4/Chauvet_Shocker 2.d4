  <History Date="24-01-20" Author="Nic Morris" Comment="Changed master dimmer to default at zero in attempt to fix customer bug report." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="50e612fb-9c3d-4220-9228-a2ee1cb782cd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~132" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~27" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="28~44" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="45~61" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="62~78" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="79~95" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="96~112" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="113~129" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="130~146" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="147~163" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="164~180" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="181~197" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="198~214" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="215~231" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="232~249" Update="Auto_Spd" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2,3" If="'Auto'==16||'Auto1'==8" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Master/Slave" Name="Master/Slave" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Master" Display="'Master'" Dmx="7~50" />
      <Function ID="3" Name="Slave 1" Display="'Slave 1'" Dmx="51~100" />
      <Function ID="4" Name="Slave 2" Display="'Slave 2'" Dmx="101~150" />
      <Function ID="5" Name="Slave 3" Display="'Slave 3'" Dmx="151~200" />
      <Function ID="6" Name="Slave 4" Display="'Slave 4'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~40" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~80" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="81~120" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="121~170" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="171~220" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="221~249" Update="Auto_Spd" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
  </Control>

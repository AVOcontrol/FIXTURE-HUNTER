      <Set Channel="P/T_Spd_Macro:1" Delay="0" />
    </Macro>
    <Macro Name="Linear">
      <Set Channel="P/T_Spd_Macro:5" Delay="6000" />
      <Set Channel="P/T_Spd_Macro:1" Delay="0" />
    </Macro>
  </Macro>

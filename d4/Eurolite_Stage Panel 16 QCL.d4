  <AtlaBase TypeID="d5bf1891-41eb-47d0-b243-02cce2b5a7fe" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Wram White" Display="'Wram White'" Dmx="40~49" Colour="255,240,200" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="50~59" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="70~79" Colour="0,255,255" />
      <Function ID="9" Name="Dark Orange" Display="'Dark Orange'" Dmx="80~89" Colour="255,100,0" />
      <Function ID="10" Name="Green Yellow" Display="'Green Yellow'" Dmx="90~99" Colour="180,180,0" />
      <Function ID="11" Name="Salmon" Display="'Salmon'" Dmx="100~109" Colour="255,150,150" />
      <Function ID="12" Name="Turquoise" Display="'Turquoise'" Dmx="110~119" Colour="0,255,128" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="120~129" Colour="128,255,0" />
      <Function ID="14" Name="Orange" Display="'Orange'" Dmx="130~139" Colour="255,128,0" />
      <Function ID="15" Name="Straw" Display="'Straw'" Dmx="140~149" Colour="255,250,230" />
      <Function ID="16" Name="Lavender" Display="'Lavender'" Dmx="150~159" Colour="255,128,255" />
      <Function ID="17" Name="Light Blue" Display="'Light Blue'" Dmx="160~169" Colour="0,128,255" />
      <Function ID="18" Name="Dark Blue" Display="'Dark Blue'" Dmx="170~179" Colour="0,0,180" />
      <Function ID="19" Name="Pink" Display="'Pink'" Dmx="180~189" Colour="255,150,150" />
      <Function ID="20" Name="Full On" Display="'Full On'" Dmx="190~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="30~39" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="40~49" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="50~59" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="60~69" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="70~79" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="80~89" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="90~99" />
      <Function ID="11" Name="Sound 1" Display="'Sound 1'" Dmx="100~109" />
      <Function ID="12" Name="Sound 2" Display="'Sound 2'" Dmx="110~119" />
      <Function ID="13" Name="Sound 3" Display="'Sound 3'" Dmx="120~129" />
      <Function ID="14" Name="Sound 4" Display="'Sound 4'" Dmx="130~139" />
      <Function ID="15" Name="Sound 5" Display="'Sound 5'" Dmx="140~149" />
      <Function ID="16" Name="Sound 6" Display="'Sound 6'" Dmx="150~159" />
      <Function ID="17" Name="Sound 7" Display="'Sound 7'" Dmx="160~169" />
      <Function ID="18" Name="Sound 8" Display="'Sound 8'" Dmx="170~179" />
      <Function ID="19" Name="Sound 9" Display="'Sound 9'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Studio Par Platinum 20x3W RGB" ShortName="StPar 20x3" Company="Ignition">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-11-11" Author="Nic Morris" Comment="Created" />
  <History Date="23-01-14" Author="Nic Morris" Comment="Modified shutter ranges in response to customer bug report" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="01-01-17" Author="Nic Morris" Comment="Added '20x3W RGB' to name to differentiate from other models." />
  <History Date="01-01-17" Author="Nic Morris" Comment="Fixed Atlabase ID's (previously referenced 18x4W version which is RGBW with different mappings)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1ae8ed21-61a4-49a4-a30e-9ac1592b1e30" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',1~255" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="32~63" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="64~95" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="96~127" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="128~159" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="160~191" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="192~223" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1,1 DMX" Channels="1">
    <Import PearlRef="UK_IGSPP1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cb221003-e6e9-4cae-a1fb-b0498d4dd800" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 2 DMX" Channels="2">
    <Import PearlRef="UK_IGSPP2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9d46f29b-10c0-40db-9757-6cd68d068d31" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 3 DMX" Channels="3">

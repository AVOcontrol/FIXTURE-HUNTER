  <Mode Name="16 DMX" Channels="16" Id="68632c35-27ae-474c-88f6-cf5c206f3fbc">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

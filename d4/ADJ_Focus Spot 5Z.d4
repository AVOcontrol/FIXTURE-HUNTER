  <History Date="07-01-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="11-06-20" Author="Nic Morris" Comment="Created from American DJ Focus Spot 4Z (note charts contain errors - basic mode has no channel 17.  assumed 18 total.  conflicting ranges in gobo rot.)" Version="2" />
  <History Date="11-06-20" Author="Nic Morris" Comment="(no gobo images available.  left as the Focus Spot 4Z for now)" Version="2" />
  <History Date="28-04-23" Author="Nic Morris" Comment="Added Dim Mode to Basic mode in response to customer feedback (still missing from documentation)." Version="3" />
  <History Date="28-04-23" Author="Nic Morris" Comment="Revised gobo swatches and colour 2 function names in line with latest documentation." Version="3" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Focus Spot 5Z.d4 to ADJ_Focus Spot 5Z.d4." Version="4" />

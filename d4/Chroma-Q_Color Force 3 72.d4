  <Thumbnail>54605897-a852-4c0b-bdc4-52c00d6e54af</Thumbnail>
  <History Date="16-06-26" Author="Nic Morris" Comment="Created (silly number of modes.  included separate Main and SparQle patch only.  the resulting number of permutations for the Main+SparQle auto-follow is impractical with more than 1000 modes.  Even without this there are 150)" Version="0" />
  <History Date="16-06-26" Author="Nic Morris" Comment="(for auto-follow patch the appropriate Main followed by SparQle modes)" Version="13" />
  <History Date="18-06-26" Author="Nic Morris" Comment="Added control mode (the fixture has an option to address this independently)" Version="29" />
  <History Date="20-06-26" Author="Nic Morris" Comment="Corrected RGBA Cmp (By1 16b) mapping.  Corrected SparQle mapping.  Added Atlabase ID's." Version="30" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d161764a-fd54-4373-9208-12f971277918" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">

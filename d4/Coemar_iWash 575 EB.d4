<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iWash 575 EB" ShortName="iWash575EB" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-01-03" Author="D.Shelton" Comment="Created" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. M Speed - Inverted to match LX version and 0-100% in DMX scroll for vector + tracking" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Shutter - Shutter close pulse DMX inverted for 0-100%" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Colour Pos - Needs to be modified to match LX" />
  <History Date="26-05-04" Author="Greg Brown" Comment="Above Errors Corrected" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Vector and Tracking are inverted on MSpeed channel" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Dimmer should power on at min value" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Shutter should power on open" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Close pulse is inverted and Rand strobe needs renaming on Shutter channel" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Zoom channel should locate and power on at 50%" />
  <History Date="11-08-05" Author="Ed" Comment="Error: No raw DMX on colour" />
  <History Date="11-08-05" Author="Ed" Comment="Error: DMX ranges are incorrect on effect channel" />
  <History Date="11-08-05" Author="Ed" Comment="Fixed all above problems" />
  <History Date="05-04-06" Author="Ed" Comment="Changed Beam shape to beam group" />
  <History Date="07-07-06" Author="Ed" Comment="Changed CMY Mixing attributes to proper CMIXes" />
  <History Date="11-07-06" Author="Ed" Comment="Added zoom angles" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="08-05-12" Author="Peter Budd" Comment="Added Highlight and Lowlightvalues, and preset palettes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-10-17" Author="Nic Morris" Comment="Changed name from I Wash 575 EB to iWash 575 EB.  Standardised highlight/lowlight." />
  <History Date="16-10-17" Author="Nic Morris" Comment="Added colour function index." />
  <Manual Filename="/manual/Coemar_IWash 575 EB.pdf" Summary="Created:Massimo, 30/1/2001,06/06/2001" />
  <AtlaBase TypeID="7585a26f-71d7-4ad9-b3c9-3430b06ce8d3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Ultra Fast" Display="'Ultra Fast'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Tracking" Display="'Tracking %.1f%%',0.0~100.0" Dmx="247~128" />
      <Function ID="5" Name="Tracking Slow" Display="'Tracking Slow'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~66" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="188~244" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="69~125" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="128~184" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:16" PowerOn="1:16" />
      <Function ID="1" Name="Zoom" Display="'%.2f',9.00~23.00" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Beam_Shape" Name="Beam Shape" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Beam Shape" Display="'Beam Shape %.1f°',0.0~180.0" Dmx="10~230" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="CTO Filter" Display="'CTO Filter'" Dmx="231~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~27" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="28~47" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="48~67" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="68~87" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="88~107" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="108~127" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Col 1/Col2" Display="'Col 1/Col2 %.f%%',0~100" Dmx="8~27" WheelPosition="1" Colour="0,0,0" />
      <Function ID="10" Name="Col 2/Col 3" Display="'Col 2/Col 3 %.f%%',0~100" Dmx="28~47" WheelPosition="2" Colour="0,0,0" />
      <Function ID="11" Name="Col3/ Col 4" Display="'Col3/ Col 4 %.f%%',0~100" Dmx="48~67" WheelPosition="3" Colour="0,0,0" />
      <Function ID="12" Name="Col 4/Col 5" Display="'Col 4/Col 5 %.f%%',0~100" Dmx="68~87" WheelPosition="4" Colour="0,0,0" />
      <Function ID="13" Name="Col 5/Col 6" Display="'Col 5/Col 6 %.f%%',0~100" Dmx="88~107" WheelPosition="5" Colour="0,0,0" />
      <Function ID="14" Name="Col 6/Open" Display="'Col 6/Open %.f%%',0~100" Dmx="108~127" WheelPosition="6" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="255~255" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Zap Effect" Display="'Zap Effect'" Dmx="11~30" />
      <Function ID="3" Name="Zap Speed" Display="'Zap %.1f%%',0.0~100.0" Dmx="31~249" />
      <Function ID="4" Name="Move in Dark" Display="'Move in Dark'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="11~29" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~65" />
      <Function ID="4" Name="Reset no P/T/Dimmer" Display="'Reset no P/T/Dimmer'" Dmx="66~100" />
      <Function ID="5" Name="Reset no Dimmer" Display="'Reset no Dimmer'" Dmx="101~135" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="136~170" />
      <Function ID="7" Name="Fans Max" Display="'Fans Max'" Dmx="171~249" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="CM_IWs575EB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="Phillips MSD 150W" Lumens="18000" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="23.5" />
      <Size Height="0.510" Width="0.456" Depth="0.350" />
      <Focus Type="Head" PanMax="538" TiltMax="260" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7816013e-bfa9-496f-8a7c-016ed4efc1cd" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="10" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="11" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="12" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="13" Wheel="12" />
      <Attribute ID="Colour1Func" ChannelOffset="14" Wheel="7" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Beam_Shape" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Effect" ChannelOffset="15" Wheel="22" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset no P/T/Dimmer">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset no Dimmer">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:9" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:16" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:23" />
    </Group>
  </Palettes>
</Fixture>
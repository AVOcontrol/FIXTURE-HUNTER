      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="41~80" />
      <Function ID="3" Name="L In-Out" Display="'L In-Out'" Dmx="81~120" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="121~160" />
      <Function ID="5" Name="Chase" Display="'Chase'" Dmx="161~255" />

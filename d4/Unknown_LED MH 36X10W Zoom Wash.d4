<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED MH 36X10W Zoom Wash" ShortName="MH 36x10W" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-10-12" Author="Pablo Cubillas" Comment="Created" />
  <History Date="08-10-12" Author="Peter Budd" Comment="Checked" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'               %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'Red C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'Green C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'Blue C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'White C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="10~14" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="15~19" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~24" Colour="0,255,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="25~29" Colour="0,128,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="30~34" Colour="0,0,255" />
      <Function ID="8" Name="Dark Plum" Display="'Dark Plum'" Dmx="35~39" Colour="123,1,137" />
      <Function ID="9" Name="Light Plum" Display="'Light Plum'" Dmx="40~44" Colour="231,24,254" />
      <Function ID="10" Name="White" Display="'White'" Dmx="45~49" Colour="255,255,255" />
      <Function ID="11" Name="9 Col Jump" Display="'9 Col Jump %.f%%',0~100" Dmx="50~94" Colour="0,0,0" />
      <Function ID="12" Name="9 Col Grad" Display="'9 Col Grad %.f%%',0~100" Dmx="95~99" Colour="0,0,0" />
      <Function ID="13" Name="White/Red" Display="'White/Red %.f%%',0~100" Dmx="100~149" Colour="0,0,0" />
      <Function ID="14" Name="White/Green" Display="'White/Green %.f%%',0~100" Dmx="150~154" Colour="0,0,0" />
      <Function ID="15" Name="White/Blue" Display="'White/Blue %.f%%',0~100" Dmx="155~166" Colour="0,0,0" />
      <Function ID="16" Name="Red/Blue" Display="'Red/Blue %.f%%',0~100" Dmx="167~178" Colour="0,0,0" />
      <Function ID="17" Name="Green/Blue" Display="'Green/Blue %.f%%',0~100" Dmx="179~190" Colour="0,0,0" />
      <Function ID="18" Name="Green/Blue" Display="'Green/Blue %.f%%',0~100" Dmx="191~202" Colour="0,0,0" />
      <Function ID="19" Name="Blue/Red" Display="'Blue/Red %.f%%',0~100" Dmx="203~214" Colour="0,0,0" />
      <Function ID="20" Name="Blue/Red" Display="'Blue/Red %.f%%',0~100" Dmx="215~226" Colour="0,0,0" />
      <Function ID="21" Name="Red/Grn/Blue" Display="'Red/Grn/Blue %.f%%',0~100" Dmx="227~238" Colour="0,0,0" />
      <Function ID="22" Name="Blue/Red/Grn" Display="'Blue/Red/Grn %.f%%',0~100" Dmx="239~250" Colour="0,0,0" />
      <Function ID="23" Name="White" Display="'White'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~6" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="7~65" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="66~69" Intensity="0~0" />
      <Function ID="4" Name="Thunder Strobe" Display="'Thunder Strobe %.f%%',0~100" Dmx="70~128" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="129~132" Intensity="0~0" />
      <Function ID="6" Name="Grad Light Strobe" Display="'Grad Light Strobe %.f%%',0~100" Dmx="133~191" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="192~195" Intensity="0~0" />
      <Function ID="8" Name="Grad Dark Strobe" Display="'Grad Dark Strobe %.f%%',0~100" Dmx="196~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f%%',0~100" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="16~80" />
      <Function ID="3" Name="Reserved" Display="'Reserved'" Dmx="81~95" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="96~110" />
      <Function ID="5" Name="Reserved" Display="'Reserved'" Dmx="111~125" />
      <Function ID="6" Name="Auto Mode" Display="'Auto Mode'" Dmx="126~175" />
      <Function ID="7" Name="Reserved" Display="'Reserved'" Dmx="176~190" />
      <Function ID="8" Name="Sound Mode" Display="'Sound Mode'" Dmx="191~240" />
      <Function ID="9" Name="Reserved" Display="'Reserved'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Control1" Name="P/T Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="X/Y Forw" Display="'X/Y Forw'" Dmx="0~63" />
      <Function ID="2" Name="X Forw" Display="'X Forw'" Dmx="64~127" />
      <Function ID="3" Name="X/Y Rev" Display="'X/Y Rev'" Dmx="128~191" />
      <Function ID="4" Name="Y Rev" Display="'Y Rev'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="UK_LMH3610X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Control1" ChannelOffset="14" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="UK_LMH3610B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="10" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />

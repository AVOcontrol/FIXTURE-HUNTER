      <Function ID="26" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Auto_Spd" />
      <Function ID="27" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Auto_Spd" />

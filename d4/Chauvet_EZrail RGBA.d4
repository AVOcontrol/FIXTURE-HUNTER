      <Function ID="31" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Auto_Spd" />
      <Function ID="32" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="2" If="'Auto'&gt;16&amp;&amp;'Auto'&lt;32" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'==32" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

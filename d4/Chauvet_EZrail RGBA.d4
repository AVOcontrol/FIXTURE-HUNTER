      <Function ID="16" Name="RGBA" Display="'RGBA'" Dmx="120~127" Update="Auto_Spd" />
      <Function ID="17" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Auto_Spd" />
      <Function ID="18" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Auto_Spd" />
      <Function ID="19" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Auto_Spd" />
      <Function ID="20" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Auto_Spd" />
      <Function ID="21" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Auto_Spd" />
      <Function ID="22" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Auto_Spd" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ECLIPSEFS" ShortName="ECLIPSEFS" Company="Prolights" Version="11">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>022b8573-8e09-4638-955b-10d12b14ff84</Thumbnail>
  <History Date="30-07-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="31-07-19" Author="Nic Morris" Comment="Re-added product thumbnail in attempt to solve patch issue." Version="2" />
  <History Date="31-07-19" Author="Nic Morris" Comment="Added remaining Atlabase mode ID's." Version="3" />
  <History Date="06-09-19" Author="Nic Morris" Comment="Changed 3 and 5 channel mode CTC and 8 and 13 channel mode Colour Macro to the CTC used in the 2 channel mode and changed the first function to 2000K in response to manufacturer request." Version="4" />
  <History Date="10-10-19" Author="Nic Morris" Comment="Further revisions to 8 and 13 channel mode CTC functions in line with latest charts in response to manufacturer request (adds open range at 0 with 2000K now starting at 1)" Version="5" />
  <History Date="21-07-20" Author="Nic Morris" Comment="Revised CTC functions in response to manufacturer request (contrary to documentation)" Version="6" />
  <History Date="21-09-24" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds 20 channel Theatre mode)" Version="7" />
  <History Date="24-09-24" Author="Nic Morris" Comment="Fixed duplicate function ID in shutter." Version="11" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="67ce472e-a2e6-4985-a3e6-4ecd785c1ed3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2800~10000" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC1" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC C-Mix" Display="'CTC C-Mix %.fK',2800~10000" Dmx="23~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="CTC_Function" Name="CTC Function" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CTC" Display="'CTC'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="CTC+Amber Shift" Display="'CTC+Amber Shift'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xFade_CTC-&gt;Col" Name="xFade CTC-&gt;Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTC-&gt;Col" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f',25.0~0.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="2" Name="0" Display="'0'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="3" Name="+" Display="'+ %.1f',0.0~25.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="White Presets" Display="'White Presets'" Dmx="17~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Colour_Func'==1" />
      <Condition Name="White Presets" ID="2,3,4,5,6,7,8" If="'Colour_Func'==2" />
      <Condition Name="Scroll" ID="9" If="'Colour_Func'==3||'Colour_Func'==4" />
      <Condition Name="Index/Bounce" ID="10,11,12,13,14,15,16" If="'Colour_Func'==5||'Colour_Func'==6" />
      <Else ID="17" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2000K" Display="'2000K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="2000-2700K" Display="'2000-2700K %.fK',2000~2700" Dmx="23~57" Colour="0,0,0" />
      <Function ID="4" Name="2700-3200K" Display="'2700-3200K %.fK',2700~3200" Dmx="58~90" Colour="0,0,0" />
      <Function ID="5" Name="3200-4200K" Display="'3200-4200K %.fK',3200~4200" Dmx="91~139" Colour="0,0,0" />
      <Function ID="6" Name="4200-5600K" Display="'4200-5600K %.fK',4200~5600" Dmx="140~185" Colour="0,0,0" />
      <Function ID="7" Name="5600-8000K" Display="'5600-8000K %.fK',5600~8000" Dmx="186~234" Colour="0,0,0" />
      <Function ID="8" Name="8000-10000K" Display="'8000-10000K %.fK',8000~10000" Dmx="235~255" Colour="0,0,0" />
      <Function ID="9" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="10" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="12" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="13" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="14" Name="Lime" Display="'Lime'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="15" Name="LED All" Display="'LED All'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="LED All" Display="'LED All'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO_On_Colours" Name="CTO On Colours" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>

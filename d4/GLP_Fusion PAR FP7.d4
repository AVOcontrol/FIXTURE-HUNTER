      <Condition Name="Random" ID="39,40" If="'Colour1Func'==3" />
      <Condition Name="White" ID="41,42,43,44,45,46,47" If="'Colour1Func'==4" />
      <Else ID="48" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />

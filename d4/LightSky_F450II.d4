  <Thumbnail>4986ba38-a300-4108-9798-989ac3e158f5</Thumbnail>
  <History Date="28-03-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="26-06-15" Author="Nic Morris" Comment="Added 'Black out speed' function to Lamp channel and added 18 DMX mode in response to customer bug report." Version="2" />
  <History Date="26-05-17" Author="Nic Morris" Comment="Added 16 DMX mode.  Added Atlabase ID's (note 18 DMX mode is not documented and therefore not simulated)." Version="3" />
  <History Date="10-06-17" Author="Nic Morris" Comment="Created from FOS Beam 7R Hybrid (alternative colours and gobos - Atlabase tested on real-world fixture and found manufacturer's charts incorrect)." Version="4" />
  <History Date="17-02-18" Author="Nic Morris" Comment="Created from FOS Beam 7R Hybrid (2)" Version="5" />
  <History Date="21-02-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="22-02-18" Author="Nic Morris" Comment="Revised colour ranges to align with Capture (fixed at start of range in assumption it is fully indexable)" Version="7" />
  <History Date="23-06-19" Author="Nic Morris" Comment="Added RDM ID's" Version="8" />
  <History Date="27-03-25" Author="Nic Morris" Comment="Added 16 DMX Plus mode and gobo swatches in line with latest documentation." Version="9" />
  <Manual Filename="" Summary="" />

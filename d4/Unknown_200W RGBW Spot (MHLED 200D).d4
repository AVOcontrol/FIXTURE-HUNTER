      <Attribute ID="Tilt" ChannelOffset="12,13" Wheel="3" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="14" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="15" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="16" Wheel="18" />
      <Attribute ID="Focus" ChannelOffset="17" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="19" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="20" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="21" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

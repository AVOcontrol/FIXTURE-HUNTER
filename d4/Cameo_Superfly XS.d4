<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Superfly XS" ShortName="SuperflyXS" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-05-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_Colour" Name="LED Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~20" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~35" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~50" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="51~65" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="66~80" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="81~95" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="96~110" Colour="255,255,255" />
      <Function ID="9" Name="GB" Display="'GB'" Dmx="111~125" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="126~140" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="141~155" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="156~170" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="171~185" Colour="255,255,255" />
      <Function ID="14" Name="GBW" Display="'GBW'" Dmx="186~200" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="201~215" Colour="255,255,255" />
      <Function ID="16" Name="Auto Single" Display="'Auto Single %.f%%',0~100" Dmx="216~230" Colour="255,255,255" />
      <Function ID="17" Name="Auto All" Display="'Auto All %.f%%',0~100" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="LED_Rotation" Name="LED Rotation" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Strobe_Program" Name="Strobe Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~19" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="20~29" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="30~39" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="40~49" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="50~59" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="60~69" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="70~79" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="80~89" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="90~99" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="100~109" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="110~119" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="120~129" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="130~139" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="140~149" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="150~159" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="160~169" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="170~179" />
      <Function ID="19" Name="ON" Display="'ON'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto Mix" Display="'Auto Mix'" Dmx="10~50" />
      <Function ID="3" Name="Auto Derby" Display="'Auto Derby'" Dmx="51~91" />
      <Function ID="4" Name="Auto Strobe" Display="'Auto Strobe'" Dmx="92~132" />
      <Function ID="5" Name="Sound Mix" Display="'Sound Mix'" Dmx="133~173" />
      <Function ID="6" Name="Sound Derby" Display="'Sound Derby'" Dmx="174~214" />
      <Function ID="7" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="215~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKCMSFX1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKCMSFX5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="LED_Colour" ChannelOffset="2" Wheel="7" />
      <Attribute ID="LED_Strobe" ChannelOffset="3" Wheel="4" />
      <Attribute ID="LED_Rotation" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Strobe_Program" ChannelOffset="5" Wheel="22" />
    </Include>
  </Mode>
</Fixture>
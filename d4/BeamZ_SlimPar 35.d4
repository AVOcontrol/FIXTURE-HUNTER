  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5d012bbb-eb78-41b3-b1f9-6f60e8c30cd4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~49" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="50~59" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~69" Colour="0,255,255" />
      <Function ID="8" Name="Dark Orange" Display="'Dark Orange'" Dmx="70~79" Colour="255,100,0" />
      <Function ID="9" Name="Green Yellow" Display="'Green Yellow'" Dmx="80~89" Colour="180,180,0" />
      <Function ID="10" Name="Salmon" Display="'Salmon'" Dmx="90~99" Colour="255,150,150" />
      <Function ID="11" Name="Turquoise" Display="'Turquoise'" Dmx="100~109" Colour="0,255,128" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="110~119" Colour="128,255,0" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="120~129" Colour="255,128,0" />
      <Function ID="14" Name="Lavender" Display="'Lavender'" Dmx="130~139" Colour="255,128,255" />
      <Function ID="15" Name="Light Blue" Display="'Light Blue'" Dmx="140~149" Colour="0,128,255" />
      <Function ID="16" Name="Dark Blue" Display="'Dark Blue'" Dmx="150~159" Colour="0,0,180" />
      <Function ID="17" Name="Pink" Display="'Pink'" Dmx="160~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Blend" Display="'Blend %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Change" Display="'Change %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Sound Blend" Display="'Sound Blend %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Sound Change" Display="'Sound Change %.f%%',0~100" Dmx="190~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

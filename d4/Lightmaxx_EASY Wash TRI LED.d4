  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7c4a5932-b0cc-489f-a4c2-faeb216ce514" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="240~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="135~239" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="8~21" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~34" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="35~49" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="50~63" Colour="0,0,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="64~77" Colour="255,255,255" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="78~91" Colour="0,128,255" />
      <Function ID="8" Name="Crimson" Display="'Crimson'" Dmx="92~105" Colour="255,0,127" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="106~119" Colour="255,255,0" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="120~133" Colour="128,0,255" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="134~147" Colour="255,128,0" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="148~161" Colour="128,255,0" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="162~175" Colour="255,0,255" />
      <Function ID="14" Name="Pink" Display="'Pink'" Dmx="176~189" Colour="255,150,150" />
      <Function ID="15" Name="Buff" Display="'Buff'" Dmx="190~203" Colour="255,200,200" />
      <Function ID="16" Name="White" Display="'White'" Dmx="204~217" Colour="255,255,255" />
      <Function ID="17" Name="Dark Purple" Display="'Dark Purple'" Dmx="218~231" Colour="180,0,180" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="232~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Speed" Name="Col Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~22" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="23~37" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="38~53" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="54~67" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="68~82" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="83~97" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="98~112" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="113~127" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="128~142" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="143~157" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="158~172" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="173~187" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="188~202" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="203~217" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="218~232" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="233~255" />
    </Attribute>
  </Control>

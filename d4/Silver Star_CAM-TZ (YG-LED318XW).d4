<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CAM-TZ (YG-LED318XW)" ShortName="LED318XW" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>99544eb3-989e-4853-90c8-479559466c08</Thumbnail>
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Fixed power on and locate.  Changed HSV attribute groups." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Simplified conditional statements.  Fixed shutter palettes." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Increased wheel resolutions.  Added missing IDs to ID Address" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Added virtual dimmers." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Adapted from Chauvet COLORado 1 Tour" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Removed Value attribute.  Repaced with Dimmer for HTP." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="10-07-16" Author="Nic Morris" Comment="Changed macro and macro speed to effect group,  Added Atlabase ID's (linked to Chauvet COLORado 1 Tour)." />
  <History Date="13-07-16" Author="Nic Morris" Comment="Fixed Atlabase Fixture Identifier." />
  <History Date="05-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="05-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="01-09-18" Author="Nic Morris" Comment="Changed name from YG-LED318XW to CAM-TZ (YG-LED318XW).  Revised Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d334a450-2f62-4d16-afe4-c7c0ac245c5e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="0,0,0" />

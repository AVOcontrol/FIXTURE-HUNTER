  <Control>
    <Attribute ID="Play_Mode" Name="Play Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Pattern/Folder, Scaling/File" />
      <Function ID="2" Name="SD View File" Display="'SD View File'" Dmx="1~40" Update="Pattern/Folder, Scaling/File" />
      <Function ID="3" Name="SD Playlist" Display="'SD Playlist'" Dmx="41~80" Update="Pattern/Folder, Scaling/File" />

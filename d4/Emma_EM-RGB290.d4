      <Function ID="5" Name="SD Playlist Sound" Display="'SD Playlist Sound'" Dmx="101~120" Update="Pattern/Folder, Scaling/File" />
      <Function ID="6" Name="Preset Effect" Display="'Preset Effect'" Dmx="121~160" Update="Pattern/Folder, Scaling/File" />
      <Function ID="7" Name="Preset Effect Sound" Display="'Preset Effect Sound'" Dmx="161~200" Update="Pattern/Folder, Scaling/File" />
      <Function ID="8" Name="DMX" Display="'DMX'" Dmx="201~240" Update="Pattern/Folder, Scaling/File" />
      <Function ID="9" Name="DMX Sound" Display="'DMX Sound'" Dmx="241~255" Update="Pattern/Folder, Scaling/File" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Display" Display="'No Display'" Dmx="0~0" />
      <Function ID="2" Name="Out of Bounds Through" Display="'Out of Bounds Through %.f%%',0~100" Dmx="1~50" />
      <Function ID="3" Name="Out of Bounds Return" Display="'Out of Bounds Return %.f%%',0~100" Dmx="51~100" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern/Folder" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="SD" ID="2" If="'Play_Mode'==2||'Play_Mode'==3||'Play_Mode'==4||'Play_Mode'==5" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scaling/File" Name="Scaling/File" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="SD" ID="2" If="'Play_Mode'==2||'Play_Mode'==3||'Play_Mode'==4||'Play_Mode'==5" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="File" Display="'File %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />

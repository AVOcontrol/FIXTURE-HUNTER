      <Function ID="21" Name="Pk/ Cy" Display="'Pk/ Cy'" Dmx="65~69" WheelPosition="6" Colour="255,150,150" />
      <Function ID="22" Name="Cy/ Mag" Display="'Cy/ Mag'" Dmx="75~79" WheelPosition="7" Colour="0,255,255" />
      <Function ID="23" Name="Mag/ Amb" Display="'Mag/ Amb'" Dmx="85~89" WheelPosition="8" Colour="255,0,255" />
      <Function ID="24" Name="Amb/ L Grn" Display="'Amb/ L Grn'" Dmx="95~99" WheelPosition="9" Colour="255,100,0" />
      <Function ID="25" Name="L Grn/ L Blu" Display="'L Grn/ L Blu'" Dmx="105~109" WheelPosition="10" Colour="128,255,0" />
      <Function ID="26" Name="L Blu/ CTB" Display="'L Blu/ CTB'" Dmx="115~119" WheelPosition="11" Colour="0,128,255" />

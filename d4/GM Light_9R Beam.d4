      <Function ID="12" Name="Light Blue" Display="'Light Blue'" Dmx="110~114" WheelPosition="11" Colour="0,128,255" />
      <Function ID="13" Name="CTB" Display="'CTB'" Dmx="120~124" WheelPosition="12" Colour="230,230,255" />
      <Function ID="14" Name="Light Pink" Display="'Light Pink'" Dmx="130~134" WheelPosition="13" Colour="255,200,200" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="25~29" WheelPosition="2" Colour="255,255,0" />

      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1 (Red Glass)" Display="'Gobo 1 (Red Glass)'" Dmx="5~9" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2 (Green Mosaic)" Display="'Gobo 2 (Green Mosaic)'" Dmx="10~14" WheelPosition="2" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~115" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="136~235" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="11~40" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="41~70" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="71~100" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="101~130" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="131~160" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="161~190" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="191~220" />
      <Function ID="9" Name="Random Pixels" Display="'Random Pixels'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~50" />
      <Function ID="2" Name="FWD" Display="'FWD %.f%%',100~0" Dmx="150~51" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="151~155" />
      <Function ID="4" Name="REV" Display="'REV %.f%%',0~100" Dmx="156~255" />
    </Attribute>
    <Attribute ID="FG_Dimmer" Name="FG Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FG_Colour" Name="FG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~18" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="19~36" Colour="0,255,0" />

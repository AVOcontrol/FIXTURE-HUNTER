      <Function ID="8" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="109~126" Colour="0,128,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="127~144" Colour="0,255,255" />

    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="LED Freq 1.2k" Display="'LED Freq 1.2k'" Dmx="31~35" />
      <Function ID="3" Name="LED Freq 2.4k" Display="'LED Freq 2.4k'" Dmx="36~40" />
      <Function ID="4" Name="LED Freq 12k" Display="'LED Freq 12k'" Dmx="41~45" />

      <Function ID="9" Name="Dim Fade Fast" Display="'Dim Fade Fast'" Dmx="101~105" />
      <Function ID="10" Name="Fan Off (Low Power Mode)" Display="'Fan Off (Low Power Mode)'" Dmx="121~125" />

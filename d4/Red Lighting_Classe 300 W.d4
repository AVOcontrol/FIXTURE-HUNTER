    <Attribute ID="Effect" Name="Effect" Description="" Group="E" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~771" />
      <Function ID="2" Name="Beam Shaper" Display="'Beam Shaper'" Dmx="1028~32639" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="32896~48573" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="49858~65535" />
    </Attribute>
  </Control>
  <Mode Name="Basic" Channels="14">
    <Import PearlRef="RE_Cls300WB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="3" Wheel="11" />

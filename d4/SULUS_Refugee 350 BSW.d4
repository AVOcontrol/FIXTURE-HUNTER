      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~199" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />

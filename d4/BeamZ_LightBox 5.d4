    <AtlaBase ModeID="0ebdc4e7-e105-4247-bb9a-884bb91407f1" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Rotation" ChannelOffset="1" Wheel="19" />
        <Attribute ID="Jellyball_Rot" Wheel="20" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Laser_Rot" Wheel="21" />
        <Attribute ID="Red_Laser" Wheel="70" />
        <Attribute ID="Green_Laser" Wheel="71" />
        <Attribute ID="Master_Dimmer" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
        <Attribute ID="White_Strobe" ChannelOffset="17" Wheel="6" />
        <Attribute ID="Macro" ChannelOffset="18" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Jellyball" ChannelOffset="2" ModeLink="Jellyball cell" X="0" Y="0">
        <AttributeLink SourceId="Jellyball_Rot" TargetId="Jellyball_Rot" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Laser" ChannelOffset="3" ModeLink="Laser cell" X="0" Y="1">
        <AttributeLink SourceId="Laser_Rot" TargetId="Laser_Rot" />
        <AttributeLink SourceId="Red_Laser" TargetId="Red_Laser" />
        <AttributeLink SourceId="Green_Laser" TargetId="Green_Laser" />
      </Cell>
      <Cell ID="Cell3" Name="LED" ChannelOffset="12" ModeLink="LED cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="UV" ChannelOffset="16" ModeLink="Dim cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Power Spot 700 CMY" ShortName="PwrSp70CMY" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>597e0090-f31d-435c-be07-c3a79a90b427</Thumbnail>
  <History Date="01-12-06" Author="D.Milligan" Comment="Created" />
  <History Date="01-12-06" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="16-12-10" Author="John Rogers" Comment="Added Palettes." />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated Raw DMX function to have no range." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="04-05-18" Author="Nic Morris" Comment="Added product thumbnail.  Added colour function index.  Changed split colours to text only." />
  <History Date="04-05-18" Author="Nic Morris" Comment="Standardised conditionals.  Increased wheel resolution.  Revised colour and gobo with fast/slow options." />
  <History Date="04-05-18" Author="Nic Morris" Comment="Changed open shutter to locate and power on at 255 in attempt to fix customer bug report (lamp on)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Fast" Display="'Fixed Fast'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Fast" Display="'Split Fast'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Fixed Slow" Display="'Fixed Slow'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Split Slow" Display="'Split Slow'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Fast" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split Fast" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Fixed Slow" ID="19,20,21,22,23,24,25,26,27" If="'Colour1Func'==3" />
      <Condition Name="Split Slow" ID="28,29,30,31,32,33,34,35,36" If="'Colour1Func'==4" />
      <Condition Name="Scroll" ID="37,38,39,40,41,42" If="'Colour1Func'==5" />
      <Else ID="43" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="1 (Lila 509)" Display="'1 (Lila 509)'" Dmx="4~5" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="2 (Green 206)" Display="'2 (Green 206)'" Dmx="8~9" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="3 (Pink 312)" Display="'3 (Pink 312)'" Dmx="12~13" WheelPosition="3" Colour="255,128,192" />
      <Function ID="5" Name="4 (Orange 306u)" Display="'4 (Orange 306u)'" Dmx="16~17" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="5 (Lila 502)" Display="'5 (Lila 502)'" Dmx="20~21" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="6 (Yellow 601)" Display="'6 (Yellow 601)'" Dmx="24~25" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="7 (CTC 3200-4100)" Display="'7 (CTC 3200-4100)'" Dmx="28~29" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="8 (Rot 308)" Display="'8 (Rot 308)'" Dmx="32~33" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Op/ 1" Display="'Op/ 1'" Dmx="2~3" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="1/ 2" Display="'1/ 2'" Dmx="6~7" WheelPosition="1" Colour="0,0,0" />
      <Function ID="12" Name="2/ 3" Display="'2/ 3'" Dmx="10~11" WheelPosition="2" Colour="0,255,0" />
      <Function ID="13" Name="3/ 4" Display="'3/ 4'" Dmx="14~15" WheelPosition="3" Colour="255,128,192" />
      <Function ID="14" Name="4/ 5" Display="'4/ 5'" Dmx="18~19" WheelPosition="4" Colour="255,128,0" />
      <Function ID="15" Name="5/ 6" Display="'5/ 6'" Dmx="22~23" WheelPosition="5" Colour="0,0,0" />
      <Function ID="16" Name="6/ 7" Display="'6/ 7'" Dmx="26~27" WheelPosition="6" Colour="255,255,0" />
      <Function ID="17" Name="7/ 8" Display="'7/ 8'" Dmx="30~31" WheelPosition="7" Colour="255,240,200" />
      <Function ID="18" Name="8/ Op" Display="'8/ Op'" Dmx="34~35" WheelPosition="8" Colour="0,0,0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="64~65" WheelPosition="0" Colour="255,255,255" />
      <Function ID="20" Name="1 (Lila 509)" Display="'1 (Lila 509)'" Dmx="68~69" WheelPosition="1" Colour="0,0,0" />
      <Function ID="21" Name="2 (Green 206)" Display="'2 (Green 206)'" Dmx="72~73" WheelPosition="2" Colour="0,255,0" />
      <Function ID="22" Name="3 (Pink 312)" Display="'3 (Pink 312)'" Dmx="76~77" WheelPosition="3" Colour="255,128,192" />
      <Function ID="23" Name="4 (Orange 306u)" Display="'4 (Orange 306u)'" Dmx="80~81" WheelPosition="4" Colour="255,128,0" />
      <Function ID="24" Name="5 (Lila 502)" Display="'5 (Lila 502)'" Dmx="84~85" WheelPosition="5" Colour="0,0,0" />
      <Function ID="25" Name="6 (Yellow 601)" Display="'6 (Yellow 601)'" Dmx="88~89" WheelPosition="6" Colour="255,255,0" />
      <Function ID="26" Name="7 (CTC 3200-4100)" Display="'7 (CTC 3200-4100)'" Dmx="92~93" WheelPosition="7" Colour="255,240,200" />
      <Function ID="27" Name="8 (Rot 308)" Display="'8 (Rot 308)'" Dmx="96~97" WheelPosition="8" Colour="0,0,0" />
      <Function ID="28" Name="Op/ 1" Display="'Op/ 1'" Dmx="66~67" WheelPosition="0" Colour="255,255,255" />
      <Function ID="29" Name="1/ 2" Display="'1/ 2'" Dmx="70~71" WheelPosition="1" Colour="0,0,0" />
      <Function ID="30" Name="2/ 3" Display="'2/ 3'" Dmx="74~75" WheelPosition="2" Colour="0,255,0" />
      <Function ID="31" Name="3/ 4" Display="'3/ 4'" Dmx="78~79" WheelPosition="3" Colour="255,128,192" />
      <Function ID="32" Name="4/ 5" Display="'4/ 5'" Dmx="82~83" WheelPosition="4" Colour="255,128,0" />
      <Function ID="33" Name="5/ 6" Display="'5/ 6'" Dmx="86~87" WheelPosition="5" Colour="0,0,0" />
      <Function ID="34" Name="6/ 7" Display="'6/ 7'" Dmx="90~91" WheelPosition="6" Colour="255,255,0" />
      <Function ID="35" Name="7/ 8" Display="'7/ 8'" Dmx="94~95" WheelPosition="7" Colour="255,240,200" />
      <Function ID="36" Name="8/ Op" Display="'8/ Op'" Dmx="98~99" WheelPosition="8" Colour="0,0,0" />
      <Function ID="37" Name="No Scroll" Display="'No Scroll'" Dmx="128~129" Colour="255,255,255" />
      <Function ID="38" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~130" Colour="0,0,0" />
      <Function ID="39" Name="No Scroll" Display="'No Scroll'" Dmx="128~129" Colour="0,0,0" />
      <Function ID="40" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="253~192" Colour="0,0,0" />
      <Function ID="41" Name="Sound Slow" Display="'Sound Slow'" Dmx="254~254" Colour="0,0,0" />
      <Function ID="42" Name="Sound Fast" Display="'Sound Fast'" Dmx="255~255" Colour="0,0,0" />
      <Function ID="43" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fast Index" Display="'Fast Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fast Spin" Display="'Fast Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Fast Sound" Display="'Fast Sound'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Slow Index" Display="'Slow Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Slow Spin" Display="'Slow Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Slow Sound" Display="'Slow Sound'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll Sound" Display="'Scroll Sound'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fast" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2||'Gobo1Func'==3" />
      <Condition Name="Slow" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==4||'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Scroll" ID="17,18,19,20,21,22" If="'Gobo1Func'==7||'Gobo1Func'==8||'Gobo1Func'==9" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="64~71" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1" Display="'Gobo 1'" Dmx="72~79" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2" Display="'Gobo 2'" Dmx="80~87" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3" Display="'Gobo 3'" Dmx="88~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4" Display="'Gobo 4'" Dmx="96~103" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5" Display="'Gobo 5'" Dmx="104~111" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6" Display="'Gobo 6'" Dmx="112~119" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7" Display="'Gobo 7'" Dmx="120~127" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="128~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="128~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="253~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Sound Slow" Display="'Sound Slow'" Dmx="254~254" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Sound Fast" Display="'Sound Fast'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==4||'Gobo1Func'==7" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==5||'Gobo1Func'==8" />
      <Condition Name="Sound" ID="6,7" If="'Gobo1Func'==3||'Gobo1Func'==6||'Gobo1Func'==9" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="128~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="253~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Sound Slow" Display="'Sound Slow'" Dmx="254~254" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Sound Fast" Display="'Sound Fast'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fast" Display="'Fast'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Slow" Display="'Slow'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />

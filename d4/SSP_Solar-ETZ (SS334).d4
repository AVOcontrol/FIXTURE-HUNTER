      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="11~50" Colour="0,0,0" />
      <Function ID="3" Name="3400K" Display="'3400K'" Dmx="51~80" Colour="0,0,0" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="81~110" Colour="0,0,0" />

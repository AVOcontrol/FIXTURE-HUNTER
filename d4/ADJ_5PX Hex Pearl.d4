    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="30 Col Change" Display="'30 Col Change'" Dmx="21~40" Update="Auto_Spd" />
      <Function ID="3" Name="6 Col Change" Display="'6 Col Change'" Dmx="41~60" Update="Auto_Spd" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="61~80" Update="Auto_Spd" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7f356a0d-d3df-484f-aece-aad466ddbacc" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="16~32" Intensity="0~0" />
      <Function ID="3" Name="Async Pulse" Display="'Async Pulse'" Dmx="33~49" Intensity="0~0" />
      <Function ID="4" Name="Asnc Op Pulse" Display="'Asnc Op Pulse'" Dmx="50~66" Intensity="0~0" />
      <Function ID="5" Name="Async Cl Pulse" Display="'Async Cl Pulse'" Dmx="67~83" Intensity="0~0" />
      <Function ID="6" Name="Async Pulse" Display="'Async Pulse'" Dmx="84~100" Intensity="0~0" />
      <Function ID="7" Name="Async Str Pulse" Display="'Async Str Pulse'" Dmx="101~117" Intensity="0~0" />
      <Function ID="8" Name="Strobe" Display="'Strobe'" Dmx="118~134" Intensity="0~0" />
      <Function ID="9" Name="Sync Pulse 1" Display="'Sync Pulse 1'" Dmx="135~151" Intensity="0~0" />
      <Function ID="10" Name="Sync Pulse 2" Display="'Sync Pulse 2'" Dmx="152~168" Intensity="0~0" />
      <Function ID="11" Name="Sync Op Pulse" Display="'Sync Op Pulse'" Dmx="169~185" Intensity="0~0" />
      <Function ID="12" Name="Sync Cl Pulse" Display="'Sync Cl Pulse'" Dmx="186~202" Intensity="0~0" />
      <Function ID="13" Name="Sync Pulse" Display="'Sync Pulse'" Dmx="203~219" Intensity="0~0" />
      <Function ID="14" Name="Sync Str Pulse" Display="'Sync Str Pulse'" Dmx="220~236" Intensity="0~0" />
      <Function ID="15" Name="Strobe %" Display="'Strobe'" Dmx="237~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Shutter Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Macro 1" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Condition Name="Sound" ID="3" If="'Colour_Macro'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Pixel" Display="'Pixel %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~48" Update="Control" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="49~64" Update="Control" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="65~80" Update="Control" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="81~96" Update="Control" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="97~112" Update="Control" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="113~128" Update="Control" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="129~144" Update="Control" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="145~160" Update="Control" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="161~176" Update="Control" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="177~192" Update="Control" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="193~208" Update="Control" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="209~224" Update="Control" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="225~240" Update="Control" Colour="0,0,0" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="241~255" Update="Control" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Intensity1" Name="Intensity1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

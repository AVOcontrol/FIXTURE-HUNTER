<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Strike 2 IP (EK-EB2 IP)" ShortName="Strike2 IP" Company="EK Lights" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="31-08-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~132" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="41~80" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="81~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5 %.f%%',0~100" Dmx="161~200" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6 %.f%%',0~100" Dmx="201~240" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORado Zoom WW Tour" ShortName="CdZm WW Tr" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="07-10-17" Author="Nic Morris" Comment="Fixed STD.P mode mapping (was missing control channel).  Added Atlabase ID's.  Added channel counts to mode names." />
  <History Date="07-10-17" Author="Nic Morris" Comment="Revised warm white and cold white attribute ID's.  Changed warm white and cold white power on to match locate." />
  <History Date="07-10-17" Author="Nic Morris" Comment="Removed manufacturer shortcode from display name." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cf9094c1-678f-4539-bd70-b8740b6611d9" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="White 1" Display="'White 1'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="White 2" Display="'White 2'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="White 3" Display="'White 3'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="White 4" Display="'White 4'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="White 5" Display="'White 5'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="STD.W, 5 DMX" Channels="5">
    <Import PearlRef="CH_CRZmWWTW" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6b4d850e-3a75-4ccc-8658-dfbc0ec15fa9" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="STD.P, 4 DMX" Channels="4">
    <Import PearlRef="CH_CRZmWWTP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d8f5a448-205f-4852-9821-19e781c17b4e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="UNO, 1 DMX" Channels="1">
    <Import PearlRef="CH_CRZmWWTU" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="28eb8bef-9780-4e50-a73c-c9476642914b" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
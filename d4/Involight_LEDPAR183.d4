<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LEDPAR183" ShortName="LEDPAR183" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-01-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Auto'==2" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;2&amp;&amp;'Auto'&lt;12" />
      <Condition Name="Sensitivity" ID="4" If="'Auto'==12" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="1~24" Update="Red" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="25~49" Update="Red" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="50~74" Update="Red" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="75~99" Update="Red" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="100~124" Update="Red" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="125~149" Update="Red" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="150~174" Update="Red" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="175~199" Update="Red" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="200~224" Update="Red" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="225~249" Update="Red" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Colour="0,0,255" />
      <Function ID="5" Name="Turquoise" Display="'Turquoise'" Dmx="69~91" Colour="0,255,128" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="92~114" Colour="255,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="115~137" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="138~160" Colour="255,150,150" />
      <Function ID="9" Name="Lilac" Display="'Lilac'" Dmx="161~183" Colour="255,128,255" />
      <Function ID="10" Name="Dark Blue" Display="'Dark Blue'" Dmx="184~206" Colour="0,0,180" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="207~229" Colour="128,255,0" />
      <Function ID="12" Name="White" Display="'White'" Dmx="230~252" Colour="255,255,255" />
      <Function ID="13" Name="Warm White" Display="'Warm White'" Dmx="253~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="IVLP1831" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="IVLP1833" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="IVLP1834" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="IVLP1836" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="23" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="JBLED A7 (VaryLED A7 Zoom)" ShortName="JBLED A7" Company="JB Lighting">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>c6d399f4-9e46-4825-ae69-aeb57f706185</Thumbnail>
  <History Date="04-12-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="04-12-08" Author="David Hunt" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution.  Standardised func names." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Simplified shutter.  Shortened function names for Expert LCD" />
  <History Date="29-08-12" Author="Peter Budd" Comment="Edited changed colour mixing range on colour channel to 0" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="30-04-14" Author="Nic Morris" Comment="Renamed shutter functions in response to customer bug report." />
  <History Date="14-07-15" Author="Nic" Comment="Created from JB Lighting VaryLED A7 Zoom" />
  <History Date="27-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="05-09-18" Author="Nic Morris" Comment="Changed name from JBLED A7 to JBLED A7 (VaryLED A7 Zoom)" />
  <History Date="05-09-18" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="798ea4ad-49a9-4273-9d66-22388872419b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="255~255" />
      <Function ID="2" Name="Full Power" Display="'Full Power'" Dmx="0~0" />
      <Function ID="3" Name="8500K Fade" Display="'8500K Fade'" Dmx="8~15" />
      <Function ID="4" Name="6500K Fade" Display="'6500K Fade'" Dmx="16~23" />
      <Function ID="5" Name="Col Picker Fade" Display="'Col Picker Fade'" Dmx="24~31" />
      <Function ID="6" Name="Camera 50Hz" Display="'Camera 50Hz'" Dmx="208~215" />
      <Function ID="7" Name="Camera 60Hz" Display="'Camera 60Hz'" Dmx="216~223" />
      <Function ID="8" Name="Camera Flex" Display="'Camera Flex'" Dmx="224~231" />
      <Function ID="9" Name="Reset" Display="'Reset'" Dmx="240~247" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="16~95" Intensity="0~0" />
      <Function ID="3" Name="Pls Op &gt;10Hz" Display="'Pls Op &gt;10Hz %.f%%',0~100" Dmx="96~110" Intensity="0~0" />
      <Function ID="4" Name="Fade w/ Dim" Display="'Fade w/ Dim %.f%%',0~100" Dmx="112~125" Intensity="0~0" />
      <Function ID="5" Name="Pls Op &lt;10Hz" Display="'Pls Op &lt;10Hz %.f%%',0~100" Dmx="128~142" Intensity="0~0" />
      <Function ID="6" Name="Pls Closing" Display="'Pls Closing %.f%%',0~100" Dmx="144~158" Intensity="0~0" />
      <Function ID="7" Name="Fade 0%" Display="'Fade 0 %.f%%',0~100" Dmx="160~174" Intensity="0~0" />
      <Function ID="8" Name="Fade 100%" Display="'Fade 100 %.f%%',0~100" Dmx="176~190" Intensity="0~0" />
      <Function ID="9" Name="Rand 100%" Display="'Rand 100 %.f%%',0~100" Dmx="192~206" Intensity="0~0" />
      <Function ID="10" Name="Rand 0%" Display="'Rand 0 %.f%%',0~100" Dmx="208~222" Intensity="0~0" />
      <Function ID="11" Name="Rnd Fade 0%" Display="'Rnd Fade 0 %.f%%',0~100" Dmx="224~238" Intensity="0~0" />
      <Function ID="12" Name="Rnd Fd 100%" Display="'Rnd Fd 100 %.f%%',0~100" Dmx="240~254" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="19" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White'" Dmx="2~3" WheelPosition="1" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="8~11" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="16~19" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="24~27" WheelPosition="4" Colour="255,0,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="32~35" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Amber" Display="'Amber'" Dmx="40~43" WheelPosition="6" Colour="255,100,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="48~51" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="56~59" WheelPosition="8" Colour="0,255,255" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Wht - Rd" Display="'Wht - Rd %.f%%',0~100" Dmx="4~7" WheelPosition="1" Colour="255,128,128" />
      <Function ID="12" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="12~15" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Yel - Mag" Display="'Yel - Mag %.f%%',0~100" Dmx="20~23" WheelPosition="3" Colour="255,128,128" />
      <Function ID="14" Name="Mag - Grn" Display="'Mag - Grn %.f%%',0~100" Dmx="28~31" WheelPosition="4" Colour="128,128,128" />
      <Function ID="15" Name="Grn - Amb" Display="'Grn - Amb %.f%%',0~100" Dmx="36~39" WheelPosition="5" Colour="128,178,0" />
      <Function ID="16" Name="Amb - Blu" Display="'Amb - Blu %.f%%',0~100" Dmx="44~47" WheelPosition="6" Colour="128,50,128" />
      <Function ID="17" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="52~55" WheelPosition="7" Colour="0,128,255" />
      <Function ID="18" Name="Cy - Op" Display="'Cy - Op %.f%%',0~100" Dmx="60~63" WheelPosition="8" Colour="128,255,255" />
      <Function ID="19" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="255,255,255" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~222" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="255,255,255" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="225~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Effect_Speed" Name="Effect Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Blackout_Move" Name="Blackout Move" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="96~127" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="128~159" />
      <Function ID="4" Name="All in Dark" Display="'All in Dark'" Dmx="224~255" />
    </Attribute>
  </Control>

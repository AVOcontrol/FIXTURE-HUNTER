  <Thumbnail>0e6e8b9f-5be6-4b2d-ba6a-592afc6f7af8</Thumbnail>
  <History Date="23-05-12" Author="Alessandro Fantin" Comment="Created" />
  <History Date="23-05-12" Author="Peter Budd" Comment="Checked" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Changed fixture name from ARC7337Z to ARCLED7337ZOOM" />
  <History Date="14-08-16" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised mode names.  Removed ARCS mode and added missing HSV mode." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Added virtual dimmer to Arc.1 and Arc.2 mods and fixed Arc.1 mapping." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Moved auto and auto speed into effect group and wheel slot." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Changed control functions from percentage to text only." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Changed colour macro index function from text only to percentage range." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Changed shutter open function from value to text only range." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Standardised white locate value.  Revised auto and dim spd functions." />
  <History Date="14-08-16" Author="Nic Morris" Comment="Moved dim spd from intensity to special wheel slot in line with group." />
  <History Date="21-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="21-12-17" Author="Nic Morris" Comment="Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="24a24753-1349-427a-8f12-11405ea83c87" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

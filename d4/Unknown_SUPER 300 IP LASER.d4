      <Function ID="29" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="116~119" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="124~127" WheelPosition="14" Colour="0,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />

      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="86~89" WheelPosition="10" Colour="0,255,255" />
      <Function ID="12" Name="CTO 260" Display="'CTO 260'" Dmx="94~98" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="CTO 190" Display="'CTO 190'" Dmx="103~106" WheelPosition="12" Colour="255,240,200" />

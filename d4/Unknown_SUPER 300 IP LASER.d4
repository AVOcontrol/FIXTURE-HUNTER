      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="120~123" WheelPosition="14" Colour="0,0,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="13~17" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="22~25" WheelPosition="2" Colour="255,128,0" />

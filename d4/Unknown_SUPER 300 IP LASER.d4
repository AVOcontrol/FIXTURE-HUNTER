      <Function ID="20" Name="Grn/ L Grn" Display="'Grn/ L Grn'" Dmx="39~42" WheelPosition="4" Colour="0,255,0" />
      <Function ID="21" Name="L Grn/ Lav" Display="'L Grn/ Lav'" Dmx="47~51" WheelPosition="5" Colour="128,255,0" />
      <Function ID="22" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="56~59" WheelPosition="6" Colour="255,128,255" />
      <Function ID="23" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="64~68" WheelPosition="7" Colour="255,150,150" />
      <Function ID="24" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="73~76" WheelPosition="8" Colour="255,255,0" />
      <Function ID="25" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="82~85" WheelPosition="9" Colour="255,0,255" />
      <Function ID="26" Name="Cy/ 260" Display="'Cy/ 260'" Dmx="90~93" WheelPosition="10" Colour="0,255,255" />

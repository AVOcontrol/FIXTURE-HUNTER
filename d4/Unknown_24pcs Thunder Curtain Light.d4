<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="24pcs Thunder Curtain Light" ShortName="24pcsThndr" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="27-02-26" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Pattern_Auto" Name="Pattern Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto Col Change" Display="'Auto Col Change'" Dmx="0~0" />
      <Function ID="2" Name="Monochrome" Display="'Monochrome'" Dmx="33~64" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="65~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Overall_Auto" Name="Overall Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="A001, 10 DMX" Channels="10" Id="d49cecec-8cc7-401e-a8c2-743934599ab4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Pattern_Auto" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Overall_Auto" ChannelOffset="9" Wheel="23" />
        <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="RGB" ChannelOffset="3" ModeLink="RGB cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="White" ChannelOffset="6" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Aux" ChannelOffset="7" ModeLink="Dim cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True" Id="3fb992ac-7dae-4eed-aab1-82252e138b8f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

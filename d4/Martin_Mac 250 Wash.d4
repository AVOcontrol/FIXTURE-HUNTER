      <Function ID="8" Name="Op - CTC" Display="'Op - CTC %.2f%%',0.00~100.00" Dmx="0~6939" WheelPosition="0" Colour="255,240,220" />
      <Function ID="9" Name="CTC - Pk" Display="'CTC - Pk %.2f%%',0.00~100.00" Dmx="6939~13364" WheelPosition="1" Colour="255,192,192" />
      <Function ID="10" Name="Pk - UV" Display="'Pk - UV %.2f%%',0.00~100.00" Dmx="13364~20046" WheelPosition="2" Colour="192,0,255" />
      <Function ID="11" Name="UV - Rd" Display="'UV - Rd %.2f%%',0.00~100.00" Dmx="20046~26471" WheelPosition="3" Colour="255,0,0" />
      <Function ID="12" Name="Rd - Grn" Display="'Rd - Grn %.2f%%',0.00~100.00" Dmx="26471~33153" WheelPosition="4" Colour="0,255,0" />
      <Function ID="13" Name="Grn - Blu" Display="'Grn - Blu %.2f%%',0.00~100.00" Dmx="33153~39578" WheelPosition="5" Colour="0,0,255" />
      <Function ID="14" Name="Blu - Op" Display="'Blu - Op %.2f%%',0.00~100.00" Dmx="39578~46003" WheelPosition="6" Colour="255,255,255" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="53456~58082" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="58339~62965" Colour="0,0,0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="20" Name="Random" Display="'Random %.1f%%',0.0~100.0" Dmx="65535~63222" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="E" Size="2">

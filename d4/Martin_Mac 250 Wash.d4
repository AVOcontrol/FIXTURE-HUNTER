  <AtlaBase TypeID="1e9d5088-0dd3-44b7-ad5f-db19acb21572" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="72~50" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="99~80" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="119~100" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="187~128" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls Slow" Display="'Rnd Op Pls Slow'" Dmx="194~196" Intensity="0~0" />
      <Function ID="8" Name="Rnd Op Pls Fast" Display="'Rnd Op Pls Fast'" Dmx="191~193" Intensity="0~0" />
      <Function ID="9" Name="Rnd Cl Pls Slow" Display="'Rnd Cl Pls Slow'" Dmx="200~202" Intensity="0~0" />
      <Function ID="10" Name="Rnd Cl Pls Fast" Display="'Rnd Cl Pls Fast'" Dmx="197~199" Intensity="0~0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="203~207" Intensity="0~0" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
      <Function ID="13" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" Intensity="0~0" />
      <Function ID="14" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Colour1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Colour1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CMY Random" ID="2,3,4" If="'Colour1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
      <Function ID="2" Name="Full Range" Display="'Full Range'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min Value" Display="'Min Value %.2f%%',0.00~100.00" Dmx="257~32639" Colour="0,0,0" />
      <Function ID="4" Name="Max Value" Display="'Max Value %.2f%%',100.00~0.00" Dmx="65278~32896" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1, Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1, Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1, Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1, Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1, Cyan, Magenta, Yellow" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="19,20" If="'Colour1Func'==4" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="51400~52171" WheelPosition="1" Colour="255,240,220" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="50372~51143" WheelPosition="2" Colour="255,192,192" />

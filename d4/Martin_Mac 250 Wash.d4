    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="242~3" />
      <Function ID="3" Name="Tracking PTSP SLOW" Display="'Tracking PTSP SLOW'" Dmx="243~245" />
      <Function ID="4" Name="Tracking PTSP NORM" Display="'Tracking PTSP NORM'" Dmx="246~248" />

  <History Date="26-04-05" Author="Phil Rogers" Comment="Created" />
  <History Date="27-04-05" Author="Tom" Comment="Checked" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="22-01-11" Author="Nic Morris" Comment="Removed duplicate ID's.  Increased wheel resolution for 16bit attr." />
  <History Date="22-01-11" Author="Nic Morris" Comment="Moved main CMY function to else condition.  Moved raw function to else condition." />
  <History Date="22-01-11" Author="Nic Morris" Comment="Changed CMY random update to Colour1Func.  Fixed highlight." />
  <History Date="22-01-11" Author="Nic Morris" Comment="Fixed macros to return to open shutter and added CMY to reset.  Added palettes." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="24-05-17" Author="Nic Morris" Comment="Merged some of history to reduce length." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Increased 16bit wheel resolution.  Standardised conditionals.  Revised P/T Speed functions." />
  <History Date="24-05-17" Author="Nic Morris" Comment="Revised colour index to allow full field control.  Added colour function index." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19792" ModelID="0" />

      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="76~87" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="88~99" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="100~123" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="124~135" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="136~147" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="148~159" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="160~171" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="172~183" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="184~195" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="196~207" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="208~219" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="220~231" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="232~243" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~159" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="192~223" Colour="0,255,255" />
      <Function ID="8" Name="All Bright" Display="'All Bright'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
  </Control>

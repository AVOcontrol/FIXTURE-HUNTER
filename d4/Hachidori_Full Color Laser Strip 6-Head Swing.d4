<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Full Color Laser Strip 6-Head Swing" ShortName="FCLsrStrip" Company="Hachidori" Version="7">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="11-09-20" Author="Nic Morris" Comment="Created (very poor documentation)" Version="0" />
  <History Date="05-09-22" Author="Nic Morris" Comment="Created from Unknown 6 eye laser bar (conflicting specs)" Version="1" />
  <History Date="07-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="20-09-22" Author="Nic Morris" Comment="Created from FOS Razor Laser (hopeless documentation. identical)" Version="3" />
  <History Date="22-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="22-03-23" Author="Nic Morris" Comment="Created from Space Lights Laser Moving Bar 6x1W RGB (embarrasingly bad documentation.  effectively identical)" Version="5" />
  <History Date="19-05-23" Author="Nic Morris" Comment="Created from Pro Light Full Color Laser Strip 6-Head Swing (poor documentation.  reset ranges missing - assumed identical)" Version="6" />
  <History Date="24-09-25" Author="Nic Morris" Comment="Created from Shehds 3000mW RGB 3in1 Moving Head Laser Light (very poor documentation.  effectively identical)" Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Spd" Name="Tilt Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="All_Pan" Name="All Pan" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Pan_Spd" Name="Pan Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1 (Tilt Controllable)" Display="'Auto 1 (Tilt Controllable)'" Dmx="16~45" />
      <Function ID="3" Name="Auto 2 (Tilt Controllable)" Display="'Auto 2 (Tilt Controllable)'" Dmx="46~75" />
      <Function ID="4" Name="Auto 3 (Tilt Controllable)" Display="'Auto 3 (Tilt Controllable)'" Dmx="76~105" />
      <Function ID="5" Name="Auto 4 (Tilt Controllable)" Display="'Auto 4 (Tilt Controllable)'" Dmx="106~135" />
      <Function ID="6" Name="Auto 5 (Tilt Controllable)" Display="'Auto 5 (Tilt Controllable)'" Dmx="136~165" />
      <Function ID="7" Name="Auto 6 (Tilt Controllable)" Display="'Auto 6 (Tilt Controllable)'" Dmx="166~195" />
      <Function ID="8" Name="Auto 7 (Tilt Uncontrollable)" Display="'Auto 7 (Tilt Uncontrollable)'" Dmx="196~225" />
      <Function ID="9" Name="Sound 1 (Tilt Controllable)" Display="'Sound 1 (Tilt Controllable)'" Dmx="226~240" />
      <Function ID="10" Name="Sound 2 (Tilt Uncontrollable)" Display="'Sound 2 (Tilt Uncontrollable)'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="P/T_Macro_Spd" Name="P/T Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="All_Red" Name="All Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="All_Green" Name="All Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="All_Blue" Name="All Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~27" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="28~39" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="40~51" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="52~63" />

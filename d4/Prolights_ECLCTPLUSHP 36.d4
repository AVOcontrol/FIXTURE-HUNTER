  <History Date="14-07-25" Author="Nic Morris" Comment="Created (note there is only one RDM model ID but there needs to be multiple versions to accommodate the various lens options.  As such RDM discovery will not know which version is correct.  colour macro functions missing)" Version="0" />
  <History Date="15-07-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="16" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="5584" ModelID="41014" />

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="2:1850" PowerOn="2:1850" />
      <Else ID="1" />
      <Condition Name="1850-20000K" ID="2" If="'CCT_Range'==1" />
      <Condition Name="2200-15000K" ID="3" If="'CCT_Range'==2" />
      <Condition Name="2200-20000K" ID="4" If="'CCT_Range'==4" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',2800.00~10000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.2fK',1850.00~20000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="CCT C-Mix" Display="'%.2fK',2200.00~15000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="4" Name="CCT C-Mix" Display="'%.2fK',2200.00~20000.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="2~3" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.1f%%',99.0~1.0" Dmx="4~126" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.1f%%',1.0~99.0" Dmx="129~253" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="254~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CCT_Range" Name="CCT Range" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1850-20000K" Display="'1850-20000K'" Dmx="0~0" Update="CCT" Colour="0,0,0" />
      <Function ID="2" Name="2200-15000K" Display="'2200-15000K'" Dmx="10~19" Update="CCT" Colour="0,0,0" />
      <Function ID="3" Name="2800-10000K" Display="'2800-10000K'" Dmx="20~29" Update="CCT" Colour="0,0,0" />
      <Function ID="4" Name="2200-20000K" Display="'2200-20000K'" Dmx="30~39" Update="CCT" Colour="0,0,0" />
    </Attribute>

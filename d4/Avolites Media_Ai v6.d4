  <History Date="04-01-12" Author="John Rogers" Comment="Created" />
  <History Date="30-01-12" Author="Peter Budd" Comment="Edited added ranges to Blend Mode, Aspect Ratio, Transport Ctrl, Play Mode and updated default values" />
  <History Date="15-03-12" Author="Peter Budd" Comment="Edited updated wheel assignment" />
  <History Date="23-02-12" Author="Peter Budd" Comment="Edited Updated to new specs" />
  <History Date="15-03-12" Author="Peter Budd" Comment="Edited corrected wheel mapping" />
  <History Date="12-04-12" Author="Peter Budd" Comment="Edited updated to latest spec" />
  <History Date="16-05-12" Author="Peter Budd" Comment="Changed Pan X and Pan Y to X and Y" />
  <History Date="16-04-13" Author="Gregory Haynes" Comment="Added reset macro to change all attributes then set them back to the power on state" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-09-17" Author="Nic Morris" Comment="Changed name from AI to Ai" />
  <History Date="08-03-18" Author="Nic Morris" Comment="Changed name from Ai to Ai v6 in response to OW request.  Added product thumbnail." />

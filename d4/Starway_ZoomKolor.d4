      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="111~120" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Zoom 1200 SV" ShortName="SZm1200 SV" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="31-01-03" Author="D.Shelton" Comment="Created" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. Colour - colour rotate 0-300 RPM takes 37 revolutions of encoder (17 + 20 DMX channel ver)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Zoom - Not locate at 255 (Locate)(12 + 16 + 17 + 20 DMX channel ver)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Prism Rotate + Gobo Rotate - No CCW rotation (17 + 20 DMX channel ver)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 5. CMY - Not locate at 255 values inverted 0-100 (17 + 20 DMX channel ver)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 6. Lamp - Not locate at 255. No control (Locate)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 7. Pan F + Tilt F + Gobo F - 16 bit only (17 + 20 DMX channel ver)" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 8. Pan + Tilt - 12 channel mode is as fine channel not course" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 9. Lamp off wrong value should be 33. No half power value at 90 (12 + 14 DMX channel ver)" />
  <History Date="07-10-05" Author="Ed" Comment="Fixed control channel and added macros" />
  <History Date="06-04-06" Author="Ed" Comment="Moved Frost into Beam group" />
  <History Date="07-07-06" Author="Ed" Comment="Changed CMY Mixing attributes to proper CMIXes" />
  <History Date="11-07-06" Author="Ed" Comment="Added Zoom beam angles, removed 2nd occurance of zoom text from wheels, rearragned all beam attributes to be on correct wheels" />
  <History Date="11-07-06" Author="Ed" Comment="Fixed focus wheel naming and Iris wheel naming" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="04-05-07" Author="D.Milligan" Comment="Added Dimmer Func" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-06-17" Author="Nic Morris" Comment="Changed Atlabase ID's to CMY versions.  Revised mode names to reflect settings more clearly." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Standardised highlight/lowlight.  Revised dimmer.  Renamed iris function and changed power on to match locate." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Added conditions to colour.  Added colour index options.  Revised colour scroll range." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Added colour function index.  Added colour swatches.  Increased wheel resolution." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Inverted zoom.  Changed focus power on to match locate.  Standardised gobo and prism rot." />
  <History Date="10-06-17" Author="Nic Morris" Comment="Added palettes." />
  <Manual Filename="/manual/Clay-Paky_Stage Zoom 1200 SV.pdf" Summary="Creator:mac11-gianluigi, 20-06-2002" />
  <AtlaBase TypeID="bbf5832a-4334-4a14-8c0c-e6dac2a4dddc" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Warm Filter" Display="'Warm Filter'" Dmx="16~16" WheelPosition="1" Colour="255,240,200" />
      <Function ID="3" Name="Cold Filter" Display="'Cold Filter'" Dmx="32~32" WheelPosition="2" Colour="230,230,255" />
      <Function ID="4" Name="Blue w/hole" Display="'Blue w/hole'" Dmx="48~48" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow w/hole" Display="'Yellow w/hole'" Dmx="64~64" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="80~80" WheelPosition="5" Colour="255,0,0" />
      <Function ID="7" Name="4 Colour Filter" Display="'4 Colour Filter'" Dmx="96~96" WheelPosition="6" Colour="255,255,255" />
      <Function ID="8" Name="UV Filter" Display="'UV Filter'" Dmx="112~112" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op/ CTO" Display="'Op/ CTO'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="CTO/ CTB" Display="'CTO/ CTB'" Dmx="24~24" WheelPosition="1" Colour="255,240,200" />
      <Function ID="11" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="40~40" WheelPosition="2" Colour="230,230,255" />
      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="56~56" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ Rd" Display="'Yel/ Rd'" Dmx="72~72" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Rd/ 4 Col" Display="'Rd/ 4 Col'" Dmx="88~88" WheelPosition="5" Colour="255,0,0" />
      <Function ID="15" Name="4 Col/ UV" Display="'4 Col/ UV'" Dmx="104~104" WheelPosition="6" Colour="255,255,255" />
      <Function ID="16" Name="UV/ Op" Display="'UV/ Op'" Dmx="120~120" WheelPosition="7" Colour="180,0,255" />
      <Function ID="17" Name="Op - CTO" Display="'Op - CTO %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="CTO - CTB" Display="'CTO - CTB %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="255,240,200" />
      <Function ID="19" Name="CTB - Blu" Display="'CTB - Blu %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="230,230,255" />
      <Function ID="20" Name="Blu - Yel" Display="'Blu - Yel %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="0,0,255" />
      <Function ID="21" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="255,255,0" />
      <Function ID="22" Name="Rd - 4 Col" Display="'Rd - 4 Col %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="255,0,0" />
      <Function ID="23" Name="4 Col - UV" Display="'4 Col - UV %.f%%',0~100" Dmx="96~112" WheelPosition="6" Colour="255,255,255" />
      <Function ID="24" Name="UV - Op" Display="'UV - Op %.f%%',0~100" Dmx="112~127" WheelPosition="7" Colour="180,0,255" />
      <Function ID="25" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="27" Name="Scroll" Display="'Scroll %.1f RPM',10.0~300.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~139" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f Hz',1.0~11.0" Dmx="140~243" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Zoom" Display="'%.2f°',16.00~24.00" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="4 Facet Prism" Display="'4 Facet Prism'" Dmx="52~103" />
      <Function ID="3" Name="5 Facet Prism" Display="'5 Facet Prism'" Dmx="104~155" />
      <Function ID="4" Name="2 Facet Prism" Display="'2 Facet Prism'" Dmx="156~207" />
      <Function ID="5" Name="5 Facet 3D" Display="'5 Facet 3D'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="48~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="100~151" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="152~203" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="204~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="52~103" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="104~155" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="156~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="208~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48830" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On (Half)" Display="'Lamp On (Half)'" Dmx="64~127" />
      <Function ID="3" Name="Lamp On (Full)" Display="'Lamp On (Full)'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX, 8bit (CMY)" Channels="17">
    <Import PearlRef="CPSZSV16" DiamondRef="CPSZSV8" WysiwygRef="" />
    <Physical>
      <Bulb Type="HMI 1200W/S" Lumens="110000" ColourTemp="" />
      <Lens Name="Zoom lens" Degrees="13.5~21.6" />
      <Weight Kg="63.5" />
      <Size Height="0.800" Width="0.590" Depth="0.390" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="90" TiltMaxSpeed="79" />
    </Physical>
    <AtlaBase ModeID="520d9880-7714-4a9f-9ebe-dd72e6361e11" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="14" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="15" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="16" Wheel="12" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo2" ChannelOffset="12" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="13" Wheel="18" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Frost" ChannelOffset="3" Wheel="49" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Prism_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
      <Attribute ID="Colour1Func" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="20 DMX, 16bit (CMY)" Channels="20">
    <Import PearlRef="CPStgZm12SV" DiamondRef="CPStgZoomSV" WysiwygRef="" />
    <Physical>
      <Bulb Type="HMI 1200W/S" Lumens="110000" ColourTemp="" />
      <Lens Name="Zoom lens" Degrees="13.5~21.6" />
      <Weight Kg="63.5" />
      <Size Height="0.800" Width="0.590" Depth="0.390" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="90" TiltMaxSpeed="79" />
    </Physical>
    <AtlaBase ModeID="5703cfae-a6bf-408c-b9be-2d94ef15c7fa" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5,18" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,19" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="14" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="15" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="16" Wheel="12" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo2" ChannelOffset="12" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="13,20" Wheel="18" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Frost" ChannelOffset="3" Wheel="49" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Prism_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
      <Attribute ID="Colour1Func" Wheel="7" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On (Full)">
      <Set Channel="Control:2" Delay="5000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Lamp On (Half)">
      <Set Channel="Control:3" Delay="5000" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo2:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo2:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo2:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo2:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo2:1" />
      <Palette ID="6" Name="Gobo 1" Number="16" Page="1" SetControl="Gobo2:2,Gobo1:1" />
      <Palette ID="7" Name="Gobo 2" Number="17" Page="1" SetControl="Gobo2:3,Gobo1:1" />
      <Palette ID="8" Name="Gobo 3" Number="18" Page="1" SetControl="Gobo2:4,Gobo1:1" />
      <Palette ID="9" Name="Gobo 4" Number="19" Page="1" SetControl="Gobo2:5,Gobo1:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />

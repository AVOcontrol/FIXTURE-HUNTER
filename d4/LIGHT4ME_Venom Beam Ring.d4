      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="187~120" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

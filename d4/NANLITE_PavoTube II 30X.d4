  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2b50ed6c-94d0-4f77-ad03-95ddee31b25c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2700.0~12000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta(8bit)" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="-100 Green" Display="'-100 Green'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="- Green" Display="'- Green %.f%%',99~1" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',1~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="+100 Green" Display="'+100 Green'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green/Magenta(16bit)" Name="Green/Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="-100 Green" Display="'-100 Green'" Dmx="5001~10000" Colour="255,255,255" />
      <Function ID="3" Name="- Green" Display="'- Green %.2f%%',99.00~1.00" Dmx="10001~29999" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30000~40000" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.2f%%',1.00~99.00" Dmx="40001~59999" Colour="255,255,255" />
      <Function ID="6" Name="+100 Green" Display="'+100 Green'" Dmx="60000~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT-&gt;Col_xFade" Name="CCT-&gt;Col xFade" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;Col" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
      <Function ID="3" Name="Random Slow" Display="'Random Slow'" Dmx="6~6" />
      <Function ID="4" Name="Random Med" Display="'Random Med'" Dmx="5~5" />
      <Function ID="5" Name="Random Fast" Display="'Random Fast'" Dmx="4~4" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />

    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
      <Function ID="2" Name="HSI" Display="'HSI'" Dmx="39~77" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
      <Function ID="3" Name="RGBW" Display="'RGBW'" Dmx="78~115" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
      <Function ID="4" Name="Effect" Display="'Effect'" Dmx="116~154" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
      <Function ID="5" Name="Pixel FX" Display="'Pixel FX'" Dmx="155~191" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Param_1, Param_2, Param_3, Param_4, Param_5" />
    </Attribute>
    <Attribute ID="Param_1" Name="Param 1" Description="" Group="E">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Condition Name="CCT" ID="1" If="'Mode'==1" />

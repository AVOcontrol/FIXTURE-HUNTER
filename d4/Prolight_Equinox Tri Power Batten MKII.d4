  <AtlaBase TypeID="c8aabf4f-b570-4609-b0f4-f2155a908d1e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="1~14" Update="Program_Spd" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="15~29" Update="Program_Spd" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="30~44" Update="Program_Spd" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="45~59" Update="Program_Spd" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="60~74" Update="Program_Spd" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="75~89" Update="Program_Spd" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="90~104" Update="Program_Spd" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="105~119" Update="Program_Spd" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="120~134" Update="Program_Spd" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="135~149" Update="Program_Spd" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="150~164" Update="Program_Spd" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="165~179" Update="Program_Spd" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="180~194" Update="Program_Spd" />
      <Function ID="15" Name="Program 15" Display="'Program 15'" Dmx="195~209" Update="Program_Spd" />
      <Function ID="16" Name="Program 16" Display="'Program 16'" Dmx="210~224" Update="Program_Spd" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="225~255" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Program'==17" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

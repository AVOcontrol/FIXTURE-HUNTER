  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control:3" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Square">
      <Set Channel="Control:4" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Inv Sq">
      <Set Channel="Control:5" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim S-Curve">
      <Set Channel="Control:6" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:7" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:8" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Full">
      <Set Channel="Control:10" Delay="6000" />

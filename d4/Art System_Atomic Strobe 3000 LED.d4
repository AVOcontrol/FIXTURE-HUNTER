      <Function ID="34" Name="LEE 164" Display="'LEE 164'" Dmx="171~175" Colour="255,50,0" />
      <Function ID="35" Name="Magenta" Display="'Magenta'" Dmx="176~180" Colour="255,0,255" />
      <Function ID="36" Name="Medium Lavender" Display="'Medium Lavender'" Dmx="181~185" Colour="255,128,255" />
      <Function ID="37" Name="White" Display="'White'" Dmx="186~190" Colour="255,255,255" />
      <Function ID="38" Name="No Scroll" Display="'No Scroll'" Dmx="215~219" Colour="255,255,255" />

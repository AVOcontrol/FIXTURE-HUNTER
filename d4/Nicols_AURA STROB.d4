      <Function ID="12" Name="Medium Blue" Display="'Medium Blue'" Dmx="61~65" Colour="128,255,255" />
      <Function ID="13" Name="Double CT Blue" Display="'Double CT Blue'" Dmx="66~70" Colour="230,230,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Legend 330SR Spot" ShortName="Lg330SR Sp" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-05-10" Author="John Rogers" Comment="Created" />
  <History Date="05-04-11" Author="John Rogers" Comment="Rewrote Prism and Prism_Rot in response to manufacturer." />
  <History Date="28-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution.  Standardised func names." />
  <History Date="28-06-11" Author="Nic Morris" Comment="Modified Gobo1Func to provide access to all functions." />
  <History Date="28-06-11" Author="Nic Morris" Comment="Removed faulty duplicate macros.  Added missing macros.  Added missing shutter functions." />
  <History Date="15-11-13" Author="Peter Budd" Comment="Created from the Chauvet Legend 300E Spot." />
  <History Date="26-08-14" Author="Nic Morris" Comment="Renamed colours in response to manufactuer request.  Changed colour mix to percentage range." />
  <History Date="26-08-14" Author="Nic Morris" Comment="Removed prism func and recreated prism functions.  Changed Prism Rot from 16-bit to 8-bit." />
  <History Date="16-09-14" Author="Nic Morris" Comment="Updated prism functions in response to manufacturer request." />
  <History Date="17-07-15" Author="Nic Morris" Comment="Added classic pearl refs for vis" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-10-17" Author="Nic Morris" Comment="Changed name from Legend 330 SR Spot to Legend 330SR Spot.  Added physical p/t limits." />
  <History Date="09-10-17" Author="Nic Morris" Comment="Fixed gobos (wheel 1 was missing gobo 8, wheel 2 missing 9-14).  Gobo shake ranges not documentated (guessed)." />
  <History Date="09-10-17" Author="Nic Morris" Comment="Revised iris ranges.  Revised control functions and macros.  Recreated palettes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5ee73920-7e72-458e-b44d-31ba6a81c3bd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="132~167" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="168~203" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="204~239" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" Colour="255,255,0" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="24~31" Colour="100,200,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~47" Colour="255,100,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~55" Colour="0,0,255" />
      <Function ID="8" Name="CTO" Display="'CTO'" Dmx="56~63" Colour="255,200,150" />
      <Function ID="9" Name="Index" Display="'Index %.f%%',0~100" Dmx="64~127" Colour="255,255,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />

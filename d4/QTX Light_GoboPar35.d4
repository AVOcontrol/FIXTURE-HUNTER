        <Attribute ID="Gobo_Macro" ChannelOffset="11" Wheel="13" />
        <Attribute ID="Gobo_Strobe" ChannelOffset="12" Wheel="6" />
      </Master>
      <Cell ID="Cell1" Name="RGB" ChannelOffset="2" ModeLink="RGB cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Pattern 1" ChannelOffset="5" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Pattern 2" ChannelOffset="6" ModeLink="Dim cell" X="0" Y="2">

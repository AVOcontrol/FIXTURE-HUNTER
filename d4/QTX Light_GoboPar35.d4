    <AtlaBase ModeID="48b8b85c-bf67-4a00-9d2b-dd80e91aff0b" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />

      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="8" If="'Colour2Func'==2" />
      <Condition Name="Macro" ID="9,10,11,12,13,14" If="'Colour2Func'==3" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour2Func'==4" />
      <Else ID="19" />

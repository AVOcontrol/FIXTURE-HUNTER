      <Function ID="5" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="186~239" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="10~18" Colour="0,128,255" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="19~27" Colour="255,150,150" />
      <Function ID="4" Name="UV Purple" Display="'UV Purple'" Dmx="28~36" Colour="180,0,255" />
      <Function ID="5" Name="Light Green" Display="'Light Green'" Dmx="37~45" Colour="128,255,0" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="46~54" Colour="255,240,200" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="55~63" Colour="230,230,255" />
      <Function ID="8" Name="Index" Display="'%.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />

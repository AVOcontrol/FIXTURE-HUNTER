  <Thumbnail>4d7391fb-75ea-45ba-baf5-c9a25e833a11</Thumbnail>
  <History Date="24-05-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="14-04-16" Author="Nic Morris" Comment="Split autofocus into two separate 8 bit controls in response to manufacturer bug report." Version="2" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Swapped focus and zoom wheel slots in response to manufacturer bug report." Version="4" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Changed All Blade Rot to locate and power on at 50% in response to customer bug report." Version="5" />
  <History Date="11-05-17" Author="Nic Morris" Comment="Reverted blade rot to power on and locate at zero." Version="6" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." Version="7" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Added gobo swatches.  Added colour names and swatches." Version="8" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Changed blades to two-point system in response to manufacturer request (documentation is incorrect).  Calibrated in line with manufacturer data" Version="9" />
  <History Date="04-01-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel counts to mode names." Version="10" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="11" />

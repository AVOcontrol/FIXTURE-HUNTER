<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED KLS-2500" ShortName="KLS-2500" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="05-12-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Program Speed" ID="2" If="'Program'&gt;1&amp;&amp;'Program'&gt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Program Fade" ID="2" If="'Program'&gt;1&amp;&amp;'Program'&gt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~9" Update="Red, Green, Speed" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~29" Update="Red, Green, Speed" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="30~49" Update="Red, Green, Speed" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="50~69" Update="Red, Green, Speed" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="70~89" Update="Red, Green, Speed" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="90~109" Update="Red, Green, Speed" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="110~129" Update="Red, Green, Speed" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="130~149" Update="Red, Green, Speed" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="150~169" Update="Red, Green, Speed" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="170~189" Update="Red, Green, Speed" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="190~209" Update="Red, Green, Speed" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="210~229" Update="Red, Green, Speed" />
      <Function ID="13" Name="Program 0" Display="'Program 0'" Dmx="230~249" Update="Red, Green, Speed" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red, Green, Speed" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="16~23" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="A" Display="'A'" Dmx="32~39" Colour="255,255,255" />
      <Function ID="6" Name="W" Display="'W'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="RG" Display="'RG'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="RB" Display="'RB'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="RA" Display="'RA'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="RW" Display="'RW'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="GB" Display="'GB'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="GA" Display="'GA'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="GW" Display="'GW'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="BA" Display="'BA'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="BW" Display="'BW'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="AW" Display="'AW'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="17" Name="RGB" Display="'RGB'" Dmx="128~135" Colour="255,255,255" />
      <Function ID="18" Name="RGA" Display="'RGA'" Dmx="136~143" Colour="255,255,255" />
      <Function ID="19" Name="RGW" Display="'RGW'" Dmx="144~151" Colour="255,255,255" />
      <Function ID="20" Name="RBA" Display="'RBA'" Dmx="152~159" Colour="255,255,255" />
      <Function ID="21" Name="RBW" Display="'RBW'" Dmx="160~167" Colour="255,255,255" />
      <Function ID="22" Name="RAW" Display="'RAW'" Dmx="168~175" Colour="255,255,255" />
      <Function ID="23" Name="GBA" Display="'GBA'" Dmx="176~183" Colour="255,255,255" />
      <Function ID="24" Name="GBW" Display="'GBW'" Dmx="184~191" Colour="255,255,255" />
      <Function ID="25" Name="BAW" Display="'BAW'" Dmx="192~199" Colour="255,255,255" />
      <Function ID="26" Name="GAW" Display="'GAW'" Dmx="200~207" Colour="255,255,255" />
      <Function ID="27" Name="RGBA" Display="'RGBA'" Dmx="208~215" Colour="255,255,255" />
      <Function ID="28" Name="RGBW" Display="'RGBW'" Dmx="216~223" Colour="255,255,255" />
      <Function ID="29" Name="RGAW" Display="'RGAW'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="30" Name="RBAW" Display="'RBAW'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="31" Name="GBAW" Display="'GBAW'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="32" Name="RGBAW" Display="'RGBAW'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2,3" If="'Program'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~10" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Generic" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~15" />
      <Function ID="2" Name="Auto Slow" Display="'Auto Slow'" Dmx="16~89" />
      <Function ID="3" Name="Auto Med" Display="'Auto Med'" Dmx="90~164" />
      <Function ID="4" Name="Auto Fast" Display="'Auto Fast'" Dmx="165~240" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Synthesis Spot 700" ShortName="Syn Sp 700" Company="SGM">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-04-06" Author="Ed" Comment="Created" />
  <History Date="24-04-06" Author="Ed" Comment="Checked" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="09-11-06" Author="D.Milligan" Comment="Fixed locate values" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="22-08-17" Author="Nic Morris" Comment="Changed name from Giotto Synthesis 700 to Synthesis Spot 700" />
  <History Date="22-08-17" Author="Nic Morris" Comment="Revised mode names.  Added Atlabase ID's.  Standardised condionals." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Renamed colour mode to colour func, removed colour update." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Added raw colour option.  Fixed duplicate functions in else conditions.  Added function index." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Realighned split colour swatches.  Changed colour scroll to a single variable range." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Fixed gobo 1 func update (was updating gobo 2).  Changed shutter to power on to match locate." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Inverted zoom.  Standardised spin wheel directions.  Changed gobo shake to single variable range." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Increased 16bit wheel resolution.  Fixed gobo 1 Rot 16bit raw display range." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Added palettes.  Changed control to power on and locate at zero." />
  <History Date="22-08-17" Author="Nic Morris" Comment="Fixed LRV mode channel mapping." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eb3fadd9-25dd-4d11-9ecb-d777d9b34ff7" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="51~101" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="102~152" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="153~203" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="204~255" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="16" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="17" If="'Colour1Func'==4" />
      <Condition Name="Sound" ID="18,19" If="'Colour1Func'==5" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="36~71" WheelPosition="2" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="72~107" WheelPosition="3" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="108~145" WheelPosition="4" Colour="0,0,255" />
      <Function ID="5" Name="Pink" Display="'Pink'" Dmx="146~181" WheelPosition="5" Colour="255,150,150" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="182~215" WheelPosition="6" Colour="255,100,0" />
      <Function ID="7" Name="Wood" Display="'Wood'" Dmx="216~255" WheelPosition="7" Colour="255,240,200" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="32~63" WheelPosition="1" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="64~95" WheelPosition="2" Colour="255,0,0" />
      <Function ID="11" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="96~127" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="128~159" WheelPosition="4" Colour="0,0,255" />
      <Function ID="13" Name="Pk/ Amb" Display="'Pk/ Amb'" Dmx="160~191" WheelPosition="5" Colour="255,150,150" />
      <Function ID="14" Name="Amb/ Wd" Display="'Amb/ Wd'" Dmx="192~223" WheelPosition="6" Colour="255,100,0" />
      <Function ID="15" Name="Wd/ Op" Display="'Wd/ Op'" Dmx="224~255" WheelPosition="7" Colour="255,240,200" />
      <Function ID="16" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="17" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="18" Name="Fixed" Display="'Fixed'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Split" Display="'Split'" Dmx="128~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />

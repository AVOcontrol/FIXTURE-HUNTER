  <Thumbnail>036f1fef-1ef4-4d8f-95ef-78bf0b210b04</Thumbnail>
  <History Date="01-08-24" Author="Nic Morris" Comment="Created (hopeless documentation.  complete mess.  gobo 1 ranges appear to be missing.  gobo 2 ranges look wrong." Version="0" />
  <History Date="02-08-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="83fde8b4-ab23-4ff7-bbd6-264ca9028d90" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~251" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~5" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="10~10" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Aquamarine" Display="'Aquamarine'" Dmx="15~15" WheelPosition="3" Colour="0,255,200" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~20" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Light Green" Display="'Light Green'" Dmx="25~25" WheelPosition="5" Colour="128,255,0" />
      <Function ID="7" Name="Lavender" Display="'Lavender'" Dmx="30~30" WheelPosition="6" Colour="255,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="35~39" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="40~40" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="45~45" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="50~50" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="Aq/ Grn" Display="'Aq/ Grn'" Dmx="55~55" WheelPosition="3" Colour="0,255,200" />
      <Function ID="13" Name="Grn/ L Grn" Display="'Grn/ L Grn'" Dmx="60~60" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="L Grn/ Lav" Display="'L Grn/ Lav'" Dmx="65~65" WheelPosition="5" Colour="128,255,0" />
      <Function ID="15" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="70~70" WheelPosition="6" Colour="255,128,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="75~79" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="80~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="8,9" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~10" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~20" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~30" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~40" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~50" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="9" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="226~230" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="70~129" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="135~225" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6,7" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~63" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="3" Name="Spin F-&gt;S (1)" Display="'Spin F-&gt;S (1) %.f%%',100~0" Dmx="64~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="5" Name="Spin F-&gt;S (2)" Display="'Spin F-&gt;S (2) %.f%%',100~0" Dmx="128~190" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="191~192" WheelPosition="0" />
      <Function ID="7" Name="Spin S-&gt;F" Display="'Spin S-&gt;F %.f%%',0~100" Dmx="193~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="10~14" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="15~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14" Id="11b8bb4b-8c38-4181-b520-78039992ddeb">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9677f4cc-d717-4dd0-8135-785bd806fead" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Pan" ChannelOffset="3,12" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4,13" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="8" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="9" Wheel="18" />
      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Focus" ChannelOffset="11" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="4" Name="Orange" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Light Green" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Aquamarine" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Aquamarine" Number="6" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="9" Name="Aquamarine" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="No Scroll" Number="7" Page="1" SetControl="Colour1:17,Colour1Func:3" />
      <Palette ID="11" Name="Lavender" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="12" Name="Lavender" Number="10" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Lavender" Number="8" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="15" Name="Lavender" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="2" Name="Open" Number="12" Page="1" SetControl="Gobo2:1,Gobo2Func:2" />
      <Palette ID="3" Name="Gobo 1" Number="13" Page="1" SetControl="Gobo2:2,Gobo2Func:2" />
      <Palette ID="4" Name="Gobo 2" Number="14" Page="1" SetControl="Gobo2:3,Gobo2Func:2" />
      <Palette ID="5" Name="Gobo 3" Number="15" Page="1" SetControl="Gobo2:4,Gobo2Func:2" />
      <Palette ID="6" Name="Gobo 4" Number="16" Page="1" SetControl="Gobo2:5,Gobo2Func:2" />
      <Palette ID="7" Name="Gobo 5" Number="17" Page="1" SetControl="Gobo2:6,Gobo2Func:2" />
      <Palette ID="8" Name="Gobo 6" Number="18" Page="1" SetControl="Gobo2:7,Gobo2Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />

  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="2" />
  <History Date="27-01-23" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added vdim to cells.  Removed invalid palettes." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f6324374-fde0-4a25-a4a6-74137ddbfa34" />
  <Control>
    <Attribute ID="Shows" Name="Shows" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~247" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Fade 1" Display="'Fade 1'" Dmx="8~22" Colour="255,255,255" />
      <Function ID="3" Name="Fade 2" Display="'Fade 2'" Dmx="23~37" Colour="255,255,255" />
      <Function ID="4" Name="Colour Chase 3" Display="'Colour Chase 3'" Dmx="38~52" Colour="255,255,255" />
      <Function ID="5" Name="Colour Chase 4" Display="'Colour Chase 4'" Dmx="53~67" Colour="255,255,255" />
      <Function ID="6" Name="Colour Chase 5" Display="'Colour Chase 5'" Dmx="68~82" Colour="255,255,255" />
      <Function ID="7" Name="Colour Chase 6" Display="'Colour Chase 6'" Dmx="83~97" Colour="255,255,255" />
      <Function ID="8" Name="Colour Chase 7" Display="'Colour Chase 7'" Dmx="98~112" Colour="255,255,255" />
      <Function ID="9" Name="Colour Chase 8" Display="'Colour Chase 8'" Dmx="113~127" Colour="255,255,255" />
      <Function ID="10" Name="Colour Chase 9" Display="'Colour Chase 9'" Dmx="128~142" Colour="255,255,255" />
      <Function ID="11" Name="Colour Chase 10" Display="'Colour Chase 10'" Dmx="143~157" Colour="255,255,255" />
      <Function ID="12" Name="Colour Chase 11" Display="'Colour Chase 11'" Dmx="158~172" Colour="255,255,255" />
      <Function ID="13" Name="Colour Chase 12" Display="'Colour Chase 12'" Dmx="173~187" Colour="255,255,255" />
      <Function ID="14" Name="Colour Chase 13" Display="'Colour Chase 13'" Dmx="188~202" Colour="255,255,255" />
      <Function ID="15" Name="Colour Chase 14" Display="'Colour Chase 14'" Dmx="203~217" Colour="255,255,255" />
      <Function ID="16" Name="Colour Chase 15" Display="'Colour Chase 15'" Dmx="218~232" Colour="255,255,255" />
      <Function ID="17" Name="Colour Chase 16" Display="'Colour Chase 16'" Dmx="233~247" Colour="255,255,255" />
      <Function ID="18" Name="Stand Alone" Display="'Stand Alone'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Hold" Display="'Hold'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="JBSRAIN1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

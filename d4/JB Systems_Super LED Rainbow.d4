    <AtlaBase ModeID="68a62a13-c712-4e58-a709-39c4c6b84722" />
    <Include>
      <Attribute ID="Shows" ChannelOffset="1" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">

  <History Date="22-01-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="22-01-15" Author="Gabi de Moitelle" Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed physical to fixed.  Increased wheel resolution" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed hue and saturation to percentage ranges.  Added macros." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Fixed virtual attribute error in Arc2.  Changed effect speed to effect group." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Updated RGB power on to locate values." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Standardised.  Added zoom palettes.  Added missing Atlabase ID's." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="261648de-07f1-4353-a56d-f67ad7504a06" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Color Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="4" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="5" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="6" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="8" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="9" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="10" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="11" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="12" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="13" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />

      <Function ID="13" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="66~71" WheelPosition="1" />
      <Function ID="14" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="72~77" WheelPosition="2" />
      <Function ID="15" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="78~83" WheelPosition="3" />
      <Function ID="16" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="84~89" WheelPosition="4" />
      <Function ID="17" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="90~95" WheelPosition="5" />

      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="24~25" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="26~27" WheelPosition="13" />

  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="7000" />
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:14" Delay="7000" />
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5" Delay="7000" />
      <Set Channel="Control:1" Delay="5000" />

    <Attribute ID="Blit" Name="Blit Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="PiP" Display="'PiP'" Dmx="0~0" />
      <Function ID="2" Name="Add" Display="'Add'" Dmx="1~1" />
      <Function ID="3" Name="Strong Add" Display="'Strong Add'" Dmx="2~2" />
      <Function ID="4" Name="Substract" Display="'Substract'" Dmx="3~3" />
      <Function ID="5" Name="Multiply" Display="'Multiply'" Dmx="4~4" />
      <Function ID="6" Name="Luminance" Display="'Luminance'" Dmx="5~5" />
      <Function ID="7" Name="Strong Luminance" Display="'Strong Luminance'" Dmx="6~6" />
      <Function ID="8" Name="Darken" Display="'Darken'" Dmx="7~7" />
      <Function ID="9" Name="Lighten" Display="'Lighten'" Dmx="8~8" />
      <Function ID="10" Name="Diff B/W" Display="'Diff B/W'" Dmx="9~9" />
    </Attribute>
    <Attribute ID="Tiling" Name="Tiling" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Tiles" Display="'No Tiles'" Dmx="0~0" />
      <Function ID="2" Name="X Tiling" Display="'X Tiling'" Dmx="1~1" />
      <Function ID="3" Name="Y Tiling" Display="'Y Tiling'" Dmx="2~2" />
      <Function ID="4" Name="XY Tiling" Display="'XY Tiling'" Dmx="3~3" />
    </Attribute>
    <Attribute ID="Aspect_Mode" Name="Aspect Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fill" Display="'Fill'" Dmx="0~0" />
      <Function ID="2" Name="Aspect" Display="'Aspect'" Dmx="1~1" />
      <Function ID="3" Name="1 by 1" Display="'1 by 1'" Dmx="2~2" />
      <Function ID="4" Name="per pixel" Display="'per pixel'" Dmx="3~3" />
      <Function ID="5" Name="user 1" Display="'user 1'" Dmx="4~4" />
      <Function ID="6" Name="user 2" Display="'user 2'" Dmx="5~5" />
      <Function ID="7" Name="user 3" Display="'user 3'" Dmx="6~6" />
    </Attribute>
    <Attribute ID="Key_In" Name="Key In" Description="" Group="S" Size="2">

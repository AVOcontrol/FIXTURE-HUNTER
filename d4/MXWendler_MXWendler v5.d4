      <Attribute ID="FX_Parm_3" ChannelOffset="22" Wheel="54" />
      <Attribute ID="Speed" ChannelOffset="23,24" Wheel="25" />
      <Attribute ID="Blit" ChannelOffset="25" Wheel="28" />
      <Attribute ID="Tiling" ChannelOffset="26" Wheel="29" />

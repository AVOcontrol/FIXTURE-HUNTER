      <Attribute ID="Green" ChannelOffset="15" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="16" Wheel="12" />
      <Attribute ID="File" ChannelOffset="12" Wheel="13" />
      <Attribute ID="Folder" ChannelOffset="13" Wheel="14" />
      <Attribute ID="Effect" ChannelOffset="17" Wheel="22" />
      <Attribute ID="Effect_Bank" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Effect_Master" ChannelOffset="19" Wheel="24" />
      <Attribute ID="FX_Parm_1" ChannelOffset="20" Wheel="52" />

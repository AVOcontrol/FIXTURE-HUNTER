      <Function ID="1" Name="Key Out" Display="'Key Out %.f',0~65535" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="31">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

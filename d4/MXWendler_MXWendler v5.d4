      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FX Parm 1" Display="'FX Parm 1 %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Parm_2" Name="FX Parm 2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FX Parm 2" Display="'FX Parm 2 %.f',0~255" Dmx="0~255" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Translation_X" Name="Translation X" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Translation X" Display="'Translation X %.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Translation_Y" Name="Translation Y" Description="" Group="P" Size="2">

      <Function ID="26" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="168~174" WheelPosition="10" />
      <Function ID="27" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="175~181" WheelPosition="11" />
      <Function ID="28" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="182~188" WheelPosition="12" />

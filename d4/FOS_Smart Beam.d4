      <Function ID="32" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="203~255" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />

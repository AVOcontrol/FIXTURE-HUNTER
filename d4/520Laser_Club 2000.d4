      <Function ID="8" Name="Show 5" Display="'Show 5'" Dmx="80~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Show 6" Display="'Show 6'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Show 7" Display="'Show 7'" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Show 8" Display="'Show 8'" Dmx="128~143" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Show 9" Display="'Show 9'" Dmx="144~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Show 10" Display="'Show 10'" Dmx="160~175" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Show 11" Display="'Show 11'" Dmx="176~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Show 12" Display="'Show 12'" Dmx="192~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Show 13" Display="'Show 13'" Dmx="208~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Show 14" Display="'Show 14'" Dmx="224~239" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Show 15" Display="'Show 15'" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">

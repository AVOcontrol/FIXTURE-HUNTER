      <Function ID="3" Name="Dark Green" Display="'Dark Green'" Dmx="93~93" WheelPosition="2" Colour="0,180,0" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="146~146" WheelPosition="3" Colour="128,255,0" />
      <Function ID="5" Name="UV Blue" Display="'UV Blue'" Dmx="202~202" WheelPosition="4" Colour="180,0,255" />
      <Function ID="6" Name="Dark Orange" Display="'Dark Orange'" Dmx="255~255" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="1~32" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="D Rd/ D Grn" Display="'D Rd/ D Grn'" Dmx="71~81" WheelPosition="1" Colour="180,0,0" />
      <Function ID="9" Name="D Grn/ L Grn" Display="'D Grn/ L Grn'" Dmx="94~125" WheelPosition="2" Colour="0,180,0" />
      <Function ID="10" Name="L Grn/ UV" Display="'L Grn/ UV'" Dmx="147~196" WheelPosition="3" Colour="128,255,0" />
      <Function ID="11" Name="UV/ D Org" Display="'UV/ D Org'" Dmx="203~237" WheelPosition="4" Colour="180,0,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />

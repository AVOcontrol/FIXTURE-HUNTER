  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Energy Saving Mode (360W)" Display="'Energy Saving Mode (360W)'" Dmx="20~24" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="5" Name="Reset Effect" Display="'Reset Effect'" Dmx="160~169" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="7" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="43~43" WheelPosition="1" Colour="255,150,150" />
      <Function ID="3" Name="Light Orange" Display="'Light Orange'" Dmx="103~103" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Light Purple" Display="'Light Purple'" Dmx="145~145" WheelPosition="3" Colour="128,0,255" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="202~202" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Dark Blue" Display="'Dark Blue'" Dmx="255~255" WheelPosition="5" Colour="0,0,180" />
      <Function ID="7" Name="Op/ Pk" Display="'Op/ Pk'" Dmx="1~34" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Pk/ L Org" Display="'Pk/ L Org'" Dmx="82~96" WheelPosition="1" Colour="255,150,150" />
      <Function ID="9" Name="L Org/ L Ppl" Display="'L Org/ L Ppl'" Dmx="114~141" WheelPosition="2" Colour="255,128,0" />
      <Function ID="10" Name="L Ppl/ Blu" Display="'L Ppl/ Blu'" Dmx="152~190" WheelPosition="3" Colour="128,0,255" />
      <Function ID="11" Name="Blu/ D Blu" Display="'Blu/ D Blu'" Dmx="203~239" WheelPosition="4" Colour="0,0,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />

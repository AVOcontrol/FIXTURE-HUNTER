    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="0~254" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Velocity" Name="Velocity" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White_Flash" Name="White Flash" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />

  <Thumbnail>cbfd0b84-e299-46ba-ade4-7436968f2bc4</Thumbnail>
  <History Date="23-05-23" Author="Nic Morris" Comment="Created (poor documentation.  contains range conflicts)" Version="0" />
  <History Date="26-05-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c1852d15-d1e0-4901-8bab-ce436eb1c4c3" />
  <Control>
    <Attribute ID="Derby_Strobe" Name="Derby Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="6 DMX" ID="2,3,4" If="'Macro'&gt;1||'Macro'&lt;7" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Par Red" Display="'Par Red %.f%%',0~100" Dmx="8~15" Colour="255,0,0" />
      <Function ID="4" Name="Par+Derby Red" Display="'Par+Derby Red %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="6 DMX" ID="2,3,4" If="'Macro'&gt;1||'Macro'&lt;7" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Par Green" Display="'Par Green %.f%%',0~100" Dmx="8~15" Colour="0,255,0" />
      <Function ID="4" Name="Par+Derby Green" Display="'Par+Derby Green %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Else ID="1" />
      <Condition Name="6 DMX" ID="2,3,4" If="'Macro'&gt;1||'Macro'&lt;7" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Par Blue" Display="'Par Blue %.f%%',0~100" Dmx="8~15" Colour="0,0,255" />
      <Function ID="4" Name="Par+Derby Blue" Display="'Par+Derby Blue %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="6 DMX" ID="2,3,4" If="'Macro'&gt;1||'Macro'&lt;7" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Par White" Display="'Par White %.f%%',0~100" Dmx="8~15" Colour="255,255,255" />
      <Function ID="4" Name="Par+Derby White" Display="'Par+Derby White %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Motor" Name="Motor" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Derby_Macro" Name="Derby Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Par_Strobe" Name="Par Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Par_Mode" Name="Par Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="6~84" />
      <Function ID="3" Name="Pulse" Display="'Pulse'" Dmx="85~166" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="167~255" />
    </Attribute>
    <Attribute ID="Par_Mode_Spd" Name="Par Mode Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Red, Green, Blue, White" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="6~47" Update="Red, Green, Blue, White" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="48~89" Update="Red, Green, Blue, White" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="90~131" Update="Red, Green, Blue, White" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="132~172" Update="Red, Green, Blue, White" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="173~214" Update="Red, Green, Blue, White" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="215~255" Update="Red, Green, Blue, White" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="a24dab12-c6c8-4589-b01c-742d313478e1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

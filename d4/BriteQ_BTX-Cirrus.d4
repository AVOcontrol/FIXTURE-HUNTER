      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Strobe" Name="BG Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Select" Name="BG Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Wash Mode" Display="'Wash Mode'" Dmx="0~0" />
      <Function ID="2" Name="Pix 1" Display="'Pix 1'" Dmx="9~9" />
      <Function ID="3" Name="Ring 2" Display="'Ring 2'" Dmx="10~10" />
      <Function ID="4" Name="Ring 3" Display="'Ring 3'" Dmx="11~11" />
      <Function ID="5" Name="Pix 1+Ring 3" Display="'Pix 1+Ring 3'" Dmx="12~12" />
      <Function ID="6" Name="Pix 1+Ring 2" Display="'Pix 1+Ring 2'" Dmx="13~13" />
      <Function ID="7" Name="Pix 1+Ring 2+Ring 3" Display="'Pix 1+Ring 2+Ring 3'" Dmx="14~14" />
      <Function ID="8" Name="Ring 2+Ring 3" Display="'Ring 2+Ring 3'" Dmx="15~15" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

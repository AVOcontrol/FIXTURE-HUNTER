  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_4 Stage Pak.d4 to ADJ_4 Stage Pak.d4." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="55f75c8f-80e3-4b41-b57f-1aa280ff3bcf" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2,3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;5" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2,3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;5" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Select" ID="2,3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;5" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;8" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Shutter, Red, Green, Blue" />
      <Function ID="2" Name="Dim" Display="'Dim'" Dmx="32~63" Update="Shutter, Red, Green, Blue" />
      <Function ID="3" Name="Light" Display="'Light'" Dmx="64~95" Update="Shutter, Red, Green, Blue" />
      <Function ID="4" Name="Dim + Light" Display="'Dim + Light'" Dmx="96~127" Update="Shutter, Red, Green, Blue" />
      <Function ID="5" Name="Col Mix" Display="'Col Mix'" Dmx="128~159" Update="Shutter, Red, Green, Blue" />
      <Function ID="6" Name="3 Col Strobe" Display="'3 Col Strobe'" Dmx="160~191" Update="Shutter, Red, Green, Blue" />
      <Function ID="7" Name="7 Col Strobe" Display="'7 Col Strobe'" Dmx="192~223" Update="Shutter, Red, Green, Blue" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter, Red, Green, Blue" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="ADJ4STPK" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

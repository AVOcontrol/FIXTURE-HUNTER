    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="3" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="4" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="5" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="6" Name="Theatre Mode On" Display="'Theatre Mode On'" Dmx="110~139" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="8" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="9" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />

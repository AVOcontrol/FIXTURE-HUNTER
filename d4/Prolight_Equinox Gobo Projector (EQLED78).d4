    <Attribute ID="Gobo1Rot1" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="125~0" />

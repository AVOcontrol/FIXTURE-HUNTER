  <History Date="29-03-23" Author="Nic Morris" Comment="Added 10 channel mode in line with latest documentation." Version="1" />
  <History Date="21-09-24" Author="Nic Morris" Comment="Created from Shehds 3000mw RGB Scan Laser" Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Coordinate" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Coordinate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Coordinate" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Coordinate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Col Select" Display="'Col Select %.f%%',0~100" Dmx="0~63" Colour="0,0,0" />
      <Function ID="2" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="64~95" Colour="0,0,0" />
      <Function ID="3" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="96~127" Colour="0,0,0" />
      <Function ID="4" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="128~159" Colour="0,0,0" />
      <Function ID="5" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="160~191" Colour="0,0,0" />
      <Function ID="6" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="192~223" Colour="0,0,0" />
      <Function ID="7" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Scan_Mode" Name="Scan Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Line Scanning" Display="'Line Scanning'" Dmx="0~0" />
      <Function ID="2" Name="Point Scanning" Display="'Point Scanning'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Anim/Pattern" Name="Anim/Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Library" Name="Library" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Animation Library 1" Display="'Animation Library 1'" Dmx="0~0" />
      <Function ID="2" Name="Animation Library 2" Display="'Animation Library 2'" Dmx="8~15" />
      <Function ID="3" Name="Animation Library 3" Display="'Animation Library 3'" Dmx="16~23" />
      <Function ID="4" Name="Pattern Library" Display="'Pattern Library'" Dmx="24~255" />
    </Attribute>
    <Attribute ID="Play_Speed" Name="Play Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="27~127" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Draw_Effect" Name="Draw Effect" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Draw Effect Speed" Display="'Draw Effect Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Twisted_Waves" Name="Twisted Waves" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="X-Axis Twisted Waves" Display="'X-Axis Twisted Waves %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Y-Axis Twisted Waves" Display="'Y-Axis Twisted Waves %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Expert, 18 DMX" Channels="18" Id="47eeeae3-27c4-46e2-87b6-5f93f396e8b6">

  <Mode Name="Cell" Channels="2" Hidden="True" Id="77c657fe-fa86-43e9-92c0-02c72f016619">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

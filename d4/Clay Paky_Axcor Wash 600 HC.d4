  <History Date="17-05-19" Author="Nic Morris" Comment="Created (04/2019 charts)" Version="1" />
  <History Date="14-02-20" Author="Nic Morris" Comment="Revised Colour 2 and Function functions in line with 01/2020 charts." Version="2" />
  <History Date="19-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cee25f11-6728-4745-806c-a47209eb5be6" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="21~21" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="42~42" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="CRI" Display="'CRI'" Dmx="63~63" WheelPosition="3" Colour="255,255,255" />
      <Function ID="5" Name="Gold Amber" Display="'Gold Amber'" Dmx="84~84" WheelPosition="4" Colour="255,100,0" />
      <Function ID="6" Name="Navy Blue" Display="'Navy Blue'" Dmx="106~106" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="11~11" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="D Rd/ Grn" Display="'D Rd/ Grn'" Dmx="32~32" WheelPosition="1" Colour="180,0,0" />
      <Function ID="9" Name="Grn/ CRI" Display="'Grn/ CRI'" Dmx="53~53" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="CRI/ G Amb" Display="'CRI/ G Amb'" Dmx="74~74" WheelPosition="3" Colour="255,255,255" />
      <Function ID="11" Name="G Amb/ N Blu" Display="'G Amb/ N Blu'" Dmx="95~95" WheelPosition="4" Colour="255,100,0" />
      <Function ID="12" Name="N Blu/ Op" Display="'N Blu/ Op'" Dmx="118~118" WheelPosition="5" Colour="0,0,255" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="13,14" If="'Colour2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow Green" Display="'Yellow Green'" Dmx="21~21" WheelPosition="1" Colour="180,180,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="42~42" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Lavender" Display="'Lavender'" Dmx="63~63" WheelPosition="3" Colour="255,128,255" />
      <Function ID="5" Name="Pink" Display="'Pink'" Dmx="84~84" WheelPosition="4" Colour="255,150,150" />
      <Function ID="6" Name="Aquamarine" Display="'Aquamarine'" Dmx="106~106" WheelPosition="5" Colour="0,255,200" />
      <Function ID="7" Name="Op/ Y Grn" Display="'Op/ Y Grn'" Dmx="11~11" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Y Grn/ Yel" Display="'Y Grn/ Yel'" Dmx="32~32" WheelPosition="1" Colour="180,180,0" />
      <Function ID="9" Name="Yel/ Lav" Display="'Yel/ Lav'" Dmx="53~53" WheelPosition="2" Colour="255,255,0" />
      <Function ID="10" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="74~74" WheelPosition="3" Colour="255,128,255" />
      <Function ID="11" Name="Pk/ Aq" Display="'Pk/ Aq'" Dmx="95~95" WheelPosition="4" Colour="255,150,150" />
      <Function ID="12" Name="Aq/ Op" Display="'Aq/ Op'" Dmx="118~118" WheelPosition="5" Colour="0,255,200" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_Up+Down" Name="Blade Up+Down" Description="" Group="B">

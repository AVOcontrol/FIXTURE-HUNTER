  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="11~50" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="51~100" />
      <Function ID="4" Name="Rainbow" Display="'Rainbow'" Dmx="101~150" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="151~200" />
      <Function ID="6" Name="Strobe" Display="'Strobe'" Dmx="201~255" />

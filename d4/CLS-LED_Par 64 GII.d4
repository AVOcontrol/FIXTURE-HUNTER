      <Function ID="26" Name="Snap 9" Display="'Snap 9'" Dmx="125~129" Colour="0,0,0" />
      <Function ID="27" Name="Snap 10" Display="'Snap 10'" Dmx="130~134" Colour="0,0,0" />

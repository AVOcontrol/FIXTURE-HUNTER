    <Attribute ID="FX_Select" Name="FX Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="2" Name="Party Effect" Display="'Party Effect'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="3" Name="Candle" Display="'Candle'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="4" Name="Clouds Passing" Display="'Clouds Passing'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="5" Name="Club Lights" Display="'Club Lights'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="6" Name="Colour Chase" Display="'Colour Chase'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="7" Name="Cop Car" Display="'Cop Car'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="8" Name="Fire" Display="'Fire'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="9" Name="Fireworks" Display="'Fireworks'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="10" Name="Light Strobe" Display="'Light Strobe'" Dmx="90~99" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="11" Name="Lightning" Display="'Lightning'" Dmx="100~109" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="12" Name="Paparazzi" Display="'Paparazzi'" Dmx="110~119" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="13" Name="Pulsing" Display="'Pulsing'" Dmx="120~129" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />

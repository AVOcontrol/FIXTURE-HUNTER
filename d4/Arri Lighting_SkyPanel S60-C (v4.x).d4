      <Function ID="15" Name="Explosion" Display="'Explosion'" Dmx="140~149" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="16" Name="Fluorescent Flicker" Display="'Fluorescent Flicker'" Dmx="150~159" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />

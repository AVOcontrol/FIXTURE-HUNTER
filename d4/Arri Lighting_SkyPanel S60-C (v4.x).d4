    <Attribute ID="Xfade_CCT&gt;RGBW" Name="Xfade CCT&gt;RGBW" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="3" Lowlight="3" />
      <Function ID="1" Name="CCT&gt;RGBW" Display="'CCT&gt;RGBW %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="CCT" Display="'CCT'" Dmx="0~0" />
      <Function ID="3" Name="RGBW" Display="'RGBW'" Dmx="65535~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">

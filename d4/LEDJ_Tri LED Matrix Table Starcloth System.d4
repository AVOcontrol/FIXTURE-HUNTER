<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Tri LED Matrix Table Starcloth System" ShortName="Table Star" Company="LEDJ" Version="0">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>2325e00a-a678-4072-9600-be851005b458</Thumbnail>
  <History Date="03-08-21" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="10~239" Update="Effect_Spd" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="240~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Effect'&gt;1" />
      <Else ID="1,2" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="10~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Effect" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Effect_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="2325e00a-a678-4072-9600-be851005b458"></Swatch>
  </swatchLibrary>
</Fixture>
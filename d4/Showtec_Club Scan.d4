<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Club Scan" ShortName="Club Scan" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="28-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~5" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~11" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="12~17" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 2" Display="'Gobo 2'" Dmx="18~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~29" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 4" Display="'Gobo 4'" Dmx="30~35" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 5" Display="'Gobo 5'" Dmx="36~41" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 6" Display="'Gobo 6'" Dmx="42~47" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 7" Display="'Gobo 7'" Dmx="48~53" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 8" Display="'Gobo 8'" Dmx="54~59" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Flip 1+2" Display="'Flip 1+2'" Dmx="60~65" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Flip 2+3" Display="'Flip 2+3'" Dmx="66~71" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Flip 3+4" Display="'Flip 3+4'" Dmx="72~77" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Flip 4+5" Display="'Flip 4+5'" Dmx="78~83" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Flip 5+6" Display="'Flip 5+6'" Dmx="84~89" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Flip 6+7" Display="'Flip 6+7'" Dmx="90~95" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Flip 7+8" Display="'Flip 7+8'" Dmx="96~101" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Flip 8+Op" Display="'Flip 8+Op'" Dmx="102~107" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="108~171" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="172~251" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="252~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~246" Intensity="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="247~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SHCLBSCN" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="180" TiltMax="75" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
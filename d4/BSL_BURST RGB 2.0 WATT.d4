    </Attribute>
    <Attribute ID="Page/Macro" Name="Page/Macro" Description="" Group="G">
      <Locate Locate="2" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Page" ID="2,3,4,5,6,7,8,9" If="'Mode'==2" />

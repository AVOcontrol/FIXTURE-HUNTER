    </Attribute>
  </Control>
  <Mode Name="Basic" Channels="13">
    <Import PearlRef="PG_SlashBas" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

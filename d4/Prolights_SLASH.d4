      <Function ID="2" Name="Indexed Colour" Display="'Indexed Colour'" Dmx="20~39" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="40~59" />
      <Function ID="4" Name="Safe" Display="'Safe'" Dmx="60~79" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="6" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="7" Name="Reset Colour" Display="'Reset Colour'" Dmx="88~90" />
      <Function ID="8" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="91~93" />
      <Function ID="9" Name="Safe" Display="'Safe'" Dmx="94~96" />

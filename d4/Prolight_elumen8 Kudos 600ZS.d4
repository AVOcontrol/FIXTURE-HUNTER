      <Function ID="26" Name="LEE 088" Display="'LEE 088'" Dmx="130~134" Colour="128,255,0" />
      <Function ID="27" Name="LEE 100" Display="'LEE 100'" Dmx="135~139" Colour="255,255,128" />

  <History Date="08-09-20" Author="Nic Morris" Comment="Updated existing Atlabase mode ID's to latest version and added missing.  Added product thumbnail." Version="2" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Inno Pocket Fusion.d4 to ADJ_Inno Pocket Fusion.d4." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="40ea8915-4e9a-44bb-8a59-b9cd2ea9d484" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="16~23" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="24~31" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="40~47" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="48~55" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="56~63" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="72~79" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Org/ Yel" Display="'Org/ Yel'" Dmx="80~87" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="88~95" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="96~103" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ L Blu" Display="'Blu/ L Blu'" Dmx="104~111" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="L Blu/ Pk" Display="'L Blu/ Pk'" Dmx="112~127" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="120~10" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~135" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Show_Spd" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~33" Update="Show_Spd" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="34~59" Update="Show_Spd" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="60~85" Update="Show_Spd" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="86~111" Update="Show_Spd" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="112~137" Update="Show_Spd" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="138~163" Update="Show_Spd" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="164~189" Update="Show_Spd" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="190~215" Update="Show_Spd" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="216~255" Update="Show_Spd" />
    </Attribute>
    <Attribute ID="Show_Spd" Name="Show Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Show'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="79~79" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="80~89" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="90~99" />
    </Attribute>
  </Control>

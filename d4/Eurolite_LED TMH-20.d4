  <History Date="01-04-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="da80785b-98ea-45b2-8eb1-2d2e2da42f50" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="31~200" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="201~250" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="11~20" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="21~30" />
    </Attribute>
    <Attribute ID="RGB_Macro" Name="RGB Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="41~80" Colour="255,0,0" />
      <Function ID="3" Name="R+B" Display="'R+B'" Dmx="81~120" Colour="255,0,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="121~140" Colour="0,0,255" />
      <Function ID="5" Name="B+G" Display="'B+G'" Dmx="141~160" Colour="0,255,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="161~200" Colour="0,255,0" />
      <Function ID="7" Name="R+G" Display="'R+G'" Dmx="201~240" Colour="255,255,0" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="AW_Macro" Name="AW Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Amber" Display="'Amber'" Dmx="41~80" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="81~120" Colour="255,255,255" />
      <Function ID="4" Name="A+W" Display="'A+W'" Dmx="121~140" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="141~160" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="161~200" Colour="255,255,255" />
      <Function ID="7" Name="A+W" Display="'A+W'" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R+W" Display="'R+W'" Dmx="41~80" Colour="255,255,255" />
      <Function ID="3" Name="R+B+A" Display="'R+B+A'" Dmx="81~120" Colour="255,255,255" />
      <Function ID="4" Name="B+W+A" Display="'B+W+A'" Dmx="121~140" Colour="255,255,255" />
      <Function ID="5" Name="R+A" Display="'R+A'" Dmx="141~160" Colour="255,255,255" />
      <Function ID="6" Name="G+A" Display="'G+A'" Dmx="161~200" Colour="255,255,255" />
      <Function ID="7" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="201~240" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Chromabank" ShortName="Chrombank" Company="Pulsar">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="28-02-03" Author="D.Shelton" Comment="Created" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="06-11-03" Author="Greg" Comment="Modified for Software Version 2" />
  <History Date="06-11-03" Author="Oliver Waits" Comment="Tested" />
  <History Date="31-03-05" Author="Phil" Comment="Renamed to reflect that this works for ALL chromabank versions (so far)" />
  <History Date="23-04-05" Author="Phil Rogers" Comment="Added 10 DMX mode" />
  <History Date="05-04-06" Author="Ed" Comment="Changed all chase functions to be part of effect group" />
  <History Date="06-04-06" Author="Ed" Comment="Added virtual dimmer and 2 new modes, 6DMX vDim, 9DMX vDim and macros for all in and all out" />
  <History Date="22-06-06" Author="Ed" Comment="Sorted out modes" />
  <History Date="27-01-09" Author="D4 Personality Fixer 2009" Comment="Changed attribute IDs" />
  <History Date="27-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Macros" />
  <History Date="27-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Mode" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-10-11" Author="Nic Morris" Comment="Renamed attributes.  Aligned attribute ID numbers with attribute names.  Fixed highlight." />
  <History Date="01-10-11" Author="Nic Morris" Comment="Renamed modes.  Added details to chase select.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="15-10-12" Author="Peter Budd" Comment="Created RGB master attributes and new cell mode without VDim, used for the 46 channel mode.  Updated 42 channel mode to use RGB master." />
  <History Date="07-05-13" Author="Peter Budd" Comment="Added colour information to channels." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="/manual/Pulsar_Chromabank.pdf" Summary="" />

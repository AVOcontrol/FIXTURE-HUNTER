      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~9" />
      <Function ID="7" Name="Vert Position" Display="'Vert Position'" Dmx="30~39" />
      <Function ID="8" Name="Horiz Position" Display="'Horiz Position'" Dmx="40~49" />

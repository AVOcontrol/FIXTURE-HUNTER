    </Attribute>
    <Attribute ID="Anim_Func" Name="Anim Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Anim, Anim_Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Anim, Anim_Rot" />
      <Function ID="3" Name="Macro" Display="'Macro'" Dmx="0~0" Update="Anim, Anim_Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Anim, Anim_Rot" />
    </Attribute>
    <Attribute ID="Anim" Name="Anim" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Anim_Func'==1" />
      <Condition Name="Spin" ID="6,7,8,9,10" If="'Anim_Func'==2" />

  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="SVBLST81" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt1" ChannelOffset="3,4" Wheel="20" />
      <Attribute ID="Tilt2" ChannelOffset="5,6" Wheel="21" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Pan_Spin" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="9" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
        <Attribute ID="Pan_Spin" ChannelOffset="8" Wheel="19" />
        <Attribute ID="Red" ChannelOffset="9" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" ChannelOffset="10" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" ChannelOffset="11" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="White" ChannelOffset="12" Wheel="9" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Tilt 1" ChannelOffset="3" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="5" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>

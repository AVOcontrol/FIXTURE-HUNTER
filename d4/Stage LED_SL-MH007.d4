    <Attribute ID="Shape_Spd" Name="Shape Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Radius" ID="2,3,4,5" If="'Shape_Sel'&gt;6&amp;&amp;'Shape_Sel'&lt;11" />

      <Condition Name="Offset" ID="10,11,12,13" If="'Shape_Sel'&gt;13" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

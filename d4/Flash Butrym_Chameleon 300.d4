      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="G" Display="'G'" Dmx="1~7" WheelPosition="1" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="2" />
      <Function ID="4" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="3" />
      <Function ID="5" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="4" />

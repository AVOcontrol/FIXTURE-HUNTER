      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="208~215" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="216~223" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="224~231" />
      <Function ID="31" Name="Colour 30" Display="'Colour 30'" Dmx="232~239" />
      <Function ID="32" Name="Colour 31" Display="'Colour 31'" Dmx="240~247" />
      <Function ID="33" Name="Colour 32" Display="'Colour 32'" Dmx="248~255" />
      <Function ID="34" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

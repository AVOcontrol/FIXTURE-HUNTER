      <Function ID="27" Name="1/4 CTO/ Blu" Display="'1/4 CTO/ Blu'" Dmx="92~95" WheelPosition="11" Colour="255,240,200" />
      <Function ID="28" Name="Blu/ 1/2 CTB" Display="'Blu/ 1/2 CTB'" Dmx="100~103" WheelPosition="12" Colour="0,0,255" />
      <Function ID="29" Name="1/2 CTB/ UV" Display="'1/2 CTB/ UV'" Dmx="108~111" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="UV/ Op" Display="'UV/ Op'" Dmx="116~119" WheelPosition="14" Colour="180,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />

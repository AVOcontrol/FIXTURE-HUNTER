  <History Date="22-09-21" Author="Nic Morris" Comment="Split into beam range options.  Added AtlaBase ID's." Version="1" />
  <History Date="24-09-21" Author="Nic Morris" Comment="Created from Anolis Ambiane XP56 Pendant Remote RGBNW 20°" Version="2" />
  <History Date="22-01-24" Author="Nic Morris" Comment="Created from Anolis Ambiane HP111 Recessed RGBWW 20°" Version="7" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e6f00c03-2a35-490c-9b85-8df79aae5313" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Shift" Display="'No Shift'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.1f%%',100.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="No Shift" Display="'No Shift'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Tungsten Dim 2700K" Display="'Tungsten Dim 2700K'" Dmx="1~10" Colour="255,255,255" />
      <Function ID="3" Name="Tungsten Dim 3200K" Display="'Tungsten Dim 3200K'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="4" Name="CTO C-Mix" Display="'CTO C-Mix %.fK',2700~6500" Dmx="21~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

  <AtlaBase TypeID="4bb953dd-5d3c-44c4-8fb8-728d56fa6b16" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="96~176" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="177~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',3200~6000" Dmx="5~240" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Area_Options" Name="Area Options" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Area 1,2,3" Display="'Area 1,2,3'" Dmx="0~0" />
      <Function ID="2" Name="Area 2,3" Display="'Area 2,3'" Dmx="23~45" />
      <Function ID="3" Name="Area 3" Display="'Area 3'" Dmx="46~68" />
      <Function ID="4" Name="Area 1" Display="'Area 1'" Dmx="92~114" />
      <Function ID="5" Name="Area 2" Display="'Area 2'" Dmx="115~137" />
      <Function ID="6" Name="Area 3" Display="'Area 3'" Dmx="138~160" />
      <Function ID="7" Name="Area 1,2" Display="'Area 1,2'" Dmx="161~183" />
      <Function ID="8" Name="Area 1" Display="'Area 1'" Dmx="184~206" />
      <Function ID="9" Name="Area 2" Display="'Area 2'" Dmx="207~229" />
      <Function ID="10" Name="Area 1,3" Display="'Area 1,3'" Dmx="230~252" />
      <Function ID="11" Name="Area 1,2,3" Display="'Area 1,2,3'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Scene_Options" Name="Scene Options" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scene" Display="'No Scene'" Dmx="0~0" />
      <Function ID="2" Name="Scene Effect" Display="'Scene Effect %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Scene_Spd" Name="Scene Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dynamic_FX" Name="Dynamic FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Dynamic Effect" Display="'Dynamic Effect %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Dynamic_FX_Spd" Name="Dynamic FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="70~74" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

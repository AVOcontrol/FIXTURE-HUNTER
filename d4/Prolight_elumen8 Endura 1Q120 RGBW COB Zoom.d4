  <AtlaBase TypeID="9634ec64-0fb6-453f-ad85-86589dda53c1" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Change" Display="'Col Change %.1f%%',0.0~100.0" Dmx="5~125" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade %.1f%%',0.0~100.0" Dmx="126~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Halogen Linear" Display="'Halogen Linear'" Dmx="0~0" />
      <Function ID="2" Name="Halogen Square" Display="'Halogen Square'" Dmx="46~75" />
      <Function ID="3" Name="Halogen Inv Square" Display="'Halogen Inv Square'" Dmx="76~105" />
      <Function ID="4" Name="Halogen S-Curve" Display="'Halogen S-Curve'" Dmx="106~135" />
      <Function ID="5" Name="LED Linear" Display="'LED Linear'" Dmx="136~165" />
      <Function ID="6" Name="LED Square" Display="'LED Square'" Dmx="166~195" />
      <Function ID="7" Name="LED Inv Square" Display="'LED Inv Square'" Dmx="196~225" />
      <Function ID="8" Name="LED S-Curve" Display="'LED S-Curve'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX (8bit)" Channels="2">

  <Thumbnail>30d67075-0281-4972-a343-15afd705ef22</Thumbnail>
  <History Date="12-10-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="08-01-17" Author="Nic Morris" Comment="Changed name from Quantum Profile to Mac Quantum Profile" Version="3" />
  <History Date="30-06-17" Author="Nic Morris" Comment="Revised FX Sync offset display range to show degrees.  Added gobo 1 names." Version="4" />
  <History Date="07-01-18" Author="Nic Morris" Comment="Added product thumbnail" Version="5" />
  <History Date="07-01-18" Author="Nic Morris" Comment="Added gobo swatches" Version="6" />
  <History Date="19-08-23" Author="Nic Morris" Comment="Created from Martin Mac Quantum Profile (gobo spin ranges missing - assumed the same for now.  frost implies discreet functions but values are missing - used liner range for now.)" Version="7" />
  <History Date="31-10-23" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request." Version="8" />
  <History Date="31-10-23" Author="Nic Morris" Comment="(changes from 19 to 23 channel mode, removes all but reset control function/macro and revises gobo rotate, prism 2 rotate and frost function ranges.  note gobo 2 ranges &gt; 192 are missing.  left the same for now)" Version="8" />
  <History Date="01-11-23" Author="Nic Morris" Comment="Added 23 channel mode Atlabase ID." Version="9" />
  <History Date="17-07-25" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (changed again!  gobo 2 ranges &gt; 192 are still missing.)" Version="10" />
  <History Date="20-07-25" Author="Nic Morris" Comment="Added Atlabase ID's for new mode." Version="11" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e4379184-1c3f-420a-9e41-4cd867147b9a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="25~25" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ai v9" ShortName="Ai v9" Company="Avolites Media">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>04cfe58c-2234-470b-90fe-0963f9cdeadf</Thumbnail>
  <History Date="21-03-15" Author="Nic Morris" Comment="Created" />
  <History Date="22-03-15" Author="Nic Morris" Comment="Renamed first XFade Mode function to 'Alpha' and added to Blend Mode." />
  <History Date="22-03-15" Author="Nic Morris" Comment="Inverted Auto CCW wheel direction" />
  <History Date="24-03-15" Author="Gregory Haynes" Comment="Moved Library select to Gobo 1 and FX to Beam and Effects. Removed Adj off names for Hue, Saturation and Contrast. Put Aspect Mode and Aspect Ratio together on Gobo 2." />
  <History Date="24-03-15" Author="Gregory Haynes" Comment="Changed Play Speed ranges to match percentages and changed locate to Optimal. Added Normal to Aspect Ratio and Open to Shutter. Added preset palettes. Removed additional Alpha functions from XFade and Blend Mode." />
  <History Date="09-04-15" Author="Nic Morris" Comment="Changed FX opacity's to locate at zero" />
  <History Date="09-04-15" Author="Nic Morris" Comment="Fixed x/y/z rotation, x/y pos and image size 16-bit ranges.  Adjusted to locate at MSB 128, LSB 0." />
  <History Date="09-04-15" Author="Nic Morris" Comment="Adjusted contrast and saturation ranges to locate at 127" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Reverted contrast and saturation to percentage ranges.  Inverted Y-Pos" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Inverted Movement Spd.  Fixed Levels Param 4.  Adjusted X/Y/Z rot, X/Y Pos and Image size display ranges." />
  <History Date="14-04-15" Author="Ciaran Abrams" Comment="Edited the way in which rotation values are announced" />
  <History Date="17-04-15" Author="Nic Morris" Comment="Changed file and folder to fixed functions" />
  <History Date="22-04-15" Author="Nic Morris" Comment="Changed X and Y Pos to single ranges for fade and shape compatibility.  Set DMX range limit at 65534 to force 50% at 127 MSB 255 LSB." />
  <History Date="16-12-15" Author="Peter Budd" Comment="Changed the X and Y Pos to Pan and Tilt to make it possible to run position shapes." />
  <History Date="11-02-16" Author="Peter Budd" Comment="Created from AI V8 personality." />
  <History Date="09-05-16" Author="Peter Budd" Comment="Added the BPM Sync Channels, Spout Input Channel, and re-ordered Reserved channels to make a little more sense." />
  <History Date="11-05-16" Author="Peter Budd" Comment="Updated the Rotate Values, and Image Size so they can locate in the correct place (32768). Changed Library Channels to start counting from 0." />
  <History Date="09-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed hue and saturation ID's for compatibility." />
  <History Date="08-03-18" Author="Nic Morris" Comment="Added new improved product thumbnail!" />
  <Manual Filename="" Summary="" />

      <Function ID="12" Name="Pastel Pink" Display="'Pastel Pink'" Dmx="130~141" Colour="255,200,200" />
      <Function ID="13" Name="Light Pink" Display="'Light Pink'" Dmx="142~153" Colour="255,200,200" />
      <Function ID="14" Name="Medium Yellow" Display="'Medium Yellow'" Dmx="154~165" Colour="255,255,128" />

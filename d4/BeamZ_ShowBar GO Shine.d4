    </Attribute>
    <Attribute ID="Ring_FX" Name="Ring FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Ring_FX_Spd" />

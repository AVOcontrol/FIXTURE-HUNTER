  <History Date="05-04-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="20-10-15" Author="Nic Morris" Comment="Swapped magenta and yellow channels in response to customer bug report." Version="2" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="3" />
  <History Date="20-09-18" Author="Nic Morris" Comment="Created from Varilite VL4000 BeamWash (note fixed magenta and end open center value wrong in charts - made best guess)" Version="4" />
  <History Date="13-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added Atlabase ID's.  Added gobo swatches." Version="5" />
  <History Date="25-10-19" Author="Nic Morris" Comment="Increased gobo 3 rot index resolution." Version="6" />
  <History Date="21-11-19" Author="Nic Morris" Comment="Revised colour scroll functions in response to manufacturer feedback via Atlabase (charts are wrong)" Version="7" />
  <History Date="02-07-23" Author="Nic Morris" Comment="Added Clone mode (poor and confusing charts.  littered with errors)" Version="8" />

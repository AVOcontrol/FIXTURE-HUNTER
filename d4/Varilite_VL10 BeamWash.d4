    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2'&lt;10" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2'&gt;9&amp;&amp;'Gobo2'&lt;28" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" GoboSpin="0~0" GoboOrientation="0~0" />

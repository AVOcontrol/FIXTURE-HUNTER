  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Dimmer, Master_Dimmer" />
      <Function ID="2" Name="R" Display="'R'" Dmx="20~29" Update="Dimmer, Master_Dimmer" />
      <Function ID="3" Name="G" Display="'G'" Dmx="30~39" Update="Dimmer, Master_Dimmer" />

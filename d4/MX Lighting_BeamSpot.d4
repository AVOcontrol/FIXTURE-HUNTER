      <Function ID="30" Name="14/ 15" Display="'14/ 15'" Dmx="224~239" WheelPosition="14" Colour="0,0,0" />
      <Function ID="31" Name="15/ 1" Display="'15/ 1'" Dmx="240~255" WheelPosition="15" Colour="0,0,0" />
      <Function ID="32" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="33" Name="Scroll CW" Display="'Scroll CW     %.1f%%',100.0~0.0" Dmx="10~127" Colour="0,0,0" />
      <Function ID="34" Name="No Scroll" Display="'No Scroll'" Dmx="128~137" Colour="255,255,255" />
      <Function ID="35" Name="Scroll CCW" Display="'Scroll CCW    %.1f%%',0.0~100.0" Dmx="138~255" Colour="0,0,0" />

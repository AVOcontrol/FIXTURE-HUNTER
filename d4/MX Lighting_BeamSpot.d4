      <Function ID="14" Name="Colour 14" Display="'Colour 14'" Dmx="221~237" WheelPosition="14" Colour="0,0,0" />
      <Function ID="15" Name="Colour 15" Display="'Colour 15'" Dmx="238~254" WheelPosition="15" Colour="0,0,0" />
      <Function ID="16" Name="Col 1 Half" Display="'Col 1 Half'" Dmx="0~15" WheelPosition="0" Colour="0,0,0" />
      <Function ID="17" Name="1/ 2" Display="'1/ 2'" Dmx="16~31" WheelPosition="1" Colour="0,0,0" />

  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>20bbd6a0-528b-4a2d-ab13-f639c2700f9a</Thumbnail>
  <History Date="05-09-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="26-11-17" Author="Nic Morris" Comment="Changed name from FL-672 to FL-672 (v2)" Version="2" />
  <History Date="20-04-21" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="3" />
  <History Date="21-04-21" Author="Nic Morris" Comment="Changed dimmer in 6ch modes to be an RGB on/off control and implemented virtual dimmer for Capture compatibility (documentation is unclear)" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f8a7632d-48da-4278-b339-10fb07e108a9" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~253" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~30" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~60" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="61~90" Colour="255,255,255" />
      <Function ID="5" Name="R/ G" Display="'R/ G'" Dmx="91~120" Colour="255,255,255" />
      <Function ID="6" Name="R/ B" Display="'R/ B'" Dmx="121~150" Colour="255,255,255" />
      <Function ID="7" Name="G/ B" Display="'G/ B'" Dmx="151~180" Colour="255,255,255" />
      <Function ID="8" Name="RGB Full" Display="'RGB Full'" Dmx="181~210" Colour="255,255,255" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="RGB" Name="RGB" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
  </Control>

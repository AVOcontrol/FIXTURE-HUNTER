<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Scenius Unico" ShortName="Scns Unico" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>68c61321-dd14-4d17-a623-61c908ce006d</Thumbnail>
  <History Date="21-12-16" Author="Nic Morris" Comment="Created (prelim - attributes only)" />
  <History Date="25-01-17" Author="Nic Morris" Comment="Updated with function ranges." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed Blade All Rot to locate at 50% and inverted Iris in response to customer request (non-standard implementation)." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added 'Uniform Beam' channel and revised frost channels to single ranges and renamed in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Swapped CW and CCW prism spin ranges in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised Colour names, ranges and Anim Rot ranges in line with 03/2017 charts." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed animation function to variable range in attempt to fix customer bug report." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised blade assignment in line with Capture." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Unified macros across product range." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed colour index to discreet functions in line with other products in range." />
  <History Date="08-04-17" Author="Nic Morris" Comment="Added continuous colour index function.  Fixed variable speed functions." />
  <History Date="11-04-17" Author="Nic Morris" Comment="Revised colour functions in line with revised charts from manufacturer (04/2017)" />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added gobo swatches.  Added channel counts to mode names." />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added Classic Pearl refs for R20 export." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added RDM ID's (note no personality ID's but should be ok as all modes have unique channel counts)" />
  <Manual Filename="" Summary="" />

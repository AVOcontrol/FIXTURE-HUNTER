      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="193~213" WheelPosition="4">
        <Swatch>a5600f97-0f98-4a90-9ba2-604af24f09c7</Swatch>

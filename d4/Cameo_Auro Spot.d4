    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exp" Display="'Exp'" Dmx="64~127" />
      <Function ID="4" Name="Log" Display="'Log'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="6~37" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="38~69" />
      <Function ID="4" Name="Pan Invert ON" Display="'Pan Invert ON'" Dmx="70~101" />
      <Function ID="5" Name="Pan Invert OFF" Display="'Pan Invert OFF'" Dmx="102~133" />
      <Function ID="6" Name="Tilt Invert ON" Display="'Tilt Invert ON'" Dmx="134~165" />
      <Function ID="7" Name="Tilt Invert OFF" Display="'Tilt Invert OFF'" Dmx="166~197" />
      <Function ID="8" Name="Silent Fan ON" Display="'Silent Fan ON'" Dmx="198~229" />
      <Function ID="9" Name="Silent Fan OFF" Display="'Silent Fan OFF'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">

  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="23-03-16" Author="Nic Morris" Comment="Created" />
  <History Date="24-03-16" Author="Nic Morris" Comment="Fixed gobo rot range error" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="94a2dcb5-5445-45b0-83af-10f032f24255" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" Intensity="0~0" />
      <Function ID="4" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" Intensity="0~0" />
      <Function ID="5" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" Intensity="0~0" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" Intensity="0~0" />
      <Function ID="7" Name="Break" Display="'Break %.f%%',0~100" Dmx="103~127" Intensity="0~0" />
      <Function ID="8" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="21~28" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="36~43" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="51~58" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="66~73" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="81~88" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Lavender" Display="'Lavender'" Dmx="96~103" WheelPosition="7" Colour="255,128,255" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="111~118" WheelPosition="8" Colour="255,0,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="6~10" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="16~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Org/ Yel" Display="'Org/ Yel'" Dmx="29~35" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="44~50" WheelPosition="3" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Cy" Display="'Grn/ Cy'" Dmx="59~65" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Cy/ Blu" Display="'Cy/ Blu'" Dmx="74~80" WheelPosition="5" Colour="0,255,255" />
      <Function ID="16" Name="Blu/ Lav" Display="'Blu/ Lav'" Dmx="89~95" WheelPosition="6" Colour="0,0,255" />
      <Function ID="17" Name="Lav/ Mag" Display="'Lav/ Mag'" Dmx="104~110" WheelPosition="7" Colour="255,128,255" />
      <Function ID="18" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="119~125" WheelPosition="8" Colour="255,0,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="126~128" Colour="255,255,255" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="8,9,10" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~25" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="26~45" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="46~65" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="66~85" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="86~105" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="106~127" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="128~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="255~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="7" />
      <Function ID="1" Name="No Rotate" Display="'No Rotate'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="250~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="251~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Shake" Name="Gobo Shake" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Shake Off" Display="'Shake Off'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="6~37" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="38~69" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="70~101" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="102~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Speed 5" Display="'Speed 5'" Dmx="134~165" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Speed 6" Display="'Speed 6'" Dmx="166~197" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Speed 7" Display="'Speed 7'" Dmx="198~229" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Speed 8" Display="'Speed 8'" Dmx="230~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="6~10" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="5" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="250~192" />
      <Function ID="7" Name="No Spin" Display="'No Spin'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="6~38" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="39~70" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="71~102" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="103~134" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="135~166" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="167~198" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="199~230" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

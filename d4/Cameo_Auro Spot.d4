      <Function ID="3" Name="Tilt" Display="'Tilt %.f%%',0~100" Dmx="48~89" />
      <Function ID="4" Name="P/T" Display="'P/T %.f%%',0~100" Dmx="90~131" />
      <Function ID="5" Name="P/T Invert" Display="'P/T Invert %.f%%',0~100" Dmx="132~173" />
      <Function ID="6" Name="Ellipse" Display="'Ellipse %.f%%',0~100" Dmx="174~215" />
      <Function ID="7" Name="Random" Display="'Random %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />

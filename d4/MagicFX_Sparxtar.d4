      <Function ID="2" Name="Empty Heater" Display="'Empty Heater'" Dmx="64~127" />
      <Function ID="3" Name="Output" Display="'Output'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Safety, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Safety" ChannelOffset="1" Wheel="4" />

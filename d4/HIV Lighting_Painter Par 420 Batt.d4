      <Function ID="2" Name="Static Col Mixing" Display="'Static Col Mixing'" Dmx="10~50" />
      <Function ID="3" Name="Jump Mode" Display="'Jump Mode'" Dmx="51~100" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="101~150" />
      <Function ID="5" Name="Mutation Mode" Display="'Mutation Mode'" Dmx="151~200" />
      <Function ID="6" Name="Sound Col Change" Display="'Sound Col Change'" Dmx="201~215" />
      <Function ID="7" Name="Sound Col Flash" Display="'Sound Col Flash'" Dmx="216~230" />
      <Function ID="8" Name="Sound Mutation" Display="'Sound Mutation'" Dmx="231~245" />
      <Function ID="9" Name="Sound Breathing" Display="'Sound Breathing'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

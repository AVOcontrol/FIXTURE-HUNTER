<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BOne" ShortName="BOne" Company="Luxibel">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-06-17" Author="Nic Morris" Comment="Created (channels only - documentation has conflicting information)" />
  <History Date="12-07-17" Author="Nic Morris" Comment="Updated discreet functions in line with updated documentation ('Chase Fade' looks incorrect - left as 'Col Preset' instead)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="8~39" Colour="255,0,0" />
      <Function ID="3" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="40~71" Colour="255,255,0" />
      <Function ID="4" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="72~103" Colour="0,255,0" />
      <Function ID="5" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="104~135" Colour="0,255,255" />
      <Function ID="6" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="136~167" Colour="0,0,255" />
      <Function ID="7" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="168~199" Colour="255,0,255" />
      <Function ID="8" Name="Rd - Wht" Display="'Rd - Wht %.f%%',0~100" Dmx="200~231" Colour="255,0,0" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~231" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="232~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Preset" Name="Col Preset" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Col Preset Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~84" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="240~255" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX" Channels="17">
    <Import PearlRef="UKLXB117" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Pan_Spin" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Tilt_Spin" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="13" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="9" />
      <Attribute ID="Col_Preset" ChannelOffset="15" Wheel="8" />
      <Attribute ID="Shutter1" ChannelOffset="16" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="UKLXB115" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Pan_Spin" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Tilt_Spin" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Col_Preset" ChannelOffset="13" Wheel="8" />
      <Attribute ID="Shutter1" ChannelOffset="14" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>

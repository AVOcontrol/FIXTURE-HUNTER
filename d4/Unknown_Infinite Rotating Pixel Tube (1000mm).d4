<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Infinite Rotating Pixel Tube (1000mm)" ShortName="RtPxTb1000" Company="Unknown" Version="3">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>ce5bffd1-4f1e-4c88-b58c-73fd2779e03c</Thumbnail>
  <History Date="29-03-23" Author="Nic Morris" Comment="Created (poor documentation.  13 channel mode suggests channel 5 is both p/t speed and control.  This makes no sense.  Ignored p/t speed for now)" Version="0" />
  <History Date="18-04-23" Author="Nic Morris" Comment="Changed pan power on to 0 so that it doesn't move on DMX in response to customer request." Version="2" />
  <History Date="19-04-23" Author="Nic Morris" Comment="Changed tilt power on to 0 (original request was incorrect)" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Pan Unlock" Display="'Pan Unlock'" Dmx="200~209" />
      <Function ID="3" Name="Pan Lock" Display="'Pan Lock'" Dmx="210~219" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="220~229" />
      <Function ID="5" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="230~239" />
      <Function ID="6" Name="Reset Pan" Display="'Reset Pan'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="128~1" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="6~55" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="56~105" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="106~155" />
      <Function ID="5" Name="Gradient 1" Display="'Gradient 1 %.f%%',0~100" Dmx="156~205" />
      <Function ID="6" Name="Gradient 2" Display="'Gradient 2 %.f%%',0~100" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="15~15" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="16~30" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="31~45" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="46~60" />

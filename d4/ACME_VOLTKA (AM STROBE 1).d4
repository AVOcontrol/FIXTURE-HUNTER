<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VOLTKA (AM STROBE 1)" ShortName="VOLTKA" Company="ACME" Version="2">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>ba6312dc-e6b9-4bc2-8807-0124314dfcb3</Thumbnail>
  <History Date="10-12-20" Author="Nic Morris" Comment="Created (poor documentation - there is a list of functions for a control that doesn't exist.  pixel layout missing for 150 channel mode - guessed)" Version="0" />
  <History Date="10-12-20" Author="Nic Morris" Comment="(RDM mode IDs not available - the two 35 channel modes won't work with RDM without these)" Version="0" />
  <History Date="11-12-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="15-12-20" Author="Nic Morris" Comment="Revised CTO display range and changed Duration, Shutter and BG Macro Spd locate values in response to manufactuer request." Version="2" />
  <History Date="15-12-20" Author="Nic Morris" Comment="(note it seems very strange that strobe should locate at 100%.  This suggests the shutter function ranges or descriptions are incorrect)" Version="2" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="14342" ModelID="8138" />
  </RDM>
  <AtlaBase TypeID="af36ac09-4dff-402d-8ec2-e9644c17c062" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:8000" PowerOn="1:8000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~8000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~50" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="51~100" />
      <Function ID="4" Name="Ramp Up-Dn" Display="'Ramp Up-Dn'" Dmx="101~150" />
      <Function ID="5" Name="Lightning" Display="'Lightning'" Dmx="151~200" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="BG_Macro" Name="BG Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Macro_Spd" Name="BG Macro Spd" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

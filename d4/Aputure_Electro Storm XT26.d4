  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="69dc1955-231d-4953-8fbe-21b251589949" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2700.0~6500.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta(8bit)" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Half Minus Green" Display="'Half Minus Green'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.1f%%',50.0~1.0" Dmx="21~119" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.1f%%',1.0~50.0" Dmx="146~244" Colour="0,0,0" />
      <Function ID="6" Name="Half Plus Green" Display="'Half Plus Green'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green/Magenta(16bit)" Name="Green/Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Half Minus Green" Display="'Half Minus Green'" Dmx="4588~9830" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.2f%%',50.00~1.00" Dmx="9831~30145" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30146~39976" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.2f%%',1.00~50.00" Dmx="39977~60292" Colour="0,0,0" />
      <Function ID="6" Name="Half Plus Green" Display="'Half Plus Green'" Dmx="60293~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="CCT-&gt;FX" Name="CCT-&gt;FX" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;FX" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Param" Name="Effect Param" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Lightning" ID="3,4,5" If="'Effect_Sel'==4" />
      <Condition Name="Explosion" ID="6,7" If="'Effect_Sel'==8" />
      <Function ID="1" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="255~255" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="0~0" />
      <Function ID="4" Name="Trigger" Display="'Trigger'" Dmx="10~69" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="70~255" />
      <Function ID="6" Name="Trigger" Display="'Trigger'" Dmx="0~0" />
      <Function ID="7" Name="Stop" Display="'Stop'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect_Sel" Name="Effect Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="Effect_Param" />
      <Function ID="2" Name="Fireworks" Display="'Fireworks'" Dmx="10~19" Update="Effect_Param" />
      <Function ID="3" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="20~29" Update="Effect_Param" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="30~39" Update="Effect_Param" />
      <Function ID="5" Name="TV" Display="'TV'" Dmx="40~49" Update="Effect_Param" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="50~59" Update="Effect_Param" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="60~69" Update="Effect_Param" />
      <Function ID="8" Name="Explosion" Display="'Explosion'" Dmx="70~79" Update="Effect_Param" />
      <Function ID="9" Name="Fire" Display="'Fire'" Dmx="80~89" Update="Effect_Param" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="20~39" />
      <Function ID="3" Name="3" Display="'3'" Dmx="40~59" />
      <Function ID="4" Name="4" Display="'4'" Dmx="60~79" />
      <Function ID="5" Name="5" Display="'5'" Dmx="80~99" />
      <Function ID="6" Name="6" Display="'6'" Dmx="100~119" />
      <Function ID="7" Name="7" Display="'7'" Dmx="120~139" />
      <Function ID="8" Name="8" Display="'8'" Dmx="140~159" />
      <Function ID="9" Name="9" Display="'9'" Dmx="160~179" />
      <Function ID="10" Name="10" Display="'10'" Dmx="180~199" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="200~219" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.2f%%',0.00~100.00" Dmx="5140~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Fan_Mode" Name="Fan Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Smart" Display="'Smart'" Dmx="0~0" />
      <Function ID="2" Name="High" Display="'High'" Dmx="64~127" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="128~191" />
      <Function ID="4" Name="Silent" Display="'Silent'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="S-Curve" Display="'S-Curve'" Dmx="64~127" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="128~191" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="192~255" />
    </Attribute>
  </Control>

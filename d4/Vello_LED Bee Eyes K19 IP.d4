      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="BG_Shutter" Name="BG Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="BG_Select" Name="BG Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Wash Mode" Display="'Wash Mode'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Ring 1" Display="'Ring 1'" Dmx="9~9" WheelPosition="0" />
      <Function ID="3" Name="Ring 2" Display="'Ring 2'" Dmx="10~10" WheelPosition="0" />
      <Function ID="4" Name="Ring 3" Display="'Ring 3'" Dmx="11~11" WheelPosition="0" />
      <Function ID="5" Name="Ring 1+3" Display="'Ring 1+3'" Dmx="12~12" WheelPosition="0" />
      <Function ID="6" Name="Ring 1+2" Display="'Ring 1+2'" Dmx="13~13" WheelPosition="0" />
      <Function ID="7" Name="Ring 1+2+3" Display="'Ring 1+2+3'" Dmx="14~14" WheelPosition="0" />
      <Function ID="8" Name="Ring 2+3" Display="'Ring 2+3'" Dmx="15~15" WheelPosition="0" />
      <Function ID="9" Name="No Selection" Display="'No Selection'" Dmx="16~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />

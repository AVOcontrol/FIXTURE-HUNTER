    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="10~19" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="20~29" />
      <Function ID="4" Name="Half Col" Display="'Half Col'" Dmx="30~39" />
      <Function ID="5" Name="Random Col" Display="'Random Col'" Dmx="40~49" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="60~69" />

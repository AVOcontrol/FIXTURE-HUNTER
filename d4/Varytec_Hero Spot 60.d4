  <Thumbnail>35c4a4ca-8eb8-4033-84a5-676fcc4d160b</Thumbnail>
  <History Date="06-08-19" Author="Nic Morris" Comment="Created (charts have errors)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e552c752-0c4c-4025-8626-e2c3173c991b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~50" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="51~75" Colour="255,255,0" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="76~100" Colour="0,128,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="101~125" Colour="0,255,0" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="126~150" Colour="255,100,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="151~175" Colour="128,0,255" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="176~200" Colour="0,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="201~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="7,8,9,10,11,12" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="13,14,15,16" If="'Gobo1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>739699be-97e5-40ea-84c8-a7da88e24dee</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~26" WheelPosition="1">
        <Swatch>967d42f8-9812-4bdb-a6f8-59d70cc19589</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="27~43" WheelPosition="2">
        <Swatch>8d5193ec-9fc5-4877-ae90-ae90bb7b9125</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="44~60" WheelPosition="3">
        <Swatch>22eba609-320e-464e-abb0-f9e4147d998b</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="61~77" WheelPosition="4">
        <Swatch>10d38ecb-20fd-46f6-b297-bf380fc00fe7</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="78~94" WheelPosition="5">
        <Swatch>e20b73fc-f612-4d77-a96a-d2cad1d4880c</Swatch>
      </Function>
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>739699be-97e5-40ea-84c8-a7da88e24dee</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="95~114" WheelPosition="1">
        <Swatch>967d42f8-9812-4bdb-a6f8-59d70cc19589</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="115~134" WheelPosition="2">
        <Swatch>8d5193ec-9fc5-4877-ae90-ae90bb7b9125</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="135~154" WheelPosition="3">
        <Swatch>22eba609-320e-464e-abb0-f9e4147d998b</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="155~174" WheelPosition="4">
        <Swatch>10d38ecb-20fd-46f6-b297-bf380fc00fe7</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="175~194" WheelPosition="5">
        <Swatch>e20b73fc-f612-4d77-a96a-d2cad1d4880c</Swatch>
      </Function>
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="195~224" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="130~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="White+No Gobo" Display="'White+No Gobo'" Dmx="11~20" />
      <Function ID="3" Name="Blue+Gobo 1" Display="'Blue+Gobo 1'" Dmx="21~30" />

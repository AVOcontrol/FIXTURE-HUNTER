      <Function ID="6" Name="White+Gobo 4" Display="'White+Gobo 4'" Dmx="51~60" />
      <Function ID="7" Name="White+Gobo 5" Display="'White+Gobo 5'" Dmx="61~70" />
      <Function ID="8" Name="White+No Gobo w/prism" Display="'White+No Gobo w/prism'" Dmx="71~80" />
      <Function ID="9" Name="Blue+Gobo 1 w/prism" Display="'Blue+Gobo 1 w/prism'" Dmx="81~90" />
      <Function ID="10" Name="Purple+Gobo 2 w/prism" Display="'Purple+Gobo 2 w/prism'" Dmx="91~100" />
      <Function ID="11" Name="Orange+Gobo 3 w/prism" Display="'Orange+Gobo 3 w/prism'" Dmx="101~110" />
      <Function ID="12" Name="White+Gobo 4 w/prism" Display="'White+Gobo 4 w/prism'" Dmx="111~120" />
      <Function ID="13" Name="White+Gobo 5 w/prism" Display="'White+Gobo 5 w/prism'" Dmx="121~130" />
      <Function ID="14" Name="Auto Col+Gobo 1 w/prism" Display="'Auto Col+Gobo 1 w/prism'" Dmx="131~140" />
      <Function ID="15" Name="Auto Col+Gobo 2 w/prism" Display="'Auto Col+Gobo 2 w/prism'" Dmx="141~150" />
      <Function ID="16" Name="Auto Col+Gobo 3 w/prism" Display="'Auto Col+Gobo 3 w/prism'" Dmx="151~160" />
      <Function ID="17" Name="Auto Col+Gobo 4 w/prism" Display="'Auto Col+Gobo 4 w/prism'" Dmx="161~170" />
      <Function ID="18" Name="Auto Col+Gobo 5 w/prism" Display="'Auto Col+Gobo 5 w/prism'" Dmx="171~180" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~20" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="21~30" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="31~40" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="41~50" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="51~60" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="61~70" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="71~80" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="81~90" />
      <Function ID="10" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="91~230" />
      <Function ID="11" Name="Reset" Display="'Reset'" Dmx="231~240" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">

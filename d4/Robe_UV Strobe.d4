<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="UV Strobe" ShortName="UV Strobe" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-04-15" Author="Nic Morris" Comment="Created" />
  <History Date="13-04-15" Author="Nic Morris" Comment="Fixed 8bit dimmer in Modes 1 and 2 in response to manufacturer bug report." />
  <History Date="23-07-15" Author="Nic Morris" Comment="Changed zone fx functions to variable ranges in response to manufacturer request." />
  <History Date="24-09-15" Author="Nic Morris" Comment="Updated to v1.1 spec." />
  <History Date="22-10-15" Author="Nic Morris" Comment="Reordered modes in line with v1.2 spec in response to manufacturer request." />
  <History Date="25-03-17" Author="Nic Morris" Comment="Revised in line with v1.2 charts." />
  <History Date="25-03-17" Author="Nic Morris" Comment="Created from Robe Robin Strobe (identical)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Flash" Display="'No Flash'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Permanent Lightning" Display="'Permanent Lightning'" Dmx="2~5" />
      <Function ID="3" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="4" Name="Ramp Dn" Display="'Ramp Dn'" Dmx="43~85" />
      <Function ID="5" Name="Ramp Up/Dn" Display="'Ramp Up/Dn'" Dmx="86~128" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="7" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="8" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="3" Name="Ramp Dn" Display="'Ramp Dn'" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up/Dn" Display="'Ramp Up/Dn'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display ON" Display="'Display ON'" Dmx="20~24" />
      <Function ID="3" Name="Display OFF" Display="'Display OFF'" Dmx="25~29" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~64" />
      <Function ID="5" Name="Fan High" Display="'Fan High'" Dmx="65~69" />
      <Function ID="6" Name="Douse On" Display="'Douse On'" Dmx="70~79" />
      <Function ID="7" Name="Douse Off" Display="'Douse Off'" Dmx="80~89" />
      <Function ID="8" Name="Dim Linear" Display="'Dim Linear'" Dmx="90~99" />
      <Function ID="9" Name="Dim Square" Display="'Dim Square'" Dmx="100~109" />
    </Attribute>
    <Attribute ID="Zone_FX" Name="Zone FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="3~4" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="5~6" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="7~8" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="9~10" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="11~12" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="13~14" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="15~16" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="17~18" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="19~20" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="21~22" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="23~24" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="25~26" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="27~28" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="29~30" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="31~32" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="33~34" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="35~36" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="37~38" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="39~40" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="41~42" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="43~44" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="45~46" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="47~48" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="49~50" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="51~52" />
    </Attribute>
    <Attribute ID="Zone_FX_Spd" Name="Zone FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FWD No Fade" Display="'FWD No Fade %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="REV No Fade" Display="'REV No Fade %.f%%',100~0" Dmx="64~127" />
      <Function ID="3" Name="FWD Fade" Display="'FWD Fade %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="REV Fade" Display="'REV Fade %.f%%',100~0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="8">
    <Import PearlRef="ROUVSTR1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Effect" ChannelOffset="5" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Zone_FX" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Zone_FX_Spd" ChannelOffset="8" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="Mode 2" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="1,2" Wheel="6" />
        <Attribute ID="Duration" ChannelOffset="3" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Effect" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
        <Attribute ID="Zone_FX" ChannelOffset="7" Wheel="23" />
        <Attribute ID="Zone_FX_Spd" ChannelOffset="8" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="9" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="10" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="11" ModeLink="Cell" X="2" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="12" ModeLink="Cell" X="3" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="13" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="14" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="15" ModeLink="Cell" X="2" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="16" ModeLink="Cell" X="3" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Cell 9" ChannelOffset="17" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="Cell 10" ChannelOffset="18" ModeLink="Cell" X="1" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell11" Name="Cell 11" ChannelOffset="19" ModeLink="Cell" X="2" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell12" Name="Cell 12" ChannelOffset="20" ModeLink="Cell" X="3" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Mode 3" Channels="3">
    <Import PearlRef="ROUVSTR3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="Mode 4" Channels="4">
    <Import PearlRef="ROUVSTR4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Effect1" ChannelOffset="4" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan High">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Douse On">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Douse Off">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Square">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
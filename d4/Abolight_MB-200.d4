      <Function ID="29" Name="CTB/ Ppl" Display="'CTB/ Ppl'" Dmx="135~139" WheelPosition="13" Colour="200,220,221" />
      <Function ID="30" Name="Ppl/ Op" Display="'Ppl/ Op'" Dmx="145~149" WheelPosition="14" Colour="128,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="150~199" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />

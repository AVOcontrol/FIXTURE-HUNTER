      <Attribute ID="White" ChannelOffset="10" Wheel="40" />
      <Attribute ID="Auto" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

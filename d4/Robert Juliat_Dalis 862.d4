  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.1fms',1.0~85.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dim Time" Display="'Dim Time %.fms',4000~100" Dmx="250~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RDM Off" Display="'RDM Off'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2000~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Balance" Name="Balance" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="DS" Display="'DS'" Dmx="0~0" />
      <Function ID="2" Name="DS-&gt;DS+US" Display="'DS-&gt;DS+US %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="DS+US" Display="'DS+US'" Dmx="128~128" />

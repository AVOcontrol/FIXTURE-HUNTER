      <Attribute ID="Auto_Spd" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="12" Wheel="25" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Colour_Macro" ChannelOffset="8" Wheel="37" />
        <Attribute ID="Shutter" ChannelOffset="9" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="10" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="11" Wheel="23" />
        <Attribute ID="Dim_Spd" ChannelOffset="12" Wheel="25" />
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19538" ModelID="1411" />
  </RDM>
  <AtlaBase TypeID="0e4d077d-244f-477d-8ca1-9239a7ac62d9" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Col_Mix_Func" Name="Col Mix Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="2" Name="CMY" Display="'CMY'" Dmx="91~105" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="3" Name="Cycle" Display="'Cycle'" Dmx="181~195" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="196~210" Update="Red, Green, Blue" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scan" Display="'Scan'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="80~95" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scan" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="14" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="15,16" If="'Colour1Func'&gt;3&amp;&amp;'Colour1Func'&lt;7" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op/ 1" Display="'Op/ 1'" Dmx="28~55" Colour="255,255,255" />
      <Function ID="3" Name="Colour 1" Display="'Colour 1'" Dmx="56~83" Colour="0,0,0" />
      <Function ID="4" Name="1/ 2" Display="'1/ 2'" Dmx="84~111" Colour="0,0,0" />
      <Function ID="5" Name="Colour 2" Display="'Colour 2'" Dmx="112~139" Colour="0,0,0" />
      <Function ID="6" Name="2/ 3" Display="'2/ 3'" Dmx="140~167" Colour="0,0,0" />
      <Function ID="7" Name="Colour 3" Display="'Colour 3'" Dmx="168~195" Colour="0,0,0" />
      <Function ID="8" Name="3/ Op" Display="'3/ Op'" Dmx="196~223" Colour="0,0,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="224~255" Colour="255,255,255" />
      <Function ID="10" Name="Op/ 1" Display="'Op/ 1 %.f%%',0~100" Dmx="0~63" Colour="255,255,255" />
      <Function ID="11" Name="1/ 2" Display="'1/ 2 %.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="12" Name="2/ 3" Display="'2/ 3 %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="13" Name="3/ Op" Display="'3/ Op %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="14" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="15" Name="Stop" Display="'Stop'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="16" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="64~79" Update="Gobo1" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="16~31" Update="Gobo1" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Gobo1" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Gobo1" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="5,6,7,8" If="'Gobo1Func'==2" />
      <Condition Name="Index" ID="9" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="10,11" If="'Gobo1Func'==4||'Gobo1Func'==5" />
      <Else ID="12" />
      <Function ID="1" Name="Secondary Diffusion" Display="'Secondary Diffusion'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="64~95" />
      <Function ID="4" Name="Gobo 2" Display="'Gobo 2'" Dmx="96~127" />
      <Function ID="5" Name="Gobo 1 No Shake" Display="'Gobo 1 No Shake'" Dmx="0~0" />
      <Function ID="6" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="7" Name="Gobo 2 No Shake" Display="'Gobo 2 No Shake'" Dmx="128~128" />
      <Function ID="8" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="11" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Diffuser" Name="Diffuser" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Diffusion" Display="'Diffusion %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1 (Standard Position)" Display="'Macro 1 (Standard Position)'" Dmx="1~1" />
      <Function ID="3" Name="Macro 2 (Right Position)" Display="'Macro 2 (Right Position)'" Dmx="2~2" />
      <Function ID="4" Name="Macro 3 (Upside Down Position)" Display="'Macro 3 (Upside Down Position)'" Dmx="3~3" />
      <Function ID="5" Name="Macro 4 (Left Position)" Display="'Macro 4 (Left Position)'" Dmx="4~4" />
      <Function ID="6" Name="Macro 5 (2 Col Top/Bottom)" Display="'Macro 5 (2 Col Top/Bottom)'" Dmx="5~5" />
      <Function ID="7" Name="Macro 6 (2 Col Left/Right)" Display="'Macro 6 (2 Col Left/Right)'" Dmx="6~6" />
      <Function ID="8" Name="Macro 7 (4 Col Rot)" Display="'Macro 7 (4 Col Rot)'" Dmx="7~7" />
      <Function ID="9" Name="Macro 8 (2 Col Rot)" Display="'Macro 8 (2 Col Rot)'" Dmx="8~8" />
      <Function ID="10" Name="Macro 9 (2 Col Single Cell Rot)" Display="'Macro 9 (2 Col Single Cell Rot)'" Dmx="9~9" />
      <Function ID="11" Name="Macro 10 (Left + Right)" Display="'Macro 10 (Left + Right)'" Dmx="10~10" />
      <Function ID="12" Name="Macro 11 (Top + Bottom)" Display="'Macro 11 (Top + Bottom)'" Dmx="11~11" />
      <Function ID="13" Name="Macro 12 (Crosses)" Display="'Macro 12 (Crosses)'" Dmx="12~12" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="REV -" Display="'REV - %.f%%',100~0" Dmx="0~62" />
      <Function ID="2" Name="REV x1" Display="'REV x1'" Dmx="63~63" />
      <Function ID="3" Name="REV +" Display="'REV + %.f%%',0~100" Dmx="64~126" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="5" Name="FWD -" Display="'FWD - %.f%%',100~0" Dmx="129~191" />
      <Function ID="6" Name="FWD x1" Display="'FWD x1'" Dmx="192~192" />
      <Function ID="7" Name="FWD +" Display="'FWD + %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Macro_Fade" Name="Macro Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Speed Off" Display="'P/T Speed Off'" Dmx="16~31" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="32~47" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="48~63" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="64~79" />
      <Function ID="6" Name="Shutdown" Display="'Shutdown'" Dmx="80~95" />
      <Function ID="7" Name="Fan Studio" Display="'Fan Studio'" Dmx="96~101" />
      <Function ID="8" Name="Fan Continuous" Display="'Fan Continuous'" Dmx="102~107" />
      <Function ID="9" Name="Fan Standard" Display="'Fan Standard'" Dmx="108~113" />
      <Function ID="10" Name="Fan Studio Continuous" Display="'Fan Studio Continuous'" Dmx="114~119" />
      <Function ID="11" Name="Red Shift On" Display="'Red Shift On'" Dmx="120~123" />
      <Function ID="12" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="124~126" />
      <Function ID="13" Name="Dim Freq 1" Display="'Dim Freq 1'" Dmx="127~128" />
      <Function ID="14" Name="Dim Freq 2" Display="'Dim Freq 2'" Dmx="129~131" />
      <Function ID="15" Name="Dim Freq 3" Display="'Dim Freq 3'" Dmx="132~133" />
      <Function ID="16" Name="Dim Freq 4" Display="'Dim Freq 4'" Dmx="134~136" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CMY" ID="2" If="'Col_Mix_Func'==2" />
      <Condition Name="Cycle/Random" ID="3" If="'Col_Mix_Func'&gt;2" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CMY" ID="2" If="'Col_Mix_Func'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="CMY" ID="2" If="'Col_Mix_Func'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~8000" Dmx="4~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sync" Display="'Sync'" Dmx="16~31" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="32~47" />
      <Function ID="4" Name="Rnd Sync" Display="'Rnd Sync'" Dmx="48~63" />
      <Function ID="5" Name="Rnd Col" Display="'Rnd Col'" Dmx="64~79" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="24~229" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter_Func1" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="16~31" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="32~47" />
      <Function ID="4" Name="Rnd Pixel" Display="'Rnd Pixel'" Dmx="48~63" />
      <Function ID="5" Name="Rnd Pixel/Col" Display="'Rnd Pixel/Col'" Dmx="64~79" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Bar-252 RGB 10mm" ShortName="BAR-252 10" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="03-03-08" Author="Gregory Haynes" Comment="Created" />
  <History Date="17-11-08" Author="Jonathan Moreton" Comment="Updated Palettes" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="03-02-11" Author="John Rogers" Comment="Added split modes for multiple colour picker." />
  <History Date="12-09-11" Author="Nic Morris" Comment="Aligned attribute ID numbers with attribute names.  Changed no func to text only." />
  <History Date="12-09-11" Author="Nic Morris" Comment="Simplified conditionals.  Moved main functions into else to avoid problems." />
  <History Date="12-09-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." />
  <History Date="01-11-12" Author="Peter Budd" Comment="Edited removed virtual dimmer from cells." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-07-17" Author="Nic Morris" Comment="Changed name from LED Bar RGB 252/10 to LED BAR-252 RGB 10mm" />
  <History Date="11-07-17" Author="Nic Morris" Comment="Tidied up control updates.  Added vdim to cells.  Added Atlabase ID's." />
  <History Date="17-10-17" Author="Nic Morris" Comment="Changed name from LED BAR-252 RGB 10mm to LED Bar-252 RGB 10mm for consitency across range." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8be0ffaf-538f-4981-baee-3a48edf38f15" />
  <Control>
    <Attribute ID="Control" Name="Effect" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="2" Name="Independent" Display="'Independent'" Dmx="1~15" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="3" Name="Single" Display="'Single'" Dmx="16~31" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="32~47" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="48~63" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="64~79" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="80~95" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="96~111" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="112~127" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="10" Name="White" Display="'White'" Dmx="128~143" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="11" Name="Colour Change" Display="'Colour Change'" Dmx="144~159" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="12" Name="Colour Flow" Display="'Colour Flow'" Dmx="160~175" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="13" Name="Colour Dream" Display="'Colour Dream'" Dmx="176~191" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="14" Name="Multi Flow" Display="'Multi Flow'" Dmx="192~207" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="15" Name="Dream Flow" Display="'Dream Flow'" Dmx="208~223" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="16" Name="Two Colour Flow" Display="'Two Colour    Flow'" Dmx="224~239" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer, Red1, Green1, Red, Green, Master_Dimmer" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="No Func" ID="2" If="'Control'==1||'Control'==4||'Control'==5||'Control'==6||'Control'==7||'Control'==8||'Control'==9||'Control'==10" />
      <Condition Name="Speed" ID="3" If="'Control'&gt;10&amp;&amp;'Control'&lt;17" />
      <Condition Name="Sensitivity" ID="4" If="'Control'==17" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="No Func" Display="''" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Control'==15||'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour2" Display="'Colour 2       %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Control'==15||'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour 1" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Control'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour 2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="No Func" ID="2" If="'Control'==1||'Control'==4||'Control'==5||'Control'==6||'Control'==7||'Control'==8||'Control'==9||'Control'==10" />
      <Condition Name="Speed" ID="3" If="'Control'&gt;10&amp;&amp;'Control'&lt;17" />
      <Condition Name="Sensitivity" ID="4" If="'Control'==17" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Func" Display="''" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

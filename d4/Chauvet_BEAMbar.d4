  <History Date="20-08-16" Author="Nic Morris" Comment="Fixed 5 DMX mode.  Added Atlabase ID's.  Increased wheel resolution." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from Beam Bar to BEAMbar" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="47bacbeb-2d8c-4830-a4ad-e41aed3e85ec" />
  <Control>
    <Attribute ID="Intensity1" Name="Intensity1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Intensity2" Name="Intensity2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Intensity3" Name="Intensity3" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Intensity4" Name="Intensity4" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Intensity5" Name="Intensity5" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="11~30" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="31~50" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="51~70" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="71~90" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="91~110" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="111~130" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="131~150" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="151~170" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="171~190" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="191~210" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="211~230" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="231~250" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="cell" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="CH_BeamBar5" DiamondRef="" WysiwygRef="" />

    <AtlaBase ModeID="8dd1c19e-005c-4af5-831b-ae1e706683cd" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Intensity1" ChannelOffset="1" Wheel="4" VirtualControl="Dimmer" />
      <Attribute ID="Intensity2" ChannelOffset="2" Wheel="5" VirtualControl="Dimmer" />
      <Attribute ID="Intensity3" ChannelOffset="3" Wheel="6" VirtualControl="Dimmer" />
      <Attribute ID="Intensity4" ChannelOffset="4" Wheel="34" VirtualControl="Dimmer" />
      <Attribute ID="Intensity5" ChannelOffset="5" Wheel="35" VirtualControl="Dimmer" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">

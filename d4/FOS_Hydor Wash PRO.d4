    <Attribute ID="Shape_Spd" Name="Shape Spd" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Index+Closing/Opening" ID="2,3,4,5" If="'Shape_Sel'==7||'Shape_Sel'==8" />
      <Condition Name="Index+Open Close" ID="6,7,8,9" If="'Shape_Sel'==9||'Shape_Sel'==10" />
      <Condition Name="Instant On Off" ID="10,11,12,13" If="'Shape_Sel'==11||'Shape_Sel'==12" />
      <Condition Name="Backward/Forward" ID="14,15,16,17" If="'Shape_Sel'==13||'Shape_Sel'==47||'Shape_Sel'==48" />
      <Condition Name="Index+Backward/Forward" ID="18,19,20,21" If="'Shape_Sel'==14||'Shape_Sel'==15||'Shape_Sel'==16||'Shape_Sel'==17||'Shape_Sel'==18||'Shape_Sel'==19||'Shape_Sel'==20||'Shape_Sel'==21||'Shape_Sel'==22||'Shape_Sel'==23||'Shape_Sel'==24||'Shape_Sel'==25||'Shape_Sel'==26||'Shape_Sel'==27||'Shape_Sel'==28||'Shape_Sel'==29||'Shape_Sel'==30||'Shape_Sel'==31||'Shape_Sel'==32||'Shape_Sel'==33||'Shape_Sel'==34||'Shape_Sel'==35||'Shape_Sel'==36||'Shape_Sel'==37||'Shape_Sel'==38||'Shape_Sel'==39||'Shape_Sel'==40||'Shape_Sel'==41||'Shape_Sel'==42||'Shape_Sel'==43||'Shape_Sel'==44||'Shape_Sel'==45||'Shape_Sel'==46||'Shape_Sel'==49||'Shape_Sel'==50" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Closing Effect" Display="'Closing Effect %.f%%',0~100" Dmx="64~158" />

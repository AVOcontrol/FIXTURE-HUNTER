      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="3" Name="WW -&gt; 2700K" Display="'WW -&gt; 2700K %.f%%',0~100" Dmx="7~46" Colour="255,255,255" />
      <Function ID="4" Name="2700K (Bulb White)" Display="'2700K (Bulb White)'" Dmx="47~47" Colour="255,255,255" />
      <Function ID="5" Name="2700-&gt;3200K" Display="'2700-&gt;3200K %.fK',2700~3200" Dmx="48~87" Colour="255,255,255" />
      <Function ID="6" Name="3200K (Halogen White)" Display="'3200K (Halogen White)'" Dmx="88~88" Colour="255,255,255" />
      <Function ID="7" Name="3200-&gt;4000K" Display="'3200-&gt;4000K %.fK',3200~4000" Dmx="89~128" Colour="255,255,255" />
      <Function ID="8" Name="4000K (Neutral White)" Display="'4000K (Neutral White)'" Dmx="129~129" Colour="255,255,255" />
      <Function ID="9" Name="4000-&gt;5600K" Display="'4000-&gt;5600K %.fK',4000~5600" Dmx="130~169" Colour="255,255,255" />
      <Function ID="10" Name="5600K (Studio White)" Display="'5600K (Studio White)'" Dmx="170~170" Colour="255,255,255" />
      <Function ID="11" Name="5600-&gt;6500K" Display="'5600-&gt;6500K %.fK',5600~6500" Dmx="171~210" Colour="255,255,255" />
      <Function ID="12" Name="6500K (Daylight White)" Display="'6500K (Daylight White)'" Dmx="211~211" Colour="255,255,255" />
      <Function ID="13" Name="6500-&gt;Cold Daylight" Display="'6500-&gt;Cold Daylight %.f%%',0~100" Dmx="212~251" Colour="255,255,255" />
      <Function ID="14" Name="Cold Daylight" Display="'Cold Daylight'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="15" Name="CCT C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

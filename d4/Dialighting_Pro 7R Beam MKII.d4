      <Function ID="11" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="205~211" WheelPosition="9" />
      <Function ID="12" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="212~217" WheelPosition="10" />
      <Function ID="13" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="218~223" WheelPosition="11" />
      <Function ID="14" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="224~230" WheelPosition="12" />
      <Function ID="15" Name="Gobo 13 Shake" Display="'Gobo 13 Shake  %.f%%',0~100" Dmx="231~236" WheelPosition="13" />
      <Function ID="16" Name="Gobo 14 Shake" Display="'Gobo 14 Shake  %.f%%',0~100" Dmx="237~243" WheelPosition="14" />
      <Function ID="17" Name="Gobo 15 Shake" Display="'Gobo 15 Shake  %.f%%',0~100" Dmx="244~249" WheelPosition="15" />
      <Function ID="18" Name="Gobo 16 Shake" Display="'Gobo 16 Shake  %.f%%',0~100" Dmx="250~255" WheelPosition="16" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="72~113" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="118~159" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

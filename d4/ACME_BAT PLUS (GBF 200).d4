      <Function ID="12" Name="UV" Display="'UV'" Dmx="48~51" WheelPosition="11" Colour="180,0,255" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="52~63" WheelPosition="12" Colour="0,0,0" />
      <Function ID="14" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="66~67" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="70~71" WheelPosition="1" Colour="255,0,0" />
      <Function ID="16" Name="Org/ L Yel" Display="'Org/ L Yel'" Dmx="74~75" WheelPosition="2" Colour="255,128,0" />
      <Function ID="17" Name="L Yel/ Grn" Display="'L Yel/ Grn'" Dmx="78~79" WheelPosition="3" Colour="255,255,128" />

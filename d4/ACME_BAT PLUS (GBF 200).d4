      <Function ID="19" Name="L Grn/ Blu" Display="'L Grn/ Blu'" Dmx="86~87" WheelPosition="5" Colour="128,255,0" />
      <Function ID="20" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="90~91" WheelPosition="6" Colour="0,0,255" />
      <Function ID="21" Name="Mag/ Aq" Display="'Mag/ Aq'" Dmx="94~95" WheelPosition="7" Colour="255,0,255" />
      <Function ID="22" Name="Aq/ Pk" Display="'Aq/ Pk'" Dmx="98~99" WheelPosition="8" Colour="0,255,200" />
      <Function ID="23" Name="Pk/ 6000K" Display="'Pk/ 6000K'" Dmx="102~103" WheelPosition="9" Colour="255,150,150" />
      <Function ID="24" Name="6000K/ UV" Display="'6000K/ UV'" Dmx="106~107" WheelPosition="10" Colour="230,230,255" />
      <Function ID="25" Name="No Bounce" Display="'No Bounce'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="26" Name="Bounce" Display="'Bounce %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />

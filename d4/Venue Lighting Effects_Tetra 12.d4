    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="127~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="128~227" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="255~255" />
    </Attribute>
  </Control>

  <History Date="15-05-08" Author="Ion Balan" Comment="Created" />
  <History Date="15-05-08" Author="Ion Balan" Comment="Checked" />
  <History Date="15-05-08" Author="User" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Added Red1,Green1,Blue1 and replaced first cell in 54ch mode." />
  <History Date="12-02-11" Author="Nic Morris" Comment="Fixed incorrect channel count in 54ch mode" />
  <History Date="12-02-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased strobe wheel resolution" />
  <History Date="10-09-11" Author="Nic Morris" Comment="Added palettes.  Added pixel mapper compatibility.  Removed clear values." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

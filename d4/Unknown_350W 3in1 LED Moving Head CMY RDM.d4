  <Mode Name="20 DMX (CMY version)" Channels="20" Id="6adc4306-f55f-43b9-8cd8-0246349503e1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7070d7b7-4312-4f72-b07d-a4583145e14b" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="11" Wheel="12" />
      <Attribute ID="CMY_Macro" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="13" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="14" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="16" Wheel="19" />

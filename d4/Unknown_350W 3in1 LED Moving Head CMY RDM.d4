<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="350W 3in1 LED Moving Head CMY RDM" ShortName="350W CMY" Company="Unknown" Version="4">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="26-04-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="27-04-24" Author="Nic Morris" Comment="Corrected CMY mapping (swapped cyan and magenta)" Version="2" />
  <History Date="01-05-24" Author="Nic Morris" Comment="Changed Atlabase mode ID to alternative version with swapped cyan and magenta channels." Version="3" />
  <History Date="28-06-25" Author="Nic Morris" Comment="Added mode with normal CMY mapping." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9713c3d1-4bf7-477d-ac96-06b539b309dd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="4~127" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~251" />
      <Function ID="5" Name="Gradient" Display="'Gradient %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="130~139" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="140~149" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="150~159" Colour="255,255,0" />
      <Function ID="5" Name="Dark Blue" Display="'Dark Blue'" Dmx="160~169" Colour="0,0,180" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="170~179" Colour="255,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="180~189" Colour="255,128,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="190~199" Colour="0,0,255" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~129" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="223~225" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~222" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="223~225" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="226~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CMY_Macro" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~19" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="20~29" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="30~39" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="40~49" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="60~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>1851f444-e3b7-4239-b9e3-666f60d185b9</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Small Dot)" Display="'Gobo 1 (Small Dot)'" Dmx="10~19">
        <Swatch>454a4b53-8f82-4f14-a8c4-8fad904e546e</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Line)" Display="'Gobo 2 (Line)'" Dmx="20~29">
        <Swatch>5f277514-5a2b-41b9-a3d3-ec39bfc0e1c6</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (5 Dots Linear)" Display="'Gobo 3 (5 Dots Linear)'" Dmx="30~39">
        <Swatch>7cd62096-4985-4f4d-ad6c-44ffaa47f574</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Triangle)" Display="'Gobo 4 (Triangle)'" Dmx="40~49">
        <Swatch>55bab45c-3e40-4391-a2a0-793a651e5fd6</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Moonflower)" Display="'Gobo 5 (Moonflower)'" Dmx="50~59">
        <Swatch>7effd00d-6d8d-4765-96e5-b2611926ae51</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Stars)" Display="'Gobo 6 (Stars)'" Dmx="60~69">
        <Swatch>13bf0272-e541-409e-9306-75787fa50c3a</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Rnd Lines)" Display="'Gobo 7 (Rnd Lines)'" Dmx="70~79">
        <Swatch>3565fda8-bbc2-46f3-ab0b-5f5be12db3b8</Swatch>
      </Function>
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="80~168" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="169~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~187" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="188~195" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX (MYC version)" Channels="20" Id="6eca1690-fe8c-4a7c-95cc-5ab0877bc0ae">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Opening" ID="2,3" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Rand Pixel Var" ID="4" If="'Shape'==12" />
      <Condition Name="Rainbow 1" ID="5" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21" />
      <Condition Name="Distribution" ID="6" If="'Shape'==11||'Shape'==23||'Shape'==49||'Shape'==50||'Shape'==51||'Shape'==52||'Shape'==53" />
      <Condition Name="Width" ID="7" If="'Shape'==22||'Shape'==24||'Shape'==26||'Shape'==27||'Shape'==28||'Shape'==29||'Shape'==33||'Shape'==34||'Shape'==35||'Shape'==36||'Shape'==37||'Shape'==38||'Shape'==39||'Shape'==42||'Shape'==43||'Shape'==48||'Shape'==56" />
      <Condition Name="Offset" ID="8" If="'Shape'==25||'Shape'==30||'Shape'==31||'Shape'==32||'Shape'==40||'Shape'==41||'Shape'==44||'Shape'==45||'Shape'==46||'Shape'==47" />
      <Condition Name="Number" ID="9" If="'Shape'==54||'Shape'==55" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="3" Name="Random Flash" Display="'Random Flash %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="4" Name="Pixel Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Index" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="6" Name="Rand Dist" Display="'%.f',2~20" Dmx="0~255" />
      <Function ID="7" Name="Width" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="8" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="9" Name="LEDs" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

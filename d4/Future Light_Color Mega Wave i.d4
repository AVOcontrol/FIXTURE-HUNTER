<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Color Mega Wave i" ShortName="Col Wave i" Company="Future Light">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~15" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Tilt Sync" Display="'Tilt Sync'" Dmx="32~47" />
      <Function ID="4" Name="Pan CW" Display="'Pan CW'" Dmx="48~63" />
      <Function ID="5" Name="P/T CW" Display="'P/T CW'" Dmx="64~79" />
      <Function ID="6" Name="Pan CCW" Display="'Pan CCW'" Dmx="80~95" />
      <Function ID="7" Name="P/T CCW" Display="'P/T CCW'" Dmx="96~111" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
      <Function ID="5" Name="Sequence 1" Display="'Sequence 1'" Dmx="64~67" Intensity="0~0" />
      <Function ID="6" Name="Sequence 2" Display="'Sequence 2'" Dmx="68~71" Intensity="0~0" />
      <Function ID="7" Name="Sequence 3" Display="'Sequence 3'" Dmx="72~75" Intensity="0~0" />
      <Function ID="8" Name="Sequence 4" Display="'Sequence 4'" Dmx="76~79" Intensity="0~0" />
      <Function ID="9" Name="Sequence 5" Display="'Sequence 5'" Dmx="80~83" Intensity="0~0" />
      <Function ID="10" Name="Sequence 6" Display="'Sequence 6'" Dmx="84~87" Intensity="0~0" />
      <Function ID="11" Name="Sequence 7" Display="'Sequence 7'" Dmx="88~91" Intensity="0~0" />
      <Function ID="12" Name="Sequence 8" Display="'Sequence 8'" Dmx="92~95" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="6" Name="Seq 1" Display="'Seq 1 %.f%%',0~100" Dmx="32~47" Intensity="0~0" />
      <Function ID="7" Name="Seq 2" Display="'Seq 2 %.f%%',0~100" Dmx="48~63" Intensity="0~0" />
      <Function ID="8" Name="Seq 3" Display="'Seq 3 %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="9" Name="Seq 4" Display="'Seq 4 %.f%%',0~100" Dmx="112~127" Intensity="0~0" />
      <Function ID="10" Name="Seq 5" Display="'Seq 5 %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="11" Name="Seq 6" Display="'Seq 6 %.f%%',0~100" Dmx="176~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTC" ID="1,2,3,4,5" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="6" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="7,8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="13" />
      <Function ID="1" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="5" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="6" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~243" Colour="0,0,0" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,255,255" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="246~247" Colour="255,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="255,255,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="12" Name="All Col" Display="'All Col'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~243" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="246~247" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="6" Name="All Col" Display="'All Col'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~243" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="246~247" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="6" Name="All Col" Display="'All Col'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="5" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="6" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="18">

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5db6ef14-d859-43b6-a2ee-93ab147dbc0f" />
  <Control>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C" Size="2">
      <Locate Locate="1:1500" PowerOn="1:1500" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1fK',1500.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="9255~9255" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="13110~13110" Colour="255,255,255" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="23133~23133" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="31619~31619" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="ITSH" ID="2" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~120.00" Dmx="0~65535" Colour="255,255,255" />
      <Function ID="2" Name="Saturation" Display="'%.2f%%',-120.00~120.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~0" />
      <Function ID="2" Name="FLEX" Display="'FLEX'" Dmx="1~50" />
      <Function ID="3" Name="FAST" Display="'FAST'" Dmx="51~101" />
      <Function ID="4" Name="SLOW" Display="'SLOW'" Dmx="102~152" />
      <Function ID="5" Name="OFF" Display="'OFF'" Dmx="153~203" />
      <Function ID="6" Name="FLX2" Display="'FLX2'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Saturation" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C" Size="2">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Tint" Display="'No Tint'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+ Green" Display="'+ Green %.2f%%',100.00~0.00" Dmx="257~32382" Colour="255,255,255" />
      <Function ID="3" Name="No Tint" Display="'No Tint'" Dmx="32639~32896" Colour="255,255,255" />
      <Function ID="4" Name="+ Mag" Display="'+ Mag %.2f%%',0.00~100.00" Dmx="33153~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xFade_W-&gt;RGBW" Name="xFade W-&gt;RGBW" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="W-&gt;RGBW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">

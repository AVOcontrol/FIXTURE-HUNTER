      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC1" Name="CTC" Description="" Group="C" Size="2">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1fK',2800.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Fan1" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~0" />
      <Function ID="2" Name="SLOW" Display="'SLOW'" Dmx="10~60" />
      <Function ID="3" Name="FLEX" Display="'FLEX'" Dmx="61~120" />
      <Function ID="4" Name="FAST" Display="'FAST'" Dmx="121~250" />
      <Function ID="5" Name="OFF" Display="'OFF'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

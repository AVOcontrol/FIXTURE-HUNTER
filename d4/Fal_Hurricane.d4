<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hurricane" ShortName="Hurricane" Company="Fal">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Created" />
  <History Date="18-10-19" Author="Nic Morris" Comment="Added gobo swatches.  Revised gobo function DMX ranges in response to customer feedback." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a9a7a02f-1f5d-452d-b639-abfaa081b4f6" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Purple" Display="'Purple'" Dmx="18~18" WheelPosition="1" Colour="128,0,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="36~36" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="54~54" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="72~72" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="90~90" WheelPosition="5" Colour="0,128,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="108~108" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Dark Blue" Display="'Dark Blue'" Dmx="126~126" WheelPosition="7" Colour="0,0,180" />
      <Function ID="9" Name="Op - Ppl" Display="'Op - Ppl %.f%%',0~100" Dmx="0~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Ppl - Rd" Display="'Ppl - Rd %.f%%',0~100" Dmx="18~36" WheelPosition="1" Colour="128,0,255" />
      <Function ID="11" Name="Rd - Grn" Display="'Rd - Grn %.f%%',0~100" Dmx="36~54" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="54~72" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Org - L Blu" Display="'Org - L Blu %.f%%',0~100" Dmx="72~90" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="L Blu - Yel" Display="'L Blu - Yel %.f%%',0~100" Dmx="90~108" WheelPosition="5" Colour="0,128,255" />
      <Function ID="15" Name="Yel - D Blu" Display="'Yel - D Blu %.f%%',0~100" Dmx="108~126" WheelPosition="6" Colour="255,255,0" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~126" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Gobo/ Shutter" Description="" Group="G">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~50" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="54~127" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="128~143" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="144~175">
        <Swatch>8cecae6a-9ebb-446f-9bd8-13dab5d9b4c9</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 1" Display="'Gobo 1'" Dmx="176~176">
        <Swatch>9b33d1c5-5684-4064-a43e-5e6ae1a0a01e</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 2" Display="'Gobo 2'" Dmx="192~192">
        <Swatch>5d335360-04ed-436c-92ed-a31c92df9681</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 3" Display="'Gobo 3'" Dmx="208~208">
        <Swatch>01caf42c-e078-4fe2-8f03-f0bfcac62908</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 4" Display="'Gobo 4'" Dmx="224~224">
        <Swatch>8a327777-81d9-4fd8-90bb-82aae53db00f</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 5" Display="'Gobo 5'" Dmx="240~240">
        <Swatch>2f95a95e-1b44-44d0-802f-9e0cbecddba3</Swatch>
      </Function>
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="17119e19-568c-4794-9e4a-772f826cfced" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="10" Name="Light Blue" Number="7" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="15" Name="Purple" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="9b33d1c5-5684-4064-a43e-5e6ae1a0a01e"></Swatch>
    <Swatch id="5d335360-04ed-436c-92ed-a31c92df9681"></Swatch>
    <Swatch id="01caf42c-e078-4fe2-8f03-f0bfcac62908"></Swatch>
    <Swatch id="8a327777-81d9-4fd8-90bb-82aae53db00f"></Swatch>
    <Swatch id="2f95a95e-1b44-44d0-802f-9e0cbecddba3"></Swatch>
    <Swatch id="8cecae6a-9ebb-446f-9bd8-13dab5d9b4c9"></Swatch>
  </swatchLibrary>
</Fixture>
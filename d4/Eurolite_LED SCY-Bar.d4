<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED SCY-Bar" ShortName="LEDSCY-Bar" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="10-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Update="Red" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~47" Update="Red" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="48~71" Update="Red" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="72~95" Update="Red" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="96~119" Update="Red" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="120~143" Update="Red" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="144~167" Update="Red" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="168~191" Update="Red" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="192~215" Update="Red" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="216~239" Update="Red" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="240~249" Update="Red" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Control'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Select" Name="Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~8" />
      <Function ID="2" Name="Lens 1" Display="'Lens 1'" Dmx="9~17" />
      <Function ID="3" Name="Lens 2" Display="'Lens 2'" Dmx="18~26" />
      <Function ID="4" Name="Lens 3" Display="'Lens 3'" Dmx="27~35" />
      <Function ID="5" Name="Lens 4" Display="'Lens 4'" Dmx="36~44" />
      <Function ID="6" Name="Lens 5" Display="'Lens 5'" Dmx="45~53" />
      <Function ID="7" Name="Lens 6" Display="'Lens 6'" Dmx="54~62" />
      <Function ID="8" Name="Lenses 1,2" Display="'Lenses 1,2'" Dmx="63~71" />
      <Function ID="9" Name="Lenses 2,3" Display="'Lenses 2,3'" Dmx="72~80" />
      <Function ID="10" Name="Lenses 3,4" Display="'Lenses 3,4'" Dmx="81~89" />
      <Function ID="11" Name="Lenses 4,5" Display="'Lenses 4,5'" Dmx="90~98" />
      <Function ID="12" Name="Lenses 5,6" Display="'Lenses 5,6'" Dmx="99~107" />
      <Function ID="13" Name="Lenses 1,2,3" Display="'Lenses 1,2,3'" Dmx="108~116" />
      <Function ID="14" Name="Lenses 2,3,4" Display="'Lenses 2,3,4'" Dmx="117~125" />
      <Function ID="15" Name="Lenses 3,4,5" Display="'Lenses 3,4,5'" Dmx="126~134" />
      <Function ID="16" Name="Lenses 4,5,6" Display="'Lenses 4,5,6'" Dmx="135~143" />
      <Function ID="17" Name="Lenses 1,6" Display="'Lenses 1,6'" Dmx="144~152" />
      <Function ID="18" Name="Lenses 2,5" Display="'Lenses 2,5'" Dmx="153~161" />
      <Function ID="19" Name="Lenses 3,4" Display="'Lenses 3,4'" Dmx="162~170" />
      <Function ID="20" Name="Lenses 1,3" Display="'Lenses 1,3'" Dmx="171~179" />
      <Function ID="21" Name="Lenses 2,4" Display="'Lenses 2,4'" Dmx="180~188" />
      <Function ID="22" Name="Lenses 3,6" Display="'Lenses 3,6'" Dmx="189~197" />
      <Function ID="23" Name="Lenses 1,2,3,4" Display="'Lenses 1,2,3,4'" Dmx="198~206" />
      <Function ID="24" Name="Lenses 2,3,4,5" Display="'Lenses 2,3,4,5'" Dmx="207~215" />
      <Function ID="25" Name="Lenses 3,4,5,6" Display="'Lenses 3,4,5,6'" Dmx="216~224" />
      <Function ID="26" Name="Lenses 1,2,4,5" Display="'Lenses 1,2,4,5'" Dmx="225~233" />
      <Function ID="27" Name="Lenses 2,3,5,6" Display="'Lenses 2,3,5,6'" Dmx="234~242" />
      <Function ID="28" Name="All" Display="'All'" Dmx="243~255" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

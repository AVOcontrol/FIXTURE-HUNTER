  <Mode Name="16 DMX" Channels="16" Id="58210c8d-c576-45a3-9e59-a61385cb4e30">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="105-Segment Strobe Light" ShortName="105SegStrb" Company="BSM" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="02-04-26" Author="Nic Morris" Comment="Created (hopeless documentation.  utter nonsense)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto_Mode" Name="Auto Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto" />
      <Function ID="2" Name="Col Selection" Display="'Col Selection'" Dmx="1~84" Update="Auto" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="85~169" Update="Auto" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="170~255" Update="Auto" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Selection" ID="2" If="'Auto_Mode'==2" />
      <Condition Name="Auto" ID="3" If="'Auto_Mode'==3" />
      <Condition Name="Sound" ID="4" If="'Auto_Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Col Sel, Static FX" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Auto Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Sound Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode_Sel" Name="Mode Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Left_Style" />
      <Function ID="2" Name="Single Font Mode" Display="'Single Font Mode'" Dmx="1~127" Update="Left_Style" />
      <Function ID="3" Name="Dual Font Mode" Display="'Dual Font Mode'" Dmx="128~255" Update="Left_Style" />
    </Attribute>
    <Attribute ID="Left_Style" Name="Left Style" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Left_Colour" Name="Left Colour" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Col Sel" Display="'Col Sel %.1f%%',0.0~100.0" Dmx="0~237" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="238~255" />
    </Attribute>
    <Attribute ID="Left_Speed" Name="Left Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Right_Style" Name="Right Style" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Right_Colour" Name="Right Colour" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Col Sel" Display="'Col Sel %.1f%%',0.0~100.0" Dmx="0~237" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="238~255" />
    </Attribute>
    <Attribute ID="Right_Spd" Name="Right Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode_Sel1" Name="Mode Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="6~55" />
      <Function ID="3" Name="Single Font Mode" Display="'Single Font Mode'" Dmx="56~155" />
      <Function ID="4" Name="Dual Font Mode" Display="'Dual Font Mode'" Dmx="156~255" />
    </Attribute>
    <Attribute ID="FX_Reversal" Name="FX Reversal" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="FWD" Display="'FWD'" Dmx="0~0" />
      <Function ID="2" Name="REV" Display="'REV'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="cad3cc75-3f14-4071-a666-477baa06b1ec">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />

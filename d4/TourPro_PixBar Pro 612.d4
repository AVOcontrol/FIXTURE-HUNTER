  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="30-09-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="34~56" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="57~79" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="8" Name="Break" Display="'Break %.f%%',0~100" Dmx="103~127" />
      <Function ID="9" Name="Pulse 2" Display="'Pulse 2 %.f%%',0~100" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="6~13" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="14~21" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="22~29" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="30~37" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="38~45" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="46~53" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="54~61" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="62~69" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="70~77" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="78~85" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="86~93" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="94~101" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="102~109" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="110~117" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="118~125" Colour="0,0,0" />
      <Function ID="17" Name="Stop" Display="'Stop'" Dmx="126~128" Colour="0,0,0" />
      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="129~192" Colour="0,0,0" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="6~23" />
      <Function ID="3" Name="Meteor" Display="'Meteor'" Dmx="24~41" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="42~59" />
      <Function ID="5" Name="Change" Display="'Change'" Dmx="60~77" />
      <Function ID="6" Name="Flow 1" Display="'Flow 1'" Dmx="78~95" />
      <Function ID="7" Name="Flow 2" Display="'Flow 2'" Dmx="96~113" />
      <Function ID="8" Name="Flow 3" Display="'Flow 3'" Dmx="114~131" />
      <Function ID="9" Name="Flow 4" Display="'Flow 4'" Dmx="132~149" />
      <Function ID="10" Name="Flow 5" Display="'Flow 5'" Dmx="150~167" />
      <Function ID="11" Name="Flow 6" Display="'Flow 6'" Dmx="168~185" />
      <Function ID="12" Name="Flow 7" Display="'Flow 7'" Dmx="186~203" />
      <Function ID="13" Name="Flow 8" Display="'Flow 8'" Dmx="204~221" />
      <Function ID="14" Name="Flow 9" Display="'Flow 9'" Dmx="222~239" />
      <Function ID="15" Name="Flow 10" Display="'Flow 10'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Generic" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~250" />
    </Attribute>
  </Control>

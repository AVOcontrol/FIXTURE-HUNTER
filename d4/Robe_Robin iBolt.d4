  <Thumbnail>14b17653-9e61-4b0d-9110-05c29ef676e0</Thumbnail>
  <History Date="11-04-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="20-04-23" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (adds zoom)" Version="3" />
  <History Date="17-11-23" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request (adds mode 2)" Version="5" />
  <History Date="14-02-24" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (adds safety control channel and revises control functions/macros)" Version="6" />
  <History Date="19-02-24" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (removed mode 2 and revised safety control channel functions)" Version="7" />
  <History Date="08-03-24" Author="Nic Morris" Comment="Corrected frost functions and removed random audio gobo functions in response to manufacturer request." Version="8" />
  <History Date="11-04-24" Author="Nic Morris" Comment="Added product thumbnail and gobo swatches in line with release." Version="9" />
  <History Date="12-04-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />
  <History Date="02-05-24" Author="Nic Morris" Comment="Updated in line with v2.0 charts in response to manufacturer request (revises safety control channel functions, prism 1 slot 2 names, changes beamshape to beam FX and revises functions, renames shutter open sky activation to dimmer activation)" Version="11" />
  <History Date="07-05-24" Author="Nic Morris" Comment="Updated in line with v2.1 charts in response to manufacturer request (renames Beam FX to SpektraBeam, revises safety control lidar function DMX ranges, adds dimmer activation control function and revises dimmer activation macro)" Version="14" />
  <History Date="07-05-24" Author="Nic Morris" Comment="Corrected safety channel default." Version="15" />
  <History Date="29-06-24" Author="Nic Morris" Comment="Corrected Frost range." Version="16" />
  <History Date="27-09-24" Author="Nic Morris" Comment="Updated in line with v2.3 charts in response to manufacturer request (adds stage mode safe distance safety control functions and macros)" Version="17" />
  <History Date="18-02-25" Author="Nic Morris" Comment="Updated in line with v2.4 charts in response to manufacturer request (removes safe distance 80m and adds new functions to safety control)" Version="18" />
  <History Date="05-09-25" Author="Nic Morris" Comment="Updated in line with v2.5 charts in response to manufacturer request (removes sky mode off from safety control)" Version="19" />

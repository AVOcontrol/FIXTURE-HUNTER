    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="16~16" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="32~32" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~48" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Half Minus Green" Display="'Half Minus Green'" Dmx="64~64" WheelPosition="4" Colour="128,255,0" />
      <Function ID="6" Name="Light Orange" Display="'Light Orange'" Dmx="80~80" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Dark Orange" Display="'Dark Orange'" Dmx="96~96" WheelPosition="6" Colour="255,0,0" />
      <Function ID="8" Name="Navy Blue" Display="'Navy Blue'" Dmx="112~112" WheelPosition="7" Colour="0,0,180" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ B Blu" Display="'D Rd/ B Blu'" Dmx="24~24" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="B Blu/ Grn" Display="'B Blu/ Grn'" Dmx="40~40" WheelPosition="2" Colour="0,0,255" />
      <Function ID="12" Name="Grn/ HMG" Display="'Grn/ HMG'" Dmx="56~56" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="HMG/ L Org" Display="'HMG/ L Org'" Dmx="72~72" WheelPosition="4" Colour="220,240,255" />
      <Function ID="14" Name="L Org/ D Org" Display="'L Org/ D Org'" Dmx="88~88" WheelPosition="5" Colour="255,100,0" />
      <Function ID="15" Name="D Org/ N Blu" Display="'D Org/ N Blu'" Dmx="103~103" WheelPosition="6" Colour="255,0,0" />
      <Function ID="16" Name="N Blu/ Op" Display="'N Blu/ Op'" Dmx="120~120" WheelPosition="7" Colour="0,0,180" />
      <Function ID="17" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="D Rd - B Blu" Display="'D Rd - B Blu %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="180,0,0" />
      <Function ID="19" Name="B Blu - Grn" Display="'B Blu - Grn %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="0,0,255" />
      <Function ID="20" Name="Grn - HMG" Display="'Grn - HMG %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="0,255,0" />
      <Function ID="21" Name="HMG - L Org" Display="'HMG - L Org %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="220,240,255" />
      <Function ID="22" Name="L Org - D Org" Display="'L Org - D Org %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="255,100,0" />
      <Function ID="23" Name="D Org - N Blu" Display="'D Org - N Blu %.f%%',0~100" Dmx="96~112" WheelPosition="6" Colour="255,0,0" />
      <Function ID="24" Name="N Blu - Op" Display="'N Blu - Op %.f%%',0~100" Dmx="112~127" WheelPosition="7" Colour="0,0,180" />

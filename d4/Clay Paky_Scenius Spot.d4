      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="48830~32896" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="2,3,4,5,6,7,8,9,10" If="'Anim_Func'==2" />
      <Condition Name="Shake" ID="11,12,13,14,15,16,17,18,19" If="'Anim_Func'==3" />
      <Condition Name="Scroll" ID="20,21,22,23" If="'Anim_Func'==4" />
      <Condition Name="Animation" ID="24" If="'Anim_Func'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" />
      <Function ID="4" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" />
      <Function ID="5" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" />
      <Function ID="6" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" />
      <Function ID="7" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" />
      <Function ID="8" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" />
      <Function ID="9" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" />
      <Function ID="10" Name="Gobo 8" Display="'Gobo 8'" Dmx="64~71" WheelPosition="8" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="160~171" WheelPosition="1" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="172~183" WheelPosition="2" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="184~195" WheelPosition="3" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="196~207" WheelPosition="4" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="208~219" WheelPosition="5" />
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="220~231" WheelPosition="6" />
      <Function ID="18" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="232~243" WheelPosition="7" />
      <Function ID="19" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="244~255" WheelPosition="8" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" WheelPosition="0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="118~159" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="23" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="113~72" />
      <Function ID="24" Name="Animation" Display="'Animation %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Anim_Rot" Name="Anim Rot" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~124" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="125~130" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~193" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="190~128" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Light" Display="'Light %.1f%%',0.0~100.0" Dmx="0~138" />
      <Function ID="2" Name="Heavy" Display="'Heavy %.1f%%',0.0~100.0" Dmx="139~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Distance" Display="'%.fm',4.0~100.0" Dmx="7~255" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Adj -" Display="'Adj - %.1f%%',-100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="3" Name="Adj +" Display="'Adj + %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Fast" Display="'P/T Fast'" Dmx="12~24" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="25~37" />
      <Function ID="4" Name="Dim Conventional" Display="'Dim Conventional'" Dmx="38~50" />
      <Function ID="5" Name="Dim Standard" Display="'Dim Standard'" Dmx="51~62" />
      <Function ID="6" Name="Gobo Fast" Display="'Gobo Fast'" Dmx="140~152" />
      <Function ID="7" Name="Gobo Normal" Display="'Gobo Normal'" Dmx="153~164" />
      <Function ID="8" Name="Dim Linear" Display="'Dim Linear'" Dmx="204~213" />
      <Function ID="9" Name="Unused" Display="'Unused'" Dmx="1~1" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
      <Function ID="5" Name="Unused" Display="'Unused'" Dmx="1~1" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="26~100" />
      <Function ID="3" Name="Lamp On 1200W" Display="'Lamp On 1200W'" Dmx="101~178" />
      <Function ID="4" Name="Lamp On 1400W" Display="'Lamp On 1400W'" Dmx="179~255" />
      <Function ID="5" Name="Unused" Display="'Unused'" Dmx="1~1" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
      <Function ID="3" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Col_Spd" Name="Col Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
      <Function ID="3" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Beam_Spd" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
      <Function ID="3" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gobo_Spd" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
      <Function ID="3" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Anim_Func" Name="Anim Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Animation" Display="'Animation'" Dmx="0~0" Update="Animation" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Animation" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Animation" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Animation" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Animation" />
    </Attribute>
  </Control>

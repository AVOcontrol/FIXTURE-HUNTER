<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Scenius Spot" ShortName="Scenius Sp" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>953bbc31-96be-4486-9ecb-47eb47367485</Thumbnail>
  <History Date="21-12-15" Author="Nic Morris" Comment="Created" />
  <History Date="03-05-16" Author="Peter Budd" Comment="Changed the colour open range to 0, to stop it locating with the colour wheel in." />
  <History Date="03-05-16" Author="Nic Morris" Comment="Updated fixed colour and animation functions in line with latest documentation." />
  <History Date="03-05-16" Author="Nic Morris" Comment="Revised function and lamp functions along with associated macros in line with latest spec." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-06-16" Author="Peter Budd" Comment="Corrected Gobo 2 Functions, and added animation func to modes." />
  <History Date="14-06-16" Author="Nic Morris" Comment="Removed Gobo2 updates from Gobo 1 Func.  Revised colour index functions to multiple ranges." />
  <History Date="14-06-16" Author="Nic Morris" Comment="Removed duplicate ID from colour else condition.  Increased macro delay in attempt to fix bug report." />
  <History Date="15-06-16" Author="Peter Budd" Comment="Made the macros work, inverted the iris and tidied up some of the Rotations to match the fixture." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Unified across product range where possible.  Revised colour index ranges to allow full field adjustment." />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised frost functions in line with 10/2016 charts." />
  <History Date="08-04-17" Author="Nic Morris" Comment="Added continuous colour index function.  Fixed variable speed functions." />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added gobo swatches (animation wheel static not added - no slot numbers).  Added channel counts to mode names." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added RDM ID's (note no personality ID's but should be ok as all modes have unique channel counts)" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="640" />

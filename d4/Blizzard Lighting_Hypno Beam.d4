<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hypno Beam" ShortName="Hypno Beam" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="17-08-17" Author="Nic Morris" Comment="Created" />
  <History Date="23-09-17" Author="Nic Morris" Comment="Created from BeamZ Illusion 2" />
  <History Date="29-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e02bd194-1a76-4839-a2fe-9b367e3c46f6" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="46~65" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="66~85" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="86~105" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="106~125" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="126~145" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="146~165" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="166~185" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="186~205" Colour="255,255,255" />
      <Function ID="10" Name="RGB Fade" Display="'RGB Fade %.f%%',0~100" Dmx="255~206" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Ring_Shutter" Name="Ring Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="30~225" />
    </Attribute>
    <Attribute ID="Ring_Master" Name="Ring Master" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Auto" Name="Ring Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="36~40" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="41~45" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~50" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="51~55" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="56~60" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="61~65" />
      <Function ID="8" Name="White" Display="'White'" Dmx="66~70" />
      <Function ID="9" Name="RGB Chase" Display="'RGB Chase'" Dmx="71~80" />
      <Function ID="10" Name="Red Chase" Display="'Red Chase'" Dmx="81~85" />
      <Function ID="11" Name="Green Chase" Display="'Green Chase'" Dmx="86~90" />
      <Function ID="12" Name="Blue Chase" Display="'Blue Chase'" Dmx="91~95" />
      <Function ID="13" Name="R/G Chase" Display="'R/G Chase'" Dmx="96~100" />
      <Function ID="14" Name="R/B Chase" Display="'R/B Chase'" Dmx="101~105" />
      <Function ID="15" Name="G/B Chase" Display="'G/B Chase'" Dmx="106~110" />
      <Function ID="16" Name="R/G/B Chase" Display="'R/G/B Chase'" Dmx="111~115" />
      <Function ID="17" Name="Red Ring Zm Out" Display="'Red Ring Zm Out'" Dmx="116~120" />
      <Function ID="18" Name="Green Ring Zm Out" Display="'Green Ring Zm Out'" Dmx="121~125" />
      <Function ID="19" Name="Blue Ring Zm Out" Display="'Blue Ring Zm Out'" Dmx="126~130" />
      <Function ID="20" Name="R/G/B Ring Zm Out" Display="'R/G/B Ring Zm Out'" Dmx="131~135" />
      <Function ID="21" Name="Red Ring Zm In" Display="'Red Ring Zm In'" Dmx="136~140" />
      <Function ID="22" Name="Green Ring Zm In" Display="'Green Ring Zm In'" Dmx="141~145" />
      <Function ID="23" Name="Blue Ring Zm In" Display="'Blue Ring Zm In'" Dmx="146~150" />
      <Function ID="24" Name="R/G/B Ring Zm In" Display="'R/G/B Ring Zm In'" Dmx="151~155" />
      <Function ID="25" Name="R/G/B Switch" Display="'R/G/B Switch'" Dmx="156~160" />
      <Function ID="26" Name="Col Change FX" Display="'Col Change FX'" Dmx="161~165" />
      <Function ID="27" Name="Multi-Ring Chase" Display="'Multi-Ring Chase %.f%%',0~100" Dmx="166~255" />
    </Attribute>
    <Attribute ID="Ring_Auto_Spd" Name="Ring Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="50~99" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="100~149" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~249" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="All_Ring_Dim" Name="All Ring Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Ring_Red" Name="Ring Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Ring_Green" Name="Ring Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Ring_Blue" Name="Ring Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ad9bf267-cd88-47dd-aedd-d4ae586f5777" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
        <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />

        <Attribute ID="All_Ring_Dim" Wheel="5" />
        <Attribute ID="Ring_Auto" Wheel="22" />
        <Attribute ID="Ring_Auto_Spd" Wheel="23" />
        <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
        <Attribute ID="White" ChannelOffset="7" Wheel="40" />
      </Master>
      <Cell ID="Cell1" Name="Rings" ChannelOffset="10" ModeLink="Ring cell" X="0" Y="0">
        <AttributeLink SourceId="Ring_Shutter" TargetId="Ring_Shutter" />
        <AttributeLink SourceId="All_Ring_Dim" TargetId="Dimmer" />
        <AttributeLink SourceId="Ring_Auto" TargetId="Ring_Auto" />
        <AttributeLink SourceId="Ring_Auto_Spd" TargetId="Ring_Auto_Spd" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="23 DMX" Channels="23">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="04b83f1d-51a8-4be8-a009-6d0785a5c506" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
        <Attribute ID="Colour_Macro" ChannelOffset="22" Wheel="37" />
        <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
        <Attribute ID="Ring_Shutter" ChannelOffset="18" Wheel="6" />
        <Attribute ID="Ring_Master" ChannelOffset="19" Wheel="34" />
        <Attribute ID="Ring_Auto" ChannelOffset="20" Wheel="22" />
        <Attribute ID="Ring_Auto_Spd" ChannelOffset="21" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="23" Wheel="28" />
        <Attribute ID="All_Ring_Dim" Wheel="5" />
        <Attribute ID="White" ChannelOffset="9" Wheel="40" />
        <Attribute ID="Ring_Red" Wheel="7" />
        <Attribute ID="Ring_Green" Wheel="8" />
        <Attribute ID="Ring_Blue" Wheel="9" />
      </Master>
      <Cell ID="Cell1" Name="Ring 1" ChannelOffset="12" ModeLink="RGB cell" X="0" Y="0">
        <AttributeLink SourceId="Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="All_Ring_Dim" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Ring 2" ChannelOffset="15" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Ring_Red" TargetId="Red" />
        <AttributeLink SourceId="Ring_Green" TargetId="Green" />
        <AttributeLink SourceId="Ring_Blue" TargetId="Blue" />
        <AttributeLink SourceId="All_Ring_Dim" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Ring cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Ring_Shutter" ChannelOffset="1" Wheel="6" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Ring_Auto" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Ring_Auto_Spd" ChannelOffset="4" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100,Ring_Red:1:100,Ring_Green:1:100,Ring_Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0,Ring_Red:1:100,Ring_Green:1:0,Ring_Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0,Ring_Red:1:100,Ring_Green:1:50,Ring_Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0,Ring_Red:1:100,Ring_Green:1:100,Ring_Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0,Ring_Red:1:50,Ring_Green:1:100,Ring_Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0,Ring_Red:1:0,Ring_Green:1:100,Ring_Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50,Ring_Red:1:0,Ring_Green:1:100,Ring_Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100,Ring_Red:1:0,Ring_Green:1:100,Ring_Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100,Ring_Red:1:0,Ring_Green:1:50,Ring_Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100,Ring_Red:1:0,Ring_Green:1:0,Ring_Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100,Ring_Red:1:50,Ring_Green:1:0,Ring_Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100,Ring_Red:1:100,Ring_Green:1:0,Ring_Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50,Ring_Red:1:100,Ring_Green:1:0,Ring_Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94,Ring_Red:1:71,Ring_Green:1:43,Ring_Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100,Ring_Red:1:20,Ring_Green:1:0,Ring_Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />

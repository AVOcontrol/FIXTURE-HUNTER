  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="27abaeaa-7c0d-4ba0-80c9-03dfca26200a" />
  <Control>
    <Attribute ID="Shows" Name="Shows" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~47" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="48~87" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="88~127" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="128~167" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="168~207" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="208~247" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="2:0" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="8~199" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~247" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour 1" Display="'Colour 1'" Dmx="0~46" Colour="0,0,0" />
      <Function ID="2" Name="Colour 2" Display="'Colour 2'" Dmx="47~85" Colour="0,0,0" />
      <Function ID="3" Name="Colour 3" Display="'Colour 3'" Dmx="86~124" Colour="0,0,0" />
      <Function ID="4" Name="Colour 4" Display="'Colour 4'" Dmx="125~163" Colour="0,0,0" />
      <Function ID="5" Name="Colour 5" Display="'Colour 5'" Dmx="164~202" Colour="0,0,0" />
      <Function ID="6" Name="Colour 6" Display="'Colour 6'" Dmx="203~240" Colour="0,0,0" />
      <Function ID="7" Name="Colour 7" Display="'Colour 7'" Dmx="241~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">

      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~104" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="105~154" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="155~204" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="205~255" />

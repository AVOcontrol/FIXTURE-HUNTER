<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Armor Bar 5X21W AW+UV" ShortName="Bar 5x21W" Company="Phantos">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="19-12-16" Author="Nic Morris" Comment="Created" />
  <History Date="22-12-16" Author="Nic Morris" Comment="Added ID attribute to Standard and Extended 1 modes in line with latest documentation." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="50~99" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="100~149" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="ID" Display="'ID %.f',0~50" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="8">
    <Import PearlRef="UKPHB521" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Macro" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Macro_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="7" />
      <Attribute ID="White" ChannelOffset="6" Wheel="8" />
      <Attribute ID="UV" ChannelOffset="7" Wheel="9" />
      <Attribute ID="ID" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended 2" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Amber" Wheel="7" />
        <Attribute ID="White" Wheel="8" />
        <Attribute ID="UV" Wheel="9" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="AWUV vdim" X="0" Y="0">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="AWUV vdim" X="0" Y="1">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="AWUV vdim" X="0" Y="2">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="AWUV vdim" X="0" Y="3">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="13" ModeLink="AWUV vdim" X="0" Y="4">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Extended 1" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Macro" ChannelOffset="3" Wheel="22" />
        <Attribute ID="Macro_Spd" ChannelOffset="4" Wheel="23" />
        <Attribute ID="Amber" Wheel="7" />
        <Attribute ID="White" Wheel="8" />
        <Attribute ID="UV" Wheel="9" />
        <Attribute ID="ID" ChannelOffset="20" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="AWUV cell" X="0" Y="0">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="AWUV cell" X="0" Y="1">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="11" ModeLink="AWUV cell" X="0" Y="2">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="14" ModeLink="AWUV cell" X="0" Y="3">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="17" ModeLink="AWUV cell" X="0" Y="4">
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="UV" TargetId="UV" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="AWUV cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Amber" ChannelOffset="1" Wheel="7" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="UV" ChannelOffset="3" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="AWUV vdim" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Amber" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="UV" ChannelOffset="3" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="17" Name="Split" Display="'Split %.1f%%',0.0~100.0" Dmx="60~187" Colour="255,255,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="188~219" Colour="0,0,0" />

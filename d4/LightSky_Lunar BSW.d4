      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="5m" Display="'5m'" Dmx="10~19" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="7.5m" Display="'7.5m'" Dmx="20~29" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="10m" Display="'10m'" Dmx="30~39" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="15m" Display="'15m'" Dmx="40~49" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="20m" Display="'20m'" Dmx="50~59" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="30m" Display="'30m'" Dmx="60~69" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="40m" Display="'40m'" Dmx="70~79" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="50m" Display="'50m'" Dmx="80~89" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="108~157" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="158~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

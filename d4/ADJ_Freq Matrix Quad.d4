  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Freq Matrix Quad.d4 to ADJ_Freq Matrix Quad.d4." Version="8" />

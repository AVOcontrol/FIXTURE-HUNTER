  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="11-08-25" Author="Nic Morris" Comment="Created (charts only.  translated from Chinese)" Version="0" />
  <History Date="31-12-25" Author="Nic Morris" Comment="Added modes in line with latest documentation.  Hopeless.  Very confusing.  No physical information but new modes look like there are separate elements.  Revised existing modes to multi-cell accordingly." Version="1" />

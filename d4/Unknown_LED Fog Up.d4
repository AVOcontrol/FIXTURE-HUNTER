<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Fog Up" ShortName="LED Fog Up" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="12-05-25" Author="Nic Morris" Comment="Created (charts only.  hopeless.  looks like nonsense)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red/Blue" Name="Red/Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red/Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Effect" Name="Colour Effect" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" Colour="0,0,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="36~71" Colour="0,255,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="72~107" Colour="255,0,0" />
      <Function ID="4" Name="RGB (1)" Display="'RGB (1)'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="5" Name="Red Blue" Display="'Red Blue'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="6" Name="Green Blue" Display="'Green Blue'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="7" Name="Red Green" Display="'Red Green'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="8" Name="RGB (2)" Display="'RGB (2)'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="09db6f1e-f3d0-48c8-b25e-d6b79e2f28db">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Green" Wheel="10" />
        <Attribute ID="Reserved" Wheel="28" />
        <Attribute ID="Red/Blue" Wheel="11" />
        <Attribute ID="Reserved1" Wheel="29" />
        <Attribute ID="Colour_Effect" Wheel="7" />
        <Attribute ID="Reserved2" Wheel="30" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Fog" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Fog cell" X="0" Y="0">
        <AttributeLink SourceId="Fog" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="LED" ChannelOffset="2" ModeLink="LED cell" X="0" Y="1">
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Reserved" TargetId="Reserved" />
        <AttributeLink SourceId="Red/Blue" TargetId="Red/Blue" />
        <AttributeLink SourceId="Reserved1" TargetId="Reserved1" />
        <AttributeLink SourceId="Colour_Effect" TargetId="Colour_Effect" />
        <AttributeLink SourceId="Reserved2" TargetId="Reserved2" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

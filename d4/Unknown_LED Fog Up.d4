    </Include>
  </Mode>
  <Mode Name="LED cell" Channels="7" Hidden="True" Id="077f2832-9014-4164-9517-d6445678e34b">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Green" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Reserved" ChannelOffset="2" Wheel="28" />
      <Attribute ID="Red/Blue" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Reserved1" ChannelOffset="4" Wheel="29" />
      <Attribute ID="Colour_Effect" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Reserved2" ChannelOffset="6" Wheel="30" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />

  <AtlaBase TypeID="a0fabd32-9005-49b9-96eb-307d2a8a847a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="180~249" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="120~179" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="10~49" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="50~89" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="90~119" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan High Output" Display="'Fan High Output'" Dmx="11~20" />
      <Function ID="3" Name="Fan Standard" Display="'Fan Standard'" Dmx="21~30" />
      <Function ID="4" Name="Fan Silent" Display="'Fan Silent'" Dmx="31~40" />
      <Function ID="5" Name="Dis Blink Off" Display="'Dis Blink Off'" Dmx="51~60" />
      <Function ID="6" Name="Dis Blink On" Display="'Dis Blink On'" Dmx="61~70" />
      <Function ID="7" Name="Lamp No. Invert Off" Display="'Lamp No. Invert Off'" Dmx="81~90" />
      <Function ID="8" Name="Lamp No. Invert On" Display="'Lamp No. Invert On'" Dmx="91~99" />
      <Function ID="9" Name="LED Freq 1.8kHz" Display="'LED Freq 1.8kHz'" Dmx="111~120" />
      <Function ID="10" Name="LED Freq 3.6kHz" Display="'LED Freq 3.6kHz'" Dmx="121~130" />
      <Function ID="11" Name="LED Freq 7.2kHz" Display="'LED Freq 7.2kHz'" Dmx="131~140" />
      <Function ID="12" Name="LED Freq 25kHz" Display="'LED Freq 25kHz'" Dmx="141~150" />
      <Function ID="13" Name="Dim Linear" Display="'Dim Linear'" Dmx="161~170" />
      <Function ID="14" Name="Dim Square" Display="'Dim Square'" Dmx="171~180" />
      <Function ID="15" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="181~190" />
      <Function ID="16" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="191~200" />
      <Function ID="17" Name="Dim Smooth Fast" Display="'Dim Smooth Fast'" Dmx="211~220" />
      <Function ID="18" Name="Dim Smooth Med" Display="'Dim Smooth Med'" Dmx="221~230" />
      <Function ID="19" Name="Dim Smooth Slow" Display="'Dim Smooth Slow'" Dmx="231~240" />
      <Function ID="20" Name="Dim Smooth Halogen" Display="'Dim Smooth Halogen'" Dmx="241~250" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

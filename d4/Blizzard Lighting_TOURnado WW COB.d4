<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TOURnado WW COB" ShortName="TORnado WW" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="29-04-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~115" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="116~130" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="171~210" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="211~250" Intensity="0~0" />
      <Function ID="6" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="131~170" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="21~30" />
      <Function ID="4" Name="Inv Sq" Display="'Inv Sq'" Dmx="31~40" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Square Smooth" Display="'Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Inv Sq Smooth" Display="'Inv Sq Smooth'" Dmx="71~80" />
      <Function ID="9" Name="S-Curve Smooth" Display="'S-Curve Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Preset" Display="'Preset'" Dmx="91~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKBLTWW3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dim_Spd" ChannelOffset="3" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKBLTWW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
      <Condition Name="Index+Spin" ID="10,11,12,13" If="'Shape_Sel'==11||'Shape_Sel'==13||'Shape_Sel'==14||'Shape_Sel'==15||'Shape_Sel'==16||'Shape_Sel'==17||'Shape_Sel'==18||'Shape_Sel'==19||'Shape_Sel'==20||'Shape_Sel'==21||'Shape_Sel'==22||'Shape_Sel'==23||'Shape_Sel'==24" />

      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius Size" Display="'Radius Size %.f%%',0~100" Dmx="0~63" />

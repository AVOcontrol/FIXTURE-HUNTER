    <Attribute ID="Shape_Spd" Name="Shape Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Size+Pulse" ID="2,3,4,5" If="'Shape_Sel'&gt;4&amp;&amp;'Shape_Sel'&lt;9" />

    <Attribute ID="Rotate" Name="Rotate" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="4" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="127~1" />
    </Attribute>
    <Attribute ID="Repeat" Name="Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full" Display="'Full'" Dmx="0~0" />
      <Function ID="2" Name="x2" Display="'x2'" Dmx="1~63" />

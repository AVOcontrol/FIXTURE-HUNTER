    <Attribute ID="SpektraBm_Rot" Name="SpektraBm Rot" Description="" Group="B">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Index" ID="1" If="'SpektraBm_Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'SpektraBm_Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />

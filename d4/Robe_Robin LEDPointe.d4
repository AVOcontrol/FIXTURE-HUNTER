      <Function ID="4" Name="6-Facet Linear Multicoloured Prism Spin" Display="'6-Facet Linear Multicoloured Prism Spin'" Dmx="12~15" Update="Prism_2_Rot" />
      <Function ID="5" Name="8-Facet 12° Circular Prism Spin" Display="'8-Facet 12° Circular Prism Spin'" Dmx="16~19" Update="Prism_2_Rot" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_2_Rot" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Prism" ID="1" If="'Prism_2'==1" />
      <Condition Name="Index" ID="2" If="'Prism_2'==2||'Prism_2'==3" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism_2'==4||'Prism_2'==5" />
      <Else ID="7" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="SpektraBm_Func" Name="SpektraBm Func" Description="" Group="B" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="SpektraBeam, SpektraBm_Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="SpektraBeam, SpektraBm_Rot" />

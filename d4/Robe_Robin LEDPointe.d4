  <History Date="18-02-25" Author="Nic Morris" Comment="Removed rand audio function from gobos and updated prism function names to display prism types." Version="8" />
  <History Date="28-04-25" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (adds prism in dark control functions and macros)." Version="9" />

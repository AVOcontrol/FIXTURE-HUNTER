    <Attribute ID="Frost_Func" Name="Frost Func" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Frost" />
      <Function ID="2" Name="Light Frost" Display="'Light Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="3" Name="Medium Frost" Display="'Medium Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="4" Name="Combined Frost" Display="'Combined Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Frost" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Frost_Func'==1" />
      <Condition Name="Light Frost" ID="2,3,4,5,6,7,8" If="'Frost_Func'==2" />
      <Condition Name="Medium Frost" ID="9,10,11,12,13,14,15" If="'Frost_Func'==3" />
      <Condition Name="Combined Frost" ID="16,17,18,19,20,21,22" If="'Frost_Func'==4" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="1~50" WheelPosition="1" />
      <Function ID="4" Name="Full" Display="'Full'" Dmx="51~53" WheelPosition="2" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="54~63" WheelPosition="3" />

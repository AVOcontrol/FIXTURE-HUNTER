      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="87~136" WheelPosition="1" />
      <Function ID="11" Name="Full" Display="'Full'" Dmx="137~139" WheelPosition="2" />
      <Function ID="12" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="140~149" WheelPosition="3" />
      <Function ID="13" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="150~159" WheelPosition="4" />
      <Function ID="14" Name="Ramping" Display="'Ramping %.f%%',0~100" Dmx="169~160" WheelPosition="5" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="170~172" WheelPosition="6" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="173~222" WheelPosition="1" />
      <Function ID="18" Name="Full" Display="'Full'" Dmx="223~225" WheelPosition="2" />

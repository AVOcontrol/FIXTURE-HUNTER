  <AtlaBase TypeID="45d91a6c-4d36-4d2f-b2c4-09ff9153c9b4" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="11~20" Update="Program_Spd" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="21~30" Update="Program_Spd" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="31~40" Update="Program_Spd" />
      <Function ID="5" Name="Program 1" Display="'Program 1'" Dmx="41~50" Update="Program_Spd" />
      <Function ID="6" Name="Program 2" Display="'Program 2'" Dmx="51~60" Update="Program_Spd" />
      <Function ID="7" Name="Program 3" Display="'Program 3'" Dmx="61~70" Update="Program_Spd" />
      <Function ID="8" Name="Program 4" Display="'Program 4'" Dmx="71~80" Update="Program_Spd" />
      <Function ID="9" Name="Program 5" Display="'Program 5'" Dmx="81~90" Update="Program_Spd" />
      <Function ID="10" Name="Program 6" Display="'Program 6'" Dmx="91~100" Update="Program_Spd" />
      <Function ID="11" Name="Program 7" Display="'Program 7'" Dmx="101~110" Update="Program_Spd" />
      <Function ID="12" Name="Program 8" Display="'Program 8'" Dmx="111~120" Update="Program_Spd" />
      <Function ID="13" Name="Program 9" Display="'Program 9'" Dmx="121~130" Update="Program_Spd" />
      <Function ID="14" Name="Program 10" Display="'Program 10'" Dmx="131~140" Update="Program_Spd" />
      <Function ID="15" Name="Program 11" Display="'Program 11'" Dmx="141~150" Update="Program_Spd" />
      <Function ID="16" Name="Program 12" Display="'Program 12'" Dmx="151~160" Update="Program_Spd" />
      <Function ID="17" Name="Program 13" Display="'Program 13'" Dmx="161~170" Update="Program_Spd" />
      <Function ID="18" Name="Program 14" Display="'Program 14'" Dmx="171~180" Update="Program_Spd" />
      <Function ID="19" Name="Program 15" Display="'Program 15'" Dmx="181~190" Update="Program_Spd" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="191~255" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Sensitivity" ID="3,4" If="'Program'==20" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Sound_Mode" Name="Sound Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Change Col" Display="'Change Col'" Dmx="0~0" />
      <Function ID="2" Name="Flash with Changing Col" Display="'Flash with Changing Col'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

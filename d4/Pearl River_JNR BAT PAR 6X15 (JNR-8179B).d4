    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Mixed Col" Display="'Mixed Col'" Dmx="9~50" />
      <Function ID="3" Name="Jump Fade" Display="'Jump Fade'" Dmx="51~100" />
      <Function ID="4" Name="Mutation" Display="'Mutation'" Dmx="101~150" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="151~200" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="201~220" />
      <Function ID="7" Name="Sound 3" Display="'Sound 3'" Dmx="221~240" />
      <Function ID="8" Name="Sound 4" Display="'Sound 4'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

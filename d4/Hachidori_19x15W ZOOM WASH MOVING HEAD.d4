  <Mode Name="14 DMX" Channels="14" Id="6dde025a-508e-4d46-ae78-b6eda526bad9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="5.6 kg" />
      <Size Height="360 mm" Width="196 mm" Depth="133 mm" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
      <Attribute ID="Colour1Func" Wheel="7" />

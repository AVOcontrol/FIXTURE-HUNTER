  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7fb32b09-46b2-4ed6-bbcb-91285592b644" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="R/G" Display="'R/G'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="R/B" Display="'R/B'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="R/W" Display="'R/W'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="G/B" Display="'G/B'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="G/W" Display="'G/W'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="B/W" Display="'B/W'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="R/G/B" Display="'R/G/B'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="R/G/W" Display="'R/G/W'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="R/B/W" Display="'R/B/W'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="G/B/W" Display="'G/B/W'" Dmx="224~239" Colour="255,255,255" />
      <Function ID="16" Name="R/G/B/W" Display="'R/G/B/W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shows" Name="Shows" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shows1" Name="Shows" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Show 1" Display="'Show 1'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Show 2" Display="'Show 2'" Dmx="8~37" Update="Speed" />
      <Function ID="3" Name="Show 3" Display="'Show 3'" Dmx="38~67" Update="Speed" />
      <Function ID="4" Name="Show 4" Display="'Show 4'" Dmx="68~97" Update="Speed" />
      <Function ID="5" Name="Show 5" Display="'Show 5'" Dmx="98~127" Update="Speed" />
      <Function ID="6" Name="Show 6" Display="'Show 6'" Dmx="128~157" Update="Speed" />
      <Function ID="7" Name="Show 7" Display="'Show 7'" Dmx="158~187" Update="Speed" />
      <Function ID="8" Name="Show 8" Display="'Show 8'" Dmx="188~217" Update="Speed" />
      <Function ID="9" Name="Random" Display="'Random'" Dmx="218~247" Update="Speed" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Shows1'==10||'Program'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" Update="Speed" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" Update="Speed" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" Update="Speed" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" Update="Speed" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" Update="Speed" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" Update="Speed" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" Update="Speed" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" Update="Speed" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~254" Update="Speed" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="255~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
  </Control>

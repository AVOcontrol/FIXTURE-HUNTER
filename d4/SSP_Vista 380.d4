  <Thumbnail>cfba65a4-900f-4824-bd20-71048d1a23cc</Thumbnail>
  <History Date="17-04-24" Author="Nic Morris" Comment="Created (note charts have 16 gobo slots but there are 17 in the drawings, images and specifications)" Version="0" />
  <History Date="18-04-24" Author="Nic Morris" Comment="Fixed colour index (was fixed rather than variable)" Version="2" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Vizi Beam CMY.d4 to ADJ_Vizi Beam CMY.d4." Version="3" />
  <History Date="07-08-25" Author="Nic Morris" Comment="Created from ADJ Vizi Beam CMY (awful documentation.  colour and gobo ranges are missing.  same issue with gobo images/slots.  assumed the same for now)" Version="4" />
  <History Date="10-08-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="21-08-25" Author="Nic Morris" Comment="Revised shutter ranges in response to customer feedback (documentation just has off and open)" Version="6" />
  <History Date="24-04-26" Author="Nic Morris" Comment="Created from FOS Beam CMY (poor documentation.  effectively identical. colour and gobo ranges missing.  gobo wheel drawing and specs have 17 gobos+open but charts say 16...)" Version="7" />
  <History Date="09-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="155acb01-08da-48f1-910f-5d2b75c7933b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Colours Change" Display="'Colours Change'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Colour1Func'==1" />
      <Condition Name="Colours Change" ID="3,4" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="5,6,7,8" If="'Colour1Func'==3" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.f%%',0~100" Dmx="4~59" Colour="0,0,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="Colours Change" Display="'Colours Change %.f%%',0~100" Dmx="60~127" Colour="0,0,0" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />

    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="145~164" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="165~184" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="185~204" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="205~224" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Amadeus H600" ShortName="AmdeusH600" Company="BOS Lighting" Version="30">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="21-12-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="21-03-16" Author="Nic Morris" Comment="Created from Clay Paky Scenius Spot (blade locations uncertain)" Version="2" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="3" />
  <History Date="16-06-16" Author="Nic Morris" Comment="Moved open colour from else into fixed condition.  Fixed missing colour index conditional statement.  " Version="4" />
  <History Date="16-06-16" Author="Nic Morris" Comment="Revised colour index functions to multiple ranges.  Inverted iris." Version="5" />
  <History Date="16-06-16" Author="Nic Morris" Comment="Removed duplicate ID from Gobo 1 else condition.  Fixed gobo 2 and gobo 2 rot conditions." Version="6" />
  <History Date="16-06-16" Author="Nic Morris" Comment="Flipped gobo 2 rot and prism spin ranges in line with Clay Paky Scenius Spot" Version="7" />
  <History Date="16-06-16" Author="Nic Morris" Comment="Recreated palettes.  Revised macros in line with Clay Paky Scenius Spot." Version="8" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added gobo names.  Standardised iris wheel direction.  Swapped CW and CCW gobo spin in line with 01/2017 charts." Version="9" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised frost with two frost ranges in line with 01/2017 charts." Version="10" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Unified with Clay Paky Scenius Unico where possible.  Revised Function ranges and macros in line with 01/2017 charts." Version="11" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised colour index ranges for full field adjustment." Version="12" />
  <History Date="08-04-17" Author="Nic Morris" Comment="Added continuous colour index function.  Fixed variable speed functions." Version="13" />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added product thumbnail" Version="14" />
  <History Date="15-01-18" Author="Nic Morris" Comment="Added gobo swatches.  Added channel counts to mode names." Version="15" />
  <History Date="18-01-18" Author="Nic Morris" Comment="Fixed missing gobo wheel 1 slot 5 shake function." Version="16" />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added RDM ID's (note no personality ID's but should be ok as all modes have unique channel counts)" Version="17" />
  <History Date="21-07-19" Author="Nic Morris" Comment="Created from Clay Paky Scenius Profile (poor documentation.  note gobos are missing slot numbers and fixed are just outlines but all look the same)" Version="18" />
  <History Date="22-07-19" Author="Nic Morris" Comment="Corrected model name from Sparkly 1400B to Sparkly 1400P" Version="19" />
  <History Date="23-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="20" />
  <History Date="24-07-19" Author="Nic Morris" Comment="Fixed colour conditions.  Revised colour ranges so they are fixed on the start value to agree with Capture in case they are indexable." Version="21" />
  <History Date="13-12-19" Author="Nic Morris" Comment="Created from Cyclops Sparkly 1400P (identical)" Version="22" />
  <History Date="14-12-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="23" />
  <History Date="23-06-22" Author="Nic Morris" Comment="Created from XMLite Exp470 (identical. possibly a rename but there are so many mistakes on the product page and website it is difficult to be certain)" Version="24" />
  <History Date="28-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="25" />
  <History Date="29-11-22" Author="Nic Morris" Comment="Created from XMLite Exp600 (identical.  gobo slot images missing numbers, fixed gobos are outlines only and lamp control is missing function ranges - left the same for now)" Version="26" />
  <History Date="07-12-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="27" />
  <History Date="19-03-24" Author="Nic Morris" Comment="Created from Space Lights 600W LED Profile (very poor documentation.  identical except colour function DMX values)" Version="28" />
  <History Date="23-03-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="29" />
  <History Date="24-03-24" Author="Nic Morris" Comment="Corrected split colour function DMX ranges." Version="30" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cd638136-7eec-4bfb-87d5-df100b9a126e" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="18~26" WheelPosition="1" Colour="175,0,0" />
      <Function ID="3" Name="Magenta" Display="'Magenta'" Dmx="36~44" WheelPosition="2" Colour="255,0,255" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="54~62" WheelPosition="3" Colour="255,150,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="72~80" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="90~98" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="108~109" WheelPosition="6" Colour="255,255,255" />
      <Function ID="8" Name="CRI" Display="'CRI'" Dmx="110~116" WheelPosition="7" Colour="255,255,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="9~17" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ Mag" Display="'D Rd/ Mag'" Dmx="27~35" WheelPosition="1" Colour="175,0,0" />
      <Function ID="11" Name="Mag/ Org" Display="'Mag/ Org'" Dmx="45~53" WheelPosition="2" Colour="255,0,255" />
      <Function ID="12" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="63~71" WheelPosition="3" Colour="255,150,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="81~89" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="99~107" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="CRI/ Op" Display="'CRI/ Op'" Dmx="117~127" WheelPosition="7" Colour="255,255,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="0~131" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="132~171" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="172~211" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="212~251" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Max" Display="'Max'" Dmx="252~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

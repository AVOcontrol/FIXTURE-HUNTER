<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Colourspot 1000" ShortName="CSpot1000" Company="Vello">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="15-05-07" Author="D.Milligan" Comment="Created" />
  <History Date="16-05-07" Author="D.Milligan" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Vello Lighting to Vello Professional Show Lighting" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed manufacturer from 'Vello Professional Show Lighting' to 'Vello'" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed physical type to moving head" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Standardised conditionals.  Fixed raw functions into else conditions.  Removed duplicate ID's from else." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed split functions to text only.  Added function index.  Increased wheel resolution." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Fixed locate values." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Inverted P/T Speed wheel direction." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Added palettes.  Added hilight/lolight." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="7" PowerOn="7" />
      <Function ID="1" Name="Max" Display="'Max'" Dmx="0~5" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Min" Display="'Min'" Dmx="6~10" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Min-Max-Min" Display="'o&lt;O&gt;o %.f%%',0~100" Dmx="11~51" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Min" Display="'Min'" Dmx="52~56" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Max" Display="'Max'" Dmx="57~67" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="68~250" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="251~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~39" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="48~55" WheelPosition="3" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~71" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="80~87" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~103" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="112~119" WheelPosition="7" Colour="255,0,255" />
      <Function ID="9" Name="Op/Re" Display="'Op/Re'" Dmx="7~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Re/Ye" Display="'Re/Ye'" Dmx="23~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Ye/Pu" Display="'Ye/Pu'" Dmx="39~48" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Pu/Gr" Display="'Pu/Gr'" Dmx="55~64" WheelPosition="3" Colour="128,0,255" />
      <Function ID="13" Name="Gr/Or" Display="'Gr/Or'" Dmx="71~80" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Or/Bl" Display="'Or/Bl'" Dmx="87~96" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Bl/Ma" Display="'Bl/Ma'" Dmx="103~112" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Ma/Op" Display="'Ma/Op'" Dmx="119~127" WheelPosition="7" Colour="255,0,255" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~20" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="85~115" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="116~243" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="21~52" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="53~84" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="VectMode" Name="Vector Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~5" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="6~45" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="46~85" />
      <Function ID="4" Name="Colour 1" Display="'Colour 1'" Dmx="86~125" />
      <Function ID="5" Name="Gobo" Display="'Gobo'" Dmx="126~165" />
      <Function ID="6" Name="Pan/Tilt" Display="'Pan/Tilt'" Dmx="166~205" />
      <Function ID="7" Name="All" Display="'All'" Dmx="206~245" />
      <Function ID="8" Name="Nil" Display="'Nil'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo2Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="13,14" If="'Gobo2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="21~42" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="58~78" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="95~115" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="132~152" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="169~184" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~20" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="G1/G2" Display="'G1/G2'" Dmx="42~58" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="G2/G3" Display="'G2/G3'" Dmx="78~95" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="G3/G4" Display="'G3/G4'" Dmx="115~132" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="G4/G5" Display="'G4/G5'" Dmx="152~169" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="G5/Op" Display="'G5/Op'" Dmx="184~200" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="201~205" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',0~100" Dmx="206~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo1Func'==1" />
      <Condition Name="Split" ID="6,7,8,9,10" If="'Gobo1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~47" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="48~73" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="100~125" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="152~177" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="204~229" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~47" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="G1/G2" Display="'G1/G2'" Dmx="73~100" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="G2/G3" Display="'G2/G3'" Dmx="125~152" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="G3/G4" Display="'G3/G4'" Dmx="177~204" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="G4/Op" Display="'G4/Op'" Dmx="229~255" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="132~21" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="133~143" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="144~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="6~55" Colour="0,0,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="56~105" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="106~155" Colour="255,255,0" />
      <Function ID="5" Name="Light Yellow" Display="'Yellow'" Dmx="156~205" Colour="255,255,128" />
      <Function ID="6" Name="Black" Display="'Black'" Dmx="206~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~125" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="126~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="132~21" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="133~143" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="144~255" />
    </Attribute>
    <Attribute ID="Gobo1Index" Name="Gobo 1 Index" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Indexing" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX, 16bit" Channels="18">
    <Import PearlRef="VE_ColS1000" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="16" Wheel="38" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="11" Wheel="17" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="12" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="13" Wheel="15" />
      <Attribute ID="Gobo1Index" ChannelOffset="14" Wheel="44" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="17" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="18" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="VectMode" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour2:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour2:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour2:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo2:1,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo2:2,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo2:3,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo2:4,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo2:5,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo2:6,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 1" Number="17" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="8" Name="Gobo 2" Number="18" Page="1" SetControl="Gobo1:3,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="9" Name="Gobo 3" Number="19" Page="1" SetControl="Gobo1:4,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="10" Name="Gobo 4" Number="20" Page="1" SetControl="Gobo1:5,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">

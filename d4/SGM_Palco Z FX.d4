      <Condition Name="Scroll" ID="106,107,108,109" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="110,111" If="'Colour1Func'==4" />
      <Else ID="112" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />

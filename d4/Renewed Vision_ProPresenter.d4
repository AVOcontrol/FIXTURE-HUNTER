      <Function ID="23" Name="Top R Zoom" Display="'Top R Zoom'" Dmx="22~22" />
      <Function ID="24" Name="Right Zoom" Display="'Right Zoom'" Dmx="23~23" />
      <Function ID="25" Name="Bottom R Zoom" Display="'Bottom R Zoom'" Dmx="24~24" />

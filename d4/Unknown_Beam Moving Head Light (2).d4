    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="100~105" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="200~205" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="210~215" />
      <Function ID="5" Name="Reset Small Motors" Display="'Reset Small Motors'" Dmx="220~235" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="245~250" />
    </Attribute>

      <Function ID="5" Name="Light Amber" Display="'Light Amber'" Dmx="19018~23387" Colour="239,155,73" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="23644~28013" Colour="255,245,0" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="28270~32639" Colour="252,252,182" />
      <Function ID="8" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.2f%%',0.00~100.00" Dmx="49858~65535" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Wash/Spot_Mode" Name="Wash/Spot Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Spot" Display="'Spot'" Dmx="0~0" />
      <Function ID="2" Name="Linear Mid Wash" Display="'Linear Mid Wash'" Dmx="6~130" />
      <Function ID="3" Name="Linear Light Wash" Display="'Linear Light Wash'" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">

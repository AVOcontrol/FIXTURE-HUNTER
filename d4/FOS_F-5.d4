      <Function ID="6" Name="4 Colours" Display="'4 Colours'" Dmx="180~215" />
      <Function ID="7" Name="8 Colours" Display="'8 Colours'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">

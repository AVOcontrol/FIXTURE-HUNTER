<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TecShow ION 610B RGBW" ShortName="ION 610B" Company="American Pro">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="19-03-14" Author="Nic Morris" Comment="Created" />
  <History Date="23-03-14" Author="Nic Morris" Comment="Added missing dmx ranges to shutter func." />
  <History Date="23-03-14" Author="Nic Morris" Comment="Created from Future Light WAVE" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="01-08-17" Author="Nic Morris" Comment="Created from Future Light Color Wave" />
  <History Date="04-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bea832bd-2475-4c36-83e9-3dc4acc56350" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Link" Display="'Link'" Dmx="32~47" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
      <Function ID="5" Name="Effect" Display="'Effect'" Dmx="64~95" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Update="Shutter" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Update="Shutter" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset no P/T" Display="'Reset no P/T'" Dmx="16~23" />
      <Function ID="4" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="5" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="6" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTO" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="7,8,9,10,11,12,13" If="'Colour1Func'==3||'Colour1Func'==6" />
      <Condition Name="Scroll" ID="14" If="'Colour1Func'==4||'Colour1Func'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CTO" Display="'%.fK',2000~2700" Dmx="0~223" Colour="255,240,200" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,240,200" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,240,200" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,240,200" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,240,200" />
      <Function ID="7" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~243" Colour="255,255,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="246~247" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="0,0,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="13" Name="All Colours" Display="'All Colours'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="14" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~243" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="246~247" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="0,0,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="7" Name="All Colours" Display="'All Colours'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~243" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="244~245" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="246~247" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="248~249" Colour="0,0,255" />
      <Function ID="6" Name="White" Display="'White'" Dmx="250~251" Colour="255,255,255" />
      <Function ID="7" Name="All Colours" Display="'All Colours'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
      <Function ID="6" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="32~47" />
      <Function ID="7" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="48~63" />
      <Function ID="8" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="96~111" />
      <Function ID="9" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="112~127" />
      <Function ID="10" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="160~175" />
      <Function ID="11" Name="Effect 6" Display="'Effect 6 %.f%%',0~100" Dmx="176~191" />
    </Attribute>
  </Control>

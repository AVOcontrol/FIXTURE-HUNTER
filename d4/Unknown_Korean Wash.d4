<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Korean Wash" ShortName="Korean Ws" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-03-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Thread_Mirror" Name="Thread Mirror" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CMY_Macro" Name="CMY Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CMY_Mac_Spd" Name="CMY Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="216~230" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="234~247" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="216~230" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="UKKRWS16" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="CMY_Macro" ChannelOffset="9" Wheel="22" />
      <Attribute ID="CMY_Mac_Spd" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Cyan" ChannelOffset="11" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="12" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="13" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="14" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="UKKRWS19" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Thread_Mirror" ChannelOffset="10" Wheel="26" />
      <Attribute ID="CMY_Macro" ChannelOffset="11" Wheel="22" />
      <Attribute ID="CMY_Mac_Spd" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Cyan" ChannelOffset="13" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="14" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="15" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="16" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="17" Wheel="20" />
      <Attribute ID="Lamp" ChannelOffset="18" Wheel="29" />
      <Attribute ID="Reset" ChannelOffset="19" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2,Lamp:2" Delay="6000" />
      <Set Channel="Control:1,Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:3,Reset:2" Delay="6000" />
      <Set Channel="Control:1,Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
</Fixture>
  <History Date="09-06-22" Author="Nic Morris" Comment="Created (guessed pixel layout)" Version="0" />
  <History Date="11-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="17-08-22" Author="Nic Morris" Comment="Added 12 channel mode (not detailed in digital manual or specifications)" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5d8d3f2a-0412-4d9d-97b8-a8317fe5e724" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="11~23" Update="Auto_Spd" />
      <Function ID="3" Name="WW Gradient Auto" Display="'WW Gradient Auto'" Dmx="24~46" Update="Auto_Spd" />
      <Function ID="4" Name="CW Gradient Auto" Display="'CW Gradient Auto'" Dmx="47~58" Update="Auto_Spd" />
      <Function ID="5" Name="CW WW Gradient Auto 1" Display="'CW WW Gradient Auto 1'" Dmx="59~70" Update="Auto_Spd" />
      <Function ID="6" Name="CW WW Gradient Auto 2" Display="'CW WW Gradient Auto 2'" Dmx="71~82" Update="Auto_Spd" />
      <Function ID="7" Name="CW Gradient Loop Auto" Display="'CW Gradient Loop Auto'" Dmx="83~95" Update="Auto_Spd" />
      <Function ID="8" Name="WW Gradient Loop Auto" Display="'WW Gradient Loop Auto'" Dmx="96~107" Update="Auto_Spd" />
      <Function ID="9" Name="CW Gradient Loop Auto (2)" Display="'CW Gradient Loop Auto (2)'" Dmx="108~119" Update="Auto_Spd" />
      <Function ID="10" Name="CW WW Gradient Loop Auto" Display="'CW WW Gradient Loop Auto'" Dmx="120~130" Update="Auto_Spd" />
      <Function ID="11" Name="CW WW Jump Loop Auto" Display="'CW WW Jump Loop Auto'" Dmx="131~165" Update="Auto_Spd" />
      <Function ID="12" Name="1# 2#COB CW WW Loop Auto" Display="'1# 2#COB CW WW Loop Auto'" Dmx="166~178" Update="Auto_Spd" />
      <Function ID="13" Name="COB CW WW Cross Jump" Display="'COB CW WW Cross Jump'" Dmx="179~191" Update="Auto_Spd" />
      <Function ID="14" Name="COB CW WW Up Down Jump" Display="'COB CW WW Up Down Jump'" Dmx="192~202" Update="Auto_Spd" />
      <Function ID="15" Name="COB CW WW L/R Jump" Display="'COB CW WW L/R Jump'" Dmx="203~214" Update="Auto_Spd" />
      <Function ID="16" Name="COB CW WW Mixing Jump" Display="'COB CW WW Mixing Jump'" Dmx="215~229" Update="Auto_Spd" />
      <Function ID="17" Name="COB CW WW Random Jump" Display="'COB CW WW Random Jump'" Dmx="230~238" Update="Auto_Spd" />
      <Function ID="18" Name="COB CW WW Random Gradient" Display="'COB CW WW Random Gradient'" Dmx="239~249" Update="Auto_Spd" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Colour" ID="2" If="'Auto'==2" />
      <Else ID="1" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CW-&gt;WW" Name="CW-&gt;WW" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CW-&gt;WW" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="91~100" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="101~110" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~120" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~130" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="131~140" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="141~150" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="151~160" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="161~170" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="171~180" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="181~190" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="191~200" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="201~210" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="211~220" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="221~230" Update="Red, Green, Blue, Red1, Green1, Blue1" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="231~255" Update="Red, Green, Blue, Red1, Green1, Blue1" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

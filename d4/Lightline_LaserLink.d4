<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LaserLink" ShortName="LaserLink" Company="Lightline" Version="7">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="09-06-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="10-06-20" Author="Nic Morris" Comment="Added gobo swatches." Version="3" />
  <History Date="10-06-20" Author="Nic Morris" Comment="Changed Gobo attribute ID to File and added a dummy Folder control so that the gobos display in a grid with text legend overlay toggle option in Media Selection of the Attribute Editor for Titan v12.0 and above." Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Safety" Name="Safety" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Disabled" Display="'Laser Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Laser Enabled" Display="'Laser Enabled'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Blanking" Name="Blanking" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Invert X" Display="'Invert X'" Dmx="0~0" />
      <Function ID="2" Name="Clipping at test border" Display="'Clipping at test border'" Dmx="1~1" />
      <Function ID="3" Name="Objects moving to max/min deflection fully faded" Display="'Objects moving to max/min deflection fully faded'" Dmx="2~2" />
      <Function ID="4" Name="Objects hitting max/min deflection partly faded" Display="'Objects hitting max/min deflection partly faded'" Dmx="3~3" />
      <Function ID="5" Name="Rotation Scheme" Display="'Rotation Scheme'" Dmx="4~4" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="96~127" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~159" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="160~192" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="193~223" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Orange" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Orange C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

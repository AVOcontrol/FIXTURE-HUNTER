  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>9d28498a-14e6-4508-a47f-5272f9827254</Thumbnail>
  <History Date="21-08-18" Author="Nic Morris" Comment="Created" />
  <History Date="24-08-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0b273c95-9ecb-401e-acd8-74b4f29c6413" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Macro" Name="Tilt Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="17~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="31~45" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="46~60" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="61~75" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="9" Name="GB" Display="'GB'" Dmx="136~150" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="151~165" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="166~180" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="181~195" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="196~210" Colour="255,255,255" />
      <Function ID="14" Name="RBW" Display="'RBW'" Dmx="211~225" Colour="255,255,255" />
      <Function ID="15" Name="GBW" Display="'GBW'" Dmx="226~240" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="P/T_Invert" Name="P/T Invert" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="L/R (4-6) Invert" Display="'L/R (4-6) Invert'" Dmx="64~127" />
      <Function ID="3" Name="Even/Odd (2/4/6) Invert)" Display="'Even/Odd (2/4/6) Invert)'" Dmx="128~191" />
      <Function ID="4" Name="Top-&gt;Bottom (2+5) Invert" Display="'Top-&gt;Bottom (2+5) Invert'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~22" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="23~37" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="38~52" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="53~67" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="68~82" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="83~97" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="98~112" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="113~127" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="128~142" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="143~157" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="158~172" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="173~187" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="188~202" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="203~217" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="218~232" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="233~247" Update="Auto_Spd" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==18||'Auto1'==18" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~21" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="22~33" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="34~45" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="46~57" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="58~69" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="70~81" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="82~93" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="94~105" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="106~117" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="118~129" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="130~141" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="142~153" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="154~165" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="166~177" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="178~189" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="190~201" Update="Auto_Spd" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="202~213" Update="Auto_Spd" />
      <Function ID="19" Name="Reset" Display="'Reset'" Dmx="245~249" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />

      <Function ID="2" Name="Auto FWD" Display="'Auto FWD %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Auto REV" Display="'Auto REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Roll" Name="X-Roll" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />

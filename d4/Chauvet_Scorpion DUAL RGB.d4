    </Attribute>
    <Attribute ID="Y-Roll" Name="Y-Roll" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto FWD" Display="'Auto FWD %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Auto REV" Display="'Auto REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Z-Roll" Name="Z-Roll" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />

      <Function ID="32" Name="Pattern 32" Display="'Pattern 32'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Multi-Col" Display="'Multi-Col'" Dmx="15~30" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="31~46" Update="Shutter" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="47~62" Update="Shutter" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="63~78" Update="Shutter" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="79~94" Update="Shutter" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="95~110" Update="Shutter" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="111~126" Update="Shutter" Colour="0,255,255" />
      <Function ID="9" Name="Red+Green" Display="'Red+Green'" Dmx="127~149" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Green+Blue" Display="'Green+Blue'" Dmx="150~174" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Red+Blue" Display="'Red+Blue'" Dmx="175~199" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="All Colours" Display="'All Colours'" Dmx="200~224" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="Multi-Col" Display="'Multi-Col'" Dmx="225~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour1'&gt;8" />
      <Else ID="1,2" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~169" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="170~209" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto FWD" Display="'Auto FWD %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Auto REV" Display="'Auto REV %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Function ID="21" Name="W+UV" Display="'W+UV'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="22" Name="A+UV" Display="'A+UV'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="23" Name="R+G+B" Display="'R+G+B'" Dmx="220~229" Colour="255,255,255" />

      <Function ID="25" Name="G+W+UV" Display="'G+W+UV'" Dmx="240~249" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
  </Control>

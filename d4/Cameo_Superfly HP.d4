  <Thumbnail>40ee3404-b7b5-4ff2-8e69-8435f8ba0fbb</Thumbnail>
  <History Date="22-08-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8fd41d3a-8677-47b1-8ec2-85f7b1021040" />
  <Control>
    <Attribute ID="Mode_Select" Name="Mode Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" Update="Mode_Option" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~255" Update="Mode_Option" />
    </Attribute>
    <Attribute ID="Mode_Option" Name="Mode Option" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Speed" ID="2" If="'Mode_Select'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="8~15" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="16~23" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="32~39" Colour="255,100,0" />
      <Function ID="6" Name="Red/ Green" Display="'Red/ Green'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="Red/ Blue" Display="'Red/ Blue'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="Red/ White" Display="'Red/ White'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="Red/ Amber" Display="'Red/ Amber'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="Green/ Blue" Display="'Green/ Blue'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="Green/ White" Display="'Green/ White'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="Green/ Amber" Display="'Green/ Amber'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="Blue/ White" Display="'Blue/ White'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="Blue/ Amber" Display="'Blue/ Amber'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="Red/ Green/ Blue" Display="'Red/ Green/ Blue'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="Red/ Green/ White" Display="'Red/ Green/ White'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="17" Name="Red/ Green/ Amber" Display="'Red/ Green/ Amber'" Dmx="128~135" Colour="255,255,255" />
      <Function ID="18" Name="Red/ Blue/ White" Display="'Red/ Blue/ White'" Dmx="136~143" Colour="255,255,255" />
      <Function ID="19" Name="Red/ Blue/ Amber" Display="'Red/ Blue/ Amber'" Dmx="144~151" Colour="255,255,255" />
      <Function ID="20" Name="Red/ White/ Amber" Display="'Red/ White/ Amber'" Dmx="152~159" Colour="255,255,255" />
      <Function ID="21" Name="Blue/ White/ Amber" Display="'Blue/ White/ Amber'" Dmx="160~167" Colour="255,255,255" />
      <Function ID="22" Name="Green/ Blue/ White" Display="'Green/ Blue/ White'" Dmx="168~175" Colour="255,255,255" />
      <Function ID="23" Name="Green/ Blue/ Amber" Display="'Green/ Blue/ Amber'" Dmx="176~183" Colour="255,255,255" />
      <Function ID="24" Name="Green/ White/ Amber" Display="'Green/ White/ Amber'" Dmx="184~191" Colour="255,255,255" />
      <Function ID="25" Name="Red/ Green/ Blue/ White" Display="'Red/ Green/ Blue/ White'" Dmx="192~199" Colour="255,255,255" />
      <Function ID="26" Name="Red/ Blue/ White/ Amber" Display="'Red/ Blue/ White/ Amber'" Dmx="200~207" Colour="255,255,255" />
      <Function ID="27" Name="Red/ Green/ White/ Amber" Display="'Red/ Green/ White/ Amber'" Dmx="208~215" Colour="255,255,255" />
      <Function ID="28" Name="Red/ Green/ Blue/ Amber" Display="'Red/ Green/ Blue/ Amber'" Dmx="216~223" Colour="255,255,255" />
      <Function ID="29" Name="Green/ Blue/ White/ Amber" Display="'Green/ Blue/ White/ Amber'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="30" Name="Red/ Green/ Blue/ White/ Amber" Display="'Red/ Green/ Blue/ White/ Amber'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="31" Name="Auto" Display="'Auto'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fea7489e-7a12-47a0-9f48-2404e094d6be" />
    <Include>
      <Attribute ID="Mode_Select" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Mode_Option" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="02d1d046-635c-4b5f-8bb6-f13233f6568b" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Colour_Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="40ee3404-b7b5-4ff2-8e69-8435f8ba0fbb"></Swatch>
  </swatchLibrary>
</Fixture>
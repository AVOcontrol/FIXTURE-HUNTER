  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode_Select" Name="Mode Select" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~15" />
      <Function ID="2" Name="Dimmer Mode 1" Display="'Dimmer Mode 1'" Dmx="16~49" />
      <Function ID="3" Name="Dimmer Mode 2" Display="'Dimmer Mode 2'" Dmx="50~99" />
      <Function ID="4" Name="Dimmer Mode 3" Display="'Dimmer Mode 3'" Dmx="100~149" />
      <Function ID="5" Name="Dimmer Mode 4" Display="'Dimmer Mode 4'" Dmx="150~199" />
      <Function ID="6" Name="Sound Mode" Display="'Sound Mode'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Program 1" Display="'Program 1'" Dmx="0~22" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="23~45" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="46~68" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="69~91" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="92~114" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="115~137" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="138~160" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="161~183" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="184~206" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="207~229" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="230~252" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',1.0~20.0" Dmx="16~200" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'%.f%%',0~100" Dmx="201~230" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="231~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>

  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16" If="'Colour1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="19~27" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="CTO 3200K" Display="'CTO 3200K'" Dmx="37~45" WheelPosition="2" Colour="255,240,200" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="55~63" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Aquamarine" Display="'Aquamarine'" Dmx="74~82" WheelPosition="4" Colour="128,255,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="92~100" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="110~118" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="10~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Rd/ CTO" Display="'Rd/ CTO'" Dmx="28~36" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="CTO/ Grn" Display="'CTO/ Grn'" Dmx="46~54" WheelPosition="2" Colour="255,240,200" />
      <Function ID="11" Name="Grn/ Aq" Display="'Grn/ Aq'" Dmx="64~73" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="Aq/ Org" Display="'Aq/ Org'" Dmx="83~91" WheelPosition="4" Colour="128,255,255" />
      <Function ID="13" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="101~109" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="119~127" WheelPosition="6" Colour="0,0,255" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">

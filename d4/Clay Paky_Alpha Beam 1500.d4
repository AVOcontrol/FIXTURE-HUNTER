<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Beam 1500" ShortName="Alpha B15k" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ccbaefd7-f493-49d5-b147-53c78927ff2b</Thumbnail>
  <History Date="17-10-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="11-11-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="22-04-09" Author="David Hunt" Comment="Added functions to modes" />
  <History Date="05-06-09" Author="Jonathan Moreton" Comment="Added function channel updated gobo channels" />
  <History Date="04-11-09" Author="John Rogers" Comment="Increased macro wait times for all control channels to 6 seconds." />
  <History Date="09-11-09" Author="John Rogers" Comment="Changed Lamp Off macro to fall in line with Clay Paky documentation. The Alpha Beam 300 has an identical control channel." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-06-12" Author="Peter Budd" Comment="Edited changed standard name from 23 to 24 DMX" />
  <History Date="28-08-15" Author="Nic Morris" Comment="Renamed vector mode from 27 to 28 DMX in response to customer bug report" />
  <History Date="29-08-15" Author="Nic Morris" Comment="Merged Gregory's 16bit Pan Tilt function name edits for conformity." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-05-17" Author="Nic Morris" Comment="Changed Atlabase ID's to CMY versions.  Revised mode names to reflect settings more clearly." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Moved split colours into separate condition.  Added function index." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised shutter.  Standardised conditionals.  Revised prism." />
  <History Date="29-05-17" Author="Nic Morris" Comment="Fixed lamp on (half) macro (was referencing lamp off).  Revised speed controls.  Recreated palettes." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added RDM ID's.  Added product thumbnail." />
  <History Date="06-03-19" Author="Nic Morris" Comment="Added gobo swatches" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="64" />
  </RDM>

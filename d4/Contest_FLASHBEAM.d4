      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~243" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto RGB" Display="'Auto RGB'" Dmx="10~72" />
      <Function ID="3" Name="Auto White" Display="'Auto White'" Dmx="73~132" />
      <Function ID="4" Name="Auto RGB+White" Display="'Auto RGB+White'" Dmx="133~195" />

  <History Date="07-09-22" Author="Nic Morris" Comment="Changed RGB colour functions so that they have adjustable level." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a8d2b919-f36b-40d3-ab3c-bccc84b71632" />
  <Control>
    <Attribute ID="RGB_Colour" Name="RGB Colour" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~85" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="86~170" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="171~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="164~243" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="10~83" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="84~163" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="White_Shutter" Name="White Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="White_All" Name="White Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_Macro" Name="RGB Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />

    </Attribute>
    <Attribute ID="RGB_Mac_Spd" Name="RGB Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~243" />

      <Function ID="12" Name="Gas Fire" Display="'Gas Fire'" Dmx="140~159" />
      <Function ID="13" Name="Preset Custom" Display="'Preset Custom'" Dmx="0~0" />
      <Function ID="14" Name="Preset Blue Slow" Display="'Preset Blue Slow'" Dmx="10~19" />
      <Function ID="15" Name="Preset Blue Fast" Display="'Preset Blue Fast'" Dmx="20~29" />
      <Function ID="16" Name="Preset Blue Double" Display="'Preset Blue Double'" Dmx="30~39" />

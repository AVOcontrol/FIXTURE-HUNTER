      <Function ID="24" Name="Preset Red Warning" Display="'Preset Red Warning'" Dmx="110~119" />
      <Function ID="25" Name="Preset Amber Ping" Display="'Preset Amber Ping'" Dmx="120~129" />
      <Function ID="26" Name="Preset Magenta Burst" Display="'Preset Magenta Burst'" Dmx="130~139" />
      <Function ID="27" Name="Palette Primary 6" Display="'Palette Primary 6'" Dmx="0~0" />
      <Function ID="28" Name="Palette Primary 12" Display="'Palette Primary 12'" Dmx="20~39" />
      <Function ID="29" Name="Palette Primary 24" Display="'Palette Primary 24'" Dmx="40~59" />
      <Function ID="30" Name="Palette Warm" Display="'Palette Warm'" Dmx="60~79" />

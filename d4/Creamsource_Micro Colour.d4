      <Condition Name="Television" ID="31" If="'Effect'==10" />
      <Condition Name="Paparazzi" ID="32,33" If="'Effect'==11" />
      <Condition Name="Party" ID="34,35,36" If="'Effect'==12" />
      <Else ID="37" />
      <Function ID="1" Name="Sync" Display="'Sync %.1f%%',0.0~100.0" Dmx="0~255" />

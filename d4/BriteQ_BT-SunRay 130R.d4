  <History Date="15-01-22" Author="Nic Morris" Comment="Created (note BLIND 16bit charts have two controls assigned to the same channel.  made best guess)" Version="0" />
  <History Date="21-01-22" Author="Nic Morris" Comment="Added missing Atlabase ID's for BLIND s and DTW modes." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="223ac9a7-3eda-4b95-bfa7-1966a5a6579f" />
  <Control>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="132~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="8~126" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red Shift On" Display="'Red Shift On'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="6~10" />
      <Function ID="3" Name="Dim Spd" Display="'Dim Spd %.f%%',0~100" Dmx="27~127" />
      <Function ID="4" Name="Fan Silent" Display="'Fan Silent'" Dmx="152~157" />
      <Function ID="5" Name="Fan Auto" Display="'Fan Auto'" Dmx="158~161" />
      <Function ID="6" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~173" />
      <Function ID="7" Name="Dim Square" Display="'Dim Square'" Dmx="174~179" />
      <Function ID="8" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="180~185" />
      <Function ID="9" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="186~191" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red Shift On" Display="'Red Shift On'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="6~10" />
      <Function ID="3" Name="Fan Silent" Display="'Fan Silent'" Dmx="152~157" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="158~161" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~173" />
      <Function ID="6" Name="Dim Square" Display="'Dim Square'" Dmx="174~179" />
      <Function ID="7" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="180~185" />
      <Function ID="8" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="186~191" />
    </Attribute>
  </Control>
  <Mode Name="BLIND (8bit), 4 DMX" Channels="4">

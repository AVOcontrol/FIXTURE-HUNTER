  <Macro>
    <Macro Name="Fan Silent">
      <Set Channel="Control:4,Control1:3" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control:5,Control1:4" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control:6,Control1:5" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Square">
      <Set Channel="Control:7,Control1:6" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Inv Square">
      <Set Channel="Control:8,Control1:7" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Dim S-Curve">
      <Set Channel="Control:9,Control1:8" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
  </Macro>

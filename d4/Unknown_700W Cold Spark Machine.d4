  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Preheat" Name="Preheat" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Preheat Off" Display="'Preheat Off'" Dmx="0~0" />
      <Function ID="2" Name="Preheat On" Display="'Preheat On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Spark" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Spray" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Remove Preheat Consumables" Display="'Remove Preheat Consumables'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3" Id="f02227ae-d02e-436b-b248-7a6a5ed3aaed">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Preheat" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Control" ChannelOffset="3" Wheel="29" />
    </Include>
  </Mode>
</Fixture>
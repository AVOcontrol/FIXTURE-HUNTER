      <Function ID="12" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="60~67" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Blu/ H Pk" Display="'Blu/ H Pk'" Dmx="77~84" WheelPosition="4" Colour="0,0,255" />
      <Function ID="14" Name="H Pk/ Ppl" Display="'H Pk/ Ppl'" Dmx="94~101" WheelPosition="5" Colour="255,150,150" />
      <Function ID="15" Name="Ppl/ Yel" Display="'Ppl/ Yel'" Dmx="111~118" WheelPosition="6" Colour="128,0,255" />

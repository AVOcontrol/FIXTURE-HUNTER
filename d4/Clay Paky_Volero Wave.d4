      <Condition Name="Dynamic" ID="2,3,4" If="'Pattern_Mode'==3" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~124" />

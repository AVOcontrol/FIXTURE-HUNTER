  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Tilt Spd Mode Smooth">
      <Set Channel="Function:2,Function1:2" Delay="4000" />
      <Set Channel="Function:1,Function1:1" Delay="0" />
    </Macro>
    <Macro Name="Tilt Spd Mode Fast">
      <Set Channel="Function:3,Function1:3" Delay="4000" />
      <Set Channel="Function:1,Function1:1" Delay="0" />
    </Macro>
    <Macro Name="CTO Mode Cal White">
      <Set Channel="Function:4,Function1:4" Delay="4000" />
      <Set Channel="Function:1,Function1:1" Delay="0" />
    </Macro>
    <Macro Name="CTO Mode Raw">
      <Set Channel="Function:5,Function1:5" Delay="4000" />
      <Set Channel="Function:1,Function1:1" Delay="0" />
    </Macro>
    <Macro Name="Head Index Swap Off">
      <Set Channel="Function:6" Delay="4000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Head Index Swap On">
      <Set Channel="Function:7" Delay="4000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reverse Mapping Off">
      <Set Channel="Function1:6" Delay="4000" />
      <Set Channel="Function1:1" Delay="0" />
    </Macro>
    <Macro Name="Reverse Mapping On">
      <Set Channel="Function1:7" Delay="4000" />
      <Set Channel="Function1:1" Delay="0" />
    </Macro>
    <Macro Name="Reverse Heads Off">
      <Set Channel="Function1:15" Delay="4000" />
      <Set Channel="Function1:1" Delay="0" />
    </Macro>
    <Macro Name="Reverse Heads On">
      <Set Channel="Function1:16" Delay="4000" />
      <Set Channel="Function1:1" Delay="0" />
    </Macro>

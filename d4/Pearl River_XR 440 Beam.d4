      <Function ID="19" Name="Gobo 18" Display="'Gobo 18'" Dmx="122~127" WheelPosition="18" />
      <Function ID="20" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="21" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="166~170" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />

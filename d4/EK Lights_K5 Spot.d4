      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="115~120" WheelPosition="9" Colour="0,0,0" />
      <Function ID="11" Name="Op/ 1" Display="'Op/ 1'" Dmx="7~12" WheelPosition="0" Colour="255,255,255" />
      <Function ID="12" Name="1/ 2" Display="'1/ 2'" Dmx="20~25" WheelPosition="1" Colour="0,0,0" />
      <Function ID="13" Name="2/ 3" Display="'2/ 3'" Dmx="32~38" WheelPosition="2" Colour="0,0,0" />
      <Function ID="14" Name="3/ 4" Display="'3/ 4'" Dmx="45~50" WheelPosition="3" Colour="0,0,0" />
      <Function ID="15" Name="4/ 5" Display="'4/ 5'" Dmx="58~63" WheelPosition="4" Colour="0,0,0" />
      <Function ID="16" Name="5/ 6" Display="'5/ 6'" Dmx="70~76" WheelPosition="5" Colour="0,0,0" />

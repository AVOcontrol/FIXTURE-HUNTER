    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full" Display="'Full'" Dmx="0~0" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="17~31" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',25.0~200.0" Dmx="33~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

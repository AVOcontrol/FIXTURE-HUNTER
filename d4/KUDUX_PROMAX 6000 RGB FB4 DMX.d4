  <Thumbnail>741ed9aa-3f14-4bea-be1b-aa0fa8b50f8e</Thumbnail>
  <History Date="07-02-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="08-06-17" Author="Peter Budd" Comment="Made the locate values output some light." Version="2" />
  <History Date="08-06-17" Author="Peter Budd" Comment="Created from Pangolin Laser Systems Flashback 3 SE" Version="3" />
  <History Date="08-10-18" Author="Nic Morris" Comment="Created from Pangolin Laser Systems Flashback 4 SE" Version="4" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Max Width and Max Height to default at 50% (49151) in response to manufacture request." Version="5" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Cue Speed to default at DMX 100 in response to manufacturer request." Version="6" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Fixed cue display ranges (were variable value 1-48, chaned to fixed text only)" Version="7" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed scan rate (1) to default at 15 (DMX 102) in response to manufacturer request (might need to change display type to achieve DMX 100)." Version="8" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Revised Z-Rot Spd functions in response to manufacturer request." Version="9" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Points End to default at DMX 255 in response to manufacturer request." Version="10" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Added Alpha control at DMX 255 to all colour palettes in response to manufacturer request." Version="11" />
  <History Date="27-01-23" Author="Nic Morris" Comment="Created from Pangolin Laser Systems FB4 (identical - it is simply a Pangolin FB4 interface card)" Version="12" />
  <Manual Filename="" Summary="" />

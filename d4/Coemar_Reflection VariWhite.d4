<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Reflection VariWhite" ShortName="Rflct VarW" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-11-10" Author="John Rogers" Comment="Created" />
  <History Date="26-11-10" Author="John Rogers" Comment="Added VariWhite mode and Reset Macro." />
  <History Date="20-02-11" Author="Nic Morris" Comment="Removed extra shutter open.  Renamed Random Col strobe." />
  <History Date="20-02-11" Author="Nic Morris" Comment="Fixed highlight and power on.  Fixed missing dimmer in 5 DMX mode." />
  <History Date="20-02-11" Author="Nic Morris" Comment="Removed duplicate macro.  Removed macro return percentage." />
  <History Date="20-02-11" Author="Nic Morris" Comment="Revised control frequency to explicit values." />
  <History Date="20-02-11" Author="Nic Morris" Comment="Revised CTO ranges.  Revised Tone ranges" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-02-17" Author="Nic Morris" Comment="Split from Coemar Reflection" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bcd4d80a-242b-43eb-93ad-0d36a3700592" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="111~159" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="162~207" Intensity="0~0" />
      <Function ID="6" Name="Rnd Col Strb" Display="'Rnd Col Strb %.f%%',0~100" Dmx="210~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="10~40" />
      <Function ID="3" Name="CMY" Display="'CMY'" Dmx="41~71" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="72~102" />
      <Function ID="5" Name="Safe" Display="'Safe'" Dmx="103~133" />
      <Function ID="6" Name="LCD Off" Display="'LCD Off'" Dmx="134~185" />
      <Function ID="7" Name="LCD On" Display="'LCD On'" Dmx="186~199" />
      <Function ID="8" Name="1000 Hz" Display="'1000 Hz'" Dmx="200~205" />
      <Function ID="9" Name="1500 Hz" Display="'1500 Hz'" Dmx="206~211" />
      <Function ID="10" Name="2000 Hz" Display="'2000 Hz'" Dmx="212~217" />
      <Function ID="11" Name="2500 Hz" Display="'2500 Hz'" Dmx="218~223" />
      <Function ID="12" Name="3000 Hz" Display="'3000 Hz'" Dmx="224~229" />
      <Function ID="13" Name="3500 Hz" Display="'3500 Hz'" Dmx="230~235" />
      <Function ID="14" Name="4000 Hz" Display="'4000 Hz'" Dmx="236~241" />
      <Function ID="15" Name="4500 Hz" Display="'4500 Hz'" Dmx="242~247" />
      <Function ID="16" Name="5000 Hz" Display="'5000 Hz'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="9000 K" Display="'9000 K'" Dmx="10~19" Colour="0,0,0" />
      <Function ID="3" Name="8500 K" Display="'8500 K'" Dmx="20~29" Colour="0,0,0" />
      <Function ID="4" Name="8000 K" Display="'8000 K'" Dmx="30~39" Colour="0,0,0" />
      <Function ID="5" Name="7500 K" Display="'7500 K'" Dmx="40~49" Colour="0,0,0" />
      <Function ID="6" Name="7000 K" Display="'7000 K'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="6500 K" Display="'6500 K'" Dmx="60~69" Colour="0,0,0" />
      <Function ID="8" Name="6000 K" Display="'6000 K'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="9" Name="5500 K" Display="'5500 K'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="10" Name="5000 K" Display="'5000 K'" Dmx="90~99" Colour="0,0,0" />
      <Function ID="11" Name="4500 K" Display="'4500 K'" Dmx="100~109" Colour="0,0,0" />
      <Function ID="12" Name="4000 K" Display="'4000 K'" Dmx="110~119" Colour="0,0,0" />
      <Function ID="13" Name="3200 K" Display="'3200 K'" Dmx="120~128" Colour="0,0,0" />
      <Function ID="14" Name="Proportional" Display="'Proportional %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="CM_RefVrWh5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="41805e73-1ae0-4a79-83a2-108b87f75fe5" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:4:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~154" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="155~204" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="205~255" />
    </Attribute>
    <Attribute ID="Laser_Dimmer" Name="Laser Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="5~50" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="51~255" />
    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~149" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="150~199" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="240~250" />
    </Attribute>
  </Control>

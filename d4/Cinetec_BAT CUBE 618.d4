    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Choose" Display="'Col Choose'" Dmx="10~29" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="30~49" />
      <Function ID="4" Name="Slow Col Change" Display="'Slow Col Change'" Dmx="50~69" />
      <Function ID="5" Name="Fast Col Change" Display="'Fast Col Change'" Dmx="70~89" />
      <Function ID="6" Name="Red+White Strobe" Display="'Red+White Strobe'" Dmx="90~109" />
      <Function ID="7" Name="Green+White Strobe" Display="'Green+White Strobe'" Dmx="110~129" />
      <Function ID="8" Name="Blue+White Strobe" Display="'Blue+White Strobe'" Dmx="130~149" />
      <Function ID="9" Name="Amber+White Strobe" Display="'Amber+White Strobe'" Dmx="150~169" />
      <Function ID="10" Name="UV+White Strobe" Display="'UV+White Strobe'" Dmx="170~189" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="190~209" />
      <Function ID="12" Name="Sound Col" Display="'Sound Col'" Dmx="210~229" />
      <Function ID="13" Name="Sound Action" Display="'Sound Action'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

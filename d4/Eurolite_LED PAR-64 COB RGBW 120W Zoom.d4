    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Variable" Display="'Variable %.f%%',0~100" Dmx="6~85" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="86~165" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="166~245" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~17" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="18~29" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="30~41" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="42~53" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="54~65" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="66~77" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="78~89" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="90~101" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="102~113" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="114~125" Colour="180,0,180" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="126~137" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="138~149" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="150~161" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="162~173" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="174~185" Colour="230,230,255" />
      <Function ID="17" Name="Change" Display="'Change %.f%%',0~100" Dmx="186~220" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Change" Display="'Change'" Dmx="16~95" />
      <Function ID="3" Name="Strobe" Display="'Strobe'" Dmx="96~175" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

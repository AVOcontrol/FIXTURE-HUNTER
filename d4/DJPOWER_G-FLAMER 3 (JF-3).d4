      <Function ID="2" Name="On" Display="'On'" Dmx="50~200" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="4265fa01-f8d4-40ab-bbf2-5d2f3aa53fdf">

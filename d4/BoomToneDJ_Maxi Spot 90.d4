        <AttributeLink SourceId="Gobo1" TargetId="Gobo1" />
        <AttributeLink SourceId="Prism" TargetId="Prism" />
      </Cell>
      <Cell ID="Cell2" Name="Wash" ChannelOffset="11" ModeLink="Wash cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Wash_Shutter" TargetId="Wash_Shutter" />
        <AttributeLink SourceId="Wash_Col" TargetId="Wash_Col" />
        <AttributeLink SourceId="Wash_Effect" TargetId="Wash_Effect" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Beam cell" Channels="5" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Beam_Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Beam_Col_Func" Wheel="7" />
      <Attribute ID="Beam_Colour" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="Wash cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Wash_Shutter" ChannelOffset="2" Wheel="6" />
      <Attribute ID="Wash_Col" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Wash_Effect" ChannelOffset="4" Wheel="23" />
    </Include>

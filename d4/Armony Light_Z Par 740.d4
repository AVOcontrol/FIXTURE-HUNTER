      <Function ID="2" Name="Jump (no Motor)" Display="'Jump (no Motor)'" Dmx="6~40" />
      <Function ID="3" Name="Gradual (no Motor)" Display="'Gradual (no Motor)'" Dmx="41~80" />
      <Function ID="4" Name="Pulse (no Motor)" Display="'Pulse (no Motor)'" Dmx="81~120" />
      <Function ID="5" Name="Jump (w/ Motor)" Display="'Jump (w/ Motor)'" Dmx="121~160" />
      <Function ID="6" Name="Gradient (w/ Motor)" Display="'Gradient (w/ Motor)'" Dmx="161~200" />
      <Function ID="7" Name="Pulse (w/ Motor)" Display="'Pulse (w/ Motor)'" Dmx="201~240" />
      <Function ID="8" Name="Sound (w/ Motor)" Display="'Sound (w/ Motor)'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

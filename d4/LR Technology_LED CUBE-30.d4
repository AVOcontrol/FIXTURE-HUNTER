<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED CUBE-30" ShortName="LED CUBE30" Company="LR Technology">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="26-09-15" Author="Nic Morris" Comment="Created" />
  <History Date="18-11-15" Author="Nic Morris" Comment="Created from Lumin Lights Cubix" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~30" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="31~140" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="141~145" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="146~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Max" Display="'Max'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~95" Intensity="0~0" />
      <Function ID="3" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="96~169" Intensity="0~0" />
      <Function ID="4" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="170~175" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="176~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="16~63" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="64~111" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="112~159" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="160~207" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~45" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="46~65" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="66~85" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="86~105" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="106~125" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="126~145" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="146~165" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="166~185" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="186~205" Colour="255,255,255" />
      <Function ID="10" Name="RGB Change" Display="'RGB Change'" Dmx="206~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~30" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="31~49" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="50~255" />
    </Attribute>

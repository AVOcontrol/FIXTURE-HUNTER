  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="768a12a2-972e-4ce8-8c32-375bb4f0e785" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="127~131" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~127" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="On CW" Display="'On CW'" Dmx="8~23" />
      <Function ID="3" Name="On CCW" Display="'On CCW'" Dmx="24~39" />
      <Function ID="4" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="40~43" />
      <Function ID="5" Name="Off CCW" Display="'Off CCW'" Dmx="44~55" />
      <Function ID="6" Name="Thunder" Display="'Thunder'" Dmx="56~59" />
      <Function ID="7" Name="Off CW" Display="'Off CW'" Dmx="60~71" />
      <Function ID="8" Name="Alternate" Display="'Alternate'" Dmx="72~103" />
      <Function ID="9" Name="Move CCW" Display="'Move CCW'" Dmx="104~127" />
      <Function ID="10" Name="Auto CW" Display="'Auto CW'" Dmx="128~143" />
      <Function ID="11" Name="Auto CCW" Display="'Auto CCW'" Dmx="144~159" />
      <Function ID="12" Name="Auto CW" Display="'Auto CW'" Dmx="160~175" />
      <Function ID="13" Name="Auto CCW" Display="'Auto CCW'" Dmx="176~191" />
      <Function ID="14" Name="2x2 CW" Display="'2x2 CW'" Dmx="192~207" />
      <Function ID="15" Name="2x2 CCW" Display="'2x2 CCW'" Dmx="208~223" />
      <Function ID="16" Name="3x3 CW" Display="'3x3 CW'" Dmx="224~239" />
      <Function ID="17" Name="3x3 CCW" Display="'3x3 CCW'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

      <Function ID="14" Name="Fern Green" Display="'Fern Green'" Dmx="77~82" />
      <Function ID="15" Name="Moss Green" Display="'Moss Green'" Dmx="83~88" />
      <Function ID="16" Name="Primary Green" Display="'Primary Green'" Dmx="89~94" />
      <Function ID="17" Name="Dark Green" Display="'Dark Green'" Dmx="95~100" />
      <Function ID="18" Name="Green" Display="'Green'" Dmx="101~106" />
      <Function ID="19" Name="Medium Blue Green" Display="'Medium Blue Green'" Dmx="107~112" />
      <Function ID="20" Name="Light Blue" Display="'Light Blue'" Dmx="113~118" />
      <Function ID="21" Name="Lighter Blue" Display="'Lighter Blue'" Dmx="119~124" />
      <Function ID="22" Name="Steel Blue" Display="'Steel Blue'" Dmx="125~130" />
      <Function ID="23" Name="Half CTB" Display="'Half CTB'" Dmx="131~136" />
      <Function ID="24" Name="Full CTB" Display="'Full CTB'" Dmx="137~142" />
      <Function ID="25" Name="Slate Blue" Display="'Slate Blue'" Dmx="143~148" />
      <Function ID="26" Name="Double CTB" Display="'Double CTB'" Dmx="149~154" />
      <Function ID="27" Name="Medium Blue" Display="'Medium Blue'" Dmx="155~160" />
      <Function ID="28" Name="Just Blue" Display="'Just Blue'" Dmx="161~166" />

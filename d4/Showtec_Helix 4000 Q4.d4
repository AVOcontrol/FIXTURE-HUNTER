      <Function ID="30" Name="Blue" Display="'Blue'" Dmx="173~178" />
      <Function ID="31" Name="Congo Blue" Display="'Congo Blue'" Dmx="179~184" />
      <Function ID="32" Name="Suprise Pink" Display="'Suprise Pink'" Dmx="185~190" />
      <Function ID="33" Name="Fuchsia Pink" Display="'Fuchsia Pink'" Dmx="191~196" />
      <Function ID="34" Name="Follies Pink" Display="'Follies Pink'" Dmx="197~202" />
      <Function ID="35" Name="Special Rose Pink" Display="'Special Rose Pink'" Dmx="203~208" />
      <Function ID="36" Name="Pink" Display="'Pink'" Dmx="209~214" />
      <Function ID="37" Name="Moroccan Pink" Display="'Moroccan Pink'" Dmx="215~220" />
      <Function ID="38" Name="Warm White" Display="'Warm White'" Dmx="221~226" />
      <Function ID="39" Name="Cold White" Display="'Cold White'" Dmx="227~232" />
      <Function ID="40" Name="Open White" Display="'Open White'" Dmx="233~255" />
      <Function ID="41" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SHH4KQ44" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

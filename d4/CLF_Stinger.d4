    <Attribute ID="RGBW_FX_Mode" Name="RGBW FX Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="RGBW_FX" />
      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="15~47" Update="RGBW_FX" />
      <Function ID="3" Name="Effect" Display="'Effect'" Dmx="48~95" Update="RGBW_FX" />
      <Function ID="4" Name="Number 1-9" Display="'Number 1-9'" Dmx="96~135" Update="RGBW_FX" />
      <Function ID="5" Name="Letter A-Z" Display="'Letter A-Z'" Dmx="136~175" Update="RGBW_FX" />

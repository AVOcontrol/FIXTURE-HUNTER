<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-W12L10 Wash" ShortName="BT-W12L10W" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="25-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="14-01-13" Author="Peter Budd" Comment="Corrected P/T Macro ranges." />
  <History Date="14-01-13" Author="Peter Budd" Comment="Created from Prolight Elumen8 Kudos 120" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Inverted P/T speed and P/T macro speed wheel directions." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Changed locate and power on function ranges to 0-0 where applicable in attempt to fix customer bug report." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Fixed stand alone function range in control.  Added raw range to colour macro just in case." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Fixed incorrect shutter and control channel mappings in 12 and 16ch modes." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Removed closed function and set open to 255-255 range in 9 and 28ch modes in attempt to fix customer bug report." />
  <History Date="07-06-14" Author="Nic Morris" Comment="Added 1 MSL and 4 MSL modes.  Updated macros." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

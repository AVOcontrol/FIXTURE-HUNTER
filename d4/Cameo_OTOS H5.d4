      <Function ID="20" Name="8 - Flat" Display="'8 - Flat %.f%%',0~100" Dmx="118~130" WheelPosition="9" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="22" Name="Flat" Display="'Flat'" Dmx="131~150" WheelPosition="1" />
      <Function ID="23" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="151~154" WheelPosition="2" />
      <Function ID="24" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="155~158" WheelPosition="3" />
      <Function ID="25" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="159~162" WheelPosition="4" />
      <Function ID="26" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="163~166" WheelPosition="5" />
      <Function ID="27" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="167~170" WheelPosition="6" />
      <Function ID="28" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="171~174" WheelPosition="7" />
      <Function ID="29" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="175~178" WheelPosition="8" />
      <Function ID="30" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="179~182" WheelPosition="9" />
      <Function ID="31" Name="Flat" Display="'Flat'" Dmx="183~186" WheelPosition="1" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="187~223" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5||'Gobo1Func'==7||'Gobo1Func1'==1||'Gobo1Func1'==3||'Gobo1Func1'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6||'Gobo1Func'==8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32896" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="33153~49087" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">

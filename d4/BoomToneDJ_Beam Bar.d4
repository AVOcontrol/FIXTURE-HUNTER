<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Beam Bar" ShortName="Beam Bar" Company="BoomToneDJ" Version="4">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>2307345f-30f6-43b3-8a36-ecca8fef6ac3</Thumbnail>
  <History Date="18-08-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="25-09-23" Author="Nic Morris" Comment="Created from Prolight Equinox PIXELpoint Batten (identical.  note menu suggests 25,60 and 61 channel modes but not detailed in charts.  assumed the same and left for now)" Version="1" />
  <History Date="27-09-23" Author="Nic Morris" Comment="Added Atlabase ID's (note 25, 60 and 61 channels not currently supported as they are not detailed in the charts)" Version="2" />
  <History Date="01-07-24" Author="Nic Morris" Comment="Created from Flash Butrym PIXEL BAR 40x3W RGB (F7200220) (effectively identical)" Version="3" />
  <History Date="04-07-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ffef242c-d1c6-45a0-96e7-b3cad9e005b4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Static Colours" Display="'Static Colours'" Dmx="10~19" Update="Effect_Spd" />
      <Function ID="3" Name="Breathing" Display="'Breathing'" Dmx="20~29" Update="Effect_Spd" />
      <Function ID="4" Name="Jump" Display="'Jump'" Dmx="30~39" Update="Effect_Spd" />
      <Function ID="5" Name="Gradient" Display="'Gradient'" Dmx="40~49" Update="Effect_Spd" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="50~59" Update="Effect_Spd" />
      <Function ID="7" Name="Effect 1" Display="'Effect 1'" Dmx="60~69" Update="Effect_Spd" />
      <Function ID="8" Name="Effect 2" Display="'Effect 2'" Dmx="70~79" Update="Effect_Spd" />
      <Function ID="9" Name="Effect 3" Display="'Effect 3'" Dmx="80~89" Update="Effect_Spd" />
      <Function ID="10" Name="Effect 4" Display="'Effect 4'" Dmx="90~99" Update="Effect_Spd" />
      <Function ID="11" Name="Effect 5" Display="'Effect 5'" Dmx="100~109" Update="Effect_Spd" />
      <Function ID="12" Name="Effect 6" Display="'Effect 6'" Dmx="110~119" Update="Effect_Spd" />
      <Function ID="13" Name="Effect 7" Display="'Effect 7'" Dmx="120~129" Update="Effect_Spd" />
      <Function ID="14" Name="Effect 8" Display="'Effect 8'" Dmx="130~139" Update="Effect_Spd" />
      <Function ID="15" Name="Effect 9" Display="'Effect 9'" Dmx="140~149" Update="Effect_Spd" />
      <Function ID="16" Name="Effect 10" Display="'Effect 10'" Dmx="150~159" Update="Effect_Spd" />
      <Function ID="17" Name="Effect 11" Display="'Effect 11'" Dmx="160~169" Update="Effect_Spd" />
      <Function ID="18" Name="Effect 12" Display="'Effect 12'" Dmx="170~179" Update="Effect_Spd" />
      <Function ID="19" Name="Effect 13" Display="'Effect 13'" Dmx="180~189" Update="Effect_Spd" />
      <Function ID="20" Name="Effect 14" Display="'Effect 14'" Dmx="190~199" Update="Effect_Spd" />
      <Function ID="21" Name="Effect 15" Display="'Effect 15'" Dmx="200~209" Update="Effect_Spd" />
      <Function ID="22" Name="Sound 1" Display="'Sound 1'" Dmx="210~219" Update="Effect_Spd" />
      <Function ID="23" Name="Sound 2" Display="'Sound 2'" Dmx="220~229" Update="Effect_Spd" />
      <Function ID="24" Name="Sound 3" Display="'Sound 3'" Dmx="230~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sensitivity" ID="2" If="'Effect'&gt;21" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="8" Name="Static White" Display="'Static White'" Dmx="70~79" />
      <Function ID="9" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="80~99" />
      <Function ID="10" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="100~119" />
      <Function ID="11" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="120~139" />
      <Function ID="12" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="140~159" />

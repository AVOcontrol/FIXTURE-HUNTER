      <Function ID="3" Name="Static Green" Display="'Static Green'" Dmx="20~29" />
      <Function ID="4" Name="Static Blue" Display="'Static Blue'" Dmx="30~39" />
      <Function ID="5" Name="Static Cyan" Display="'Static Cyan'" Dmx="40~49" />

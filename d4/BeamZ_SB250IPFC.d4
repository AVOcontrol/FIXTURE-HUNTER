  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Main Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Main_Col_Macro" Name="Main Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~29" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~49" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="50~69" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="70~89" Colour="255,100,0" />
      <Function ID="6" Name="Lime" Display="'Lime'" Dmx="90~109" Colour="128,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="110~129" Colour="255,150,150" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="130~149" Colour="255,255,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="150~169" Colour="0,255,255" />
      <Function ID="10" Name="White" Display="'White'" Dmx="170~189" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Main_Macro" Name="Main Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="101~150" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="151~200" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Main_Macro_Spd" Name="Main Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Macro" Name="BG Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

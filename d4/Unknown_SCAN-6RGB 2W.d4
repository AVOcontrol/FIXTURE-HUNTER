      <Function ID="3" Name="White" Display="'White'" Dmx="7~9" Colour="0,0,0" />
      <Function ID="4" Name="Col Section" Display="'Col Section %.1f%%',0.0~100.0" Dmx="10~127" Colour="0,0,0" />
      <Function ID="5" Name="Pure Col" Display="'Pure Col %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="X_Wave" Name="X Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original Pattern" Display="'Original Pattern'" Dmx="0~0" />

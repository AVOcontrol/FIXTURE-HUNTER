      <Function ID="3" Name="Big Pos" Display="'Big Pos %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Small Spd" Display="'Small Spd %.f%%',0~100" Dmx="128~191" />
      <Function ID="5" Name="Big Spd" Display="'Big Spd %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Y_Wave" Name="Y Wave" Description="" Group="E">

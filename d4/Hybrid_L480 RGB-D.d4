<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="L480 RGB-D" ShortName="L480 RGB-D" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="100~199" />
      <Function ID="3" Name="DMX" Display="'DMX'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="30~59" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="60~89" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="90~119" Colour="255,255,255" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green'" Dmx="120~149" Colour="255,255,255" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue'" Dmx="150~179" Colour="255,255,255" />
      <Function ID="7" Name="Green+Blue" Display="'Green+Blue'" Dmx="180~209" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rot_Speed" Name="Rot Speed" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Rot_Direction" Name="Rot Direction" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW'" Dmx="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="100~199" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="200~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKHYL480" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Pattern" ChannelOffset="3" Wheel="13" />
      <Attribute ID="Rot_Speed" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Rot_Direction" ChannelOffset="5" Wheel="19" />
    </Include>
  </Mode>
</Fixture>
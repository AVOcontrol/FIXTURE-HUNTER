  <History Date="03-08-19" Author="Nic Morris" Comment="Created (poor documentation.  channel 1 is listed as both dimmer and strobe in both modes.  assumed 1 is strobe and 2 is dimmer)" Version="1" />
  <History Date="07-08-19" Author="Nic Morris" Comment="Swapped dimmer and shutter in line with corrected charts." Version="2" />
  <History Date="09-03-20" Author="Nic Morris" Comment="Created from Cyclops Blade B8500 (identical)" Version="3" />
  <History Date="10-03-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="723b9c14-cfcd-40a0-9b0f-90579c27e82a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="96~175" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Laser On" Display="'Laser On'" Dmx="30~99" />
      <Function ID="3" Name="LED On" Display="'LED On'" Dmx="100~199" />
      <Function ID="4" Name="Laser+LED On" Display="'Laser+LED On'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="31~200" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~35" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="36~55" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="56~75" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="76~95" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="96~115" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="116~135" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="136~155" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="156~175" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="176~195" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

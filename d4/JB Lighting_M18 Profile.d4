      <Function ID="21" Name="White 2700K (Tungsten Dim)" Display="'White 2700K (Tungsten Dim)'" Dmx="65~65" Colour="255,255,255" />
      <Function ID="22" Name="White 3200K" Display="'White 3200K'" Dmx="66~66" Colour="255,255,255" />
      <Function ID="23" Name="White 3200K (Tungsten Dim)" Display="'White 3200K (Tungsten Dim)'" Dmx="67~67" Colour="255,255,255" />

      <Function ID="30" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="0,0,0" />
      <Function ID="31" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~222" Colour="0,0,0" />
      <Function ID="32" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="0,0,0" />
      <Function ID="33" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~225" Colour="0,0,0" />
      <Function ID="34" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

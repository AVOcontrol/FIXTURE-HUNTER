    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="1542~32896" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="49087~33153" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="65535~49601" />

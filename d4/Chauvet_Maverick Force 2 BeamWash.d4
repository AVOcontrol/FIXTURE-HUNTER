  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4990bf34-641a-4e83-9c53-4ad073d70598" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2800~10000" Dmx="255~1" Colour="255,240,200" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobos" Display="'Gobos %.1f%%',0.0~100.0" Dmx="1~168" />
    </Attribute>
    <Attribute ID="LED_Macro" Name="LED Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="LED Macro" Display="'LED Macro %.1f%%',0.0~100.0" Dmx="16~85" />
      <Function ID="3" Name="Cycle All Macro" Display="'Cycle All Macro'" Dmx="86~135" />
      <Function ID="4" Name="Auto Prog" Display="'Auto Prog %.1f%%',0.0~100.0" Dmx="136~205" />
      <Function ID="5" Name="Cycle All Auto Prog" Display="'Cycle All Auto Prog'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="LED_MacSpeed" Name="LED MacSpeed" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="LED_Mac_Delay" Name="LED Mac Delay" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="BG_Col_Macro" Name="BG Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="5~6" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="7~8" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="9~10" Colour="255,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="11~11" Colour="0,0,255" />
      <Function ID="8" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="12~48" Colour="0,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="49~49" Colour="0,255,255" />
      <Function ID="10" Name="Cy - Grn" Display="'Cy - Grn %.f%%',0~100" Dmx="50~86" Colour="0,255,255" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="87~87" Colour="0,255,0" />
      <Function ID="12" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="88~124" Colour="0,255,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="125~125" Colour="255,255,0" />
      <Function ID="14" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="126~162" Colour="255,255,0" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="163~163" Colour="255,0,0" />
      <Function ID="16" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="164~200" Colour="255,0,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="201~201" Colour="255,0,255" />
      <Function ID="18" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="202~238" Colour="255,0,255" />
      <Function ID="19" Name="Blue" Display="'Blue'" Dmx="239~239" Colour="0,0,255" />
      <Function ID="20" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="247~240" Colour="255,255,255" />
      <Function ID="21" Name="Col Snap" Display="'Col Snap %.f%%',0~100" Dmx="255~248" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" Intensity="0~0" />

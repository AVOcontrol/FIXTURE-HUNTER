  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." Version="3" />
  <History Date="11-07-17" Author="Nic Morris" Comment="Changed RGB masters to power on and locate at zero in attempt to fix customer bug report." Version="4" />
  <History Date="07-03-20" Author="Nic Morris" Comment="Added product thumbnail.  Inverted zoom display range in response to customer feedback (documentation is wrong)" Version="5" />

  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2000~10000" Dmx="20~100" Colour="255,240,200" />
      <Function ID="3" Name="10000K" Display="'10000K'" Dmx="101~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green_Point" Name="Green Point" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.1f%%',100.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />

  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="18259" ModelID="1773" />
  </RDM>
  <AtlaBase TypeID="de4219a5-6e8c-40f9-83ad-c3d32a6afa93" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Lemon" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lemon C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2200K" Display="'White 2200K'" Dmx="5~9" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="10~14" Colour="255,255,255" />
      <Function ID="4" Name="White 4200K" Display="'White 4200K'" Dmx="15~19" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="20~24" Colour="255,255,255" />
      <Function ID="6" Name="White 6500K" Display="'White 6500K'" Dmx="25~29" Colour="255,255,255" />
      <Function ID="7" Name="White 8000K" Display="'White 8000K'" Dmx="30~34" Colour="255,255,255" />
      <Function ID="8" Name="White CTO" Display="'White CTO %.fK',2200~8000" Dmx="35~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour_Cal" Name="Colour Cal" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
  </Control>

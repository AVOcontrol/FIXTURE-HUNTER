<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LUX K25" ShortName="LUX K25" Company="Pro Lux" Version="33">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>8cbb35bb-5296-4f80-a999-f3e910115fc5</Thumbnail>
  <History Date="13-06-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="23-08-12" Author="Peter Budd" Comment="Created from Terbly OV370Z-R" Version="2" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Elation Platinum Wash ZXF Pro XL" Version="3" />
  <History Date="30-10-12" Author="Peter Budd" Comment="Edited added cell layout." Version="4" />
  <History Date="17-06-13" Author="Peter Budd" Comment="Updated to include shape channels in standard mode, and colour channels." Version="5" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Increased 16-bit functions to 2dp.  Increased shape speed functions to 1dp." Version="6" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Standardised shutted function order.  Reversed shape transition and offset wheel direction." Version="7" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Removed smoothing update from shape." Version="8" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Added Extended RGBW mode." Version="9" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Created from Clay Paky A.leda Wash K20" Version="10" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="11" />
  <History Date="02-03-14" Author="Nic Morris" Comment="Added 'Full' mode and brought in line with latest spec." Version="12" />
  <History Date="05-06-14" Author="Remi Derruau" Comment="Updated Shape strobe, Back strobe and back select to latest spec." Version="13" />
  <History Date="05-06-14" Author="Remi Derruau" Comment="Updated shapes." Version="14" />
  <History Date="05-06-14" Author="Nic Morris" Comment="Checked Remi's edits against documentation.  Increased back strobe wheel resolution." Version="15" />
  <History Date="05-06-14" Author="Nic Morris" Comment="Changed back select to locate to wash mode.  Fixed spiral shape range." Version="16" />
  <History Date="08-06-14" Author="Nic Morris" Comment="Added shape offset conditional functions for new shapes." Version="17" />
  <History Date="08-06-14" Author="Nic Morris" Comment="Changed colour macro to effect group to match new wheel mappings." Version="18" />
  <History Date="08-06-14" Author="Nic Morris" Comment="Fixed lens rot CW spin range.  Changed lens rot spin display to value 1dp to provide full resolution." Version="19" />
  <History Date="02-01-15" Author="Nic Morris" Comment="Updated to 11.2014 spec" Version="20" />
  <History Date="02-02-15" Author="Peter Budd" Comment="Added pixel map on macro." Version="21" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="22" />
  <History Date="29-06-16" Author="Nic Morris" Comment="Added a 'Shape Control' only mode and a celled version of the complete Shapes mode." Version="23" />
  <History Date="29-08-16" Author="Nic Morris" Comment="Revised classic pearl refs" Version="24" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." Version="25" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed BG Select 'no selection' function to 'Mirror Effect' at 255 in response to bug report." Version="26" />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's" Version="27" />
  <History Date="15-02-19" Author="Nic Morris" Comment="Moved shape controls into effect group and wheel slot.  Moved colour macro into colour group and wheel slot." Version="28" />
  <History Date="25-10-22" Author="Nic Morris" Comment="Added vdim to Extended and Extended RGBW mode cells in response to customer request.  Note the cells used are identical to the existing hidden 'vdim' modes.  Updated existing for compatiblity with fixture exchange." Version="29" />
  <History Date="25-10-22" Author="Nic Morris" Comment="Latest firmware uses split addressing (Standard/ Shapes + RGB/ RGBW).  These options can be used for split patch for the older firmware (ie. Extended = Standard+RGB, Extended RGBW = Standard+RGBW and Full = Shapes+RGB)" Version="29" />
  <History Date="07-08-24" Author="Nic Morris" Comment="Created from Clay Paky A.leda B-EYE K20 (remarkably similar...)" Version="30" />
  <History Date="29-01-25" Author="Nic Morris" Comment="Created from Jolly Lighting Q-6 Turbo (also surprisingly similar...  hopeless documentation.  no pixel layout.  assumed the same)" Version="31" />
  <Manual Filename=" Summary=" Summary="" />

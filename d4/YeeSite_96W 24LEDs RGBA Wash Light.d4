      <Function ID="12" Name="Col Chase 11" Display="'Col Chase 11'" Dmx="158~172" />
      <Function ID="13" Name="Col Chase 12" Display="'Col Chase 12'" Dmx="173~187" />
      <Function ID="14" Name="Col Chase 13" Display="'Col Chase 13'" Dmx="188~202" />
      <Function ID="15" Name="Col Chase 14" Display="'Col Chase 14'" Dmx="203~217" />
      <Function ID="16" Name="Col Chase 15" Display="'Col Chase 15'" Dmx="218~232" />
      <Function ID="17" Name="Col Chase 16" Display="'Col Chase 16'" Dmx="233~247" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Col_Chase_Spd" Name="Col Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

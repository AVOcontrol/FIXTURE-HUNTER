    </Attribute>
    <Attribute ID="Colour_Change" Name="Colour Change" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">

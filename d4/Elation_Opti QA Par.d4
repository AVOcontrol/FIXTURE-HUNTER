    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;5" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Shutter" Colour="0,0,0" />
      <Function ID="2" Name="Auto Mix" Display="'Auto Mix'" Dmx="128~159" Update="Shutter" Colour="0,0,0" />
      <Function ID="3" Name="3 Col Change" Display="'3 Col Change'" Dmx="160~191" Update="Shutter" Colour="0,0,0" />
      <Function ID="4" Name="7 Col Change" Display="'7 Col Change'" Dmx="192~223" Update="Shutter" Colour="0,0,0" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" Colour="0,0,0" />

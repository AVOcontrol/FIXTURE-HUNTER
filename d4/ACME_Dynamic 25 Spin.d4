<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dynamic 25 Spin" ShortName="Dyn 25 Spn" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="18-10-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="138~255" Intensity="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="15~137" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~21" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 1" Display="'Gobo 1'" Dmx="22~34" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 2" Display="'Gobo 2'" Dmx="35~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~61" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 4" Display="'Gobo 4'" Dmx="62~74" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 5" Display="'Gobo 5'" Dmx="75~87" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 6" Display="'Gobo 6'" Dmx="88~101" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 7" Display="'Gobo 7'" Dmx="102~114" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 8" Display="'Gobo 8'" Dmx="115~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="AMED25SP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Rotate" ChannelOffset="3" Wheel="15" />
    </Include>
  </Mode>
</Fixture>
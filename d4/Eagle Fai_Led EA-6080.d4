  <History Date="12-09-11" Author="Nic Morris" Comment="Removed conditionals.  Added Red8,Green8,Blue8 and adjusted modes to use correct attributes." />
  <History Date="12-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added v-dim.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~3" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~9" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="19~39" Intensity="0~0" />
      <Function ID="4" Name="Fade In/Out" Display="'Fade In/Out'" Dmx="40~69" Intensity="0~0" />
      <Function ID="5" Name="Col Chng" Display="'Col Chng'" Dmx="70~99" Intensity="0~0" />
      <Function ID="6" Name="Macro 1" Display="'Macro 1'" Dmx="100~110" Intensity="0~0" />
      <Function ID="7" Name="Macro 2" Display="'Macro 2'" Dmx="111~121" Intensity="0~0" />
      <Function ID="8" Name="Macro 3" Display="'Macro 3'" Dmx="122~132" Intensity="0~0" />
      <Function ID="9" Name="Macro 4" Display="'Macro 4'" Dmx="133~143" Intensity="0~0" />

      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="101~150" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="151~255" Colour="0,0,0" />
    </Attribute>
  </Control>

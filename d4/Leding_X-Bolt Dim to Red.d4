  <Thumbnail>6a1fefb9-3fb1-43ce-b197-f00ca9df1c6c</Thumbnail>
  <History Date="19-04-20" Author="Nic Morris" Comment="Created (charts contain errors.  guessed cell layout)" Version="0" />
  <History Date="22-04-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="23-04-20" Author="Nic Morris" Comment="Fixed missing cell dimmer links in 13 and 14 DMX modes." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cac3f959-5d36-4fbe-b2d9-8c48e9def114" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Round Up" Display="'Round Up'" Dmx="36~71" />
      <Function ID="3" Name="Round Down" Display="'Round Down'" Dmx="72~107" />
      <Function ID="4" Name="Round Up Down" Display="'Round Up Down'" Dmx="108~143" />
      <Function ID="5" Name="Sin Up" Display="'Sin Up'" Dmx="144~179" />
      <Function ID="6" Name="4-LEDs Standard" Display="'4-LEDs Standard'" Dmx="180~215" />
      <Function ID="7" Name="4-LEDs Random" Display="'4-LEDs Random'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Square" Display="'Square'" Dmx="64~127" />
      <Function ID="3" Name="Inv Square" Display="'Inv Square'" Dmx="128~191" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6015cc7b-95e1-4000-be3f-6824f8cbfa8c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>

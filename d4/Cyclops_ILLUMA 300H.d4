    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="6,7,8,9,10" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="11,12" If="'Gobo1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Small Beam 1" Display="'Small Beam 1'" Dmx="4~9" WheelPosition="1" />
      <Function ID="3" Name="Small Beam 2" Display="'Small Beam 2'" Dmx="10~14" WheelPosition="2" />
      <Function ID="4" Name="Small Beam 3" Display="'Small Beam 3'" Dmx="16~21" WheelPosition="3" />
      <Function ID="5" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="58~87" WheelPosition="4" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Small Beam 1 Shake" Display="'Small Beam 1 Shake %.f%%',0~100" Dmx="96~103" WheelPosition="1" />
      <Function ID="8" Name="Small Beam 1 Shake" Display="'Small Beam 1 Shake %.f%%',0~100" Dmx="104~111" WheelPosition="2" />
      <Function ID="9" Name="Small Beam 1 Shake" Display="'Small Beam 1 Shake %.f%%',0~100" Dmx="112~119" WheelPosition="3" />
      <Function ID="10" Name="Water Ripples" Display="'Water Ripples %.f%%',0~100" Dmx="168~199" WheelPosition="4" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="202~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />

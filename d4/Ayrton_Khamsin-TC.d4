    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display Off" Display="'Display Off'" Dmx="5~9" />
      <Function ID="3" Name="Display On" Display="'Display On'" Dmx="10~14" />
      <Function ID="4" Name="Display Normal" Display="'Display Normal'" Dmx="15~19" />
      <Function ID="5" Name="Display Invert" Display="'Display Invert'" Dmx="20~24" />
      <Function ID="6" Name="Fan Auto" Display="'Fan Auto'" Dmx="25~29" />
      <Function ID="7" Name="Fan Stage" Display="'Fan Stage'" Dmx="30~34" />
      <Function ID="8" Name="Fan Studio" Display="'Fan Studio'" Dmx="35~39" />
      <Function ID="9" Name="Fan Silent" Display="'Fan Silent'" Dmx="40~44" />
      <Function ID="10" Name="Dim Square" Display="'Dim Square'" Dmx="45~49" />
      <Function ID="11" Name="Dim Linear" Display="'Dim Linear'" Dmx="50~54" />
      <Function ID="12" Name="1.2K" Display="'1.2K'" Dmx="55~59" />
      <Function ID="13" Name="2.4K" Display="'2.4K'" Dmx="60~64" />
      <Function ID="14" Name="16K" Display="'16K'" Dmx="65~69" />
      <Function ID="15" Name="Gobo Correction Off" Display="'Gobo Correction Off'" Dmx="70~74" />
      <Function ID="16" Name="Gobo Correction On" Display="'Gobo Correction On'" Dmx="75~79" />
      <Function ID="17" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="18" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="19" Name="Reset Colour" Display="'Reset Colour'" Dmx="88~90" />
      <Function ID="20" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="91~93" />
      <Function ID="21" Name="Reset Other" Display="'Reset Other'" Dmx="97~99" />
      <Function ID="22" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="23" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="24" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="25" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="26" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="27" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="28" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="29" Name="Program 8" Display="'Program 8'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTB/CRI" Name="CTB/CRI" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTB" Display="'CTB'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="CRI" Display="'CRI'" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48573" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49858~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48573" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="48830~49601" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49858~65535" />
    </Attribute>
  </Control>

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="68~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="8~37" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="38~67" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="23~27" Colour="255,240,200" />
      <Function ID="3" Name="Cold White" Display="'Cold White'" Dmx="28~32" Colour="230,230,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="33~37" Colour="255,0,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="38~42" Colour="255,128,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="43~47" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="48~52" Colour="0,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="53~57" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="58~62" Colour="0,0,255" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="63~67" Colour="128,0,255" />
      <Function ID="11" Name="User Colour" Display="'User Colour'" Dmx="68~72" Colour="255,255,255" />
      <Function ID="12" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="73~161" Colour="255,255,255" />
      <Function ID="13" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="162~250" Colour="255,255,255" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="190~90" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="35~255" />
      <Function ID="3" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="5~24" />
    </Attribute>
    <Attribute ID="Shutter3" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />

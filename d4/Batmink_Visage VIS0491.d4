<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Visage VIS0491" ShortName="VIS0491" Company="Batmink" Version="3">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="16-01-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="18-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="19-01-26" Author="Nic Morris" Comment="Created from Batmink Visage ECO Multipar 10w RGBW (VIS0490) (can't find much about this product but manual appears to be shared)" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;23" />
      <Condition Name="Sensitivity" ID="4" If="'Colour_Macro'&gt;22" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Update="Shutter" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Update="Shutter" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Update="Shutter" Colour="0,0,255" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="64~79" Update="Shutter" Colour="128,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="80~95" Update="Shutter" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="96~111" Update="Shutter" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="112~127" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="Col Mix 1" Display="'Col Mix 1'" Dmx="128~135" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Col Mix 2" Display="'Col Mix 2'" Dmx="136~143" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Col Mix 3" Display="'Col Mix 3'" Dmx="144~151" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="Col Mix 4" Display="'Col Mix 4'" Dmx="152~159" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="Col Mix 5" Display="'Col Mix 5'" Dmx="160~167" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="Col Mix 6" Display="'Col Mix 6'" Dmx="168~175" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="Col Mix 7" Display="'Col Mix 7'" Dmx="176~183" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="Col Mix 8" Display="'Col Mix 8'" Dmx="184~191" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Col Change 1" Display="'Col Change 1'" Dmx="192~199" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Col Change 2" Display="'Col Change 2'" Dmx="200~207" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="Col Change 3" Display="'Col Change 3'" Dmx="208~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="Col Change 4" Display="'Col Change 4'" Dmx="216~223" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="Col Change 5" Display="'Col Change 5'" Dmx="224~231" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="Col Change 6" Display="'Col Change 6'" Dmx="232~239" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="240~247" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="248~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="d3cdb793-fbd5-41f4-9ad2-1828ed566fb2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

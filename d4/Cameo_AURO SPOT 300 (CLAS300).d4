    </Attribute>
    <Attribute ID="Special" Name="Special" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="6~37" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="38~69" />
      <Function ID="4" Name="Pan Invert ON" Display="'Pan Invert ON'" Dmx="70~101" />
      <Function ID="5" Name="Pan Invert OFF" Display="'Pan Invert OFF'" Dmx="102~133" />
      <Function ID="6" Name="Tilt Invert ON" Display="'Tilt Invert ON'" Dmx="134~165" />
      <Function ID="7" Name="Tilt Invert OFF" Display="'Tilt Invert OFF'" Dmx="166~197" />
      <Function ID="8" Name="Fan Silent ON" Display="'Fan Silent ON'" Dmx="198~229" />
      <Function ID="9" Name="Fan Silent OFF" Display="'Fan Silent OFF'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="6~127" />
      <Function ID="3" Name="Reset Effect" Display="'Reset Effect'" Dmx="128~191" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

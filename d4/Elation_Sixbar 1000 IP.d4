  <History Date="29-12-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." Version="6" />
  <History Date="08-02-23" Author="Nic Morris" Comment="Added vdim to 75 and 79 channel modes (both cell modes are now identical but retained for compatibility).  Added product thumbnail." Version="7" />

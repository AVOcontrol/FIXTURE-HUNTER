    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Red" Colour="255,255,255" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro'" Dmx="1~22" Update="Red" Colour="255,255,255" />
      <Function ID="3" Name="Slow Transition 14 Col" Display="'Slow Transition 14 Col'" Dmx="23~45" Update="Red" Colour="255,255,255" />
      <Function ID="4" Name="Slow Transition R-G-B-W" Display="'Slow Transition R-G-B-W'" Dmx="46~68" Update="Red" Colour="255,255,255" />
      <Function ID="5" Name="Fast Transition 14 Col" Display="'Fast Transition 14 Col'" Dmx="69~91" Update="Red" Colour="255,255,255" />
      <Function ID="6" Name="Fast Transition R-G-B-W" Display="'Fast Transition R-G-B-W'" Dmx="92~114" Update="Red" Colour="255,255,255" />
      <Function ID="7" Name="Random 1" Display="'Random 1'" Dmx="115~137" Update="Red" Colour="255,255,255" />
      <Function ID="8" Name="Random 2" Display="'Random 2'" Dmx="138~160" Update="Red" Colour="255,255,255" />
      <Function ID="9" Name="Bright/ Dark, Red" Display="'Bright/ Dark, Red'" Dmx="161~183" Update="Red" Colour="255,255,255" />
      <Function ID="10" Name="Bright/ Dark, Green" Display="'Bright/ Dark, Green'" Dmx="184~206" Update="Red" Colour="255,255,255" />
      <Function ID="11" Name="Bright/ Dark, Blue" Display="'Bright/ Dark, Blue'" Dmx="207~229" Update="Red" Colour="255,255,255" />
      <Function ID="12" Name="Bright/ Dark, White" Display="'Bright/ Dark, White'" Dmx="230~255" Update="Red" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Colour="0,0,255" />

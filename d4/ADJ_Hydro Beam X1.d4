  <History Date="18-04-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="01-06-16" Author="Nic Morris" Comment="Revised shutter pulse functions" Version="3" />
  <History Date="19-04-19" Author="Nic Morris" Comment="Created from American DJ Vizi Beam RXONE (note no manual available used Vizi Beam RXONE as advised by manufacturer but Capture channel counts don't currently agree)" Version="4" />
  <History Date="23-08-19" Author="Nic Morris" Comment="Updated in line with latest charts in response to customer bug report (according to charts supports software version 1.0 and above)" Version="5" />
  <History Date="23-08-19" Author="Nic Morris" Comment="Revises dimmer resolution, shutter, prism, prism rot and control ranges and macros and channel assigment and count removing P/T macro and speed controls." Version="6" />
  <History Date="23-08-19" Author="Nic Morris" Comment="Added gobo swatches" Version="7" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Hydro Beam X1.d4 to ADJ_Hydro Beam X1.d4." Version="8" />

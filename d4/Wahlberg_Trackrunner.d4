<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Trackrunner" ShortName="Trckrunner" Company="Wahlberg">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="27-03-19" Author="Nic Morris" Comment="Created (documentation is vague - DMX ranges are in percentage only)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Position" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Maximum_Speed" Name="Maximum Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="REV/_Set_0%" Name="REV/ Set 0%" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Range" ID="2" If="'Set_Range'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FWD/_Set_100%" Name="FWD/ Set 100%" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Range" ID="2" If="'Set_Range'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Set_Range" Name="Set Range" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="REV/_Set_0%, FWD/_Set_100%" />
      <Function ID="2" Name="Enable" Display="'Enable'" Dmx="130~138" Update="REV/_Set_0%, FWD/_Set_100%" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Maximum_Speed" ChannelOffset="3" Wheel="28" />
      <Attribute ID="REV/_Set_0%" ChannelOffset="4" Wheel="26" />
      <Attribute ID="FWD/_Set_100%" ChannelOffset="5" Wheel="27" />
      <Attribute ID="Set_Range" ChannelOffset="6" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
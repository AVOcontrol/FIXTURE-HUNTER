<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FS-6" ShortName="FS-6" Company="PSLaser">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>266a2515-3d0c-4216-b283-b24f651a010d</Thumbnail>
  <History Date="24-11-15" Author="Nic Morris" Comment="Created" />
  <History Date="05-12-19" Author="Nic Morris" Comment="Created from Showtec Galactic Moodbeam (effectively identical)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="X Move" ID="2,3,4" If="'Mode'==8" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Y Move" ID="5,6,7" If="'Mode'==8" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="127~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~169" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="170~209" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="210~255" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Roll" Name="Y Roll" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Colour" ID="4,5,6,7,8" If="'Mode'==8" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Blackout" Display="'Blackout'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="RG On/ Strobe" Display="'RG On/ Strobe'" Dmx="10~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="R On/ Strobe, G Off" Display="'R On/ Strobe, G Off'" Dmx="64~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="G On/ Strobe, R Off" Display="'G On/ Strobe, R Off'" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="RG On/ Alt Strobe" Display="'RG On/ Alt Strobe'" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X_Roll" Name="X Roll" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Shutter" ID="4,5,6" If="'Mode'==8" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="250~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Z_Roll" Name="Z Roll" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Rotation" ID="4,5,6" If="'Mode'==8" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="0~75" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="76~150" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="151~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X_Move" Name="X Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Y_Move" Name="Y Move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pattern" ID="5,6,7,8,9,10" If="'Mode'==10" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~31" Colour="255,255,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~49" Colour="255,255,255" />
      <Function ID="4" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="50~255" Colour="255,255,255" />
      <Function ID="5" Name="Original" Display="'Original'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="17~31" Colour="255,255,255" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="48~62" Colour="255,255,255" />
      <Function ID="9" Name="Single" Display="'Single %.f%%',0~100" Dmx="63~160" Colour="255,255,255" />
      <Function ID="10" Name="Mix" Display="'Mix %.f%%',0~100" Dmx="161~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="1~75" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="76~150" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="2" Name="Auto Mix" Display="'Auto Mix'" Dmx="25~49" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="3" Name="Sound Mix" Display="'Sound Mix'" Dmx="50~74" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="4" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="75~99" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="5" Name="Sound Pattern" Display="'Sound Pattern'" Dmx="100~124" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="6" Name="Auto Grating" Display="'Auto Grating'" Dmx="125~149" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="7" Name="Sound Grating" Display="'Sound Grating'" Dmx="150~174" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="8" Name="DMX Dots" Display="'DMX Dots'" Dmx="175~199" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="9" Name="DMX Grating" Display="'DMX Grating'" Dmx="200~224" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
      <Function ID="10" Name="DMX Pattern" Display="'DMX Pattern'" Dmx="225~255" Update="Pattern, Zoom, Y_Roll, X_Roll, Z_Roll, Colour1" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="X_Move" ChannelOffset="7" Wheel="2" />
      <Attribute ID="Y_Move" ChannelOffset="8" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Y_Roll" ChannelOffset="4" Wheel="15" />
      <Attribute ID="X_Roll" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Z_Roll" ChannelOffset="6" Wheel="43" />
      <Attribute ID="Rotation" ChannelOffset="10" Wheel="44" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="266a2515-3d0c-4216-b283-b24f651a010d"></Swatch>
  </swatchLibrary>
</Fixture>
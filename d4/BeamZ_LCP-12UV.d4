  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="LED_Mode_1" Name="LED Mode 1" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_Mode_2" Name="LED Mode 2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="LED Mode 2" Display="'LED Mode 2 %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Strobe Spd" Display="'Strobe Spd %.1f%%',0.0~100.0" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="11~200" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKBZ12UV" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
      <Attribute ID="LED_Mode_1" ChannelOffset="1" Wheel="25" />
      <Attribute ID="LED_Mode_2" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">

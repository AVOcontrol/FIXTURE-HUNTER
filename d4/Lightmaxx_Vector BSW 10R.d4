    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="257~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33153" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33410~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="6 Facet Linear Index" Display="'6 Facet Linear Index'" Dmx="20~49" Update="Prism_Rot" />
      <Function ID="3" Name="6 Facet Linear Spin" Display="'6 Facet Linear Spin'" Dmx="50~75" Update="Prism_Rot" />
      <Function ID="4" Name="8 Facet Circ Index" Display="'8 Facet Circ Index'" Dmx="76~104" Update="Prism_Rot" />
      <Function ID="5" Name="8 Facet Circ Spin" Display="'8 Facet Circ Spin'" Dmx="105~127" Update="Prism_Rot" />
      <Function ID="6" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Prism_Rot" />
      <Function ID="7" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Prism_Rot" />
      <Function ID="8" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Prism_Rot" />
      <Function ID="9" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Prism_Rot" />
      <Function ID="10" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Prism_Rot" />
      <Function ID="11" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Prism_Rot" />
      <Function ID="12" Name="Macro 7" Display="'Macro 7'" Dmx="176~183" Update="Prism_Rot" />
      <Function ID="13" Name="Macro 8" Display="'Macro 8'" Dmx="184~191" Update="Prism_Rot" />
      <Function ID="14" Name="Macro 9" Display="'Macro 9'" Dmx="192~199" Update="Prism_Rot" />
      <Function ID="15" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Prism_Rot" />
      <Function ID="16" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Prism_Rot" />
      <Function ID="17" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" Update="Prism_Rot" />
      <Function ID="18" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" Update="Prism_Rot" />
      <Function ID="19" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" Update="Prism_Rot" />
      <Function ID="20" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Prism_Rot" />
      <Function ID="21" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2||'Prism'==4" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'==3||'Prism'==5" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ARCLED338" ShortName="ARCLED338" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="01-07-10" Author="Jonathan Moreton" Comment="Created from Silver Star YG LED 321W " />
  <History Date="23-05-12" Author="Alessandro Fantin" Comment="Created" />
  <History Date="23-05-12" Author="Peter Budd" Comment="Checked" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Added virtual dimmer to Arc1, 3 DMX mode.  Tidied up." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Removed Arc2 modes (channel counts didn't match and there is no white attribute)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macros" Name="Colour Macros" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~10" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="4" Name="White 1: 3200K" Display="'White 1: 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 2: 3400K" Display="'White 2: 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 3: 4200K" Display="'White 3: 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="White 4: 4900K" Display="'White 4: 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="White 5: 5600K" Display="'White 5: 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="White 6: 5900K" Display="'White 6: 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="White 7: 6500K" Display="'White 7: 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="11" Name="White 8: 7200K" Display="'White 8: 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="12" Name="White 9: 8000K" Display="'White 9: 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="White 10: 8500K" Display="'White 10:     8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="14" Name="White 11: 10000K" Display="'White 11:     10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fans Off" Display="'Fans Off'" Dmx="11~20" />
      <Function ID="3" Name="Fans Low" Display="'Fans Low'" Dmx="21~30" />
      <Function ID="4" Name="Fans High" Display="'Fans High'" Dmx="31~40" />
      <Function ID="5" Name="Fans Normal" Display="'Fans Normal'" Dmx="41~50" />
      <Function ID="6" Name="Fans Auto" Display="'Fans Auto'" Dmx="51~60" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="61~70" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="71~80" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="81~90" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="91~100" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="101~110" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="111~120" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="121~130" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="131~140" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="141~150" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="151~160" />
      <Function ID="17" Name="Custom 1" Display="'Custom 1'" Dmx="161~170" />
      <Function ID="18" Name="Custom 2" Display="'Custom 2'" Dmx="171~180" />
      <Function ID="19" Name="Custom 3" Display="'Custom 3'" Dmx="181~190" />
      <Function ID="20" Name="Custom 4" Display="'Custom 4'" Dmx="191~200" />
      <Function ID="21" Name="Custom 5" Display="'Custom 5'" Dmx="201~210" />
      <Function ID="22" Name="Custom 6" Display="'Custom 6'" Dmx="211~220" />
      <Function ID="23" Name="Custom 7" Display="'Custom 7'" Dmx="221~230" />
      <Function ID="24" Name="Custom 8" Display="'Custom 8'" Dmx="231~240" />
      <Function ID="25" Name="Custom 9" Display="'Custom 9'" Dmx="241~250" />
      <Function ID="26" Name="Custom 10" Display="'Custom 10'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Non Linear1" Display="'Non Linear1'" Dmx="30~69" />
      <Function ID="4" Name="Non Linear2" Display="'Non Linear2'" Dmx="70~129" />
      <Function ID="5" Name="Non Linear3" Display="'Non Linear3'" Dmx="130~189" />
      <Function ID="6" Name="Non Linear4" Display="'Non Linear4'" Dmx="190~255" />
    </Attribute>
  </Control>
  <Mode Name="STAG, 9 DMX" Channels="9">
    <Import PearlRef="PGP338ST" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macros" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="9" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Arc.1, 3 DMX" Channels="3">
    <Import PearlRef="PGP338A3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Ar1.D, 4 DMX" Channels="4">
    <Import PearlRef="PGP338AD" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="Arc.S, 5 DMX" Channels="5">
    <Import PearlRef="PGP338AS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Fans Off">
      <Set Channel="Auto:2" Delay="6000" />
      <Set Channel="Auto:1" Delay="0" />
    </Macro>
    <Macro Name="Fans Low">
      <Set Channel="Auto:3" Delay="6000" />
      <Set Channel="Auto:1" Delay="0" />
    </Macro>
    <Macro Name="Fans High">
      <Set Channel="Auto:4" Delay="6000" />
      <Set Channel="Auto:1" Delay="0" />
    </Macro>
    <Macro Name="Fans Normal">
      <Set Channel="Auto:5" Delay="6000" />
      <Set Channel="Auto:1" Delay="0" />
    </Macro>
    <Macro Name="Fans Auto">
      <Set Channel="Auto:6" Delay="6000" />
      <Set Channel="Auto:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
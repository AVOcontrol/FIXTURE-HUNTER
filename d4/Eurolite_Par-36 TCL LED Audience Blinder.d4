    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="10~29" Colour="0,0,0" />
      <Function ID="3" Name="Meteor" Display="'Meteor'" Dmx="30~49" Colour="0,0,0" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="50~69" Colour="0,0,0" />
      <Function ID="5" Name="Change" Display="'Change'" Dmx="70~89" Colour="0,0,0" />
      <Function ID="6" Name="Flow 1" Display="'Flow 1'" Dmx="90~109" Colour="0,0,0" />
      <Function ID="7" Name="Flow 2" Display="'Flow 2'" Dmx="110~129" Colour="0,0,0" />
      <Function ID="8" Name="Flow 3" Display="'Flow 3'" Dmx="130~149" Colour="0,0,0" />
      <Function ID="9" Name="Flow 4" Display="'Flow 4'" Dmx="150~169" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Par-36 TCL LED Audience Blinder" ShortName="LED Blindr" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="13-06-12" Author="Peter Budd" Comment="Created" />
  <History Date="04-02-13" Author="Peter Budd" Comment="Created from LED Pix-16 TCL Bar" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~21" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="22~32" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="33~43" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="44~54" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="55~65" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="66~76" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="77~87" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="88~98" Colour="255,255,255" />
      <Function ID="9" Name="Dream" Display="'Dream'" Dmx="99~109" Colour="0,0,0" />
      <Function ID="10" Name="Meteor" Display="'Meteor'" Dmx="110~120" Colour="0,0,0" />
      <Function ID="11" Name="Fade" Display="'Fade'" Dmx="121~131" Colour="0,0,0" />
      <Function ID="12" Name="Change" Display="'Change'" Dmx="132~142" Colour="0,0,0" />
      <Function ID="13" Name="Flow 1" Display="'Flow 1'" Dmx="143~153" Colour="0,0,0" />
      <Function ID="14" Name="Flow 2" Display="'Flow 2'" Dmx="154~164" Colour="0,0,0" />
      <Function ID="15" Name="Flow 3" Display="'Flow 3'" Dmx="165~175" Colour="0,0,0" />
      <Function ID="16" Name="Flow 4" Display="'Flow 4'" Dmx="176~186" Colour="0,0,0" />
      <Function ID="17" Name="Flow 5" Display="'Flow 5'" Dmx="187~197" Colour="0,0,0" />
      <Function ID="18" Name="Flow 6" Display="'Flow 6'" Dmx="198~208" Colour="0,0,0" />
      <Function ID="19" Name="Flow 7" Display="'Flow 7'" Dmx="209~219" Colour="0,0,0" />
      <Function ID="20" Name="Flow 8" Display="'Flow 8'" Dmx="220~230" Colour="0,0,0" />
      <Function ID="21" Name="Flow 9" Display="'Flow 9'" Dmx="231~241" Colour="0,0,0" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="242~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">

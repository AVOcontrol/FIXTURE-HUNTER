      <Attribute ID="Colour1" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Frost" ChannelOffset="11" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="12,13" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

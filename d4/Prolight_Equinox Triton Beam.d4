      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Frost" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="PTEQTBM2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

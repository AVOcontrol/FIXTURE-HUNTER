    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Dim 1" Display="'Dim 1'" Dmx="51~100" />
      <Function ID="3" Name="Dim 2" Display="'Dim 2'" Dmx="101~150" />

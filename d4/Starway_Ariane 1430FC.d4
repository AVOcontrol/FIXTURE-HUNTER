    <Attribute ID="Direction/Patt" Name="Direction/Patt" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1" />
      <Condition Name="Pixel Mode" ID="2,3" If="'Function'==1" />
      <Condition Name="Pixel Chaser" ID="4,5" If="'Function'==2" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Pixel_1/_Red, Pixel_2/_Green, Pixel_3/_Blue" />
      <Function ID="2" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Pixel_1/_Red, Pixel_2/_Green, Pixel_3/_Blue" />
      <Function ID="3" Name="Static Pattern" Display="'Static Pattern %.1f%%',0.0~100.0" Dmx="6~255" Update="Pixel_1/_Red, Pixel_2/_Green, Pixel_3/_Blue" />
      <Function ID="4" Name="FWD" Display="'FWD'" Dmx="0~0" Update="Pixel_1/_Red, Pixel_2/_Green, Pixel_3/_Blue" />
      <Function ID="5" Name="REV" Display="'REV'" Dmx="255~255" Update="Pixel_1/_Red, Pixel_2/_Green, Pixel_3/_Blue" />
    </Attribute>
    <Attribute ID="Prog_Spd/Col" Name="Prog Spd/Col" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Colour" ID="2" If="'Function'==5" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_1/_Red" Name="Pixel 1/ Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1,2,3,4" />
      <Condition Name="Red" ID="5" If="'Function'&gt;2||'Direction/Patt'==3" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~31" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="32~63" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="64~95" Colour="0,0,255" />
      <Function ID="4" Name="RGB Mix" Display="'RGB Mix %.1f%%',0.0~100.0" Dmx="96~255" Colour="0,0,0" />
      <Function ID="5" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Pixel_2/_Green" Name="Pixel 2/ Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1,2,3,4" />
      <Condition Name="Green" ID="5" If="'Function'&gt;2||'Direction/Patt'==3" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~31" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="32~63" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="64~95" Colour="0,0,255" />
      <Function ID="4" Name="RGB Mix" Display="'RGB Mix %.1f%%',0.0~100.0" Dmx="96~255" Colour="0,0,0" />
      <Function ID="5" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Pixel_3/_Blue" Name="Pixel 3/ Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1,2,3,4" />
      <Condition Name="Blue" ID="5" If="'Function'&gt;2||'Direction/Patt'==3" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~31" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="32~63" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="64~95" Colour="0,0,255" />
      <Function ID="4" Name="RGB Mix" Display="'RGB Mix %.1f%%',0.0~100.0" Dmx="96~255" Colour="0,0,0" />
      <Function ID="5" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~31" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="32~63" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="64~95" Colour="0,0,255" />
      <Function ID="4" Name="RGB Mix" Display="'RGB Mix %.1f%%',0.0~100.0" Dmx="96~255" Colour="0,0,0" />
    </Attribute>

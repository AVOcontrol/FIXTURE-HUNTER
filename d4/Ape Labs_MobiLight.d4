      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
        <Attribute ID="Speed" ChannelOffset="4" Wheel="25" />
        <Attribute ID="Fade" ChannelOffset="5" Wheel="29" />
        <Attribute ID="Direction" ChannelOffset="6" Wheel="30" />
        <Attribute ID="Group" ChannelOffset="7" Wheel="58" />

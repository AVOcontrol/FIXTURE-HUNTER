<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MobiLight" ShortName="MobiLight" Company="Ape Labs">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="22-10-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="0~7" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="8~15" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="16~23" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="24~31" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="32~39" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="40~47" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="48~55" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="56~63" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="64~71" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="72~79" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="80~87" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="88~95" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="96~103" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="104~110" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="111~111" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="112~119" Colour="0,0,0" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="120~127" Colour="0,0,0" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="128~135" Colour="0,0,0" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="136~143" Colour="0,0,0" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="144~151" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LP FW" Display="'LP FW'" Dmx="0~63" />
      <Function ID="2" Name="FFW" Display="'FFW'" Dmx="64~127" />
      <Function ID="3" Name="Rew" Display="'Rew'" Dmx="128~190" />
      <Function ID="4" Name="Loop Rew" Display="'Loop Rew'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Group" Name="Group" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="G1" Display="'G1'" Dmx="0~63" />
      <Function ID="2" Name="G1+G2" Display="'G1+G2'" Dmx="64~127" />
      <Function ID="3" Name="G1-G3" Display="'G1-G3'" Dmx="128~190" />
      <Function ID="4" Name="G1-G4" Display="'G1-G4'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Restart" Name="Restart" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Hue C-Mix" Display="'Hue C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,170,170" />
    </Attribute>
    <Attribute ID="Offset" Name="Offset" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="RGBWS, 5 DMX" Channels="5">
    <Import PearlRef="UK_ApMbLit5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="RGBW, 4 DMX" Channels="4">
    <Import PearlRef="UK_ApMbLit4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Effect Mode Fix" Channels="17">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
        <Attribute ID="Speed" ChannelOffset="4" Wheel="25" />
        <Attribute ID="Fade" ChannelOffset="5" Wheel="29" />
        <Attribute ID="Direction" ChannelOffset="6" Wheel="30" />
        <Attribute ID="Group" ChannelOffset="7" Wheel="58" />
        <Attribute ID="Offset" ChannelOffset="8" Wheel="28" />
        <Attribute ID="Restart" ChannelOffset="9" Wheel="59" />
        <Attribute ID="Hue" Wheel="8" />
        <Attribute ID="White" Wheel="9" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="10" ModeLink="Fix Cell" X="0" Y="0">
        <AttributeLink SourceId="Hue" TargetId="Hue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="11" ModeLink="Fix Cell" X="0" Y="1">
        <AttributeLink SourceId="Hue" TargetId="Hue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="12" ModeLink="Fix Cell" X="0" Y="2">
        <AttributeLink SourceId="Hue" TargetId="Hue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="Fix Cell" X="0" Y="3">
        <AttributeLink SourceId="Hue" TargetId="Hue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Effect Mode RGB" Channels="25">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

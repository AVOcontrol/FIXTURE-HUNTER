      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="128~169" />
      <Function ID="4" Name="Col Gradient" Display="'Col Gradient'" Dmx="170~210" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="211~229" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">

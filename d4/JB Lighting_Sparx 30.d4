<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sparx 30" ShortName="Sparx 30" Company="JB Lighting">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>40b99e81-1703-4e50-9d45-1025d5dbd296</Thumbnail>
  <History Date="11-05-18" Author="Nic Morris" Comment="Created (very limited information.  channels only.  initially implemented as multi-part patch)" />
  <History Date="21-12-18" Author="Nic Morris" Comment="Added mode 1 (still very limited and messy information)" />
  <History Date="23-05-19" Author="Nic Morris" Comment="Complete rewrite in line with DMX chart v1.07, Software &gt;= 1.00 (doesn't bear much resemblence to the intial documentation)" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Note charts have Cooling Standard control function at different values depending on mode.  Looks like an error.)" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Mode 1 and 2 charts have P/T Speed and Effect Speed but with no channel assignments)" />
  <History Date="23-05-19" Author="Nic Morris" Comment="(Effect Mode ranges are vague.  Effects have duplicates that look like errors.  Made best guess/reasonable assumption)" />
  <History Date="23-05-19" Author="Nic Morris" Comment="Implemented Mode 4 as multi-part patch only for now.  I feel this would be impractical in a single mode at the moment.  This will not simulate in the integrated Capture Visualiser." />
  <History Date="24-05-19" Author="Nic Morris" Comment="Note Pattern RGBW controls not currently used.  Left for now as option to link to pattern cell RGBW instead of main RGBW in Modes 1 and 2." />
  <History Date="24-05-19" Author="Nic Morris" Comment="Created from JB Lighting Sparx 18 (rewrite)" />
  <History Date="25-05-19" Author="Nic Morris" Comment="Changed mode 4 layer masters to use xfade layer control instead of xfade fx/pixel." />
  <History Date="25-05-19" Author="Nic Morris" Comment="Fixed shutter display range units.  It is not clear how these broke." />
  <Manual Filename="" Summary="" />

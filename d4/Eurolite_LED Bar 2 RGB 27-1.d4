<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Bar 2 RGB 27-1" ShortName="Bar2 27-1" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="14-03-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="Multi" Display="'Multi'" Dmx="1~15" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="Single" Display="'Single'" Dmx="16~31" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="32~47" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="48~63" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="64~79" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="80~95" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="96~111" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="112~127" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="White" Display="'White'" Dmx="128~143" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="11" Name="Col Change" Display="'Col Change'" Dmx="144~159" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="12" Name="Col Flow" Display="'Col Flow'" Dmx="160~175" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="13" Name="Col Dream" Display="'Col Dream'" Dmx="176~191" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="14" Name="Multi Flow" Display="'Multi Flow'" Dmx="192~207" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="15" Name="Dream Flow" Display="'Dream Flow'" Dmx="208~223" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="16" Name="2 Col Flow" Display="'2 Col Flow'" Dmx="224~239" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer, Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;10&amp;&amp;'Colour_Macro'&lt;17" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==17" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Sel" ID="2" If="'Colour_Macro'==15||'Colour_Macro'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Sel" ID="2" If="'Colour_Macro'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="EXB22711" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red1" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Red2" ChannelOffset="7" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="8" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="9" Wheel="42" />
      <Attribute ID="Red3" ChannelOffset="10" Wheel="70" />
      <Attribute ID="Green3" ChannelOffset="11" Wheel="71" />
      <Attribute ID="Blue3" ChannelOffset="12" Wheel="72" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="EXB22712" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="EXB22713" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter1" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:0,Blue2:1:0,Blue3:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:50,Green2:1:50,Green3:1:50,Blue1:1:0,Blue2:1:0,Blue3:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:0,Blue2:1:0,Blue3:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0,Red1:1:50,Red2:1:50,Red3:1:50,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:0,Blue2:1:0,Blue3:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0,Red1:1:0,Red2:1:0,Red3:1:0,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:0,Blue2:1:0,Blue3:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50,Red1:1:0,Red2:1:0,Red3:1:0,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:50,Blue2:1:50,Blue3:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100,Red1:1:0,Red2:1:0,Red3:1:0,Green1:1:100,Green2:1:100,Green3:1:100,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100,Red1:1:0,Red2:1:0,Red3:1:0,Green1:1:50,Green2:1:50,Green3:1:50,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100,Red1:1:0,Red2:1:0,Red3:1:0,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100,Red1:1:50,Red2:1:50,Red3:1:50,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50,Red1:1:100,Red2:1:100,Red3:1:100,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:50,Blue2:1:50,Blue3:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94,Red1:1:71,Red2:1:71,Red3:1:71,Green1:1:43,Green2:1:43,Green3:1:43,Blue1:1:94,Blue2:1:94,Blue3:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100,Red1:1:20,Red2:1:20,Red3:1:20,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:100,Blue2:1:100,Blue3:1:100" />
    </Group>

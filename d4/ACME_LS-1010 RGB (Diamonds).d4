<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LS-1010 RGB (Diamonds)" ShortName="LS1010 RGB" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-04-17" Author="Nic Morris" Comment="Created (poor documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Pattern, Strobe" />
      <Function ID="2" Name="PRG Mode" Display="'PRG Mode'" Dmx="10~49" Update="Pattern, Strobe" />
      <Function ID="3" Name="ILD Mode" Display="'ILD Mode'" Dmx="50~99" Update="Pattern, Strobe" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="100~149" Update="Pattern, Strobe" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="150~199" Update="Pattern, Strobe" />
      <Function ID="6" Name="Manual" Display="'Manual'" Dmx="200~255" Update="Pattern, Strobe" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="PRG/ILD" ID="2" If="'Mode'==2||'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Select File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="PRG/ILD" ID="3" If="'Mode'==2||'Mode'==3" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Play File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Moving" Name="Pan Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="126~155" />
      <Function ID="3" Name="R-L" Display="'R-L %.f%%',0~100" Dmx="156~185" />
      <Function ID="4" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="186~225" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="226~245" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Tilt_Moving" Name="Tilt Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="126~155" />
      <Function ID="3" Name="R-L" Display="'R-L %.f%%',0~100" Dmx="156~185" />
      <Function ID="4" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="186~225" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="226~245" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~87" />
      <Function ID="3" Name="Zm In" Display="'Zm In %.f%%',0~100" Dmx="88~150" />
      <Function ID="4" Name="Zm Out" Display="'Zm Out %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Repeat Zm" Display="'Repeat Zm %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Pan_Rot" Name="Pan Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',100.0~0.0" Dmx="1~128" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Tilt_Rot" Name="Tilt Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',100.0~0.0" Dmx="1~128" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Centre_Rot" Name="Centre Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',100.0~0.0" Dmx="1~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~129" />
    </Attribute>
    <Attribute ID="Slow_Drawing" Name="Slow Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="12~74" />
      <Function ID="3" Name="Auto S-F" Display="'Auto S-F %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Auto F-S" Display="'Auto F-S %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Repeat Slow" Display="'Repeat Slow %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Repeat S-F" Display="'Repeat S-F %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Repeat F-S" Display="'Repeat F-S %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Pan_Wave" Name="Pan Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="11~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Tilt_Wave" Name="Tilt Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="11~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Light Spot" Display="'Light Spot'" Dmx="64~127" />
      <Function ID="3" Name="Division" Display="'Division'" Dmx="128~191" />
      <Function ID="4" Name="Spot" Display="'Spot'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="WRGB Division" Display="'WRGB Division'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="BYPC Division" Display="'BYPC Division'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="WRGBYPC Division" Display="'WRGBYPC Division'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="WRGB Flow" Display="'WRGB Flow'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="BYPC Flow" Display="'BYPC Flow'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="WRGBYPC Flow" Display="'WRGBYPC Flow'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Breakpoint" Display="'Breakpoint'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX" Channels="17">
    <Import PearlRef="AMEL1010" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Strobe" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan_Moving" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Tilt_Moving" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="49" />
      <Attribute ID="Pan_Rot" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Tilt_Rot" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Centre_Rot" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Slow_Drawing" ChannelOffset="10" Wheel="5" />
      <Attribute ID="Pan_Wave" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Tilt_Wave" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Show" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="15" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="16" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="17" Wheel="12" />
    </Include>
  </Mode>
</Fixture>
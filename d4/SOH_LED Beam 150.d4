        <Swatch>7e316bb0-bc80-4fa1-b7e8-0ec7a5ca1ece</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="120~129" WheelPosition="5">
        <Swatch>e102a046-7e5b-4643-b4ab-d30316aa0427</Swatch>

      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="110~119" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>2803d645-9fc1-4a4d-9edd-6ba2b5e5e7fc</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="120~129" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6950b272-59fb-46a9-89b4-45e1f06333f5</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="130~139" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">

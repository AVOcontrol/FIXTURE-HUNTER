<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Beam 150" ShortName="LED Bm 150" Company="SOH">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="12-08-17" Author="Novas" Comment="Created" />
  <History Date="08-05-18" Author="Nic Morris" Comment="Standardised conditionals.  Added Gobo2Func.  Fixed highlight/lowlight.  Fixed split colour function names." />
  <History Date="08-05-18" Author="Nic Morris" Comment="Fixed duplicate functions in else conditions.  Fixed function index.  Fixed gobo rot function names." />
  <History Date="08-05-18" Author="Nic Morris" Comment="Recreated palettes.  Recreated macros.  Fixed prism rot power on and locate." />
  <History Date="09-05-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="09-05-18" Author="Nic Morris" Comment="Added gobo swatches" />
  <History Date="09-05-18" Author="Nic Morris" Comment="Fixed gobo 1 function index." />
  <Manual Filename="LED Beam 150" Summary="" />
  <AtlaBase TypeID="c80b0268-9098-4059-9548-6c798c6cb87b" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~39" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~55" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~71" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Lavender" Display="'Lavender'" Dmx="80~87" WheelPosition="5" Colour="255,128,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="96~103" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="112~119" WheelPosition="7" Colour="255,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="128~135" WheelPosition="8" Colour="0,255,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="8~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="24~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="40~47" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="56~63" WheelPosition="3" Colour="0,0,255" />
      <Function ID="14" Name="Grn/ Lav" Display="'Grn/ Lav'" Dmx="72~79" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Lav/ Org" Display="'Lav/ Org'" Dmx="88~95" WheelPosition="5" Colour="255,128,255" />
      <Function ID="16" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="104~111" WheelPosition="6" Colour="255,128,0" />
      <Function ID="17" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="120~127" WheelPosition="7" Colour="255,0,255" />
      <Function ID="18" Name="Cy/ Op" Display="'Cy/ Op'" Dmx="136~143" WheelPosition="8" Colour="0,255,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="144~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="104~107" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="251~192" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="108~149" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="150~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>46867c8e-0e52-4b5e-a8df-20ce4fb7938a</Swatch>

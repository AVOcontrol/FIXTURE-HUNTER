<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="intelliFLEX" ShortName="LI intFlex" Company="Light Initiative">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="09-03-12" Author="Peter Budd" Comment="Created" />
  <History Date="15-11-12" Author="Peter Budd" Comment="Updated to include 20 channel mode" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Cell 1 Dim" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer2" Name="Cell 2 Dim" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" />
      <Function ID="2" Name="1 Colour" Display="'1 Colour'" Dmx="26~41" />
      <Function ID="3" Name="2 Colour" Display="'2 Colour'" Dmx="42~51" />
      <Function ID="4" Name="Trace-Colour" Display="'Trace-Colour'" Dmx="52~76" />
      <Function ID="5" Name="Trace-Delay" Display="'Trace-Delay'" Dmx="77~102" />
      <Function ID="6" Name="Trace-Tears1" Display="'Trace-Tears1'" Dmx="103~127" />
      <Function ID="7" Name="Trace-Tears2" Display="'Trace-Tears2'" Dmx="128~153" />
      <Function ID="8" Name="tri-RGB" Display="'tri-RGB'" Dmx="154~169" />
      <Function ID="9" Name="tri-GBR" Display="'tri-GBR'" Dmx="170~179" />
      <Function ID="10" Name="tri-BRG" Display="'tri-BRG'" Dmx="180~189" />
      <Function ID="11" Name="tri-RBG" Display="'tri-RBG'" Dmx="190~199" />
      <Function ID="12" Name="trie-GRB" Display="'trie-GRB'" Dmx="200~209" />
      <Function ID="13" Name="Scatter" Display="'Scatter'" Dmx="210~219" />
      <Function ID="14" Name="Sweep" Display="'Sweep'" Dmx="220~254" />
      <Function ID="15" Name="RSweep" Display="'RSweep'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Size" Name="Effect Size" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Dir" Name="Effect Dir" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~63" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="64~127" />
      <Function ID="3" Name="Mirror Out" Display="'Mirror Out'" Dmx="128~191" />
      <Function ID="4" Name="Mirror In" Display="'Mirror In'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Effect_Decay" Name="Effect Decay" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Decay" Display="'Decay %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Attack" Name="Effect Attack" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Snap Off" Display="'Snap Off'" Dmx="0~0" />
      <Function ID="2" Name="Decay Off" Display="'Decay Off'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect_Off" Name="Effect Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'Offset %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Len" Name="Effect Length" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Length" Display="'Length %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Den" Name="Effect Density" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Density" Display="'Density %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full" Display="'Full'" Dmx="0~0" />
      <Function ID="2" Name="Half" Display="'Half'" Dmx="1~63" />
      <Function ID="3" Name="Quarter" Display="'Quarter'" Dmx="64~127" />
      <Function ID="4" Name="Eigth" Display="'Eigth'" Dmx="128~195" />
      <Function ID="5" Name="Sixteenth" Display="'Sixteenth'" Dmx="196~254" />
      <Function ID="6" Name="1/32" Display="'1/32'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect2" Name="Effect Fan" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'Fan %.f%%',0~100" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX, 8bit" Channels="18">

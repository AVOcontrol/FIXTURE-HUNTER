  <Mode Name="16 DMX" Channels="16" Id="2b08014e-c604-4c2f-a3d6-0bec22e0a868">
    <Import PearlRef="UKXMN260" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="269cca47-2f01-4ba2-9e78-6935ac4a0aed" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />

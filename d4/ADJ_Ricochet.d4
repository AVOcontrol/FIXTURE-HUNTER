  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="2" Name="Shake" Display="'Shake %.2f%%',0.00~100.00" Dmx="32896~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

      <Function ID="14" Name="Yel/ Org" Display="'Yel/ Org'" Dmx="88~88" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="Org/ Cgo" Display="'Org/ Cgo'" Dmx="104~104" WheelPosition="6" Colour="255,100,0" />

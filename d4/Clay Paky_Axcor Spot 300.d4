<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Axcor Spot 300" ShortName="AxcrSp 300" Company="Clay Paky" Version="15">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>31cb4f87-44cd-4951-ac1f-be6c4f9ee3b8</Thumbnail>
  <History Date="21-12-16" Author="Nic Morris" Comment="Created (prelim - attributes only)" Version="1" />
  <History Date="25-01-17" Author="Nic Morris" Comment="Updated with function ranges." Version="2" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed Blade All Rot to locate at 50% and inverted Iris in response to customer request (non-standard implementation)." Version="3" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added 'Uniform Beam' channel and revised frost channels to single ranges and renamed in line with 03/2017 charts." Version="4" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Swapped CW and CCW prism spin ranges in line with 03/2017 charts." Version="5" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Revised Colour names, ranges and Anim Rot ranges in line with 03/2017 charts." Version="6" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed animation function to variable range in attempt to fix customer bug report." Version="7" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised blade assignment in line with Capture." Version="8" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Unified macros across product range." Version="9" />
  <History Date="07-04-17" Author="Nic Morris" Comment="Changed colour index to discreet functions in line with other products in range." Version="10" />
  <History Date="08-04-17" Author="Nic Morris" Comment="Created from Clay Paky Scenius Unico (note Draft charts - assumed colour ranges the same)" Version="11" />
  <History Date="05-12-17" Author="Nic Morris" Comment="Created from Clay Paky Axcor Profile 900 (note prelim docs)." Version="12" />
  <History Date="08-12-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's (note no personality ID's but should be ok as only one mode)" Version="14" />
  <History Date="10-06-22" Author="Nic Morris" Comment="Added gobo swatches" Version="15" />

      <Condition Name="Prism_Ind_Func" ID="1,2,3,4,5" If="'Effect_Func'==1||'Effect_Func'==2" />
      <Condition Name="Frost_Func" ID="6,7" If="'Effect_Func'==3" />
      <Condition Name="Raw_Func" ID="8" If="'Effect_Func'==4" />
      <Else ID="1,2,3,4,5,6,7,8" />

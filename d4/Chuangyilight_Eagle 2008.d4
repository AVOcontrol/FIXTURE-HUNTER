      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="80~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 4" Display="'Gobo 4'" Dmx="100~119" GoboSpin="0~0" GoboOrientation="0~0" />

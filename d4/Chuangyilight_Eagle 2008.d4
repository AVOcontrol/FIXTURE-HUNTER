      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Purple" Display="'Purple'" Dmx="154~162" Colour="128,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="163~170" Colour="0,255,0" />
      <Function ID="5" Name="Deep Yellow" Display="'Yellow'" Dmx="171~177" Colour="180,180,0" />
      <Function ID="6" Name="Dark Blue" Display="'Deep Blue'" Dmx="178~184" Colour="0,0,180" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="185~191" Colour="255,0,0" />

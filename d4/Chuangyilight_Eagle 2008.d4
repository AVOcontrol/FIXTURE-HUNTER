      <Function ID="1" Name="Prism_Ind_Func" Display="'Prism Index'" Dmx="0~0" Update="Effect, Effect_Rot" />
      <Function ID="2" Name="Prism_Spin_Func" Display="'Prism Spin'" Dmx="0~0" Update="Effect, Effect_Rot" />

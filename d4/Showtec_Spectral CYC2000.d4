  <AtlaBase TypeID="2923fd09-9545-47ba-9d64-a3e815cecfa3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;16" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Fan OFF" Display="'Fan OFF'" Dmx="11~20" Update="Red, Green" />
      <Function ID="3" Name="Fan LOW" Display="'Fan LOW'" Dmx="21~30" Update="Red, Green" />
      <Function ID="4" Name="Fan HIGH" Display="'Fan HIGH'" Dmx="31~40" Update="Red, Green" />
      <Function ID="5" Name="Fan NORM" Display="'Fan NORM'" Dmx="41~50" Update="Red, Green" />
      <Function ID="6" Name="Fan AUTO" Display="'Fan AUTO'" Dmx="51~60" Update="Red, Green" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="61~70" Update="Red, Green" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="71~80" Update="Red, Green" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="81~90" Update="Red, Green" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="91~100" Update="Red, Green" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="101~110" Update="Red, Green" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="111~120" Update="Red, Green" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="121~130" Update="Red, Green" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="131~140" Update="Red, Green" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="141~150" Update="Red, Green" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="151~160" Update="Red, Green" />
      <Function ID="17" Name="Custom 1" Display="'Custom 1'" Dmx="161~170" Update="Red, Green" />
      <Function ID="18" Name="Custom 2" Display="'Custom 2'" Dmx="171~180" Update="Red, Green" />
      <Function ID="19" Name="Custom 3" Display="'Custom 3'" Dmx="181~190" Update="Red, Green" />
      <Function ID="20" Name="Custom 4" Display="'Custom 4'" Dmx="191~200" Update="Red, Green" />
      <Function ID="21" Name="Custom 5" Display="'Custom 5'" Dmx="201~210" Update="Red, Green" />
      <Function ID="22" Name="Custom 6" Display="'Custom 6'" Dmx="211~220" Update="Red, Green" />
      <Function ID="23" Name="Custom 7" Display="'Custom 7'" Dmx="221~230" Update="Red, Green" />
      <Function ID="24" Name="Custom 8" Display="'Custom 8'" Dmx="231~240" Update="Red, Green" />

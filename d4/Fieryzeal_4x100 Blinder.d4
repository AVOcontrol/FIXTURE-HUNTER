<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="4x100 Blinder" ShortName="4x100Blind" Company="Fieryzeal" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="13-08-25" Author="Nic Morris" Comment="Created (12 channel mode charts only.  effect ranges not documentation properly and don't make sense.  no pixel layout.  guessed)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="10~19" Update="Auto_Spd" />
      <Function ID="3" Name="Breathing Effect" Display="'Breathing Effect'" Dmx="20~29" Update="Auto_Spd" />
      <Function ID="4" Name="Jumping Effect" Display="'Jumping Effect'" Dmx="30~39" Update="Auto_Spd" />
      <Function ID="5" Name="Gradual Effect" Display="'Gradual Effect'" Dmx="40~49" Update="Auto_Spd" />
      <Function ID="6" Name="Pulse Effect" Display="'Pulse Effect'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="7" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="60~249" Update="Auto_Spd" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="250~252" Update="Auto_Spd" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="253~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Colour" ID="2" If="'Auto'==2" />
      <Condition Name="Effect" ID="3" If="'Auto'&gt;7" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="a9575d13-a986-49cf-9370-1d1426750c0a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="WarmWhite" Wheel="10" />
        <Attribute ID="White" Wheel="11" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Auto" ChannelOffset="11" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="12" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="9" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True" Id="67089b6c-2fd1-41ef-a8f5-7ee358f88798">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
</Fixture>
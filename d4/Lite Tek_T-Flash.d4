    </Attribute>
    <Attribute ID="Beam_Shutter" Name="Beam Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Flash 1" Display="'Flash 1'" Dmx="6~42" />
      <Function ID="3" Name="Flash 2" Display="'Flash 2'" Dmx="43~85" />
      <Function ID="4" Name="Flash 3" Display="'Flash 3'" Dmx="86~128" />
      <Function ID="5" Name="Flash 4" Display="'Flash 4'" Dmx="129~171" />
      <Function ID="6" Name="Flash 5" Display="'Flash 5'" Dmx="172~214" />
      <Function ID="7" Name="Flash 6" Display="'Flash 6'" Dmx="215~255" />

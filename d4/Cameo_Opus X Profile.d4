      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="34695~34695" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Congo Blue" Display="'Congo Blue'" Dmx="41634~41634" WheelPosition="6" Colour="180,0,255" />
      <Function ID="8" Name="Op - D Rd" Display="'Op - D Rd %.2f%%',0.00~100.00" Dmx="0~6939" WheelPosition="0" Colour="255,255,255" />

    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="6939~6939" WheelPosition="1" Colour="200,0,0" />
      <Function ID="3" Name="Medium Blue" Display="'Medium Blue'" Dmx="13878~13878" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Deep Green" Display="'Deep Green'" Dmx="20817~20817" WheelPosition="3" Colour="0,200,0" />

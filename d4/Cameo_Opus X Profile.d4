      <Function ID="11" Name="D Grn - Lav" Display="'D Grn - Lav %.2f%%',0.00~100.00" Dmx="20817~27756" WheelPosition="3" Colour="0,200,0" />
      <Function ID="12" Name="Lav - Amb" Display="'Lav - Amb %.2f%%',0.00~100.00" Dmx="27756~34695" WheelPosition="4" Colour="255,128,255" />
      <Function ID="13" Name="Amb - C Blu" Display="'Amb - C Blu %.2f%%',0.00~100.00" Dmx="34695~41634" WheelPosition="5" Colour="255,100,0" />
      <Function ID="14" Name="C Blu - Op" Display="'C Blu - Op %.2f%%',0.00~100.00" Dmx="41634~49087" WheelPosition="6" Colour="180,0,255" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="57568~57568" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="49344~57311" Colour="0,0,0" />

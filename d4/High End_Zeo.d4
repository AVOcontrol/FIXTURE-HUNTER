    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="REV +" Display="'REV + %.f%%',100~0" Dmx="0~62" />
      <Function ID="2" Name="REV x1" Display="'REV x1'" Dmx="63~63" />
      <Function ID="3" Name="REV -" Display="'REV - %.f%%',0~100" Dmx="64~126" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="5" Name="FWD -" Display="'FWD - %.f%%',100~0" Dmx="129~191" />
      <Function ID="6" Name="FWD x1" Display="'FWD x1'" Dmx="192~192" />
      <Function ID="7" Name="FWD +" Display="'FWD + %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Macro_xFade" Name="Macro xFade" Description="" Group="E">
      <Locate Locate="2:50" PowerOn="2:50" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="xFade" Display="'xFade %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Macro_nShot" Name="Macro nShot" Description="" Group="E">
      <Locate Locate="7" PowerOn="7" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="1 Shot" Display="'1 Shot'" Dmx="1~9" />
      <Function ID="3" Name="2 Shot" Display="'2 Shot'" Dmx="10~19" />
      <Function ID="4" Name="3 Shot" Display="'3 Shot'" Dmx="20~29" />
      <Function ID="5" Name="4 Shot" Display="'4 Shot'" Dmx="30~39" />
      <Function ID="6" Name="5 Shot" Display="'5 Shot'" Dmx="40~49" />
      <Function ID="7" Name="Continuous Run" Display="'Continuous Run'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="mSpeed" Name="mSpeed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Fan_Speed" Name="Fan Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Idle" Display="'Idle'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~215" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="216~225" />
      <Function ID="4" Name="Studio" Display="'Studio'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display Off" Display="'Display Off'" Dmx="20~29" />
      <Function ID="3" Name="Display On" Display="'Display On'" Dmx="30~39" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="50~59" />
      <Function ID="5" Name="Shutdown" Display="'Shutdown'" Dmx="60~69" />
      <Function ID="6" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="70~79" />
      <Function ID="7" Name="Red Shift On" Display="'Red Shift On'" Dmx="80~89" />
      <Function ID="8" Name="LED PWM 2.4kHz" Display="'LED PWM 2.4kHz'" Dmx="90~99" />
      <Function ID="9" Name="LED PWM 16kHz" Display="'LED PWM 16kHz'" Dmx="100~109" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Blue" ID="2" If="'Colour_Mode'==3||'Colour_Mode'==4||'Colour_Mode'==9||'Colour_Mode'==10" />
      <Condition Name="Green" ID="3" If="'Colour_Mode'==5||'Colour_Mode'==6||'Colour_Mode'==11||'Colour_Mode'==12" />
      <Condition Name="Speed" ID="4" If="'Colour_Mode'==13||'Colour_Mode'==14" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="3" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Blue" ID="2" If="'Colour_Mode'==2||'Colour_Mode'==6||'Colour_Mode'==8||'Colour_Mode'==12" />
      <Condition Name="Red" ID="3" If="'Colour_Mode'==3||'Colour_Mode'==5||'Colour_Mode'==9||'Colour_Mode'==11" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="3" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Else ID="1" />
      <Condition Name="Green" ID="2" If="'Colour_Mode'==2||'Colour_Mode'==3||'Colour_Mode'==8||'Colour_Mode'==9" />
      <Condition Name="Red" ID="3" If="'Colour_Mode'==4||'Colour_Mode'==6||'Colour_Mode'==10||'Colour_Mode'==12" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="3" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CT" Name="CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2400~9000" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Continuous (Dim Tracking)" Display="'Continuous (Dim Tracking)'" Dmx="0~0" />
      <Function ID="2" Name="Strobe (Dim Tracking)" Display="'Strobe (Dim Tracking) %.f%%',0~100" Dmx="16~41" />
      <Function ID="3" Name="Rnd Strobe (Dim Tracking)" Display="'Rnd Strobe (Dim Tracking) %.f%%',0~100" Dmx="42~67" />
      <Function ID="4" Name="Continuous (Dim Independent)" Display="'Continuous (Dim Independent)'" Dmx="128~143" />
      <Function ID="5" Name="Strobe (Dim Independent)" Display="'Strobe (Dim Independent) %.f%%',0~100" Dmx="144~169" />
      <Function ID="6" Name="Rnd Strobe (Dim Independent)" Display="'Rnd Strobe (Dim Independent) %.f%%',0~100" Dmx="170~195" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

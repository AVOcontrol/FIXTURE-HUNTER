    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" />
      <Function ID="4" Name="Pulse (White)" Display="'Pulse (White)'" Dmx="96~127" />
      <Function ID="5" Name="Col Fading" Display="'Col Fading'" Dmx="128~159" />
      <Function ID="6" Name="Pulse (Colours)" Display="'Pulse (Colours)'" Dmx="160~191" />
      <Function ID="7" Name="Col Changing" Display="'Col Changing'" Dmx="192~223" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Dimmer 0 (fast)" Display="'Dimmer 0 (fast)'" Dmx="6~55" />
      <Function ID="3" Name="Dimmer 1" Display="'Dimmer 1'" Dmx="56~105" />
      <Function ID="4" Name="Dimmer 2" Display="'Dimmer 2'" Dmx="106~155" />
      <Function ID="5" Name="Dimmer 3" Display="'Dimmer 3'" Dmx="156~205" />
      <Function ID="6" Name="Dimmer 4 (slow)" Display="'Dimmer 4 (slow)'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="190~190" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="191~200" />
    </Attribute>
  </Control>

      <Function ID="13" Name="Y Grn/ Org" Display="'Y Grn/ Org'" Dmx="18504~20303" WheelPosition="4" Colour="180,180,0" />
      <Function ID="14" Name="Org/ Ppl" Display="'Org/ Ppl'" Dmx="22616~24415" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Ppl/ L Blu" Display="'Ppl/ L Blu'" Dmx="26728~28527" WheelPosition="6" Colour="128,0,255" />

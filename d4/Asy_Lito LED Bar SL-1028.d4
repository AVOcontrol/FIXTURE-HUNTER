  <AtlaBase TypeID="5d186b80-a3a7-40ae-81d0-90d89b48991b" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~10" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="11~51" />

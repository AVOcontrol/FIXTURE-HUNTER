      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Full Colour" Display="'Full Colour'" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="BG_Col" Name="BG Col" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="80~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />

    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="32~47" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="48~63" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3'" Dmx="64~79" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Pattern 4" Display="'Pattern 4'" Dmx="80~95" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Pattern 5" Display="'Pattern 5'" Dmx="96~111" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Pattern 6" Display="'Pattern 6'" Dmx="112~127" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="128~143" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="144~159" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="160~175" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~191" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Pattern 11" Display="'Pattern 11'" Dmx="192~207" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Pattern 12" Display="'Pattern 12'" Dmx="208~223" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Pattern 13" Display="'Pattern 13'" Dmx="224~239" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Pattern 14" Display="'Pattern 14'" Dmx="240~255" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Spd" Name="Patt Spd" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Effect" ID="2,3,4,5" If="'Pattern'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~131" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

    </Attribute>
    <Attribute ID="Main_Shutter" Name="Main Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="10~19" />

  <AtlaBase TypeID="f41b9b2d-e390-4455-b6a4-fbbc5368e20c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="Indigo" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Indigo C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="241~254" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Dark" Display="'Dark %.f%%',0~100" Dmx="1~40" />
      <Function ID="4" Name="Bright" Display="'Bright %.f%%',0~100" Dmx="41~80" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="81~120" />
      <Function ID="7" Name="Flicker" Display="'Flicker %.f%%',0~100" Dmx="161~200" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~19" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="20~249" />
    </Attribute>
    <Attribute ID="Curve" Name="Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Incandescent" Display="'Incandescent'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~19" />
      <Function ID="3" Name="Incandescent Red Shift" Display="'Incandescent Red Shift'" Dmx="20~29" />
      <Function ID="4" Name="Linear Red Shift" Display="'Linear Red Shift'" Dmx="30~39" />
      <Function ID="5" Name="Quick" Display="'Quick'" Dmx="40~49" />
      <Function ID="6" Name="Quick Linear" Display="'Quick Linear'" Dmx="50~59" />
      <Function ID="7" Name="Unregulated" Display="'Unregulated'" Dmx="60~69" />
      <Function ID="8" Name="Standard" Display="'Standard'" Dmx="70~79" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1900-5975" Display="'1900-5975 %.2fK',1900.00~5975.00" Dmx="257~42148" Colour="255,240,200" />
      <Function ID="3" Name="6000-10450" Display="'6000-10450 %.2fK',6000.00~10450.00" Dmx="42405~65278" Colour="255,240,200" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="65535~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Green" Display="'Full Green'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="3" Name="+ Green" Display="'+ Green %.1f',10.0~0.0" Dmx="2~127" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="5" Name="+ Magenta" Display="'+ Magenta %.1f',0.0~10.0" Dmx="129~254" Colour="0,0,0" />
      <Function ID="6" Name="Full Magenta" Display="'Full Magenta'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tune" Name="Tune" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Spot" Display="'Full Spot'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="3" Name="Spot-&gt;Flood" Display="'Spot-&gt;Flood %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
      <Function ID="4" Name="Full Flood" Display="'Full Flood'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
  </Control>

  <Macro>
    <Macro Name="Lamp Off (1)">
      <Set Channel="Lamp:2,Control:2" Delay="6000" />
      <Set Channel="Lamp:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (1)">
      <Set Channel="Lamp:3,Control:3" Delay="6000" />
      <Set Channel="Lamp:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off (2)">
      <Set Channel="Reset:3,Control:5" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (2)">
      <Set Channel="Reset:4,Control:6" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2,Control:4" Delay="6000" />
      <Set Channel="Reset:1,Control:1" Delay="0" />
    </Macro>
  </Macro>

      <Function ID="5" Name="White" Display="'White'" Dmx="60~60" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="70~70" Colour="255,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="80~80" Colour="255,150,150" />
      <Function ID="8" Name="Spin" Display="'Spin'" Dmx="90~90" Colour="255,255,255" />
      <Function ID="9" Name="2x Spin" Display="'2x Spin'" Dmx="100~100" Colour="255,255,255" />
      <Function ID="10" Name="3x" Display="'3x'" Dmx="110~110" Colour="255,255,255" />
      <Function ID="11" Name="2- x2" Display="'2- x2'" Dmx="120~120" Colour="255,255,255" />
      <Function ID="12" Name="2x Dif Col" Display="'2x Dif Col'" Dmx="130~130" Colour="255,255,255" />
      <Function ID="13" Name="3x Spin" Display="'3x Spin'" Dmx="140~140" Colour="255,255,255" />
      <Function ID="14" Name="3x Dif Col" Display="'3x Dif Col'" Dmx="150~150" Colour="255,255,255" />
      <Function ID="15" Name="2x Spin" Display="'2x Spin'" Dmx="160~160" Colour="255,255,255" />
      <Function ID="16" Name="Half Colour" Display="'Half Colour'" Dmx="170~170" Colour="255,255,255" />
      <Function ID="17" Name="Tri Colour" Display="'Tri Colour'" Dmx="180~180" Colour="255,255,255" />
      <Function ID="18" Name="Bi Colour" Display="'Bi Colour'" Dmx="190~190" Colour="255,255,255" />
      <Function ID="19" Name="Uni Colour" Display="'Uni Colour'" Dmx="200~200" Colour="255,255,255" />
      <Function ID="20" Name="3x Colour" Display="'3x Colour'" Dmx="210~210" Colour="255,255,255" />
      <Function ID="21" Name="Half Colour" Display="'Half Colour'" Dmx="220~220" Colour="255,255,255" />
      <Function ID="22" Name="2x1" Display="'2x1'" Dmx="230~230" Colour="255,255,255" />
      <Function ID="23" Name="2x1b" Display="'2x1b'" Dmx="240~240" Colour="255,255,255" />
      <Function ID="24" Name="2x" Display="'2x'" Dmx="250~250" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Spin Right" Display="'Spin Right'" Dmx="10~10" Colour="255,255,255" />

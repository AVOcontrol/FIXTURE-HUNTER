      <Function ID="4" Name="Spin Together" Display="'Spin Together'" Dmx="60~60" Colour="255,255,255" />
      <Function ID="5" Name="Spin Apart" Display="'Spin Apart'" Dmx="80~80" Colour="255,255,255" />
      <Function ID="6" Name="Right Only R" Display="'Right Only R'" Dmx="120~120" Colour="255,255,255" />

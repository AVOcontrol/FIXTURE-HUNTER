      <Function ID="22" Name="Snake" Display="'Snake'" Dmx="230~230" />
      <Function ID="23" Name="2x Snake" Display="'2x Snake'" Dmx="240~240" />
      <Function ID="24" Name="2x" Display="'2x'" Dmx="250~250" />

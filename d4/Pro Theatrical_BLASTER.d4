      <Function ID="13" Name="3x Spin" Display="'3x Spin'" Dmx="140~140" />
      <Function ID="14" Name="3x Dif Col" Display="'3x Dif Col'" Dmx="150~150" />
      <Function ID="15" Name="2x Spin" Display="'2x Spin'" Dmx="160~160" />
      <Function ID="16" Name="Half Colour" Display="'Half Colour'" Dmx="170~170" />

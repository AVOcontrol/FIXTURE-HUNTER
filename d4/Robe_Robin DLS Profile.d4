<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin DLS Profile" ShortName="Robin DLS" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-08-11" Author="Nic Morris" Comment="Created" />
  <History Date="06-02-12" Author="Peter Budd" Comment="Edited checked personality for V1.0 fixture release, added ranges to control and macros." />
  <History Date="06-06-12" Author="Peter Budd" Comment="Edited updated to V1.1" />
  <History Date="15-08-12" Author="Peter Budd" Comment="Edited added V1.0 back in after requests from users." />
  <History Date="16-08-12" Author="Peter Budd" Comment="Created from Robin DLX Spot to v0.9 Spec" />
  <History Date="30-08-12" Author="Peter Budd" Comment="Updated due to change in Robe Spec" />
  <History Date="01-10-12" Author="Peter Budd" Comment="Fixed mode 1 channel order so focus works, and updated blade locate values." />
  <History Date="09-01-13" Author="Peter Budd" Comment="Edited changed name to DLS profile on customer request." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="29-05-13" Author="Peter Budd" Comment="Edited corrected mode names, and edited control, Gobo Rot and effect channels inline with specs." />
  <History Date="30-05-13" Author="Peter Budd" Comment="Corrected effect speed to locate to fastest." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-05-17" Author="Nic Morris" Comment="Changed Atlabase ID's to RGB versions.  Removed Gobo 2 update from Gobo Func." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Standardised Gobo ID's.  Added open gobo to shake conditions." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Fixed gobo rot no spin DMX range.  Simplified frost.  Recreated palettes." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Fixed control 8000K ON/OFF DMX values.  Revised blade macro functions." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Inverted zoom.  Fixed prism spin CW wheel direction.  " />
  <History Date="11-09-17" Author="Nic Morris" Comment="Revised blade names and ID's." />
  <History Date="23-10-17" Author="Nic Morris" Comment="Revised autofocus.  Unified attributes and functions across product range." />
  <History Date="24-10-17" Author="Nic Morris" Comment="Further unification across product range." />

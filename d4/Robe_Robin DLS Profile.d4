    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Fixed Spin" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Shake Index" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==3" />
      <Condition Name="Shake Spin" ID="25,26,27,28,29,30,31,32" If="'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="33,34,35,36" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Random" ID="37,38,39" If="'Gobo1Func'==7||'Gobo1Func'==8" />
      <Else ID="40" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2bfb8e49-aba0-4736-b6ab-24ff14dc6585" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CT" Name="CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2700~6500" Dmx="51~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CT1" Name="CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="77~101" Colour="255,255,255" />
      <Function ID="3" Name="White 3000K" Display="'White 3000K'" Dmx="102~127" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="128~152" Colour="255,255,255" />
      <Function ID="5" Name="White 4200K" Display="'White 4200K'" Dmx="153~178" Colour="255,255,255" />
      <Function ID="6" Name="White 5600K" Display="'White 5600K'" Dmx="179~203" Colour="255,255,255" />
      <Function ID="7" Name="White 6000K" Display="'White 6000K'" Dmx="204~229" Colour="255,255,255" />
      <Function ID="8" Name="White 6500K" Display="'White 6500K'" Dmx="230~255" Colour="255,255,255" />
    </Attribute>
  </Control>

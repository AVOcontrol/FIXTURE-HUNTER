  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-10-19" Author="Nic Morris" Comment="Changed Atlabase model ID to original version (previously was ALC4-2)" />
  <History Date="28-10-19" Author="Nic Morris" Comment="Added product thumbnail.  Revised mode to match CT 7-Presets and CT Linear options." />

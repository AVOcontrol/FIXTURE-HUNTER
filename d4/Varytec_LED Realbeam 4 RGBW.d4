      <Function ID="21" Name="L105" Display="'L105'" Dmx="80~83" />
      <Function ID="22" Name="L107" Display="'L107'" Dmx="84~87" />
      <Function ID="23" Name="L111" Display="'L111'" Dmx="88~91" />
      <Function ID="24" Name="L113" Display="'L113'" Dmx="92~95" />
      <Function ID="25" Name="L115" Display="'L115'" Dmx="96~99" />
      <Function ID="26" Name="L116" Display="'L116'" Dmx="100~103" />
      <Function ID="27" Name="L119" Display="'L119'" Dmx="104~107" />
      <Function ID="28" Name="L128" Display="'L128'" Dmx="108~111" />
      <Function ID="29" Name="L132" Display="'L132'" Dmx="112~115" />
      <Function ID="30" Name="L134" Display="'L134'" Dmx="116~119" />
      <Function ID="31" Name="L135" Display="'L135'" Dmx="120~123" />
      <Function ID="32" Name="L136" Display="'L136'" Dmx="124~127" />
      <Function ID="33" Name="L147" Display="'L147'" Dmx="128~131" />
      <Function ID="34" Name="L180" Display="'L180'" Dmx="132~135" />
      <Function ID="35" Name="L156" Display="'L156'" Dmx="136~139" />
      <Function ID="36" Name="L79" Display="'L79'" Dmx="140~143" />
      <Function ID="37" Name="L194" Display="'L194'" Dmx="144~147" />
      <Function ID="38" Name="L24" Display="'L24'" Dmx="148~151" />
      <Function ID="39" Name="L017" Display="'L017'" Dmx="152~155" />
      <Function ID="40" Name="L19" Display="'L19'" Dmx="156~159" />
      <Function ID="41" Name="L108" Display="'L108'" Dmx="160~163" />
      <Function ID="42" Name="L126" Display="'L126'" Dmx="164~167" />

      <Function ID="55" Name="Dream 22" Display="'Dream 22'" Dmx="224~234" />
      <Function ID="56" Name="Dream 23" Display="'Dream 23'" Dmx="235~244" />
      <Function ID="57" Name="Dream 24" Display="'Dream 24'" Dmx="245~255" />
      <Function ID="58" Name="Sound 1" Display="'Sound 1'" Dmx="0~0" />
      <Function ID="59" Name="Sound 2" Display="'Sound 2'" Dmx="11~20" />
      <Function ID="60" Name="Sound 3" Display="'Sound 3'" Dmx="21~31" />
      <Function ID="61" Name="Sound 4" Display="'Sound 4'" Dmx="32~42" />
      <Function ID="62" Name="Sound 5" Display="'Sound 5'" Dmx="43~52" />
      <Function ID="63" Name="Sound 6" Display="'Sound 6'" Dmx="53~63" />
      <Function ID="64" Name="Sound 7" Display="'Sound 7'" Dmx="64~74" />
      <Function ID="65" Name="Sound 8" Display="'Sound 8'" Dmx="75~84" />
      <Function ID="66" Name="Sound 9" Display="'Sound 9'" Dmx="85~95" />
      <Function ID="67" Name="Sound 10" Display="'Sound 10'" Dmx="96~106" />
      <Function ID="68" Name="Sound 11" Display="'Sound 11'" Dmx="107~117" />

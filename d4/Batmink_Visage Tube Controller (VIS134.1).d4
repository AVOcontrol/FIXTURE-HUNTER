      <Function ID="33" Name="Jump 24" Display="'Jump 24'" Dmx="245~255" />
      <Function ID="34" Name="Dream 1" Display="'Dream 1'" Dmx="0~0" />
      <Function ID="35" Name="Dream 2" Display="'Dream 2'" Dmx="11~20" />
      <Function ID="36" Name="Dream 3" Display="'Dream 3'" Dmx="21~31" />

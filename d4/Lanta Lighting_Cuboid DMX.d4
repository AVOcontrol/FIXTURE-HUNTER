<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Cuboid DMX" ShortName="Cuboid DMX" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="29-11-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="16" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="50~59" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Light Red" Display="'Light Red'" Dmx="70~79" Colour="255,100,100" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="80~89" Colour="0,255,255" />
      <Function ID="10" Name="Light Green" Display="'Light Green'" Dmx="90~99" Colour="128,255,0" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="100~109" Colour="0,128,255" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="Light Yellow" Display="'Yellow'" Dmx="120~129" Colour="255,255,128" />
      <Function ID="14" Name="Light Magenta" Display="'Light Magenta'" Dmx="130~139" Colour="255,128,255" />
      <Function ID="15" Name="Light Cyan" Display="'Cyan'" Dmx="140~149" Colour="128,255,255" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="Auto" Display="'Auto'" Dmx="160~229" Colour="0,0,0" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="230~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Motor1" Name="Motor 1" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="10~119" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="120~145" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="146~255" />
    </Attribute>
    <Attribute ID="Motor2" Name="Motor 2" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="10~119" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="120~145" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="146~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="LH_CuboidDX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Motor1" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Motor2" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
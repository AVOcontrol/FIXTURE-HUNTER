      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="126~134" Colour="0,0,0" />
      <Function ID="17" Name="Colour 16" Display="'Colour 16'" Dmx="135~143" Colour="0,0,0" />
      <Function ID="18" Name="Colour 17" Display="'Colour 17'" Dmx="144~152" Colour="0,0,0" />
      <Function ID="19" Name="Colour 18" Display="'Colour 18'" Dmx="153~161" Colour="0,0,0" />
      <Function ID="20" Name="Colour 19" Display="'Colour 19'" Dmx="162~170" Colour="0,0,0" />
      <Function ID="21" Name="Colour 20" Display="'Colour 20'" Dmx="171~179" Colour="0,0,0" />
      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="180~188" Colour="0,0,0" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="189~197" Colour="0,0,0" />

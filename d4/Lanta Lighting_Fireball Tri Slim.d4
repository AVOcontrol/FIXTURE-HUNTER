      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="207~215" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="216~224" Colour="0,0,0" />
      <Function ID="27" Name="Colour 26" Display="'Colour 26'" Dmx="225~233" Colour="0,0,0" />
      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="234~242" Colour="0,0,0" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="243~251" Colour="0,0,0" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="31" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="32" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="24~24" Update="Red" />
      <Function ID="3" Name="7 Col Gradient" Display="'7 Col Gradient'" Dmx="25~49" Update="Red" />
      <Function ID="4" Name="3 Col Gradient" Display="'3 Col Gradient'" Dmx="50~74" Update="Red" />
      <Function ID="5" Name="7 Col Hopping" Display="'7 Col Hopping'" Dmx="75~99" Update="Red" />
      <Function ID="6" Name="3 Col Hopping" Display="'3 Col Hopping'" Dmx="100~124" Update="Red" />
      <Function ID="7" Name="Fantasy 1" Display="'Fantasy 1'" Dmx="125~149" Update="Red" />
      <Function ID="8" Name="Fantasy 2" Display="'Fantasy 2'" Dmx="150~174" Update="Red" />
      <Function ID="9" Name="Red Gradient" Display="'Red Gradient'" Dmx="175~199" Update="Red" />
      <Function ID="10" Name="Green Gradient" Display="'Green Gradient'" Dmx="200~224" Update="Red" />
      <Function ID="11" Name="Blue Gradient" Display="'Blue Gradient'" Dmx="225~249" Update="Red" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="69~91" Colour="0,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="92~114" Colour="255,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="115~137" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="138~160" Colour="255,150,150" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="161~183" Colour="128,0,255" />
      <Function ID="10" Name="Dark Blue" Display="'Dark Blue'" Dmx="184~206" Colour="0,0,180" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="207~229" Colour="128,255,0" />
      <Function ID="12" Name="Light Blue" Display="'Light Blue'" Dmx="230~252" Colour="0,128,255" />
      <Function ID="13" Name="White" Display="'White'" Dmx="253~255" Colour="255,255,255" />
    </Attribute>
  </Control>

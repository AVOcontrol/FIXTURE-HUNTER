<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ColorPlayer 150 3G AWW" ShortName="CP1503GAWW" Company="Ayrton">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="10-01-11" Author="Nic Morris" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="19-04-17" Author="Nic Morris" Comment="Changed name from Colorplayer 150 3G RGBWW to Colorplayer 150 3G AWW" />
  <History Date="19-04-17" Author="Nic Morris" Comment="Revised amber and white to locate and power on at full.  Added Atlabase ID's." />
  <Manual Filename="http://www.ayrton.eu/files/supports/user_manual/Colorplayer_150_3G_manual_FR1.pdf" Summary="" />
  <RDM>
    <Device ManufacturerID="16761" ModelID="0" />
  </RDM>
  <AtlaBase TypeID="24d9e1b3-f3fd-456c-9c5d-635162b276c1" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~249" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="ATN_CP3GWW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ab8b13cc-8db6-411d-9c75-2602702bfc8c" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Amber" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">

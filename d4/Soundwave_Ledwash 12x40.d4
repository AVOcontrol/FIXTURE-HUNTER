  <History Date="18-01-24" Author="Nic Morris" Comment="Created from Viking Lighting VK740 Mk2 (identical except reset function range)" Version="2" />
  <History Date="26-03-24" Author="Nic Morris" Comment="Created from Pluslite EYE-PL740 (identical)" Version="3" />
  <History Date="27-03-24" Author="Nic Morris" Comment="Added missing Atlabase ID for 22 channel mode." Version="4" />

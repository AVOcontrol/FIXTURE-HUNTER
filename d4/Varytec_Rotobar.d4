  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="25-01-07" Author="D.Milligan" Comment="Created" />
  <History Date="03-05-07" Author="D.Milligan" Comment="Updated to latest Specs" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="12-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="29-11-12" Author="Peter Budd" Comment="Created from EasilyLED KiloLED" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />

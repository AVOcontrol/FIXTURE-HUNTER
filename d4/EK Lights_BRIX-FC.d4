    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="131~200" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="11~39" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="40~59" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="60~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Col Preset" Display="'Col Preset'" Dmx="80~99" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="HALO DWE" Display="'HALO DWE'" Dmx="100~119" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Colour1Func'==1" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Col Preset" ID="8" If="'Colour1Func'==5" />
      <Condition Name="HALO DWE" ID="9" If="'Colour1Func'==6" />
      <Else ID="10" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2000-3000K" Display="'%.fK',2000~3000" Dmx="0~223" Colour="255,255,255" />
      <Function ID="3" Name="3000-4000K" Display="'%.fK',3000~4000" Dmx="224~231" Colour="255,255,255" />
      <Function ID="4" Name="4000-5600K" Display="'%.fK',4000~5600" Dmx="232~239" Colour="255,255,255" />
      <Function ID="5" Name="5600-8000K" Display="'%.fK',5600~8000" Dmx="240~247" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="9" Name="Halo" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

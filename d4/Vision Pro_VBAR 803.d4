      <Function ID="5" Name="Green Col Dream" Display="'Green Col Dream'" Dmx="153~203" />
      <Function ID="6" Name="Blue Col Dream" Display="'Blue Col Dream'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

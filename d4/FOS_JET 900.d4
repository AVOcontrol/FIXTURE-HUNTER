  <Thumbnail>f8668ca4-c34a-4bb3-9e38-5d5bdc0a1249</Thumbnail>
  <History Date="12-08-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dfafaa98-eaa9-4e22-b0cb-3dad2dfae10c" />
  <Control>
    <Attribute ID="Dimmer" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~85" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="86~170" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="171~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Magenta" Display="'Magenta'" Dmx="6~85" Colour="255,0,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="86~170" Colour="255,255,0" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="171~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Random_Colour" Name="Random Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rnd Cols" Display="'Rnd Cols %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a9357ee5-e349-492f-8dba-438e4101d7d9" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Colour2" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Random_Colour" ChannelOffset="4" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Off" Number="1" Page="1" SetControl="Random_Colour:1,Colour1:1,Colour2:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour2:1,Random_Colour:1" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:2,Colour2:1,Random_Colour:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour2:3,Colour1:1,Random_Colour:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour2:1,Random_Colour:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour2:1,Random_Colour:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour2:1,Random_Colour:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour2:4,Colour1:1,Random_Colour:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour2:1,Random_Colour:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour2:1,Random_Colour:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4,Colour2:1,Random_Colour:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour2:2,Colour1:1,Random_Colour:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour2:1,Random_Colour:1" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour2:2,Colour1:1,Random_Colour:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour2:1,Random_Colour:1" />
    </Group>
  </Palettes>
  <swatchLibrary>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Indigo 5000" ShortName="Indigo5000" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="08-03-12" Author="Peter Budd" Comment="Created" />
  <History Date="19-10-12" Author="Peter Budd" Comment="Added preset palettes, and corrected gobo 2 scroll range." />
  <History Date="28-07-15" Author="Gregory Haynes" Comment="Added Highlight and Lowlight values." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="30~39" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="40~49" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~59" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="70~79" Colour="0,128,255" />
      <Function ID="9" Name="Lt Bl-&gt;Mg" Display="'Lt Bl-&gt;Mg %.f%%',0~100" Dmx="80~99" Colour="0,128,255" />
      <Function ID="10" Name="Mg-&gt;Or" Display="'Mg-&gt;Or %.f%%',0~100" Dmx="100~119" Colour="255,0,255" />
      <Function ID="11" Name="Or-&gt;Bl" Display="'Or-&gt;Bl %.f%%',0~100" Dmx="120~139" Colour="255,128,0" />
      <Function ID="12" Name="Bl-&gt;Yell" Display="'Bl-&gt;Yell %.f%%',0~100" Dmx="140~159" Colour="0,0,255" />
      <Function ID="13" Name="Yell-&gt;Grn" Display="'Yell-&gt;Grn %.f%%',0~100" Dmx="160~179" Colour="255,255,0" />
      <Function ID="14" Name="Grn-&gt;Rd" Display="'Grn-&gt;Rd %.f%%',0~100" Dmx="180~199" Colour="0,255,0" />
      <Function ID="15" Name="Rd-&gt;Op" Display="'Rd-&gt;Op %.f%%',0~100" Dmx="200~219" Colour="255,0,0" />
      <Function ID="16" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~9" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="16" If="'Gobo1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="11~20" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="21~30" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="31~40" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="41~50" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="51~60" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="61~70" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="71~80" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="81~95" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="96~110" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="111~125" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="126~140" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="141~155" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="156~170" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="171~185" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="186~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1" />
      <Condition Name="Shake" ID="8,9,10,11,12,13" If="'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="14" If="'Gobo2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="11~20" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="21~30" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="31~40" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="41~50" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="51~60" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="61~70" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="71~85" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="86~100" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="101~115" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="116~130" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="131~145" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="146~160" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="161~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~60" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="61~150" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="151~165" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="166~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="5~127" />
      <Function ID="3" Name="Prism" Display="'Prism'" Dmx="128~132" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="96~127" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="160~191" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~19" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="20~39" />
      <Function ID="3" Name="Disable BO on P/T" Display="'Disable BO on P/T'" Dmx="40~59" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~79" />
      <Function ID="5" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="6" Name="Fan Standard" Display="'Fan Standard'" Dmx="100~119" />
      <Function ID="7" Name="Fan High" Display="'Fan High'" Dmx="120~139" />
      <Function ID="8" Name="Macro 1" Display="'Macro 1'" Dmx="140~149" />
      <Function ID="9" Name="Macro 2" Display="'Macro 2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="180~189" />
      <Function ID="13" Name="Sound 2" Display="'Sound 2'" Dmx="190~199" />
      <Function ID="14" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="15" Name="Safe" Display="'Safe'" Dmx="220~235" />
      <Function ID="16" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="17" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="18" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="19" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="20" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX, 16bit" Channels="14">
    <Import PearlRef="SH_IN500014" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="12" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="13" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="8" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="9" Wheel="18" />
      <Attribute ID="Focus" ChannelOffset="11" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX, 8bit" Channels="11">
    <Import PearlRef="SH_IN500011" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="5" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="6" Wheel="18" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="9" Name="Gobo 1" Number="19" Page="1" SetControl="Gobo2:2,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="10" Name="Gobo 2" Number="20" Page="1" SetControl="Gobo2:3,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="11" Name="Gobo 3" Number="0" Page="1" SetControl="Gobo2:4,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="12" Name="Gobo 4" Number="0" Page="1" SetControl="Gobo2:5,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="13" Name="Gobo 5" Number="0" Page="1" SetControl="Gobo2:6,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="14" Name="Gobo 6" Number="0" Page="1" SetControl="Gobo2:7,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />

      <Function ID="13" Name="AutoFocus Med" Display="'AutoFocus Med'" Dmx="115~119" />
      <Function ID="14" Name="AutoFocus Far" Display="'AutoFocus Far'" Dmx="120~124" />
      <Function ID="15" Name="Full Power" Display="'Full Power'" Dmx="125~126" />

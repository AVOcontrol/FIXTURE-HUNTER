      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour2Func'==3" />
      <Condition Name="Random" ID="13,14,15,16" If="'Colour2Func'==4" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="121~126" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="127~132" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="133~138" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="139~144" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="145~150" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="151~156" Colour="0,0,0" />
      <Function ID="8" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~119" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="201~203" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="161~200" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="201~203" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="204~243" Colour="0,0,0" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="14" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="15" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="255,255,255" />
      <Function ID="16" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="255,255,255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

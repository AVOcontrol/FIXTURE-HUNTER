      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="68~77" WheelPosition="7">
        <Swatch>36212617-ed8e-4c47-a538-590c01a02f3c</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>f88b7fa0-ad2b-40a9-bdc4-1385daeeb3a8</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="78~87" WheelPosition="1">
        <Swatch>c8bd8d09-dc0e-46a9-a410-ba016913575c</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="88~97" WheelPosition="2">

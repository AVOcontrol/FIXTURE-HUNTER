        <Swatch>824f667c-b2d4-404e-a4f6-f9d7290dd6df</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="128~137" WheelPosition="6">
        <Swatch>0bdb3e2b-aa95-4618-a8e3-f4c6359975fe</Swatch>

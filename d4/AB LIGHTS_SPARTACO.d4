      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="98~107" WheelPosition="3">
        <Swatch>b5256d84-aabf-4eea-be9a-c6efa51eb385</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="108~117" WheelPosition="4">
        <Swatch>5b048e18-6903-40f2-9cd0-b4a94c4dbe1d</Swatch>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Blazar Diamond" ShortName="Blzr Diamd" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="08-05-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~36" />
      <Function ID="2" Name="PRG Mode" Display="'PRG Mode'" Dmx="37~110" />
      <Function ID="3" Name="ILDA Mode" Display="'ILDA Mode'" Dmx="111~147" />
      <Function ID="4" Name="Sound Mode" Display="'Sound Mode'" Dmx="148~184" />
      <Function ID="5" Name="Auto Mode" Display="'Auto Mode'" Dmx="185~221" />
      <Function ID="6" Name="DMX Mode" Display="'DMX Mode'" Dmx="222~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Left to Right" Display="'Left to Right %.1f%%',0.0~100.0" Dmx="126~185" />
      <Function ID="3" Name="Jump Left to Right" Display="'Jump Left to Right %.1f%%',0.0~100.0" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump %.1f%%',0.0~100.0" Dmx="226~245" />
      <Function ID="5" Name="Audio Jump" Display="'Audio Jump %.1f%%',0.0~100.0" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Left to Right" Display="'Left to Right %.1f%%',0.0~100.0" Dmx="126~185" />
      <Function ID="3" Name="Jump Left to Right" Display="'Jump Left to Right %.1f%%',0.0~100.0" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump %.1f%%',0.0~100.0" Dmx="226~245" />
      <Function ID="5" Name="Audio Jump" Display="'Audio Jump %.1f%%',0.0~100.0" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Enlarge" Display="'Enlarge %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Narrow" Display="'Narrow %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Circular Move" Display="'Circular Move %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="XAxisRot" Name="X-Axis Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="YAxisRot" Name="Y-Axis Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="ZAxisRot" Name="Z-Axis Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Draw" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Adjust Draw" Display="'Adjust Draw %.f%%',0~100" Dmx="11~74" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Auto Adjust Draw In" Display="'Auto Adjust Draw In %.f%%',0~100" Dmx="75~104" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Auto Adjust Draw De" Display="'Auto Adjust Draw De %.f%%',0~100" Dmx="105~144" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Auto Circular" Display="'Auto Circular %.f%%',0~100" Dmx="145~184" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="End to End Increase" Display="'End to End Increase %.f%%',0~100" Dmx="185~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="End to End Decrease" Display="'End to End Decrease %.f%%',0~100" Dmx="225~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Wave Speed" Display="'Wave Speed %.1f%%',0.0~100.0" Dmx="10~199" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Wave Amplitude" Display="'Wave Amplitude %.1f%%',0.0~100.0" Dmx="200~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="Colour 1" Display="'Colour 1'" Dmx="119~135" Colour="0,0,0" />
      <Function ID="9" Name="Colour 2" Display="'Colour 2'" Dmx="136~152" Colour="0,0,0" />
      <Function ID="10" Name="Colour 3" Display="'Colour 3'" Dmx="153~169" Colour="0,0,0" />
      <Function ID="11" Name="Colour 4" Display="'Colour 4'" Dmx="170~186" Colour="0,0,0" />
      <Function ID="12" Name="Colour 5" Display="'Colour 5'" Dmx="187~203" Colour="0,0,0" />
      <Function ID="13" Name="Colour 6" Display="'Colour 6'" Dmx="204~237" Colour="0,0,0" />
      <Function ID="14" Name="Colour 7" Display="'Colour 7'" Dmx="238~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="DispMode" Name="Display Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~63" />
      <Function ID="2" Name="Lightspot" Display="'Lightspot'" Dmx="64~127" />
      <Function ID="3" Name="Segmenten" Display="'Segmenten'" Dmx="128~191" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX, 8bit" Channels="13">
    <Import PearlRef="LH_BlazDimd" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Gobo11" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="XAxisRot" ChannelOffset="7" Wheel="16" />
      <Attribute ID="YAxisRot" ChannelOffset="8" Wheel="17" />
      <Attribute ID="ZAxisRot" ChannelOffset="9" Wheel="18" />
      <Attribute ID="Wave" ChannelOffset="11" Wheel="20" />
      <Attribute ID="DispMode" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:5" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Cyan" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:7" />
      <Palette ID="9" Name="Cyan" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:6" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:6" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:6" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
  </Palettes>
</Fixture>
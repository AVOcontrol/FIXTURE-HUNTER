    <Attribute ID="LED_Fade_Time" Name="LED Fade Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="0.5s" Display="'0.5s'" Dmx="32~62" />
      <Function ID="3" Name="1s" Display="'1s'" Dmx="63~93" />
      <Function ID="4" Name="2s" Display="'2s'" Dmx="94~125" />
      <Function ID="5" Name="3s" Display="'3s'" Dmx="126~156" />
      <Function ID="6" Name="4s" Display="'4s'" Dmx="157~187" />
      <Function ID="7" Name="5s" Display="'5s'" Dmx="188~218" />
      <Function ID="8" Name="On" Display="'On'" Dmx="219~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />

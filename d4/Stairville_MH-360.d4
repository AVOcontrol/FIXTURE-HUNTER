  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8f4e3ff8-9925-4277-8e29-8c13985da189" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in dark On" Display="'Move in dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in dark Off" Display="'Move in dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="5" Name="Stand Alone" Display="'Stand Alone'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',100~0" Dmx="16~131" Intensity="0~0" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="132~139" Intensity="0~0" />
      <Function ID="4" Name="Open-Close" Display="'Open-Close %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="182~189" Intensity="0~0" />
      <Function ID="6" Name="Close-Open" Display="'Close-Open %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
      <Function ID="7" Name="No Function" Display="'No Function'" Dmx="232~239" Intensity="0~0" />
      <Function ID="8" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="9" Name="No Function" Display="'No Function'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~7" Colour="0,0,0" />
      <Function ID="2" Name="Color 1-32" Display="'Color 1-32 %.f%%',0~100" Dmx="8~127" Colour="0,0,0" />
      <Function ID="3" Name="Col Chase 1-16" Display="'Col Chase 1-16 %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade 1-16" Display="'Col Fade 1-16 %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Macro Speed" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SV_MH360" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

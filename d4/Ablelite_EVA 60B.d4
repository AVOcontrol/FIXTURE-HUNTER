      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="140~153" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="154~167" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="168~181" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />

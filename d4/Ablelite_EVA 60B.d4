    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~63" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="64~127" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="128~191" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="0~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reserved" Display="'Reserved'" Dmx="24~55" />
      <Function ID="5" Name="Display Off" Display="'Display Off'" Dmx="56~63" />
      <Function ID="6" Name="Display On" Display="'Display On'" Dmx="64~71" />
      <Function ID="7" Name="Reserved" Display="'Reserved'" Dmx="72~79" />
      <Function ID="8" Name="Reserved" Display="'Reserved'" Dmx="80~87" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
      <Function ID="10" Name="Reserved" Display="'Reserved'" Dmx="96~255" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 13 DMX" Channels="13">
    <Import PearlRef="UK_AbEV60BB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

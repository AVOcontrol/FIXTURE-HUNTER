    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Spin Cyan" ID="2,3,4,5" If="'Colour1Func1'==2||'Colour1Func1'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="127~128" Colour="0,0,0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~126" Colour="0,0,0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="127~128" Colour="0,0,0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Spin Yellow" ID="2,3,4,5" If="'Colour1Func1'==3||'Colour1Func1'==5" />

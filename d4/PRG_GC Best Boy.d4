    <Attribute ID="Colour1Func1" Name="CMY Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Continuous" Display="'Continuous'" Dmx="0~0" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Spin Cyan" Display="'Spin Cyan'" Dmx="10~19" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="3" Name="Spin Yellow" Display="'Spin Yellow'" Dmx="20~29" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="4" Name="Spin Magenta" Display="'Spin Magenta'" Dmx="30~39" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="5" Name="Spin All" Display="'Spin All'" Dmx="40~49" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="6" Name="Reserved" Display="'Reserved %.f',50~255" Dmx="50~255" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:6618" PowerOn="1:6618" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',3000.0~7500.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />

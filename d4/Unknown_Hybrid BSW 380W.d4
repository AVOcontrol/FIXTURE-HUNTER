  <History Date="07-11-23" Author="Nic Morris" Comment="Created (poor documentation.  colour and gobo are missing detailed ranges.  some descriptions refer to channels/ modes that don't exist)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp ECO (230W)" Display="'Lamp ECO (230W)'" Dmx="20~24" />
      <Function ID="3" Name="Lamp Standard (280W)" Display="'Lamp Standard (280W)'" Dmx="25~29" />
      <Function ID="4" Name="Rot Gobo Speed Mode" Display="'Rot Gobo Speed Mode'" Dmx="30~39" />
      <Function ID="5" Name="Rot Gobo Time Mode" Display="'Rot Gobo Time Mode'" Dmx="40~49" />
      <Function ID="6" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="50~59" />
      <Function ID="7" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="60~69" />
      <Function ID="8" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="9" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="10" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="90~99" />
      <Function ID="11" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="100~109" />
      <Function ID="12" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="110~119" />
      <Function ID="13" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="120~129" />
      <Function ID="14" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="15" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="16" Name="Reset Colour" Display="'Reset Colour'" Dmx="150~159" />
      <Function ID="17" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="160~169" />
      <Function ID="18" Name="Reset Dimmer/Shutter" Display="'Reset Dimmer/Shutter'" Dmx="170~179" />
      <Function ID="19" Name="Reset Zoom/Focus/Prism" Display="'Reset Zoom/Focus/Prism'" Dmx="180~189" />
      <Function ID="20" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="21" Name="Sync of Rnd Strobe On" Display="'Sync of Rnd Strobe On'" Dmx="210~219" />
      <Function ID="22" Name="Sync of Rnd Strobe Off" Display="'Sync of Rnd Strobe Off'" Dmx="220~229" />
      <Function ID="23" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="3,4" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="5,6,7,8,9,10" If="'Colour1Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.2f%%',0.00~100.00" Dmx="33410~48573" Colour="255,255,255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="4" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~33153" Colour="255,255,255" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="56283~56540" Colour="0,0,0" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="48830~56026" Colour="0,0,0" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="56283~56540" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="56797~63993" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="56283~56540" Colour="0,0,0" />
      <Function ID="10" Name="Rnd Auto" Display="'Rnd Auto %.1f%%',0.0~100.0" Dmx="65535~64250" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="3,4" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="5,6,7,8,9,10" If="'Gobo1Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="4~87" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="4" Name="Gobo Shake" Display="'Gobo Shake %.1f%%',0.0~100.0" Dmx="88~200" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="201~201" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="202~224" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="225~226" />
      <Function ID="8" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="227~249" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="225~226" />
      <Function ID="10" Name="Rnd Auto" Display="'Rnd Auto %.f%%',0~100" Dmx="255~250" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="3,4" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="5,6,7,8,9,10" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="5~76" WheelPosition="1" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="4" Name="Gobo Shake" Display="'Gobo Shake %.1f%%',0.0~100.0" Dmx="77~199" WheelPosition="1" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="200~201" />
      <Function ID="6" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="202~224" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="225~226" />
      <Function ID="8" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="227~249" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="225~226" />
      <Function ID="10" Name="Rnd Auto" Display="'Rnd Auto %.f%%',0~100" Dmx="255~250" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="20~75" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="76~127" />

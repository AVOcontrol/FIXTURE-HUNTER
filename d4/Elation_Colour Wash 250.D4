  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Mode" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated Raw DMX function to have no range." />
  <Manual Filename="/manual/Elation_Colour Wash 575.pdf" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" Highlight="1:50" Lowlight="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" Highlight="1:50" Lowlight="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="MSpeed" Name="MSpeed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
      <Function ID="2" Name="M.Speed" Display="'%.f%%',0~100" Dmx="1~249" />
      <Function ID="3" Name="BO While C/G" Display="'BO While C/G'" Dmx="250~252" />
      <Function ID="4" Name="BO Moving" Display="'BO Moving'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" Highlight="5" Lowlight="5" />
      <Function ID="1" Name="Fan Speed" Display="'Fan Spd %.f%%',100~0" Dmx="0~127" />
      <Function ID="2" Name="LampON/Reset" Display="'LampON/Reset'" Dmx="128~139" />
      <Function ID="3" Name="No Func" Display="'No Func'" Dmx="140~229" />
      <Function ID="4" Name="Lamp OFF" Display="'Lamp OFF'" Dmx="230~239" />
      <Function ID="5" Name="No Func" Display="'No Func'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~17" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~35" Colour="0,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="36~53" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="54~72" Colour="0,0,0" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="73~90" Colour="0,0,0" />
      <Function ID="6" Name="5600k" Display="'5600k'" Dmx="91~108" Colour="0,0,0" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="109~127" Colour="0,0,0" />
      <Function ID="8" Name="Fwd Rainbow" Display="'Fwd %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="9" Name="No Rotation" Display="'No Rotation'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="10" Name="Rev Rainbow" Display="'Rev %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />

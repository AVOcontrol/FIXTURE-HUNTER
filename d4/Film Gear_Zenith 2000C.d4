      <Condition Name="Explosion" ID="20" If="'FX_Select'==7" />
      <Condition Name="Flash Type" ID="21,22" If="'FX_Select'==12" />
      <Condition Name="Mode" ID="23,24,25,26,27,28" If="'FX_Select'==13" />

      <Function ID="12" Name="Paparazzi" Display="'Paparazzi'" Dmx="110~119" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8, FX_Param_9" />
      <Function ID="13" Name="Police Car" Display="'Police Car'" Dmx="120~129" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8, FX_Param_9" />
      <Function ID="14" Name="Process" Display="'Process'" Dmx="130~139" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8, FX_Param_9" />

      <Function ID="16" Name="Strobe" Display="'Strobe'" Dmx="150~159" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8, FX_Param_9" />
      <Function ID="17" Name="Television" Display="'Television'" Dmx="160~169" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8, FX_Param_9" />

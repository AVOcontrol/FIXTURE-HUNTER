    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E" Size="2">
      <Locate Locate="16:0" PowerOn="16:0" />
      <Condition Name="Speed" ID="1" If="'FX_Select'==2||'FX_Select'==3||'FX_Select'==4||'FX_Select'==6||'FX_Select'==8||'FX_Select'==9||'FX_Select'==10||'FX_Select'==17||'FX_Select'==5||'FX_Select'==14||'FX_Select'==18||'FX_Select'==19" />
      <Condition Name="Frequency" ID="2" If="'FX_Select'==11||'FX_Select'==15||'FX_Select'==12" />
      <Condition Name="Explosion" ID="3,4,5" If="'FX_Select'==7" />
      <Condition Name="Colour Combinations" ID="6,7,8,9,10,11,12,13,14" If="'FX_Select'==13" />
      <Condition Name="Strobe" ID="15" If="'FX_Select'==16" />
      <Else ID="16" />
      <Function ID="1" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Frequency" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="Auto Spd" Display="'Auto Spd %.2f%%',0.00~100.00" Dmx="0~32767" />
      <Function ID="4" Name="Idle" Display="'Idle'" Dmx="32768~64224" />
      <Function ID="5" Name="Manual Trigger" Display="'Manual Trigger'" Dmx="64225~65535" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="0~0" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="6554~13106" />
      <Function ID="8" Name="Blue + Red" Display="'Blue + Red'" Dmx="13107~19660" />
      <Function ID="9" Name="Blue + White" Display="'Blue + White'" Dmx="19661~26214" />
      <Function ID="10" Name="Amber" Display="'Amber'" Dmx="26215~32767" />
      <Function ID="11" Name="Blue +Amber" Display="'Blue +Amber'" Dmx="32768~39221" />
      <Function ID="12" Name="Red + Amber" Display="'Red + Amber'" Dmx="39222~45874" />
      <Function ID="13" Name="Blue, Red + White" Display="'Blue, Red + White'" Dmx="45875~51772" />
      <Function ID="14" Name="Blue, Red + Amber" Display="'Blue, Red + Amber'" Dmx="51773~58981" />
      <Function ID="15" Name="Strobe On" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_2" Name="FX Param 2" Description="" Group="E" Size="2">
      <Locate Locate="33:0" PowerOn="33:0" />
      <Condition Name="Saturation" ID="1" If="'FX_Select'==2" />
      <Condition Name="Colour Temperature" ID="2,3,4" If="'FX_Select'==3||'FX_Select'==8||'FX_Select'==17" />

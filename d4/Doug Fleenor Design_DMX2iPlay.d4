<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DMX2iPlay" ShortName="DMX2iPlay" Company="Doug Fleenor Design">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="11-07-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Trigger" Name="Trigger" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~84" />
      <Function ID="2" Name="Hold" Display="'Hold'" Dmx="87~166" />
      <Function ID="3" Name="Send" Display="'Send'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Show Hs" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="100" Display="'100'" Dmx="23~28" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="200" Display="'200'" Dmx="48~54" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Show Ts" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="10" Display="'10'" Dmx="23~28" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="20" Display="'20'" Dmx="48~54" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="30" Display="'30'" Dmx="74~79" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="40" Display="'40'" Dmx="99~105" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="50" Display="'50'" Dmx="125~130" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="60" Display="'60'" Dmx="150~156" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="70" Display="'70'" Dmx="176~181" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="80" Display="'80'" Dmx="201~207" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="90" Display="'90'" Dmx="227~232" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo12" Name="Show 1s" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="23~28" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="2" Display="'2'" Dmx="48~54" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="3" Display="'3'" Dmx="74~79" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="4" Display="'4'" Dmx="99~105" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="5" Display="'5'" Dmx="125~130" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="6" Display="'6'" Dmx="150~156" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="7" Display="'7'" Dmx="176~181" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="8" Display="'8'" Dmx="201~207" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="9" Display="'9'" Dmx="227~232" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="UK_DMXIPlay" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Gobo11" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Gobo12" ChannelOffset="4" Wheel="15" />
      <Attribute ID="Trigger" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="3" Name="BO onChange" Display="'BO onChange'" Dmx="236~245" />
      <Function ID="4" Name="No Func" Display="'No Func'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

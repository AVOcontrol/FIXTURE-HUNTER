<Fixture Name="TL120C" ShortName="TL120C" Company="Neewer" Version="21">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>bef8e6de-603e-412b-98d6-534d0b03a092</Thumbnail>
  <History Date="16-04-25" Author="Nic Morris" Comment="Created (note candle light effect has 6 parameters but there are only 5 in the footprint.  this doesn't make any sense.  parameters omitted for now)" Version="0" />
  <History Date="20-10-25" Author="Nic Morris" Comment="Created from Neewer TL60 RGB (implementation has been poorly considered for consoles.  note that in the pixel custom modes the fixture will follow the colour mode set in the master fixture only.  the dummy colour mode control in the cells is necessary in order to update the dependent controls but should not be changed manually)" Version="9" />
  <History Date="21-10-25" Author="Nic Morris" Comment="Corrected pixel mode (were missing main mode selector on channel 1) and mode 4 mapping (brand control seems pointless).  Very confusing documentation." Version="19" />
  <History Date="24-10-25" Author="Nic Morris" Comment="Added Atlabase ID for mode 7." Version="21" />
  <Manual Filename="" Summary="" />

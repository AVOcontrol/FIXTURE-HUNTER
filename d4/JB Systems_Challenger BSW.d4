      <Function ID="9" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="64~127" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~193" />

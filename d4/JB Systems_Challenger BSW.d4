      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>5541916c-7e13-4010-ad75-b71be414c385</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="9~17">

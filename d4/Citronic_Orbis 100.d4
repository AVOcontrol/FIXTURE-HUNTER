  <Thumbnail>9e63a6b0-78db-4025-abf2-362458234504</Thumbnail>
  <History Date="20-05-26" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="27-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dc1f5a34-0d49-46e0-831b-1a3409ceb5fd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~49" Colour="0,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="50~59" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~69" Colour="0,255,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="70~79" Colour="255,128,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="80~167" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="168~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="11,12" If="'Gobo1Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="10" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="80~149" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="149~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="100~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Show 0" Display="'Show 0'" Dmx="30~59" />
      <Function ID="3" Name="Show 1" Display="'Show 1'" Dmx="60~89" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="90~119" />
      <Function ID="5" Name="Show 3" Display="'Show 3'" Dmx="120~149" />
      <Function ID="6" Name="Sound 0" Display="'Sound 0'" Dmx="150~179" />
      <Function ID="7" Name="Sound 1" Display="'Sound 1'" Dmx="180~209" />
      <Function ID="8" Name="Sound 2" Display="'Sound 2'" Dmx="210~239" />
      <Function ID="9" Name="Sound 3" Display="'Sound 3'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Ring_Macro" Name="Ring Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~14" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~24" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="25~34" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="35~44" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="45~54" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="55~64" />
      <Function ID="8" Name="White" Display="'White'" Dmx="65~74" />
      <Function ID="9" Name="Effect Macros" Display="'Effect Macros'" Dmx="75~255" />
    </Attribute>
    <Attribute ID="Ring_Macro_Spd" Name="Ring Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="92ed8669-34e6-4529-a2ac-a95148f5fb95">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

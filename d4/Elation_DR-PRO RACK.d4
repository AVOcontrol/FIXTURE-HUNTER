<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DR-PRO RACK" ShortName="DR-PRO" Company="Elation">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="30-11-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Select" Name="Select" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Memory 1" Display="'Memory 1'" Dmx="0~0" />
      <Function ID="2" Name="Memory 2" Display="'Memory 2'" Dmx="4~7" />
      <Function ID="3" Name="Memory 3" Display="'Memory 3'" Dmx="8~11" />
      <Function ID="4" Name="Memory 4" Display="'Memory 4'" Dmx="12~15" />
      <Function ID="5" Name="Memory 5" Display="'Memory 5'" Dmx="16~19" />
      <Function ID="6" Name="Memory 6" Display="'Memory 6'" Dmx="20~23" />
      <Function ID="7" Name="Memory 7" Display="'Memory 7'" Dmx="24~27" />
      <Function ID="8" Name="Memory 8" Display="'Memory 8'" Dmx="28~31" />
    </Attribute>
    <Attribute ID="Trigger" Name="Trigger" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pause" Display="'Pause'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="80~159" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="160~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="ELDR-PRO" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Select" ChannelOffset="1" Wheel="13" />
      <Attribute ID="Trigger" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
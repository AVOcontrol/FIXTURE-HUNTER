      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="179~212" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="213~247" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="248~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~47" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="48~87" />

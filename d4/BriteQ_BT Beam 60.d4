    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~247" />
    </Attribute>
    <Attribute ID="Colour12" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~42" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="43~76" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="77~110" WheelPosition="3" Colour="0,0,0" />

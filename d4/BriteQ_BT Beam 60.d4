  <History Date="30-03-21" Author="Nic Morris" Comment="Added product thumbnail.  Revised modes and added Atlabase IDs.  Standardised conditionals.  Increased wheel resolution." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7d4c8dc4-fa6e-4cdb-94ec-9bc1c495305a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func1'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func1'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="15~28" Colour="255,255,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="29~42" Colour="0,128,255" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="43~56" Colour="128,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="57~70" Colour="255,0,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="71~84" Colour="255,0,255" />
      <Function ID="7" Name="Dark Blue" Display="'Deep Blue'" Dmx="85~98" Colour="0,0,180" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="99~112" Colour="255,128,0" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="113~127" Colour="255,150,150" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==3" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="15~22" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="30~37" WheelPosition="2" Colour="0,128,255" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="45~52" WheelPosition="3" Colour="128,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="60~67" WheelPosition="4" Colour="255,0,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="75~82" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Dark Blue" Display="'Deep Blue'" Dmx="90~97" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="105~112" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="120~127" WheelPosition="8" Colour="255,150,150" />
      <Function ID="10" Name="Op/ Yel" Display="'Op/ Yel'" Dmx="8~14" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="23~29" WheelPosition="1" Colour="255,255,0" />
      <Function ID="12" Name="L Blu/ L Grn" Display="'L Blu/ L Grn'" Dmx="38~44" WheelPosition="2" Colour="0,128,255" />
      <Function ID="13" Name="L Grn/ Rd" Display="'L Grn/ Rd'" Dmx="53~59" WheelPosition="3" Colour="128,255,0" />
      <Function ID="14" Name="Rd/ Mag" Display="'Rd/ Mag'" Dmx="68~74" WheelPosition="4" Colour="255,0,0" />
      <Function ID="15" Name="Mag/ D Blu" Display="'Mag/ D Blu'" Dmx="83~89" WheelPosition="5" Colour="255,0,255" />
      <Function ID="16" Name="D Blu/ Org" Display="'D Blu/ Org'" Dmx="98~104" WheelPosition="6" Colour="0,0,180" />
      <Function ID="17" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="113~119" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved 1" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved 2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~18" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="19~27" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="28~36" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="37~45" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="46~54" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="55~63" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="64~73" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="74~82" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="83~91" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="92~100" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="101~109" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="110~118" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="119~127" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="90~99" />
      <Function ID="5" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="100~109" />
      <Function ID="6" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="110~119" />
      <Function ID="7" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="120~129" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />

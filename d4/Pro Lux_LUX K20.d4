      <Function ID="63" Name="Sgl Pix R4" Display="'Sgl Pix R4'" Dmx="69~69" Update="Shape_Speed, Shape_Offset" />
      <Function ID="64" Name="Spiral" Display="'Spiral'" Dmx="70~70" Update="Shape_Speed, Shape_Offset" />
      <Function ID="65" Name="Reserved" Display="'Reserved'" Dmx="71~255" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;8&amp;&amp;'Shape'&lt;13" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==13||'Shape'==14" />
      <Condition Name="Rainbow" ID="10,11,12,13" If="'Shape'==15||'Shape'==16" />
      <Condition Name="Speed" ID="14,15,16,17" If="'Shape'&gt;16&amp;&amp;'Shape'&lt;65" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="161~255" />

    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f Hz',1.0~25.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2000~20000" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Matching" Name="Gel Col Match" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Best" Display="'Best'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Brightest" Display="'Brightest'" Dmx="85~170" Colour="0,0,0" />
      <Function ID="3" Name="No Colour Gel" Display="'No Colour Gel'" Dmx="171~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Type" Name="Gel Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rosco" Display="'Rosco'" Dmx="0~0" Update="Gel_Category" Colour="255,255,255" />
      <Function ID="2" Name="Lee" Display="'Lee'" Dmx="129~255" Update="Gel_Category" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Category" Name="Gel Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="LEE" ID="6,7,8,9,10" If="'Gel_Type'==2" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Col Correct" Display="'Col Correct'" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="2" Name="Cal Colour" Display="'Cal Colour'" Dmx="51~101" Update="Gel" Colour="255,255,255" />
      <Function ID="3" Name="Storaro Series" Display="'Storaro Series'" Dmx="102~152" Update="Gel" Colour="255,255,255" />
      <Function ID="4" Name="Cinelux" Display="'Cinelux'" Dmx="153~203" Update="Gel" Colour="255,255,255" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="204~255" Update="Gel" Colour="255,255,255" />
      <Function ID="6" Name="Col Correct" Display="'Col Correct'" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="7" Name="Col Filter" Display="'Col Filter'" Dmx="51~101" Update="Gel" Colour="255,255,255" />
      <Function ID="8" Name="600 Series" Display="'600 Series'" Dmx="102~152" Update="Gel" Colour="255,255,255" />
      <Function ID="9" Name="Cosmetic" Display="'Cosmetic'" Dmx="153~203" Update="Gel" Colour="255,255,255" />
      <Function ID="10" Name="700 Series" Display="'700 Series'" Dmx="204~255" Update="Gel" Colour="255,255,255" />
    </Attribute>

    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Saturation" ID="2" If="'FX_Select'==2" />
      <Condition Name="CCT Range (candle)" ID="3,4,5" If="'FX_Select'==3" />
      <Condition Name="Offset" ID="6" If="'FX_Select'==4" />
      <Condition Name="Colour Variety" ID="7,8,9,10,11,12,13,14" If="'FX_Select'==5" />

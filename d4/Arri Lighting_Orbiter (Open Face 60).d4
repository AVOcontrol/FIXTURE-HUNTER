    <Attribute ID="FX_Select" Name="FX Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />
      <Function ID="2" Name="Party Effect" Display="'Party Effect'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />

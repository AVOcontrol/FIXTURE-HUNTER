      <Function ID="8" Name="Fireworks" Display="'Fireworks'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7, FX_Param_8" />

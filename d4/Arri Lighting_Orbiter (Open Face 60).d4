    <Attribute ID="Category" Name="Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Incandescent" Display="'Incandescent'" Dmx="0~0" Update="Source" Colour="0,0,0" />
      <Function ID="2" Name="Fluorescent" Display="'Fluorescent'" Dmx="51~101" Update="Source" Colour="0,0,0" />
      <Function ID="3" Name="Discharge" Display="'Discharge'" Dmx="102~152" Update="Source" Colour="0,0,0" />
      <Function ID="4" Name="Other" Display="'Other'" Dmx="153~203" Update="Source" Colour="0,0,0" />
      <Function ID="5" Name="Reserved" Display="'Reserved'" Dmx="204~255" Update="Source" Colour="0,0,0" />
    </Attribute>

    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~32" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="33~58" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="59~84" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="85~110" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="111~136" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="53695b09-38fb-4061-8bdc-97020b70afda" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="135~239" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="240~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Macro" Name="Col Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="White (RGB)" Display="'White (RGB)'" Dmx="8~21" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~34" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="35~49" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="50~63" />
      <Function ID="6" Name="White" Display="'White'" Dmx="64~77" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="78~91" />
      <Function ID="8" Name="Crimson" Display="'Crimson'" Dmx="92~105" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="106~119" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="120~133" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="134~147" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="148~161" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="162~175" />
      <Function ID="14" Name="Pink" Display="'Pink'" Dmx="176~189" />
      <Function ID="15" Name="Buff" Display="'Buff'" Dmx="190~203" />
      <Function ID="16" Name="White (RGW)" Display="'White (RGW)'" Dmx="204~217" />
      <Function ID="17" Name="Dark Purple" Display="'Dark Purple'" Dmx="218~231" />
      <Function ID="18" Name="Change" Display="'Change %.f%%',0~100" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~22" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="23~37" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="38~52" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="53~67" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="68~82" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="83~97" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="98~112" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="113~127" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="128~142" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="143~157" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="158~172" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="173~187" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="188~202" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="203~217" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="218~232" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="233~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="150~200" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="UKUKMMH1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c56dc0bf-223e-4209-9257-05e3cde171a5" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="White" ChannelOffset="7" Wheel="9" />

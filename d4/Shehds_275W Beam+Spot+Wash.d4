      <Function ID="22" Name="Org/ PS Blu" Display="'Org/ PS Blu'" Dmx="52~55" WheelPosition="6" Colour="255,150,0" />
      <Function ID="23" Name="PS Blu/ Ppl" Display="'PS Blu/ Ppl'" Dmx="60~63" WheelPosition="7" Colour="50,150,255" />
      <Function ID="24" Name="Ppl/ 3000K" Display="'Ppl/ 3000K'" Dmx="68~71" WheelPosition="8" Colour="150,0,255" />

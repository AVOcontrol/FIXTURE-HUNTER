      <Function ID="28" Name="WW/ PC Blu" Display="'WW/ PC Blu'" Dmx="100~103" WheelPosition="12" Colour="255,225,150" />
      <Function ID="29" Name="PC Blu/ Wht" Display="'PC Blu/ Wht'" Dmx="108~111" WheelPosition="13" Colour="100,200,255" />
      <Function ID="30" Name="Wht/ Op" Display="'Wht/ Op'" Dmx="116~119" WheelPosition="14" Colour="255,255,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~192" Colour="0,0,0" />

      <Function ID="10" Name="3000K" Display="'3000K'" Dmx="72~75" WheelPosition="9" Colour="255,225,150" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="80~83" WheelPosition="10" Colour="100,255,100" />
      <Function ID="12" Name="4000K" Display="'4000K'" Dmx="88~91" WheelPosition="11" Colour="255,225,200" />
      <Function ID="13" Name="Warm White" Display="'Warm White'" Dmx="96~99" WheelPosition="12" Colour="255,225,150" />
      <Function ID="14" Name="Pastel Clear Blue" Display="'Pastel Clear Blue'" Dmx="104~107" WheelPosition="13" Colour="100,200,255" />

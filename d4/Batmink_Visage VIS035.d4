  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0e48c426-1260-491c-8ea6-5861106b91f9" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Condition Name="Sensitivity" ID="1,2" If="'Effect'==20" />
      <Else ID="3,4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="32~255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~26" Update="Shutter" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="27~38" Update="Shutter" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="39~51" Update="Shutter" />
      <Function ID="5" Name="White" Display="'White'" Dmx="52~64" Update="Shutter" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="65~76" Update="Shutter" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="77~89" Update="Shutter" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="90~102" Update="Shutter" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="103~114" Update="Shutter" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="115~127" Update="Shutter" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="128~140" Update="Shutter" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="141~152" Update="Shutter" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="153~165" Update="Shutter" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="166~178" Update="Shutter" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="179~190" Update="Shutter" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="191~204" Update="Shutter" />
      <Function ID="17" Name="Jump" Display="'Jump'" Dmx="205~217" Update="Shutter" />
      <Function ID="18" Name="Dream" Display="'Dream'" Dmx="218~230" Update="Shutter" />
      <Function ID="19" Name="Auto" Display="'Auto'" Dmx="231~242" Update="Shutter" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="243~255" Update="Shutter" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4d7f3a1e-c209-4ce8-9c93-0fbe22cd29b7" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Effect" ChannelOffset="7" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />

  <History Date="11-07-19" Author="Nic Morris" Comment="Created (limited information - no colour ranges)" />
  <History Date="23-10-19" Author="Nic Morris" Comment="Changed Colour to CCT with revised display range (not documented)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="CCT" Description="" Group="C">
      <Locate Locate="1:3200" PowerOn="1:3200" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',3200~5500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="991, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
    </Include>
  </Mode>

      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="203~219" />
      <Function ID="22" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="202~155" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="203~219" />
      <Function ID="24" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="220~255" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

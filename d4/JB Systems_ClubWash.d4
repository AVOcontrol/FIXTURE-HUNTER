      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~37" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="38~67" Colour="0,255,0" />
      <Function ID="4" Name="Dark Blue" Display="'Dark Blue'" Dmx="68~97" Colour="0,0,180" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="98~127" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="128~157" Colour="255,128,0" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="158~187" Colour="180,0,255" />
      <Function ID="8" Name="Fade" Display="'Fade'" Dmx="218~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="199~199" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~250" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="P/T Fast" Display="'P/T Fast'" Dmx="16~200" />
      <Function ID="3" Name="P/T Slow" Display="'P/T Slow'" Dmx="201~255" />
    </Attribute>
  </Control>

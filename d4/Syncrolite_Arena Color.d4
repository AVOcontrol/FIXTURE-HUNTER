      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="43~43" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="85~85" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="169~169" />

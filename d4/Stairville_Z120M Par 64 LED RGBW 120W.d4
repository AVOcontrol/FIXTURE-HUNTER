      <Function ID="17" Name="Change" Display="'Change %.f%%',0~100" Dmx="186~220" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="36~55" Colour="0,0,0" />

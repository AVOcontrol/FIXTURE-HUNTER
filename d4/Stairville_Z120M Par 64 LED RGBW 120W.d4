      <Function ID="12" Name="7000K" Display="'7000K'" Dmx="236~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="16~95" />
      <Function ID="3" Name="Strobe Effect Colour" Display="'Strobe Effect Colour'" Dmx="96~175" />
      <Function ID="4" Name="Col Fade Effect" Display="'Col Fade Effect'" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

      <Function ID="8" Name="Cobalt Blue" Display="'Cobalt Blue'" Dmx="78~89" Colour="0,0,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="90~101" Colour="0,0,255" />
      <Function ID="10" Name="Lilac" Display="'Lilac'" Dmx="102~113" Colour="180,0,255" />
      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="114~125" Colour="128,0,255" />

  <History Date="20-05-22" Author="Nic Morris" Comment="Created (note manual suggests 10, 15, 21, 39 and 375 channel modes but only 15 and 39 provided)" Version="0" />
  <History Date="25-05-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="16-08-22" Author="Nic Morris" Comment="Created from Unknown 19x25W Zoom LED Moving Head Lighting (identical plus the missing modes)" Version="2" />
  <History Date="29-10-22" Author="Nic Morris" Comment="Created from Gamma Led Vision Silhouette Borealis X Z (identical. note provided documentation differs from that linked from the product webpage)" Version="3" />
  <History Date="01-11-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="16-05-23" Author="Nic Morris" Comment="Created from Gamma Led Vision Silhouette Borealis XL Z (very poor documentation.  identical)" Version="5" />
  <History Date="07-05-25" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (awful documentation.  adds 25 channel mode, 37 channel mode v2 and removes 39 channel mode)" Version="6" />
  <History Date="07-05-25" Author="Nic Morris" Comment="Added product thumbnail.  Added Atlabase IDs." Version="6" />
  <History Date="08-05-25" Author="Nic Morris" Comment="Added missing Atlabase IDs for 25 and 37 DMX V2 modes." Version="7" />

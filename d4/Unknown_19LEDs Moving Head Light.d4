      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="40" />
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="5" />
      <Attribute ID="Zoom" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Auto" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
      <Attribute ID="Reserved" ChannelOffset="16" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="24 DMX" Channels="24" Id="7fb57e3e-7d95-4ba0-a88e-8a755da6bb3d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

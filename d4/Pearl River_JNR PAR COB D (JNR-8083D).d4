<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="JNR PAR COB D (JNR-8083D)" ShortName="PAR COB D" Company="Pearl River">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-09-17" Author="Nic Morris" Comment="Created (poor documentation)" />
  <History Date="20-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="20-09-17" Author="Nic Morris" Comment="Changed dimmer to 'Switch' and added virtual dimmer to ensure dimming operation (documentation is not clear)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2ce5a8e0-e659-4676-8e41-831331530859" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="Pure White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter_Speed" Name="Shutter Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Pure White" Display="'Pure White'" Dmx="51~101" />
      <Function ID="3" Name="Warm White" Display="'Warm White'" Dmx="102~152" />
      <Function ID="4" Name="Sync Pure+Warm" Display="'Sync Pure+Warm'" Dmx="153~203" />
      <Function ID="5" Name="Gradual Fade" Display="'Gradual Fade'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Switch" Name="Switch" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Activate" Display="''" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="PRJ8083D" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="247b0990-fa92-41ed-894f-e415aac4bd30" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="White" ChannelOffset="2" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Shutter_Speed" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Shutter_Func" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Switch" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
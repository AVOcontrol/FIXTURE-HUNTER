<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="400W Warm White DMX Blinder" ShortName="WW Blinder" Company="FOS">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-09-17" Author="Nic Morris" Comment="Created (no layout information - guessed)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="983d397a-65a1-40ed-ad72-42813e1e82ab" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Up" Display="'Auto Up'" Dmx="36~71" />
      <Function ID="3" Name="Down" Display="'Down'" Dmx="72~107" />
      <Function ID="4" Name="Up/ Down" Display="'Up/ Down'" Dmx="108~143" />
      <Function ID="5" Name="SIN Up" Display="'SIN Up'" Dmx="144~179" />
      <Function ID="6" Name="4-Colours" Display="'4-Colours'" Dmx="180~215" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="11~40" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="41~80" />
      <Function ID="4" Name="Slow" Display="'Slow'" Dmx="81~120" />
      <Function ID="5" Name="Preset" Display="'Preset'" Dmx="121~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKFOSWB1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="32928194-693a-4957-836d-c0524c04d8ce" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>

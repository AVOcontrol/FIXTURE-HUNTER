  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0305eef6-c7aa-41a6-b3c0-6ce7118080dc" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~63" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="64~191" />
      <Function ID="4" Name="Rnd Flash" Display="'Rnd Flash %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Macro_Spd" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="5~34" Update="Macro_Spd" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="35~64" Update="Macro_Spd" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="65~94" Update="Macro_Spd" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="95~124" Update="Macro_Spd" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="125~154" Update="Macro_Spd" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="155~184" Update="Macro_Spd" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="185~214" Update="Macro_Spd" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="215~244" Update="Macro_Spd" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="245~255" Update="Macro_Spd" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Macro'==10" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

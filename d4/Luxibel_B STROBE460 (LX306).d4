  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="365f975a-d1f5-4559-8bef-d573fcf5f6c4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Master Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Flash" Display="'No Flash'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Rate" Display="'Rate %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="4" Name="Ramp Up-Down" Display="'Ramp Up-Down'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Pixel" Name="Pixel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~249" Intensity="0~0" />
      <Function ID="3" Name="Blinder" Display="'Blinder'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="11~40" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="41~70" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="71~100" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="101~130" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="131~160" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5'" Dmx="161~190" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6'" Dmx="191~220" />
      <Function ID="9" Name="Auto 7" Display="'Auto 7'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SP1500-DMX Mod" ShortName="BXSP15DMXM" Company="Botex">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="03-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="12-07-15" Author="Nic Morris" Comment="Changed manufactuer from unknown to Botex" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~49" Intensity="0~0" />
      <Function ID="2" Name="Blinding" Display="'Blinding'" Dmx="50~99" Intensity="0~0" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="100~149" Intensity="0~0" />
      <Function ID="4" Name="Single Flash" Display="'Single Flash'" Dmx="150~199" Intensity="0~0" />
      <Function ID="5" Name="SYNC" Display="'SYNC'" Dmx="200~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="BX_SP15DMXM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PVP" ShortName="PVP" Company="Renewed Vision">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="17-11-11" Author="Tim Bechtel" Comment="Created" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Changed hue and saturation ID's for compatibility." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Folder" Name="Playlist" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Playlist" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="File" Name="Clip" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Clip" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Hue" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Saturation" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Brightness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="C">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Contrast" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fade_Time" Name="Fade Time" Description="" Group="E">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Fade Time" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Manual_Fade" Name="Maunal Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual Fade" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Play_Rate" Name="Play Rate" Description="" Group="S">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Play Rate" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Control" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="S">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Volume" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="11 Channel" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="xHue" ChannelOffset="7" Wheel="7" />
      <Attribute ID="xSaturation" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Contrast" ChannelOffset="10" Wheel="9" />
      <Attribute ID="Folder" ChannelOffset="1" Wheel="13" />
      <Attribute ID="File" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Fade_Time" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Manual_Fade" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
      <Attribute ID="Play_Rate" ChannelOffset="6" Wheel="25" />
      <Attribute ID="Volume" ChannelOffset="11" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="4 Channel" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

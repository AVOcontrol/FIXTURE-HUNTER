<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Star Dream 6x3m 144 LED White" ShortName="StDrm6x3mW" Company="Showtec" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="21-03-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="23-03-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0251c12b-2277-400b-9e6c-b384b8ac3439" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual Mode On" Display="'Manual Mode On'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Manual Mode Off" Display="'Manual Mode Off'" Dmx="50~59" Update="Program_Spd" />
      <Function ID="3" Name="White" Display="'White'" Dmx="60~129" Update="Program_Spd" />
      <Function ID="4" Name="Program 1" Display="'Program 1'" Dmx="130~139" Update="Program_Spd" />
      <Function ID="5" Name="Program 2" Display="'Program 2'" Dmx="140~149" Update="Program_Spd" />
      <Function ID="6" Name="Program 3" Display="'Program 3'" Dmx="150~159" Update="Program_Spd" />
      <Function ID="7" Name="Program 4" Display="'Program 4'" Dmx="160~169" Update="Program_Spd" />
      <Function ID="8" Name="Program 5" Display="'Program 5'" Dmx="170~179" Update="Program_Spd" />
      <Function ID="9" Name="Program 6" Display="'Program 6'" Dmx="180~189" Update="Program_Spd" />
      <Function ID="10" Name="Program 7" Display="'Program 7'" Dmx="190~199" Update="Program_Spd" />
      <Function ID="11" Name="Program 8" Display="'Program 8'" Dmx="200~209" Update="Program_Spd" />
      <Function ID="12" Name="Program 9" Display="'Program 9'" Dmx="210~219" Update="Program_Spd" />
      <Function ID="13" Name="Program 10" Display="'Program 10'" Dmx="220~229" Update="Program_Spd" />
      <Function ID="14" Name="Auto" Display="'Auto'" Dmx="230~239" Update="Program_Spd" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="240~249" Update="Program_Spd" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Program'==15" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5f844c19-b8c2-48a5-b4e9-48c7c41f81d7" />
    <Include>
      <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Program" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c85b978c-8d8e-4f75-ae77-c1a3fafcce84" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />

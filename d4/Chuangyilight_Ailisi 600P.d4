<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ailisi 600P" ShortName="Alisi600P" Company="Chuangyilight">
  <Copyright Notice="© Avolites Ltd. 2009" />
  <History Date="12-03-07" Author="D.Milligan" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~26" Colour="255,0,0" />
      <Function ID="2" Name="Mid-Orchid" Display="'Mid-Orchid'" Dmx="27~52" Colour="218,112,214" />
      <Function ID="3" Name="Light Yellow" Display="'Yellow'" Dmx="53~78" Colour="255,255,128" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="79~104" Colour="0,255,0" />
      <Function ID="5" Name="Rose" Display="'Rose'" Dmx="105~255" Colour="255,0,127" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Light Orchid" Display="'Light Orchid'" Dmx="0~63" Colour="236,183,234" />
      <Function ID="2" Name="Dark Orchid" Display="'Dark Orchid'" Dmx="64~127" Colour="179,47,172" />
      <Function ID="3" Name="Dark Yellow" Display="'Dark Yellow'" Dmx="128~191" Colour="180,180,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="192~255" Colour="255,150,150" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~23" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="24~231" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="232~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="CY_ALS600P" DiamondRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="2" Wheel="38" />
    </Include>
  </Mode>
</Fixture>
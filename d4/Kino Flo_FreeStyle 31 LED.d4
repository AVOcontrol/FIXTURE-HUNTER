    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect_Sel" Name="Effect Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Candle" Display="'Candle'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="2" Name="Fire" Display="'Fire'" Dmx="20~29" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="30~39" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="4" Name="Police" Display="'Police'" Dmx="40~49" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="5" Name="Lightning" Display="'Lightning'" Dmx="50~59" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="6" Name="Paparazzi" Display="'Paparazzi'" Dmx="60~69" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="7" Name="Pulse" Display="'Pulse'" Dmx="70~79" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="8" Name="Scroll" Display="'Scroll'" Dmx="80~89" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, CCT_(Effect)" />
    </Attribute>
    <Attribute ID="CCT_(Effect)" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:1400" PowerOn="1:1400" />
      <Condition Name="Candle/Fire" ID="1" If="'Effect_Sel'&lt;3" />
      <Else ID="2" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',1400~2500" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2500~9900" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Flame Type (Candle)" ID="1,2" If="'Effect_Sel'==1" />
      <Condition Name="Flame Type (Fire)" ID="3,4" If="'Effect_Sel'==2" />
      <Condition Name="TV Type" ID="5,6,7" If="'Effect_Sel'==3" />
      <Condition Name="Colour" ID="8,9,10,11,12" If="'Effect_Sel'==4" />
      <Condition Name="Type (Lightning)" ID="13,14" If="'Effect_Sel'==5" />
      <Condition Name="Type (Paparazzi)" ID="15,16" If="'Effect_Sel'==6" />
      <Condition Name="Hue" ID="17" If="'Effect_Sel'==7" />
      <Condition Name="Time" ID="18" If="'Effect_Sel'==8" />
      <Else ID="19" />
      <Function ID="1" Name="Flame Type Interior" Display="'Flame Type Interior'" Dmx="0~0" />
      <Function ID="2" Name="Flame Type Breeze" Display="'Flame Type Breeze'" Dmx="10~19" />
      <Function ID="3" Name="Flame Type Firepit" Display="'Flame Type Firepit'" Dmx="0~0" />
      <Function ID="4" Name="Flame Type Gas Fireplace" Display="'Flame Type Gas Fireplace'" Dmx="10~19" />
      <Function ID="5" Name="TV Type Movie" Display="'TV Type Movie'" Dmx="0~0" />
      <Function ID="6" Name="TV Type Music Video" Display="'TV Type Music Video'" Dmx="10~19" />
      <Function ID="7" Name="TV Type Sports" Display="'TV Type Sports'" Dmx="20~29" />
      <Function ID="8" Name="Colour Blue+Red" Display="'Colour Blue+Red'" Dmx="0~0" />
      <Function ID="9" Name="Colour Red" Display="'Colour Red'" Dmx="10~19" />
      <Function ID="10" Name="Colour Yellow" Display="'Colour Yellow'" Dmx="20~29" />
      <Function ID="11" Name="Colour Blue+White+Red" Display="'Colour Blue+White+Red'" Dmx="30~39" />
      <Function ID="12" Name="Colour Blue" Display="'Colour Blue'" Dmx="40~49" />
      <Function ID="13" Name="Type Storm" Display="'Type Storm'" Dmx="0~0" />
      <Function ID="14" Name="Type Frankenstein" Display="'Type Frankenstein'" Dmx="10~19" />
      <Function ID="15" Name="Type Red Carpet" Display="'Type Red Carpet'" Dmx="0~0" />
      <Function ID="16" Name="Type Stalker" Display="'Type Stalker'" Dmx="10~19" />
      <Function ID="17" Name="Hue" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="18" Name="Time" Display="'Time %.fms',600~60000" Dmx="0~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Condition Name="Rate" ID="1" If="'Effect_Sel'==1||'Effect_Sel'==2||'Effect_Sel'==3||'Effect_Sel'==5" />
      <Condition Name="Burst" ID="2" If="'Effect_Sel'==4" />
      <Condition Name="Rate (Paparazzi)" ID="3" If="'Effect_Sel'==6" />
      <Condition Name="Sat" ID="4" If="'Effect_Sel'==7||'Effect_Sel'==8" />
      <Else ID="5" />
      <Function ID="1" Name="Rate" Display="'%.1f',1.0~20.0" Dmx="0~255" />
      <Function ID="2" Name="Burst" Display="'%.2f',1.00~4.00" Dmx="0~255" />
      <Function ID="3" Name="Rate" Display="'%.1f',1.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Amplitude" ID="1" If="'Effect_Sel'==1||'Effect_Sel'==2||'Effect_Sel'==3" />
      <Condition Name="Rate" ID="2" If="'Effect_Sel'==4||'Effect_Sel'==7" />
      <Condition Name="Flash" ID="3" If="'Effect_Sel'==6" />
      <Else ID="4" />
      <Function ID="1" Name="Amplitude" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Rate" Display="'%.1f',1.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Flash" Display="'%.1f',1.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Length" ID="1" If="'Effect_Sel'==7" />
      <Else ID="2" />
      <Function ID="1" Name="Length" Display="'%.1f',1.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_5" Name="Effect Param 5" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Sync" ID="1,2" If="'Effect_Sel'&lt;9" />
      <Else ID="3" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Restart Seq" Display="'Restart Seq'" Dmx="255~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="x" Name="x" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="x" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />

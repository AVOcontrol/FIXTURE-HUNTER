<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FreeStyle 31 LED" ShortName="FS 31 LED" Company="Kino Flo" Version="3">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>a9d53c1c-d63d-4f98-bd7a-443144d19662</Thumbnail>
  <History Date="18-03-22" Author="Nic Morris" Comment="Created (based on True Match Firmware 5.0.  note some modes appear to be duplicated, P30 is missing channel allocations for the Tungsten and Daylight controls and RGB assignments don't leave enough space.  made best guess)" Version="0" />
  <History Date="22-03-22" Author="Nic Morris" Comment="Corrected P23 mode mapping (xfade was 16bit).  Added Atlabase ID's." Version="2" />
  <History Date="22-04-22" Author="Nic Morris" Comment="Changed Green/Magenta to default at 0 and renamed for clarity (based on customer feedback it seems values &gt;0 override other controls such as RGB where relevant)." Version="3" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19270" />
  </RDM>
  <AtlaBase TypeID="34d4ddc2-bb5b-4b99-b4c8-b20c27f3b09b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2500" PowerOn="1:2500" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2500.0~9900.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="100% Magenta" Display="'100% Magenta'" Dmx="12~22" Colour="255,255,255" />
      <Function ID="3" Name="+ Mag" Display="'+ Mag %.f%%',100~0" Dmx="23~121" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="122~133" Colour="255,255,255" />
      <Function ID="5" Name="+ Grn" Display="'+ Grn %.f%%',0~100" Dmx="134~232" Colour="255,255,255" />
      <Function ID="6" Name="100% Green" Display="'100% Green'" Dmx="233~243" Colour="255,255,255" />
      <Function ID="7" Name="Neutral" Display="'Neutral'" Dmx="244~255" Colour="255,255,255" />
    </Attribute>

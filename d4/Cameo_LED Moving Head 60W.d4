<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Moving Head 60W" ShortName="LMH RGB60" Company="Cameo" Version="4">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>7c8f3d7c-bdfe-4de6-9a6b-54e411d13972</Thumbnail>
  <History Date="17-12-13" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="13-05-14" Author="Nic Morris" Comment="Fixed 13 DMX channel mapping in response to customer bug report.  Confirmed against manual." Version="2" />
  <History Date="13-05-14" Author="Nic Morris" Comment="Inverted CW spin range." Version="3" />
  <History Date="07-11-25" Author="Nic Morris" Comment="Standardised.  Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="78f51985-863c-4347-a673-080849063336" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="14~27" Colour="255,255,0" />
      <Function ID="3" Name="Magenta" Display="'Magenta'" Dmx="28~41" Colour="255,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="42~55" Colour="0,255,0" />
      <Function ID="5" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="56~69" Colour="255,128,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="70~83" Colour="0,255,255" />
      <Function ID="7" Name="Bright Green" Display="'Bright Green'" Dmx="84~97" Colour="128,255,0" />
      <Function ID="8" Name="Amber" Display="'Amber'" Dmx="98~111" Colour="255,100,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="112~127" Colour="255,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="80~99" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="100~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="120~139" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="140~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~179" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="180~199" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="200~219" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~127" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="138~201" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="4~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="17~33" />
      <Function ID="3" Name="Col/ Gobo in Dark" Display="'Col/ Gobo in Dark'" Dmx="34~50" />
      <Function ID="4" Name="Reset Col/ Gobo" Display="'Reset Col/ Gobo'" Dmx="51~67" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="68~84" />
      <Function ID="6" Name="Program 1" Display="'Program 1'" Dmx="85~101" />
      <Function ID="7" Name="Program 2" Display="'Program 2'" Dmx="102~118" />
      <Function ID="8" Name="Program 3" Display="'Program 3'" Dmx="119~135" />
      <Function ID="9" Name="Program 4" Display="'Program 4'" Dmx="136~152" />
      <Function ID="10" Name="Program 5" Display="'Program 5'" Dmx="153~169" />
      <Function ID="11" Name="Program 6" Display="'Program 6'" Dmx="170~186" />
      <Function ID="12" Name="Program 7" Display="'Program 7'" Dmx="187~203" />
      <Function ID="13" Name="Program 8" Display="'Program 8'" Dmx="204~220" />
      <Function ID="14" Name="Show 1" Display="'Show 1'" Dmx="221~237" />
      <Function ID="15" Name="Show 2" Display="'Show 2'" Dmx="238~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="77887b3c-a52c-4d5f-9cab-833c81a5cc60">
    <Import PearlRef="UKCMLMH608" DiamondRef="" WysiwygRef="" />

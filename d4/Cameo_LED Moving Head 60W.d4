  </Mode>
  <Mode Name="13 DMX" Channels="13" Id="37b83877-bf07-4d17-87e9-63a659f3ef3f">
    <Import PearlRef="UKCMLMH6013" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />

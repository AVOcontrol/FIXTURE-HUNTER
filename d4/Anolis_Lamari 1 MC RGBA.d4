  <AtlaBase TypeID="18be984c-0e67-4193-9b8d-85fa6b333855" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Save Initial" Display="'Save Initial'" Dmx="1~2" />
      <Function ID="3" Name="Show Initial" Display="'Show Initial'" Dmx="3~4" />
      <Function ID="4" Name="Demo on Power On" Display="'Demo on Power On'" Dmx="5~6" />
      <Function ID="5" Name="Insect Friendly Light On" Display="'Insect Friendly Light On'" Dmx="7~8" />
      <Function ID="6" Name="Insect Friendly Light Off" Display="'Insect Friendly Light Off'" Dmx="9~10" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Uncorrected White" Display="'Uncorrected White'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="- Green" Display="'- Green %.1f%%',100.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Uncorrected White" Display="'Uncorrected White'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Tungsten Dimming 2700K" Display="'Tungsten Dimming 2700K'" Dmx="1~10" Colour="0,0,0" />
      <Function ID="3" Name="Tungsten Dimming 3200K" Display="'Tungsten Dimming 3200K'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="4" Name="CTC C-Mix" Display="'CTC C-Mix %.fK',1800~6500" Dmx="21~255" Colour="0,0,0" />
      <Function ID="5" Name="1800K" Display="'1800K'" Dmx="21~21" Colour="0,0,0" />
      <Function ID="6" Name="2700K" Display="'2700K'" Dmx="66~66" Colour="0,0,0" />
      <Function ID="7" Name="3200K" Display="'3200K'" Dmx="91~91" Colour="0,0,0" />
      <Function ID="8" Name="4200K" Display="'4200K'" Dmx="141~141" Colour="0,0,0" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="211~211" Colour="0,0,0" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TRI4U" ShortName="TRI4U" Company="Contest">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="26-10-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Update="Dimmer" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="21~30" Update="Dimmer" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="31~40" Update="Dimmer" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="41~51" Update="Dimmer" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="52~61" Update="Dimmer" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="62~71" Update="Dimmer" Colour="0,0,255" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="72~81" Update="Dimmer" Colour="255,0,127" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="82~92" Update="Dimmer" Colour="255,0,255" />
      <Function ID="10" Name="Cold White" Display="'Cold White'" Dmx="93~102" Update="Dimmer" Colour="230,230,255" />
      <Function ID="11" Name="Warm White" Display="'Warm White'" Dmx="103~112" Update="Dimmer" Colour="255,240,200" />
      <Function ID="12" Name="Macro 1" Display="'Macro 1'" Dmx="113~122" Update="Dimmer" Colour="0,0,0" />
      <Function ID="13" Name="Macro 2" Display="'Macro 2'" Dmx="123~133" Update="Dimmer" Colour="0,0,0" />
      <Function ID="14" Name="Macro 3" Display="'Macro 3'" Dmx="134~143" Update="Dimmer" Colour="0,0,0" />
      <Function ID="15" Name="Macro 4" Display="'Macro 4'" Dmx="144~153" Update="Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Macro 5" Display="'Macro 5'" Dmx="154~163" Update="Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Pattern 1" Display="'Pattern 1'" Dmx="164~174" Update="Dimmer" Colour="0,0,0" />
      <Function ID="18" Name="Pattern 2" Display="'Pattern 2'" Dmx="175~184" Update="Dimmer" Colour="0,0,0" />
      <Function ID="19" Name="Pattern 3" Display="'Pattern 3'" Dmx="185~194" Update="Dimmer" Colour="0,0,0" />
      <Function ID="20" Name="Pattern 4" Display="'Pattern 4'" Dmx="195~204" Update="Dimmer" Colour="0,0,0" />
      <Function ID="21" Name="Pattern 5" Display="'Pattern 5'" Dmx="205~215" Update="Dimmer" Colour="0,0,0" />
      <Function ID="22" Name="Pattern 6" Display="'Pattern 6'" Dmx="216~225" Update="Dimmer" Colour="0,0,0" />
      <Function ID="23" Name="Pattern 7" Display="'Pattern 7'" Dmx="226~235" Update="Dimmer" Colour="0,0,0" />
      <Function ID="24" Name="Pattern 8" Display="'Pattern 8'" Dmx="236~245" Update="Dimmer" Colour="0,0,0" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="246~255" Update="Dimmer" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;11&amp;&amp;'Colour_Macro'&lt;25" />
      <Condition Name="Alt" ID="3,4,5,6" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="4" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="1~189" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
      <Function ID="6" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~24" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="25~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Update="Dimmer" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="21~30" Update="Dimmer" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="31~40" Update="Dimmer" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="41~51" Update="Dimmer" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="52~61" Update="Dimmer" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="62~71" Update="Dimmer" Colour="0,0,255" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="72~81" Update="Dimmer" Colour="255,0,127" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="82~92" Update="Dimmer" Colour="255,0,255" />
      <Function ID="10" Name="Cold White" Display="'Cold White'" Dmx="93~102" Update="Dimmer" Colour="230,230,255" />
      <Function ID="11" Name="Warm White" Display="'Warm White'" Dmx="103~112" Update="Dimmer" Colour="255,240,200" />
      <Function ID="12" Name="Macro 1" Display="'Macro 1'" Dmx="113~122" Update="Dimmer" Colour="0,0,0" />
      <Function ID="13" Name="Macro 2" Display="'Macro 2'" Dmx="123~133" Update="Dimmer" Colour="0,0,0" />
      <Function ID="14" Name="Macro 3" Display="'Macro 3'" Dmx="134~143" Update="Dimmer" Colour="0,0,0" />
      <Function ID="15" Name="Macro 4" Display="'Macro 4'" Dmx="144~153" Update="Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Macro 5" Display="'Macro 5'" Dmx="154~163" Update="Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Pattern 1" Display="'Pattern 1'" Dmx="164~174" Update="Dimmer" Colour="0,0,0" />
      <Function ID="18" Name="Pattern 2" Display="'Pattern 2'" Dmx="175~184" Update="Dimmer" Colour="0,0,0" />
      <Function ID="19" Name="Pattern 3" Display="'Pattern 3'" Dmx="185~194" Update="Dimmer" Colour="0,0,0" />
      <Function ID="20" Name="Pattern 4" Display="'Pattern 4'" Dmx="195~204" Update="Dimmer" Colour="0,0,0" />
      <Function ID="21" Name="Pattern 5" Display="'Pattern 5'" Dmx="205~215" Update="Dimmer" Colour="0,0,0" />
      <Function ID="22" Name="Pattern 6" Display="'Pattern 6'" Dmx="216~225" Update="Dimmer" Colour="0,0,0" />
      <Function ID="23" Name="Pattern 7" Display="'Pattern 7'" Dmx="226~235" Update="Dimmer" Colour="0,0,0" />
      <Function ID="24" Name="Pattern 8" Display="'Pattern 8'" Dmx="236~245" Update="Dimmer" Colour="0,0,0" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="246~255" Update="Dimmer" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~200" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">

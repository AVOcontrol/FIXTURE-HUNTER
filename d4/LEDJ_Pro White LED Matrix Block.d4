<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pro White LED Matrix Block" ShortName="Wht Matrix" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="14-12-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" Update="Dimmer, Master_Dimmer" />
      <Function ID="2" Name="Spot 1" Display="'Spot 1'" Dmx="8~15" Update="Dimmer, Master_Dimmer" />
      <Function ID="3" Name="Spot 2" Display="'Spot 2'" Dmx="16~23" Update="Dimmer, Master_Dimmer" />
      <Function ID="4" Name="Spot 3" Display="'Spot 3'" Dmx="24~31" Update="Dimmer, Master_Dimmer" />
      <Function ID="5" Name="Spot 4" Display="'Spot 4'" Dmx="32~39" Update="Dimmer, Master_Dimmer" />
      <Function ID="6" Name="Spot 5" Display="'Spot 5'" Dmx="40~47" Update="Dimmer, Master_Dimmer" />
      <Function ID="7" Name="Spot 6" Display="'Spot 6'" Dmx="48~55" Update="Dimmer, Master_Dimmer" />
      <Function ID="8" Name="Spot 7" Display="'Spot 7'" Dmx="56~63" Update="Dimmer, Master_Dimmer" />
      <Function ID="9" Name="Spot 8" Display="'Spot 8'" Dmx="64~71" Update="Dimmer, Master_Dimmer" />
      <Function ID="10" Name="Spot 9" Display="'Spot 9'" Dmx="72~79" Update="Dimmer, Master_Dimmer" />
      <Function ID="11" Name="Spot 10" Display="'Spot 10'" Dmx="80~87" Update="Dimmer, Master_Dimmer" />
      <Function ID="12" Name="Spot 11" Display="'Spot 11'" Dmx="88~95" Update="Dimmer, Master_Dimmer" />
      <Function ID="13" Name="Spot 12" Display="'Spot 12'" Dmx="96~103" Update="Dimmer, Master_Dimmer" />
      <Function ID="14" Name="Spot 13" Display="'Spot 13'" Dmx="104~111" Update="Dimmer, Master_Dimmer" />
      <Function ID="15" Name="Spot 14" Display="'Spot 14'" Dmx="112~119" Update="Dimmer, Master_Dimmer" />
      <Function ID="16" Name="Spot 15" Display="'Spot 15'" Dmx="120~127" Update="Dimmer, Master_Dimmer" />
      <Function ID="17" Name="Spot 16" Display="'Spot 16'" Dmx="128~135" Update="Dimmer, Master_Dimmer" />
      <Function ID="18" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer, Master_Dimmer" />
      <Function ID="19" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer, Master_Dimmer" />
      <Function ID="20" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer, Master_Dimmer" />
      <Function ID="21" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer, Master_Dimmer" />
      <Function ID="22" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer, Master_Dimmer" />
      <Function ID="23" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer, Master_Dimmer" />
      <Function ID="24" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer, Master_Dimmer" />
      <Function ID="25" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer, Master_Dimmer" />
      <Function ID="26" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer, Master_Dimmer" />
      <Function ID="27" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer, Master_Dimmer" />
      <Function ID="28" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer, Master_Dimmer" />
      <Function ID="29" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer, Master_Dimmer" />
      <Function ID="30" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer, Master_Dimmer" />
      <Function ID="31" Name="Flow 10" Display="'Flow 10'" Dmx="240~247" Update="Dimmer, Master_Dimmer" />
      <Function ID="32" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Dimmer, Master_Dimmer" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Effect'&gt;17&amp;&amp;'Effect'&lt;32" />
      <Condition Name="Sensitivity" ID="3" If="'Effect'==32" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Effect'&gt;17&amp;&amp;'Effect'&lt;32" />
      <Condition Name="Sensitivity" ID="3" If="'Effect'==32" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="LJWMTRX3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Effect" ChannelOffset="1" Wheel="23" />
    </Include>
  </Mode>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LX200B" ShortName="LX200B" Company="Luxibel" Version="9">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>c7b424d6-09b6-4df6-858b-63ce4cc4a4b6</Thumbnail>
  <History Date="04-10-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="06-11-12" Author="Peter Budd" Comment="Edited colour 1 cto range to a percentage." Version="2" />
  <History Date="22-07-13" Author="Peter Budd" Comment="Created from the Ablelite ADA 70B." Version="3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="4" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="5" />
  <History Date="24-09-17" Author="Nic Morris" Comment="Changed name from Eye-7 RGBW to EYE-7 RGBW.  Revised mode names." Version="6" />
  <History Date="24-09-17" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Simplified shutter and increase wheel resolution.  Inverted P/T Speed." Version="7" />
  <History Date="24-09-17" Author="Nic Morris" Comment="Increased RGBW 16bit wheel resolution." Version="8" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Created from Future Light EYE-7 RGBW (identical)" Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eebaf571-578a-4437-920a-933cab64005b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGBW" Display="'RGBW'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="CTC " Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTC " ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Colour" ID="8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="2000-2700K" Display="'%.fK',2000~2700" Dmx="0~223" Colour="255,240,200" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="4" Name="White 4200K" Display="'White 4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="6" Name="White 8000K" Display="'White 8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.f%%',0~100" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="5" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Display Off" Display="'Display Off'" Dmx="56~63" />
      <Function ID="5" Name="Display On" Display="'Display On'" Dmx="64~71" />
      <Function ID="6" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
  </Control>

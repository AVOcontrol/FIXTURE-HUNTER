    <Attribute ID="DigiFX_Spd" Name="DigiFX Spd" Description="" Group="G">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Original Speed" Display="'Original Speed'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="6~9" />
      <Function ID="3" Name="Speed -" Display="'Speed - %.1f%%',100.0~0.0" Dmx="10~125" />
      <Function ID="4" Name="Original Speed" Display="'Original Speed'" Dmx="126~129" />
      <Function ID="5" Name="Speed +" Display="'Speed + %.1f%%',0.0~100.0" Dmx="130~246" />
    </Attribute>
    <Attribute ID="DigiFX_Pos_X" Name="DigiFX Pos X" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Flex Relative" ID="2" If="'DigiFX/NDI_Sel'==105||'DigiFX/NDI_Sel'==106||'DigiFX/NDI_Sel'==107||'DigiFX/NDI_Sel'==108" />
      <Condition Name="Flex Segmented" ID="3,4" If="'DigiFX/NDI_Sel'==101||'DigiFX/NDI_Sel'==102||'DigiFX/NDI_Sel'==103||'DigiFX/NDI_Sel'==104" />
      <Condition Name="Flex Absolute" ID="5" If="'DigiFX/NDI_Sel'==97||'DigiFX/NDI_Sel'==98||'DigiFX/NDI_Sel'==99||'DigiFX/NDI_Sel'==100" />
      <Condition Name="Fix Position" ID="6" If="'DigiFX/NDI_Sel'==85||'DigiFX/NDI_Sel'==86||'DigiFX/NDI_Sel'==87||'DigiFX/NDI_Sel'==88||'DigiFX/NDI_Sel'==89||'DigiFX/NDI_Sel'==90||'DigiFX/NDI_Sel'==91||'DigiFX/NDI_Sel'==92||'DigiFX/NDI_Sel'==93||'DigiFX/NDI_Sel'==94||'DigiFX/NDI_Sel'==95||'DigiFX/NDI_Sel'==96" />
      <Function ID="1" Name="X Pos" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Left&lt;-&gt;Right" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="4" Name="Column" Display="'Column %.f',1~65" Dmx="1000~65000" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="6" Name="No Function" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="DigiFX_Pos_Y" Name="DigiFX Pos Y" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Flex Relative" ID="2" If="'DigiFX/NDI_Sel'==105||'DigiFX/NDI_Sel'==106||'DigiFX/NDI_Sel'==107||'DigiFX/NDI_Sel'==108" />
      <Condition Name="Flex Segmented" ID="3,4" If="'DigiFX/NDI_Sel'==101||'DigiFX/NDI_Sel'==102||'DigiFX/NDI_Sel'==103||'DigiFX/NDI_Sel'==104" />
      <Condition Name="Flex Absolute" ID="5" If="'DigiFX/NDI_Sel'==97||'DigiFX/NDI_Sel'==98||'DigiFX/NDI_Sel'==99||'DigiFX/NDI_Sel'==100" />
      <Condition Name="Fix Position" ID="6" If="'DigiFX/NDI_Sel'==85||'DigiFX/NDI_Sel'==86||'DigiFX/NDI_Sel'==87||'DigiFX/NDI_Sel'==88||'DigiFX/NDI_Sel'==89||'DigiFX/NDI_Sel'==90||'DigiFX/NDI_Sel'==91||'DigiFX/NDI_Sel'==92||'DigiFX/NDI_Sel'==93||'DigiFX/NDI_Sel'==94||'DigiFX/NDI_Sel'==95||'DigiFX/NDI_Sel'==96" />
      <Function ID="1" Name="Y Pos" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Top&lt;-&gt;Bottom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="4" Name="Line" Display="'Line %.f',1~65" Dmx="1000~65000" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="6" Name="No Function" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="DigiFX_Scale" Name="DigiFX Scale" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4" />
      <Condition Name="Relative Position" ID="5,6,7,8" If="'DigiFX/NDI_Sel'==93||'DigiFX/NDI_Sel'==94||'DigiFX/NDI_Sel'==95||'DigiFX/NDI_Sel'==96||'DigiFX/NDI_Sel'==105||'DigiFX/NDI_Sel'==106||'DigiFX/NDI_Sel'==107||'DigiFX/NDI_Sel'==108" />
      <Function ID="1" Name="Original Size" Display="'Original Size'" Dmx="0~0" />
      <Function ID="2" Name="Scale -" Display="'Scale - %.1f%%',0.0~100.0" Dmx="10~127" />
      <Function ID="3" Name="Original Size" Display="'Original Size'" Dmx="128~128" />
      <Function ID="4" Name="Scale +" Display="'Scale + %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="5" Name="Original Size 1:1" Display="'Original Size 1:1'" Dmx="0~0" />
      <Function ID="6" Name="Scale -" Display="'Scale - %.1f%%',0.0~100.0" Dmx="10~127" />
      <Function ID="7" Name="Original Size (Original Capture Size)" Display="'Original Size (Original Capture Size)'" Dmx="128~128" />
      <Function ID="8" Name="Scale +" Display="'Scale + %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="DigiFX_Rot" Name="DigiFX Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotation" Display="'Rotation %.f°',0~359" Dmx="0~255" />
      <Function ID="2" Name="0°" Display="'0°'" Dmx="0~0" />
      <Function ID="3" Name="45°" Display="'45°'" Dmx="32~32" />
      <Function ID="4" Name="90°" Display="'90°'" Dmx="64~64" />
      <Function ID="5" Name="135°" Display="'135°'" Dmx="96~96" />
      <Function ID="6" Name="180°" Display="'180°'" Dmx="128~128" />
      <Function ID="7" Name="225°" Display="'225°'" Dmx="160~160" />
      <Function ID="8" Name="270°" Display="'270°'" Dmx="192~192" />
      <Function ID="9" Name="315°" Display="'315°'" Dmx="224~224" />
    </Attribute>
    <Attribute ID="DigiFX_Shape_1" Name="DigiFX Shape 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

  <History Date="24-05-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-08-18" Author="Nic Morris" Comment="Added missing Atlabase ID to 3 DMX mode.  Added vdim to all multi-pixel mode cells.  Added product thumbnail." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="327da7d9-b0b1-424e-afb9-fb927d690f1c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Strobe" ID="2" If="'Control'==2||'Control'==3||'Control'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="8~15" Update="Dimmer" />
      <Function ID="3" Name="Mode" Display="'Mode %.f',1~27" Dmx="16~231" Update="Dimmer" />
      <Function ID="4" Name="Sound" Display="'Sound %.f',1~3" Dmx="232~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

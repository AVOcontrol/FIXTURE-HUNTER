  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4fb9a7e5-57cc-45cb-9bd1-f247fed76e71" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Bubble" Name="Bubble" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan_Speed" Name="Fan Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Cleaning" Name="Cleaning" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Bubble Cleaning" Display="'Bubble Cleaning'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~24" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="25~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~66" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="67~87" Colour="255,100,0" />
      <Function ID="6" Name="Sky Blue" Display="'Sky Blue'" Dmx="88~108" Colour="0,128,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="109~129" Colour="255,255,0" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="130~150" Colour="128,0,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="151~171" Colour="255,255,255" />
      <Function ID="10" Name="RGBY Fade" Display="'RGBY Fade'" Dmx="172~192" Colour="255,255,255" />
      <Function ID="11" Name="8 Col Fade" Display="'8 Col Fade'" Dmx="193~213" Colour="255,255,255" />
      <Function ID="12" Name="RGBY Scroll" Display="'RGBY Scroll'" Dmx="214~234" Colour="255,255,255" />
      <Function ID="13" Name="8 Col Scroll" Display="'8 Col Scroll'" Dmx="235~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="226011bf-94aa-4b92-acef-78084dbaa26e">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

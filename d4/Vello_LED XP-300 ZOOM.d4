  <History Date="29-12-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="23-10-18" Author="Nic Morris" Comment="Added Atlabase ID's (currently missing 11 channel mode).  Added product thumbnail." Version="2" />
  <History Date="26-10-18" Author="Nic Morris" Comment="Added Atlabase ID to 11 channel mode.  Revised 14 channel mode ID.  Inverted zoom." Version="3" />
  <History Date="23-05-21" Author="Nic Morris" Comment="Added Reduced, 13 DMX and Standard, 16 DMX modes in line with 2017 ver06.15 manual." Version="4" />
  <History Date="25-05-21" Author="Nic Morris" Comment="Added Atlabase ID's to 13 and 16 channel modes." Version="5" />
  <History Date="25-03-25" Author="Nic Morris" Comment="Changed Reduced and Standard mode zoom so that it runs 0-&gt;255 = wide-&gt;narrow in response to customer feedback (this is contrary to the documentation)" Version="6" />
  <History Date="25-09-25" Author="Nic Morris" Comment="Added alternative 14 channel mode." Version="7" />
  <Manual Filename="" Summary="" />

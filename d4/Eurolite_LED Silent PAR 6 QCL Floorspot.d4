  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9461405b-b903-44e1-bd5d-43b5623f7569" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="206~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="6~55" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="56~105" />
      <Function ID="5" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="156~205" />
      <Function ID="6" Name="On/Off" Display="'On/Off %.f%%',0~100" Dmx="106~155" />
    </Attribute>
    <Attribute ID="Col_Mix_Preset" Name="Col Mix Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="2~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Preset" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~15" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~25" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="26~35" Colour="0,0,255" />
      <Function ID="5" Name="Colour Mix 1" Display="'Colour Mix 1'" Dmx="36~45" Colour="0,0,0" />
      <Function ID="6" Name="Colour Mix 2" Display="'Colour Mix 2'" Dmx="46~55" Colour="0,0,0" />
      <Function ID="7" Name="Colour Mix 3" Display="'Colour Mix 3'" Dmx="56~65" Colour="0,0,0" />
      <Function ID="8" Name="Colour Mix 4" Display="'Colour Mix 4'" Dmx="66~75" Colour="0,0,0" />
      <Function ID="9" Name="Colour Mix 5" Display="'Colour Mix 5'" Dmx="76~85" Colour="0,0,0" />
      <Function ID="10" Name="Colour Mix 6" Display="'Colour Mix 6'" Dmx="86~95" Colour="0,0,0" />
      <Function ID="11" Name="Colour Mix 7" Display="'Colour Mix 7'" Dmx="96~105" Colour="0,0,0" />
      <Function ID="12" Name="Colour Mix 8" Display="'Colour Mix 8'" Dmx="106~115" Colour="0,0,0" />
      <Function ID="13" Name="Colour Mix 9" Display="'Colour Mix 9'" Dmx="116~125" Colour="0,0,0" />
      <Function ID="14" Name="Colour Mix 10" Display="'Colour Mix 10'" Dmx="126~135" Colour="0,0,0" />
      <Function ID="15" Name="Colour Mix 11" Display="'Colour Mix 11'" Dmx="136~145" Colour="0,0,0" />
      <Function ID="16" Name="Colour Mix 12" Display="'Colour Mix 12'" Dmx="146~155" Colour="0,0,0" />
      <Function ID="17" Name="Colour Mix 13" Display="'Colour Mix 13'" Dmx="156~165" Colour="0,0,0" />
      <Function ID="18" Name="Colour Mix 14" Display="'Colour Mix 14'" Dmx="166~175" Colour="0,0,0" />
      <Function ID="19" Name="Colour Mix 15" Display="'Colour Mix 15'" Dmx="176~185" Colour="0,0,0" />
      <Function ID="20" Name="Colour Mix 16" Display="'Colour Mix 16'" Dmx="186~195" Colour="0,0,0" />
      <Function ID="21" Name="White 1" Display="'White 1'" Dmx="196~205" Colour="0,0,0" />
      <Function ID="22" Name="White 2" Display="'White 2'" Dmx="206~215" Colour="0,0,0" />
      <Function ID="23" Name="Warm White" Display="'Warm White'" Dmx="216~225" Colour="0,0,0" />
      <Function ID="24" Name="White 4" Display="'White 4'" Dmx="226~235" Colour="0,0,0" />
      <Function ID="25" Name="White 5" Display="'White 5'" Dmx="236~245" Colour="0,0,0" />
      <Function ID="26" Name="White 6" Display="'White 6'" Dmx="246~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="11~40" Update="Auto_Spd" />
      <Function ID="3" Name="RGB Fade" Display="'RGB Fade'" Dmx="41~70" Update="Auto_Spd" />
      <Function ID="4" Name="RGB (lower CT) Fade" Display="'RGB (lower CT) Fade'" Dmx="71~100" Update="Auto_Spd" />
      <Function ID="5" Name="7 Col Switch" Display="'7 Col Switch'" Dmx="101~130" Update="Auto_Spd" />
      <Function ID="6" Name="RGB Switch" Display="'RGB Switch'" Dmx="131~160" Update="Auto_Spd" />
      <Function ID="7" Name="RGB (lower CT) Switch" Display="'RGB (lower CT) Switch'" Dmx="161~190" Update="Auto_Spd" />
      <Function ID="8" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="191~220" Update="Auto_Spd" />
      <Function ID="9" Name="Sound Col Change" Display="'Sound Col Change'" Dmx="221~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound Strobe" ID="2" If="'Auto'==8||'Auto'==9" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LED Response" Display="'LED Response'" Dmx="0~0" />
      <Function ID="2" Name="Halogen Response Very Fast" Display="'Halogen Response Very Fast'" Dmx="21~40" />
      <Function ID="3" Name="Halogen Response Fast" Display="'Halogen Response Fast'" Dmx="41~60" />
      <Function ID="4" Name="Halogen Response Med" Display="'Halogen Response Med'" Dmx="61~80" />
      <Function ID="5" Name="Halogen Response Slow" Display="'Halogen Response Slow'" Dmx="81~100" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
  </Control>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e27f5be4-820f-4005-88be-108ab67eb9c7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="White CCT" Description="" Group="C">
      <Locate Locate="1:3000" PowerOn="1:3000" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',3000~6500" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="3000K" Display="'3000K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="73~73" Colour="0,0,0" />
      <Function ID="4" Name="4800K" Display="'4800K'" Dmx="131~131" Colour="0,0,0" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="189~189" Colour="0,0,0" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="White_Bm_Angle" Name="White Bm Angle" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="NEMA 3 (Narrow Optic)/ NEMA 5 (Wide Optic)" Display="'NEMA 3 (Narrow Optic)/ NEMA 5 (Wide Optic)'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="NEMA 4 (Narrow Optic)/ NEMA 6 (Wide Optic)" Display="'NEMA 4 (Narrow Optic)/ NEMA 6 (Wide Optic)'" Dmx="128~128" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="NEMA 5 (Narrow Optic)/ NEMA 7 (Wide Optic)" Display="'NEMA 5 (Narrow Optic)/ NEMA 7 (Wide Optic)'" Dmx="255~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10" Id="fbe5be8f-3625-4fdd-a0db-41ef75b4d8f5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="206911aa-473e-49bd-81c9-08b1f8ad46bd" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="CCT" Wheel="7" />
        <Attribute ID="White_Bm_Angle" Wheel="19" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Amber" Wheel="40" />
        <Attribute ID="Reserved" ChannelOffset="8" Wheel="28" />
        <Attribute ID="Reserved1" ChannelOffset="9" Wheel="29" />
        <Attribute ID="Reserved2" ChannelOffset="10" Wheel="30" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="1" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="CCT" TargetId="CCT" />
        <AttributeLink SourceId="White_Bm_Angle" TargetId="White_Bm_Angle" />
      </Cell>
      <Cell ID="Cell2" Name="RGBA" ChannelOffset="4" ModeLink="RGBA cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="White cell" Channels="3" Hidden="True" Id="f88167fc-17ce-41b3-b365-a919199e5e02">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="7" />
      <Attribute ID="White_Bm_Angle" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="RGBA cell" Channels="4" Hidden="True" Id="03e4d664-070a-4cb7-8841-405bdef5016d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />

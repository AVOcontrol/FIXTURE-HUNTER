      <Function ID="2" Name="Highlights" Display="'Highlights'" Dmx="64~127" />
      <Function ID="3" Name="Bars" Display="'Bars'" Dmx="128~191" />
      <Function ID="4" Name="Points" Display="'Points'" Dmx="192~255" />
    </Attribute>
  </Control>

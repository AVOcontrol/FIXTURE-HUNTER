      <Function ID="2" Name="Small" Display="'Small %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="3" Name="Large" Display="'Large %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colours" Display="'Colours %.1f%%',0.0~100.0" Dmx="28~169" Colour="255,255,255" />
      <Function ID="3" Name="Colour Change" Display="'Colour Change'" Dmx="170~220" Colour="255,255,255" />
      <Function ID="4" Name="Different Cols" Display="'Different Cols'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Gobo1, Shutter" />
      <Function ID="2" Name="PRG show" Display="'PRG show'" Dmx="74~110" Update="Gobo1, Shutter" />
      <Function ID="3" Name="ILD show" Display="'ILD show'" Dmx="111~147" Update="Gobo1, Shutter" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="148~184" Update="Gobo1, Shutter" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="185~221" Update="Gobo1, Shutter" />
      <Function ID="6" Name="Manual" Display="'Manual'" Dmx="222~255" Update="Gobo1, Shutter" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Folders" ID="2" If="'Mode'==2||'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter/File" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Shows" ID="4" If="'Mode'==2||'Mode'==3" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" Intensity="0~0" />
      <Function ID="4" Name="File" Display="'%.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="X-Moving" Name="X-Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto L-R" Display="'Auto L-R %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Auto R-L" Display="'Auto R-L %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rnd Pos" Display="'Rnd Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound Rnd" Display="'Sound Rnd'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Moving" Name="Y-Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto Up-Dn" Display="'Auto Up-Dn %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Auto Dn-Up" Display="'Auto Dn-Up %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rnd Pos" Display="'Rnd Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound Rnd" Display="'Sound Rnd'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom In" Display="'Zoom In %.f%%',0~100" Dmx="101~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X_Roll" Name="X Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Y_Roll" Name="Y Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />

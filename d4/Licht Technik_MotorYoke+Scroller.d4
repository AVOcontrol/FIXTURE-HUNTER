<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MotorYoke+Scroller" ShortName="MtrYk+Scrl" Company="Licht Technik">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="30-07-18" Author="Nic Morris" Comment="Created (charts provided by customer - can't find any other information about exactly what this is)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="A-1" Display="'A-1'" Dmx="7~19" Colour="255,255,255" />
      <Function ID="3" Name="A-2" Display="'A-2'" Dmx="20~32" Colour="255,255,255" />
      <Function ID="4" Name="L203" Display="'L203'" Dmx="33~45" Colour="255,255,255" />
      <Function ID="5" Name="L202" Display="'L202'" Dmx="46~58" Colour="255,255,255" />
      <Function ID="6" Name="73" Display="'73'" Dmx="59~71" Colour="255,255,255" />
      <Function ID="7" Name="L142" Display="'L142'" Dmx="72~84" Colour="255,255,255" />
      <Function ID="8" Name="L180" Display="'L180'" Dmx="85~97" Colour="255,255,255" />
      <Function ID="9" Name="22" Display="'22'" Dmx="98~110" Colour="255,255,255" />
      <Function ID="10" Name="58" Display="'58'" Dmx="111~123" Colour="255,255,255" />
      <Function ID="11" Name="R54" Display="'R54'" Dmx="124~136" Colour="255,255,255" />
      <Function ID="12" Name="31" Display="'31'" Dmx="137~149" Colour="255,255,255" />
      <Function ID="13" Name="17" Display="'17'" Dmx="150~162" Colour="255,255,255" />
      <Function ID="14" Name="67" Display="'67'" Dmx="163~175" Colour="255,255,255" />
      <Function ID="15" Name="40" Display="'40'" Dmx="176~188" Colour="255,255,255" />
      <Function ID="16" Name="59" Display="'59'" Dmx="189~201" Colour="255,255,255" />
      <Function ID="17" Name="38" Display="'38'" Dmx="202~214" Colour="255,255,255" />
      <Function ID="18" Name="78" Display="'78'" Dmx="215~227" Colour="255,255,255" />
      <Function ID="19" Name="16" Display="'16'" Dmx="228~240" Colour="255,255,255" />
      <Function ID="20" Name="77" Display="'77'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Fan_Speed" Name="Fan Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="LTMYSCR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Pan_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Tilt_Speed" ChannelOffset="6" Wheel="26" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Colour_Speed" ChannelOffset="9" Wheel="27" />
      <Attribute ID="Fan_Speed" ChannelOffset="10" Wheel="55" />
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
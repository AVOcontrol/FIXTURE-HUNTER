  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="W Bal Reset">
      <Set Channel="W_Bal_Reset:2" Delay="6000" />
      <Set Channel="W_Bal_Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Toggle OSD">
      <Set Channel="Display:2" Delay="6000" />
      <Set Channel="Display:1" Delay="0" />
    </Macro>
  </Macro>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SBL-3000" ShortName="SBL-3000" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="30-01-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~9" Update="Dimmer, Shutter" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~249" Update="Dimmer, Shutter" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Dimmer, Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Auto" ID="2" If="'Control'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Program" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Sensitivity" ID="3" If="'Control'==3" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Speed" Colour="255,255,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Update="Speed" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Update="Speed" Colour="255,255,255" />
      <Function ID="5" Name="Turquoise" Display="'Turquoise'" Dmx="40~49" Update="Speed" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Update="Speed" Colour="255,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Update="Speed" Colour="255,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="80~89" Update="Speed" Colour="255,255,255" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="90~99" Update="Speed" Colour="255,255,255" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="100~109" Update="Speed" Colour="255,255,255" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="110~119" Update="Speed" Colour="255,255,255" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="120~129" Update="Speed" Colour="255,255,255" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="130~139" Update="Speed" Colour="255,255,255" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="140~149" Update="Speed" Colour="255,255,255" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="150~159" Update="Speed" Colour="255,255,255" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="160~169" Update="Speed" Colour="255,255,255" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="170~179" Update="Speed" Colour="255,255,255" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="180~189" Update="Speed" Colour="255,255,255" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="190~199" Update="Speed" Colour="255,255,255" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="200~209" Update="Speed" Colour="255,255,255" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="210~219" Update="Speed" Colour="255,255,255" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="220~229" Update="Speed" Colour="255,255,255" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="230~239" Update="Speed" Colour="255,255,255" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Speed" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==25" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
        <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="10" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="IVSBL3K1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter1" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="IVSBL3K2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>

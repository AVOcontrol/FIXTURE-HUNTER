<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Generic RGB" ShortName="RGB" Company="Generic" Version="23">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="06-11-02" Author="D.Shelton" Comment="Created" Version="1" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" Version="2" />
  <History Date="23-05-05" Author="Phil Rogers" Comment="Added mode with virtual dimmer" Version="3" />
  <History Date="23-05-05" Author="Phil Rogers" Comment="Revised high/lowlight values" Version="4" />
  <History Date="11-05-06" Author="Ed" Comment="Fixed 3DMX mode to use Red Green and Blue and not Red1 Green1 or Blue1" Version="5" />
  <History Date="27-07-06" Author="Phil" Comment="Fixed V Dimmer channels for Green &amp; Blue" Version="6" />
  <History Date="09-01-09" Author="Jonathan Moreton" Comment="Updated and tidied" Version="7" />
  <History Date="13-01-09" Author="David Hunt" Comment="Checked" Version="8" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="9" />
  <History Date="03-08-09" Author="David Hunt" Comment="Added RGB 3x Mode" Version="10" />
  <History Date="06-05-10" Author="John Rogers" Comment="Edited device name to prevent conflict." Version="11" />
  <History Date="26-07-11" Author="Nic Morris" Comment="Removed non-vdim 4 cell mode.  Renamed modes.  Added 2 &amp; 5 thru 12 cell options." Version="12" />
  <History Date="26-07-11" Author="Nic Morris" Comment="Standardised wheel mapping.  Added pixel mapper compatibility." Version="13" />
  <History Date="02-07-13" Author="Gregory Haynes" Comment="Added Pearl reference for RGB + Virtual Dimmer mode" Version="14" />
  <History Date="16-01-14" Author="Peter Budd" Comment="Added 170 RGB Cell mode." Version="15" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="16" />
  <History Date="03-02-15" Author="Peter Budd" Comment="Added 59 Cell Mode." Version="17" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Revised classic ref in RGB + Virtual Dimmer and 1x RGB, 3 DMX modes to fix vis auto patch in response to distributor bug report." Version="18" />
  <History Date="30-03-19" Author="Nic Morris" Comment="Added 31x RGB mode." Version="19" />
  <History Date="26-02-22" Author="Nic Morris" Comment="Added 36x RGB mode." Version="20" />
  <History Date="20-11-22" Author="Nic Morris" Comment="Added 150x RGB mode." Version="21" />
  <History Date="10-12-22" Author="Nic Morris" Comment="Added 90x RGB mode." Version="22" />
  <History Date="12-09-23" Author="Gregory Haynes" Comment="Added 16x, 32x, 64x and 128x RGB modes." Version="23" />
  <Manual Filename="" Summary="" />
  <Control>

      <Function ID="16" Name="WW/ Op" Display="'WW/ Op'" Dmx="150~159" WheelPosition="7" Colour="255,240,200" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~227" Colour="0,0,0" />

      <Condition Name="Scroll" ID="17,18,19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~29" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~49" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~69" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="80~89" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="100~109" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="120~129" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Warm White" Display="'Warm White'" Dmx="140~149" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="10~19" WheelPosition="0" Colour="255,255,255" />

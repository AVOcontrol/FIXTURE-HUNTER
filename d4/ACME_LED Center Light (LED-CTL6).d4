<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Center Light (LED-CTL6)" ShortName="Center Lt" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-01-12" Author="Nic Morris" Comment="Created" />
  <History Date="07-05-17" Author="Nic Morris" Comment="Changed name from LED CTL6 to LED Center Light (LED-CTL6)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Movement" Name="Movement" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Movement 1" Display="'Movement 1'" Dmx="10~29" />
      <Function ID="3" Name="Movement 2" Display="'Movement 2'" Dmx="30~49" />
      <Function ID="4" Name="Movement 3" Display="'Movement 3'" Dmx="50~69" />
      <Function ID="5" Name="Movement 4" Display="'Movement 4'" Dmx="70~89" />
      <Function ID="6" Name="Movement 5" Display="'Movement 5'" Dmx="90~109" />
      <Function ID="7" Name="Movement 6" Display="'Movement 6'" Dmx="110~129" />
      <Function ID="8" Name="Movement 7" Display="'Movement 7'" Dmx="130~149" />
      <Function ID="9" Name="Movement 8" Display="'Movement 8'" Dmx="150~169" />
      <Function ID="10" Name="Movement 9" Display="'Movement 9'" Dmx="170~189" />
      <Function ID="11" Name="Movement 10" Display="'Movement 10'" Dmx="190~209" />
      <Function ID="12" Name="Movement 11" Display="'Movement 11'" Dmx="210~229" />
      <Function ID="13" Name="Movement 12" Display="'Movement 12'" Dmx="230~249" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Move_Speed" Name="Move Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="10~29" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="30~49" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="50~69" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="70~89" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="90~109" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="110~129" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="130~149" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="150~169" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="170~189" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="190~209" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="210~229" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="230~249" Colour="0,0,0" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="AME_LDCTL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Movement" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Move_Speed" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Macro_Speed" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
</Fixture>
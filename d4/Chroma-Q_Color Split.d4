  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-09-07" Author="D.Milligan" Comment="Created" />
  <History Date="04-09-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="30-06-09" Author="David Hunt" Comment="Added Virtual Dimmers to the mode" />
  <History Date="12-06-11" Author="Nic Morris" Comment="Changed intensity to intensity group and dimmer wheel mapping" />
  <History Date="12-06-11" Author="Nic Morris" Comment="Added virtual intensity to mode 7.  Added pixel mapper compatibility." />
  <History Date="14-06-11" Author="Nic Morris" Comment="Changed HSI intensity to HTP attribute." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added some missing Atlabase ID's." />
  <History Date="06-09-16" Author="Nic Morris" Comment="Added remaining Atlabase ID's." />
  <History Date="14-10-17" Author="Nic Morris" Comment="Changed manufacturer name from Chroma Q to Chroma-Q.  Revised mode names." />
  <History Date="14-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." />

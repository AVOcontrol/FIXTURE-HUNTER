    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2500~10000" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="-0.02" Display="'-0.02 %.1f%%',100.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="0" Display="'0'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="+0.02" Display="'+0.02 %.1f%%',0.0~100.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>

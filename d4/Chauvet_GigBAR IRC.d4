<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GigBAR IRC" ShortName="GigBAR" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="28-12-16" Author="Nic Morris" Comment="Created" />
  <History Date="04-03-17" Author="Nic Morris" Comment="Changed name from GigaBAR IRC to GigBAR IRC" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Auto Mixed" Display="'Auto Mixed %.1f%%',0.0~100.0" Dmx="229~10" />
      <Function ID="3" Name="Sound Mixed" Display="'Sound Mixed'" Dmx="230~239" />
      <Function ID="4" Name="Show" Display="'Show'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto Par" Display="'Auto Par'" Dmx="10~19" />
      <Function ID="3" Name="Auto Derby" Display="'Auto Derby'" Dmx="20~29" />
      <Function ID="4" Name="Auto Laser" Display="'Auto Laser'" Dmx="30~39" />
      <Function ID="5" Name="Auto Strobe" Display="'Auto Strobe'" Dmx="40~49" />
      <Function ID="6" Name="Auto Par+Derby" Display="'Auto Par+Derby'" Dmx="50~59" />
      <Function ID="7" Name="Auto Par+Laser" Display="'Auto Par+Laser'" Dmx="60~69" />
      <Function ID="8" Name="Auto Par+Strobe" Display="'Auto Par+Strobe'" Dmx="70~79" />
      <Function ID="9" Name="Auto Derby+Laser" Display="'Auto Derby+Laser'" Dmx="80~89" />
      <Function ID="10" Name="Auto Derby+Strobe" Display="'Auto Derby+Strobe'" Dmx="90~99" />
      <Function ID="11" Name="Auto Par+Derby+Laser" Display="'Auto Par+Derby+Laser'" Dmx="100~109" />
      <Function ID="12" Name="Auto Par+Derby+Strobe" Display="'Auto Par+Derby+Strobe'" Dmx="110~119" />
      <Function ID="13" Name="Auto Par+Laser+Strobe" Display="'Auto Par+Laser+Strobe'" Dmx="120~129" />
      <Function ID="14" Name="Auto All" Display="'Auto All'" Dmx="130~139" />
      <Function ID="15" Name="Sound Par" Display="'Sound Par'" Dmx="140~149" />
      <Function ID="16" Name="Sound Derby" Display="'Sound Derby'" Dmx="150~159" />
      <Function ID="17" Name="Sound Laser" Display="'Sound Laser'" Dmx="160~169" />
      <Function ID="18" Name="Sound Par+Derby" Display="'Sound Par+Derby'" Dmx="170~179" />
      <Function ID="19" Name="Sound Par+Laser" Display="'Sound Par+Laser'" Dmx="180~189" />
      <Function ID="20" Name="Sound Par+Strobe" Display="'Sound Par+Strobe'" Dmx="190~199" />
      <Function ID="21" Name="Sound Derby+Laser" Display="'Sound Derby+Laser'" Dmx="200~209" />
      <Function ID="22" Name="Sound Derby+Strobe" Display="'Sound Derby+Strobe'" Dmx="210~219" />
      <Function ID="23" Name="Sound Par+Derby+Laser" Display="'Sound Par+Derby+Laser'" Dmx="220~229" />
      <Function ID="24" Name="Sound Par+Derby+Strobe" Display="'Sound Par+Derby+Strobe'" Dmx="230~239" />
      <Function ID="25" Name="Sound Par+Laser+Strobe" Display="'Sound Par+Laser+Strobe'" Dmx="240~249" />
      <Function ID="26" Name="Sound All" Display="'Sound All'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="9 DMX" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~239" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Derby_Rot" Name="Derby Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Red_Laser_Strobe" Name="Red Laser Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~54" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="55~255" />
    </Attribute>
    <Attribute ID="Green_Laser_Strobe" Name="Green Laser Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~54" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="55~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~54" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="55~255" />
    </Attribute>
    <Attribute ID="PAR_Strobe" Name="PAR Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="127~127" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~249" />
    </Attribute>
    <Attribute ID="Derby_Col" Name="Derby Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~74" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="75~99" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="100~124" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="125~149" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="150~174" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="175~199" Colour="255,255,255" />
      <Function ID="9" Name="1 Col Auto" Display="'1 Col Auto'" Dmx="200~224" Colour="255,255,255" />
      <Function ID="10" Name="2 Col Auto" Display="'2 Col Auto'" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Derby_Strobe" Name="Derby Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Laser Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red On" Display="'Red On'" Dmx="40~79" Colour="255,255,255" />
      <Function ID="3" Name="Green On" Display="'Green On'" Dmx="80~119" Colour="255,255,255" />
      <Function ID="4" Name="R+G On" Display="'R+G On'" Dmx="120~159" Colour="255,255,255" />
      <Function ID="5" Name="R+G Strobe" Display="'R+G Strobe'" Dmx="160~199" Colour="255,255,255" />
      <Function ID="6" Name="G On, R Strobe" Display="'G On, R Strobe'" Dmx="200~239" Colour="255,255,255" />
      <Function ID="7" Name="R+G Alt Strobe" Display="'R+G Alt Strobe'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Strobe_Pattern" Name="Strobe Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~29" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="30~49" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="50~69" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="70~89" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="90~109" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="110~129" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="130~149" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="150~169" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="170~189" />
      <Function ID="11" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~209" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Strobe_Shutter" Name="Strobe Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Dimmer" Name="Strobe Dimmer" Description="" Group="I" Size="0">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="CHGGABR3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto1" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="3" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="CHGGABR9" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Derby_Rot" ChannelOffset="5" Wheel="19" />
      <Attribute ID="Red_Laser_Strobe" ChannelOffset="6" Wheel="64" />
      <Attribute ID="Green_Laser_Strobe" ChannelOffset="7" Wheel="65" />
      <Attribute ID="Laser_Rot" ChannelOffset="8" Wheel="20" />
      <Attribute ID="LED_Strobe" ChannelOffset="9" Wheel="5" />
      <Attribute ID="Dummy" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="20 DMX" Channels="20">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="PAR_Strobe" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Derby_Col" Wheel="7" />
        <Attribute ID="Derby_Strobe" Wheel="6" />
        <Attribute ID="Derby_Rot" Wheel="19" />
        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Laser_Strobe" Wheel="34" />
        <Attribute ID="Laser_Rot" Wheel="20" />
        <Attribute ID="Strobe_Pattern" Wheel="52" />
        <Attribute ID="Strobe_Shutter" Wheel="36" />
        <Attribute ID="Strobe_Dimmer" Wheel="35" />
      </Master>
      <Cell ID="Cell1" Name="Par 1" ChannelOffset="1" ModeLink="Par cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="PAR_Strobe" TargetId="PAR_Strobe" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Par 2" ChannelOffset="5" ModeLink="Par cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="PAR_Strobe" TargetId="PAR_Strobe" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Derby 1" ChannelOffset="9" ModeLink="Derby cell" X="0" Y="2">
        <AttributeLink SourceId="Derby_Col" TargetId="Derby_Col" />
        <AttributeLink SourceId="Derby_Strobe" TargetId="Derby_Strobe" />
        <AttributeLink SourceId="Derby_Rot" TargetId="Derby_Rot" />
      </Cell>
      <Cell ID="Cell4" Name="Derby 2" ChannelOffset="12" ModeLink="Derby cell" X="0" Y="3">
        <AttributeLink SourceId="Derby_Col" TargetId="Derby_Col" />
        <AttributeLink SourceId="Derby_Strobe" TargetId="Derby_Strobe" />
        <AttributeLink SourceId="Derby_Rot" TargetId="Derby_Rot" />
      </Cell>
      <Cell ID="Cell5" Name="Laser" ChannelOffset="15" ModeLink="Laser cell v1" X="0" Y="4">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
        <AttributeLink SourceId="Laser_Strobe" TargetId="Laser_Strobe" />
        <AttributeLink SourceId="Laser_Rot" TargetId="Laser_Rot" />
      </Cell>
      <Cell ID="Cell6" Name="Strobe" ChannelOffset="18" ModeLink="Strobe cell" X="0" Y="5">
        <AttributeLink SourceId="Strobe_Pattern" TargetId="Strobe_Pattern" />
        <AttributeLink SourceId="Strobe_Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Strobe_Shutter" TargetId="Strobe_Shutter" />
      </Cell>
    </Cells>
  </Mode>

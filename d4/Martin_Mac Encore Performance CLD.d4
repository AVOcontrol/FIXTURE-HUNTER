      <Function ID="19" Name="Congo" Display="'Congo'" Dmx="70~70" WheelPosition="10" Colour="0,0,128" />
      <Function ID="20" Name="Cg - Rd" Display="'Cg - Rd %.f%%',0~100" Dmx="70~84" WheelPosition="11" Colour="0,0,128" />
      <Function ID="21" Name="Red" Display="'Red'" Dmx="84~84" WheelPosition="12" Colour="255,0,0" />
      <Function ID="22" Name="Rd - Op" Display="'Rd - Op %.f%%',0~100" Dmx="84~98" WheelPosition="13" Colour="255,0,0" />
      <Function ID="23" Name="Open" Display="'Open'" Dmx="98~160" WheelPosition="14" Colour="255,255,255" />
      <Function ID="24" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~98" Colour="0,0,0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="29" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="30" Name="Rnd Slow" Display="'Rnd Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="31" Name="Rnd Med" Display="'Rnd Med'" Dmx="248~251" Colour="0,0,0" />
      <Function ID="32" Name="Rnd Fast" Display="'Rnd Fast'" Dmx="244~247" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />

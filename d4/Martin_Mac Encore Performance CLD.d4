      <Condition Name="Scroll" ID="25,26,27,28" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="29,30,31,32" If="'Colour1Func'==4" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="161~163" WheelPosition="2" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="164~166" WheelPosition="4" Colour="0,255,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="167~169" WheelPosition="6" Colour="255,128,0" />

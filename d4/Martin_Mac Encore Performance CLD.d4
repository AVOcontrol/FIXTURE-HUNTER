    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="601~32130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32131~32895" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64515" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="65535~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Animation_Rot" />
      <Function ID="2" Name="Horiz Index" Display="'Horiz Index'" Dmx="6~10" Update="Animation_Rot" />
      <Function ID="3" Name="Horiz Spin" Display="'Horiz Spin'" Dmx="11~15" Update="Animation_Rot" />
      <Function ID="4" Name="Vert Spin" Display="'Vert Spin'" Dmx="16~20" Update="Animation_Rot" />
      <Function ID="5" Name="Vert Index" Display="'Vert Index'" Dmx="21~25" Update="Animation_Rot" />
      <Function ID="6" Name="Angled Pos Spin" Display="'Angled Pos Spin'" Dmx="26~110" Update="Animation_Rot" />
      <Function ID="7" Name="Angled Pos Vert Index" Display="'Angled Pos Vert Index'" Dmx="111~195" Update="Animation_Rot" />
      <Function ID="8" Name="Angled Pos Horiz Index" Display="'Angled Pos Horiz Index'" Dmx="196~255" Update="Animation_Rot" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Animation_Rot" />
    </Attribute>
    <Attribute ID="Animation_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Animation'==1" />
      <Condition Name="Index" ID="2" If="'Animation'==2||'Animation'==5||'Animation'==7||'Animation'==8" />
      <Condition Name="Spin" ID="3,4,5,6,7" If="'Animation'==3||'Animation'==4||'Animation'==6" />
      <Else ID="8" />
      <Function ID="1" Name="No Function" Display="''" Dmx="127~127" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin 0°" Display="'No Spin 0°'" Dmx="0~2" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="253~130" />
      <Function ID="7" Name="No Spin 90°" Display="'No Spin 90°'" Dmx="254~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

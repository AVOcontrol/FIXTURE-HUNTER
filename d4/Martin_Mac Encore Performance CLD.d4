      <Function ID="12" Name="Blu - Grn" Display="'Blu - Grn %.f%%',0~100" Dmx="14~28" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="28~28" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="28~42" WheelPosition="5" Colour="0,255,0" />
      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="42~42" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="Org - Mag" Display="'Org - Mag %.f%%',0~100" Dmx="42~56" WheelPosition="7" Colour="0,128,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="56~56" WheelPosition="8" Colour="255,0,255" />

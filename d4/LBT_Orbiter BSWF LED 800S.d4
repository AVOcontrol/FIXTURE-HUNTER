  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="23-09-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-09-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="25-09-20" Author="Nic Morris" Comment="Fixed Iris start DMX value." Version="2" />
  <History Date="18-12-20" Author="Nic Morris" Comment="Fixed missing DMX ranges for Function functions/macros." Version="3" />
  <History Date="04-08-21" Author="Nic Morris" Comment="Updated Function functions and macros in line with latest charts in response to manufacturer request." Version="4" />
  <History Date="05-08-25" Author="Nic Morris" Comment="Created from Clay Paky Arolla Profile HP (very poor documentation)" Version="5" />
  <History Date="08-08-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="07-11-25" Author="Nic Morris" Comment="Created from ZHLED ZH-LED600G (effectively identical)" Version="7" />
  <History Date="12-11-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="24-07-26" Author="Nic Morris" Comment="Created from Rico Ares Profile 600" Version="9" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="90~255" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~14" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~24" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~34" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Pink" Display="'Pink'" Dmx="40~44" WheelPosition="4" Colour="255,175,200" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~54" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Peach" Display="'Peach'" Dmx="60~64" WheelPosition="6" Colour="255,150,50" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="128~255" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="70~127" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="25~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="13" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="14" Name="Pk/ Org" Display="'Pk/ Org'" Dmx="45~49" WheelPosition="4" Colour="255,175,200" />
      <Function ID="15" Name="Org/ Pch" Display="'Org/ Pch'" Dmx="55~59" WheelPosition="5" Colour="255,100,0" />
      <Function ID="16" Name="Pch/ CTO" Display="'Pch/ CTO'" Dmx="65~69" WheelPosition="6" Colour="255,150,50" />
      <Function ID="17" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="128~255" WheelPosition="7" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="70~127" WheelPosition="8" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />

      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1 (Sail Boats)" Display="'Gobo 1 (Sail Boats)'" Dmx="8~15" WheelPosition="1" />

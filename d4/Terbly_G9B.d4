  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="4" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created from Terbly PT320B" Version="5" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created from Terbly PT322S" Version="6" />
  <History Date="26-05-16" Author="Nic Morris" Comment="Fixed colour else function." Version="7" />
  <History Date="26-05-16" Author="Nic Morris" Comment="Fixed colour locate in response to manufacturer bug report." Version="8" />
  <History Date="20-12-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel counts to mode names." Version="9" />
  <History Date="20-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Added extra no spin function to gobo rot." Version="10" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="11" />

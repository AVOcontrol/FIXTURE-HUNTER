      <Function ID="2" Name="Layer" Display="'Layer'" Dmx="1~128" />
      <Function ID="3" Name="MTC" Display="'MTC'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Saturation" Display="'Saturation %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Brightness" Display="'Brightness %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

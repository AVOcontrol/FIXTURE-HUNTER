    <Attribute ID="Rotation" Name="Rotation" Description="" Group="E" Size="2">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Function ID="1" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="16383~0" />
      <Function ID="2" Name="Index CCW" Display="'Index CCW %.f°',100~0" Dmx="16384~32768" />
      <Function ID="3" Name="Index CW" Display="'Index CW %.f%%',0~100" Dmx="32768~49152" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="65535~49153" />
    </Attribute>
    <Attribute ID="Scale" Name="Scale" Description="" Group="B" Size="2">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Mirror + Flip Max Size" Display="'Mirror + Flip Max Size'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Mirror + Flip Upscale" Display="'Mirror + Flip Upscale %.f%%',0~100" Dmx="1~21844" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Mirror + Flip Fullscreen" Display="'Mirror + Flip Fullscreen'" Dmx="21845~21845" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Mirror + Flip Dwnscale" Display="'Mirror + Flip Dwnscale %.f%%',0~100" Dmx="21846~27306" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Layer Downscaling" Display="'Layer  Down-   scaling %.f%%',0~100" Dmx="27307~32767" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Layer Fullscreen" Display="'Layer         Fullscreen'" Dmx="32768~32768" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Layer Upscaling" Display="'Layer Up-     scaling %.f%%',0~100" Dmx="32769~65534" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Layer Upscaling Max" Display="'Layer Up-     scaling Max'" Dmx="65535~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Aspect" Name="Aspect" Description="" Group="B" Size="2">

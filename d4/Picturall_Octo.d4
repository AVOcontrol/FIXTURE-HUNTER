      <Function ID="1" Name="Flipped Layer Upscaling Max Size" Display="'Flip Upscaling Max Size'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Flip Upscaling" Display="'Flip Upscaling %.f%%',0~100" Dmx="0~21844" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Flipped Layer Original Aspect Ratio" Display="'Flip Original Aspect Ratio'" Dmx="21845~21845" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Flip Downscaling" Display="'Flip Downscaling %.f%%',0~100" Dmx="21846~27306" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Layer downscaling" Display="'Layer down-   scaling %.f%%',0~100" Dmx="27307~31402" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="4:3 to 16:19" Display="'4:3 to 16:19'" Dmx="31403~31403" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Layer Downscaling" Display="'Layer Down-   scaling %.f%%',0~100" Dmx="31404~32767" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Layer Original Aspect Ratio" Display="'Layer Original Aspect Ratio'" Dmx="32768~32768" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="Layer Upscaling" Display="'Layer Up-     scaling %.f%%',0~100" Dmx="32769~34587" Iris="0~0" Zoom="0~0" />
      <Function ID="10" Name="16:9 to 4;3" Display="'16:9 to 4:3   %.f%%',0~100" Dmx="34588~34588" Iris="0~0" Zoom="0~0" />
      <Function ID="11" Name="Layer Upscaling" Display="'Layer Up-     scaling %.f%%',0~100" Dmx="32769~65534" Iris="0~0" Zoom="0~0" />
      <Function ID="12" Name="Layer Upscaling Max Size" Display="'Layer Upscaling Max Size'" Dmx="65535~65535" Iris="0~0" Zoom="0~0" />

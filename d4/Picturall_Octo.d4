    <Attribute ID="Draw_Mode" Name="Draw Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Additive" Display="'Additive'" Dmx="0~0" />
      <Function ID="2" Name="Replace" Display="'Replace'" Dmx="1~1" />
      <Function ID="3" Name="Subtract" Display="'Subtract'" Dmx="2~2" />
      <Function ID="4" Name="Darken" Display="'Darken'" Dmx="3~3" />
      <Function ID="5" Name="Lighten" Display="'Lighten'" Dmx="4~4" />
      <Function ID="6" Name="Multiply" Display="'Multiply'" Dmx="5~5" />
      <Function ID="7" Name="Linear Burn" Display="'Linear Burn'" Dmx="6~6" />
      <Function ID="8" Name="Screen" Display="'Screen'" Dmx="7~7" />
      <Function ID="9" Name="Reserved" Display="'Reserved %.f',8~255" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="File" Name="File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

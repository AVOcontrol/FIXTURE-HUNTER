    <Attribute ID="Fx1_Library" Name="Fx1 Library" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Fx" Display="'No Fx'" Dmx="0~0" Update="Fx1_Index" />
      <Function ID="2" Name="Wave" Display="'Wave'" Dmx="1~1" Update="Fx1_Index" />
      <Function ID="3" Name="Blur" Display="'Blur'" Dmx="2~2" Update="Fx1_Index" />
      <Function ID="4" Name="Chroma Key" Display="'Chroma Key'" Dmx="3~3" Update="Fx1_Index" />
      <Function ID="5" Name="Beam" Display="'Beam'" Dmx="4~4" Update="Fx1_Index" />
      <Function ID="6" Name="3D" Display="'3D'" Dmx="5~5" Update="Fx1_Index" />
      <Function ID="7" Name="Colour Tone" Display="'Colour Tone'" Dmx="6~6" Update="Fx1_Index" />
      <Function ID="8" Name="Edge" Display="'Edge'" Dmx="7~7" Update="Fx1_Index" />
      <Function ID="9" Name="Tiles" Display="'Tiles'" Dmx="8~8" Update="Fx1_Index" />
      <Function ID="10" Name="Shadow" Display="'Shadow'" Dmx="9~9" Update="Fx1_Index" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Fx1_Index" />
    </Attribute>
    <Attribute ID="Fx1_Index" Name="Fx1 Index" Description="" Group="E">
      <Locate Locate="34:0" PowerOn="34:0" />
      <Condition Name="Wave" ID="1,2" If="'Fx1_Library'==2" />
      <Condition Name="Blur" ID="3,4,5,6,7,8,9" If="'Fx1_Library'==3" />
      <Condition Name="Chroma Key" ID="10,11,12,13" If="'Fx1_Library'==4" />
      <Condition Name="Beam" ID="14,15,16,17" If="'Fx1_Library'==5" />
      <Condition Name="3D" ID="18,19,20" If="'Fx1_Library'==6" />
      <Condition Name="Colour Tone" ID="21,22,23,24,25,26" If="'Fx1_Library'==7" />
      <Condition Name="Edge" ID="27,28,29,30,31" If="'Fx1_Library'==8" />
      <Condition Name="Tiles" ID="32" If="'Fx1_Library'==9" />
      <Condition Name="Shadow" ID="33" If="'Fx1_Library'==10" />
      <Else ID="34" />
      <Function ID="1" Name="Wave" Display="'Wave'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="2" Name="Water Ripple" Display="'Water Ripple'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="3" Name="Blur" Display="'Blur'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="4" Name="Heavy Blur" Display="'Heavy Blur'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="5" Name="Gaussian Blur" Display="'Gaussian Blur'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="6" Name="Radial Blur" Display="'Radial Blur'" Dmx="4~4" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="7" Name="Radial Blur Adv" Display="'Radial Blur Adv'" Dmx="5~5" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="8" Name="Directional Blur" Display="'Directional Blur'" Dmx="6~6" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="9" Name="Glow" Display="'Glow'" Dmx="7~7" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="10" Name="Chromakey" Display="'Chromakey'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="11" Name="Chromakey Inv" Display="'Chromakey Inv'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="12" Name="Lumakey" Display="'Lumakey'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="13" Name="Lumakey Inv" Display="'Lumakey Inv'" Dmx="4~4" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="14" Name="Quick Border" Display="'Quick Border'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="15" Name="Edge Blur" Display="'Edge Blur'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="16" Name="Mask" Display="'Mask'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="17" Name="Keystone" Display="'Keystone'" Dmx="4~4" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="18" Name="3D Plane" Display="'3D Plane'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="19" Name="3D Cube" Display="'3D Cube'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="20" Name="3D Sphere" Display="'3D Sphere'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="21" Name="Sepia" Display="'Sepia'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="22" Name="Inverse" Display="'Inverse'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="23" Name="Halftone" Display="'Halftone'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="24" Name="Halftone Adv" Display="'Halftone Adv'" Dmx="4~4" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="25" Name="Comic" Display="'Comic'" Dmx="5~5" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="26" Name="Pixelsize" Display="'Pixelsize'" Dmx="6~6" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="27" Name="Edge Laplace" Display="'Edge Laplace'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="28" Name="Edge Laplace Add" Display="'Edge Laplace Add'" Dmx="2~2" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="29" Name="Sharpening" Display="'Sharpening'" Dmx="3~3" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="30" Name="Pencil Sketch" Display="'Pencil Sketch'" Dmx="4~4" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="31" Name="Cartoon" Display="'Cartoon'" Dmx="5~5" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="32" Name="Tiles" Display="'Tiles'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="33" Name="Drop Shadow" Display="'Drop Shadow'" Dmx="1~1" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
      <Function ID="34" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Fx1_Param6, Fx1_Param5, Fx1_Param4, Fx1_Param3, Fx1_Param2, Fx1_Param1" />
    </Attribute>
    <Attribute ID="Fx1_Param1" Name="Fx1 Param1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Amplitude" ID="2" If="'Fx1_Index'==1" />
      <Condition Name="Size" ID="3" If="'Fx1_Index'==2||'Fx1_Index'==3||'Fx1_Index'==6||'Fx1_Index'==7" />
      <Condition Name="Blur Size" ID="4" If="'Fx1_Index'==4||'Fx1_Index'==5||'Fx1_Index'==8" />
      <Condition Name="Threshold" ID="5" If="'Fx1_Index'==9||'Fx1_Index'==10||'Fx1_Index'==11" />
      <Condition Name="Accuracy" ID="6" If="'Fx1_Index'==12||'Fx1_Index'==13" />
      <Condition Name="Border Amount" ID="7" If="'Fx1_Index'==14" />
      <Condition Name="Blur Amount" ID="8" If="'Fx1_Index'==15" />
      <Condition Name="Mask Left" ID="9" If="'Fx1_Index'==16" />
      <Condition Name="On/Off" ID="10" If="'Fx1_Index'==17" />
      <Condition Name="X Rot" ID="11" If="'Fx1_Index'==18||'Fx1_Index'==19||'Fx1_Index'==20" />
      <Condition Name="Sepia" ID="12" If="'Fx1_Index'==21" />
      <Condition Name="Amount" ID="13" If="'Fx1_Index'==23||'Fx1_Index'==24||'Fx1_Index'==26||'Fx1_Index'==30" />
      <Condition Name="Comic Amount" ID="14" If="'Fx1_Index'==25" />
      <Condition Name="Mixing" ID="15" If="'Fx1_Index'==27" />
      <Condition Name="Laplace Amount" ID="16" If="'Fx1_Index'==28" />
      <Condition Name="Radius" ID="17" If="'Fx1_Index'==29" />
      <Condition Name="Border Intensity" ID="18" If="'Fx1_Index'==31" />

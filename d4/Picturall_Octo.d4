      <Function ID="2" Name="Fixed Fps" Display="'Fixed Fps %.f',1~63" Dmx="1~63" />
      <Function ID="3" Name="Relative Play Spd" Display="'Relative Play Spd %.f%%',0~200" Dmx="64~160" />

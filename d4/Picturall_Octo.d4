      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Red Adj" Display="'Red Adj %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Adj" Name="Green" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />

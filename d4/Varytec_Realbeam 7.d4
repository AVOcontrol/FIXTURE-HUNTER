  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3eaf94e7-dfc5-4f96-937c-1e5c439f5aed" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~100" />

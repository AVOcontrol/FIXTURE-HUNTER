<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Chameleon" ShortName="Chameleon" Company="ShowLED">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="08-11-05" Author="Ed" Comment="Created" />
  <History Date="08-11-05" Author="Ed" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Merged 24 channel mode.  Added Atlabase ID's.  Standardised conditionals." />
  <History Date="04-02-20" Author="Nic Morris" Comment="Changed split cols to index.  Added colour function index." />
  <History Date="04-02-20" Author="Nic Morris" Comment="Changed name from Colour Chameleon to Chameleon" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cd30ff7a-7072-4e4b-b674-bb51625cb5d4" />
  <Control>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Chase 1" Display="'Chase 1'" Dmx="0~0" />
      <Function ID="2" Name="Chase 2" Display="'Chase 2'" Dmx="32~63" />
      <Function ID="3" Name="Chase 3" Display="'Chase 3'" Dmx="64~91" />
      <Function ID="4" Name="Chase 4" Display="'Chase 4'" Dmx="92~127" />
      <Function ID="5" Name="Chase 5" Display="'Chase 5'" Dmx="128~159" />
      <Function ID="6" Name="Chase 6" Display="'Chase 6'" Dmx="160~191" />
      <Function ID="7" Name="Chase 7" Display="'Chase 7'" Dmx="192~223" />
      <Function ID="8" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Behavior" Name="Behavior" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Soft" Display="'Soft'" Dmx="0~0" />
      <Function ID="2" Name="Hard" Display="'Hard'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Min_Intensity" Name="Min Int" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Min Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Else ID="18" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" WheelPosition="0" Colour="0,0,255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" WheelPosition="1" Colour="255,255,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~64" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="96~96" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="128~128" WheelPosition="4" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="160~160" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="192~192" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="224~224" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="255~255" WheelPosition="8" Colour="255,255,0" />
      <Function ID="10" Name="Blu - Op" Display="'Blu - Op %.f%%',0~100" Dmx="0~32" WheelPosition="0" Colour="0,0,255" />
      <Function ID="11" Name="Op - Yel" Display="'Op - Yel %.f%%',0~100" Dmx="32~64" WheelPosition="1" Colour="255,255,128" />
      <Function ID="12" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="64~96" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="96~128" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="128~160" WheelPosition="4" Colour="0,255,255" />
      <Function ID="15" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="160~192" WheelPosition="5" Colour="0,0,255" />
      <Function ID="16" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="192~224" WheelPosition="6" Colour="255,0,255" />
      <Function ID="17" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="224~255" WheelPosition="7" Colour="255,0,0" />

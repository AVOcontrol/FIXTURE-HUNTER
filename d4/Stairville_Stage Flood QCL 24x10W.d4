  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b25fe9ce-6b3d-444f-9b0b-ae244496dd88" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Auto'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade" ID="2" If="'Auto'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Fade 1" Display="'Fade 1'" Dmx="11~20" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Fade 2" Display="'Fade 2'" Dmx="21~30" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="Fade 3" Display="'Fade 3'" Dmx="31~40" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="Fade 4" Display="'Fade 4'" Dmx="41~50" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="Fade 5" Display="'Fade 5'" Dmx="51~60" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="Fade 6" Display="'Fade 6'" Dmx="61~70" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="Fade 7" Display="'Fade 7'" Dmx="71~80" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="Fade 8" Display="'Fade 8'" Dmx="81~90" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Colour 1" Display="'Colour 1'" Dmx="91~100" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Colour 2" Display="'Colour 2'" Dmx="101~110" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="Colour 3" Display="'Colour 3'" Dmx="111~120" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="Colour 4" Display="'Colour 4'" Dmx="121~130" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="Colour 5" Display="'Colour 5'" Dmx="131~140" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="Colour 6" Display="'Colour 6'" Dmx="141~150" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="Colour 7" Display="'Colour 7'" Dmx="151~160" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Colour 8" Display="'Colour 8'" Dmx="161~170" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Colour 9" Display="'Colour 9'" Dmx="171~180" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="Colour 10" Display="'Colour 10'" Dmx="181~190" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="RGBW" Display="'RGBW'" Dmx="191~200" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="White 1" Display="'White 1'" Dmx="201~205" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="White 2" Display="'White 2'" Dmx="206~210" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="White 3" Display="'White 3'" Dmx="211~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="White 4" Display="'White 4'" Dmx="216~220" Update="Shutter" Colour="255,255,255" />
      <Function ID="25" Name="White 5" Display="'White 5'" Dmx="221~225" Update="Shutter" Colour="255,255,255" />
      <Function ID="26" Name="White 6" Display="'White 6'" Dmx="226~230" Update="Shutter" Colour="255,255,255" />
      <Function ID="27" Name="White 7" Display="'White 7'" Dmx="231~235" Update="Shutter" Colour="255,255,255" />
      <Function ID="28" Name="White 8" Display="'White 8'" Dmx="236~240" Update="Shutter" Colour="255,255,255" />
      <Function ID="29" Name="White 9" Display="'White 9'" Dmx="241~245" Update="Shutter" Colour="255,255,255" />
      <Function ID="30" Name="White 10" Display="'White 10'" Dmx="246~250" Update="Shutter" Colour="255,255,255" />
      <Function ID="31" Name="White 11" Display="'White 11'" Dmx="251~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;20" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" Update="Red, Green" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" Update="Red, Green" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="30~39" Update="Red, Green" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="40~49" Update="Red, Green" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="50~59" Update="Red, Green" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="60~69" Update="Red, Green" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="70~79" Update="Red, Green" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="80~89" Update="Red, Green" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="90~99" Update="Red, Green" />
      <Function ID="11" Name="Auto 10" Display="'Sound 10'" Dmx="100~109" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="50~99" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="100~149" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="150~199" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

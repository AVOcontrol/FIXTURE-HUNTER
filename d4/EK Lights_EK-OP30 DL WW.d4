<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EK-OP30 DL WW" ShortName="OP30 DL WW" Company="EK Lights" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="31-08-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Curve Linear" Display="'Dim Curve Linear'" Dmx="2~3" />
      <Function ID="3" Name="Dim Curve S-Curve" Display="'Dim Curve S-Curve'" Dmx="4~5" />
      <Function ID="4" Name="Dim Curve Square" Display="'Dim Curve Square'" Dmx="6~7" />
      <Function ID="5" Name="Dim Curve Inv Square" Display="'Dim Curve Inv Square'" Dmx="8~9" />
      <Function ID="6" Name="Dim Spd Auto" Display="'Dim Spd Auto'" Dmx="10~11" />
      <Function ID="7" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="12~13" />
      <Function ID="8" Name="Dim Spd Med" Display="'Dim Spd Med'" Dmx="14~15" />
      <Function ID="9" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="16~17" />
      <Function ID="10" Name="LED Freq 600Hz" Display="'LED Freq 600Hz'" Dmx="18~19" />
      <Function ID="11" Name="LED Freq 1200Hz" Display="'LED Freq 1200Hz'" Dmx="20~21" />
      <Function ID="12" Name="LED Freq 2000Hz" Display="'LED Freq 2000Hz'" Dmx="22~23" />
      <Function ID="13" Name="LED Freq 4000Hz" Display="'LED Freq 4000Hz'" Dmx="24~25" />
      <Function ID="14" Name="LED Freq 6000Hz" Display="'LED Freq 6000Hz'" Dmx="26~27" />
      <Function ID="15" Name="LED Freq 25KHz" Display="'LED Freq 25KHz'" Dmx="28~29" />
      <Function ID="16" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="30~31" />
      <Function ID="17" Name="No DMX Blackout" Display="'No DMX Blackout'" Dmx="32~33" />
      <Function ID="18" Name="No DMX Stand-Alone" Display="'No DMX Stand-Alone'" Dmx="34~35" />
      <Function ID="19" Name="Default" Display="'Default'" Dmx="254~255" />
    </Attribute>
  </Control>
  <Mode Name="UNO, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="BASIC, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="STANDARD, 3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
    </Include>
  </Mode>
  <Mode Name="EXTENDED, 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Dim_Spd" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Dim Curve Linear">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Curve S-Curve">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Curve Square">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Curve Inv Square">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Auto">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Fast">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Med">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Slow">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 600Hz">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 1200Hz">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 2000Hz">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 4000Hz">
      <Set Channel="Control:13" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 6000Hz">
      <Set Channel="Control:14" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="LED Freq 25KHz">
      <Set Channel="Control:15" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="No DMX Hold">
      <Set Channel="Control:16" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="No DMX Blackout">
      <Set Channel="Control:17" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="No DMX Stand-Alone">
      <Set Channel="Control:18" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Default">
      <Set Channel="Control:19" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:4:100" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
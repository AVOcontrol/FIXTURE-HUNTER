      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="1~9" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="40~49" Colour="255,255,0" />

    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default Curve" Display="'Default Curve'" Dmx="0~0" />
      <Function ID="2" Name="Curve Off, No Gamma" Display="'Curve Off, No Gamma'" Dmx="10~29" />
      <Function ID="3" Name="Curve Off, Gamma 2.2" Display="'Curve Off, Gamma 2.2'" Dmx="30~69" />
      <Function ID="4" Name="Curve Smooth, No Gamma" Display="'Curve Smooth, No Gamma'" Dmx="70~129" />
      <Function ID="5" Name="Curve Smooth, Gamma 2.2" Display="'Curve Smooth, Gamma 2.2'" Dmx="130~190" />
      <Function ID="6" Name="Default Curve" Display="'Default Curve'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />

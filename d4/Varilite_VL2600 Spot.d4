      <Function ID="2" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />
      <Function ID="3" Name="Follows Cue Data" Display="'Follows Cue Data'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Fan_Control" Name="Fan Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~5" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="6~10" />
      <Function ID="3" Name="Shutdown" Display="'Shutdown'" Dmx="21~25" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="26~30" />
      <Function ID="5" Name="Display Off" Display="'Display Off'" Dmx="31~35" />
      <Function ID="6" Name="Reset P/T" Display="'Reset P/T'" Dmx="36~40" />
      <Function ID="7" Name="Reset Col" Display="'Reset Col'" Dmx="41~45" />
      <Function ID="8" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="46~50" />
      <Function ID="9" Name="Reset Beam" Display="'Reset Beam'" Dmx="51~55" />
      <Function ID="10" Name="Reset Optics" Display="'Reset Optics'" Dmx="56~60" />
      <Function ID="11" Name="Reset to Defaults" Display="'Reset to Defaults'" Dmx="66~70" />
      <Function ID="12" Name="Reboot" Display="'Reboot'" Dmx="71~75" />
      <Function ID="13" Name="Status On/Off" Display="'Status On/Off'" Dmx="76~80" />
      <Function ID="14" Name="Standard Mode" Display="'Standard Mode'" Dmx="81~85" />
      <Function ID="15" Name="Studio Mode" Display="'Studio Mode'" Dmx="86~90" />
      <Function ID="16" Name="Side Hang Disable" Display="'Side Hang Disable'" Dmx="91~100" />
      <Function ID="17" Name="Side Hang Enable" Display="'Side Hang Enable'" Dmx="101~110" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="9,10,11,12,13,14,15,16" If="'Gobo2Func'==2" />
      <Condition Name="Mega Step" ID="17,18,19,20,21,22,23,24" If="'Gobo2Func'==3" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>9cc27546-76fd-47fd-b882-53dc74ece6ff</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Dichrofusion)" Display="'Gobo 1 (Dichrofusion)'" Dmx="6~10" WheelPosition="1">
        <Swatch>8e925ae5-6f7a-4db2-b9d7-59d79340b584</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Alpha Rays)" Display="'Gobo 2 (Alpha Rays)'" Dmx="11~15" WheelPosition="2">
        <Swatch>e8aea0bd-1b25-47a9-a0df-9290b483500f</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Circle of Holes)" Display="'Gobo 3 (Circle of Holes)'" Dmx="16~20" WheelPosition="3">
        <Swatch>767f7ba1-fe5b-4ea0-98d3-276df6151fdf</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Vertical Bars)" Display="'Gobo 4 (Vertical Bars)'" Dmx="21~25" WheelPosition="4">
        <Swatch>9953536c-55a2-4820-8046-83d0f6f3499a</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Tribal)" Display="'Gobo 5 (Tribal)'" Dmx="26~30" WheelPosition="5">
        <Swatch>3e026bd6-4e93-4fa6-aa3c-42255047ee8c</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Honeycomb)" Display="'Gobo 6 (Honeycomb)'" Dmx="31~35" WheelPosition="6">
        <Swatch>5d794257-d55d-4bc5-8ebe-3468cb45f21a</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Droplets)" Display="'Gobo 7 (Droplets)'" Dmx="36~40" WheelPosition="7">
        <Swatch>dd072864-2db7-451e-9ae2-6b3e39f21998</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="41~45" WheelPosition="0">
        <Swatch>9cc27546-76fd-47fd-b882-53dc74ece6ff</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 (Dichrofusion)" Display="'Gobo 1 (Dichrofusion)'" Dmx="46~50" WheelPosition="1">
        <Swatch>8e925ae5-6f7a-4db2-b9d7-59d79340b584</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 (Alpha Rays)" Display="'Gobo 2 (Alpha Rays)'" Dmx="51~55" WheelPosition="2">
        <Swatch>e8aea0bd-1b25-47a9-a0df-9290b483500f</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 (Circle of Holes)" Display="'Gobo 3 (Circle of Holes)'" Dmx="56~60" WheelPosition="3">
        <Swatch>767f7ba1-fe5b-4ea0-98d3-276df6151fdf</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 (Vertical Bars)" Display="'Gobo 4 (Vertical Bars)'" Dmx="61~65" WheelPosition="4">
        <Swatch>9953536c-55a2-4820-8046-83d0f6f3499a</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 (Tribal)" Display="'Gobo 5 (Tribal)'" Dmx="66~70" WheelPosition="5">
        <Swatch>3e026bd6-4e93-4fa6-aa3c-42255047ee8c</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 (Honeycomb)" Display="'Gobo 6 (Honeycomb)'" Dmx="71~75" WheelPosition="6">
        <Swatch>5d794257-d55d-4bc5-8ebe-3468cb45f21a</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 (Droplets)" Display="'Gobo 7 (Droplets)'" Dmx="76~80" WheelPosition="7">
        <Swatch>dd072864-2db7-451e-9ae2-6b3e39f21998</Swatch>
      </Function>
      <Function ID="17" Name="Open" Display="'Open'" Dmx="81~85" WheelPosition="0">
        <Swatch>9cc27546-76fd-47fd-b882-53dc74ece6ff</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 1 (Dichrofusion)" Display="'Gobo 1 (Dichrofusion)'" Dmx="86~90" WheelPosition="1">
        <Swatch>8e925ae5-6f7a-4db2-b9d7-59d79340b584</Swatch>
      </Function>
      <Function ID="19" Name="Gobo 2 (Alpha Rays)" Display="'Gobo 2 (Alpha Rays)'" Dmx="91~95" WheelPosition="2">
        <Swatch>e8aea0bd-1b25-47a9-a0df-9290b483500f</Swatch>
      </Function>
      <Function ID="20" Name="Gobo 3 (Circle of Holes)" Display="'Gobo 3 (Circle of Holes)'" Dmx="96~100" WheelPosition="3">
        <Swatch>767f7ba1-fe5b-4ea0-98d3-276df6151fdf</Swatch>
      </Function>
      <Function ID="21" Name="Gobo 4 (Vertical Bars)" Display="'Gobo 4 (Vertical Bars)'" Dmx="101~105" WheelPosition="4">
        <Swatch>9953536c-55a2-4820-8046-83d0f6f3499a</Swatch>
      </Function>
      <Function ID="22" Name="Gobo 5 (Tribal)" Display="'Gobo 5 (Tribal)'" Dmx="106~110" WheelPosition="5">
        <Swatch>3e026bd6-4e93-4fa6-aa3c-42255047ee8c</Swatch>
      </Function>
      <Function ID="23" Name="Gobo 6 (Honeycomb)" Display="'Gobo 6 (Honeycomb)'" Dmx="111~115" WheelPosition="6">
        <Swatch>5d794257-d55d-4bc5-8ebe-3468cb45f21a</Swatch>
      </Function>
      <Function ID="24" Name="Gobo 7 (Droplets)" Display="'Gobo 7 (Droplets)'" Dmx="116~120" WheelPosition="7">
        <Swatch>dd072864-2db7-451e-9ae2-6b3e39f21998</Swatch>
      </Function>
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==3" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo_2_Ctrl" Name="Gobo 2 Ctrl" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Fast" Display="'Fixed Fast'" Dmx="0~0" />
      <Function ID="2" Name="Fixed Normal" Display="'Fixed Normal'" Dmx="6~10" />
      <Function ID="3" Name="Shake Fast" Display="'Shake Fast %.f%%',0~100" Dmx="91~120" />
      <Function ID="4" Name="Shake Normal" Display="'Shake Normal %.f%%',0~100" Dmx="121~150" />
      <Function ID="5" Name="Twist Fast" Display="'Twist Fast %.f%%',0~100" Dmx="151~180" />
      <Function ID="6" Name="Twist Normal" Display="'Twist Normal %.f%%',0~100" Dmx="181~210" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="21~50" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="51~60" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="61~90" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Optical_Style" Name="Optical Style" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Hybrid" Display="'Hybrid'" Dmx="0~0" />
      <Function ID="2" Name="Spot Projection" Display="'Spot Projection'" Dmx="31~60" />
      <Function ID="3" Name="Open Beam" Display="'Open Beam'" Dmx="61~90" />
      <Function ID="4" Name="Shaft" Display="'Shaft'" Dmx="91~120" />
    </Attribute>
  </Control>

    <Macro Name="Dimmer Snap On">
      <Set Channel="Programmers_Ch:12" Delay="6000" />
      <Set Channel="Programmers_Ch:1" Delay="0" />
    </Macro>
    <Macro Name="Dimmer Snap Off">
      <Set Channel="Programmers_Ch:13" Delay="6000" />
      <Set Channel="Programmers_Ch:1" Delay="0" />
    </Macro>
  </Macro>

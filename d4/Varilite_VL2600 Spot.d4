      <Function ID="8" Name="Edge Tracking Off" Display="'Edge Tracking Off'" Dmx="221~225" />
      <Function ID="9" Name="Edge Tracking On" Display="'Edge Tracking On'" Dmx="226~230" />
      <Function ID="10" Name="Soft Zoom Start On" Display="'Soft Zoom Start On'" Dmx="231~235" />
      <Function ID="11" Name="Soft Zoom Start Off" Display="'Soft Zoom Start Off'" Dmx="236~240" />
      <Function ID="12" Name="Dimmer Snap On" Display="'Dimmer Snap On'" Dmx="241~245" />
      <Function ID="13" Name="Dimmer Snap Off" Display="'Dimmer Snap Off'" Dmx="246~250" />
    </Attribute>
    <Attribute ID="P/T_Timing" Name="P/T Timing" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~1" />
      <Function ID="2" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />

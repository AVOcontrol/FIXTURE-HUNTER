<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iW-720" ShortName="iW-720" Company="Infinity">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Created" />
  <History Date="15-02-14" Author="Nic Morris" Comment="Created from Showtec Infinity IW-715" />
  <History Date="08-08-15" Author="Nic Morris" Comment="Changed manufacturer from Showtec to Infinity in response to manufacturer request" />
  <History Date="05-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="21-09-17" Author="Nic Morris" Comment="Added 16 channel mode (introduced in V3 charts).  Revised 14 channel mode mapping." />
  <History Date="21-09-17" Author="Nic Morris" Comment="Changed name from IW-720 to iW-720.  Added physical pan/tilt limits.  Added vdim to 29 DMX mode." />
  <History Date="21-09-17" Author="Nic Morris" Comment="Moved Auto into effect group and wheel slot.  Revised shutter function names and standardised." />
  <History Date="21-09-17" Author="Nic Morris" Comment="Inverted effect speed.  Inverted zoom.  Revised move in dark control function name." />
  <History Date="23-09-17" Author="Nic Morris" Comment="Added Atlabase ID to 16 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9a8563e7-729b-4828-8de2-903a0576f7e0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

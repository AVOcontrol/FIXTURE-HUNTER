    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="11~20" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="21~30" />
      <Function ID="4" Name="Reset Colour" Display="'Reset Colour'" Dmx="31~40" />
      <Function ID="5" Name="Reset Framing" Display="'Reset Framing'" Dmx="51~60" />
      <Function ID="6" Name="Reset Focus" Display="'Reset Focus'" Dmx="61~70" />
      <Function ID="7" Name="Super Silent" Display="'Super Silent'" Dmx="71~80" />
      <Function ID="8" Name="Silent" Display="'Silent'" Dmx="81~90" />
      <Function ID="9" Name="High Light" Display="'High Light'" Dmx="91~100" />
      <Function ID="10" Name="Zoom Invert" Display="'Zoom Invert'" Dmx="111~120" />
      <Function ID="11" Name="Zoom Normal" Display="'Zoom Normal'" Dmx="121~130" />
      <Function ID="12" Name="Display Auto" Display="'Display Auto'" Dmx="181~190" />
      <Function ID="13" Name="Function Open" Display="'Function Open'" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />

  <History Date="28-12-22" Author="Nic Morris" Comment="Created (note it is unclear which gobo wheel is which in the documentation - the drawings are labelled A and B but the charts are 1 and 2.  Assumed A = 1 and B = 2)" Version="0" />
  <History Date="04-01-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="08-03-25" Author="Nic Morris" Comment="Created from LightSky Shark Profile" Version="3" />
  <History Date="28-03-25" Author="Nic Morris" Comment="Created from LightSky Super Scope Max (colour names not included in charts and slot numbers missing from separate details.  made best guess)" Version="20" />

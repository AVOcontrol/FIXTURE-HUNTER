    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="7" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="8,9,10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="105~119" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="120~134" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="135~149" Colour="0,0,255" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="150~164" Colour="255,150,0" />
      <Function ID="6" Name="High CRI" Display="'High CRI'" Dmx="165~179" Colour="200,150,200" />
      <Function ID="7" Name="Index" Display="'%.f%%',0~100" Dmx="0~89" Colour="0,0,0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="214~180" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="249~215" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Random" Display="'Random'" Dmx="250~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

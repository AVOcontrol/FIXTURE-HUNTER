  <History Date="13-08-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="18" />
  <History Date="25-08-20" Author="Nic Morris" Comment="Swapped 4 and 8 facet prism functions (this is contrary to the documentation provided)" Version="19" />
  <History Date="02-09-20" Author="Nic Morris" Comment="Created from Terbly S380H IP" Version="20" />
  <History Date="03-09-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="21" />
  <History Date="30-10-20" Author="Nic Morris" Comment="Revised prism function names in response to manufacturer request (contrary to the documentation)." Version="22" />
  <History Date="24-02-24" Author="Nic Morris" Comment="Created from Terbly S380H (virtually identical.  no gobo images.  left the same for now)" Version="23" />
  <History Date="01-03-24" Author="Nic Morris" Comment="Changed frost function from fixed to variable in response to manufacturer request." Version="25" />
  <History Date="22-04-24" Author="Nic Morris" Comment="Added product image and revised gobo 1 slot 1 image in line with latest documentation." Version="26" />
  <History Date="24-04-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="27" />

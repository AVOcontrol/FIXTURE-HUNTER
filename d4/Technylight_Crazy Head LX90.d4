  <History Date="25-05-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ef07ddbd-a589-4fc3-89cb-612d63fe4931" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~249" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~10" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~20" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~30" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~40" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Fushia" Display="'Fushia'" Dmx="50~50" WheelPosition="5" Colour="180,0,180" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="60~60" WheelPosition="6" Colour="0,255,128" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="70~70" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="140~140" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="130~130" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="120~120" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ Fs" Display="'Yel/ Fs'" Dmx="110~110" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Fs/ Tq" Display="'Fs/ Tq'" Dmx="100~100" WheelPosition="5" Colour="180,0,180" />
      <Function ID="15" Name="Tq/ Or" Display="'Tq/ Or'" Dmx="90~90" WheelPosition="6" Colour="0,255,128" />
      <Function ID="16" Name="Or/ Op" Display="'Or/ Op'" Dmx="80~80" WheelPosition="7" Colour="255,128,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="150~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="8,9" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>b3345a83-3aa3-4106-a9e0-55fd13c60d4b</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="36~71">
        <Swatch>9ed45705-a063-43ad-a9ed-1a9f4667b993</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="72~107">
        <Swatch>0f5024d8-88c7-4575-9057-bf14699469f4</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="108~143">
        <Swatch>84770ea8-e924-4d47-984c-63f4a49f9c8a</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="144~179">
        <Swatch>1043ed79-1b66-4731-aa73-b5daf5e91ec5</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="180~215">
        <Swatch>904e3bab-20f3-4876-9cb1-35e32e457fb8</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="216~219">
        <Swatch>087028c5-1194-43a9-a9f3-a54e355dc3fe</Swatch>
      </Function>
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~89" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="167~178" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~179" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="167~178" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="90~167" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo_1_Shake" Name="Gobo 1 Shake" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shake" Display="'No Shake'" Dmx="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="10~250" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func'==1" />
      <Condition Name="Scroll" ID="10,11" If="'Gobo2Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0">
        <Swatch>b3345a83-3aa3-4106-a9e0-55fd13c60d4b</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="27~53" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="54~80" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="81~107" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="108~134" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="135~161" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="162~188" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="189~214" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="215~219" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~250" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo_2_Shake" Name="Gobo 2 Shake" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shake" Display="'No Shake'" Dmx="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="10~250" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="50~100" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="101~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="150~200" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Poseidon Aqua 2" ShortName="Aqua 2" Company="Froggys Fog">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>4d94b84e-9243-4913-8f53-274a20b7c47a</Thumbnail>
  <History Date="01-11-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Humidity" Name="Humidity" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="25%" Display="'25%'" Dmx="11~62" />
      <Function ID="3" Name="50%" Display="'50%'" Dmx="63~122" />
      <Function ID="4" Name="75%" Display="'75%'" Dmx="123~183" />
      <Function ID="5" Name="100%" Display="'100%'" Dmx="184~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKFFPAQ2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Humidity" ChannelOffset="3" Wheel="5" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="4d94b84e-9243-4913-8f53-274a20b7c47a"></Swatch>
  </swatchLibrary>
</Fixture>
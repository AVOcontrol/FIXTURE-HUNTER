<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Twin Effect Laser" ShortName="JSTwinELsr" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="07-02-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Modes" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~24" />
      <Function ID="2" Name="Auto Grating" Display="'Auto Grating'" Dmx="25~59" />
      <Function ID="3" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="60~99" />
      <Function ID="4" Name="Auto Grate + Pattern" Display="'Auto Grate + Pattern'" Dmx="100~139" />
      <Function ID="5" Name="Sound Grating" Display="'Sound Grating'" Dmx="140~179" />
      <Function ID="6" Name="Sound Pattern" Display="'Sound Pattern'" Dmx="180~219" />
      <Function ID="7" Name="Sound Grate + Pattern" Display="'Sound Grate + Pattern'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Control1" Name="Modes" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~24" Update="Colour1" />
      <Function ID="2" Name="Auto Grating + Pattern" Display="'Auto Grating + Pattern'" Dmx="25~49" Update="Colour1" />
      <Function ID="3" Name="Sound Grating/Pattern" Display="'Sound Grating/Pattern'" Dmx="50~74" Update="Colour1" />
      <Function ID="4" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="75~99" Update="Colour1" />
      <Function ID="5" Name="Sound Pattern" Display="'Sound Pattern'" Dmx="100~124" Update="Colour1" />
      <Function ID="6" Name="Auto Grating" Display="'Auto Grating'" Dmx="125~149" Update="Colour1" />
      <Function ID="7" Name="Sound Grating" Display="'Sound Grating'" Dmx="150~174" Update="Colour1" />
      <Function ID="8" Name="DMX A" Display="'DMX A'" Dmx="175~199" Update="Colour1" />
    </Attribute>
    <Attribute ID="X-Axis" Name="X-Axis" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Pos" Display="'X Pos %.f',0~127" Dmx="0~127" />
      <Function ID="2" Name="CW Move" Display="'CW Move %.1f%%',0.0~100.0" Dmx="128~191" />
      <Function ID="3" Name="CCW Move" Display="'CCW Move %.1f%%',0.0~100.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Y-Axis" Name="Y-Axis" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Pos" Display="'Y Pos %.f',0~127" Dmx="0~127" />
      <Function ID="2" Name="CW Move" Display="'CW Move %.1f%%',0.0~100.0" Dmx="128~191" />
      <Function ID="3" Name="CCW Move" Display="'CCW Move %.1f%%',0.0~100.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Mode1" ID="2,3,4,5,6" If="'Control1'==8" />
      <Condition Name="Mode 2" ID="7,8,9,10" If="'Control2'==8" />
      <Condition Name="Mode 3" ID="11,12,13,14,15,16" If="'Control3'==8" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Laser Blackout" Display="'Laser Blackout'" Dmx="0~9" Colour="0,0,0" />
      <Function ID="3" Name="Red + Green" Display="'Red + Green %.f%%',0~100" Dmx="10~63" Colour="255,0,0" />
      <Function ID="4" Name="Red" Display="'Red %.f%%',0~100" Dmx="64~127" Colour="255,0,0" />
      <Function ID="5" Name="Green" Display="'Green %.f%%',0~100" Dmx="128~191" Colour="0,255,0" />
      <Function ID="6" Name="Red + Green" Display="'Red + Green'" Dmx="192~255" Colour="0,255,0" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="0~16" Colour="255,0,0" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="17~31" Colour="0,255,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="32~49" Colour="255,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="50~255" Colour="0,0,0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="12" Name="Red" Display="'Red'" Dmx="17~31" Colour="255,0,0" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="14" Name="Yellow" Display="'Yellow'" Dmx="48~62" Colour="255,255,0" />
      <Function ID="15" Name="2 Col Scroll" Display="'2 Col Scroll %.f%%',0~100" Dmx="63~160" Colour="0,0,0" />
      <Function ID="16" Name="3 Col Scroll" Display="'3 Col Scroll %.f%%',0~100" Dmx="161~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~249" Intensity="0~0" />
      <Function ID="3" Name="Snd Strobe" Display="'Snd Strobe'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rot" Name="Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll CW" Display="'Scroll CW     %.f%%',0~100" Dmx="1~75" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="76~150" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="151~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',100.0~0.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom in Effect" Display="'Zoom in Effect %.1f%%',0.0~100.0" Dmx="128~169" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom out Effect" Display="'Zoom out Effect %.1f%%',0.0~100.0" Dmx="170~209" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom Effect" Display="'Zoom Effect %.1f%%',0.0~100.0" Dmx="210~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y-Roll" Name="Y-Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed Pos" Display="'Fixed Pos %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="CW" Display="'CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Roll" Name="X-Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed Pos" Display="'Fixed Pos %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="CW" Display="'CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Z-Roll" Name="Z-Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed Pos" Display="'Fixed Pos %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="CW" Display="'CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Grating" Name="Grating" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~11" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control2" Name="Modes" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~24" Update="Colour1" />
      <Function ID="2" Name="Auto Grating + Pattern" Display="'Auto Grating + Pattern'" Dmx="25~49" Update="Colour1" />
      <Function ID="3" Name="Sound Grating/Pattern" Display="'Sound Grating/Pattern'" Dmx="50~74" Update="Colour1" />
      <Function ID="4" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="75~99" Update="Colour1" />
      <Function ID="5" Name="Sound Pattern" Display="'Sound Pattern'" Dmx="100~124" Update="Colour1" />
      <Function ID="6" Name="Auto Grating" Display="'Auto Grating'" Dmx="125~149" Update="Colour1" />
      <Function ID="7" Name="Sound Grating" Display="'Sound Grating'" Dmx="150~174" Update="Colour1" />
      <Function ID="8" Name="DMX B" Display="'DMX B'" Dmx="200~224" Update="Colour1" />
    </Attribute>
    <Attribute ID="Control3" Name="Modes" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~24" Update="Colour1" />
      <Function ID="2" Name="Auto Grating + Pattern" Display="'Auto Grating + Pattern'" Dmx="25~49" Update="Colour1" />
      <Function ID="3" Name="Sound Grating/Pattern" Display="'Sound Grating/Pattern'" Dmx="50~74" Update="Colour1" />
      <Function ID="4" Name="Auto Pattern" Display="'Auto Pattern'" Dmx="75~99" Update="Colour1" />
      <Function ID="5" Name="Sound Pattern" Display="'Sound Pattern'" Dmx="100~124" Update="Colour1" />
      <Function ID="6" Name="Auto Grating" Display="'Auto Grating'" Dmx="125~149" Update="Colour1" />
      <Function ID="7" Name="Sound Grating" Display="'Sound Grating'" Dmx="150~174" Update="Colour1" />
      <Function ID="8" Name="DMX C" Display="'DMX C'" Dmx="225~255" Update="Colour1" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX, 8bit" Channels="1">
    <Import PearlRef="JSTwinELsr1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Mode 1" Channels="10">
    <Import PearlRef="JSTwinELsrA" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="X-Axis" ChannelOffset="2" Wheel="2" />
      <Attribute ID="Y-Axis" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Rot" ChannelOffset="6" Wheel="15" />
      <Attribute ID="Control1" ChannelOffset="1" Wheel="28" />

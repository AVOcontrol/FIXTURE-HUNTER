      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="63~67" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="72~76" Colour="0,0,0" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="81~85" Colour="0,0,0" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="90~103" Colour="0,0,0" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="97~105" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="108~112" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="117~121" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="15" Name="Open/Col 1" Display="'Open/Col 1'" Dmx="5~8" Colour="255,255,255" />
      <Function ID="16" Name="Col 1/Col 2" Display="'Col 1/Col 2'" Dmx="14~17" Colour="0,0,0" />
      <Function ID="17" Name="Col 2/Col 3" Display="'Col 2/Col 3'" Dmx="23~26" Colour="0,0,0" />
      <Function ID="18" Name="Col 3/Col 4" Display="'Col 3/Col 4'" Dmx="32~35" Colour="0,0,0" />
      <Function ID="19" Name="Col 4/Col 5" Display="'Col 4/Col 5'" Dmx="41~44" Colour="0,0,0" />
      <Function ID="20" Name="Col 5/Col 6" Display="'Col 5/Col 6'" Dmx="50~53" Colour="0,0,0" />
      <Function ID="21" Name="Col 6/Col 7" Display="'Col 6/Col 7'" Dmx="59~62" Colour="0,0,0" />
      <Function ID="22" Name="Col 7/Col 8" Display="'Col 7/Col 8'" Dmx="68~71" Colour="0,0,0" />
      <Function ID="23" Name="Col 8/Col 9" Display="'Col 8/Col 9'" Dmx="77~80" Colour="0,0,0" />
      <Function ID="24" Name="Col 9/Col 10" Display="'Col 9/Col 10'" Dmx="86~89" Colour="0,0,0" />
      <Function ID="25" Name="Col 10/Col 11" Display="'Col 10/Col 11'" Dmx="95~98" Colour="0,0,0" />

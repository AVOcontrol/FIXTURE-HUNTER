      <Function ID="21" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="160~167" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="168~175" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="176~183" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="184~191" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="192~199" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="200~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="4~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="132~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="96~127" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="160~191" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:50" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="6~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~199" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="200~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~225" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="226~235" />
      <Function ID="3" Name="BO on Change" Display="'BO on Change'" Dmx="236~245" />
      <Function ID="4" Name="No Func" Display="'No Func'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Func" Display="'No Func'" Dmx="0~19" />
      <Function ID="2" Name="No Func" Display="'No Func'" Dmx="20~29" />
      <Function ID="3" Name="No Func" Display="'No Func'" Dmx="30~39" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="80~99" />
      <Function ID="7" Name="Macro 1" Display="'Macro 1'" Dmx="100~119" />
      <Function ID="8" Name="Macro 2" Display="'Macro 2'" Dmx="120~139" />
      <Function ID="9" Name="Macro 3" Display="'Macro 3'" Dmx="140~159" />
      <Function ID="10" Name="Macro 4" Display="'Macro 4'" Dmx="160~179" />
      <Function ID="11" Name="Macro 5" Display="'Macro 5'" Dmx="180~199" />

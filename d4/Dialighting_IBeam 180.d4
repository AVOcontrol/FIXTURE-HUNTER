      <Function ID="27" Name="Col 12/Col 13" Display="'Col 12/Col 13'" Dmx="113~116" Colour="0,0,0" />
      <Function ID="28" Name="Col 13/Open" Display="'Col 13/Open'" Dmx="122~127" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

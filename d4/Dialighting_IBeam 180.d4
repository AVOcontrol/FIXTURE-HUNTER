      <Function ID="14" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

  <History Date="27-03-13" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="22-04-13" Author="Peter Budd" Comment="Updated to latest specs" Version="2" />
  <History Date="29-11-13" Author="Peter Budd" Comment="Moved Keystone to Gobo 2, to ensure the wheels are on the same page." Version="3" />
  <History Date="10-12-13" Author="Peter Budd" Comment="Added additional detail to bring into line with latest spec." Version="4" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Updated to version 1.2 spec in response to manufacturer request." Version="5" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Fixed duplicate range in control.  Added missing macros." Version="6" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Simplified shutter.  Inverted speed wheel direction.  Added colour function index." Version="7" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Added Eff_Speed to Effect_Func function updates." Version="8" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Added standard and max functions to P/T speed." Version="9" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Modified zoom functions to ensure real size is absolute." Version="10" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Changed keystone to 255 value range and set default at 128." Version="11" />
  <History Date="18-02-14" Author="Nic Morris" Comment="Fixed duplicate ranges in colour.  Increased Gobo Rot wheel resolution." Version="12" />
  <History Date="22-01-16" Author="Nic Morris" Comment="Added NAS functions to Gobo Func in line with latest spec in response to manufacturer request." Version="13" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (swapped local and remote NAS functions)." Version="14" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Added physical pan/tilt ranges.  Inverted P/T Speed range to match wheel display." Version="15" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Shortened colour index function names to fit in all displays.  Revised ranges to full field." Version="16" />
  <History Date="12-12-17" Author="Nic Morris" Comment="Added Sync Local NAS w/NAS control function and macro in line with v1.6 charts in response to manufacturer request." Version="17" />
  <History Date="02-07-18" Author="Gregory Haynes" Comment="Added RDM information." Version="18" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Created from Robe Robin MiniMe" Version="19" />
  <History Date="10-06-20" Author="Nic Morris" Comment="Updated in line with v1.1 charts." Version="20" />
  <History Date="25-09-20" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request." Version="21" />
  <History Date="27-10-20" Author="Nic Morris" Comment="Revised Gobo with discreet functions in line with v1.3 charts in response to manufacturer request." Version="23" />
  <History Date="09-12-20" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (adds black gobo function and control functions and macros)" Version="24" />
  <History Date="10-12-20" Author="Nic Morris" Comment="Changed gobo black to white in line with latest charts in response to manufacturer request." Version="25" />
  <History Date="02-03-21" Author="Nic Morris" Comment="Added product thumbnail.  Checked against release version (v1.6 charts) - no differences found." Version="26" />
  <History Date="06-04-21" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request." Version="27" />
  <History Date="09-12-22" Author="Nic Morris" Comment="Added 33 channel mode 2 in line with v2.1 charts in response to manufacturer request.  Added Atlabase IDs for 25 channel mode." Version="28" />
  <History Date="10-12-22" Author="Nic Morris" Comment="Added Atlabase ID for 33 channel mode." Version="29" />
  <History Date="11-07-23" Author="Nic Morris" Comment="Updated in line with v2.2 charts in response to manufacturer request (adds robospot and fan quiet control functions and macros)" Version="30" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="31" />
  <History Date="11-03-24" Author="Nic Morris" Comment="Created from Robe Robin ProMotion" Version="32" />
  <History Date="13-04-24" Author="Nic Morris" Comment="Added product thumbnail" Version="36" />
  <History Date="13-08-24" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request." Version="37" />
  <History Date="14-08-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="38" />
  <History Date="21-10-25" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request (adds HDMI control functions/macros)" Version="39" />

    </Attribute>
    <Attribute ID="Eff_Speed" Name="Effect Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Control 1" ID="2,3,4" If="'Effect'&gt;1&amp;&amp;'Effect'&lt;51" />
      <Condition Name="Control 2" ID="5,6,7,8,9" If="'Effect'&gt;63&amp;&amp;'Effect'&lt;73" />
      <Condition Name="Control 3" ID="10,11" If="'Effect'&gt;52&amp;&amp;'Effect'&lt;60" />
      <Condition Name="Control 4" ID="12,13" If="'Effect'&lt;63&amp;&amp;'Effect'&gt;59" />
      <Condition Name="Control 5" ID="14" If="'Effect'&gt;74&amp;&amp;'Effect'&lt;78" />
      <Condition Name="Control 6" ID="15,16" If="'Effect'&gt;77&amp;&amp;'Effect'&lt;82" />
      <Condition Name="Control 7" ID="17,18,19" If="'Effect'==82||'Effect'==83" />
      <Condition Name="Control 8" ID="20" If="'Effect'&gt;84&amp;&amp;'Effect'&lt;91" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Presentation" Display="'Presentation'" Dmx="0~0" />
      <Function ID="3" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="251~255" />
      <Function ID="5" Name="Presentation" Display="'Presentation'" Dmx="0~0" />
      <Function ID="6" Name="Time FW" Display="'Time FW %.1f%%',0.0~100.0" Dmx="1~126" />
      <Function ID="7" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="8" Name="Time RW" Display="'Time RW %.1f%%',100.0~0.0" Dmx="129~254" />
      <Function ID="9" Name="Stop" Display="'Stop'" Dmx="255~255" />
      <Function ID="10" Name="Presentation" Display="'Presentation'" Dmx="0~0" />
      <Function ID="11" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="12" Name="Presentation" Display="'Presentation'" Dmx="0~0" />
      <Function ID="13" Name="Corners" Display="'Corners %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="14" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="16" Name="Mask" Display="'Mask %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="17" Name="Edge to Centre" Display="'Edge to Centre %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="18" Name="Centre" Display="'Centre'" Dmx="128~128" />
      <Function ID="19" Name="Centre to Edge" Display="'Centre to Edge %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="20" Name="Continuous" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="GreyBoxCorrect" Name="GreyBoxCorrect" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Diameter" Display="'Diameter %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Closed (LEDs Off)" Display="'Closed (LEDs Off)'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Closed (LEDs On)" Display="'Closed (LEDs On)'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>

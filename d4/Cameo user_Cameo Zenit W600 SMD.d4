<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Cameo Zenit W600 SMD" ShortName="Cameo Zeni" Company="Cameo user">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open %.1f%%',0.0~100.0" Dmx="0~5" />
      <Function ID="2" Name="Closed" Display="'Closed %.1f%%',0.0~100.0" Dmx="6~10" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="4" Name="Ramp up" Display="'Ramp up %.f%%',0~100" Dmx="34~56" />
      <Function ID="5" Name="Ramp down" Display="'Ramp down %.f%%',0~100" Dmx="57~79" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" />
      <Function ID="7" Name="Effect" Display="'Effect %.f%%',0~100" Dmx="103~127" />
      <Function ID="8" Name="Strobe Hz" Display="'Strobe %.f Hz',0~50" Dmx="128~250" />
      <Function ID="9" Name="Open" Display="'Open %.f%%',0~100" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green" Display="'Green %.f%%',0~100" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1" Lowlight="1:90" />
      <Function ID="1" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.f%%',0~100" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="14~21" Colour="255,100,0" />
      <Function ID="4" Name="Yellow C-Mix" Display="'Yellow warm %.1f%%',0.0~100.0" Dmx="22~29" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="30~37" Colour="0,255,0" />
      <Function ID="6" Name="Turquoise" Display="'Turquoise'" Dmx="38~45" Colour="0,255,128" />
      <Function ID="7" Name="Cyan C-Mix" Display="'Cyan %.1f%%',0.0~100.0" Dmx="46~53" Colour="0,255,255" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="54~61" Colour="0,0,255" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="62~69" Colour="128,0,255" />
      <Function ID="10" Name="Surprise Pink" Display="'Lavander'" Dmx="70~77" Colour="255,150,230" />
      <Function ID="11" Name="Magenta" Display="'Mauve'" Dmx="78~85" Colour="255,0,255" />
      <Function ID="12" Name="Light Magenta" Display="'Magenta'" Dmx="86~93" Colour="255,128,255" />
      <Function ID="13" Name="CTO Mix" Display="'Pink %.1f%%',0.0~100.0" Dmx="94~101" Colour="255,240,200" />
      <Function ID="14" Name="White C-Mix" Display="'Warm white %.1f%%',0.0~100.0" Dmx="102~109" Colour="255,255,255" />
      <Function ID="15" Name="CTB" Display="'White'" Dmx="110~117" Colour="230,230,255" />
      <Function ID="16" Name="No Scroll" Display="'Coldwhite'" Dmx="118~125" Colour="255,255,255" />
      <Function ID="17" Name="Scroll CCW" Display="'Stop Jumping %.f%%',0~100" Dmx="126~127" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Jumping Slow/Fast %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Fading %.f',0~255" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Generic" Name="Dimmer Curve" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1" />
      <Function ID="1" Name="OPEN" Display="'OPEN %.f',0~255" Dmx="0~5" WheelPosition="0" />
      <Function ID="2" Name="LINEAR" Display="'LINEAR %.f',0~255" Dmx="6~63" WheelPosition="0" />
      <Function ID="3" Name="EXPONENTIAL" Display="'EXPONENTIAL %.f',0~255" Dmx="64~127" WheelPosition="0" />
      <Function ID="4" Name="ALGHORITMIC" Display="'ALGHORITMIC %.f',0~255" Dmx="128~191" WheelPosition="0" />
      <Function ID="5" Name="S-CURVE" Display="'S-CURVE %.f',0~255" Dmx="192~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="DEVICE SETTINGS" Display="'DEVICE SETTINGS %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Cameo Zenit W600 SMD " Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="9" />
      <Attribute ID="White" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="11" />
      <Attribute ID="CTO" ChannelOffset="8" Wheel="12" />
      <Attribute ID="Generic" ChannelOffset="9" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
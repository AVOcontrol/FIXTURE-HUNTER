  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7849456d-1d51-49c4-b1ac-496d128bd207" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="2 DMX" ID="2,3" If="'Dummy'==1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~241" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="242~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Colour="0,0,255" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="21~25" Colour="0,200,0" />
      <Function ID="6" Name="Red/Green" Display="'Red/Green'" Dmx="26~30" Colour="255,255,255" />
      <Function ID="7" Name="Green/Blue" Display="'Green/Blue'" Dmx="31~35" Colour="255,255,255" />
      <Function ID="8" Name="Red/Blue" Display="'Red/Blue'" Dmx="36~40" Colour="255,255,255" />
      <Function ID="9" Name="Red/Lime" Display="'Red/Lime'" Dmx="41~45" Colour="255,255,255" />
      <Function ID="10" Name="Green/Lime" Display="'Green/Lime'" Dmx="46~50" Colour="255,255,255" />
      <Function ID="11" Name="Blue/Lime" Display="'Blue/Lime'" Dmx="51~55" Colour="255,255,255" />
      <Function ID="12" Name="Red/Green/Blue" Display="'Red/Green/Blue'" Dmx="56~60" Colour="255,255,255" />
      <Function ID="13" Name="Red/Green/Lime" Display="'Red/Green/Lime'" Dmx="61~65" Colour="255,255,255" />
      <Function ID="14" Name="Red/Blue/Lime" Display="'Red/Blue/Lime'" Dmx="66~70" Colour="255,255,255" />
      <Function ID="15" Name="Green/Blue/Lime" Display="'Green/Blue/Lime'" Dmx="71~75" Colour="255,255,255" />
      <Function ID="16" Name="Red/Green/Blue/Lime" Display="'Red/Green/Blue/Lime'" Dmx="76~80" Colour="255,255,255" />
      <Function ID="17" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="150~81" Colour="255,255,255" />
      <Function ID="18" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="255~151" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="190~190" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Sound/Sensitivity" Display="'Sound/Sensitivity %.f%%',0~100" Dmx="191~200" />
      <Function ID="5" Name="Full On" Display="'Full On'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2400K" Display="'2400K'" Dmx="46~75" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="76~105" Colour="0,0,0" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="106~135" Colour="0,0,0" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="136~165" Colour="0,0,0" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="166~195" Colour="0,0,0" />
      <Function ID="7" Name="7500K" Display="'7500K'" Dmx="196~225" Colour="0,0,0" />
      <Function ID="8" Name="8500K" Display="'8500K'" Dmx="226~255" Colour="0,0,0" />
    </Attribute>
  </Control>

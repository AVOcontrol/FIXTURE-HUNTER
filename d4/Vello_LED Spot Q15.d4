  </Mode>
  <Mode Name="Extended 1" Channels="23">
    <Import PearlRef="UKVLQ152" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter_Func" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />

      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Spot" ID="4,5,6,7" If="'Gobo1'&gt;1&amp;&amp;'Gobo1'&lt;25" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="15m" Display="'15m'" Dmx="51~100" />
      <Function ID="3" Name="29m" Display="'29m'" Dmx="101~150" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="5" Name="7.5m" Display="'7.5m'" Dmx="51~100" />
      <Function ID="6" Name="15m" Display="'15m'" Dmx="101~150" />
      <Function ID="7" Name="20m" Display="'20m'" Dmx="151~200" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">

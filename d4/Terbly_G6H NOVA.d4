  <History Date="23-05-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="24-05-18" Author="Nic Morris" Comment="Corrected name from GH6 NOVA to G6H NOVA" Version="2" />
  <History Date="20-07-18" Author="Nic Morris" Comment="Revised channel mappings in line with latest charts (completely different to original!)" Version="3" />
  <History Date="20-07-18" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches.  Note tilt range currently inconsistent between manual and product webpage." Version="4" />
  <History Date="15-08-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="03-09-18" Author="Nic Morris" Comment="More changes.  Adds controls to Standard mode and adds Basic mode (note total channel counts in charts don't match)." Version="6" />
  <History Date="03-09-18" Author="Nic Morris" Comment="Changes to autofocus function ranges." Version="7" />
  <History Date="26-09-18" Author="Nic Morris" Comment="Added basic and revised standard and extended Atlabase ID's to 'V2' versions." Version="8" />
  <History Date="25-03-19" Author="Nic Morris" Comment="Increased macro delay to 8 sec in response to manufacturer request." Version="9" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="10" />

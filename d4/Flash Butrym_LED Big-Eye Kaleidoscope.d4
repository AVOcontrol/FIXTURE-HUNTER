    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Distribution" ID="4" If="'Shape'==11" />
      <Condition Name="Density" ID="5" If="'Shape'==12" />
      <Condition Name="Angle" ID="6" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21||'Shape'==22||'Shape'==23||'Shape'==24||'Shape'==25||'Shape'==26||'Shape'==27||'Shape'==28||'Shape'==29||'Shape'==30||'Shape'==31||'Shape'==32" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Continuous" Display="'Continuous'" Dmx="0~0" />
      <Function ID="3" Name="Distribution" Display="'Distribution %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="4" Name="Distribution" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Offset" Display="'%.f°',0~360" Dmx="0~255" />
    </Attribute>

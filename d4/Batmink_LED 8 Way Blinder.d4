<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED 8 Way Blinder" ShortName="LEDBlinder" Company="Batmink">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="20-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Mode" Display="'RGB Mode'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~21" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="22~32" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="33~43" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="44~54" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="55~65" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="66~76" Colour="128,0,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="77~87" Colour="255,255,255" />
      <Function ID="9" Name="Slow Dream" Display="'Slow Dream'" Dmx="88~98" Colour="0,0,0" />
      <Function ID="10" Name="Fast Dream" Display="'Fast Dream'" Dmx="99~109" Colour="0,0,0" />
      <Function ID="11" Name="Colour Fade" Display="'Colour Fade'" Dmx="110~120" Colour="0,0,0" />
      <Function ID="12" Name="Colour Change" Display="'Colour Change'" Dmx="121~131" Colour="0,0,0" />
      <Function ID="13" Name="Flow 1" Display="'Flow 1'" Dmx="132~142" Colour="0,0,0" />
      <Function ID="14" Name="Flow 2" Display="'Flow 2'" Dmx="143~153" Colour="0,0,0" />
      <Function ID="15" Name="Flow 3" Display="'Flow 3'" Dmx="154~164" Colour="0,0,0" />
      <Function ID="16" Name="Flow 4" Display="'Flow 4'" Dmx="165~175" Colour="0,0,0" />
      <Function ID="17" Name="Double Flow 1" Display="'Double Flow 1'" Dmx="176~186" Colour="0,0,0" />
      <Function ID="18" Name="Double Flow 2" Display="'Double Flow 2'" Dmx="187~197" Colour="0,0,0" />
      <Function ID="19" Name="Multi Colour" Display="'Multi Colour'" Dmx="198~208" Colour="0,0,0" />
      <Function ID="20" Name="2 Colour Flow 1" Display="'2 Colour Flow 1'" Dmx="209~219" Colour="0,0,0" />
      <Function ID="21" Name="2 Colour Flow 2" Display="'2 Colour Flow 2'" Dmx="220~230" Colour="0,0,0" />
      <Function ID="22" Name="Sound Active" Display="'Sound Active'" Dmx="231~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour Sort" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sort" Display="'Sort %.f%%',0~100" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="BM_8LEDBLND" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Reserved" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
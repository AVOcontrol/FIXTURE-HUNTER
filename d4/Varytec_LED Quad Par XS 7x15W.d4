    <AtlaBase ModeID="4f585094-e969-453c-954e-ecd792d1f5af" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="38" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="37" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="10" Wheel="25" />
      <Attribute ID="Generic" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>

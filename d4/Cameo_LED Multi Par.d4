      <Function ID="10" Name="Bright Green" Display="'Bright Green'" Dmx="153~169" Colour="128,255,0" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="170~186" Colour="255,0,255" />
      <Function ID="12" Name="Warm White" Display="'Warm White'" Dmx="187~203" Colour="255,240,200" />
      <Function ID="13" Name="Cold White" Display="'Cold White'" Dmx="204~220" Colour="230,230,255" />

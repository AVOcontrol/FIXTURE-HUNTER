  <AtlaBase TypeID="6aac1802-e8d0-4966-8c16-955be3feca0a" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~47" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="48~55" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="56~63" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="8" Name="BW" Display="'BW'" Dmx="64~71" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="9" Name="RW" Display="'RW'" Dmx="72~79" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="80~87" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="11" Name="RB" Display="'RB'" Dmx="88~95" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="96~103" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="13" Name="GBW" Display="'GBW'" Dmx="104~111" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="14" Name="RGW" Display="'RGW'" Dmx="112~119" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="15" Name="RBW" Display="'RBW'" Dmx="120~127" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="128~135" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer, Red, Green, Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivitiy" ID="3" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Flow 8-9" ID="2,3" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~254" Colour="255,255,255" />
      <Function ID="3" Name="Blackout" Display="'Blackout'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Flow 8-9" ID="2,3" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~254" Colour="255,255,255" />
      <Function ID="3" Name="Blackout" Display="'Blackout'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Light_1" Name="Light 1" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Light_2" Name="Light 2" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Alt" ID="2,3,4" If="'Colour_Macro'&gt;1||'Colour_Macro'&lt;30" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="129~255" Intensity="0~0" />
      <Function ID="4" Name="Sound Sens" Display="'Sound Sens %.1f%%',0.0~100.0" Dmx="1~128" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="16" PowerOn="16" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />

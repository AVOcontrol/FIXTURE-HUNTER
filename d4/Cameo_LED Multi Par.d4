      <Function ID="7" Name="Cyan Bright" Display="'Cyan Bright'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="Violet Bright" Display="'Violet Bright'" Dmx="119~135" Colour="180,0,255" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d1e926a3-8a33-4520-9cf2-3717f21afbee" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="25~35" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="36~50" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="51~75" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="76~90" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="91~105" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="106~120" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="121~135" />
      <Function ID="9" Name="Fade Effect 1" Display="'Fade Effect 1'" Dmx="136~150" />
      <Function ID="10" Name="Fade Effect 2" Display="'Fade Effect 2'" Dmx="151~165" />
      <Function ID="11" Name="Fade Effect 3" Display="'Fade Effect 3'" Dmx="166~180" />
      <Function ID="12" Name="Fade Effect 4" Display="'Fade Effect 4'" Dmx="181~195" />
      <Function ID="13" Name="Fade Effect 5" Display="'Fade Effect 5'" Dmx="196~210" />
      <Function ID="14" Name="Fade Effect 6" Display="'Fade Effect 6'" Dmx="211~225" />
      <Function ID="15" Name="Fade Effect 7" Display="'Fade Effect 7'" Dmx="226~240" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade_Spd" Name="Fade Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="1s" Display="'1s'" Dmx="11~20" />
      <Function ID="3" Name="2s" Display="'2s'" Dmx="21~30" />
      <Function ID="4" Name="3s" Display="'3s'" Dmx="31~40" />
      <Function ID="5" Name="4s" Display="'4s'" Dmx="41~50" />
      <Function ID="6" Name="5s" Display="'5s'" Dmx="51~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">

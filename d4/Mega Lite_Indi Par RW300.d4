  <AtlaBase TypeID="da1b6091-7d35-4098-b1b5-db11eae1a20b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~196" />
      <Function ID="2" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="197~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="2~19" Colour="255,255,255" />
      <Function ID="3" Name="Snap" Display="'Snap %.f%%',0~100" Dmx="20~39" Colour="255,255,255" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="40~59" Colour="255,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~78" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="79~97" Colour="128,0,255" />
      <Function ID="7" Name="Aqua" Display="'Aqua'" Dmx="98~116" Colour="0,255,200" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="117~135" Colour="255,128,0" />
      <Function ID="9" Name="Red Pulse" Display="'Red Pulse'" Dmx="136~154" Colour="255,0,0" />
      <Function ID="10" Name="Green Pulse" Display="'Green Pulse'" Dmx="155~173" Colour="0,255,0" />
      <Function ID="11" Name="Blue Pulse" Display="'Blue Pulse'" Dmx="174~192" Colour="0,0,255" />
      <Function ID="12" Name="Yellow Pulse" Display="'Yellow Pulse'" Dmx="193~211" Colour="255,255,0" />
      <Function ID="13" Name="Aqua Pulse" Display="'Aqua Pulse'" Dmx="212~230" Colour="0,255,200" />
      <Function ID="14" Name="White Pulse" Display="'White Pulse'" Dmx="231~249" Colour="255,255,255" />
      <Function ID="15" Name="White LED Full" Display="'White LED Full'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
  </Control>

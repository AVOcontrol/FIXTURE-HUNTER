<Fixture Name="Robin 100 LEDBeam" ShortName="100 LED Bm" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>c3731188-dc29-4551-ba24-5db8e916141f</Thumbnail>
  <History Date="08-06-11" Author="John Rogers" Comment="Created from Robe_Robin 600E Wash.d4" />
  <History Date="28-07-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Removed shutter update from colour macros." />
  <History Date="28-07-11" Author="Nic Morris" Comment="Increased wheel resolution.  Added pixel mapper compatibility." />
  <History Date="28-07-11" Author="Nic Morris" Comment="Shortened names for Expert LCD" />
  <History Date="30-08-11" Author="Nic Morris" Comment="Removed dimmer attribute link from modes 1 and 5 cells." />
  <History Date="07-11-11" Author="John Rogers" Comment="Removed Virtual Dimmer from Cells." />
  <History Date="07-12-11" Author="John Rogers" Comment="Edited Colour Macro Zone Effects to Value range." />
  <History Date="17-02-12" Author="Peter Budd" Comment="Created from Robe Robin 300 LED Wash" />
  <History Date="16-04-12" Author="Peter Budd" Comment="Edited updated the P/T Speed ranges" />
  <History Date="24-04-12" Author="Peter Budd" Comment="Edited updated control and added macros. Added mode 6." />
  <History Date="07-08-12" Author="Peter Budd" Comment="Updated macros and physical timings." />
  <History Date="23-08-12" Author="Peter Budd" Comment="Added RDM support." />
  <History Date="30-08-12" Author="Peter Budd" Comment="Corrected" />
  <History Date="06-09-12" Author="Gregory Haynes" Comment="Corrected RDM Version elements." />
  <History Date="12-02-13" Author="Peter Budd" Comment="Edited unhid mode 5" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-05-17" Author="Nic Morris" Comment="Inverted P/T Speed wheel direction.  Revised Virtual Col index functions for full field control." />
  <History Date="31-05-17" Author="Nic Morris" Comment="Added vdim to multi-cell modes." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added product thumbnail." />
  <History Date="02-10-18" Author="Nic Morris" Comment="Added missing dimmer links to mode 6 cells." />

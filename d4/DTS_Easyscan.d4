      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:2" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:3" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:5" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:5" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:5" />

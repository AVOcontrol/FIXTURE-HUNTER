  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1362b3ae-1ca6-4b91-917a-e22b4bbf293e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~149" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="150~203" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="204~254" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="20~39" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="40~59" Colour="0,0,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="60~79" Colour="255,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="80~99" Colour="255,0,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="100~159" Colour="255,0,0" />
      <Function ID="7" Name="Scroll Speed I" Display="'Scroll Speed I'" Dmx="160~183" Colour="255,255,255" />
      <Function ID="8" Name="Scroll Speed 2" Display="'Scroll Speed 2'" Dmx="184~207" Colour="255,255,255" />
      <Function ID="9" Name="Scroll Speed 3" Display="'Scroll Speed 3'" Dmx="208~231" Colour="255,255,255" />
      <Function ID="10" Name="Scroll Speed 4" Display="'Scroll Speed 4'" Dmx="232~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="20~39" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="40~59" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="60~79" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="80~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="100~119" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="120~139" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="140~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="160~179" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll Speed 1" Display="'Scroll Speed 1'" Dmx="180~183" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Scroll Speed 2" Display="'Scroll Speed 2'" Dmx="184~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll Speed 3" Display="'Scroll Speed 3'" Dmx="208~231" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Scroll Speed 4" Display="'Scroll Speed 4'" Dmx="232~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6d8530c4-a378-433c-a488-87e223163c29" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />

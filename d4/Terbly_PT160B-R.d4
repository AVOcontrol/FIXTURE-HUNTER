      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="90~104" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>1d6cc138-36c1-421b-832d-259750bf744a</Swatch>

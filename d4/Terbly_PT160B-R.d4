        <Swatch>510d86fc-2706-4a49-abb2-5dd4c9ea1d24</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="150~164" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>f03e9795-78c6-4c03-9302-cc17e58f798c</Swatch>

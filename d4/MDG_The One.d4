<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="The One" ShortName="The One" Company="MDG">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="22-10-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Haze" Display="'Haze'" Dmx="0~0" />
      <Function ID="2" Name="Fog" Display="'Fog'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Fog" Display="'Fog %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="FogCtrl" Name="Fog Ctrl" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fog Off" Display="'Fog Off'" Dmx="0~0" />
      <Function ID="2" Name="Fog On" Display="'Fog On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="UK_MDGTOne" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Mode" ChannelOffset="2" Wheel="26" />
      <Attribute ID="FogCtrl" ChannelOffset="4" Wheel="27" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
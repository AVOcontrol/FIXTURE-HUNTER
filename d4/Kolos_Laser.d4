      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~41" />
      <Function ID="2" Name="Auto DMX" Display="'Auto DMX'" Dmx="42~83" />
      <Function ID="3" Name="Auto Cartoon" Display="'Auto Cartoon'" Dmx="84~125" />
      <Function ID="4" Name="Auto Beam" Display="'Auto Beam'" Dmx="126~167" />
      <Function ID="5" Name="Sound Beam" Display="'Sound Beam'" Dmx="168~209" />
      <Function ID="6" Name="Sound Cartoon" Display="'Sound Cartoon'" Dmx="210~251" />
      <Function ID="7" Name="Sound DMX" Display="'Sound DMX'" Dmx="252~255" />

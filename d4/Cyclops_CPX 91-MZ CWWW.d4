  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="077ffbb7-154b-45a6-928e-46f6de18b1c3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~200" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="8" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="10" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="11" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="12" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe%" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="20~39" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="40~59" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~79" />
      <Function ID="5" Name="Fan Slow" Display="'Fan Slow'" Dmx="80~99" />
      <Function ID="6" Name="Fan Normal" Display="'Fan Normal'" Dmx="100~119" />
      <Function ID="7" Name="Fan Fast" Display="'Fan Fast'" Dmx="120~139" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="140~149" />
      <Function ID="9" Name="Auto 2" Display="'Auto 2'" Dmx="150~159" />
      <Function ID="10" Name="Test" Display="'Test'" Dmx="160~169" />
      <Function ID="11" Name="Custom" Display="'Custom'" Dmx="170~179" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="180~199" />
      <Function ID="13" Name="Reset" Display="'Reset'" Dmx="200~219" />
      <Function ID="14" Name="Dim 0" Display="'Dim 0'" Dmx="236~239" />
      <Function ID="15" Name="Dim 1" Display="'Dim 1'" Dmx="240~243" />
      <Function ID="16" Name="Dim 2" Display="'Dim 2'" Dmx="244~247" />
      <Function ID="17" Name="Dim 3" Display="'Dim 3'" Dmx="248~251" />
      <Function ID="18" Name="Dim 4" Display="'Dim 4'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

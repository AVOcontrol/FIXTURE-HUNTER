  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Mode" Name="Tilt Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="3~4" Colour="0,0,0" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="5~6" Colour="0,0,0" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="7~8" Colour="0,0,0" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="9~10" Colour="0,0,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="11~11" Colour="0,0,255" />
      <Function ID="8" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="12~48" Colour="0,0,255" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="49~49" Colour="0,255,255" />
      <Function ID="10" Name="Cy - Grn" Display="'Cy - Grn %.f%%',0~100" Dmx="50~86" Colour="0,255,255" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="87~87" Colour="0,255,0" />
      <Function ID="12" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="88~124" Colour="0,255,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="125~125" Colour="255,255,0" />
      <Function ID="14" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="126~162" Colour="255,255,0" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="163~163" Colour="255,0,0" />
      <Function ID="16" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="164~200" Colour="255,0,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="201~201" Colour="255,0,255" />
      <Function ID="18" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="202~238" Colour="255,0,255" />
      <Function ID="19" Name="Blue" Display="'Blue'" Dmx="239~239" Colour="0,0,255" />
      <Function ID="20" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~239" Colour="0,0,0" />

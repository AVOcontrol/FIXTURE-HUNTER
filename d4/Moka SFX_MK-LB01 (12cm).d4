      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2e704d86-60ca-468a-af0e-46f9d19943ad" />
    <Include>
      <Attribute ID="Lifting_Height" ChannelOffset="1,2" Wheel="3" />
      <Attribute ID="Lifting_Spd" ChannelOffset="3" Wheel="25" />

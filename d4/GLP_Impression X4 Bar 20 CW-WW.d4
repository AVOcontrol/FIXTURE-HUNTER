  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Capture DMX Scene" Display="'Capture DMX Scene'" Dmx="60~63" />
      <Function ID="3" Name="DMX Hold use Captured Scene" Display="'DMX Hold use Captured Scene'" Dmx="64~67" />
      <Function ID="4" Name="Base Fan Full Off" Display="'Base Fan Full Off'" Dmx="72~75" />
      <Function ID="5" Name="Base Fan Full On" Display="'Base Fan Full On'" Dmx="76~79" />
      <Function ID="6" Name="Head Fan Full Off" Display="'Head Fan Full Off'" Dmx="80~83" />
      <Function ID="7" Name="Head Fan Full On" Display="'Head Fan Full On'" Dmx="84~87" />
      <Function ID="8" Name="PWM Freq 600Hz" Display="'PWM Freq 600Hz'" Dmx="88~91" />
      <Function ID="9" Name="PWM Freq 1200Hz" Display="'PWM Freq 1200Hz'" Dmx="92~95" />
      <Function ID="10" Name="PWM Freq 2400Hz" Display="'PWM Freq 2400Hz'" Dmx="96~99" />
      <Function ID="11" Name="PWM Freq 4800Hz" Display="'PWM Freq 4800Hz'" Dmx="100~103" />
      <Function ID="12" Name="PWM Freq 9600Hz" Display="'PWM Freq 9600Hz'" Dmx="104~107" />
      <Function ID="13" Name="PWM Freq 19.2kHz" Display="'PWM Freq 19.2kHz'" Dmx="108~111" />
      <Function ID="14" Name="PWM Freq 25kHz" Display="'PWM Freq 25kHz'" Dmx="112~115" />
      <Function ID="15" Name="Display Flip Off" Display="'Display Flip Off'" Dmx="144~147" />
      <Function ID="16" Name="Display Flip On" Display="'Display Flip On'" Dmx="148~151" />
      <Function ID="17" Name="X4 Compatibility Off" Display="'X4 Compatibility Off'" Dmx="192~195" />
      <Function ID="18" Name="X4 Compatibility On" Display="'X4 Compatibility On'" Dmx="196~199" />
      <Function ID="19" Name="Silent OFF" Display="'Silent OFF'" Dmx="200~203" />
      <Function ID="20" Name="Silent ON" Display="'Silent ON'" Dmx="204~207" />
      <Function ID="21" Name="Pos Feedback Off" Display="'Pos Feedback Off'" Dmx="208~211" />
      <Function ID="22" Name="Pos Feedback On" Display="'Pos Feedback On'" Dmx="212~215" />
      <Function ID="23" Name="DMX Hold Off" Display="'DMX Hold Off'" Dmx="216~219" />
      <Function ID="24" Name="DMX Hold On" Display="'DMX Hold On'" Dmx="220~223" />
      <Function ID="25" Name="Tilt Invert Off" Display="'Tilt Invert Off'" Dmx="224~227" />
      <Function ID="26" Name="Tilt Invert On" Display="'Tilt Invert On'" Dmx="228~231" />
      <Function ID="27" Name="Pixel Invert Off" Display="'Pixel Invert Off'" Dmx="232~235" />
      <Function ID="28" Name="Pixel Invert On" Display="'Pixel Invert On'" Dmx="236~239" />
      <Function ID="29" Name="Zoom Invert Off" Display="'Zoom Invert Off'" Dmx="240~243" />
      <Function ID="30" Name="Zoom Invert On" Display="'Zoom Invert On'" Dmx="244~247" />
      <Function ID="31" Name="Default" Display="'Default'" Dmx="248~251" />
      <Function ID="32" Name="Reset" Display="'Reset'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~239" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="144~159" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="48~79" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="80~111" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="112~143" />
      <Function ID="8" Name="Rand Pls" Display="'Rand Pls %.f%%',0~100" Dmx="16~47" />
      <Function ID="9" Name="Pause" Display="'Pause %.f%%',0~100" Dmx="160~199" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp OFF">
      <Set Channel="Control:10" Delay="6000" />

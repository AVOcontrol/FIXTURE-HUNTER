    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Shutter" ID="1,2" If="'Control'&gt;1&amp;&amp;'Control'&lt;6" />
      <Condition Name="Program" ID="3,4,5,6,7,8,9,10,11" If="'Control'&gt;5" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" Intensity="0~0" />

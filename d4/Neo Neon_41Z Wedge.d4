  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5a86ba0d-fac2-45c7-bcc0-f32cb8cab82b" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~40" Update="Program" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="41~80" Update="Program" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="81~120" Update="Program" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="121~160" Update="Program" />

      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="120~149" Intensity="0~0" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="150~179" Intensity="0~0" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="180~209" Intensity="0~0" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="210~239" Intensity="0~0" />
      <Function ID="11" Name="Program 9" Display="'Program 9'" Dmx="240~255" Intensity="0~0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />

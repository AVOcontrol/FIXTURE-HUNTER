    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="131~200" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="11~39" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="40~59" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="60~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Col Preset" Display="'Col Preset'" Dmx="80~99" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Halo DWE" Display="'Halo DWE'" Dmx="100~119" Update="Colour1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="CTC" ID="2" If="'Colour1Func'==2" />
      <Condition Name="Speed" ID="3" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Preset" ID="4" If="'Colour1Func'==5" />
      <Condition Name="Halo" ID="5" If="'Colour1Func'==6" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="255~255" Colour="0,0,0" />
      <Function ID="2" Name="CTO" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd Auto" Display="'Dim Spd Auto'" Dmx="10~19" />
      <Function ID="3" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="20~29" />
      <Function ID="4" Name="Dim Spd Med" Display="'Dim Spd Med'" Dmx="30~39" />
      <Function ID="5" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="40~49" />
      <Function ID="6" Name="Static Fixed Col" Display="'Static Fixed Col'" Dmx="50~59" />
      <Function ID="7" Name="Static Manual Col" Display="'Static Manual Col'" Dmx="60~69" />
      <Function ID="8" Name="Keylock On" Display="'Keylock On'" Dmx="70~79" />
      <Function ID="9" Name="Keylock Off" Display="'Keylock Off'" Dmx="80~89" />
      <Function ID="10" Name="Master DMX" Display="'Master DMX'" Dmx="90~99" />
      <Function ID="11" Name="Slave" Display="'Slave'" Dmx="100~109" />
      <Function ID="12" Name="Backlight On" Display="'Backlight On'" Dmx="110~119" />
      <Function ID="13" Name="Backlight 10s" Display="'Backlight 10s'" Dmx="120~129" />
      <Function ID="14" Name="Backlight 20s" Display="'Backlight 20s'" Dmx="130~139" />
      <Function ID="15" Name="Backlight 30s" Display="'Backlight 30s'" Dmx="140~149" />
      <Function ID="16" Name="Mapping Rotation On" Display="'Mapping Rotation On'" Dmx="150~159" />
      <Function ID="17" Name="Mapping Rotation Off" Display="'Mapping Rotation Off'" Dmx="160~169" />
    </Attribute>
  </Control>

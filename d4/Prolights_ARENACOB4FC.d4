  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>5d9b3d70-2f2b-49e1-b48c-da083024ed27</Thumbnail>
  <History Date="19-03-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="02-08-16" Author="Ermanno Valvason" Comment="Edited DMX modes names, added missing channels n EXTENDED modes." Version="2" />
  <History Date="02-08-16" Author="Nic Morris" Comment="Added HALO modes in line with documentation REV.003-05/16 - FW 1.24" Version="3" />
  <History Date="05-08-16" Author="Ermanno Valvason" Comment="Fixed EXT 27ch mapping." Version="4" />
  <History Date="21-01-20" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Standardised mode names." Version="5" />
  <History Date="21-01-20" Author="Nic Morris" Comment="Added vdim to EXTENDED 21 and 27 DMX mode cells in response to manufacturer request." Version="6" />
  <History Date="21-01-20" Author="Nic Morris" Comment="Fixed pattern index DMX range." Version="7" />
  <History Date="17-03-20" Author="Nic Morris" Comment="Changed colour to default at 255 in attempt to solve customer bug report (Capture is always treating this control as CTC regardless of Colour Func value meaning it was setting colour temp to 2000K at zero making blue look green)" Version="8" />
  <History Date="01-07-24" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds Extended, 28 DMX and Standard, 16 DMX modes)" Version="11" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e2d5aa5f-dbfd-4bed-a8e7-5ae9c642f206" />

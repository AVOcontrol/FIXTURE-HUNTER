  <History Date="19-04-19" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Z_axis" Name="Z axis" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Z Axis" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="26~50" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="51~75" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="76~100" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="101~125" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="126~150" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="151~175" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="176~200" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="201~225" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="11~13" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="32~52" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="53~73" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="74~94" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="95~115" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="116~136" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="137~157" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="158~178" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="179~199" WheelPosition="9" Colour="0,0,0" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="200~220" WheelPosition="10" Colour="0,0,0" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="221~241" WheelPosition="11" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="242~252" WheelPosition="12" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="253~255" WheelPosition="13" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Z_axis" ChannelOffset="3" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="P/T_Macro" ChannelOffset="5" Wheel="22" />
      <Attribute ID="P/T_Mac_Spd" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>

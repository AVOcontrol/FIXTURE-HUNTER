<Fixture Name="5.0-X4 Razor" ShortName="5.0-X4 Rzr" Company="Rodlight" Version="3">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="19-09-22" Author="Nic Morris" Comment="Created.  (note RDM model ID is not documented correctly.  Flash effect rate function ranges not documented properly)" Version="0" />
  <History Date="19-09-22" Author="Nic Morris" Comment="(charts contain errors - GEL is listed as 5 channels and has R defined twice - assume should be 6 with blue on offset 6.  Mode 5 is listed as 3 channels but is actually 5 as it is 16bit)" Version="0" />
  <History Date="08-03-23" Author="Nic Morris" Comment="Created from Rodlight ColorDim 1.25 (identical. contains all the same errors)" Version="1" />
  <History Date="11-03-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="1699" />
  </RDM>
  <AtlaBase TypeID="2f66b117-7967-4213-90bb-25b7106877c0" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="2000-7000" Display="'2000-7000 %.fK',2000~7000" Dmx="0~200" Colour="255,240,200" />
      <Function ID="2" Name="7100-12000" Display="'7100-12000 %.fK',7100~12000" Dmx="201~250" Colour="255,240,200" />
      <Function ID="3" Name="13600-20000" Display="'13600-20000 %.fK',13600~20000" Dmx="251~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M" Name="G/M" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="12~22" Colour="255,255,255" />
      <Function ID="3" Name="- Grn" Display="'- Grn %.f',99~0" Dmx="23~121" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="123~133" Colour="255,255,255" />
      <Function ID="5" Name="+ Grn" Display="'+ Grn %.f',0~99" Dmx="134~231" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="232~243" Colour="255,255,255" />
      <Function ID="7" Name="Neutral" Display="'Neutral'" Dmx="244~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xFade_CCT-&gt;Col" Name="xFade CCT-&gt;Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="No Function" ID="2" If="'FX'==2" />
      <Function ID="1" Name="CCT-&gt;Col" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Adjust Hue" ID="2,3,4,5" If="'FX'==2" />
      <Condition Name="No Function" ID="6" If="'FX'==6" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="0°" Display="'0°'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Adjust -" Display="'Adjust - %.1f°',330.0~360.0" Dmx="10~124" Colour="255,255,255" />
      <Function ID="4" Name="0°" Display="'0°'" Dmx="125~143" Colour="255,255,255" />
      <Function ID="5" Name="Adjust +" Display="'Adjust + %.1f°',1.0~30.0" Dmx="144~255" Colour="255,255,255" />
      <Function ID="6" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Adjust Hue" ID="2,3,4,5" If="'FX'==2" />
      <Condition Name="No Function" ID="6" If="'FX'==6" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />

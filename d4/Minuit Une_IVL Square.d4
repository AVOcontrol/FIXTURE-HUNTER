      <Function ID="3" Name="4 Beams" Display="'4 Beams'" Dmx="56~83" Update="Beam_Spin" />
      <Function ID="4" Name="8 Beams" Display="'8 Beams'" Dmx="84~111" Update="Beam_Spin" />

    <Attribute ID="Beam_Split1" Name="Beam Split" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Beam" Display="'1 Beam'" Dmx="0~0" Update="Beam_Spin" />

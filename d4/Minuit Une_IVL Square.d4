<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IVL Square" ShortName="IVL Square" Company="Minuit Une">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>434b4bc2-a66b-415b-9cbf-e221a682d46f</Thumbnail>
  <History Date="22-06-17" Author="Nic Morris" Comment="Created" />
  <History Date="04-07-17" Author="Nic Morris" Comment="Merged Pete's beam spin conditionals (spin ranges limited depending on number of beams)" />
  <History Date="04-07-17" Author="Nic Morris" Comment="Changed tilt master to locate at zero to allow individual tilts to work." />
  <History Date="29-09-17" Author="Peter Budd" Comment="Corrected Cell Layout on manufacturer request changed beem offset and size to percent for keyframe shapes." />
  <History Date="28-03-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="28-03-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="23-05-18" Author="Nic Morris" Comment="Changed Beam Offset to be always available in response to manufacturer request (previously it was set to disable when beam spin was set to off)" />
  <History Date="07-02-20" Author="Nic Morris" Comment="Created from Minuit Une M-Carre" />
  <History Date="11-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2bb41d6e-fa70-4a46-88ce-d74942bd498c" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="50~255" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="24~49" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade" Name="Blade" Description="" Group="I" Size="2">
      <Locate Locate="1:360" PowerOn="1:360" />
      <Function ID="1" Name="Blade" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="15~27" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe" Display="'%.f BPM',30~1440" Dmx="28~227" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="228~255" />
    </Attribute>
    <Attribute ID="All_Tilt_Mode" Name="All Tilt Mode" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="All_Tilt" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="0~0" Update="All_Tilt" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="All_Tilt" />
    </Attribute>
    <Attribute ID="All_Tilt" Name="All Tilt" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Normal" ID="1" If="'All_Tilt_Mode'==1" />
      <Condition Name="Frost" ID="2" If="'All_Tilt_Mode'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~32767" />
      <Function ID="2" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="32768~65535" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Ind_Tilt_Mode" Name="Ind Tilt Mode" Description="" Group="P" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Ind_Tilt" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="0~0" Update="Ind_Tilt" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Ind_Tilt" />
    </Attribute>
    <Attribute ID="Ind_Tilt" Name="Ind Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:25" PowerOn="1:25" />
      <Condition Name="Normal" ID="1" If="'Ind_Tilt_Mode'==1" />
      <Condition Name="Frost" ID="2" If="'Ind_Tilt_Mode'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~32767" />
      <Function ID="2" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="32768~65535" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Mode" Name="Tilt Mode" Description="" Group="P" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Tilt" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="0~0" Update="Tilt" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Tilt" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:25" PowerOn="1:25" />
      <Condition Name="Normal" ID="1" If="'Tilt_Mode'==1" />
      <Condition Name="Frost" ID="2" If="'Tilt_Mode'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~32767" />
      <Function ID="2" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="32768~65535" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Split" Name="Beam Split" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Beam" Display="'1 Beam'" Dmx="0~0" Update="Beam_Spin" />
      <Function ID="2" Name="2 Beams" Display="'2 Beams'" Dmx="37~73" Update="Beam_Spin" />
      <Function ID="3" Name="4 Beams" Display="'4 Beams'" Dmx="74~110" Update="Beam_Spin" />
      <Function ID="4" Name="8 Beams" Display="'8 Beams'" Dmx="111~147" Update="Beam_Spin" />
      <Function ID="5" Name="16 Beams" Display="'16 Beams'" Dmx="148~184" Update="Beam_Spin" />
      <Function ID="6" Name="32 Beams" Display="'32 Beams'" Dmx="185~221" Update="Beam_Spin" />
      <Function ID="7" Name="64 Beams" Display="'64 Beams'" Dmx="222~255" Update="Beam_Spin" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Beam_Spin" />
    </Attribute>
    <Attribute ID="Beam_Offset" Name="Beam Offset" Description="" Group="G" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Spin" Name="Beam Spin" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="1 Beam" ID="1,2,3,4,5" If="'Beam_Split'==1||'Beam_Split1'==1" />
      <Condition Name="2 Beams" ID="6,7,8,9,10" If="'Beam_Split'==2||'Beam_Split1'==2" />
      <Condition Name="4 Beams" ID="11,12,13,14,15" If="'Beam_Split'==3||'Beam_Split1'==3" />
      <Condition Name="8 Beams" ID="16,17,18,19,20" If="'Beam_Split'==4||'Beam_Split1'==4" />
      <Condition Name="16 Beams" ID="21,22,23,24,25" If="'Beam_Split'==5||'Beam_Split1'==5" />
      <Condition Name="32 Beams" ID="26,27,28,29,30" If="'Beam_Split'==6||'Beam_Split1'==6" />
      <Condition Name="64 Beams" ID="31,32,33,34,35" If="'Beam_Split'==7||'Beam_Split1'==7" />
      <Else ID="36" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="3352~31485" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34010~62015" />
      <Function ID="5" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="6" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="20632~31490" />
      <Function ID="8" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="9" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34064~44874" />
      <Function ID="10" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="11" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="12" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="26308~31459" />
      <Function ID="13" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="14" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34054~39244" />
      <Function ID="15" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="16" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="28383~31478" />
      <Function ID="18" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="19" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34098~37154" />
      <Function ID="20" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="21" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="22" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="29309~31469" />
      <Function ID="23" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="24" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34026~36217" />
      <Function ID="25" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="26" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="27" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="30240~31466" />
      <Function ID="28" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="29" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34035~35301" />
      <Function ID="30" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="31" Name="Off" Display="'Off'" Dmx="0~0" WheelPosition="0" />
      <Function ID="32" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="30861~31487" />
      <Function ID="33" Name="No Spin" Display="'No Spin'" Dmx="31490~31490" />
      <Function ID="34" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="34088~34670" />
      <Function ID="35" Name="Off" Display="'Off'" Dmx="65535~65535" WheelPosition="0" />
      <Function ID="36" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Size" Name="Beam Size" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Size" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

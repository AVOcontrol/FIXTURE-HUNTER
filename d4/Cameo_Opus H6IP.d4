    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16,17" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Shake" ID="18,19,20,21,22,23,24,25" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Scroll" ID="26,27,28,29" If="'Gobo1Func'==7||'Gobo1Func'==8" />
      <Else ID="30" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="22~22" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="39~39" WheelPosition="2" />

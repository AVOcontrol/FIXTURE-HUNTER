      <Function ID="26" Name="Open" Display="'Open'" Dmx="192~192" WheelPosition="0" />
      <Function ID="27" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~223" />
      <Function ID="28" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" />
      <Function ID="29" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" />
      <Function ID="30" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

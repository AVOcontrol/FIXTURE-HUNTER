  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="67d3df93-ef8c-4562-8fc9-06b850173b8d" />
  <Control>
    <Attribute ID="Tilt" Name="Lift" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lift" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Lift_Speed" Name="Lift Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="30~39" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="40~49" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="50~59" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="60~69" />
      <Function ID="6" Name="Roll Up PRI" Display="'Roll Up PRI'" Dmx="71~71" />
      <Function ID="7" Name="Roll Up SEC 1" Display="'Roll Up SEC 1'" Dmx="72~72" />
      <Function ID="8" Name="Roll Up SEC 2" Display="'Roll Up SEC 2'" Dmx="73~73" />
      <Function ID="9" Name="Roll Up All" Display="'Roll Up All'" Dmx="77~77" />
      <Function ID="10" Name="Release PRI" Display="'Release PRI'" Dmx="81~81" />
      <Function ID="11" Name="Release SEC 1" Display="'Release SEC 1'" Dmx="82~82" />
      <Function ID="12" Name="Release SEC 2" Display="'Release SEC 2'" Dmx="83~83" />
      <Function ID="13" Name="Release All" Display="'Release All'" Dmx="88~88" />
      <Function ID="14" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="15" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="210~219" />
      <Function ID="16" Name="Dim Spd Smooth" Display="'Dim Spd Smooth'" Dmx="220~229" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Studio Fresnel WW" ShortName="Fres WW" Company="TourPro">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="17-09-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear+LED" Display="'Linear+LED'" Dmx="0~0" />
      <Function ID="2" Name="Linear+Halogen" Display="'Linear+Halogen'" Dmx="31~60" />
      <Function ID="3" Name="Square+LED" Display="'Square+LED'" Dmx="61~90" />
      <Function ID="4" Name="Square+Halogen" Display="'Square+Halogen'" Dmx="91~120" />
      <Function ID="5" Name="Inv Sq+LED" Display="'Inv Sq+LED'" Dmx="121~150" />
      <Function ID="6" Name="Inv Sq+Halogen" Display="'Inv Sq+Halogen'" Dmx="151~180" />
      <Function ID="7" Name="S-Curve+LED" Display="'S-Curve+LED'" Dmx="181~210" />
      <Function ID="8" Name="S-Curve+Halogen" Display="'S-Curve+Halogen'" Dmx="211~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKTPSFW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKTPSFW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Dim_Spd" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Tilt" ChannelOffset="5" Wheel="21" />
      <Attribute ID="Pan1" ChannelOffset="6" Wheel="2" />
      <Attribute ID="Tilt1" ChannelOffset="7" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />

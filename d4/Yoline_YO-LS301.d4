    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed" Display="'Fixed %.f',0~24" Dmx="0~24" Colour="0,0,0" />
      <Function ID="2" Name="Col. select" Display="'Col. select %.f',25~199" Dmx="25~199" Colour="0,0,0" />
      <Function ID="3" Name="Col. Scroll 1" Display="'Col. Scroll 1 %.f%%',0~100" Dmx="200~224" Colour="0,0,0" />
      <Function ID="4" Name="Col. Scroll 2" Display="'Col. Scroll 2 %.f%%',0~100" Dmx="225~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Speed" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'Speed %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

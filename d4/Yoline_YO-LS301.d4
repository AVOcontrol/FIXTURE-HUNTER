  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="01-06-12" Author="Sebastian Beutel" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Trigger" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~41" Intensity="0~0" />
      <Function ID="2" Name="Auto/Normal" Display="'Auto/Normal'" Dmx="42~83" Intensity="0~0" />
      <Function ID="3" Name="Auto/Anim" Display="'Auto/Anim %.f',0~100" Dmx="84~125" Intensity="0~0" />
      <Function ID="4" Name="Auto/Beam" Display="'Auto/Beam %.f',0~100" Dmx="126~167" Intensity="0~0" />
      <Function ID="5" Name="Music/Beam" Display="'Music/Beam %.f',0~100" Dmx="168~209" Intensity="0~0" />
      <Function ID="6" Name="Music/Anim" Display="'Music/Anim %.f',0~100" Dmx="210~251" Intensity="0~0" />
      <Function ID="7" Name="Music/Normal" Display="'Music/Normal'" Dmx="252~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern Select" Display="'Pattern Select %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Pattern rotate" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'Angle %.f',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse %.f%%',0~100" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Normal" Display="'Normal %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Hor. rotate" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Vert. rotate" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pan1" Name="Hor. move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt1" Name="Vert. move" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Pattern size" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Size" Display="'Size %.f',0~100" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Large-Small" Display="'Large-Small %.f',0~100" Dmx="64~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Small-Large" Display="'Small-Large %.f',0~100" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Zoom Speed" Display="'Zoom Speed %.f',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Pattern speed" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'Speed %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Scan Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Scan Speed" Display="'Scan Speed %.1f%%',0.0~100.0" Dmx="0~127" />

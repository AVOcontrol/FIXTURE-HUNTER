<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="XR250 Spot" ShortName="XR250Spot" Company="DTS">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo ID to Gobo1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated GoboRot ID to Gobo1Rot" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-14" Author="Nic Morris" Comment="Standardised conditionals.  Moved raw functions into else conditions and fixed duplicate ID's." />
  <History Date="25-05-14" Author="Nic Morris" Comment="Added conditions to Gobo spin.  Added colour function index.  Added palettes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="81ae6161-0bbe-496e-85d1-f814ac7f8d31" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tracking" Display="'Tracking'" Dmx="0~10" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="247~128" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="234~255" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="10~23" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="24~107" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="108~163" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="164~219" Intensity="0~0" />
      <Function ID="7" Name="Col/Gobo BO" Display="'Col/Gobo BO'" Dmx="220~227" Intensity="0~0" />
      <Function ID="8" Name="P/T BO" Display="'P/T BO'" Dmx="228~233" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21" If="'Colour1Func'==3" />
      <Else ID="22" />
      <Function ID="1" Name="Col 1" Display="'Col 1'" Dmx="0~10" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Col 2" Display="'Col 2'" Dmx="22~32" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Col 3" Display="'Col 3'" Dmx="44~54" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Col 4" Display="'Col 4'" Dmx="67~76" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Col 5" Display="'Col 5'" Dmx="88~98" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Col 6" Display="'Col 6'" Dmx="110~120" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Col 7" Display="'Col 7'" Dmx="132~142" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Col 8" Display="'Col 8'" Dmx="154~164" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Col 9" Display="'Col 9'" Dmx="176~186" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Split 1/2" Display="'Split 1/2'" Dmx="11~21" WheelPosition="0" Colour="0,0,0" />
      <Function ID="11" Name="Split 2/3" Display="'Split 2/3'" Dmx="33~43" WheelPosition="1" Colour="0,0,0" />
      <Function ID="12" Name="Split 3/4" Display="'Split 3/4'" Dmx="55~65" WheelPosition="2" Colour="0,0,0" />
      <Function ID="13" Name="Split 4/5" Display="'Split 4/5'" Dmx="77~87" WheelPosition="3" Colour="0,0,0" />
      <Function ID="14" Name="Split 5/6" Display="'Split 5/6'" Dmx="99~109" WheelPosition="4" Colour="0,0,0" />
      <Function ID="15" Name="Split 6/7" Display="'Split 6/7'" Dmx="121~131" WheelPosition="5" Colour="0,0,0" />
      <Function ID="16" Name="Split 7/8" Display="'Split 7/8'" Dmx="143~153" WheelPosition="6" Colour="0,0,0" />
      <Function ID="17" Name="Split 8/9" Display="'Split 8/9'" Dmx="165~175" WheelPosition="7" Colour="0,0,0" />
      <Function ID="18" Name="Split 9/1" Display="'Split 9/1'" Dmx="187~197" WheelPosition="8" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',0~100" Dmx="198~224" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="225~228" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="229~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourProp" Name="Colour Prop" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" Colour="0,0,0" />
      <Function ID="2" Name="Colour Prop" Display="'%.1f%%',0.0~100.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="9" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="26~51" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="52~77" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="78~103" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="104~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="130~155" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="156~181" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="182~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',0~100" Dmx="208~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="5" />
      <Function ID="1" Name="Index" Display="'Index %.f°',0~360" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="181~202" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',100~0" Dmx="203~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~63" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="64~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~29" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="30~85" />
      <Function ID="3" Name="Reset_PT" Display="'Reset PT'" Dmx="86~170" />
      <Function ID="4" Name="Reset_All" Display="'Reset All'" Dmx="171~235" />
      <Function ID="5" Name="Lamp On" Display="'Lamp On'" Dmx="236~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX, 16bit" Channels="14">
    <Import PearlRef="DTS_XR25S14" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

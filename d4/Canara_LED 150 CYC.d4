      <Function ID="20" Name="Light Salmon" Display="'Light Salmon'" Dmx="162~169" Colour="255,200,200" />
      <Function ID="21" Name="Magenta" Display="'Magenta'" Dmx="170~178" Colour="255,0,255" />
      <Function ID="22" Name="Dark Amber" Display="'Dark Amber'" Dmx="179~186" Colour="255,100,0" />
      <Function ID="23" Name="Apricot" Display="'Apricot'" Dmx="187~195" Colour="255,128,0" />
      <Function ID="24" Name="Warm Peach" Display="'Warm Peach'" Dmx="196~203" Colour="255,200,200" />
      <Function ID="25" Name="Steel Blue" Display="'Steel Blue'" Dmx="204~212" Colour="220,240,255" />
      <Function ID="26" Name="Lavender" Display="'Lavender'" Dmx="213~220" Colour="255,128,255" />

      <Function ID="17" Name="Medium Yellow" Display="'Medium Yellow'" Dmx="136~144" Colour="255,255,0" />
      <Function ID="18" Name="Indigo" Display="'Indigo'" Dmx="145~152" Colour="180,0,255" />

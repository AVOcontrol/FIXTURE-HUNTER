      <Function ID="5" Name="Dark Green" Display="'Dark Green'" Dmx="34~42" Colour="0,180,0" />
      <Function ID="6" Name="Sky Blue" Display="'Sky Blue'" Dmx="43~50" Colour="0,128,255" />
      <Function ID="7" Name="Deep Orange" Display="'Deep Orange'" Dmx="51~59" Colour="255,100,0" />

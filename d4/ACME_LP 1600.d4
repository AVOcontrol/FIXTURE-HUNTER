  <History Date="11-10-11" Author="Nic Morris" Comment="Created" />
  <History Date="11-10-11" Author="Nic Morris" Comment="Created from LP 900" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Cold_White" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Cold White" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Warm White" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 2 DMX" Channels="2">
    <Import PearlRef="AME_LP161" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Cold_White" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Warm_White" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 2 DMX" Channels="2">
    <Import PearlRef="AME_LP162" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 3 DMX" Channels="3">
    <Import PearlRef="AME_LP163" DiamondRef="" WysiwygRef="" />
    <Physical>

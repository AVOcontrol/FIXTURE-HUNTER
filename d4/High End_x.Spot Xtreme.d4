  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:10,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:11,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:12,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Int">
      <Set Channel="Control:13,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Focus/Zoom/Frost">
      <Set Channel="Control:14,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Iris">

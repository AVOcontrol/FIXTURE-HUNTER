      <Function ID="3" Name="Index" Display="'Index'" Dmx="16~31" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="4" Name="Index (MSpeed)" Display="'Index (MSpeed)'" Dmx="144~159" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="5" Name="Blink" Display="'Blink'" Dmx="112~127" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="6" Name="Blind (MSpeed)" Display="'Blind (MSpeed)'" Dmx="240~255" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="7" Name="Spin" Display="'Spin'" Dmx="48~63" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="8" Name="Spin (MSpeed)" Display="'Spin (MSpeed)'" Dmx="176~191" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="9" Name="Cycle" Display="'Cycle'" Dmx="64~79" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="10" Name="Cycle (MSpeed)" Display="'Cycle (MSpeed)'" Dmx="192~207" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="96~111" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="12" Name="Random (MSpeed)" Display="'Random (MSpeed)'" Dmx="224~239" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Index/Blink" ID="2,3" If="'C-Mix_Func'&gt;2&amp;&amp;'C-Mix_Func'&lt;7" />
      <Condition Name="Spin" ID="4,5,6,7,8" If="'C-Mix_Func'==7||'C-Mix_Func'==8" />
      <Condition Name="Cycle/Random" ID="9" If="'C-Mix_Func'&gt;8" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
      <Function ID="2" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="127~0" Colour="0,255,255" />
      <Function ID="3" Name="-" Display="'- %.1f%%',100.0~0.0" Dmx="128~255" Colour="0,255,255" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="188~195" Colour="0,0,0" />
      <Function ID="6" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~196" Colour="0,0,0" />
      <Function ID="7" Name="No Spin" Display="'No Spin'" Dmx="188~195" Colour="0,0,0" />
      <Function ID="8" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="187~128" Colour="0,0,0" />
      <Function ID="9" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Index/Blink" ID="2,3" If="'C-Mix_Func'&gt;2&amp;&amp;'C-Mix_Func'&lt;7" />
      <Condition Name="Spin" ID="4,5,6,7,8" If="'C-Mix_Func'==7||'C-Mix_Func'==8" />
      <Else ID="1" />

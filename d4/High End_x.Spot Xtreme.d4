      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:7,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:8,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Shutdown">
      <Set Channel="Control:9,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="P/T MSpeed Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:3,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display Dim">
      <Set Channel="Control:4,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display Bright">
      <Set Channel="Control:5,Shutter_Func:1,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
  </Macro>

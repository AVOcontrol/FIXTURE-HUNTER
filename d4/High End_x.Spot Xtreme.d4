    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Fixed (MSpeed)" Display="'Fixed (MSpeed)'" Dmx="128~143" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Slow Scan" Display="'Slow Scan'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />

  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Lamp Assisted Strobes" Display="'Lamp Assisted Strobes'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Lamp Effects" Display="'Lamp Effects'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Dual Dimming" Display="'Dual Dimming'" Dmx="96~127" Update="Shutter" />
      <Function ID="5" Name="Electronic Dimming Only" Display="'Electronic Dimming Only'" Dmx="128~159" Update="Shutter" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">

  <History Date="31-08-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-12-16" Author="Nic Morris" Comment="Added separate v1 and v2 options to modes 3 and 4.  Moved Atlabase ID's to V1 versions." />
  <History Date="13-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to 1 DMX, 3 DMX V2 and 4 DMX V2 modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="63ff3643-af86-4915-a133-1731cac65535" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~41" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="42~84" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="85~127" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="128~170" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="171~213" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="214~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="ELQPWW21" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a56aa4d9-1be0-4627-9fcf-06b77b68babc" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>

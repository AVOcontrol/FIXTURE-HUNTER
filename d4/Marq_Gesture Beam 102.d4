  <History Date="22-03-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added palettes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ddbf8669-c897-478b-a620-e8a1f0a4c934" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="189~128" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="189~128" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="146~215" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="30~44" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="45~59" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="60~74" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="75~89" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="90~104" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="105~119" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="120~134" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="135~149" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="150~164" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="165~179" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="180~194" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="195~209" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="210~224" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="225~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Program" Name="Col Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="2" Name="Program 1 (Snap)" Display="'Program 1 (Snap)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="3" Name="Program 2 (Snap)" Display="'Program 2 (Snap)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="4" Name="Program 3 (Snap)" Display="'Program 3 (Snap)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="5" Name="Program 4 (Fade)" Display="'Program 4 (Fade)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="6" Name="Program 5 (Fade)" Display="'Program 5 (Fade)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="7" Name="Program 6 (Fade)" Display="'Program 6 (Fade)'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="8" Name="Sound Snap" Display="'Sound Snap'" Dmx="0~0" Update="Col_Prog_Spd" />
      <Function ID="9" Name="Sound Fade" Display="'Sound Fade'" Dmx="0~0" Update="Col_Prog_Spd" />
    </Attribute>
    <Attribute ID="Col_Prog_Spd" Name="Col Prog Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Col_Program'&gt;7" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="40~71" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="72~103" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="104~135" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="136~167" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="168~199" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="200~231" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4'" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="5" Name="Reset Col/Gobo" Display="'Reset Col/Gobo'" Dmx="150~169" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
  </Control>

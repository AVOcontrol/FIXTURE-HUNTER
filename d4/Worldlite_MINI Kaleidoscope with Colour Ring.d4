    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Auto Slow" Display="'Auto Slow %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto Fast" Display="'Auto Fast %.1f%%',0.0~100.0" Dmx="128~255" />

      <Attribute ID="Iris_Macro" ChannelOffset="19" Wheel="49" />
      <Attribute ID="Focus" ChannelOffset="20,21" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="22,23" Wheel="19" />

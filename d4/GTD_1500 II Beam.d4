      <Attribute ID="Prism_Rot" ChannelOffset="25" Wheel="24" />
      <Attribute ID="Pan" ChannelOffset="26,27" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="28,29" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="30" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="31" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Shutter">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

  <Thumbnail>d65388b7-0b4a-4ad6-9fc2-17f1142056c6</Thumbnail>
  <History Date="07-06-24" Author="Nic Morris" Comment="Created (note charts and menu detail mode 3 as 55 channels but channels 52-54 are missing.  assumed 51 for now.  Similarly, mode 4 has two controls on offset 4.  assumed zoom is 8bit and ignored zoom fine)" Version="0" />
  <History Date="08-06-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="29-06-24" Author="Nic Morris" Comment="Fixed inverted dimmer." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eef683f4-80f9-4aa0-aefd-cea98057956a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

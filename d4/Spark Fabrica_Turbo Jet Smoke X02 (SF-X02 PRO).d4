        <AttributeLink SourceId="Smoke" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="8 DMX" Channels="8" Id="9b745244-f4ba-4e75-abb5-72261d021cf7">

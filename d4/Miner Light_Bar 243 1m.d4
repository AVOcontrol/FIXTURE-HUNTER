  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a0a6922e-1e92-48a6-993f-d1cc3646925d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~16" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="17~27" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="28~38" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="39~49" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="50~60" Colour="255,150,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="61~71" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="72~82" Colour="255,255,255" />
      <Function ID="9" Name="Jump 1" Display="'Jump 1'" Dmx="83~93" Colour="0,0,0" />
      <Function ID="10" Name="Jump 2" Display="'Jump 2'" Dmx="94~104" Colour="0,0,0" />
      <Function ID="11" Name="Jump 3" Display="'Jump 3'" Dmx="105~115" Colour="0,0,0" />
      <Function ID="12" Name="Jump 4" Display="'Jump 4'" Dmx="116~126" Colour="0,0,0" />
      <Function ID="13" Name="Jump 5" Display="'Jump 5'" Dmx="127~137" Colour="0,0,0" />
      <Function ID="14" Name="Jump 6" Display="'Jump 6'" Dmx="138~148" Colour="0,0,0" />
      <Function ID="15" Name="Jump 7" Display="'Jump 7'" Dmx="149~159" Colour="0,0,0" />
      <Function ID="16" Name="Jump 8" Display="'Jump 8'" Dmx="160~170" Colour="0,0,0" />
      <Function ID="17" Name="Loop Jump 1-8" Display="'Loop Jump 1-8'" Dmx="171~181" Colour="0,0,0" />
      <Function ID="18" Name="Red Shade Effect" Display="'Red Shade Effect'" Dmx="182~192" Colour="255,0,0" />
      <Function ID="19" Name="Green Shade Effect" Display="'Green Shade Effect'" Dmx="193~203" Colour="0,255,0" />
      <Function ID="20" Name="Blue Shade Effect" Display="'Blue Shade Effect'" Dmx="204~214" Colour="0,0,255" />
      <Function ID="21" Name="Pink Shade Effect" Display="'Pink Shade Effect'" Dmx="215~225" Colour="255,150,150" />
      <Function ID="22" Name="Yellow Shade Effect" Display="'Yellow Shade Effect'" Dmx="226~236" Colour="255,255,0" />
      <Function ID="23" Name="Loop Red-Yellow Shade Effect" Display="'Loop Red-Yellow Shade Effect'" Dmx="237~247" Colour="255,255,255" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sunbeam" ShortName="Sunbeam" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="06-07-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="16~23" Colour="255,255,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="32~39" Colour="255,255,255" />
      <Function ID="6" Name="R/ G" Display="'R/ G'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="R/ B" Display="'R/ B'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="R/ W" Display="'R/ W'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="R/ A" Display="'R/ A'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="G/ B" Display="'G/ B'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="G/ W" Display="'G/ W'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="G/ A" Display="'G/ A'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="B/ W" Display="'B/ W'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="B/ A" Display="'B/ A'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="R/ G/ B" Display="'R/ G/ B'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="R/ G/ W" Display="'R/ G/ W'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="17" Name="R/ G/ A" Display="'R/ G/ A'" Dmx="128~135" Colour="255,255,255" />
      <Function ID="18" Name="R/ B/ W" Display="'R/ B/ W'" Dmx="136~143" Colour="255,255,255" />
      <Function ID="19" Name="R/ B/ A" Display="'R/ B/ A'" Dmx="144~151" Colour="255,255,255" />
      <Function ID="20" Name="R/ W/ A" Display="'R/ W/ A'" Dmx="152~159" Colour="255,255,255" />
      <Function ID="21" Name="B/ W/ A" Display="'B/ W/ A'" Dmx="160~167" Colour="255,255,255" />
      <Function ID="22" Name="G/ B/ W" Display="'G/ B/ W'" Dmx="168~175" Colour="255,255,255" />
      <Function ID="23" Name="G/ B/ A" Display="'G/ B/ A'" Dmx="176~183" Colour="255,255,255" />
      <Function ID="24" Name="G/ W/ A" Display="'G/ W/ A'" Dmx="184~191" Colour="255,255,255" />
      <Function ID="25" Name="R/ G/ B/ W" Display="'R/ G/ B/ W'" Dmx="192~199" Colour="255,255,255" />
      <Function ID="26" Name="R/ B/ W/ A" Display="'R/ B/ W/ A'" Dmx="200~207" Colour="255,255,255" />
      <Function ID="27" Name="R/ G/ W/ A" Display="'R/ G/ W/ A'" Dmx="208~215" Colour="255,255,255" />
      <Function ID="28" Name="R/ G/ B/ A" Display="'R/ G/ B/ A'" Dmx="216~223" Colour="255,255,255" />
      <Function ID="29" Name="G/ B/ W/ A" Display="'G/ B/ W/ A'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="30" Name="R/ G/ W/ A" Display="'R/ G/ W/ A'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="31" Name="Auto" Display="'Auto'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~9" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="10~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed1" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMSUN2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKCMSUN5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Speed1" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
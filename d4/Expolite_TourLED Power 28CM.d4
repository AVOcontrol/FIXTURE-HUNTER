<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TourLED Power 28 CM" ShortName="TourLED 28" Company="Expolite">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="23-04-12" Author="Sebastian Beutel" Comment="Created from Tourled 42 CM" />
  <History Date="24-04-12" Author="Peter Budd" Comment="Edited added zoom range." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="31-08-14" Author="Sebastian Beutel" Comment="Created from Tourled 37" />
  <History Date="01-09-14" Author="Nic Morris" Comment="Moved white attribute to fixed colour wheel slot for standardisation." />
  <History Date="01-09-14" Author="Nic Morris" Comment="Minor revision to mode names.  Added 'CM' to fixture name." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-12-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed colour macro fixed functions to a variable index range." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed macro speed locate to match associated condition." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="db341992-cc9a-4ccb-83f5-811825f49f50" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Macro'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Macro'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~20.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Red, Green, Macro_Speed" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="41~50" Update="Red, Green, Macro_Speed" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="51~60" Update="Red, Green, Macro_Speed" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="61~70" Update="Red, Green, Macro_Speed" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="71~80" Update="Red, Green, Macro_Speed" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="81~90" Update="Red, Green, Macro_Speed" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="91~100" Update="Red, Green, Macro_Speed" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="101~110" Update="Red, Green, Macro_Speed" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="111~120" Update="Red, Green, Macro_Speed" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="121~130" Update="Red, Green, Macro_Speed" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="131~140" Update="Red, Green, Macro_Speed" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="141~150" Update="Red, Green, Macro_Speed" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="151~160" Update="Red, Green, Macro_Speed" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="161~170" Update="Red, Green, Macro_Speed" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="171~180" Update="Red, Green, Macro_Speed" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="181~190" Update="Red, Green, Macro_Speed" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="191~200" Update="Red, Green, Macro_Speed" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="201~210" Update="Red, Green, Macro_Speed" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="211~220" Update="Red, Green, Macro_Speed" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="221~230" Update="Red, Green, Macro_Speed" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="231~255" Update="Red, Green, Macro_Speed" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="2" If="'Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Inactive" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Tour, 10 DMX" Channels="10">
    <Import PearlRef="EP_TL2810" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6c6b8cda-6a2b-4812-8d6d-c675c0805e4e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="38" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="37" />
      <Attribute ID="Macro" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Macro_Speed" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="10" Wheel="25" />
    </Include>
  </Mode>

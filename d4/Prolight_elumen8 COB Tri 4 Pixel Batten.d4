<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 COB Tri 4 Pixel Batten" ShortName="Tri 4 Pix" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="26-02-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="aaacc879-8c09-406e-a19c-fe1d6bca4c0a" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="40~47" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="48~55" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="56~63" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="64~71" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Red, Green, Col_Mac_Spd, Master_Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~239" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="PTE8T4P3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a0d13dbf-5b57-40f3-bc69-cd79d72c7632" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

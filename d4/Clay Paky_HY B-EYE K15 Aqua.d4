      <Function ID="44" Name="Syncopation" Display="'Syncopation'" Dmx="56~56" Update="Shape_Speed, Shape_Offset" />
      <Function ID="45" Name="Bumping 1" Display="'Bumping 1'" Dmx="57~57" Update="Shape_Speed, Shape_Offset" />
      <Function ID="46" Name="Bumping 2" Display="'Bumping 2'" Dmx="58~58" Update="Shape_Speed, Shape_Offset" />
      <Function ID="47" Name="Bumping 3" Display="'Bumping 3'" Dmx="59~59" Update="Shape_Speed, Shape_Offset" />
      <Function ID="48" Name="Vert Pix Scr" Display="'Vert Pix Scr'" Dmx="60~60" Update="Shape_Speed, Shape_Offset" />
      <Function ID="49" Name="Rand Vert Sect" Display="'Rand Vert Sect'" Dmx="61~61" Update="Shape_Speed, Shape_Offset" />
      <Function ID="50" Name="Rand Cent Sect" Display="'Rand Cent Sect'" Dmx="62~62" Update="Shape_Speed, Shape_Offset" />
      <Function ID="51" Name="Rand Ring 3" Display="'Rand Ring 3'" Dmx="63~63" Update="Shape_Speed, Shape_Offset" />
      <Function ID="52" Name="Rand Ring 2+4" Display="'Rand Ring 2+4'" Dmx="65~65" Update="Shape_Speed, Shape_Offset" />
      <Function ID="53" Name="Rand Ring 3+4" Display="'Rand Ring 3+4'" Dmx="66~66" Update="Shape_Speed, Shape_Offset" />
      <Function ID="54" Name="Sgl Pix R1" Display="'Sgl Pix R1'" Dmx="67~67" Update="Shape_Speed, Shape_Offset" />
      <Function ID="55" Name="Sgl Pix R2" Display="'Sgl Pix R2'" Dmx="68~68" Update="Shape_Speed, Shape_Offset" />
      <Function ID="56" Name="Spiral" Display="'Spiral'" Dmx="70~70" Update="Shape_Speed, Shape_Offset" />
      <Function ID="57" Name="Reserved" Display="'Reserved'" Dmx="71~255" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==11||'Shape'==12" />
      <Condition Name="Rainbow" ID="10,11,12,13" If="'Shape'==13||'Shape'==14" />
      <Condition Name="Speed" ID="14,15,16,17" If="'Shape'&gt;14&amp;&amp;'Shape'&lt;57" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="8" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="11" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="12" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="13" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
      <Function ID="14" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="15" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="17" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
    </Attribute>
    <Attribute ID="Shape_Fade" Name="Shape Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Snap" Display="'Snap'" Dmx="0~0" />
      <Function ID="2" Name="Gamma" Display="'Gamma %.f',1~229" Dmx="16~245" />
      <Function ID="3" Name="Auto Smooth" Display="'Auto Smooth'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Shape_Red" Name="Shape Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Shape_Green" Name="Shape Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Shape_Blue" Name="Shape Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shape_White" Name="Shape White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shape_Dimmer" Name="Shape Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Opening" ID="2,3" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Rand Pixel Var" ID="4" If="'Shape'==12" />
      <Condition Name="Rainbow 1" ID="5" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21" />
      <Condition Name="Distribution" ID="6" If="'Shape'==11||'Shape'==23||'Shape'==49||'Shape'==50||'Shape'==51||'Shape'==52||'Shape'==53" />
      <Condition Name="Width" ID="7" If="'Shape'==22||'Shape'==24||'Shape'==26||'Shape'==27||'Shape'==28||'Shape'==29||'Shape'==33||'Shape'==34||'Shape'==35||'Shape'==36||'Shape'==37||'Shape'==38||'Shape'==39||'Shape'==42||'Shape'==43||'Shape'==48||'Shape'==56" />
      <Condition Name="Offset" ID="8" If="'Shape'==25||'Shape'==30||'Shape'==31||'Shape'==32||'Shape'==40||'Shape'==41||'Shape'==44||'Shape'==45||'Shape'==46||'Shape'==47" />
      <Condition Name="Number" ID="9" If="'Shape'==54||'Shape'==55" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="3" Name="Random Flash" Display="'Random Flash %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="4" Name="Pixel Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Index" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="6" Name="Rand Dist" Display="'%.f',2~20" Dmx="0~255" />
      <Function ID="7" Name="Width" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="8" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="9" Name="LEDs" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FG_Strobe" Name="FG Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rand Slow" Display="'Rand Slow'" Dmx="213~225" Intensity="0~0" />
      <Function ID="5" Name="Rand Med" Display="'Rand Med'" Dmx="226~238" Intensity="0~0" />
      <Function ID="6" Name="Rand Fast" Display="'Rand Fast'" Dmx="239~251" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Strobe" Name="BG Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rand Slow" Display="'Rand Slow'" Dmx="213~225" Intensity="0~0" />
      <Function ID="5" Name="Rand Med" Display="'Rand Med'" Dmx="226~238" Intensity="0~0" />
      <Function ID="6" Name="Rand Fast" Display="'Rand Fast'" Dmx="239~251" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Select" Name="BG Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Wash Mode" Display="'Wash Mode'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Ring 1" Display="'Ring 1'" Dmx="9~9" WheelPosition="0" />
      <Function ID="3" Name="Ring 2" Display="'Ring 2'" Dmx="10~10" WheelPosition="0" />
      <Function ID="4" Name="Ring 3" Display="'Ring 3'" Dmx="11~11" WheelPosition="0" />
      <Function ID="5" Name="Ring 1+3" Display="'Ring 1+3'" Dmx="12~12" WheelPosition="0" />
      <Function ID="6" Name="Ring 1+2" Display="'Ring 1+2'" Dmx="13~13" WheelPosition="0" />
      <Function ID="7" Name="Ring 1+2+3" Display="'Ring 1+2+3'" Dmx="14~14" WheelPosition="0" />
      <Function ID="8" Name="Ring 2+3" Display="'Ring 2+3'" Dmx="15~15" WheelPosition="0" />
      <Function ID="9" Name="No Selection" Display="'No Selection'" Dmx="16~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

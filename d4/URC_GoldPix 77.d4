    <Attribute ID="Alpha" Name="Alpha" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Gobo1Rot" />
      <Function ID="2" Name="Numeric" Display="'Numeric %.1f%%',0.0~100.0" Dmx="1~127" Update="Gobo1Rot" />
      <Function ID="3" Name="Alpha" Display="'Alpha %.1f%%',0.0~100.0" Dmx="128~255" Update="Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" />
      <Function ID="2" Name="Cross" Display="'Cross'" Dmx="11~20" />
      <Function ID="3" Name="Box" Display="'Box'" Dmx="21~29" />
      <Function ID="4" Name="Sq Implode" Display="'Sq Implode'" Dmx="30~38" />
      <Function ID="5" Name="Sq Explode" Display="'Sq Explode'" Dmx="39~47" />
      <Function ID="6" Name="Dmd Implode" Display="'Dmd Implode'" Dmx="48~56" />
      <Function ID="7" Name="Dmd Explode" Display="'Dmd Explode'" Dmx="57~65" />
      <Function ID="8" Name="2 Line Spin" Display="'2 Line Spin'" Dmx="66~74" />
      <Function ID="9" Name="Tri Spin" Display="'Tri Spin'" Dmx="75~83" />
      <Function ID="10" Name="Tri-Down" Display="'Tri-Down'" Dmx="84~92" />
      <Function ID="11" Name="Tri-Up" Display="'Tri-Up'" Dmx="93~101" />
      <Function ID="12" Name="Bowtie" Display="'Bowtie'" Dmx="102~110" />
      <Function ID="13" Name="One-Line" Display="'One-Line'" Dmx="111~119" />
      <Function ID="14" Name="Hop Up" Display="'Hop Up'" Dmx="120~128" />
      <Function ID="15" Name="Hop Down" Display="'Hop Down'" Dmx="129~137" />
      <Function ID="16" Name="Hop Up/Dn" Display="'Hop Up/Dn'" Dmx="138~146" />
      <Function ID="17" Name="T-Spin" Display="'T-Spin'" Dmx="147~155" />
      <Function ID="18" Name="Inv T-Spin" Display="'Inv T-Spin'" Dmx="156~164" />
      <Function ID="19" Name="Dmd Spin" Display="'Dmd Spin'" Dmx="165~173" />
      <Function ID="20" Name="Hop Left" Display="'Hop Left'" Dmx="174~182" />
      <Function ID="21" Name="Hop Right" Display="'Hop Right'" Dmx="183~191" />
      <Function ID="22" Name="Hop LR" Display="'Hop LR'" Dmx="192~200" />
      <Function ID="23" Name="Double Vert" Display="'Double Vert'" Dmx="201~209" />
      <Function ID="24" Name="Double Horiz" Display="'Double Horiz'" Dmx="210~218" />
      <Function ID="25" Name="Diag Right" Display="'Diag Right'" Dmx="219~227" />
      <Function ID="26" Name="Reset" Display="'Reset'" Dmx="228~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Alpha" ID="6,7,8,9" If="'Alpha'&gt;1" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~100" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="101~149" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="150~202" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="203~255" />
      <Function ID="6" Name="0 Degree" Display="'0 Degree'" Dmx="0~63" />
      <Function ID="7" Name="90 Degree" Display="'90 Degree'" Dmx="64~127" />
      <Function ID="8" Name="180 Degree" Display="'180 Degree'" Dmx="128~191" />
      <Function ID="9" Name="270 Degree" Display="'270 Degree'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKUGP5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="26" />
      <Attribute ID="Dim_Mode" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="af14fb8b-ad56-401c-ba63-27e8b9589775" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="128~139" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~16" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~32" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="48~48" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~64" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="80~80" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="96~96" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="112~112" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="0~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="16~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="32~47" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="48~63" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="64~79" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="80~95" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="96~111" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="112~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="19" Name="Yel - Mag" Display="'Yel - Mag %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="255,255,0" />
      <Function ID="20" Name="Mag - Grn" Display="'Mag - Grn %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="255,0,255" />
      <Function ID="21" Name="Grn - Blu" Display="'Grn - Blu %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="0,255,0" />
      <Function ID="22" Name="Blu - Org" Display="'Blu - Org %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="0,0,255" />
      <Function ID="23" Name="Org - Pk" Display="'Org - Pk %.f%%',0~100" Dmx="96~112" WheelPosition="6" Colour="255,128,0" />
      <Function ID="24" Name="Pk - Op" Display="'Pk - Op %.f%%',0~100" Dmx="112~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="25" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="27" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="255~128" Colour="0,0,0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="5~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1Rot, Gobo1, Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1Rot, Gobo1, Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1Rot, Gobo1, Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1Rot, Gobo1, Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1Rot, Gobo1, Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="7,8" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6d7f9719-6d29-40ac-8a2a-200929894bb7</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ca1eb374-9ae5-4eb8-b6d2-1973367cfc64</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>69274f18-4a11-4675-86f6-0f253a5104b7</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>d18b1847-600a-4d59-b55c-fbfb25315064</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>a4a089bf-9c44-448f-be09-91ec8eaeb01f</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~223" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>4b087ab6-f28a-4fa8-8b84-6ebbe2737698</Swatch>
      </Function>
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="224~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~60" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="61~158" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="159~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour" Display="'Colour'" Dmx="0~0" Update="ColGobo, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo" Display="'Gobo'" Dmx="0~0" Update="ColGobo, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="ColGobo, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour" ID="1,2,3,4" If="'Gobo1Func'==1" />
      <Condition Name="Gobo" ID="5,6,7,8" If="'Gobo1Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6d7f9719-6d29-40ac-8a2a-200929894bb7</Swatch>
      </Function>
      <Function ID="2" Name="Light Orange" Display="'Light Orange'" Dmx="148~184" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pale Purple" Display="'Pale Purple'" Dmx="185~221" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="222~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6d7f9719-6d29-40ac-8a2a-200929894bb7</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 1" Display="'Gobo 1'" Dmx="37~73" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>1a423126-65d5-49fc-9d74-fc15f43d8ce4</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 2" Display="'Gobo 2'" Dmx="74~110" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>dd41320f-ebca-43b7-9ff0-a0f1fe1bdf2c</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 3" Display="'Gobo 3'" Dmx="111~147" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>74b268dc-db29-4891-977f-14ea4b870d53</Swatch>
      </Function>
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="15° AutoFocus Off" Display="'15° AutoFocus Off'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="18° AutoFocus Off" Display="'18° AutoFocus Off'" Dmx="32~47" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="21° AutoFocus Off" Display="'21° AutoFocus Off'" Dmx="48~63" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="24° AutoFocus Off" Display="'24° AutoFocus Off'" Dmx="64~79" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="26° AutoFocus Off" Display="'26° AutoFocus Off'" Dmx="80~95" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Frost" Display="'Frost'" Dmx="96~111" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="UV Filter" Display="'UV Filter'" Dmx="112~127" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="15° AutoFocus On" Display="'15° AutoFocus On'" Dmx="128~159" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="18° AutoFocus On" Display="'18° AutoFocus On'" Dmx="160~175" Iris="0~0" Zoom="0~0" />
      <Function ID="10" Name="21° AutoFocus On" Display="'21° AutoFocus On'" Dmx="176~191" Iris="0~0" Zoom="0~0" />
      <Function ID="11" Name="24° AutoFocus On" Display="'24° AutoFocus On'" Dmx="192~207" Iris="0~0" Zoom="0~0" />
      <Function ID="12" Name="26° AutoFocus On" Display="'26° AutoFocus On'" Dmx="208~223" Iris="0~0" Zoom="0~0" />
      <Function ID="13" Name="Frost" Display="'Frost'" Dmx="224~239" Iris="0~0" Zoom="0~0" />
      <Function ID="14" Name="UV Filter" Display="'UV Filter'" Dmx="240~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="SH_Ex250Pro" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="570" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1004bd58-0db1-4e8a-861e-3b90ce76fcd4" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="15" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="16" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="11" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="12" Wheel="18" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="13" Wheel="19" />
      <Attribute ID="Prism_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="22" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LEDBAR 320" ShortName="LEDBAR 320" Company="Pulse">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="28-06-14" Author="Nic Morris" Comment="Created" />
  <History Date="02-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="be4cc081-28d7-4740-b5ee-4e5b0d181eaf" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Update="Speed" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" Update="Speed" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" Update="Speed" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="32~39" Update="Speed" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="40~47" Update="Speed" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="48~55" Update="Speed" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="56~63" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="64~71" Update="Speed" Colour="255,255,255" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="72~79" Update="Speed" Colour="255,255,255" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="80~87" Update="Speed" Colour="255,255,255" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="88~95" Update="Speed" Colour="255,255,255" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="96~103" Update="Speed" Colour="255,255,255" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="104~111" Update="Speed" Colour="255,255,255" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="112~119" Update="Speed" Colour="255,255,255" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="120~127" Update="Speed" Colour="255,255,255" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="128~135" Update="Speed" Colour="255,255,255" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="136~143" Update="Speed" Colour="255,255,255" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="144~151" Update="Speed" Colour="255,255,255" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="152~159" Update="Speed" Colour="255,255,255" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="160~167" Update="Speed" Colour="255,255,255" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="168~175" Update="Speed" Colour="255,255,255" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="176~183" Update="Speed" Colour="255,255,255" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="184~191" Update="Speed" Colour="255,255,255" />
      <Function ID="25" Name="Program 17" Display="'Program 17'" Dmx="192~199" Update="Speed" Colour="255,255,255" />
      <Function ID="26" Name="Program 18" Display="'Program 18'" Dmx="200~207" Update="Speed" Colour="255,255,255" />
      <Function ID="27" Name="Program 19" Display="'Program 19'" Dmx="208~215" Update="Speed" Colour="255,255,255" />
      <Function ID="28" Name="Program 20" Display="'Program 20'" Dmx="216~223" Update="Speed" Colour="255,255,255" />
      <Function ID="29" Name="Program 21" Display="'Program 21'" Dmx="224~231" Update="Speed" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="232~255" Update="Speed" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sentivitiy" ID="2" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="3">
    <Import PearlRef="UKPLS321" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c9b4bbc2-16ab-4c90-848e-7ab2be618071" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>

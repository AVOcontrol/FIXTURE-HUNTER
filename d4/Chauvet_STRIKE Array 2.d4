    <AtlaBase ModeID="7a971a36-8c94-4789-93eb-72975978676e" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1,2" Wheel="4" />
        <Attribute ID="White" Wheel="10" />
        <Attribute ID="Amber" Wheel="11" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="WA cell" X="0" Y="0">
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="WA cell" X="0" Y="1">
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

  <History Date="18-10-23" Author="Nic Morris" Comment="Updated in line with latest charts (rev 3.  Adds 9 channel modes)" Version="2" />
  <History Date="19-10-23" Author="Nic Morris" Comment="Added Atlabase ID for 9 channel mode." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="26f40777-482f-452b-910a-8f2f849e6306" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~132" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="41~80" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="81~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5 %.f%%',0~100" Dmx="161~200" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6 %.f%%',0~100" Dmx="201~240" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd Linear" Display="'Dim Spd Linear'" Dmx="52~101" />
      <Function ID="3" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="102~152" />
      <Function ID="4" Name="Dim Spd Med" Display="'Dim Spd Med'" Dmx="153~203" />
      <Function ID="5" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9" Id="1aeb3809-6477-419e-bf87-34c7f7ed9dc8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

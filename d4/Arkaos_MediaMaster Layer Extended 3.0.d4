<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MediaMaster Layer Extended 3.0" ShortName="MM Ext 3.0" Company="Arkaos" Version="11">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="09-06-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="06-11-17" Author="Nic Morris" Comment="Revised hue and saturation ID's for compatibility." Version="2" />
  <History Date="22-01-19" Author="Nic Morris" Comment="Changed Visual Library Generators and Audio Flash functions to specific values and renamed Media Puzzle to Media Pause in response to customer bug report." Version="3" />
  <History Date="01-10-21" Author="Nic Morris" Comment="Updated in line with latest charts (adds 1:1 pixel mapping aspect ratio, various copy and loop modes)" Version="4" />
  <History Date="01-10-21" Author="Nic Morris" Comment="Created from Arkaos MediaMaster Layer Extended" Version="5" />
  <History Date="01-10-21" Author="Nic Morris" Comment="Created from Arkaos MediaMaster Layer Extended 1.1" Version="6" />
  <History Date="17-05-22" Author="Nic Morris" Comment="Created from Arkaos MediaMaster Layer Extended 2.0 (note BPM divisor functions are missing DMX ranges.  left as raw for now)" Version="7" />
  <History Date="17-05-22" Author="Nic Morris" Comment="Removed unnecessary file update from visual library (folder)." Version="9" />
  <History Date="17-05-22" Author="Nic Morris" Comment="Updated in line with latest charts (adds BPM divisor functions and revises PB @End defaults)" Version="10" />
  <History Date="23-05-22" Author="Nic Morris" Comment="Added NDI and Subtitles functions to Visual Library in response to customer query (not currently documented but confirmed by Arkaos)" Version="11" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Folder" Name="Visual Library" Description="" Group="G">

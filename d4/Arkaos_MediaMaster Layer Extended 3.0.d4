    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ingnore_Alpha" Name="Ingnore Alpha" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Transition" Name="Transition" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Cut" Display="'Cut'" Dmx="0~0" />
      <Function ID="2" Name="Crossfade" Display="'Crossfade'" Dmx="8~15" />
    </Attribute>
    <Attribute ID="Transition_Spd" Name="Transition Spd" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'%.1f Sec',0.0~6553.0" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~200.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Audio_Pan" Name="Audio Pan" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Left" Display="'Left'" Dmx="0~0" />
      <Function ID="2" Name="L-&gt;C" Display="'L-&gt;C %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="3" Name="Center" Display="'Center'" Dmx="128~128" />
      <Function ID="4" Name="C-&gt;R" Display="'C-&gt;R %.1f%%',0.0~100.0" Dmx="129~254" />
      <Function ID="5" Name="Right" Display="'Right'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Aspect_Ratio" Name="Aspect Ratio" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stretch" Display="'Stretch'" Dmx="0~0" />
      <Function ID="2" Name="Auto Detect" Display="'Auto Detect'" Dmx="32~63" />
      <Function ID="3" Name="4:3" Display="'4:3'" Dmx="64~95" />
      <Function ID="4" Name="16:9" Display="'16:9'" Dmx="96~127" />
      <Function ID="5" Name="16:10" Display="'16:10'" Dmx="128~159" />

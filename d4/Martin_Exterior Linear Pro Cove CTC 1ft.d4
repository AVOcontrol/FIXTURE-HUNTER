  <AtlaBase TypeID="b141651b-a8d3-4b1a-ac7e-d89f6e1fa07c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="2700K" Display="'2700K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2750-3950K" Display="'2750-3950K %.fK',2750~3950" Dmx="53~77" Colour="255,255,255" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="78~78" Colour="255,255,255" />
      <Function ID="4" Name="4050-6450K" Display="'4050-6450K %.fK',4050~6450" Dmx="79~127" Colour="255,255,255" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="2700K" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="White" Name="4000K" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="6500K" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

  <History Date="21-05-26" Author="Nic Morris" Comment="Created from LightSky Super Scope Color (identical except for minor difference in virtual col functions.  documentation is otherwise the same and comments above apply)" Version="3" />
  <History Date="05-06-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />

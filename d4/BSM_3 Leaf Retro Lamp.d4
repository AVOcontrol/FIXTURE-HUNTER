    <Attribute ID="RGB_Colour" Name="RGB Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~59" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="42~89" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="77~119" Colour="0,0,255" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green'" Dmx="113~149" Colour="0,0,0" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue'" Dmx="149~179" Colour="0,0,0" />
      <Function ID="7" Name="Green+Blue" Display="'Green+Blue'" Dmx="185~209" Colour="0,0,0" />
      <Function ID="8" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_Colour" Name="Beam Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~36" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~48" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="49~79" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~111" Colour="0,0,0" />
      <Function ID="6" Name="Red+Green" Display="'Red+Green'" Dmx="112~144" Colour="0,0,0" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="145~176" Colour="0,0,0" />
      <Function ID="8" Name="Green+Blue" Display="'Green+Blue'" Dmx="177~208" Colour="0,0,0" />
      <Function ID="9" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="209~240" Colour="0,0,0" />
      <Function ID="10" Name="Red+Green+Blue+White" Display="'Red+Green+Blue+White'" Dmx="241~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Golden_Master" Name="Golden Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_Master" Name="RGB Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />

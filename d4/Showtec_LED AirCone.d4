<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Air Cone" ShortName="LED  ACone" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="07-12-05" Author="Ed" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="17-01-13" Author="Peter Budd" Comment="Edited updated to include mode on latest specs" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Character" Name="Character" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~63" />
      <Function ID="2" Name="7 Col Mixing" Display="'7 Col Mixing'" Dmx="64~127" />
      <Function ID="3" Name="7 Col Change" Display="'7 Col Change'" Dmx="128~191" />
      <Function ID="4" Name="3 Col Change" Display="'3 Col Change'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="11~100" />
      <Function ID="3" Name="No Func" Display="'No Func'" Dmx="101~150" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour" Display="'Colour'" Dmx="0~31" Update="Shutter" />
      <Function ID="2" Name="Fade Out" Display="'Fade Out'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Fade In" Display="'Fade In'" Dmx="64~94" Update="Shutter" />
      <Function ID="4" Name="Out In" Display="'Out In'" Dmx="95~127" Update="Shutter" />
      <Function ID="5" Name="Auto Mix" Display="'Auto Mix'" Dmx="128~159" Update="Shutter" />
      <Function ID="6" Name="3 Colour" Display="'3 Colour'" Dmx="160~191" Update="Shutter" />
      <Function ID="7" Name="7 Colour" Display="'7 Colour'" Dmx="192~223" Update="Shutter" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.f%%',0~100" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour" ID="1,2" If="'Control1'==1" />
      <Condition Name="Fade Out" ID="3" If="'Control1'&gt;1" />
      <Else ID="4" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="SH_LEDACone" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Character" ChannelOffset="1" Wheel="30" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="SH_LEDACon6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Control1" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
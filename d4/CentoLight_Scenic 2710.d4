      <Function ID="2" Name="Red" Display="'Red'" Dmx="30~39" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~49" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="50~59" />
      <Function ID="5" Name="White" Display="'White'" Dmx="60~69" />
      <Function ID="6" Name="Red+Green" Display="'Red+Green'" Dmx="70~79" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="80~89" />
      <Function ID="8" Name="Green+Blue" Display="'Green+Blue'" Dmx="90~99" />
      <Function ID="9" Name="White" Display="'White'" Dmx="100~149" />
      <Function ID="10" Name="Pulse" Display="'Pulse'" Dmx="150~199" />
      <Function ID="11" Name="Jump" Display="'Jump'" Dmx="200~229" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

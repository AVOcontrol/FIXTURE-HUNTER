<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Krystal RGV (VDP2301RGVLD10)" ShortName="HQKrys RGV" Company="HQ Power">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="03-08-12" Author="Peter Budd" Comment="Created" />
  <History Date="21-08-12" Author="Peter Budd" Comment="Updated colour macro range" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~63" />
      <Function ID="2" Name="Auto no pattern" Display="'Auto no pattern'" Dmx="64~127" />
      <Function ID="3" Name="DMX" Display="'DMX'" Dmx="128~191" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~5" Colour="0,0,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="11~15" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="16~20" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="21~25" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="26~30" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="31~35" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="36~40" Colour="128,0,255" />
      <Function ID="9" Name="Single" Display="'Single'" Dmx="41~110" Colour="0,0,0" />
      <Function ID="10" Name="Colour Auto" Display="'Colour Auto'" Dmx="111~180" Colour="0,0,0" />
      <Function ID="11" Name="Colour Move" Display="'Colour Move'" Dmx="181~251" Colour="0,0,0" />
      <Function ID="12" Name="Bounded Col" Display="'Bounded Col'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto-Down" Display="'Auto-Down %.1f%%',0.0~100.0" Dmx="128~191" />
      <Function ID="3" Name="Auto-Up" Display="'Auto-Up %.1f%%',0.0~100.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto-Right" Display="'Auto-Right %.1f%%',0.0~100.0" Dmx="128~191" />
      <Function ID="3" Name="Auto-Left" Display="'Auto-Left %.1f%%',0.0~100.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="TRoll" Name="Tilt Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Tilt Roll" Display="'Tilt Roll %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Auto Tilt" Display="'Auto Tilt %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="PRoll" Name="Pan Roll" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pan Roll" Display="'Pan Roll %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Auto Pan" Display="'Auto Pan %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Roll" Display="'Roll %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom Small" Display="'Zoom Small %.1f%%',0.0~100.0" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom Large" Display="'Zoom Large %.1f%%',100.0~0.0" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom Large" Display="'Zoom Large %.1f%%',100.0~0.0" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="HQ_2301RGVL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="TRoll" ChannelOffset="6" Wheel="29" />
      <Attribute ID="PRoll" ChannelOffset="7" Wheel="30" />
      <Attribute ID="Rotation" ChannelOffset="8" Wheel="15" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
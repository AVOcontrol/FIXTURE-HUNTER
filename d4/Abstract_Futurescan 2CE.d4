<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Futurescan 2CE" ShortName="FutScn 2CE" Company="Abstract">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="19-09-97" Author="S. Anwar" Comment="Revised for Sapphire 96" />
  <History Date="15-01-98" Author="P.Bari" Comment="Revised attributes" />
  <History Date="14-05-12" Author="Pers Creator" Comment="Imported from Pearl Personality: ABFUT1CE.R20 and updated." />
  <History Date="19-03-14" Author="Nic Morris" Comment="Created from Abstract Futurescan 1CE" />
  <History Date="10-04-14" Author="Nic Morris" Comment="Changed shutter to gobo and updated ranges in response to customer bug report." />
  <History Date="12-05-17" Author="Nicholas Fryman" Comment="Fixed colour ranges and names. Fixed gobo names." />
  <History Date="15-05-17" Author="Nic Morris" Comment="Confirmed changes with Tim Mitchell (original designer).  Minor adjustment to colour function order." />
  <History Date="15-05-17" Author="Nic Morris" Comment="Added raw options to colour and gobo." />
  <History Date="16-05-17" Author="Nic Morris" Comment="Revised shortname (removed AB)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" Highlight="6" Lowlight="4" />
      <Function ID="1" Name="Close" Display="'Close'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="26~26" Colour="255,0,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="43~43" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="59~59" Colour="0,255,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="75~75" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="91~91" Colour="0,255,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="108~108" Colour="255,128,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="124~124" Colour="255,0,255" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="140~140" Colour="255,0,255" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="173~173" Colour="0,255,255" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="156~156" Colour="255,128,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="189~189" Colour="255,255,0" />
      <Function ID="14" Name="Blue" Display="'Blue'" Dmx="221~221" Colour="0,0,255" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="238~238" Colour="255,0,0" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Gobo" Description="" Group="G">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="24~24" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Dot Tunnel" Display="'Dot Tunnel'" Dmx="40~40" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Slash" Display="'Slash'" Dmx="56~56" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Segment" Display="'Segment'" Dmx="72~72" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Triangle" Display="'Triangle'" Dmx="88~88" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Tunnel" Display="'Tunnel'" Dmx="104~104" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Bubbles" Display="'Bubbles'" Dmx="120~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Stars" Display="'Stars'" Dmx="136~136" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Bubbles" Display="'Bubbles'" Dmx="152~152" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Tunnel" Display="'Tunnel'" Dmx="168~168" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Triangle" Display="'Triangle'" Dmx="184~184" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Segment" Display="'Segment'" Dmx="200~200" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Slash" Display="'Slash'" Dmx="216~216" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Slow Strobe" Display="'Slow Strobe'" Dmx="226~226" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Strobe 2" Display="'Strobe 2'" Dmx="230~230" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Strobe 3" Display="'Strobe 3'" Dmx="234~234" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Strobe 4" Display="'Strobe 4'" Dmx="238~238" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Strobe 5" Display="'Strobe 5'" Dmx="242~242" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Strobe 6" Display="'Strobe 6'" Dmx="246~246" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Strobe 7" Display="'Strobe 7'" Dmx="250~250" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Fast Strobe" Display="'Fast Strobe'" Dmx="254~254" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="AB_FUTRE2CE" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="A1/232 150W 15V" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="160" TiltMax="80" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="13" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
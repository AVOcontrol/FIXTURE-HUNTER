      <Function ID="2" Name="Small to Big" Display="'Small to Big %.1f%%',0.0~100.0" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Spot+Line" Name="Spot+Line" Description="" Group="E">

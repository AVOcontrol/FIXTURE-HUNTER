      <Function ID="2" Name="CCW Spin" Display="'CCW Spin %.f%%',0~100" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Small to Big" Display="'Small to Big %.f%%',0~100" Dmx="1~85" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Big to Small" Display="'Big to Small %.f%%',0~100" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="171~255" Iris="0~0" Zoom="0~0" />

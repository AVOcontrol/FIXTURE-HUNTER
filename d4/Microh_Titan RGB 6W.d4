      <Function ID="2" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Horizontal" Description="" Group="P">

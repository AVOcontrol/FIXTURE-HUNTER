      <Function ID="2" Name="Right-Left" Display="'Right-Left %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Left-Right" Display="'Left-Right %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Vertical_Rot" Name="Vertical Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

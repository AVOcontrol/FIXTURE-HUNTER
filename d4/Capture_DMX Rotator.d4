<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DMX Rotator" ShortName="Rotator" Company="Capture" Version="3">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="02-03-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="01-04-11" Author="John Rogers" Comment="Edited in response to Vangelis." Version="2" />
  <History Date="08-03-21" Author="Nic Morris" Comment="Changed name from Alpha Rotator to DMX Rotator and added missing modes." Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Alpha" Name="Alpha" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Alpha" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~2559" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',0.00~100.00" Dmx="65535~34304" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="33792~34303" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33791~2560" />
    </Attribute>
  </Control>
  <Mode Name="Alpha (16-bit), 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Alpha" ChannelOffset="1,2" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Alpha (8-bit), 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Alpha" ChannelOffset="1" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Alpha+Speed (16-bit), 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Alpha" ChannelOffset="1,2" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="3,4" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="Alpha+Speed (8-bit), 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Alpha" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
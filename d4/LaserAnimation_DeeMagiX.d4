<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DeeMagiX" ShortName="DeeMagiX" Company="LaserAnimation" Version="2">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="29-04-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="01-05-25" Author="Nic Morris" Comment="Changed Aspect Ratio to default at 100% Y-Size in response to customer feedback.  Fixed missing DMX values in Grating 2." Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Grating 1 Func" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1Rot, Gobo1" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo1Rot, Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1Rot, Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Grating 1" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="5,6,7,8" If="'Gobo1Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Grid WT" Display="'Grid WT'" Dmx="64~95" WheelPosition="1" />
      <Function ID="3" Name="Machado" Display="'Machado'" Dmx="96~127" WheelPosition="2" />
      <Function ID="4" Name="Stargate" Display="'Stargate'" Dmx="128~159" WheelPosition="3" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="6" Name="Grid WT" Display="'Grid WT'" Dmx="160~191" WheelPosition="1" />
      <Function ID="7" Name="Machado" Display="'Machado'" Dmx="192~223" WheelPosition="2" />
      <Function ID="8" Name="Stargate" Display="'Stargate'" Dmx="224~255" WheelPosition="3" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Grating 1 Rot" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Grating 2 Func" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2Rot, Gobo2" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo2Rot, Gobo2" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2Rot, Gobo2" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Grating 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="5,6,7,8" If="'Gobo2Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Grid XT" Display="'Grid XT'" Dmx="64~95" WheelPosition="1" />
      <Function ID="3" Name="Line" Display="'Line'" Dmx="96~127" WheelPosition="2" />
      <Function ID="4" Name="Lumia" Display="'Lumia'" Dmx="128~159" WheelPosition="3" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="6" Name="Grid XT" Display="'Grid XT'" Dmx="160~191" WheelPosition="1" />
      <Function ID="7" Name="Line" Display="'Line'" Dmx="192~223" WheelPosition="2" />
      <Function ID="8" Name="Lumia" Display="'Lumia'" Dmx="224~255" WheelPosition="3" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Grating 2 Rot" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="127~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'Intensity %.1f%%',0.0~100.0" Dmx="0~185" />
      <Function ID="2" Name="Fade to White (Bleaching Cols)" Display="'Fade to White (Bleaching Cols) %.f%%',0~100" Dmx="186~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~127" />
    </Attribute>
    <Attribute ID="Object_Bank" Name="Object Bank" Description="" Group="G">

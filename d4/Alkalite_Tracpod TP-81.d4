<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Tracpod TP-81" ShortName="TP-81" Company="Alkalite">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>2e205f69-b691-486a-b28b-de35295d9f09</Thumbnail>
  <History Date="16-08-04" Author="Phil" Comment="Created" />
  <History Date="17-08-04" Author="Tom" Comment="Checked" />
  <History Date="24-05-05" Author="Phil" Comment="Added mode with virtual Dimmer" />
  <History Date="21-06-05" Author="Phil" Comment="Changed shutter locate" />
  <History Date="11-04-06" Author="Ed Spencer" Comment="Renamed all shutters to strobes" />
  <History Date="22-06-06" Author="Ed" Comment="Fixed mode 4 and added mode 8, added virtual dimmer to all modes" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="27-01-09" Author="David Hunt" Comment="Removed Duplicate attribute" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Removed RGB update from Effect attributes." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Removed duplicate ID's.  Moved RGB functions into else condition.  Simplified and tidied RGB updates." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Added Colour attribute for single cell modes.  Adjusted mode 4 to use the correct attribute/ID's." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Fixed 48 DMX channel count by removing dimmer from mapping." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Added palettes.  Standardised RGB locate values.  Added pixel mapper compatibility." />
  <History Date="01-09-11" Author="Nic Morris" Comment="After much deliberation and searching removed mode 3 and completely reworked channel mapping." />
  <History Date="01-09-11" Author="Nic Morris" Comment="Adapted from Octopod OP-80" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="28-04-16" Author="Nic Morris" Comment="Added 3 DMX mode" />
  <History Date="19-01-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="19-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e9b917a2-2ddd-4469-ab66-e8d800f4206b" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Not RGB Col Mix" ID="2" If="'Colour'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="No Func" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Not RGB Col Mix" ID="2" If="'Colour'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="No Func" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Not RGB Col Mix" ID="2" If="'Colour'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Func" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="1~30" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="31~60" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="61~90" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="91~120" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="121~150" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="151~180" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="181~210" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="211~240" />
      <Function ID="10" Name="Sound-Active" Display="'Sound-Active'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Col Mix" Display="'RGB Col Mix'" Dmx="0~0" Update="Red1, Green1, Blue1" Colour="255,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.1f%%',100.0~0.0" Dmx="1~255" Update="Red1, Green1, Blue1" Colour="0,0,0" />
    </Attribute>

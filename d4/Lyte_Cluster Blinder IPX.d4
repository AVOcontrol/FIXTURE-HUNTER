  <History Date="24-06-22" Author="Nic Morris" Comment="Created (note some control ranges such as colour macro refer to documents that are not currently available)" Version="0" />
  <History Date="30-06-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="03-06-25" Author="Nic Morris" Comment="Created from ROXX Cluster B2 FC (poor documentation.  remarkably similar...)" Version="5" />
  <History Date="05-06-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="07-08-25" Author="Nic Morris" Comment="Created from Taurus Light LED Outdoor Blinder 600 (LOB600) (awful documentation.  contains inconsistencies.  identical except written in a way that is extremely difficult to read...)" Version="7" />
  <History Date="08-08-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="08-08-25" Author="Nic Morris" Comment="Created from FOS Brick 600 IP65 (L007786) (very poor documentation.  effectively idential.  charts contain inconsistencies and range conflicts)" Version="9" />
  <History Date="10-08-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="10" />
  <History Date="12-02-26" Author="Nic Morris" Comment="Created from Osten Terreo Blinder FC IP (identical.  contains range conflicts)" Version="11" />
  <History Date="17-02-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="12" />
  <History Date="25-02-26" Author="Nic Morris" Comment="Created from Pomelo B2 FC (effectively identical)" Version="13" />
  <History Date="03-06-26" Author="Nic Morris" Comment="Created from Gamma Led Vision Pulse Blinder 600 IP FC (charts contain errors.  effectively identical)" Version="15" />

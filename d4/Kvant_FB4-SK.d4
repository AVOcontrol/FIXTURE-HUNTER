    <Attribute ID="Cue_Speed" Name="Cue Speed" Description="" Group="G">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Scan_Rate1" Name="Scan Rate" Description="" Group="S">
      <Locate Locate="1:15" PowerOn="1:15" />
      <Function ID="1" Name="Rate" Display="'%.fK',5.0~30.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Alpha" Name="Alpha" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="3" Name="Orig-&gt;RGB" Display="'Orig-&gt;RGB %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Points_Start" Name="Points Start" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Visibility" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Points_End" Name="Points End" Description="" Group="G">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Visibility" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Z-Rot_Spd" Name="Z-Rot Spd" Description="" Group="B" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Angle Reset" Display="'Angle Reset'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32769~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32768~32768" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="1~32767" />
    </Attribute>
    <Attribute ID="Content" Name="Content" Description="" Group="G" Size="0">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="User" Display="'User'" Dmx="0~0" Update="Folder" />
      <Function ID="2" Name="Content Pack" Display="'Content Pack'" Dmx="0~0" Update="Folder" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FB4-SK" ShortName="FB4-SK" Company="Kvant" Version="34">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="07-02-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="08-06-17" Author="Peter Budd" Comment="Made the locate values output some light." Version="2" />
  <History Date="08-06-17" Author="Peter Budd" Comment="Created from Pangolin Laser Systems Flashback 3 SE" Version="3" />
  <History Date="08-10-18" Author="Nic Morris" Comment="Created from Pangolin Laser Systems Flashback 4 SE" Version="4" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Max Width and Max Height to default at 50% (49151) in response to manufacture request." Version="5" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Cue Speed to default at DMX 100 in response to manufacturer request." Version="6" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Fixed cue display ranges (were variable value 1-48, chaned to fixed text only)" Version="7" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed scan rate (1) to default at 15 (DMX 102) in response to manufacturer request (might need to change display type to achieve DMX 100)." Version="8" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Revised Z-Rot Spd functions in response to manufacturer request." Version="9" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Changed Points End to default at DMX 255 in response to manufacturer request." Version="10" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Added Alpha control at DMX 255 to all colour palettes in response to manufacturer request." Version="11" />
  <History Date="09-07-19" Author="Nic Morris" Comment="Created from Pangolin Laser Systems FB4" Version="12" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Added multi-part patch options." Version="13" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Revised size, pos and points start/end locate values in response to manufacturer request." Version="14" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Changed Page and Cue index attribute IDs to Folder and File respectively for compatibility." Version="15" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Appended (100%) to Original cue speed function name in response to manufacturer request." Version="16" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Added discreet page and cue functions.  Moved cue speed into gobo attribute group and bank." Version="17" />
  <History Date="03-02-20" Author="Nic Morris" Comment="Moved page and cue to gobo wheel bank 1 and points start/end to gobo wheel bank 2.  Inverted position display ranges." Version="18" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Tested against fixture with manufacturer.  Fixed channel mapping error (points start/end and shutter were muddled)" Version="19" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Changed cue speed 0 function name to Static.  Inverted points DMX range." Version="20" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Reverted x and y pos locate to 50%.  Changed max horiz and vert to locate at 0%." Version="21" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Revised multi-part patch options moving mode into setup and blinder into a cell in playback." Version="22" />
  <History Date="04-02-20" Author="Nic Morris" Comment="Added discreet functions to test frames.  Moved test frames to gobo group and wheel slot." Version="23" />
  <History Date="09-03-20" Author="Nic Morris" Comment="Added content switch (note no Raw DMX function as Media Selection page doesn't display the associated functions properly).  Added content pack pages with associated cue conditions and functions." Version="31" />
  <History Date="09-03-20" Author="Nic Morris" Comment="Added content pack thumbnails.  Added test frame thumbnails.  Fixed wheel mapping conflict." Version="31" />
  <History Date="10-03-20" Author="Nic Morris" Comment="Created from Kvant Burstberry" Version="33" />
  <History Date="11-03-20" Author="Nic Morris" Comment="Unhid modes." Version="34" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X-Size" Name="X-Size" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y-Size" Name="Y-Size" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Z-Angle" Name="Z-Angle" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.2f°',0.00~359.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Pos" Display="'%.2f%%',100.00~0.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Pos" Display="'%.2f%%',100.00~0.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Setup" Display="'Setup'" Dmx="240~240" />
      <Function ID="3" Name="Playback" Display="'Playback'" Dmx="251~251" />
    </Attribute>
    <Attribute ID="Max_Intensity" Name="Max Intensity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Max Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Test_Frames" Name="Test Frames" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="001" Display="'001'" Dmx="1~1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ff85a38f-fcbc-40f4-98ee-5347b6017f82</Swatch>
      </Function>
      <Function ID="3" Name="002" Display="'002'" Dmx="2~2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ff44f93e-6fbc-43ae-b553-d8b79f564969</Swatch>
      </Function>
      <Function ID="4" Name="003" Display="'003'" Dmx="3~3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>72335010-6d31-454b-86a3-6d6ab6541746</Swatch>
      </Function>
      <Function ID="5" Name="004" Display="'004'" Dmx="4~4" GoboSpin="0~0" GoboOrientation="0~0">

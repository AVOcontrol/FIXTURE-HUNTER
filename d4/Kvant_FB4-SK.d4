      </Function>
      <Function ID="9" Name="008" Display="'008'" Dmx="8~8" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>89709da2-fadf-4287-bcc7-5ca6adc48e5b</Swatch>
      </Function>
      <Function ID="10" Name="009" Display="'009'" Dmx="9~9" GoboSpin="0~0" GoboOrientation="0~0">

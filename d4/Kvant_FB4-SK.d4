      </Function>
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Max_Width" Name="Max Width" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size X" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Max_Height" Name="Max Height" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size Y" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Max_Horiz" Name="Max Horiz" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pos X" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Max_Vert" Name="Max Vert" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pos Y" Display="'%.2f%%',-100.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Max_Angle" Name="Max Angle" Description="" Group="B" Size="2">
      <Locate Locate="1:360" PowerOn="1:360" />
      <Function ID="1" Name="Rot Z" Display="'%.2f°',0.00~360.00" Dmx="0~65535" />
    </Attribute>

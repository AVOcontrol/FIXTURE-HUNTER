      <Function ID="6" Name="Pattern 6" Display="'Pattern 6'" Dmx="160~191" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Pattern 7" Display="'Pattern 7'" Dmx="192~233" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />

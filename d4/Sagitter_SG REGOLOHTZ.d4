      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="Aura Part" Channels="6" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />

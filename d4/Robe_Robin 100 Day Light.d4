<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin 100 Day Light" ShortName="R100 DayLt" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="08-06-11" Author="John Rogers" Comment="Created from Robe_Robin 600E Wash.d4" />
  <History Date="28-07-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Removed shutter update from colour macros." />
  <History Date="28-07-11" Author="Nic Morris" Comment="Increased wheel resolution.  Added pixel mapper compatibility." />
  <History Date="28-07-11" Author="Nic Morris" Comment="Shortened names for Expert LCD" />
  <History Date="30-08-11" Author="Nic Morris" Comment="Removed dimmer attribute link from modes 1 and 5 cells." />
  <History Date="07-11-11" Author="John Rogers" Comment="Removed Virtual Dimmer from Cells." />
  <History Date="07-12-11" Author="John Rogers" Comment="Edited Colour Macro Zone Effects to Value range." />
  <History Date="17-02-12" Author="Peter Budd" Comment="Created from Robe Robin 300 LED Wash" />
  <History Date="16-04-12" Author="Peter Budd" Comment="Edited updated the P/T Speed ranges" />
  <History Date="24-04-12" Author="Peter Budd" Comment="Edited updated control and added macros. Added mode 6." />
  <History Date="07-08-12" Author="Peter Budd" Comment="Updated macros and physical timings." />
  <History Date="15-08-12" Author="Peter Budd" Comment="Created from Robe Robin 100 LEDBeam" />
  <History Date="15-08-12" Author="Peter Budd" Comment="Created from Robe Robin 100 LEDBeam Smart White" />
  <History Date="15-08-12" Author="Peter Budd" Comment="Created from Robe Robin 100 Warm White" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="21075" ModelID="104" />
  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~49" />
      <Function ID="2" Name="P/T Speed Mode" Display="'P/T Speed Mode'" Dmx="50~59" />
      <Function ID="3" Name="P/T Time Mode" Display="'P/T Time Mode'" Dmx="60~69" />
      <Function ID="4" Name="BO on P/T" Display="'BO on P/T'" Dmx="70~79" />
      <Function ID="5" Name="Disable BO P/T" Display="'Disable BO P/T'" Dmx="80~89" />
      <Function ID="6" Name="Tilt Reduce On" Display="'Tilt Reduce On'" Dmx="120~124" />
      <Function ID="7" Name="Tilt Reduce Off" Display="'Tilt Reduce Off'" Dmx="125~129" />
      <Function ID="8" Name="Reset_PT" Display="'Reset PT'" Dmx="140~149" />
      <Function ID="9" Name="Reset_All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="10" Name="Reserved" Display="'Reserved %.f',90~119" Dmx="90~119" />
      <Function ID="11" Name="Reserved" Display="'Reserved %.f',150~199" Dmx="150~199" />
      <Function ID="12" Name="Reserved" Display="'Reserved %.f',210~255" Dmx="210~255" />
    </Attribute>
    <Attribute ID="ColourMacros" Name="Colour Macros" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="LED On" Display="'LED On'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="Effect 1" Display="'Effect 1'" Dmx="16~23" Colour="255,255,255" />
      <Function ID="4" Name="Effect 2" Display="'Effect 2'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="Effect 3" Display="'Effect 3'" Dmx="32~39" Colour="255,255,255" />
      <Function ID="6" Name="Effect 4" Display="'Effect 4'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="Effect 5" Display="'Effect 5'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="Effect 6" Display="'Effect 6'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="Effect 7" Display="'Effect 7'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="Effect 8" Display="'Effect 8'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="Effect 9" Display="'Effect 9'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="Effect 10" Display="'Effect 10'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="Effect 11" Display="'Effect 11'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="Effect 12" Display="'Effect 12'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="Effect 13" Display="'Effect 13'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="Reserved" Display="'Reserved'" Dmx="120~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
      <Function ID="3" Name="Z3 Strobe %" Display="'Zone 3 Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="5" Name="Zone FX Fwd" Display="'Zone FX Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="6" Name="Zone FX Rev" Display="'Zone FX Rev %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="8" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
      <Function ID="9" Name="Rnd Zone Strb" Display="'Rnd Zone Strb %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="10" Name="Rnd Zone Strb" Display="'Rnd Zone Strb %.f%%',100~0" Dmx="176~191" Intensity="0~0" />
      <Function ID="11" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White1" Name="White 1" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White2" Name="White 2" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White3" Name="White 3" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

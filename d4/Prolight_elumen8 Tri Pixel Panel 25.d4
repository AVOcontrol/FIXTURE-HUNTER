<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 Tri Pixel Panel 25" ShortName="Tri Pix 25" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-03-14" Author="Nic Morris" Comment="Created" />
  <History Date="12-06-17" Author="Nic Morris" Comment="Separated 25 channel mode into warm and cold white versions.  Added Atlabase ID's." />
  <History Date="12-06-17" Author="Nic Morris" Comment="Added vdim to 76 and 78 channel mode cells." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6a6551ae-8e15-4eeb-a3b6-b271c33d5331" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="40~47" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="48~55" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="56~63" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="64~71" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Master_Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Pattern_Rot" Name="Pattern Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~149" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="150~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Sel" Name="Pattern Sel" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Letters" Display="'Letters %.f%%',0~100" Dmx="0~99" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Numbers" Display="'Numbers %.f%%',0~100" Dmx="100~199" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Patterns" Display="'Patterns %.f%%',0~100" Dmx="200~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Colour" Name="Pattern Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="26~50" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="51~75" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="76~100" Colour="255,255,0" />
      <Function ID="5" Name="Pink" Display="'Pink'" Dmx="101~125" Colour="255,150,150" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="126~150" Colour="128,0,255" />
      <Function ID="7" Name="Cool White" Display="'Cool White'" Dmx="151~175" Colour="230,230,255" />
      <Function ID="8" Name="Warm White" Display="'Warm White'" Dmx="176~200" Colour="255,240,200" />
      <Function ID="9" Name="Colour Fade" Display="'Colour Fade %.f%%',0~100" Dmx="201~225" Colour="255,255,255" />
      <Function ID="10" Name="Colour Change" Display="'Colour Change %.f%%',0~100" Dmx="226~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:2" Delay="3000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="4000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>

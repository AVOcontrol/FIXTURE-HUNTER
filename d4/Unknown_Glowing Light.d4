  <Thumbnail>e7d2a04e-0321-4e1e-80c7-3e661d657d3a</Thumbnail>
  <History Date="13-02-26" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Function_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select %.f%%',0~100" Dmx="51~100" Update="Function_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="101~150" Update="Function_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="151~200" Update="Function_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="201~250" Update="Function_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Function_Spd" />
    </Attribute>
    <Attribute ID="Function_Spd" Name="Function Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Function'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_FX" Name="Ring FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Monochrome 1" Display="'Monochrome 1'" Dmx="4~10" />
      <Function ID="3" Name="Monochrome 2" Display="'Monochrome 2'" Dmx="11~20" />
      <Function ID="4" Name="Monochrome 3" Display="'Monochrome 3'" Dmx="21~30" />
      <Function ID="5" Name="Monochrome 4" Display="'Monochrome 4'" Dmx="31~40" />
      <Function ID="6" Name="Monochrome 5" Display="'Monochrome 5'" Dmx="41~50" />
      <Function ID="7" Name="Monochrome 6" Display="'Monochrome 6'" Dmx="51~60" />
      <Function ID="8" Name="Function 1" Display="'Function 1'" Dmx="61~80" />
      <Function ID="9" Name="Function 2" Display="'Function 2'" Dmx="81~100" />
      <Function ID="10" Name="Function 3" Display="'Function 3'" Dmx="101~150" />
      <Function ID="11" Name="Function 4" Display="'Function 4'" Dmx="151~200" />
      <Function ID="12" Name="Function 5" Display="'Function 5'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Ring_FX_Spd" Name="Ring FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10" Id="dd7517dd-1786-4f91-9e0e-20f06cefa6f4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Function" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Function_Spd" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Ring_FX" ChannelOffset="9" Wheel="52" />
      <Attribute ID="Ring_FX_Spd" ChannelOffset="10" Wheel="53" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Legend="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Legend="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Legend="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Legend="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Legend="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Legend="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Legend="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Legend="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Legend="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Legend="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>

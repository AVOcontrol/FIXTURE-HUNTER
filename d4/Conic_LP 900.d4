<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LP 900" ShortName="LP 900" Company="Conic" Version="26">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>156082df-0cf5-4a1c-b0f8-0453ba60be8e</Thumbnail>
  <History Date="27-03-19" Author="Nic Morris" Comment="Created (v0.9)" Version="1" />
  <History Date="30-08-19" Author="Nic Morris" Comment="Changed name from Espritt to Esprite and updated in line with v1.1 charts in response to manufacturer request (adds max intensity control and boost mode control functions and macros)" Version="2" />
  <History Date="13-11-19" Author="Nic Morris" Comment="Fixed colour CCW scroll DMX range.  Added product thumbnail.  Added gobo swatches." Version="3" />
  <History Date="12-12-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <History Date="10-08-20" Author="Nic Morris" Comment="Created from Robe Esprite" Version="5" />
  <History Date="17-08-20" Author="Nic Morris" Comment="Corrected CTO locate value in response to manufacturer request." Version="7" />
  <History Date="28-08-20" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request (removes combined frost function and adds green shift control)" Version="8" />
  <History Date="25-09-20" Author="Nic Morris" Comment="Updated in line with v1.3 charts in response to manufacturer request." Version="10" />
  <History Date="20-11-20" Author="Nic Morris" Comment="Updated in line with v1.5 charts (minor change to gobo scroll ranges)." Version="11" />
  <History Date="20-01-21" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches" Version="12" />
  <History Date="22-02-21" Author="Nic Morris" Comment="Updated in line with v1.6 charts in response to manufacturer request (adds quiet mode fan control functions and macros)" Version="13" />
  <History Date="22-02-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="24-03-21" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (removes control boost modes and macros)" Version="15" />
  <History Date="24-05-21" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds gobo indexing and revises quiet mode control functions and macros)" Version="16" />
  <History Date="16-08-21" Author="Nic Morris" Comment="Updated in line with v1.9 charts in response to manufacturer request (adds focus tracking control functions and macros)." Version="17" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Updated in line wtih v2.0 charts in response to manufacturer request (adds ultra square dim curve control function and macro)" Version="18" />
  <History Date="28-02-22" Author="Nic Morris" Comment="Revised CTO display range from 2700-6000 to 3000-6700K in line with v2.0 charts in response to manufacturer request." Version="19" />
  <History Date="23-09-22" Author="Nic Morris" Comment="Updated in line with v2.3 charts in response to manufacturer request (adds mode 2 and super quiet fan mode control function and macro)" Version="20" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="22" />
  <History Date="22-12-23" Author="Nic Morris" Comment="Added Atlabase ID for mode 2." Version="23" />
  <History Date="27-01-24" Author="Nic Morris" Comment="Created from Robe Robin FORTE (hopeless documentation. complete nonsense.  looks like an wholely incompetent copy including use of Robe mode names and references to Robe fixtures in the manual)" Version="24" />
  <History Date="02-02-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="26" />

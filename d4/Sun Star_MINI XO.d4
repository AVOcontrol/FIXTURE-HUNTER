  <History Date="28-11-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="460b50cf-4ef2-448a-a598-a4c1483c58b5" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="215~8" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~13" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="14~19" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="20~25" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Violet" Display="'Violet'" Dmx="26~31" WheelPosition="4" Colour="180,0,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="32~37" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="38~43" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="44~55" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Rd - Org" Display="'Rd - Org %.f%%',0~100" Dmx="56~67" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="Org - Grn" Display="'Org - Grn %.f%%',0~100" Dmx="68~79" WheelPosition="2" Colour="255,128,0" />
      <Function ID="11" Name="Grn - Vlt" Display="'Grn - Vlt %.f%%',0~100" Dmx="80~91" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="Vlt - Blu" Display="'Vlt - Blu %.f%%',0~100" Dmx="92~103" WheelPosition="4" Colour="180,0,255" />
      <Function ID="13" Name="Blu - Yel" Display="'Blu - Yel %.f%%',0~100" Dmx="104~115" WheelPosition="5" Colour="0,0,255" />
      <Function ID="14" Name="Yel - Op" Display="'Yel - Op %.f%%',0~100" Dmx="116~126" WheelPosition="6" Colour="255,255,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~255" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="127~191" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~13" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="14~19" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="20~25" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="26~31" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="32~37" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="38~43" WheelPosition="6" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="44~55" WheelPosition="1" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="56~67" WheelPosition="2" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="68~79" WheelPosition="3" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="80~91" WheelPosition="4" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="92~103" WheelPosition="5" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="104~115" WheelPosition="6" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="192~255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="116~191" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~21" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="22~36" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="37~51" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="52~66" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="67~81" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="82~96" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="97~111" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="112~126" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="127~141" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="142~156" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="157~171" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="172~186" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="187~201" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="202~216" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="217~231" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="232~255" />
    </Attribute>
  </Control>

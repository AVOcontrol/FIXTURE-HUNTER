      <Function ID="11" Name="Yellow" Display="'Yellow'" Dmx="106~112" WheelPosition="10" Colour="255,255,0" />
      <Function ID="12" Name="Pink" Display="'Pink'" Dmx="121~127" WheelPosition="11" Colour="255,150,150" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="16~22" WheelPosition="1" Colour="0,255,0" />
      <Function ID="15" Name="Rd/ Blu" Display="'Rd/ Blu'" Dmx="53~60" WheelPosition="5" Colour="255,0,0" />
      <Function ID="16" Name="L Grn/ Org" Display="'L Grn/ Org'" Dmx="83~90" WheelPosition="8" Colour="128,255,0" />

      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="60~68" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="69~76" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="77~85" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="86~93" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="94~102" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="103~110" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="111~119" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="120~127" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />

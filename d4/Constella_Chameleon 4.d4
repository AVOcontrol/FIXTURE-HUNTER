  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="8~119" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="120~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="136~247" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="248~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="23~23" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Slot 1" Display="'Slot 1'" Dmx="46~46" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Slot 2" Display="'Slot 2'" Dmx="69~69" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Slot 3" Display="'Slot 3'" Dmx="92~92" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Slot 4" Display="'Slot 4'" Dmx="115~115" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Slot 5" Display="'Slot 5'" Dmx="138~138" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Slot 6" Display="'Slot 6'" Dmx="161~161" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Slot 7" Display="'Slot 7'" Dmx="184~184" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Slot 8" Display="'Slot 8'" Dmx="207~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Slot 9" Display="'Slot 9'" Dmx="230~230" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Slot 10" Display="'Slot 10'" Dmx="253~253" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCNCHM4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Gobo1Rot" ChannelOffset="1" Wheel="15" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
    </Include>
  </Mode>
</Fixture>
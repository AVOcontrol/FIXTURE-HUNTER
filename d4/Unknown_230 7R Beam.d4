      <Function ID="17" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="16~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="26~30" WheelPosition="2" Colour="255,255,0" />
      <Function ID="19" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="36~40" WheelPosition="3" Colour="0,0,255" />

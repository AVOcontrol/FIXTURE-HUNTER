      <Function ID="22" Name="Wht/ Org" Display="'Wht/ Org'" Dmx="66~70" WheelPosition="6" Colour="255,255,255" />
      <Function ID="23" Name="Org/ Cy" Display="'Org/ Cy'" Dmx="76~80" WheelPosition="7" Colour="255,128,0" />
      <Function ID="24" Name="Cy/ L Grn" Display="'Cy/ L Grn'" Dmx="86~90" WheelPosition="8" Colour="0,255,255" />
      <Function ID="25" Name="L Grn/ W Yel" Display="'L Grn/ W Yel'" Dmx="96~100" WheelPosition="9" Colour="128,255,0" />

      <Function ID="28" Name="Pk/ UV" Display="'Pk/ UV'" Dmx="126~130" WheelPosition="12" Colour="255,150,150" />
      <Function ID="29" Name="UV/ W Org" Display="'UV/ W Org'" Dmx="136~140" WheelPosition="13" Colour="180,0,255" />
      <Function ID="30" Name="W Org/ Op" Display="'W Org/ Op'" Dmx="146~150" WheelPosition="14" Colour="255,128,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~151" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="206~255" Colour="0,0,0" />

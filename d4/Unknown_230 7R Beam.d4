      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="86~90" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="20" Name="Gobo Shake" Display="'Gobo Shake %.1f%%',0.0~100.0" Dmx="91~209" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="231~234" />
      <Function ID="22" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="210~230" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="231~234" />

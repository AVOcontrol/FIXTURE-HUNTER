      <Function ID="11" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="101~105" WheelPosition="10" Colour="255,255,0" />
      <Function ID="12" Name="Warm Blue" Display="'Warm Blue'" Dmx="111~115" WheelPosition="11" Colour="0,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="121~125" WheelPosition="12" Colour="255,150,150" />
      <Function ID="14" Name="UV" Display="'UV'" Dmx="131~135" WheelPosition="13" Colour="180,0,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Visage Hawk 900" ShortName="VHawk 900" Company="Batmink">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="08-07-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Astrolite to Unknown" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated fixture type from nothing to fixed" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated fixture type from nothing to fixed" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="14-06-13" Author="Peter Budd" Comment="Created from the Astrolite X-Torm 800." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll_Func" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="1,13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="32~47" Colour="0,128,255" />
      <Function ID="4" Name="Light Yellow" Display="'Yellow'" Dmx="48~63" Colour="255,255,128" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~79" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="80~95" Colour="0,0,255" />
      <Function ID="7" Name="Deep Yellow" Display="'Yellow'" Dmx="96~111" Colour="180,180,0" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="112~127" Colour="255,0,127" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="208~255" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~207" Intensity="0~0" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="0~15" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll_Func" ID="9,10,11,12" If="'Gobo1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~31" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="32~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="80~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func_Ind" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1" />
      <Condition Name="Scroll_Func_Ind" ID="9,10,11,12" If="'Gobo2Func'==2" />
      <Else ID="11,13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~31" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="32~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="80~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="96~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="86~170" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="171~178" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="1~85" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin Auto" Display="'Spin Auto %.f%%',0~100" Dmx="179~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="86~170" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="171~178" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="1~85" />
      <Function ID="5" Name="Spin Auto" Display="'Spin Auto %.f%%',0~100" Dmx="179~255" />
    </Attribute>
    <Attribute ID="GoboShake" Name="Gobo Shake" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="64~125" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="126~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="BM_VsHwk900" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="11" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="12" Wheel="18" />
      <Attribute ID="GoboShake" ChannelOffset="16" Wheel="46" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="13" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="14" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="15" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="GoboShake:4" Delay="7000" />
      <Set Channel="GoboShake:2" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Deep Yellow" Number="3" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="4" Name="Light Yellow" Number="4" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="5" Name="Deep Yellow" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="12" Name="Rose" Number="10" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="14" Name="Open" Number="8" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1,Gobo2:1,Gobo2Func:1" />
      <Palette ID="9" Name="Gobo 1" Number="19" Page="1" SetControl="Gobo2:2,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="10" Name="Gobo 2" Number="20" Page="1" SetControl="Gobo2:3,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="11" Name="Gobo 3" Number="0" Page="1" SetControl="Gobo2:4,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="12" Name="Gobo 4" Number="0" Page="1" SetControl="Gobo2:5,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="13" Name="Gobo 5" Number="0" Page="1" SetControl="Gobo2:6,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="14" Name="Gobo 6" Number="0" Page="1" SetControl="Gobo2:7,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
      <Palette ID="15" Name="Gobo 7" Number="0" Page="1" SetControl="Gobo2:8,Gobo2Func:1,Gobo1:1,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
      <Palette ID="7" Name="Frost Off" Number="47" Page="1" SetControl="Frost:1:0" />
      <Palette ID="8" Name="Frost Full" Number="48" Page="1" SetControl="Frost:1:100" />
    </Group>
  </Palettes>
</Fixture>
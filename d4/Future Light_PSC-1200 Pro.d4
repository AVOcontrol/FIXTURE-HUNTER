<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PSC-1200 Pro" ShortName="PSC12Pro" Company="Future Light">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="22-06-05" Author="Phil Rogers" Comment="Created" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="22-07-15" Author="Nic Morris" Comment="Changed physical type from fixed to moving head.  Inverted P/T speed wheel direction." />
  <History Date="22-07-15" Author="Nic Morris" Comment="Standardised conditionals.  Removed duplicate ID's and moved raw into else." />
  <History Date="22-07-15" Author="Nic Morris" Comment="Increased wheel resolution.  Added hilight/lolight.  Simplified prism.  Fixed shutter locate." />
  <History Date="22-07-15" Author="Nic Morris" Comment="Simplified control.  Added palettes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1dda648a-dc7b-4e30-bc8d-6edd09897274" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="225~15" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~14" />
      <Function ID="3" Name="B/O w P/T" Display="'B/O w P/T'" Dmx="226~235" />
      <Function ID="4" Name="B/O w Wheels" Display="'B/O w Wheels'" Dmx="236~245" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="14~27" Colour="0,128,255" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="28~41" Colour="255,150,150" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="42~55" Colour="0,0,255" />
      <Function ID="5" Name="Light Green" Display="'Light Green'" Dmx="56~69" Colour="128,255,0" />
      <Function ID="6" Name="Light Yellow" Display="'Yellow'" Dmx="70~83" Colour="255,255,128" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="84~97" Colour="255,0,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="98~111" Colour="255,128,0" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="112~127" Colour="128,0,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour2Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour2Func'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~27" Colour="255,0,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="28~41" Colour="0,128,255" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="42~55" Colour="255,150,150" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="56~69" Colour="255,255,0" />
      <Function ID="6" Name="CTO" Display="'CTO'" Dmx="70~83" Colour="255,240,200" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="84~97" Colour="230,230,255" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="98~111" Colour="180,0,255" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="112~127" Colour="0,255,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />

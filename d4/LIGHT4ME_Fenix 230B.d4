      <Function ID="22" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="75~79" WheelPosition="7" Colour="255,150,150" />
      <Function ID="23" Name="Yel/ D Blu" Display="'Yel/ D Blu'" Dmx="85~89" WheelPosition="8" Colour="255,255,0" />
      <Function ID="24" Name="D Blu/ CW" Display="'D Blu/ CW'" Dmx="95~99" WheelPosition="9" Colour="0,0,180" />
      <Function ID="25" Name="CW/ Blu" Display="'CW/ Blu'" Dmx="105~109" WheelPosition="10" Colour="230,230,255" />
      <Function ID="26" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="115~119" WheelPosition="11" Colour="0,0,255" />

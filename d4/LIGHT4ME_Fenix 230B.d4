      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="130~134" WheelPosition="13" Colour="255,240,200" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />

    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~28" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="29~45" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="46~62" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="63~79" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="80~96" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="97~113" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="114~130" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="131~147" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="148~164" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="165~181" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="182~198" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="199~215" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="216~232" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="233~250" Update="Auto_Spd" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2,3" If="'Auto'==16" />
      <Else ID="1" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

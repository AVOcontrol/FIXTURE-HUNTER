    <Attribute ID="HueTheatre1" Name="Hue" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0" Display="'0'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Hue" Display="'Hue %.1f°',-25.0~25.0" Dmx="1~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="HueTheatre2" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f°',-25.0~0.0" Dmx="0~126" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="0" Display="'0'" Dmx="127~127" WheelPosition="0" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f°',0.0~25.0" Dmx="128~255" WheelPosition="0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">

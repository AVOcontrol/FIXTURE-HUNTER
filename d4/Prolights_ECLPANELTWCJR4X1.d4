  <History Date="20-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-06-19" Author="Nic Morris" Comment="Updated to latest charts (completely different.  note pixel layout unavailable.  guessed).  Added product thumbnail." Version="2" />
  <History Date="03-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Changed name from ECLPANELTWC800 to ECLPANELTWC in response to manufacturer request." Version="4" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Revised CCT, Hue and Effect function ranges in line with latest charts in response to manufacturer request." Version="4" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Changed CTC to a single variable range and added an 'Open' range to the 10 and 15 channel 'Theatre' modes in response to manufacturer request." Version="5" />
  <History Date="26-04-21" Author="Nic Morris" Comment="Added Theatre, 21 DMX mode in line with latest charts in response to manufacturer request." Version="6" />
  <History Date="07-05-21" Author="Nic Morris" Comment="Revised Theatre, 21 DMX mode colour macro functions in response to manufacturer request." Version="8" />
  <History Date="01-07-21" Author="Nic Morris" Comment="Updated control functions and macros and added Film modes in line with latest charts in response to manufacturer request." Version="9" />
  <History Date="29-09-21" Author="Nic Morris" Comment="Updated control functions and macros and added XY mode in line with latest charts in response to manufacturer request." Version="10" />
  <History Date="01-10-21" Author="Nic Morris" Comment="Added Atlabase ID for XY mode." Version="11" />
  <History Date="12-01-22" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWC" Version="12" />
  <History Date="12-01-22" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWCM2X1 (identical)" Version="13" />
  <History Date="24-11-23" Author="Nic Morris" Comment="Added dim spd off and spektra cal control functions and macros in response to manufacturer request." Version="14" />

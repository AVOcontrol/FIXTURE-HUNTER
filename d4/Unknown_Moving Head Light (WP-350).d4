      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="120~185" Colour="0,0,0" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="186~189" Colour="0,0,0" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="190~255" Colour="0,0,0" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />

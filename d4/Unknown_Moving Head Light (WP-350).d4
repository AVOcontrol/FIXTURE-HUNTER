      <Function ID="20" Name="Amb/ Blu" Display="'Amb/ Blu'" Dmx="95~99" WheelPosition="7" Colour="255,100,0" />
      <Function ID="21" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="100~104" WheelPosition="8" Colour="0,0,255" />
      <Function ID="22" Name="Pk/ L Lav" Display="'Pk/ L Lav'" Dmx="105~109" WheelPosition="9" Colour="255,150,150" />
      <Function ID="23" Name="L Lav/ CTO" Display="'L Lav/ CTO'" Dmx="110~114" WheelPosition="10" Colour="255,128,255" />
      <Function ID="24" Name="CTO/ Op" Display="'CTO/ Op'" Dmx="115~119" WheelPosition="11" Colour="255,240,200" />

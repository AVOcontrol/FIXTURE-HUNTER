  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset Head">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Half Power">
      <Set Channel="Lamp:4" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Full Power">
      <Set Channel="Lamp:5" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>

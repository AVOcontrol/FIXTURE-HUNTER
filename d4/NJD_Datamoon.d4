<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Datamoon" ShortName="Datamoon" Company="NJD">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="24-04-13" Author="Peter Budd" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3ee940f6-2352-4985-9721-34fcf5bccc8c" />
  <Control>
    <Attribute ID="Pan" Name="Dish Rotate" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Rotate" Display="'Rotate %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Mg Squares" Display="'Mg Squares'" Dmx="0~31" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Yellow Tunnel" Display="'Yellow Tunnel'" Dmx="32~63" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Cyan Dots" Display="'Cyan Dots'" Dmx="64~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Pink Start" Display="'Pink Start'" Dmx="96~127" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Green Triangle" Display="'Green Triangle'" Dmx="128~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Red Segments" Display="'Red Segments'" Dmx="160~191" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Blue Spiral" Display="'Blue Spiral'" Dmx="192~223" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="White Circle" Display="'White Circle'" Dmx="224~255" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="2:100" PowerOn="3" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~223" Intensity="0~0" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="42ee4bb3-51c6-4a84-a1b3-54c0181fbb12" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Reserved" ChannelOffset="2" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position" />
    <Group Name="Shutter" />
  </Palettes>
</Fixture>
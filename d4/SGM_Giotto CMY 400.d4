  <History Date="13-01-05" Author="Phil" Comment="Changed colour wheel and renamed animation" Version="4" />
  <History Date="13-01-05" Author="Phil" Comment="Changed zoom locate value" Version="5" />
  <History Date="10-04-06" Author="Ed" Comment="Moved Macros into special group" Version="6" />

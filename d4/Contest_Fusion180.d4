      <Condition Name="Scroll" ID="21,22,23,24" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="4~7" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="8~11" WheelPosition="2" />

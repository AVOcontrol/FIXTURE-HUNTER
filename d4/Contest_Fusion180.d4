      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="76~90" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="91~105" WheelPosition="6" Colour="0,0,0" />

  <Thumbnail>20450a5b-0736-4286-b6a7-e19b560c1e7e</Thumbnail>
  <History Date="15-10-16" Author="Nic Morris" Comment="Created" />
  <History Date="05-02-20" Author="Nic Morris" Comment="Created from AFX Spider 9BeamFX" />
  <History Date="06-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4091a099-207f-4edb-9dec-e46b631245b3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="12 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="8~17" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="18~27" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="28~37" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="38~47" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="48~57" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="58~67" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="68~77" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="78~87" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="88~97" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="98~107" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="108~117" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="118~127" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="128~136" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="137~146" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="147~156" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="157~166" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="167~176" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="177~186" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="187~196" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="197~206" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="207~216" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="217~226" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="227~236" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="237~246" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Pan" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="360" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />

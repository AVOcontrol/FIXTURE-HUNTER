      <Attribute ID="Beam_Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Beam_Rate" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Beam_Effect" ChannelOffset="4" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Beam_Duration" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Beam_Rate" ChannelOffset="3" Wheel="4" />

  <Mode Name="Extended, 14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a293fb78-f451-4e43-9fe3-d63d7ca04345" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Beam_Duration" Wheel="5" />
        <Attribute ID="Beam_Rate" Wheel="4" />
        <Attribute ID="Beam_Effect" Wheel="22" />
        <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
        <Attribute ID="Effect" ChannelOffset="6" Wheel="23" />
        <Attribute ID="Effect_Spd" ChannelOffset="7" Wheel="24" />
        <Attribute ID="Reserved" ChannelOffset="8" Wheel="29" />
        <Attribute ID="Aura_Shutter" Wheel="6" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Aura_Colour" Wheel="8" />
      </Master>
      <Cell ID="Cell1" Name="Beam" ChannelOffset="1" ModeLink="Beam cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Beam_Duration" TargetId="Beam_Duration" />
        <AttributeLink SourceId="Beam_Rate" TargetId="Beam_Rate" />
        <AttributeLink SourceId="Beam_Effect" TargetId="Beam_Effect" />
      </Cell>
      <Cell ID="Cell2" Name="Aura" ChannelOffset="9" ModeLink="Aura cell" X="0" Y="1">
        <AttributeLink SourceId="Aura_Shutter" TargetId="Aura_Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Aura_Colour" TargetId="Aura_Colour" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Beam cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />

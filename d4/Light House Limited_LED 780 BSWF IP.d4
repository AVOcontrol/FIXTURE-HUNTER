  <History Date="10-02-18" Author="Nic Morris" Comment="Added gobo swatches" Version="4" />
  <History Date="25-02-19" Author="Nic Morris" Comment="Created from Ayrton Ghibli (note no gobo images or framing calibration details.  Assumed identical for now)" Version="5" />
  <History Date="30-03-20" Author="Nic Morris" Comment="Split for Capture.  Added Atlabase ID's." Version="6" />
  <History Date="19-07-21" Author="Nic Morris" Comment="Updated in line with v201 charts (revises existing fan and rate control function DMX ranges and adds constant fans and 25K control functions and macros)" Version="7" />

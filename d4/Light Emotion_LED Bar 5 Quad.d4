    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~20" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="21~41" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="3" Name="Fade Change" Display="'Fade Change'" Dmx="42~62" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="4" Name="Jump" Display="'Jump'" Dmx="63~83" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="5" Name="Dir Flow" Display="'Dir Flow'" Dmx="84~104" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="6" Name="Double Dir Flow" Display="'Double Dir Flow'" Dmx="105~125" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="7" Name="Dir+Dream 1" Display="'Dir+Dream 1'" Dmx="126~146" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="8" Name="Dir+Dream2" Display="'Dir+Dream2'" Dmx="147~167" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="9" Name="Flow 1" Display="'Flow 1'" Dmx="168~188" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="10" Name="Flow 2" Display="'Flow 2'" Dmx="189~209" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="11" Name="Double Flow" Display="'Double Flow'" Dmx="210~230" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="12" Name="Colour Mix" Display="'Colour Mix'" Dmx="231~251" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="13" Name="Auto" Display="'Auto'" Dmx="252~255" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>

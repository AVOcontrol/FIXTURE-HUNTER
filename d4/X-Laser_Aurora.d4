<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Aurora" ShortName="Aurora" Company="X-Laser">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="18-03-16" Author="Nic Morris" Comment="Created" />
  <History Date="17-05-18" Author="Nic Morris" Comment="Changed name from Aurora 4C-4G and merged in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="5" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto Mode" Display="'Auto Mode'" Dmx="50~100" />
      <Function ID="3" Name="Sound Active" Display="'Sound Active'" Dmx="101~150" />
      <Function ID="4" Name="Static Patterns" Display="'Static Patterns'" Dmx="151~200" />
      <Function ID="5" Name="Dynamic Patterns" Display="'Dynamic Patterns'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Rate" Name="Scan Rate" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="2~63" />
      <Function ID="3" Name="Animated" Display="'Animated %.f%%',0~100" Dmx="64~160" />
      <Function ID="4" Name="Static at Last" Display="'Static at Last'" Dmx="161~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="255~11" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mirror" Name="Mirror" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Mirror" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 9 DMX" Channels="9">
    <Import PearlRef="UKXLA4CG" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Colour1" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Mirror" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Scan_Rate" ChannelOffset="4" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="43f3df38-3634-473c-9414-edab867783f6" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="26~225" />
      <Function ID="4" Name="Macro" Display="'Macro'" Dmx="226~246" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CMY_Macro" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~35" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="36~54" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="55~73" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="74~92" Colour="0,255,255" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="93~110" Colour="128,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="111~128" Colour="255,0,255" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==3" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="16~23" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Dark Magenta" Display="'Dark Magenta'" Dmx="31~38" WheelPosition="2" Colour="180,0,180" />
      <Function ID="4" Name="Light Magenta" Display="'Light Magenta'" Dmx="46~53" WheelPosition="3" Colour="255,128,255" />
      <Function ID="5" Name="Light Yellow" Display="'Light Yellow'" Dmx="61~68" WheelPosition="4" Colour="255,255,128" />
      <Function ID="6" Name="Light Green" Display="'Light Green'" Dmx="76~83" WheelPosition="5" Colour="128,255,0" />
      <Function ID="7" Name="Dark Cyan" Display="'Dark Cyan'" Dmx="91~98" WheelPosition="6" Colour="0,180,180" />
      <Function ID="8" Name="Light Cyan" Display="'Light Cyan'" Dmx="106~113" WheelPosition="7" Colour="128,255,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="121~127" WheelPosition="8" Colour="255,255,255" />
      <Function ID="10" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="9~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="D Rd/ D Mag" Display="'D Rd/ D Mag'" Dmx="24~30" WheelPosition="1" Colour="180,0,0" />
      <Function ID="12" Name="D Mag/ L Mag" Display="'D Mag/ L Mag'" Dmx="39~45" WheelPosition="2" Colour="180,0,180" />
      <Function ID="13" Name="L Mag/ L Yel" Display="'L Mag/ L Yel'" Dmx="54~60" WheelPosition="3" Colour="255,128,255" />
      <Function ID="14" Name="L Yel/ L Grn" Display="'L Yel/ L Grn'" Dmx="69~75" WheelPosition="4" Colour="255,255,128" />
      <Function ID="15" Name="L Grn/ D Cy" Display="'L Grn/ D Cy'" Dmx="84~90" WheelPosition="5" Colour="128,255,0" />
      <Function ID="16" Name="D Cy/ L Cy" Display="'D Cy/ L Cy'" Dmx="99~105" WheelPosition="6" Colour="0,180,180" />
      <Function ID="17" Name="L Cy/ Op" Display="'L Cy/ Op'" Dmx="114~120" WheelPosition="7" Colour="128,255,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />

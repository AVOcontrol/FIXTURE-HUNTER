<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Solo 1200II Spot (PR-2950M)" ShortName="S1200II Sp" Company="Pearl River">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="09-10-08" Author="David Hunt" Comment="Created" />
  <History Date="31-10-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="03-09-12" Author="Peter Budd" Comment="Created from Pearl River XL-250" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~10" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="11~25" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="26~225" Intensity="0~0" />
      <Function ID="4" Name="Macro" Display="'Macro'" Dmx="226~246" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="247~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split Gel" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="25~32" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="41~48" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="57~64" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="73~80" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="89~96" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="105~112" Colour="0,0,0" />
      <Function ID="8" Name="Open/Col 1" Display="'Open/Col 1'" Dmx="17~24" Colour="255,255,255" />
      <Function ID="9" Name="Col 1/Col 2" Display="'Col 1/Col 2'" Dmx="33~40" Colour="0,0,0" />
      <Function ID="10" Name="Col 2 / Col 3" Display="'Col 2 / Col 3'" Dmx="49~56" Colour="0,0,0" />
      <Function ID="11" Name="Col 3 / Col 4" Display="'Col 3 / Col 4'" Dmx="65~72" Colour="0,0,0" />
      <Function ID="12" Name="Col 4/ Col5" Display="'Col 4/ Col5'" Dmx="81~88" Colour="0,0,0" />
      <Function ID="13" Name="Col 5/Col 6" Display="'Col 5/Col 6'" Dmx="97~104" Colour="0,0,0" />
      <Function ID="14" Name="Col 6/Open" Display="'Col 6/Open'" Dmx="113~120" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="121~127" Colour="255,255,255" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="121~127" Colour="255,255,255" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="0~34695" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="34952~42919" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="43176~51143" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="51400~59367" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="59624~60395" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Op/Cl" Display="'Op/Cl'" Dmx="60652~61423" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Cl/Op" Display="'Cl/Op'" Dmx="61680~62451" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Cl/Op" Display="'Cl/Op'" Dmx="62708~63736" Iris="0~0" Zoom="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="63993~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw" Display="'Raw'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo1Func'==3" />
      <Condition Name="Shake" ID="13,14,15,16,17,18,19" If="'Gobo1Func'==2" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="17~32" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="33~48" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="49~64" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="65~80" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="81~96" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="97~112" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="113~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~149" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="150~171" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="172~183" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="184~195" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="196~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="208~219" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="220~231" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="232~243" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="244~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw" Display="'Raw'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Shake" ID="12,13,14,15,16,17" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~21" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="22~42" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="43~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="64~85" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="86~106" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="107~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~21" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~156" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~21" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="157~185" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="0~21" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="186~199" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="200~213" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="214~227" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="228~244" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="245~255" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Fixed Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~30583" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="30840~30840" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="31097~48059" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48316~48316" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="48573~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Prism" Display="'Prism'" Dmx="0~0" Update="Prism, Prism_Rot" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="0~0" Update="Prism" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Prism" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism_Func" ID="1,2" If="'Prism_Func'==1" />
      <Condition Name="Frost" ID="4,5,6,7" If="'Prism_Func'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~50" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="51~101" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~50" />
      <Function ID="5" Name="Linear" Display="'Linear'" Dmx="102~152" />
      <Function ID="6" Name="Deep Soft Lens" Display="'Deep Soft Lens'" Dmx="153~203" />
      <Function ID="7" Name="Light Soft Lens" Display="'Light Soft Lens'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Prism_Func" ID="1,2,3,4,5" If="'Prism_Func'==1" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="189~195" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~188" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="189~195" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="196~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~47" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="48~80" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="81~112" />
      <Function ID="4" Name="Lamp Off" Display="'Lamp Off'" Dmx="113~144" />
      <Function ID="5" Name="Safe" Display="'Safe'" Dmx="145~168" />
      <Function ID="6" Name="Lamp 50%" Display="'Lamp 50%'" Dmx="169~200" />
      <Function ID="7" Name="Safe" Display="'Safe'" Dmx="201~223" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="Short 14 DMX, 8bit" Channels="14">
    <Import PearlRef="PR_S12002SB" DiamondRef="" WysiwygRef="" />

  <Mode Name="Ext 22 DMX, 16bit" Channels="22">
    <Import PearlRef="PR_S12002SX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="17,18" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="19,20" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="8" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="9,10" Wheel="18" />
      <Attribute ID="Iris" ChannelOffset="5,6" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="13,14" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="15,16" Wheel="19" />
      <Attribute ID="Prism_Func" Wheel="22" />
      <Attribute ID="Prism" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="12" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="21" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="22" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:4" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp 50%">
      <Set Channel="Control:6" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo2:1,Gobo2Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo2:2,Gobo2Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo2:3,Gobo2Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo2:4,Gobo2Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo2:5,Gobo2Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo2:6,Gobo2Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
</Fixture>
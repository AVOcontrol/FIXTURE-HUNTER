<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Wash 1500 LT" ShortName="AlphaW15LT" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>15765f78-4c17-4df3-a331-bbf388499a53</Thumbnail>
  <History Date="17-10-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="17-09-09" Author="David Hunt" Comment="Updated with latest values" />
  <History Date="14-10-09" Author="John Rogers" Comment="Updated file name from 1500 to 1500 LT." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-05-17" Author="Nic Morris" Comment="Changed Atlabse ID's to CMY versions.  Added physical pan/tilt limits.  Standardised shutter." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised colour with discreet functions.  Changed dimmer function name from 16Bit HTP to Dimmer." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Increased wheel resolution.  Changed pan and tilt function names from 16bit to Pan and Tilt respectively." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised function function names and DMX ranges.  Revised speed controls." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Recreated palettes.  Fixed lamp on (full) macro (was referencing half power)." />
  <History Date="08-02-19" Author="Nic Morris" Comment="Added RDM information.  Added product thumbnail." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="32" />
  </RDM>
  <AtlaBase TypeID="63a44374-3f60-4962-831e-866a0e0e0e04" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="8,9" If="'Colour1Func'==2" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~20" Colour="255,0,0" />
      <Function ID="3" Name="CTO 3200K" Display="'CTO 3200K'" Dmx="39~39" Colour="255,240,200" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="58~58" Colour="0,255,0" />
      <Function ID="5" Name="Aquamarine" Display="'Aquamarine'" Dmx="77~77" Colour="0,255,200" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="97~97" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="117~117" Colour="0,0,255" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="64~127" />
      <Function ID="3" Name="UV Filter" Display="'UV Filter'" Dmx="128~191" />
      <Function ID="4" Name="Ovalizer" Display="'Ovalizer'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effects" Display="'Reset Effects'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="26~100" />
      <Function ID="3" Name="Lamp On (Half)" Display="'Lamp On (Half)'" Dmx="101~179" />
      <Function ID="4" Name="Lamp On (Full)" Display="'Lamp On (Full)'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Beam_Speed" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Fast" Display="'P/T Fast'" Dmx="12~24" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="25~37" />
      <Function ID="4" Name="Dim Conventional" Display="'Dim Conventional'" Dmx="38~50" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="51~62" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
  </Control>

      <Function ID="28" Name="W/ CW" Display="'W/ CW'" Dmx="125~129" WheelPosition="12" Colour="255,255,255" />
      <Function ID="29" Name="CW/ D Blu" Display="'CW/ D Blu'" Dmx="135~139" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="D Blu/ Op" Display="'D Blu/ Op'" Dmx="145~149" WheelPosition="14" Colour="0,0,180" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="205~155" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~206" Colour="0,0,0" />

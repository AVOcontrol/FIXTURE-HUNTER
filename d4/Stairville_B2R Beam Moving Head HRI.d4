      <Function ID="22" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="65~69" WheelPosition="6" Colour="255,128,255" />
      <Function ID="23" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="75~79" WheelPosition="7" Colour="255,150,150" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ODP-1210RGBW" ShortName="ODP-1210" Company="img Stage Line">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="06-07-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-12-16" Author="Nic Morris" Comment="Added Atlabase ID to Arc2 mode." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="10-12-17" Author="Nic Morris" Comment="Added channel counts to mode names." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a4d41037-ff5a-4f4a-a2ad-bf97f5aa3504" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="201~205" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="206~210" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="211~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="216~220" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="221~225" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="226~230" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="231~235" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="236~240" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="241~245" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="246~250" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="251~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'==2" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~19" Update="Red, Green" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="20~29" Update="Red, Green" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="30~39" Update="Red, Green" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="40~49" Update="Red, Green" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="50~59" Update="Red, Green" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="60~69" Update="Red, Green" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="70~79" Update="Red, Green" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="80~89" Update="Red, Green" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="90~99" Update="Red, Green" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="100~109" Update="Red, Green" />
      <Function ID="12" Name="Chase 1" Display="'Chase 1'" Dmx="110~119" Update="Red, Green" />
      <Function ID="13" Name="Chase 2" Display="'Chase 2'" Dmx="120~129" Update="Red, Green" />
      <Function ID="14" Name="Chase 3" Display="'Chase 3'" Dmx="130~139" Update="Red, Green" />
      <Function ID="15" Name="Chase 4" Display="'Chase 4'" Dmx="140~149" Update="Red, Green" />
      <Function ID="16" Name="Chase 5" Display="'Chase 5'" Dmx="150~159" Update="Red, Green" />
      <Function ID="17" Name="Chase 6" Display="'Chase 6'" Dmx="160~169" Update="Red, Green" />
      <Function ID="18" Name="Chase 7" Display="'Chase 7'" Dmx="170~179" Update="Red, Green" />
      <Function ID="19" Name="Chase 8" Display="'Chase 8'" Dmx="180~189" Update="Red, Green" />
      <Function ID="20" Name="Chase 9" Display="'Chase 9'" Dmx="190~199" Update="Red, Green" />
      <Function ID="21" Name="Chase 10" Display="'Chase 10'" Dmx="200~255" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Fast" Display="'Dim Fast'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="50~99" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="100~149" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="150~199" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Arc.1, 3 DMX" Channels="3">

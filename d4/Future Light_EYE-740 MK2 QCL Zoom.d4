    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="FWD" Display="'FWD %.f%%',100~0" Dmx="128~190" />

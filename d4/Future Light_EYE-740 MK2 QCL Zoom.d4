      <Function ID="36" Name="3 pixels movement around ring 2" Display="'3 pixels movement around ring 2'" Dmx="221~226" />
      <Function ID="37" Name="Bottom half open/close, top half open close" Display="'Bottom half open/close, top half open close'" Dmx="227~232" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Cube 16 CW" ShortName="Cube 16 CW" Company="Neo Neon">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="03-08-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Program" ID="7,8,9" If="'Program'&gt;1" />
      <Else ID="1,2,3,4,5,6" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="250~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="106~153" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="154~201" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="202~249" Intensity="0~0" />
      <Function ID="7" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="250~255" Intensity="0~0" />
      <Function ID="9" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" Update="Shutter" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~15" Update="Shutter" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="16~31" Update="Shutter" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="32~47" Update="Shutter" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="48~63" Update="Shutter" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="64~79" Update="Shutter" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="80~95" Update="Shutter" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="96~111" Update="Shutter" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="112~127" Update="Shutter" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="128~143" Update="Shutter" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="144~159" Update="Shutter" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="160~175" Update="Shutter" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="176~191" Update="Shutter" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="192~207" Update="Shutter" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="208~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Generic" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Short, 16 DMX" Channels="16">

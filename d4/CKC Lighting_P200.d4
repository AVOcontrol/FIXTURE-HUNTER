    <Attribute ID="CCT_Preset" Name="CCT Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2400~8500" Dmx="24~85" Colour="255,240,200" />

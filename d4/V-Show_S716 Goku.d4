      <Function ID="12" Name="Grn/ Cy" Display="'Grn/ Cy'" Dmx="56~63" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Cy/ Amb" Display="'Cy/ Amb'" Dmx="72~79" WheelPosition="4" Colour="0,255,255" />
      <Function ID="14" Name="Amb/ Mag" Display="'Amb/ Mag'" Dmx="88~95" WheelPosition="5" Colour="255,100,0" />
      <Function ID="15" Name="Mag/ Pk" Display="'Mag/ Pk'" Dmx="104~111" WheelPosition="6" Colour="255,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />

      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="80~80" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="96~96" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="112~112" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Op/ 1" Display="'Op/ 1'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="1/ 2" Display="'1/ 2'" Dmx="24~24" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="2/ 3" Display="'2/ 3'" Dmx="40~40" WheelPosition="2" Colour="0,0,0" />
      <Function ID="12" Name="3/ 4" Display="'3/ 4'" Dmx="56~56" WheelPosition="3" Colour="0,0,0" />
      <Function ID="13" Name="4/ 5" Display="'4/ 5'" Dmx="72~72" WheelPosition="4" Colour="0,0,0" />
      <Function ID="14" Name="5/ 6" Display="'5/ 6'" Dmx="88~88" WheelPosition="5" Colour="0,0,0" />
      <Function ID="15" Name="6/ 7" Display="'6/ 7'" Dmx="104~104" WheelPosition="6" Colour="0,0,0" />
      <Function ID="16" Name="7/ Op" Display="'7/ Op'" Dmx="120~120" WheelPosition="7" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

      <Function ID="12" Name="Bowtie Spinner" Display="'Bowtie Spinner'" Dmx="101~109" />
      <Function ID="13" Name="One-Liner" Display="'One-Liner'" Dmx="110~118" />
      <Function ID="14" Name="Line Hop Up" Display="'Line Hop Up'" Dmx="119~127" />
      <Function ID="15" Name="Line Hop Down" Display="'Line Hop Down'" Dmx="128~136" />
      <Function ID="16" Name="Line Hop Up/Down" Display="'Line Hop Up/Down'" Dmx="137~145" />
      <Function ID="17" Name="T-Spin" Display="'T-Spin'" Dmx="146~154" />
      <Function ID="18" Name="Upside Down T-Spin" Display="'Upside Down T-Spin'" Dmx="155~163" />
      <Function ID="19" Name="Diamond Spoke Spin" Display="'Diamond Spoke Spin'" Dmx="164~172" />

    <Attribute ID="Alphanumeric" Name="Alphanumeric" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="1-10" Display="'1-10 %.1f%%',0.0~100.0" Dmx="1~127" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="H2O DMX Pro" ShortName="H2ODMX Pro" Company="ADJ" Version="3">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="15-05-13" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_H2O DMX Pro.d4 to ADJ_H2O DMX Pro.d4." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3dc112fd-1b31-43be-94aa-ddcf43c92dca" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~9" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split Gel" ID="7,8,9,10,11,12" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="13,14,15,16" If="'Colour1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="22~32" Colour="255,128,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="44~54" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="66~76" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="88~98" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="110~120" Colour="128,0,255" />
      <Function ID="7" Name="Open/Orange" Display="'Open/Orange'" Dmx="11~21" Colour="255,255,255" />
      <Function ID="8" Name="Orange/Green" Display="'Orange/Green'" Dmx="33~43" Colour="255,128,0" />
      <Function ID="9" Name="Green/Blue" Display="'Green/Blue'" Dmx="55~65" Colour="0,255,0" />
      <Function ID="10" Name="Blue/Yellow" Display="'Blue/Yellow'" Dmx="77~87" Colour="0,0,255" />
      <Function ID="11" Name="Yellow/Purple" Display="'Yellow/Purple'" Dmx="99~109" Colour="255,255,0" />
      <Function ID="12" Name="Purple/Open" Display="'Purple/Open'" Dmx="121~127" Colour="128,0,255" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="187~196" Colour="255,255,255" />
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW     %.f%%',0~100" Dmx="128~186" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="187~196" Colour="255,255,255" />
      <Function ID="16" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="196~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="ADJ_H2ODMXP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="060548cb-84b6-4446-8506-7ab1e866879f" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Rotation" ChannelOffset="2" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Orange" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="13" Name="Purple" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
    </Group>
  </Palettes>
</Fixture>
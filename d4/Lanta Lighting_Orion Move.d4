<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Orion Move" ShortName="Orion Move" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="25-05-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~19" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="20~29" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="30~39" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="40~49" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="50~59" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="60~69" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="70~79" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="80~89" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="90~99" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="100~109" />
      <Function ID="11" Name="Show 10" Display="'Show 10'" Dmx="110~119" />
      <Function ID="12" Name="No Function" Display="'No Function'" Dmx="120~139" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~180" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Show1" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~9" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~19" />
      <Function ID="3" Name="Show 1" Display="'Show 1'" Dmx="20~29" />
      <Function ID="4" Name="Show 2" Display="'Show 2'" Dmx="30~39" />
      <Function ID="5" Name="Show 3" Display="'Show 3'" Dmx="40~49" />
      <Function ID="6" Name="Show 4" Display="'Show 4'" Dmx="50~59" />
      <Function ID="7" Name="Show 5" Display="'Show 5'" Dmx="60~69" />
      <Function ID="8" Name="Show 6" Display="'Show 6'" Dmx="70~79" />
      <Function ID="9" Name="Show 7" Display="'Show 7'" Dmx="80~89" />
      <Function ID="10" Name="Show 8" Display="'Show 8'" Dmx="90~99" />
      <Function ID="11" Name="Show 9" Display="'Show 9'" Dmx="100~109" />
      <Function ID="12" Name="Show 10" Display="'Show 10'" Dmx="110~119" />
      <Function ID="13" Name="No Function" Display="'No Function'" Dmx="120~139" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Speed1" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="LHORMOVE" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Speed" Wheel="26" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Left Move" ChannelOffset="1" ModeLink="Move cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Speed" TargetId="Speed" />
      </Cell>
      <Cell ID="Cell2" Name="Right Move" ChannelOffset="3" ModeLink="Move cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Speed" TargetId="Speed" />
      </Cell>
      <Cell ID="Cell3" Name="Left LED 1" ChannelOffset="5" ModeLink="Dimmer cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Left LED 2" ChannelOffset="6" ModeLink="Dimmer cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Left LED 3" ChannelOffset="7" ModeLink="Dimmer cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Left LED 4" ChannelOffset="8" ModeLink="Dimmer cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Right LED 1" ChannelOffset="9" ModeLink="Dimmer cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Right LED 2" ChannelOffset="10" ModeLink="Dimmer cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Right LED 3" ChannelOffset="11" ModeLink="Dimmer cell" X="0" Y="8">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="Right LED 4" ChannelOffset="12" ModeLink="Dimmer cell" X="0" Y="9">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Speed" Wheel="26" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="13" Wheel="5" />
        <Attribute ID="Show1" ChannelOffset="14" Wheel="28" />
        <Attribute ID="Speed1" ChannelOffset="15" Wheel="25" />
        <Attribute ID="Shutter" ChannelOffset="16" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Left Move" ChannelOffset="1" ModeLink="Move cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Speed" TargetId="Speed" />
      </Cell>
      <Cell ID="Cell2" Name="Right Move" ChannelOffset="3" ModeLink="Move cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Speed" TargetId="Speed" />
      </Cell>
      <Cell ID="Cell3" Name="Left LED 1" ChannelOffset="5" ModeLink="Dimmer cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Left LED 2" ChannelOffset="6" ModeLink="Dimmer cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Left LED 3" ChannelOffset="7" ModeLink="Dimmer cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Left LED 4" ChannelOffset="8" ModeLink="Dimmer cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Right LED 1" ChannelOffset="9" ModeLink="Dimmer cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Right LED 2" ChannelOffset="10" ModeLink="Dimmer cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Right LED 3" ChannelOffset="11" ModeLink="Dimmer cell" X="0" Y="8">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="Right LED 4" ChannelOffset="12" ModeLink="Dimmer cell" X="0" Y="9">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

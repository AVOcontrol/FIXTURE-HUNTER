<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IGNITE150 LED Spot" ShortName="IGNITE 150" Company="BeamZ">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>fa666de2-47ec-43d1-8076-8e77993f777e</Thumbnail>
  <History Date="20-04-19" Author="Nic Morris" Comment="Created" />
  <History Date="23-04-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="14c75937-64da-4aff-81fc-a07e20c8f3a1" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~199" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~249" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="9" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13,14" If="'Colour1Func'==2" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="20~39" Colour="0,0,255" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="40~59" Colour="255,128,0" />
      <Function ID="4" Name="Lime" Display="'Lime'" Dmx="60~79" Colour="0,180,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="80~99" Colour="0,255,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="100~119" Colour="255,0,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="120~139" Colour="0,255,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="140~159" Colour="255,150,150" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="160~179" Colour="255,255,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="205~229" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="230~255" Colour="0,0,0" />
      <Function ID="14" Name="Skip" Display="'Skip %.f%%',0~100" Dmx="204~180" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Offset" Name="Colour Offset" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Step" Display="'Step'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Linear" Display="'Linear'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Step" ID="9,10,11,12" If="'Gobo1Func'==2" />
      <Condition Name="Linear" ID="13,14,15,16" If="'Gobo1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="20~39" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="40~59" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="60~79" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="80~99" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="100~119" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="120~139" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="140~159" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Step CW" Display="'Step CW %.f%%',100~0" Dmx="160~179" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Step CCW" Display="'Step CCW %.f%%',0~100" Dmx="180~199" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="14" Name="Linear CW" Display="'Linear CW %.f%%',100~0" Dmx="200~226" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Linear CCW" Display="'Linear CCW %.f%%',0~100" Dmx="227~255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="20~99" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="100~179" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="6" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Gobo_Shake" Name="Gobo Shake" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Shake Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="64~119" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="120~179" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="6" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="20~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="40~59" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="200~219" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="806d4ce2-9c7b-46d2-9b90-6ad1963edf49" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Focus" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="9" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="11" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a398ec63-8a70-428f-bc1f-e99747d76ae1" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Colour_Offset" ChannelOffset="9" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="12" Wheel="15" />
      <Attribute ID="Gobo_Shake" ChannelOffset="13" Wheel="43" />
      <Attribute ID="Prism" ChannelOffset="14" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="15" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="fa666de2-47ec-43d1-8076-8e77993f777e"></Swatch>

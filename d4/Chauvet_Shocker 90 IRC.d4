<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Shocker 90 IRC" ShortName="Shocker 90" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="10-01-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a0dc384d-e3a5-4792-8877-5f34269148fa" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~249" Intensity="0~0" />
      <Function ID="3" Name="Blinder" Display="'Blinder'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~20" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="21~40" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="41~60" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="61~80" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="81~100" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="101~120" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5'" Dmx="121~140" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6'" Dmx="141~160" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 7" Display="'Auto 7'" Dmx="161~180" Update="Auto_Spd" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="181~225" Update="Auto_Spd" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="226~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'&gt;9" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter_All" Name="Shutter All" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pulse" Name="Pulse" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="6~42" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="43~85" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Zone_Macro" Name="Zone Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~5" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="3af1a1e1-2c59-4b0a-af86-e6dea13bca15" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="Auto" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="6" Wheel="23" />
        <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
        <Attribute ID="Shutter_All" ChannelOffset="8" Wheel="5" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
    </Cells>
  </Mode>

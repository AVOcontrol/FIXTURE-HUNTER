<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ARENACOB4HALO" ShortName="Ar C4 HALO" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="19-03-16" Author="Nic Morris" Comment="Created" />
  <History Date="20-09-16" Author="Nic Morris" Comment="Added condition to dimmer that fixes it at full when patterns are activated in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Pattern" ID="2" If="'Pattern'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Patt On" Display="''" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Amber_Shift" Name="Amber Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="131~200" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="11~20" Update="Dimmer" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="21~30" Update="Dimmer" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3'" Dmx="31~40" Update="Dimmer" />
      <Function ID="5" Name="Pattern 4" Display="'Pattern 4'" Dmx="41~50" Update="Dimmer" />
      <Function ID="6" Name="Pattern 5" Display="'Pattern 5'" Dmx="51~60" Update="Dimmer" />
      <Function ID="7" Name="Pattern 6" Display="'Pattern 6'" Dmx="61~70" Update="Dimmer" />
      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="71~80" Update="Dimmer" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="81~90" Update="Dimmer" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="91~100" Update="Dimmer" />
      <Function ID="11" Name="Pattern 10" Display="'Pattern 10'" Dmx="101~110" Update="Dimmer" />
      <Function ID="12" Name="Pattern 11" Display="'Pattern 11'" Dmx="111~120" Update="Dimmer" />
      <Function ID="13" Name="Pattern 12" Display="'Pattern 12'" Dmx="121~130" Update="Dimmer" />
      <Function ID="14" Name="Pattern 13" Display="'Pattern 13'" Dmx="131~140" Update="Dimmer" />
      <Function ID="15" Name="Pattern 14" Display="'Pattern 14'" Dmx="141~150" Update="Dimmer" />
      <Function ID="16" Name="Pattern 15" Display="'Pattern 15'" Dmx="151~160" Update="Dimmer" />
      <Function ID="17" Name="Pattern 16" Display="'Pattern 16'" Dmx="161~170" Update="Dimmer" />
      <Function ID="18" Name="Pattern 17" Display="'Pattern 17'" Dmx="171~180" Update="Dimmer" />
      <Function ID="19" Name="Pattern 18" Display="'Pattern 18'" Dmx="181~190" Update="Dimmer" />
      <Function ID="20" Name="Pattern 19" Display="'Pattern 19'" Dmx="191~200" Update="Dimmer" />
      <Function ID="21" Name="Pattern 20" Display="'Pattern 20'" Dmx="201~210" Update="Dimmer" />
      <Function ID="22" Name="Pattern 21" Display="'Pattern 21'" Dmx="211~220" Update="Dimmer" />
      <Function ID="23" Name="Pattern 22" Display="'Pattern 22'" Dmx="221~230" Update="Dimmer" />
      <Function ID="24" Name="Pattern 23" Display="'Pattern 23'" Dmx="231~240" Update="Dimmer" />
      <Function ID="25" Name="Random" Display="'Random'" Dmx="241~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Patt_Spd" Name="Patt Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~29" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="30~140" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="HALO 1 DMX" Channels="1">
    <Import PearlRef="PGARC4H1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="HALO 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Dim Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Dim Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Dim Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Dim Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="PGARC4H2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>

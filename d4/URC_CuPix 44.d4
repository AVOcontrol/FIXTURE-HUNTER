      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="71~90" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="91~110" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="111~130" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Xtylos HPE" ShortName="MinXtylHPE" Company="Clay Paky" Version="7">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Created (prelim DMX channels 04/2019 charts.  lots missing)" Version="1" />
  <History Date="22-07-19" Author="Nic Morris" Comment="Updated in line with DMX Channels 07/2019 charts (still 'prelim!').  Adds CTO, gobo and effect ranges, revises functions and macros." Version="2" />
  <History Date="22-07-19" Author="Nic Morris" Comment="Note 'Vector' mode seems to have disappeared.  Kept for now making best guess." Version="3" />
  <History Date="23-07-19" Author="Nic Morris" Comment="Added Atlabase ID's (Standard mode only at the moment)" Version="4" />
  <History Date="25-08-20" Author="Nic Morris" Comment="Updated in line with latest documentation (DMX Channels 06/2020)" Version="5" />
  <History Date="11-02-21" Author="Nic Morris" Comment="Updated in line with latest documentation (DMX Channels 01/2021) in response to manufacturer request (adds gobo images, BAZ Fading control, revises Show Setup/Macros, removes 'Vector' mode)" Version="6" />
  <History Date="30-07-21" Author="Nic Morris" Comment="Created from Clay Paky Xtylos" Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',3000~9000" Dmx="255~1" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Show_Setup" Name="Show Setup" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Limited Output On" Display="'Limited Output On'" Dmx="12~16" />
      <Function ID="3" Name="Limited Output Off" Display="'Limited Output Off'" Dmx="17~21" />
      <Function ID="4" Name="Max Output - HD=33ft" Display="'Max Output - HD=33ft'" Dmx="22~27" />
      <Function ID="5" Name="Max Output - HD=27ft" Display="'Max Output - HD=27ft'" Dmx="28~32" />
      <Function ID="6" Name="Max Output - HD=20ft" Display="'Max Output - HD=20ft'" Dmx="33~37" />
      <Function ID="7" Name="Check Start" Display="'Check Start'" Dmx="43~47" />
      <Function ID="8" Name="Check Stop" Display="'Check Stop'" Dmx="48~52" />
      <Function ID="9" Name="BAZ - Symmetric" Display="'BAZ - Symmetric'" Dmx="53~57" />
      <Function ID="10" Name="BAZ - Pan 180" Display="'BAZ - Pan 180'" Dmx="58~62" />
      <Function ID="11" Name="BAZ - Custom - Tilt 1" Display="'BAZ - Custom - Tilt 1'" Dmx="63~67" />
      <Function ID="12" Name="BAZ - Custom - Pan 1" Display="'BAZ - Custom - Pan 1'" Dmx="68~72" />
      <Function ID="13" Name="BAZ - Custom - Pan 2" Display="'BAZ - Custom - Pan 2'" Dmx="73~78" />
      <Function ID="14" Name="BAZ - Custom - Tilt 2" Display="'BAZ - Custom - Tilt 2'" Dmx="79~83" />
      <Function ID="15" Name="BAZ - Invert Off" Display="'BAZ - Invert Off'" Dmx="94~99" />
      <Function ID="16" Name="BAZ - Invert On" Display="'BAZ - Invert On'" Dmx="100~104" />
      <Function ID="17" Name="BAZ - Reset" Display="'BAZ - Reset'" Dmx="105~108" />
      <Function ID="18" Name="Max Output - Symmetric" Display="'Max Output - Symmetric'" Dmx="109~113" />
      <Function ID="19" Name="Max Output - Pan 180" Display="'Max Output - Pan 180'" Dmx="114~118" />
      <Function ID="20" Name="Max Output - Custom - Tilt 1" Display="'Max Output - Custom - Tilt 1'" Dmx="119~123" />
      <Function ID="21" Name="Max Output - Custom - Pan 1" Display="'Max Output - Custom - Pan 1'" Dmx="124~129" />
      <Function ID="22" Name="Max Output - Custom - Pan 2" Display="'Max Output - Custom - Pan 2'" Dmx="130~134" />
      <Function ID="23" Name="Max Output - Custom - Tilt 2" Display="'Max Output - Custom - Tilt 2'" Dmx="135~139" />
      <Function ID="24" Name="Max Output - Invert Off" Display="'Max Output - Invert Off'" Dmx="150~154" />
      <Function ID="25" Name="Max Output - Invert On" Display="'Max Output - Invert On'" Dmx="155~159" />
      <Function ID="26" Name="Max Output - Reset" Display="'Max Output - Reset'" Dmx="160~164" />
      <Function ID="27" Name="Complete Channel Reset" Display="'Complete Channel Reset'" Dmx="165~169" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="33~64" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="65~97" />
      <Function ID="4" Name="Prism 3" Display="'Prism 3'" Dmx="98~129" />
      <Function ID="5" Name="Frost Shake" Display="'Frost Shake %.f%%',0~100" Dmx="130~171" />
      <Function ID="6" Name="Prism 1 Shake" Display="'Prism 1 Shake %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Prism 2 Shake" Display="'Prism 2 Shake %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~193" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="190~128" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Smart_Fading" Name="Smart Fading" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Fade" Display="'No Fade'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Generic" Name="BAZ Fading" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Fade" Display="'No Fade'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~1" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Fast" Display="'P/T Fast'" Dmx="12~24" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="25~37" />
      <Function ID="4" Name="Pan Spin Fast" Display="'Pan Spin Fast'" Dmx="38~50" />
      <Function ID="5" Name="Pan Spin Slow" Display="'Pan Spin Slow'" Dmx="51~62" />
      <Function ID="6" Name="Mini Xtylos Like - HPE" Display="'Mini Xtylos Like - HPE'" Dmx="63~75" />
      <Function ID="7" Name="Mini Xtylos Like" Display="'Mini Xtylos Like'" Dmx="76~88" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effects" Display="'Reset Effects'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Function_2" Name="Function 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Base Freq 4700Hz" Display="'Base Freq 4700Hz'" Dmx="12~12" />
      <Function ID="3" Name="Base Freq 6000Hz" Display="'Base Freq 6000Hz'" Dmx="13~13" />
      <Function ID="4" Name="Base Freq 7300Hz" Display="'Base Freq 7300Hz'" Dmx="14~14" />
      <Function ID="5" Name="Base Freq 8600Hz" Display="'Base Freq 8600Hz'" Dmx="15~15" />
      <Function ID="6" Name="Base Freq 10000Hz" Display="'Base Freq 10000Hz'" Dmx="16~16" />
      <Function ID="7" Name="Base Freq 12000Hz" Display="'Base Freq 12000Hz'" Dmx="17~17" />
      <Function ID="8" Name="Base Freq 15000Hz" Display="'Base Freq 15000Hz'" Dmx="18~18" />
      <Function ID="9" Name="Base Freq 17578Hz" Display="'Base Freq 17578Hz'" Dmx="19~19" />
      <Function ID="10" Name="Base Freq 20000Hz" Display="'Base Freq 20000Hz'" Dmx="20~20" />
      <Function ID="11" Name="Base Freq 22000Hz" Display="'Base Freq 22000Hz'" Dmx="21~21" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frequency" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="27 DMX" Channels="27">

      <Function ID="5" Name="Reset Zoom/Focus/Prism/Frost" Display="'Reset Zoom/Focus/Prism/Frost'" Dmx="50~59" />
      <Function ID="6" Name="Reset Anim/Iris/Framing" Display="'Reset Anim/Iris/Framing'" Dmx="60~69" />
      <Function ID="7" Name="Display Default" Display="'Display Default'" Dmx="70~74" />
      <Function ID="8" Name="Display Off" Display="'Display Off'" Dmx="75~79" />
      <Function ID="9" Name="Display On" Display="'Display On'" Dmx="80~84" />
      <Function ID="10" Name="Fan Low" Display="'Fan Low'" Dmx="85~89" />
      <Function ID="11" Name="Fan Med" Display="'Fan Med'" Dmx="90~94" />
      <Function ID="12" Name="Fan High" Display="'Fan High'" Dmx="95~99" />

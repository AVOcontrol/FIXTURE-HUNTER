      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="144~199" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func1" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="3" Name="Index Index" Display="'Index Index'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="4" Name="Index Spin" Display="'Index Spin'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo21, Gobo2Rot1" />
    </Attribute>
    <Attribute ID="Gobo21" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func1'==1||'Gobo2Func1'==2" />
      <Condition Name="Index" ID="8" If="'Gobo2Func1'==3||'Gobo2Func1'==4" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo2Func1'==5||'Gobo2Func1'==6" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="9~17" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="18~26" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="27~35" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="36~44" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="45~53" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="54~62" WheelPosition="6" />
      <Function ID="8" Name="Index" Display="'Index %.f%%',0~100" Dmx="72~135" WheelPosition="0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="196~255" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="136~195" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot1" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo2Func1'==1||'Gobo2Func1'==3||'Gobo2Func1'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo2Func1'==2||'Gobo2Func1'==4||'Gobo2Func1'==6" />
      <Else ID="7" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~123" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="187~124" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="4~67" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="68~100" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="101~131" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="132~175" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="176~247" />
      <Function ID="7" Name="Random 1" Display="'Random 1'" Dmx="248~251" />
      <Function ID="8" Name="Random 2" Display="'Random 2'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Refresh_Rate" Name="Refresh Rate" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1200Hz - Auto PWM" Display="'1200Hz - Auto PWM'" Dmx="0~0" />
      <Function ID="2" Name="1200Hz - Fast PWM" Display="'1200Hz - Fast PWM'" Dmx="64~127" />
      <Function ID="3" Name="13600Hz - Auto PWM" Display="'13600Hz - Auto PWM'" Dmx="128~191" />
      <Function ID="4" Name="13600Hz - Fast PWM" Display="'13600Hz - Fast PWM'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Iris1" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="128~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="136~173" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="174~211" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="212~249" />
    </Attribute>
    <Attribute ID="Frost_(Soft)" Name="Frost (Soft)" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost 1" Display="'Frost 1 %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Frost_(Hard)" Name="Frost (Hard)" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost 2" Display="'Frost 2 %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Animation1" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Animation_Rot1" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~151" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="248~255" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="152~247" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="20~29" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~39" />

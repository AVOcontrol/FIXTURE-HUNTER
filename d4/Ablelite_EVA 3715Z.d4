<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EVA 3715Z" ShortName="EVA 3715Z" Company="Ablelite">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>9036fe0b-7d95-41b1-96e0-79edbc1f5acc</Thumbnail>
  <History Date="05-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="09-01-15" Author="Nic Morris" Comment="Changed RGB Pixel to RGB and RGB to RGB Master so that it works with pixel mapper in response to manufacturer bug report." />
  <History Date="09-01-15" Author="Nic Morris" Comment="Applied cell layout in response to manufacturer information." />
  <History Date="17-01-15" Author="Nic Morris" Comment="Created from Prolights Diamond19" />
  <History Date="08-03-15" Author="Nic Morris" Comment="Updated in line with software version 1.0.00 documentation in response to manufacturer request." />
  <History Date="18-11-15" Author="Ermanno Valvason" Comment="Zoom, Patterns, FG and BG colours Updated" />
  <History Date="02-12-15" Author="Nic Morris" Comment="Tidied up patt spd conditions and functions and power on values." />
  <History Date="02-12-15" Author="Nic Morris" Comment="Slight adjustment to wheel mapping to ensure attributes line up across diamond series." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="03-07-18" Author="Nic Morris" Comment="Created from Prolights DIAMOND37" />
  <History Date="07-07-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="67f49be9-6481-49be-819d-5a726867e45b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FWD" Display="'Pulse FWD'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll FW" Display="'Scroll FW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll REV" Display="'Scroll REV'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="13:0" PowerOn="13:0" />
      <Condition Name="CTC" ID="1,2,3,4,5" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="6" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="7,8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="13" />
      <Function ID="1" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="5" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="6" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />

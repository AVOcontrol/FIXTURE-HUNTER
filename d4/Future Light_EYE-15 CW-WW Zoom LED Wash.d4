        <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="P/T_Func" ChannelOffset="6" Wheel="26" />
        <Attribute ID="Shutter_Func" ChannelOffset="7" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
        <Attribute ID="Colour1Func" ChannelOffset="10" Wheel="7" />
        <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
        <Attribute ID="Colour2" ChannelOffset="12" Wheel="9" />
        <Attribute ID="WarmWhite" ChannelOffset="13" Wheel="10" />
        <Attribute ID="ColdWhite" ChannelOffset="14" Wheel="11" />
        <Attribute ID="CTO" Wheel="37" />
        <Attribute ID="Zoom" ChannelOffset="20" Wheel="19" />
        <Attribute ID="Control" ChannelOffset="21" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="15" ModeLink="Cell" X="0" Y="0">

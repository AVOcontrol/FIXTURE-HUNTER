<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Bar-1250 RGB+UV 4in1" ShortName="Bar-1250" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-02-17" Author="Nic Morris" Comment="Created" />
  <History Date="17-10-17" Author="Nic Morris" Comment="Changed name from LED BAR-1250 RGB+UV 4in1 to LED Bar-1250 RGB+UV 4in1" />
  <History Date="17-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d44370f7-df05-41fc-ab87-4b1e7db26ace" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="UV" Display="'UV'" Dmx="40~47" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="48~55" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="56~63" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="BUV" Display="'BUV'" Dmx="64~71" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="RUV" Display="'RUV'" Dmx="72~79" Update="Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="GUV" Display="'GUV'" Dmx="80~87" Update="Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="RB" Display="'RB'" Dmx="88~95" Update="Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="96~103" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="GBUV" Display="'GBUV'" Dmx="104~111" Update="Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="RGUV" Display="'RGUV'" Dmx="112~119" Update="Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="RBUV" Display="'RBUV'" Dmx="120~127" Update="Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="RGBUV" Display="'RGBUV'" Dmx="128~135" Update="Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Program 1" Display="'Program 1'" Dmx="136~143" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Program 2" Display="'Program 2'" Dmx="144~151" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Program 3" Display="'Program 3'" Dmx="152~159" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Program 4" Display="'Program 4'" Dmx="160~167" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Program 5" Display="'Program 5'" Dmx="168~175" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Program 6" Display="'Program 6'" Dmx="176~183" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Program 7" Display="'Program 7'" Dmx="184~191" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Program 8" Display="'Program 8'" Dmx="192~199" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Program 9" Display="'Program 9'" Dmx="200~207" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Program 10" Display="'Program 10'" Dmx="208~215" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Program 11" Display="'Program 11'" Dmx="216~223" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;28" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==28" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="EXL12501" DiamondRef="" WysiwygRef="" />
    <Physical>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robohead X-3 LED" ShortName="Robohd X-3" Company="Stairville">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Deep Blue'" Dmx="8~15" WheelPosition="1" Colour="0,0,180" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="24~31" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Peachblow" Display="'Peachblow'" Dmx="40~47" WheelPosition="5" Colour="255,150,150" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~55" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="56~63" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op/ D Bl" Display="'Op/ D Bl'" Dmx="64~71" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Bl/ Yel" Display="'D Bl/ Yel'" Dmx="72~79" WheelPosition="1" Colour="0,0,180" />
      <Function ID="11" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="80~87" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Pk/ Grn" Display="'Pk/ Grn'" Dmx="88~95" WheelPosition="3" Colour="255,150,150" />
      <Function ID="13" Name="Grn/ Pch" Display="'Grn/ Pch'" Dmx="96~103" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Pch/ Bl" Display="'Pch/ Bl'" Dmx="104~111" WheelPosition="5" Colour="255,150,150" />
      <Function ID="15" Name="Bl/ Rd" Display="'Bl/ Rd'" Dmx="112~119" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Rd/ Op" Display="'Rd/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~3" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="4~7" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~215" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="112~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="104~111" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="96~103" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="88~95" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="80~87" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="72~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="64~71" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~239" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="8~15" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="16~23" />
      <Function ID="4" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="24~31" />
      <Function ID="5" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="32~39" />
      <Function ID="6" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="40~47" />
      <Function ID="7" Name="Gobo in Dark OFF" Display="'Gobo in Dark OFF'" Dmx="48~55" />
      <Function ID="8" Name="All in Dark" Display="'All in Dark'" Dmx="88~95" />
      <Function ID="9" Name="Reset P/T" Display="'Reset P/T'" Dmx="96~103" />
      <Function ID="10" Name="Reset Col" Display="'Reset Col'" Dmx="112~119" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="12" Name="Reset Gobo Rot" Display="'Reset Gobo Rot'" Dmx="128~135" />
      <Function ID="13" Name="Reset Prism" Display="'Reset Prism'" Dmx="136~143" />
      <Function ID="14" Name="Reset Focus" Display="'Reset Focus'" Dmx="144~151" />
      <Function ID="15" Name="Reset All" Display="'Reset All'" Dmx="152~159" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="8~23" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="24~39" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="40~55" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="56~71" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="72~87" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="88~103" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="104~119" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="120~135" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="136~151" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="152~167" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="168~183" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="184~199" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="200~215" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="216~231" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="232~247" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan1" Name="Pan 1" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan2" Name="Pan 2" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="SVRHX-31" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="540" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Pan1" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Pan2" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="7" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Auto" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Pan" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
        <Attribute ID="Colour1Func" Wheel="7" />
        <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
        <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
        <Attribute ID="Gobo1Func" Wheel="13" />
        <Attribute ID="Gobo1" ChannelOffset="6" Wheel="14" />
        <Attribute ID="Gobo1Rot" ChannelOffset="7" Wheel="15" />
        <Attribute ID="Prism" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
        <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
        <Attribute ID="Auto" ChannelOffset="11" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="8bit cell" X="0" Y="0">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="8bit cell" X="0" Y="1">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="SVRHX-32" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="540" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Pan1" ChannelOffset="1,4" Wheel="19" />
      <Attribute ID="Tilt" ChannelOffset="2,5" Wheel="3" />
      <Attribute ID="Pan2" ChannelOffset="3,6" Wheel="21" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="12" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="16" Wheel="20" />
      <Attribute ID="Auto" ChannelOffset="14" Wheel="23" />
      <Attribute ID="Prism" ChannelOffset="15" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Pan" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="2,5" Wheel="3" />
        <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
        <Attribute ID="Colour1Func" Wheel="7" />
        <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
        <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
        <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
        <Attribute ID="Gobo1Func" Wheel="13" />
        <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
        <Attribute ID="Gobo1Rot" ChannelOffset="12" Wheel="15" />
        <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
        <Attribute ID="Auto" ChannelOffset="14" Wheel="23" />
        <Attribute ID="Prism" ChannelOffset="15" Wheel="22" />
        <Attribute ID="Focus" ChannelOffset="16" Wheel="20" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="16bit cell" X="0" Y="0">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="16bit cell" X="0" Y="1">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16bit cell" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="540" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,4" Wheel="2" />
    </Include>
  </Mode>
  <Mode Name="8bit cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="540" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Col">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo Rot">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Prism">
      <Set Channel="Control:13" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Focus">
      <Set Channel="Control:14" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:15" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />

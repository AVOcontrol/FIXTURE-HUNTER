    <Attribute ID="Animation" Name="Animation" Description="" Group="E" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="FWD/ Quick BWD" Display="'FWD/ Quick BWD'" Dmx="2570~12336" />
      <Function ID="3" Name="BWD/ Quick FWD" Display="'BWD/ Quick FWD'" Dmx="12593~22359" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="22616~32639" />
      <Function ID="5" Name="Spin CW (2)" Display="'Spin CW (2) %.2f%%',100.00~0.00" Dmx="32896~48830" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="7" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="11~138" Update="Prism_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="139~255" Update="Prism_Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Prism" ID="1" If="'Prism'==1" />
      <Condition Name="Index" ID="2" If="'Prism'==2" />
      <Condition Name="Spin" ID="3,4,5,6,7" If="'Prism'==3" />
      <Else ID="8" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="7" Name="No Spin" Display="'No Spin'" Dmx="254~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Reset Specific" Display="'Reset Specific'" Dmx="15~29" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~34" />
      <Function ID="5" Name="1.2kHz" Display="'1.2kHz'" Dmx="50~54" />
      <Function ID="6" Name="6kHz" Display="'6kHz'" Dmx="55~59" />
      <Function ID="7" Name="12kHz" Display="'12kHz'" Dmx="60~64" />
      <Function ID="8" Name="24kHz" Display="'24kHz'" Dmx="65~69" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Spd" Name="Colour Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Focus/Zoom_Spd" Name="Focus/Zoom Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Gobo_Spd" Name="Gobo Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

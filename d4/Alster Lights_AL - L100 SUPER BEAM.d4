      <Condition Name="Scroll" ID="28,29,30,31" If="'Colour1Func'==3" />
      <Else ID="32" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="2570~3598" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="5140~6168" WheelPosition="2" Colour="0,255,0" />

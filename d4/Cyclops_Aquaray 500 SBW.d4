      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="34" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="68~121" />
      <Function ID="35" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="36" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="122~175" />
      <Function ID="37" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

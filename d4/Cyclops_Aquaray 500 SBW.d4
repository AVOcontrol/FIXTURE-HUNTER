      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="60~63" WheelPosition="14" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="64~67" WheelPosition="15" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="176~180" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="181~185" WheelPosition="2" />

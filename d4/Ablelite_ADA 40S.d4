<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ADA 40S" ShortName="ADA 40S" Company="Ablelite">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>0057b937-00e8-4267-a770-69378a665c0c</Thumbnail>
  <History Date="04-10-12" Author="Peter Budd" Comment="Created" />
  <History Date="08-10-12" Author="Peter Budd" Comment="Created from Ablelite EVA 60B" />
  <History Date="13-06-13" Author="Peter Budd" Comment="Created from the Ablelite EVA 75S." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="30-11-19" Author="Nic Morris" Comment="Revised wheel mapping for compatibility.  Added product thumbnail." />
  <History Date="30-11-19" Author="Nic Morris" Comment="Note channel layout and count doesnt match information online.  Basic mode had 16 DMX in name but only 15 in count." />
  <History Date="30-11-19" Author="Nic Morris" Comment="Standard mode had 17 count with a gap.  Assumed should be unused focus.  Fixed spelling errors.  This is a mess." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Continuous" Display="'Continuous'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Indexed" Display="'Indexed'" Dmx="112~127" Update="Colour1" Colour="0,0,0" />
      <Function ID="8" Name="Reserved" Display="'Reserved %.f',128~255" Dmx="128~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="22:0" PowerOn="22:0" />
      <Condition Name="CTC" ID="1,2,3,4,5" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="6" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Continuous/ Bounce" ID="7,8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Condition Name="Indexed" ID="13,14,15,16,17,18,19,20,21" If="'Colour1Func'==7" />
      <Else ID="22" />
      <Function ID="1" Name="CTO" Display="'CTO %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,240,200" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="5" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="14" Name="Colour 1" Display="'Colour 1'" Dmx="28~55" Colour="0,0,0" />
      <Function ID="15" Name="Colour 2" Display="'Colour 2'" Dmx="56~83" Colour="0,0,0" />
      <Function ID="16" Name="Colour 3" Display="'Colour 3'" Dmx="84~111" Colour="0,0,0" />
      <Function ID="17" Name="Colour 4" Display="'Colour 4'" Dmx="112~139" Colour="0,0,0" />
      <Function ID="18" Name="Colour 5" Display="'Colour 5'" Dmx="140~167" Colour="0,0,0" />
      <Function ID="19" Name="Colour 6" Display="'Colour 6'" Dmx="168~195" Colour="0,0,0" />
      <Function ID="20" Name="Colour 7" Display="'Colour 7'" Dmx="196~223" Colour="0,0,0" />
      <Function ID="21" Name="Colour 8" Display="'Colour 8'" Dmx="224~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed+BO" Display="'Fixed+BO'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1" />
      <Condition Name="Fixed+BO" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==2" />
      <Condition Name="Shake" ID="15,16,17,18,19,20" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="21,22,23,24" If="'Gobo1Func'==4" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="7~13" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="14~20" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="21~27" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="28~34" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="35~41" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="42~48" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="49~55" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1" Display="'Gobo 1'" Dmx="56~62" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2" Display="'Gobo 2'" Dmx="63~69" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3" Display="'Gobo 3'" Dmx="70~76" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4" Display="'Gobo 4'" Dmx="77~83" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5" Display="'Gobo 5'" Dmx="84~90" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6" Display="'Gobo 6'" Dmx="91~97" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="98~118" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="119~139" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="140~160" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="161~181" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="182~202" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="203~223" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="224~239" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~63" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Colour" Display="'Reset Colour'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="7" Name="Display Off" Display="'Display Off'" Dmx="56~63" />
      <Function ID="8" Name="Display On" Display="'Display On'" Dmx="64~71" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
    <Attribute ID="GoboRot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="224~239" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Anim CW" Display="'Anim CW %.f%%',100~0" Dmx="192~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Anim CCW" Display="'Anim CCW %.f%%',0~100" Dmx="208~223" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 15 DMX" Channels="15">
    <Import PearlRef="UK_AbAD40SB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="40" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="12" Wheel="14" />
      <Attribute ID="GoboRot" ChannelOffset="13" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="14" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Standard, 18 DMX" Channels="18">
    <Import PearlRef="UK_AbAD40SS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="9" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="10" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="40" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="15" Wheel="14" />
      <Attribute ID="GoboRot" ChannelOffset="16" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="17" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="18" Wheel="28" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="Extended, 23 DMX" Channels="23">
    <Import PearlRef="UK_AbAD40SX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7,8" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1Func" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="10" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="11" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="12,13" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="14,15" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="16,17" Wheel="12" />
      <Attribute ID="White" ChannelOffset="18,19" Wheel="40" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="20" Wheel="14" />
      <Attribute ID="GoboRot" ChannelOffset="21" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="22" Wheel="22" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="23" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Hibernate">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />

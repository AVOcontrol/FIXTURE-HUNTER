      <Attribute ID="Motor_Param_6" ChannelOffset="6" Wheel="79" />
      <Attribute ID="Motor_Param_7" ChannelOffset="7" Wheel="80" />
      <Attribute ID="Motor_Param_8" ChannelOffset="8" Wheel="81" />
      <Attribute ID="Motor_Param_9" ChannelOffset="9" Wheel="109" />
      <Attribute ID="Motor_Param_10" ChannelOffset="10" Wheel="110" />
      <Attribute ID="Gel_Fan" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Lamp_Control" ChannelOffset="12" Wheel="28" />
      <Attribute ID="Motor_Mode" ChannelOffset="13" Wheel="19" />
      <Attribute ID="Reserved2" ChannelOffset="14" Wheel="29" />

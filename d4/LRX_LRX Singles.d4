  <History Date="30-03-22" Author="Nic Morris" Comment="Created (very strange DMX control implementation.  At the moment I have provided a single mode with ability to switch mode dynamically but it might be better as two fixed modes)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Motor_Param_1" Name="Motor Param 1" Description="" Group="B">
      <Locate Locate="5" PowerOn="5" />
      <Condition Name="Fader" ID="1,2,3,4" If="'Motor_Mode'==2" />
      <Else ID="5,6" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="2" Name="Pan Left" Display="'Pan Left'" Dmx="0~0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="4" Name="Pan Right" Display="'Pan Right'" Dmx="255~255" />
      <Function ID="5" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="6" Name="Pan Left" Display="'Pan Left'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_2" Name="Motor Param 2" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3,4,5,6" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="4" Name="Tilt Up" Display="'Tilt Up'" Dmx="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="6" Name="Tilt Down" Display="'Tilt Down'" Dmx="255~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Pan Right" Display="'Pan Right'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_3" Name="Motor Param 3" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3,4,5,6" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="4" Name="Spot" Display="'Spot'" Dmx="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="6" Name="Flood" Display="'Flood'" Dmx="255~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Tilt Up" Display="'Tilt Up'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_4" Name="Motor Param 4" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3,4,5,6" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="4" Name="Trolley Left" Display="'Trolley Left'" Dmx="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="127~127" />
      <Function ID="6" Name="Trolley Right" Display="'Trolley Right'" Dmx="255~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Tilt Down" Display="'Tilt Down'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_5" Name="Motor Param 5" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spot" Display="'Spot'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_6" Name="Motor Param 6" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Flood" Display="'Flood'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_7" Name="Motor Param 7" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fader" ID="3" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Trolley Left" Display="'Trolley Left'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_8" Name="Motor Param 8" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fader" ID="3" If="'Motor_Mode'==2" />
      <Else ID="1,2" />
      <Function ID="3" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Trolley Right" Display="'Trolley Right'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Motor_Param_9" Name="Motor Param 9" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Motor_Param_10" Name="Motor Param 10" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gel_Fan" Name="Gel Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Lamp_Control" Name="Lamp Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Motor_Mode" Name="Motor Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Bump" Display="'Bump'" Dmx="0~0" Update="Motor_Param_1, Motor_Param_2, Motor_Param_3, Motor_Param_4, Motor_Param_5, Motor_Param_6, Motor_Param_7, Motor_Param_8" />
      <Function ID="2" Name="Fader" Display="'Fader'" Dmx="255~255" Update="Motor_Param_1, Motor_Param_2, Motor_Param_3, Motor_Param_4, Motor_Param_5, Motor_Param_6, Motor_Param_7, Motor_Param_8" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Motor_Param_1" ChannelOffset="1" Wheel="20" />

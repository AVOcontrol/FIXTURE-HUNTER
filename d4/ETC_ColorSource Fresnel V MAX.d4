  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="Indigo" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Indigo C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="241~254" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Dark" Display="'Dark %.f%%',0~100" Dmx="1~40" />
      <Function ID="4" Name="Bright" Display="'Bright %.f%%',0~100" Dmx="41~80" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="81~120" />
      <Function ID="7" Name="Flicker" Display="'Flicker %.f%%',0~100" Dmx="161~200" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~19" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="20~249" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="1900-5975K" Display="'1900-5975K %.fK',1900~5975" Dmx="1~164" Colour="0,0,0" />
      <Function ID="3" Name="6000-10450K" Display="'6000-10450K %.fK',6000~10450" Dmx="165~254" Colour="0,0,0" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral (0)" Display="'Neutral (0)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Green (10)" Display="'Full Green (10)'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="3" Name="+ Green" Display="'+ Green %.1f',10.0~0.0" Dmx="2~127" Colour="0,0,0" />
      <Function ID="4" Name="Neutral (0)" Display="'Neutral (0)'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="5" Name="+ Magenta (-10)" Display="'+ Magenta (-10) %.1f',0.0~10.0" Dmx="129~254" Colour="0,0,0" />
      <Function ID="6" Name="Full Magenta (-10)" Display="'Full Magenta (-10)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tune" Name="Tune" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Brightest" Display="'Brightest'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Best Spectral" Display="'Best Spectral'" Dmx="50~99" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" />
    </Attribute>
  </Control>

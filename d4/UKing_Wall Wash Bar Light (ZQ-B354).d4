  <AtlaBase TypeID="b4c86bb3-bcb7-4c7a-b381-15171d1e79fd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="LED Col Selection Red" Display="'LED Col Selection Red'" Dmx="6~16" />
      <Function ID="3" Name="LED Col Selection Green" Display="'LED Col Selection Green'" Dmx="17~27" />
      <Function ID="4" Name="LED Col Selection Blue" Display="'LED Col Selection Blue'" Dmx="28~38" />
      <Function ID="5" Name="LED Col Selection Yellow" Display="'LED Col Selection Yellow'" Dmx="39~49" />
      <Function ID="6" Name="LED Col Selection Purple" Display="'LED Col Selection Purple'" Dmx="50~60" />
      <Function ID="7" Name="LED Col Selection Cyan" Display="'LED Col Selection Cyan'" Dmx="61~71" />
      <Function ID="8" Name="LED Col Selection White" Display="'LED Col Selection White'" Dmx="72~82" />
      <Function ID="9" Name="Point to Point Control- 1" Display="'Point to Point Control- 1'" Dmx="83~93" />
      <Function ID="10" Name="Point to Point Control- 2" Display="'Point to Point Control- 2'" Dmx="94~104" />
      <Function ID="11" Name="Point to Point Control- 3" Display="'Point to Point Control- 3'" Dmx="105~115" />
      <Function ID="12" Name="Point to Point Control- 4" Display="'Point to Point Control- 4'" Dmx="116~126" />
      <Function ID="13" Name="Point to Point Control- 5" Display="'Point to Point Control- 5'" Dmx="127~137" />
      <Function ID="14" Name="Point to Point Control- 6" Display="'Point to Point Control- 6'" Dmx="138~148" />
      <Function ID="15" Name="Point to Point Control- 7" Display="'Point to Point Control- 7'" Dmx="149~159" />
      <Function ID="16" Name="Point to Point Control- 8" Display="'Point to Point Control- 8'" Dmx="160~170" />
      <Function ID="17" Name="Point to Point Control- 9" Display="'Point to Point Control- 9'" Dmx="171~181" />
      <Function ID="18" Name="Red Gradient Effect" Display="'Red Gradient Effect'" Dmx="182~192" />
      <Function ID="19" Name="Green Gradient Effect" Display="'Green Gradient Effect'" Dmx="193~203" />
      <Function ID="20" Name="Blue Gradient Effect" Display="'Blue Gradient Effect'" Dmx="204~214" />
      <Function ID="21" Name="Purple Gradient Effect" Display="'Purple Gradient Effect'" Dmx="215~225" />
      <Function ID="22" Name="Yellow Gradient Effect" Display="'Yellow Gradient Effect'" Dmx="226~236" />
      <Function ID="23" Name="Cyclic Gradient Effect" Display="'Cyclic Gradient Effect'" Dmx="237~247" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

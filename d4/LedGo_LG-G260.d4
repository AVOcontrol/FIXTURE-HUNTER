      <Attribute ID="Special_Effect" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Filters" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Parameter_1" ChannelOffset="5" Wheel="9" />

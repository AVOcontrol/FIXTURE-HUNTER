<Fixture Name="LG-G260" ShortName="LG-G260" Company="LedGo" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="10-03-26" Author="Nic Morris" Comment="Created (hopeless documentation. the charts suggest channels 5-9 are dependent on more than one channel.  this doesn't make any sense.)" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="76c06a6a-6a18-4e7b-bad7-602bd0a54f0a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lighting_Mode" Name="Lighting Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="OFF" Display="'OFF'" Dmx="0~0" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="2" Name="CCT" Display="'CCT'" Dmx="29~56" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="3" Name="HSI" Display="'HSI'" Dmx="57~84" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="4" Name="RGBW" Display="'RGBW'" Dmx="85~112" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="5" Name="Tungsten" Display="'Tungsten'" Dmx="113~140" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="6" Name="Sodium Vepour" Display="'Sodium Vepour'" Dmx="141~168" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="7" Name="Metal Halide" Display="'Metal Halide'" Dmx="169~196" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="8" Name="Fluorescent" Display="'Fluorescent'" Dmx="197~224" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
      <Function ID="9" Name="Street" Display="'Street'" Dmx="225~255" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4, Parameter_5" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Special_Effect" Name="Special Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Storm" Display="'Storm'" Dmx="32~63" />
      <Function ID="3" Name="Cop Car" Display="'Cop Car'" Dmx="64~93" />
      <Function ID="4" Name="Candle Light" Display="'Candle Light'" Dmx="94~124" />
      <Function ID="5" Name="Soft Disco" Display="'Soft Disco'" Dmx="125~155" />
      <Function ID="6" Name="Hard Disco" Display="'Hard Disco'" Dmx="156~186" />
      <Function ID="7" Name="Monitor" Display="'Monitor'" Dmx="187~217" />
      <Function ID="8" Name="Multi Flash" Display="'Multi Flash'" Dmx="218~255" />
    </Attribute>
    <Attribute ID="Filters" Name="Filters" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="L3202" Display="'L3202'" Dmx="24~46" Colour="0,0,0" />
      <Function ID="3" Name="L3203" Display="'L3203'" Dmx="47~69" Colour="0,0,0" />
      <Function ID="4" Name="L3204" Display="'L3204'" Dmx="70~92" Colour="0,0,0" />
      <Function ID="5" Name="L3208" Display="'L3208'" Dmx="93~115" Colour="0,0,0" />
      <Function ID="6" Name="L3216" Display="'L3216'" Dmx="116~138" Colour="0,0,0" />
      <Function ID="7" Name="L3407" Display="'L3407'" Dmx="139~161" Colour="0,0,0" />
      <Function ID="8" Name="L3411" Display="'L3411'" Dmx="162~184" Colour="0,0,0" />
      <Function ID="9" Name="L3408" Display="'L3408'" Dmx="185~207" Colour="0,0,0" />
      <Function ID="10" Name="L3409" Display="'L3409'" Dmx="208~230" Colour="0,0,0" />
      <Function ID="11" Name="L3418" Display="'L3418'" Dmx="231~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Parameter_1" Name="Parameter 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Lighting_Mode'==2" />
      <Condition Name="HSI" ID="3" If="'Lighting_Mode'==3" />
      <Condition Name="RGBW" ID="4" If="'Lighting_Mode'==4" />
      <Condition Name="Tungsten" ID="5" If="'Lighting_Mode'==5" />
      <Condition Name="Fluorescent" ID="6,7,8" If="'Lighting_Mode'==8" />
      <Condition Name="Street" ID="9,10,11,12" If="'Lighting_Mode'==9" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2700~7500" Dmx="0~255" Colour="255,240,200" />
      <Function ID="3" Name="Hue" Display="'%.f°',0~360" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="5" Name="Red+" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="6" Name="Warmer" Display="'Warmer'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="7" Name="Cooler" Display="'Cooler'" Dmx="86~172" Colour="0,0,0" />
      <Function ID="8" Name="Neutral" Display="'Neutral'" Dmx="173~255" Colour="0,0,0" />
      <Function ID="9" Name="YW" Display="'YW'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="WW" Display="'WW'" Dmx="64~127" Colour="0,0,0" />
      <Function ID="11" Name="NW" Display="'NW'" Dmx="128~191" Colour="0,0,0" />
      <Function ID="12" Name="CW" Display="'CW'" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Parameter_2" Name="Parameter 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Lighting_Mode'==2" />
      <Condition Name="HSI" ID="3" If="'Lighting_Mode'==3" />
      <Condition Name="RGBW" ID="4" If="'Lighting_Mode'==4" />
      <Condition Name="Tungsten" ID="5" If="'Lighting_Mode'==5" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="GN" Display="'%.1f',-50.0~50.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="SAT" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="5" Name="Green+" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Parameter_3" Name="Parameter 3" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Lighting_Mode'==2" />
      <Condition Name="RGBW" ID="3" If="'Lighting_Mode'==4" />
      <Condition Name="Tungsten" ID="4" If="'Lighting_Mode'==5" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="3" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="4" Name="Blue+" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Parameter_4" Name="Parameter 4" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Lighting_Mode'==2" />
      <Condition Name="RGBW" ID="3" If="'Lighting_Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="3" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Parameter_5" Name="Parameter 5" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Lighting_Mode'==2" />
      <Condition Name="HSI" ID="3,4" If="'Lighting_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="3" Name="Cycle OFF" Display="'Cycle OFF'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="4" Name="Cycle Time" Display="'Cycle Time %.2f Sec',4.00~16.00" Dmx="5~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="SOS" Display="'SOS'" Dmx="255~255" />
      <Function ID="3" Name="Flashing" Display="'Flashing %.f%%',0~100" Dmx="11~110" />
      <Function ID="4" Name="Freq" Display="'Freq %.f%%',0~100" Dmx="111~210" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10" Id="3053f5b4-85c5-4302-b1bc-1d800b0d4cda">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

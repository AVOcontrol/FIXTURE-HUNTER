  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5426201b-6c7c-467d-bd7b-0735334787f5" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~115" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="136~235" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="Full RGB" Display="'Full RGB'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Colour 1" Display="'Colour 1'" Dmx="201~205" WheelPosition="1" Colour="0,0,0" />
      <Function ID="5" Name="Colour 2" Display="'Colour 2'" Dmx="206~210" WheelPosition="2" Colour="0,0,0" />
      <Function ID="6" Name="Colour 3" Display="'Colour 3'" Dmx="211~215" WheelPosition="3" Colour="0,0,0" />
      <Function ID="7" Name="Colour 4" Display="'Colour 4'" Dmx="216~220" WheelPosition="4" Colour="0,0,0" />
      <Function ID="8" Name="Colour 5" Display="'Colour 5'" Dmx="221~225" WheelPosition="5" Colour="0,0,0" />
      <Function ID="9" Name="Colour 6" Display="'Colour 6'" Dmx="226~230" WheelPosition="6" Colour="0,0,0" />
      <Function ID="10" Name="Colour 7" Display="'Colour 7'" Dmx="231~235" WheelPosition="7" Colour="0,0,0" />
      <Function ID="11" Name="Colour 8" Display="'Colour 8'" Dmx="236~240" WheelPosition="8" Colour="0,0,0" />
      <Function ID="12" Name="Colour 9" Display="'Colour 9'" Dmx="241~245" WheelPosition="9" Colour="0,0,0" />
      <Function ID="13" Name="Colour 10" Display="'Colour 10'" Dmx="246~250" WheelPosition="10" Colour="0,0,0" />
      <Function ID="14" Name="Colour 11" Display="'Colour 11'" Dmx="251~255" WheelPosition="11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="52~102" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="103~153" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="154~204" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="205~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 4 DMX" Channels="4">

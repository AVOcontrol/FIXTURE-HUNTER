<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BT-Dazzle" ShortName="BT-Dazzle" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="11-02-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~194" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="189~128" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Generic" Name="P/T Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~15" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="16~23" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="24~31" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="32~39" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="40~47" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="48~55" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="56~63" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="64~71" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="72~79" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="80~87" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="88~95" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="96~103" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="104~111" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="112~119" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="120~127" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="128~135" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="136~143" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="144~151" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="152~159" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="160~167" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="168~175" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="176~183" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="184~191" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="192~199" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="200~207" />
      <Function ID="27" Name="Macro 26" Display="'Macro 26'" Dmx="208~215" />
      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="216~223" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="224~231" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="232~239" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="240~247" />
      <Function ID="32" Name="Macro 31" Display="'Macro 31'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~69" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~24" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" Intensity="0~0" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" Intensity="0~0" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~67" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="68~127" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="128~187" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="188~247" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="90" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan_Spin" ChannelOffset="1" Wheel="20" />
        <Attribute ID="Pan" ChannelOffset="2" Wheel="2" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Control" ChannelOffset="7" Wheel="28" />
        <Attribute ID="Master_Dimmer" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
        <Attribute ID="Effect" ChannelOffset="14" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell 1" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell 1" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Cell 1" X="0" Y="2">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="Cell 1" X="0" Y="3">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="90" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan_Spin" ChannelOffset="1" Wheel="20" />
        <Attribute ID="Pan" ChannelOffset="2" Wheel="2" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
        <Attribute ID="Generic" ChannelOffset="8" Wheel="26" />
        <Attribute ID="P/T_Mac_Spd" ChannelOffset="9" Wheel="27" />
        <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
        <Attribute ID="Master_Dimmer" ChannelOffset="11" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell 2" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell 2" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Cell 2" X="0" Y="2">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="Cell 2" X="0" Y="3">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell 1" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="90" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
    </Include>
  </Mode>
  <Mode Name="Cell 2" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="90" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
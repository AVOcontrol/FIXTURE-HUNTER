      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="30~35" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="36~41" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="42~47" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="48~53" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="54~63" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="122~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="116~121" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="110~115" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="104~109" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="98~103" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="92~97" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="86~91" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="80~85" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="74~79" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="64~73" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="8~15" />

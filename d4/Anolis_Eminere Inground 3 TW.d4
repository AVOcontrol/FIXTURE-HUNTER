<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Eminere Inground 3 TW" ShortName="EmIG3TW" Company="Anolis" Version="6">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="24-05-24" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.fK',2700~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>
  <Mode Name="Mode 11 (White Selection), 3 DMX" Channels="3" Id="80a68c95-3fb7-4407-a65a-4ef0515c186f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="CTC" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode 12 (WW+CW), 4 DMX" Channels="4" Id="f2ac33a2-965e-40fe-9f83-0655cb847fb6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

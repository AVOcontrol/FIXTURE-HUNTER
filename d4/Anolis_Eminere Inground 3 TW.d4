  <Mode Name="Mode 19 (TW Pixels), 6 DMX" Channels="6" Id="e1116178-e43d-4d8e-b4ac-feea112cdcaa">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

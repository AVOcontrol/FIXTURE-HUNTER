  <History Date="23-09-19" Author="Nic Morris" Comment="Created (very poor documentation.  functions have conflicting ranges)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4238c2f6-2898-4d95-a93d-01e17bb758ba" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~253" />
      <Function ID="3" Name="Spikes" Display="'Spikes'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Dancing" Display="'Dancing'" Dmx="5~46" />
      <Function ID="3" Name="Lightning" Display="'Lightning'" Dmx="47~89" />
      <Function ID="4" Name="Random Strobe" Display="'Random Strobe'" Dmx="90~130" />
      <Function ID="5" Name="Ramp Up" Display="'Ramp Up'" Dmx="131~170" />
      <Function ID="6" Name="Ramp Up-Down" Display="'Ramp Up-Down'" Dmx="171~214" />
      <Function ID="7" Name="Ramp Down" Display="'Ramp Down'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Auto" Display="'No Auto'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect'" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sound" Display="'No Sound'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Lighting" Name="Lighting" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="No Lighting" Display="'No Lighting'" Dmx="0~0" />
      <Function ID="2" Name="Lighting" Display="'Lighting %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">

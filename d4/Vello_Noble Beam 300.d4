      <Attribute ID="Frost" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Pan" ChannelOffset="10,11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12,13" Wheel="3" />
      <Attribute ID="Lamp" ChannelOffset="14" Wheel="29" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="28" />
      <Attribute ID="PT_Speed" ChannelOffset="16" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Head">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="QolorPIX" ShortName="QolorPIX" Company="City Theatrical" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>7dc0a377-4d0e-482a-8933-b3c3b2d9d2aa</Thumbnail>
  <History Date="12-03-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="2" Name="1 Col Paparazzi (Snap)" Display="'1 Col Paparazzi (Snap)'" Dmx="1~1" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="3" Name="1 Col Paparazzi (Fade)" Display="'1 Col Paparazzi (Fade)'" Dmx="2~2" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="4" Name="2 Col Paparazzi (Snap)" Display="'2 Col Paparazzi (Snap)'" Dmx="3~3" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="5" Name="2 Col Paparazzi (Fade)" Display="'2 Col Paparazzi (Fade)'" Dmx="4~4" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="6" Name="Comet (Uniform Colour)" Display="'Comet (Uniform Colour)'" Dmx="5~5" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="7" Name="Comet (Uniform Decay)" Display="'Comet (Uniform Decay)'" Dmx="6~6" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="8" Name="Jockey" Display="'Jockey'" Dmx="7~7" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="9" Name="Checkers" Display="'Checkers'" Dmx="8~8" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="10" Name="Colour Merge" Display="'Colour Merge'" Dmx="9~9" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="11" Name="Wave (Uniform Colour)" Display="'Wave (Uniform Colour)'" Dmx="10~10" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="12" Name="Wave (Uniform Decay)" Display="'Wave (Uniform Decay)'" Dmx="11~11" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="13" Name="Sweep (Continuous)" Display="'Sweep (Continuous)'" Dmx="12~12" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="14" Name="Sweep (Random Start Delay)" Display="'Sweep (Random Start Delay)'" Dmx="13~13" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="15" Name="Index Wipe" Display="'Index Wipe'" Dmx="14~14" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="16" Name="VU (Manual)" Display="'VU (Manual)'" Dmx="15~15" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="17" Name="VU (Random Height)" Display="'VU (Random Height)'" Dmx="16~16" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="18" Name="VU (Height Index)" Display="'VU (Height Index)'" Dmx="17~17" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="19" Name="Strobe" Display="'Strobe'" Dmx="18~18" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="20" Name="Knight Rider (Uniform Colour)" Display="'Knight Rider (Uniform Colour)'" Dmx="19~19" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="21" Name="Knight Rider (Uniform Decay)" Display="'Knight Rider (Uniform Decay)'" Dmx="20~20" Update="Size, Rate_1, Rate_2, Density" />
      <Function ID="22" Name="Police Strobe" Display="'Police Strobe'" Dmx="21~21" Update="Size, Rate_1, Rate_2, Density" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Percentage" ID="2" If="'Effect'==6||'Effect'==7||'Effect'==10||'Effect'==11||'Effect'==12||'Effect'==15||'Effect'==16||'Effect'==18||'Effect'==20||'Effect'==21" />
      <Condition Name="1-13 pixels" ID="3" If="'Effect'==2||'Effect'==3||'Effect'==4||'Effect'==5||'Effect'==8" />
      <Condition Name="1-8 pixels" ID="4" If="'Effect'==13||'Effect'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Size" Display="'%.f px',1~13" Dmx="0~255" />
      <Function ID="4" Name="Size" Display="'%.f px',1~8" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Mix" Name="Colour Mix" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rate_1" Name="Rate 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Decay" ID="2" If="'Effect'==2||'Effect'==3||'Effect'==4||'Effect'==5" />
      <Condition Name="Height" ID="3" If="'Effect'==17||'Effect'==18" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Height" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rate_2" Name="Rate 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Effect'==2||'Effect'==3||'Effect'==4||'Effect'==5||'Effect'==6||'Effect'==7||'Effect'==8||'Effect'==9||'Effect'==10||'Effect'==11||'Effect'==12||'Effect'==13||'Effect'==14||'Effect'==20||'Effect'==21" />
      <Condition Name="Rate" ID="3" If="'Effect'==17||'Effect'==18" />
      <Condition Name="Strobe" ID="4" If="'Effect'==19||'Effect'==22" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Rate" Display="'%.f BPM',0~600" Dmx="0~255" />
      <Function ID="4" Name="Strobe" Display="'%.1f FPS',0.0~10.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Density" Name="Density" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Density" ID="2" If="'Effect'==2||'Effect'==3||'Effect'==4||'Effect'==5" />
      <Condition Name="Duty Cycle" ID="3" If="'Effect'==19" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Duty Cycle" Display="'%.1f%%',1.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="63~127" />
      <Function ID="3" Name="Mirror In" Display="'Mirror In'" Dmx="128~191" />
      <Function ID="4" Name="Mirror Out" Display="'Mirror Out'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Repeat" Name="Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="2x" Display="'2x'" Dmx="1~63" />
      <Function ID="2" Name="4x" Display="'4x'" Dmx="64~127" />
      <Function ID="3" Name="8x" Display="'8x'" Dmx="128~195" />
      <Function ID="4" Name="16x" Display="'16x'" Dmx="196~254" />
      <Function ID="5" Name="32x" Display="'32x'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Origin_Offset" Name="Origin Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Effect" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Size" ChannelOffset="9" Wheel="23" />
        <Attribute ID="Colour_Mix" ChannelOffset="10" Wheel="24" />
        <Attribute ID="Rate_1" ChannelOffset="11" Wheel="52" />
        <Attribute ID="Rate_2" ChannelOffset="12" Wheel="53" />
        <Attribute ID="Density" ChannelOffset="13" Wheel="54" />
        <Attribute ID="Direction" ChannelOffset="14" Wheel="82" />
        <Attribute ID="Repeat" ChannelOffset="15" Wheel="83" />
        <Attribute ID="Origin_Offset" ChannelOffset="16" Wheel="84" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="7dc0a377-4d0e-482a-8933-b3c3b2d9d2aa"></Swatch>
  </swatchLibrary>
</Fixture>
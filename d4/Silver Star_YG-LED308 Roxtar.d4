<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="YG-LED308 Roxtar" ShortName="LED 308Rox" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="10-10-08" Author="David Hunt" Comment="Created From LED 307" />
  <History Date="21-10-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="28-03-11" Author="Gregory Haynes" Comment="Changed short name from 307 to 308, added preset palettes" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Changed Magenta to Purple and used attribute ID UV.  Fixed highlight/lowlight." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Standardised compatibility attribute names and ID's.  Added pixel mapper compatibility." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Renamed 'Mode Select' functions to 'Control' and revised functions to fix to respective modes." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Added virtual dimmer.  Revised module function names.  Changed palettes from CMY to RGB." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="IDs 1-20" Display="'IDs 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="IDs 21-66" Display="'IDs 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="Purple" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Purple C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Module" />
      <Function ID="2" Name="Col Cycle 1" Display="'Col Cycle 1'" Dmx="5~34" Update="Module" />
      <Function ID="3" Name="Col Cycle 2" Display="'Col Cycle 2'" Dmx="35~64" Update="Module" />
      <Function ID="4" Name="Col Cycle 3" Display="'Col Cycle 3'" Dmx="65~94" Update="Module" />
      <Function ID="5" Name="Col Cycle 4" Display="'Col Cycle 4'" Dmx="95~124" Update="Module" />
      <Function ID="6" Name="Col Cycle 5" Display="'Col Cycle 5'" Dmx="125~154" Update="Module" />
      <Function ID="7" Name="Col Cycle 6" Display="'Col Cycle 6'" Dmx="155~184" Update="Module" />
      <Function ID="8" Name="Col Cycle 7" Display="'Col Cycle 7'" Dmx="185~214" Update="Module" />
      <Function ID="9" Name="Col Cycle 8" Display="'Col Cycle 8'" Dmx="215~244" Update="Module" />
    </Attribute>
    <Attribute ID="Module" Name="Module Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="10" If="'Control'==5" />
      <Else ID="1,2,3,4,5,6,7,8,9" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="5~34" />
      <Function ID="3" Name="2" Display="'2'" Dmx="35~64" />
      <Function ID="4" Name="3" Display="'3'" Dmx="65~94" />
      <Function ID="5" Name="1+2" Display="'1+2'" Dmx="95~124" />
      <Function ID="6" Name="2+3" Display="'2+3'" Dmx="125~154" />
      <Function ID="7" Name="1+3" Display="'1+3'" Dmx="155~184" />
      <Function ID="8" Name="All" Display="'All'" Dmx="185~214" />
      <Function ID="9" Name="All Off" Display="'All Off'" Dmx="215~255" />
      <Function ID="10" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~50" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Module_1" Name="Module 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~34" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="35~64" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="65~94" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="95~124" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="125~154" Colour="0,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="155~184" Colour="128,0,255" />
      <Function ID="8" Name="Pink-White" Display="'Pink-White'" Dmx="185~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Module_2" Name="Module 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~34" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="35~64" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="65~94" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="95~124" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="125~154" Colour="0,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="155~184" Colour="128,0,255" />
      <Function ID="8" Name="Pink-White" Display="'Pink-White'" Dmx="185~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Module_3" Name="Module 3" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~34" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="35~64" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="65~94" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="95~124" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="125~154" Colour="0,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="155~184" Colour="128,0,255" />
      <Function ID="8" Name="Pink-White" Display="'Pink-White'" Dmx="185~255" Colour="255,150,150" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved 1" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved 2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved 3" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved 4" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 2" Display="''" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~29" Colour="255,0,0" />
      <Function ID="3" Name="R85% + G15%" Display="'R85% + G15%'" Dmx="30~39" Colour="216,38,0" />
      <Function ID="4" Name="R60% + G40%" Display="'R60% + G40%'" Dmx="40~49" Colour="153,102,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="50~69" Colour="255,255,0" />
      <Function ID="6" Name="R15% + G85%" Display="'R15% + G85%'" Dmx="70~79" Colour="38,216,0" />
      <Function ID="7" Name="R40% + G60%" Display="'R40% + G60%'" Dmx="80~89" Colour="102,153,0" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="90~109" Colour="0,255,0" />
      <Function ID="9" Name="G85% + B15%" Display="'G85% + B15%'" Dmx="110~119" Colour="0,216,38" />
      <Function ID="10" Name="G60% + B40%" Display="'G60% + B40%'" Dmx="120~129" Colour="0,153,102" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="130~149" Colour="0,0,255" />
      <Function ID="12" Name="G85% + B15%" Display="'G85% + B15%'" Dmx="150~159" Colour="0,216,38" />
      <Function ID="13" Name="G60% + B40%" Display="'G60% + B40%'" Dmx="160~169" Colour="0,153,102" />
      <Function ID="14" Name="Cyan" Display="'Cyan'" Dmx="170~189" Colour="0,255,255" />
      <Function ID="15" Name="G50% + P50%" Display="'G50% + P50%'" Dmx="190~199" Colour="64,128,128" />
      <Function ID="16" Name="Purple" Display="'Purple'" Dmx="200~219" Colour="128,0,255" />
      <Function ID="17" Name="P80% + G20%" Display="'P80% + G20%'" Dmx="220~229" Colour="102,51,204" />
      <Function ID="18" Name="RGB" Display="'RGB'" Dmx="230~249" Colour="255,255,255" />
      <Function ID="19" Name="White" Display="'White'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>

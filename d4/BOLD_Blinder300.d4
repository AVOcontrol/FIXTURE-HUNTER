    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2200" PowerOn="1:2200" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2200~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>

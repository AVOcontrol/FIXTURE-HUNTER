  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="10~200" />
      <Function ID="3" Name="Random Colour" Display="'Random Colour'" Dmx="201~210" />
      <Function ID="4" Name="Auto Program" Display="'Auto Program'" Dmx="211~234" />
      <Function ID="5" Name="Auto Colour 1" Display="'Auto Colour 1'" Dmx="235~239" />
      <Function ID="6" Name="Auto Colour 2" Display="'Auto Colour 2'" Dmx="240~244" />
      <Function ID="7" Name="Auto Colour 3" Display="'Auto Colour 3'" Dmx="245~249" />

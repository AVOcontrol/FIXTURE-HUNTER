<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Fine 390 DG V2" ShortName="Fine390DG2" Company="Fine Art">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="06-08-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Program" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="26~51" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="52~77" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="78~103" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="104~129" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="130~155" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="156~181" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="182~207" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="208~233" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="234~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~18" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="19~37" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="38~56" Colour="0,0,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="57~75" Colour="255,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="76~94" Colour="255,0,255" />
      <Function ID="6" Name="Light Red" Display="'Light Red'" Dmx="95~113" Colour="255,50,50" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="114~132" Colour="0,0,255" />
      <Function ID="8" Name="Light Green" Display="'Light Green'" Dmx="133~151" Colour="0,255,255" />
      <Function ID="9" Name="Light Blue" Display="'Light Blue'" Dmx="152~170" Colour="50,50,255" />
      <Function ID="10" Name="Light Yellow" Display="'Light Yellow'" Dmx="171~189" Colour="255,255,50" />
      <Function ID="11" Name="Light Magenta" Display="'Light Magenta'" Dmx="190~208" Colour="255,50,255" />
      <Function ID="12" Name="Light Cyan" Display="'Light Cyan'" Dmx="209~227" Colour="50,255,255" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="228~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="FI_F390DG2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Colour_Macro1" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="8" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
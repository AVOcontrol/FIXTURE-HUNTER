  <History Date="25-03-21" Author="Nic Morris" Comment="Created (poor documentation. confusing. no function range details. channels only)" Version="0" />
  <History Date="25-03-21" Author="Nic Morris" Comment="(note Titan Ultimate and Utility modes dynamically change control resolution which cannot be supported - implemented as separate modes instead)" Version="0" />
  <Manual Filename="" Summary="" />

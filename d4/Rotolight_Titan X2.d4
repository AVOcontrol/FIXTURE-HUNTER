    <Attribute ID="Mode_SelectGemini" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="2" Name="HIS" Display="'HIS'" Dmx="43~85" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="3" Name="Filter" Display="'Filter'" Dmx="86~127" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="4" Name="RGBW" Display="'RGBW'" Dmx="128~170" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="5" Name="EFFECTS" Display="'EFFECTS'" Dmx="171~212" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="6" Name="PRESETS" Display="'PRESETS'" Dmx="213~255" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_1" Name="Param 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CCT (CCT/Filter/RGBW)" ID="1" If="'Mode_SelectGemini'==1||'Mode_SelectGemini'==3||'Mode_SelectGemini'==4" />
      <Condition Name="Hue (HSI)" ID="2" If="'Mode_SelectGemini'==2" />
      <Condition Name="FX Select (EFFECTS)" ID="3" If="'Mode_SelectGemini'==5" />
      <Condition Name="Preset Select (PRESETS)" ID="4" If="'Mode_SelectGemini'==6" />
      <Else ID="5" />
      <Function ID="1" Name="CCT" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="FX Select" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Preset" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_2" Name="Param 2" Description="" Group="C">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Magenta/Green (CCT)" ID="1" If="'Mode_SelectGemini'==1" />
      <Condition Name="Saturation (HIS)" ID="2" If="'Mode_SelectGemini'==2" />
      <Condition Name="FILT3-Gel#1's (Filter)" ID="3" If="'Mode_SelectGemini'==3" />
      <Condition Name="White (RGBW)" ID="4" If="'Mode_SelectGemini'==4" />
      <Condition Name="FX Param 1 (EFFECTS)" ID="5" If="'Mode_SelectGemini'==5" />
      <Condition Name="Trigger (PRESETS)" ID="6" If="'Mode_SelectGemini'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Mag/Green" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Gel 1's" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="5" Name="FX Param 1" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="6" Name="Trigger" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_3" Name="Param 3" Description="" Group="C">
      <Locate Locate="5:0" PowerOn="5:0" />
      <Condition Name="FILT2-Gel#10's (Filter)" ID="1" If="'Mode_SelectGemini'==3" />
      <Condition Name="Red (RGBW)" ID="2" If="'Mode_SelectGemini'==4" />
      <Condition Name="FX Param 2 (EFFECTS)" ID="3" If="'Mode_SelectGemini'==5" />
      <Condition Name="Factory User (PRESETS)" ID="4" If="'Mode_SelectGemini'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Gel 10's" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="3" Name="FX Param 2" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Factory" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_4" Name="Param 4" Description="" Group="C">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Green (RGBW)" ID="1" If="'Mode_SelectGemini'==4" />
      <Condition Name="FX Param 3 (EFFECTS)" ID="2" If="'Mode_SelectGemini'==5" />
      <Else ID="3" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="FX Param 3" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_5" Name="Param 5" Description="" Group="C">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Blue (RGBW)" ID="1" If="'Mode_SelectGemini'==4" />
      <Condition Name="FX Param 4 (EFFECTS)" ID="2" If="'Mode_SelectGemini'==5" />
      <Else ID="3" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="FX Param 4" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_6" Name="Param 6" Description="" Group="C">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="FX Param 5 (EFFECTS)" ID="1" If="'Mode_SelectGemini'==5" />
      <Else ID="2" />
      <Function ID="1" Name="FX Param 5" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Mode_SelectARRI" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="2" Name="HSI" Display="'HSI'" Dmx="10~19" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="3" Name="RGBW" Display="'RGBW'" Dmx="20~29" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="4" Name="GEL" Display="'GEL'" Dmx="30~39" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="5" Name="SourceMatch" Display="'SourceMatch'" Dmx="40~49" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="6" Name="XY" Display="'XY'" Dmx="50~59" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="7" Name="Effects" Display="'Effects'" Dmx="60~69" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Col_Param_1, Col_Param_2, Col_Param_3, Col_Param_4, Col_Param_5, Col_Param_6" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_1" Name="Col Param 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CCT (CCT)" ID="1" If="'Mode_SelectARRI'==1" />
      <Condition Name="Hue (HSI)" ID="2" If="'Mode_SelectARRI'==2" />
      <Condition Name="Red (RGBW)" ID="3" If="'Mode_SelectARRI'==3" />
      <Condition Name="CCT (GEL)" ID="4" If="'Mode_SelectARRI'==4" />
      <Condition Name="Category (SourceMatch)" ID="5" If="'Mode_SelectARRI'==5" />
      <Condition Name="X (XY)" ID="6" If="'Mode_SelectARRI'==6" />
      <Condition Name="FILT3-FX Select (Effects)" ID="7" If="'Mode_SelectARRI'==7" />
      <Else ID="8" />
      <Function ID="1" Name="CCT" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="4" Name="CCT" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Category" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="6" Name="X" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="FX Select" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_2" Name="Col Param 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Magenta/Green (CCT)" ID="1" If="'Mode_SelectARRI'==1" />
      <Condition Name="Saturation (HSI)" ID="2" If="'Mode_SelectARRI'==2" />
      <Condition Name="Green (RGBW)" ID="3" If="'Mode_SelectARRI'==3" />
      <Condition Name="FILT4-Colour Mode (GEL)" ID="4" If="'Mode_SelectARRI'==4" />
      <Condition Name="Source (SourceMatch)" ID="5" If="'Mode_SelectARRI'==5" />
      <Condition Name="Y (XY)" ID="6" If="'Mode_SelectARRI'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Mag/Green" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="4" Name="Colour Mode" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Source" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="6" Name="Y" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_3" Name="Col Param 3" Description="" Group="C">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Blue (RGBW)" ID="1" If="'Mode_SelectARRI'==3" />
      <Condition Name="FILT1-Gel Brand (GEL)" ID="2" If="'Mode_SelectARRI'==4" />
      <Else ID="3" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Gel Brand" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_4" Name="Col Param 4" Description="" Group="C">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="White (RGBW)" ID="1" If="'Mode_SelectARRI'==3" />
      <Condition Name="FILT2-Category (GEL)" ID="2" If="'Mode_SelectARRI'==4" />
      <Else ID="3" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="2" Name="Category" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_5" Name="Col Param 5" Description="" Group="C">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="CCT (RGBW)" ID="1" If="'Mode_SelectARRI'==3" />
      <Condition Name="FILT3-Gel Number (GEL)" ID="2" If="'Mode_SelectARRI'==4" />
      <Else ID="3" />

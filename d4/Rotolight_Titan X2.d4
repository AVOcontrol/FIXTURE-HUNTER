      <Function ID="2" Name="Gel Number" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Param_6" Name="Col Param 6" Description="" Group="C">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Magenta/Green (RGBW)" ID="1" If="'Mode_SelectARRI'==3" />

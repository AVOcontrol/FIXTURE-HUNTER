    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~169" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'All Full'" Dmx="170~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~215" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~50" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~100" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="101~150" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="151~200" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~34" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="35~49" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="50~84" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="85~109" />

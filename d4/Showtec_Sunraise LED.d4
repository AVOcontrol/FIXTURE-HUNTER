      <Function ID="21" Name="Auto" Display="'Auto'" Dmx="200~229" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~9" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="119~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="120~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5e1da27e-8157-45c1-8caf-519efab68f3a" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="40~49" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="Slow Dream" Display="'Slow Dream'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="Fast Dream" Display="'Fast Dream'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="11" Name="Col Fade" Display="'Col Fade'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="Col Change" Display="'Col Change'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="Flow 1" Display="'Flow 1'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="Flow 2" Display="'Flow 2'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="Flow 3" Display="'Flow 3'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="Flow 4" Display="'Flow 4'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="Double Flow 1" Display="'Double Flow 1'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="18" Name="Double Flow 2" Display="'Double Flow 2'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="19" Name="Multi Col" Display="'Multi Col'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="20" Name="Col Flow 1" Display="'Col Flow 1'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="21" Name="Col Flow 2" Display="'Col Flow 2'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="22" Name="Fade 1" Display="'Fade 1'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="23" Name="Fade 2" Display="'Fade 2'" Dmx="220~229" Colour="255,255,255" />
      <Function ID="24" Name="Fade 3" Display="'Fade 3'" Dmx="230~239" Colour="255,255,255" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ZStrip 240" ShortName="ZStrip 240" Company="Pro Light" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="29-03-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~30" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~61" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="62~92" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="93~123" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="124~154" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="155~185" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="186~216" Colour="0,255,255" />
      <Function ID="9" Name="White (RGBW)" Display="'White (RGBW)'" Dmx="217~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~28" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="29~37" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="38~46" />
      <Function ID="5" Name="White" Display="'White'" Dmx="47~55" />

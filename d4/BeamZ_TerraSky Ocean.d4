  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="3" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="140~209" />
      <Function ID="3" Name="DMX" Display="'DMX'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">

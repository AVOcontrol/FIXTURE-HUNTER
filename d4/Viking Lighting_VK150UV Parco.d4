      <Function ID="23" Name="Delay 6.0s" Display="'Delay 6.0s'" Dmx="136~136" />
      <Function ID="24" Name="Delay 7.0s" Display="'Delay 7.0s'" Dmx="137~137" />
      <Function ID="25" Name="Delay 8.0s" Display="'Delay 8.0s'" Dmx="138~138" />
      <Function ID="26" Name="Delay 9.0s" Display="'Delay 9.0s'" Dmx="139~139" />

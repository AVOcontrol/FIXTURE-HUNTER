  <History Date="23-07-21" Author="Nic Morris" Comment="Created (note chart column headers have 1,2,3 and 5 channel but 5 channel only lists 4)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="4" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="5" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="6" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="7" Name="Stage2" Display="'Stage2'" Dmx="101~120" />
      <Function ID="8" Name="Delay 0.1s" Display="'Delay 0.1s'" Dmx="121~121" />

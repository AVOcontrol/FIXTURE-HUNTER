    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Undefined" Display="'Undefined'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="C-Mix" Display="'C-Mix'" Dmx="1~4" Colour="0,0,0" />
      <Function ID="3" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">

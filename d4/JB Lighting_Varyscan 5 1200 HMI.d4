    <Attribute ID="Gobo11" Name="Gobo 1" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Gobo1Rot1" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

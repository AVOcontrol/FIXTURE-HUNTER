      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~190" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo3Func" Name="Gobo 3 Func" Description="" Group="G" Size="0">

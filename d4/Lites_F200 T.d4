    <AtlaBase ModeID="9cab00c2-49c0-4140-a267-fe0f7be06ca7" />
    <Include>
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="3 DMX (Dimmer)" Channels="3">
    <Import PearlRef="UKLIF2T3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

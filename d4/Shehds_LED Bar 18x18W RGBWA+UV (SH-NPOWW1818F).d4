      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="106~120" Update="8/16bit" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~135" Update="8/16bit" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="136~150" Update="8/16bit" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="151~165" Update="8/16bit" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="166~180" Update="8/16bit" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="181~195" Update="8/16bit" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="196~210" Update="8/16bit" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="211~225" Update="8/16bit" />
      <Function ID="17" Name="Colour Mode" Display="'Colour Mode'" Dmx="226~240" Update="8/16bit" />
      <Function ID="18" Name="Sound Mode" Display="'Sound Mode'" Dmx="241~255" Update="8/16bit" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="8/16bit" Name="8/16bit" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Auto" ID="3,4" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;17" />
      <Function ID="1" Name="16BT" Display="'16BT'" Dmx="0~0" />
      <Function ID="2" Name="8BT" Display="'8BT'" Dmx="255~255" />
      <Function ID="3" Name="8BT" Display="'8BT'" Dmx="0~0" />
      <Function ID="4" Name="16BT" Display="'16BT'" Dmx="255~255" />
    </Attribute>

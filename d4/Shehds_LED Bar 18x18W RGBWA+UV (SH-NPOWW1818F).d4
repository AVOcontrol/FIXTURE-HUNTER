  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="8/16bit" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="2~15" Update="8/16bit" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="16~30" Update="8/16bit" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="31~45" Update="8/16bit" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="46~60" Update="8/16bit" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~75" Update="8/16bit" />

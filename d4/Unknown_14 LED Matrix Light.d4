<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="14 LED Matrix Light" ShortName="14 LED Mtx" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="01-03-19" Author="Nic Morris" Comment="Created (very poor documentation.  conflicting ranges and charts have a 'total dimmer' and 'brightness' control.  no idea)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Brightness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="15~29" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="30~44" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="45~59" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="60~74" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="75~89" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="90~104" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="105~119" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="120~134" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="135~149" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="150~164" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="165~179" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="180~194" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="195~209" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="210~224" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="225~239" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="6" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Brightness" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
    </Include>
  </Mode>

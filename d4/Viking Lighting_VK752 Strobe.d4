    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="21~255" Intensity="0~0" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="11~20" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~10" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="19~5" Intensity="0~0" />
      <Function ID="3" Name="Pulse 1" Display="'Pulse 1 %.f%%',0~100" Dmx="25~20" Intensity="0~0" />
      <Function ID="4" Name="Pulse 2" Display="'Pulse 2 %.f%%',0~100" Dmx="51~31" Intensity="0~0" />

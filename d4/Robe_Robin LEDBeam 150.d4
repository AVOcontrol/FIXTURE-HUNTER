  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:45" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:19" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Control:20" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>

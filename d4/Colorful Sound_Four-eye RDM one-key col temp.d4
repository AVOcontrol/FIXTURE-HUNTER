  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Days Cold" Display="'Days Cold'" Dmx="6~15" />
      <Function ID="3" Name="Degrees Warm" Display="'Degrees Warm'" Dmx="16~30" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="31~45" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="46~60" />
      <Function ID="6" Name="White 1+White 2" Display="'White 1+White 2'" Dmx="61~75" />
      <Function ID="7" Name="Warm White 1" Display="'Warm White 1'" Dmx="76~90" />
      <Function ID="8" Name="Warm White 2" Display="'Warm White 2'" Dmx="91~105" />
      <Function ID="9" Name="Warm White 1+Warm White 2" Display="'Warm White 1+Warm White 2'" Dmx="106~120" />
      <Function ID="10" Name="White 1+Warm White 1" Display="'White 1+Warm White 1'" Dmx="121~135" />
      <Function ID="11" Name="White 2+Warm White 2" Display="'White 2+Warm White 2'" Dmx="136~150" />
      <Function ID="12" Name="White 1+Warm White 2" Display="'White 1+Warm White 2'" Dmx="151~165" />
      <Function ID="13" Name="White 2+Warm White 1" Display="'White 2+Warm White 1'" Dmx="166~180" />
      <Function ID="14" Name="Jump" Display="'Jump'" Dmx="181~195" />
      <Function ID="15" Name="Gradient" Display="'Gradient'" Dmx="196~209" />
      <Function ID="16" Name="Flash" Display="'Flash'" Dmx="210~225" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

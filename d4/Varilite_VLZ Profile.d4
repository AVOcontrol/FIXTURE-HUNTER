    <Attribute ID="Blade_LB" Name="Frame 4A" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_LT" Name="Frame 4B" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_All_Rot" Name="Frame Rot" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.2f°',-90.00~90.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="6~10" Update="Prism_Rot" />
      <Function ID="3" Name="Rotate" Display="'Rotate'" Dmx="11~15" Update="Prism_Rot" />
      <Function ID="4" Name="Mega Step" Display="'Mega Step'" Dmx="16~20" Update="Prism_Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Prism'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==3||'Prism'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Light Diffusion" Display="'Light Diffusion'" Dmx="51~100" />
      <Function ID="3" Name="Heavy Frost" Display="'Heavy Frost'" Dmx="101~150" />
      <Function ID="4" Name="Diffusion+Frost" Display="'Diffusion+Frost'" Dmx="151~200" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="4~6" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="7~32" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="33~58" />
      <Function ID="5" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="59~84" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="85~110" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="111~136" />
      <Function ID="8" Name="Rnd Op Sync" Display="'Rnd Op Sync %.f%%',0~100" Dmx="137~162" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="163~188" />
      <Function ID="10" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="189~214" />
      <Function ID="11" Name="Rnd Cl Sync" Display="'Rnd Cl Sync %.f%%',0~100" Dmx="215~240" />
    </Attribute>
    <Attribute ID="Focus_Speed" Name="Focus Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Optics_Speed" Name="Optics Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Beam_Speed" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gobo_Speed" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="6~10" />
      <Function ID="3" Name="Shutdown" Display="'Shutdown'" Dmx="21~25" />
      <Function ID="4" Name="Display ON" Display="'Display ON'" Dmx="26~30" />
      <Function ID="5" Name="Display OFF" Display="'Display OFF'" Dmx="31~35" />
      <Function ID="6" Name="Reset P/T" Display="'Reset P/T'" Dmx="36~40" />
      <Function ID="7" Name="Reset Col" Display="'Reset Col'" Dmx="41~45" />
      <Function ID="8" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="46~50" />
      <Function ID="9" Name="Reset Beam" Display="'Reset Beam'" Dmx="51~55" />
      <Function ID="10" Name="Reset Optics" Display="'Reset Optics'" Dmx="56~60" />
      <Function ID="11" Name="Reset Defaults" Display="'Reset Defaults'" Dmx="66~70" />
      <Function ID="12" Name="Reboot" Display="'Reboot'" Dmx="71~75" />
      <Function ID="13" Name="Status On/Off" Display="'Status On/Off'" Dmx="76~80" />
      <Function ID="14" Name="Standard Mode" Display="'Standard Mode'" Dmx="81~85" />
      <Function ID="15" Name="Studio Mode" Display="'Studio Mode'" Dmx="86~90" />
      <Function ID="16" Name="Reset Int" Display="'Reset Int'" Dmx="61~65" />
    </Attribute>
  </Control>

      <Function ID="5" Name="Snap" Display="'Snap'" Dmx="128~137" />
      <Function ID="6" Name="Fade over Full" Display="'Fade over Full %.f%%',0~100" Dmx="138~191" />
    </Attribute>
    <Attribute ID="Mix_Priority" Name="Mix Priority" Description="" Group="S">

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="196c8072-5363-4879-9932-3d21c966a159" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="6~95" Colour="255,255,255" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="96~110" Colour="255,255,255" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="111~125" Colour="255,255,255" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="126~140" Colour="255,255,255" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="141~155" Colour="255,255,255" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5 %.f%%',0~100" Dmx="156~170" Colour="255,255,255" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6 %.f%%',0~100" Dmx="171~185" Colour="255,255,255" />
      <Function ID="9" Name="Auto 7" Display="'Auto 7 %.f%%',0~100" Dmx="186~200" Colour="255,255,255" />
      <Function ID="10" Name="Auto 8" Display="'Auto 8 %.f%%',0~100" Dmx="201~215" Colour="255,255,255" />
      <Function ID="11" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="216~230" Colour="255,255,255" />
      <Function ID="12" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="231~245" Colour="255,255,255" />
      <Function ID="13" Name="No Function" Display="'No Function'" Dmx="246~254" Colour="255,255,255" />
      <Function ID="14" Name="Reset" Display="'Reset'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="SACYC601" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

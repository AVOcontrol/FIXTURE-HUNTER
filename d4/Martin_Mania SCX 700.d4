      <Function ID="26" Name="Slow" Display="'Slow'" Dmx="251~255" Colour="255,255,255" />
      <Function ID="27" Name="Med" Display="'Med'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="28" Name="Fast" Display="'Fast'" Dmx="240~245" Colour="255,255,255" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1,Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1,Gobo1Rot" />

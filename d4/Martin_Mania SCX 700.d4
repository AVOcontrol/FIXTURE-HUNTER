  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Shutter" ID="1,2,3,4,5" If="'Shutter_Func'==1" />
      <Condition Name="Control" ID="6,7,8,9" If="'Shutter_Func'==2" />
      <Else ID="10" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="104~151" Intensity="0~0" />
      <Function ID="5" Name="Music" Display="'Music'" Dmx="160~199" Intensity="0~0" />

  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~5" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="6~10" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Op Pulse" Display="'Op Pulse %.f%%',0~100" Dmx="11~51" Iris="0~0" Zoom="0~0" />

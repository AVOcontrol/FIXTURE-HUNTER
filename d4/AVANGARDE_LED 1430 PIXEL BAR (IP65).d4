  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~16" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="17~27" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="28~38" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="39~49" />

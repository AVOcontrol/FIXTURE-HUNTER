      <Function ID="8" Name="White" Display="'White'" Dmx="72~82" />
      <Function ID="9" Name="Effect 1" Display="'Effect 1'" Dmx="83~93" />
      <Function ID="10" Name="Effect 2" Display="'Effect 2'" Dmx="94~104" />
      <Function ID="11" Name="Effect 3" Display="'Effect 3'" Dmx="105~115" />
      <Function ID="12" Name="Effect 4" Display="'Effect 4'" Dmx="116~126" />
      <Function ID="13" Name="Effect 5" Display="'Effect 5'" Dmx="127~137" />
      <Function ID="14" Name="Effect 6" Display="'Effect 6'" Dmx="138~148" />
      <Function ID="15" Name="Effect 7" Display="'Effect 7'" Dmx="149~159" />
      <Function ID="16" Name="Effect 8" Display="'Effect 8'" Dmx="160~170" />
      <Function ID="17" Name="Effect 1-8" Display="'Effect 1-8'" Dmx="171~181" />
      <Function ID="18" Name="Red Pulse" Display="'Red Pulse'" Dmx="182~192" />
      <Function ID="19" Name="Green Pulse" Display="'Green Pulse'" Dmx="193~203" />
      <Function ID="20" Name="Blue Pulse" Display="'Blue Pulse'" Dmx="204~214" />

  <AtlaBase TypeID="6ba2475a-3193-4097-99fa-a2049d459313" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Static" ID="2" If="'Control'==2" />
      <Condition Name="Speed" ID="3" If="'Control'&gt;2&amp;&amp;'Control'&lt;13" />
      <Condition Name="Sensitivity" ID="4" If="'Control'==13" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="1~22" Update="Red" />
      <Function ID="3" Name="Gradual 1" Display="'Gradual 1'" Dmx="23~45" Update="Red" />
      <Function ID="4" Name="Gradual 2" Display="'Gradual 2'" Dmx="46~68" Update="Red" />
      <Function ID="5" Name="Jump 1" Display="'Jump 1'" Dmx="69~91" Update="Red" />
      <Function ID="6" Name="Jump 2" Display="'Jump 2'" Dmx="92~114" Update="Red" />
      <Function ID="7" Name="Fantasy 1" Display="'Fantasy 1'" Dmx="115~137" Update="Red" />
      <Function ID="8" Name="Fantasy 2" Display="'Fantasy 2'" Dmx="138~160" Update="Red" />
      <Function ID="9" Name="Red Gradual" Display="'Red Gradual'" Dmx="161~183" Update="Red" />
      <Function ID="10" Name="Green Gradual" Display="'Green Gradual'" Dmx="184~206" Update="Red" />
      <Function ID="11" Name="Blue Gradual" Display="'Blue Gradual'" Dmx="207~229" Update="Red" />
      <Function ID="12" Name="While Gradual" Display="'While Gradual'" Dmx="230~252" Update="Red" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="253~255" Update="Red" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>

    <Attribute ID="Gobo2Rot1" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func1'==1||'Gobo2Func1'==3||'Gobo2Func1'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func1'==2||'Gobo2Func1'==4||'Gobo2Func1'==6" />
      <Else ID="6" />

    </Attribute>
    <Attribute ID="Gobo21" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func1'==1||'Gobo2Func1'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo2Func1'==3||'Gobo2Func1'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo2Func1'==5||'Gobo2Func1'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="L350 RGB-F" ShortName="L350 RGB-F" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Pattern/Folder, Shutter/File" />
      <Function ID="2" Name="PRG Mode" Display="'PRG Mode'" Dmx="10~49" Update="Pattern/Folder, Shutter/File" />
      <Function ID="3" Name="ILD Mode" Display="'ILD Mode'" Dmx="50~99" Update="Pattern/Folder, Shutter/File" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="100~149" Update="Pattern/Folder, Shutter/File" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="150~199" Update="Pattern/Folder, Shutter/File" />
      <Function ID="6" Name="Manual" Display="'Manual'" Dmx="200~255" Update="Pattern/Folder, Shutter/File" />
    </Attribute>
    <Attribute ID="Pattern/Folder" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="PRG/ILD" ID="2" If="'Mode'==2||'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter/File" Name="Shutter/File" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="PRG/ILD" ID="4" If="'Mode'==2||'Mode'==3" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" />
      <Function ID="4" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto Circle" Display="'Auto Circle %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Jump Circle" Display="'Jump Circle %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound Jump" Display="'Sound Jump %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto Circle" Display="'Auto Circle %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Jump Circle" Display="'Jump Circle %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Auto Jump" Display="'Auto Jump %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound Jump" Display="'Sound Jump %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.f%%',0~100" Dmx="1~87" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="88~150" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="X-Roll" Name="X-Roll" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Y-Roll" Name="Y-Roll" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Z-Roll" Name="Z-Roll" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="129~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="0~74" />
      <Function ID="2" Name="Auto +" Display="'Auto + %.f%%',0~100" Dmx="75~104" />
      <Function ID="3" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="105~144" />
      <Function ID="4" Name="Auto Circle" Display="'Auto Circle %.f%%',0~100" Dmx="145~184" />
      <Function ID="5" Name="Auto -" Display="'Auto - %.f%%',0~100" Dmx="185~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small'" Dmx="10~69" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="70~129" />
      <Function ID="4" Name="Big" Display="'Big'" Dmx="130~189" />
      <Function ID="5" Name="Biggest" Display="'Biggest'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Light Dot" Display="'Light Dot'" Dmx="64~127" />
      <Function ID="3" Name="Segment" Display="'Segment'" Dmx="128~191" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="35~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="WRGB" Display="'WRGB'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="BRPC" Display="'BRPC'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="WRGBYPC" Display="'WRGBYPC'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="WRGB" Display="'WRGB'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="BYPC" Display="'BYPC'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="RGBYPCW" Display="'RGBYPCW'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Subsection" Display="'Subsection'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="UKHYL350" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern/Folder" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Shutter/File" ChannelOffset="3" Wheel="4" />
      <Attribute ID="X-Move" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Y-Move" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="X-Roll" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Y-Roll" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Z-Roll" ChannelOffset="9" Wheel="49" />
      <Attribute ID="Drawing" ChannelOffset="10" Wheel="5" />
      <Attribute ID="X-Wave" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Y-Wave" ChannelOffset="12" Wheel="23" />
      <Attribute ID="Display_Mode" ChannelOffset="13" Wheel="6" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
    </Include>
  </Mode>
</Fixture>
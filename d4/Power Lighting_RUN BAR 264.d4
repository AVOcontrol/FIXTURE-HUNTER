    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Static Col" ID="2" If="'Auto'==2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;32" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Colour" Name="Auto Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="29~56" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="57~85" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="86~113" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="114~142" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="143~170" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="171~199" />
      <Function ID="8" Name="White" Display="'White'" Dmx="200~227" />
      <Function ID="9" Name="Auto RGB" Display="'Auto RGB'" Dmx="228~255" />
    </Attribute>
    <Attribute ID="Auto_Red" Name="Auto Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Pixel Bar 19x9W" ShortName="PixBar19x9" Company="StageStar">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="09-04-18" Author="Nic Morris" Comment="Created (note Russian documentation shows pixel component order as RBG)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Pixels" Display="'Pixels'" Dmx="48~63" />
      <Function ID="3" Name="Chases" Display="'Chases'" Dmx="64~79" />
      <Function ID="4" Name="Running" Display="'Running'" Dmx="80~95" />
      <Function ID="5" Name="Jumping" Display="'Jumping'" Dmx="96~111" />
      <Function ID="6" Name="Shifts" Display="'Shifts'" Dmx="112~127" />
      <Function ID="7" Name="Groups" Display="'Groups'" Dmx="128~143" />
      <Function ID="8" Name="Figure 1" Display="'Figure 1'" Dmx="144~159" />
      <Function ID="9" Name="Figure 2" Display="'Figure 2'" Dmx="160~175" />
      <Function ID="10" Name="Figure 3" Display="'Figure 3'" Dmx="176~191" />
      <Function ID="11" Name="Figure 4" Display="'Figure 4'" Dmx="192~207" />
      <Function ID="12" Name="Figure 5" Display="'Figure 5'" Dmx="208~223" />
      <Function ID="13" Name="Figure 6" Display="'Figure 6'" Dmx="224~239" />
      <Function ID="14" Name="All Programs" Display="'All Programs'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>

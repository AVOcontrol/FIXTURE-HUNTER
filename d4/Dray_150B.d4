      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="140~153" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="154~167" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="168~181" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="182~195" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="196~209" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="210~223" WheelPosition="15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="224~237" WheelPosition="16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="238~255" WheelPosition="17" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />

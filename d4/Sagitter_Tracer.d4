  <History Date="23-06-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-06-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="60c23691-12bf-49c2-8b7c-0bf48603a21e" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Colour1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~34" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="47~55" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="66~76" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="87~95" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="107~117" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="128~136" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="147~157" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~24" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="35~46" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="56~65" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="77~86" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="96~106" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="117~127" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="137~146" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="158~168" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="169~255" Colour="0,0,0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Correction" Name="Col Correction" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="50~99" Colour="255,240,200" />
      <Function ID="3" Name="Frost" Display="'Frost'" Dmx="100~149" Colour="0,0,0" />
      <Function ID="4" Name="CTB" Display="'CTB'" Dmx="150~199" Colour="230,230,255" />
      <Function ID="5" Name="Frost" Display="'Frost'" Dmx="200~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="135~243" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="100~100" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~75" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="114~140" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="181~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="321632d1-db93-4988-a87b-88f888f71eea">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a7703674-1804-41c1-9028-21dc0b764d60" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Col_Correction" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Iris" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Focus" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="100" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="21000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="b19737af-48d9-4cde-9b90-0df7f7ec7ef4"></Swatch>
  </swatchLibrary>
</Fixture>
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~49" />
      <Function ID="2" Name="Auto Beam" Display="'Auto Beam'" Dmx="50~99" />
      <Function ID="3" Name="Auto Anim" Display="'Auto Anim'" Dmx="100~149" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Color Change" Display="'Color Change %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern_Sel" Name="Pattern Sel" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

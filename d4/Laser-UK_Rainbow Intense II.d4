      <Function ID="2" Name="Up - Down" Display="'Up - Down %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Down - Up" Display="'Down - Up %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Move_X" Name="Move X" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Left - Right" Display="'Left - Right %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Right - Left" Display="'Right - Left %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Rot_X" Name="Rot X" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Rot_Y" Name="Rot Y" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Rot_Z" Name="Rot Z" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Small - Big" Display="'Small - Big %.f%%',0~100" Dmx="1~85" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Big - Small" Display="'Big - Small %.f%%',0~100" Dmx="86~170" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Auto Zoom" Display="'Auto Zoom %.f%%',0~100" Dmx="171~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Size" Name="Pattern Size" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Spot_and_Line" Name="Spot and Line" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

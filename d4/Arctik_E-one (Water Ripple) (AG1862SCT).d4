      <Function ID="7" Name="6000Hz" Display="'6000Hz'" Dmx="181~190" />
      <Function ID="8" Name="25000Hz" Display="'25000Hz'" Dmx="191~200" />
      <Function ID="9" Name="Reset All" Display="'Reset All'" Dmx="201~210" />
      <Function ID="10" Name="Reset Colour" Display="'Reset Colour'" Dmx="211~220" />
      <Function ID="11" Name="Reset Water Ripple" Display="'Reset Water Ripple'" Dmx="231~240" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 8 DMX" Channels="8" Id="620eafef-4acc-4117-8ac1-4065309d3e2d">

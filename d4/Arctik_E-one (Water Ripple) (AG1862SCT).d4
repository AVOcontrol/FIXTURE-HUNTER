      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd Off" Display="'Dim Spd Off'" Dmx="101~110" />
      <Function ID="3" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="111~120" />

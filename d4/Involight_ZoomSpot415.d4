      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d801a5c1-a36f-4161-8955-a5e63702f044" />
    <Include>
      <Attribute ID="Zoom" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="9 DMX" Channels="9">

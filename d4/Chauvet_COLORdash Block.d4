<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORdash Block" ShortName="COLORdshBK" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="07-09-09" Author="David Hunt" Comment="Created from Quad" />
  <History Date="11-06-10" Author="Gregory Haynes" Comment="Fixed Else condition" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution.  Standardised func names." />
  <History Date="19-06-11" Author="Nic Morris" Comment="Added Control_Func to macros.  Added v-dim.  Added pixel mapper compatibility." />
  <History Date="25-08-11" Author="Nic Morris" Comment="Added white channel to Stage 1 in response to customer bug report." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID to ARC1 +D mode." />
  <History Date="21-08-16" Author="Nic Morris" Comment="Revised block functions." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="455fe207-9e5a-46d2-8b56-2e603c5de05e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="20~39" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="40~59" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="60~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="80~99" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="CTO" Display="'CTO'" Dmx="100~119" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CTO" ID="2,3,4,5,6,7,8" If="'Colour1Func'==2||'Colour1Func'==6" />
      <Condition Name="Scroll" ID="9" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="10,11,12,13,14,15" If="'Colour1Func'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2000~2700" Dmx="0~223" Colour="255,255,255" />
      <Function ID="3" Name="White 2700K" Display="'White 2700K'" Dmx="224~228" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="229~233" Colour="255,255,255" />

  <History Date="06-07-15" Author="Nic Morris" Comment="Created" />
  <History Date="26-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="13-12-18" Author="Nic Morris" Comment="Added product thumbnail.  Added v1.5 mode." />
  <History Date="14-12-18" Author="Nic Morris" Comment="Added Atlabase ID for 7 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d7947d07-d57c-47aa-b192-9fa0cfabc8b4" />
  <Control>
    <Attribute ID="Smoke" Name="Smoke" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="1~10" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="31~40" Colour="255,255,255" />
      <Function ID="6" Name="B Strobe" Display="'B Strobe'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="7" Name="R Strobe" Display="'R Strobe'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="8" Name="G Strobe" Display="'G Strobe'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="9" Name="B Fade" Display="'B Fade'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="10" Name="R Fade" Display="'R Fade'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="11" Name="G Fade" Display="'G Fade'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="12" Name="B/R/G Fade" Display="'B/R/G Fade'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="13" Name="Col Change" Display="'Col Change %.1f%%',0.0~100.0" Dmx="111~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX (v1.1)" Channels="4">
    <Import PearlRef="UKBZS2K4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4beeb96e-4bed-471d-9007-ca69a8d27a80" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Smoke" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Reserved" ChannelOffset="2" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="7 DMX (v1.5)" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cb38ca86-9f32-44f5-8a93-dbcf9781265d" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Auto" Wheel="22" />
        <Attribute ID="Smoke" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Fog cell" X="0" Y="0">
        <AttributeLink SourceId="Smoke" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="LED" ChannelOffset="2" ModeLink="LED cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Auto" TargetId="Auto" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Fog cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="LED cell" Channels="6" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Auto" ChannelOffset="6" Wheel="22" />
    </Include>
  </Mode>

      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW'" Dmx="64~71" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="72~79" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="80~87" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="88~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="96~103" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="104~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="112~119" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="120~127" GoboSpin="0~0" GoboOrientation="0~0" />

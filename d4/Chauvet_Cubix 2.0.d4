      <Attribute ID="Side_Colours" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Side_Rotate" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Middle_Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Middle_Speed" ChannelOffset="5" Wheel="23" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c5cc52e7-0fdf-4ef0-be91-68df900e92c5" />
  <Control>
    <Attribute ID="Side_Colours" Name="Side Colours" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~28" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="29~56" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="57~84" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="85~112" Colour="0,255,255" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="113~140" Colour="128,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="141~168" Colour="255,255,0" />
      <Function ID="8" Name="White" Display="'White'" Dmx="169~197" Colour="255,255,255" />
      <Function ID="9" Name="3 Colours" Display="'3 Colours'" Dmx="198~224" Colour="255,255,255" />
      <Function ID="10" Name="7 Colours" Display="'7 Colours'" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Side_Shutter" Name="Side Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Side_Rotate" Name="Side Rotate" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Bounce" Display="'Bounce %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Middle_Auto" Name="Middle Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="15~255" />
    </Attribute>
    <Attribute ID="Middle_Speed" Name="Middle Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Middle_Shutter" Name="Middle Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Generic2" Name="All Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="10~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="CHCUBIX2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

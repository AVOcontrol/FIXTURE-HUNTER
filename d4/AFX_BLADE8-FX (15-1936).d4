      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="177~186" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="187~196" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="197~206" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="207~216" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="217~226" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="227~236" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="237~246" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

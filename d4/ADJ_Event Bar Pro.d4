  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="2" />
  <History Date="06-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID to 17 DMX mode (was missing in Capture library)." Version="3" />
  <History Date="13-10-17" Author="Nic Morris" Comment="Added missing numbers to show functions.  Added compatibility for R20 export." Version="4" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Event Bar Pro.d4 to ADJ_Event Bar Pro.d4." Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="75012922-226f-47c0-8790-13c45a8545ab" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shows" Name="Shows" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Show_Speed" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" Update="Show_Speed" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" Update="Show_Speed" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" Update="Show_Speed" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" Update="Show_Speed" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" Update="Show_Speed" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" Update="Show_Speed" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" Update="Show_Speed" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" Update="Show_Speed" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~254" Update="Show_Speed" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="255~255" Update="Show_Speed" />
    </Attribute>
    <Attribute ID="Show_Speed" Name="Show Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Shows'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Pan1" Name="Pan 1" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

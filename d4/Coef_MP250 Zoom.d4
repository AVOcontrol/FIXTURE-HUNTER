<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MP250 Zoom" ShortName="MP250 Zm" Company="Coef">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="16-06-05" Author="Phil Rogers" Comment="Created" />
  <History Date="13-07-05" Author="Phil Rogers" Comment="Added 7 DMX mode for Alan King" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo ID to Gobo1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated GoboRot ID to Gobo1Rot" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Macros" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-04-17" Author="Nic Morris" Comment="Changed name from MP 250 Zoom to MP250 Zoom.  Increased wheel resolution." />
  <History Date="21-04-17" Author="Nic Morris" Comment="Standardised conditionals.  Fixed colour func updates.  Fixed duplicate functions in else conditions." />
  <History Date="21-04-17" Author="Nic Morris" Comment="Added palettes.  Changed physical type from moving mirror to moving head and added pan/tilt limits." />
  <History Date="21-04-17" Author="Nic Morris" Comment="Revised dimmer and shutter for HTP compatibility.  Added function index.  Added highlight/lowlight." />
  <History Date="21-04-17" Author="Nic Morris" Comment="Swapped spin and index gobos.  Fixed gobo reduction range.  Revised macros." />
  <History Date="21-04-17" Author="Nic Morris" Comment="Added missing Gobo Func to 9 DMX Col Mode 1" />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added missing Atlabase ID's for separate colour modes (cannot find documentation for 7 DMX mode)." />
  <History Date="25-04-17" Author="Nic Morris" Comment="Fixed 8 DMX dimmer (changed from fixed to variable)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="41be2e47-dc58-4492-97bc-46a0c477ce61" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />

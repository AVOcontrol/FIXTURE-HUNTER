    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="11~37" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="38~64" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="65~91" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="92~118" />

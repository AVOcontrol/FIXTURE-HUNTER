      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Stop" Display="'Stop'" Dmx="126~128" Colour="255,255,255" />
      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="129~192" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f Hz',0.0~30.0" Dmx="11~250" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />

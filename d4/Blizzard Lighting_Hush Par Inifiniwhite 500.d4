<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hush Par Inifiniwhite 500" ShortName="HPar IW500" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~31" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" />
      <Function ID="5" Name="Gradual" Display="'Gradual'" Dmx="128~159" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="160~191" />
      <Function ID="7" Name="Jump" Display="'Jump'" Dmx="192~223" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Saturation" Display="'Saturation %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="32-Bit_Dim" Name="32-Bit Dim" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~5" />
      <Function ID="2" Name="Mode 0" Display="'Mode 0'" Dmx="6~55" />
      <Function ID="3" Name="Mode 1" Display="'Mode 1'" Dmx="56~105" />
      <Function ID="4" Name="Mode 2" Display="'Mode 2'" Dmx="106~155" />
      <Function ID="5" Name="Mode 3" Display="'Mode 3'" Dmx="156~205" />
      <Function ID="6" Name="Mode 4" Display="'Mode 4'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKBL5008" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="ColdWhite" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Saturation" ChannelOffset="7" Wheel="38" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="32-Bit_Dim" ChannelOffset="8" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="UKBL5007" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="ColdWhite" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Saturation" ChannelOffset="7" Wheel="38" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="UKBL5006" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="ColdWhite" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKBL5003" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Amber" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
</Fixture>
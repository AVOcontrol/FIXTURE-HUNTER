  <History Date="18-05-21" Author="Nic Morris" Comment="Added Atlabase ID's (note only rotating gobos can be simulated in gobo at the time of writing)" Version="1" />
  <History Date="01-07-21" Author="Nic Morris" Comment="Changed name from AQUARIUS (XL-300 BEAM IP) to KRAKEN (XL-300 BEAM IP) (original information was incorrect)" Version="2" />
  <History Date="25-11-21" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request.  Significantly different.  Low resolution gobo images." Version="3" />

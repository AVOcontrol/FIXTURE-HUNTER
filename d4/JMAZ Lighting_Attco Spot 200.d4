      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="195~204" WheelPosition="7">
        <Swatch>17f53bb5-ffc2-4a6a-8da7-ef9c612b318a</Swatch>

      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="155~164" WheelPosition="3">
        <Swatch>4c3439c5-4294-4699-8df2-04ffc74306e5</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="165~174" WheelPosition="4">
        <Swatch>d2b65b6c-0d26-4a77-a0e8-f792fe0f636b</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="175~184" WheelPosition="5">
        <Swatch>5d101cd9-49d4-4bd8-8dc4-aea8cbe35412</Swatch>

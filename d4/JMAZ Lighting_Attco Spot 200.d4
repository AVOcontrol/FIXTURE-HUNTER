      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="30~44" WheelPosition="2">
        <Swatch>955d9e35-12e0-43b7-ac01-6f8055fce84c</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="45~59" WheelPosition="3">
        <Swatch>4c3439c5-4294-4699-8df2-04ffc74306e5</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="60~74" WheelPosition="4">

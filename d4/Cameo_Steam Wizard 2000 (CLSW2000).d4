  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a7e97c30-21be-4108-be70-aacda44fd136" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="14~21" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="22~29" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="30~37" Colour="255,100,0" />
      <Function ID="6" Name="Red-Green" Display="'Red-Green'" Dmx="38~45" Colour="255,255,255" />
      <Function ID="7" Name="Red-Blue" Display="'Red-Blue'" Dmx="46~53" Colour="255,255,255" />
      <Function ID="8" Name="Red-Amber" Display="'Red-Amber'" Dmx="54~61" Colour="255,255,255" />
      <Function ID="9" Name="Green-Blue" Display="'Green-Blue'" Dmx="62~69" Colour="255,255,255" />
      <Function ID="10" Name="Green-Amber" Display="'Green-Amber'" Dmx="70~77" Colour="255,255,255" />
      <Function ID="11" Name="Blue-Amber" Display="'Blue-Amber'" Dmx="78~85" Colour="255,255,255" />
      <Function ID="12" Name="Red-Green-Blue" Display="'Red-Green-Blue'" Dmx="86~93" Colour="255,255,255" />
      <Function ID="13" Name="Red-Green-Amber" Display="'Red-Green-Amber'" Dmx="94~101" Colour="255,255,255" />
      <Function ID="14" Name="Red-Blue-Amber" Display="'Red-Blue-Amber'" Dmx="102~109" Colour="255,255,255" />
      <Function ID="15" Name="Green-Blue-Amber" Display="'Green-Blue-Amber'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Red-Green-Blue-Amber" Display="'Red-Green-Blue-Amber'" Dmx="118~125" Colour="255,255,255" />
      <Function ID="17" Name="Stop" Display="'Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e24846dd-a154-4842-854f-9f1159d1db07" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Fog" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Fog cell" X="0" Y="0">
        <AttributeLink SourceId="Fog" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="LED" ChannelOffset="2" ModeLink="LED cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Fog cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="LED cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />

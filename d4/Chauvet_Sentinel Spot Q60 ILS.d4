  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e700a120-4baa-4946-b751-f1430f480d35" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="7,8,9,10,11,12" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="13,14,15,16" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>917f039c-d37c-488f-ab96-bc700fa0801a</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~23" WheelPosition="1">
        <Swatch>11d2c4b9-cdd0-4d2d-9b32-f1d78d8ca23b</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="24~37" WheelPosition="2">
        <Swatch>63e2e627-bc3f-420e-a014-74d6aaa6ebea</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="38~51" WheelPosition="3">
        <Swatch>bb945922-83f9-4b85-9905-eb1fdd107f3b</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="52~65" WheelPosition="4">
        <Swatch>afac591f-6b2c-4fdd-a292-547275c87ba0</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="66~79" WheelPosition="5">
        <Swatch>184c645b-5e7b-47e4-88b2-38c57e977787</Swatch>
      </Function>
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>917f039c-d37c-488f-ab96-bc700fa0801a</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="112~119" WheelPosition="1">
        <Swatch>11d2c4b9-cdd0-4d2d-9b32-f1d78d8ca23b</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="104~111" WheelPosition="2">
        <Swatch>63e2e627-bc3f-420e-a014-74d6aaa6ebea</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="96~103" WheelPosition="3">
        <Swatch>bb945922-83f9-4b85-9905-eb1fdd107f3b</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="88~95" WheelPosition="4">
        <Swatch>afac591f-6b2c-4fdd-a292-547275c87ba0</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="80~87" WheelPosition="5">
        <Swatch>184c645b-5e7b-47e4-88b2-38c57e977787</Swatch>
      </Function>
      <Function ID="13" Name="Open" Display="'Open'" Dmx="120~127" WheelPosition="0">
        <Swatch>917f039c-d37c-488f-ab96-bc700fa0801a</Swatch>
      </Function>
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="189~128" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="16" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="187~128" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="188~191" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="146~215" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="8~15" />
      <Function ID="3" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="24~31" />
      <Function ID="4" Name="P/T/G in Dark" Display="'P/T/G in Dark'" Dmx="40~47" />
      <Function ID="5" Name="Reset Pan" Display="'Reset Pan'" Dmx="96~103" />
      <Function ID="6" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="104~111" />
      <Function ID="7" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="120~127" />
      <Function ID="8" Name="Reset All" Display="'Reset All'" Dmx="152~159" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

  <History Date="23-01-18" Author="Nic Morris" Comment="Revised pan/tilt ranges in line with latest specs in response to manufacturer request." Version="5" />
  <History Date="23-01-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed name from Robin LED Beam 150 to Robin LEDBeam 150" Version="6" />
  <History Date="23-01-18" Author="Nic Morris" Comment="Added channel counts to mode names." Version="7" />
  <History Date="02-07-18" Author="Gregory Haynes" Comment="Added RDM information." Version="8" />
  <History Date="11-01-21" Author="Nic Morris" Comment="Created from Robe Robin LEDBeam 150" Version="9" />
  <History Date="15-04-21" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="11" />
  <History Date="05-10-21" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (adds quiet mode, fan speed and quiet mode at B/O control functions and macros)" Version="13" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="15" />
  <History Date="22-02-24" Author="Nic Morris" Comment="Created from Robe Robin LEDBeam 350" Version="16" />
  <History Date="24-02-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="17" />
  <History Date="24-04-24" Author="Nic Morris" Comment="Corrected amber ID (was white) in response to customer feedback." Version="18" />

      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="86~93" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="94~101" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="102~109" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Jump Stop" Display="'Jump Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~164" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="165~201" Colour="255,255,255" />
      <Function ID="20" Name="User Col 1" Display="'User Col 1'" Dmx="202~207" Colour="255,255,255" />
      <Function ID="21" Name="User Col 2" Display="'User Col 2'" Dmx="208~213" Colour="255,255,255" />
      <Function ID="22" Name="User Col 3" Display="'User Col 3'" Dmx="214~219" Colour="255,255,255" />
      <Function ID="23" Name="User Col 4" Display="'User Col 4'" Dmx="220~225" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Preset_xFade" Name="Preset xFade" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="100-10000ms" Display="'100-10000ms %.fms',100~10000" Dmx="6~105" Colour="255,255,255" />
      <Function ID="3" Name="11-119s" Display="'11-119s %.f Sec',11~119" Dmx="106~214" Colour="255,255,255" />
      <Function ID="4" Name="120-290s" Display="'120-290s %.f Sec',120~290" Dmx="215~232" Colour="255,255,255" />
      <Function ID="5" Name="5-27min" Display="'%.fmin',5~27" Dmx="233~255" Colour="255,255,255" />
    </Attribute>

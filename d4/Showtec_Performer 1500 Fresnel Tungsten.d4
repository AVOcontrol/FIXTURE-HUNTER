    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="11~35" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="36~60" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="61~85" Colour="255,255,255" />

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f Hz',0.0~20.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~17" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="18~35" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~53" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="54~71" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="72~89" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="90~107" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="108~125" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="126~142" Colour="255,255,255" />
      <Function ID="10" Name="Colour Pulse" Display="'Colour Pulse'" Dmx="143~192" Colour="255,255,255" />
      <Function ID="11" Name="Colour Fade" Display="'Colour Fade'" Dmx="193~224" Colour="255,255,255" />
      <Function ID="12" Name="Colour Jump" Display="'Colour Jump'" Dmx="225~255" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VLHive 151 Digital FX" ShortName="VLHive 151" Company="Varilite" Version="27">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>2623c5f8-08a6-4a8c-8610-bad894089520</Thumbnail>
  <History Date="11-03-25" Author="Nic Morris" Comment="Created (charts are littered with spelling errors/typos.  no pixel layout.  conflicting default values for focus - used 0)" Version="0" />
  <History Date="11-03-25" Author="Nic Morrisa" Comment="(note some controls functions change dyamically depending on fixture level settings.  there is no way to support this at the moment through DMX as there is no way to know what state the fixture is in)" Version="4" />
  <History Date="11-03-25" Author="Nic Morrisa" Comment="(Gobo Key Stone Effect ranges missing)" Version="7" />
  <History Date="28-11-25" Author="Nic Morris" Comment="Added 16-BIT Extended mode in line with latest charts (significantly different.  the other modes are no longer detailed.  suffers from same problem with dynamic functions based on fixture level settings.  these cannot be supported.  probably by any console)" Version="23" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a670f511-7563-40f0-8c4f-f00bfa3e5a17" />

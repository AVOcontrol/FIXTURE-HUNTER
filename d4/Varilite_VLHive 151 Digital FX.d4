    <Attribute ID="F_Img_Ctr" Name="F Img Ctr" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="F_Img_Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="11~20" Update="F_Img_Rot" />
      <Function ID="3" Name="Mega Step" Display="'Mega Step'" Dmx="21~30" Update="F_Img_Rot" />
    </Attribute>
    <Attribute ID="F_Img_Rot" Name="F Img Rot" Description="" Group="G">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'F_Img_Ctr'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'F_Img_Ctr'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

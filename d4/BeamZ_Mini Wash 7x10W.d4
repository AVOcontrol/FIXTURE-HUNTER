  <Thumbnail>80b87d9b-c494-4620-b417-f538c99c8788</Thumbnail>
  <History Date="22-05-12" Author="Peter Budd" Comment="Created" />
  <History Date="14-01-13" Author="Peter Budd" Comment="Created from Timpani TL56MW" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="19-01-18" Author="Nic Morris" Comment="Changed manufacturer name from Beamz to BeamZ.  Added product image." />
  <History Date="19-01-18" Author="Nic Morris" Comment="Revised dimmer range and moved to first function for compatibility." />
  <History Date="19-01-18" Author="Nic Morris" Comment="Corrected channel count in mode name (8 channel mode was 4 DMX, 8bit)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~134" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="135~239" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="8~21" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~34" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="35~49" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="50~63" Colour="0,0,255" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="64~77" Colour="255,255,255" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="78~91" Colour="0,128,255" />
      <Function ID="8" Name="Crimson" Display="'Crimson'" Dmx="92~105" Colour="255,128,0" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="106~119" Colour="255,255,0" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="120~133" Colour="128,0,255" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="134~147" Colour="255,128,0" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="148~161" Colour="128,255,0" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="162~175" Colour="255,0,255" />
      <Function ID="14" Name="Pink" Display="'Pink'" Dmx="176~189" Colour="255,150,150" />
      <Function ID="15" Name="Buff" Display="'Buff'" Dmx="190~203" Colour="255,150,150" />
      <Function ID="16" Name="RGB" Display="'RGB'" Dmx="204~217" Colour="255,255,255" />
      <Function ID="17" Name="UV" Display="'UV'" Dmx="218~231" Colour="180,0,255" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="232~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="PT_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~37" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="38~52" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="53~67" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="68~82" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="83~97" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="98~112" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="128~142" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="143~157" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="158~172" />
      <Function ID="13" Name="Sound 4" Display="'Sound 4'" Dmx="173~187" />
      <Function ID="14" Name="Sound 5" Display="'Sound 5'" Dmx="188~202" />
      <Function ID="15" Name="Sound 6" Display="'Sound 6'" Dmx="203~217" />
      <Function ID="16" Name="Sound 7" Display="'Sound 7'" Dmx="218~232" />
      <Function ID="17" Name="Sound 8" Display="'Sound 8'" Dmx="233~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX, 16bit" Channels="13">
    <Import PearlRef="UK_BZMW710X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="11" Wheel="7" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="12" Wheel="26" />
      <Attribute ID="PT_Macro" ChannelOffset="13" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="UK_BZMW710B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="White" ChannelOffset="7" Wheel="9" />
      <Attribute ID="PT_Speed" ChannelOffset="8" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />

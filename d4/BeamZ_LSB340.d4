  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e6929f01-fa13-4547-898c-8bb80f7efaf6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="SMD_Strobe" Name="SMD Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Strobe" Name="White Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="10~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="40~69" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="70~99" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="100~129" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="130~159" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="160~189" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3 %.f%%',0~100" Dmx="190~219" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4 %.f%%',0~100" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="70~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xWhite" Name="White" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="10~29" />
      <Function ID="3" Name="2" Display="'2'" Dmx="30~49" />
      <Function ID="4" Name="3" Display="'3'" Dmx="50~69" />
      <Function ID="5" Name="1+2" Display="'1+2'" Dmx="70~89" />
      <Function ID="6" Name="1+3" Display="'1+3'" Dmx="90~109" />
      <Function ID="7" Name="2+3" Display="'2+3'" Dmx="110~129" />
      <Function ID="8" Name="1+2+3" Display="'1+2+3'" Dmx="130~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="77948633-c607-455b-b53e-7674750a2565">

      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Dimmer_Effect" Name="Dimmer Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.1f%%',0.0~100.0" Dmx="8~131" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Prism_Frost" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="64~127" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="128~191" />
      <Function ID="4" Name="Frost" Display="'Frost'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Shutter" Display="'Shutter'" Dmx="0~0" Update="Shutter, Shutter16CH" Intensity="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Shutter, Shutter16CH" Intensity="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Shutter, Shutter16CH" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter16CH" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Shutter" ID="1,2,3,4" If="'Shutter_Func'==1" />
      <Condition Name="Shake" ID="5,6" If="'Shutter_Func'==2" />
      <Else ID="7" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="240~255" Intensity="0~0" />
      <Function ID="5" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="132~185" Intensity="0~0" />
      <Function ID="6" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="186~239" Intensity="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>

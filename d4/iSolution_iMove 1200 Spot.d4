<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iMove 1200 Spot" ShortName="IM 1200S" Company="iSolution">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-08-06" Author="D.Milligan" Comment="Created" />
  <History Date="23-08-06" Author="Ed" Comment="Errors: Gobo 1Rot and Gobo 2Rot: Spin goes fast to slow then slow to fast. Gobo2: Scroll Cw ends at 187 not 188" />
  <History Date="23-08-06" Author="Ed" Comment="Error: Prism Rot needs a function wheel" />
  <History Date="23-08-06" Author="Ed" Comment="Error: Iris is at maximum at Zero.  Should also locate to maximum" />
  <History Date="23-08-06" Author="Ed" Comment="Error: Control: No need for no func in d4 file" />
  <History Date="23-08-06" Author="Ed" Comment="Error: FX channels need more appropriate IDs" />
  <History Date="23-08-06" Author="Ed" Comment="Error: FX channels go from fast to slow then slow to fast" />
  <History Date="23-08-06" Author="Ed" Comment="Error: Prism/Frost needs more appropriate ID" />
  <History Date="23-08-06" Author="Ed" Comment="Error: Prism/Frost rot isnt needed, just use 22DMX prism rot" />
  <History Date="23-08-06" Author="Ed" Comment="Error: 16DMX Channel allocation is incorrect, some channels also clash" />
  <History Date="23-08-06" Author="D.Milligan" Comment="Fixed above Errors" />
  <History Date="23-08-06" Author="Ed" Comment="Created" />
  <History Date="14-10-08" Author="Jonathan Moreton" Comment="Updated manufacturer name" />
  <History Date="26-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="11-06-10" Author="Gregory Haynes" Comment="Fixed condition" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="01-01-17" Author="Nic Morris" Comment="Revised dimmer to power on at zero (was 100%).  Removed Dimmer Effect update from Shutter Func." />
  <History Date="01-01-17" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised conditionals.  Swapped blue and green in colour 1." />
  <History Date="01-01-17" Author="Nic Morris" Comment="Fixed Colour 2 Func update (was also updating Colour 1).  Added palettes.  Added highlight/lowlight." />
  <History Date="04-01-17" Author="Nic Morris" Comment="Added Atlabase ID to 16 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="631bab90-34e5-40a8-b2b6-a6e8c8ac75ae" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Shutter" ID="1,2,3,4" If="'Shutter_Func'==1" />
      <Condition Name="Shake" ID="5,6" If="'Shutter_Func'==2" />
      <Else ID="7" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="132~185" Intensity="0~0" />
      <Function ID="6" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="186~239" Intensity="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="16~31" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="48~63" Colour="255,128,0" />
      <Function ID="5" Name="Light Green" Display="'Light Green'" Dmx="64~79" Colour="128,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="80~95" Colour="255,0,255" />
      <Function ID="7" Name="Light Yellow" Display="'Yellow'" Dmx="96~111" Colour="255,255,128" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="112~127" Colour="255,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour2Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Colour2Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="19~36" Colour="0,128,255" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="37~54" Colour="255,150,150" />
      <Function ID="4" Name="UV" Display="'UV'" Dmx="55~72" Colour="180,0,255" />
      <Function ID="5" Name="Grn/ Yel/ Mag/ Blue" Display="'Grn/ Yel/ Mag/ Blue'" Dmx="73~90" Colour="0,0,0" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="91~108" Colour="230,230,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="109~127" Colour="255,240,200" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="6,7,8,9" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="26~50" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="51~76" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="77~101" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="102~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW       %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW      %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="6,7,8,9" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="26~50" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="51~76" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="77~101" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="102~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~187" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="188~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Col in Dark ON" Display="'Col in Dark ON'" Dmx="90~99" />
      <Function ID="3" Name="Col in Dark OFF" Display="'Col in Dark OFF'" Dmx="100~109" />
      <Function ID="4" Name="Gobo in Dark ON" Display="'Gobo in Dark ON'" Dmx="110~119" />

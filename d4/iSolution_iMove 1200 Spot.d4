    <Attribute ID="Iris_Effect" Name="Iris Effect" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="10~91" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="92~173" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="174~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Frost_Effect" Name="Frost Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Slow Frost" Display="'Slow Frost %.f%%',0~100" Dmx="1~179" />
      <Function ID="3" Name="Frost" Display="'Frost'" Dmx="180~189" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~211" />

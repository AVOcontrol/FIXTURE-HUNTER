      </Function>
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="152~164" WheelPosition="2">
        <Swatch>e276484b-2873-493f-9701-6c1cc2669b17</Swatch>

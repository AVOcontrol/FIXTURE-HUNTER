      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="175~199" Colour="255,255,255" />
      <Function ID="9" Name="Auto 1 Col" Display="'Auto 1 Col %.f%%',0~100" Dmx="200~224" Colour="255,255,255" />
      <Function ID="10" Name="Auto 2 Col" Display="'Auto 2 Col %.f%%',0~100" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_1_Strobe" Name="LED 1 Strobe" Description="" Group="I">

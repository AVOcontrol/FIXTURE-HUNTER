  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_1_Colour" Name="LED 1 Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~74" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="75~99" Colour="0,0,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="100~124" Colour="255,255,255" />

  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMSFX1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKCMSFX2" DiamondRef="" WysiwygRef="" />

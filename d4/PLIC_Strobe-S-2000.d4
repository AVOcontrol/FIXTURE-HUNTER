      <Function ID="4" Name="Ramp Up-Down" Display="'Ramp Up-Down'" Dmx="86~128" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Plate_Spd(JDC1)" Name="Plate Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="L-&gt;R" Display="'L-&gt;R %.f%%',100~0" Dmx="48~151" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="R-&gt;L" Display="'R-&gt;L %.f%%',0~100" Dmx="152~255" />
    </Attribute>
    <Attribute ID="Beam_Spd(JDC1)" Name="Beam Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="L-&gt;R" Display="'L-&gt;R %.f%%',100~0" Dmx="48~151" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="R-&gt;L" Display="'R-&gt;L %.f%%',0~100" Dmx="152~255" />
    </Attribute>
    <Attribute ID="FX_Dimmer" Name="FX Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CrossFade" Name="CrossFade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Snap" Display="'Snap'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'Duration %.1f%%',0.0~100.0" Dmx="3~255" />
    </Attribute>
  </Control>

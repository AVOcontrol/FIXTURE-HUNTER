      <Function ID="36" Name="Y" Display="'Y'" Dmx="246~252" />
      <Function ID="37" Name="Z" Display="'Z'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Pixel_Macro" Name="Pixel Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="8~126" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~20" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="MGLAGRID" DiamondRef="" WysiwygRef="" />

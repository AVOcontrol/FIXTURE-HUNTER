      <Attribute ID="PT_Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="40" />
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="11" Wheel="9" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="22 DMX" Channels="22">

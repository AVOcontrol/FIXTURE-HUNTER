  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="addc7e43-e668-4ec4-9139-1aaaff4424e6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~23" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~36" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="37~49" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="50~62" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="63~75" Colour="255,100,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="76~88" Colour="255,128,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="89~101" Colour="255,255,0" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="102~114" Colour="128,0,255" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="115~127" Colour="255,150,150" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="128~140" Colour="0,255,255" />
      <Function ID="12" Name="Light Red" Display="'Light Red'" Dmx="141~153" Colour="255,100,100" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="154~166" Colour="128,255,0" />
      <Function ID="14" Name="Light Blue" Display="'Light Blue'" Dmx="167~179" Colour="0,128,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="180~192" Colour="255,240,200" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="193~205" Colour="230,230,255" />
      <Function ID="17" Name="2700K" Display="'2700K'" Dmx="206~218" Colour="255,240,200" />
      <Function ID="18" Name="3200K" Display="'3200K'" Dmx="219~231" Colour="255,240,200" />
      <Function ID="19" Name="4500K" Display="'4500K'" Dmx="232~244" Colour="255,255,255" />
      <Function ID="20" Name="5400K" Display="'5400K'" Dmx="245~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="11~26" Update="Auto_Spd" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="27~42" Update="Auto_Spd" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="43~58" Update="Auto_Spd" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="59~74" Update="Auto_Spd" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="75~90" Update="Auto_Spd" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="91~106" Update="Auto_Spd" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="107~122" Update="Auto_Spd" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="123~138" Update="Auto_Spd" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="139~154" Update="Auto_Spd" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="155~170" Update="Auto_Spd" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="171~186" Update="Auto_Spd" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="187~202" Update="Auto_Spd" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="203~218" Update="Auto_Spd" />
      <Function ID="15" Name="Program ALL" Display="'Program ALL'" Dmx="219~206" Update="Auto_Spd" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="235~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==16" />
      <Else ID="1" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~45" Colour="0,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~80" Colour="0,0,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="81~115" Colour="0,0,0" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="116~150" Colour="0,0,0" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="151~185" Colour="0,0,0" />
      <Function ID="7" Name="B+G" Display="'B+G'" Dmx="186~220" Colour="0,0,0" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="51~100" Update="Auto_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="101~150" Update="Auto_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="151~200" Update="Auto_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="201~250" Update="Auto_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Auto'==2" />
      <Condition Name="Sound" ID="3" If="'Auto'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sound Mode" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_FX" Name="Pixel FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Pixel_FX_Spd" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="51~55" Update="Pixel_FX_Spd" />

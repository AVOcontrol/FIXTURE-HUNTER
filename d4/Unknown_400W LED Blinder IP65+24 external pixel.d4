      <Function ID="34" Name="Overall Process Effect" Display="'Overall Process Effect'" Dmx="210~220" Update="Pixel_FX_Spd" />
      <Function ID="35" Name="Sound" Display="'Sound'" Dmx="221~255" Update="Pixel_FX_Spd" />
    </Attribute>
    <Attribute ID="Pixel_FX_Spd" Name="Pixel FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Pixel_FX'==35" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sound Mode" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

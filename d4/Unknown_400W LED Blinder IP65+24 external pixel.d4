      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="156~160" Update="Pixel_FX_Spd" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="161~165" Update="Pixel_FX_Spd" />

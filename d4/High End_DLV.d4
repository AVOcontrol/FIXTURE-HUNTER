      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Persp_Sp_Func" Display="'Perspective   Spherical'" Dmx="0~0" Update="Effect, ViewpointM" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Persp_Cart_Func" Display="'Perspective   Cartesian'" Dmx="0~0" Update="Effect, ViewpointM" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Ortho Cart_Func" Display="'Othogonal     Cartesian'" Dmx="0~0" Update="Effect, ViewpointM" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Reserved_Func" Display="'Reserved'" Dmx="0~0" Update="Effect, ViewpointM" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Effect, ViewpointM" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="ViewpointM" Name="Viewpoint Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Persp_Sp_Func" ID="1,2,3,4,15" If="'Viewpoint_Func'==1" />
      <Condition Name="Persp_Cart_Func" ID="5,6,7,8,16" If="'Viewpoint_Func'==2" />
      <Condition Name="Ortho Cart_Func" ID="9,10,11,12,17" If="'Viewpoint_Func'==3" />
      <Condition Name="Reserved_Func" ID="13,18,19" If="'Viewpoint_Func'==4" />
      <Else ID="14" />
      <Function ID="1" Name="Centre Of Universe" Display="'Centre Of     Universe'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Object 1" Display="'Object 1'" Dmx="1~1" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Object 2" Display="'Object 2'" Dmx="2~2" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Object 3" Display="'Object 3'" Dmx="3~3" Iris="0~0" Zoom="0~0" />

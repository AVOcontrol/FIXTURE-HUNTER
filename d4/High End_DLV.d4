      <Function ID="12" Name="Object 3" Display="'Object 3'" Dmx="11~11" Iris="0~0" Zoom="0~0" />
      <Function ID="13" Name="Reserved" Display="'Reserved %.f',30~127" Dmx="30~127" Iris="0~0" Zoom="0~0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Iris="0~0" Zoom="0~0" />
      <Function ID="15" Name="Object 4" Display="'Object 4'" Dmx="12~12" Iris="0~0" Zoom="0~0" />

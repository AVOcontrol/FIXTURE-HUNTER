      <Condition Name="Correction" ID="105" If="'G_Effect5'==98||'G_Effect5'==99||'G_Effect5'==100||'G_Effect5'==101||'G_Effect5'==102||'G_Effect5'==103||'G_Effect5'==111||'G_Effect5'==112" />

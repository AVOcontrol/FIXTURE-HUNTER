    <Attribute ID="Effect1_Modifier1" Name="Effect 1 Mod 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Cyan" ID="2" If="'Effect1_Mode'==2||'Effect1_Mode'==3||'Effect1_Mode'==4||'Effect1_Mode'==51" />

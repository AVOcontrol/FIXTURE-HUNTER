    <Attribute ID="G_E5_Mod1" Name="Effect 5 Mod 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Cyan" ID="2" If="'G_Effect5'==2||'G_Effect5'==3||'G_Effect5'==4||'G_Effect5'==51" />
      <Condition Name="Red" ID="3" If="'G_Effect5'==5||'G_Effect5'==6||'G_Effect5'==7||'G_Effect5'==8||'G_Effect5'==9||'G_Effect5'==10||'G_Effect5'==11||'G_Effect5'==12||'G_Effect5'==13||'G_Effect5'==15||'G_Effect5'==16||'G_Effect5'==17||'G_Effect5'==18||'G_Effect5'==19||'G_Effect5'==20||'G_Effect5'==27||'G_Effect5'==28||'G_Effect5'==29||'G_Effect5'==30||'G_Effect5'==31||'G_Effect5'==32||'G_Effect5'==40||'G_Effect5'==42||'G_Effect5'==43||'G_Effect5'==44||'G_Effect5'==48||'G_Effect5'==50||'G_Effect5'==91||'G_Effect5'==92||'G_Effect5'==93||'G_Effect5'==94||'G_Effect5'==95" />
      <Condition Name="X" ID="4" If="'G_Effect5'==35||'G_Effect5'==36||'G_Effect5'==37||'G_Effect5'==38||'G_Effect5'==54||'G_Effect5'==58||'G_Effect5'==62||'G_Effect5'==49||'G_Effect5'==88||'G_Effect5'==120||'G_Effect5'==63" />
      <Condition Name="Size" ID="5" If="'G_Effect5'==84||'G_Effect5'==23||'G_Effect5'==24||'G_Effect5'==25||'G_Effect5'==26||'G_Effect5'==47||'G_Effect5'==53||'G_Effect5'==55||'G_Effect5'==56||'G_Effect5'==57||'G_Effect5'==77||'G_Effect5'==78||'G_Effect5'==80||'G_Effect5'==82||'G_Effect5'==85||'G_Effect5'==86" />
      <Condition Name="Scan Line" ID="6" If="'G_Effect5'==33" />
      <Condition Name="Width" ID="7" If="'G_Effect5'==21||'G_Effect5'==22||'G_Effect5'==34||'G_Effect5'==67||'G_Effect5'==68" />
      <Condition Name="Colour" ID="8" If="'G_Effect5'==39" />
      <Condition Name="Position X" ID="9,10,11,12" If="'G_Effect5'==76||'G_Effect5'==41||'G_Effect5'==66" />
      <Condition Name="Mode" ID="13" If="'G_Effect5'==45||'G_Effect5'==46" />

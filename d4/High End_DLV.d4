<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DLV" ShortName="DLV" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="22-09-05" Author="Ed" Comment="Created" />
  <History Date="06-04-06" Author="Ed" Comment="Moved global control and global controlm into Special group" />
  <History Date="07-04-06" Author="Ed" Comment="Made all Edging part of beam group and made macro part of special group" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved all Opacity into the beam group" />
  <History Date="11-04-06" Author="Ed Spencer" Comment="Moved all Scalling into beam group" />
  <History Date="13-04-06" Author="Ed Spencer" Comment="Moved all View Pos's and viewpoint into Beam group" />
  <History Date="13-04-06" Author="Ed" Comment="Moved all rot and Pos's into beam group" />
  <History Date="13-04-06" Author="Ed" Comment="Moved Mask into beam group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="08-02-07" Author="D.Milligan" Comment="Fixed X, Y, Z Pos locates. Increased resolution for X, Y, Z" />
  <History Date="30-04-07" Author="D.Milligan" Comment="Updated Z axis locate. Changed Opacity to Dimmer" />
  <History Date="04-06-08" Author="Gregory Haynes" Comment="Fixed macros, made object layer one mode (to be patched 3 times), tidied up and added missing names, added conditions for effects and visual mode..." />
  <History Date="28-07-08" Author="Jonathan Moreton" Comment="Converted from DL2, updated to most recent spec." />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="20-07-09" Author="David Hunt" Comment="Fixed function name in attribute Dimmer" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-07-12" Author="Peter Budd" Comment="Created from Catalyst DL3" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19538" />
  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',100.0~0.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="MSpeed" Name="Motor Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

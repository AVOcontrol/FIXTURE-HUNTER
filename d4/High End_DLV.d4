    <Attribute ID="Vis_Modifier1" Name="Vis Modifier 1" Description="" Group="S">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Black Level" ID="2" If="'VisMode'==2||'VisMode'==6||'VisMode'==12" />
      <Condition Name="Fade" ID="3" If="'VisMode'==3||'VisMode'==4||'VisMode'==9" />
      <Condition Name="Level" ID="4" If="'VisMode'==5||'VisMode'==7||'VisMode'==16" />
      <Condition Name="White/BW" ID="5" If="'VisMode'==8" />
      <Condition Name="Scale" ID="6" If="'VisMode'==10||'VisMode'==14" />
      <Condition Name="Contrast" ID="7" If="'VisMode'==11" />
      <Condition Name="Graphic Object" ID="8,9,10" If="'VisMode'==13" />
      <Condition Name="X" ID="11" If="'VisMode'==15||'VisMode'==19||'VisMode'==21||'VisMode'==23||'VisMode'==25" />
      <Condition Name="Grid Size" ID="12" If="'VisMode'==17||'VisMode'==18" />
      <Condition Name="Position X" ID="13,14,15,16" If="'VisMode'==20||'VisMode'==22" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX        %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Black Level" Display="'Black Level    %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Fade" Display="'Fade           %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Level" Display="'Level          %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="White/BW" Display="'White/BW       %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Scale" Display="'Scale          %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="7" Name="Contrast" Display="'Contrast       %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="8" Name="Graphic Object None" Display="'Graphic Object None'" Dmx="0~0" />
      <Function ID="9" Name="Graphic Object" Display="'Graphic Object %.f',1~3" Dmx="1~3" />
      <Function ID="10" Name="Graphic Object Reserved" Display="'Reserved       %.f',4~255" Dmx="4~255" />
      <Function ID="11" Name="X" Display="'X              %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="12" Name="Grid Size" Display="'Grid Size      %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="13" Name="Normal (X)" Display="'Normal (X)'" Dmx="128~128" />
      <Function ID="14" Name="Left" Display="'Left           %.f%%',100~0" Dmx="255~129" />
      <Function ID="15" Name="Normal (X)" Display="'Normal (X)'" Dmx="128~128" />
      <Function ID="16" Name="Right" Display="'Right          %.f%%',0~100" Dmx="127~0" />
    </Attribute>
    <Attribute ID="Vis_Modifier2" Name="Vis Modifier 2" Description="" Group="S">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Contrast" ID="2" If="'VisMode'==2||'VisMode'==6||'VisMode'==7" />
      <Condition Name="Saturation" ID="3" If="'VisMode'==3||'VisMode'==4" />
      <Condition Name="Brightness" ID="4" If="'VisMode'==5" />
      <Condition Name="Subtract Red/Green" ID="5,6" If="'VisMode'==10" />
      <Condition Name="Shift" ID="7" If="'VisMode'==11" />
      <Condition Name="White Level" ID="8" If="'VisMode'==12" />
      <Condition Name="Opacity" ID="9" If="'VisMode'==13" />
      <Condition Name="Angle" ID="10" If="'VisMode'==14" />
      <Condition Name="Y" ID="11" If="'VisMode'==15||'VisMode'==19||'VisMode'==21||'VisMode'==23||'VisMode'==25" />
      <Condition Name="Spacing" ID="12,13" If="'VisMode'==17||'VisMode'==18" />
      <Condition Name="Position Y" ID="14,15,16,17" If="'VisMode'==20||'VisMode'==22" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX        %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Contrast" Display="'Contrast       %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Saturation" Display="'Saturation     %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Brightness" Display="'Brightness     %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Subtract Red" Display="'Subtract Red   %.f%%',100~0" Dmx="0~128" />
      <Function ID="6" Name="Subtract Green" Display="'Subtract Green %.f%%',0~100" Dmx="129~255" />
      <Function ID="7" Name="Shift" Display="'Shift          %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="8" Name="White Level" Display="'White Level    %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="9" Name="Opacity" Display="'Opacity        %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="10" Name="Angle" Display="'Angle          %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="11" Name="Y" Display="'Y              %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="12" Name="Spacing Black" Display="'Spacing Black  %.f%%',0~100" Dmx="0~127" />
      <Function ID="13" Name="Spacing White" Display="'Spacing White  %.f%%',0~100" Dmx="128~255" />
      <Function ID="14" Name="Normal (Y)" Display="'Normal (Y)'" Dmx="128~128" />
      <Function ID="15" Name="Down" Display="'Down           %.f%%',100~0" Dmx="0~127" />
      <Function ID="16" Name="Normal (Y)" Display="'Normal (Y)'" Dmx="128~128" />
      <Function ID="17" Name="Up" Display="'Up             %.f%%',0~100" Dmx="129~255" />
    </Attribute>

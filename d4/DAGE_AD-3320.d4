      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="60~60" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="65~65" WheelPosition="13" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="70~70" WheelPosition="14" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake'" Dmx="75~75" WheelPosition="1" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake'" Dmx="80~80" WheelPosition="2" />
      <Function ID="19" Name="Gobo 3 Shake" Display="'Gobo 3 Shake'" Dmx="85~85" WheelPosition="3" />
      <Function ID="20" Name="Gobo 4 Shake" Display="'Gobo 4 Shake'" Dmx="90~90" WheelPosition="4" />
      <Function ID="21" Name="Gobo 5 Shake" Display="'Gobo 5 Shake'" Dmx="95~95" WheelPosition="5" />
      <Function ID="22" Name="Gobo 6 Shake" Display="'Gobo 6 Shake'" Dmx="100~100" WheelPosition="6" />
      <Function ID="23" Name="Gobo 7 Shake" Display="'Gobo 7 Shake'" Dmx="105~105" WheelPosition="7" />
      <Function ID="24" Name="Gobo 8 Shake" Display="'Gobo 8 Shake'" Dmx="110~110" WheelPosition="8" />
      <Function ID="25" Name="Gobo 9 Shake" Display="'Gobo 9 Shake'" Dmx="115~115" WheelPosition="9" />
      <Function ID="26" Name="Gobo 10 Shake" Display="'Gobo 10 Shake'" Dmx="120~120" WheelPosition="10" />
      <Function ID="27" Name="Gobo 11 Shake" Display="'Gobo 11 Shake'" Dmx="125~125" WheelPosition="11" />
      <Function ID="28" Name="Gobo 12 Shake" Display="'Gobo 12 Shake'" Dmx="130~130" WheelPosition="12" />
      <Function ID="29" Name="Gobo 13 Shake" Display="'Gobo 13 Shake'" Dmx="135~135" WheelPosition="13" />
      <Function ID="30" Name="Gobo 14 Shake" Display="'Gobo 14 Shake'" Dmx="140~140" WheelPosition="14" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="201~205" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~206" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="201~205" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~145" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />

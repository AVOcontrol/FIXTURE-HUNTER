      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="5~5" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="10~10" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="15~15" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="20~20" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="25~25" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="30~30" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="35~35" WheelPosition="7" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="40~40" WheelPosition="8" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake'" Dmx="45~45" WheelPosition="1" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake'" Dmx="50~50" WheelPosition="2" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake'" Dmx="55~55" WheelPosition="3" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake'" Dmx="60~60" WheelPosition="4" />
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake'" Dmx="65~65" WheelPosition="5" />
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake'" Dmx="70~70" WheelPosition="6" />
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake'" Dmx="75~75" WheelPosition="7" />
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake'" Dmx="80~80" WheelPosition="8" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="170~175" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~176" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="170~175" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="179~85" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~63" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="64~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
      <Function ID="6" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="192~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">

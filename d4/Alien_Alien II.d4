      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="72~79" Update="Auto_Spd" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="80~87" Update="Auto_Spd" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="88~95" Update="Auto_Spd" />

      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Update="Auto_Spd" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" Update="Auto_Spd" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" Update="Auto_Spd" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="32~39" Update="Auto_Spd" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="40~47" Update="Auto_Spd" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="48~55" Update="Auto_Spd" />

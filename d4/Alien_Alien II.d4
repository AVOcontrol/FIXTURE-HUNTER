      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="136~143" Update="Auto_Spd" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="144~151" Update="Auto_Spd" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="152~159" Update="Auto_Spd" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="160~167" Update="Auto_Spd" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="168~175" Update="Auto_Spd" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="176~183" Update="Auto_Spd" />

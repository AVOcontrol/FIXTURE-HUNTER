<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Wash 575" ShortName="AlphW 575" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-04-04" Author="Lena" Comment="Created" />
  <History Date="21-04-04" Author="Greg Brown" Comment="Checked" />
  <History Date="06-12-04" Author="Phil" Comment="Added &quot;Extn&quot; mode" />
  <History Date="07-07-06" Author="Ed" Comment="Changed CMY Mixing attributes to proper CMIXes" />
  <History Date="11-07-06" Author="Ed" Comment="Entered zoom angles" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="20-04-07" Author="D.Milligan" Comment="Fixed Colour IDs" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="03-12-09" Author="John Rogers" Comment="Added Vector modes." />
  <History Date="15-03-10" Author="John Rogers" Comment="Edited Pan locate value to 40%" />
  <History Date="26-11-10" Author="John Rogers" Comment="Edited wheel assignment Vector On modes." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-11-15" Author="Gregory Haynes" Comment="Removed duplicate Dimmer text from Dimmer attribute." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Simplified Rain Off colour.  Fixed duplicate ID's in colour else conditions.  Added highlight/lowlight." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Increased CTO wheel resolution." />
  <History Date="15-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to 'Rain OFF' modes." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly.  Added physical pan/tilt limits." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Standardised shutter.  Revised speed controls.  Added missing reset options." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised zoom display range and changed to 1dp.  Recreated palettes." />
  <Manual Filename="\manuals\fixtures\clay paky" Summary="" />
  <AtlaBase TypeID="d0ec23f8-3f6b-4f50-8780-012ec27a8c6a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:40" PowerOn="1:40" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Light_Frost" Name="Light Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Light Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Heavy_Frost" Name="Heavy Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Heavy Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:42" PowerOn="1:42" />
      <Function ID="1" Name="Zoom" Display="'%.1f°',4.0~80.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effects" Display="'Reset Effects'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="26~100" />
      <Function ID="3" Name="Lamp On (Half)" Display="'Lamp On (Half)'" Dmx="101~179" />
      <Function ID="4" Name="Lamp On (Full)" Display="'Lamp On (Full)'" Dmx="180~255" />
    </Attribute>
    <Attribute ID="Col_RainON_Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Col_RainON" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Col_RainON" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Col_RainON" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_RainON" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Col_RainON_Func'==1" />
      <Condition Name="Scroll" ID="6,7" If="'Col_RainON_Func'==2" />
      <Else ID="8" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="50~74" Colour="0,0,255" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="75~99" Colour="255,255,255" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="100~127" Colour="255,255,255" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="7" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_RainOFF" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="51~101" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="102~152" Colour="0,0,255" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="153~203" Colour="255,255,255" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="204~255" Colour="255,255,255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Beam_Speed" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Follow Cue" Display="'Follow Cue'" Dmx="255~255" />
    </Attribute>
  </Control>

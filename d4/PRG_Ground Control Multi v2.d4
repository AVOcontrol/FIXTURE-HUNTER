  <Mode Name="Main, 7 DMX" Channels="7" Id="8c6051fe-a108-49a8-abb3-5f92584e04b8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Ctrl_Config" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Cam_Exposure" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Cam_Zoom" ChannelOffset="3" Wheel="20" />

    <Attribute ID="Cam_Exposure" Name="Cam Exposure" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Change" Display="'No Change'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Exposure" Display="'Exposure %.1f%%',0.0~100.0" Dmx="1~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Cam_Zoom" Name="Cam Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Change" Display="'No Change'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="255~1" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Cam_WB+Reticle" Name="Cam WB+Reticle" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Change" Display="'No Change'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="1~1" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="2~2" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="5800K" Display="'5800K'" Dmx="3~3" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="ATW" Display="'ATW'" Dmx="4~4" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="One-Puse WB" Display="'One-Puse WB'" Dmx="5~5" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Reticle Off" Display="'Reticle Off'" Dmx="127~127" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Reticle On" Display="'Reticle On'" Dmx="128~128" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Ctrl_Selection" Name="Ctrl Selection" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Console Control" Display="'Console Control'" Dmx="1~1" />
      <Function ID="3" Name="GC Control" Display="'GC Control'" Dmx="10~10" />
    </Attribute>
    <Attribute ID="Store_Target" Name="Store Target" Description="" Group="S">

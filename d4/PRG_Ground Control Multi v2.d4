  <Macro>
    <Macro Name="Store Target Point Alpha">
      <Set Channel="Store_Target:2" Delay="2000" />
      <Set Channel="Store_Target:1" Delay="0" />
    </Macro>
    <Macro Name="Store Target Point Bravo">
      <Set Channel="Store_Target:3" Delay="2000" />
      <Set Channel="Store_Target:1" Delay="0" />
    </Macro>
    <Macro Name="Store Target Point Charlie">
      <Set Channel="Store_Target:4" Delay="2000" />
      <Set Channel="Store_Target:1" Delay="0" />
    </Macro>
    <Macro Name="Store Target Point Delta">
      <Set Channel="Store_Target:5" Delay="2000" />
      <Set Channel="Store_Target:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
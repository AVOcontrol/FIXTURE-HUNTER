<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GlowUp TW" ShortName="GlowUp TW" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>cc2093ed-c171-4e34-9e2c-6d83da75c417</Thumbnail>
  <History Date="02-10-12" Author="Peter Budd" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Split Intensity into two modes and added Atlabase ID's.  Revised Cool and Warm White to use reserved ID's." />
  <History Date="15-10-17" Author="Nic Morris" Comment="Changed name from Glow Up TW to GlowUp TW.  Changed random shutter to single variable range." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's (note no personality ID's.  this is likely to fail as all modes have the same channel count)" />
  <History Date="27-02-19" Author="Nic Morris" Comment="Fixed max intensity channel mapping." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="33" />
  </RDM>
  <AtlaBase TypeID="4a09e815-9519-4caa-bec2-980bd2f0419f" />
  <Control>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Cool C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Warm C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~69" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="212~250" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="75~140" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="141~206" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="Independent, 3 DMX" Channels="3">
    <Import PearlRef="CP_GlowTWId" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1337fc96-0995-466e-b744-196b01fff226" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Constant Intensity, 3 DMX" Channels="3">
    <Import PearlRef="CP_GlowTWIt" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="70ab9a6c-d2a4-4a3b-b1e4-609d71111f04" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Max Intensity, 3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8fdfda75-5a62-459e-8410-1b26b2f17970" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="cc2093ed-c171-4e34-9e2c-6d83da75c417"></Swatch>
  </swatchLibrary>
</Fixture>
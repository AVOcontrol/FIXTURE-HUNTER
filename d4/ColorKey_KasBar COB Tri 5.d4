  <AtlaBase TypeID="e7274a31-03fa-410d-941f-3ccbe3477155" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="3~3" Colour="255,0,0" />
      <Function ID="3" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="4~38" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="39~39" Colour="255,255,0" />
      <Function ID="5" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="40~74" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="75~75" Colour="0,255,0" />
      <Function ID="7" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="76~110" Colour="0,255,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="111~111" Colour="0,255,200" />
      <Function ID="9" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="112~146" Colour="0,255,200" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="147~147" Colour="0,0,255" />
      <Function ID="11" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="148~182" Colour="0,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="183~183" Colour="255,0,255" />
      <Function ID="13" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="184~218" Colour="255,0,255" />
      <Function ID="14" Name="Red" Display="'Red'" Dmx="219~219" Colour="255,0,0" />
      <Function ID="15" Name="Rd - Wht" Display="'Rd - Wht %.f%%',0~100" Dmx="220~254" Colour="255,0,0" />
      <Function ID="16" Name="White" Display="'White'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

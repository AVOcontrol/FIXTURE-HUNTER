      <Function ID="17" Name="Org/ D Bl" Display="'Org/ D Bl'" Dmx="114~120" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="D Bl/ Op" Display="'D Bl/ Op'" Dmx="121~127" WheelPosition="8" Colour="0,0,180" />

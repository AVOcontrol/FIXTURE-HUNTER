      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="96~101" WheelPosition="1" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="102~107" WheelPosition="2" />

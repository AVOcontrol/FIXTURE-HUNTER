      <Function ID="13" Name="Zm/Focus On" Display="'Zm/Focus On'" Dmx="115~119" />
      <Function ID="14" Name="Zm/Focus Link 12m" Display="'Zm/Focus Link 12m'" Dmx="120~124" />
      <Function ID="15" Name="AutoFocus Gobo 1" Display="'AutoFocus Gobo 1'" Dmx="225~229" />

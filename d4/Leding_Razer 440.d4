    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Reset Col" Display="'Reset Col'" Dmx="15~19" />
      <Function ID="4" Name="Reset Other" Display="'Reset Other'" Dmx="20~24" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="25~29" />
      <Function ID="6" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="30~34" />
      <Function ID="7" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="35~39" />
      <Function ID="8" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="40~44" />
      <Function ID="9" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="45~49" />

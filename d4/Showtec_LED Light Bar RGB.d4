    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Program 0" Display="'Program 0'" Dmx="0~0" Update="Control" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="18~35" Update="Control" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="36~53" Update="Control" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="54~71" Update="Control" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="72~89" Update="Control" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="90~107" Update="Control" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="108~125" Update="Control" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="126~143" Update="Control" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="144~161" Update="Control" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="162~179" Update="Control" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="180~197" Update="Control" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="198~215" Update="Control" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="216~233" Update="Control" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Control" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Control" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Effects Ctrl" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Program 0" ID="1,2,3,4,5,6,7,8" If="'Effect'==1" />
      <Condition Name="Program" ID="9" If="'Effect'==2||'Effect'==3||'Effect'==4||'Effect'==5||'Effect'==6||'Effect'==7||'Effect'==8||'Effect'==9||'Effect'==10||'Effect'==11||'Effect'==12||'Effect'==13" />
      <Condition Name="Sound Activated" ID="10" If="'Effect'==14" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="37~72" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="73~109" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="110~145" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green'" Dmx="146~182" />
      <Function ID="6" Name="Red/Green" Display="'Red/Green'" Dmx="183~218" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue'" Dmx="219~254" />
      <Function ID="8" Name="RGB Full" Display="'RGB Full'" Dmx="255~255" />
      <Function ID="9" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
      <Function ID="10" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="LED Light Bar 9DMX" Channels="9">
    <Import PearlRef="SH_LBar3CH" DiamondRef="" WysiwygRef="" />

      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="16191~18247" Colour="255,128,0" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="18504~20560" Colour="255,150,150" />
      <Function ID="10" Name="Gold" Display="'Gold'" Dmx="20817~22873" Colour="255,128,0" />
      <Function ID="11" Name="Navy Blue" Display="'Navy Blue'" Dmx="23130~25186" Colour="0,0,180" />
      <Function ID="12" Name="UV Filter" Display="'UV Filter'" Dmx="25443~27499" Colour="180,0,255" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="27756~29812" Colour="255,240,200" />
      <Function ID="14" Name="CTB" Display="'CTB'" Dmx="30069~32639" Colour="230,230,255" />
      <Function ID="15" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~32639" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.2f%%',100.00~0.00" Dmx="32896~48573" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="48830~49601" Colour="255,255,255" />

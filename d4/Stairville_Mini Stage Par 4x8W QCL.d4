  <History Date="14-03-13" Author="Peter Budd" Comment="Created" />
  <History Date="22-07-13" Author="Peter Budd" Comment="Created from the Stairville Par 64 CX-1 RGBW." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0a16a1bc-3803-4b59-92bb-4e8e58873da4" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="C-Mix" Display="'C-Mix'" Dmx="0~63" Colour="0,0,0" />
      <Function ID="2" Name="Auto-7" Display="'Auto-7'" Dmx="64~127" Colour="0,0,0" />
      <Function ID="3" Name="Auto-12" Display="'Auto-12'" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Auto-4" Display="'Auto-4'" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Col Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scroll" Display="'No Scroll'" Dmx="0~10" />
      <Function ID="2" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="11~100" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="101~150" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Macro " Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Eff" Name="Colour Eff" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="C-Mix" Display="'C-Mix'" Dmx="0~31" Colour="0,0,0" />
      <Function ID="2" Name="Fade Out" Display="'Fade Out'" Dmx="32~63" Colour="0,0,0" />
      <Function ID="3" Name="Fade In" Display="'Fade In'" Dmx="64~95" Colour="0,0,0" />
      <Function ID="4" Name="Fade In Out" Display="'Fade In Out'" Dmx="96~127" Colour="0,0,0" />
      <Function ID="5" Name="Auto Mix" Display="'Auto Mix'" Dmx="128~159" Colour="0,0,0" />
      <Function ID="6" Name="4 Colour" Display="'4 Colour'" Dmx="160~191" Colour="0,0,0" />
      <Function ID="7" Name="12 Colour" Display="'12 Colour'" Dmx="192~223" Colour="0,0,0" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX, 8bit" Channels="8">
    <Import PearlRef="SV_MP48WQ_8" DiamondRef="" WysiwygRef="" />
    <Physical>

      <Function ID="12" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~44" Colour="0,0,255" />
      <Function ID="13" Name="Green" Display="'Green %.f%%',0~100" Dmx="45~59" Colour="0,255,0" />
      <Function ID="14" Name="Light Yellow" Display="'Yellow %.f%%',0~100" Dmx="60~74" Colour="255,255,128" />
      <Function ID="15" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="75~89" Colour="255,0,255" />
      <Function ID="16" Name="Deep Red" Display="'Deep Red %.f%%',0~100" Dmx="90~104" Colour="180,0,0" />
      <Function ID="17" Name="Light Blue" Display="'Light Blue %.f%%',0~100" Dmx="105~119" Colour="0,128,255" />
      <Function ID="18" Name="Pink" Display="'Pink %.f%%',0~100" Dmx="120~255" Colour="255,150,150" />

    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~30" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~61" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="62~92" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="93~123" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="124~154" Colour="255,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="155~185" Colour="255,150,150" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="186~216" Colour="0,255,255" />
      <Function ID="9" Name="RGBW" Display="'RGBW'" Dmx="217~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~38" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="39~57" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="58~76" />
      <Function ID="5" Name="White" Display="'White'" Dmx="77~95" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="96~114" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="115~133" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="134~152" />
      <Function ID="9" Name="RGBW" Display="'RGBW'" Dmx="153~171" />
      <Function ID="10" Name="Jump" Display="'Jump'" Dmx="172~190" />
      <Function ID="11" Name="Gradient" Display="'Gradient'" Dmx="191~209" />
      <Function ID="12" Name="Flash" Display="'Flash'" Dmx="210~228" />
      <Function ID="13" Name="Random" Display="'Random'" Dmx="229~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

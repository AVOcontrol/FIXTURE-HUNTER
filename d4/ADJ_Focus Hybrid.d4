      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="34~38" Colour="128,0,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="39~43" Colour="255,0,255" />
      <Function ID="9" Name="Dark Blue" Display="'Dark Blue'" Dmx="44~48" Colour="0,0,180" />
      <Function ID="10" Name="Light Blue" Display="'Light Blue'" Dmx="49~53" Colour="0,128,255" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="54~58" Colour="128,255,0" />
      <Function ID="12" Name="3200K CTO" Display="'3200K CTO'" Dmx="59~63" Colour="255,240,200" />
      <Function ID="13" Name="Index" Display="'%.f%%',0~100" Dmx="64~127" Colour="0,0,0" />
      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="15" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />

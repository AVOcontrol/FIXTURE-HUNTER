      <Function ID="10" Name="Amber" Display="'Amber'" Dmx="90~94" WheelPosition="9" Colour="255,100,0" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="100~104" WheelPosition="10" Colour="0,128,255" />
      <Function ID="12" Name="Blue" Display="'Blue'" Dmx="110~114" WheelPosition="11" Colour="0,0,255" />
      <Function ID="13" Name="UV" Display="'UV'" Dmx="120~124" WheelPosition="12" Colour="180,0,255" />
      <Function ID="14" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="16" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="25~29" WheelPosition="2" Colour="0,255,0" />

      <Function ID="22" Name="Ppl/ Amb" Display="'Ppl/ Amb'" Dmx="85~89" WheelPosition="8" Colour="128,0,255" />
      <Function ID="23" Name="Amb/ L Blu" Display="'Amb/ L Blu'" Dmx="95~99" WheelPosition="9" Colour="255,100,0" />
      <Function ID="24" Name="L Blu/ Blu" Display="'L Blu/ Blu'" Dmx="105~109" WheelPosition="10" Colour="0,128,255" />
      <Function ID="25" Name="Blu/ UV" Display="'Blu/ UV'" Dmx="115~119" WheelPosition="11" Colour="0,0,255" />
      <Function ID="26" Name="UV/ Op" Display="'UV/ Op'" Dmx="125~129" WheelPosition="12" Colour="180,0,255" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="28" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="201~255" Colour="0,0,0" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="140~200" Colour="0,0,0" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">

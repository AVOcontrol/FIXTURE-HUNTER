  <History Date="10-03-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="11-03-21" Author="Nic Morris" Comment="Corrected manufacturer name." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5547852c-7168-49aa-8ee5-cc2b87a75998" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="4~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="4~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Colour1Func'==1" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index/Bounce" ID="8,9,10,11,12,13" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2000~27000" Dmx="0~47" Colour="255,240,200" />
      <Function ID="3" Name="3200K White" Display="'3200K White'" Dmx="48~98" Colour="255,240,200" />
      <Function ID="4" Name="4200K White" Display="'4200K White'" Dmx="99~149" Colour="255,240,200" />
      <Function ID="5" Name="5600K White" Display="'5600K White'" Dmx="150~200" Colour="255,255,255" />
      <Function ID="6" Name="8000K White" Display="'8000K White'" Dmx="201~255" Colour="230,230,255" />
      <Function ID="7" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="13" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="8~15" />
      <Function ID="3" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="16~23" />
      <Function ID="4" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="24~31" />
      <Function ID="5" Name="Move on Sound On" Display="'Move on Sound On'" Dmx="32~39" />
      <Function ID="6" Name="Move on Sound Off" Display="'Move on Sound Off'" Dmx="40~47" />
      <Function ID="7" Name="Col on Sound On" Display="'Col on Sound On'" Dmx="48~55" />
      <Function ID="8" Name="Col on Sound Off" Display="'Col on Sound Off'" Dmx="56~63" />
      <Function ID="9" Name="Display Off" Display="'Display Off'" Dmx="64~71" />
      <Function ID="10" Name="Display On" Display="'Display On'" Dmx="72~79" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~87" />
      <Function ID="12" Name="Fan Full" Display="'Fan Full'" Dmx="88~95" />
      <Function ID="13" Name="Dim Linear" Display="'Dim Linear'" Dmx="96~103" />
      <Function ID="14" Name="Dim Slow" Display="'Dim Slow'" Dmx="104~111" />
      <Function ID="15" Name="Dim Med" Display="'Dim Med'" Dmx="112~119" />
      <Function ID="16" Name="Dim Fast" Display="'Dim Fast'" Dmx="120~127" />
      <Function ID="17" Name="Move in Dark" Display="'Move in Dark'" Dmx="128~135" />
      <Function ID="18" Name="Pan FWD Spin" Display="'Pan FWD Spin'" Dmx="136~143" />
      <Function ID="19" Name="Pan REV Spind" Display="'Pan REV Spind'" Dmx="144~151" />
      <Function ID="20" Name="Tilt FWD Spin" Display="'Tilt FWD Spin'" Dmx="152~159" />
      <Function ID="21" Name="Tilt REV Spin" Display="'Tilt REV Spin'" Dmx="160~167" />
      <Function ID="22" Name="P/T FWD Spin" Display="'P/T FWD Spin'" Dmx="168~175" />
      <Function ID="23" Name="P/T REV Spin" Display="'P/T REV Spin'" Dmx="176~183" />
      <Function ID="24" Name="Pan FWD/ Tilt REV Spind" Display="'Pan FWD/ Tilt REV Spind'" Dmx="184~191" />
      <Function ID="25" Name="Pan REV/ Tilt FWD Spin" Display="'Pan REV/ Tilt FWD Spin'" Dmx="192~199" />
    </Attribute>
  </Control>

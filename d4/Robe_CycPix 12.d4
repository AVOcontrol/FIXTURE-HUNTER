  <AtlaBase TypeID="2f9c287d-4d20-4a61-a292-af03aa8bb763" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~19" />
      <Function ID="2" Name="Display ON" Display="'Display ON'" Dmx="20~24" />
      <Function ID="3" Name="Display OFF" Display="'Display OFF'" Dmx="25~29" />
      <Function ID="4" Name="RGBW mode" Display="'RGBW mode'" Dmx="30~39" />
      <Function ID="5" Name="CMY mode" Display="'CMY mode'" Dmx="40~49" />
      <Function ID="6" Name="Col Cal On" Display="'Col Cal On'" Dmx="50~59" />
      <Function ID="7" Name="Col Cal OFF" Display="'Col Cal OFF'" Dmx="60~69" />
      <Function ID="8" Name="Dim Linear" Display="'Dim Linear'" Dmx="90~99" />
      <Function ID="9" Name="Dim Square" Display="'Dim Square'" Dmx="100~109" />
      <Function ID="10" Name="White Count On" Display="'White Count On'" Dmx="110~119" />
      <Function ID="11" Name="White Count Off" Display="'White Count Off'" Dmx="120~129" />
      <Function ID="12" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Tung" Display="'2700K Tung'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Tung" Display="'3200K Tung'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
      <Function ID="10" Name="Scroll w/ fade" Display="'Scroll w/ fade %.f%%',0~100" Dmx="248~251" Colour="255,255,255" />
      <Function ID="11" Name="Scroll no fade" Display="'Scroll no fade %.f%%',0~100" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~2" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~90" Dmx="3~182" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FW no fade" Display="'FW no fade %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="REV no fade" Display="'REV no fade %.f%%',100~0" Dmx="64~127" />
      <Function ID="3" Name="FW w/ fade" Display="'FW w/ fade %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="REV w/ fade" Display="'REV w/ fade %.f%%',100~0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Master" Name="White Master" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
  </Control>

    <Attribute ID="MBE_Effect" Name="MBE Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="MBE_Rot" />

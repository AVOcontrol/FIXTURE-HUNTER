      <Condition Name="Mode 1 (RGBW)" ID="2" If="'Mode'==1" />
      <Condition Name="Mode 3 (GEL)" ID="3" If="'Mode'==3" />
      <Condition Name="Mode 4 (Effects)" ID="4" If="'Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="3" Name="Hue" Display="'%.1f%%',-10.0~10.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PAR6" Name="PAR6" Description="" Group="C">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Else ID="1" />
      <Condition Name="Mode 1 (RGBW)" ID="2" If="'Mode'==1" />
      <Condition Name="Mode 3 (GEL)" ID="3" If="'Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Sat" Display="'%.1f%%',-10.0~10.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PAR7" Name="PAR7" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PAR8" Name="PAR8" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green_Shift1" Name="Green Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Green Shift" Display="'Green Shift %.f%%',-99~99" Dmx="5~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Cloud Effect" Display="'Cloud Effect'" Dmx="12~24" />
      <Function ID="3" Name="Club Lights Effect" Display="'Club Lights Effect'" Dmx="25~36" />
      <Function ID="4" Name="Cop Car Effect" Display="'Cop Car Effect'" Dmx="37~48" />
      <Function ID="5" Name="Fire Effect" Display="'Fire Effect'" Dmx="49~60" />
      <Function ID="6" Name="Fireworks Effect" Display="'Fireworks Effect'" Dmx="61~72" />
      <Function ID="7" Name="Explosion Effect" Display="'Explosion Effect'" Dmx="73~84" />
      <Function ID="8" Name="Lightning Effect" Display="'Lightning Effect'" Dmx="85~96" />
      <Function ID="9" Name="Flicker Effect" Display="'Flicker Effect'" Dmx="97~108" />
      <Function ID="10" Name="Paparazzi Effect" Display="'Paparazzi Effect'" Dmx="109~120" />
      <Function ID="11" Name="Party Effect" Display="'Party Effect'" Dmx="121~132" />
      <Function ID="12" Name="Process Effect" Display="'Process Effect'" Dmx="133~144" />
      <Function ID="13" Name="Pulse Effect" Display="'Pulse Effect'" Dmx="145~156" />
      <Function ID="14" Name="Strobe Effect" Display="'Strobe Effect'" Dmx="157~168" />
      <Function ID="15" Name="Television Effect" Display="'Television Effect'" Dmx="169~192" />
      <Function ID="16" Name="Welding Effect" Display="'Welding Effect'" Dmx="193~204" />
      <Function ID="17" Name="Rainbow Effect" Display="'Rainbow Effect'" Dmx="205~216" />
      <Function ID="18" Name="Glowing Water Effect" Display="'Glowing Water Effect'" Dmx="217~228" />
      <Function ID="19" Name="Northern Lights Effect" Display="'Northern Lights Effect'" Dmx="229~240" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

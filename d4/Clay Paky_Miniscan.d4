<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Miniscan" ShortName="Miniscan" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-05-06" Author="Ed" Comment="Created" />
  <History Date="04-05-06" Author="Ed" Comment="Checked" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-06-12" Author="Peter Budd" Comment="Added R20 name on the mode." />
  <History Date="26-10-12" Author="Peter Budd" Comment="Edited corrected colour wheel, to add index range and center the fixed range on the colour" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="15-10-17" Author="Nic Morris" Comment="Changed name from Mini Scan to Miniscan.  Added physical pan/tilt ranges." />
  <History Date="15-10-17" Author="Nic Morris" Comment="Revised colour index ranges for full field.  Increased wheel resolution.  Added colour function index." />
  <History Date="15-10-17" Author="Nic Morris" Comment="Added highlight/lowlight." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3f60ec2c-0e9d-4614-bb09-21cd3163ae1e" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~18" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="36~36" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="UV" Display="'UV'" Dmx="55~55" WheelPosition="3" Colour="180,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="72~72" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="91~91" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="109~109" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="127~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="18~36" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel - UV" Display="'Yel - UV %.f%%',0~100" Dmx="36~55" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="UV - Grn" Display="'UV - Grn %.f%%',0~100" Dmx="55~72" WheelPosition="3" Colour="180,0,255" />
      <Function ID="13" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="72~91" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="91~109" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu - Pk" Display="'Blu - Pk %.f%%',0~100" Dmx="109~127" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Shutter/Gobo" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~69" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="70~121" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="122~144" Intensity="0~0" />
      <Function ID="4" Name="Gobo 1" Display="'Gobo 1'" Dmx="153~161" WheelPosition="1" Intensity="0~0" />
      <Function ID="5" Name="Gobo 2" Display="'Gobo 2'" Dmx="162~172" WheelPosition="2" Intensity="0~0" />
      <Function ID="6" Name="Gobo 3" Display="'Gobo 3'" Dmx="185~201" WheelPosition="3" Intensity="0~0" />
      <Function ID="7" Name="Gobo 4" Display="'Gobo 4'" Dmx="202~220" WheelPosition="4" Intensity="0~0" />
      <Function ID="8" Name="Gobo 5" Display="'Gobo 5'" Dmx="221~245" WheelPosition="5" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="246~255" WheelPosition="0" Intensity="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CPMiniscan" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="150" TiltMax="110" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a75993ed-eaa1-4cbb-be97-69712452e0cd" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="11" Name="UV" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="12" Name="UV" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="UV" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
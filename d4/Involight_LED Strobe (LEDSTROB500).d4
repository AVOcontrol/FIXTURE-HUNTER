<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Strobe (LEDSTROB500)" ShortName="LED Strobe" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-11-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="01553de8-fe3f-4352-9361-1b69c5c4971e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="All Full" Display="'All Full %.f%%',0~100" Dmx="60~79" />
      <Function ID="3" Name="Left-&gt;Right" Display="'Left-&gt;Right %.f%%',0~100" Dmx="80~99" />
      <Function ID="4" Name="Right-&gt;Left" Display="'Right-&gt;Left %.f%%',0~100" Dmx="100~119" />
      <Function ID="5" Name="Shuffle 1" Display="'Shuffle 1 %.f%%',0~100" Dmx="120~139" />
      <Function ID="6" Name="Shuffle 2" Display="'Shuffle 2 %.f%%',0~100" Dmx="140~159" />
      <Function ID="7" Name="Shuffle 3" Display="'Shuffle 3 %.f%%',0~100" Dmx="160~179" />
      <Function ID="8" Name="Shuffle 4" Display="'Shuffle 4 %.f%%',0~100" Dmx="180~199" />
      <Function ID="9" Name="Static" Display="'Static %.f%%',0~100" Dmx="200~219" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="220~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="IVSTR500" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c5896fc8-8de9-4605-90a4-39172ebf4b58" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Effect" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Effect_Spd" ChannelOffset="4" Wheel="23" />
    </Include>
  </Mode>
</Fixture>
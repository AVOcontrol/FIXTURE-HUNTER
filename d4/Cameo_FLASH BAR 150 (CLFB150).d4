  <History Date="07-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8675b170-da33-459a-93a9-67151846c32b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~510" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~54" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="55~103" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="104~152" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="153~201" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="202~250" Update="Auto_Spd" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~54" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="55~103" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="104~152" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="153~201" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="202~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKCMF151" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

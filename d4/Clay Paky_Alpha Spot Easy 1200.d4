    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour2Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22" If="'Colour2Func'==3" />
      <Else ID="23" />

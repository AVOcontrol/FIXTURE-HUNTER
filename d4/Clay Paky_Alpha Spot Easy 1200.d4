      <Function ID="21" Name="Pk - Op" Display="'Pk - Op %.f%%',0~100" Dmx="216~255" WheelPosition="6" Colour="255,150,150" />
      <Function ID="22" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">

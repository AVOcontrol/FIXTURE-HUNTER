      <Function ID="16" Name="CTO - CTB" Display="'CTO - CTB %.f%%',0~100" Dmx="36~72" WheelPosition="1" Colour="255,240,200" />
      <Function ID="17" Name="CTB - Tq" Display="'CTB - Tq %.f%%',0~100" Dmx="72~108" WheelPosition="2" Colour="230,230,255" />

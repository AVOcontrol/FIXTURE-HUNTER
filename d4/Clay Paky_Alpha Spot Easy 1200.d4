<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot Easy 1200" ShortName="AlSpEs1200" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="03-05-07" Author="D.Milligan" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="15-03-10" Author="John Rogers" Comment="Edited Pan locate value to 40%" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Standardised conditionals.  Removed duplicate ID's from else conditions.  Moved Raw into else condition." />
  <History Date="04-09-16" Author="Nic Morris" Comment="Fixed Colour Func updates.  Added function index.  Fixed raw 16 bit range." />
  <History Date="04-09-16" Author="Nic Morris" Comment="Increased wheel resolution.  Recreated palettes.  Recreated macros.  Revised highlight/lowlight." />
  <History Date="16-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to Rain Off modes." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly.  Added physical pan/tilt limits." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Changed split colours to fixed range and added separate index ranges." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Inverted zoom." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="038737da-315f-4307-8617-70106d824072" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="36~36" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="72~72" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="108~108" WheelPosition="3" Colour="238,130,238" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="144~144" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="180~180" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="216~216" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="18~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="54~54" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="Yel/ Vlt" Display="'Yel/ Vlt'" Dmx="90~90" WheelPosition="2" Colour="255,255,0" />
      <Function ID="11" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="126~126" WheelPosition="3" Colour="238,130,238" />
      <Function ID="12" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="162~162" WheelPosition="4" Colour="0,255,0" />
      <Function ID="13" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="198~198" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="234~234" WheelPosition="6" Colour="0,0,255" />
      <Function ID="15" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~36" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="36~72" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel - Vlt" Display="'Yel - Vlt %.f%%',0~100" Dmx="72~108" WheelPosition="2" Colour="255,255,0" />
      <Function ID="18" Name="Vlt - Grn" Display="'Vlt - Grn %.f%%',0~100" Dmx="108~144" WheelPosition="3" Colour="238,130,238" />
      <Function ID="19" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="144~180" WheelPosition="4" Colour="0,255,0" />
      <Function ID="20" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="180~216" WheelPosition="5" Colour="255,128,0" />
      <Function ID="21" Name="Blu - Op" Display="'Blu - Op %.f%%',0~100" Dmx="216~255" WheelPosition="6" Colour="0,0,255" />
      <Function ID="22" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />

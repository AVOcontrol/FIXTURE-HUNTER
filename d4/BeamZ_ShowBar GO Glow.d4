    <Attribute ID="Spot_Col_Func" Name="Spot Col Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Spot_Colour" Name="Spot Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Spot_Col_Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Spot_Col_Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Spot_Col_Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~14" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~21" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="22~28" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Lemon" Display="'Lemon'" Dmx="29~35" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="36~42" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="43~49" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="50~56" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="57~66" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="67~76" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="77~86" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Blu/ Lmn" Display="'Blu/ Lmn'" Dmx="87~96" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Lmn/ Org" Display="'Lmn/ Org'" Dmx="97~106" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Org/ Pk" Display="'Org/ Pk'" Dmx="107~116" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Pk/ Cy" Display="'Pk/ Cy'" Dmx="117~127" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />

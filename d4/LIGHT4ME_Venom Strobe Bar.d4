  <Thumbnail>c4eb2395-ba94-4c9f-a6c7-8ee22f5de39c</Thumbnail>
  <History Date="09-12-19" Author="Nic Morris" Comment="Created (documentation is vague)" Version="1" />
  <History Date="11-12-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="08-03-24" Author="Nic Morris" Comment="Created from LIGHT4ME Thunder Bar (similarly vague documentation.  no pixel layout - assumed the same)" Version="3" />
  <History Date="13-03-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="105fdaeb-8d84-4074-83d5-ed48f14ec85f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="8~19" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="20~31" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="32~43" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="44~55" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="56~67" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="68~79" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="80~91" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="92~103" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="104~115" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="116~127" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="128~139" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="140~151" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="152~163" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="164~175" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="176~187" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="188~199" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="200~211" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="212~223" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="224~235" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="WW" Display="'WW'" Dmx="40~79" />
      <Function ID="3" Name="Strobe" Display="'Strobe'" Dmx="80~119" />
      <Function ID="4" Name="RGB" Display="'RGB'" Dmx="120~159" />
      <Function ID="5" Name="WW+Strobe" Display="'WW+Strobe'" Dmx="160~199" />
      <Function ID="6" Name="WW+RGB" Display="'WW+RGB'" Dmx="200~239" />
      <Function ID="7" Name="Strobe+RGB" Display="'Strobe+RGB'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>

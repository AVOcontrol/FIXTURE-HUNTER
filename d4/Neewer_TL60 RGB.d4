    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
      <Function ID="2" Name="HSI" Display="'HSI'" Dmx="39~77" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
      <Function ID="3" Name="RGBCW" Display="'RGBCW'" Dmx="78~115" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour_Param_1, Colour_Param_2, Colour_Param_3, Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Param_1" Name="Colour Param 1" Description="" Group="C">
      <Locate Locate="2:2500" PowerOn="2:2500" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Colour_Mode'==1" />
      <Condition Name="HSI" ID="3" If="'Colour_Mode'==2" />
      <Condition Name="RGBCW" ID="4" If="'Colour_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.fK',2500~10000" Dmx="0~255" Colour="255,240,200" />
      <Function ID="3" Name="Hue" Display="'%.f°',1~360" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Colour_Param_2" Name="Colour Param 2" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1" />
      <Condition Name="CCT" ID="2" If="'Colour_Mode'==1" />
      <Condition Name="HSI" ID="3" If="'Colour_Mode'==2" />
      <Condition Name="RGBCW" ID="4" If="'Colour_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="G/M" Display="'%.1f',-50.0~50.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="4" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Colour_Param_3" Name="Colour Param 3" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="RGBCW" ID="2" If="'Colour_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Param_4" Name="Colour Param 4" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="RGBCW" ID="2" If="'Colour_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Cool White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Colour_Param_5" Name="Colour Param 5" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="RGBCW" ID="2" If="'Colour_Mode'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Warm White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>

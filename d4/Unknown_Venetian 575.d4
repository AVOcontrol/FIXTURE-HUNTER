<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Venetian 575" ShortName="Venetian" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="11-12-21" Author="Nic Morris" Comment="Created (very poor documentation)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="31~42" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="43~54" Colour="0,0,255" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="55~66" Colour="255,128,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="67~78" Colour="255,0,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="79~90" Colour="0,255,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="91~102" Colour="255,255,0" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="103~113" Colour="0,255,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="114~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="64~95" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="96~127" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="192~223" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="224~255" WheelPosition="7" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~139" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="140~243" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Max" Display="'Max'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="3" Wheel="15" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Prism" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:2" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
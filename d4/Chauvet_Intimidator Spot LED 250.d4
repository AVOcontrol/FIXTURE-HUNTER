      <Function ID="14" Name="Red" Display="'Red'" Dmx="93~99" Colour="255,0,0" />
      <Function ID="15" Name="Light Blue" Display="'Light Blue'" Dmx="100~106" Colour="0,128,255" />
      <Function ID="16" Name="Light Green" Display="'Light Green'" Dmx="107~113" Colour="128,255,0" />
      <Function ID="17" Name="Orange" Display="'Orange'" Dmx="114~120" Colour="255,128,0" />
      <Function ID="18" Name="Dark Blue" Display="'Deep Blue'" Dmx="121~127" Colour="0,0,180" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />

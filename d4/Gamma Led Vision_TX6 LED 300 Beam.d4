      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="6,7,8,9" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="0-250" Display="'0-250 %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="0-90" Display="'0-90 %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="0-250" Display="'0-250 %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="0-360" Display="'0-360 %.f%%',0~100" Dmx="156~175" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="215~176" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="216~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="0-250" Display="'0-250 %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="0-90" Display="'0-90 %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="0-250" Display="'0-250 %.f%%',0~100" Dmx="136~155" />

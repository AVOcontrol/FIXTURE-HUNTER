  <History Date="14-05-12" Author="Pers Creator" Comment="Imported from Pearl Personality: ABFUT1CE.R20 and updated." />
  <History Date="04-04-16" Author="Nic Morris" Comment="Increased wheel resolution.  Updated pan/tilt power on values to match locate." />
  <History Date="04-04-16" Author="Nic Morris" Comment="Removed shutter hilight/lolight values and replaced with colours." />
  <History Date="04-04-16" Author="Nic Morris" Comment="Changed colour functions to variable ranges in attempt to fix customer bug report (documentation suggests intermediate colours available)" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Moved shutter into correct wheel slot." />
  <History Date="02-12-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d783c483-5091-4ec3-ae45-8f43829d2b42" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">

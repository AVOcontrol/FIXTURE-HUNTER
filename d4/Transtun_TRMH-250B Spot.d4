      <Palette ID="9" Name="Pink" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Scroll CW" Number="7" Page="1" SetControl="Colour1:12:50,Colour1Func:2" />
      <Palette ID="11" Name="Rose" Number="9" Page="1" SetControl="Colour1:10,Colour1Func:1" />
      <Palette ID="12" Name="Rose" Number="10" Page="1" SetControl="Colour1:10,Colour1Func:1" />

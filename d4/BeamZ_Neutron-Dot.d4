  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="30d94a06-e50e-4fb2-9dab-815ec4905f3d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Beam_Duration" Name="Beam Duration" Description="" Group="I">
      <Locate Locate="1:7" PowerOn="1:7" />
      <Function ID="1" Name="Duration" Display="'%.fms',7~650" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Strobe" Name="Beam Strobe" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~250" />
    </Attribute>
    <Attribute ID="Beam_Effect" Name="Beam Effect" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="11~60" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="61~160" />
      <Function ID="4" Name="Ramp Up, Down" Display="'Ramp Up, Down'" Dmx="161~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display On" Display="'Display On'" Dmx="6~15" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="16~25" />
      <Function ID="4" Name="Dim Linear" Display="'Dim Linear'" Dmx="36~45" />
      <Function ID="5" Name="Dim Square" Display="'Dim Square'" Dmx="46~55" />
      <Function ID="6" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="56~65" />
      <Function ID="7" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="66~75" />
      <Function ID="8" Name="Dim Response LED" Display="'Dim Response LED'" Dmx="86~96" />
      <Function ID="9" Name="Dim Response Halogen" Display="'Dim Response Halogen'" Dmx="97~105" />
      <Function ID="10" Name="LED PWM Freq 800Hz" Display="'LED PWM Freq 800Hz'" Dmx="116~125" />
      <Function ID="11" Name="LED PWM Freq 1200Hz" Display="'LED PWM Freq 1200Hz'" Dmx="126~135" />
      <Function ID="12" Name="LED PWM Freq 2000Hz" Display="'LED PWM Freq 2000Hz'" Dmx="136~145" />
      <Function ID="13" Name="LED PWM Freq 3600Hz" Display="'LED PWM Freq 3600Hz'" Dmx="146~155" />

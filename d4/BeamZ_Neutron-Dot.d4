  <History Date="27-04-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="02-05-19" Author="Nic Morris" Comment="Revised Aura CTC function ranges and added pixel layout in line with user guide rev A final (previously was draft)" Version="3" />

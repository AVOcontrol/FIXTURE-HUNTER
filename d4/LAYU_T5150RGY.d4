<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="T5150RGY" ShortName="T5150RGY" Company="LAYU">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="25-10-17" Author="Nic Morris" Comment="Created (poor documentation)" />
  <History Date="27-10-17" Author="Nic Morris" Comment="Revised 'Mode' function names in response to customer bug report (original charts were wrong)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="50~99" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="100~149" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Scan_Track" Name="Scan Track" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Pos" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y-Pos" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Speed" Name="Scan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Spin_Direction" Name="Spin Direction" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW'" Dmx="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="100~199" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Spin_Speed" Name="Spin Speed" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red+Green" Display="'Red+Green'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="100~199" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="UKLYUT51" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Scan_Track" ChannelOffset="2" Wheel="13" />
      <Attribute ID="X-Pos" ChannelOffset="3" Wheel="2" />
      <Attribute ID="Y-Pos" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Scan_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Spin_Direction" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Spin_Speed" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="9" Wheel="8" />
    </Include>
  </Mode>

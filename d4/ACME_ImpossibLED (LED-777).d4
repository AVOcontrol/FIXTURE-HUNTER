    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pattern" ID="1,2" If="'Control'==1" />
      <Condition Name="Chase" ID="3" If="'Control'==2" />
      <Else ID="4" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

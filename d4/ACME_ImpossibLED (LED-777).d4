  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern" Display="'Pattern'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Chase" Display="'Chase'" Dmx="120~239" Update="Speed" />
      <Function ID="3" Name="Stand-Alone" Display="'Stand-Alone'" Dmx="240~255" Update="Speed" />
    </Attribute>

      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="176~185" Update="Program_Speed" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="186~195" Update="Program_Speed" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="196~205" Update="Program_Speed" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="206~215" Update="Program_Speed" />
      <Function ID="22" Name="Auto" Display="'Auto'" Dmx="216~235" Update="Program_Speed" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="236~255" Update="Program_Speed" />
    </Attribute>
    <Attribute ID="Program_Speed" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sensitivity" ID="2" If="'Programs'==23" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

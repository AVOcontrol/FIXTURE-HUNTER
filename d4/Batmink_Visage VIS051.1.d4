      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="184~195" Colour="255,255,255" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="196~207" Colour="255,255,255" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="208~219" Colour="255,255,255" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="220~231" Colour="255,255,255" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="232~243" Colour="255,255,255" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="244~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Programs" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Program_Speed" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~25" Update="Program_Speed" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="26~35" Update="Program_Speed" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="36~45" Update="Program_Speed" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="46~55" Update="Program_Speed" />

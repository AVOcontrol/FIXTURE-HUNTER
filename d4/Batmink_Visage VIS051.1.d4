      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="86~95" Update="Program_Speed" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="96~105" Update="Program_Speed" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="106~115" Update="Program_Speed" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="116~125" Update="Program_Speed" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="126~135" Update="Program_Speed" />

  </Mode>
  <Mode Name="4 DMX" Channels="4" Id="6b8e94c4-a8f1-44bd-b19a-afa70e13dadd">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a922985a-48bf-4117-a82d-70159cc1fa6d" />
    <Include>
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="10" />

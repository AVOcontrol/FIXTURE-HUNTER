<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin 600 PureWhite SW" ShortName="600 PW SW" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>17aa14ec-7bea-4f27-8028-34c9e5b92eb1</Thumbnail>
  <History Date="31-03-11" Author="John Rogers" Comment="Created" />
  <History Date="26-04-11" Author="John Rogers" Comment="Edited Colour Macro to become LED Zone Effects channel in response to Robe." />
  <History Date="09-09-11" Author="John Rogers" Comment="Edited Zone Effects to locate to DMX 0." />
  <History Date="29-10-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Changed Control Safe function to text only." />
  <History Date="29-10-11" Author="Nic Morris" Comment="Added pixel mapper compatibility.  Added missing macros." />
  <History Date="24-08-12" Author="Peter Budd" Comment="Added V1.1 Spec" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-08-18" Author="Nic Morris" Comment="Changed name from Robin 600 Pure White to Robin 600 PureWhite SW" />
  <History Date="28-08-18" Author="Nic Morris" Comment="Added product thumbnail.  Revised warm white and cool white with reserved ID's for compatibility." />
  <History Date="28-08-18" Author="Nic Morris" Comment="Changed warm white and cool white to power on and locate at full." />
  <History Date="28-08-18" Author="Nic Morris" Comment="Fixed colour macro ranges ('white' should have been variable and zone effect was fixed as one option)" />
  <History Date="28-08-18" Author="Nic Morris" Comment="Added Atlabase ID's to v1.1 modes (reused - only difference is 'Zone Effects'/'Colour Macro').  Added channel counts to mode names." />
  <History Date="28-08-18" Author="Nic Morris" Comment="Fixed v1.1 wheel mapping (colour macro was conflicting with tilt)" />
  <Manual Filename="" Summary="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Indigo 250" ShortName="Indigo 250" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>83b96827-7d09-461b-bd7e-6c0be831a65f</Thumbnail>
  <History Date="04-06-09" Author="David Hunt" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="28-07-15" Author="Gregory Haynes" Comment="Added Highlight and Lowlight values." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Added product thumbnail.  Added physical pan/tilt ranges.  Revised mode names with channel counts." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Inverted P/T speed.  Standardised conditionals.  Revised colour function names." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Increased wheel resolution.  Revised prism and gobo 2 rot DMX ranges.  Reordered Gobo Shake functions." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Revised shutter functions and ranges and corrected typo.  Revised effect with discreet fixed functions." />
  <History Date="11-10-18" Author="Nic Morris" Comment="Revised palettes.  Added alternative advanced mode (customer confirmed 16bit pan/tilt mapping with actual fixture)" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Removed closed shutter and corrected shutter open and gobo rot direction." />
  <History Date="13-10-18" Author="Nic Morris" Comment="Added Atlabase ID to alternative mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4732d4a9-1066-43ff-abaf-9a827d4f9436" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="20~39" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="40~59" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="60~79" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="80~99" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="100~119" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="120~139" />
      <Function ID="8" Name="Custom" Display="'Custom'" Dmx="140~159" />
      <Function ID="9" Name="Test" Display="'Test'" Dmx="160~179" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="200~219" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange Red" Display="'Orange Red'" Dmx="20~39" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="40~59" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="60~79" Colour="0,255,0" />
      <Function ID="5" Name="Light Orange" Display="'Light Orange'" Dmx="80~99" Colour="255,128,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="100~119" Colour="0,0,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="120~139" Colour="255,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="140~159" Colour="255,150,150" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="160~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~132" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="3~127" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="200~219" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="180~199" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="160~179" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="140~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="120~139" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="100~119" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="80~99" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />

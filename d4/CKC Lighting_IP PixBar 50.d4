  <History Date="01-05-21" Author="Nic Morris" Comment="Corrected FX mode colour macros." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e4e3d847-2e48-43f9-9b68-7a2ee2485080" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3,4" If="'Colour_Macro'&gt;16" />
      <Else ID="1,2" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Shutter" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Update="Shutter" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Update="Shutter" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="50~59" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="60~69" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="BW" Display="'BW'" Dmx="70~79" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="RW" Display="'RW'" Dmx="80~89" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="90~99" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="RB" Display="'RB'" Dmx="100~109" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="110~119" Update="Shutter" Colour="255,255,255" />

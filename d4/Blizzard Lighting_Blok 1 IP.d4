  <History Date="14-05-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~115" />
      <Function ID="3" Name="Sine Wave" Display="'Sine Wave %.f%%',0~100" Dmx="131~170" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="170~210" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="211~250" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Custom Col 1 (CTO1)" Display="'Custom Col 1 (CTO1)'" Dmx="6~10" />
      <Function ID="3" Name="Custom Col 2 (CTO2)" Display="'Custom Col 2 (CTO2)'" Dmx="11~15" />
      <Function ID="4" Name="Custom Col 3 (CTO3)" Display="'Custom Col 3 (CTO3)'" Dmx="16~20" />
      <Function ID="5" Name="Custom Col 4 (CTO4)" Display="'Custom Col 4 (CTO4)'" Dmx="21~25" />
      <Function ID="6" Name="Custom Col 5 (CTO5)" Display="'Custom Col 5 (CTO5)'" Dmx="26~30" />
      <Function ID="7" Name="Custom Col 6 (CTO6)" Display="'Custom Col 6 (CTO6)'" Dmx="31~35" />
      <Function ID="8" Name="Custom Col 7 (CTO7)" Display="'Custom Col 7 (CTO7)'" Dmx="36~40" />
      <Function ID="9" Name="Custom Col 8 (CTO8)" Display="'Custom Col 8 (CTO8)'" Dmx="41~45" />
      <Function ID="10" Name="Custom Col 9 (CTO9)" Display="'Custom Col 9 (CTO9)'" Dmx="46~50" />
      <Function ID="11" Name="Custom Col 10 (CT10)" Display="'Custom Col 10 (CT10)'" Dmx="51~55" />
      <Function ID="12" Name="Auto 1" Display="'Auto 1'" Dmx="56~60" />
      <Function ID="13" Name="Auto 2" Display="'Auto 2'" Dmx="61~65" />
      <Function ID="14" Name="Auto 3" Display="'Auto 3'" Dmx="66~70" />
      <Function ID="15" Name="Auto 4" Display="'Auto 4'" Dmx="71~75" />
      <Function ID="16" Name="Auto 5" Display="'Auto 5'" Dmx="76~80" />
      <Function ID="17" Name="Custom Prog (CH01)" Display="'Custom Prog (CH01)'" Dmx="221~225" />
      <Function ID="18" Name="Custom Prog (CH02)" Display="'Custom Prog (CH02)'" Dmx="226~230" />
      <Function ID="19" Name="Custom Prog (CH03)" Display="'Custom Prog (CH03)'" Dmx="231~235" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Virtual_Col" Name="Virtual Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="11~11" Colour="0,0,255" />
      <Function ID="3" Name="Blu-Teal" Display="'Blu-Teal %.f%%',0~100" Dmx="11~51" Colour="0,0,255" />
      <Function ID="4" Name="Teal" Display="'Teal'" Dmx="51~51" Colour="0,255,200" />
      <Function ID="5" Name="Teal-Grn" Display="'Teal-Grn %.f%%',0~100" Dmx="51~91" Colour="0,255,200" />
      <Function ID="6" Name="Grn" Display="'Grn'" Dmx="91~91" Colour="0,255,0" />
      <Function ID="7" Name="Grn-Yel" Display="'Grn-Yel %.f%%',0~100" Dmx="91~131" Colour="0,255,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="131~131" Colour="255,255,0" />
      <Function ID="9" Name="Yel-Rd" Display="'Yel-Rd %.f%%',0~100" Dmx="131~171" Colour="255,255,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="171~171" Colour="255,0,0" />
      <Function ID="11" Name="Rd-Mag" Display="'Rd-Mag %.f%%',0~100" Dmx="171~211" Colour="255,0,0" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="211~211" Colour="255,0,255" />
      <Function ID="13" Name="Mag-Blu" Display="'Mag-Blu %.f%%',0~100" Dmx="211~251" Colour="255,0,255" />
      <Function ID="14" Name="Blue" Display="'Blue'" Dmx="251~255" Colour="0,0,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="21~30" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="31~40" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Square Smooth" Display="'Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Inv Sq Smooth" Display="'Inv Sq Smooth'" Dmx="71~80" />
      <Function ID="9" Name="S-Curve Smooth" Display="'S-Curve Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Default" Display="'Default'" Dmx="91~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">

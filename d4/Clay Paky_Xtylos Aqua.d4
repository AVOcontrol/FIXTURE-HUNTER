  <History Date="12-04-19" Author="Nic Morris" Comment="Created (prelim DMX channels 04/2019 charts.  lots missing)" Version="1" />
  <History Date="22-07-19" Author="Nic Morris" Comment="Updated in line with DMX Channels 07/2019 charts (still 'prelim!').  Adds CTO, gobo and effect ranges, revises functions and macros." Version="2" />
  <History Date="22-07-19" Author="Nic Morris" Comment="Note 'Vector' mode seems to have disappeared.  Kept for now making best guess." Version="3" />
  <History Date="23-07-19" Author="Nic Morris" Comment="Added Atlabase ID's (Standard mode only at the moment)" Version="4" />
  <History Date="25-08-20" Author="Nic Morris" Comment="Updated in line with latest documentation (DMX Channels 06/2020)" Version="5" />
  <History Date="11-02-21" Author="Nic Morris" Comment="Updated in line with latest documentation (DMX Channels 01/2021) in response to manufacturer request (adds gobo images, BAZ Fading control, revises Show Setup/Macros, removes 'Vector' mode)" Version="6" />
  <History Date="09-03-22" Author="Nic Morris" Comment="Created from Clay Paky Xtylos (identical)" Version="7" />
  <History Date="11-03-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />

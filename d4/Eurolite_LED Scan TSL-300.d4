<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Scan TSL-300" ShortName="TSL-300 Sc" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="12-07-13" Author="Peter Budd" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="727bda0b-a63e-4c90-9108-8be918d9d873" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~30" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="31~61" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="62~92" Colour="0,255,0" />
      <Function ID="4" Name="Light Yellow" Display="'Yellow'" Dmx="93~123" Colour="255,255,128" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="124~154" Colour="255,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="155~185" Colour="255,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="186~216" Colour="255,150,150" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="217~247" Colour="0,128,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="248~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~30" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="31~61" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="62~92" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="93~123" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="124~154" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="155~185" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="186~216" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="217~247" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="248~255" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~251" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="252~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="EX_ScTSL300" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b7e4940c-1056-4b31-9fbc-b8fd5e24858d" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:9" />
      <Palette ID="3" Name="Yellow" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:6" />
      <Palette ID="5" Name="Yellow" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:8" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:8" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:2" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:5" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:5" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:7" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:2" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
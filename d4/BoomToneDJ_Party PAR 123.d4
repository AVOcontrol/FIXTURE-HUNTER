  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="11~50" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="51~100" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="101~150" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="151~200" />

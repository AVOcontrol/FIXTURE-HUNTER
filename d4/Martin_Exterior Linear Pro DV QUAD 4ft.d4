    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1000K" Display="'1000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1050-3950K" Display="'1050-3950K %.fK',1050~3950" Dmx="19~77" Colour="255,255,255" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="78~78" Colour="255,255,255" />
      <Function ID="4" Name="4050-6450K" Display="'4050-6450K %.fK',4050~6450" Dmx="79~127" Colour="255,255,255" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="6" Name="6550-12800K" Display="'6550-12800K %.fK',6550~12800" Dmx="129~254" Colour="255,255,255" />
      <Function ID="7" Name="12850K" Display="'12850K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

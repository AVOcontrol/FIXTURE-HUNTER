<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SMARTMODULA" ShortName="SMTMODULA" Company="Prolights">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>40a8bc42-e6db-4ec1-94f6-52bf040fa482</Thumbnail>
  <History Date="21-01-18" Author="Nic Morris" Comment="Created (colour macro charts have range conflicts - removed duplicate light orange and made best guess)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~25" Colour="255,0,0" />
      <Function ID="3" Name="Deep Orange" Display="'Deep Orange'" Dmx="26~35" Colour="255,100,0" />
      <Function ID="4" Name="Light Orange" Display="'Light Orange'" Dmx="36~45" Colour="255,128,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="46~55" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="56~65" Colour="0,255,0" />
      <Function ID="7" Name="Sea Green" Display="'Sea Green'" Dmx="66~75" Colour="0,255,128" />
      <Function ID="8" Name="Aquamarine" Display="'Aquamarine'" Dmx="76~85" Colour="0,255,200" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="86~95" Colour="0,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="96~105" Colour="0,0,255" />
      <Function ID="11" Name="Violet" Display="'Violet'" Dmx="106~115" Colour="180,0,255" />
      <Function ID="12" Name="Purple" Display="'Purple'" Dmx="116~125" Colour="128,0,255" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="126~135" Colour="255,0,255" />
      <Function ID="14" Name="Full RGB" Display="'Full RGB'" Dmx="136~145" Colour="255,255,255" />
      <Function ID="15" Name="White" Display="'White'" Dmx="146~155" Colour="255,255,255" />
      <Function ID="16" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="156~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="PGSMTMD1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">

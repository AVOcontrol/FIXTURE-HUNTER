<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Zoom Moving Light" ShortName="LED Zm ML" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="10-10-17" Author="Nic Morris" Comment="Created (no documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~59" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="60~64" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="65~114" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="115~119" />
      <Function ID="6" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="120~169" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="170~174" />
      <Function ID="8" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="175~224" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="225~234" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="235~244" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGBWA" Display="'RGBWA'" Dmx="3~5" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="6~8" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="9~11" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="12~14" Colour="255,255,255" />
      <Function ID="6" Name="W" Display="'W'" Dmx="15~17" Colour="255,255,255" />
      <Function ID="7" Name="A" Display="'A'" Dmx="18~20" Colour="255,255,255" />
      <Function ID="8" Name="RG" Display="'RG'" Dmx="21~23" Colour="255,255,255" />
      <Function ID="9" Name="RB" Display="'RB'" Dmx="24~26" Colour="255,255,255" />
      <Function ID="10" Name="RA" Display="'RA'" Dmx="27~29" Colour="255,255,255" />
      <Function ID="11" Name="GB" Display="'GB'" Dmx="30~32" Colour="255,255,255" />
      <Function ID="12" Name="GA" Display="'GA'" Dmx="33~35" Colour="255,255,255" />
      <Function ID="13" Name="BA" Display="'BA'" Dmx="36~38" Colour="255,255,255" />
      <Function ID="14" Name="RGB" Display="'RGB'" Dmx="39~41" Colour="255,255,255" />
      <Function ID="15" Name="RGA" Display="'RGA'" Dmx="42~44" Colour="255,255,255" />
      <Function ID="16" Name="GBA" Display="'GBA'" Dmx="45~47" Colour="255,255,255" />
      <Function ID="17" Name="RGA" Display="'RGA'" Dmx="48~49" Colour="255,255,255" />
      <Function ID="18" Name="Yel/Amb" Display="'Yel/Amb %.f%%',0~100" Dmx="50~83" Colour="255,255,255" />
      <Function ID="19" Name="Org/Grn" Display="'Org/Grn %.f%%',0~100" Dmx="84~117" Colour="255,255,255" />
      <Function ID="20" Name="Grn/Amb" Display="'Grn/Amb %.f%%',0~100" Dmx="118~151" Colour="255,255,255" />
      <Function ID="21" Name="Aq/Amb" Display="'Aq/Amb %.f%%',0~100" Dmx="152~185" Colour="255,255,255" />
      <Function ID="22" Name="Rd/Amb" Display="'Rd/Amb %.f%%',0~100" Dmx="186~218" Colour="255,255,255" />
      <Function ID="23" Name="Rd/Mag" Display="'Rd/Mag %.f%%',0~100" Dmx="219~252" Colour="255,255,255" />
      <Function ID="24" Name="RGBWA" Display="'RGBWA'" Dmx="253~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Gradual" Display="'Gradual %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Jump" Display="'Jump %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="252~0" />
      <Function ID="2" Name="Vector" Display="'Vector'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Auto Pan" Display="'Auto Pan'" Dmx="50~99" />
      <Function ID="3" Name="Auto Tilt" Display="'Auto Tilt'" Dmx="100~149" />
      <Function ID="4" Name="Auto P/T" Display="'Auto P/T'" Dmx="150~199" />
      <Function ID="5" Name="No Macro" Display="'No Macro'" Dmx="200~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="UKLEDZML" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,14" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Auto" ChannelOffset="12" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="15" Wheel="25" />
      <Attribute ID="P/T_Macro" ChannelOffset="16" Wheel="22" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:10" Delay="6000" />
      <Set Channel="Shutter:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
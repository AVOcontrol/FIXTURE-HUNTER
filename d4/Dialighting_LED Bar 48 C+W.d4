  <Thumbnail>89a76e86-f7f5-4eb0-bef3-578743a2076c</Thumbnail>
  <History Date="02-03-18" Author="Nic Morris" Comment="Created" />
  <History Date="13-03-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="961071a3-e18d-4c94-bb58-ebc5f5b97c28" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="11~40" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="41~70" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="71~100" Colour="255,255,255" />
      <Function ID="5" Name="3400K" Display="'3400K'" Dmx="101~130" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="131~160" Colour="255,255,255" />
      <Function ID="7" Name="4900K" Display="'4900K'" Dmx="161~190" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="191~220" Colour="255,255,255" />
      <Function ID="9" Name="5900K" Display="'5900K'" Dmx="221~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 3 DMX" Channels="3">
    <Import PearlRef="DAB48CW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9257f76b-a992-4f0c-92b1-6fe2b17ea31b" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 2 DMX" Channels="2">
    <Import PearlRef="DAB48CW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5d9fe115-1f5d-4941-a3c1-b9d51f223301" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 7 DMX" Channels="7">
    <Import PearlRef="DAB48CW3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bb911b82-b4e7-457d-b96a-0d35baf9d741" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dim_Spd" ChannelOffset="6" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="89a76e86-f7f5-4eb0-bef3-578743a2076c"></Swatch>
  </swatchLibrary>
</Fixture>
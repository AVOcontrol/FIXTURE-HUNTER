      <Attribute ID="Col_Preset_Dim" ChannelOffset="14" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Standard" Channels="17">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 ZF 150 LED Zoom Fresnel CW" ShortName="ZF 150 CW" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="01-09-17" Author="Nic Morris" Comment="Created (note Dim Curve set to power on and locate at linear in response to customer request - assumed Halogen)" />
  <History Date="02-09-17" Author="Nic Morris" Comment="Shortended name from elumen8 ZF 150 LED Zoom Fresnel CW (ELUM093) to elumen8 ZF 150 LED Zoom Fresnel CW" />
  <History Date="02-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b03ccb14-05ce-4349-83f5-f009be4a30cd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear Halogen" Display="'Linear Halogen'" Dmx="15~44" />
      <Function ID="3" Name="Square Halogen" Display="'Square Halogen'" Dmx="45~74" />
      <Function ID="4" Name="Inv Sq Halogen" Display="'Inv Sq Halogen'" Dmx="75~104" />
      <Function ID="5" Name="S-Curve Halogen" Display="'S-Curve Halogen'" Dmx="105~134" />
      <Function ID="6" Name="Linear LED" Display="'Linear LED'" Dmx="135~164" />
      <Function ID="7" Name="Square LED" Display="'Square LED'" Dmx="165~194" />
      <Function ID="8" Name="Inv Sq LED" Display="'Inv Sq LED'" Dmx="195~224" />
      <Function ID="9" Name="S-Curve LED" Display="'S-Curve LED'" Dmx="225~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="PTE8Z5C1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="343c35c6-c564-496d-9695-e95b46ae19db" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="PTE8Z5C2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="de0371ea-ebe8-48fe-8ca4-4600da0bbd0f" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Dim_Spd" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Color Jet" ShortName="Color Jet" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>10882b88-9652-4d34-a907-a32d075576f4</Thumbnail>
  <History Date="21-10-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cfb2736f-480f-474a-8d0b-81c768e9b103" />
  <Control>
    <Attribute ID="Dimmer" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Fog" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Colour" Display="'No Colour'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~85" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="86~170" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="171~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Colour" Display="'No Colour'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red+Blue" Display="'Red+Blue'" Dmx="6~85" Colour="255,255,255" />
      <Function ID="3" Name="Green+Red" Display="'Green+Red'" Dmx="86~170" Colour="255,255,255" />
      <Function ID="4" Name="Blue+Green" Display="'Blue+Green'" Dmx="171~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Random_Col" Name="Random Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Colour" Display="'No Colour'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Random Col" Display="'Random Col'" Dmx="6~85" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="JBCOLJET" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="795af7df-69cb-44bc-947b-10da379f0ccc" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Colour2" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Random_Col" ChannelOffset="4" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="No Colour" Number="1" Page="1" SetControl="Colour1:1,Colour2:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour2:1" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:2,Colour2:1" />
      <Palette ID="4" Name="No Colour" Number="4" Page="1" SetControl="Colour1:1,Colour2:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour2:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour2:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour2:1" />
      <Palette ID="8" Name="No Colour" Number="6" Page="1" SetControl="Colour1:1,Colour2:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour2:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4,Colour2:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4,Colour2:1" />
      <Palette ID="12" Name="No Colour" Number="10" Page="1" SetControl="Colour1:1,Colour2:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour2:1" />
      <Palette ID="14" Name="No Colour" Number="8" Page="1" SetControl="Colour1:1,Colour2:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4,Colour2:1" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="10882b88-9652-4d34-a907-a32d075576f4"></Swatch>
  </swatchLibrary>
</Fixture>
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="18259" ModelID="1849" />
  </RDM>
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Preset" Name="Colour Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="5~9" Colour="0,0,0" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="10~14" Colour="0,0,0" />
      <Function ID="4" Name="White 4300K" Display="'White 4300K'" Dmx="15~19" Colour="0,0,0" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="20~24" Colour="0,0,0" />
      <Function ID="6" Name="White 6500K" Display="'White 6500K'" Dmx="25~29" Colour="0,0,0" />
      <Function ID="7" Name="White 8000K" Display="'White 8000K'" Dmx="30~34" Colour="0,0,0" />
      <Function ID="8" Name="White 2700-8000K" Display="'White 2700-8000K %.fK',2700~8000" Dmx="35~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="31~50" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="51~70" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="71~90" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="91~110" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="111~130" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="131~150" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="151~170" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="171~190" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="191~210" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="211~230" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="3:100" PowerOn="3:100" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~131" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="126~130" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="125~0" />
    </Attribute>
    <Attribute ID="Chase_Fade" Name="Chase Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Fresh_Mode" Name="Fresh Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Low End" Display="'Low End'" Dmx="64~127" />
      <Function ID="3" Name="Stage" Display="'Stage'" Dmx="128~191" />
      <Function ID="4" Name="High Speed" Display="'High Speed'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />

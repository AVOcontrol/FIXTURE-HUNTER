<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PLB-280" ShortName="PLB-280" Company="Future Light">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>2eda6dd2-cde7-4f31-9fe8-f096af433f96</Thumbnail>
  <History Date="15-03-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-03-15" Author="Nic Morris" Comment="Added lamp on/off in line with latest documentation in response to manufacturer request." />
  <History Date="25-03-15" Author="Nic Morris" Comment="Changed Gobo2Func to default at zero in attempt to fix manufacturer bug report." />
  <History Date="16-05-15" Author="Nic Morris" Comment="Created from Prolights Jasper" />
  <History Date="20-06-15" Author="Nic Morris" Comment="Changed all first fixed functions to default to zero in yet another attempt to make this work." />
  <History Date="22-06-15" Author="Nic Morris" Comment="Updated prism rot functions to latest spec in response to manufacturer request." />
  <History Date="30-06-15" Author="Nic Morris" Comment="Added prism 1 condition to prism rot with CW and CCW ranges swapped in response to manufacturer request." />
  <History Date="23-07-15" Author="Nic Morris" Comment="Changed colours Blue Green to Dark Blue and Amber to CTO in response to manufacturer request." />
  <History Date="23-07-15" Author="Nic Morris" Comment="Swapped prism rot CW and CCW spin ranges in response to manufacturer request." />
  <History Date="01-08-15" Author="Nic Morris" Comment="Updated split colour functions to new Dark Blue and CTO in response to manufacturer request." />
  <History Date="01-08-15" Author="Nic Morris" Comment="Swapped prism functions again in response to manufacturer request." />
  <History Date="12-09-15" Author="Nic Morris" Comment="Inverted Prism 1 CW range in response to manufacturer request." />
  <History Date="02-12-15" Author="Nic Morris" Comment="Created from Prolights JADE" />
  <History Date="03-01-19" Author="Nic Morris" Comment="Added product thumbnail.  Added Atlabase ID's.  Added channel counts to mode names." />
  <History Date="03-01-19" Author="Nic Morris" Comment="Added physical pan/tilt ranges." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2c0f8474-a157-480a-bf3f-4560b857b6ec" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Fixed BO" Display="'Fixed BO'" Dmx="16~31" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="0,0,0" />
      <Function ID="6" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">

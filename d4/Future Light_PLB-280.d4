      <Condition Name="Index" ID="1" If="'Gobo_1_Rot_Func'==1" />
      <Condition Name="Spin" ID="2,3" If="'Gobo_1_Rot_Func'&gt;1&amp;&amp;'Gobo_1_Rot_Func'&lt;4" />

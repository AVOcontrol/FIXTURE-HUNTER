  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="30~39" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="40~49" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="50~59" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="60~69" />
      <Function ID="6" Name="LED Freq Setting Enable" Display="'LED Freq Setting Enable'" Dmx="100~109" />
      <Function ID="7" Name="LED Freq Setting Disable" Display="'LED Freq Setting Disable'" Dmx="110~119" />
      <Function ID="8" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="180~189" />
      <Function ID="9" Name="Dim Spd Smooth" Display="'Dim Spd Smooth'" Dmx="190~199" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

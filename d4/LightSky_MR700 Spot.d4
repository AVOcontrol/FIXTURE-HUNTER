      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="185~199" WheelPosition="2" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="170~184" WheelPosition="3" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="155~169" WheelPosition="4" />

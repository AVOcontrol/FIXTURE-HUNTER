      <Function ID="8" Name="Slow" Display="'Slow'" Dmx="170~179" />
      <Function ID="9" Name="Fast (2)" Display="'Fast (2)'" Dmx="190~199" />
      <Function ID="10" Name="Med (2)" Display="'Med (2)'" Dmx="200~209" />
      <Function ID="11" Name="Slow (2)" Display="'Slow (2)'" Dmx="210~219" />

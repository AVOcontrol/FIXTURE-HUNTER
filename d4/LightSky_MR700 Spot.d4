  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="LED Delay" Display="'LED Delay'" Dmx="10~16" />
      <Function ID="3" Name="Delay" Display="'Delay'" Dmx="20~26" />
      <Function ID="4" Name="Delay (2)" Display="'Delay (2)'" Dmx="30~36" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="50~56" />
      <Function ID="6" Name="Reset All (2)" Display="'Reset All (2)'" Dmx="70~76" />
      <Function ID="7" Name="Reset Col/Shutter" Display="'Reset Col/Shutter'" Dmx="90~96" />
      <Function ID="8" Name="Reset CMY/CTC" Display="'Reset CMY/CTC'" Dmx="120~126" />
      <Function ID="9" Name="Reset P/T" Display="'Reset P/T'" Dmx="150~156" />
      <Function ID="10" Name="Lamp Off" Display="'Lamp Off'" Dmx="220~226" />
      <Function ID="11" Name="Lamp On" Display="'Lamp On'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

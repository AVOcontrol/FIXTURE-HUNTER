      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~250" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
    </Attribute>

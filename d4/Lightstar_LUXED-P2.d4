  <History Date="30-07-21" Author="Nic Morris" Comment="Created (note controller selection not currently supported - implemented as separate modes. pixel layout not available - guessed)" Version="0" />
  <History Date="31-07-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="26-11-22" Author="Nic Morris" Comment="Updated in line with latest charts (documentation is a mess. very confusing and littered with errors.  made best guess.  v1.0 effects have range conflicts - assumed should be the same as v2.0)" Version="4" />
  <History Date="28-11-22" Author="Nic Morris" Comment="Created from Lightstar LUXED-4" Version="20" />
  <History Date="08-12-22" Author="Nic Morris" Comment="Added Atlabase ID's (v2.0)" Version="23" />
  <History Date="13-12-22" Author="Nic Morris" Comment="Added Atlabase ID's for v1.0 CCT modes (other v1 modes not currently simulated)" Version="24" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="20180568-1288-4196-9fa1-9a493603e4fe" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT(v2.0)" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2700.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Red/Green(8bit)" Name="Red/Green" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0%" Display="'0%'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Red (100%)" Display="'Full Red (100%)'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="3" Name="+ Red" Display="'+ Red %.f%%',99~1" Dmx="31~129" Colour="255,255,255" />
      <Function ID="4" Name="0%" Display="'0%'" Dmx="130~140" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',1~99" Dmx="141~240" Colour="255,255,255" />
      <Function ID="6" Name="Green (100%)" Display="'Green (100%)'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red/Green(16bit)" Name="Red/Green" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0%" Display="'0%'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Red (100%)" Display="'Full Red (100%)'" Dmx="5001~10000" Colour="255,255,255" />
      <Function ID="3" Name="+ Red" Display="'+ Red %.2f%%',99.00~1.00" Dmx="10001~29999" Colour="255,255,255" />
      <Function ID="4" Name="0%" Display="'0%'" Dmx="30000~40000" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.2f%%',1.00~99.00" Dmx="40001~59999" Colour="255,255,255" />
      <Function ID="6" Name="Green (100%)" Display="'Green (100%)'" Dmx="60000~65535" Colour="255,255,255" />
    </Attribute>

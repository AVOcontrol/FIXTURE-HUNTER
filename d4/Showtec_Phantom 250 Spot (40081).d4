      <Function ID="12" Name="1/2 CTO/ CTO" Display="'1/2 CTO/ CTO'" Dmx="115~129" WheelPosition="3" Colour="255,240,200" />
      <Function ID="13" Name="CTO/ L Yel" Display="'CTO/ L Yel'" Dmx="130~145" WheelPosition="4" Colour="255,240,200" />
      <Function ID="14" Name="L Yel/ R Rd" Display="'L Yel/ R Rd'" Dmx="146~160" WheelPosition="5" Colour="255,255,128" />
      <Function ID="15" Name="R Rd/ L Grn" Display="'R Rd/ L Grn'" Dmx="161~176" WheelPosition="6" Colour="255,0,127" />
      <Function ID="16" Name="L Grn/ Op" Display="'L Grn/ Op'" Dmx="177~189" WheelPosition="7" Colour="128,255,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~221" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />

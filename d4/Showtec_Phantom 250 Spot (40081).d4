      <Function ID="11" Name="D Yel/ Grn" Display="'D Yel/ Grn'" Dmx="99~114" WheelPosition="2" Colour="180,180,0" />
      <Function ID="12" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="115~129" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="Org/ Mag" Display="'Org/ Mag'" Dmx="130~145" WheelPosition="4" Colour="255,128,0" />
      <Function ID="14" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="146~160" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Cy/ Cgo" Display="'Cy/ Cgo'" Dmx="161~176" WheelPosition="6" Colour="0,255,255" />
      <Function ID="16" Name="Cgo/ Op" Display="'Cgo/ Op'" Dmx="177~189" WheelPosition="7" Colour="180,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="190~221" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />

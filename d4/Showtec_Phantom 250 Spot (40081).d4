      <Function ID="9" Name="Frost" Display="'Frost'" Dmx="130~133" WheelPosition="1" />
      <Function ID="10" Name="Prism" Display="'Prism'" Dmx="134~137" WheelPosition="2" />
      <Function ID="11" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="192~138" WheelPosition="3" />

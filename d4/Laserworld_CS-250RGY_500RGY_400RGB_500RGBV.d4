<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CS-250RGY/500RGY/400RGB/500RGBV" ShortName="CS250545" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="29-06-10" Author="Jonathan Moreton" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Music active" Display="'Music active'" Dmx="0~49" />
      <Function ID="2" Name="Auto Beam Fx" Display="'Auto Beam Fx'" Dmx="50~99" />
      <Function ID="3" Name="Auto Graphics" Display="'Auto Graphics'" Dmx="100~149" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Laser off" Display="'Laser off'" Dmx="0~5" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~16" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="17~25" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="26~35" Colour="255,255,0" />
      <Function ID="5" Name="Colour Change" Display="'Colour Change %.f%%',0~100" Dmx="36~105" Colour="0,0,0" />
      <Function ID="6" Name="Colour Change (orig cols)" Display="'Colour Change (orig cols)'" Dmx="106~175" Colour="0,0,0" />
      <Function ID="7" Name="Pattern coloured random" Display="'Pattern       coloured rand'" Dmx="176~245" Colour="0,0,0" />
      <Function ID="8" Name="Original pattern colours" Display="'Original      pattern cols'" Dmx="246~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~127" />
      <Function ID="2" Name="Auto Down" Display="'Auto Down %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Auto Up" Display="'Auto Up %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~127" />
      <Function ID="2" Name="Auto Left" Display="'Auto Left %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Auto Right" Display="'Au Right %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Rotate_Y" Name="Rotate Y" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~127" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotate_X" Name="Rotate X" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~127" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.f%%',0~100" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~127" />
      <Function ID="2" Name="Dynamic CW" Display="'Dynamic CW    %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Dynamic CCW" Display="'Dynamic CCW   %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Zoom out" Display="'Zoom out %.f%%',0~100" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom in" Display="'Zoom in %.f%%',0~100" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom in/out" Display="'Zoom in/out   %.f%%',0~100" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Generic %" Display="'%.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pointdraw" Name="Pointdraw" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Generic %" Display="'%.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Piecewise drawing" Display="'Piecewise     drawing %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Piecewise drawing/erasing" Display="'Piecewise draw/erase %.f%%',0~100" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="LZ_CS25545" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Size" ChannelOffset="10" Wheel="21" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Pattern" ChannelOffset="3" Wheel="20" />
      <Attribute ID="Rotate_Y" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Rotate_X" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Rotation" ChannelOffset="8" Wheel="24" />
      <Attribute ID="Pointdraw" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Drawing" ChannelOffset="12" Wheel="26" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
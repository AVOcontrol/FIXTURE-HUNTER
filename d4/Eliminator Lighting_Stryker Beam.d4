      <Function ID="8" Name="Royal Blue" Display="'Royal Blue'" Dmx="70~74" WheelPosition="7" Colour="0,0,200" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="80~84" WheelPosition="8" Colour="255,150,150" />
      <Function ID="10" Name="Reseda" Display="'Reseda'" Dmx="90~94" WheelPosition="9" Colour="255,255,255" />
      <Function ID="11" Name="Silver" Display="'Silver'" Dmx="100~104" WheelPosition="10" Colour="255,255,255" />
      <Function ID="12" Name="Light Yellow" Display="'Light Yellow'" Dmx="110~114" WheelPosition="11" Colour="255,255,128" />
      <Function ID="13" Name="Orange Yellow" Display="'Orange Yellow'" Dmx="120~124" WheelPosition="12" Colour="255,128,0" />
      <Function ID="14" Name="Purple" Display="'Purple'" Dmx="130~134" WheelPosition="13" Colour="128,0,255" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="25~29" WheelPosition="2" Colour="255,128,0" />
      <Function ID="18" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />

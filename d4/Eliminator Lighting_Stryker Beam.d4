      <Function ID="20" Name="Yel/ Crm" Display="'Yel/ Crm'" Dmx="55~59" WheelPosition="5" Colour="255,255,0" />
      <Function ID="21" Name="Crm/ R Blu" Display="'Crm/ R Blu'" Dmx="65~69" WheelPosition="6" Colour="180,0,0" />
      <Function ID="22" Name="R Blu/ Pk" Display="'R Blu/ Pk'" Dmx="75~79" WheelPosition="7" Colour="0,0,200" />
      <Function ID="23" Name="Pk/ Rsda" Display="'Pk/ Rsda'" Dmx="85~89" WheelPosition="8" Colour="255,150,150" />
      <Function ID="24" Name="Rsda/ Slvr" Display="'Rsda/ Slvr'" Dmx="95~99" WheelPosition="9" Colour="255,255,255" />
      <Function ID="25" Name="Slvr/ L Yel" Display="'Slvr/ L Yel'" Dmx="105~109" WheelPosition="10" Colour="255,255,255" />
      <Function ID="26" Name="L Yel/ Org Yel" Display="'L Yel/ Org Yel'" Dmx="115~119" WheelPosition="11" Colour="255,255,128" />
      <Function ID="27" Name="Org Yel/ Ppl" Display="'Org Yel/ Ppl'" Dmx="125~129" WheelPosition="12" Colour="255,128,0" />
      <Function ID="28" Name="Ppl/ Op" Display="'Ppl/ Op'" Dmx="135~139" WheelPosition="13" Colour="128,0,255" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="200~205" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~199" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="200~205" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="206~255" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />

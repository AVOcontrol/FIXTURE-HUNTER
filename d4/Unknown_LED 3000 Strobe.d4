<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED 3000 Strobe" ShortName="3K Strobe" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-11-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~250" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="6~13" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="14~21" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="22~29" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="30~37" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="38~45" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="46~53" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="54~61" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="62~69" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Shutter" Name="BG Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="14~21" Colour="255,100,0" />
      <Function ID="4" Name="Yellow Amber" Display="'Yellow Amber'" Dmx="22~29" Colour="255,128,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="30~37" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="38~45" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="46~53" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="54~61" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="62~69" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="70~77" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="78~85" Colour="180,0,255" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="86~93" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="94~101" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="102~109" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Jump Stop" Display="'Jump Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="18" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="19" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="BG_Auto" Name="BG Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~30" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~55" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="56~80" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="81~105" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="106~130" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="131~155" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="156~180" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="181~205" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="206~230" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="BG_Auto_Spd" Name="BG Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="26 DMX" Channels="26">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Duration" ChannelOffset="3" Wheel="6" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Program" ChannelOffset="8" Wheel="22" />
        <Attribute ID="Program_Spd" ChannelOffset="9" Wheel="23" />
        <Attribute ID="BG_Shutter" Wheel="35" />
        <Attribute ID="BG_Colour" Wheel="8" />
        <Attribute ID="BG_Auto" Wheel="52" />
        <Attribute ID="BG_Auto_Spd" Wheel="53" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="BG_Dimmer" Wheel="34" />
      </Master>
      <Cell ID="Cell1" Name="Strobe 1" ChannelOffset="4" ModeLink="Dimmer cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Strobe 2" ChannelOffset="5" ModeLink="Dimmer cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Strobe 3" ChannelOffset="6" ModeLink="Dimmer cell" X="2" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Strobe 4" ChannelOffset="7" ModeLink="Dimmer cell" X="3" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="BG" ChannelOffset="10" ModeLink="BG cell" X="4" Y="1">
        <AttributeLink SourceId="BG_Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="BG_Shutter" TargetId="BG_Shutter" />
        <AttributeLink SourceId="BG_Colour" TargetId="BG_Colour" />
        <AttributeLink SourceId="BG_Auto" TargetId="BG_Auto" />
        <AttributeLink SourceId="BG_Auto_Spd" TargetId="BG_Auto_Spd" />
      </Cell>
      <Cell ID="Cell6" Name="Col 1" ChannelOffset="15" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell7" Name="Col 2" ChannelOffset="18" ModeLink="RGB cell" X="1" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell8" Name="Col 3" ChannelOffset="21" ModeLink="RGB cell" X="2" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell9" Name="Col 4" ChannelOffset="24" ModeLink="RGB cell" X="3" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dimmer cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="BG cell" Channels="5" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="BG_Shutter" ChannelOffset="2" Wheel="35" />
      <Attribute ID="BG_Colour" ChannelOffset="3" Wheel="8" />
      <Attribute ID="BG_Auto" ChannelOffset="4" Wheel="52" />
      <Attribute ID="BG_Auto_Spd" ChannelOffset="5" Wheel="53" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
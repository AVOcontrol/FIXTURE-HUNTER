<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pixel-Blinder Bar (L005218)" ShortName="Px/BlndBar" Company="FOS">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>68e65fe8-bb5b-4ea9-b507-b2e2253e4f41</Thumbnail>
  <History Date="19-01-18" Author="Nic Morris" Comment="Created" />
  <History Date="31-01-18" Author="Nic Morris" Comment="Added 9, 15, 180 and 190 channel modes." />
  <History Date="31-01-18" Author="Nic Morris" Comment="Note documentation is poor and littered with errors (particularly channel offsets and counts) and has no pixel layout information.  Made best guess" />
  <History Date="01-02-18" Author="Nic Morris" Comment="Added Atlabase ID's to 9, 15 and 190 channel modes.  Removed the 180 channel mode." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Revised in attempt to improve pixel mapper compatibility in response to customer bug report." />
  <History Date="17-03-18" Author="Nic Morris" Comment="Created from Taurus LED Color Bar 70 (identical except white cells mapped before the RGB's in 190 DMX mode)" />
  <History Date="21-03-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="28-05-18" Author="Nic Morris" Comment="Added multi-part patch option in response to cusomter bug report." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3075dbac-4565-4669-b051-f502023f0665" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="xWhite" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program_1-15" Name="Program 1-15" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program" Display="'Program %.f',1~15" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Program_16-30" Name="Program 16-30" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program" Display="'Program %.f',16~30" Dmx="1~237" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="238~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

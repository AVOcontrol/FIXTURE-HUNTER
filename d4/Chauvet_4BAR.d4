  <History Date="09-02-12" Author="Peter Budd" Comment="Created" Version="1" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="2" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="3" />
  <History Date="26-10-16" Author="Nic Morris" Comment="Added conditionals to shutter and changed dimmer to a single range for compatibility." Version="4" />
  <History Date="26-10-16" Author="Nic Morris" Comment="Removed Atlabase ID's (multi head fixture type not currently supported)" Version="5" />
  <History Date="26-10-16" Author="Nic Morris" Comment="Changed display name from CH_4Bar to 4Bar" Version="6" />
  <History Date="25-09-17" Author="Nic Morris" Comment="Changed name from 4Bar to 4BAR" Version="7" />
  <History Date="25-09-17" Author="Nic Morris" Comment="Revised mode names." Version="8" />
  <History Date="25-09-17" Author="Nic Morris" Comment="Added vdim to cells.  Revised 3 DMX mode mapping." Version="9" />
  <History Date="22-03-23" Author="Nic Morris" Comment="Added product thumbnail.  Added Atlabase ID's (currently missing 3 channel mode)  Note shutter ranges are different depending on whether you look at the manual or QRG.  Shutter changing to speed or sensitivity control is not documented." Version="10" />
  <History Date="23-03-23" Author="Nic Morris" Comment="Added missing 3 DMX Atlabase ID." Version="11" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="962c5f5e-79a2-455d-9eec-fbc5a017a998" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~29" Update="Shutter" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="30~49" Update="Shutter" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="50~69" Update="Shutter" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="70~89" Update="Shutter" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="90~109" Update="Shutter" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="110~129" Update="Shutter" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="130~149" Update="Shutter" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="150~169" Update="Shutter" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="170~189" Update="Shutter" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="190~209" Update="Shutter" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="210~229" Update="Shutter" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="230~249" Update="Shutter" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;14" />
      <Condition Name="Sensitivity" ID="4,5" If="'Auto'==14" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="5" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">

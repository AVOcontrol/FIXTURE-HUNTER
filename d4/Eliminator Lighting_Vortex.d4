      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reflector_Rot" Name="Reflector Rot" Description="" Group="B">

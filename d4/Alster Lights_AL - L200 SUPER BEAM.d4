  <History Date="20-01-20" Author="Nic Morris" Comment="Created (poor documentation.  contains conflicting ranges)" Version="1" />
  <History Date="21-01-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="15-05-22" Author="Nic Morris" Comment="Created from Rico 80W LED Beam Moving Head Light (ML-B080) (very poor documentation.  contains range conflicts.  effectively identical)" Version="3" />
  <History Date="19-05-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <History Date="08-09-22" Author="Nic Morris" Comment="Updated in lline with latest documentation in response to manufacturer request (adds colour names/palettes/highlight/lowlight.  charts contain range conflicts)" Version="5" />

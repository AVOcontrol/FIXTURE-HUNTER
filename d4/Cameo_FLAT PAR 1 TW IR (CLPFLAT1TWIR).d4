  <AtlaBase TypeID="330a9af9-c1d7-4084-a1d6-62a704e6fc61" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Preset 1" Display="'Preset 1'" Dmx="6~22" Colour="255,255,255" />
      <Function ID="3" Name="Preset 2" Display="'Preset 2'" Dmx="23~39" Colour="255,255,255" />
      <Function ID="4" Name="Preset 3" Display="'Preset 3'" Dmx="40~56" Colour="255,255,255" />
      <Function ID="5" Name="Preset 4" Display="'Preset 4'" Dmx="57~73" Colour="255,255,255" />
      <Function ID="6" Name="Preset 5" Display="'Preset 5'" Dmx="74~90" Colour="255,255,255" />
      <Function ID="7" Name="Preset 6" Display="'Preset 6'" Dmx="91~107" Colour="255,255,255" />
      <Function ID="8" Name="Preset 7" Display="'Preset 7'" Dmx="108~124" Colour="255,255,255" />
      <Function ID="9" Name="Preset 8" Display="'Preset 8'" Dmx="125~141" Colour="255,255,255" />
      <Function ID="10" Name="Preset 9" Display="'Preset 9'" Dmx="142~158" Colour="255,255,255" />
      <Function ID="11" Name="Preset 10" Display="'Preset 10'" Dmx="159~175" Colour="255,255,255" />
      <Function ID="12" Name="Preset 11" Display="'Preset 11'" Dmx="176~192" Colour="255,255,255" />
      <Function ID="13" Name="Preset 12" Display="'Preset 12'" Dmx="193~209" Colour="255,255,255" />
      <Function ID="14" Name="Preset 13" Display="'Preset 13'" Dmx="210~226" Colour="255,255,255" />
      <Function ID="15" Name="Preset 14" Display="'Preset 14'" Dmx="227~243" Colour="255,255,255" />
      <Function ID="16" Name="Preset 15" Display="'Preset 15'" Dmx="244~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="32~56" />
      <Function ID="6" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="7" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Dim_Response" Name="Dim Response" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="LED" Display="'LED'" Dmx="6~127" />
      <Function ID="3" Name="Halogen" Display="'Halogen'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
  </Control>

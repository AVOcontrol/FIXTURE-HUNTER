    <Attribute ID="Eff_Speed" Name="Effect Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Control 1" ID="2,3,4" If="'Effect'&gt;1&amp;&amp;'Effect'&lt;51" />
      <Condition Name="Control 2" ID="5,6,7,8,9" If="'Effect'&gt;63&amp;&amp;'Effect'&lt;73" />
      <Condition Name="Control 3" ID="10,11" If="'Effect'&gt;52&amp;&amp;'Effect'&lt;60" />
      <Condition Name="Control 4" ID="12,13" If="'Effect'&lt;63&amp;&amp;'Effect'&gt;59" />
      <Condition Name="Control 5" ID="14" If="'Effect'&gt;74&amp;&amp;'Effect'&lt;78" />
      <Condition Name="Control 6" ID="15,16" If="'Effect'&gt;77&amp;&amp;'Effect'&lt;82" />
      <Condition Name="Control 7" ID="17,18,19" If="'Effect'==82||'Effect'==83" />
      <Condition Name="Control 8" ID="20" If="'Effect'&gt;84&amp;&amp;'Effect'&lt;91" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Presentation" Display="'Presentation'" Dmx="0~0" />
      <Function ID="3" Name="Time" Display="'Time %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="251~255" />

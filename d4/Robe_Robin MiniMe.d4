    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Factory" Display="'Factory'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Internal Custom" Display="'Internal Custom'" Dmx="32~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="External Custom" Display="'External Custom'" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Local NAS" Display="'Local NAS'" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Remote NAS" Display="'Remote NAS'" Dmx="128~143" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Video Speed" Description="" Group="S">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Pause" Display="'Pause'" Dmx="1~1" />
      <Function ID="2" Name="Speed -" Display="'Speed - %.1f%%',25.0~100.0" Dmx="2~127" />
      <Function ID="3" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="4" Name="Speed +" Display="'Speed + %.f%%',100~400" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~49087" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49344~49601" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49858~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Transition" Display="'Transition'" Dmx="0~0" Update="Effect, Eff_Speed" />
      <Function ID="2" Name="Effect on Gobo" Display="'Effect on Gobo'" Dmx="0~0" Update="Effect, Eff_Speed" />
      <Function ID="3" Name="Manual Effect" Display="'Manual Effect'" Dmx="0~0" Update="Effect, Eff_Speed" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Effect, Eff_Speed" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">

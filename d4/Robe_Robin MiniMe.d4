      <Function ID="19" Name="Sync Local NAS w/NAS" Display="'Sync Local NAS w/NAS'" Dmx="240~244" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Zoom -" Display="'Zoom - %.1f%%',100.0~0.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Real Size" Display="'Real Size'" Dmx="128~128" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom +" Display="'Zoom + %.1f%%',0.0~100.0" Dmx="129~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_Horizontal" Name="Key Horizontal" Description="" Group="G">
      <Locate Locate="1:128" PowerOn="1:128" />
      <Function ID="1" Name="Horizontal" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Keystone_Vertical" Name="Key Vertical" Description="" Group="G">
      <Locate Locate="1:128" PowerOn="1:128" />
      <Function ID="1" Name="Vertical" Display="'%.f',0~255" Dmx="0~255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AC-MFL" ShortName="AC-MFL" Company="AC Lasers">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-06-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="32~223" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Solid Line" Display="'Solid Line'" Dmx="0~0" />
      <Function ID="2" Name="Solid Circle" Display="'Solid Circle'" Dmx="16~31" />
      <Function ID="3" Name="Solid Square" Display="'Solid Square'" Dmx="32~47" />
      <Function ID="4" Name="3 Solid Concentric Circles" Display="'3 Solid Concentric Circles'" Dmx="48~63" />
      <Function ID="5" Name="Solid Waves" Display="'Solid Waves'" Dmx="64~79" />
      <Function ID="6" Name="Solid Semicircle" Display="'Solid Semicircle'" Dmx="80~95" />
      <Function ID="7" Name="Solid Blanking Triangle" Display="'Solid Blanking Triangle'" Dmx="96~111" />
      <Function ID="8" Name="8 Rainbow Circles" Display="'8 Rainbow Circles'" Dmx="112~127" />
      <Function ID="9" Name="Single Spot" Display="'Single Spot'" Dmx="128~143" />
      <Function ID="10" Name="Blanking Line" Display="'Blanking Line'" Dmx="144~159" />
      <Function ID="11" Name="Blanking Rainbow Circle" Display="'Blanking Rainbow Circle'" Dmx="160~175" />
      <Function ID="12" Name="Blanking Square" Display="'Blanking Square'" Dmx="176~191" />
      <Function ID="13" Name="Blanking Rainbow Waves" Display="'Blanking Rainbow Waves'" Dmx="192~207" />
      <Function ID="14" Name="Blanking Rainbow Semicircle" Display="'Blanking Rainbow Semicircle'" Dmx="208~223" />
      <Function ID="15" Name="4 Spots" Display="'4 Spots'" Dmx="224~239" />
      <Function ID="16" Name="Blanking Solid Line" Display="'Blanking Solid Line'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Size" Name="X-Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y-Size" Name="Y-Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Z-Angle" Name="Z-Angle" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f°',0~360" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Pos" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y-Pos" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Visible_Point" Name="Visible Point" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Visible Point" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Rate" Name="Scan Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Sync Strobe" Display="'Sync Strobe'" Dmx="16~31" />
      <Function ID="3" Name="Random Strobe" Display="'Random Strobe'" Dmx="32~47" />
      <Function ID="4" Name="Col Flow" Display="'Col Flow'" Dmx="48~63" />
      <Function ID="5" Name="Cyc Patt Zm Out" Display="'Cyc Patt Zm Out'" Dmx="64~79" />
      <Function ID="6" Name="Cyc Patt Zm In" Display="'Cyc Patt Zm In'" Dmx="80~95" />
      <Function ID="7" Name="Cyc Horiz FWD Rot" Display="'Cyc Horiz FWD Rot'" Dmx="96~111" />
      <Function ID="8" Name="Cyc Horiz REV Rot" Display="'Cyc Horiz REV Rot'" Dmx="112~127" />
      <Function ID="9" Name="Cyc Vert FWD Rot" Display="'Cyc Vert FWD Rot'" Dmx="128~143" />
      <Function ID="10" Name="Cyc Vert REV Rot" Display="'Cyc Vert REV Rot'" Dmx="144~159" />
      <Function ID="11" Name="Cyc Centre FWD Rot" Display="'Cyc Centre FWD Rot'" Dmx="160~175" />
      <Function ID="12" Name="Cyc Centre REV Rot" Display="'Cyc Centre REV Rot'" Dmx="176~191" />
      <Function ID="13" Name="Cyc L-R Move" Display="'Cyc L-R Move'" Dmx="192~207" />
      <Function ID="14" Name="Cyc R-L Move" Display="'Cyc R-L Move'" Dmx="208~223" />
      <Function ID="15" Name="Cyc Up-Dn Move" Display="'Cyc Up-Dn Move'" Dmx="224~239" />
      <Function ID="16" Name="Cyc Bottom-Top Move" Display="'Cyc Bottom-Top Move'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Grating" Display="'No Grating'" Dmx="0~0" />
      <Function ID="2" Name="Grid" Display="'Grid'" Dmx="64~127" />
      <Function ID="3" Name="Line" Display="'Line'" Dmx="128~191" />
      <Function ID="4" Name="Lumia" Display="'Lumia'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Rot_Direction" Name="Rot Direction" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Rot_Spd" Name="Rot Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="UKAC-MFL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Pattern" ChannelOffset="6" Wheel="13" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="X-Size" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Y-Size" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Z-Angle" ChannelOffset="10" Wheel="49" />
      <Attribute ID="X-Pos" ChannelOffset="11" Wheel="2" />
      <Attribute ID="Y-Pos" ChannelOffset="12" Wheel="3" />
      <Attribute ID="Visible_Point" ChannelOffset="13" Wheel="4" />
      <Attribute ID="Scan_Rate" ChannelOffset="14" Wheel="5" />
      <Attribute ID="Macro" ChannelOffset="15" Wheel="22" />
      <Attribute ID="Speed" ChannelOffset="16" Wheel="25" />
      <Attribute ID="Mode" ChannelOffset="17" Wheel="28" />
      <Attribute ID="Rot_Direction" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Rot_Spd" ChannelOffset="19" Wheel="24" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
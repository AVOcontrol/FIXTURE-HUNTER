<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kreios PAR 144W" ShortName="KP 144W" Company="Osram">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-10-15" Author="Nic Morris" Comment="Created" />
  <History Date="06-08-16" Author="Nic Morris" Comment="Created from Osram Kreios PAR" />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="83c3c048-40f5-47c4-8548-fb7955fd5173" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Time" ID="2" If="'Auto'&gt;11&amp;&amp;'Auto'&lt;22" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade" ID="2" If="'Auto'&gt;11&amp;&amp;'Auto'&lt;22" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~20" Colour="255,255,255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="21~30" Colour="255,255,255" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="31~200" Colour="255,255,255" />
      <Function ID="5" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="6" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="7" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="8" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="9" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="10" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="11" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="12" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="13" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="14" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="15" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="21~30" Update="Red, Green" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="31~40" Update="Red, Green" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="41~50" Update="Red, Green" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="51~60" Update="Red, Green" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="61~70" Update="Red, Green" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="71~80" Update="Red, Green" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="81~90" Update="Red, Green" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="91~100" Update="Red, Green" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="101~110" Update="Red, Green" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="111~120" Update="Red, Green" />
      <Function ID="12" Name="Auto 1" Display="'Auto 1'" Dmx="121~130" Update="Red, Green" />
      <Function ID="13" Name="Auto 2" Display="'Auto 2'" Dmx="131~140" Update="Red, Green" />
      <Function ID="14" Name="Auto 3" Display="'Auto 3'" Dmx="141~150" Update="Red, Green" />
      <Function ID="15" Name="Auto 4" Display="'Auto 4'" Dmx="151~160" Update="Red, Green" />
      <Function ID="16" Name="Auto 5" Display="'Auto 5'" Dmx="161~170" Update="Red, Green" />
      <Function ID="17" Name="Auto 6" Display="'Auto 6'" Dmx="171~180" Update="Red, Green" />
      <Function ID="18" Name="Auto 7" Display="'Auto 7'" Dmx="181~190" Update="Red, Green" />
      <Function ID="19" Name="Auto 8" Display="'Auto 8'" Dmx="191~200" Update="Red, Green" />
      <Function ID="20" Name="Auto 9" Display="'Auto 9'" Dmx="201~210" Update="Red, Green" />
      <Function ID="21" Name="Auto 10" Display="'Auto 10'" Dmx="211~220" Update="Red, Green" />
      <Function ID="22" Name="Sound Col" Display="'Sound Col'" Dmx="221~240" Update="Red, Green" />
      <Function ID="23" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="241~255" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Speed 1" Display="'Speed 1'" Dmx="30~69" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="70~129" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="130~189" />
      <Function ID="6" Name="Speed 4" Display="'Speed 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

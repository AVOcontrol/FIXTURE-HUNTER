      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="90~99" />
      <Function ID="5" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="100~109" />
      <Function ID="6" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="110~119" />
      <Function ID="7" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="120~129" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="9" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="10" Name="Reset Effect" Display="'Reset Effect'" Dmx="150~159" />
      <Function ID="11" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="12" Name="Lamp Off" Display="'Lamp Off'" Dmx="231~239" />
    </Attribute>
  </Control>

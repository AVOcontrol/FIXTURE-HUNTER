    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="23,24" If="'Colour1Func'==4" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="18~18" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Brilliant Blue 485" Display="'Brilliant Blue 485'" Dmx="36~36" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green 5054" Display="'Green 5054'" Dmx="54~54" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Half Minus Green HMG4" Display="'Half Minus Green HMG4'" Dmx="72~72" WheelPosition="4" Colour="128,255,0" />
      <Function ID="6" Name="Gold Amber 555" Display="'Gold Amber 555'" Dmx="91~91" WheelPosition="5" Colour="255,100,0" />
      <Function ID="7" Name="Navy Blue 440" Display="'Navy Blue 440'" Dmx="108~108" WheelPosition="7" Colour="0,0,255" />
      <Function ID="8" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="9~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="D Rd/ B Blu" Display="'D Rd/ B Blu'" Dmx="27~27" WheelPosition="1" Colour="180,0,0" />
      <Function ID="10" Name="B Blu/ Grn" Display="'B Blu/ Grn'" Dmx="45~45" WheelPosition="2" Colour="0,0,255" />
      <Function ID="11" Name="Grn/ HMG" Display="'Grn/ HMG'" Dmx="63~63" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="HMG/ G Amb" Display="'HMG/ G Amb'" Dmx="82~82" WheelPosition="4" Colour="128,255,0" />
      <Function ID="13" Name="G Amb/ N Blu" Display="'G Amb/ N Blu'" Dmx="100~100" WheelPosition="5" Colour="255,100,0" />
      <Function ID="14" Name="N Blu/ Op" Display="'N Blu/ Op'" Dmx="118~118" WheelPosition="7" Colour="0,0,255" />
      <Function ID="15" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~18" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="D Rd - B Blu" Display="'D Rd - B Blu %.f%%',0~100" Dmx="18~36" WheelPosition="1" Colour="180,0,0" />
      <Function ID="17" Name="B Blu - Grn" Display="'B Blu - Grn %.f%%',0~100" Dmx="36~54" WheelPosition="2" Colour="0,0,255" />
      <Function ID="18" Name="Grn - HMG" Display="'Grn - HMG %.f%%',0~100" Dmx="54~72" WheelPosition="3" Colour="0,255,0" />
      <Function ID="19" Name="HMG - G Amb" Display="'HMG - G Amb %.f%%',0~100" Dmx="72~91" WheelPosition="4" Colour="220,240,255" />
      <Function ID="20" Name="G Amb - N Blu" Display="'G Amb - N Blu %.f%%',0~100" Dmx="91~108" WheelPosition="5" Colour="255,100,0" />
      <Function ID="21" Name="N Blu - Op" Display="'N Blu - Op %.f%%',0~100" Dmx="108~127" WheelPosition="7" Colour="0,0,180" />
      <Function ID="22" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="24" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />

      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="193~213" WheelPosition="4">
        <Swatch>a35e65ba-c83c-40f6-9b2f-2ba7d181e340</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="214~234" WheelPosition="5">
        <Swatch>4e6cba26-d840-4ca9-81cb-5538426c28d6</Swatch>

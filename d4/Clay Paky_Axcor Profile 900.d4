      </Function>
      <Function ID="7" Name="Gobo 6 (Water Lines)" Display="'Gobo 6 (Water Lines)'" Dmx="112~129" WheelPosition="6">
        <Swatch>f471d64f-530d-40a2-be73-66ac8ebd07d6</Swatch>
      </Function>
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>43a4c811-1be4-40ba-b326-43b5da94304d</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="130~150" WheelPosition="1">
        <Swatch>de5eb629-26c2-4df9-abf7-967e65241d51</Swatch>

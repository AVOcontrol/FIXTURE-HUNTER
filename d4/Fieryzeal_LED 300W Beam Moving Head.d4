      <Function ID="21" Name="Cy/ D Org" Display="'Cy/ D Org'" Dmx="76~80" WheelPosition="7" Colour="0,255,255" />
      <Function ID="22" Name="D Org/ Ppl" Display="'D Org/ Ppl'" Dmx="86~90" WheelPosition="8" Colour="255,100,0" />
      <Function ID="23" Name="Ppl/ L Yel" Display="'Ppl/ L Yel'" Dmx="96~100" WheelPosition="9" Colour="128,0,255" />
      <Function ID="24" Name="L Yel/ D Grn" Display="'L Yel/ D Grn'" Dmx="106~110" WheelPosition="10" Colour="255,255,128" />
      <Function ID="25" Name="D Grn/ CTO" Display="'D Grn/ CTO'" Dmx="116~120" WheelPosition="11" Colour="0,200,0" />
      <Function ID="26" Name="CTO/ Op" Display="'CTO/ Op'" Dmx="136~139" WheelPosition="12" Colour="255,240,200" />

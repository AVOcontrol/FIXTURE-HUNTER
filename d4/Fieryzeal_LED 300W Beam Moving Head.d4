      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="91~95" WheelPosition="9" Colour="128,0,255" />
      <Function ID="11" Name="Light Yellow" Display="'Light Yellow'" Dmx="101~105" WheelPosition="10" Colour="255,255,128" />
      <Function ID="12" Name="Deep Green" Display="'Deep Green'" Dmx="111~115" WheelPosition="11" Colour="0,200,0" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="121~125" WheelPosition="12" Colour="255,240,200" />
      <Function ID="14" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="6~10" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="16~20" WheelPosition="1" Colour="255,0,0" />
      <Function ID="16" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="26~30" WheelPosition="2" Colour="0,255,0" />
      <Function ID="17" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="36~40" WheelPosition="3" Colour="0,0,255" />

      <Function ID="28" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~199" Colour="0,0,0" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="200~205" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="206~255" Colour="0,0,0" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_Shutter" Name="Beam Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />

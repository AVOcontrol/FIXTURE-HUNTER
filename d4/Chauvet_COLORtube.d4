<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORtube" ShortName="COLORtube" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-07-04" Author="Phil Rogers" Comment="Created" />
  <History Date="02-08-04" Author="Tom Peck" Comment="Created" />
  <History Date="19-07-06" Author="Ed" Comment="Checked after a change by D4 Pers fixer" />
  <History Date="25-09-17" Author="Nic Morris" Comment="Changed name from LED-T40HV Color Tube to COLORtube" />
  <History Date="25-09-17" Author="Nic Morris" Comment="Renamed effect to shutter.  Inverted speed and increased resolution.  Simplified colours." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="8" PowerOn="1" Highlight="4" Lowlight="5" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="13~25" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="26~38" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="39~51" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="52~64" Colour="0,0,255" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="65~77" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="78~90" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="91~103" Colour="255,255,255" />
      <Function ID="9" Name="Color Change" Display="'Color Change'" Dmx="104~116" Colour="0,0,0" />
      <Function ID="10" Name="Slow Flow 1" Display="'Slow Flow 1'" Dmx="117~129" Colour="0,0,0" />
      <Function ID="11" Name="Slow Flow 2" Display="'Slow Flow 2'" Dmx="130~142" Colour="0,0,0" />
      <Function ID="12" Name="Roll Chase 1" Display="'Roll Chase 1'" Dmx="143~155" Colour="0,0,0" />
      <Function ID="13" Name="Roll Chase 2" Display="'Roll Chase 2'" Dmx="156~168" Colour="0,0,0" />
      <Function ID="14" Name="Multicolour" Display="'Multicolour'" Dmx="169~181" Colour="0,0,0" />
      <Function ID="15" Name="Fast Flow 1" Display="'Fast Flow 1'" Dmx="182~194" Colour="0,0,0" />
      <Function ID="16" Name="Fast Flow 2" Display="'Fast Flow 2'" Dmx="195~207" Colour="0,0,0" />
      <Function ID="17" Name="2 Col Chase" Display="'2 Col Chase'" Dmx="208~220" Colour="0,0,0" />
      <Function ID="18" Name="2 Col Flow" Display="'2 Col Flow'" Dmx="221~233" Colour="0,0,0" />
      <Function ID="19" Name="Colour Fade" Display="'Colour Fade'" Dmx="234~246" Colour="0,0,0" />
      <Function ID="20" Name="Auto Run" Display="'Auto Run'" Dmx="247~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red + Green" Display="'Red + Green'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Red + Yellow" Display="'Red + Yellow'" Dmx="12~23" Colour="255,0,0" />
      <Function ID="3" Name="Red + Blue" Display="'Red + Blue'" Dmx="24~35" Colour="255,0,0" />
      <Function ID="4" Name="Red + Purple" Display="'Red + Purple'" Dmx="36~47" Colour="255,0,0" />
      <Function ID="5" Name="Red + Cyan" Display="'Red + Cyan'" Dmx="48~59" Colour="255,0,0" />
      <Function ID="6" Name="Red + White" Display="'Red + White'" Dmx="60~71" Colour="255,0,0" />
      <Function ID="7" Name="Green + Yellow" Display="'Green + Yellow'" Dmx="72~83" Colour="0,255,0" />
      <Function ID="8" Name="Green + Blue" Display="'Green + Blue'" Dmx="84~95" Colour="0,255,0" />
      <Function ID="9" Name="Green + Purple" Display="'Green + Purple'" Dmx="96~107" Colour="0,255,0" />
      <Function ID="10" Name="Green + Cyan" Display="'Green + Cyan'" Dmx="108~119" Colour="0,255,0" />
      <Function ID="11" Name="Green + White" Display="'Green + White'" Dmx="120~131" Colour="0,255,0" />
      <Function ID="12" Name="Yellow + Blue" Display="'Yellow + Blue'" Dmx="132~143" Colour="255,255,0" />
      <Function ID="13" Name="Yellow + Purple" Display="'Yellow + Purple'" Dmx="144~155" Colour="255,255,0" />
      <Function ID="14" Name="Yellow + Cyan" Display="'Yellow + Cyan'" Dmx="156~167" Colour="255,255,0" />
      <Function ID="15" Name="Yellow + White" Display="'Yellow + White'" Dmx="168~179" Colour="255,255,0" />
      <Function ID="16" Name="Blue + Purple" Display="'Blue + Purple'" Dmx="180~191" Colour="0,0,255" />
      <Function ID="17" Name="Blue + Cyan" Display="'Blue + Cyan'" Dmx="192~203" Colour="0,0,255" />
      <Function ID="18" Name="Blue + White" Display="'Blue + White'" Dmx="204~215" Colour="0,0,255" />
      <Function ID="19" Name="Purple + Cyan" Display="'Purple + Cyan'" Dmx="216~227" Colour="128,0,255" />
      <Function ID="20" Name="Purple + White" Display="'Purple + White'" Dmx="228~239" Colour="128,0,255" />
      <Function ID="21" Name="Cyan + White" Display="'Cyan + White'" Dmx="240~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe" Display="'%.1f Hz',0.0~20.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CH_ColTube" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Colour2" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
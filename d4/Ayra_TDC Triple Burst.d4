<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TDC Triple Burst" ShortName="Triple Bst" Company="Ayra">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="09-06-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~247" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Col_Chase" Name="Col Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~7" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="8~22" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="23~37" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="38~52" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="53~67" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="68~82" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="83~97" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="98~112" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="113~127" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="128~142" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="143~157" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="158~172" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="173~187" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="188~202" />
      <Function ID="15" Name="Chase 14" Display="'Chase 14'" Dmx="203~217" />
      <Function ID="16" Name="Chase 15" Display="'Chase 15'" Dmx="218~232" />
      <Function ID="17" Name="Chase 16" Display="'Chase 16'" Dmx="233~247" />
      <Function ID="18" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Hold" Display="'Hold'" Dmx="0~7" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>

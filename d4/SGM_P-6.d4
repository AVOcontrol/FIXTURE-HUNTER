  <History Date="20-01-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="20-07-18" Author="Nic Morris" Comment="Updated in line with 'Protocol Rev. 2' charts (firmware v01.03).  Note 21 channel (Studio) mode charts are vague." Version="2" />
  <History Date="25-07-18" Author="Nic Morris" Comment="Added Atlabase ID's to new modes." Version="3" />
  <History Date="18-12-18" Author="Nic Morris" Comment="Created from SGM P-10" Version="4" />
  <History Date="19-10-22" Author="Nic Morris" Comment="Updated in line with latest docmentation/firmware (v3.xx) in response to manufacturer request (adds standard modes and changes duration to master dimmer in 21 and 27 channel modes)" Version="5" />
  <History Date="29-11-22" Author="Nic Morris" Comment="Reinstated original 21 and 27 channel modes, added 66 channel mode and added 'v3' to v3 mode names to help differentiate." Version="7" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b93790fc-bb77-44fb-94c5-f1e22e0ea2bb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="2" Name="z" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="3" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />

    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="x" ID="2" If="'Colour_Mode'==2||'Colour_Mode1'==2" />
      <Condition Name="Hue" ID="3" If="'Colour_Mode'==4||'Colour_Mode1'==4" />
      <Condition Name="Cyan" ID="4" If="'Colour_Mode'==5||'Colour_Mode1'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="x" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="3" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="4" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="y" ID="2" If="'Colour_Mode'==2||'Colour_Mode1'==2" />
      <Condition Name="Saturation" ID="3" If="'Colour_Mode'==4||'Colour_Mode1'==4" />
      <Condition Name="Magenta" ID="4" If="'Colour_Mode'==5||'Colour_Mode1'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="y" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="3" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="4" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="z" ID="2" If="'Colour_Mode'==2||'Colour_Mode1'==2" />
      <Condition Name="Intensity" ID="3" If="'Colour_Mode'==4||'Colour_Mode1'==4" />
      <Condition Name="Yellow" ID="4" If="'Colour_Mode'==5||'Colour_Mode1'==5" />
      <Else ID="1" />

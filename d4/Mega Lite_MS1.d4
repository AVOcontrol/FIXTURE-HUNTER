  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5140~7453" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="10280~12593" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="15420~17733" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20560~22873" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="25700~28013" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="30840~33153" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="35980~38293" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="2570~4883" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="7710~10023" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="12850~15163" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="17990~20303" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="23130~25443" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Mag/ Org" Display="'Mag/ Org'" Dmx="28270~30583" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="Org/ UV" Display="'Org/ UV'" Dmx="33410~35723" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="51400~52685" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="38550~51143" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="51400~52685" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="52942~65535" Colour="0,0,0" />

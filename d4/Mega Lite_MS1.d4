    </Attribute>
    <Attribute ID="Animation_Func" Name="Animation Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Animation" />
      <Function ID="2" Name="Bounce" Display="'Bounce'" Dmx="0~0" Update="Animation" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Animation" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Animation" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4" If="'Animation_Func'==1" />
      <Condition Name="Bounce" ID="5,6,7,8" If="'Animation_Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Animation_Func'==3" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Animation 1" Display="'Animation 1'" Dmx="10~39" WheelPosition="1" />
      <Function ID="3" Name="Animation 2" Display="'Animation 2'" Dmx="40~69" WheelPosition="2" />
      <Function ID="4" Name="Animation 3" Display="'Animation 3'" Dmx="70~99" WheelPosition="3" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="6" Name="Animation 1" Display="'Animation 1 %.f%%',0~100" Dmx="100~119" WheelPosition="1" />
      <Function ID="7" Name="Animation 2" Display="'Animation 2 %.f%%',0~100" Dmx="120~139" WheelPosition="2" />
      <Function ID="8" Name="Animation 3" Display="'Animation 3 %.f%%',0~100" Dmx="140~159" WheelPosition="3" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="160~169" WheelPosition="0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="170~209" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="210~215" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~216" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>80ab1ec4-d498-4b5d-a8c8-4bd1f78d6905</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1">
        <Swatch>ffbd8078-84d4-48ab-957e-826d88a38d19</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2">
        <Swatch>2cb74d55-31bd-4188-868a-e5b465ec0481</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3">
        <Swatch>ec7b968e-4d80-43ad-b7fb-ef50f3e1bd50</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4">
        <Swatch>ca10b5ed-23ef-4879-b3aa-15488cd49f48</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5">
        <Swatch>28621a12-63ec-43fa-b416-72d25997459d</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6">
        <Swatch>faf4185f-5e30-4d80-a305-e005f75cbe84</Swatch>
      </Function>
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>80ab1ec4-d498-4b5d-a8c8-4bd1f78d6905</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="70~79" WheelPosition="1">
        <Swatch>ffbd8078-84d4-48ab-957e-826d88a38d19</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="80~89" WheelPosition="2">
        <Swatch>2cb74d55-31bd-4188-868a-e5b465ec0481</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="90~99" WheelPosition="3">
        <Swatch>ec7b968e-4d80-43ad-b7fb-ef50f3e1bd50</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="100~109" WheelPosition="4">
        <Swatch>ca10b5ed-23ef-4879-b3aa-15488cd49f48</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="110~119" WheelPosition="5">
        <Swatch>28621a12-63ec-43fa-b416-72d25997459d</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="120~129" WheelPosition="6">
        <Swatch>faf4185f-5e30-4d80-a305-e005f75cbe84</Swatch>
      </Function>
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="191~194" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="130~190" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="191~194" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="257~32639" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48830" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">

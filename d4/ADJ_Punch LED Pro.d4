<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Punch LED Pro" ShortName="PLed Pro" Company="ADJ" Version="8">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="05-12-08" Author="Jonathan Moreton" Comment="Created" Version="1" />
  <History Date="08-12-08" Author="David Hunt" Comment="Checked" Version="2" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="3" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="4" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="5" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="6" />
  <History Date="06-08-16" Author="Nic Morris" Comment="Fixed 6 DMX mapping and added missing Atlabase ID.  Increased wheel resolution." Version="7" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Punch LED Pro.d4 to ADJ_Punch LED Pro.d4." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b32c18b0-5988-4e97-8c11-2e8f97cc55af" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro %.1f%%',0.0~100.0" Dmx="8~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim - Bright" Display="'Dim - Bright %.f%%',0~100" Dmx="32~63" />
      <Function ID="3" Name="Bright - Dim" Display="'Bright - Dim %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Dim - Bright - Dim" Display="'Dim - Bright  - Dim %.f%%',0~100" Dmx="96~127" />
      <Function ID="5" Name="Colour Mixing" Display="'Colour Mixing %.f%%',0~100" Dmx="128~159" />
      <Function ID="6" Name="3 Colour Change" Display="'3 Colour      Change %.f%%',0~100" Dmx="160~191" />
      <Function ID="7" Name="7 Colour Change" Display="'7 Colour      Change %.f%%',0~100" Dmx="192~223" />
      <Function ID="8" Name="Sound Active" Display="'Sound Active %.f%%',0~100" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="ADJ_PLEDPR3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d2c80cad-ffa6-46f5-9d95-263a0814de29" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="6 DMX, 8bit" Channels="6">

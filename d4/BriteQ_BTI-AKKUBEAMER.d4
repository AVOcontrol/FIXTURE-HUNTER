  <AtlaBase TypeID="9b45c31e-fe01-43f1-b4bd-6642c4c2bcfa" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2500K" Display="'2500K'" Dmx="46~60" Colour="255,255,255" />
      <Function ID="3" Name="2800K" Display="'2800K'" Dmx="61~75" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="76~90" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="91~105" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="106~120" Colour="255,255,255" />
      <Function ID="7" Name="6000K" Display="'6000K'" Dmx="121~135" Colour="255,255,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="136~150" Colour="255,255,0" />
      <Function ID="9" Name="Orange" Display="'Orange'" Dmx="151~165" Colour="255,128,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="166~180" Colour="255,0,0" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="181~195" Colour="255,0,255" />
      <Function ID="12" Name="Cyan" Display="'Cyan'" Dmx="196~210" Colour="0,255,255" />
      <Function ID="13" Name="Blue" Display="'Blue'" Dmx="211~225" Colour="0,0,255" />
      <Function ID="14" Name="Green" Display="'Green'" Dmx="226~240" Colour="0,255,0" />
      <Function ID="15" Name="Green 2" Display="'Green 2'" Dmx="241~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="135~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="6~126" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~6" />
      <Function ID="2" Name="Preset" Display="'Preset'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="190~190" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="HSV, 3 DMX" Channels="3" Id="834634b5-ea76-48eb-b7a0-52115dd238a6">

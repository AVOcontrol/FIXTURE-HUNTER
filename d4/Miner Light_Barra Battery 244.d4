      <Function ID="17" Name="B+Y" Display="'B+Y'" Dmx="117~123" Colour="255,255,255" />
      <Function ID="18" Name="W+Y" Display="'W+Y'" Dmx="124~130" Colour="255,255,255" />
      <Function ID="19" Name="R+P" Display="'R+P'" Dmx="131~137" Colour="255,255,255" />
      <Function ID="20" Name="G+P" Display="'G+P'" Dmx="138~144" Colour="255,255,255" />

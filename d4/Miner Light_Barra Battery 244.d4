    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="11~200" />
      <Function ID="3" Name="Sound Auto Run Effect" Display="'Sound Auto Run Effect'" Dmx="201~210" />
      <Function ID="4" Name="Sound Active Col Change" Display="'Sound Active Col Change'" Dmx="211~220" />

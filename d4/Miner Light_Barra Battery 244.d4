  <History Date="02-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c298cb74-7316-4777-8eee-7dea0f45e032" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~17" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="18~23" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="24~31" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="32~38" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="39~45" Colour="255,255,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="46~52" Colour="128,0,255" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="53~59" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="60~66" Colour="255,255,255" />

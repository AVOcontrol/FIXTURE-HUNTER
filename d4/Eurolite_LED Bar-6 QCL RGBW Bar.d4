  <AtlaBase TypeID="a10518fd-b0c7-4418-8b6e-0e4037f8d316" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="10~29" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="30~49" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="50~69" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="70~89" Colour="255,255,255" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="90~109" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="110~129" Colour="255,255,255" />
      <Function ID="8" Name="6000K" Display="'6000K'" Dmx="130~149" Colour="255,255,255" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="150~169" Colour="255,255,255" />
      <Function ID="10" Name="7500K" Display="'7500K'" Dmx="170~189" Colour="255,255,255" />
      <Function ID="11" Name="8000K" Display="'8000K'" Dmx="190~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~119" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="120~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Green Yellow" Display="'Green Yellow'" Dmx="50~59" Colour="180,180,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~69" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="70~79" Colour="255,0,255" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="80~89" Colour="255,255,0" />
      <Function ID="10" Name="Turquoise" Display="'Turquoise'" Dmx="90~99" Colour="0,255,128" />
      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="100~109" Colour="255,0,255" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="110~119" Colour="255,128,0" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="120~129" Colour="128,255,0" />
      <Function ID="14" Name="Magenta" Display="'Magenta'" Dmx="130~139" Colour="255,0,255" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="140~149" Colour="255,150,150" />
      <Function ID="16" Name="Light Green" Display="'Light Green'" Dmx="150~159" Colour="128,255,0" />
      <Function ID="17" Name="Light Blue" Display="'Light Blue'" Dmx="160~169" Colour="0,128,255" />
      <Function ID="18" Name="Salmon" Display="'Salmon'" Dmx="170~179" Colour="255,150,150" />
      <Function ID="19" Name="Cold White" Display="'Cold White'" Dmx="180~189" Colour="230,230,255" />
      <Function ID="20" Name="Warm White" Display="'Warm White'" Dmx="190~199" Colour="255,240,200" />
      <Function ID="21" Name="Lavender" Display="'Lavender'" Dmx="200~255" Colour="255,128,255" />
    </Attribute>
  </Control>

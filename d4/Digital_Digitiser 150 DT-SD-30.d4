<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Digitiser 150 DT-SD-30" ShortName="Digitiser" Company="Digital">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="05-04-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Spread" Name="Spread" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Motion" Name="Motion" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FW" Display="'FW %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Transition" Name="Transition" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fade" Display="'Fade'" Dmx="0~16" />
      <Function ID="2" Name="Wipe" Display="'Wipe'" Dmx="48~48" />
      <Function ID="3" Name="Sweep" Display="'Sweep'" Dmx="80~80" />
      <Function ID="4" Name="Bounce" Display="'Bounce'" Dmx="112~112" />
      <Function ID="5" Name="Burst" Display="'Burst'" Dmx="144~144" />
      <Function ID="6" Name="Dissolve" Display="'Dissolve'" Dmx="176~176" />
      <Function ID="7" Name="Pulse" Display="'Pulse'" Dmx="208~208" />
      <Function ID="8" Name="Random" Display="'Random'" Dmx="240~240" />
    </Attribute>
    <Attribute ID="Repeat" Name="Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="2x" Display="'2x'" Dmx="16~16" />
      <Function ID="2" Name="3x" Display="'3x'" Dmx="48~48" />
      <Function ID="3" Name="4x" Display="'4x'" Dmx="80~80" />
      <Function ID="4" Name="5x" Display="'5x'" Dmx="112~112" />
      <Function ID="5" Name="6x" Display="'6x'" Dmx="144~144" />
      <Function ID="6" Name="7x" Display="'7x'" Dmx="176~176" />
      <Function ID="7" Name="8x" Display="'8x'" Dmx="208~208" />
      <Function ID="8" Name="Random" Display="'Random'" Dmx="240~240" />
    </Attribute>
    <Attribute ID="Effects_Spd" Name="Effects Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Overlay" Name="Overlay" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Sparkle" Display="'Sparkle'" Dmx="0~16" />
      <Function ID="2" Name="Comet" Display="'Comet'" Dmx="48~48" />
      <Function ID="3" Name="Trance" Display="'Trance'" Dmx="80~80" />
      <Function ID="4" Name="Breakout" Display="'Breakout'" Dmx="112~112" />
      <Function ID="5" Name="Equaliser" Display="'Equaliser'" Dmx="140~140" />
      <Function ID="6" Name="Fire" Display="'Fire'" Dmx="176~176" />
      <Function ID="7" Name="Water" Display="'Water'" Dmx="208~208" />
      <Function ID="8" Name="Random" Display="'Random'" Dmx="240~240" />
    </Attribute>
    <Attribute ID="Effects_Col" Name="Effects Col" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="16~16" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="48~48" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="80~80" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="112~112" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="144~144" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="176~176" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="208~208" />
      <Function ID="8" Name="White" Display="'White'" Dmx="240~240" />
    </Attribute>
    <Attribute ID="Length" Name="Length" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Length" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Action" Name="Action" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sparkle" Display="'Sparkle %.f%%',0~100" Dmx="4~48" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="49~239" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Spread" ChannelOffset="8" Wheel="9" />
        <Attribute ID="Motion" ChannelOffset="9" Wheel="22" />
        <Attribute ID="Transition" ChannelOffset="10" Wheel="23" />
        <Attribute ID="Repeat" ChannelOffset="11" Wheel="24" />
        <Attribute ID="Effects_Spd" ChannelOffset="12" Wheel="25" />
        <Attribute ID="Overlay" ChannelOffset="13" Wheel="52" />
        <Attribute ID="Effects_Col" ChannelOffset="14" Wheel="53" />
        <Attribute ID="Length" ChannelOffset="15" Wheel="26" />
        <Attribute ID="Action" ChannelOffset="16" Wheel="4" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Washer 12x30W RGBW Mk2" ShortName="Ws 12x30v2" Company="Flash Butrym">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="17-11-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d1f5b7b6-507d-49f4-a18c-fca69f8b7cd2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~10" Update="Col_Mac_Spd" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Update="Col_Mac_Spd" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Update="Col_Mac_Spd" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="21~25" Update="Col_Mac_Spd" Colour="0,255,255" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="26~30" Update="Col_Mac_Spd" Colour="255,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="31~35" Update="Col_Mac_Spd" Colour="255,255,0" />
      <Function ID="8" Name="Light Red" Display="'Light Red'" Dmx="36~40" Update="Col_Mac_Spd" Colour="255,100,100" />
      <Function ID="9" Name="Light Green" Display="'Light Green'" Dmx="41~45" Update="Col_Mac_Spd" Colour="128,255,0" />
      <Function ID="10" Name="Light Blue" Display="'Light Blue'" Dmx="46~50" Update="Col_Mac_Spd" Colour="0,128,255" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="51~55" Update="Col_Mac_Spd" Colour="255,128,0" />
      <Function ID="12" Name="Mint" Display="'Mint'" Dmx="56~60" Update="Col_Mac_Spd" Colour="0,255,200" />
      <Function ID="13" Name="Sky Blue" Display="'Sky Blue'" Dmx="61~65" Update="Col_Mac_Spd" Colour="0,128,255" />
      <Function ID="14" Name="Light Cyan" Display="'Light Cyan'" Dmx="66~70" Update="Col_Mac_Spd" Colour="128,255,255" />
      <Function ID="15" Name="Light Magenta" Display="'Light Magenta'" Dmx="71~75" Update="Col_Mac_Spd" Colour="255,128,255" />
      <Function ID="16" Name="Light Yellow" Display="'Light Yellow'" Dmx="76~80" Update="Col_Mac_Spd" Colour="255,255,128" />
      <Function ID="17" Name="White" Display="'White'" Dmx="81~85" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="18" Name="White 9000K" Display="'White 9000K'" Dmx="86~90" Update="Col_Mac_Spd" Colour="230,230,255" />
      <Function ID="19" Name="White 6500K" Display="'White 6500K'" Dmx="91~95" Update="Col_Mac_Spd" Colour="230,230,255" />
      <Function ID="20" Name="White 5600K" Display="'White 5600K'" Dmx="96~100" Update="Col_Mac_Spd" Colour="230,230,255" />
      <Function ID="21" Name="White 5000K" Display="'White 5000K'" Dmx="101~105" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="22" Name="White 4500K" Display="'White 4500K'" Dmx="106~110" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="23" Name="White 3200K" Display="'White 3200K'" Dmx="111~115" Update="Col_Mac_Spd" Colour="255,240,200" />
      <Function ID="24" Name="White 2500K" Display="'White 2500K'" Dmx="116~120" Update="Col_Mac_Spd" Colour="255,240,200" />
      <Function ID="25" Name="White 2200K" Display="'White 2200K'" Dmx="121~125" Update="Col_Mac_Spd" Colour="255,240,200" />
      <Function ID="26" Name="Macro 1 (Snap RGB)" Display="'Macro 1 (Snap RGB)'" Dmx="126~130" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="27" Name="Macro 2 (Snap RGBCMYW)" Display="'Macro 2 (Snap RGBCMYW)'" Dmx="131~135" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="28" Name="Macro 3 (Snap RGBCMY)" Display="'Macro 3 (Snap RGBCMY)'" Dmx="136~140" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="29" Name="Macro 4 (Snap RMBCGY)" Display="'Macro 4 (Snap RMBCGY)'" Dmx="141~145" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="30" Name="Macro 5 (Fade RGB)" Display="'Macro 5 (Fade RGB)'" Dmx="146~150" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="31" Name="Macro 6 (Fade RGBCMYW)" Display="'Macro 6 (Fade RGBCMYW)'" Dmx="151~155" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="32" Name="Macro 7 (Fade RGBCMY)" Display="'Macro 7 (Fade RGBCMY)'" Dmx="156~160" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="33" Name="Macro 8 (Fade RMBCGY)" Display="'Macro 8 (Fade RMBCGY)'" Dmx="161~165" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="34" Name="Macro 9 (Fade ROY)" Display="'Macro 9 (Fade ROY)'" Dmx="166~170" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="35" Name="Macro 10 (Fade RVBM)" Display="'Macro 10 (Fade RVBM)'" Dmx="171~175" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="36" Name="Macro 11 (Fade GCBV)" Display="'Macro 11 (Fade GCBV)'" Dmx="176~180" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="37" Name="Pixel Macro 1 (Chase FWD)" Display="'Pixel Macro 1 (Chase FWD)'" Dmx="181~185" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="38" Name="Pixel Macro 2 (Chase REV)" Display="'Pixel Macro 2 (Chase REV)'" Dmx="186~190" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="39" Name="Pixel Macro 3 (Chase FWD Smooth)" Display="'Pixel Macro 3 (Chase FWD Smooth)'" Dmx="191~195" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="40" Name="Pixel Macro 4 (Chase REV Smooth)" Display="'Pixel Macro 4 (Chase REV Smooth)'" Dmx="196~200" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="41" Name="Pixel Macro 5 (21/12)" Display="'Pixel Macro 5 (21/12)'" Dmx="201~205" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="42" Name="Pixel Macro 6 (21/12 Smooth)" Display="'Pixel Macro 6 (21/12 Smooth)'" Dmx="206~210" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="43" Name="Pixel Macro 7 (In-Out FWD)" Display="'Pixel Macro 7 (In-Out FWD)'" Dmx="211~215" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="44" Name="Pixel Macro 8 (In-Out REV)" Display="'Pixel Macro 8 (In-Out REV)'" Dmx="216~220" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="45" Name="Pixel Macro 9 (In-Out FWD Smooth)" Display="'Pixel Macro 9 (In-Out FWD Smooth)'" Dmx="221~225" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="46" Name="Pixel Macro 10 (In-Out REV Smooth)" Display="'Pixel Macro 10 (In-Out REV Smooth)'" Dmx="226~230" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="47" Name="Pixel Macro 11 (Rainbow)" Display="'Pixel Macro 11 (Rainbow)'" Dmx="231~235" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="48" Name="Sound 1" Display="'Sound 1'" Dmx="236~240" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="49" Name="Sound 2" Display="'Sound 2'" Dmx="241~245" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="50" Name="Sound 3" Display="'Sound 3'" Dmx="246~250" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="51" Name="Sound 4" Display="'Sound 4'" Dmx="251~255" Update="Col_Mac_Spd" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pulse Spd" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;26" />
      <Condition Name="Macro Spd" ID="4" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;48" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Pulse Spd" Display="'Pulse Spd %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="BG_Col_Dim" Name="BG Col Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

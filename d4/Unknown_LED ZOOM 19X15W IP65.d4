      <Function ID="18" Name="Auto Effect 7" Display="'Auto Effect 7'" Dmx="197~208" />
      <Function ID="19" Name="Auto Effect 8" Display="'Auto Effect 8'" Dmx="209~220" />
      <Function ID="20" Name="Auto Effect 9" Display="'Auto Effect 9'" Dmx="221~232" />
      <Function ID="21" Name="Auto Sound" Display="'Auto Sound'" Dmx="233~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">

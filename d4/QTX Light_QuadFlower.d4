<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="QuadFlower" ShortName="QuadFlower" Company="QTX Light">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="31-07-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sync" Display="'Sync'" Dmx="10~85" />
      <Function ID="3" Name="2-Light" Display="'2-Light'" Dmx="86~160" />
      <Function ID="4" Name="4-Light" Display="'4-Light'" Dmx="161~239" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto 1" Display="'Auto 1'" Dmx="0~20" />
      <Function ID="2" Name="Auto 2" Display="'Auto 2'" Dmx="21~41" />
      <Function ID="3" Name="Auto 3" Display="'Auto 3'" Dmx="43~63" />
      <Function ID="4" Name="Auto 4" Display="'Auto 4'" Dmx="64~85" />
      <Function ID="5" Name="Auto 5" Display="'Auto 5'" Dmx="86~106" />
      <Function ID="6" Name="Auto 6" Display="'Auto 6'" Dmx="107~127" />
      <Function ID="7" Name="Auto 7" Display="'Auto 7'" Dmx="128~149" />
      <Function ID="8" Name="Auto 8" Display="'Auto 8'" Dmx="150~170" />
      <Function ID="9" Name="Auto 9" Display="'Auto 9'" Dmx="171~191" />
      <Function ID="10" Name="Auto 10" Display="'Sound 10'" Dmx="192~213" />
      <Function ID="11" Name="Auto 11" Display="'Auto 11'" Dmx="214~234" />
      <Function ID="12" Name="Auto 12" Display="'Auto 12'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKQTXQFL" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Auto" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="3" Wheel="24" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
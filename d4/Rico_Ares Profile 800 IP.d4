      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="10~14" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="20~24" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="30~34" WheelPosition="3" Colour="0,0,0" />

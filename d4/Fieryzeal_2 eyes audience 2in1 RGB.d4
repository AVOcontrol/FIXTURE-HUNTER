<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="2 eyes audience 2in1 RGB" ShortName="2 eyes aud" Company="Fieryzeal" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="25-09-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="COB_FX" Name="COB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="COB_FX_Spd" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="5~13" Update="COB_FX_Spd" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="14~22" Update="COB_FX_Spd" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="23~31" Update="COB_FX_Spd" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="32~40" Update="COB_FX_Spd" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="41~49" Update="COB_FX_Spd" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="50~58" Update="COB_FX_Spd" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="59~67" Update="COB_FX_Spd" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="68~76" Update="COB_FX_Spd" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="77~85" Update="COB_FX_Spd" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="86~94" Update="COB_FX_Spd" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="95~103" Update="COB_FX_Spd" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="104~112" Update="COB_FX_Spd" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="113~121" Update="COB_FX_Spd" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="122~130" Update="COB_FX_Spd" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="131~139" Update="COB_FX_Spd" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="140~148" Update="COB_FX_Spd" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="149~157" Update="COB_FX_Spd" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="158~166" Update="COB_FX_Spd" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="167~175" Update="COB_FX_Spd" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="176~184" Update="COB_FX_Spd" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="185~193" Update="COB_FX_Spd" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="194~202" Update="COB_FX_Spd" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="203~211" Update="COB_FX_Spd" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="212~220" Update="COB_FX_Spd" />
      <Function ID="26" Name="Effect 25 (Loop)" Display="'Effect 25 (Loop)'" Dmx="221~244" Update="COB_FX_Spd" />
      <Function ID="27" Name="Sound" Display="'Sound'" Dmx="245~255" Update="COB_FX_Spd" />
    </Attribute>
    <Attribute ID="COB_FX_Spd" Name="COB FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1,2" />
      <Condition Name="Sound" ID="3" If="'COB_FX'==27" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="5~11" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="12~18" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="19~25" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="26~32" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="33~39" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="40~46" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="47~53" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="54~60" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="61~67" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="68~74" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="75~81" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="82~88" />

      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="124~130" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="131~137" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="138~144" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="145~151" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="152~158" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="159~165" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="166~172" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="173~179" />
      <Function ID="27" Name="Effect 26" Display="'Effect 26'" Dmx="180~186" />
      <Function ID="28" Name="Effect 27" Display="'Effect 27'" Dmx="187~193" />
      <Function ID="29" Name="Effect 28" Display="'Effect 28'" Dmx="194~200" />
      <Function ID="30" Name="Effect 29" Display="'Effect 29'" Dmx="201~207" />
      <Function ID="31" Name="Effect 30 (Loop)" Display="'Effect 30 (Loop)'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="RGB_FX_Spd" Name="RGB FX Spd" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13" Id="b62413a9-c4d3-4ddd-83be-d17e633f5d34">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="WarmWhite" Wheel="40" />
        <Attribute ID="White" Wheel="41" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="COB_FX" ChannelOffset="10" Wheel="22" />
        <Attribute ID="COB_FX_Spd" ChannelOffset="11" Wheel="23" />
        <Attribute ID="RGB_FX" ChannelOffset="12" Wheel="52" />
        <Attribute ID="RGB_FX_Spd" ChannelOffset="13" Wheel="53" />
      </Master>
      <Cell ID="Cell1" Name="COB 1" ChannelOffset="3" ModeLink="COB cell" X="0" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="COB 2" ChannelOffset="5" ModeLink="COB cell" X="0" Y="1">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="RGB" ChannelOffset="7" ModeLink="RGB cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="COB cell" Channels="2" Hidden="True" Id="2477ea7d-e7c1-4a38-90ee-d363493b0f86">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="2" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True" Id="e88288b5-698b-46f5-bc56-f694f61f7142">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Legend="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Legend="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Legend="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

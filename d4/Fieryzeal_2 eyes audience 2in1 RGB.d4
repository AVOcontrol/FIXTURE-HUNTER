      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="96~102" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="103~109" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="110~116" />

  <Mode Name="Cell" Channels="4" Hidden="True" Id="2f8ac112-85ba-47e9-97d5-1352d9e90570">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

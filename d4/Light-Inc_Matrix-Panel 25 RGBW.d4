      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="71~80" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="81~90" />
      <Function ID="10" Name="Program 1" Display="'Program 1'" Dmx="91~100" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="101~110" />

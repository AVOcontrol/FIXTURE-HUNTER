      <Function ID="2" Name="Effect" Display="'Effect %.f',1~85" Dmx="3~172" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixel_Effect_Spd" Name="Pixel Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="FW no fade" Display="'FW no fade %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="REV no fade" Display="'REV no fade %.f%%',100~0" Dmx="64~127" />
      <Function ID="3" Name="FW w/ fade" Display="'FW w/ fade %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="REV w/ fade" Display="'REV w/ fade %.f%%',100~0" Dmx="192~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">

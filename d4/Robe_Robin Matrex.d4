<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin Matrex" ShortName="Matrex" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="13-04-15" Author="Petr Vanek + Radim Zlebek " Comment="Created" />
  <History Date="13-04-15" Author="Nic Morris" Comment="Fixed CCW spin range in Effect4.  Fixed wheel mapping.  Removed Dimmer8b as no longer required." />
  <History Date="13-04-15" Author="Nic Morris" Comment="Adjusted RGB Master locate values.  Moved 'All Zooms' to Beam wheel slot." />
  <History Date="13-04-15" Author="Nic Morris" Comment="Added dimmer master attribute and dimmer link to Mode 4" />
  <History Date="04-05-15" Author="Nic Morris" Comment="Rewrote control and macros.  Updated to latest spec.  Tidied up." />
  <History Date="04-05-15" Author="Nic Morris" Comment="Changed RGBW to 16-bit.  Replaced mode 1 RGBW master with RGBW.  Removed White master." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="RGBW Mode" Display="'RGBW Mode'" Dmx="30~39" />
      <Function ID="5" Name="CMY Mode" Display="'CMY Mode'" Dmx="40~49" />
      <Function ID="6" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="7" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="8" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="9" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="10" Name="Dim Square" Display="'Dim Square'" Dmx="90~99" />
      <Function ID="11" Name="Dim Linear" Display="'Dim Linear'" Dmx="100~109" />
      <Function ID="12" Name="Reset no PT" Display="'Reset no PT'" Dmx="130~139" />
      <Function ID="13" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="14" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="150~159" />
      <Function ID="15" Name="Reset Effects" Display="'Reset Effects'" Dmx="160~169" />
      <Function ID="16" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Tung" Display="'2700K Tung'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Tung" Display="'3200K Tung'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="16~247" Colour="255,255,255" />
      <Function ID="10" Name="Scroll w/ fade" Display="'Scroll w/ fade %.f%%',0~100" Dmx="248~251" Colour="255,255,255" />
      <Function ID="11" Name="Scroll no fade" Display="'Scroll no fade %.f%%',0~100" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pixel_Effect" Name="Pixel Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

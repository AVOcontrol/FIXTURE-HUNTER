<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Double Sweeper LED" ShortName="Dbl Sweepr" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="01-08-15" Author="Nic Morris" Comment="Created (very basic documentation)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Movement" Name="Movement" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SHDBLSWP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Movement" ChannelOffset="3" Wheel="24" />
    </Include>
  </Mode>
</Fixture>
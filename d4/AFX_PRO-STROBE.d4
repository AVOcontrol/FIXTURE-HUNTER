<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PRO-STROBE" ShortName="PRO-STROBE" Company="AFX">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="06-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="10~199" Update="Auto_Spd" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="200~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Segment" Name="Segment" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="10~19" />
      <Function ID="3" Name="2" Display="'2'" Dmx="20~29" />
      <Function ID="4" Name="3" Display="'3'" Dmx="30~39" />
      <Function ID="5" Name="4" Display="'4'" Dmx="40~49" />
      <Function ID="6" Name="5" Display="'5'" Dmx="50~59" />
      <Function ID="7" Name="6" Display="'6'" Dmx="60~69" />
      <Function ID="8" Name="1+2" Display="'1+2'" Dmx="70~79" />
      <Function ID="9" Name="1+3" Display="'1+3'" Dmx="80~89" />
      <Function ID="10" Name="1+4" Display="'1+4'" Dmx="90~99" />
      <Function ID="11" Name="1+5" Display="'1+5'" Dmx="100~109" />
      <Function ID="12" Name="1+6" Display="'1+6'" Dmx="110~119" />
      <Function ID="13" Name="2+3" Display="'2+3'" Dmx="120~129" />
      <Function ID="14" Name="2+4" Display="'2+4'" Dmx="130~139" />
      <Function ID="15" Name="2+5" Display="'2+5'" Dmx="140~149" />
      <Function ID="16" Name="2+6" Display="'2+6'" Dmx="150~159" />
      <Function ID="17" Name="3+4" Display="'3+4'" Dmx="160~169" />
      <Function ID="18" Name="3+5" Display="'3+5'" Dmx="170~179" />
      <Function ID="19" Name="3+6" Display="'3+6'" Dmx="180~189" />
      <Function ID="20" Name="4+5" Display="'4+5'" Dmx="190~199" />
      <Function ID="21" Name="4+6" Display="'4+6'" Dmx="200~209" />
      <Function ID="22" Name="5+6" Display="'5+6'" Dmx="210~219" />
      <Function ID="23" Name="1+2+3" Display="'1+2+3'" Dmx="220~229" />
      <Function ID="24" Name="1+3+5" Display="'1+3+5'" Dmx="230~239" />
      <Function ID="25" Name="2+4+6" Display="'2+4+6'" Dmx="240~249" />
      <Function ID="26" Name="All" Display="'All'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer_1" Name="Dimmer 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_2" Name="Dimmer 2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_3" Name="Dimmer 3" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_4" Name="Dimmer 4" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_5" Name="Dimmer 5" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer_6" Name="Dimmer 6" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKAXPST1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Segment" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="3" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="UKAXPST2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer_1" ChannelOffset="1" Wheel="34" />
      <Attribute ID="Dimmer_2" ChannelOffset="2" Wheel="35" />
      <Attribute ID="Dimmer_3" ChannelOffset="3" Wheel="36" />
      <Attribute ID="Dimmer_4" ChannelOffset="4" Wheel="64" />
      <Attribute ID="Dimmer_5" ChannelOffset="5" Wheel="65" />
      <Attribute ID="Dimmer_6" ChannelOffset="6" Wheel="66" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="24" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="7" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
        <Attribute ID="Auto" ChannelOffset="9" Wheel="23" />
        <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
</Fixture>
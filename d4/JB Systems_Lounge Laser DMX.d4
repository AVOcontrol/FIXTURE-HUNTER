<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Lounge Laser DMX" ShortName="Lnge Laser" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-02-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Laser Blackout" Display="'Laser Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="52~102" />
      <Function ID="3" Name="Slow" Display="'Slow'" Dmx="103~154" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="155~206" />
      <Function ID="5" Name="DMX" Display="'DMX'" Dmx="207~255" />
    </Attribute>
    <Attribute ID="Red_Laser" Name="Red Laser" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Green_Laser" Name="Green Laser" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="134~255" />
    </Attribute>
    <Attribute ID="LED_Rot" Name="LED Rot" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="5~127" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="254~128" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Blackout" Display="'Laser Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="8~100" />
      <Function ID="3" Name="Slow" Display="'Slow'" Dmx="101~170" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="171~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="JBLNGLS1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show" ChannelOffset="1" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="JBLNGLS7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Red_Laser" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Green_Laser" ChannelOffset="3" Wheel="6" />
      <Attribute ID="Laser_Rot" ChannelOffset="4" Wheel="20" />
      <Attribute ID="LED_Rot" ChannelOffset="5" Wheel="19" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pro Spot 575 LX" ShortName="PSpt 575LX" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="08-01-03" Author="D.Shelton" Comment="Created" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="16-01-04" Author="Shahid Anwar" Comment="Shutter control enhanced, now gives all possible options" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. Dimmer - (Power On) not 0" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Shutter - Invert legend 100%-0% for range 128-184 (Locate) not open" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Focus - (Locate) Not 127" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 5. Gobo 2 - Change legend for 193-255 to SPIN 0-100%" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 6. Invert legend 10%-0 for 128-190 range" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 7. E/C Pos - No preset positions just 0-255 raw DMX" />
  <History Date="11-05-04" Author="Greg Brown" Comment="Above Errors corrected and brought in line with current format" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Gobo1 Rot: Can't seem to access all areas of channel" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Raw fuc not working properly on Gobo 2" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Proportional prism CW incorrect. Display wrong and is a step function." />
  <History Date="11-08-05" Author="Ed" Comment="Error: All motoro reset legend too long on control channel" />
  <History Date="12-08-05" Author="Ed" Comment="Fixed all above problems" />
  <History Date="06-04-06" Author="Ed" Comment="Moved GC Pos into Special group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed attribute IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Mode" />
  <History Date="09-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="04-05-15" Author="Nic Morris" Comment="Removed function channels and index to simplify in response to customer bug report." />
  <History Date="04-05-15" Author="Nic Morris" Comment="Added palettes.  Standardised locate" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="/manual/Coemar_Pro Spot 575 LX.pdf" Summary="Created:Massimo, 30/1/2001,06/06/2001" />
  <AtlaBase TypeID="9e10a34f-4709-4e66-b9e7-d4d530684df6" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="245~255" Intensity="0~0" />
      <Function ID="3" Name="Synchro Strobe" Display="'Synchro Strobe %.f Hz',0~10" Dmx="10~66" Intensity="0~0" />
      <Function ID="4" Name="Pulse. Close Slow Open Fast" Display="'Close Slow    Open Fast %.f%%',0~100" Dmx="69~125" Intensity="0~0" />
      <Function ID="5" Name="Pulse. Close Fast Open Slow" Display="'Close Fast    Open Slow %.f%%',0~100" Dmx="184~128" Intensity="0~0" />
      <Function ID="6" Name="Random Strobe" Display="'Random        Strobe %.f%%',0~100" Dmx="188~244" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="129~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Iris Pulse" Display="'Pulse %.f%%',0~100" Dmx="130~189" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="190~192" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Iris Pulse/Flash" Display="'Flash %.f%%',0~100" Dmx="193~251" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="252~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="11~40" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="41~70" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="71~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="101~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="131~160" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="161~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Index" Name="Gobo 1 Index" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Index" Display="'No Index'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="11~40" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="41~70" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="71~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="101~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="131~160" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="161~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="11~20" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="21~136" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="137~139" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="140~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="4:50" Lowlight="3:50" />
      <Function ID="1" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~7" Colour="0,0,0" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue %.f%%',0~100" Dmx="8~27" Colour="0,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="28~47" Colour="0,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="48~67" Colour="0,0,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="68~87" Colour="0,0,0" />
      <Function ID="6" Name="Red" Display="'Red %.f%%',0~100" Dmx="88~107" Colour="0,0,0" />
      <Function ID="7" Name="Green" Display="'Green %.f%%',0~100" Dmx="108~127" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Gobo_Mode" Name="Col Gobo Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Fixed" Display="'All Fixed'" Dmx="0~0" />
      <Function ID="2" Name="Gobo Index" Display="'Gobo Index'" Dmx="11~125" />
      <Function ID="3" Name="Col Index" Display="'Col Index'" Dmx="126~239" />
      <Function ID="4" Name="All Index" Display="'All Index'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~10" />
      <Function ID="2" Name="No effect" Display="'No effect'" Dmx="11~29" />
      <Function ID="3" Name="PT Reset" Display="'PT Reset'" Dmx="30~65" />
      <Function ID="4" Name="Mtr Rst Ex PT" Display="'Mtr Rst Ex PT'" Dmx="66~100" />
      <Function ID="5" Name="Mtr Rst Ex Dim" Display="'Mtr Rst Ex Dim'" Dmx="101~135" />
      <Function ID="6" Name="Motor Reset" Display="'Motor Reset'" Dmx="136~170" />
      <Function ID="7" Name="No AutoLens" Display="'No AutoLens'" Dmx="171~249" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index Fine" Display="'Index Fine %.f%%',0~100" Dmx="0~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="101~176" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="177~179" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="180~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="CM_PSpt575X" DiamondRef="CO_PSpt575X" WysiwygRef="" />
    <Physical>
      <Bulb Type="Phillips MSD 575W" Lumens="18000" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="23.5" />
      <Size Height="0.510" Width="0.456" Depth="0.350" />
      <Focus Type="Head" PanMax="385" TiltMax="260" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5a8ab18d-93aa-4283-8757-e6827e0cdc7e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="13" />
      <Attribute ID="Gobo1Index" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="11" Wheel="15" />
      <Attribute ID="Gobo2" ChannelOffset="12" Wheel="17" />
      <Attribute ID="Iris" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="13" Wheel="22" />
      <Attribute ID="Col_Gobo_Mode" ChannelOffset="15" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8" Delay="8000" />
      <Set Channel="Control:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:1" Delay="8000" />
      <Set Channel="Control:2" Delay="0" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:6" Delay="8000" />
      <Set Channel="Control:2" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
      <Palette ID="7" Name="Frost Off" Number="47" Page="1" SetControl="Frost:1:0" />
      <Palette ID="8" Name="Frost Full" Number="48" Page="1" SetControl="Frost:1:100" />
    </Group>
  </Palettes>
</Fixture>
  <AtlaBase TypeID="2e2e91a8-7123-4d50-bfbd-366b6aed80a5" />
  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~13" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="14~20" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="21~27" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="5" Name="White" Display="'White'" Dmx="28~34" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="35~41" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="42~48" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="8" Name="Red+White" Display="'Red+White'" Dmx="49~55" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="56~62" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="10" Name="Green+White" Display="'Green+White'" Dmx="63~69" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="11" Name="Blue+White" Display="'Blue+White'" Dmx="70~76" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="12" Name="White (RGB)" Display="'White (RGB)'" Dmx="77~83" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="13" Name="Yellow+White" Display="'Yellow+White'" Dmx="84~90" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="14" Name="Magenta+White" Display="'Magenta+White'" Dmx="91~97" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="15" Name="Cyan+White" Display="'Cyan+White'" Dmx="98~104" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="16" Name="White (RGBW)" Display="'White (RGBW)'" Dmx="105~111" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="17" Name="Auto 1" Display="'Auto 1'" Dmx="112~118" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="18" Name="Auto 2" Display="'Auto 2'" Dmx="119~125" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="19" Name="Auto 3" Display="'Auto 3'" Dmx="126~132" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="20" Name="Auto 4" Display="'Auto 4'" Dmx="133~139" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="21" Name="Auto 5" Display="'Auto 5'" Dmx="140~146" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="22" Name="Auto 6" Display="'Auto 6'" Dmx="147~153" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="23" Name="Auto 7" Display="'Auto 7'" Dmx="154~160" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="24" Name="Auto 8" Display="'Auto 8'" Dmx="161~167" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="25" Name="Auto 9" Display="'Auto 9'" Dmx="168~174" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="26" Name="Auto 10" Display="'Auto 10'" Dmx="175~181" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="27" Name="Auto 11" Display="'Auto 11'" Dmx="182~188" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="28" Name="Sound 1" Display="'Sound 1'" Dmx="189~195" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="29" Name="Sound 2" Display="'Sound 2'" Dmx="196~202" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="30" Name="Sound 3" Display="'Sound 3'" Dmx="203~209" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="31" Name="Sound 4" Display="'Sound 4'" Dmx="210~216" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="32" Name="Sound 5" Display="'Sound 5'" Dmx="217~223" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="33" Name="Sound 6" Display="'Sound 6'" Dmx="224~230" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="34" Name="Sound 7" Display="'Sound 7'" Dmx="231~237" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="35" Name="Sound 8" Display="'Sound 8'" Dmx="238~244" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="36" Name="Sound 9" Display="'Sound 9'" Dmx="245~251" Update="Macro_Spd, Master_Dimmer" />
      <Function ID="37" Name="Sound 10" Display="'Sound 10'" Dmx="252~255" Update="Macro_Spd, Master_Dimmer" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="2" If="'Macro'&gt;16&amp;&amp;'Macro'&lt;28" />
      <Condition Name="Sensitivity" ID="3" If="'Macro'&gt;27" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="12~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="No Function" ID="2" If="'Macro'&gt;1&amp;&amp;'Macro'&lt;17" />
      <Condition Name="Speed" ID="3" If="'Macro'&gt;16&amp;&amp;'Macro'&lt;28" />
      <Condition Name="Sensitivity" ID="4" If="'Macro'&gt;27" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="07-09-23" Author="Nic Morris" Comment="Created (charts are vague.  note gel index function ranges incomplete)" Version="0" />
  <History Date="08-11-23" Author="Nic Morris" Comment="Updated Gel Index with discreet functions in line with latest documentation." Version="8" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M" Name="G/M" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0 G" Display="'0 G'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="100 M" Display="'100 M'" Dmx="21~33" Colour="255,255,255" />
      <Function ID="3" Name="+ M" Display="'+ M %.f%%',99~1" Dmx="34~134" Colour="255,255,255" />
      <Function ID="4" Name="0 G" Display="'0 G'" Dmx="135~145" Colour="255,255,255" />
      <Function ID="5" Name="+ G" Display="'+ G %.f%%',1~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="100 G" Display="'100 G'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~359.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Brand" Name="Gel Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Gel_Index" Colour="255,255,255" />
      <Function ID="2" Name="Resco" Display="'Resco'" Dmx="21~39" Update="Gel_Index" Colour="255,255,255" />
      <Function ID="3" Name="Lee" Display="'Lee'" Dmx="40~255" Update="Gel_Index" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel_CCT" Name="Gel CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="21~39" Colour="255,255,255" />
    </Attribute>

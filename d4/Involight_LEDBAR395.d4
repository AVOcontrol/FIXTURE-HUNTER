      <Function ID="5" Name="Green Fade" Display="'Green Fade'" Dmx="153~203" />
      <Function ID="6" Name="Blue Fade" Display="'Blue Fade'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

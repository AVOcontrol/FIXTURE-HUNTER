<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Color 1200" ShortName="StCol 1200" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-01-03" Author="D.Shelton" Comment="Created" />
  <History Date="04-03-03" Author="D.Shelton" Comment="Updated ID's for Shape Generator" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="20-08-03" Author="D.Shelton" Comment="Updated Pan/Tilt Channels" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. No macros found" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. CMY - Not locate at 255 values 0-100% inverted" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Pan + Tilt - 8 bit is fine not course" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found . Pan F + Tilt F - 16 bit only" />
  <History Date="03-05-05" Author="Phil" Comment="Added info for RGB mode" />
  <History Date="22-07-05" Author="D Trounce" Comment="Error: No Macros" />
  <History Date="06-04-06" Author="Ed" Comment="Moved CTC to colour group" />
  <History Date="06-04-06" Author="Ed" Comment="Moved frost into beam group" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved Ovaliser into beam group" />
  <History Date="07-07-06" Author="Ed" Comment="Changed CMY Mixing attributes to proper CMIXes" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="28-05-17" Author="Nic Morris" Comment="Standardised shutter.  Increased wheel resolution.  Standardised CTO.  Added palettes." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Moved frost and ovaliser into beam wheel slots.  Standardised highlight/lowlight." />
  <Manual Filename="/manual/Clay Paky_Stage Color 1200.pdf" Summary="Creator:Clay Paky, 09-07-2001" />
  <AtlaBase TypeID="e7ce65b2-c7a2-4a41-a108-ba46c0f22001" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe  %.1f%%',0.0~100.0" Dmx="26~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour " Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="42~85" Colour="0,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="86~128" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="129~171" Colour="0,0,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="172~214" Colour="0,0,0" />
      <Function ID="6" Name="UV Filter" Display="'UV Filter'" Dmx="215~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ovalizer" Name="Ovalizer" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Ovalizer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Lamp OFF" Display="'Lamp OFF'" Dmx="0~0" />
      <Function ID="2" Name="Lamp ON" Display="'Lamp ON'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
  </Control>

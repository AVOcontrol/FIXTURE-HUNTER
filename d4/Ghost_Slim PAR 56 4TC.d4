  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0ecc34b2-e224-47a4-b74f-fe687d27073f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="6" If="'Auto'&gt;1" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="7~65" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="70~128" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="133~191" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="196~255" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Func" Name="Auto Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Static Colour" ID="2" If="'Auto'==2" />
      <Condition Name="Strobe" ID="3" If="'Auto'==3" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Strobe" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter, Auto_Func" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="60~119" Update="Shutter, Auto_Func" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="120~179" Update="Shutter, Auto_Func" />
      <Function ID="4" Name="Col Linear" Display="'Col Linear'" Dmx="180~239" Update="Shutter, Auto_Func" />
      <Function ID="5" Name="Sound 1" Display="'Sound 1'" Dmx="240~245" Update="Shutter, Auto_Func" />
      <Function ID="6" Name="Sound 2" Display="'Sound 2'" Dmx="246~251" Update="Shutter, Auto_Func" />
      <Function ID="7" Name="Sound 3" Display="'Sound 3'" Dmx="252~255" Update="Shutter, Auto_Func" />
    </Attribute>
  </Control>

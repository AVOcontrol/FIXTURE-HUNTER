  <History Date="11-09-15" Author="Nic Morris" Comment="Updated to latest spec" Version="2" />
  <History Date="20-01-16" Author="Nic Morris" Comment="Revised Gobo 2 scroll function ranges in response to manufacturer request." Version="3" />
  <History Date="12-02-16" Author="Nic Morris" Comment="Updated to v1.3" Version="4" />
  <History Date="15-04-16" Author="Nic Morris" Comment="Updated col mix func functions and locate in line with v1.4 spec." Version="5" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="6" />
  <History Date="21-10-16" Author="Nic Morris" Comment="Changed Col Mix Func locate to 'ADD' in line with v1.5 chart in response to manufacturer request." Version="7" />
  <History Date="08-11-16" Author="Nic Morris" Comment="Revised Cyan and Lt Green attributes to use CyanAdditive and Lime reserved ID's." Version="8" />
  <History Date="25-01-17" Author="Peter Budd" Comment="Added Open ranges on Gobo Wheels, corrected blade rotate functions, re-implemented Nics V1.6 changes and added P/T Speed." Version="9" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (RoboSpot control functions/macros)" Version="10" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised colour macro function names.  Added gobo 1 index functions.  Revised gobo 1 scroll ranges." Version="11" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised mode names with channel counts.  Simplified frost and iris ranges.  Inverted zoom." Version="12" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised frame attribute ID's for correct alighnment with Attribute Editor controls." Version="13" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Recreated palettes with frost and iris." Version="14" />
  <History Date="24-10-17" Author="Nic Morris" Comment="Unification across product range." Version="15" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added product thumbnail" Version="16" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added gobo swatches" Version="17" />
  <History Date="06-09-18" Author="Nic Morris" Comment="Created from Robe Robin DL7S Profile" Version="18" />
  <History Date="11-09-18" Author="Nic Morris" Comment="Added R20" Version="19" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Updated in line with v1.3 charts." Version="20" />
  <History Date="19-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches.  Updated in line with v1.4 charts." Version="21" />
  <History Date="22-02-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Minor correction to Colour Macro function typo ('Filter 120 Deep Blue' was 'Filter 120 Beep Blue')" Version="22" />
  <History Date="20-11-20" Author="Nic Morris" Comment="Updated in line with v1.9 charts (minor change to gobo scroll ranges)." Version="23" />
  <History Date="25-01-21" Author="Nic Morris" Comment="Changed Colour Macro to Virtual Col for compatibility across range in response to manufacturer query." Version="24" />
  <History Date="07-07-21" Author="Nic Morris" Comment="Created from Robe Robin T1 Profile (v1.0)" Version="25" />
  <History Date="17-08-21" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (still v1.0 iteration. adds escape silent mode control function and macro. removes virtual col multi col functions)." Version="26" />
  <History Date="04-10-21" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request (revises CRI default, changes escape silent mode to simple mode off, removes fans high and adds high freq)." Version="27" />
  <History Date="22-11-21" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (revises CRI default again)" Version="28" />
  <History Date="25-11-21" Author="Nic Morris" Comment="Added product thumbnail" Version="29" />
  <History Date="27-03-23" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (adds dim super square colour func function and macro).  Added Atlabase IDs." Version="30" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="31" />
  <History Date="11-12-23" Author="Nic Morris" Comment="Created from Robe Robin T11 Profile" Version="32" />
  <History Date="13-04-24" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="33" />
  <History Date="16-04-25" Author="Nic Morris" Comment="Changed lime to default at full in response to manufacturer request." Version="34" />
  <History Date="07-09-25" Author="Nic Morris" Comment="Added CMY modes." Version="35" />
  <History Date="19-11-25" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request." Version="36" />

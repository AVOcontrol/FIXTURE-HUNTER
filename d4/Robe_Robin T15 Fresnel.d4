      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="230~230" Colour="255,255,255" />
      <Function ID="7" Name="2700K" Display="'2700K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Shift" Display="'No Shift'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Green" Display="'- Green %.1f%%',100.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="No Shift" Display="'No Shift'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mix_Func" Name="Col Mix Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Virtual" Display="'Virtual'" Dmx="0~0" />
      <Function ID="2" Name="HTP" Display="'HTP'" Dmx="10~19" />
      <Function ID="3" Name="LTP" Display="'LTP'" Dmx="20~29" />
      <Function ID="4" Name="MIX" Display="'MIX'" Dmx="30~39" />
      <Function ID="5" Name="ADD" Display="'ADD'" Dmx="45~45" />
      <Function ID="6" Name="SUB" Display="'SUB'" Dmx="50~59" />
      <Function ID="7" Name="INV SUB" Display="'INV SUB'" Dmx="60~69" />
      <Function ID="8" Name="White Point Off" Display="'White Point Off'" Dmx="70~79" />
      <Function ID="9" Name="Virtual" Display="'Virtual'" Dmx="129~129" />
      <Function ID="10" Name="Xfade" Display="'Xfade %.1f%%',0.0~100.0" Dmx="130~254" />
      <Function ID="11" Name="Colour Mix" Display="'Colour Mix'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
  </Control>

      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="126~140" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>9d45aa81-3063-41e5-ac70-cc96714a8f26</Swatch>

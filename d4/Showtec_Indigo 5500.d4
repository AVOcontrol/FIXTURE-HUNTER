  <History Date="19-10-12" Author="Peter Budd" Comment="Created from the Showtec Indigo 5000" Version="2" />
  <History Date="28-07-15" Author="Gregory Haynes" Comment="Added Highlight and Lowlight values." Version="3" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="4" />
  <History Date="08-11-20" Author="Nic Morris" Comment="Standardised conditionals and function orders.  Added macros.  Added product thumbnail.  Added gobo swatches." Version="5" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c5322e50-68a8-4d01-993b-7f0367130225" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="30~39" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="40~49" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~59" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="60~69" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="70~79" Colour="0,128,255" />
      <Function ID="9" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="219~200" Colour="255,0,0" />
      <Function ID="10" Name="Rd - Grn" Display="'Rd - Grn %.f%%',0~100" Dmx="199~180" Colour="0,255,0" />
      <Function ID="11" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="179~160" Colour="255,255,0" />
      <Function ID="12" Name="Yel - Blu" Display="'Yel - Blu %.f%%',0~100" Dmx="159~140" Colour="0,0,255" />
      <Function ID="13" Name="Blu - Org" Display="'Blu - Org %.f%%',0~100" Dmx="139~120" Colour="255,128,0" />
      <Function ID="14" Name="Org - Mag" Display="'Org - Mag %.f%%',0~100" Dmx="119~100" Colour="255,0,255" />
      <Function ID="15" Name="Mag - L Blu" Display="'Mag - L Blu %.f%%',0~100" Dmx="99~80" Colour="0,128,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>4517c2f3-1d8d-4655-84f3-7738f4c7640e</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="11~20" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>fe504f42-27d8-4d35-80d0-45893cd972f5</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="21~30" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>05635d78-bab7-4879-a3fd-4b414b0a9e9d</Swatch>

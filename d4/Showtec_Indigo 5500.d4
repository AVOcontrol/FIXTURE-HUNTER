      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="161~255" GoboSpin="0~0" GoboOrientation="0~0" />

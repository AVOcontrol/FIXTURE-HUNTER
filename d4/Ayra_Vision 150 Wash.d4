    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="&lt;3200K" Display="'&lt;3200K'" Dmx="0~0" Colour="255,240,200" />
      <Function ID="3" Name="3200-3500K" Display="'3200-3500K %.fK',3200~3500" Dmx="1~255" Colour="255,240,200" />
      <Function ID="4" Name="3500-5000K" Display="'3500-5000K %.fK',3500~5000" Dmx="1~255" Colour="255,240,200" />
      <Function ID="5" Name="5000-5500K" Display="'5000-5500K %.fK',5000~5500" Dmx="1~255" Colour="255,240,200" />
      <Function ID="6" Name="5500-6000K" Display="'5500-6000K %.fK',5500~6000" Dmx="1~255" Colour="255,240,200" />
      <Function ID="7" Name="6000-6500K" Display="'6000-6500K %.fK',6000~6500" Dmx="1~255" Colour="255,240,200" />
      <Function ID="8" Name="6500-7000K" Display="'6500-7000K %.fK',6500~7000" Dmx="1~255" Colour="255,240,200" />
      <Function ID="9" Name="7000-8000K" Display="'7000-8000K %.fK',7000~8000" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Halogen_Effect" Name="Halogen Effect" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Halogen Effect" Display="'Halogen Effect %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="80~89" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="90~99" />
      <Function ID="4" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="5" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="6" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="7" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="8" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="9" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="10" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
  </Control>

  <History Date="30-08-19" Author="Nic Morris" Comment="Changed name from Espritt to Esprite and updated in line with v1.1 charts in response to manufacturer request (adds max intensity control and boost mode control functions and macros)" Version="2" />
  <History Date="13-11-19" Author="Nic Morris" Comment="Fixed colour CCW scroll DMX range.  Added product thumbnail.  Added gobo swatches." Version="3" />
  <History Date="12-12-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <History Date="20-11-20" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (minor change to gobo scroll ranges)." Version="5" />
  <History Date="14-01-21" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds modes 3+4)" Version="6" />
  <History Date="14-01-21" Author="Nic Morris" Comment="Revised fixed colour names and swatches.  Revised CTO range.  Added prism index/prism spin." Version="6" />
  <History Date="20-05-21" Author="Nic Morris" Comment="Updated in line with v2.0 charts in response to manufacturer request (adds control functions and macros)" Version="7" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Updated in line wtih v2.2 charts in response to manufacturer request (adds ultra square dim curve control function and macro)" Version="8" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Added Atlabase ID's for modes 3 and 4." Version="8" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="9" />
  <History Date="11-12-23" Author="Nic Morris" Comment="Updated in line with v2.4 charts (adds mode 5)" Version="10" />

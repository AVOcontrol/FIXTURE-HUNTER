      <Function ID="3" Name="Prism Spin" Display="'Prism Spin'" Dmx="74~127" Update="Prism_Rot" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Prism_Rot" />
      <Function ID="5" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Prism_Rot" />
      <Function ID="6" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Prism_Rot" />
      <Function ID="7" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Prism_Rot" />
      <Function ID="8" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Prism_Rot" />
      <Function ID="9" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Prism_Rot" />
      <Function ID="10" Name="Macro 7" Display="'Macro 7'" Dmx="176~183" Update="Prism_Rot" />
      <Function ID="11" Name="Macro 8" Display="'Macro 8'" Dmx="184~191" Update="Prism_Rot" />
      <Function ID="12" Name="Macro 9" Display="'Macro 9'" Dmx="192~199" Update="Prism_Rot" />
      <Function ID="13" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Prism_Rot" />
      <Function ID="14" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Prism_Rot" />
      <Function ID="15" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" Update="Prism_Rot" />
      <Function ID="16" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" Update="Prism_Rot" />
      <Function ID="17" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" Update="Prism_Rot" />
      <Function ID="18" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Prism_Rot" />
      <Function ID="19" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="6:0" PowerOn="6:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'==3" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~129" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~1" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Light Frost" Display="'Light Frost %.f%%',0~100" Dmx="1~50" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Light Frost Full" Display="'Light Frost Full'" Dmx="51~86" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Heavy Frost" Display="'Heavy Frost %.f%%',0~100" Dmx="87~136" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Heavy Frost Full" Display="'Heavy Frost Full'" Dmx="137~172" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Mixed Frost" Display="'Mixed Frost %.f%%',0~100" Dmx="173~222" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Mixed Frost Full" Display="'Mixed Frost Full'" Dmx="223~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.2f%%',0.00~100.00" Dmx="49087~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.2f%%',0.00~100.00" Dmx="49344~56283" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.2f%%',100.00~0.00" Dmx="56540~63479" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Rnd Op Pls Slow" Display="'Rnd Op Pls Slow'" Dmx="64250~64507" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Rnd Op Pls Fast" Display="'Rnd Op Pls Fast'" Dmx="63736~63993" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Rnd Cl Pls Slow" Display="'Rnd Cl Pls Slow'" Dmx="65278~65535" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Rnd Cl Pls Fast" Display="'Rnd Cl Pls Fast'" Dmx="64764~65021" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_All_Rot" Name="Slice Rotation" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_TL" Name="Slice Up 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_TR" Name="Slice Up 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_BL" Name="Slice Down 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_BR" Name="Slice Down 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_LT" Name="Slice Left 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_LB" Name="Slice Left 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />

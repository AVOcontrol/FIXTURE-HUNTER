  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:14" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:12" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Small Motor">
      <Set Channel="Control:13" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Detection On">
      <Set Channel="Control:2" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Detection Off (Power Off)">
      <Set Channel="Control:3" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Light Source Switch (High Brightness)">
      <Set Channel="Control:4" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Light Source Switch (High Visibility)">

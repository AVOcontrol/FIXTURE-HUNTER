<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IQ250" ShortName="IQ250" Company="NJD">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="21-07-12" Author="Toby Roworth" Comment="Created" />
  <History Date="21-11-12" Author="Peter Budd" Comment="Corrected made shutter HTP" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="1~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="224~224" Intensity="0~0" />
      <Function ID="4" Name="Closed" Display="'Closed'" Dmx="225~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="7" />
      <Function ID="1" Name="Magenta Window" Display="'Magenta Window'" Dmx="0~31" Colour="255,0,255" />
      <Function ID="2" Name="Yellow Ring" Display="'Yellow Ring'" Dmx="32~63" Colour="255,255,0" />
      <Function ID="3" Name="Cyan Dots" Display="'Cyan Dots'" Dmx="64~95" Colour="0,255,255" />
      <Function ID="4" Name="Pink Star" Display="'Pink Star'" Dmx="96~127" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="160~191" Colour="255,0,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="192~223" Colour="0,0,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="4">
    <Import PearlRef="NJD_IQ250" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:8" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6" />
      <Palette ID="3" Name="Yellow Ring" Number="3" Page="1" SetControl="Colour1:2" />
      <Palette ID="4" Name="Yellow Ring" Number="4" Page="1" SetControl="Colour1:2" />
      <Palette ID="5" Name="Yellow Ring" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Cyan Dots" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="8" Name="Cyan Dots" Number="6" Page="1" SetControl="Colour1:3" />
      <Palette ID="9" Name="Cyan Dots" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="11" Name="Magenta Window" Number="9" Page="1" SetControl="Colour1:1" />
      <Palette ID="12" Name="Magenta Window" Number="10" Page="1" SetControl="Colour1:1" />
      <Palette ID="13" Name="Magenta Window" Number="0" Page="1" SetControl="Colour1:1" />
      <Palette ID="14" Name="Pink Star" Number="8" Page="1" SetControl="Colour1:4" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter" />
  </Palettes>
</Fixture>
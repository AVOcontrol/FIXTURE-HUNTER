<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SuperKolor HD" ShortName="SuperKolHD" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>c36c01c0-5f98-4cb0-9ee6-982bb3566468</Thumbnail>
  <History Date="17-02-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="17-02-15" Author="Gab " Comment="Tested" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Increased wheel resolution.  Changed linear dimmer to text only." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed hue and saturation to percentage ranges.  Added macros" />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed effect speed to effect group." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Fixed virtual attribute error in Arc2.  Changed full mode to use cells.  Removed RGBW2 attributes." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Updated RGB power on to locate values." />
  <History Date="25-05-15" Author="Nic Morris" Comment="Changed physical to fixed." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed name from SuperKolorHD to SuperKolor HD.  Standardised.  Corrected channel count in Full mode name." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Added zoom palettes." />
  <History Date="08-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Color Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="4" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="5" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="6" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="8" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="9" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="10" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="11" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="12" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="13" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control1" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="41~50" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~60" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~70" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="71~80" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="81~90" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="91~100" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="101~110" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~120" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~130" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="131~140" />
      <Function ID="12" Name="Program 1" Display="'Program 1'" Dmx="141~150" />
      <Function ID="13" Name="Program 2" Display="'Program 2'" Dmx="151~160" />
      <Function ID="14" Name="Program 3" Display="'Program 3'" Dmx="161~170" />
      <Function ID="15" Name="Program 4" Display="'Program 4'" Dmx="171~180" />
      <Function ID="16" Name="Program 5" Display="'Program 5'" Dmx="181~190" />
      <Function ID="17" Name="Program 6" Display="'Program 6'" Dmx="191~200" />
      <Function ID="18" Name="Program 7" Display="'Program 7'" Dmx="201~210" />
      <Function ID="19" Name="Program 8" Display="'Program 8'" Dmx="211~220" />
      <Function ID="20" Name="Program 9" Display="'Program 9'" Dmx="221~230" />
      <Function ID="21" Name="Program 10" Display="'Program 10'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HeliLED" ShortName="HeliLED" Company="Abstract">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-07-13" Author="Gregory Haynes" Comment="Created" />
  <History Date="11-07-13" Author="Peter Budd" Comment="Completed." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="17-10-17" Author="Nic Morris" Comment="Fixed channel mapping." />
  <History Date="17-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in FAB mode and linked to vdim for compatibility." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="PanFunc" Name="Pan Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed w/ Full Rotation" Display="'Fixed w/ Full Rotation'" Dmx="17~192" Update="Pan" />
      <Function ID="2" Name="Fixed w/out Full Rotation" Display="'Fixed w/out Full Rotation'" Dmx="193~255" Update="Pan" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Pan" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pan" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Fixed" ID="1" If="'PanFunc'==1||'PanFunc'==2" />
      <Condition Name="Scroll" ID="2,3,4,5" If="'PanFunc'==3" />
      <Else ID="6" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~133" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="132~124" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="123~4" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue C-Mix" Display="'Hue C-Mix %.1f%%',0.0~100.0" Dmx="0~223" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="192~255" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="96~127" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="32~95" Intensity="0~0" />
      <Function ID="5" Name="Seq Strobe" Display="'Seq Strobe %.f%%',0~100" Dmx="128~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Spread" Name="Colour Spread" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spread" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Head_Select" Name="Head Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="Head 1" Display="'Head 1'" Dmx="32~32" />
      <Function ID="3" Name="Head 1 &amp; 2" Display="'Head 1 &amp; 2'" Dmx="64~64" />
      <Function ID="4" Name="Head 2" Display="'Head 2'" Dmx="96~96" />
      <Function ID="5" Name="Head 2 &amp; 3" Display="'Head 2 &amp; 3'" Dmx="128~128" />
      <Function ID="6" Name="Head 3" Display="'Head 3'" Dmx="160~160" />
      <Function ID="7" Name="Head 3 &amp; 1" Display="'Head 3 &amp; 1'" Dmx="192~192" />
      <Function ID="8" Name="All" Display="'All'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter 1" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Intensity="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="32~95" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="96~127" Intensity="0~0" />
      <Function ID="4" Name="Seq Strobe" Display="'Seq Strobe %.f%%',0~100" Dmx="128~191" Intensity="0~0" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="192~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />

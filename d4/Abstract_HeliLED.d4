      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100,Red1:1:20,Red2:1:20,Red3:1:20,Green1:1:0,Green2:1:0,Green3:1:0,Blue1:1:100,Blue2:1:100,Blue3:1:100" />

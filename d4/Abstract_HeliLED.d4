  <Mode Name="Rotation, 2 DMX" Channels="2" Hidden="True">
    <Import PearlRef="AB_HELIROT" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="PanFunc" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
    </Include>
  </Mode>
  <Mode Name="FAB, 8 DMX" Channels="8">
    <Import PearlRef="AB_HELIFAB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="PanFunc" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Hue" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Saturation" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Colour_Spread" ChannelOffset="7" Wheel="37" />
      <Attribute ID="Head_Select" ChannelOffset="8" Wheel="26" />
      <Attribute ID="ColourIntensity" ChannelOffset="5" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="NORM, 20 DMX" Channels="20">
    <Import PearlRef="AB_HELINORM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Dimmer1" ChannelOffset="7" Wheel="4" VirtualControl="Dimmer" />
      <Attribute ID="Shutter1" ChannelOffset="8" Wheel="5" />
      <Attribute ID="Dimmer2" ChannelOffset="13" Wheel="6" VirtualControl="Dimmer" />
      <Attribute ID="Shutter2" ChannelOffset="14" Wheel="34" />
      <Attribute ID="Dimmer3" ChannelOffset="19" Wheel="35" VirtualControl="Dimmer" />
      <Attribute ID="Shutter3" ChannelOffset="20" Wheel="36" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="PanFunc" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Red1" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White1" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Red2" ChannelOffset="9" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="10" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="11" Wheel="42" />
      <Attribute ID="White2" ChannelOffset="12" Wheel="39" />
      <Attribute ID="Red3" ChannelOffset="15" Wheel="70" />
      <Attribute ID="Green3" ChannelOffset="16" Wheel="71" />
      <Attribute ID="Blue3" ChannelOffset="17" Wheel="72" />
      <Attribute ID="White3" ChannelOffset="18" Wheel="69" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
        <Attribute ID="PanFunc" ChannelOffset="2" Wheel="25" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="9" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="15" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="6" Hidden="True">

  <History Date="08-10-25" Author="Nic Morris" Comment="Created from Miner Light Laser 15W (poor documentation.  effectively identical)" Version="4" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Colour" Display="'Full Colour'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="10~14" Colour="0,0,255" />
      <Function ID="4" Name="Blue+Magenta" Display="'Blue+Magenta'" Dmx="15~19" Colour="255,255,255" />
      <Function ID="5" Name="Blue+Light Blue" Display="'Blue+Light Blue'" Dmx="20~24" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="25~29" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="30~34" Colour="0,255,0" />
      <Function ID="8" Name="Colour Effect" Display="'Colour Effect %.1f%%',0.0~100.0" Dmx="35~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~10" Colour="0,0,0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CUE_Groups" Name="CUE Groups" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CUE_Select" Name="CUE Select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto_Zoom" Name="Auto Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Zoom In" Display="'Zoom In'" Dmx="0~0" />
      <Function ID="2" Name="Auto Zoom Out" Display="'Auto Zoom Out %.f%%',0~100" Dmx="16~55" />
      <Function ID="3" Name="Auto Zoom In" Display="'Auto Zoom In %.f%%',0~100" Dmx="56~95" />
      <Function ID="4" Name="Auto Zoom In/Out" Display="'Auto Zoom In/Out %.f%%',0~100" Dmx="96~135" />
      <Function ID="5" Name="Irregular Zoom In/Out" Display="'Irregular Zoom In/Out %.f%%',0~100" Dmx="136~175" />
      <Function ID="6" Name="X Y Irregular Zoom In/Out Mode 1" Display="'X Y Irregular Zoom In/Out Mode 1 %.f%%',0~100" Dmx="176~215" />
      <Function ID="7" Name="X Y Irregular Zoom In/Out Mode 2" Display="'X Y Irregular Zoom In/Out Mode 2 %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Twist_Effect" Name="Twist Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Twist Effect Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Draw_Mode" Name="Draw Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Drawing" Display="'No Drawing'" Dmx="0~0" />
      <Function ID="2" Name="Manual 1" Display="'Manual 1'" Dmx="2~63" />
      <Function ID="3" Name="Manual 2" Display="'Manual 2'" Dmx="64~127" />
      <Function ID="4" Name="Add" Display="'Add'" Dmx="128~153" />
      <Function ID="5" Name="Subtraction" Display="'Subtraction'" Dmx="154~179" />
      <Function ID="6" Name="Auto Gradient 1" Display="'Auto Gradient 1'" Dmx="180~205" />
      <Function ID="7" Name="Auto Gradient 2" Display="'Auto Gradient 2'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Macro_CUE" Name="Macro CUE" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro CUE Show" Display="'Macro CUE Show %.1f%%',0.0~100.0" Dmx="2~253" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="CUE_Speed" Name="CUE Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
  </Control>

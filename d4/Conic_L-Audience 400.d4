      <Function ID="13" Name="Jump 12" Display="'Jump 12'" Dmx="156~169" />
      <Function ID="14" Name="Fader 1" Display="'Fader 1'" Dmx="170~185" />
      <Function ID="15" Name="Fader 2" Display="'Fader 2'" Dmx="186~200" />
      <Function ID="16" Name="Fader 3" Display="'Fader 3'" Dmx="201~215" />
      <Function ID="17" Name="Strobe" Display="'Strobe'" Dmx="216~230" />
      <Function ID="18" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="231~255" />

  <Macro>
    <Macro Name="Reset">
      <Set Channel="Dimmer:5" Delay="6000" />
      <Set Channel="Dimmer:1:100" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Dimmer:6,Gobo1Func:3,Gobo1:19,Gobo1Shake:4:100" Delay="6000" />
    </Macro>
  </Macro>
  <Palettes>

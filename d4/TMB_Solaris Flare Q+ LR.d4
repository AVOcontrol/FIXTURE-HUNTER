  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7b5271f0-1439-4ecf-8b3e-2f3bd5609022" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'Duration %.fms',0~650" Dmx="0~254" Intensity="0~0" />
      <Function ID="2" Name="Hyper" Display="'Hyper'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Flash" Display="'No Flash'" Dmx="0~0" />
      <Function ID="2" Name="Rate" Display="'Rate %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Strobe_FX" Name="Strobe FX" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Wash" Display="'Wash'" Dmx="5~5" />
      <Function ID="3" Name="RampUp" Display="'RampUp'" Dmx="6~42" />
      <Function ID="4" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="5" Name="Ramp Up-Down" Display="'Ramp Up-Down'" Dmx="86~128" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="7" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="8" Name="Spikes" Display="'Spikes'" Dmx="215~240" />
      <Function ID="9" Name="Burst" Display="'Burst'" Dmx="241~245" />
      <Function ID="10" Name="Meltdown (Rnd Pix w/ Solid BG)" Display="'Meltdown (Rnd Pix w/ Solid BG)'" Dmx="246~250" />
      <Function ID="11" Name="Meltdown (Rnd Pix w/ Burst BG)" Display="'Meltdown (Rnd Pix w/ Burst BG)'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Strobe_Int" Name="Strobe Int" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red_Strobe" Name="Red Strobe" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Strobe" Name="Green Strobe" Description="" Group="C">

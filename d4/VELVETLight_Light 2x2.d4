  <Control>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:3222" PowerOn="1:3222" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

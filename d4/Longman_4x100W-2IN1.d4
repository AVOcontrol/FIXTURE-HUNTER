<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="4x100W-2IN1" ShortName="4x100W" Company="Longman">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="26-06-18" Author="Nic Morris" Comment="Created (poor documentation - auto function ranges missing and don't divide - guessed)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~35" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="36~56" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="57~77" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="78~98" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="99~119" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="121~135" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="136~150" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="151~168" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="169~186" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="187~204" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="205~222" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="226~240" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
        <Attribute ID="ColdWhite" Wheel="7" />
        <Attribute ID="WarmWhite" Wheel="8" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="11" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="LO4X1006" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

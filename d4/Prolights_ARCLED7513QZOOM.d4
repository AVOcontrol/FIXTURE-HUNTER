  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ea5cf952-21af-467f-9fc0-a664a8111da1" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Custom" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Custom" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" Update="Red, Green" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~40" Update="Red, Green" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="41~50" Update="Red, Green" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~60" Update="Red, Green" />

      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="218~232" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="233~247" />
      <Function ID="18" Name="Stand-Alone" Display="'Stand-Alone'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Auto_Speed" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />

      <Function ID="10" Name="Cinelux" Display="'Cinelux'" Dmx="151~200" Update="Gel" Colour="255,255,255" />
      <Function ID="11" Name="Reserved" Display="'Reserved'" Dmx="201~255" Update="Gel" Colour="255,255,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gel" Colour="0,0,0" />
    </Attribute>

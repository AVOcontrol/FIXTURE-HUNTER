      <Function ID="5" Name="Cosmetic" Display="'Cosmetic'" Dmx="151~200" Update="Gel" Colour="255,255,255" />
      <Function ID="6" Name="700 Series" Display="'700 Series'" Dmx="201~255" Update="Gel" Colour="255,255,255" />
      <Function ID="7" Name="Col Correct" Display="'Col Correct'" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="8" Name="Cal Colour" Display="'Cal Colour'" Dmx="51~100" Update="Gel" Colour="255,255,255" />

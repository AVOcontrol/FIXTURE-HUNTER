    <Attribute ID="Gel_Brand" Name="Gel Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Gel_Category" Colour="255,255,255" />
      <Function ID="2" Name="LEE" Display="'LEE'" Dmx="1~50" Update="Gel_Category" Colour="255,255,255" />
      <Function ID="3" Name="Rosco" Display="'Rosco'" Dmx="51~100" Update="Gel_Category" Colour="255,255,255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gel_Category" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel_Category" Name="Gel Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Gel_Brand'==1" />
      <Condition Name="LEE" ID="2,3,4,5,6" If="'Gel_Brand'==2" />
      <Condition Name="Rosco" ID="7,8,9,10,11" If="'Gel_Brand'==3" />
      <Else ID="12" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Gel" Colour="255,255,255" />
      <Function ID="2" Name="Col Correct" Display="'Col Correct'" Dmx="0~0" Update="Gel" Colour="255,255,255" />

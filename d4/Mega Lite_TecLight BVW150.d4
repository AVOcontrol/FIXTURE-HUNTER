    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd All" Display="'Rnd All %.f%%',0~100" Dmx="150~199" />
      <Function ID="4" Name="Rnd Segment" Display="'Rnd Segment %.f%%',0~100" Dmx="200~255" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="100~149" />
    </Attribute>
  </Control>

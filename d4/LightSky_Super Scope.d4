      <Function ID="8" Name="Dark Blue" Display="'Dark Blue'" Dmx="160~169" Colour="0,0,180" />
      <Function ID="9" Name="CRI" Display="'CRI'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="10" Name="Index" Display="'%.f%%',0~100" Dmx="0~89" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VK200 COB" ShortName="VK200 COB" Company="Viking Lighting">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-06-17" Author="Nic Morris" Comment="Created" />
  <History Date="22-06-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="443ef052-9226-4d86-ada2-a3045ad7031a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Prog 1 (CC)" Display="'Prog 1 (CC)'" Dmx="51~100" />
      <Function ID="3" Name="Prog 2 (CP)" Display="'Prog 2 (CP)'" Dmx="101~150" />
      <Function ID="4" Name="Prog 3 (DE)" Display="'Prog 3 (DE)'" Dmx="151~200" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 2 DMX" Channels="2">
    <Import PearlRef="UKVK200B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b741eb3f-5409-4fd9-80db-757b4ad71cee" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Full, 6 DMX" Channels="6">
    <Import PearlRef="UKVK200F" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ca438928-2706-46bd-a211-bad2a644c957" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
      <Attribute ID="WarmWhite" ChannelOffset="5" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="6" Wheel="8" />
    </Include>
  </Mode>
</Fixture>
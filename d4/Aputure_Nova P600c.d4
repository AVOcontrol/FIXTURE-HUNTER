    <Attribute ID="Effect1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1" />
      <Condition Name="Club Lights" ID="2,3,4,5,6,7,8,9" If="'FX_Sel'==1" />
      <Condition Name="Paparazzi" ID="10" If="'FX_Sel'==2" />
      <Condition Name="Lightning" ID="11" If="'FX_Sel'==3" />
      <Condition Name="TV" ID="12,13,14" If="'FX_Sel'==4" />
      <Condition Name="Candle" ID="15,16,17" If="'FX_Sel'==5" />
      <Condition Name="Fire" ID="18,19,20" If="'FX_Sel'==6" />
      <Condition Name="Strobe" ID="21,22,23,24,25,26" If="'FX_Sel'==7" />
      <Condition Name="Explosion" ID="27,28,29,30,31,32" If="'FX_Sel'==8" />
      <Condition Name="Faulty Bulb" ID="33,34,35,36,37,38" If="'FX_Sel'==9" />
      <Condition Name="Pulsing" ID="39,40,41,42,43,44" If="'FX_Sel'==10" />
      <Condition Name="Welding" ID="45,46,47,48,49,50" If="'FX_Sel'==11" />
      <Condition Name="Cop Car" ID="51,52,53,54,55" If="'FX_Sel'==12" />
      <Condition Name="Color Chase" ID="56" If="'FX_Sel'==13" />
      <Condition Name="Party Lights" ID="57" If="'FX_Sel'==14" />

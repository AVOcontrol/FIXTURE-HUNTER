      <Function ID="2" Name="Paparazzi" Display="'Paparazzi'" Dmx="10~19" Update="Effect1, Effect2, Effect3, Effect4, Effect5, Effect9, Effect13, Effect17, Effect18, Effect19, Effect10, Effect11" />

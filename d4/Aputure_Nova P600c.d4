    <Attribute ID="Mode" Name="Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT+RGB" Display="'CCT+RGB'" Dmx="0~0" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="2" Name="CCT" Display="'CCT'" Dmx="10~19" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="3" Name="CCT+HSI" Display="'CCT+HSI'" Dmx="20~29" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="4" Name="RGB" Display="'RGB'" Dmx="30~39" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="5" Name="HSI" Display="'HSI'" Dmx="40~49" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="6" Name="Gel" Display="'Gel'" Dmx="50~59" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="7" Name="XY" Display="'XY'" Dmx="60~69" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="8" Name="Source" Display="'Source'" Dmx="70~79" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="9" Name="FX" Display="'FX'" Dmx="80~89" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="255,255,255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Param_1, Param_2, Param_3, Param_4, Param_5, Param_6, Param_7" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Param_1" Name="Param 1" Description="" Group="C">
      <Locate Locate="2:2000" PowerOn="2:2000" />
      <Else ID="1" />
      <Condition Name="CCT+RGB" ID="2" If="'Mode'==1" />
      <Condition Name="CCT" ID="3" If="'Mode'==2" />
      <Condition Name="CCT+HSI" ID="4" If="'Mode'==3" />
      <Condition Name="RGB" ID="5" If="'Mode'==4" />
      <Condition Name="HSI" ID="6" If="'Mode'==5" />

    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="51~90" Colour="255,255,255" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="91~130" Colour="255,255,255" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="131~170" Colour="255,255,255" />

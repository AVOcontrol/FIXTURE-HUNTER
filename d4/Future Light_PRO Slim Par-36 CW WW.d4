<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PRO Slim Par-36 CW/WW" ShortName="FLPSPar-36" Company="Future Light">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="28-08-13" Author="Matt Benson" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WhiteWarm" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Warm C-Mix" Display="'Warm C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WhiteCold" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Cold C-Mix" Display="'Cold C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="InternalProg" Name="Internal Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No function" Display="'No function'" Dmx="0~0" />
      <Function ID="2" Name="Internal Program 1" Display="'Internal Program 1'" Dmx="52~101" />
      <Function ID="3" Name="Internal Program 2" Display="'Internal Program 2'" Dmx="102~153" />
      <Function ID="4" Name="Internal Program 3" Display="'Internal Program 3'" Dmx="154~203" />
      <Function ID="5" Name="Internal Program 4" Display="'Internal Program 4'" Dmx="204~254" />
      <Function ID="6" Name="Internal Program 5" Display="'Internal Program 5'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="ProgSpeed" Name="Program Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control2" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Control Board" Display="'Control Board'" Dmx="0~0" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="51~101" />
      <Function ID="3" Name="Speed 1" Display="'Speed 1'" Dmx="102~152" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="153~203" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="204~254" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX, 8bit" Channels="7">
    <Import PearlRef="FU_PSl36CW7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="WhiteWarm" ChannelOffset="2" Wheel="11" />
      <Attribute ID="WhiteCold" ChannelOffset="3" Wheel="12" />
      <Attribute ID="InternalProg" ChannelOffset="5" Wheel="22" />
      <Attribute ID="ProgSpeed" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Control2" ChannelOffset="7" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="FU_PSl36CW4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="WhiteWarm" ChannelOffset="2" Wheel="11" />
      <Attribute ID="WhiteCold" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="FU_PSl36CW3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WhiteWarm" ChannelOffset="2" Wheel="11" />
      <Attribute ID="WhiteCold" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="FU_PSl36CW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WhiteWarm" ChannelOffset="1" Wheel="11" />
      <Attribute ID="WhiteCold" ChannelOffset="2" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
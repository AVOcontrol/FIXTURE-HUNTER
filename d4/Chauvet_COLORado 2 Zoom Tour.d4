<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORado 2 Zoom Tour" ShortName="CR 2 ZmTr" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Fixed power on and locate.  Changed HSV attribute groups." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Simplified conditional statements.  Fixed shutter palettes." />
  <History Date="20-04-11" Author="Nic Morris" Comment="Increased wheel resolutions.  Added missing IDs to ID Address" />
  <History Date="20-04-11" Author="Nic Morris" Comment="Added virtual dimmers." />
  <History Date="03-05-11" Author="Nic Morris" Comment="Adapted from COLORado 2 Tour.  Erm.  Maybe I meant COLORado 1 Tour?" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Removed Value and replaced with Dimmer for HTP" />
  <History Date="12-01-12" Author="Peter Budd" Comment="Created from COLORado 2 Tour" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="21-08-16" Author="Nic Morris" Comment="Revised channel count in Tour mode name (was Tour, 11 DMX)" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from COLORado 2 ZoomTour to COLORado 2 Zoom Tour" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Revised colour macro (removed 'high power' function and adjusted index range)." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Removed ID attribute (unused).  Revised mode names.  Added zoom palettes." />
  <History Date="19-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="29a56077-5e09-425c-a2df-2e996cfa012b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="6" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="7" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="8" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="9" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="10" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="11" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="12" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="13" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="14" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="21~30" Update="Red, Green" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~40" Update="Red, Green" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="41~50" Update="Red, Green" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="51~60" Update="Red, Green" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="61~70" Update="Red, Green" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="71~80" Update="Red, Green" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="81~90" Update="Red, Green" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="91~100" Update="Red, Green" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="101~110" Update="Red, Green" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="111~120" Update="Red, Green" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" Update="Red, Green" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" Update="Red, Green" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" Update="Red, Green" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" Update="Red, Green" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" Update="Red, Green" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" Update="Red, Green" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" Update="Red, Green" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" Update="Red, Green" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" Update="Red, Green" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="TOUR, 12 DMX" Channels="12">
    <Import PearlRef="CH_C2T_T11" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="82cf7b13-99a5-415d-8860-ebd6c9474e93" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />

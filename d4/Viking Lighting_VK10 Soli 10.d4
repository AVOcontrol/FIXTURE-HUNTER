    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro %.f%%',0~100" Dmx="5~80" Colour="255,255,255" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="81~150" Colour="255,255,255" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="151~220" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
  </Control>

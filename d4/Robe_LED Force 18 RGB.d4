  <History Date="21-04-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1ab889d1-f923-4678-8de1-9ef6cdc9ca6f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Join" ID="2,3" If="'Control'==2||'Control'==3||'Control'==4" />
      <Condition Name="No Function" ID="4" If="'Control'&gt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="3" Name="Join In" Display="'Join In %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,255,255" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Join" ID="2,3" If="'Control'==2||'Control'==3||'Control'==4" />
      <Condition Name="No Function" ID="4" If="'Control'&gt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="3" Name="Join In" Display="'Join In %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,255,255" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Join" ID="2,3" If="'Control'==2||'Control'==3||'Control'==4" />
      <Condition Name="No Function" ID="4" If="'Control'&gt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="3" Name="Join In" Display="'Join In %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,255,255" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="3" If="'Control'&gt;4" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="14~255" Colour="255,255,255" />
      <Function ID="3" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Control'&gt;4&amp;&amp;'Control'&lt;8" />
      <Condition Name="No Function" ID="4" If="'Control'==8" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="0~0" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="2" Name="Light Mode" Display="'Light Mode'" Dmx="36~71" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="3" Name="Dim Mode" Display="'Dim Mode'" Dmx="72~107" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="4" Name="Dim + Light Mode" Display="'Dim + Light Mode'" Dmx="108~143" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="5" Name="Auto Mix Colour" Display="'Auto Mix Colour'" Dmx="144~179" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="6" Name="3 Col Strobe" Display="'3 Col Strobe'" Dmx="180~215" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="7" Name="7 Col Strobe" Display="'7 Col Strobe'" Dmx="216~251" Update="Red, Green, Blue, Colour_Macro, Shutter" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Red, Green, Blue, Colour_Macro, Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Macro" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="1">
    <Import PearlRef="RO4CE181" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

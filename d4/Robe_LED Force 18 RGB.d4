      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f9437918-5132-4a2c-808e-0e9bae6cb3d4" />
    <Include>
      <Attribute ID="Macro" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="Mode 2" Channels="2">

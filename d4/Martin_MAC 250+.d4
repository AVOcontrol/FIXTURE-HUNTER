      </Function>
      <Function ID="10" Name="Open" Display="'Open'" Dmx="45~49" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>dbf68766-c1c6-44c6-b19b-4c385413fb53</Swatch>
      </Function>
      <Function ID="11" Name="1 (Radial Dashes)" Display="'1 (Radial Dashes)'" Dmx="50~54" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>fd368db9-136b-45bc-8acc-60982cfdb948</Swatch>

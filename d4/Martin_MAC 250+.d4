        <Swatch>91cd4793-b9cb-4927-8dd5-c19abe6982c9</Swatch>
      </Function>
      <Function ID="27" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="90~104" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0">

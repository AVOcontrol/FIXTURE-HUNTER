      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="87~93" WheelPosition="12" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="15" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="94~101" WheelPosition="1" />
      <Function ID="16" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="102~109" WheelPosition="2" />
      <Function ID="17" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="110~117" WheelPosition="3" />

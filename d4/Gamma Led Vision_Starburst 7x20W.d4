      <Function ID="2" Name="Col Choose" Display="'Col Choose'" Dmx="51~100" />
      <Function ID="3" Name="Col Change" Display="'Col Change'" Dmx="101~150" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="151~200" />
      <Function ID="5" Name="Col Pulse" Display="'Col Pulse'" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

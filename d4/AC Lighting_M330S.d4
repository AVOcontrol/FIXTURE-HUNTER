    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" Colour="255,255,255" />
      <Function ID="2" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="4~195" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="196~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fire" Display="'Fire %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Anim_Rot" Name="Animation Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="4~97" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="98~191" />
      <Function ID="4" Name="Swing 1.8" Display="'Swing 1.8 %.f%%',0~100" Dmx="192~207" />
      <Function ID="5" Name="Swing 7.2" Display="'Swing 7.2 %.f%%',0~100" Dmx="208~223" />
      <Function ID="6" Name="Swing 28.8" Display="'Swing 28.8 %.f%%',0~100" Dmx="224~239" />
      <Function ID="7" Name="Swing 57.6" Display="'Swing 57.6 %.f%%',0~100" Dmx="240~255" />
    </Attribute>
  </Control>

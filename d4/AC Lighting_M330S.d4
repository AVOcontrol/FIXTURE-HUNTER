    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5,6,7,8" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="5,9" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~16191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="16448~32639" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="19d051ca-4ef9-411c-be1c-73d0ceb1de90" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~5" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~21" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="22~27" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="28~33" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="34~39" Colour="255,255,255" />
      <Function ID="8" Name="R+B" Display="'R+B'" Dmx="40~45" Colour="255,255,255" />
      <Function ID="9" Name="R+G" Display="'R+G'" Dmx="46~51" Colour="255,255,255" />
      <Function ID="10" Name="R+W" Display="'R+W'" Dmx="52~57" Colour="255,255,255" />
      <Function ID="11" Name="R+A" Display="'R+A'" Dmx="58~63" Colour="255,255,255" />
      <Function ID="12" Name="G+W" Display="'G+W'" Dmx="64~69" Colour="255,255,255" />
      <Function ID="13" Name="G+A" Display="'G+A'" Dmx="70~75" Colour="255,255,255" />
      <Function ID="14" Name="B+W" Display="'B+W'" Dmx="76~81" Colour="255,255,255" />
      <Function ID="15" Name="B+A" Display="'B+A'" Dmx="82~87" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="88~93" Colour="255,255,255" />
      <Function ID="17" Name="Auto 1" Display="'Auto 1'" Dmx="94~123" Colour="255,255,255" />
      <Function ID="18" Name="Auto 2" Display="'Auto 2'" Dmx="124~185" Colour="255,255,255" />
      <Function ID="19" Name="Auto 3" Display="'Auto 3'" Dmx="186~218" Colour="255,255,255" />
      <Function ID="20" Name="Auto 4" Display="'Auto 4'" Dmx="219~250" Colour="255,255,255" />
      <Function ID="21" Name="Sound no SMD" Display="'Sound no SMD'" Dmx="251~254" Colour="255,255,255" />
      <Function ID="22" Name="Sound w/SMD" Display="'Sound w/SMD'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Side_Lenses" Name="Side Lenses" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="5~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Middle_SMD" Name="Middle SMD" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~15" />
      <Function ID="2" Name="Auto Slow" Display="'Auto Slow'" Dmx="16~89" />
      <Function ID="3" Name="Auto Medium" Display="'Auto Medium'" Dmx="90~164" />
      <Function ID="4" Name="Auto Fast" Display="'Auto Fast'" Dmx="165~240" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="PGRADST5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ac1ef82e-5ff8-445d-8c64-cfa29e2096b1" />
    <Include>
      <Attribute ID="Side_Lenses" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Middle_SMD" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Rotation" ChannelOffset="4" Wheel="15" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="PGRADST2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4a9ac201-6309-4f39-afc4-eea3802e8f22" />
    <Include>
      <Attribute ID="Shutter2" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
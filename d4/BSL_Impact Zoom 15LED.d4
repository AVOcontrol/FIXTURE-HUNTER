<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Impact Zoom 15LED" ShortName="Imp Zm 15" Company="BSL">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-02-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="24-07-17" Author="Nic Morris" Comment="Fixed missing segment condition in dimmer." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="304626e7-8272-437c-83ff-b7811eadd509" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FWD" Display="'Pulse FWD'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Segment" ID="2" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="Segment" Display="'Segment'" Dmx="112~127" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1, Colour2, Red, Green, Blue, White, Dimmer" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="13:0" PowerOn="13:0" />
      <Condition Name="CTC" ID="1,2,3,4,5" If="'Colour1Func'==2" />
      <Condition Name="Speed" ID="6" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="7,8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Condition Name="Segment" ID="14" If="'Colour1Func'==7" />
      <Else ID="13" />
      <Function ID="1" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="5" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="7" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="14" Name="Chaser" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Segment" ID="7" If="'Colour1Func'==7" />
      <Else ID="1,2,3,4,5,6" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="7" Name="Segment A" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Segment" ID="2" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Segment B" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Segment" ID="2" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Segment C" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Segment" ID="2" If="'Colour1Func'==7" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Segment D" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">

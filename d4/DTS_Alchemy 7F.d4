<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alchemy 7F" ShortName="Alchemy 7F" Company="DTS" Version="5">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>aa5a3de4-ec3a-4919-b0dc-b4d2b73d83b4</Thumbnail>
  <History Date="10-06-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="18-09-19" Author="Nic Morris" Comment="Added CMY Emulation mode in line with latest charts in response to manufacturer request." Version="2" />
  <History Date="19-09-19" Author="Nic Morris" Comment="Added Atlabase ID to CMY Emulation mode." Version="3" />
  <History Date="14-09-22" Author="Nic Morris" Comment="Created from DTS Alchemy 5 (some ranges and details such as gel library are missing - assumed identical)" Version="4" />
  <History Date="14-09-22" Author="Nic Morris" Comment="(note documentation refers to an 'Alchemy 7' and 'Alchemy 7F' in various places, notably including RDM model ID's)" Version="5" />
  <History Date="14-09-22" Author="Nic Morris" Comment="(also the charts all suggest two different channel counts for each mode, although the lower of the two is not explained anywhere.  the implication is the 'F' does not have the framing system/controls but the website just details one model)" Version="5" />

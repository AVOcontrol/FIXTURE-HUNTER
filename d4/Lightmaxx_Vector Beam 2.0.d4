      <Function ID="22" Name="L Grn/ Yel" Display="'L Grn/ Yel'" Dmx="104~109" WheelPosition="8" Colour="0,255,50" />
      <Function ID="23" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="116~121" WheelPosition="9" Colour="255,255,0" />
      <Function ID="24" Name="Blu/ CTO" Display="'Blu/ CTO'" Dmx="128~133" WheelPosition="10" Colour="0,0,255" />

  <AtlaBase TypeID="d892b23d-1d73-4b64-9190-78870eae9ba8" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Mode" Name="Beam Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" />
      <Function ID="2" Name="Strobe Mode 1" Display="'Strobe Mode 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Strobe Mode 2" Display="'Strobe Mode 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Strobe Mode 3" Display="'Strobe Mode 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Strobe Mode 4" Display="'Strobe Mode 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Strobe Mode 5" Display="'Strobe Mode 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Strobe Mode 6" Display="'Strobe Mode 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Beam_Duration" Name="Beam Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.2f Sec',0.00~3.00" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Macro" Name="Beam Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="16~57" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="58~99" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="100~141" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="142~183" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="184~225" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Plate_Shutter" Name="Plate Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

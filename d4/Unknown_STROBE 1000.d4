  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Mode" Name="Strobe Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe'" Dmx="3~5" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="6~50" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse'" Dmx="51~100" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse'" Dmx="101~150" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="151~200" />
      <Function ID="7" Name="Lightning" Display="'Lightning'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">

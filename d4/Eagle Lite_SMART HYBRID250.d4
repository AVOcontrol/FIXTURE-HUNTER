    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="4~123" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="188~191" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="124~187" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="5m" Display="'5m'" Dmx="4~63" />
      <Function ID="3" Name="7.5m" Display="'7.5m'" Dmx="64~127" />
      <Function ID="4" Name="10m" Display="'10m'" Dmx="128~191" />
      <Function ID="5" Name="15m" Display="'15m'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="20~29" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~39" />
      <Function ID="4" Name="Reset Col/Gobo" Display="'Reset Col/Gobo'" Dmx="40~49" />
      <Function ID="5" Name="Reset Zoom/Focus/Prism/Frost" Display="'Reset Zoom/Focus/Prism/Frost'" Dmx="50~59" />
      <Function ID="6" Name="Display Default" Display="'Display Default'" Dmx="70~74" />
      <Function ID="7" Name="Display Off" Display="'Display Off'" Dmx="75~79" />
      <Function ID="8" Name="Display On" Display="'Display On'" Dmx="80~84" />
      <Function ID="9" Name="Fan Quiet" Display="'Fan Quiet'" Dmx="85~89" />
      <Function ID="10" Name="Fan Med" Display="'Fan Med'" Dmx="90~94" />
      <Function ID="11" Name="Fan High" Display="'Fan High'" Dmx="95~99" />
    </Attribute>
  </Control>

      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="181~184" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="111~180" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="181~184" />

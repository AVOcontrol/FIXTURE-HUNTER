  <History Date="22-01-18" Author="Nic Morris" Comment="Created (very poor documentation - note there are 2 dimmers which makes no sense and is almost certainly wrong.  2nd dimmer will be LTP)" />
  <History Date="26-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d4fe846d-5544-40cd-8ec2-182940895b30" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="3~252" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="5~9" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="10~14" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="15~19" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~24" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="25~29" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="30~34" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="35~39" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Blu" Display="'Op/ Blu'" Dmx="40~44" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Blu/ Rd" Display="'Blu/ Rd'" Dmx="45~49" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="50~54" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="55~59" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="60~64" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Mag/ D Blu" Display="'Mag/ D Blu'" Dmx="65~69" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="D Blu/ Pk" Display="'D Blu/ Pk'" Dmx="70~74" WheelPosition="6" Colour="0,0,180" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="75~79" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="170~174" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="80~169" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="170~174" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="175~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" />

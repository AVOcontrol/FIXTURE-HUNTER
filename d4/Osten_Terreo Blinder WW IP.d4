  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="02a85350-51e6-4beb-ba14-81c1da146fe5" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="250~250" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" />
      <Function ID="11" Name="Sine Wave" Display="'Sine Wave %.f%%',0~100" Dmx="224~210" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~510" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="102~152" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="153~203" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Dim_Response" Name="Dim Response" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Fast (LED)" Display="'Fast (LED)'" Dmx="64~127" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="128~191" />
      <Function ID="4" Name="Slow (Halogen)" Display="'Slow (Halogen)'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="85~170" />
      <Function ID="3" Name="On" Display="'On'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="41~83" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="84~126" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="127~169" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="170~212" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="213~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display On" Display="'Display On'" Dmx="30~34" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="35~39" />
      <Function ID="4" Name="No DMX Blackout" Display="'No DMX Blackout'" Dmx="45~49" />
      <Function ID="5" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="50~54" />
      <Function ID="6" Name="No DMX Emergency Light" Display="'No DMX Emergency Light'" Dmx="55~59" />
      <Function ID="7" Name="RAW" Display="'RAW'" Dmx="65~69" />
      <Function ID="8" Name="User Cal" Display="'User Cal'" Dmx="70~74" />
      <Function ID="9" Name="LED Freq 800Hz" Display="'LED Freq 800Hz'" Dmx="80~84" />

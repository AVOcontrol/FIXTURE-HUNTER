      <Function ID="12" Name="LED Freq 3600Hz" Display="'LED Freq 3600Hz'" Dmx="95~99" />
      <Function ID="13" Name="LED Freq 12kHz" Display="'LED Freq 12kHz'" Dmx="100~104" />
      <Function ID="14" Name="LED Freq 25kHz" Display="'LED Freq 25kHz'" Dmx="105~109" />
      <Function ID="15" Name="Fan Auto" Display="'Fan Auto'" Dmx="115~119" />
      <Function ID="16" Name="Fan Silent" Display="'Fan Silent'" Dmx="120~124" />
      <Function ID="17" Name="Fan Off" Display="'Fan Off'" Dmx="125~129" />
      <Function ID="18" Name="Fan High" Display="'Fan High'" Dmx="130~134" />
      <Function ID="19" Name="Mapping Invert Off" Display="'Mapping Invert Off'" Dmx="140~144" />
      <Function ID="20" Name="Mapping Invert On" Display="'Mapping Invert On'" Dmx="145~149" />
      <Function ID="21" Name="LED Mode Illumination" Display="'LED Mode Illumination'" Dmx="155~159" />
      <Function ID="22" Name="LED Mode Boost" Display="'LED Mode Boost'" Dmx="160~164" />
      <Function ID="23" Name="Factory Reset" Display="'Factory Reset'" Dmx="170~174" />
      <Function ID="24" Name="User Reset" Display="'User Reset'" Dmx="175~179" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

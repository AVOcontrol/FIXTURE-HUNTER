<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SL Punchlite 220" ShortName="Punch 220" Company="Philips">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-02-13" Author="Peter Budd" Comment="Created" />
  <History Date="13-02-13" Author="Peter Budd" Comment="Created from Philips SL Bar 640" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-07-13" Author="Peter Budd" Comment="Added simple mode and updated shutter range." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed channel mapping error in 6 group, 8 bit mode." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed simple, 8 bit mode channel mapping.  Added simple group modes." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed channel mapping errors for all HSIC modes." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed Control PL Curve range.  Increased wheel resolution for all 16 bit colour attributes." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Fixed palettes.  Added macros." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Renamed random colour scroll function and reversed range." />
  <History Date="24-01-14" Author="Nic Morris" Comment="Inverted timing wheel direction.  Renamed shutter functions to differentiate between open and close pulse ranges." />
  <History Date="09-11-14" Author="Nic Morris" Comment="Created from Philips SL BAR 520" />
  <History Date="04-04-15" Author="Nic Morris" Comment="Created from Philips SL Bar 510 RGBW" />
  <History Date="26-04-15" Author="Nic Morris" Comment="Fixed duplicate channel mapping in 3 Group HSIC compatibility in response to auto gen bug report." />
  <History Date="25-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="26-11-16" Author="Nic Morris" Comment="Aligned functions with other fixtures in range." />
  <History Date="16-12-17" Author="Nic Morris" Comment="Changed intensity attribute ID to ColourIntensity for compatibility." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="20545" />
  </RDM>
  <AtlaBase TypeID="e55f84a4-3c03-4cdd-a63d-6933e14b9223" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">

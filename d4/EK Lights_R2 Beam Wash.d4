      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~6" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Pattern_Trans" Name="Pattern Trans" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Transition" Display="'%.fms',100~5000" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Wake" Display="'Wake %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="6~7" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="8~9" />
      <Function ID="4" Name="Pan Invert" Display="'Pan Invert'" Dmx="42~43" />
      <Function ID="5" Name="Pan Normal" Display="'Pan Normal'" Dmx="44~45" />
      <Function ID="6" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="46~47" />
      <Function ID="7" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="48~49" />
      <Function ID="8" Name="Dim LED" Display="'Dim LED'" Dmx="74~75" />
      <Function ID="9" Name="Dim Halogen" Display="'Dim Halogen'" Dmx="76~77" />
      <Function ID="10" Name="Fan Silent" Display="'Fan Silent'" Dmx="98~99" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="100~101" />
      <Function ID="12" Name="LED Freq 800Hz" Display="'LED Freq 800Hz'" Dmx="120~121" />
      <Function ID="13" Name="LED Freq 1200Hz" Display="'LED Freq 1200Hz'" Dmx="122~123" />
      <Function ID="14" Name="LED Freq 2000Hz" Display="'LED Freq 2000Hz'" Dmx="124~125" />
      <Function ID="15" Name="LED Freq 3600Hz" Display="'LED Freq 3600Hz'" Dmx="126~127" />
      <Function ID="16" Name="LED Freq 12KHz" Display="'LED Freq 12KHz'" Dmx="128~129" />
      <Function ID="17" Name="LED Freq 25KHz" Display="'LED Freq 25KHz'" Dmx="130~131" />
      <Function ID="18" Name="Display On" Display="'Display On'" Dmx="140~141" />
      <Function ID="19" Name="Display Off" Display="'Display Off'" Dmx="142~143" />
      <Function ID="20" Name="LED Dir Normal" Display="'LED Dir Normal'" Dmx="160~161" />
      <Function ID="21" Name="LED Dir Mirrored" Display="'LED Dir Mirrored'" Dmx="162~163" />
      <Function ID="22" Name="Dim Linear" Display="'Dim Linear'" Dmx="164~165" />
      <Function ID="23" Name="Dim Exponential" Display="'Dim Exponential'" Dmx="166~167" />
      <Function ID="24" Name="Dim Logarithmic" Display="'Dim Logarithmic'" Dmx="168~169" />
      <Function ID="25" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="170~171" />
      <Function ID="26" Name="RAW Mode" Display="'RAW Mode'" Dmx="202~203" />
      <Function ID="27" Name="User Cal" Display="'User Cal'" Dmx="204~205" />
      <Function ID="28" Name="Factory Cal" Display="'Factory Cal'" Dmx="206~207" />
      <Function ID="29" Name="Reset P/T" Display="'Reset P/T'" Dmx="222~223" />
      <Function ID="30" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="228~229" />
      <Function ID="31" Name="Reset All" Display="'Reset All'" Dmx="236~237" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pattern1" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Pattern" Display="'No Pattern'" Dmx="0~0" />
      <Function ID="2" Name="1 (Cross CW)" Display="'1 (Cross CW)'" Dmx="6~10" />
      <Function ID="3" Name="2 (Circ 2 Step In&gt;Out)" Display="'2 (Circ 2 Step In&gt;Out)'" Dmx="11~15" />
      <Function ID="4" Name="3 (Circ 2 Step Col In&gt;Out)" Display="'3 (Circ 2 Step Col In&gt;Out)'" Dmx="16~20" />
      <Function ID="5" Name="4 (Clock Hand CW)" Display="'4 (Clock Hand CW)'" Dmx="21~25" />
      <Function ID="6" Name="5 (Ventilator CW)" Display="'5 (Ventilator CW)'" Dmx="26~30" />
      <Function ID="7" Name="6 (Bow Runs Left&gt;)" Display="'6 (Bow Runs Left&gt;)'" Dmx="31~35" />
      <Function ID="8" Name="7 (Bow Runs Down&gt;)" Display="'7 (Bow Runs Down&gt;)'" Dmx="36~40" />
      <Function ID="9" Name="8 (3 Line to 2 Line)" Display="'8 (3 Line to 2 Line)'" Dmx="41~45" />
      <Function ID="10" Name="9 (Diamond Change)" Display="'9 (Diamond Change)'" Dmx="46~50" />
      <Function ID="11" Name="10 (Small Circ 2 Dots Run)" Display="'10 (Small Circ 2 Dots Run)'" Dmx="51~55" />
      <Function ID="12" Name="11 (Circ 3 Step In&gt;Out)" Display="'11 (Circ 3 Step In&gt;Out)'" Dmx="56~60" />
      <Function ID="13" Name="12 (2 Dots Run Outer Circ)" Display="'12 (2 Dots Run Outer Circ)'" Dmx="61~65" />
      <Function ID="14" Name="13 (4 Dots Run Outer Circ)" Display="'13 (4 Dots Run Outer Circ)'" Dmx="66~70" />
      <Function ID="15" Name="14 (Even/Odd)" Display="'14 (Even/Odd)'" Dmx="71~75" />
      <Function ID="16" Name="15 (Rand Single Dots Jump)" Display="'15 (Rand Single Dots Jump)'" Dmx="76~80" />
      <Function ID="17" Name="16 (Rand Single Dots Fade)" Display="'16 (Rand Single Dots Fade)'" Dmx="81~85" />
      <Function ID="18" Name="17 (Raindrop Jump)" Display="'17 (Raindrop Jump)'" Dmx="86~90" />
      <Function ID="19" Name="18 (Raindrop Fade)" Display="'18 (Raindrop Fade)'" Dmx="91~95" />
      <Function ID="20" Name="19 (Al Effects)" Display="'19 (Al Effects)'" Dmx="96~100" />
      <Function ID="21" Name="All LEDs On" Display="'All LEDs On'" Dmx="101~255" />
    </Attribute>
  </Control>

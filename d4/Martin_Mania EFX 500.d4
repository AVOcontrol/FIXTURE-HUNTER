    </Attribute>
    <Attribute ID="Gobo1Shake" Name="Gobo Shake" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shake" Display="'No Shake'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Narrow" Display="'Narrow %.1f%%',0.0~100.0" Dmx="2~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Wide" Display="'Wide %.1f%%',0.0~100.0" Dmx="129~255" GoboSpin="0~0" GoboOrientation="0~0" />

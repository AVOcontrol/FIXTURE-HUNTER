  <History Date="13-12-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="14-12-22" Author="Nic Morris" Comment="Added 3, 4, 5 and 6 string modes and renamed existing in attempt to improve clarity in response to customer feedback (these are not documented in the charts but are alluded to in the menu documentation)" Version="1" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~23" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="24~31" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="32~39" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="40~47" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="48~55" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="56~63" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="64~71" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Rush MH 8 Mini Profile" ShortName="Rush MH 8" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-07-16" Author="Nic Morris" Comment="Created" />
  <History Date="04-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="155d283d-b041-494e-b6c6-4f826c523926" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="132~167" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="168~203" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="204~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="15,16,17,18" If="'Colour1Func'==4" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="161~163" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="164~166" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="167~169" Colour="255,255,0" />
      <Function ID="5" Name="Light Green" Display="'Light Green'" Dmx="170~172" Colour="128,255,0" />
      <Function ID="6" Name="Dark Blue" Display="'Dark Blue'" Dmx="173~175" Colour="0,0,180" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="176~178" Colour="255,0,255" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="179~181" Colour="0,128,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="182~184" Colour="255,150,150" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~134" Colour="0,0,0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="185~192" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="255,255,255" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="135~160" Colour="255,255,255" />
      <Function ID="16" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" Colour="255,255,255" />
      <Function ID="17" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="255,255,255" />
      <Function ID="18" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="255,255,255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Gobo1" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="10" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Gobo1Func'==3" />
      <Condition Name="Random" ID="15,16,17,18" If="'Gobo1Func'==4" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="161~163" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="164~166" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="167~169" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="170~172" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="173~175" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="176~178" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="179~181" WheelPosition="7" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="182~184" WheelPosition="8" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~134" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="185~192" WheelPosition="0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~214" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="222~243" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="135~160" WheelPosition="0" />
      <Function ID="16" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~255" />
      <Function ID="17" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" />
      <Function ID="18" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Reset Col" Display="'Reset Col'" Dmx="20~24" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~34" />
      <Function ID="5" Name="Cal ON" Display="'Cal ON'" Dmx="55~59" />
      <Function ID="6" Name="Dim Linear" Display="'Dim Linear'" Dmx="60~64" />
      <Function ID="7" Name="Dim Square" Display="'Dim Square'" Dmx="65~69" />
      <Function ID="8" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="70~74" />
      <Function ID="9" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="75~79" />
      <Function ID="10" Name="P/T Normal" Display="'P/T Normal'" Dmx="80~84" />
      <Function ID="11" Name="P/T Fast" Display="'P/T Fast'" Dmx="85~89" />
      <Function ID="12" Name="P/T Slow" Display="'P/T Slow'" Dmx="90~94" />
      <Function ID="13" Name="Shortcut ON" Display="'Shortcut ON'" Dmx="95~99" />
      <Function ID="14" Name="Shortcut OFF" Display="'Shortcut OFF'" Dmx="100~104" />
      <Function ID="15" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="145~149" />
      <Function ID="16" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="150~154" />
      <Function ID="17" Name="Display ON" Display="'Display ON'" Dmx="155~159" />
      <Function ID="18" Name="Display OFF" Display="'Display OFF'" Dmx="160~164" />
      <Function ID="19" Name="Store P/T" Display="'Store P/T'" Dmx="165~169" />
      <Function ID="20" Name="Store Gobo" Display="'Store Gobo'" Dmx="210~214" />
      <Function ID="21" Name="Store Pan" Display="'Store Pan'" Dmx="235~239" />
      <Function ID="22" Name="Store Tilt" Display="'Store Tilt'" Dmx="240~244" />
      <Function ID="23" Name="Reset Cal" Display="'Reset Cal'" Dmx="245~249" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="MTRSHMH8" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="230" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a283631c-14cc-4380-b556-c720bfdb752a" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />

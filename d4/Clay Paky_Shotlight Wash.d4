<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Shotlight Wash" ShortName="ShotLt Wsh" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>f3f1ce36-ec93-4ee2-836c-862de1e69c5d</Thumbnail>
  <History Date="10-03-11" Author="Nic Morris" Comment="Created" />
  <History Date="30-06-11" Author="John Rogers" Comment="Edited Channel Assignment in response to Clay Paky." />
  <History Date="26-07-11" Author="Nic Morris" Comment="Fixed channel assignment errors in response to auto generated bug report." />
  <History Date="09-07-14" Author="Nic Morris" Comment="Updated Flash Macro functions to latest spec.  Increased colour 1 scroll resolution." />
  <History Date="09-07-14" Author="Nic Morris" Comment="Added 28 DMX modes." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Added missing speed controls to Sync+Vect, 28 DMX (previously was identical to Sync)" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed Ind+Vect and Ind Atlabase ID's.  Added missing Sync+Vect Atlabase ID." />
  <History Date="27-05-17" Author="Nic Morris" Comment="Standardised shutter.  Added no scroll to colour.  Added physical pan/tilt limits." />
  <History Date="27-05-17" Author="Nic Morris" Comment="Moved flash components into cells for HTP dimmer." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly." />
  <History Date="14-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's." />
  <Manual Filename="" Summary="" />

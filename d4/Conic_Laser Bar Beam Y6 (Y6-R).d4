  <History Date="14-09-22" Author="Nic Morris" Comment="Split from Conic Laser Bar Beam Y6 for Capture.  Added Atlabase ID's." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="15ef2823-2748-47cd-953e-4104d5dd55fb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1 (Pan)" Display="'Macro 1 (Pan)'" Dmx="8~22" />
      <Function ID="3" Name="Macro 2 (Pan)" Display="'Macro 2 (Pan)'" Dmx="23~37" />
      <Function ID="4" Name="Macro 3 (Pan)" Display="'Macro 3 (Pan)'" Dmx="38~52" />
      <Function ID="5" Name="Macro 4 (Pan)" Display="'Macro 4 (Pan)'" Dmx="53~67" />
      <Function ID="6" Name="Macro 5 (Pan)" Display="'Macro 5 (Pan)'" Dmx="68~82" />
      <Function ID="7" Name="Macro 6 (Pan)" Display="'Macro 6 (Pan)'" Dmx="83~97" />
      <Function ID="8" Name="Macro 7 (Pan)" Display="'Macro 7 (Pan)'" Dmx="98~112" />
      <Function ID="9" Name="Macro 8 (Pan)" Display="'Macro 8 (Pan)'" Dmx="113~127" />
      <Function ID="10" Name="Macro 9 (Pan)" Display="'Macro 9 (Pan)'" Dmx="128~142" />
      <Function ID="11" Name="Macro 10 (Pan+Chase)" Display="'Macro 10 (Pan+Chase)'" Dmx="143~157" />
      <Function ID="12" Name="Macro 11 (Pan+Chase)" Display="'Macro 11 (Pan+Chase)'" Dmx="158~172" />
      <Function ID="13" Name="Macro 12 (Pan+Chase)" Display="'Macro 12 (Pan+Chase)'" Dmx="173~187" />
      <Function ID="14" Name="Macro 13 (Pan+Chase)" Display="'Macro 13 (Pan+Chase)'" Dmx="188~202" />
      <Function ID="15" Name="Macro 14 (Pan+Chase)" Display="'Macro 14 (Pan+Chase)'" Dmx="203~217" />
      <Function ID="16" Name="Macro 15 (Pan+Chase)" Display="'Macro 15 (Pan+Chase)'" Dmx="218~232" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="233~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="15~35" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="36~56" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="57~76" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="77~97" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="98~117" />
      <Function ID="7" Name="All Lasers On" Display="'All Lasers On'" Dmx="118~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Pan" Name="Master Pan" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="23 DMX" Channels="23">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="140" TiltMax="240" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="853b72a7-5789-4f74-ba58-31fdcfbea0f7" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Effect" ChannelOffset="3" Wheel="22" />
        <Attribute ID="Effect_Spd" ChannelOffset="4" Wheel="23" />
        <Attribute ID="Chase" ChannelOffset="5" Wheel="52" />
        <Attribute ID="Chase_Spd" ChannelOffset="6" Wheel="53" />
        <Attribute ID="Tilt" ChannelOffset="7,8" Wheel="3" />
        <Attribute ID="Master_Pan" ChannelOffset="9" Wheel="19" />
        <Attribute ID="PT_Speed" ChannelOffset="10" Wheel="25" />
        <Attribute ID="Pan" Wheel="2" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Control" ChannelOffset="23" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="11" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="13" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="15" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="17" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="19" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="21" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Pan" TargetId="Pan" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="140" TiltMax="240" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />

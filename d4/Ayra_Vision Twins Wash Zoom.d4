      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="110~119" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="120~129" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="130~139" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="140~149" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="150~159" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="160~169" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="170~179" />

<Fixture Name="FlipSide FX" ShortName="FlipSideFX" Company="XBlack" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>23006521-d6a6-4a50-9ea0-72c418797ea8</Thumbnail>
  <History Date="17-04-23" Author="Nic Morris" Comment="Created (very poor and inadequate documentation.  Charts only.  Function ranges missing or missing descriptions.  Guessed strobe ranges are Clay Paky type.  Reset cannot be guessed - left control as raw)" Version="0" />
  <History Date="17-04-23" Author="Nic Morris" Comment="(No explanation of various controls or pixel layout.  68 channel mode is missing channels 12 and 13)" Version="0" />
  <History Date="29-07-23" Author="Nic Morris" Comment="Changed name from BL S560 to FlipSide FX and changed channels 12 and 13 in 68 channel mode to Aux Master and Aux Strobe respectively in line with latest documentation in response to manufacturer request." Version="1" />
  <History Date="29-07-23" Author="Nic Morris" Comment="(still missing all the function ranges and pixel layout)" Version="1" />
  <History Date="29-07-23" Author="Nic Morris" Comment="Added product thumbnail (still has only product name)" Version="1" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />

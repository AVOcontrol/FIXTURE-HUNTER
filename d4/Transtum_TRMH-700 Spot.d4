<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TRMH-700 Spot" ShortName="TRMH-700Sp" Company="Translite">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Changed manufacturer from 'Transtum' to 'Translite'" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Inverted P/T speed and strobe wheel direction.  Increased wheel resolution." />
  <History Date="14-02-15" Author="Nic Morris" Comment="Re-ordered Gobo Shake" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="100~50" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="101~107" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="108~127" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~147" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="148~155" Intensity="0~0" />
      <Function ID="8" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="156~235" Intensity="0~0" />
      <Function ID="9" Name="Reset" Display="'Reset'" Dmx="236~245" Intensity="0~0" />
      <Function ID="10" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="246~250" Intensity="0~0" />
      <Function ID="11" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="251~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="6" Lowlight="7" />
      <Condition Name="Index" ID="1" If="'Colour1Func'==1" />
      <Condition Name="Fixed" ID="2,3,4,5,6,7,8,9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~153" Colour="0,0,0" />
      <Function ID="2" Name="Rose" Display="'Rose'" Dmx="154~163" Colour="255,0,127" />
      <Function ID="3" Name="Purple" Display="'Purple'" Dmx="164~168" Colour="128,0,255" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="169~173" Colour="255,128,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="174~178" Colour="0,255,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="179~183" Colour="255,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="184~188" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="189~193" Colour="255,0,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="199~219" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="220~240" Colour="0,0,0" />
      <Function ID="14" Name="Random Colour" Display="'Random Colour'" Dmx="241~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="2" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Condition Name="Index" ID="1" If="'Colour2Func'==1" />
      <Condition Name="Fixed" ID="2,3,4,5,6,7,8,9" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13,14" If="'Colour2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~153" Colour="0,0,0" />
      <Function ID="2" Name="Colour " Display="'Colour'" Dmx="154~163" Colour="0,0,0" />
      <Function ID="3" Name="Light Pink" Display="'Light Pink'" Dmx="164~168" Colour="255,200,200" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="169~173" Colour="0,128,255" />
      <Function ID="5" Name="Deep Yellow" Display="'Yellow'" Dmx="174~178" Colour="180,180,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="179~183" Colour="255,150,150" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="184~188" Colour="230,230,255" />
      <Function ID="8" Name="CTO" Display="'CTO'" Dmx="189~193" Colour="255,240,200" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="199~219" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="220~240" Colour="0,0,0" />
      <Function ID="14" Name="Colour " Display="'Colour'" Dmx="241~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~0" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="0~199" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="200~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22,23" If="'Gobo1Func'==3" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="1~16" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="17~33" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="34~50" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="51~67" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="68~84" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="85~101" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="102~118" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="119~135" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="136~153" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="189~193" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="184~188" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="179~183" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="174~178" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="169~173" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="164~168" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="159~163" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="154~158" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="199~219" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="194~198" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="220~240" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Random" Display="'Random %.f%%',0~100" Dmx="241~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="65021~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="65021~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64764" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.1f%%',0.0~100.0" Dmx="16~127" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Macro 1 &amp; 2" Display="'Macro 1 &amp; 2 %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo_Macro" Name="Gobo Macro" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~95" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="96~175" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="176~255" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Vector" Name="Vector" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~251" />
      <Function ID="2" Name="Vector Mode" Display="'Vector Mode'" Dmx="252~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard" Channels="18">
    <Import PearlRef="UK_TRMH700S" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="4" Wheel="38" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="12,13" Wheel="15" />
      <Attribute ID="Iris" ChannelOffset="10" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="16" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="17" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Vector" ChannelOffset="18" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended" Channels="20">
    <Import PearlRef="UK_TRMH700X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5,7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6,8" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="4" Wheel="38" />
      <Attribute ID="Colour_Macro" ChannelOffset="18" Wheel="9" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="11" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="12,13" Wheel="15" />
      <Attribute ID="Gobo_Macro" ChannelOffset="19" Wheel="43" />
      <Attribute ID="Iris" ChannelOffset="10" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="16" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="17" Wheel="24" />
      <Attribute ID="PT_Speed" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Vector" ChannelOffset="20" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:9,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:8,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:4,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:6,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="5" Name="Deep Yellow" Number="0" Page="1" SetControl="Colour2:5,Colour2Func:2,Colour1:9,Colour1Func:2" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour2:4,Colour2Func:2,Colour1:9,Colour1Func:2" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour2:4,Colour2Func:2,Colour1:9,Colour1Func:2" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:3,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:3,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:3,Colour1Func:2,Colour2:9,Colour2Func:2" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:2,Colour2:9,Colour2Func:2" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />

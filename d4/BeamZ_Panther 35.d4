      <Function ID="10" Name="Part 3 Blue" Display="'Part 3 Blue'" Dmx="54~59" />
      <Function ID="11" Name="Part 4 Red" Display="'Part 4 Red'" Dmx="60~65" />
      <Function ID="12" Name="Part 4 Green" Display="'Part 4 Green'" Dmx="66~71" />

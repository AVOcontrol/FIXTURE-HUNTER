      <Function ID="20" Name="All Red" Display="'All Red'" Dmx="114~119" />
      <Function ID="21" Name="All Green" Display="'All Green'" Dmx="120~125" />
      <Function ID="22" Name="All Blue" Display="'All Blue'" Dmx="126~131" />

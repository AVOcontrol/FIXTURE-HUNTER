<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Tiny Zoom 7" ShortName="Tiny Zm 7" Company="E-Lite">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="13-12-16" Author="Nic Morris" Comment="Created (poor documentation - channel 12 missing from 16 DMX mode charts)" />
  <History Date="26-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="97c374a4-cac9-485d-a505-f31c90b549dd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~250" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Macro" Name="Col Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="R" Display="'R'" Dmx="11~20" />
      <Function ID="3" Name="G" Display="'G'" Dmx="21~30" />
      <Function ID="4" Name="B" Display="'B'" Dmx="31~40" />
      <Function ID="5" Name="W" Display="'W'" Dmx="41~50" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="51~60" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="61~70" />
      <Function ID="8" Name="BW" Display="'BW'" Dmx="71~80" />
      <Function ID="9" Name="RB" Display="'RB'" Dmx="81~90" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="91~100" />
      <Function ID="11" Name="RW" Display="'RW'" Dmx="101~110" />
      <Function ID="12" Name="RBW" Display="'RBW'" Dmx="111~120" />
      <Function ID="13" Name="RGB" Display="'RGB'" Dmx="121~130" />
      <Function ID="14" Name="GBW" Display="'GBW'" Dmx="131~140" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="141~150" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Col_Fade" Name="Col Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="21~40" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="41~60" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="61~80" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="81~100" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="101~120" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="121~140" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="141~160" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="161~180" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="201~225" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="EITNZM71" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a25a510e-2ed6-48ec-b647-5bcb648e1826" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />

  <History Date="16-10-19" Author="Nic Morris" Comment="Revised Record Scenes mode in line with latest charts in response to manufacturer request." Version="3" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added fixed colour names and swatches." Version="4" />
  <History Date="28-04-20" Author="Nic Morris" Comment="Added 44 channel mode in line with latest charts in response to manufacturer request (note prism and animation don't make sense and look wrong)" Version="5" />
  <History Date="30-04-20" Author="Nic Morris" Comment="Added 44 DMX Atlabase ID." Version="6" />
  <History Date="30-04-20" Author="Nic Morris" Comment="Revised in line with corrected charts in response to manufacturer request." Version="7" />

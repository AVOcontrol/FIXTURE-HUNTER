      <Function ID="12" Name="Lm/ Org" Display="'Lm/ Org'" Dmx="41~45" WheelPosition="4" Colour="255,240,200" />
      <Function ID="13" Name="Org/ Vlt" Display="'Org/ Vlt'" Dmx="50~54" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="Vlt/ Op" Display="'Vlt/ Op'" Dmx="59~63" WheelPosition="6" Colour="180,0,255" />
      <Function ID="15" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="95~64" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~49087" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="57054~57825" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="49344~56797" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="57054~57825" WheelPosition="0" />

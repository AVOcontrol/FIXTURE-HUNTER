      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="ADV. ZOOM INDEX OFF">
      <Set Channel="Control:19" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="WARM UP LOW TEMP ON">
      <Set Channel="Control:20" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="WARM UP LOW TEMP OFF">
      <Set Channel="Control:21" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="WARM UP LOW TEMP VALUE">
      <Set Channel="Control:22" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Record Scene Mode">
      <Set Channel="Record_Scenes:3" Delay="4000" />
      <Set Channel="Record_Scenes:1" Delay="0" />
    </Macro>
  </Macro>

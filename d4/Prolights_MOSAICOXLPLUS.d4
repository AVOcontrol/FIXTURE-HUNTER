    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="10~13" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="19~22" WheelPosition="2" Colour="0,128,255" />

      <Function ID="3" Name="Light Blue" Display="'Light Blue'" Dmx="28~41" Colour="0,128,255" />
      <Function ID="4" Name="Rose" Display="'Rose'" Dmx="42~55" Colour="255,0,127" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="56~69" Colour="255,100,0" />

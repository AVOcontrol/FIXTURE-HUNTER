  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="70d4df51-5e18-40e6-ac7b-e21f666780ca" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll_Func" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="4" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll_Func" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="14~27" Colour="0,255,255" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="28~41" Colour="255,128,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="42~55" Colour="0,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="56~69" Colour="0,255,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="70~83" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="84~97" Colour="255,0,255" />
      <Function ID="8" Name="Light Orange" Display="'Light Orange'" Dmx="98~111" Colour="255,128,64" />
      <Function ID="9" Name="Turquoise" Display="'Turquoise'" Dmx="112~127" Colour="0,128,128" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="255,255,255" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll    CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func_Ind" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1Rot, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake_Func_Ind" Display="'Shake Index'" Dmx="0~0" Update="Gobo1Rot, Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Fixed_Func_Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake_Func_Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll_Func" Display="'Scroll'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func_Spin" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Shake_Func_Spin" ID="8,9,10,11,12,13" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Condition Name="Scroll_Func" ID="15,16" If="'Gobo1Func'==5" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 1 Shk" Display="'Gobo 1 Shk    %.f%%',0~100" Dmx="70~89" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 2 Shk" Display="'Gobo 2 Shk    %.f%%',0~100" Dmx="90~109" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 3 Shk" Display="'Gobo 3 Shk    %.f%%',0~100" Dmx="110~129" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 4 Shk" Display="'Gobo 4 Shk    %.f%%',0~100" Dmx="130~149" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 5 Shk" Display="'Gobo 5 Shk    %.f%%',0~100" Dmx="150~169" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 6 Shk" Display="'Gobo 6 Shk    %.f%%',0~100" Dmx="170~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="190~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Spin_Func" ID="2,3,4,5" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Index_Func" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed_Func" Display="'Fixed'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake_Func" Display="'Shake'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll_Func" Display="'Scroll'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw_Func" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed_Func" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1" />
      <Condition Name="Shake_Func" ID="9,10,11,12,13,14,15" If="'Gobo2Func'==2" />
      <Condition Name="Scroll_Func" ID="16,17" If="'Gobo2Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="14~27" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="28~41" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="42~55" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="56~69" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="70~83" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="84~97" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="98~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 1 Shk" Display="'Gobo 1 Shk    %.f%%',0~100" Dmx="112~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2 Shk" Display="'Gobo 2 Shk    %.f%%',0~100" Dmx="128~143" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 3 Shk" Display="'Gobo 3 Shk    %.f%%',0~100" Dmx="144~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4 Shk" Display="'Gobo 4 Shk    %.f%%',0~100" Dmx="160~175" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5 Shk" Display="'Gobo 5 Shk    %.f%%',0~100" Dmx="176~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6 Shk" Display="'Gobo 6 Shk    %.f%%',0~100" Dmx="192~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 7 Shk" Display="'Gobo 7 Shk    %.f%%',0~100" Dmx="208~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="224~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

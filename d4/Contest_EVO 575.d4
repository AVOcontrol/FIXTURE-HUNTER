    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Col/Gob Chg Normal" Display="'Colour/Gobo   Change Norm'" Dmx="0~19" />
      <Function ID="2" Name="Colour Chg Position" Display="'Colour Change    Position'" Dmx="20~29" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Lumi Painter" ShortName="Painter" Company="Lumisia">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-11-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~16" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="48~249" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="16~47" Intensity="0~0" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="250~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~54" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="55~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~54" Colour="255,255,255" />
      <Function ID="2" Name="6500K" Display="'6500K'" Dmx="55~60" Colour="230,230,255" />
      <Function ID="3" Name="Blood Red" Display="'Blood Red'" Dmx="61~66" Colour="255,0,0" />
      <Function ID="4" Name="Pale Gold" Display="'Pale Gold'" Dmx="67~72" Colour="255,240,200" />
      <Function ID="5" Name="Congo Blue" Display="'Congo Blue'" Dmx="73~78" Colour="180,0,255" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="79~84" Colour="255,150,150" />
      <Function ID="7" Name="Dark Green" Display="'Dark Green'" Dmx="85~90" Colour="0,180,0" />
      <Function ID="8" Name="Sky Blue" Display="'Sky Blue'" Dmx="91~96" Colour="0,128,255" />
      <Function ID="9" Name="Tokyo Blue" Display="'Tokyo Blue'" Dmx="97~102" Colour="0,0,255" />
      <Function ID="10" Name="Deep Orange" Display="'Deep Orange'" Dmx="103~108" Colour="255,100,0" />
      <Function ID="11" Name="Deep Lavender" Display="'Deep Lavender'" Dmx="109~114" Colour="180,0,180" />
      <Function ID="12" Name="Primary Red" Display="'Primary Red'" Dmx="115~120" Colour="255,0,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="121~125" Colour="255,255,0" />
      <Function ID="14" Name="Fire" Display="'Fire'" Dmx="127~132" Colour="255,0,0" />
      <Function ID="15" Name="Medium Red" Display="'Medium Red'" Dmx="133~138" Colour="255,100,100" />
      <Function ID="16" Name="Deeper Blue" Display="'Deeper Blue'" Dmx="139~144" Colour="0,0,180" />
      <Function ID="17" Name="Evening Blue" Display="'Evening Blue'" Dmx="145~150" Colour="0,0,255" />
      <Function ID="18" Name="Medium Amber" Display="'Medium Amber'" Dmx="151~156" Colour="255,128,0" />
      <Function ID="19" Name="Medium Yellow" Display="'Medium Yellow'" Dmx="157~162" Colour="255,255,0" />
      <Function ID="20" Name="Steel Green" Display="'Steel Green'" Dmx="163~168" Colour="220,240,255" />
      <Function ID="21" Name="Deep Amber" Display="'Deep Amber'" Dmx="169~174" Colour="255,100,0" />
      <Function ID="22" Name="Light Salmon" Display="'Light Salmon'" Dmx="175~180" Colour="255,150,230" />
      <Function ID="23" Name="Magenta" Display="'Magenta'" Dmx="181~186" Colour="255,0,255" />
      <Function ID="24" Name="Dark Amber" Display="'Dark Amber'" Dmx="187~192" Colour="255,100,0" />
      <Function ID="25" Name="Apricot" Display="'Apricot'" Dmx="193~198" Colour="255,128,0" />
      <Function ID="26" Name="Dark Blue" Display="'Deep Blue'" Dmx="199~204" Colour="0,0,180" />
      <Function ID="27" Name="Steel Blue" Display="'Steel Blue'" Dmx="205~210" Colour="220,240,255" />
      <Function ID="28" Name="Lavender" Display="'Lavender'" Dmx="211~216" Colour="255,128,255" />
      <Function ID="29" Name="Spr Correction" Display="'Spr Correction'" Dmx="217~222" Colour="230,230,255" />
      <Function ID="30" Name="Fern Green" Display="'Fern Green'" Dmx="223~228" Colour="0,255,0" />
      <Function ID="31" Name="Straw" Display="'Straw'" Dmx="229~236" Colour="255,250,230" />
      <Function ID="32" Name="Special Med Lav" Display="'Special Med Lav'" Dmx="237~242" Colour="255,128,255" />
      <Function ID="33" Name="6500K" Display="'6500K'" Dmx="243~255" Colour="230,230,255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="7">
    <Import PearlRef="UKLUPTR1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="7" Wheel="9" />
    </Include>
  </Mode>

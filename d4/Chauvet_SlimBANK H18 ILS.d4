      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="199~215" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="216~232" Update="Auto_Spd" />

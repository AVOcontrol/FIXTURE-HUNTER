      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="114~130" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="131~147" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="148~164" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="165~181" Update="Auto_Spd" />

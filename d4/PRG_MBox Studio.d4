      <Condition Name="Amount" ID="2" If="'Effect4Func'==2||'Effect4Func'==3||'Effect4Func'==5||'Effect4Func'==11||'Effect4Func'==14||'Effect4Func'==22||'Effect4Func'==23||'Effect4Func'==93||'Effect4Func'==94||'Effect4Func'==95||'Effect4Func'==96||'Effect4Func'==97||'Effect4Func'==98||'Effect4Func'==112" />

    <Attribute ID="Effect1Func" Name="Obj Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="2" Name="L/R Shutter" Display="'L/R Shutter'" Dmx="1~1" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="3" Name="B/T Shutter" Display="'B/T Shutter'" Dmx="2~2" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="4" Name="Move Center" Display="'Move Center'" Dmx="3~3" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="5" Name="Shake" Display="'Shake'" Dmx="4~4" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="6" Name="Strobe" Display="'Strobe'" Dmx="5~5" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="7" Name="Object Tile" Display="'Object Tile'" Dmx="6~6" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="8" Name="Z Position" Display="'Z Position'" Dmx="7~7" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="9" Name="Specular Highlight" Display="'Specular      Highlight'" Dmx="8~8" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="10" Name="Texture Scale/Rotate" Display="'Texture Scale/Rotate'" Dmx="9~9" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="11" Name="Texture X/Y Position" Display="'Texture X/Y   Position'" Dmx="10~10" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
      <Function ID="12" Name="Allegiance" Display="'Allegiance'" Dmx="11~11" Update="Effect1A, Effect1B, ObjEffect1A, ObjEffect1B" />
    </Attribute>
    <Attribute ID="ObjEffect1A" Name="Obj Effect 1A" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="L/R Shutter" ID="1" If="'Effect1Func'==2||'Effect1Func'==3" />
      <Condition Name="Move Center" ID="2" If="'Effect1Func'==4||'Effect1Func'==5||'Effect1Func'==11" />
      <Condition Name="Strobe" ID="3" If="'Effect1Func'==6" />
      <Condition Name="Object Tile" ID="4" If="'Effect1Func'==7" />
      <Condition Name="Z Position" ID="5" If="'Effect1Func'==8" />
      <Condition Name="Specular Highlight" ID="6" If="'Effect1Func'==9" />
      <Condition Name="Texture Scale/Rotate" ID="7" If="'Effect1Func'==10" />
      <Else ID="8" />
      <Function ID="1" Name="Left/Bottom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="X" Display="'X %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Off Time" Display="'Off Time %.1f%%',0.0~100.0" Dmx="0~255" />

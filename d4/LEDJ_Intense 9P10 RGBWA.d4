<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intense 9P10 RGBWA" ShortName="Intse 9P10" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="15-04-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~22" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~45" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="46~68" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="69~91" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="92~114" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="115~137" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="138~160" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="161~183" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="184~206" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="207~229" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="230~252" />
      <Function ID="13" Name="Safe" Display="'Safe'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="13~25" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="26~38" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="39~51" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="52~64" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="65~77" Colour="255,100,0" />
      <Function ID="7" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="78~90" Colour="180,180,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="91~103" Colour="255,255,0" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="104~116" Colour="128,0,255" />
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="117~129" Colour="255,150,150" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="130~142" Colour="0,255,255" />
      <Function ID="12" Name="Light Pink" Display="'Light Pink'" Dmx="143~155" Colour="255,200,200" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="156~168" Colour="128,255,0" />
      <Function ID="14" Name="Light Blue" Display="'Light Blue'" Dmx="169~181" Colour="0,128,255" />
      <Function ID="15" Name="Orange" Display="'Orange'" Dmx="182~194" Colour="255,128,0" />
      <Function ID="16" Name="Lime" Display="'Lime'" Dmx="195~207" Colour="0,255,0" />
      <Function ID="17" Name="UV" Display="'UV'" Dmx="208~220" Colour="180,0,255" />
      <Function ID="18" Name="CTO" Display="'CTO'" Dmx="221~233" Colour="255,240,200" />
      <Function ID="19" Name="White" Display="'White'" Dmx="234~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="LJI9P105" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="5" Wheel="7" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="LJI9P107" DiamondRef="" WysiwygRef="" />
    <Physical>

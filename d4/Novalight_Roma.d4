  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus Off">
      <Set Channel="Function:10" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus 8m">
      <Set Channel="Function:11" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus 12m">
      <Set Channel="Function:12" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="AutoFocus 20m">

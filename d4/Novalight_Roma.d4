      <Function ID="2" Name="Standby" Display="'Standby'" Dmx="8~11" />
      <Function ID="3" Name="Standby (Black)" Display="'Standby (Black)'" Dmx="12~15" />
      <Function ID="4" Name="Zoom In Faded" Display="'Zoom In Faded'" Dmx="16~45" />
      <Function ID="5" Name="Zoom Out Faded" Display="'Zoom Out Faded'" Dmx="46~75" />
      <Function ID="6" Name="Zoom In Out" Display="'Zoom In Out'" Dmx="76~105" />
      <Function ID="7" Name="Standby (Black)" Display="'Standby (Black)'" Dmx="106~135" />
      <Function ID="8" Name="Zoom In Faded Random" Display="'Zoom In Faded Random'" Dmx="136~165" />
      <Function ID="9" Name="Zoom Out Faded Random" Display="'Zoom Out Faded Random'" Dmx="166~195" />
      <Function ID="10" Name="Zoom In Out Random" Display="'Zoom In Out Random'" Dmx="196~225" />
      <Function ID="11" Name="Standby (Black)" Display="'Standby (Black)'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />

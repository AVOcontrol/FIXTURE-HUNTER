<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BSW280" ShortName="BSW280" Company="ALS" Version="32">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="09-09-10" Author="Jonathan Moreton" Comment="Created from Robe Robin 300E Spot" Version="1" />
  <History Date="09-11-10" Author="John Rogers" Comment="Edited Colour order." Version="2" />
  <History Date="09-11-10" Author="John Rogers" Comment="Tested against fixture." Version="3" />
  <History Date="24-07-11" Author="Nic Morris" Comment="Inverted speed ranges.  Reordered some attribute functions.  Removed PT Speed update from Control." Version="4" />
  <History Date="24-07-11" Author="Nic Morris" Comment="Standardised func names.  Renamed colour spit to index.  Simplified index ranges." Version="5" />
  <History Date="24-07-11" Author="Nic Morris" Comment="Increased wheel resolution.  Fixed 16bit raw ranges.  Added function indexs." Version="6" />
  <History Date="24-07-11" Author="Nic Morris" Comment="Shortened names for Expert LCD.  Added index/spin options to gobo2 scroll and random." Version="7" />
  <History Date="24-07-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added highlight and lowlight." Version="8" />
  <History Date="07-03-13" Author="Peter Budd" Comment="Created from Robe Robin 300 Spot Classic to Robe Robin Pointe V0.9 Spec" Version="9" />
  <History Date="27-03-13" Author="Peter Budd" Comment="Edited updated to V0.91 of the spec" Version="10" />
  <History Date="22-04-13" Author="Peter Budd" Comment="Added Auto Focus channel." Version="11" />
  <History Date="22-04-13" Author="Peter Budd" Comment="Added Esta Manufacturer ID." Version="12" />
  <History Date="02-05-13" Author="Peter Budd" Comment="Updated to V1.1 Spec. Including change to colour wheel, gobo 2 and autofocus ranges." Version="13" />
  <History Date="07-05-13" Author="Peter Budd" Comment="Corrected wheel mapping." Version="14" />
  <History Date="21-05-13" Author="Peter Budd" Comment="Fixed the Open/Hole effect on Gobo 2." Version="15" />
  <History Date="22-05-13" Author="Peter Budd" Comment="Corrected Lamp Off Macro." Version="16" />
  <History Date="24-07-13" Author="Peter Budd" Comment="Updated gobo 1 locate value." Version="17" />
  <History Date="24-03-14" Author="Nic Morris" Comment="Adjusted physical max pan.  Added standard function to P/T speed.  Tidied macros." Version="18" />
  <History Date="24-03-14" Author="Nic Morris" Comment="Added function index to colour.  Removed electronic strobe function from shutter." Version="19" />
  <History Date="24-03-14" Author="Nic Morris" Comment="Added mode 3.  Changed gobo 1 to 8 bit." Version="20" />
  <History Date="01-02-15" Author="Nic Morris" Comment="Recreated palettes in response to customer bug report (library re-sync)" Version="21" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="22" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (RoboSpot control function and macros)." Version="23" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Tidied conditional function orders.  Revised colour locate (open) ranges.  Fixed gobo function index." Version="24" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Shortened col index function names to fit all displays, revised ranges to full field and increased 16bit wheel resolution." Version="25" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Inverted zoom.  Recreated palettes with both gobo wheels." Version="26" />
  <History Date="01-01-18" Author="Nic Morris" Comment="Added product thumbnail" Version="27" />
  <History Date="01-01-18" Author="Nic Morris" Comment="Added gobo swatches" Version="28" />
  <History Date="18-01-18" Author="Nic Morris" Comment="Added open gobo swatch to gobo wheel 1 index hole slot." Version="29" />
  <History Date="17-10-19" Author="Nic Morris" Comment="Created from Robe Robin Pointe (poor documentation)." Version="30" />
  <History Date="31-07-22" Author="Nic Morris" Comment="Created from Unknown FTT280 (identical)" Version="31" />
  <History Date="02-08-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="32" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9b512037-088c-486f-8762-accbf2f75a3b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

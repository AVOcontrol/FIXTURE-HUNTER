  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="18-07-12" Author="Peter Budd" Comment="Created" />
  <History Date="24-05-13" Author="Peter Budd" Comment="Edited" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-08-15" Author="Nic Morris" Comment="Changed colour macro functions from fixed to percentage ranges in response to customer bug report." />
  <History Date="03-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="04-08-16" Author="Nic Morris" Comment="Created from MilTec Batten2" />
  <History Date="09-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eb9c1d52-7a23-4562-9267-9dba9b65e8da" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="58~59" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="109~110" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="111~159" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="160~161" Intensity="0~0" />
      <Function ID="8" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="162~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="10~50" Colour="0,0,0" />
      <Function ID="3" Name="Fade RGB" Display="'Fade RGB %.f%%',0~100" Dmx="51~91" Colour="0,0,0" />
      <Function ID="4" Name="Fade Chase" Display="'Fade Chase %.f%%',0~100" Dmx="92~132" Colour="0,0,0" />
      <Function ID="5" Name="Snap Chase" Display="'Snap Chase %.f%%',0~100" Dmx="133~173" Colour="0,0,0" />
      <Function ID="6" Name="Macros" Display="'Macros %.f%%',0~100" Dmx="174~214" Colour="0,0,0" />
      <Function ID="7" Name="Random" Display="'Random %.f%%',0~100" Dmx="215~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode A, 4 DMX" Channels="4">
    <Import PearlRef="MIBAT2MA" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

    <Attribute ID="Lightsource" Name="Lightsource" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue Screen" Display="'Blue Screen'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Green Screen" Display="'Green Screen'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="Candle" Display="'Candle'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="Tungsten" Display="'Tungsten'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="Halogen" Display="'Halogen'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Carbon Arc" Display="'Carbon Arc'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="Fluorescent Warm" Display="'Fluorescent Warm'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="8" Name="Fluorescent Standard" Display="'Fluorescent Standard'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="Fluorescent Cool" Display="'Fluorescent Cool'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="10" Name="Fluorescent Black Light" Display="'Fluorescent Black Light'" Dmx="9~9" Colour="255,255,255" />
      <Function ID="11" Name="HMI" Display="'HMI'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="12" Name="Mercury Vapour" Display="'Mercury Vapour'" Dmx="11~11" Colour="255,255,255" />
      <Function ID="13" Name="Moonlight" Display="'Moonlight'" Dmx="12~12" Colour="255,255,255" />
      <Function ID="14" Name="Sky Blue" Display="'Sky Blue'" Dmx="13~13" Colour="255,255,255" />
      <Function ID="15" Name="Sky Overcast" Display="'Sky Overcast'" Dmx="14~14" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kosmos v2" ShortName="Kosmos v2" Company="VELVETLight" Version="27">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="03-10-19" Author="Nic Morris" Comment="Created (note 'Changing' modes not implemented)" Version="1" />
  <History Date="09-10-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="03-08-20" Author="Nic Morris" Comment="Created from VELVETLight EVO1 (note 16bit charts not available - assumed identical.  'Changing' modes not implemented)" Version="3" />
  <History Date="03-11-20" Author="Nic Morris" Comment="Added Individual modes in line with latest information in response to manufacturer request." Version="4" />
  <History Date="13-05-22" Author="Nic Morris" Comment="Updated in line with latest charts (Firmware v0204-30-March-22.  Significant differences, particularly 16bit modes.  Documentation linked from website still show original mappings)" Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Very confusing.  Impemented full modes as split patch.  Note 8bit and 16 bit full modes appear to have different options and looks wrong)." Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Lightsources and non-full mode effect ranges not documented - left unchanged for now.  Gels not documented - left as raw)" Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Tried to imply effect parameters from full modes)" Version="8" />
  <History Date="18-05-22" Author="Nic Morris" Comment="Created from VELVETLight VELVET CYC" Version="21" />
  <History Date="18-05-22" Author="Nic Morris" Comment="(Changing modes not implemented as they change control resolution dynamically which is not currently supported)" Version="22" />
  <History Date="18-05-22" Author="Nic Morris" Comment="(note 8bit effect mode details as 14 channels but only 13 listed.  assumed is 14 with zoom on offset 13.  similarly, 16bit effect mode details as 16 channels but only 15 listed.  assumed is 15)" Version="22" />
  <History Date="18-05-22" Author="Nic Morris" Comment="(also note full 8bit gels overlaps full 8bit lightsources.  assumed this is incorrect and adjusted patch offsets of lightsources and all subsequent modes to suit)" Version="22" />
  <History Date="18-05-22" Author="Nic Morris" Comment="(seems strange that the 'full' modes do not have a zoom control)" Version="22" />
  <History Date="18-05-22" Author="Nic Morris" Comment="Revised full mode control functions." Version="27" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2500" PowerOn="1:2500" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+Magenta" Display="'+Magenta %.1f%%',100.0~1.0" Dmx="1~121" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="122~132" Colour="255,255,255" />
      <Function ID="4" Name="+Green" Display="'+Green %.1f%%',1.0~100.0" Dmx="133~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.f°',0~359" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Family" Name="Gel Family" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LEE" Display="'LEE'" Dmx="0~0" Update="Gel_Number" Colour="255,255,255" />
      <Function ID="2" Name="Rosco" Display="'Rosco'" Dmx="255~255" Update="Gel_Number" Colour="255,255,255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gel_Number" Colour="0,0,0" />
    </Attribute>

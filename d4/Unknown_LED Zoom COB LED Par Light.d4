  <Mode Name="9 DMX" Channels="9" Id="8643fad1-01da-4c95-bfc5-5c6cc889df36">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

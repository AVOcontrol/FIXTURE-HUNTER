      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X_Roll_Spd" Name="X Roll Spd" Description="" Group="S">

  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="White 2700K (Halogen)" Display="'White 2700K (Halogen)'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="White 3200K (Halogen)" Display="'White 3200K (Halogen)'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="White 5600K" Display="'White 5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="White 8000K" Display="'White 8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="10" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="17~55" Colour="0,0,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />
      <Function ID="12" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="57~95" Colour="0,128,255" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="14" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="97~134" Colour="0,255,0" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="255,255,0" />
      <Function ID="16" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="136~174" Colour="255,255,0" />
      <Function ID="17" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="18" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="176~214" Colour="255,0,0" />
      <Function ID="19" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="20" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="216~246" Colour="255,0,255" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="247~247" Colour="0,0,255" />
      <Function ID="22" Name="Rbow w/fade" Display="'Rbow w/fade %.f%%',0~100" Dmx="251~248" Colour="255,255,255" />
      <Function ID="23" Name="Rbow no fade" Display="'Rbow no fade %.f%%',0~100" Dmx="255~252" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

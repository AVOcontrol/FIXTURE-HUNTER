<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Star LED" ShortName="Star LED" Company="Showtec" Version="4">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>bd791dfa-7d96-4b47-b383-e34723b3df2a</Thumbnail>
  <History Date="28-01-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="05-02-16" Author="Nic Morris" Comment="Swapped colour and effect attribute groups and associated wheel mapping in response to customer request." Version="2" />
  <History Date="07-02-16" Author="Nic Morris" Comment="Changed rotate to gobo in response to customer request." Version="3" />
  <History Date="19-05-20" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d3cc431e-ef09-4202-a8fd-a6ff8a63ad99" />
  <Control>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Effect_Func'==1" />
      <Condition Name="Scroll" ID="9,10,11" If="'Effect_Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~39" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~59" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~79" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="80~99" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="100~119" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="120~139" />
      <Function ID="8" Name="White" Display="'White'" Dmx="140~159" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="160~179" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="180~199" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="200~255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~28" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="29~56" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="57~84" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="85~112" Colour="0,255,255" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="113~140" Colour="255,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="141~168" Colour="255,255,0" />
      <Function ID="8" Name="White" Display="'White'" Dmx="169~197" Colour="255,255,255" />
      <Function ID="9" Name="Auto" Display="'Auto'" Dmx="198~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="128~132" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="133~249" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="250~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="SHSTRLED" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="506e6098-ed58-4c58-aa96-005edd6f1487" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Rotate" ChannelOffset="4" Wheel="13" />
      <Attribute ID="Effect_Func" Wheel="22" />
      <Attribute ID="Effect" ChannelOffset="1" Wheel="23" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="No Function" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:2" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:7" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:5" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:6" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Magenta" Number="8" Page="1" SetControl="Colour1:6" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="bd791dfa-7d96-4b47-b383-e34723b3df2a"></Swatch>
  </swatchLibrary>
</Fixture>
      <Function ID="13" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="104~221" Colour="0,0,0" />
      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="15" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="222~238" Colour="0,0,0" />

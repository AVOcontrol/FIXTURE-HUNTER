  <AtlaBase TypeID="f8758730-f5f9-48ee-ad75-1edcc5746f6d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGB Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="Colour 1" Display="'Colour 1'" Dmx="201~205" WheelPosition="1" Colour="0,0,0" />
      <Function ID="5" Name="Colour 2" Display="'Colour 2'" Dmx="206~210" WheelPosition="2" Colour="0,0,0" />
      <Function ID="6" Name="Colour 3" Display="'Colour 3'" Dmx="211~215" WheelPosition="3" Colour="0,0,0" />
      <Function ID="7" Name="Colour 4" Display="'Colour 4'" Dmx="216~220" WheelPosition="4" Colour="0,0,0" />
      <Function ID="8" Name="Colour 5" Display="'Colour 5'" Dmx="221~225" WheelPosition="5" Colour="0,0,0" />
      <Function ID="9" Name="Colour 6" Display="'Colour 6'" Dmx="226~230" WheelPosition="6" Colour="0,0,0" />
      <Function ID="10" Name="Colour 7" Display="'Colour 7'" Dmx="231~235" WheelPosition="7" Colour="0,0,0" />
      <Function ID="11" Name="Colour 8" Display="'Colour 8'" Dmx="236~240" WheelPosition="8" Colour="0,0,0" />
      <Function ID="12" Name="Colour 9" Display="'Colour 9'" Dmx="241~245" WheelPosition="9" Colour="0,0,0" />
      <Function ID="13" Name="Colour 10" Display="'Colour 10'" Dmx="246~250" WheelPosition="10" Colour="0,0,0" />
      <Function ID="14" Name="Colour 11" Display="'Colour 11'" Dmx="251~255" WheelPosition="11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3000K" Display="'3000K'" Dmx="6~39" Colour="255,255,255" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="40~69" Colour="255,255,255" />
      <Function ID="4" Name="5000K" Display="'5000K'" Dmx="70~99" Colour="255,255,255" />
      <Function ID="5" Name="6000K" Display="'6000K'" Dmx="100~129" Colour="255,255,255" />
      <Function ID="6" Name="7000K" Display="'7000K'" Dmx="130~159" Colour="255,255,255" />
      <Function ID="7" Name="8000K" Display="'8000K'" Dmx="160~189" Colour="255,255,255" />
      <Function ID="8" Name="9000K" Display="'9000K'" Dmx="190~219" Colour="255,255,255" />
      <Function ID="9" Name="10000K" Display="'10000K'" Dmx="220~250" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
  </Control>

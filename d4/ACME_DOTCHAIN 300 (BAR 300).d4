      <Condition Name="Random" ID="40,41,42,43" If="'Colour1Func'==3" />
      <Else ID="44" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Moroccan Pink" Display="'Moroccan Pink'" Dmx="10~14" Colour="254,37,221" />

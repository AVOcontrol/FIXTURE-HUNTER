  <History Date="27-08-21" Author="Nic Morris" Comment="Added product thumbnail.  Changed shutter open to fix at zero in attempt to solve customer query (charts say 0-31 = off).  Added colour macro preview fog function in line with Rev 8/15 manual." Version="3" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Fog Fury Jett.d4 to ADJ_Fog Fury Jett.d4." Version="4" />

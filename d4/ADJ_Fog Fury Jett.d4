  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Colour Macro Preview" Display="'Colour Macro Preview'" Dmx="16~31" />
      <Function ID="3" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>

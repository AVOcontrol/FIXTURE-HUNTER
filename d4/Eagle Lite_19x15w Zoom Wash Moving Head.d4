<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="19x15w Zoom Wash Moving Head" ShortName="19x15w Zm" Company="Eagle Lite" Version="3">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="07-05-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="15-05-20" Author="Nic Morris" Comment="Inverted p/t speed and correct shutter ranges in response to customer feedback." Version="1" />
  <History Date="13-07-21" Author="Nic Morris" Comment="Added compatibility for Diamond 4." Version="2" />
  <History Date="28-10-21" Author="Nic Morris" Comment="Changed manufacturer name from Eagle Light to Eagle Lite in response to manufacturer request." Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="96~176" />
      <Function ID="4" Name="Fast" Display="'Fast %.f%%',0~100" Dmx="177~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="24~24" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="25~49" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="50~74" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="75~99" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="100~124" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="125~149" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="150~174" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="175~199" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="200~224" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Function_Spd" Name="Function Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Show" Display="'Show'" Dmx="50~99" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="100~149" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

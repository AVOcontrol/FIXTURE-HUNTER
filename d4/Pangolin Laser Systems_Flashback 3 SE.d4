      <Function ID="2" Name="Hold" Display="'Hold'" Dmx="33~95" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="97~159" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="33~223" Colour="0,0,0" />
      <Function ID="3" Name="White" Display="'White'" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

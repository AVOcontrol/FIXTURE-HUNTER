  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="07-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="08-06-17" Author="Peter Budd" Comment="Made the locate values output some light." />
  <History Date="13-12-18" Author="Nic Morris" Comment="Restricted control options per mode.  Revised Cue with discreet functions." />
  <History Date="13-12-18" Author="Nic Morris" Comment="Revised Speed display range.  Revised Zoom locate values.  Revised X and Y-Size display ranges." />
  <History Date="13-12-18" Author="Nic Morris" Comment="Revised Z-Angle display range.  Revised release time functions.  Removed shortcode from display name." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="ControlBasic" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Basic" Display="'Basic'" Dmx="33~95" />
    </Attribute>
    <Attribute ID="ControlStandard" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />

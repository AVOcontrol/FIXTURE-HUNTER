  <AtlaBase TypeID="6bb991da-cf2d-4e6c-9a58-88105146b3f4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Dim Speed 0 (no delay)" Display="'Dim Speed 0 (no delay)'" Dmx="6~55" />
      <Function ID="3" Name="Dim Speed 1" Display="'Dim Speed 1'" Dmx="56~105" />
      <Function ID="4" Name="Dim Speed 2" Display="'Dim Speed 2'" Dmx="106~155" />
      <Function ID="5" Name="Dim Speed 3" Display="'Dim Speed 3'" Dmx="156~205" />
      <Function ID="6" Name="Dim Speed 4 (slowest)" Display="'Dim Speed 4 (slowest)'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>

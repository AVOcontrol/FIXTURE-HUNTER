      <Function ID="17" Name="5500K" Display="'5500K'" Dmx="184~195" Colour="230,230,255" />
      <Function ID="18" Name="6000K" Display="'6000K'" Dmx="196~207" Colour="230,230,255" />
      <Function ID="19" Name="7000K" Display="'7000K'" Dmx="208~219" Colour="230,230,255" />
      <Function ID="20" Name="8000K" Display="'8000K'" Dmx="220~231" Colour="230,230,255" />
      <Function ID="21" Name="9000K" Display="'9000K'" Dmx="232~243" Colour="230,230,255" />
      <Function ID="22" Name="10000K" Display="'10000K'" Dmx="244~255" Colour="230,230,255" />

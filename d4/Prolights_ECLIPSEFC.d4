      <Function ID="10" Name="Light Yellow" Display="'Yellow'" Dmx="100~111" Colour="255,255,128" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="112~123" Colour="0,128,255" />
      <Function ID="12" Name="Light Pink" Display="'Light Pink'" Dmx="124~135" Colour="255,150,150" />
      <Function ID="13" Name="2700K" Display="'2700K'" Dmx="136~147" Colour="255,240,200" />
      <Function ID="14" Name="3200K" Display="'3200K'" Dmx="148~159" Colour="255,240,200" />
      <Function ID="15" Name="4200K" Display="'4200K'" Dmx="160~171" Colour="255,240,200" />

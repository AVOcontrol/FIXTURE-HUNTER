    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="2700K" Display="'2700K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="27~51" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="52~76" Colour="255,255,255" />
      <Function ID="4" Name="5000K" Display="'5000K'" Dmx="77~101" Colour="255,255,255" />
      <Function ID="5" Name="5500K" Display="'5500K'" Dmx="102~126" Colour="255,255,255" />
      <Function ID="6" Name="6000K" Display="'6000K'" Dmx="127~151" Colour="255,255,255" />
      <Function ID="7" Name="7000K" Display="'7000K'" Dmx="152~176" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="177~201" Colour="255,255,255" />
      <Function ID="9" Name="9000K" Display="'9000K'" Dmx="202~226" Colour="255,255,255" />
      <Function ID="10" Name="10000K" Display="'10000K'" Dmx="227~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~100" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="131~200" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f°',-25.0~0.0" Dmx="0~126" Colour="255,255,255" />
      <Function ID="2" Name="0" Display="'0'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="3" Name="+" Display="'+ %.1f°',0.0~25.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Amber Shift On" Display="'Amber Shift On'" Dmx="3~5" Colour="255,255,255" />
      <Function ID="3" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO_on_Colours" Name="CTO on Colours" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Spd1" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
  </Control>

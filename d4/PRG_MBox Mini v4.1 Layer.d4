    <Attribute ID="Effect_1_Mod_1" Name="Effect Mod 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Hue Angle" ID="2" If="'Effect_1'==2||'Effect_1'==3" />
      <Condition Name="Gamma" ID="3" If="'Effect_1'==4" />
      <Condition Name="Exposure" ID="4" If="'Effect_1'==5" />

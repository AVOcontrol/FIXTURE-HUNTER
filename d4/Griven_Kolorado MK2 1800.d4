<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kolorado MK2 1800" ShortName="Kol M2 18K" Company="Griven">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="04-08-10" Author="Jonathan Moreton" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-12-16" Author="Nic Morris" Comment="Added Atlabase ID to Option 2 Off mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1eaf767f-6d25-4e0b-815f-4d99474ecb0b" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lamp On" Display="'Lamp On'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="128~159" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="160~239" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="240~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Yellow" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op/ Yel" Display="'Op/ Yel %.f%%',0~100" Dmx="4~31" Colour="255,255,128" />
      <Function ID="3" Name="Yel/ Grn" Display="'Yel/ Grn %.f%%',0~100" Dmx="32~59" Colour="128,255,0" />
      <Function ID="4" Name="Grn/ Cy" Display="'Grn/ Cy %.f%%',0~100" Dmx="56~87" Colour="0,255,0" />
      <Function ID="5" Name="Cy/ Op" Display="'Cy/ Op %.f%%',0~100" Dmx="88~111" Colour="128,255,255" />
      <Function ID="6" Name="Op/ Mag" Display="'Op/ Mag %.f%%',0~100" Dmx="112~139" Colour="255,128,255" />
      <Function ID="7" Name="Mag/ Wood" Display="'Mag/ Wood %.f%%',0~100" Dmx="140~163" Colour="255,0,255" />
      <Function ID="8" Name="Wood/ Cy" Display="'Wood/ Cy %.f%%',0~100" Dmx="164~191" Colour="0,0,0" />
      <Function ID="9" Name="Mag/ Rd" Display="'Mag/ Rd %.f%%',0~100" Dmx="192~219" Colour="255,0,128" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel %.f%%',0~100" Dmx="220~243" Colour="255,128,0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="244~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Cyan" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
  </Control>
  <Mode Name="Option 2 On" Channels="5">
    <Import PearlRef="GR_KM218KO2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Reserved" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Reserved1" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Option 2 Off" Channels="5">
    <Import PearlRef="GR_KM218K" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6fb91bd0-667f-460c-98fc-2f0ef3d6b4cf" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Cyan" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>

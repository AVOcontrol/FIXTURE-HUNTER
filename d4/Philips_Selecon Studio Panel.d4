<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Selecon Studio Panel" ShortName="Std Panel" Company="Philips">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="15-08-12" Author="Peter Budd" Comment="Created" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="20545" ModelID="0" />
  </RDM>
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 16bit" Channels="4">
    <Import PearlRef="PH_SelStdPX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="3,4" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="PH_SelStdPB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d3f5557f-4c09-4c73-b15f-9be0c0001f81" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="15~15" Colour="255,128,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="30~30" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="45~45" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~60" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="75~75" Colour="255,150,150" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="90~90" Colour="0,128,255" />
      <Function ID="8" Name="Light Green" Display="'Light Green'" Dmx="105~105" Colour="128,255,0" />
      <Function ID="9" Name="Light Yellow" Display="'Yellow'" Dmx="120~120" Colour="255,255,128" />
      <Function ID="10" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~14" Colour="255,255,255" />
      <Function ID="11" Name="Orange" Display="'Orange %.f%%',0~100" Dmx="15~29" Colour="255,128,0" />
      <Function ID="12" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~44" Colour="0,0,255" />
      <Function ID="13" Name="Green" Display="'Green %.f%%',0~100" Dmx="45~59" Colour="0,255,0" />
      <Function ID="14" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="60~74" Colour="255,255,0" />
      <Function ID="15" Name="Pink" Display="'Pink %.f%%',0~100" Dmx="75~89" Colour="255,150,150" />
      <Function ID="16" Name="Light Blue" Display="'Light Blue %.f%%',0~100" Dmx="90~104" Colour="0,128,255" />
      <Function ID="17" Name="Light Green" Display="'Light Green %.f%%',0~100" Dmx="105~119" Colour="128,255,0" />
      <Function ID="18" Name="Light Yellow" Display="'Yellow %.f%%',0~100" Dmx="120~127" Colour="255,255,128" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="128~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~14" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />

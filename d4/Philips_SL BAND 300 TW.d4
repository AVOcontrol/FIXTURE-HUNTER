<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SL BAND 300 TW" ShortName="BAND 300 W" Company="Philips">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="30-10-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="21-10-16" Author="Nic Morris" Comment="Created from Philips SL BAND 300" />
  <History Date="21-10-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="26-11-16" Author="Nic Morris" Comment="Aligned functions with other fixtures in range." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e94a240c-79b0-4186-a6fd-919b1a3d2bed" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="3~5" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="13~127" Intensity="0~0" />
      <Function ID="4" Name="Rnd Slow" Display="'Rnd Slow'" Dmx="6~7" Intensity="0~0" />
      <Function ID="5" Name="Rnd Med" Display="'Rnd Med'" Dmx="8~10" Intensity="0~0" />
      <Function ID="6" Name="Rnd Fast" Display="'Rnd Fast'" Dmx="11~12" Intensity="0~0" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="134~191" Intensity="0~0" />
      <Function ID="8" Name="Op Pls Rnd Slow" Display="'Op Pls Rnd Slow'" Dmx="128~129" Intensity="0~0" />
      <Function ID="9" Name="Op Pls Rnd Med" Display="'Op Pls Rnd Med'" Dmx="130~131" Intensity="0~0" />
      <Function ID="10" Name="Op Pls Rnd Fast" Display="'Op Pls Rnd Fast'" Dmx="132~133" Intensity="0~0" />
      <Function ID="11" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="198~255" Intensity="0~0" />
      <Function ID="12" Name="Cls Pls Rnd Slow" Display="'Cls Pls Rnd Slow'" Dmx="192~193" Intensity="0~0" />
      <Function ID="13" Name="Cls Pls Rnd Med" Display="'Cls Pls Rnd Med'" Dmx="194~195" Intensity="0~0" />
      <Function ID="14" Name="Cls Pls Rnd Fast" Display="'Cls Pls Rnd Fast'" Dmx="196~197" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.f',0~85" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Normal" Display="'Dim Normal'" Dmx="5~9" />
      <Function ID="3" Name="Dim Incandescent" Display="'Dim Incandescent'" Dmx="10~29" />
      <Function ID="4" Name="Curve Linear" Display="'Curve Linear'" Dmx="30~34" />
      <Function ID="5" Name="Curve Square" Display="'Curve Square'" Dmx="35~39" />
      <Function ID="6" Name="S-Curve" Display="'S-Curve'" Dmx="40~44" />
      <Function ID="7" Name="PL-Curve" Display="'PL-Curve'" Dmx="45~69" />
      <Function ID="8" Name="Calibration Off" Display="'Calibration Off'" Dmx="70~74" />
      <Function ID="9" Name="Calibration On" Display="'Calibration On'" Dmx="75~79" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="WW" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="WW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="CW" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="CW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="CCT 16-Bit, 8 DMX" Channels="8">
    <Import PearlRef="PHSL3004" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8b180c7f-f8f4-420a-b272-6adb7dcb02f8" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="CTO" ChannelOffset="7,8" Wheel="9" />
      <Attribute ID="Duration" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="CCT 8-Bit, 6 DMX" Channels="6">
    <Import PearlRef="PHSL3005" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f59a1712-ab81-4292-b25c-0655916e2722" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="CTO" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Duration" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="WW+CW 16-Bit, 10 DMX" Channels="10">
    <Import PearlRef="PHSL3006" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="eb7cc627-0112-4295-8e09-822d3fd77e64" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="7,8" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="9,10" Wheel="8" />

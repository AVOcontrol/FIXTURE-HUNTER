  <Manual Filename="\\W79\manuals\Fixtures\Clay Paky\Clay Paky Miniscan HP3" Summary="" />
  <AtlaBase TypeID="c41b7d93-67f2-4348-be21-e01baf49c35b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="128~134" Intensity="0~0" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="135~223" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="224~247" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19" If="'Colour1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~39" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="48~55" WheelPosition="3" Colour="150,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~71" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="80~87" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~103" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="112~119" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="8~15" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="24~31" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Vlt" Display="'Yel/ Vlt'" Dmx="40~47" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="56~63" WheelPosition="3" Colour="150,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="72~79" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="88~95" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="104~111" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="120~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="255,255,255" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour11" Colour="255,255,255" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour11" Colour="255,255,255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func1'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func1'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func1'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~47" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~79" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="96~111" WheelPosition="3" Colour="150,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~143" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="160~175" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="192~207" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="224~239" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~31" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="48~63" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Vlt" Display="'Yel/ Vlt'" Dmx="80~95" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="112~127" WheelPosition="3" Colour="150,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="144~159" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="176~191" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="208~223" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="240~255" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="37~73" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="74~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="111~147" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="148~184" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="185~221" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="222~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.f°',0~540" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="0~131" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="132~171" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="172~211" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="212~251" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Open" Display="'Open %.f%%',0~100" Dmx="255~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Effect_Func'==1" />
      <Condition Name="Index" ID="9" If="'Effect_Func'==2" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Warm Filter" Display="'Warm Filter'" Dmx="32~63" />
      <Function ID="3" Name="Cold Filter" Display="'Cold Filter'" Dmx="64~95" />
      <Function ID="4" Name="Light Frost" Display="'Light Frost'" Dmx="96~127" />
      <Function ID="5" Name="Heavy Frost" Display="'Heavy Frost'" Dmx="128~159" />
      <Function ID="6" Name="3 Facet Prism" Display="'3 Facet Prism'" Dmx="160~191" />
      <Function ID="7" Name="U.V. Filter" Display="'U.V. Filter'" Dmx="192~223" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="224~255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Colour_Chase" Name="Colour Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="8~247" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Pattern" Display="'No Pattern'" Dmx="0~0" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="8~247" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>

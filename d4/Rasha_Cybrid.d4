    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="6~55" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="56~105" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="106~155" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="156~205" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Motor" Display="'Reset Motor'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
  </Control>

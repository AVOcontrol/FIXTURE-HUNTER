    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="6-Facet Linear Prism" Display="'6-Facet Linear Prism'" Dmx="51~100" />
      <Function ID="3" Name="8-Facet Prism" Display="'8-Facet Prism'" Dmx="101~150" />
      <Function ID="4" Name="Frost" Display="'Frost'" Dmx="151~255" />

  <Macro>
    <Macro Name="Wired DMX">
      <Set Channel="Control:2,Shutter:1" Delay="11000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Wireless DMX">
      <Set Channel="Control:3,Shutter:1" Delay="11000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:4,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">

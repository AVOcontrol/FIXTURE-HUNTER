<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CX90 LED Profile" ShortName="CX90 Prof" Company="LightSky">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="28-06-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Red_Orange" Name="Red Orange" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rd Org C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Green_Mint" Name="Green Mint" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Mint C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="2500K" Display="'2500K'" Dmx="4~6" Colour="255,255,255" />
      <Function ID="3" Name="2800K" Display="'2800K'" Dmx="22~24" Colour="255,255,255" />
      <Function ID="4" Name="3000K" Display="'3000K'" Dmx="40~42" Colour="255,255,255" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="58~60" Colour="255,255,255" />
      <Function ID="6" Name="3500K" Display="'3500K'" Dmx="76~78" Colour="255,255,255" />
      <Function ID="7" Name="4000K" Display="'4000K'" Dmx="94~96" Colour="255,255,255" />
      <Function ID="8" Name="4500K" Display="'4500K'" Dmx="112~114" Colour="255,255,255" />
      <Function ID="9" Name="5000K" Display="'5000K'" Dmx="130~132" Colour="255,255,255" />
      <Function ID="10" Name="5500K" Display="'5500K'" Dmx="148~150" Colour="255,255,255" />
      <Function ID="11" Name="6000K" Display="'6000K'" Dmx="166~168" Colour="255,255,255" />
      <Function ID="12" Name="6500K" Display="'6500K'" Dmx="184~186" Colour="255,255,255" />
      <Function ID="13" Name="7000K" Display="'7000K'" Dmx="202~204" Colour="255,255,255" />
      <Function ID="14" Name="7500K" Display="'7500K'" Dmx="220~222" Colour="255,255,255" />
      <Function ID="15" Name="8000K" Display="'8000K'" Dmx="238~240" Colour="255,255,255" />
      <Function ID="16" Name="9000K" Display="'9000K'" Dmx="252~254" Colour="255,255,255" />
      <Function ID="17" Name="10000K" Display="'10000K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="180~249" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="120~179" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="10~49" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="50~89" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="90~119" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="LSCX90" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Red_Orange" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Green_Mint" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="UV" ChannelOffset="6" Wheel="9" />
      <Attribute ID="CTO" ChannelOffset="7" Wheel="37" />
      <Attribute ID="Colour_Macro" ChannelOffset="8" Wheel="38" />
      <Attribute ID="Dimmer" ChannelOffset="9,10" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
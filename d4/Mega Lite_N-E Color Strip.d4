  <AtlaBase TypeID="9d836700-158b-421d-b2fa-6c971b2111b4" />
  <Control>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer'" Dmx="10~10" />

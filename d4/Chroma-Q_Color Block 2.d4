<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Color Block 2" ShortName="Col Block2" Company="Chroma-Q">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>dbb9c61f-39a3-4f27-9d1e-76d3c267e30e</Thumbnail>
  <History Date="19-01-05" Author="Phil Rogers" Comment="Created" />
  <History Date="06-04-06" Author="Ed" Comment="Moved Group into special group" />
  <History Date="06-04-06" Author="Ed" Comment="Put all intensities under intensity group" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved Speed, Fan and Range into Special group" />
  <History Date="12-04-06" Author="Ed Spencer" Comment="Moved step into special group" />
  <History Date="27-07-06" Author="Phil" Comment="Added FX only mode" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed attribute IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Mode" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="02-07-09" Author="David Hunt" Comment="Added Extra Modes" />
  <History Date="01-02-10" Author="John Rogers" Comment="Fixed locate values of Red Green and Blue." />
  <History Date="02-06-11" Author="John Rogers" Comment="Added HTP dimming to Mode 8 (HSV)" />
  <History Date="14-06-11" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised highlight/lowlight.  Fixed Amber power on/locate." />
  <History Date="14-06-11" Author="Nic Morris" Comment="Added RGBA and HSI 1 and replaced in modes" />
  <History Date="14-06-11" Author="Nic Morris" Comment="Removed v-dim from mode names.  Added v-dim to all relevant modes.  Incuded Amber in v-dim." />
  <History Date="14-06-11" Author="Nic Morris" Comment="Added Look attribute and mode 16.  Added pixel mapper compatibility." />
  <History Date="25-11-11" Author="John Rogers" Comment="Removed extraneous Virtual Dimmer Attribute Links." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="14-07-16" Author="Nic Morris" Comment="Added Atlabase ID's.  Note not all channel counts match - almost certainly because Capture currently cannot simulate multi-fixture." />
  <History Date="12-10-17" Author="Nic Morris" Comment="Changed manufacturer from Chroma Q to Chroma-Q.  Changed name from Colour Block to Color Block DB4" />
  <History Date="12-10-17" Author="Nic Morris" Comment="Fixed illegal display name length (was 11 chars).  Revised attribute names, groups and wheel slots." />
  <History Date="12-10-17" Author="Nic Morris" Comment="Revised locate values.  Revised intensity attribute ID and linked to virtual dimmer for compatibility." />
  <History Date="12-10-17" Author="Nic Morris" Comment="Revised effect functions." />
  <History Date="01-10-19" Author="Nic Morris" Comment="Created from Color Block DB4 (note integrated Capture support is currently extremely limited - modes 7,8,9,14,15 and 16 only and these assume it is a single fixture)" />
  <History Date="02-10-19" Author="Nic Morris" Comment="Fixed RGBI mapping." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="be724b74-0506-4bf8-83fa-e5c32ecb2ad0" />
  <Control>
    <Attribute ID="FX_Group" Name="FX Group" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Group" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Scroll" Name="Colour Scroll" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Fan" Name="Colour Fan" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Range" Name="Colour Range" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Range" Display="'Range %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="2" Name="Full Spectrum" Display="'Full Spectrum'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Colour_Step" Name="Colour Step" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="255~255" />
      <Function ID="2" Name="Scroll Smooth" Display="'Scroll Smooth %.1f%%',0.0~100.0" Dmx="0~250" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="192~255" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="1~63" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="64~127" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Shutter_Fan" Name="Shutter Fan" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

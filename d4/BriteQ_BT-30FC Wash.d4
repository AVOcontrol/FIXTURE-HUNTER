  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="2" />
  <History Date="16-08-13" Author="Peter Budd" Comment="Created from iSolution Splendor 90." Version="3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="4" />
  <History Date="11-04-24" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added MSL modes.  Major overhaul." Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="63dc81b3-71ee-4cb7-acd0-f2027632304e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="16~35" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="36~55" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="56~75" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="76~95" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="96~115" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="116~135" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="136~155" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="156~175" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="176~195" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="196~215" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="216~235" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="5" Name="Stand Alone" Display="'Stand Alone'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colours" Display="'Colours %.f%%',0~100" Dmx="8~127" Colour="0,0,0" />
      <Function ID="3" Name="Colour Macros" Display="'Colour Macros %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Colour Fade" Display="'Colour Fade   %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fade_Speed" Name="Fade Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~239" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~247" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~37" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="38~67" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="68~97" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="98~127" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="128~157" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="158~187" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="188~217" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="218~247" WheelPosition="8" Colour="0,0,0" />
      <Function ID="10" Name="Original Colours" Display="'Original Colours'" Dmx="248~255" WheelPosition="0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Movement" Name="Movement" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Movement 1" Display="'Movement 1'" Dmx="8~67" />
      <Function ID="3" Name="Movement 2" Display="'Movement 2'" Dmx="68~127" />
      <Function ID="4" Name="Movement 3" Display="'Movement 3'" Dmx="128~187" />
      <Function ID="5" Name="Movement 4" Display="'Movement 4'" Dmx="188~247" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~67" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="68~127" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="128~187" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="188~247" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>

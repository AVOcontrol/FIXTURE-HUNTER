  <History Date="22-09-23" Author="Nic Morris" Comment="Created (poor documentation.  charts only.  contains errors.  tilt and tilt spd are listed twice.  assume channels 9 and 10 are actually pan)" Version="0" />
  <History Date="30-04-24" Author="Nic Morris" Comment="Created from Unknown 6 Eyes RGB Moving Laser Bar (hopeless documentation)" Version="1" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="56~80" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="81~105" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="106~130" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="131~155" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="156~180" />
      <Function ID="7" Name="Sound 1" Display="'Sound 1'" Dmx="181~205" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="206~230" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Chase" Name="Col Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

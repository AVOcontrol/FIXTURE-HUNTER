<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MBox Mini v4.1 Output Master" ShortName="MBoxOutput" Company="PRG">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-04-17" Author="Nic Morris" Comment="Created" />
  <History Date="08-04-17" Author="Nic Morris" Comment="Stripped invalid effects in response to additional information from manufacturer (FX #'s&gt;200)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Intensity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Base_Red" Name="Base Red" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Base Red -" Display="'Base Red - %.1f%%',100.0~0.0" Dmx="0~126" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="3" Name="Base Red +" Display="'Base Red + %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Base_Green" Name="Base Green" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Base Green -" Display="'Base Green - %.1f%%',100.0~0.0" Dmx="0~126" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="3" Name="Base Green +" Display="'Base Green + %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Base_Blue" Name="Base Blue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Base Blue -" Display="'Base Blue - %.1f%%',100.0~0.0" Dmx="0~126" Colour="255,255,255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="127~127" Colour="255,255,255" />
      <Function ID="3" Name="Base Blue +" Display="'Base Blue + %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Brightness -" Display="'Brightness - %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="127~127" />
      <Function ID="3" Name="Brightness +" Display="'Brightness + %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Contrast -" Display="'Contrast - %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="127~127" />
      <Function ID="3" Name="Contrast +" Display="'Contrast + %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_1_Mod_1, Effect_1_Mod_2, Effect_1_Mod_3, Effect_1_Mod_4, Effect_1_Mod_5" />
      <Function ID="2" Name="Hue" Display="'Hue'" Dmx="1~1" Update="Effect_1_Mod_1, Effect_1_Mod_2, Effect_1_Mod_3, Effect_1_Mod_4, Effect_1_Mod_5" />
      <Function ID="3" Name="Hue+Sat" Display="'Hue+Sat'" Dmx="2~2" Update="Effect_1_Mod_1, Effect_1_Mod_2, Effect_1_Mod_3, Effect_1_Mod_4, Effect_1_Mod_5" />

      <Function ID="2" Name="Fade 1" Display="'Fade 1'" Dmx="11~40" />
      <Function ID="3" Name="Fade 2" Display="'Fade 2'" Dmx="41~70" />
      <Function ID="4" Name="Fade 3" Display="'Fade 3'" Dmx="71~100" />
      <Function ID="5" Name="Pulse 1" Display="'Pulse 1'" Dmx="101~130" />
      <Function ID="6" Name="Pulse 2" Display="'Pulse 2'" Dmx="131~160" />
      <Function ID="7" Name="Pulse 3" Display="'Pulse 3'" Dmx="161~190" />
      <Function ID="8" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="191~220" />
      <Function ID="9" Name="Sound Pulse" Display="'Sound Pulse'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Standard" Display="'Dim Standard'" Dmx="0~0" />
      <Function ID="2" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="21~40" />
      <Function ID="3" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="41~60" />
      <Function ID="4" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="61~80" />
      <Function ID="5" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="81~100" />
      <Function ID="6" Name="Half Power on High Temp Off" Display="'Half Power on High Temp Off'" Dmx="150~155" />
      <Function ID="7" Name="Half Power on High Temp On" Display="'Half Power on High Temp On'" Dmx="200~205" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

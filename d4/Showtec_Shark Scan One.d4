  <AtlaBase TypeID="09160bf6-7865-4383-8e1c-707120a52c31" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="9" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="13~20" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="29~36" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="45~52" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="61~68" WheelPosition="4" Colour="255,0,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="77~84" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Light Green" Display="'Light Green'" Dmx="93~100" WheelPosition="6" Colour="128,255,0" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="109~116" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="UV" Display="'UV'" Dmx="125~132" WheelPosition="8" Colour="180,0,255" />
      <Function ID="10" Name="Op/ Yel" Display="'Op/ Yel'" Dmx="5~12" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="21~28" WheelPosition="1" Colour="255,255,0" />
      <Function ID="12" Name="Pk/ Grn" Display="'Pk/ Grn'" Dmx="37~44" WheelPosition="2" Colour="255,150,150" />
      <Function ID="13" Name="Grn/ Rd" Display="'Grn/ Rd'" Dmx="53~60" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Rd/ Cy" Display="'Rd/ Cy'" Dmx="69~76" WheelPosition="4" Colour="255,0,0" />
      <Function ID="15" Name="Cy/ L Grn" Display="'Cy/ L Grn'" Dmx="85~92" WheelPosition="5" Colour="0,255,255" />
      <Function ID="16" Name="L Grn/ Org" Display="'L Grn/ Org'" Dmx="101~108" WheelPosition="6" Colour="128,255,0" />
      <Function ID="17" Name="Org/ UV" Display="'Org/ UV'" Dmx="117~124" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="Open" Display="'Open'" Dmx="133~139" WheelPosition="8" Colour="180,0,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="195~140" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~200" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />

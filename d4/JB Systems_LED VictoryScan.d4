<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED VictoryScan" ShortName="JB VScan" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="03-09-13" Author="Matt Benson" Comment="Edited locate value of shutter" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="02-01-17" Author="Nic Morris" Comment="Added Atlabase ID's to 7 DMX modes.  Increased wheel resolution.  Standardised shutter locate." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8663e7cd-d840-4af2-9cdb-2c3300bb0068" />
  <Control>
    <Attribute ID="Control" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19" If="'Gobo1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~14" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="15~21" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="22~28" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="29~35" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="36~42" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="43~49" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="50~56" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="57~63" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="64~71" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="72~78" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="79~85" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="86~92" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="93~99" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="100~106" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="107~113" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="114~120" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="121~127" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="70~79" />
      <Function ID="3" Name="No BO on P/T" Display="'No BO on P/T'" Dmx="80~89" />
      <Function ID="4" Name="BO on Color" Display="'BO on Color'" Dmx="90~99" />
      <Function ID="5" Name="No BO on Color" Display="'No BO on Color'" Dmx="100~109" />
      <Function ID="6" Name="BO on Gobo" Display="'BO on Gobo'" Dmx="110~119" />
      <Function ID="7" Name="No BO on Gobo" Display="'No BO on Gobo'" Dmx="120~129" />
      <Function ID="8" Name="Safe" Display="'Safe'" Dmx="130~199" />
      <Function ID="9" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="10" Name="Safe" Display="'Safe'" Dmx="210~239" />
      <Function ID="11" Name="Stand-Alone" Display="'Stand-Alone'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="15~28" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="29~42" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="43~56" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="57~70" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="71~84" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="85~98" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="99~112" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="113~127" Colour="0,0,0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="15~21" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="22~28" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="29~35" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="36~42" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="43~49" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="50~56" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="57~63" Colour="0,0,0" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="64~70" Colour="0,0,0" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="71~77" Colour="0,0,0" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="78~84" Colour="0,0,0" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="85~91" Colour="0,0,0" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="92~98" Colour="0,0,0" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="99~108" Colour="0,0,0" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="109~112" Colour="0,0,0" />
      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="113~119" Colour="0,0,0" />
      <Function ID="17" Name="Colour 16" Display="'Colour 16'" Dmx="120~127" Colour="0,0,0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX, 8bit" Channels="1">
    <Import PearlRef="JB_VScan1CH" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Control" ChannelOffset="1" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="7 DMX, Normal" Channels="7">
    <Import PearlRef="JB_VScanNrm" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f62e437d-a051-46df-b2ed-b72cd3f77547" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Control1" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="7 DMX, Split" Channels="7">
    <Import PearlRef="JB_VScanSpl" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f2f74b3c-7c39-404d-9ceb-b128866fc6ed" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour11" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Control1" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control1:9" Delay="7000" />
      <Set Channel="Control1:0" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
      <Palette ID="9" Name="Gobo 8" Number="19" Page="1" SetControl="Gobo1:9,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
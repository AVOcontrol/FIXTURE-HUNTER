      <Function ID="14" Name="Cool White" Display="'Cool White'" Dmx="221~237" Colour="230,230,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="238~255" Colour="255,240,200" />
    </Attribute>

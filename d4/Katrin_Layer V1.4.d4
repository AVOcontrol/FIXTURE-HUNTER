    </Attribute>
    <Attribute ID="ImageAspect" Name="Image Aspect" Description="" Group="B">
      <Locate Locate="1:25" PowerOn="1:25" />
      <Function ID="1" Name="Aspect" Display="'Aspect %.2f%%',0.00~100.00" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="ImgPan" Name="Image Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ImgTilt" Name="Image Tilt" Description="" Group="P" Size="2">

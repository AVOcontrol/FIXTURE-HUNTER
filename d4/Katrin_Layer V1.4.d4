<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Layer V1.4" ShortName="Katn Layer" Company="Katrin">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="30-05-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Folder" Display="'Folder %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="File" Name="File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="File" Display="'File %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Play Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PlayMode" Name="Play Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Visible Fwd Loop" Display="'Visible Fwd Loop'" Dmx="0~0" />
      <Function ID="2" Name="Visible Fwd Stop" Display="'Visible Fwd Stop'" Dmx="1~1" />
      <Function ID="3" Name="Visible Fwd Pause" Display="'Visible Fwd Pause'" Dmx="2~2" />
      <Function ID="4" Name="Visible Fwd" Display="'Visible Fwd'" Dmx="3~3" />
      <Function ID="5" Name="Visible Fwd Stop In/Out" Display="'Visible Fwd Stop In/Out'" Dmx="4~4" />
      <Function ID="6" Name="Visible Fwd Pause In/Out" Display="'Visible Fwd Pause In/Out'" Dmx="5~5" />
      <Function ID="7" Name="Fwd Loop" Display="'Fwd Loop'" Dmx="6~6" />
      <Function ID="8" Name="Fwd Stop" Display="'Fwd Stop'" Dmx="7~7" />
      <Function ID="9" Name="Fwd Pause" Display="'Fwd Pause'" Dmx="8~8" />
      <Function ID="10" Name="Fwd In/Out" Display="'Fwd In/Out'" Dmx="9~9" />
      <Function ID="11" Name="Fwd Stop" Display="'Fwd Stop'" Dmx="10~10" />
      <Function ID="12" Name="Fwd Pause" Display="'Fwd Pause'" Dmx="11~11" />
      <Function ID="13" Name="Start Frame" Display="'Start Frame'" Dmx="12~12" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',13~255" Dmx="13~255" />
    </Attribute>
    <Attribute ID="CopyMode" Name="Copy Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Nromal" Display="'Nromal'" Dmx="0~0" />
      <Function ID="2" Name="Add" Display="'Add'" Dmx="1~1" />
      <Function ID="3" Name="Substract" Display="'Substract'" Dmx="2~2" />
      <Function ID="4" Name="Screen" Display="'Screen'" Dmx="3~3" />
      <Function ID="5" Name="Modulate" Display="'Modulate'" Dmx="4~4" />
      <Function ID="6" Name="If lighter" Display="'If lighter'" Dmx="5~5" />
      <Function ID="7" Name="If darker" Display="'If darker'" Dmx="6~6" />
      <Function ID="8" Name="Transparent white" Display="'Transparent white'" Dmx="7~7" />
      <Function ID="9" Name="Transparent black" Display="'Transparent black'" Dmx="8~8" />
      <Function ID="10" Name="Lighten" Display="'Lighten'" Dmx="9~9" />
      <Function ID="11" Name="Darken" Display="'Darken'" Dmx="10~10" />
    </Attribute>
    <Attribute ID="MaskType" Name="Mask Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Ellipse" Display="'Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Circle" Display="'Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Rectangle" Display="'Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Square" Display="'Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Vertical" Display="'Vertical'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Horizontal" Display="'Horizontal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Transparent Ellipse" Display="'Transparent Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Transparent Circle" Display="'Transparent Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Transparent Rectangle" Display="'Transparent Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Transparent Square" Display="'Transparent Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Transparent Y" Display="'Transparent Y'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Transparent X" Display="'Transparent X'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mask_Zoom" Name="Mask Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Mask_Focus" Name="Mask Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Screen3D" Name="Screen Obj 3D" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Screen" Display="'Full Screen'" Dmx="0~0" />
      <Function ID="2" Name="16:9 Correction" Display="'16:9 Correction'" Dmx="1~1" />
      <Function ID="3" Name="4:3 Correction" Display="'4:3 Correction'" Dmx="2~2" />
      <Function ID="4" Name="No Macro" Display="'No Macro'" Dmx="3~3" />
      <Function ID="5" Name="Disk" Display="'Disk'" Dmx="4~4" />
      <Function ID="6" Name="Half Cylinder 1" Display="'Half Cylinder 1'" Dmx="5~5" />
      <Function ID="7" Name="Half Cylinder 2" Display="'Half Cylinder 2'" Dmx="6~6" />
      <Function ID="8" Name="Quarter 1" Display="'Quarter 1'" Dmx="7~7" />
      <Function ID="9" Name="Quater 2" Display="'Quater 2'" Dmx="8~8" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',9~255" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Scale_X" Name="Scale X" Description="" Group="B">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Scale X" Display="'Scale X %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Scale_Y" Name="Scale Y" Description="" Group="B">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Scale Y" Display="'Scale Y %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Scale_Z" Name="Scale Z" Description="" Group="B">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Scale Z" Display="'Scale Z %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ZPos" Name="Z Position" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Z Position" Display="'Z Position %.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="X Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Rot" Display="'X Rot %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot1" Name="Y Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Rot" Display="'Y Rot %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot2" Name="Z Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Z Rot" Display="'Z Rot %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Effect1, Effect2, Effect3" />
      <Function ID="2" Name="Gamma" Display="'Gamma'" Dmx="1~1" Update="Effect1, Effect2, Effect3" />
      <Function ID="3" Name="Hue" Display="'Hue'" Dmx="2~2" Update="Effect1, Effect2, Effect3" />
      <Function ID="4" Name="Brightness" Display="'Brightness'" Dmx="3~3" Update="Effect1, Effect2, Effect3" />
      <Function ID="5" Name="RGB" Display="'RGB'" Dmx="4~4" Update="Effect1, Effect2, Effect3" />
      <Function ID="6" Name="Gamma RGB" Display="'Gamma RGB'" Dmx="5~5" Update="Effect1, Effect2, Effect3" />
      <Function ID="7" Name="Grayscale" Display="'Grayscale'" Dmx="6~6" Update="Effect1, Effect2, Effect3" />
      <Function ID="8" Name="Sepia" Display="'Sepia'" Dmx="7~7" Update="Effect1, Effect2, Effect3" />
      <Function ID="9" Name="Detect Edges" Display="'Detect Edges'" Dmx="8~8" Update="Effect1, Effect2, Effect3" />
      <Function ID="10" Name="Reserved" Display="'Reserved %.f',9~255" Dmx="9~255" Update="Effect1, Effect2, Effect3" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect Par 1" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Condition Name="Detect Edges" ID="4" If="'Effect'==9" />
      <Else ID="5" />
      <Function ID="1" Name="Black" Display="'Black %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Brightness" Display="'Brightness %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Amount X" Display="'Amount X %.f%%',0~100" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect2" Name="Effect Par 2" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Condition Name="Detect Edges" ID="4" If="'Effect'==9" />
      <Else ID="5" />
      <Function ID="1" Name="White" Display="'White %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Contrast" Display="'Contrast %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Amount Y" Display="'Amount Y %.f%%',0~100" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect3" Name="Effect Par 3" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Gamma" ID="1" If="'Effect'==2" />
      <Condition Name="Brightness" ID="2" If="'Effect'==4" />
      <Condition Name="RGB" ID="3" If="'Effect'==5" />
      <Else ID="4" />
      <Function ID="1" Name="Gamma" Display="'Gamma %.f%%',0~100" Dmx="0~255" />
      <Function ID="2" Name="Saturation" Display="'Saturation %.f%%',0~100" Dmx="0~255" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blade_1" Name="Blade 1" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Top" Display="'Top %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_2" Name="Blade 2" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Right" Display="'Right %.2f%%',0.00~100.00" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_3" Name="Blade 3" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />

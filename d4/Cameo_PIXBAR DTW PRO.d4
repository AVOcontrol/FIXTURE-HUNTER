    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',1600~6800" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
  </Control>

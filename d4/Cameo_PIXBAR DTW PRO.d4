  <AtlaBase TypeID="7c77a43a-9180-44c6-9c85-da0ba98ebcce" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Rnd Pls" Display="'Rnd Pls %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTC_Macro" Name="CTC Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1600K" Display="'1600K'" Dmx="6~20" Colour="255,255,255" />
      <Function ID="3" Name="2000K" Display="'2000K'" Dmx="21~40" Colour="255,255,255" />
      <Function ID="4" Name="2500K" Display="'2500K'" Dmx="41~60" Colour="255,255,255" />
      <Function ID="5" Name="3000K" Display="'3000K'" Dmx="61~80" Colour="255,255,255" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="81~100" Colour="255,255,255" />
      <Function ID="7" Name="3500K" Display="'3500K'" Dmx="101~120" Colour="255,255,255" />
      <Function ID="8" Name="4000K" Display="'4000K'" Dmx="121~140" Colour="255,255,255" />
      <Function ID="9" Name="4500K" Display="'4500K'" Dmx="141~160" Colour="255,255,255" />
      <Function ID="10" Name="5000K" Display="'5000K'" Dmx="161~180" Colour="255,255,255" />
      <Function ID="11" Name="5600K" Display="'5600K'" Dmx="181~200" Colour="255,255,255" />
      <Function ID="12" Name="6000K" Display="'6000K'" Dmx="201~220" Colour="255,255,255" />
      <Function ID="13" Name="6500K" Display="'6500K'" Dmx="221~240" Colour="255,255,255" />
      <Function ID="14" Name="6800K" Display="'6800K'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',1600~6800" Dmx="255~6" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Pattern" Display="'No Pattern'" Dmx="0~0" />
      <Function ID="2" Name="Level Meter" Display="'Level Meter'" Dmx="6~23" />
      <Function ID="3" Name="Meteor" Display="'Meteor'" Dmx="24~41" />
      <Function ID="4" Name="Random Raindrops" Display="'Random Raindrops'" Dmx="42~59" />
      <Function ID="5" Name="Las Vegas Style" Display="'Las Vegas Style'" Dmx="60~77" />
      <Function ID="6" Name="Bar Full" Display="'Bar Full'" Dmx="78~95" />
      <Function ID="7" Name="Bar Single" Display="'Bar Single'" Dmx="96~113" />
      <Function ID="8" Name="Night Rider" Display="'Night Rider'" Dmx="114~131" />
      <Function ID="9" Name="Tetris" Display="'Tetris'" Dmx="132~149" />
      <Function ID="10" Name="Double Bounce" Display="'Double Bounce'" Dmx="150~167" />
      <Function ID="11" Name="Fire" Display="'Fire'" Dmx="168~185" />
      <Function ID="12" Name="Double Tetris" Display="'Double Tetris'" Dmx="186~203" />
      <Function ID="13" Name="Bounce Inverse" Display="'Bounce Inverse'" Dmx="204~221" />
      <Function ID="14" Name="Chaser Inverse" Display="'Chaser Inverse'" Dmx="222~239" />
      <Function ID="15" Name="Snow" Display="'Snow'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~0" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim LED" Display="'Dim LED'" Dmx="78~79" />
      <Function ID="3" Name="Dim Halogen" Display="'Dim Halogen'" Dmx="80~81" />
      <Function ID="4" Name="DTW (Redshift) On" Display="'DTW (Redshift) On'" Dmx="82~83" />
      <Function ID="5" Name="DTW (Redshift) Off" Display="'DTW (Redshift) Off'" Dmx="84~85" />
      <Function ID="6" Name="Dim Linear" Display="'Dim Linear'" Dmx="168~169" />
      <Function ID="7" Name="Dim Exponential" Display="'Dim Exponential'" Dmx="170~171" />
      <Function ID="8" Name="Dim Logarithmic" Display="'Dim Logarithmic'" Dmx="172~173" />
      <Function ID="9" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="174~175" />

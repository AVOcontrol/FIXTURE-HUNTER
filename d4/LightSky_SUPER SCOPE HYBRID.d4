  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="31f937b0-4d02-44b7-8877-b1b316718c4d" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan High" Display="'Fan High'" Dmx="10~19" />
      <Function ID="3" Name="Fan Auto" Display="'Fan Auto'" Dmx="20~29" />
      <Function ID="4" Name="Fan Slow" Display="'Fan Slow'" Dmx="30~39" />
      <Function ID="5" Name="Reset P/T" Display="'Reset P/T'" Dmx="40~49" />
      <Function ID="6" Name="Reset CMY" Display="'Reset CMY'" Dmx="50~59" />
      <Function ID="7" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="60~69" />
      <Function ID="8" Name="Reset Frame" Display="'Reset Frame'" Dmx="70~79" />
      <Function ID="9" Name="Reset Head" Display="'Reset Head'" Dmx="80~89" />
      <Function ID="10" Name="Reset Other" Display="'Reset Other'" Dmx="90~99" />
      <Function ID="11" Name="Reset All" Display="'Reset All'" Dmx="100~109" />
      <Function ID="12" Name="Pan Invert" Display="'Pan Invert'" Dmx="130~139" />
      <Function ID="13" Name="Pan Normal" Display="'Pan Normal'" Dmx="140~149" />
      <Function ID="14" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="150~159" />
      <Function ID="15" Name="Tilt Normal" Display="'Tilt Normal'" Dmx="160~169" />
      <Function ID="16" Name="LED Freq 1kHz" Display="'LED Freq 1kHz'" Dmx="170~177" />
      <Function ID="17" Name="LED Freq 3.6kHz" Display="'LED Freq 3.6kHz'" Dmx="178~185" />
      <Function ID="18" Name="LED Freq 7.2kHz" Display="'LED Freq 7.2kHz'" Dmx="186~193" />
      <Function ID="19" Name="LED Freq 25kHz" Display="'LED Freq 25kHz'" Dmx="194~199" />
      <Function ID="20" Name="Dim Linear" Display="'Dim Linear'" Dmx="200~204" />
      <Function ID="21" Name="Dim Square 1" Display="'Dim Square 1'" Dmx="205~209" />
      <Function ID="22" Name="Dim Square 2" Display="'Dim Square 2'" Dmx="210~214" />
      <Function ID="23" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="215~219" />
      <Function ID="24" Name="Dim Fast" Display="'Dim Fast'" Dmx="220~229" />
      <Function ID="25" Name="Dim Smooth" Display="'Dim Smooth'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~23" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~41" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="42~59" Colour="0,0,255" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="60~77" Colour="255,128,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="78~95" Colour="0,128,255" />
      <Function ID="7" Name="CRI" Display="'CRI'" Dmx="96~113" Colour="255,255,255" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="194~134" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~195" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20,21,22" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>a948dfee-4a2e-4104-b510-1c752f83ea96</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1">
        <Swatch>9383db1a-319a-4fd9-8cfb-0f0eeda5b24d</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2">
        <Swatch>d515bfea-ed55-494c-831e-bb391f6405be</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3">
        <Swatch>6ffbb507-70ae-4e64-bbaf-6487dd3612fa</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4">
        <Swatch>6bd255d5-b9db-491f-b0bc-aa5f278780cf</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5">
        <Swatch>132191f6-9b11-4114-9a96-dc42d3b22f34</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6">
        <Swatch>95740673-f2b1-404d-9c56-595c56c468b5</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7">
        <Swatch>b7d3b171-8d69-4138-891c-b5cc04d9fd9f</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>a948dfee-4a2e-4104-b510-1c752f83ea96</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="80~87" WheelPosition="1">
        <Swatch>9383db1a-319a-4fd9-8cfb-0f0eeda5b24d</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="88~95" WheelPosition="2">
        <Swatch>d515bfea-ed55-494c-831e-bb391f6405be</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="96~103" WheelPosition="3">
        <Swatch>6ffbb507-70ae-4e64-bbaf-6487dd3612fa</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="104~111" WheelPosition="4">
        <Swatch>6bd255d5-b9db-491f-b0bc-aa5f278780cf</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="112~119" WheelPosition="5">
        <Swatch>132191f6-9b11-4114-9a96-dc42d3b22f34</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="120~127" WheelPosition="6">
        <Swatch>95740673-f2b1-404d-9c56-595c56c468b5</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="128~135" WheelPosition="7">
        <Swatch>b7d3b171-8d69-4138-891c-b5cc04d9fd9f</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~194" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~249" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Random" Display="'Random'" Dmx="250~255" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="10~63" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="127~64" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" />
      <Function ID="5" Name="Flickered 90°" Display="'Flickered 90° %.f%%',0~100" Dmx="192~207" />
      <Function ID="6" Name="Flickered 180°" Display="'Flickered 180° %.f%%',0~100" Dmx="208~223" />
      <Function ID="7" Name="Flickered 270°" Display="'Flickered 270° %.f%%',0~100" Dmx="224~239" />
      <Function ID="8" Name="Flickered 360°" Display="'Flickered 360° %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~68" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="140~188" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="80~128" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="10m" Display="'10m'" Dmx="128~158" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="15m" Display="'15m'" Dmx="159~190" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="20m" Display="'20m'" Dmx="191~225" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="30m" Display="'30m'" Dmx="226~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

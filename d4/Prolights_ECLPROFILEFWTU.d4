<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ECLPROFILEFWTU" ShortName="ECLPROFWTU" Company="Prolights" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="26-11-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="2~62" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="191~251" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="65~125" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~188" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display On" Display="'Display On'" Dmx="2~3" />
      <Function ID="3" Name="Display 10s" Display="'Display 10s'" Dmx="4~5" />
      <Function ID="4" Name="Display 20s" Display="'Display 20s'" Dmx="6~7" />
      <Function ID="5" Name="Display 30s" Display="'Display 30s'" Dmx="8~9" />
      <Function ID="6" Name="Display Invert" Display="'Display Invert'" Dmx="10~11" />
      <Function ID="7" Name="Display Normal" Display="'Display Normal'" Dmx="12~13" />
      <Function ID="8" Name="Key Lock On" Display="'Key Lock On'" Dmx="14~15" />
      <Function ID="9" Name="Key Lock Off" Display="'Key Lock Off'" Dmx="16~17" />
      <Function ID="10" Name="Dim Linear" Display="'Dim Linear'" Dmx="18~19" />
      <Function ID="11" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="20~21" />
      <Function ID="12" Name="Dim Square" Display="'Dim Square'" Dmx="22~23" />
      <Function ID="13" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="24~25" />
      <Function ID="14" Name="Dim Spd Auto" Display="'Dim Spd Auto'" Dmx="26~27" />
      <Function ID="15" Name="Dim Spd Fast" Display="'Dim Spd Fast'" Dmx="28~29" />
      <Function ID="16" Name="Dim Spd Med" Display="'Dim Spd Med'" Dmx="30~31" />
      <Function ID="17" Name="Dim Spd Slow" Display="'Dim Spd Slow'" Dmx="32~33" />
      <Function ID="18" Name="LED Freq 620Hz" Display="'LED Freq 620Hz'" Dmx="34~35" />
      <Function ID="19" Name="LED Freq 1200Hz" Display="'LED Freq 1200Hz'" Dmx="36~37" />
      <Function ID="20" Name="LED Freq 2000Hz" Display="'LED Freq 2000Hz'" Dmx="38~39" />
      <Function ID="21" Name="LED Freq 4000Hz" Display="'LED Freq 4000Hz'" Dmx="40~41" />
      <Function ID="22" Name="LED Freq 6000Hz" Display="'LED Freq 6000Hz'" Dmx="42~43" />
      <Function ID="23" Name="LED Freq 25KHz" Display="'LED Freq 25KHz'" Dmx="44~45" />
      <Function ID="24" Name="Fan Auto" Display="'Fan Auto'" Dmx="46~47" />
      <Function ID="25" Name="Fan Silent" Display="'Fan Silent'" Dmx="48~49" />
      <Function ID="26" Name="Fan High" Display="'Fan High'" Dmx="50~51" />
      <Function ID="27" Name="Fan Off" Display="'Fan Off'" Dmx="52~53" />
      <Function ID="28" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="54~55" />
      <Function ID="29" Name="No DMX Blackout" Display="'No DMX Blackout'" Dmx="56~57" />
      <Function ID="30" Name="No DMX Stand Alone" Display="'No DMX Stand Alone'" Dmx="58~59" />
      <Function ID="31" Name="Default" Display="'Default'" Dmx="254~255" />
    </Attribute>
  </Control>
  <Mode Name="Uno, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Basic, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>

    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Time" Display="'Time %.fms',200~4000" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RDM Disabled" Display="'RDM Disabled'" Dmx="1~10" />
      <Function ID="3" Name="RDM Enabled" Display="'RDM Enabled'" Dmx="11~20" />
      <Function ID="4" Name="Fan Silent" Display="'Fan Silent'" Dmx="101~110" />
      <Function ID="5" Name="Fan Normal" Display="'Fan Normal'" Dmx="110~120" />
      <Function ID="6" Name="Fan Full" Display="'Fan Full'" Dmx="121~130" />
      <Function ID="7" Name="Front Ext Disabled" Display="'Front Ext Disabled'" Dmx="131~140" />
      <Function ID="8" Name="Front Ext Enable" Display="'Front Ext Enable'" Dmx="141~150" />
    </Attribute>
  </Control>

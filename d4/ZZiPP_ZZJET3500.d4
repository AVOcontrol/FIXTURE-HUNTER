    </Attribute>
    <Attribute ID="Group_1_Strobe" Name="Group 1 Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Group_1_Colour" Name="Group 1 Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~36" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~56" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="57~76" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="77~96" Colour="255,100,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="97~116" Colour="255,255,0" />
      <Function ID="7" Name="Sky Blue" Display="'Sky Blue'" Dmx="117~136" Colour="0,128,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="137~156" Colour="128,0,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="157~176" Colour="255,255,255" />
      <Function ID="10" Name="R/G/B/A Col Fade (Smooth Change)" Display="'R/G/B/A Col Fade (Smooth Change)'" Dmx="177~196" Colour="0,0,0" />
      <Function ID="11" Name="All Col Fade (Smooth Change)" Display="'All Col Fade (Smooth Change)'" Dmx="197~216" Colour="0,0,0" />
      <Function ID="12" Name="R/G/B/A Col Scroll (Fast Change)" Display="'R/G/B/A Col Scroll (Fast Change)'" Dmx="217~236" Colour="0,0,0" />
      <Function ID="13" Name="All Col Scroll (Fast Change)" Display="'All Col Scroll (Fast Change)'" Dmx="237~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Group_2_Colour" Name="Group 2 Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~39" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~69" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="70~99" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="100~129" Colour="255,100,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="130~159" Colour="255,255,0" />
      <Function ID="7" Name="Sky Blue" Display="'Sky Blue'" Dmx="160~189" Colour="0,128,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="190~219" Colour="128,0,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="220~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Scroll" Name="Colour Scroll" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
  </Control>

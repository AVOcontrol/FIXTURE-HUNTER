      <Function ID="15" Name="Magenta" Display="'Magenta'" Dmx="196~209" WheelPosition="15" Colour="255,0,255" />
      <Function ID="16" Name="Blue" Display="'Blue'" Dmx="210~223" WheelPosition="16" Colour="0,0,255" />
      <Function ID="17" Name="Amber" Display="'Amber'" Dmx="224~237" WheelPosition="17" Colour="255,150,0" />
      <Function ID="18" Name="Dark Green" Display="'Dark Green'" Dmx="238~255" WheelPosition="18" Colour="0,100,0" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="20" Name="Op/ Red" Display="'Op/ Red'" Dmx="13~25" WheelPosition="1" Colour="255,255,255" />

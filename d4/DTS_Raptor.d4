      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="98~111" WheelPosition="8" Colour="255,100,0" />
      <Function ID="9" Name="Dark Blue" Display="'Dark Blue'" Dmx="112~125" WheelPosition="9" Colour="0,0,150" />
      <Function ID="10" Name="Light Red" Display="'Light Red'" Dmx="126~139" WheelPosition="10" Colour="255,100,100" />
      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="140~153" WheelPosition="11" Colour="100,0,255" />
      <Function ID="12" Name="Yellow 2" Display="'Yellow 2'" Dmx="154~167" WheelPosition="12" Colour="255,255,0" />

      <Function ID="23" Name="Grn/ Pk" Display="'Grn/ Pk'" Dmx="52~64" WheelPosition="4" Colour="0,255,0" />
      <Function ID="24" Name="Pk/ CTO" Display="'Pk/ CTO'" Dmx="65~77" WheelPosition="5" Colour="255,100,100" />
      <Function ID="25" Name="CTO/ CTB" Display="'CTO/ CTB'" Dmx="78~90" WheelPosition="6" Colour="255,255,150" />
      <Function ID="26" Name="CTB/ Org" Display="'CTB/ Org'" Dmx="91~103" WheelPosition="7" Colour="200,200,255" />
      <Function ID="27" Name="Org/ Dk Bl" Display="'Org/ Dk Bl'" Dmx="104~116" WheelPosition="8" Colour="255,100,0" />
      <Function ID="28" Name="Dk Bl/ L Red" Display="'Dk Bl/ L Red'" Dmx="117~129" WheelPosition="9" Colour="0,0,150" />
      <Function ID="29" Name="L Red/ Ppl" Display="'L Red/ Ppl'" Dmx="130~142" WheelPosition="10" Colour="255,100,100" />
      <Function ID="30" Name="Ppl/ Yel2" Display="'Ppl/ Yel2'" Dmx="143~155" WheelPosition="11" Colour="100,0,255" />
      <Function ID="31" Name="Yel2/ L Blu" Display="'Yel2/ L Blu'" Dmx="156~168" WheelPosition="12" Colour="255,255,0" />
      <Function ID="32" Name="L Blu/ L Grn" Display="'L Blu/ L Grn'" Dmx="169~181" WheelPosition="13" Colour="100,100,255" />
      <Function ID="33" Name="L Grn/ Mag" Display="'L Grn/ Mag'" Dmx="182~194" WheelPosition="14" Colour="100,255,100" />

      <Function ID="39" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
      <Function ID="40" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />

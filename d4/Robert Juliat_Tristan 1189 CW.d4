      <Function ID="2" Name="Med" Display="'Med'" Dmx="10~19" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Slow" Display="'Slow'" Dmx="20~29" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Raw" Display="'Raw'" Dmx="30~39" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Master" Name="Master" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Master" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

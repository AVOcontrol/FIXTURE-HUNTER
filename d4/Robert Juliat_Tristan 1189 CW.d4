      <Function ID="6" Name="Dim Square" Display="'Dim Square'" Dmx="41~50" />
      <Function ID="7" Name="Fan Silent" Display="'Fan Silent'" Dmx="101~110" />
      <Function ID="8" Name="Fan Normal" Display="'Fan Normal'" Dmx="111~120" />
      <Function ID="9" Name="Fan Full Power" Display="'Fan Full Power'" Dmx="121~130" />
      <Function ID="10" Name="Iris Local Off" Display="'Iris Local Off'" Dmx="161~170" />
      <Function ID="11" Name="Iris Local On" Display="'Iris Local On'" Dmx="171~180" />
      <Function ID="12" Name="Reset Motor" Display="'Reset Motor'" Dmx="181~190" />

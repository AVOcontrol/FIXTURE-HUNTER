    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Speed" ID="3" If="'Program'&gt;1&amp;&amp;'Program'&lt;16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="3" Name="Program Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Col Seq w/xfade 1" Display="'Col Seq w/xfade 1'" Dmx="16~31" Update="Shutter" />
      <Function ID="3" Name="Col Seq w/xfade 2" Display="'Col Seq w/xfade 2'" Dmx="32~47" Update="Shutter" />

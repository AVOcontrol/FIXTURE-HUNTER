      <Function ID="15" Name="Flash sync sound WRGB" Display="'Flash sync sound WRGB'" Dmx="224~239" Update="Shutter" />
      <Function ID="16" Name="Flash sync sound+col change" Display="'Flash sync sound+col change'" Dmx="240~255" Update="Shutter" />

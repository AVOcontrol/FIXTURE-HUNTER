      <Function ID="6" Name="Col Seq w/xfade 5" Display="'Col Seq w/xfade 5'" Dmx="80~95" Update="Shutter" />
      <Function ID="7" Name="Strobe WRGB" Display="'Strobe WRGB'" Dmx="96~111" Update="Shutter" />
      <Function ID="8" Name="Col Seq w/fade-in/out 1" Display="'Col Seq w/fade-in/out 1'" Dmx="112~127" Update="Shutter" />
      <Function ID="9" Name="Col Seq w/sudden changes 1" Display="'Col Seq w/sudden changes 1'" Dmx="128~143" Update="Shutter" />
      <Function ID="10" Name="Col Seq w/sudden changes+b/o" Display="'Col Seq w/sudden changes+b/o'" Dmx="144~159" Update="Shutter" />
      <Function ID="11" Name="Col Seq sudden on/fade out" Display="'Col Seq sudden on/fade out'" Dmx="160~175" Update="Shutter" />
      <Function ID="12" Name="Col Seq fade in sudden off" Display="'Col Seq fade in sudden off'" Dmx="176~191" Update="Shutter" />

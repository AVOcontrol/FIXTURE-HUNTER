      <Condition Name="LEE 700" ID="286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327" If="'Gel_Category'==10" />
      <Else ID="328" />

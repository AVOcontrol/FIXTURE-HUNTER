      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="49~55">
        <Swatch>f61ef9a1-b172-4d39-bc5c-9fcfdf94534d</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="56~62">
        <Swatch>1a0c0107-347d-4f17-91c0-f2216bde1b22</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="63~69">
        <Swatch>d8225110-77b4-46e9-9fe7-2a34adf42439</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="70~76">
        <Swatch>5cb1f1ff-16bf-41e7-adb7-d5544862b333</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="77~83">
        <Swatch>59add802-2fe0-4b1d-a1be-f2b0ef146cec</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="84~90">
        <Swatch>d4bfa6cb-151c-4357-8920-5477f330e2e8</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="91~97">
        <Swatch>b84528f6-9341-4d5b-b061-a298f3e6fc81</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="98~104">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Geist BSWF (XA-500 BSWF)" ShortName="Geist BSWF" Company="ACME" Version="18">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>371a129c-c69d-4814-a221-736558659932</Thumbnail>
  <History Date="23-10-18" Author="Nic Morris" Comment="Created (documentation is missing a lot of information.  prism rot ranges look wrong)" Version="1" />
  <History Date="25-10-18" Author="Nic Morris" Comment="Revised prism rot ranges in response to manufacturer information.  Added 29 channel mode." Version="2" />
  <History Date="25-10-18" Author="Nic Morris" Comment="Added colour names and swatches.  Added gobo swatches." Version="3" />
  <History Date="31-10-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Inverted zoom in response to manufacturer information." Version="4" />
  <History Date="03-11-18" Author="Nic Morris" Comment="Revised prism functions in line with latest charts (previously had two prisms)." Version="5" />
  <History Date="03-11-18" Author="Nic Morris" Comment="Changed blades to 2-point system and renamed.  Calibration may still need to be revised but at least default should be open beam." Version="6" />
  <History Date="11-11-18" Author="Nic Morris" Comment="Revised blade assignment for Attribute Editor" Version="7" />
  <History Date="12-12-18" Author="Nic Morris" Comment="Added default RDM mode ID's in response to manufacturer request." Version="8" />
  <History Date="21-12-18" Author="Nic Morris" Comment="Revised blade assignments again in line with updated calibration drawings." Version="9" />
  <History Date="09-01-19" Author="Nic Morris" Comment="Yet another update (adds mode 4)" Version="10" />
  <History Date="11-01-19" Author="Nic Morris" Comment="Added Atlabase ID to mode 4" Version="11" />
  <History Date="19-08-19" Author="Nic Morris" Comment="Added LED freq setting and autofocus control functions and macros in line with latest charts in repsonse to manufacturer request." Version="12" />
  <History Date="19-08-19" Author="Nic Morris" Comment="Added missing default RDM personality ID to mode 4." Version="13" />
  <History Date="09-06-20" Author="Nic Morris" Comment="Created from ACME XA-1000 BSWF" Version="14" />
  <History Date="10-06-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="15" />
  <History Date="08-07-20" Author="Nic Morris" Comment="Reversed gobo 1 swatch order in response to manufacturer request." Version="16" />
  <History Date="24-07-24" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds 35 channel mode, removes autofocus and adds standard and quiet control functions/macros)." Version="17" />
  <History Date="25-07-24" Author="Nic Morris" Comment="Added Atlabase ID for 35 channel mode." Version="18" />
  <Manual Filename="" Summary="" />

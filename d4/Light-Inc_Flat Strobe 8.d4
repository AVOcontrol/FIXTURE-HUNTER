<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Flat Strobe 8" ShortName="Flat Strb8" Company="Light-Inc">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="18-07-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~24" Update="Auto_Spd" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="25~49" Update="Auto_Spd" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="50~74" Update="Auto_Spd" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="75~99" Update="Auto_Spd" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="100~124" Update="Auto_Spd" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="125~149" Update="Auto_Spd" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="150~174" Update="Auto_Spd" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="175~199" Update="Auto_Spd" />
      <Function ID="10" Name="Sound 1" Display="'Sound 1'" Dmx="200~224" Update="Auto_Spd" />
      <Function ID="11" Name="Sound 2" Display="'Sound 2'" Dmx="225~249" Update="Auto_Spd" />
      <Function ID="12" Name="Sound 3" Display="'Sound 3'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'&gt;9" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

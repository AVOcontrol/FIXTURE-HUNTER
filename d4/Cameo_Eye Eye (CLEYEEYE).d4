<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Eye Eye (CLEYEEYE)" ShortName="Eye Eye" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-10-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~249" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="64~79" Colour="255,100,0" />
      <Function ID="6" Name="Red/Green" Display="'Red/Green'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="Red/Amber" Display="'Red/Amber'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="Green/Blue" Display="'Green/Blue'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="Green/Amber" Display="'Green/Amber'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="Blue/Amber" Display="'Blue/Amber'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="176~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Sound 1" Display="'Sound 1'" Dmx="11~22" Update="Auto_Spd" />
      <Function ID="3" Name="Sound 2" Display="'Sound 2'" Dmx="23~29" Update="Auto_Spd" />
      <Function ID="4" Name="Sound 3" Display="'Sound 3'" Dmx="30~36" Update="Auto_Spd" />
      <Function ID="5" Name="Sound 4" Display="'Sound 4'" Dmx="37~43" Update="Auto_Spd" />
      <Function ID="6" Name="Sound 5" Display="'Sound 5'" Dmx="44~50" Update="Auto_Spd" />
      <Function ID="7" Name="Sound 6" Display="'Sound 6'" Dmx="51~57" Update="Auto_Spd" />
      <Function ID="8" Name="Sound 7" Display="'Sound 7'" Dmx="58~64" Update="Auto_Spd" />
      <Function ID="9" Name="Sound 8" Display="'Sound 8'" Dmx="65~71" Update="Auto_Spd" />
      <Function ID="10" Name="Sound 9" Display="'Sound 9'" Dmx="72~78" Update="Auto_Spd" />
      <Function ID="11" Name="Sound 10" Display="'Sound 10'" Dmx="79~85" Update="Auto_Spd" />
      <Function ID="12" Name="Sound 11" Display="'Sound 11'" Dmx="86~92" Update="Auto_Spd" />
      <Function ID="13" Name="Sound 12" Display="'Sound 12'" Dmx="93~99" Update="Auto_Spd" />
      <Function ID="14" Name="Sound 13" Display="'Sound 13'" Dmx="100~106" Update="Auto_Spd" />
      <Function ID="15" Name="Sound 14" Display="'Sound 14'" Dmx="107~113" Update="Auto_Spd" />
      <Function ID="16" Name="Sound 15" Display="'Sound 15'" Dmx="114~120" Update="Auto_Spd" />
      <Function ID="17" Name="Sound 16" Display="'Sound 16'" Dmx="121~127" Update="Auto_Spd" />
      <Function ID="18" Name="Auto Combination" Display="'Auto Combination'" Dmx="128~141" Update="Auto_Spd" />
      <Function ID="19" Name="Auto 1" Display="'Auto 1'" Dmx="142~147" Update="Auto_Spd" />
      <Function ID="20" Name="Auto 2" Display="'Auto 2'" Dmx="148~153" Update="Auto_Spd" />
      <Function ID="21" Name="Auto 3" Display="'Auto 3'" Dmx="154~159" Update="Auto_Spd" />
      <Function ID="22" Name="Auto 4" Display="'Auto 4'" Dmx="160~165" Update="Auto_Spd" />
      <Function ID="23" Name="Auto 5" Display="'Auto 5'" Dmx="166~171" Update="Auto_Spd" />
      <Function ID="24" Name="Auto 6" Display="'Auto 6'" Dmx="172~177" Update="Auto_Spd" />
      <Function ID="25" Name="Auto 7" Display="'Auto 7'" Dmx="178~183" Update="Auto_Spd" />
      <Function ID="26" Name="Auto 8" Display="'Auto 8'" Dmx="184~189" Update="Auto_Spd" />
      <Function ID="27" Name="Auto 9" Display="'Auto 9'" Dmx="190~195" Update="Auto_Spd" />
      <Function ID="28" Name="Auto 10" Display="'Auto 10'" Dmx="196~201" Update="Auto_Spd" />
      <Function ID="29" Name="Auto 11" Display="'Auto 11'" Dmx="202~207" Update="Auto_Spd" />
      <Function ID="30" Name="Auto 12" Display="'Auto 12'" Dmx="208~213" Update="Auto_Spd" />
      <Function ID="31" Name="Auto 13" Display="'Auto 13'" Dmx="214~219" Update="Auto_Spd" />
      <Function ID="32" Name="Auto 14" Display="'Auto 14'" Dmx="220~225" Update="Auto_Spd" />
      <Function ID="33" Name="Auto 15" Display="'Auto 15'" Dmx="226~231" Update="Auto_Spd" />
      <Function ID="34" Name="Auto 16" Display="'Auto 16'" Dmx="232~237" Update="Auto_Spd" />
      <Function ID="35" Name="Auto 17" Display="'Auto 17'" Dmx="238~243" Update="Auto_Spd" />
      <Function ID="36" Name="Auto 18" Display="'Auto 18'" Dmx="244~249" Update="Auto_Spd" />
      <Function ID="37" Name="Auto 19" Display="'Auto 19'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;18" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMEYE2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKCMEYE3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKCMEYE4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="4" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Colour1" Wheel="8" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="7" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="8" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Blackout" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:5" />
      <Palette ID="4" Name="Amber" Number="4" Page="1" SetControl="Colour1:5" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="8" Name="Blackout" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:4" />
      <Palette ID="12" Name="Blackout" Number="10" Page="1" SetControl="Colour1:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Blackout" Number="8" Page="1" SetControl="Colour1:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
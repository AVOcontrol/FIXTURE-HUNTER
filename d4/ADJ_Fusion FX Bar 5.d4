<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Fusion FX Bar 5" ShortName="Fsn FXbar5" Company="ADJ" Version="2">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>68cace55-8ef2-4556-88f4-59977edaac3f</Thumbnail>
  <History Date="11-01-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Fusion FX Bar 5.d4 to ADJ_Fusion FX Bar 5.d4." Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="248~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red+Green" Display="'Red+Green'" Dmx="19~36" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~54" Colour="255,255,255" />
      <Function ID="4" Name="Green+Blue" Display="'Green+Blue'" Dmx="55~73" Colour="255,255,255" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="74~91" Colour="255,255,255" />
      <Function ID="6" Name="Red+Blue" Display="'Red+Blue'" Dmx="92~109" Colour="255,255,255" />
      <Function ID="7" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="110~127" Colour="255,255,255" />
      <Function ID="8" Name="Red - Green" Display="'Red - Green'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="9" Name="Green - Blue" Display="'Green - Blue'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="10" Name="Red - Blue" Display="'Red - Blue'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="11" Name="Red - Green - Blue" Display="'Red - Green - Blue'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Flower_Rot" Name="Flower Rot" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" Colour="0,0,0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" Colour="0,0,0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" Colour="0,0,0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red_Laser" Name="Red Laser" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Green_Laser" Name="Green Laser" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="E">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
        <Attribute ID="Flower_Rot" ChannelOffset="4" Wheel="9" />
        <Attribute ID="Red_Laser" ChannelOffset="5" Wheel="19" />
        <Attribute ID="Green_Laser" ChannelOffset="6" Wheel="20" />
        <Attribute ID="Laser_Rot" ChannelOffset="7" Wheel="21" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Flower" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="68cace55-8ef2-4556-88f4-59977edaac3f"></Swatch>
  </swatchLibrary>
</Fixture>
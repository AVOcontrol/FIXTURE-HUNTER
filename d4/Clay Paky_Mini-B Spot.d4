  <History Date="22-03-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="01-06-23" Author="Nic Morris" Comment="Updated in line with latest charts (changes colour func to virtual, reduces channel count to 18 and adds col mode control functions and macros)" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b209cf19-49ae-48d7-931b-658e6cce9f8c" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19" If="'Colour1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="10~14" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="20~24" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~34" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="CTO" Display="'CTO'" Dmx="40~44" WheelPosition="4" Colour="255,240,200" />
      <Function ID="6" Name="Light Orange" Display="'Light Orange'" Dmx="50~54" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Dark Orange" Display="'Dark Orange'" Dmx="60~64" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="Navy Blue" Display="'Navy Blue'" Dmx="70~74" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ B Blu" Display="'D Rd/ B Blu'" Dmx="15~19" WheelPosition="1" Colour="180,0,0" />
      <Function ID="11" Name="B Blu/ Grn" Display="'B Blu/ Grn'" Dmx="25~29" WheelPosition="2" Colour="0,0,255" />
      <Function ID="12" Name="Grn/ CTO" Display="'Grn/ CTO'" Dmx="35~39" WheelPosition="3" Colour="0,255,0" />
      <Function ID="13" Name="CTO/ L Org" Display="'CTO/ L Org'" Dmx="45~49" WheelPosition="4" Colour="255,240,200" />
      <Function ID="14" Name="L Org/ D Org" Display="'L Org/ D Org'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="D Org/ N Blu" Display="'D Org/ N Blu'" Dmx="65~69" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="N Blu/ Op" Display="'N Blu/ Op'" Dmx="75~79" WheelPosition="7" Colour="0,0,255" />
      <Function ID="17" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="80~127" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>b2cd20ca-59b2-41a0-8eba-5272f5529502</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="9~17" WheelPosition="1">
        <Swatch>f6e6efc9-45d0-4382-9124-df01c11469d7</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="18~26" WheelPosition="2">
        <Swatch>a2215423-1ac3-495b-a83a-44ffd37cc98e</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="27~35" WheelPosition="3">
        <Swatch>807acd2d-3793-4f4d-a029-1283484e4959</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="36~44" WheelPosition="4">
        <Swatch>33a78d54-10dd-4069-986b-72fd3ea38bdc</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="45~53" WheelPosition="5">
        <Swatch>d7fa5e27-8495-4ad4-96f2-053fc60e3a93</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="54~62" WheelPosition="6">
        <Swatch>93edafd3-30d6-488f-b41f-e514b86af129</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="63~71" WheelPosition="7">
        <Swatch>479ca5a2-2b2b-476a-83b3-a120ee0b2030</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>b2cd20ca-59b2-41a0-8eba-5272f5529502</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="160~173" WheelPosition="1">
        <Swatch>f6e6efc9-45d0-4382-9124-df01c11469d7</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="174~187" WheelPosition="2">
        <Swatch>a2215423-1ac3-495b-a83a-44ffd37cc98e</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="188~200" WheelPosition="3">
        <Swatch>807acd2d-3793-4f4d-a029-1283484e4959</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="201~214" WheelPosition="4">
        <Swatch>33a78d54-10dd-4069-986b-72fd3ea38bdc</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="215~227" WheelPosition="5">
        <Swatch>d7fa5e27-8495-4ad4-96f2-053fc60e3a93</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="228~241" WheelPosition="6">
        <Swatch>93edafd3-30d6-488f-b41f-e514b86af129</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="242~255" WheelPosition="7">
        <Swatch>479ca5a2-2b2b-476a-83b3-a120ee0b2030</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="114~117" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="159~118" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll %.f%%',0~100" Dmx="114~117" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="113~72" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~48830" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49087~49344" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

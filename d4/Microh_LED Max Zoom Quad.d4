  <History Date="01-09-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e807121a-d89e-40fe-bf95-425e60dba3f7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;23" />
      <Condition Name="Sensitivity" ID="4" If="'Colour_Macro'&gt;22" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Update="Shutter" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Update="Shutter" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Update="Shutter" Colour="0,0,255" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="64~79" Update="Shutter" Colour="128,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="80~95" Update="Shutter" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="96~111" Update="Shutter" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="112~127" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="Mixing 1" Display="'Mixing 1'" Dmx="128~135" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="Mixing 2" Display="'Mixing 2'" Dmx="136~143" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="Mixing 3" Display="'Mixing 3'" Dmx="144~151" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="Mixing 4" Display="'Mixing 4'" Dmx="152~159" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="Mixing 5" Display="'Mixing 5'" Dmx="160~167" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="Mixing 6" Display="'Mixing 6'" Dmx="168~175" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="Mixing 7" Display="'Mixing 7'" Dmx="176~183" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="Mixing 8" Display="'Mixing 8'" Dmx="184~191" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Change 1" Display="'Change 1'" Dmx="192~199" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Change 2" Display="'Change 2'" Dmx="200~207" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="Change 3" Display="'Change 3'" Dmx="208~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="Change 4" Display="'Change 4'" Dmx="216~223" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="Change 5" Display="'Change 5'" Dmx="224~231" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="Change 6" Display="'Change 6'" Dmx="232~239" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="240~247" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="248~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="MMLMZMQ5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

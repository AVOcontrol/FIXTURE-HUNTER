<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IW108-RGBW Zoom" ShortName="IW-108 Zm" Company="Dialighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="01-07-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~50" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Natural" Display="'Natural'" Dmx="255~255" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~236" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Moroccan Pink" Display="'Moroccan Pink'" Dmx="10~14" Colour="255,150,150" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="15~19" Colour="255,150,150" />
      <Function ID="4" Name="Special Rose Pink" Display="'Special Rose Pink'" Dmx="20~24" Colour="255,150,150" />
      <Function ID="5" Name="Follies Pink" Display="'Follies Pink'" Dmx="25~29" Colour="255,150,150" />
      <Function ID="6" Name="Fuchsia Pink" Display="'Fuchsia Pink'" Dmx="30~34" Colour="255,150,150" />
      <Function ID="7" Name="Surprise Pink" Display="'Surprise Pink'" Dmx="35~39" Colour="255,150,150" />
      <Function ID="8" Name="Congo Blue" Display="'Congo Blue'" Dmx="40~44" Colour="0,0,255" />
      <Function ID="9" Name="Tokyo Blue" Display="'Tokyo Blue'" Dmx="45~49" Colour="0,0,255" />
      <Function ID="10" Name="Deep Blue" Display="'Deep Blue'" Dmx="50~54" Colour="0,0,255" />
      <Function ID="11" Name="Just Blue" Display="'Just Blue'" Dmx="55~59" Colour="0,0,255" />
      <Function ID="12" Name="Medium Blue" Display="'Medium Blue'" Dmx="60~64" Colour="0,0,255" />
      <Function ID="13" Name="Double CT Blue" Display="'Double CT Blue'" Dmx="65~69" Colour="0,0,255" />
      <Function ID="14" Name="Slate Blue" Display="'Slate Blue'" Dmx="70~74" Colour="220,240,255" />
      <Function ID="15" Name="Full CT Blue" Display="'Full CT Blue'" Dmx="75~79" Colour="230,230,255" />
      <Function ID="16" Name="Half CT Blue" Display="'Half CT Blue'" Dmx="80~84" Colour="230,230,255" />
      <Function ID="17" Name="Steel Blue" Display="'Steel Blue'" Dmx="85~89" Colour="230,230,255" />
      <Function ID="18" Name="Lighter Blue" Display="'Lighter Blue'" Dmx="90~94" Colour="0,128,255" />
      <Function ID="19" Name="Light Blue" Display="'Light Blue'" Dmx="95~99" Colour="0,128,255" />
      <Function ID="20" Name="Medium Blue Green" Display="'Medium Blue Green'" Dmx="100~104" Colour="0,255,128" />
      <Function ID="21" Name="Dark Green" Display="'Dark Green'" Dmx="105~109" Colour="0,180,0" />
      <Function ID="22" Name="Primary Green" Display="'Primary Green'" Dmx="110~114" Colour="0,255,0" />
      <Function ID="23" Name="Moss Green" Display="'Moss Green'" Dmx="115~119" Colour="0,255,0" />
      <Function ID="24" Name="Fern Green" Display="'Fern Green'" Dmx="120~124" Colour="0,255,0" />
      <Function ID="25" Name="JAS Green" Display="'JAS Green'" Dmx="125~129" Colour="0,255,0" />
      <Function ID="26" Name="Lime Green" Display="'Lime Green'" Dmx="130~134" Colour="128,255,0" />
      <Function ID="27" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="135~139" Colour="255,255,0" />
      <Function ID="28" Name="Deep Amber" Display="'Deep Amber'" Dmx="140~144" Colour="255,100,0" />
      <Function ID="29" Name="Chrome Orange" Display="'Chrome Orange'" Dmx="145~149" Colour="255,128,0" />
      <Function ID="30" Name="Orange" Display="'Orange'" Dmx="150~154" Colour="255,128,0" />
      <Function ID="31" Name="Gold Amber" Display="'Gold Amber'" Dmx="155~159" Colour="255,100,0" />
      <Function ID="32" Name="Millennium Gold" Display="'Millennium Gold'" Dmx="160~164" Colour="255,128,0" />
      <Function ID="33" Name="Deep Golden Amber" Display="'Deep Golden Amber'" Dmx="165~169" Colour="255,100,0" />
      <Function ID="34" Name="Flame Red" Display="'Flame Red'" Dmx="170~174" Colour="255,0,0" />
      <Function ID="35" Name="Open" Display="'Open'" Dmx="175~179" Colour="255,255,255" />
      <Function ID="36" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="180~201" Colour="0,0,0" />
      <Function ID="37" Name="No Scroll" Display="'No Scroll'" Dmx="202~207" Colour="255,255,255" />
      <Function ID="38" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="208~229" Colour="0,0,0" />
      <Function ID="39" Name="Open" Display="'Open'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="40" Name="Rand Fast" Display="'Rand Fast'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="41" Name="Rand Medium" Display="'Rand Medium'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="42" Name="Rand Slow" Display="'Rand Slow'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="43" Name="Open" Display="'Open'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="20~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="DA108ZM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="3,4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5,6" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="7" />
      <Attribute ID="CTO" ChannelOffset="13" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="14" Wheel="19" />
    </Include>
  </Mode>

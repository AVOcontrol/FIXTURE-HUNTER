    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Black/White" ID="2" If="'CEff'==13||'CEff'==14||'CEff'==15||'CEff'==17||'CEff'==24||'CEff'==25||'CEff'==26||'CEff'==27||'CEff'==28||'CEff'==29||'CEff'==30||'CEff'==31||'CEff'==32||'CEff'==33||'CEff'==34||'CEff'==35||'CEff'==42||'CEff'==43" />
      <Condition Name="Mask" ID="3" If="'CEff'==18||'CEff'==19||'CEff'==20||'CEff'==21||'CEff'==22||'CEff'==23" />
      <Condition Name="Gamma" ID="4" If="'CEff'==36||'CEff'==37" />
      <Condition Name="Color Gain Sep" ID="5" If="'CEff'==38" />
      <Condition Name="Convert to YUV" ID="6" If="'CEff'==40" />
      <Condition Name="Saturation" ID="7" If="'CEff'==41||'CEff'==42" />
      <Condition Name="Fade to Hue" ID="8" If="'CEff'==57" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="No Func" Display="'No Func'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Mask" Display="'Mask %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Gamma" Display="'Gamma %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Col Gain" Display="'Col Gain %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="6" Name="Intensity" Display="'Intensity %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Saturation" Display="'Saturation %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Fade %" Display="'Fade %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Black/White" ID="2" If="'CEff'==13||'CEff'==14||'CEff'==15||'CEff'==17||'CEff'==24||'CEff'==25||'CEff'==26||'CEff'==27||'CEff'==28||'CEff'==29||'CEff'==30||'CEff'==31||'CEff'==32||'CEff'==33||'CEff'==34||'CEff'==42||'CEff'==43||'CEff'==35" />
      <Condition Name="Mask" ID="8" If="'CEff'==18||'CEff'==19||'CEff'==20||'CEff'==21||'CEff'==22||'CEff'==23" />
      <Condition Name="Gamma" ID="3" If="'CEff'==36" />

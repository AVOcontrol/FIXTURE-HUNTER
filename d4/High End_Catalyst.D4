      <Function ID="2" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="1~24" Intensity="0~0" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="25~49" Intensity="0~0" />

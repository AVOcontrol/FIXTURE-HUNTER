    <Attribute ID="Effect_Func" Name="FX Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Gobo" Display="'Gobo'" Dmx="0~4" Update="VisualEffect1, VisualEffect2" />
      <Function ID="2" Name="Wobble" Display="'Wobble'" Dmx="5~9" Update="VisualEffect1, VisualEffect2" />
      <Function ID="3" Name="Tile" Display="'Tile'" Dmx="10~19" Update="VisualEffect1, VisualEffect2" />

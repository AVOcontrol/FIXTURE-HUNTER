  <History Date="14-12-04" Author="Tom" Comment="Checked" Version="2" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 1: Could do with merging with other Catalyst personalities." Version="3" />
  <History Date="05-04-06" Author="Ed" Comment="Changed Aspect Ratio to beam" Version="4" />
  <History Date="06-04-06" Author="Ed" Comment="Moved all keystoning to Beam group" Version="5" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved Param 1 and 2 into special group" Version="6" />
  <History Date="11-04-06" Author="Ed Spencer" Comment="Moved Scale into beam group" Version="7" />
  <History Date="12-04-06" Author="Ed Spencer" Comment="Moved trail into Effect group and moved visual Effect into effect group" Version="8" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="9" />
  <History Date="28-09-09" Author="Gregory Haynes" Comment="Changed Dimmer power on value to 0" Version="10" />
  <History Date="28-01-11" Author="Gregory Haynes" Comment="Updated keystone attributes for Titan attribute control" Version="11" />
  <History Date="28-01-11" Author="Gregory Haynes" Comment="Merged Catalyst personalities into one file" Version="12" />
  <History Date="09-02-11" Author="John Rogers" Comment="Edited ranges types in Mask Rotate. Corrected Blue locate value." Version="13" />
  <History Date="09-02-11" Author="John Rogers" Comment="Corrected Highlight/Lowlight values." Version="14" />
  <History Date="01-03-11" Author="John Rogers" Comment="Inverted ranges of Keystone X3, Y1 X4 and Y4 attributes." Version="15" />
  <History Date="01-03-11" Author="John Rogers" Comment="Added Layer Select and Video Switcher modes." Version="16" />
  <History Date="03-08-11" Author="Nic Morris" Comment="Changed Gobo size, Scale, xpos and ypos to single 16bit raw range in response to customer." Version="17" />
  <History Date="03-08-11" Author="Nic Morris" Comment="Removed X Rot update from Y Rot Func.  Adjusted rotate functions.  Increased wheel resolution." Version="18" />
  <History Date="03-08-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed non-existant attributes from Colour Eff update." Version="19" />
  <History Date="03-08-11" Author="Nic Morris" Comment="Removed parameter update from visual eff.  There was nothing to update." Version="20" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" Version="21" />
  <History Date="10-12-12" Author="Peter Budd" Comment="Edited added Raw DMX range to Visual FX and Colour FX." Version="22" />
  <History Date="10-12-12" Author="Peter Budd" Comment="Put lots of ranges into Library and File channels" Version="23" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." Version="24" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="25" />
  <History Date="16-07-21" Author="Nic Morris" Comment="Added more functions to Play Mode in 40 DMX mode." Version="26" />

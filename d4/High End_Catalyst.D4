    <Attribute ID="VisualEffect1" Name="Vis Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Gobo" ID="1,2,3,4,5,6,7,8" If="'Effect_Func'==1" />
      <Condition Name="Wobble" ID="9,10" If="'Effect_Func'==2" />
      <Condition Name="Tile" ID="11,12,13,14,15,16,17,18" If="'Effect_Func'==3" />

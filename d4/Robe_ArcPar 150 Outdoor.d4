  <Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:2,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">
      <Set Channel="Control:3,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="RGBW Mode">

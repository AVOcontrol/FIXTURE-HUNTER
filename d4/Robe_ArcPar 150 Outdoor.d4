    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Variable" Display="'%.fK',2700~8000" Dmx="255~0" Colour="255,255,255" />
      <Function ID="2" Name="8000K" Display="'8000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="64~64" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="192~192" Colour="255,255,255" />
      <Function ID="6" Name="2700K" Display="'2700K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mix_Func" Name="Col Mix Func" Description="" Group="S">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Virtual" Display="'Virtual'" Dmx="0~0" />
      <Function ID="2" Name="Maximum" Display="'Maximum'" Dmx="10~19" />
      <Function ID="3" Name="Minimum" Display="'Minimum'" Dmx="20~29" />
      <Function ID="4" Name="Multiply" Display="'Multiply'" Dmx="30~39" />
      <Function ID="5" Name="Addition" Display="'Addition'" Dmx="45~45" />
      <Function ID="6" Name="Subtraction" Display="'Subtraction'" Dmx="50~59" />
      <Function ID="7" Name="Inv Subtract" Display="'Inv Subtract'" Dmx="60~69" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',70~128" Dmx="70~128" />
      <Function ID="9" Name="Virtual" Display="'Virtual'" Dmx="129~129" />
      <Function ID="10" Name="Crossfade" Display="'Crossfade %.1f%%',0.0~100.0" Dmx="130~254" />
      <Function ID="11" Name="Colour Mix" Display="'Colour Mix'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="159~144" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

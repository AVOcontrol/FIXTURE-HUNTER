<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AtmosFear Tour HZ" ShortName="AtFr Tr HZ" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="22-10-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Switch" Name="Switch" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~127" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fog" Name="Fog" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKBLAFHZ" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Switch" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="24" />
      <Attribute ID="Fog" ChannelOffset="3" Wheel="23" />
    </Include>
  </Mode>
</Fixture>
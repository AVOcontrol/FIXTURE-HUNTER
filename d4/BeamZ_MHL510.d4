      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="White" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Auto" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="10" Wheel="24" />
      <Attribute ID="Tilt_Speed" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="17 DMX" Channels="17">

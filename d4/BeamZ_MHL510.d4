      <Function ID="35" Name="Sound No Tilt 7" Display="'Sound No Tilt 7'" Dmx="232~238" />
      <Function ID="36" Name="Sound No Tilt 8" Display="'Sound No Tilt 8'" Dmx="239~245" />
      <Function ID="37" Name="Sound No Tilt 9" Display="'Sound No Tilt 9'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="2~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~61" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="62~91" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="92~121" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="122~151" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="152~181" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="182~211" Colour="255,255,255" />
      <Function ID="9" Name="R+G" Display="'R+G'" Dmx="212~241" Colour="255,255,255" />
      <Function ID="10" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="242~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~254" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKBZM510" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="1,2" Wheel="3" />

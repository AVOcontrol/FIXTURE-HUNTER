<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dragonfly Quad" ShortName="DragonflyQ" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="16-12-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~69" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="70~131" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="132~193" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~131" Intensity="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~7" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="8~22" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="23~37" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="38~52" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="53~67" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="68~82" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="83~97" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="98~112" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="113~127" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="128~142" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="143~157" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="158~172" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="173~187" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="188~202" />
      <Function ID="15" Name="Chase 14" Display="'Chase 14'" Dmx="203~217" />
      <Function ID="16" Name="Chase 15" Display="'Chase 15'" Dmx="218~232" />
      <Function ID="17" Name="Chase 16" Display="'Chase 16'" Dmx="233~247" />
      <Function ID="18" Name="Full On" Display="'Full On'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~23" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="32~39" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="17" Name="Col Change" Display="'Col Change %.1f%%',0.0~100.0" Dmx="128~247" Colour="255,255,255" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tilt1" Name="Tilt 1" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt2" Name="Tilt 2" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

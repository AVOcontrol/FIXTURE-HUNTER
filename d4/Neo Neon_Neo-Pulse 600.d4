<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Neo-Pulse 600" ShortName="Pulse 600" Company="Neo Neon">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="14-02-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Program" ID="8,9,10" If="'Auto'&gt;1" />
      <Else ID="1,2,3,4,5,6,7" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="250~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="58~105" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="154~201" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="202~249" Intensity="0~0" />
      <Function ID="7" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="106~153" Intensity="0~0" />
      <Function ID="8" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="250~255" Intensity="0~0" />
      <Function ID="10" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Update="Shutter" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="10~19" Update="Shutter" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="20~39" Update="Shutter" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="40~59" Update="Shutter" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="60~79" Update="Shutter" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="80~99" Update="Shutter" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="100~119" Update="Shutter" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="120~139" Update="Shutter" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="140~159" Update="Shutter" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="160~179" Update="Shutter" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="180~199" Update="Shutter" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="200~219" Update="Shutter" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="220~239" Update="Shutter" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="240~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Short" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="2" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>

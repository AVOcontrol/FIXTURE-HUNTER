        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="2" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="7" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="8" ModeLink="Cell" X="1" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Cell 9" ChannelOffset="9" ModeLink="Cell" X="2" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="Cell 10" ChannelOffset="10" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell11" Name="Cell 11" ChannelOffset="11" ModeLink="Cell" X="1" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell12" Name="Cell 12" ChannelOffset="12" ModeLink="Cell" X="2" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Full" Channels="17">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Auto" ChannelOffset="15" Wheel="23" />
        <Attribute ID="Auto_Spd" ChannelOffset="16" Wheel="24" />
        <Attribute ID="Fade" ChannelOffset="17" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="5" ModeLink="Cell" X="2" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="7" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="8" ModeLink="Cell" X="2" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="9" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="10" ModeLink="Cell" X="1" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Cell 9" ChannelOffset="11" ModeLink="Cell" X="2" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="Cell 10" ChannelOffset="12" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell11" Name="Cell 11" ChannelOffset="13" ModeLink="Cell" X="1" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

      <Function ID="21" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="108~111" WheelPosition="4" />
      <Function ID="22" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="104~107" WheelPosition="5" />
      <Function ID="23" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="100~103" WheelPosition="6" />
      <Function ID="24" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="96~99" WheelPosition="7" />
      <Function ID="25" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="92~95" WheelPosition="8" />
      <Function ID="26" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="88~91" WheelPosition="9" />
      <Function ID="27" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="84~87" WheelPosition="10" />
      <Function ID="28" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="80~83" WheelPosition="11" />
      <Function ID="29" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="76~79" WheelPosition="12" />
      <Function ID="30" Name="Gobo 13 Shake" Display="'Gobo 13 Shake  %.f%%',0~100" Dmx="72~75" WheelPosition="13" />
      <Function ID="31" Name="Gobo 14 Shake" Display="'Gobo 14 Shake  %.f%%',0~100" Dmx="68~71" WheelPosition="14" />
      <Function ID="32" Name="Gobo 15 Shake" Display="'Gobo 15 Shake  %.f%%',0~100" Dmx="64~67" WheelPosition="15" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="34" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="35" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="36" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="37" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="80~84" />
      <Function ID="3" Name="Reset Colour" Display="'Reset Colour'" Dmx="85~89" />
      <Function ID="4" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="90~94" />
      <Function ID="5" Name="Reset Int" Display="'Reset Int'" Dmx="95~99" />
      <Function ID="6" Name="Move in Dark" Display="'Move in Dark'" Dmx="100~109" />
      <Function ID="7" Name="Col in Dark" Display="'Col in Dark'" Dmx="110~119" />
      <Function ID="8" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="120~129" />
      <Function ID="9" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="10" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="11" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
      <Function ID="12" Name="Auto" Display="'Auto'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="af74cef9-877a-4cae-abad-39968849f51b">
    <Import PearlRef="SVB1RBM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

      <Condition Name="White (RGBW)" ID="1" If="'Col_Mode'==3" />
      <Condition Name="Saturation (EFFECT (Firework (Colour Default/Manual), Hue Loop, Flash, Pulse, Bad Bulb, Explosion, Welding (HSI Mode)))" ID="2" If="'Col_Param_1'==8||'Col_Param_2'==57||'Col_Param_2'==65||'Col_Param_2'==66" />

  <History Date="05-05-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="27-06-21" Author="Nic Morris" Comment="Completed remaining modes (ultimate mode parameter documentation is vague)" Version="1" />
  <History Date="28-06-21" Author="Nic Morris" Comment="Fixed missing condition statement in Col Param 5 Pulses/Min." Version="26" />
  <History Date="28-06-21" Author="Nic Morris" Comment="Fixed EFFECT Explosion Trigger Manual Col Param 7 and 8." Version="27" />
  <History Date="28-06-21" Author="Nic Morris" Comment="Fixed EFFECT Welding Col Param 5, 6 and 7." Version="28" />
  <History Date="28-06-21" Author="Nic Morris" Comment="Fixed EFFECT Int Loop Col Param 5, 6, 7, 8, 9 and 10." Version="29" />
  <History Date="28-06-22" Author="Nic Morris" Comment="Revised CCT with Kelvin display range.  There are two possible ranges dependent on a fixture level setting.  Used two separate functions to accommodate this." Version="30" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="dd6645e5-0b88-4c05-840c-3ac0ea89ae98" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT (Boost)" Display="'CCT (Boost) %.fK',2700~7500" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="CCT (Standard)" Display="'CCT (Standard) %.fK',2700~20000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="5001~10000" Colour="255,255,255" />
      <Function ID="3" Name="- Grn" Display="'- Grn %.2f%%',99.00~1.00" Dmx="10001~29999" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30000~40000" Colour="255,255,255" />
      <Function ID="5" Name="+ Grn" Display="'+ Grn %.2f%%',1.00~99.00" Dmx="40001~59999" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="65535~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;RGBW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />
      <Function ID="2" Name="Half Speed" Display="'Half Speed'" Dmx="86~170" />
      <Function ID="3" Name="Off" Display="'Off'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="CCT_Mode" Name="CCT Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="86~170" />
      <Function ID="3" Name="Boost" Display="'Boost'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

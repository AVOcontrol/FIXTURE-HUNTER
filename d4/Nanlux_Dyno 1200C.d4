    <Attribute ID="Col_Param_3" Name="Col Param 3" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="CCT Mode (CCT)" ID="1,2,3" If="'Col_Mode'==1" />
      <Condition Name="Blue (RGBW)" ID="4" If="'Col_Mode'==3" />
      <Condition Name="Hue 2 (EFFECT (Hue Loop))" ID="5" If="'Col_Param_1'==8" />
      <Condition Name="CCT 2 (EFFECT (CCT Loop))" ID="6" If="'Col_Param_1'==9" />
      <Condition Name="Color Mode (EFFECT (Int Loop, TV, Candle/Fire, Welding))" ID="7,8" If="'Col_Param_1'==10||'Col_Param_1'==15||'Col_Param_1'==17||'Col_Param_1'==22" />
      <Condition Name="CCT (EFFECT (Flash, Pulse, Bad Bulb, Explosion, Firework (CCT Mode)))" ID="9" If="'Col_Param_2'==56||'Col_Param_2'==67" />
      <Condition Name="Hue (EFFECT (Flash, Pulse, Bad Bulb, Explosion (HSI Mode)))" ID="10" If="'Col_Param_2'==57" />
      <Condition Name="Flash Times High (EFFECT (Storm))" ID="11" If="'Col_Param_1'==13" />
      <Condition Name="Mode (EFFECT (Police Car))" ID="12,13,14,15" If="'Col_Param_1'==14" />
      <Condition Name="G/M (EFFECT (Paparazzi))" ID="16" If="'Col_Param_1'==16" />
      <Condition Name="Amount (EFFECT (Disco, Firework (Default)))" ID="17,18,19,20,21,22,23,24" If="'Col_Param_2'==63||'Col_Param_2'==65" />
      <Condition Name="Amount (EFFECT (Disco, Firework (Manual)))" ID="25,26,27,28,29,30" If="'Col_Param_2'==64||'Col_Param_2'==66" />
      <Else ID="31" />

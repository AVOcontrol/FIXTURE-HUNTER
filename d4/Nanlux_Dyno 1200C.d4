    </Attribute>
    <Attribute ID="Green/Magenta1" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="- Grn" Display="'- Grn %.f%%',99~1" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="255,255,255" />
      <Function ID="5" Name="+ Grn" Display="'+ Grn %.f%%',1~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />

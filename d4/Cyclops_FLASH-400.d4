  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5211bd7d-a4e6-4d84-b903-217d49407fd7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Jumping" Display="'Jumping'" Dmx="51~100" Update="Speed" />
      <Function ID="3" Name="Gradient" Display="'Gradient'" Dmx="101~150" Update="Speed" />
      <Function ID="4" Name="Pulse Change" Display="'Pulse Change'" Dmx="151~200" Update="Speed" />
      <Function ID="5" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="201~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Auto Speed" ID="2" If="'Auto'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dim Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
      <Function ID="2" Name="Auto Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

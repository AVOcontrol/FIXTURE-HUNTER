    <Attribute ID="Laser_Program" Name="Laser Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~46" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="47~88" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="89~130" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="131~172" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="173~214" />

    <Attribute ID="Strobe_Program" Name="Strobe Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~64" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="65~96" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="97~128" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="129~160" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="161~192" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="193~224" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Red" Name="Wash Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Wash Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Wash Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="Wash UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Wash Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~100" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="101~250" />
      <Function ID="3" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Beam_Colour" Name="Beam Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~18" Update="Beam_Strobe" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="19~32" Update="Beam_Strobe" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="33~46" Update="Beam_Strobe" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="47~60" Update="Beam_Strobe" Colour="255,100,0" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="61~74" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="75~88" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="8" Name="R+A" Display="'R+A'" Dmx="89~102" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="9" Name="G&#xD;&#xA;+B" Display="'G&#xD;&#xA;+B'" Dmx="103~116" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="10" Name="G+A" Display="'G+A'" Dmx="117~130" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="11" Name="B+A" Display="'B+A'" Dmx="131~144" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="145~158" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="13" Name="R+G+A" Display="'R+G+A'" Dmx="159~172" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="14" Name="R+B+A" Display="'R+B+A'" Dmx="173~186" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="15" Name="G+B+A" Display="'G+B+A'" Dmx="187~200" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="201~214" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="17" Name="Col Change Program 1" Display="'Col Change Program 1'" Dmx="215~228" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="18" Name="Col Change Program 2" Display="'Col Change Program 2'" Dmx="229~242" Update="Beam_Strobe" Colour="255,255,255" />
      <Function ID="19" Name="Col Change Program 3" Display="'Col Change Program 3'" Dmx="243~255" Update="Beam_Strobe" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Beam_Strobe" Name="Beam Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3" />
      <Condition Name="Col Change Program" ID="4,5" If="'Beam_Colour'&gt;16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Laser_Mode" Name="Laser Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red On" Display="'Red On'" Dmx="6~48" />
      <Function ID="3" Name="Green On" Display="'Green On'" Dmx="49~89" />
      <Function ID="4" Name="Red + Green On" Display="'Red + Green On'" Dmx="90~131" />
      <Function ID="5" Name="Red Flash + Green On" Display="'Red Flash + Green On'" Dmx="132~173" />
      <Function ID="6" Name="Red On + Green Flash" Display="'Red On + Green Flash'" Dmx="174~215" />
      <Function ID="7" Name="Red + Green Flash" Display="'Red + Green Flash'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~1" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Strobe_LEDs" Name="Strobe LEDs" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~250" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

  <History Date="31-08-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="01-09-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6599258a-e4a8-495a-894a-a6147d73d6f6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="2:100" PowerOn="2:100" Highlight="2:100" Lowlight="2:0" />
      <Condition Name="Speed" ID="1" If="'Auto1'==2" />
      <Else ID="2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="12~23" Update="Auto_Spd" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="24~35" Update="Auto_Spd" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="36~47" Update="Auto_Spd" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="48~59" Update="Auto_Spd" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="60~71" Update="Auto_Spd" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="72~83" Update="Auto_Spd" />
      <Function ID="8" Name="White" Display="'White'" Dmx="84~95" Update="Auto_Spd" />
      <Function ID="9" Name="Program 2" Display="'Program 2'" Dmx="96~107" Update="Auto_Spd" />
      <Function ID="10" Name="Program 3" Display="'Program 3'" Dmx="108~119" Update="Auto_Spd" />
      <Function ID="11" Name="Program 4" Display="'Program 4'" Dmx="120~131" Update="Auto_Spd" />
      <Function ID="12" Name="Program 5" Display="'Program 5'" Dmx="132~143" Update="Auto_Spd" />
      <Function ID="13" Name="Program 6" Display="'Program 6'" Dmx="144~155" Update="Auto_Spd" />
      <Function ID="14" Name="Program 7" Display="'Program 7'" Dmx="156~167" Update="Auto_Spd" />
      <Function ID="15" Name="Program 8" Display="'Program 8'" Dmx="168~179" Update="Auto_Spd" />
      <Function ID="16" Name="Program 9" Display="'Program 9'" Dmx="180~191" Update="Auto_Spd" />
      <Function ID="17" Name="Program 10" Display="'Program 10'" Dmx="192~203" Update="Auto_Spd" />
      <Function ID="18" Name="Program 11" Display="'Program 11'" Dmx="204~215" Update="Auto_Spd" />
      <Function ID="19" Name="Program 12" Display="'Program 12'" Dmx="216~227" Update="Auto_Spd" />
      <Function ID="20" Name="Auto" Display="'Auto'" Dmx="228~239" Update="Auto_Spd" />
      <Function ID="21" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="2:50" PowerOn="2:50" />
      <Condition Name="Sensitivity" ID="1" If="'Auto'==21" />
      <Else ID="2" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Sensitivity" ID="1" If="'Auto1'==3" />
      <Else ID="2,3" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Red, Shutter" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="10~249" Update="Red, Shutter" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red, Shutter" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

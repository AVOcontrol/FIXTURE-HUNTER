    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fixed Col" Display="'Fixed Col'" Dmx="51~100" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="101~150" />
      <Function ID="4" Name="Col Pulse Change" Display="'Col Pulse Change'" Dmx="151~200" />
      <Function ID="5" Name="Col Gradient" Display="'Col Gradient'" Dmx="201~250" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="251~253" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Spartic-Move" ShortName="SpartcMove" Company="Magnum Lighting" Version="0">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>74364258-b474-480d-9c1e-c55077c77141</Thumbnail>
  <History Date="20-02-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pre-Heat Off" Display="'Pre-Heat Off'" Dmx="0~0" />
      <Function ID="2" Name="Emergency Stop" Display="'Emergency Stop'" Dmx="11~220" />
      <Function ID="3" Name="Clear Powder" Display="'Clear Powder'" Dmx="221~239" />
      <Function ID="4" Name="Pre-Heat On" Display="'Pre-Heat On'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Fire" Name="Fire" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Height 1" Display="'Height 1'" Dmx="16~63" />
      <Function ID="3" Name="Height 2" Display="'Height 2'" Dmx="64~111" />
      <Function ID="4" Name="Height 3" Display="'Height 3'" Dmx="112~159" />
      <Function ID="5" Name="Height 4" Display="'Height 4'" Dmx="160~207" />
      <Function ID="6" Name="Height 5" Display="'Height 5'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="120" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Fire" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="74364258-b474-480d-9c1e-c55077c77141"></Swatch>

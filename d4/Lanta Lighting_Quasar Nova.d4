<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Quasar Nova" ShortName="QuasarNova" Company="Lanta Lighting">
  <Copyright Notice="© Avolites Ltd. 2011" />
  <History Date="21-12-11" Author="John Rogers" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~69" />
      <Function ID="2" Name="Sound Active" Display="'Sound Active'" Dmx="70~139" />
      <Function ID="3" Name="Auto Run" Display="'Auto Run'" Dmx="140~209" />
      <Function ID="4" Name="Manual" Display="'Manual'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~31" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.f',42~255" Dmx="42~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dots_Lines" Name="Dots and Lines" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~69" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Dot and Line" Display="'Dot and Line  %.f%%',0~100" Dmx="70~139" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Subsection" Display="'Subsection    %.f%%',0~100" Dmx="140~209" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Dot" Display="'Dot %.f%%',0~100" Dmx="210~255" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Horizontal" Name="Horizontal" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.f',0~160" Dmx="0~160" />
      <Function ID="2" Name="Auto" Display="'Auto %.f',161~220" Dmx="161~220" />
      <Function ID="3" Name="Loop" Display="'Loop %.f',221~255" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Vertical" Name="Vertical" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.f',0~160" Dmx="0~160" />
      <Function ID="2" Name="Auto" Display="'Auto %.f',161~220" Dmx="161~220" />
      <Function ID="3" Name="Loop" Display="'Loop %.f',221~255" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="0~92" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto Zoom" Display="'Auto Zoom %.f%%',0~100" Dmx="93~200" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Auto Loop" Display="'Auto Loop %.f%%',0~100" Dmx="201~255" WheelPosition="9" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Mix" Display="'Mix %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ZAxisRot" Name="Z-Axis Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Clockwise" Display="'Clockwise'" Dmx="181~217" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Anti-Clockwise" Display="'Anti-Clockwise'" Dmx="218~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="YAxisRot" Name="Y-Axis Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~150" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="151~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="XAxisRot" Name="X-Axis Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~150" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="151~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~199" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="LH_QusrNova" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Horizontal" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Vertical" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Dots_Lines" ChannelOffset="4" Wheel="14" />
      <Attribute ID="ZAxisRot" ChannelOffset="9" Wheel="18" />
      <Attribute ID="YAxisRot" ChannelOffset="10" Wheel="16" />
      <Attribute ID="XAxisRot" ChannelOffset="11" Wheel="17" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
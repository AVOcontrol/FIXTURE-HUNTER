      <Function ID="6" Name="Gobo 5 (Sticks)" Display="'Gobo 5 (Sticks)'" Dmx="40~47" />
      <Function ID="7" Name="Gobo 6 (Glass)" Display="'Gobo 6 (Glass)'" Dmx="48~55" />
      <Function ID="8" Name="Index" Display="'Index %.f%%',0~100" Dmx="63~135" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="136~195" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="196~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Index" ID="8" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1 (Squares)" Display="'Gobo 1 (Squares)'" Dmx="8~15" />
      <Function ID="3" Name="Gobo 2 (Sharpe B/U)" Display="'Gobo 2 (Sharpe B/U)'" Dmx="16~23" />
      <Function ID="4" Name="Gobo 3 (Waves)" Display="'Gobo 3 (Waves)'" Dmx="24~31" />

    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="9" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Gobo1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gobo 1 (Dots)" Display="'Gobo 1 (Dots)'" Dmx="16~23" />
      <Function ID="3" Name="Gobo 2 (Squiggler)" Display="'Gobo 2 (Squiggler)'" Dmx="24~31" />
      <Function ID="4" Name="Gobo 3 (Wedges)" Display="'Gobo 3 (Wedges)'" Dmx="32~39" />

    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15,16,17,18,19,20,21,22" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="23,24,25,26" If="'Colour1Func'==4" />
      <Else ID="27" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="24~31" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="32~39" WheelPosition="4" Colour="0,128,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~47" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Dark Blue" Display="'Dark Blue'" Dmx="48~55" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="76~76" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="97~97" WheelPosition="1" Colour="255,0,0" />
      <Function ID="10" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="119~119" WheelPosition="2" Colour="255,255,0" />
      <Function ID="11" Name="Grn/ L Blu" Display="'Grn/ L Blu'" Dmx="140~140" WheelPosition="3" Colour="0,255,0" />
      <Function ID="12" Name="L Blu/ Org" Display="'L Blu/ Org'" Dmx="162~162" WheelPosition="4" Colour="0,128,255" />
      <Function ID="13" Name="Org/ D Blu" Display="'Org/ D Blu'" Dmx="184~184" WheelPosition="5" Colour="255,128,0" />
      <Function ID="14" Name="D Blu/ Op" Display="'D Blu/ Op'" Dmx="206~206" WheelPosition="6" Colour="0,0,180" />
      <Function ID="15" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="56~84" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="84~106" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="106~127" WheelPosition="2" Colour="255,255,0" />
      <Function ID="18" Name="Grn - L Blu" Display="'Grn - L Blu %.f%%',0~100" Dmx="127~149" WheelPosition="3" Colour="0,255,0" />
      <Function ID="19" Name="L Blu - Org" Display="'L Blu - Org %.f%%',0~100" Dmx="149~171" WheelPosition="4" Colour="0,128,255" />
      <Function ID="20" Name="Org - D Blu" Display="'Org - D Blu %.f%%',0~100" Dmx="171~193" WheelPosition="5" Colour="255,128,0" />
      <Function ID="21" Name="D Blu - Op" Display="'D Blu - Op %.f%%',0~100" Dmx="193~214" WheelPosition="6" Colour="0,0,180" />
      <Function ID="22" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="56~214" Colour="0,0,0" />
      <Function ID="23" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="24" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="222~247" Colour="0,0,0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="26" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="248~255" Colour="0,0,0" />

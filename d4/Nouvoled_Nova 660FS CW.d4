  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ad6278e5-49a1-49b9-9e7b-9dfd856e6afb" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~189" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="40~78" Colour="255,255,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="79~118" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="119~158" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="159~198" Colour="0,0,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="199~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="8500K" Display="'8500K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="5500K" Display="'5500K'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="5000K" Display="'5000K'" Dmx="128~192" Colour="255,255,255" />
      <Function ID="4" Name="4500K" Display="'4500K'" Dmx="193~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="59df20c2-7bc5-456d-89ab-56e57712d5ed" />
    <Include>

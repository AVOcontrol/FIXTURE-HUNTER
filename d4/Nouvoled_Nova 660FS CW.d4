      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:2" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />

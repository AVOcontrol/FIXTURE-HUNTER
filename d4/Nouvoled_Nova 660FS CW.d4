      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="7" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>

      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:5" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:5" />

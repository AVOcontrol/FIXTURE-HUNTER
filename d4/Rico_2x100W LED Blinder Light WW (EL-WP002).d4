<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="2x100W LED Blinder Light WW (EL-WP002)" ShortName="2xWW Blind" Company="Rico" Version="0">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>f7ac5db6-51bf-4c8d-a40b-567b14ec991b</Thumbnail>
  <History Date="12-05-23" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a0e6f8a2-e8cb-4685-9acf-18ac5a92fde2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="51~100" Update="Auto_Spd" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="101~150" Update="Auto_Spd" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="151~200" Update="Auto_Spd" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="201~250" Update="Auto_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="CTO" ID="2" If="'Auto'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="498711b0-84eb-412b-a80e-4057fe41dc3c" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="6" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5df90a9e-47b0-417d-ab5c-fa984094de9c" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="f7ac5db6-51bf-4c8d-a40b-567b14ec991b"></Swatch>

        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="SMD_Shutter" ChannelOffset="6" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Flower 1" ChannelOffset="1" ModeLink="Flower cell" X="0" Y="0">
        <AttributeLink SourceId="Flower_Col" TargetId="Flower_Col" />
      </Cell>
      <Cell ID="Cell2" Name="Flower 2" ChannelOffset="2" ModeLink="Flower cell" X="0" Y="1">

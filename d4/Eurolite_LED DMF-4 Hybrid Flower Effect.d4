  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="40f85f6e-5a90-49eb-99da-59af92af1b66" />
  <Control>
    <Attribute ID="Flower_Col" Name="Flower Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="70~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="RGB_Shutter" Name="RGB Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="SMD" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="SMD_Shutter" Name="SMD Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="10~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="40~69" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="70~99" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="100~129" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="130~159" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="160~189" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3 %.f%%',0~100" Dmx="190~219" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4 %.f%%',0~100" Dmx="220~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="4f2e9910-a0d2-42b0-9f53-36c1ef3b9ea2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="15d66f79-0db1-4826-96bf-5dcf4f7c5231" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Flower_Col" Wheel="7" />

      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="80~83" WheelPosition="10" Colour="0,255,255" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="88~91" WheelPosition="11" Colour="255,100,0" />
      <Function ID="13" Name="CTO" Display="'CTO'" Dmx="96~99" WheelPosition="12" Colour="255,240,200" />

      <Function ID="17" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="12~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="20~23" WheelPosition="2" Colour="255,128,0" />
      <Function ID="19" Name="Aq/ Grn" Display="'Aq/ Grn'" Dmx="28~31" WheelPosition="3" Colour="0,255,200" />
      <Function ID="20" Name="Grn/ L Grn" Display="'Grn/ L Grn'" Dmx="36~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="21" Name="L Grn/ Lav" Display="'L Grn/ Lav'" Dmx="44~47" WheelPosition="5" Colour="128,255,0" />
      <Function ID="22" Name="Lav/ Pk" Display="'Lav/ Pk'" Dmx="52~55" WheelPosition="6" Colour="255,128,255" />
      <Function ID="23" Name="Pk/ Yel" Display="'Pk/ Yel'" Dmx="60~63" WheelPosition="7" Colour="255,150,150" />
      <Function ID="24" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="68~71" WheelPosition="8" Colour="255,255,0" />
      <Function ID="25" Name="Mag/ Cy" Display="'Mag/ Cy'" Dmx="76~79" WheelPosition="9" Colour="255,0,255" />
      <Function ID="26" Name="Cy/ Amb" Display="'Cy/ Amb'" Dmx="84~87" WheelPosition="10" Colour="0,255,255" />
      <Function ID="27" Name="Amb/ CTO" Display="'Amb/ CTO'" Dmx="92~95" WheelPosition="11" Colour="255,100,0" />
      <Function ID="28" Name="CTO/ CTB" Display="'CTO/ CTB'" Dmx="100~103" WheelPosition="12" Colour="255,240,200" />
      <Function ID="29" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="108~111" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="116~127" WheelPosition="14" Colour="0,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~192" Colour="0,0,0" />

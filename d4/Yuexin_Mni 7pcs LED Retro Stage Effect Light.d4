    </Cells>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True" Id="d14eb470-b688-4627-a766-1c50e61fdc80">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

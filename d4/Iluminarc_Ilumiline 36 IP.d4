<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ilumiline 36 IP" ShortName="Ilumi 36IP" Company="Iluminarc">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="29-03-11" Author="John Rogers" Comment="Created" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Added Macro dependant conditionals.  Changed shutter locate and power on to open." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed ID power on and locate to All IDs." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed dimmer speed non-linear to explicit values." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed HSV attribute groups and wheel mapping.  Added v-dim to PIXEL mode." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado 3P Tour." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado Ridge IP" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed Value and replaced with Dimmer for HTP" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Adapted from COLORado Range IP" />
  <History Date="05-03-12" Author="Peter Budd" Comment="Created Cell mode for Tour mode." />
  <History Date="29-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="23-10-12" Author="Peter Budd" Comment="Created from the Chauvet Well" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="31-12-16" Author="Nic Morris" Comment="Added Atlabase ID to ARC1 mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="35fedae0-6f08-4bb8-911a-52f32b26241b" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~210" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="8" Name="5900K" Display="'5900K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="10" Name="7200K" Display="'7200K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="11" Name="8000K" Display="'8000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~20.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Speed 1" Display="'Speed 1'" Dmx="10~69" />
      <Function ID="3" Name="Speed 2" Display="'Speed 2'" Dmx="70~129" />
      <Function ID="4" Name="Speed 3" Display="'Speed 3'" Dmx="130~189" />
      <Function ID="5" Name="Speed 4" Display="'Speed 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="ARC1" Channels="3">
    <Import PearlRef="UK_Il36IPA1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

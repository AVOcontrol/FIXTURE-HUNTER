      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="31~40" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="41~50" WheelPosition="4" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="161~170" />
      <Function ID="7" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="101~160" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="161~170" />
      <Function ID="9" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="171~230" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="161~170" />
      <Function ID="11" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="51~100" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">

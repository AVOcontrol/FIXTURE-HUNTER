  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="81~90" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="171~240" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="11~80" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="91~160" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="6~10" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~21" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="29~35" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="43~49" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="57~63" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="71~77" WheelPosition="5" Colour="255,150,150" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="85~91" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="CTO" Display="'CTO'" Dmx="99~105" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="UV" Display="'UV'" Dmx="113~119" WheelPosition="8" Colour="180,0,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="8~14" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Blu" Display="'Rd/ Blu'" Dmx="22~28" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="36~42" WheelPosition="2" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="50~56" WheelPosition="3" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Pk" Display="'Grn/ Pk'" Dmx="64~70" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Pk/ Org" Display="'Pk/ Org'" Dmx="78~84" WheelPosition="5" Colour="255,150,150" />
      <Function ID="16" Name="Org/ CTO" Display="'Org/ CTO'" Dmx="92~98" WheelPosition="6" Colour="255,128,0" />
      <Function ID="17" Name="CTO/ UV" Display="'CTO/ UV'" Dmx="106~112" WheelPosition="7" Colour="255,240,200" />
      <Function ID="18" Name="UV/ Op" Display="'UV/ Op'" Dmx="120~126" WheelPosition="8" Colour="180,0,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="184~194" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="134~183" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="184~194" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~244" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />

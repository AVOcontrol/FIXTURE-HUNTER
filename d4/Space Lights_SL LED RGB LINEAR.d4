  <History Date="22-07-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="23-07-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="24-07-22" Author="Nic Morris" Comment="Changed WW master to default at zero for Capture compatibility (there are no details as to whether this is HTP or proportional)" Version="2" />
  <History Date="04-08-23" Author="Nic Morris" Comment="Created from FOS Vintage 6 Ultra (identical)" Version="3" />
  <History Date="06-08-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="18734965-7b34-4177-81fa-57e4268d8629" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="8~76" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="146~215" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="77~145" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~31" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="32~47" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="48~63" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="64~79" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="80~95" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="96~111" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="112~127" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="128~143" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="144~159" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="160~175" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="176~191" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="192~207" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="208~223" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="224~239" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_Colour" Name="Program Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WW_Master" Name="WW Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="WW" Display="'WW'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B" Display="'R+G+B'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="144~255" Colour="255,255,255" />
    </Attribute>
  </Control>

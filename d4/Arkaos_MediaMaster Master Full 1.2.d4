  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Brightness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Contrast" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mask" Name="Mask" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Mask" Display="'No  Mask'" Dmx="0~0" />
      <Function ID="2" Name="Mask" Display="'Mask %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Keystone_TL_X" Name="Keystone X1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Keystone X" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Keystone_TL_Y" Name="Keystone Y1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />

      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Curve" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Layer_Select" Name="Layer Select" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Layer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="251~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="LED_Map_Mode" Name="LED Map Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Replace" Display="'Replace'" Dmx="0~0" />
      <Function ID="2" Name="Max/HTP" Display="'Max/HTP'" Dmx="16~31" />
      <Function ID="3" Name="Min/LTP" Display="'Min/LTP'" Dmx="32~47" />
      <Function ID="4" Name="Multiply" Display="'Multiply'" Dmx="64~79" />
      <Function ID="5" Name="Addition" Display="'Addition'" Dmx="80~95" />
      <Function ID="6" Name="Subtraction" Display="'Subtraction'" Dmx="96~111" />
      <Function ID="7" Name="Rev Subtraction" Display="'Rev Subtraction'" Dmx="112~127" />
      <Function ID="8" Name="LED Mapper Muted" Display="'LED Mapper Muted'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Merger_Int" Name="Merger Int" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="DMX-&gt;Mapper" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Master Full Mode 1.2" Channels="18">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Brightness" ChannelOffset="1" Wheel="6" />
      <Attribute ID="Volume" ChannelOffset="15" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="16" Wheel="4" />
      <Attribute ID="Keystone_TL_X" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Keystone_TL_Y" ChannelOffset="5" Wheel="20" />

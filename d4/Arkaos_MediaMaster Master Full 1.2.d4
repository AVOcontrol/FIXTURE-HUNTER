      <Attribute ID="Contrast" ChannelOffset="2" Wheel="34" />
      <Attribute ID="Mask" ChannelOffset="3" Wheel="35" />
      <Attribute ID="SoftEdge_Width" ChannelOffset="12" Wheel="13" />

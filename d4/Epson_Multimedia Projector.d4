<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Multimedia Projector" ShortName="Projector" Company="Epson">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Source" Name="Source" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="HDMI" Display="'HDMI'" Dmx="8~15" />
      <Function ID="3" Name="HDBaseT" Display="'HDBaseT'" Dmx="24~31" />
      <Function ID="4" Name="DVI-D" Display="'DVI-D'" Dmx="32~39" />
      <Function ID="5" Name="SDI" Display="'SDI'" Dmx="48~55" />
      <Function ID="6" Name="Computer" Display="'Computer'" Dmx="56~63" />
      <Function ID="7" Name="BNC" Display="'BNC'" Dmx="72~79" />
      <Function ID="8" Name="LAN" Display="'LAN'" Dmx="80~87" />
    </Attribute>
    <Attribute ID="Lens_Position" Name="Lens Position" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Home" Display="'Home'" Dmx="32~63" />
    </Attribute>
    <Attribute ID="Horiz_Shift" Name="Horiz Shift" Description="" Group="P">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="+ Large" Display="'+ Large'" Dmx="0~0" />
      <Function ID="2" Name="+ Med" Display="'+ Med'" Dmx="32~63" />
      <Function ID="3" Name="+ Small" Display="'+ Small'" Dmx="64~95" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="5" Name="- Small" Display="'- Small'" Dmx="160~191" />
      <Function ID="6" Name="- Med" Display="'- Med'" Dmx="192~223" />
      <Function ID="7" Name="- Large" Display="'- Large'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Tilt_Shift" Name="Tilt Shift" Description="" Group="P">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="+ Large" Display="'+ Large'" Dmx="0~0" />
      <Function ID="2" Name="+ Med" Display="'+ Med'" Dmx="32~63" />
      <Function ID="3" Name="+ Small" Display="'+ Small'" Dmx="64~95" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="5" Name="- Small" Display="'- Small'" Dmx="160~191" />
      <Function ID="6" Name="- Med" Display="'- Med'" Dmx="192~223" />
      <Function ID="7" Name="- Large" Display="'- Large'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="+ Large" Display="'+ Large'" Dmx="0~0" />
      <Function ID="2" Name="+ Med" Display="'+ Med'" Dmx="32~63" />
      <Function ID="3" Name="+ Small" Display="'+ Small'" Dmx="64~95" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="5" Name="- Small" Display="'- Small'" Dmx="160~191" />
      <Function ID="6" Name="- Med" Display="'- Med'" Dmx="192~223" />
      <Function ID="7" Name="- Large" Display="'- Large'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="+ Large" Display="'+ Large'" Dmx="0~0" />
      <Function ID="2" Name="+ Med" Display="'+ Med'" Dmx="32~63" />
      <Function ID="3" Name="+ Small" Display="'+ Small'" Dmx="64~95" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="5" Name="- Small" Display="'- Small'" Dmx="160~191" />
      <Function ID="6" Name="- Med" Display="'- Med'" Dmx="192~223" />
      <Function ID="7" Name="- Large" Display="'- Large'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Distortion" Name="Distortion" Description="" Group="B">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="+ Large" Display="'+ Large'" Dmx="0~0" />
      <Function ID="2" Name="+ Med" Display="'+ Med'" Dmx="32~63" />
      <Function ID="3" Name="+ Small" Display="'+ Small'" Dmx="64~95" />
      <Function ID="4" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="5" Name="- Small" Display="'- Small'" Dmx="160~191" />
      <Function ID="6" Name="- Med" Display="'- Med'" Dmx="192~223" />
      <Function ID="7" Name="- Large" Display="'- Large'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Lens_Memory" Name="Lens Memory" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Load Lens Memory 1" Display="'Load Lens Memory 1'" Dmx="16~31" />
      <Function ID="3" Name="Load Lens Memory 2" Display="'Load Lens Memory 2'" Dmx="32~47" />
      <Function ID="4" Name="Load Lens Memory 3" Display="'Load Lens Memory 3'" Dmx="48~63" />
      <Function ID="5" Name="Load Lens Memory 4" Display="'Load Lens Memory 4'" Dmx="64~79" />
      <Function ID="6" Name="Load Lens Memory 5" Display="'Load Lens Memory 5'" Dmx="80~95" />
      <Function ID="7" Name="Load Lens Memory 6" Display="'Load Lens Memory 6'" Dmx="96~111" />
      <Function ID="8" Name="Load Lens Memory 7" Display="'Load Lens Memory 7'" Dmx="112~127" />
      <Function ID="9" Name="Load Lens Memory 8" Display="'Load Lens Memory 8'" Dmx="128~143" />
      <Function ID="10" Name="Load Lens Memory 9" Display="'Load Lens Memory 9'" Dmx="144~159" />
      <Function ID="11" Name="Load Lens Memory 10" Display="'Load Lens Memory 10'" Dmx="160~175" />
    </Attribute>
    <Attribute ID="Power_Control" Name="Power Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="128~128" />
      <Function ID="2" Name="Power Off" Display="'Power Off'" Dmx="0~0" />
      <Function ID="3" Name="Power On" Display="'Power On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Geometry" Name="Geometry" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function " Display="'No Function '" Dmx="255~255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="3" Name="Keystone" Display="'Keystone'" Dmx="16~31" />
      <Function ID="4" Name="Quick Corner" Display="'Quick Corner'" Dmx="32~47" />
      <Function ID="5" Name="Point Correction" Display="'Point Correction'" Dmx="48~63" />
      <Function ID="6" Name="Curved Surface" Display="'Curved Surface'" Dmx="64~79" />
      <Function ID="7" Name="Corner Wall" Display="'Corner Wall'" Dmx="80~95" />
      <Function ID="8" Name="Load Memory 1" Display="'Load Memory 1'" Dmx="96~111" />
      <Function ID="9" Name="Load Memory 2" Display="'Load Memory 2'" Dmx="112~127" />
      <Function ID="10" Name="Load Memory 3" Display="'Load Memory 3'" Dmx="128~143" />
    </Attribute>
    <Attribute ID="Lock" Name="Lock" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Locked" Display="'Locked'" Dmx="0~0" />
      <Function ID="2" Name="Unlocked" Display="'Unlocked'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Source" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Lens_Position" ChannelOffset="4" Wheel="28" />
      <Attribute ID="Horiz_Shift" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt_Shift" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Distortion" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Lens_Memory" ChannelOffset="10" Wheel="25" />
      <Attribute ID="Power_Control" ChannelOffset="11" Wheel="29" />
      <Attribute ID="Geometry" ChannelOffset="12" Wheel="49" />
      <Attribute ID="Lock" ChannelOffset="13" Wheel="30" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Vortex" ShortName="Vortex" Company="Blatt Lighting">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>64ee90ee-c017-4af4-b0f3-22ed0f9580cc</Thumbnail>
  <History Date="13-06-12" Author="Peter Budd" Comment="Created" />
  <History Date="23-08-12" Author="Peter Budd" Comment="Created from Terbly OV370Z-R" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Elation Platinum Wash ZXF Pro XL" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Clay Paky A.leda K20" />
  <History Date="30-10-12" Author="Peter Budd" Comment="Edited extended mode to include cell layout. Added RGBW master channels and added attribute links to RGBW cells" />
  <History Date="27-10-13" Author="Nic Morris" Comment="Increased 16-bit functions to 2dp.  Standardised shutted function order." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Added detailed functions to Colour Macro and Function attributes." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Fixed shape mode.  Added Extended RGBW mode." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Created from Clay Paky A.leda Wash K10" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="02-03-14" Author="Nic Morris" Comment="Added 'Full' mode and brought in line with latest spec." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Updated Shape strobe, Back strobe and back select to latest spec." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Updated shapes." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Added shape offset conditional functions for new shapes." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Revised wheel mappings and attribute groups." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Fixed lens rot CW spin range.  Changed lens rot spin display to value 1dp to provide full resolution." />
  <History Date="02-01-15" Author="Nic Morris" Comment="Updated to 11.2014 spec" />
  <History Date="24-11-15" Author="Nic Morris" Comment="Fixed extended mapping" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-06-16" Author="Nic Morris" Comment="Added Shape Control only mode and celled version of full Shapes mode." />
  <History Date="29-08-16" Author="Nic Morris" Comment="Revised classic pearl refs" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="15-05-18" Author="Nic Morris" Comment="Changed RGB masters to locate at zero." />
  <History Date="26-09-18" Author="Peter Budd" Comment="Added and extra open range to the end of the shutter channel, and changed colour macro off to 0 instead of 0-9." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's.  Added physical pan/tilt ranges." />
  <History Date="15-02-19" Author="Nic Morris" Comment="Moved shape controls into effect group and wheel slot.  Moved colour macro into colour group and wheel slot." />
  <History Date="14-01-20" Author="Nic Morris" Comment="Created from Clay Paky A.leda B-EYE K10 (only channel overview provided - looks identical to Clay Paky A.leda B-EYE K10 documentation.  Assumed function ranges and pixel layout identical)" />
  <Manual Filename=" Summary=" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rand Slow" Display="'Rand Slow'" Dmx="213~225" Intensity="0~0" />
      <Function ID="5" Name="Rand Med" Display="'Rand Med'" Dmx="226~238" Intensity="0~0" />
      <Function ID="6" Name="Rand Fast" Display="'Rand Fast'" Dmx="239~251" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>

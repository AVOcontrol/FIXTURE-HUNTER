      <Function ID="24" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="115~119" WheelPosition="9" />
      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="120~124" WheelPosition="10" />
      <Function ID="26" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="125~129" WheelPosition="11" />

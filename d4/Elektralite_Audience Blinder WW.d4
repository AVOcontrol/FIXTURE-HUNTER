<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Audience Blinder WW" ShortName="Blinder WW" Company="Elektralite">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="09-11-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-12-16" Author="Nic Morris" Comment="Split for Capture.  Revised shutter function names.  Added 2,3 and 4 DMX modes." />
  <History Date="29-12-16" Author="Nic Morris" Comment="Arranged cells (best guess).  Removed Atlabase ID's (wrong fixture)" />
  <History Date="31-12-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c1253308-97b5-44aa-9a04-b72feeaa04c9" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Sync Slow" Display="'Sync Slow %.f%%',0~100" Dmx="10~49" Intensity="0~0" />
      <Function ID="3" Name="Async Slow" Display="'Async Slow %.f%%',0~100" Dmx="50~99" Intensity="0~0" />
      <Function ID="4" Name="Rnd Slow" Display="'Rnd Slow %.f%%',0~100" Dmx="100~149" Intensity="0~0" />
      <Function ID="5" Name="Async Fast" Display="'Async Fast %.f%%',0~100" Dmx="150~199" Intensity="0~0" />
      <Function ID="6" Name="Sync Fast" Display="'Sync Fast %.f%%',0~100" Dmx="200~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="51~100" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="101~150" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="151~200" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="ID" Display="'ID %.f',1~255" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="22501cb5-43f3-4090-bc4e-a0fc99cb40e5" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="5" />
        <Attribute ID="Dimmer" Wheel="1" />

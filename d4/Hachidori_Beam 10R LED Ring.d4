      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="35~39" WheelPosition="7" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="40~44" WheelPosition="8" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="45~49" WheelPosition="9" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="50~54" WheelPosition="10" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="55~59" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="60~64" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="65~69" WheelPosition="13" />
      <Function ID="15" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="70~74" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="75~79" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="80~84" WheelPosition="2" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="85~89" WheelPosition="3" />
      <Function ID="19" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="90~94" WheelPosition="4" />
      <Function ID="20" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="95~99" WheelPosition="5" />

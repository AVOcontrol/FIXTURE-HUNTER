  <History Date="09-01-19" Author="Nic Morris" Comment="Created (hopeless documentation)" />
  <History Date="16-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="10-04-19" Author="Nic Morris" Comment="Created from Shehds Mini LED 60W (poor documentation with the same confusing charts)" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Added Atlabase ID's (Capture have implemented 30 channel as 32.  Without proper documentation it is impossible to know how this works)" />
  <History Date="21-07-19" Author="Nic Morris" Comment="Created from Hybrid HMH 12" />
  <History Date="23-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b7a3bf2c-781a-42b1-89b4-2c204fc8d541" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Col Beam" Display="'Col Beam %.1f%%',0.0~100.0" Dmx="0~189" />
      <Function ID="2" Name="Col Bm+Ring" Display="'Col Bm+Ring %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto/Sound'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Macro" Name="Ring Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="R" Display="'R'" Dmx="10~19" />
      <Function ID="3" Name="G" Display="'G'" Dmx="20~29" />
      <Function ID="4" Name="B" Display="'B'" Dmx="30~39" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~49" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="50~59" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="60~69" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="70~79" />
      <Function ID="9" Name="Dynamic 1" Display="'Dynamic 1'" Dmx="80~89" />
      <Function ID="10" Name="Dynamic 2" Display="'Dynamic 2'" Dmx="90~99" />
      <Function ID="11" Name="Dynamic 3" Display="'Dynamic 3'" Dmx="100~109" />
      <Function ID="12" Name="Dynamic 4" Display="'Dynamic 4'" Dmx="110~119" />
      <Function ID="13" Name="Dynamic 5" Display="'Dynamic 5'" Dmx="120~129" />
      <Function ID="14" Name="Dynamic 6" Display="'Dynamic 6'" Dmx="130~139" />
      <Function ID="15" Name="Dynamic 7" Display="'Dynamic 7'" Dmx="140~149" />
      <Function ID="16" Name="Dynamic 8" Display="'Dynamic 8'" Dmx="150~159" />
      <Function ID="17" Name="Dynamic 9" Display="'Dynamic 9'" Dmx="160~169" />
      <Function ID="18" Name="Dynamic 10" Display="'Dynamic 10'" Dmx="170~179" />
      <Function ID="19" Name="Dynamic 11" Display="'Dynamic 11'" Dmx="180~189" />
      <Function ID="20" Name="Dynamic 12" Display="'Dynamic 12'" Dmx="190~199" />
      <Function ID="21" Name="Dynamic 13" Display="'Dynamic 13'" Dmx="200~209" />
      <Function ID="22" Name="Dynamic 14" Display="'Dynamic 14'" Dmx="210~219" />
      <Function ID="23" Name="Dynamic 15" Display="'Dynamic 15'" Dmx="220~229" />
      <Function ID="24" Name="Dynamic 16" Display="'Dynamic 16'" Dmx="230~239" />
      <Function ID="25" Name="Dynamic 17" Display="'Dynamic 17'" Dmx="240~249" />
      <Function ID="26" Name="Dynamic 18" Display="'Dynamic 18'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto/Sound" Name="Auto/Sound" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Macro_Speed" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="1~128" Update="Macro_Speed" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="129~255" Update="Macro_Speed" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">

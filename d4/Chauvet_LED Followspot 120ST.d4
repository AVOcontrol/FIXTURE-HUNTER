<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Followspot 120ST" ShortName="F-Sp 120ST" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-07-16" Author="Nic Morris" Comment="Created" />
  <History Date="07-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6fec7a3c-d41f-4835-822a-af7247a7905f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Cool White" Display="'Cool White'" Dmx="0~0" Colour="230,230,255" />
      <Function ID="2" Name="Warm White" Display="'Warm White'" Dmx="32~63" Colour="255,240,200" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="96~127" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="160~191" Colour="255,0,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="192~223" Colour="0,128,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="224~255" Colour="255,128,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~215" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="CHF120ST" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c320cb13-3bdf-430c-bb85-eb3b46183205" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Cool White" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:8" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:7" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Light Blue" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:4" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:4" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:4" />
      <Palette ID="15" Name="Purple" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
  </Palettes>
</Fixture>
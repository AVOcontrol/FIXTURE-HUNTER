      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="20~29" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="30~39" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="40~49" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="50~59" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="60~69" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="70~79" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="80~89" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="90~99" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="100~109" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="110~119" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="120~129" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="130~139" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="140~149" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="150~159" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="160~169" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="170~179" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="180~189" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="190~199" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static Step 1" Display="'Static Step 1'" Dmx="0~0" />
      <Function ID="2" Name="Static Step 2" Display="'Static Step 2'" Dmx="5~9" />
      <Function ID="3" Name="Static Step 3" Display="'Static Step 3'" Dmx="10~14" />
      <Function ID="4" Name="Static Step 4" Display="'Static Step 4'" Dmx="15~19" />
      <Function ID="5" Name="Static Step 5" Display="'Static Step 5'" Dmx="20~24" />
      <Function ID="6" Name="Static Step 6" Display="'Static Step 6'" Dmx="25~29" />
      <Function ID="7" Name="Static Step 7" Display="'Static Step 7'" Dmx="30~34" />
      <Function ID="8" Name="Static Step 8" Display="'Static Step 8'" Dmx="35~39" />
      <Function ID="9" Name="Chase FWD" Display="'Chase FWD %.f%%',100~0" Dmx="40~145" />
      <Function ID="10" Name="Chase Stop" Display="'Chase Stop'" Dmx="146~149" />
      <Function ID="11" Name="Chase REV" Display="'Chase REV %.f%%',0~100" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Program_Fade" Name="Program Fade" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

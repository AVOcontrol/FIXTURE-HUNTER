  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Update="Shutter" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="10~14" Update="Shutter" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="15~19" Update="Shutter" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="20~24" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="25~29" Update="Shutter" Colour="255,100,0" />
      <Function ID="7" Name="R+G" Display="'R+G'" Dmx="30~34" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="35~39" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="B+W" Display="'B+W'" Dmx="40~44" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="W+A" Display="'W+A'" Dmx="45~49" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="R+A" Display="'R+A'" Dmx="50~54" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="G+A" Display="'G+A'" Dmx="55~59" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="B+A" Display="'B+A'" Dmx="60~64" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="R+B" Display="'R+B'" Dmx="65~69" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="R+W" Display="'R+W'" Dmx="70~74" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="G+W" Display="'G+W'" Dmx="75~79" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="R+G+B" Display="'R+G+B'" Dmx="80~84" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="G+B+W" Display="'G+B+W'" Dmx="85~89" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="B+W+A" Display="'B+W+A'" Dmx="90~94" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="R+W+A" Display="'R+W+A'" Dmx="95~99" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="G+W+A" Display="'G+W+A'" Dmx="100~104" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="R+G+W" Display="'R+G+W'" Dmx="105~109" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="R+G+A" Display="'R+G+A'" Dmx="110~114" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="R+B+A" Display="'R+B+A'" Dmx="115~119" Update="Shutter" Colour="255,255,255" />
      <Function ID="25" Name="R+B+W" Display="'R+B+W'" Dmx="120~124" Update="Shutter" Colour="255,255,255" />
      <Function ID="26" Name="G+A+B" Display="'G+A+B'" Dmx="125~129" Update="Shutter" Colour="255,255,255" />
      <Function ID="27" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="130~134" Update="Shutter" Colour="255,255,255" />
      <Function ID="28" Name="G+B+W+A" Display="'G+B+W+A'" Dmx="135~139" Update="Shutter" Colour="255,255,255" />
      <Function ID="29" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="140~144" Update="Shutter" Colour="255,255,255" />
      <Function ID="30" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="145~149" Update="Shutter" Colour="255,255,255" />
      <Function ID="31" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="150~154" Update="Shutter" Colour="255,255,255" />
      <Function ID="32" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="155~200" Update="Shutter" Colour="255,255,255" />
      <Function ID="33" Name="Col Dream" Display="'Col Dream %.f%%',0~100" Dmx="201~250" Update="Shutter" Colour="255,255,255" />
      <Function ID="34" Name="Sound" Display="'Sound'" Dmx="251~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==34" />
      <Else ID="1" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Motor" Name="Motor" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Motor" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="48afe301-9f30-452d-b301-97084328ac03"></Swatch>
  </swatchLibrary>
</Fixture>
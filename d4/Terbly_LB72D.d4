<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LB72D" ShortName="LB72D" Company="Terbly">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="19-03-09" Author="David Hunt" Comment="Created" />
  <History Date="27-04-09" Author="Jonathan Moreton" Comment="Created" />
  <History Date="11-02-10" Author="Gregory Haynes" Comment="Updated macro timings to 20 seconds" />
  <History Date="10-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added Red1, Green1, Blue1 and replaced first cell in 15 DMX mode." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Added v-dim.  Added pixel mapper compatibility." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="03-01-18" Author="Nic Morris" Comment="Changed name from LB-72D to LB72D" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~40" Update="Dimmer" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="41~70" Update="Dimmer" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="71~100" Update="Dimmer" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="101~130" Update="Dimmer" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="131~160" Update="Dimmer" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="161~190" Update="Dimmer" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="191~220" Update="Dimmer" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="221~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />

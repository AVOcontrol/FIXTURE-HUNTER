  <Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Fast">
      <Set Channel="Function:2" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Normal">
      <Set Channel="Function:3" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Conventional Dimmer">

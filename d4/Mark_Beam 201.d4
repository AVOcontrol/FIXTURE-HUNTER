      <Function ID="32" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="S-F Strobe" Display="'S-F Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="F-S Strobe" Display="'F-S Strobe %.f%%',100~0" Dmx="108~207" Intensity="0~0" />

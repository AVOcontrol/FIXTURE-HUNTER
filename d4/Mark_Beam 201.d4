      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="120~123" WheelPosition="14" Colour="0,0,0" />
      <Function ID="16" Name="Colour 15" Display="'Colour 15'" Dmx="128~255" WheelPosition="15" Colour="0,0,0" />
      <Function ID="17" Name="Op/ 1" Display="'Op/ 1'" Dmx="5~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="1/ 2" Display="'1/ 2'" Dmx="13~17" WheelPosition="1" Colour="0,0,0" />

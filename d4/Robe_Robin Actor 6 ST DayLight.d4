  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="Reserved" Display="'Reserved %.f',20~169" Dmx="20~169" />
      <Function ID="5" Name="Save Values" Display="'Save Values'" Dmx="170~179" />
      <Function ID="6" Name="Reset Beam" Display="'Reset Beam'" Dmx="180~189" />
      <Function ID="7" Name="Reserved" Display="'Reserved %.f',190~199" Dmx="190~199" />
      <Function ID="8" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="9" Name="Reserved" Display="'Reserved %.f',210~229" Dmx="210~229" />
      <Function ID="10" Name="Fans Full Speed" Display="'Fans Full     Speed'" Dmx="240~240" />
      <Function ID="11" Name="Fan Speed" Display="'Fans Speed    %.f%%',0~100" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" />
      <Function ID="2" Name="All ON" Display="'All ON'" Dmx="8~15" />
      <Function ID="3" Name="Effect 1" Display="'Effect 1'" Dmx="16~23" />
      <Function ID="4" Name="Effect 2" Display="'Effect 2'" Dmx="24~31" />
      <Function ID="5" Name="Effect 3" Display="'Effect 3'" Dmx="32~39" />
      <Function ID="6" Name="Effect 4" Display="'Effect 4'" Dmx="40~47" />
      <Function ID="7" Name="Effect 5" Display="'Effect 5'" Dmx="48~55" />
      <Function ID="8" Name="Effect 6" Display="'Effect 6'" Dmx="56~63" />
      <Function ID="9" Name="Effect 7" Display="'Effect 7'" Dmx="64~71" />
      <Function ID="10" Name="Effect 8" Display="'Effect 8'" Dmx="72~79" />
      <Function ID="11" Name="Effect 9" Display="'Effect 9'" Dmx="80~87" />
      <Function ID="12" Name="Effect 10" Display="'Effect 10'" Dmx="88~95" />
      <Function ID="13" Name="Effect 11" Display="'Effect 11'" Dmx="96~103" />
      <Function ID="14" Name="Effect 12" Display="'Effect 12'" Dmx="104~111" />
      <Function ID="15" Name="Effect 13" Display="'Effect 13'" Dmx="112~119" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~31" Intensity="0~0" />
      <Function ID="7" Name="Z3 Strobe %" Display="'Zone 3 Strobe %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="10" Name="Zone FX Fwd" Display="'Zone FX Fwd %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="11" Name="Zone FX Rev" Display="'Zone FX Rev %.f%%',0~100" Dmx="127~112" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="159~144" Intensity="0~0" />
      <Function ID="8" Name="Rnd Zn" Display="'Rnd Zn %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="9" Name="Rnd Zn Strb" Display="'Rnd Zn Strb %.f%%',0~100" Dmx="191~176" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="224~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

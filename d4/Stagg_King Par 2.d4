<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="King Par 2" ShortName="King Par 2" Company="Stagg">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="25-02-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution" />
  <History Date="28-03-11" Author="Nic Morris" Comment="Removed shutter palettes.  Added missing ID functions." />
  <History Date="28-03-11" Author="Nic Morris" Comment="Changed Hue and Saturation to Colour Group.  Changed Value to Dimmer." />
  <History Date="28-03-11" Author="Nic Morris" Comment="Moved Hue and Sat to Colour wheels.  Simplified Macro Speed conditional logic." />
  <History Date="24-05-12" Author="Peter Budd" Comment="Created from Chauvet Colorado 1 Tri Tour" />
  <History Date="24-05-12" Author="Peter Budd" Comment="Created from Stagg King Par 2" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="06-02-18" Author="Nic Morris" Comment="Added all missing Atlabase ID's except for AR1+S" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d88ab1f3-b7ae-40c8-b58c-4a78884187ac" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1 %.f%%',0~100" Dmx="11~20" Update="Shutter" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2 %.f%%',0~100" Dmx="21~30" Update="Shutter" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3 %.f%%',0~100" Dmx="31~40" Update="Shutter" Colour="0,0,0" />

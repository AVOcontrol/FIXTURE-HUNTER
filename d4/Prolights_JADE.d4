    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism 1 Index" Display="'Prism 1 Index'" Dmx="64~127" Update="Prism_Rot" />
      <Function ID="3" Name="Prism 1 Spin" Display="'Prism 1 Spin'" Dmx="64~127" Update="Prism_Rot" />
      <Function ID="4" Name="Prism 2 Index" Display="'Prism 2 Index'" Dmx="128~191" Update="Prism_Rot" />
      <Function ID="5" Name="Prism 2 Spin" Display="'Prism 2 Spin'" Dmx="128~191" Update="Prism_Rot" />
      <Function ID="6" Name="Prism 3 Index" Display="'Prism 3 Index'" Dmx="192~255" Update="Prism_Rot" />
      <Function ID="7" Name="Prism 3 Spin" Display="'Prism 3 Spin'" Dmx="192~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="8:0" PowerOn="8:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2||'Prism'==4||'Prism'==6" />
      <Condition Name="Spin 1" ID="2,3,4" If="'Prism'==3" />
      <Condition Name="Spin 2" ID="5,6,7" If="'Prism'==5||'Prism'==7" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~224" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="223~192" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="6" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="223~192" />
      <Function ID="7" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="224~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus_Func" Name="Focus Func" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto 5m" Display="'Auto 5m'" Dmx="16~31" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Auto 7.5m" Display="'Auto 7.5m'" Dmx="32~47" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Auto 10m" Display="'Auto 10m'" Dmx="48~63" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Auto 15m" Display="'Auto 15m'" Dmx="64~95" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Auto &gt;20m" Display="'Auto &gt;20m'" Dmx="96~127" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Colour" Display="'Reset Colour'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="7" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="8" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
      <Function ID="10" Name="Lamp Off" Display="'Lamp Off'" Dmx="72~79" />
      <Function ID="11" Name="Lamp On" Display="'Lamp On'" Dmx="80~87" />
    </Attribute>
  </Control>

<Fixture Name="JADE" ShortName="JADE" Company="Prolights" Version="17">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>769f6cdd-a7e3-4d60-8843-2e78f227fe4e</Thumbnail>
  <History Date="15-03-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="25-03-15" Author="Nic Morris" Comment="Added lamp on/off in line with latest documentation in response to manufacturer request." Version="2" />
  <History Date="25-03-15" Author="Nic Morris" Comment="Changed Gobo2Func to default at zero in attempt to fix manufacturer bug report." Version="3" />
  <History Date="16-05-15" Author="Nic Morris" Comment="Created from Prolights Jasper" Version="4" />
  <History Date="20-06-15" Author="Nic Morris" Comment="Changed all first fixed functions to default to zero in yet another attempt to make this work." Version="5" />
  <History Date="22-06-15" Author="Nic Morris" Comment="Updated prism rot functions to latest spec in response to manufacturer request." Version="6" />
  <History Date="30-06-15" Author="Nic Morris" Comment="Added prism 1 condition to prism rot with CW and CCW ranges swapped in response to manufacturer request." Version="7" />
  <History Date="23-07-15" Author="Nic Morris" Comment="Changed colours Blue Green to Dark Blue and Amber to CTO in response to manufacturer request." Version="8" />
  <History Date="23-07-15" Author="Nic Morris" Comment="Swapped prism rot CW and CCW spin ranges in response to manufacturer request." Version="9" />
  <History Date="01-08-15" Author="Nic Morris" Comment="Updated split colour functions to new Dark Blue and CTO in response to manufacturer request." Version="10" />
  <History Date="01-08-15" Author="Nic Morris" Comment="Swapped prism functions again in response to manufacturer request." Version="11" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Inverted Prism 1 CW range in response to manufacturer request." Version="12" />
  <History Date="02-02-16" Author="Nic Morris" Comment="Added prism index and spin options to filter prism rot display in response to customer request." Version="13" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="14" />
  <History Date="14-08-16" Author="Nic Morris" Comment="Fixed duplicate ID in prism rot else condition.  Added open, no scroll and no spin functions to various conditions." Version="15" />
  <History Date="14-03-20" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches.  Added missing palettes." Version="16" />
  <History Date="17-03-20" Author="Nic Morris" Comment="Changed Op/Rd colour palette to Red in response to bug report." Version="17" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b889b887-0d70-4779-b5e7-214831636f09" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />

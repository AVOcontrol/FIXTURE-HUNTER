      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Video_Map_Mix" Name="Video Map Mix" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />

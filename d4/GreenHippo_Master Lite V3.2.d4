      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mix" Display="'Mix'" Dmx="0~0" />
      <Function ID="2" Name="Morph" Display="'Morph'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Map_Select_A" Name="Map Select A" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select A" Display="'Select A %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Map_Select_B" Name="Map Select B" Description="" Group="G">

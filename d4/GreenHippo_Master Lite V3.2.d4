    </Attribute>
    <Attribute ID="RegionMap" Name="Region Mapper" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shift" Name="Shift" Description="" Group="S">
      <Locate Locate="1:128" PowerOn="1:128" />
      <Function ID="1" Name="Shift" Display="'Shift %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:128" PowerOn="1:128" />

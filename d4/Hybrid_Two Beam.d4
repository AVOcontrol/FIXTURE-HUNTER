<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Two Beam" ShortName="Two Beam" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="24~247" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Gobo 1" Display="'Gobo 1'" Dmx="0~7" />
      <Function ID="2" Name="Gobo 2" Display="'Gobo 2'" Dmx="8~15" />
      <Function ID="3" Name="Gobo 3" Display="'Gobo 3'" Dmx="16~23" />
      <Function ID="4" Name="Gobo 4" Display="'Gobo 4'" Dmx="24~31" />
      <Function ID="5" Name="Gobo 5" Display="'Gobo 5'" Dmx="32~39" />
      <Function ID="6" Name="Gobo 6" Display="'Gobo 6'" Dmx="40~47" />
      <Function ID="7" Name="Gobo 7" Display="'Gobo 7'" Dmx="48~55" />
      <Function ID="8" Name="Gobo 8" Display="'Gobo 8'" Dmx="56~63" />
      <Function ID="9" Name="Gobo 9" Display="'Gobo 9'" Dmx="64~71" />
      <Function ID="10" Name="Gobo 10" Display="'Gobo 10'" Dmx="72~79" />
      <Function ID="11" Name="Gobo 11" Display="'Gobo 11'" Dmx="80~87" />
      <Function ID="12" Name="Gobo 12" Display="'Gobo 12'" Dmx="88~95" />
      <Function ID="13" Name="Gobo 13" Display="'Gobo 13'" Dmx="96~103" />
      <Function ID="14" Name="Gobo 14" Display="'Gobo 14'" Dmx="104~111" />
      <Function ID="15" Name="Gobo 15" Display="'Gobo 15'" Dmx="112~119" />
      <Function ID="16" Name="Gobo 16" Display="'Gobo 16'" Dmx="120~127" />
      <Function ID="17" Name="Rot Gobo 1" Display="'Rot Gobo 1'" Dmx="128~143" />
      <Function ID="18" Name="Rot Gobo 2" Display="'Rot Gobo 2'" Dmx="144~159" />
      <Function ID="19" Name="Rot Gobo 3" Display="'Rot Gobo 3'" Dmx="160~175" />
      <Function ID="20" Name="Rot Gobo 4" Display="'Rot Gobo 4'" Dmx="176~191" />
      <Function ID="21" Name="Rot Gobo 5" Display="'Rot Gobo 5'" Dmx="192~207" />
      <Function ID="22" Name="Rot Gobo 6" Display="'Rot Gobo 6'" Dmx="208~223" />
      <Function ID="23" Name="Rot Gobo 7" Display="'Rot Gobo 7'" Dmx="224~239" />
      <Function ID="24" Name="Rot Gobo 8" Display="'Rot Gobo 8'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="120~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="247~128" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="248~255" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="0~119" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKHY2BM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="3" Wheel="15" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Gobo 1" Number="11" Page="1" SetControl="Gobo1:1" />
      <Palette ID="2" Name="Gobo 2" Number="12" Page="1" SetControl="Gobo1:2" />
      <Palette ID="3" Name="Gobo 3" Number="13" Page="1" SetControl="Gobo1:3" />
      <Palette ID="4" Name="Gobo 4" Number="14" Page="1" SetControl="Gobo1:4" />
      <Palette ID="5" Name="Gobo 5" Number="15" Page="1" SetControl="Gobo1:5" />
      <Palette ID="6" Name="Gobo 6" Number="16" Page="1" SetControl="Gobo1:6" />
      <Palette ID="7" Name="Gobo 7" Number="17" Page="1" SetControl="Gobo1:7" />
      <Palette ID="8" Name="Gobo 8" Number="18" Page="1" SetControl="Gobo1:8" />
      <Palette ID="9" Name="Gobo 9" Number="19" Page="1" SetControl="Gobo1:9" />
      <Palette ID="10" Name="Gobo 10" Number="20" Page="1" SetControl="Gobo1:10" />
      <Palette ID="11" Name="Gobo 11" Number="0" Page="1" SetControl="Gobo1:11" />

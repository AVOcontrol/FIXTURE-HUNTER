      <Palette ID="13" Name="Gobo 13" Number="0" Page="1" SetControl="Gobo1:13" />
      <Palette ID="14" Name="Gobo 14" Number="0" Page="1" SetControl="Gobo1:14" />
      <Palette ID="15" Name="Gobo 15" Number="0" Page="1" SetControl="Gobo1:15" />
      <Palette ID="16" Name="Gobo 16" Number="0" Page="1" SetControl="Gobo1:16" />
      <Palette ID="17" Name="Rot Gobo 1" Number="0" Page="1" SetControl="Gobo1:17" />
      <Palette ID="18" Name="Rot Gobo 2" Number="0" Page="1" SetControl="Gobo1:18" />
      <Palette ID="19" Name="Rot Gobo 3" Number="0" Page="1" SetControl="Gobo1:19" />
      <Palette ID="20" Name="Rot Gobo 4" Number="0" Page="1" SetControl="Gobo1:20" />
      <Palette ID="21" Name="Rot Gobo 5" Number="0" Page="1" SetControl="Gobo1:21" />
      <Palette ID="22" Name="Rot Gobo 6" Number="0" Page="1" SetControl="Gobo1:22" />
      <Palette ID="23" Name="Rot Gobo 7" Number="0" Page="1" SetControl="Gobo1:23" />
      <Palette ID="24" Name="Rot Gobo 8" Number="0" Page="1" SetControl="Gobo1:24" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
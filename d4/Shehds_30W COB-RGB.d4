      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="51~100" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="101~150" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="151~200" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CB-1010" ShortName="CB-1010" Company="AC Lighting">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="13-03-15" Author="Nic Morris" Comment="Created" />
  <History Date="17-10-17" Author="Nic Morris" Comment="Added channel counts to mode names.  Changed dimmer to intensity in Mode 6 and linked to vdim for compatibility." />
  <History Date="30-11-19" Author="Nic Morris" Comment="Revised wheel mapping for compatibility." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Block" Name="Block" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="All On" Display="'All On'" Dmx="18~34" />
      <Function ID="3" Name="Block 1" Display="'Block 1'" Dmx="35~51" />
      <Function ID="4" Name="Block 2" Display="'Block 2'" Dmx="52~68" />
      <Function ID="5" Name="Block 3" Display="'Block 3'" Dmx="69~85" />
      <Function ID="6" Name="Block 4" Display="'Block 4'" Dmx="86~102" />
      <Function ID="7" Name="Block 1,2" Display="'Block 1,2'" Dmx="103~119" />
      <Function ID="8" Name="Block 2,3" Display="'Block 2,3'" Dmx="120~136" />
      <Function ID="9" Name="Block 3,4" Display="'Block 3,4'" Dmx="137~153" />
      <Function ID="10" Name="Block 1,2,3" Display="'Block 1,2,3'" Dmx="154~170" />
      <Function ID="11" Name="Block 2,3,4" Display="'Block 2,3,4'" Dmx="171~187" />
      <Function ID="12" Name="Block 1,3,4" Display="'Block 1,3,4'" Dmx="188~204" />
      <Function ID="13" Name="Block 1,2,4" Display="'Block 1,2,4'" Dmx="205~221" />
      <Function ID="14" Name="Block 1,3" Display="'Block 1,3'" Dmx="222~238" />
      <Function ID="15" Name="Block 2,4" Display="'Block 2,4'" Dmx="239~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan Off" Display="'Fan Off'" Dmx="11~20" />
      <Function ID="3" Name="Fan Low" Display="'Fan Low'" Dmx="21~30" />
      <Function ID="4" Name="Fan Norm" Display="'Fan Norm'" Dmx="31~40" />
      <Function ID="5" Name="Fan High" Display="'Fan High'" Dmx="41~50" />
      <Function ID="6" Name="Fan Auto" Display="'Fan Auto'" Dmx="51~60" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="61~70" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="71~80" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="81~90" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="91~100" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="101~110" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="111~120" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="121~130" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="131~140" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="141~150" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="151~160" />
      <Function ID="17" Name="Custom 1" Display="'Custom 1'" Dmx="161~170" />
      <Function ID="18" Name="Custom 2" Display="'Custom 2'" Dmx="171~180" />
      <Function ID="19" Name="Custom 3" Display="'Custom 3'" Dmx="181~190" />
      <Function ID="20" Name="Custom 4" Display="'Custom 4'" Dmx="191~200" />
      <Function ID="21" Name="Custom 5" Display="'Custom 5'" Dmx="201~210" />
      <Function ID="22" Name="Custom 6" Display="'Custom 6'" Dmx="211~220" />
      <Function ID="23" Name="Custom 7" Display="'Custom 7'" Dmx="221~230" />
      <Function ID="24" Name="Custom 8" Display="'Custom 8'" Dmx="231~240" />
      <Function ID="25" Name="Custom 9" Display="'Custom 9'" Dmx="241~250" />
      <Function ID="26" Name="Custom 10" Display="'Custom 10'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="61~255" Intensity="0~0" />
      <Function ID="3" Name="Dim Preset" Display="'Dim Preset'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Dim Linear" Display="'Dim Linear'" Dmx="11~20" Intensity="0~0" />
      <Function ID="5" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="21~30" Intensity="0~0" />
      <Function ID="6" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="31~40" Intensity="0~0" />
      <Function ID="7" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="41~50" Intensity="0~0" />
      <Function ID="8" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="51~60" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 10 DMX" Channels="10">
    <Import PearlRef="ACQ10101" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Block" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="9" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="10" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="White" Wheel="40" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="13" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Mode 3, 4 DMX" Channels="4">
    <Import PearlRef="ACQ10103" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 4, 5 DMX" Channels="5">
    <Import PearlRef="ACQ10104" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="40" />
    </Include>
  </Mode>
  <Mode Name="Mode 5, 6 DMX" Channels="6">
    <Import PearlRef="ACQ10105" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />

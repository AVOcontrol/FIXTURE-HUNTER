      <Function ID="3" Name="Green" Display="'Green'" Dmx="40~49" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="50~59" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~69" />

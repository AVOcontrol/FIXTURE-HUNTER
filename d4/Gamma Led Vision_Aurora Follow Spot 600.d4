<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Aurora Follow Spot 600" ShortName="AurFlSp600" Company="Gamma Led Vision" Version="2">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>da26979c-f1f2-4ee2-9e59-685c532e4ebe</Thumbnail>
  <History Date="24-02-26" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="02-03-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="04-03-26" Author="Nic Morris" Comment="Corrected colour index functions from fixed to variable." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9fa19c64-206c-4a8a-9f1f-6e047ab456c2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~159" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="160~191" />
      <Function ID="5" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="47~47" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="73~73" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="116~116" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="121~121" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="176~176" WheelPosition="5" Colour="0,255,255" />
      <Function ID="7" Name="Amber" Display="'Amber'" Dmx="205~205" WheelPosition="6" Colour="255,100,0" />
      <Function ID="8" Name="Violet" Display="'Violet'" Dmx="255~255" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~47" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd - Grn" Display="'Rd - Grn %.f%%',0~100" Dmx="47~73" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Grn - Mag" Display="'Grn - Mag %.f%%',0~100" Dmx="73~116" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Mag - Yel" Display="'Mag - Yel %.f%%',0~100" Dmx="116~121" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Yel - Cy" Display="'Yel - Cy %.f%%',0~100" Dmx="121~176" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Cy - Amb" Display="'Cy - Amb %.f%%',0~100" Dmx="176~205" WheelPosition="5" Colour="0,255,255" />
      <Function ID="15" Name="Amb - Vlt" Display="'Amb - Vlt %.f%%',0~100" Dmx="205~255" WheelPosition="6" Colour="255,100,0" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="5600K" Display="'5600K'" Dmx="64~127" Colour="0,0,0" />
      <Function ID="3" Name="4500K" Display="'4500K'" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="0d597b58-6d3c-4507-9777-c81b139da443">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="00dccb41-c49f-4241-8939-23a2d95dc5ba" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Iris" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Focus" ChannelOffset="6" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="9" Name="Cyan" Number="0" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="10" Name="Violet" Number="7" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="11" Name="Violet" Number="9" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Violet" Number="8" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="15" Name="Violet" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:3:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="da26979c-f1f2-4ee2-9e59-685c532e4ebe"></Swatch>

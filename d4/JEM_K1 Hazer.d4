<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="K1 Hazer" ShortName=" K1  Haze" Company="JEM">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="05-11-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="05-11-08" Author="David Hunt" Comment="Checked" />
  <History Date="06-04-14" Author="Nic Morris" Comment="Overhauled and created two versions in response to customer bug report and in line with manuf documentation." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Haze" Name="Haze" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standby" Display="'Standby'" Dmx="0~0" />
      <Function ID="2" Name="Level" Display="'Level %.1f%%',0.0~100.0" Dmx="20~219" />
      <Function ID="3" Name="Prime" Display="'Prime'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~219" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="220~244" />
      <Function ID="3" Name="Shutdown" Display="'Shutdown'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Haze1" Name="Haze" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standby" Display="'Standby'" Dmx="0~0" />
      <Function ID="2" Name="Level" Display="'Level %.1f%%',0.0~100.0" Dmx="20~219" />
      <Function ID="3" Name="Max" Display="'Max'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan1" Name="Fan" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~219" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="220~244" />
      <Function ID="3" Name="Shutdown" Display="'Shutdown'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="v1.5" Channels="2">
    <Import PearlRef="JM_K1v15" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Haze" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="v2.0" Channels="2">
    <Import PearlRef="JM_K1v20" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Haze1" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Fan1" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Shutdown">
      <Set Channel="Haze:1:0,Haze1:1:0" Delay="1000" />
      <Set Channel="Fan:3,Fan1:3" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
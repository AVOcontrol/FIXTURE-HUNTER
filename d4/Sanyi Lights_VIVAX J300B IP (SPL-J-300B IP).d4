      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~193" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Magic 2" ShortName="Magic 2" Company="BeamZ" Version="0">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>f50950fb-9c06-49cf-b104-213a5569c708</Thumbnail>
  <History Date="24-11-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Magic_Colour" Name="Magic Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R, B, A" Display="'R, B, A'" Dmx="10~44" Colour="255,255,255" />
      <Function ID="3" Name="R, W, A" Display="'R, W, A'" Dmx="45~79" Colour="255,255,255" />
      <Function ID="4" Name="B, G, P" Display="'B, G, P'" Dmx="80~114" Colour="255,255,255" />
      <Function ID="5" Name="R, B, W, A" Display="'R, B, W, A'" Dmx="115~149" Colour="255,255,255" />
      <Function ID="6" Name="G, B, W, A, P" Display="'G, B, W, A, P'" Dmx="150~184" Colour="255,255,255" />
      <Function ID="7" Name="R, G, B, A, P" Display="'R, G, B, A, P'" Dmx="185~219" Colour="255,255,255" />
      <Function ID="8" Name="All Colours On" Display="'All Colours On'" Dmx="220~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~99" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="100~199" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="UV LED" Display="'UV LED'" Dmx="17~33" />
      <Function ID="3" Name="Magic" Display="'Magic'" Dmx="34~50" />
      <Function ID="4" Name="Laser" Display="'Laser'" Dmx="51~67" />
      <Function ID="5" Name="White LED" Display="'White LED'" Dmx="68~84" />
      <Function ID="6" Name="UV LED + Magic" Display="'UV LED + Magic'" Dmx="85~101" />
      <Function ID="7" Name="White LED + Laser" Display="'White LED + Laser'" Dmx="102~118" />
      <Function ID="8" Name="Magic + Laser" Display="'Magic + Laser'" Dmx="119~135" />
      <Function ID="9" Name="Only White LED" Display="'Only White LED'" Dmx="136~152" />
      <Function ID="10" Name="UV LED + Laser" Display="'UV LED + Laser'" Dmx="153~169" />
      <Function ID="11" Name="UV LED + Magic" Display="'UV LED + Magic'" Dmx="170~186" />
      <Function ID="12" Name="UV LED + Magic + Laser" Display="'UV LED + Magic + Laser'" Dmx="187~203" />
      <Function ID="13" Name="White LED + Magic + Laser" Display="'White LED + Magic + Laser'" Dmx="204~220" />
      <Function ID="14" Name="All Effect On" Display="'All Effect On'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Magic_Rot" Name="Magic Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="51~200" />
      <Function ID="3" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Magic_Colour" ChannelOffset="3" Wheel="7" />
        <Attribute ID="Laser" ChannelOffset="4" Wheel="13" />
        <Attribute ID="Mode" ChannelOffset="5" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
        <Attribute ID="Magic_Rot" ChannelOffset="7" Wheel="19" />
        <Attribute ID="Laser_Rot" ChannelOffset="8" Wheel="20" />
        <Attribute ID="Auto" ChannelOffset="9" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="UV LED" ChannelOffset="1" ModeLink="Dim cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="White LED" ChannelOffset="2" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dim cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="f50950fb-9c06-49cf-b104-213a5569c708"></Swatch>
  </swatchLibrary>
</Fixture>
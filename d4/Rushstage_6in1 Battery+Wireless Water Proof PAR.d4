      <Function ID="2" Name="Col Macro" Display="'Col Macro'" Dmx="5~80" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump'" Dmx="81~150" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="151~220" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>

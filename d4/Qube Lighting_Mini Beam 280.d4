      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="191~195" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="196~200" WheelPosition="2" />

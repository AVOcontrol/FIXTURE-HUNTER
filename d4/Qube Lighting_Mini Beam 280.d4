      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~200" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="201~255" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

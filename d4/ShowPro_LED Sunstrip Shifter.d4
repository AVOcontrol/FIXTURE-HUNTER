  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="30550cbf-8518-4ba8-a2a6-4a44cc859a84" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~125" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="126~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~76" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="77~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="121~164" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="165~208" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="209~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red_Shift" Name="Red Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd Mode Off" Display="'Dim Spd Mode Off'" Dmx="52~101" />
      <Function ID="3" Name="Dim Spd Mode 1" Display="'Dim Spd Mode 1'" Dmx="102~152" />
      <Function ID="4" Name="Dim Spd Mode 2" Display="'Dim Spd Mode 2'" Dmx="153~203" />
      <Function ID="5" Name="Dim Spd Mode 3" Display="'Dim Spd Mode 3'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
  </Control>

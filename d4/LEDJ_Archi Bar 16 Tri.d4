  <AtlaBase TypeID="415ffdfe-e73c-41f7-8b37-f2a9eacccb9a" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~10" Colour="0,0,0" />
      <Function ID="2" Name="Safe" Display="'Safe'" Dmx="11~21" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~32" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="33~43" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="44~54" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="55~65" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="66~76" Colour="0,0,255" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="77~87" Colour="128,0,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="88~98" Colour="255,255,255" />
      <Function ID="10" Name="Dream" Display="'Dream'" Dmx="99~109" Colour="0,0,0" />
      <Function ID="11" Name="Meteor" Display="'Meteor'" Dmx="110~120" Colour="0,0,0" />
      <Function ID="12" Name="Fade" Display="'Fade'" Dmx="121~131" Colour="0,0,0" />
      <Function ID="13" Name="Change" Display="'Change'" Dmx="132~142" Colour="0,0,0" />
      <Function ID="14" Name="Flow 1" Display="'Flow 1'" Dmx="143~153" Colour="0,0,0" />
      <Function ID="15" Name="Flow 2" Display="'Flow 2'" Dmx="154~164" Colour="0,0,0" />
      <Function ID="16" Name="Flow 3" Display="'Flow 3'" Dmx="165~175" Colour="0,0,0" />
      <Function ID="17" Name="Flow 4" Display="'Flow 4'" Dmx="176~186" Colour="0,0,0" />
      <Function ID="18" Name="Flow 5" Display="'Flow 5'" Dmx="187~197" Colour="0,0,0" />
      <Function ID="19" Name="Flow 6" Display="'Flow 6'" Dmx="198~208" Colour="0,0,0" />
      <Function ID="20" Name="Flow 7" Display="'Flow 7'" Dmx="209~219" Colour="0,0,0" />
      <Function ID="21" Name="Flow 8" Display="'Flow 8'" Dmx="220~230" Colour="0,0,0" />
      <Function ID="22" Name="Flow 9" Display="'Flow 9'" Dmx="231~241" Colour="0,0,0" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="242~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

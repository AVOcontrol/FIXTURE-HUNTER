      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="RGB_BG_Col" Name="RGB BG Col" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="RGB_BG_Col_Dim" Name="RGB BG Col Dim" Description="" Group="I" Merge="HTP">

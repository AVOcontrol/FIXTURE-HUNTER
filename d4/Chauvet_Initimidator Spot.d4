<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intimidator Spot" ShortName="INT SPOT" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="12-08-08" Author="Jonathan Moreton" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Removed Atlabase ID.  Wrong fixture.  Can't find suitable match or fixture manual." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~179" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="180~223" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="224~250" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="16~31" WheelPosition="1" Colour="255,150,150" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="32~43" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="44~55" WheelPosition="3" Colour="0,128,255" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="56~67" WheelPosition="4" Colour="255,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="68~79" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="80~91" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="92~107" WheelPosition="7" Colour="0,255,0" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="108~119" WheelPosition="8" Colour="255,0,0" />
      <Function ID="10" Name="White/Pink" Display="'White/Pink    %.f%%',0~100" Dmx="239~228" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Pink/Orange" Display="'Pink/Orange   %.f%%',0~100" Dmx="227~216" WheelPosition="1" Colour="255,128,128" />
      <Function ID="12" Name="Orange/Light Blue" Display="'Orange/Light  Blue %.f%%',0~100" Dmx="215~200" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Light Blue/Magenta" Display="'Light Blue/   Magenta %.f%%',0~100" Dmx="199~184" WheelPosition="3" Colour="0,128,255" />
      <Function ID="14" Name="Magenta/Yellow" Display="'Magenta/Yellow %.f%%',0~100" Dmx="183~168" WheelPosition="4" Colour="255,0,255" />
      <Function ID="15" Name="Yellow/Blue" Display="'Yellow/Blue   %.f%%',0~100" Dmx="167~152" WheelPosition="5" Colour="255,255,0" />
      <Function ID="16" Name="Blue/Green" Display="'Blue/Green    %.f%%',0~100" Dmx="151~136" WheelPosition="6" Colour="0,0,255" />
      <Function ID="17" Name="Green/Red" Display="'Green/Red %.f%%',0~100" Dmx="135~120" WheelPosition="7" Colour="0,255,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="9" If="'Gobo1Func'==2" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Leaves" Display="'Leaves'" Dmx="24~47" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="3D Sphere" Display="'3D Sphere'" Dmx="48~71" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Flowers" Display="'Flowers'" Dmx="72~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Shapes" Display="'Shapes'" Dmx="96~119" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Maze" Display="'Maze'" Dmx="120~143" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Mini Triangles" Display="'Mini Triangles'" Dmx="144~167" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Atomic" Display="'Atomic'" Dmx="168~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX, 8bit" Channels="7">
    <Import PearlRef="CH_INTSP1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="510" TiltMax="260" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="6" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="7" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="8" Name="Light Blue" Number="6" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="10" Name="Light Blue" Number="7" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Leaves" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="3D Sphere" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Flowers" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Shapes" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Maze" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Mini Triangles" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Atomic" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
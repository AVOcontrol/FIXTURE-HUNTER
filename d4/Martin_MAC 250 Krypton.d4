      <Condition Name="Shake" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="25,26,27,28" If="'Gobo1Func'==4||'Gobo1Func'==5" />
      <Else ID="29" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">

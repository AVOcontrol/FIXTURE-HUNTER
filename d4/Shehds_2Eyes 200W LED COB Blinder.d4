    <AtlaBase ModeID="37031e81-c611-4e06-83b1-dba86683b733" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">

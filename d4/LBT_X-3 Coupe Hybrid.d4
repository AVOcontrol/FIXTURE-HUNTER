      <Attribute ID="Prism_2" ChannelOffset="14" Wheel="24" />
      <Attribute ID="Frost" ChannelOffset="15" Wheel="21" />
      <Attribute ID="Zoom" ChannelOffset="16,17" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="18,19" Wheel="20" />
      <Attribute ID="AutoFocus" ChannelOffset="20" Wheel="49" />

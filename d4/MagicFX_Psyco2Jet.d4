<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Psyco2Jet" ShortName="Psyco2Jet" Company="MagicFX">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="10-04-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Safety" Name="Safety" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="100~155" />
      <Function ID="3" Name="Test (CO2 output OFF)" Display="'Test (CO2 output OFF)'" Dmx="156~255" />
    </Attribute>
    <Attribute ID="Angle" Name="Angle" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.1f°',-90.0~90.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Output" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Preset" Name="Preset" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset 1" Display="'Preset 1'" Dmx="0~0" />
      <Function ID="2" Name="Preset 2" Display="'Preset 2'" Dmx="25~49" />
      <Function ID="3" Name="Preset 3" Display="'Preset 3'" Dmx="50~74" />
      <Function ID="4" Name="Preset 4" Display="'Preset 4'" Dmx="75~99" />
      <Function ID="5" Name="Preset 5" Display="'Preset 5'" Dmx="100~124" />
      <Function ID="6" Name="Preset 6" Display="'Preset 6'" Dmx="125~149" />
      <Function ID="7" Name="Preset 7" Display="'Preset 7'" Dmx="150~174" />
      <Function ID="8" Name="Preset 8" Display="'Preset 8'" Dmx="175~199" />
      <Function ID="9" Name="Preset 9" Display="'Preset 9'" Dmx="200~224" />
      <Function ID="10" Name="Preset 10" Display="'Preset 10'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Left" Display="'Left'" Dmx="0~0" />
      <Function ID="2" Name="Left Bounce" Display="'Left Bounce'" Dmx="64~127" />
      <Function ID="3" Name="Right Bounce" Display="'Right Bounce'" Dmx="128~191" />
      <Function ID="4" Name="Right" Display="'Right'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Go" Name="Go" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Continuous" Display="'Continuous'" Dmx="200~249" />
      <Function ID="3" Name="Step in Preset" Display="'Step in Preset'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="Safety" Channels="1">
    <Import PearlRef="UKMFP2JS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Safety" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Raw" Channels="3">
    <Import PearlRef="UKMFP2JR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Angle" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Preset" Channels="4">
    <Import PearlRef="UKMFP2JP" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Preset" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Direction" ChannelOffset="3" Wheel="24" />
      <Attribute ID="Go" ChannelOffset="4" Wheel="52" />
    </Include>
  </Mode>
</Fixture>
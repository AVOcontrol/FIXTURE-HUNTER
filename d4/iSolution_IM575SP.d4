      <Function ID="5" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="80~103" Intensity="0~0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="104~127" Intensity="0~0" />
      <Function ID="7" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
    </Attribute>
  </Control>

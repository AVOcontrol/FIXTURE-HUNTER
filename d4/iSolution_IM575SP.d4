      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="28~31" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="32~35" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="36~39" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~3" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 1" Display="'Gobo 1'" Dmx="40~43" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2" Display="'Gobo 2'" Dmx="44~47" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~51" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 4" Display="'Gobo 4'" Dmx="52~55" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 5" Display="'Gobo 5'" Dmx="56~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~63" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 7" Display="'Gobo 7'" Dmx="64~67" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />

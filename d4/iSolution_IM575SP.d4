    <Attribute ID="Gobo1Func1" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Gobo 1 Fixed" Display="'Gobo 1 Fixed'" Dmx="0~0" Update="Gobo11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 2 Fixed" Display="'Gobo 2 Fixed'" Dmx="0~0" Update="Gobo11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Overlay" Display="'Overlay'" Dmx="0~0" Update="Gobo11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 1 Scroll" Display="'Gobo 1 Scroll'" Dmx="0~0" Update="Gobo11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 2 Scroll" Display="'Gobo 2 Scroll'" Dmx="0~0" Update="Gobo11" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="192~212" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="213~234" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="235~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="32~55" Intensity="0~0" />

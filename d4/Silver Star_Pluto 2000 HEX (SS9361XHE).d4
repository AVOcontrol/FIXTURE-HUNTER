<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pluto 2000 HEX (SS9361XHE)" ShortName="Plu2000HEX" Company="Silver Star" Version="14">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="17-12-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="03-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names.  Added physical pan/tilt ranges." Version="2" />
  <History Date="03-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" Version="3" />
  <History Date="03-02-18" Author="Nic Morris" Comment="Added Atlabase ID's (note channel count mismatch for PERSON1, PERSON2 and CMY modes.  Existing agrees with supplied documentation)" Version="4" />
  <History Date="24-07-18" Author="Nic Morris" Comment="Changed name from Pluto 2000XE to Pluto 2000XE (SS646XCE).  Added RDM ID's." Version="5" />
  <History Date="12-03-19" Author="Nic Morris" Comment="Added alternative modes (there appears to be two manuals with different charts.  no indication of version or why)" Version="6" />
  <History Date="16-03-19" Author="Nic Morris" Comment="Swapped PERSON1, PERSON2 and CMY Atlabase ID's to the 13, 21 and 15 channel versions." Version="7" />
  <History Date="22-06-19" Author="Nic Morris" Comment="Added default RDM mode ID's (note HSIC, 13 DMX and PERSON1, 13 DMX will not work without proper Personality ID's.  The multiple versions may also be problematic here)." Version="8" />
  <History Date="08-03-21" Author="Nic Morris" Comment="Updated to latest charts in response to manufacturer request (it is not clear what version this relates to or if it is even another fixture but part number is the same)" Version="9" />
  <History Date="08-03-21" Author="Nic Morris" Comment="Created from Silver Star Pluto 2000XE (SS646XCE) (littered with errors.  channel 6 is missing in PERSON1 bunched up and assumed 17 channels total)" Version="10" />
  <History Date="10-03-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intellaspot XT-1" ShortName="ispot XT-1" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="22-09-10" Author="John Rogers" Comment="Created" />
  <History Date="24-09-10" Author="John Rogers" Comment="Fixed Yellow colour mix to go from 255 to 0." />
  <History Date="27-09-10" Author="John Rogers" Comment="Fixed CTO mix to go from 255 to 0." />
  <History Date="27-09-10" Author="John Rogers" Comment="Edited Closed function in Shutter to start and end at DMX 0 for use in macros." />
  <History Date="28-09-10" Author="John Rogers" Comment="Changed order of fixed colour wheel." />
  <History Date="28-09-10" Author="John Rogers" Comment="Edits made to numerous Func channels, Conditions updated accordingly." />
  <History Date="28-09-10" Author="John Rogers" Comment="Edited DMX ranges in the Control channel to match updates from High End." />
  <History Date="18-10-11" Author="John Rogers" Comment="Added Indigo attributes." />
  <History Date="02-04-12" Author="Peter Budd" Comment="Created seperate spot and indigo highlight modes." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Adjusted wheel resolutions.  Fixed function index." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Updated C-Mix Func to latest spec.  Adjusted CMY to suit." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Revised all other func names and order.  Added Raw DMX functions.  Added gobo conditionals." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Added control functions.  Updated Indigo Highlight functions.  Changed Indigo Dim to percentage range." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Added shutter func to macros.  Fixed control macro return value.  Added shutter to macro return." />
  <History Date="21-04-14" Author="Nic Morris" Comment="Added new control functions to macros.  Shortened functions for Expert LCD." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19538" />
  </RDM>
  <AtlaBase TypeID="a02885e5-2d42-4938-b449-2ffc8a07cd53" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="C-Mix_Func" Name="C-Mix Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed Pure" Display="'Full Speed Pure'" Dmx="0~0" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="2" Name="Full Speed Pure no QP" Display="'Full Speed Pure no QP'" Dmx="96~111" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="3" Name="MSpeed Pure" Display="'MSpeed Pure'" Dmx="128~143" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="4" Name="MSpeed Pure no QP" Display="'MSpeed Pure no QP'" Dmx="224~239" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="5" Name="Full Speed Continuous" Display="'Full Speed Continuous'" Dmx="16~31" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="6" Name="Fulll Speed Cont no QP" Display="'Fulll Speed Cont no QP'" Dmx="112~127" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="7" Name="MSpeed Continuous" Display="'MSpeed Continuous'" Dmx="144~159" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="8" Name="MSpeed Cont no QP" Display="'MSpeed Cont no QP'" Dmx="240~255" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="9" Name="Full Speed Spin" Display="'Full Speed Spin'" Dmx="32~47" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="10" Name="MSpeed Spin" Display="'MSpeed Spin'" Dmx="160~175" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="11" Name="Full Speed Cycle" Display="'Full Speed Cycle'" Dmx="48~63" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="12" Name="Full Speed Random" Display="'Full Speed Random'" Dmx="64~79" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="13" Name="Full Speed Blink" Display="'Full Speed Blink'" Dmx="80~95" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="14" Name="MSpeed Cycle" Display="'MSpeed Cycle'" Dmx="176~191" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="15" Name="MSpeed Random" Display="'MSpeed Random'" Dmx="192~207" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
      <Function ID="16" Name="MSpeed Blink" Display="'MSpeed Blink'" Dmx="208~223" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Speed" ID="2" If="'C-Mix_Func'&gt;10" />
      <Condition Name="Continuous" ID="3,4,5,6" If="'C-Mix_Func'&gt;4&amp;&amp;'C-Mix_Func'&lt;9" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'C-Mix_Func'==9||'C-Mix_Func'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="4" Name="Split" Display="'Split'" Dmx="5~40" Colour="255,255,255" />
      <Function ID="5" Name="Variable" Display="'Variable %.1f%%',0.0~100.0" Dmx="41~248" Colour="255,255,255" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="249~255" Colour="255,255,255" />
      <Function ID="7" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="255~196" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="188~195" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="187~128" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Speed" ID="2" If="'C-Mix_Func'&gt;10" />

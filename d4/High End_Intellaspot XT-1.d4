    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed Index" Display="'Full Speed Index'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />

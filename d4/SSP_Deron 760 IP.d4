      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="10~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Static_FX" Name="Static FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dynamic_FX" Name="Dynamic FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Dynamic_FX_Spd" Name="Dynamic FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="255~128" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="127~0" />
    </Attribute>
    <Attribute ID="Aura_Macro" Name="Aura Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.f%%',0~100" Dmx="2~51" />
      <Function ID="3" Name="Dynamic Effect" Display="'Dynamic Effect %.1f%%',0.0~100.0" Dmx="52~255" />
    </Attribute>
    <Attribute ID="Aura_Macro_Spd" Name="Aura Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control2" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effect" Display="'Reset Effect'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Fan Mute" Display="'Fan Mute'" Dmx="130~134" />
      <Function ID="5" Name="Fan Standard" Display="'Fan Standard'" Dmx="135~139" />
      <Function ID="6" Name="Fan Full" Display="'Fan Full'" Dmx="0~144" />
      <Function ID="7" Name="Reset All" Display="'Reset All'" Dmx="192~255" />
    </Attribute>
  </Control>

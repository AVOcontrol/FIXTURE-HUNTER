      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="201~255" Update="COB_FX_Spd" />
    </Attribute>
    <Attribute ID="COB_FX_Spd" Name="COB FX Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Colour" ID="2" If="'COB_FX'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

      <Function ID="7" Name="Set Runtime 16h" Display="'Set Runtime 16h'" Dmx="208~212" />
      <Function ID="8" Name="Set Runtime 20h" Display="'Set Runtime 20h'" Dmx="213~218" />
      <Function ID="9" Name="LED 800Hz" Display="'LED 800Hz'" Dmx="219~223" />
      <Function ID="10" Name="LED 1200Hz" Display="'LED 1200Hz'" Dmx="224~228" />
      <Function ID="11" Name="LED 2000Hz" Display="'LED 2000Hz'" Dmx="229~233" />
      <Function ID="12" Name="LED 3600Hz" Display="'LED 3600Hz'" Dmx="234~238" />
      <Function ID="13" Name="LED 12kHz" Display="'LED 12kHz'" Dmx="239~243" />

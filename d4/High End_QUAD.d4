    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Static Disable" Display="'Static Disable'" Dmx="0~0" />
      <Function ID="2" Name="Static Speed" Display="'Static Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="3" Name="Anim FW -" Display="'Anim FW - %.f%%',0~100" Dmx="129~191" />
      <Function ID="4" Name="Anim FW x1" Display="'Anim FW x1'" Dmx="192~192" />
      <Function ID="5" Name="Anim FW +" Display="'Anim FW + %.f%%',0~100" Dmx="193~255" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="7" Name="Anim BW -" Display="'Anim BW - %.f%%',0~100" Dmx="0~62" />
      <Function ID="8" Name="Anim BW x1" Display="'Anim BW x1'" Dmx="63~63" />
      <Function ID="9" Name="Anim BW +" Display="'Anim BW + %.f%%',0~100" Dmx="64~126" />
    </Attribute>
    <Attribute ID="Macro_xfade" Name="Macro xfade" Description="" Group="E">
      <Locate Locate="5" PowerOn="5" />
      <Function ID="1" Name="Static Disable" Display="'Static Disable'" Dmx="0~0" />
      <Function ID="2" Name="Static Speed" Display="'Static Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="3" Name="Anim Stop" Display="'Anim Stop'" Dmx="0~0" />
      <Function ID="4" Name="Anim Time -" Display="'Anim Time - %.1f%%',0.0~100.0" Dmx="1~127" />

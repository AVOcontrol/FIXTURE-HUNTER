    <Attribute ID="X_Shift" Name="X Shift" Description="" Group="B">
      <Locate Locate="1:127" PowerOn="1:127" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Blue" ID="2" If="'C-Mix_Func'==3||'C-Mix_Func'==4" />
      <Condition Name="Green" ID="3" If="'C-Mix_Func'==5||'C-Mix_Func'==6" />
      <Condition Name="Cyan" ID="4" If="'C-Mix_Func'==7||'C-Mix_Func'==8" />
      <Condition Name="Yellow" ID="5" If="'C-Mix_Func'==9||'C-Mix_Func'==10" />
      <Condition Name="Magenta" ID="6" If="'C-Mix_Func'==11||'C-Mix_Func'==12" />
      <Condition Name="Speed" ID="7" If="'C-Mix_Func'==13||'C-Mix_Func'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="3" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="4" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
      <Function ID="5" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
      <Function ID="6" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Blue" ID="2" If="'C-Mix_Func'==2||'C-Mix_Func'==6" />
      <Condition Name="Red" ID="3" If="'C-Mix_Func'==3||'C-Mix_Func'==5" />
      <Condition Name="Cyan" ID="4" If="'C-Mix_Func'==9||'C-Mix_Func'==11" />
      <Condition Name="Yellow" ID="5" If="'C-Mix_Func'==8||'C-Mix_Func'==12" />

  <AtlaBase TypeID="22d1d932-5ead-432f-9e78-759d1e267440" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="C-Mix_Func" Name="C-Mix Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="0~0" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="2" Name="RBG" Display="'RBG'" Dmx="16~30" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="3" Name="BRG" Display="'BRG'" Dmx="31~45" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="4" Name="BGR" Display="'BGR'" Dmx="46~60" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="5" Name="GRB" Display="'GRB'" Dmx="61~75" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="6" Name="GBR" Display="'GBR'" Dmx="76~90" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="7" Name="CMY" Display="'CMY'" Dmx="91~105" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="8" Name="CYM" Display="'CYM'" Dmx="106~120" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="9" Name="YCM" Display="'YCM'" Dmx="121~135" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="10" Name="YMC" Display="'YMC'" Dmx="136~150" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="11" Name="MCY" Display="'MCY'" Dmx="151~165" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="12" Name="MYC" Display="'MYC'" Dmx="166~180" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="13" Name="Cycle" Display="'Cycle'" Dmx="181~195" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="196~210" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Red, Green, Blue" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="32~63" />
      <Function ID="3" Name="Synchronous Rnd" Display="'Synchronous Rnd'" Dmx="64~95" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="24~229" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Disable" Display="'Disable'" Dmx="0~0" />
    </Attribute>

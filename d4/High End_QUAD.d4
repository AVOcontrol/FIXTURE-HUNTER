      <Function ID="6" Name="Anim Time +" Display="'Anim Time + %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Speed Off" Display="'P/T Speed Off'" Dmx="16~31" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="32~47" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="48~63" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="64~79" />
      <Function ID="6" Name="Shutdown" Display="'Shutdown'" Dmx="80~95" />
      <Function ID="7" Name="Module X Invert" Display="'Module X Invert'" Dmx="112~127" />
      <Function ID="8" Name="Module X Normal" Display="'Module X Normal'" Dmx="128~143" />
      <Function ID="9" Name="Module Y Invert" Display="'Module Y Invert'" Dmx="144~159" />
      <Function ID="10" Name="Module Y Normal" Display="'Module Y Normal'" Dmx="160~175" />
      <Function ID="11" Name="X/Y Swap" Display="'X/Y Swap'" Dmx="176~191" />
      <Function ID="12" Name="X/Y Normal" Display="'X/Y Normal'" Dmx="192~207" />
      <Function ID="13" Name="Reset Modules" Display="'Reset Modules'" Dmx="208~223" />
      <Function ID="14" Name="Motion Only Macro Mode" Display="'Motion Only Macro Mode'" Dmx="224~239" />
    </Attribute>
    <Attribute ID="Indigo_Func" Name="Indigo Func" Description="" Group="I">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Dimmer Tracking" Display="'Dimmer Tracking'" Dmx="0~0" />
      <Function ID="2" Name="Strobe Tracking" Display="'Strobe Tracking'" Dmx="16~41" />

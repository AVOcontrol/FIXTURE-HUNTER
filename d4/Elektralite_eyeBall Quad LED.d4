<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="eyeBall Quad LED" ShortName="eyeBall Q" Company="Elektralite">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="29-11-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="02-11-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="02-11-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="90dce3f6-8e64-480b-a939-411ad316a778" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="4" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="6" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="8" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="9" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="10" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="11" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="12" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="13" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Dim Spd" />
      <Function ID="2" Name="Fan Off" Display="'Fan Off'" Dmx="11~20" Update="Dim Spd" />
      <Function ID="3" Name="Fan Low" Display="'Fan Low'" Dmx="21~25" Update="Dim Spd" />
      <Function ID="4" Name="Fan High" Display="'Fan High'" Dmx="26~30" Update="Dim Spd" />
      <Function ID="5" Name="Fan Auto" Display="'Fan Auto'" Dmx="31~40" Update="Dim Spd" />
      <Function ID="6" Name="No Effect" Display="'No Effect'" Dmx="41~50" Update="Dim Spd" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="51~70" Update="Dim Spd" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="71~90" Update="Dim Spd" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="91~110" Update="Dim Spd" />
      <Function ID="10" Name="Yellow" Display="'Yellow'" Dmx="111~130" Update="Dim Spd" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="131~150" Update="Dim Spd" />
      <Function ID="12" Name="Purple" Display="'Purple'" Dmx="151~170" Update="Dim Spd" />
      <Function ID="13" Name="White" Display="'White'" Dmx="171~190" Update="Dim Spd" />
      <Function ID="14" Name="Effect 1" Display="'Effect 1'" Dmx="191~210" Update="Dim Spd" />
      <Function ID="15" Name="Effect 2" Display="'Effect 2'" Dmx="211~230" Update="Dim Spd" />
      <Function ID="16" Name="Effect 3" Display="'Effect 3'" Dmx="231~255" Update="Dim Spd" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Crossfade" ID="6" If="'Effect'&gt;13" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="51~100" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="101~150" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="151~200" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="201~255" />
      <Function ID="6" Name="Crossfade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID" Display="'ID %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="ARC.1, 4 DMX" Channels="4">
    <Import PearlRef="EKIBQ4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f70f1b7b-a316-4ab7-b6be-c5c0c5ccb607" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dim_Spd" ChannelOffset="4" Wheel="26" />
    </Include>
  </Mode>

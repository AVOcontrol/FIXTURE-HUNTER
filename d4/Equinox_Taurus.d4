  <History Date="26-09-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~51" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="52~103" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="104~155" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="156~207" />
      <Function ID="5" Name="DMX" Display="'DMX'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Disp_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Solid" Display="'Solid'" Dmx="64~91" />
      <Function ID="3" Name="Dotted" Display="'Dotted'" Dmx="92~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern Folder" Description="" Group="G">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Folder" Display="'Folder %.f',1~32" Dmx="0~255" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo11" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',1~7" Dmx="0~255" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Horiz_Rot" Name="Horizontal Rot" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotate" Display="'Rotate %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Vert_Rot" Name="Vertical Rot" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotate" Display="'Rotate %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Rotate" Display="'Rotate %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom1" Name="Zoom Hrz" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom2" Name="Zoom Vert" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Refresh" Name="Refresh Rate" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Refresh" Display="'Refresh %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX, 8bit" Channels="15">
    <Import PearlRef="UK_EQTaurus" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="15" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="8" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="9" Wheel="3" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="13" />

    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Preset Col" Display="'Preset Col %.1f%%',0.0~100.0" Dmx="11~127" Colour="255,255,255" />
      <Function ID="3" Name="Factory Col" Display="'Factory Col %.1f%%',0.0~100.0" Dmx="130~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Chase" Display="'Chase %.f%%',0~100" Dmx="20~79" />
      <Function ID="3" Name="Custom Chase" Display="'Custom Chase %.f%%',0~100" Dmx="80~127" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="128~159" />
      <Function ID="5" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="160~191" />
      <Function ID="6" Name="Col Pulse" Display="'Col Pulse %.f%%',0~100" Dmx="192~223" />
      <Function ID="7" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="LED" Display="'LED'" Dmx="6~55" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="56~105" />
      <Function ID="4" Name="Less Fast" Display="'Less Fast'" Dmx="106~155" />
      <Function ID="5" Name="Med" Display="'Med'" Dmx="156~205" />
      <Function ID="6" Name="Slow" Display="'Slow'" Dmx="206~255" />
    </Attribute>
  </Control>

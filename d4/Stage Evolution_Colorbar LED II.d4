  <History Date="04-11-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-10-24" Author="Nic Morris" Comment="Added vdim to 14 cells.  Added Atlabase ID's.  Added product thumbnail" Version="2" />
  <History Date="20-05-26" Author="Nic Morris" Comment="Created from Stairville LED IP Bar 320-8 RGB" Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e94c8ded-17d2-4e21-918f-e03d007153ea" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="9~17" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="18~26" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="27~35" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="36~44" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="45~53" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="54~62" />
      <Function ID="8" Name="White" Display="'White'" Dmx="63~71" />
      <Function ID="9" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="72~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Platinum Spot LED Pro" ShortName="PlatSpLPro" Company="Elation" Version="16">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>24ae3584-f8ad-44bc-8329-513eec4c7018</Thumbnail>
  <History Date="05-07-10" Author="Jonathan Moreton" Comment="Created" Version="1" />
  <History Date="05-01-11" Author="Nic Morris" Comment="Adapted from Platinum Spot 5R" Version="2" />
  <History Date="03-05-11" Author="Nic Morris" Comment="Standardised func names.  Fixed raw ranges.  Added raw to Gobo2Func." Version="3" />
  <History Date="03-05-11" Author="Nic Morris" Comment="Adjusted wheel resolutions.  Fixed power on and locate." Version="4" />
  <History Date="10-05-11" Author="Nic Morris" Comment="Removed percentage value from macro return function." Version="5" />
  <History Date="10-05-11" Author="Nic Morris" Comment="Increased macro delay in attempt to resolve reported bug.  There are no details from manuf." Version="6" />
  <History Date="09-08-12" Author="Peter Budd" Comment="Created Platinum Spot 15R Pro" Version="7" />
  <History Date="26-03-13" Author="Peter Budd" Comment="Created from the Elation Platinum Beam 15R Pro" Version="8" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Fixed typo in Gobo1, Gobo 7 shake.  Increased focus and iris wheel resolution for 16bit." Version="9" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Inverted iris range for more logical wheel mapping.  Adjusted locate value to suit." Version="10" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Moved colour func index next to fixed and added function index." Version="11" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Inverted P/T speed wheel direction.  Removed Prism Rot update from Prism Func" Version="12" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Removed Index func from Prism Func.  Reordered shutter functions." Version="13" />
  <History Date="20-12-13" Author="Nic Morris" Comment="Added colour func to highlight and lowlight.  Fixed palettes." Version="14" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="15" />
  <History Date="20-01-23" Author="Nic Morris" Comment="Increased macro delay to 11s in response to customer feedback (not documentated)" Version="16" />
  <History Date="20-01-23" Author="Nic Morris" Comment="Added product thumbnail. Revised iris functions in line with latest documentation. Standardised.  Recreated palettes." Version="16" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="93c5bab8-0506-4f09-95eb-d3c863cf56e0" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />

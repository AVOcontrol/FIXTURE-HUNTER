<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini Ultra Scan 2" ShortName="MnUltraSc2" Company="Tas">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="30-04-10" Author="Personality Builder" Comment="Imported from Pearl Personality: TAMINI2.R20" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="26-06-17" Author="Nic Morris" Comment="Fixed wheel mapping error.  Removed Atlabase ID (wrong fixture)." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Changed physical type from fixed to moving mirror.  Changed display name from device name." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Changed mode name from 'Ultra Scan 2' to '8 DMX'.  Changed shutter to dimmer." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Changed gobo and gobo rot display range from percentage 0-100 to value 0-255." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Fixed palettes (using R20 - no manual available.  Original conversion assumed percentage range)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:144" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="TA_MiniUS2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="6" Wheel="17" />
      <Attribute ID="Reserved" ChannelOffset="3" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:1:50" Delay="1600" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Positions">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="1" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="1" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="1" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="1" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="1" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="1" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="1" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="1" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Colors">
      <Palette ID="1" Name="Open" Legend="Colour1" Number="1" Page="1" SetControl="Colour1:1:0" />
      <Palette ID="1" Name="Colour 1" Number="2" Page="1" SetControl="Colour1:1:40" />
      <Palette ID="1" Name="Colour 2" Number="3" Page="1" SetControl="Colour1:1:64" />
      <Palette ID="1" Name="Colour 3" Number="4" Page="1" SetControl="Colour1:1:88" />
      <Palette ID="1" Name="Colour 4" Number="5" Page="1" SetControl="Colour1:1:96" />
      <Palette ID="1" Name="Colour 5" Number="6" Page="1" SetControl="Colour1:1:120" />
      <Palette ID="1" Name="Colour 6" Number="7" Page="1" SetControl="Colour1:1:144" />
      <Palette ID="1" Name="Colour 7" Number="8" Page="1" SetControl="Colour1:1:168" />
      <Palette ID="1" Name="Colour 8" Number="9" Page="1" SetControl="Colour1:1:192" />
      <Palette ID="1" Name="Colour 9" Number="10" Page="1" SetControl="Colour1:1:216" />
    </Group>
    <Group Name="Gobos">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1:0" />
      <Palette ID="1" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:1:40" />
      <Palette ID="1" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:1:64" />
      <Palette ID="1" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:1:88" />
      <Palette ID="1" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:1:96" />
      <Palette ID="1" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:1:120" />
      <Palette ID="1" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:1:144" />
      <Palette ID="1" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:1:168" />
      <Palette ID="1" Name="Gobo 8" Number="19" Page="1" SetControl="Gobo1:1:192" />
      <Palette ID="1" Name="Gobo 9" Number="20" Page="1" SetControl="Gobo1:1:216" />
    </Group>
  </Palettes>
</Fixture>
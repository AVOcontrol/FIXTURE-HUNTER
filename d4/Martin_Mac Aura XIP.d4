    <Attribute ID="FX_2_Adjust" Name="FX 2 Adjust" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~130" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="127~129" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="126~0" />
    </Attribute>
    <Attribute ID="FX_Sync" Name="FX Sync" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sync" Display="'No Sync'" Dmx="0~0" />

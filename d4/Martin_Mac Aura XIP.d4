    <Attribute ID="Beam_Col_Func" Name="Beam Col Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Beam_Colour" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Beam_Colour" Colour="0,0,0" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="0~0" Update="Beam_Colour" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin SPIIDER" ShortName="SPIIDER" Company="Robe" Version="83">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>35c52ab4-7aa4-4106-879a-9c1b61db8316</Thumbnail>
  <History Date="22-03-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="25-03-16" Author="Nic Morris" Comment="Added new DFE functions in line with latest spec as cells in response to manufacturer request." Version="2" />
  <History Date="25-07-16" Author="Nic Morris" Comment="Updated in line with latest spec (1.0) in response to manufacturer request." Version="3" />
  <History Date="02-09-16" Author="Nic Morris" Comment="Updated to 1.1 spec in response to manufacturer request." Version="4" />
  <History Date="02-09-16" Author="Nic Morris" Comment="Added cell layout to mode 4." Version="5" />
  <History Date="05-09-16" Author="Nic Morris" Comment="Changed DFE Rot to locate at disabled." Version="6" />
  <History Date="29-09-16" Author="Nic Morris" Comment="Changed name from Robin SPIIDER 8 to Robin SPIIDER" Version="7" />
  <History Date="03-10-16" Author="Peter Budd" Comment="Inverted close pulse shutter range. Changed default Col Mix Func to Pixel for Mode 4 by adding new Col Mix Func Channel." Version="8" />
  <History Date="13-11-16" Author="Nic Morris" Comment="Merged master links for flower attributes." Version="9" />
  <History Date="13-11-16" Author="Nic Morris" Comment="Updated to v1.2 spec" Version="10" />
  <History Date="17-11-16" Author="Nic Morris" Comment="Added cell links.  (Editable version.  Virtual Col, RGBW, CTO and Active Zone need to be manually removed after save)." Version="11" />
  <History Date="17-11-16" Author="Nic Morris" Comment="Reordered cells in Modes 4, 5 and 6 so that the LED's will follow numeric selection." Version="12" />
  <History Date="17-11-16" Author="Nic Morris" Comment="Separated flower, background and pattern cells from LED layout in modes 4, 5 and 6 so that they can be selected in Attribute Editor." Version="13" />
  <History Date="17-11-16" Author="Nic Morris" Comment="Moved all colour attributes into C-Mix wheel slots in attempt to maintain reasonable order for all consoles wheels and Attribute Editor." Version="14" />
  <History Date="16-12-16" Author="Nic Morris" Comment="Revised in line with 1.3 spec in response to manufacturer request." Version="15" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Updated to v1.4 charts in response to manufacturer request." Version="16" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Added Atlabase ID's to Modes 8+9. (Note Capture Mode 5 currently has incorrect channel count and modes 6,7 and 10 need updating to v1.4.)" Version="17" />
  <History Date="23-02-17" Author="Nic Morris" Comment="Fixed missing white cell link in modes 5-10.  Fixed dimmer power on (was at full)" Version="18" />
  <History Date="25-02-17" Author="Nic Morris" Comment="Revised some default values in line with v1.5 charts." Version="19" />
  <History Date="24-03-17" Author="Nic Morris" Comment="Unified control functions and macros across all modes and revised virtual col names in line with v1.6 charts (changed from Lxxx to Filter xxx)" Version="20" />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added Atlabase ID's to modes 5,6,9 and 10." Version="21" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Updated in line with v1.7 charts (added parking position + pixel control functions/macros)." Version="22" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised mode names with descriptions and channel counts." Version="23" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Added split mode options for modes 4,7,8,9 and 10." Version="24" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Linked pixel attributes in pixel modes and background attributes in non-pixel modes to standard master attributes." Version="25" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Shortened 'Patt Transition' to 'Patt Trans' to comply with 14char limit attribute display name limit." Version="26" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Changed 'Pixel Index' control function to variable range.  Revised Virtual Col + BG Virtual Col scroll function names." Version="27" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Inverted zoom.  Changed pattern transition display range to miliseconds." Version="28" />
  <History Date="23-10-17" Author="Nic Morris" Comment="Revised tilt range." Version="29" />
  <History Date="12-12-17" Author="Nic Morris" Comment="Added Save pixel index+mirror control function and macro in line with v1.8 charts in response to manufacturer request." Version="30" />
  <History Date="02-10-18" Author="Nic Morris" Comment="Please note if this personality is opened in an earlier version of Personality Builder than 3.1.4.5 it will remove some or all of the cell links." Version="31" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) if this is then saved/used in a show it will not prevent the personality from working but it will prevent" Version="32" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) the ability to control cell controls from the master fixture (notably including the locate function)" Version="33" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) and may cause issues with other console functions such as record by fixture and tracking." Version="34" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) Therefore, if this occurs (or has occurred) the links should be reinstated.  This should be done using" Version="35" />
  <History Date="02-10-18" Author="Nic Morris" Comment="version 3.1.4.5 (or later if available) of Personality Builder." Version="36" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) Ideally this Personality should be opened in Personality Builder version 3.1.4.5 or later where the cell links will be preserved correctly." Version="37" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) You can check the current version of Personality Builder on a console by going to the Tools menu and selecting 'About'." Version="38" />
  <History Date="02-10-18" Author="Nic Morris" Comment="(cont.) on a PC right-click on the Personality Builder.exe application, select 'Properties' and then the 'Details' tab." Version="39" />
  <History Date="12-01-19" Author="Nic Morris" Comment="Added product thumbnail.  Added compatibility for d4 in response to customer bug report (main modes only)" Version="40" />
  <History Date="05-06-19" Author="Nic Morris" Comment="Updated in line with version 2.0 charts in response to manufacturer request (adds control LED frequency and macros)" Version="41" />
  <History Date="08-09-20" Author="Nic Morris" Comment="Updated Altabase mode ID's to latest version." Version="42" />
  <History Date="25-03-22" Author="Nic Morris" Comment="Added CMY mode options.  Renamed existing with RGBW." Version="43" />
  <History Date="24-09-23" Author="Nic Morris" Comment="Major overhaul.  Changed all RGBW mode cells to use virtual dimmer and linked all cell dimmers to dimmer to avoid issues resulting from linking to LTP master controls such as Flower and Pattern Dimmer." Version="67" />
  <History Date="24-09-23" Author="Nic Morris" Comment="Retained existing 'vdim' cell modes for update/exchange compatibility.  Changed all cell c-mix controls to link to standard c-mix master controls.  Added patterns 12-14 in line with latest charts v2.3)" Version="71" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's (note personality ID's are duplicated for CMY and RGBW modes)" Version="83" />
  <Manual Filename="" Summary="" />

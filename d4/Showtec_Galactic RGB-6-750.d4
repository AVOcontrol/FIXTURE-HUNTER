    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~169" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="170~209" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="9, 7, 12 DMX" ID="1,2,3" If="'Dummy1'==1" />
      <Else ID="4" />
      <Function ID="1" Name="X-Pos" Display="'X-Pos %.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="L-&gt;R" Display="'L-&gt;R %.f%%',0~100" Dmx="192~223" />
      <Function ID="3" Name="R-&gt;L" Display="'R-&gt;L %.f%%',0~100" Dmx="224~255" />
      <Function ID="4" Name="X-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="9, 7, 12 DMX" ID="1,2,3" If="'Dummy1'==1" />
      <Else ID="4" />
      <Function ID="1" Name="Y-Pos" Display="'Y-Pos %.1f%%',0.0~100.0" Dmx="0~191" />
      <Function ID="2" Name="Down-&gt;Up" Display="'Down-&gt;Up %.f%%',0~100" Dmx="192~223" />
      <Function ID="3" Name="Up-&gt;Down" Display="'Up-&gt;Down %.f%%',0~100" Dmx="224~255" />
      <Function ID="4" Name="Y-Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Laser_Mirror" Name="Laser Mirror" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="1,2,3 + 4,5,6 Mirror X" Display="'1,2,3 + 4,5,6 Mirror X'" Dmx="16~55" />
      <Function ID="3" Name="1,3,5 + 2,4,6 Mirror X" Display="'1,3,5 + 2,4,6 Mirror X'" Dmx="56~95" />
      <Function ID="4" Name="1,2,3 + 4,5,6 Mirror Y" Display="'1,2,3 + 4,5,6 Mirror Y'" Dmx="96~135" />
      <Function ID="5" Name="1,3,5 + 2,4,6 Mirror Y" Display="'1,3,5 + 2,4,6 Mirror Y'" Dmx="136~175" />
      <Function ID="6" Name="1,2,3 + 4,5,6 Mirror X+Y" Display="'1,2,3 + 4,5,6 Mirror X+Y'" Dmx="176~215" />
      <Function ID="7" Name="1,3,5 + 2,4,6 Mirror X+Y" Display="'1,3,5 + 2,4,6 Mirror X+Y'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="6~100" Colour="255,255,255" />
      <Function ID="3" Name="Default" Display="'Default'" Dmx="101~115" Colour="255,255,255" />
      <Function ID="4" Name="Fixed Combination" Display="'Fixed Combination'" Dmx="116~185" Colour="255,255,255" />
      <Function ID="5" Name="Col Flow" Display="'Col Flow'" Dmx="186~254" Colour="255,255,255" />
      <Function ID="6" Name="Col Flow Stop" Display="'Col Flow Stop'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Manual" Display="'Manual'" Dmx="1~100" Update="Red" />
      <Function ID="3" Name="Default Col" Display="'Default Col'" Dmx="101~138" Update="Red" />
      <Function ID="4" Name="Static Col" Display="'Static Col'" Dmx="139~177" Update="Red" />
      <Function ID="5" Name="Multiple Cols" Display="'Multiple Cols'" Dmx="178~215" Update="Red" />
      <Function ID="6" Name="Col Flow" Display="'Col Flow'" Dmx="216~255" Update="Red" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="191~128" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="191~128" />

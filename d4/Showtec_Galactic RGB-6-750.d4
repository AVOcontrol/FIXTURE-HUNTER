  <AtlaBase TypeID="1b2bd85e-710d-4d26-b18d-00de6142df06" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="9 DMX" ID="2,3,4,5,6,7" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.f%%',0~100" Dmx="0~100" />
      <Function ID="3" Name="Max Intensity" Display="'Max Intensity'" Dmx="101~110" />
      <Function ID="4" Name="Default Colour" Display="'Default Colour'" Dmx="111~125" />
      <Function ID="5" Name="Col Switch" Display="'Col Switch %.f%%',0~100" Dmx="126~190" />
      <Function ID="6" Name="Col Flow" Display="'Col Flow %.f%%',0~100" Dmx="191~254" />
      <Function ID="7" Name="Col Flow Stop" Display="'Col Flow Stop'" Dmx="255~255" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Static Col" ID="2,3,4,5,6,7,8" If="'Mode'==4" />
      <Condition Name="Multiple Cols" ID="9,10,11,12,13,14,15" If="'Mode'==5" />
      <Condition Name="Col Flow" ID="16,17" If="'Mode'==6" />
      <Else ID="1" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~73" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="74~110" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="111~147" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="148~184" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="185~221" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="222~255" Colour="255,255,255" />
      <Function ID="9" Name="Grn, Cy, Mag, Yel" Display="'Grn, Cy, Mag, Yel'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Blu, Cy, Mag, Yel" Display="'Blu, Cy, Mag, Yel'" Dmx="37~73" Colour="255,255,255" />
      <Function ID="11" Name="W, Cy, Mag, Yel" Display="'W, Cy, Mag, Yel'" Dmx="74~110" Colour="255,255,255" />
      <Function ID="12" Name="Rd, W, Cy, Mag" Display="'Rd, W, Cy, Mag'" Dmx="111~147" Colour="255,255,255" />
      <Function ID="13" Name="Rd, Grn, W, Cy" Display="'Rd, Grn, W, Cy'" Dmx="148~184" Colour="255,255,255" />
      <Function ID="14" Name="Rd, Grn, Blu, W" Display="'Rd, Grn, Blu, W'" Dmx="185~221" Colour="255,255,255" />
      <Function ID="15" Name="Rd, Grn, Blu, Yel" Display="'Rd, Grn, Blu, Yel'" Dmx="222~225" Colour="255,255,255" />
      <Function ID="16" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~254" Colour="255,255,255" />
      <Function ID="17" Name="Stop" Display="'Stop'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

  <AtlaBase TypeID="88b29207-2717-4306-b0de-0c08fd579190" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~84" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="85~169" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~30" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="31~61" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="62~92" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="93~123" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="124~154" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="155~185" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="186~216" Colour="255,255,255" />
      <Function ID="9" Name="Full Light" Display="'Full Light'" Dmx="217~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~38" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="39~57" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="58~76" />
      <Function ID="5" Name="White" Display="'White'" Dmx="77~95" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="96~114" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="115~133" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="134~152" />
      <Function ID="9" Name="Full Bright" Display="'Full Bright'" Dmx="153~171" />
      <Function ID="10" Name="Jump" Display="'Jump'" Dmx="172~190" />
      <Function ID="11" Name="Gradient" Display="'Gradient'" Dmx="191~209" />
      <Function ID="12" Name="Strobe" Display="'Strobe'" Dmx="210~228" />
      <Function ID="13" Name="Complete Effect" Display="'Complete Effect'" Dmx="229~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="245~255" />
    </Attribute>
  </Control>

    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="10m" Display="'10m'" Dmx="7~7" />
      <Function ID="3" Name="20m" Display="'20m'" Dmx="51~51" />
      <Function ID="4" Name="30m" Display="'30m'" Dmx="77~77" />
      <Function ID="5" Name="40m" Display="'40m'" Dmx="102~102" />
      <Function ID="6" Name="50-100m" Display="'50-100m'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-" Display="'- %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="In Focus" Display="'In Focus'" Dmx="127~127" />
      <Function ID="3" Name="+" Display="'+ %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Blade_Macro" Name="Blade Macro" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Max Square" Display="'Max Square'" Dmx="8~15" />
      <Function ID="3" Name="Min Square" Display="'Min Square'" Dmx="16~23" />
      <Function ID="4" Name="Bar" Display="'Bar'" Dmx="24~31" />
      <Function ID="5" Name="Rectangular" Display="'Rectangular'" Dmx="32~39" />
      <Function ID="6" Name="Vertical Bars" Display="'Vertical Bars'" Dmx="40~47" />
      <Function ID="7" Name="Rectangular" Display="'Rectangular'" Dmx="48~55" />
      <Function ID="8" Name="Max Iso Trap" Display="'Max Iso Trap'" Dmx="56~63" />

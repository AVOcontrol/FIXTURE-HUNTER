      <Function ID="10" Name="Min Iso Tri Up" Display="'Min Iso Tri Up'" Dmx="72~79" />
      <Function ID="11" Name="Max Iso Tri Dn" Display="'Max Iso Tri Dn'" Dmx="80~87" />
      <Function ID="12" Name="Min Iso Tri Dn" Display="'Min Iso Tri Dn'" Dmx="88~95" />
      <Function ID="13" Name="Max Iso Tri Left" Display="'Max Iso Tri Left'" Dmx="96~103" />
      <Function ID="14" Name="Min Iso Tri Left" Display="'Min Iso Tri Left'" Dmx="104~111" />
      <Function ID="15" Name="Max Iso Tri Right" Display="'Max Iso Tri Right'" Dmx="112~119" />
      <Function ID="16" Name="Min Iso Tri Right" Display="'Min Iso Tri Right'" Dmx="120~127" />
      <Function ID="17" Name="Up Semicircle" Display="'Up Semicircle'" Dmx="128~135" />
      <Function ID="18" Name="Right Upper Fan" Display="'Right Upper Fan'" Dmx="136~143" />
      <Function ID="19" Name="Right Semicircle" Display="'Right Semicircle'" Dmx="144~151" />
      <Function ID="20" Name="Lower Right Fan" Display="'Lower Right Fan'" Dmx="152~159" />
      <Function ID="21" Name="Lower Semicircle" Display="'Lower Semicircle'" Dmx="160~167" />
      <Function ID="22" Name="Lower Left Fan" Display="'Lower Left Fan'" Dmx="168~175" />
      <Function ID="23" Name="Left Semicircle" Display="'Left Semicircle'" Dmx="176~183" />
      <Function ID="24" Name="Left Upper Fan" Display="'Left Upper Fan'" Dmx="184~191" />
      <Function ID="25" Name="No Macro" Display="'No Macro'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Calibration" Name="Calibration" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

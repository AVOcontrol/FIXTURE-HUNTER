      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="34~37" WheelPosition="8" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="38~42" WheelPosition="9" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="43~46" WheelPosition="10" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="47~51" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="52~55" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="56~59" WheelPosition="13" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Animation" Display="'Animation'" Dmx="60~71" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="160~166" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="167~173" WheelPosition="2" />

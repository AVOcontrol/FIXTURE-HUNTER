      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="118~159" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

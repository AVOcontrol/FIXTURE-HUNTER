      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="210~224" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="225~239" />
      <Function ID="17" Name="All Off" Display="'All Off'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Change" Display="'Change %.1f%%',0.0~100.0" Dmx="6~140" />
      <Function ID="3" Name="7 Col Run" Display="'7 Col Run'" Dmx="141~154" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="155~161" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="162~168" />
      <Function ID="6" Name="Auto 3" Display="'Auto 3'" Dmx="169~175" />
      <Function ID="7" Name="Auto 4" Display="'Auto 4'" Dmx="176~182" />
      <Function ID="8" Name="Auto 5" Display="'Auto 5'" Dmx="183~189" />
      <Function ID="9" Name="Auto 6" Display="'Auto 6'" Dmx="190~196" />
      <Function ID="10" Name="Auto 7" Display="'Auto 7'" Dmx="197~203" />
      <Function ID="11" Name="Auto 8" Display="'Auto 8'" Dmx="204~210" />
      <Function ID="12" Name="Auto 9" Display="'Auto 9'" Dmx="211~217" />
      <Function ID="13" Name="Auto 10" Display="'Auto 10'" Dmx="218~224" />

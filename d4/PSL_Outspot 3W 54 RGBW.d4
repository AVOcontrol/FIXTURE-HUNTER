      <Function ID="16" Name="Auto 13" Display="'Auto 13'" Dmx="239~245" />
      <Function ID="17" Name="Off" Display="'Off'" Dmx="246~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">

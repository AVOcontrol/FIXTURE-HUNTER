    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~44" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="45~64" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="65~234" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="235~244" />
      <Function ID="5" Name="Safe" Display="'Safe'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="PT_Macro" Name="P/T Macro" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Macro" Display="'Macro %.f',0~255" Dmx="0~255" />

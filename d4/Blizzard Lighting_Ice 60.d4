      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="70~76" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="63~69" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="119~125" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="126~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="119~125" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />

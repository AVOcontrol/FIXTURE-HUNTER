<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="YK50 Dual Arm Yoke" ShortName="YK50 Yoke" Company="Christie Digital">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="19-09-12" Author="Peter Budd" Comment="Created" />
  <History Date="24-10-12" Author="Peter Budd" Comment="Created from the Christie Digital YK-200 Dual Arm Yoke" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Motor_Mode" Name="Motor Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 0" Display="'Mode 0'" Dmx="0~32" />
      <Function ID="2" Name="Mode 1" Display="'Mode 1'" Dmx="33~64" />
      <Function ID="3" Name="Mode 2" Display="'Mode 2'" Dmx="65~96" />
      <Function ID="4" Name="Mode 3" Display="'Mode 3'" Dmx="97~128" />
      <Function ID="5" Name="Mode 4" Display="'Mode 4'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Beam" Display="'Reset Beam'" Dmx="15~15" />
      <Function ID="3" Name="Reset Yoke" Display="'Reset Yoke'" Dmx="20~20" />
      <Function ID="4" Name="Load" Display="'Load'" Dmx="86~86" />
      <Function ID="5" Name="Execute" Display="'Execute'" Dmx="171~171" />
    </Attribute>
    <Attribute ID="Video_Func" Name="Video Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="2~2" />
      <Function ID="3" Name="Power On" Display="'Power On'" Dmx="4~4" />
      <Function ID="4" Name="Power Off" Display="'Power Off'" Dmx="6~6" />
      <Function ID="5" Name="Input 1" Display="'Input 1'" Dmx="8~8" />
      <Function ID="6" Name="Input 2" Display="'Input 2'" Dmx="10~10" />
      <Function ID="7" Name="Input 3" Display="'Input 3'" Dmx="12~12" />
      <Function ID="8" Name="Input 4" Display="'Input 4'" Dmx="14~14" />
      <Function ID="9" Name="Mute On" Display="'Mute On'" Dmx="16~16" />
      <Function ID="10" Name="Mute Off" Display="'Mute Off'" Dmx="18~18" />
      <Function ID="11" Name="4:3 Image" Display="'4:3 Image'" Dmx="20~20" />
      <Function ID="12" Name="Wide Image" Display="'Wide Image'" Dmx="22~22" />
      <Function ID="13" Name="Menu On" Display="'Menu On'" Dmx="24~24" />
      <Function ID="14" Name="Menu Off" Display="'Menu Off'" Dmx="26~26" />
      <Function ID="15" Name="Display Clear" Display="'Display Clear'" Dmx="28~28" />
      <Function ID="16" Name="Image" Display="'Image'" Dmx="30~30" />
      <Function ID="17" Name="Freeze On" Display="'Freeze On'" Dmx="36~36" />
      <Function ID="18" Name="Freeze Off" Display="'Freeze Off'" Dmx="38~38" />
      <Function ID="19" Name="Auto PC Adjust" Display="'Auto PC Adjust'" Dmx="56~56" />
      <Function ID="20" Name="Load" Display="'Load'" Dmx="86~86" />
      <Function ID="21" Name="Execute" Display="'Execute'" Dmx="171~171" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="UK_ChDYK50" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Motor_Mode" ChannelOffset="5" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Video_Func" ChannelOffset="7" Wheel="30" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Beam">
      <Set Channel="Control:2" Delay="2000" />
      <Set Channel="Control:8" Delay="2000" />
      <Set Channel="Control:9" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Yoke">
      <Set Channel="Control:3" Delay="2000" />
      <Set Channel="Control:8" Delay="2000" />
      <Set Channel="Control:9" Delay="2000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Video_Func:2" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Power On">
      <Set Channel="Video_Func:3" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Power Off">
      <Set Channel="Video_Func:4" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Input 1">
      <Set Channel="Video_Func:5" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Input 2">
      <Set Channel="Video_Func:6" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Input 3">
      <Set Channel="Video_Func:7" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Input 4">
      <Set Channel="Video_Func:8" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Mute On">
      <Set Channel="Video_Func:9" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Mute Off">
      <Set Channel="Video_Func:10" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Set 4:3 Image">
      <Set Channel="Video_Func:11" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Set Wide Image">
      <Set Channel="Video_Func:11" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Menu On">
      <Set Channel="Video_Func:13" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Menu Off">
      <Set Channel="Video_Func:14" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Display Clear">
      <Set Channel="Video_Func:15" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Image">
      <Set Channel="Video_Func:16" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Freeze On">
      <Set Channel="Video_Func:17" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Freeze Off">
      <Set Channel="Video_Func:18" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />
    </Macro>
    <Macro Name="Auto PC Adjust">
      <Set Channel="Video_Func:19" Delay="2000" />
      <Set Channel="Video_Func:20" Delay="2000" />
      <Set Channel="Video_Func:21" Delay="2000" />
      <Set Channel="Video_Func:1" Delay="0" />

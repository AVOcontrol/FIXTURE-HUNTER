<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="D3" ShortName="D3" Company="d3 Technologies">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="02-06-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Command" Name="Command" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="10~20" />
      <Function ID="3" Name="Play to End Section" Display="'Play to End Section'" Dmx="21~30" />
      <Function ID="4" Name="Loop Section" Display="'Loop Section'" Dmx="31~40" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="41~50" />
      <Function ID="6" Name="Next Section" Display="'Next Section'" Dmx="51~60" />
      <Function ID="7" Name="Prev Section" Display="'Prev Section'" Dmx="61~70" />
      <Function ID="8" Name="Next Cue" Display="'Next Cue'" Dmx="71~80" />
      <Function ID="9" Name="Go to Cue" Display="'Go to Cue'" Dmx="81~90" />
      <Function ID="10" Name="Return to Start" Display="'Return to Start'" Dmx="91~100" />
      <Function ID="11" Name="Track Select" Display="'Track Select'" Dmx="101~110" />
    </Attribute>
    <Attribute ID="Track_Select" Name="Track Select" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Execute_Command" Name="Execute Command" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Execute Command" Display="'Execute Command'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Go_to_Cue_XX" Name="Go to Cue XX" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Go_to_Cue_YY" Name="Go to Cue YY" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Go_to_Cue_ZZ" Name="Go to Cue ZZ" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Play_Status" Name="Play Status" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="10~20" />
      <Function ID="3" Name="Play to End Section" Display="'Play to End Section'" Dmx="21~30" />
      <Function ID="4" Name="Loop Section" Display="'Loop Section'" Dmx="31~40" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="41~50" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKD3D3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Command" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Track_Select" ChannelOffset="3" Wheel="20" />
      <Attribute ID="Execute_Command" ChannelOffset="4" Wheel="21" />
      <Attribute ID="Go_to_Cue_XX" ChannelOffset="5" Wheel="13" />
      <Attribute ID="Go_to_Cue_YY" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Go_to_Cue_ZZ" ChannelOffset="7" Wheel="15" />
      <Attribute ID="Play_Status" ChannelOffset="8" Wheel="25" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Execute Command">
      <Set Channel="Execute_Command:2" Delay="1000" />
      <Set Channel="Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Play">
      <Set Channel="Command:2" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Play to End Section">
      <Set Channel="Command:3" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Loop Section">
      <Set Channel="Command:4" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Stop">
      <Set Channel="Command:5" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Next Section">
      <Set Channel="Command:6" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Prev Section">
      <Set Channel="Command:7" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Next Cue">
      <Set Channel="Command:8" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Go to Cue">
      <Set Channel="Command:9" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Return to Start">
      <Set Channel="Command:10" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
    <Macro Name="Track Select">
      <Set Channel="Command:11" Delay="500" />
      <Set Channel="Execute_Command:2" Delay="500" />
      <Set Channel="Command:1,Execute_Command:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Glamor Video Panel 4096" ShortName="GVP 4096" Company="Taurus Light">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f Hz',2.0~15.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Program_1-15" Name="Program 1-15" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~31" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="32~47" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="48~63" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="64~79" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="80~95" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="96~111" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="112~127" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="128~143" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="144~159" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="160~175" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="176~191" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="192~207" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="208~223" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="224~239" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_16-29" Name="Program 16-29" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Program 16" Display="'Program 16'" Dmx="16~31" />
      <Function ID="3" Name="Program 17" Display="'Program 17'" Dmx="32~47" />
      <Function ID="4" Name="Program 18" Display="'Program 18'" Dmx="48~63" />
      <Function ID="5" Name="Program 19" Display="'Program 19'" Dmx="64~79" />
      <Function ID="6" Name="Program 20" Display="'Program 20'" Dmx="80~95" />
      <Function ID="7" Name="Program 21" Display="'Program 21'" Dmx="96~111" />
      <Function ID="8" Name="Program 22" Display="'Program 22'" Dmx="112~127" />
      <Function ID="9" Name="Program 23" Display="'Program 23'" Dmx="128~143" />
      <Function ID="10" Name="Program 24" Display="'Program 24'" Dmx="144~159" />
      <Function ID="11" Name="Program 25" Display="'Program 25'" Dmx="160~175" />
      <Function ID="12" Name="Program 26" Display="'Program 26'" Dmx="176~191" />
      <Function ID="13" Name="Program 27" Display="'Program 27'" Dmx="192~207" />
      <Function ID="14" Name="Program 28" Display="'Program 28'" Dmx="208~223" />
      <Function ID="15" Name="Program 29" Display="'Program 29'" Dmx="224~239" />
      <Function ID="16" Name="Program 1-29" Display="'Program 1-29'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Program_Speed" Name="Program Speed" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3Hz" Display="'3Hz'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f Hz',3.0~30.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="DMX/_Network" Name="DMX/ Network" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Network Mode" Display="'Network Mode'" Dmx="0~0" />
      <Function ID="2" Name="DMX Mode" Display="'DMX Mode'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="UKTL4096" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Program_1-15" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Program_16-29" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Program_Speed" ChannelOffset="8" Wheel="24" />
      <Attribute ID="Pan" ChannelOffset="9,10" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="11,12" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="29" />
      <Attribute ID="DMX/_Network" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
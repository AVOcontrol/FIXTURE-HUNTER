      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="73~81" WheelPosition="2">
        <Swatch>8364abeb-8bd3-4762-89b1-6d6bdd31deda</Swatch>

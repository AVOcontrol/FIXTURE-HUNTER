<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="QS250W" ShortName="QS 250W" Company="Qmaxz">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-03-07" Author="D.Milligan" Comment="Created" />
  <History Date="20-03-07" Author="D.Milligan" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Qmaxz Lighting to Qmaxz" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="08-09-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="08-09-17" Author="Nic Morris" Comment="Standardised shutter.  Standardised conditionals.  Moved raw function into else condition." />
  <History Date="08-09-17" Author="Nic Morris" Comment="Rebuilt macros.  Added palettes." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="20813" ModelID="0" />
  </RDM>
  <AtlaBase TypeID="4af36c68-d227-454c-8d7e-dd2bf945bb90" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display Invert" Display="'Display Invert'" Dmx="10~16" />
      <Function ID="3" Name="Display On/Off" Display="'Display On/Off'" Dmx="30~36" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="50~56" />
      <Function ID="5" Name="Reset No P/T" Display="'Reset No P/T'" Dmx="70~76" />
      <Function ID="6" Name="Reset C/S/Z" Display="'Reset C/S/Z'" Dmx="90~96" />
      <Function ID="7" Name="Reset CMY/CTO" Display="'Reset CMY/CTO'" Dmx="120~126" />
      <Function ID="8" Name="Lamp Off" Display="'Lamp Off'" Dmx="220~226" />
      <Function ID="9" Name="Lamp On" Display="'Lamp On'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~65" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="179~150" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="76~107" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="108~139" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="219~190" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="249~220" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Deep Blue'" Dmx="10~19" Colour="0,0,180" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="30~39" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~49" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~59" Colour="255,128,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="60~69" Colour="0,128,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="70~79" Colour="255,0,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="Index" Display="'Index %.f%%',0~100" Dmx="90~193" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="224~225" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="194~223" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="224~225" Colour="0,0,0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="226~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CMY_Speed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" />
      <Function ID="2" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blackout" Name="Blackout" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Col in Dark" Display="'Col in Dark'" Dmx="150~179" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="180~209" />
      <Function ID="4" Name="All in Dark" Display="'All in Dark'" Dmx="210~239" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" />
      <Function ID="2" Name="Max Speed" Display="'Max Speed'" Dmx="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 16bit" Channels="16">
    <Import PearlRef="QM_QS250Wm1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="85e42d89-4583-4732-9f8b-9d5b39e5947a" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="4,15" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5,16" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="9" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="10" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="CMY_Speed" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Blackout" ChannelOffset="13" Wheel="29" />
      <Attribute ID="PT_Speed" ChannelOffset="14" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 8bit" Channels="12">
    <Import PearlRef="QM_QS250Wm2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cc0f0d24-c306-4ae1-be22-3df08581a7dc" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="9" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="10" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />

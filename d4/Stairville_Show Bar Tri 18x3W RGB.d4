  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="09-11-14" Author="Nic Morris" Comment="Created" />
  <History Date="21-02-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5ef177d8-1387-47ef-9cc3-dc3d8d9be102" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="R" Display="'R'" Dmx="1~7" Update="Auto_Spd" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="8~15" Update="Auto_Spd" />
      <Function ID="4" Name="G" Display="'G'" Dmx="16~23" Update="Auto_Spd" />
      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="24~31" Update="Auto_Spd" />
      <Function ID="6" Name="B" Display="'B'" Dmx="32~39" Update="Auto_Spd" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="40~47" Update="Auto_Spd" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="48~55" Update="Auto_Spd" />
      <Function ID="9" Name="Show 2" Display="'Show 2'" Dmx="56~63" Update="Auto_Spd" />
      <Function ID="10" Name="Show 3" Display="'Show 3'" Dmx="64~71" Update="Auto_Spd" />
      <Function ID="11" Name="Show 4" Display="'Show 4'" Dmx="72~79" Update="Auto_Spd" />
      <Function ID="12" Name="Show 5" Display="'Show 5'" Dmx="80~87" Update="Auto_Spd" />
      <Function ID="13" Name="Show 6" Display="'Show 6'" Dmx="88~95" Update="Auto_Spd" />
      <Function ID="14" Name="Show 7" Display="'Show 7'" Dmx="96~103" Update="Auto_Spd" />
      <Function ID="15" Name="Show 8" Display="'Show 8'" Dmx="104~111" Update="Auto_Spd" />
      <Function ID="16" Name="Show 9" Display="'Show 9'" Dmx="112~119" Update="Auto_Spd" />
      <Function ID="17" Name="Show 10" Display="'Show 10'" Dmx="120~127" Update="Auto_Spd" />
      <Function ID="18" Name="Show 11" Display="'Show 11'" Dmx="128~135" Update="Auto_Spd" />
      <Function ID="19" Name="Show 12" Display="'Show 12'" Dmx="136~143" Update="Auto_Spd" />
      <Function ID="20" Name="Show 13" Display="'Show 13'" Dmx="144~151" Update="Auto_Spd" />
      <Function ID="21" Name="Show 14" Display="'Show 14'" Dmx="152~159" Update="Auto_Spd" />
      <Function ID="22" Name="Show 15" Display="'Show 15'" Dmx="160~167" Update="Auto_Spd" />
      <Function ID="23" Name="Show 16" Display="'Show 16'" Dmx="168~175" Update="Auto_Spd" />
      <Function ID="24" Name="Show 17" Display="'Show 17'" Dmx="176~183" Update="Auto_Spd" />
      <Function ID="25" Name="Show 18" Display="'Show 18'" Dmx="184~191" Update="Auto_Spd" />
      <Function ID="26" Name="Show 19" Display="'Show 19'" Dmx="192~199" Update="Auto_Spd" />
      <Function ID="27" Name="Show 20" Display="'Show 20'" Dmx="200~207" Update="Auto_Spd" />
      <Function ID="28" Name="Show 21" Display="'Show 21'" Dmx="208~215" Update="Auto_Spd" />
      <Function ID="29" Name="Show 22" Display="'Show 22'" Dmx="216~223" Update="Auto_Spd" />
      <Function ID="30" Name="Show 23" Display="'Show 23'" Dmx="224~231" Update="Auto_Spd" />
      <Function ID="31" Name="Show 24" Display="'Show 24'" Dmx="232~239" Update="Auto_Spd" />
      <Function ID="32" Name="Show 25" Display="'Show 25'" Dmx="240~247" Update="Auto_Spd" />
      <Function ID="33" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==33" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Sensitivity" Name="Sensitivity" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

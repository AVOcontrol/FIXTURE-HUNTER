<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Fog Balloon (WP-4L)" ShortName="FogBalloon" Company="DJPOWER" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="15-07-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="16-07-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a94edf26-70e2-4715-8376-599208308bd8" />
  <Control>
    <Attribute ID="Bubble" Name="Bubble" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Haze" Name="Haze" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="3" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Low" Display="'Low'" Dmx="11~100" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="101~200" />
      <Function ID="4" Name="High" Display="'High'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Cleaning" Name="Cleaning" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Mixing" Name="Mixing" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Mixed Colours" Display="'Mixed Colours %.1f%%',0.0~100.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Col Change Spd" Display="'Auto Col Change Spd %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12" Id="8d107da7-8367-4dbf-b8bd-d33cd649a2ba">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7dc1c6be-990b-4136-8510-becac63906c7" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="UV" Wheel="40" />
        <Attribute ID="Mixing" Wheel="7" />
        <Attribute ID="Shutter" Wheel="6" />
        <Attribute ID="Auto" Wheel="22" />
        <Attribute ID="Fan" ChannelOffset="3" Wheel="25" />
        <Attribute ID="Cleaning" ChannelOffset="4" Wheel="28" />
        <Attribute ID="Bubble" Wheel="4" />
        <Attribute ID="Haze" Wheel="5" />
      </Master>
      <Cell ID="Cell1" Name="Bubble" ChannelOffset="1" ModeLink="Dim cell" X="0" Y="0">
        <AttributeLink SourceId="Bubble" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Haze" ChannelOffset="2" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Haze" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="LED" ChannelOffset="5" ModeLink="LED cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="UV" TargetId="UV" />
        <AttributeLink SourceId="Mixing" TargetId="Mixing" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Auto" TargetId="Auto" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dim cell" Channels="1" Hidden="True" Id="704dceb6-5c61-4502-b216-3a2982a8495b">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="LED cell" Channels="8" Hidden="True" Id="b555437f-2c87-45dc-9d7b-5770637c31b9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="UV" ChannelOffset="5" Wheel="40" />
      <Attribute ID="Mixing" ChannelOffset="6" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="6" />
      <Attribute ID="Auto" ChannelOffset="8" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
</Fixture>
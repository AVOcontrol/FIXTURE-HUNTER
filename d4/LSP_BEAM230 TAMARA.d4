  <Mode Name="LED cell" Channels="8" Hidden="True" Id="f77a7568-1e92-4c33-b788-788a4add650d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

      </Cell>
      <Cell ID="Cell2" Name="LED" ChannelOffset="17" ModeLink="LED cell" X="0" Y="1">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="LED_Col_Macro" TargetId="LED_Col_Macro" />
        <AttributeLink SourceId="LED_FX" TargetId="LED_FX" />
        <AttributeLink SourceId="LED_FX_Spd" TargetId="LED_FX_Spd" />
      </Cell>
    </Cells>
  </Mode>

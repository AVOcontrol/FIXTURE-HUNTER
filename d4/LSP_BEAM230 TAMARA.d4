        <Attribute ID="LED_FX_Spd" Wheel="54" />
      </Master>
      <Cell ID="Cell1" Name="Beam" ChannelOffset="1" ModeLink="Beam cell" X="0" Y="0">
        <AttributeLink SourceId="Beam_Col_Func" TargetId="Beam_Col_Func" />
        <AttributeLink SourceId="Beam_Colour" TargetId="Beam_Colour" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Gobo1Func" TargetId="Gobo1Func" />
        <AttributeLink SourceId="Gobo1" TargetId="Gobo1" />

  <AtlaBase TypeID="14001324-6a9a-4983-906c-df4844861f88" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~25" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Burst Pls" Display="'Burst Pls %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="30~34" />
      <Function ID="3" Name="Dim Exponential" Display="'Dim Exponential'" Dmx="35~39" />
      <Function ID="4" Name="Dim Logarithmic" Display="'Dim Logarithmic'" Dmx="40~44" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="45~49" />
      <Function ID="6" Name="Dim Response LED" Display="'Dim Response LED'" Dmx="50~54" />
      <Function ID="7" Name="Dim Response Halogen" Display="'Dim Response Halogen'" Dmx="55~59" />
      <Function ID="8" Name="LED Freq 800Hz" Display="'LED Freq 800Hz'" Dmx="95~99" />
      <Function ID="9" Name="LED Freq 1200Hz" Display="'LED Freq 1200Hz'" Dmx="100~104" />
      <Function ID="10" Name="LED Freq 2000Hz" Display="'LED Freq 2000Hz'" Dmx="105~109" />
      <Function ID="11" Name="LED Freq 3600Hz" Display="'LED Freq 3600Hz'" Dmx="110~114" />
      <Function ID="12" Name="LED Freq 12kHz" Display="'LED Freq 12kHz'" Dmx="115~119" />
      <Function ID="13" Name="LED Freq 25kHz" Display="'LED Freq 25kHz'" Dmx="120~124" />
      <Function ID="14" Name="Fan Auto" Display="'Fan Auto'" Dmx="130~134" />
      <Function ID="15" Name="Fan Silent" Display="'Fan Silent'" Dmx="135~139" />
      <Function ID="16" Name="Fan Studio" Display="'Fan Studio'" Dmx="140~144" />
      <Function ID="17" Name="Fan Off" Display="'Fan Off'" Dmx="145~149" />
      <Function ID="18" Name="Fan High Power" Display="'Fan High Power'" Dmx="150~154" />
      <Function ID="19" Name="Reset Factory" Display="'Reset Factory'" Dmx="180~184" />
      <Function ID="20" Name="Reset User" Display="'Reset User'" Dmx="185~189" />

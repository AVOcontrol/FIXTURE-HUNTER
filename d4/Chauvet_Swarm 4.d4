  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~14" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~19" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="20~24" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="25~29" Colour="255,100,0" />
      <Function ID="6" Name="Green + Blue" Display="'Green + Blue'" Dmx="30~34" Colour="0,0,0" />
      <Function ID="7" Name="Red + Blue" Display="'Red + Blue'" Dmx="35~39" Colour="0,0,0" />
      <Function ID="8" Name="Red + Green" Display="'Red + Green'" Dmx="40~44" Colour="0,0,0" />
      <Function ID="9" Name="Red + Amber" Display="'Red + Amber'" Dmx="45~49" Colour="0,0,0" />
      <Function ID="10" Name="Green + Amber" Display="'Green + Amber'" Dmx="50~54" Colour="0,0,0" />
      <Function ID="11" Name="Blue + Amber" Display="'Blue + Amber'" Dmx="55~59" Colour="0,0,0" />
      <Function ID="12" Name="Red + Green + Blue" Display="'Red + Green + Blue'" Dmx="60~64" Colour="0,0,0" />
      <Function ID="13" Name="Green + Blue + Amber" Display="'Green + Blue + Amber'" Dmx="65~69" Colour="0,0,0" />
      <Function ID="14" Name="Red + Blue + Amber" Display="'Red + Blue + Amber'" Dmx="70~74" Colour="0,0,0" />
      <Function ID="15" Name="Red+Green + Blue+Amber" Display="'Red+Green + Blue+Amber'" Dmx="75~79" Colour="0,0,0" />
      <Function ID="16" Name="Auto (Single Cols)" Display="'Auto (Single Cols)'" Dmx="80~139" Colour="0,0,0" />
      <Function ID="17" Name="Auto (2 Cols)" Display="'Auto (2 Cols)'" Dmx="140~199" Colour="0,0,0" />
      <Function ID="18" Name="Auto" Display="'Auto'" Dmx="200~249" Colour="0,0,0" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~4" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Rotate" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="5~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ccb5808b-557e-4d19-afcb-45ebe0acd11c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="High Power" Display="'High Power'" Dmx="6~10" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="4" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="5" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="6" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="7" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="8" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="9" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="10" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="11" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="12" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="13" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="14" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="15" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Fans Off" Display="'Fans Off'" Dmx="11~20" />
      <Function ID="3" Name="Fans Low" Display="'Fans Low'" Dmx="21~30" />
      <Function ID="4" Name="Fans High" Display="'Fans High'" Dmx="31~40" />
      <Function ID="5" Name="Fans Normal" Display="'Fans Normal'" Dmx="41~50" />
      <Function ID="6" Name="Fans Auto" Display="'Fans Auto'" Dmx="51~60" />
      <Function ID="7" Name="Auto 1" Display="'Auto 1'" Dmx="61~70" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="71~80" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="81~90" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="91~100" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="101~110" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="111~120" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="121~130" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="131~140" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="141~150" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="151~160" />
      <Function ID="17" Name="Custom 1" Display="'Custom 1'" Dmx="161~170" />
      <Function ID="18" Name="Custom 2" Display="'Custom 2'" Dmx="171~180" />
      <Function ID="19" Name="Custom 3" Display="'Custom 3'" Dmx="181~190" />
      <Function ID="20" Name="Custom 4" Display="'Custom 4'" Dmx="191~200" />
      <Function ID="21" Name="Custom 5" Display="'Custom 5'" Dmx="201~210" />
      <Function ID="22" Name="Custom 6" Display="'Custom 6'" Dmx="211~220" />
      <Function ID="23" Name="Custom 7" Display="'Custom 7'" Dmx="221~230" />
      <Function ID="24" Name="Custom 8" Display="'Custom 8'" Dmx="231~240" />
      <Function ID="25" Name="Custom 9" Display="'Custom 9'" Dmx="241~250" />
      <Function ID="26" Name="Custom 10" Display="'Custom 10'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Speed 1" Display="'Speed 1'" Dmx="30~69" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="70~129" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="130~189" />
      <Function ID="6" Name="Speed 4" Display="'Speed 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="STAG, 9 DMX" Channels="9">

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7ee77256-78aa-4583-a126-3f0d9e6f575f" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="40~63" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="88~111" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="136~159" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="184~207" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="232~255" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~39" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="64~87" WheelPosition="1" Colour="255,0,0" />
      <Function ID="9" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="112~135" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="160~183" WheelPosition="3" Colour="255,255,0" />
      <Function ID="11" Name="Blu/ Org" Display="'Blu/ Org'" Dmx="208~231" WheelPosition="4" Colour="0,0,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="8000K" Display="'8000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="6500K" Display="'6500K'" Dmx="21~49" Colour="255,255,255" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="50~101" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="102~152" Colour="255,255,255" />
      <Function ID="5" Name="2700K" Display="'2700K'" Dmx="153~203" Colour="255,255,255" />
      <Function ID="6" Name="8000K" Display="'8000K'" Dmx="204~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~239" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="3cf0f3fa-5684-40a5-b461-1496a94ec837">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b5d7ded4-f484-43bb-b2d6-d16663177e5c" />
    <Include>
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Iris" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3f1121ec-ab22-4f2d-937c-2ac4bee0e3c2" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==3" />
      <Condition Name="Index" ID="14,15,16,17,18,19,20,21" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Cyan" Display="'Cyan'" Dmx="32~47" Colour="0,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~63" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="64~79" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="80~95" Colour="255,0,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~111" Colour="0,0,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="112~127" Colour="255,128,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="14" Name="Op/Rd" Display="'Op/Rd %.f%%',0~100" Dmx="0~15" Colour="255,255,255" />
      <Function ID="15" Name="Rd/Cy" Display="'Rd/Cy %.f%%',0~100" Dmx="16~31" Colour="255,0,0" />
      <Function ID="16" Name="Cy/Grn" Display="'Cy/Grn %.f%%',0~100" Dmx="32~47" Colour="0,255,255" />
      <Function ID="17" Name="Grn/Yell" Display="'Grn/Yell %.f%%',0~100" Dmx="48~63" Colour="0,255,0" />
      <Function ID="18" Name="Yell/Mg" Display="'Yell/Mg %.f%%',0~100" Dmx="64~79" Colour="255,255,0" />
      <Function ID="19" Name="Mg/Bl" Display="'Mg/Bl %.f%%',0~100" Dmx="80~95" Colour="255,0,255" />
      <Function ID="20" Name="Bl/Or" Display="'Bl/Or %.f%%',0~100" Dmx="96~111" Colour="0,0,255" />
      <Function ID="21" Name="Or/Op" Display="'Or/Op %.f%%',0~100" Dmx="112~127" Colour="255,128,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Gobo1Func'==3" />
      <Condition Name="Index" ID="12,13,14,15,16,17,18,19" If="'Gobo1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~39" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="40~69" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="70~99" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="100~129" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="130~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="140~189" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="190~219" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~225" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Op/G1" Display="'Op/G1 %.f%%',0~100" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="G1/G2" Display="'G1/G2 %.f%%',0~100" Dmx="10~39" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="G2/G3" Display="'G2/G3 %.f%%',0~100" Dmx="40~69" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="G3/G4" Display="'G3/G4 %.f%%',0~100" Dmx="70~99" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="G4/G5" Display="'G4/G5 %.f%%',0~100" Dmx="100~129" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="G5/G6" Display="'G5/G6 %.f%%',0~100" Dmx="130~159" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="G6/G7" Display="'G6/G7 %.f%%',0~100" Dmx="140~189" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="G7/Op" Display="'G7/Op %.f%%',0~100" Dmx="190~219" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="4~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" GoboSpin="0~0" GoboOrientation="0~0" />

      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="90~109" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="110~129" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="130~149" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="150~169" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="170~207" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="208~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Op/G1" Display="'Op/G1 %.f%%',0~100" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="G1/G2" Display="'G1/G2 %.f%%',0~100" Dmx="10~29" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="G2/G3" Display="'G2/G3 %.f%%',0~100" Dmx="30~49" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

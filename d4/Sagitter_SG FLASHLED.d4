  <History Date="10-12-20" Author="Nic Morris" Comment="Fixed strobe display type (was fixed) and corrected shutter locate level." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a43740a6-722c-424f-930a-a97141acbdea" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="6" If="'Mode'==3" />
      <Condition Name="Sensitivity" ID="7" If="'Mode'==4" />
      <Else ID="1,2,3,4,5" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="7" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="7~65" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="133~191" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="196~255" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="70~128" />
    </Attribute>
    <Attribute ID="Sector_Macros" Name="Sector Macros" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Sector Macros" Display="'Sector Macros'" Dmx="60~119" Update="Shutter" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="120~239" Update="Shutter" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Shutter" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">

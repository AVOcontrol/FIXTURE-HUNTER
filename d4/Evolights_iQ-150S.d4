<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iQ-150S" ShortName="iQ-150S" Company="Evolights" Version="8">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>e87ea958-a4a4-4ced-8c2f-9455ab8142b4</Thumbnail>
  <History Date="08-09-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="16-09-14" Author="Nic Morris" Comment="Updated colour and gobo in response to manufacturer request." Version="2" />
  <History Date="22-09-14" Author="Nic Morris" Comment="Updated prism functions to latest spec in response to manufacturer request." Version="3" />
  <History Date="04-05-15" Author="Nic Morris" Comment="Updated basic modes to use simplified shutter functions in attempt to fix distributor bug report." Version="4" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="5" />
  <History Date="14-08-16" Author="Nic Morris" Comment="Fixed duplicate ID's in else conditions." Version="6" />
  <History Date="17-09-20" Author="Nic Morris" Comment="Created from Prolights CRYSTAL (poor documentation.  colour and gobo range details are missing and don't make sense.  assumed same)" Version="7" />
  <History Date="18-09-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="47ceb8b7-772f-4386-b917-9b8d0aa1d82d" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Fixed B/O" Display="'Fixed B/O'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Bounce" Display="'Bounce'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Fixed B/O" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Bounce" ID="19,20,21,22,23,24,25,26,27" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="28,29,30" If="'Colour1Func'==4" />
      <Else ID="31" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~11" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="12~17" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="18~23" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="24~29" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="30~35" WheelPosition="5" Colour="255,150,150" />
      <Function ID="7" Name="Sky Blue" Display="'Sky Blue'" Dmx="36~41" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="42~47" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="48~53" WheelPosition="8" Colour="255,0,255" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="54~59" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="60~65" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Blue" Display="'Blue'" Dmx="66~71" WheelPosition="2" Colour="0,0,255" />
      <Function ID="13" Name="Green" Display="'Green'" Dmx="72~77" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="Yellow" Display="'Yellow'" Dmx="78~83" WheelPosition="4" Colour="255,255,0" />
      <Function ID="15" Name="Pink" Display="'Pink'" Dmx="84~89" WheelPosition="5" Colour="255,150,150" />
      <Function ID="16" Name="Sky Blue" Display="'Sky Blue'" Dmx="90~95" WheelPosition="6" Colour="0,128,255" />
      <Function ID="17" Name="Orange" Display="'Orange'" Dmx="96~101" WheelPosition="7" Colour="255,128,0" />
      <Function ID="18" Name="Magenta" Display="'Magenta'" Dmx="102~106" WheelPosition="8" Colour="255,0,255" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="107~119" WheelPosition="0" Colour="255,255,255" />
      <Function ID="20" Name="Red" Display="'Red'" Dmx="120~132" WheelPosition="1" Colour="255,0,0" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="133~145" WheelPosition="2" Colour="0,0,255" />
      <Function ID="22" Name="Green" Display="'Green'" Dmx="146~158" WheelPosition="3" Colour="0,255,0" />
      <Function ID="23" Name="Yellow" Display="'Yellow'" Dmx="159~171" WheelPosition="4" Colour="255,255,0" />
      <Function ID="24" Name="Pink" Display="'Pink'" Dmx="172~184" WheelPosition="5" Colour="255,150,150" />
      <Function ID="25" Name="Sky Blue" Display="'Sky Blue'" Dmx="185~197" WheelPosition="6" Colour="0,128,255" />
      <Function ID="26" Name="Orange" Display="'Orange'" Dmx="198~210" WheelPosition="7" Colour="255,128,0" />
      <Function ID="27" Name="Magenta" Display="'Magenta'" Dmx="211~223" WheelPosition="8" Colour="255,0,255" />
      <Function ID="28" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="29" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="239~224" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="240~255" Colour="0,0,0" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed B/O" Display="'Fixed B/O'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Fixed B/O" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Shake" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==3" />
      <Condition Name="Scroll" ID="25,26,27" If="'Gobo1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="6~11" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="12~17" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="18~23" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="24~29" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="30~35" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="36~41" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="42~47" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="48~53" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1" Display="'Gobo 1'" Dmx="54~59" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2" Display="'Gobo 2'" Dmx="60~65" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3" Display="'Gobo 3'" Dmx="66~71" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4" Display="'Gobo 4'" Dmx="72~77" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5" Display="'Gobo 5'" Dmx="78~83" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6" Display="'Gobo 6'" Dmx="84~89" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7" Display="'Gobo 7'" Dmx="90~95" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="98~111" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="112~132" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="133~153" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="154~174" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="175~195" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="196~216" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="217~223" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="239~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Anim CW" Display="'Anim CW %.f%%',100~0" Dmx="207~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Anim CCW" Display="'Anim CCW %.f%%',0~100" Dmx="208~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="239~224" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="240~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~4" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~131" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="132~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Reset Col" Display="'Reset Col'" Dmx="24~31" />
      <Function ID="5" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="32~39" />
      <Function ID="6" Name="Reset Other" Display="'Reset Other'" Dmx="48~55" />
      <Function ID="7" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="8" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="9" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ef2e4382-d278-4d91-99c1-6c386c85edf6" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="8" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Standard, 13 DMX" Channels="13">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="eb085f83-9a84-4050-8abd-c72268c6e7a8" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="10" Wheel="15" />
      <Attribute ID="Prism" ChannelOffset="11" Wheel="23" />
      <Attribute ID="Focus" ChannelOffset="12" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Col">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5,Colour1Func:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4,Colour1Func:1" />
      <Palette ID="8" Name="Sky Blue" Number="6" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="9" Name="Sky Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:3,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">

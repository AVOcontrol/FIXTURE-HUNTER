      <Function ID="10" Name="Auto 15" Display="'Auto 15'" Dmx="202~225" />
      <Function ID="11" Name="Auto 16" Display="'Auto 16'" Dmx="226~249" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">

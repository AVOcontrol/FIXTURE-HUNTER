  <AtlaBase TypeID="dee6a234-135b-4a30-baa8-fb1f635968eb" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Effect'==28||'Effect'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Colour" ID="2" If="'Effect'==28||'Effect'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Effect'&gt;16&amp;&amp;'Effect'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Effect'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green, Dimmer" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Red, Green, Dimmer" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Red, Green, Dimmer" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Red, Green, Dimmer" />
      <Function ID="5" Name="W" Display="'W'" Dmx="40~47" Update="Red, Green, Dimmer" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="48~55" Update="Red, Green, Dimmer" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="56~63" Update="Red, Green, Dimmer" />
      <Function ID="8" Name="BW" Display="'BW'" Dmx="64~71" Update="Red, Green, Dimmer" />
      <Function ID="9" Name="WR" Display="'WR'" Dmx="72~79" Update="Red, Green, Dimmer" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="80~87" Update="Red, Green, Dimmer" />
      <Function ID="11" Name="RB" Display="'RB'" Dmx="88~95" Update="Red, Green, Dimmer" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="96~103" Update="Red, Green, Dimmer" />
      <Function ID="13" Name="GBW" Display="'GBW'" Dmx="104~111" Update="Red, Green, Dimmer" />
      <Function ID="14" Name="RGW" Display="'RGW'" Dmx="112~119" Update="Red, Green, Dimmer" />
      <Function ID="15" Name="RBW" Display="'RBW'" Dmx="120~127" Update="Red, Green, Dimmer" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="128~135" Update="Red, Green, Dimmer" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Red, Green, Dimmer" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Red, Green, Dimmer" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Red, Green, Dimmer" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Red, Green, Dimmer" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Red, Green, Dimmer" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Red, Green, Dimmer" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Red, Green, Dimmer" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Red, Green, Dimmer" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Red, Green, Dimmer" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Red, Green, Dimmer" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Red, Green, Dimmer" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Red, Green, Dimmer" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Red, Green, Dimmer" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Red, Green, Dimmer" />
    </Attribute>
  </Control>

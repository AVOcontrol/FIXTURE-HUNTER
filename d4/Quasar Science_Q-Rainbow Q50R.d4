  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="870a51e2-580a-4fd6-862d-acba8277472b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2000~6000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="No Shift" Display="'No Shift'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="- Green" Display="'- Green %.f%%',99~1" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="128~129" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',1~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xFade_Col" Name="xFade Col" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White-&gt;RGB" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="FX" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Rainbow" Display="'Rainbow'" Dmx="28~40" />
      <Function ID="3" Name="Short Circuit" Display="'Short Circuit'" Dmx="41~53" />
      <Function ID="4" Name="Paparazzi" Display="'Paparazzi'" Dmx="54~68" />
      <Function ID="5" Name="Fire 1" Display="'Fire 1'" Dmx="69~78" />
      <Function ID="6" Name="Fire 2" Display="'Fire 2'" Dmx="79~91" />
      <Function ID="7" Name="Fire 3" Display="'Fire 3'" Dmx="92~104" />
      <Function ID="8" Name="Cop Light 1" Display="'Cop Light 1'" Dmx="105~116" />
      <Function ID="9" Name="Cop Light 2" Display="'Cop Light 2'" Dmx="117~129" />
      <Function ID="10" Name="Demo" Display="'Demo'" Dmx="130~142" />
    </Attribute>
    <Attribute ID="FX_Rate" Name="FX Rate" Description="" Group="E">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="11~20" />
      <Function ID="3" Name="- Speed" Display="'- Speed %.f%%',1~99" Dmx="21~119" />
      <Function ID="4" Name="x1" Display="'x1'" Dmx="128~128" />
      <Function ID="5" Name="+ Speed" Display="'+ Speed %.f%%',101~199" Dmx="146~244" />
      <Function ID="6" Name="x2" Display="'x2'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="FX_Size" Name="FX Size" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="112~124" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="125~137" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="138~150" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="151~163" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="164~176" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="177~189" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="190~202" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="203~215" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="216~228" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="229~241" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="242~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~35" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="36~56" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="57~76" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="77~97" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="98~117" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="118~138" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="139~159" />
      <Function ID="9" Name="On" Display="'On'" Dmx="160~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

  <History Date="19-02-26" Author="Nic Morris" Comment="Created (note prism rot missing 128-190 range and 191-194 detailed as Spin CW.  Assumed 128-190 is actually spin and 191-194 is no spin)" Version="0" />
  <History Date="20-02-26" Author="Nic Morris" Comment="Corrected name (was ClubSpot 3000)" Version="1" />
  <History Date="27-02-26" Author="Nic Morris" Comment="Revised Atlabase IDs to V2 version." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="00d189e1-4b70-40e5-b1d8-b87b9a8c9ff4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="20~29" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="CTB (Steel Blue)" Display="'CTB (Steel Blue)'" Dmx="40~49" WheelPosition="2" Colour="220,240,255" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="60~69" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="80~89" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="100~109" WheelPosition="5" Colour="255,0,255" />
      <Function ID="7" Name="CTO (Strew)" Display="'CTO (Strew)'" Dmx="120~129" WheelPosition="6" Colour="255,240,200" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="140~149" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="10~19" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ CTB" Display="'Rd/ CTB'" Dmx="30~39" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="CTB/ Yel" Display="'CTB/ Yel'" Dmx="50~59" WheelPosition="2" Colour="220,240,255" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="70~79" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="90~99" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Mag/ CTO" Display="'Mag/ CTO'" Dmx="110~119" WheelPosition="5" Colour="255,0,255" />
      <Function ID="15" Name="CTO/ Blu" Display="'CTO/ Blu'" Dmx="130~139" WheelPosition="6" Colour="255,240,200" />
      <Function ID="16" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="150~159" WheelPosition="7" Colour="0,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="207~160" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="255~208" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="4~7" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="8~11" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="12~15" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="16~19" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="20~23" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="24~27" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="28~31" WheelPosition="7" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="32~35" WheelPosition="8" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="122~138" WheelPosition="1" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="139~155" WheelPosition="2" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="156~172" WheelPosition="3" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="173~189" WheelPosition="4" />
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="190~206" WheelPosition="5" />
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="207~223" WheelPosition="6" />
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="224~230" WheelPosition="7" />
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="231~255" WheelPosition="8" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="77~80" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="36~76" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="77~80" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="81~121" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo2Func'==5||'Gobo2Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~59" WheelPosition="6" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="60~80" WheelPosition="1" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="81~101" WheelPosition="2" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="102~122" WheelPosition="3" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="123~143" WheelPosition="4" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="144~164" WheelPosition="5" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="165~189" WheelPosition="6" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="222~190" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="223~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="48573~32896" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="48830~65535" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~194" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="195~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a874e65d-c63b-456e-87d2-c097af633a16" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~15" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~25" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="26~35" Colour="0,0,255" />
      <Function ID="5" Name="Lime Green" Display="'Lime Green'" Dmx="36~45" Colour="0,180,0" />
      <Function ID="6" Name="Yellow Green" Display="'Yellow Green'" Dmx="46~55" Colour="180,180,0" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="56~65" Colour="255,255,0" />
      <Function ID="8" Name="Orange Yellow" Display="'Orange Yellow'" Dmx="66~75" Colour="255,128,0" />
      <Function ID="9" Name="Amber" Display="'Amber'" Dmx="76~85" Colour="255,100,0" />
      <Function ID="10" Name="Orange" Display="'Orange'" Dmx="86~95" Colour="255,128,0" />
      <Function ID="11" Name="Fuschia Pink" Display="'Fuschia Pink'" Dmx="96~105" Colour="255,150,150" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="106~115" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="116~125" Colour="255,150,150" />
      <Function ID="14" Name="Purple" Display="'Purple'" Dmx="126~135" Colour="128,0,255" />
      <Function ID="15" Name="Medium Blue" Display="'Medium Blue'" Dmx="136~145" Colour="0,0,255" />
      <Function ID="16" Name="Cyan" Display="'Cyan'" Dmx="146~155" Colour="0,255,255" />
      <Function ID="17" Name="Light Blue" Display="'Light Blue'" Dmx="156~165" Colour="0,128,255" />
      <Function ID="18" Name="Sky Blue" Display="'Sky Blue'" Dmx="166~175" Colour="0,128,255" />
      <Function ID="19" Name="Turquoise" Display="'Turquoise'" Dmx="176~185" Colour="0,255,128" />
      <Function ID="20" Name="Mint Green" Display="'Mint Green'" Dmx="186~195" Colour="128,255,0" />
      <Function ID="21" Name="White (Blue Tint)" Display="'White (Blue Tint)'" Dmx="196~205" Colour="255,255,255" />
      <Function ID="22" Name="White" Display="'White'" Dmx="206~215" Colour="255,255,255" />
      <Function ID="23" Name="Cool White" Display="'Cool White'" Dmx="216~225" Colour="230,230,255" />
      <Function ID="24" Name="White (Pink Tint)" Display="'White (Pink Tint)'" Dmx="226~235" Colour="255,255,255" />
      <Function ID="25" Name="White (Yellow Tint)" Display="'White (Yellow Tint)'" Dmx="236~245" Colour="255,255,255" />
      <Function ID="26" Name="Warm White" Display="'Warm White'" Dmx="246~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="3 Col Fade (RGB)" Display="'3 Col Fade (RGB)'" Dmx="6~30" Update="Auto_Spd" />
      <Function ID="3" Name="3 Col Fade (CMY)" Display="'3 Col Fade (CMY)'" Dmx="31~55" Update="Auto_Spd" />
      <Function ID="4" Name="4 Col Fade (RGBW)" Display="'4 Col Fade (RGBW)'" Dmx="56~80" Update="Auto_Spd" />
      <Function ID="5" Name="7 Col Fade (RGBWCMY)" Display="'7 Col Fade (RGBWCMY)'" Dmx="81~105" Update="Auto_Spd" />
      <Function ID="6" Name="3 Col Fade in/out (RGB)" Display="'3 Col Fade in/out (RGB)'" Dmx="106~130" Update="Auto_Spd" />
      <Function ID="7" Name="3 Col Change (RGB)" Display="'3 Col Change (RGB)'" Dmx="131~155" Update="Auto_Spd" />
      <Function ID="8" Name="3 Col Change (CMY)" Display="'3 Col Change (CMY)'" Dmx="156~180" Update="Auto_Spd" />
      <Function ID="9" Name="4 Col Change (RGBW)" Display="'4 Col Change (RGBW)'" Dmx="181~205" Update="Auto_Spd" />
      <Function ID="10" Name="7 Col Change (RGBWCMY)" Display="'7 Col Change (RGBWCMY)'" Dmx="206~230" Update="Auto_Spd" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="231~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX m1" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

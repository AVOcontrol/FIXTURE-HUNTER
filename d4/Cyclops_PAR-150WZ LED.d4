  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="251fadd8-f89e-44b4-8265-e67ad365d65c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Speed 0" Display="'Speed 0'" Dmx="6~55" />
      <Function ID="3" Name="Speed 1" Display="'Speed 1'" Dmx="56~105" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="106~155" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="156~205" />
      <Function ID="6" Name="Speed 4" Display="'Speed 4'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="IDs 1-20" Display="'IDs 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="IDs 21-66" Display="'IDs 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKCY15W1" DiamondRef="" WysiwygRef="" />

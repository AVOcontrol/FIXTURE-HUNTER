    <AtlaBase ModeID="bdb682e0-f987-43ff-be24-3ead5ad96365" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="White" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="White1" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />

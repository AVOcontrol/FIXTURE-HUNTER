<Fixture Name="Fusion Stick FS16Z" ShortName="FS16Z" Company="GLP" Version="10">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>a0e9273a-a927-4eb7-bcdd-91b14cd43e9c</Thumbnail>
  <History Date="05-10-18" Author="Nic Morris" Comment="Created (note changing DMX mode via control channel is not supported)" Version="1" />
  <History Date="25-07-19" Author="Nic Morris" Comment="Created from Ehrgeiz Fusion 2 (GLP have aquired Ehrgeiz and rebranded this - manual linked from GLP product page is currently still Ehrgeiz Fusion 2 and therefore identical.  Assumed the same but with 10 cells instead of 20.  Suspect pattern functions may be wrong)" Version="2" />
  <History Date="26-07-19" Author="Nic Morris" Comment="Corrected manufacturer name." Version="3" />
  <History Date="07-07-21" Author="Nic Morris" Comment="Created from GLP Fusion Stick FS10 (note pattern functions not documented.  left the same for now)" Version="4" />
  <History Date="08-07-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="09-07-21" Author="Nic Morris" Comment="Fixed Compressed and Pixel mode channels." Version="6" />
  <History Date="30-07-24" Author="Nic Morris" Comment="Updated in line with DMX charts Rev. 20240625-01 (adds modes 5-7 and revises pattern functions)" Version="7" />
  <History Date="31-07-24" Author="Nic Morris" Comment="Added Atlabase IDs for modes 6 and 7." Version="10" />

      <Function ID="30" Name="Gobo 14 Shake" Display="'Gobo 14 Shake %.f%%',0~100" Dmx="104~110" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="31" Name="Gobo 15 Shake" Display="'Gobo 15 Shake %.f%%',0~100" Dmx="97~103" WheelPosition="15" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Gobo 16 Shake" Display="'Gobo 16 Shake %.f%%',0~100" Dmx="90~96" WheelPosition="16" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="33" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="34" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~99" />
      <Function ID="2" Name="Lamp OFF" Display="'Lamp OFF'" Dmx="100~110" />
      <Function ID="3" Name="Lamp ON" Display="'Lamp ON'" Dmx="200~210" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~244" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="UKET209" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Rotate" ChannelOffset="8" Wheel="15" />
      <Attribute ID="Lamp" ChannelOffset="9" Wheel="29" />
      <Attribute ID="Reset" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp OFF">
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp ON">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1" />

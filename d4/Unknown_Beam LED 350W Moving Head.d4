      <Condition Name="Random" ID="21,22,23" If="'Colour1Func'==4" />
      <Else ID="24" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="33410~34181" Colour="255,0,0" />

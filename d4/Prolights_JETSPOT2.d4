    </Include>
  </Mode>
  <Mode Name="Extended" Channels="15">
    <Import PearlRef="PGJETS2X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="50074101-7e72-4727-a03a-b19604ff1bec" />

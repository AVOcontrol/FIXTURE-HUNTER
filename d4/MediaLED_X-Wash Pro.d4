  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>47de6325-5dc1-4abf-a69c-24ea4a0015cd</Thumbnail>
  <History Date="21-09-10" Author="John Rogers" Comment="Created from Robe_Robin 600E Wash.d4" />
  <History Date="09-11-10" Author="John Rogers" Comment="Tested against fixture." />
  <History Date="07-01-11" Author="John Rogers" Comment="Added Physical Movement info." />
  <History Date="12-01-11" Author="John Rogers" Comment="Added Robe updates including new modes." />
  <History Date="31-03-11" Author="John Rogers" Comment="Updated Macros." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Removed shutter update from colour." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Increased wheel resolution.  Shortened names for Expert LCD.  Reordered shutter." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Added missing macros.  Added pixel mapper compatibility." />
  <History Date="07-11-11" Author="John Rogers" Comment="Removed Virtual Dimmer from Cells." />
  <History Date="07-12-11" Author="John Rogers" Comment="Edited Colour Macro Zone Effects to Value range." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-01-17" Author="Nic Morris" Comment="Fixed channel count in cell mode name and changed to hidden." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Revised control functions and macros." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Changed Colour Macros to Virtual Col and aligned functions with product range for compatibility." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Revised Virtual Col index functions for full field control." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Aligned shutter functions (where possible) across product range for compatibility." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added vdim to cells." />
  <History Date="28-10-18" Author="Nic Morris" Comment="Created from Robe Robin 600 LED Wash (identical)" />
  <History Date="02-11-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="03-11-18" Author="Nic Morris" Comment="Revised display name" />
  <History Date="12-06-19" Author="Nic Morris" Comment="Inverted Zone FX Rev and Rnd Zn Strb in line with charts in response to customer bug report." />

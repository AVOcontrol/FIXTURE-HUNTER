  <AtlaBase TypeID="605f4304-2229-43fa-afbd-efd402c5ec5b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Break" Display="'Break %.1f Sec',5.0~1.0" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~13" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="14~21" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="22~29" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="30~37" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="38~45" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="46~53" Colour="0,255,128" />
      <Function ID="8" Name="Cobalt Blue" Display="'Cobalt Blue'" Dmx="54~61" Colour="0,0,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="62~69" Colour="0,0,255" />
      <Function ID="10" Name="Lilac" Display="'Lilac'" Dmx="70~77" Colour="128,0,255" />
      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="78~85" Colour="128,0,255" />
      <Function ID="12" Name="Crimson Red" Display="'Crimson Red'" Dmx="86~93" Colour="255,0,0" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="94~101" Colour="255,150,150" />
      <Function ID="14" Name="Warm White" Display="'Warm White'" Dmx="102~109" Colour="255,240,200" />
      <Function ID="15" Name="White" Display="'White'" Dmx="110~117" Colour="255,255,255" />
      <Function ID="16" Name="Cold White" Display="'Cold White'" Dmx="118~125" Colour="230,230,255" />
      <Function ID="17" Name="Change Stop" Display="'Change Stop'" Dmx="126~127" Colour="255,255,255" />
      <Function ID="18" Name="Change" Display="'Change %.f%%',0~100" Dmx="128~191" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',3200~7200" Dmx="255~6" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="4" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~199" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTO" Description="" Group="C">
      <Locate Locate="1:7200" PowerOn="1:7200" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',3200.0~7200.0" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
  </Control>

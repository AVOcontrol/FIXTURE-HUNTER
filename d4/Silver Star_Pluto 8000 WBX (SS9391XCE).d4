      <Function ID="7" Name="Live" Display="'Live'" Dmx="61~70" />
      <Function ID="8" Name="Studio" Display="'Studio'" Dmx="71~80" />
      <Function ID="9" Name="Power" Display="'Power'" Dmx="81~90" />
      <Function ID="10" Name="Dimmer OFF" Display="'Dimmer OFF'" Dmx="101~110" />
      <Function ID="11" Name="Dimmer DIM4" Display="'Dimmer DIM4'" Dmx="111~120" />
      <Function ID="12" Name="1200Hz" Display="'1200Hz'" Dmx="151~160" />
      <Function ID="13" Name="2400Hz" Display="'2400Hz'" Dmx="161~170" />
      <Function ID="14" Name="4000Hz" Display="'4000Hz'" Dmx="171~180" />
      <Function ID="15" Name="6000Hz" Display="'6000Hz'" Dmx="181~190" />
      <Function ID="16" Name="25000kHz" Display="'25000kHz'" Dmx="191~200" />
      <Function ID="17" Name="Reset All" Display="'Reset All'" Dmx="201~210" />
      <Function ID="18" Name="Reset P/T" Display="'Reset P/T'" Dmx="211~220" />
      <Function ID="19" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="221~230" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">

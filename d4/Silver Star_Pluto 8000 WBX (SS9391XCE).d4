      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="10~23" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="24~37" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="38~51" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="52~65" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="66~79" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="80~93" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="94~107" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="108~121" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="122~135" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="136~149" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="150~163" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="164~177" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="178~191" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="192~205" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="206~219" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="220~233" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="234~247" />
    </Attribute>
    <Attribute ID="Ring_FX_Spd" Name="Ring FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Dimmer" Name="Ring Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="11~20" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="21~30" />
      <Function ID="4" Name="Pan Invert" Display="'Pan Invert'" Dmx="31~40" />
      <Function ID="5" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="41~50" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CS-400G v2" ShortName="CS-400G v2" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="A_Select, B_Select, Control" />
      <Function ID="2" Name="Geo Pattern" Display="'Geo Pattern'" Dmx="31~61" Update="A_Select, B_Select, Control" />
      <Function ID="3" Name="Geo Edit" Display="'Geo Edit'" Dmx="62~92" Update="A_Select, B_Select, Control" />
      <Function ID="4" Name="Geo Auto" Display="'Geo Auto'" Dmx="93~123" Update="A_Select, B_Select, Control" />
      <Function ID="5" Name="Geo Sound" Display="'Geo Sound'" Dmx="124~154" Update="A_Select, B_Select, Control" />
      <Function ID="6" Name="Anim Pattern" Display="'Anim Pattern'" Dmx="155~185" Update="A_Select, B_Select, Control" />
      <Function ID="7" Name="Anim Edit" Display="'Anim Edit'" Dmx="186~216" Update="A_Select, B_Select, Control" />
      <Function ID="8" Name="Anim Auto" Display="'Anim Auto'" Dmx="217~247" Update="A_Select, B_Select, Control" />
      <Function ID="9" Name="Anim Sound" Display="'Anim Sound'" Dmx="248~255" Update="A_Select, B_Select, Control" />
    </Attribute>
    <Attribute ID="A_Select" Name="A Select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Show" ID="2" If="'Mode'==3||'Mode'==4||'Mode'==5||'Mode'==7||'Mode'==8||'Mode'==9" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Show" Display="'Show %.f',0~255" Dmx="0~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="B_Select" Name="B Select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Show" ID="2" If="'Mode'==3||'Mode'==4||'Mode'==5||'Mode'==7||'Mode'==8||'Mode'==9" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Part" Display="'Part %.f',0~255" Dmx="0~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="C_Select" Name="C Select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="D_Select" Name="D Select" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Edit" ID="6,7" If="'Mode'==3||'Mode'==7" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Individual" Display="'Individual'" Dmx="0~0" />
      <Function ID="2" Name="Pattern A" Display="'Pattern A'" Dmx="52~103" />
      <Function ID="3" Name="Pattern B" Display="'Pattern B'" Dmx="104~155" />
      <Function ID="4" Name="Pattern C" Display="'Pattern C'" Dmx="156~207" />
      <Function ID="5" Name="Pattern D" Display="'Pattern D'" Dmx="208~255" />
      <Function ID="6" Name="Edit Off" Display="'Edit Off'" Dmx="0~0" />
      <Function ID="7" Name="Edit On" Display="'Edit On'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="192~255" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Vert_Rev" Name="Vert Rev" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Horiz_Rev" Name="Horiz Rev" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Moving" Name="Moving" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Horiz Spd" Display="'Horiz Spd %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Vert Spd" Display="'Vert Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="0~41" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="42~83" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="84~127" />
      <Function ID="4" Name="Point" Display="'Point %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~169" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="170~211" />
      <Function ID="5" Name="Patt Spd" Display="'Patt Spd %.f%%',0~100" Dmx="212~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="LZC400G2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="A_Select" ChannelOffset="2" Wheel="13" />
      <Attribute ID="B_Select" ChannelOffset="3" Wheel="14" />
      <Attribute ID="C_Select" ChannelOffset="4" Wheel="15" />
      <Attribute ID="D_Select" ChannelOffset="5" Wheel="43" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="44" />
      <Attribute ID="Effect_Rot" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Vert_Rev" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Horiz_Rev" ChannelOffset="9" Wheel="24" />
      <Attribute ID="Moving" ChannelOffset="10" Wheel="52" />
      <Attribute ID="Drawing" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="12" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="13" Wheel="2" />
      <Attribute ID="Zoom" ChannelOffset="14" Wheel="19" />
      <Attribute ID="Speed" ChannelOffset="15" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
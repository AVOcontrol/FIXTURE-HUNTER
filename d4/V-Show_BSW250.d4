    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index 0-250" Display="'Index 0-250 %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Index 0-90" Display="'Index 0-90 %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="Index 0-300" Display="'Index 0-300 %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="Index 0-360" Display="'Index 0-360 %.f%%',0~100" Dmx="156~175" />
      <Function ID="6" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="215~176" />
      <Function ID="7" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="8~131" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="132~249" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="250~253" />
    </Attribute>
  </Control>

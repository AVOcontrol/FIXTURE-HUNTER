<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Matrix559" ShortName="Matrix559" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="19-04-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto 1" Display="'Auto 1'" Dmx="0~12" Update="Auto_Spd" />
      <Function ID="2" Name="Auto 2" Display="'Auto 2'" Dmx="13~25" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 3" Display="'Auto 3'" Dmx="26~38" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 4" Display="'Auto 4'" Dmx="39~51" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 5" Display="'Auto 5'" Dmx="52~64" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 6" Display="'Auto 6'" Dmx="65~77" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 7" Display="'Auto 7'" Dmx="78~90" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 8" Display="'Auto 8'" Dmx="91~103" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 9" Display="'Auto 9'" Dmx="104~116" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 10" Display="'Auto 10'" Dmx="117~129" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 11" Display="'Auto 11'" Dmx="130~142" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 12" Display="'Auto 12'" Dmx="143~155" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 13" Display="'Auto 13'" Dmx="156~168" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 14" Display="'Auto 14'" Dmx="169~181" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 15" Display="'Auto 15'" Dmx="182~194" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 16" Display="'Auto 16'" Dmx="195~207" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 17" Display="'Auto 17'" Dmx="208~220" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 18" Display="'Auto 18'" Dmx="221~233" Update="Auto_Spd" />
      <Function ID="19" Name="Sound" Display="'Sound'" Dmx="234~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==19" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="IVMX5593" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>

      <Condition Name="Spin" ID="2,3,4,5,6,7" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.f%%',0~100" Dmx="0~63" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="145~64" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="146~149" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="150~231" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="146~149" />
      <Function ID="7" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="232~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

  <AtlaBase TypeID="b5516943-abad-4852-ba17-ec92677fc306" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="8~15" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~115" />
      <Function ID="4" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="124~173" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="182~231" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="3~25" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="26~48" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="49~71" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="72~94" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="95~117" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="118~140" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="141~163" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="164~186" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="187~209" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="210~232" />
      <Function ID="12" Name="Random" Display="'Random'" Dmx="233~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~249" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Square (1)" Display="'Square (1)'" Dmx="51~100" />
      <Function ID="3" Name="Square (2)" Display="'Square (2)'" Dmx="101~150" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="151~200" />
      <Function ID="5" Name="Halogen" Display="'Halogen'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

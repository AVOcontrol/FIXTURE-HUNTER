      <Function ID="3" Name="Single" Display="'Single'" Dmx="5~9" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~250" />
      <Function ID="5" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="160~199" />

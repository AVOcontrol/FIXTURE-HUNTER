      <Function ID="23" Name="Gobo 13" Display="'Gobo 13'" Dmx="63~65" WheelPosition="13" />
      <Function ID="24" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="25" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="66~72" WheelPosition="1" />

      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="70~99" />
      <Function ID="10" Name="Double" Display="'Double %.f%%',0~100" Dmx="100~129" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">

    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Combined" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~32639" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="32896~49087" />

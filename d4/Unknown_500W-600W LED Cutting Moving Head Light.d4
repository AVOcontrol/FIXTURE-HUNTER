    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="210~215" />
      <Function ID="3" Name="Reset Effect" Display="'Reset Effect'" Dmx="220~235" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="240~255" />
    </Attribute>
  </Control>
  <Mode Name="26 DMX" Channels="26" Id="d21c1793-bb89-4a46-a861-d07334d07c9f">

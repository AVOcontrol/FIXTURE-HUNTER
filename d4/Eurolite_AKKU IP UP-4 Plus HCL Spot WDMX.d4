    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="RGBAW+UV Switching" Display="'RGBAW+UV Switching'" Dmx="11~60" Update="Auto_Spd" />
      <Function ID="3" Name="63 Cols Switching" Display="'63 Cols Switching'" Dmx="61~120" Update="Auto_Spd" />
      <Function ID="4" Name="RGBAW+UV Fading" Display="'RGBAW+UV Fading'" Dmx="121~180" Update="Auto_Spd" />
      <Function ID="5" Name="63 Cols Fading" Display="'63 Cols Fading'" Dmx="181~240" Update="Auto_Spd" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="241~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2,3" If="'Auto'==6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">

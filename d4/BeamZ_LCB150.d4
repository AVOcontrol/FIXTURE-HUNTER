  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="deb470ab-607f-428d-b277-f176251ee697" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="50~59" Colour="255,100,0" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="60~69" Colour="180,0,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="70~79" Colour="255,255,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="80~89" Colour="255,0,255" />
      <Function ID="10" Name="Cyan" Display="'Cyan'" Dmx="90~99" Colour="0,255,255" />
      <Function ID="11" Name="Dark Orange" Display="'Dark Orange'" Dmx="100~109" Colour="255,128,0" />
      <Function ID="12" Name="Green Yellow" Display="'Green Yellow'" Dmx="110~119" Colour="180,180,0" />
      <Function ID="13" Name="Salmon" Display="'Salmon'" Dmx="120~129" Colour="255,150,150" />
      <Function ID="14" Name="Turquoise" Display="'Turquoise'" Dmx="130~139" Colour="0,255,128" />
      <Function ID="15" Name="Light Green" Display="'Light Green'" Dmx="140~149" Colour="128,255,0" />
      <Function ID="16" Name="Orange" Display="'Orange'" Dmx="150~159" Colour="255,128,0" />
      <Function ID="17" Name="Straw" Display="'Straw'" Dmx="160~169" Colour="255,250,230" />
      <Function ID="18" Name="Lavender" Display="'Lavender'" Dmx="170~179" Colour="255,128,255" />
      <Function ID="19" Name="Light Blue" Display="'Light Blue'" Dmx="180~189" Colour="0,128,255" />
      <Function ID="20" Name="Dark Blue" Display="'Dark Blue'" Dmx="190~199" Colour="0,0,180" />
      <Function ID="21" Name="Pink" Display="'Pink'" Dmx="200~209" Colour="255,150,150" />
      <Function ID="22" Name="Cool White" Display="'Cool White'" Dmx="210~219" Colour="230,230,255" />
      <Function ID="23" Name="Warm White" Display="'Warm White'" Dmx="220~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="10~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="40~69" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="70~99" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="100~129" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1 %.f%%',0~100" Dmx="130~159" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2 %.f%%',0~100" Dmx="160~189" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3 %.f%%',0~100" Dmx="190~219" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4 %.f%%',0~100" Dmx="220~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="White 4300K" Display="'White 4300K'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="White 6500K" Display="'White 6500K'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="White 8000K" Display="'White 8000K'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />

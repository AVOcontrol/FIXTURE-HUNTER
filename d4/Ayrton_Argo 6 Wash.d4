  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>1b7c1539-bc2a-4aca-929e-decffb468d71</Thumbnail>
  <History Date="19-05-22" Author="Nic Morris" Comment="Created (no pixel layout)" Version="0" />
  <History Date="31-05-22" Author="Nic Morris" Comment="Added pixel layout to Extended modes based on coordinates." Version="2" />
  <History Date="31-05-22" Author="Nic Morris" Comment="Added Liquid FX modes and layouts also based on coordinates (it is not clear how these might be used. they are not in the DMX mapping and there is very little information in the documentation)." Version="3" />
  <History Date="21-10-22" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer feedback (Terbly/Goldensea) (revises chase and effect control ranges and various locate values)" Version="4" />
  <History Date="01-03-23" Author="Nic Morris" Comment="Created from Ayrton Zonda 9 FX" Version="5" />
  <History Date="19-08-23" Author="Nic Morris" Comment="Created from Ayrton Zonda 3 FX (guessed pixel layout)" Version="6" />
  <History Date="02-11-23" Author="Nic Morris" Comment="Created from Ayrton Argo 6 FX (guessed pixel layout)" Version="7" />
  <History Date="08-11-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="03-02-26" Author="Nic Morris" Comment="Updated in line with v130 charts (adds extended ring and extended pixel modes.  no pixel layout - assumed same as parent fixtures...)" Version="9" />
  <History Date="04-02-26" Author="Nic Morris" Comment="Removed old Atlabase IDs from v130 modes." Version="10" />
  <History Date="10-02-26" Author="Nic Morris" Comment="Added Atlabase ID's for new modes.  Removed old modes." Version="11" />

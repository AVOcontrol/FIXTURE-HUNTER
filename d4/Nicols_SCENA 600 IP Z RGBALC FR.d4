      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="X" Name="X" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X" Display="'%.1f',0.0~85.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Y" Name="Y" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y" Display="'%.1f',0.0~85.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel_Source_CCT" Name="Gel Source CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="6500K" Display="'6500K'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel_Category" Name="Gel Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Gel" Colour="0,0,0" />
      <Function ID="2" Name="LEE Colour Correction" Display="'LEE Colour Correction'" Dmx="10~19" Update="Gel" Colour="0,0,0" />
      <Function ID="3" Name="LEE Colour Filter" Display="'LEE Colour Filter'" Dmx="20~29" Update="Gel" Colour="0,0,0" />
      <Function ID="4" Name="LEE 600 Series" Display="'LEE 600 Series'" Dmx="30~39" Update="Gel" Colour="0,0,0" />
      <Function ID="5" Name="LEE Cosmetic Filter" Display="'LEE Cosmetic Filter'" Dmx="40~49" Update="Gel" Colour="0,0,0" />
      <Function ID="6" Name="LEE 700 Series" Display="'LEE 700 Series'" Dmx="50~59" Update="Gel" Colour="0,0,0" />
      <Function ID="7" Name="RC Colour Correction" Display="'RC Colour Correction'" Dmx="60~69" Update="Gel" Colour="0,0,0" />
      <Function ID="8" Name="RC CalC" Display="'RC CalC'" Dmx="70~79" Update="Gel" Colour="0,0,0" />

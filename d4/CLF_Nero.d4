    <Attribute ID="Plate_Col" Name="Plate Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="White 4200K" Display="'White 4200K'" Dmx="5~6" Colour="255,255,255" />

  <History Date="11-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="04-02-23" Author="Nic Morris" Comment="Created from LIGHT4ME Mini Spot 30 Ring (effectively identical.  also missing majority of ranges)" Version="3" />

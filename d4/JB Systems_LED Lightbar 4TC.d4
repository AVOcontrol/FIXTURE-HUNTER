<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Lightbar 4TC" ShortName="Lightbar" Company="JB Systems">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="27-11-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" Colour="255,255,255" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" Colour="255,255,255" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" Colour="255,255,255" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" Colour="255,255,255" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" Colour="255,255,255" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" Colour="255,255,255" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" Colour="255,255,255" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" Colour="255,255,255" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Manual" Display="'Manual'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Colour Chase 1" Display="'Colour Chase 1'" Dmx="8~22" Colour="255,255,255" />
      <Function ID="3" Name="Colour Chase 2" Display="'Colour Chase 2'" Dmx="23~37" Colour="255,255,255" />
      <Function ID="4" Name="Colour Chase 3" Display="'Colour Chase 3'" Dmx="38~52" Colour="255,255,255" />
      <Function ID="5" Name="Colour Chase 4" Display="'Colour Chase 4'" Dmx="53~67" Colour="255,255,255" />
      <Function ID="6" Name="Colour Chase 5" Display="'Colour Chase 5'" Dmx="68~82" Colour="255,255,255" />
      <Function ID="7" Name="Colour Chase 6" Display="'Colour Chase 6'" Dmx="83~97" Colour="255,255,255" />
      <Function ID="8" Name="Colour Chase 7" Display="'Colour Chase 7'" Dmx="98~112" Colour="255,255,255" />
      <Function ID="9" Name="Colour Chase 8" Display="'Colour Chase 8'" Dmx="113~127" Colour="255,255,255" />
      <Function ID="10" Name="Colour Chase 9" Display="'Colour Chase 9'" Dmx="128~142" Colour="255,255,255" />
      <Function ID="11" Name="Colour Chase 10" Display="'Colour Chase 10'" Dmx="143~157" Colour="255,255,255" />
      <Function ID="12" Name="Colour Chase 11" Display="'Colour Chase 11'" Dmx="158~172" Colour="255,255,255" />
      <Function ID="13" Name="Colour Chase 12" Display="'Colour Chase 12'" Dmx="173~187" Colour="255,255,255" />
      <Function ID="14" Name="Colour Chase 13" Display="'Colour Chase 13'" Dmx="188~202" Colour="255,255,255" />
      <Function ID="15" Name="Colour Chase 14" Display="'Colour Chase 14'" Dmx="203~217" Colour="255,255,255" />
      <Function ID="16" Name="Colour Chase 15" Display="'Colour Chase 15'" Dmx="218~232" Colour="255,255,255" />
      <Function ID="17" Name="Colour Chase 16" Display="'Colour Chase 16'" Dmx="233~247" Colour="255,255,255" />
      <Function ID="18" Name="Stand Alone" Display="'Stand Alone'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="4 DMX" ID="2,3,4,5,6" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="8~190" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="4" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="5" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="6" Name="Stand Alone" Display="'Stand Alone'" Dmx="191~200" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~247" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Hold" Display="'Hold'" Dmx="0~7" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="JBLB4TC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="JBLB4TC4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Dummy" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="JBLB4TC7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro1" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Speed" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="RGB Cell, 3 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="RGB Cell, 3 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="RGB Cell, 3 DMX" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="RGB Cell, 3 DMX" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" ChannelOffset="13" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="14" Wheel="4" />
        <Attribute ID="Colour_Macro1" ChannelOffset="15" Wheel="9" />
        <Attribute ID="Speed" ChannelOffset="16" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="RGB Cell, no v-dim" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="RGB Cell, no v-dim" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="RGB Cell, no v-dim" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="RGB Cell, no v-dim" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="RGB Cell, 3 DMX" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="RGB Cell, no v-dim" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
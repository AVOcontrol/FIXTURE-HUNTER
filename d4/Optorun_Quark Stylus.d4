    </Attribute>
    <Attribute ID="Clipping" Name="Clipping" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Size" Display="'Full Size'" Dmx="0~0" Iris="0~0" Zoom="0~0" />

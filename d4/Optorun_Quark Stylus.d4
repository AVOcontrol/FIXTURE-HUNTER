  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="6" PowerOn="6" />
      <Function ID="1" Name="Laser OFF" Display="'Laser OFF'" Dmx="0~49" />

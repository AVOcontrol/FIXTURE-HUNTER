  <Mode Name="Cell" Channels="3" Hidden="True" Id="9051be86-0046-48de-8d74-499f60a3d7a6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

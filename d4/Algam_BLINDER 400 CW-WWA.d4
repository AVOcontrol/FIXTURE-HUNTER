  <Thumbnail>b9a1a792-b7ed-41e3-af3b-3594563d3029</Thumbnail>
  <History Date="24-03-25" Author="Nic Morris" Comment="Created (charts contain range conflicts.  guessed cell layout)" Version="0" />
  <History Date="27-03-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e0586d6b-099f-4006-b2a9-c1cf5e6cd63e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="50~50" Update="Auto_Spd" />
      <Function ID="3" Name="Single Col Jump" Display="'Single Col Jump'" Dmx="51~78" Update="Auto_Spd" />
      <Function ID="4" Name="Col Jump" Display="'Col Jump'" Dmx="79~100" Update="Auto_Spd" />
      <Function ID="5" Name="Single Col Gradient" Display="'Single Col Gradient'" Dmx="101~128" Update="Auto_Spd" />
      <Function ID="6" Name="Col Gradient" Display="'Col Gradient'" Dmx="129~150" Update="Auto_Spd" />
      <Function ID="7" Name="Single Pulse" Display="'Single Pulse'" Dmx="151~178" Update="Auto_Spd" />
      <Function ID="8" Name="Pulse" Display="'Pulse'" Dmx="179~200" Update="Auto_Spd" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="201~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Auto'==2" />
      <Condition Name="Sound" ID="3" If="'Auto'==9" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="514020e7-12d4-4791-8245-1157f5513b05">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

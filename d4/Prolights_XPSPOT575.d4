      <Palette ID="8" Name="Green Blue" Number="6" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour1:12,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="10" Name="Steel Blue" Number="7" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="11" Name="Deep Blue" Number="9" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="12" Name="Rose Pink" Number="10" Page="1" SetControl="Colour2:3,Colour2Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="13" Name="Rose Pink" Number="0" Page="1" SetControl="Colour2:3,Colour2Func:1,Colour1:1,Colour1Func:1" />
      <Palette ID="14" Name="Dark Pink" Number="8" Page="1" SetControl="Colour1:10,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="15" Name="Deep Blue" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1,Colour2Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />

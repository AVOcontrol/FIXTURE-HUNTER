  <History Date="11-10-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="17-10-15" Author="Nic Morris" Comment="Swapped shutter open and closed ranges in repsonse to customer bug report." Version="2" />
  <History Date="17-10-15" Author="Nic Morris" Comment="Changed all fixed first functions to default at zero just in case." Version="3" />
  <History Date="20-10-15" Author="Nic Morris" Comment="Added virtual dimmer to cells in response to customer bug report." Version="4" />
  <History Date="17-03-16" Author="Nic Morris" Comment="Created from Cameo PIXBAR 600 PRO" Version="5" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="6" />

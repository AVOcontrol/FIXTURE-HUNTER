  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="27d13a98-bbed-475d-833a-c37d6354079a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="201~210" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~1000" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Wave" Display="'Wave'" Dmx="1~1" />
      <Function ID="3" Name="Step" Display="'Step'" Dmx="2~2" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="3~3" />

      <Function ID="58" Name="Snowflakes" Display="'Snowflakes'" Dmx="110~110" />
      <Function ID="59" Name="Rain" Display="'Rain'" Dmx="111~111" />
      <Function ID="60" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect Mod" Description="" Group="E">
      <Locate Locate="4:0" PowerOn="4:0" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Sync" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sync" Display="'No Sync'" Dmx="0~0" />
      <Function ID="2" Name="Offset" Display="'Offset %.f°',10~350" Dmx="1~35" />
      <Function ID="3" Name="Sync" Display="'Sync'" Dmx="36~36" />
      <Function ID="4" Name="Rnd Start" Display="'Rnd Start'" Dmx="101~120" />
      <Function ID="5" Name="Rnd Duration" Display="'Rnd Duration'" Dmx="121~140" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="P3_Switch" Name="P3 Switch" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DMX Mode" Display="'DMX Mode'" Dmx="0~0" />
      <Function ID="2" Name="Video Mode" Display="'Video Mode'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="RGB, 3 DMX" Channels="3">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pure Diode RGB 3.0" ShortName="Pure RGB 3" Company="BSL">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-05-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Basic" Display="'Basic'" Dmx="32~95" />
    </Attribute>
    <Attribute ID="Mode1" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="96~159" />
    </Attribute>
    <Attribute ID="Mode2" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Extended" Display="'Extended'" Dmx="160~223" />
    </Attribute>
    <Attribute ID="Mode3" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Full" Display="'Full'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Page" Name="Page" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="16~31" />
      <Function ID="3" Name="3" Display="'3'" Dmx="32~47" />
      <Function ID="4" Name="4" Display="'4'" Dmx="48~63" />
      <Function ID="5" Name="5" Display="'5'" Dmx="64~79" />
      <Function ID="6" Name="6" Display="'6'" Dmx="80~95" />
      <Function ID="7" Name="7" Display="'7'" Dmx="96~111" />
      <Function ID="8" Name="8" Display="'8'" Dmx="112~127" />
      <Function ID="9" Name="9" Display="'9'" Dmx="128~143" />
      <Function ID="10" Name="10" Display="'10'" Dmx="144~159" />
      <Function ID="11" Name="11" Display="'11'" Dmx="160~175" />
      <Function ID="12" Name="12" Display="'12'" Dmx="176~191" />
      <Function ID="13" Name="13" Display="'13'" Dmx="192~207" />
      <Function ID="14" Name="14" Display="'14'" Dmx="208~223" />
      <Function ID="15" Name="15" Display="'15'" Dmx="224~239" />
      <Function ID="16" Name="16" Display="'16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Cue" Name="Cue" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Cue" Display="'Cue %.f',1~48" Dmx="32~224" />
      <Function ID="3" Name="Repeat" Display="'Repeat'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="16~31" />
      <Function ID="3" Name="Speed" Display="'Speed %.f%%',25~200" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="X_Size" Name="X Size" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Y_Size" Name="Y Size" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Z_Angle" Name="Z Angle" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Angle" Display="'%.f°',0~360" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X_Pos" Name="X Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y_Pos" Name="Y Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Pos" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Points" Name="Points" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Points" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan_Spd" Name="Scan Spd" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Release" Name="Release" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Pause" Display="'Pause'" Dmx="32~95" />
      <Function ID="3" Name="Loop" Display="'Loop'" Dmx="96~159" />
      <Function ID="4" Name="Next" Display="'Next'" Dmx="160~223" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="32~223" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Basic" Channels="4">
    <Import PearlRef="UKBSLD3B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

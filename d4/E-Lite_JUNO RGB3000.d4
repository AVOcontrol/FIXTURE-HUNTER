    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Auto Circ" Display="'Auto Circ %.f%%',0~100" Dmx="126~225" />
      <Function ID="3" Name="Rnd Jump" Display="'Rnd Jump %.f%%',0~100" Dmx="226~245" />
      <Function ID="4" Name="Rnd Sound" Display="'Rnd Sound %.f%%',0~100" Dmx="246~255" />

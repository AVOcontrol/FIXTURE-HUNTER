<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ignite 150" ShortName="Ignite 150" Company="Prestige">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="10-10-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="21~60" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="101~140" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="141~180" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="181~220" Intensity="0~0" />
      <Function ID="6" Name="Async" Display="'Async %.f%%',0~100" Dmx="6~20" Intensity="0~0" />
      <Function ID="7" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="61~100" Intensity="0~0" />
      <Function ID="8" Name="Square" Display="'Square %.f%%',0~100" Dmx="221~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="2" Name="CTO 1" Display="'CTO 1'" Dmx="11~15" />
      <Function ID="3" Name="CTO 2" Display="'CTO 2'" Dmx="16~20" />
      <Function ID="4" Name="CTO 3" Display="'CTO 3'" Dmx="21~25" />
      <Function ID="5" Name="CTO 4" Display="'CTO 4'" Dmx="26~30" />
      <Function ID="6" Name="CTO 5" Display="'CTO 5'" Dmx="31~35" />
      <Function ID="7" Name="CTO 6" Display="'CTO 6'" Dmx="36~40" />
      <Function ID="8" Name="CTO 7" Display="'CTO 7'" Dmx="41~45" />
      <Function ID="9" Name="CTO 8" Display="'CTO 8'" Dmx="46~50" />
      <Function ID="10" Name="CTO 9" Display="'CTO 9'" Dmx="51~55" />
      <Function ID="11" Name="CTO 10" Display="'CTO 10'" Dmx="56~60" />
      <Function ID="12" Name="Auto 1" Display="'Auto 1'" Dmx="61~65" />
      <Function ID="13" Name="Auto 2" Display="'Auto 2'" Dmx="66~70" />
      <Function ID="14" Name="Auto 3" Display="'Auto 3'" Dmx="71~75" />
      <Function ID="15" Name="Auto 4" Display="'Auto 4'" Dmx="76~80" />
      <Function ID="16" Name="Auto 5" Display="'Auto 5'" Dmx="81~85" />
      <Function ID="17" Name="Chase 1" Display="'Chase 1'" Dmx="86~90" />
      <Function ID="18" Name="Chase 2" Display="'Chase 2'" Dmx="91~95" />
      <Function ID="19" Name="Chase 3" Display="'Chase 3'" Dmx="96~100" />
      <Function ID="20" Name="Sound 1" Display="'Sound 1'" Dmx="101~105" />
      <Function ID="21" Name="Sound 2" Display="'Sound 2'" Dmx="106~110" />
      <Function ID="22" Name="R" Display="'R'" Dmx="111~115" />
      <Function ID="23" Name="G" Display="'G'" Dmx="116~120" />
      <Function ID="24" Name="B" Display="'B'" Dmx="121~125" />
      <Function ID="25" Name="A" Display="'A'" Dmx="126~130" />
      <Function ID="26" Name="W" Display="'W'" Dmx="131~135" />
      <Function ID="27" Name="AW" Display="'AW'" Dmx="136~140" />
      <Function ID="28" Name="Yellow" Display="'Yellow'" Dmx="141~145" />
      <Function ID="29" Name="Pink" Display="'Pink'" Dmx="146~150" />
      <Function ID="30" Name="Cyan" Display="'Cyan'" Dmx="151~155" />
      <Function ID="31" Name="Orange" Display="'Orange'" Dmx="156~160" />
      <Function ID="32" Name="Violet" Display="'Violet'" Dmx="161~165" />
      <Function ID="33" Name="Golden" Display="'Golden'" Dmx="166~170" />
      <Function ID="34" Name="2700K" Display="'2700K'" Dmx="171~175" />
      <Function ID="35" Name="3200K" Display="'3200K'" Dmx="176~180" />
      <Function ID="36" Name="4000K" Display="'4000K'" Dmx="181~185" />
      <Function ID="37" Name="5500K" Display="'5500K'" Dmx="186~190" />
      <Function ID="38" Name="5600K" Display="'5600K'" Dmx="191~195" />
      <Function ID="39" Name="RGBW" Display="'RGBW'" Dmx="196~200" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~10" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="21~30" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="31~40" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Square Smooth" Display="'Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Inv Sq Smooth" Display="'Inv Sq Smooth'" Dmx="71~80" />
      <Function ID="9" Name="S-Curve Smooth" Display="'S-Curve Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Default" Display="'Default'" Dmx="91~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX m1" Channels="4">
    <Import PearlRef="UKPS1501" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX m2" Channels="4">

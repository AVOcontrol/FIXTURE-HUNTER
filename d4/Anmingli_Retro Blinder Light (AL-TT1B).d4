  <Thumbnail>4dedf891-8ad7-4340-82e3-5513f826419d</Thumbnail>
  <History Date="29-10-24" Author="Nic Morris" Comment="Created (manual contains a 37 channel mode but charts are nonsense.  omitted for now)" Version="0" />
  <History Date="30-10-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="31-10-24" Author="Nic Morris" Comment="Revised cell names." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="245098dd-6e64-42c2-a955-7f412b3d6d03" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Seq RGB CCW" Display="'Col Seq RGB CCW'" Dmx="22~36" />
      <Function ID="3" Name="Col Seq RGB CW" Display="'Col Seq RGB CW'" Dmx="37~51" />
      <Function ID="4" Name="Col Add Mode RGB CCW" Display="'Col Add Mode RGB CCW'" Dmx="52~65" />
      <Function ID="5" Name="Col Add Mode RGB CW" Display="'Col Add Mode RGB CW'" Dmx="66~80" />
      <Function ID="6" Name="Col Seq Rot RGB CCW" Display="'Col Seq Rot RGB CCW'" Dmx="81~95" />
      <Function ID="7" Name="Col Seq Rot RGB CW" Display="'Col Seq Rot RGB CW'" Dmx="96~110" />
      <Function ID="8" Name="Small Col Seq Rot RGB CCW" Display="'Small Col Seq Rot RGB CCW'" Dmx="111~125" />
      <Function ID="9" Name="Small Col Seq Rot RGB CW" Display="'Small Col Seq Rot RGB CW'" Dmx="126~139" />
      <Function ID="10" Name="Med Col Seq Rot RGB CCW" Display="'Med Col Seq Rot RGB CCW'" Dmx="140~155" />
      <Function ID="11" Name="Med Col Seq Rot RGB CW" Display="'Med Col Seq Rot RGB CW'" Dmx="156~170" />
      <Function ID="12" Name="Large Col Seq Rot RGB CCW" Display="'Large Col Seq Rot RGB CCW'" Dmx="171~185" />
      <Function ID="13" Name="Large Col Seq Rot RGB CW" Display="'Large Col Seq Rot RGB CW'" Dmx="186~200" />
      <Function ID="14" Name="Three Col Seq Rot CCW" Display="'Three Col Seq Rot CCW'" Dmx="201~215" />
      <Function ID="15" Name="Three Col Seq Rot CW" Display="'Three Col Seq Rot CW'" Dmx="216~230" />
      <Function ID="16" Name="Col Seq" Display="'Col Seq'" Dmx="231~245" />
      <Function ID="17" Name="Col Seq xFade" Display="'Col Seq xFade'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="75b1b755-cf6b-445b-ad73-5ed4440dbf1a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1869d458-8771-4323-9964-15e5764d36f4" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Effect" ChannelOffset="8" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="White" ChannelOffset="2" ModeLink="White cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="4" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="White cell" Channels="2" Hidden="True" Id="4fb54545-0b3a-43c6-9c88-efec0732c5c0">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="4" Hidden="True" Id="46505288-7146-45a6-85b5-d844b0190768">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />

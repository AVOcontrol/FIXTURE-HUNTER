  <History Date="28-02-25" Author="Nic Morris" Comment="Created from Space Lights Lunar Tube (identical. no function ranges. documentation is unbranded and titled ABOIA COLOR TUBE)" Version="2" />
  <History Date="03-03-25" Author="Nic Morris" Comment="Added Atlabase ID's (Latechnoloiges Color Tube)" Version="3" />

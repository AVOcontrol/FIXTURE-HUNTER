  <History Date="14-09-16" Author="Nic Morris" Comment="Fixed missing cell attribute links in response to bug report." Version="2" />
  <History Date="03-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added product thumbnail.  Fixed 67 DMX p1 although largely irrelevant as only used for R20 export." Version="4" />
  <History Date="20-04-26" Author="Nic Morris" Comment="Changed all multi-cell modes to use virtual dimmer and replaced dimmer with master dimmer.  Both cell modes are now identical - retained original to avoid any compatibilty issues)" Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5f2c4f22-4b1a-471b-9167-e4dbcf548e86" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="40~47" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="48~55" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="56~63" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="8" Name="BW" Display="'BW'" Dmx="64~71" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="9" Name="WR" Display="'WR'" Dmx="72~79" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="GW" Display="'GW'" Dmx="80~87" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="11" Name="RB" Display="'RB'" Dmx="88~95" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="96~103" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="13" Name="GBW" Display="'GBW'" Dmx="104~111" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="14" Name="RGW" Display="'RGW'" Dmx="112~119" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="15" Name="RBW" Display="'RBW'" Dmx="120~127" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="16" Name="RGBW" Display="'RGBW'" Dmx="128~135" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer, Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Select" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

  <History Date="09-01-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="2:50" PowerOn="2:50" />
      <Function ID="1" Name="Digital" Display="'Digital %.1f%%',0.0~100.0" Dmx="0~128" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Optical" Display="'Optical %.1f%%',0.0~100.0" Dmx="129~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Display OFF" Display="'Display OFF'" Dmx="28~31" />
      <Function ID="3" Name="Display ON" Display="'Display ON'" Dmx="32~35" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="64~67" />
      <Function ID="5" Name="Lamp ON" Display="'Lamp ON'" Dmx="72~75" />
      <Function ID="6" Name="Lamp OFF" Display="'Lamp OFF'" Dmx="76~79" />
      <Function ID="7" Name="Shutdown" Display="'Shutdown'" Dmx="80~83" />
      <Function ID="8" Name="Reset Graphic" Display="'Reset Graphic'" Dmx="84~87" />
      <Function ID="9" Name="Lamp Brightness" Display="'Lamp Brightness'" Dmx="88~91" />
      <Function ID="10" Name="Lamp Eco" Display="'Lamp Eco'" Dmx="92~95" />
      <Function ID="11" Name="Project Floor" Display="'Project Floor'" Dmx="108~111" />
      <Function ID="12" Name="Project Ceiling" Display="'Project Ceiling'" Dmx="112~115" />
      <Function ID="13" Name="Project Front" Display="'Project Front'" Dmx="116~119" />
      <Function ID="14" Name="Project Rear" Display="'Project Rear'" Dmx="120~123" />
      <Function ID="15" Name="DMX HUD Blue" Display="'DMX HUD Blue'" Dmx="248~248" />
      <Function ID="16" Name="DMX HUD Green" Display="'DMX HUD Green'" Dmx="249~249" />
      <Function ID="17" Name="DMX HUD Red" Display="'DMX HUD Red'" Dmx="250~250" />
      <Function ID="18" Name="DMX HUD White" Display="'DMX HUD White'" Dmx="251~251" />

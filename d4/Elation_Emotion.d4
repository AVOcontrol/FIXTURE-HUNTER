      <Function ID="21" Name="General HUD Red" Display="'General HUD Red'" Dmx="254~254" />
      <Function ID="22" Name="General HUD White" Display="'General HUD White'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Periodic" Display="'Periodic %.f%%',0~100" Dmx="1~84" Intensity="0~0" />
      <Function ID="3" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="85~167" Intensity="0~0" />
      <Function ID="4" Name="Rnd Rand" Display="'Rnd Rand %.f%%',0~100" Dmx="168~254" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Mod1" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;22" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
      <Function ID="2" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Mod2" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;22" />
      <Else ID="1" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
      <Function ID="2" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Condition Name="Mod3" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;22" />
      <Else ID="1" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
      <Function ID="2" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CMY" Display="'CMY'" Dmx="0~0" Update="Cyan, Magenta, Yellow" Colour="255,255,255" />

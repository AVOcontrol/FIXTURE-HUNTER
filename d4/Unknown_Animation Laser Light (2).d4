<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Animation Laser Light (2)" ShortName="Anim Laser" Company="Unknown" Version="1">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="08-04-20" Author="Nic Morris" Comment="Created (shocking documentation.  almost impossible to interpret.  only created 6 channel mode as requested by customer)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto Scene" Display="'Auto Scene'" Dmx="0~0" />
      <Function ID="2" Name="Auto Sequence" Display="'Auto Sequence'" Dmx="32~63" />
      <Function ID="3" Name="Auto Mixed" Display="'Auto Mixed'" Dmx="64~95" />
      <Function ID="4" Name="Sound Scene" Display="'Sound Scene'" Dmx="128~159" />
      <Function ID="5" Name="Sound Sequence" Display="'Sound Sequence'" Dmx="160~191" />
      <Function ID="6" Name="Sound Mixed" Display="'Sound Mixed'" Dmx="192~223" />
    </Attribute>
    <Attribute ID="Group" Name="Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Group 1" Display="'Group 1'" Dmx="0~0" />
      <Function ID="2" Name="Group 2" Display="'Group 2'" Dmx="16~31" />
      <Function ID="3" Name="Group 3" Display="'Group 3'" Dmx="32~47" />
      <Function ID="4" Name="Group 4" Display="'Group 4'" Dmx="48~63" />
      <Function ID="5" Name="Group 5" Display="'Group 5'" Dmx="64~79" />
      <Function ID="6" Name="Group 6" Display="'Group 6'" Dmx="80~95" />
      <Function ID="7" Name="Group 7" Display="'Group 7'" Dmx="96~111" />
      <Function ID="8" Name="Group 8" Display="'Group 8'" Dmx="112~127" />
      <Function ID="9" Name="Group 9" Display="'Group 9'" Dmx="128~143" />
      <Function ID="10" Name="Group 10" Display="'Group 10'" Dmx="144~159" />
      <Function ID="11" Name="Group 11" Display="'Group 11'" Dmx="160~175" />
      <Function ID="12" Name="Group 12" Display="'Group 12'" Dmx="176~191" />
      <Function ID="13" Name="Group 13" Display="'Group 13'" Dmx="192~207" />
      <Function ID="14" Name="Group 14" Display="'Group 14'" Dmx="208~223" />
      <Function ID="15" Name="Group 15" Display="'Group 15'" Dmx="224~239" />
      <Function ID="16" Name="Group 16" Display="'Group 16'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="96~127" Colour="0,255,0" />
      <Function ID="5" Name="(Unknown)" Display="'(Unknown)'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="160~191" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="192~223" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Mode" ChannelOffset="2" Wheel="28" />
      <Attribute ID="Group" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Pattern" ChannelOffset="4" Wheel="15" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Speed" ChannelOffset="6" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Original" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:2" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:4" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="8" Name="Original" Number="6" Page="1" SetControl="Colour1:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:6" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:7" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:7" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:7" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:6" />
    </Group>
  </Palettes>
</Fixture>
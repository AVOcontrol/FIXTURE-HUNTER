<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Two Beam + Strobe" ShortName="2 Bm+Strb" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="7 Patterns" Display="'7 Patterns'" Dmx="1~104" />
      <Function ID="3" Name="Effect Cycle" Display="'Effect Cycle'" Dmx="105~119" />
      <Function ID="4" Name="Effect 1" Display="'Effect 1'" Dmx="120~134" />
      <Function ID="5" Name="Effect 2" Display="'Effect 2'" Dmx="135~149" />
      <Function ID="6" Name="Effect 3" Display="'Effect 3'" Dmx="150~164" />
      <Function ID="7" Name="Effect 4" Display="'Effect 4'" Dmx="165~179" />
      <Function ID="8" Name="Effect 5" Display="'Effect 5'" Dmx="180~194" />
      <Function ID="9" Name="Effect 6" Display="'Effect 6'" Dmx="195~209" />
      <Function ID="10" Name="Effect 7" Display="'Effect 7'" Dmx="210~224" />
      <Function ID="11" Name="Effect 8" Display="'Effect 8'" Dmx="225~239" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKHY2BMS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Effect" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Effect_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
    </Include>
  </Mode>
</Fixture>
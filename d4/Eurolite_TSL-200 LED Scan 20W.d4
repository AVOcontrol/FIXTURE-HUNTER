  <History Date="16-01-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="17-02-18" Author="Nic Morris" Comment="Changed colour orange to red and pink to purple in response to customer information (manual is wrong)." />
  <History Date="17-02-18" Author="Nic Morris" Comment="Added split and index colour functions (note split colour values provided by customer)" />
  <History Date="17-02-18" Author="Nic Morris" Comment="Added product thumbnail." />
  <History Date="17-02-18" Author="Nic Morris" Comment="Revised colour ranges in response to customer information." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="78ad27ec-42d8-41f6-bad7-953eb03199d7" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="16,17,18,19,20,21,22,23,24" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="25,26" If="'Colour1Func'==4" />
      <Else ID="27" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Deep Blue'" Dmx="17~17" WheelPosition="1" Colour="0,0,180" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="32~32" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="48~48" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Purple" Display="'Purple'" Dmx="65~65" WheelPosition="4" Colour="128,0,128" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="80~80" WheelPosition="5" Colour="0,128,255" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="100~100" WheelPosition="6" Colour="0,255,0" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="115~115" WheelPosition="7" Colour="255,0,255" />
      <Function ID="9" Name="Op/ D Blu" Display="'Op/ D Blu'" Dmx="12~12" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Blu/ Rd" Display="'D Blu/ Rd'" Dmx="27~27" WheelPosition="1" Colour="0,0,180" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="42~42" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Ppl" Display="'Yel/ Ppl'" Dmx="59~59" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Ppl/ L Blu" Display="'Ppl/ L Blu'" Dmx="73~73" WheelPosition="4" Colour="128,0,128" />
      <Function ID="14" Name="L Blu/ Grn" Display="'L Blu/ Grn'" Dmx="91~91" WheelPosition="5" Colour="0,128,255" />
      <Function ID="15" Name="Grn/ Mag" Display="'Grn/ Mag'" Dmx="108~108" WheelPosition="6" Colour="0,255,0" />
      <Function ID="16" Name="Op - D Blu" Display="'Op - D Blu %.f%%',0~100" Dmx="0~17" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="D Blu - Rd" Display="'D Blu - Rd %.f%%',0~100" Dmx="17~32" WheelPosition="1" Colour="0,0,180" />
      <Function ID="18" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="255,0,0" />
      <Function ID="19" Name="Yel - Ppl" Display="'Yel - Ppl %.f%%',0~100" Dmx="48~65" WheelPosition="3" Colour="255,255,0" />
      <Function ID="20" Name="Ppl - L Blu" Display="'Ppl - L Blu %.f%%',0~100" Dmx="65~80" WheelPosition="4" Colour="128,0,128" />
      <Function ID="21" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="80~100" WheelPosition="5" Colour="0,128,255" />
      <Function ID="22" Name="Grn - Mag" Display="'Grn - Mag %.f%%',0~100" Dmx="100~115" WheelPosition="6" Colour="0,255,0" />
      <Function ID="23" Name="Mag - Op" Display="'Mag - Op %.f%%',0~100" Dmx="115~127" WheelPosition="7" Colour="255,0,255" />
      <Function ID="24" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="26" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="40~47" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="48~55" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="56~63" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="64~71" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="120~127" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="16~135" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="136~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~15" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="140~180" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="232~239" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~25" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="26~43" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="44~61" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="62~79" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="80~97" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="98~115" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="116~133" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="134~151" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="152~169" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="170~187" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="188~205" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="206~223" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="224~241" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="242~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="EXTSL200" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bf130c8b-5abf-434a-b72e-774e9ef60dd4" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />

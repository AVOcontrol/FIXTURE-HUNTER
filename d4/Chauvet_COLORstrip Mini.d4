<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORstrip Mini" ShortName="ClStrpMini" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-10-10" Author="John Rogers" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="03-08-17" Author="Nic Morris" Comment="Changed Atlabase mode ID to 'RGB Color Mix Mode' (querying multiple options)" />
  <History Date="03-08-17" Author="Nic Morris" Comment="Moved Colour Macro 'RGB Colour Mix' to first function and added conditionals to RGB channels." />
  <History Date="03-08-17" Author="Nic Morris" Comment="Revised Colour Macro function names and changed the colours to variable ranges." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b0740a9f-cee8-4dcd-adf5-20fdc6209862" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="RGB Colour Mix" Display="'RGB Colour Mix'" Dmx="210~219" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red %.f%%',0~100" Dmx="10~19" Update="Blue, Green, Red" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green %.f%%',0~100" Dmx="20~29" Update="Blue, Green, Red" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~39" Update="Blue, Green, Red" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="40~49" Update="Blue, Green, Red" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="50~59" Update="Blue, Green, Red" Colour="255,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan %.f%%',0~100" Dmx="60~69" Update="Blue, Green, Red" Colour="0,255,255" />
      <Function ID="9" Name="White" Display="'White %.f%%',0~100" Dmx="70~79" Update="Blue, Green, Red" Colour="255,255,255" />
      <Function ID="10" Name="Chase 1" Display="'Chase 1'" Dmx="80~89" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="11" Name="Chase 2" Display="'Chase 2'" Dmx="90~99" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="12" Name="Chase 3" Display="'Chase 3'" Dmx="100~109" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="13" Name="Chase 4" Display="'Chase 4'" Dmx="110~119" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="14" Name="Chase 5" Display="'Chase 5'" Dmx="120~129" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="15" Name="Chase 6" Display="'Chase 6'" Dmx="130~139" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="16" Name="Chase 7" Display="'Chase 7'" Dmx="140~149" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="17" Name="Chase 8" Display="'Chase 8'" Dmx="150~159" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="18" Name="Chase 9" Display="'Chase 9'" Dmx="160~169" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="19" Name="Chase 10" Display="'Chase 10'" Dmx="170~179" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="20" Name="Chase 11" Display="'Chase 11'" Dmx="180~189" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="21" Name="Chase 12" Display="'Chase 12'" Dmx="190~199" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="22" Name="Chase 13" Display="'Chase 13'" Dmx="200~209" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="23" Name="Color Fade" Display="'Color Fade'" Dmx="220~229" Update="Blue, Green, Red" Colour="0,0,0" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="230~255" Update="Blue, Green, Red" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Run Speed" ID="2,3" If="'Colour_Macro'&gt;9&amp;&amp;'Colour_Macro'&lt;23" />
      <Condition Name="Fade Speed" ID="4" If="'Colour_Macro'==23" />
      <Condition Name="No Function" ID="5" If="'Colour_Macro'==2||'Colour_Macro'==3||'Colour_Macro'==4||'Colour_Macro'==5||'Colour_Macro'==6||'Colour_Macro'==7||'Colour_Macro'==8||'Colour_Macro'==9||'Colour_Macro'==24" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="128~255" WheelPosition="0" Colour="255,255,255" />
      <Function ID="4" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" Colour="255,255,255" />
      <Function ID="5" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Strobe" ID="2,3,4" If="'Colour_Macro'&gt;2&amp;&amp;'Colour_Macro'&lt;14" />
      <Condition Name="No Function" ID="5" If="'Colour_Macro'==2||'Colour_Macro'==14||'Colour_Macro'==15||'Colour_Macro'==16||'Colour_Macro'==17||'Colour_Macro'==18||'Colour_Macro'==19||'Colour_Macro'==20||'Colour_Macro'==21||'Colour_Macro'==22||'Colour_Macro'==23||'Colour_Macro'==24" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="3~249" Colour="0,0,0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="0,0,0" />
      <Function ID="5" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CH_ColSMini" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8c1a0930-9b55-4140-821e-17494955121b" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
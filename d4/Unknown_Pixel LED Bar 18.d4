<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Pixel LED Bar 18" ShortName="PxLEDBar18" Company="Unknown" Version="3">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="13-11-19" Author="Nic Morris" Comment="Created (poor documentation - auto functions dont make sense)" Version="1" />
  <History Date="14-05-21" Author="Nic Morris" Comment="Created from Unknown LED Wall Washer Light (effecitvely identical.  poor documentation. same nonsense with auto function ranges)." Version="2" />
  <History Date="16-09-22" Author="Nic Morris" Comment="Created from Viking Lighting VK1815 Pixelbar" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Function_1" Name="Function 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Running" Display="'Col Running'" Dmx="26~35" />
      <Function ID="3" Name="Col Jump (1)" Display="'Col Jump (1)'" Dmx="36~45" />
      <Function ID="4" Name="Col Gradual" Display="'Col Gradual'" Dmx="46~55" />
      <Function ID="5" Name="Choose Col" Display="'Choose Col'" Dmx="56~65" />
      <Function ID="6" Name="Col Jump (2)" Display="'Col Jump (2)'" Dmx="66~75" />
      <Function ID="7" Name="Gradual, Pulse" Display="'Gradual, Pulse'" Dmx="76~85" />
      <Function ID="8" Name="Gradual 1" Display="'Gradual 1'" Dmx="86~95" />
      <Function ID="9" Name="Gradual 2" Display="'Gradual 2'" Dmx="96~105" />
      <Function ID="10" Name="Gradual 3" Display="'Gradual 3'" Dmx="106~115" />
      <Function ID="11" Name="Gradual 4" Display="'Gradual 4'" Dmx="116~125" />
      <Function ID="12" Name="Gradual 5" Display="'Gradual 5'" Dmx="126~135" />
      <Function ID="13" Name="Gradual 6" Display="'Gradual 6'" Dmx="136~145" />
      <Function ID="14" Name="Gradual 7" Display="'Gradual 7'" Dmx="146~155" />
      <Function ID="15" Name="Running Effect 8" Display="'Running Effect 8'" Dmx="156~165" />
      <Function ID="16" Name="Running Effect 9" Display="'Running Effect 9'" Dmx="166~175" />
      <Function ID="17" Name="Running Effect 10" Display="'Running Effect 10'" Dmx="176~185" />

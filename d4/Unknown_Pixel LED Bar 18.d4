      <Function ID="22" Name="Running Effect 15" Display="'Running Effect 15'" Dmx="226~235" />
      <Function ID="23" Name="Running Effect 16" Display="'Running Effect 16'" Dmx="236~245" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="246~255" />

  <History Date="26-06-08" Author="David Hunt" Comment="Created" Version="1" />
  <History Date="01-07-08" Author="Jonathan Moreton" Comment="Changed Segments to Cmixes, added virtual dimmer" Version="2" />
  <History Date="03-07-08" Author="Jonathan Moreton" Comment="Converted from Eagle fai Led Bar EA8080" Version="3" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from ASY to Asy" Version="4" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="5" />
  <History Date="16-02-11" Author="Nic Morris" Comment="Added fixture type." Version="6" />
  <History Date="16-02-11" Author="Nic Morris" Comment="Fixed incorrect channel count (master layer uses 5, was named 4)" Version="7" />
  <History Date="16-02-11" Author="Nic Morris" Comment="Added v-dim to segment layer" Version="8" />
  <History Date="16-02-11" Author="Nic Morris" Comment="Added palettes.  Fixed power on" Version="9" />
  <History Date="16-02-11" Author="Nic Morris" Comment="Standardised segment names and wheel mapping." Version="10" />
  <History Date="08-09-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." Version="11" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="12" />
  <History Date="06-05-17" Author="Nic Morris" Comment="Changed name from Lito LED Bar SL 1031 to Lito LED Bar SL-1031.  Added Atlabase ID's." Version="13" />
  <History Date="28-04-26" Author="Nic Morris" Comment="Changed cell master RGB controls to master versions, removed virtual controllers from master, changed cells to use dedicated hidden mode and added missing cell links.  Moved colour macro to colour wheel group.  Added missing Atlabase mode ID's." Version="14" />

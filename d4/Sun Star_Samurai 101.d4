    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="10~14" />
      <Function ID="3" Name="Speed Normal" Display="'Speed Normal'" Dmx="40~44" />
      <Function ID="4" Name="Speed Max" Display="'Speed Max'" Dmx="45~49" />
      <Function ID="5" Name="Speed Min" Display="'Speed Min'" Dmx="50~54" />

      <Function ID="13" Name="Halogen 1000W" Display="'Halogen 1000W'" Dmx="83~87" />
      <Function ID="14" Name="Halogen 1200W" Display="'Halogen 1200W'" Dmx="88~92" />
      <Function ID="15" Name="Halogen 2000W" Display="'Halogen 2000W'" Dmx="93~97" />
      <Function ID="16" Name="Halogen 2500W" Display="'Halogen 2500W'" Dmx="98~102" />
      <Function ID="17" Name="Reset to Default" Display="'Reset to Default'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Master" Name="White Master" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shape" Name="Shape" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shape" Display="'No Shape'" Dmx="0~0" Update="Shape_Speed, Shape_Offset" />
      <Function ID="2" Name="Ring 1" Display="'Ring 1'" Dmx="8~8" Update="Shape_Speed, Shape_Offset" />
      <Function ID="3" Name="Ring 2" Display="'Ring 2'" Dmx="9~9" Update="Shape_Speed, Shape_Offset" />
      <Function ID="4" Name="Ring 1+2" Display="'Ring 1+2'" Dmx="12~12" Update="Shape_Speed, Shape_Offset" />
      <Function ID="5" Name="Opening" Display="'Opening'" Dmx="15~15" Update="Shape_Speed, Shape_Offset" />
      <Function ID="6" Name="Opening Filled" Display="'Opening Filled'" Dmx="16~16" Update="Shape_Speed, Shape_Offset" />
      <Function ID="7" Name="Open/Close" Display="'Open/Close'" Dmx="17~17" Update="Shape_Speed, Shape_Offset" />
      <Function ID="8" Name="Open/Close Fill" Display="'Open/Close Fill'" Dmx="18~18" Update="Shape_Speed, Shape_Offset" />
      <Function ID="9" Name="Var Radius" Display="'Var Radius'" Dmx="19~19" Update="Shape_Speed, Shape_Offset" />
      <Function ID="10" Name="Var Radius Fill" Display="'Var Radius Fill'" Dmx="20~20" Update="Shape_Speed, Shape_Offset" />
      <Function ID="11" Name="Rand Pixel" Display="'Rand Pixel'" Dmx="21~21" Update="Shape_Speed, Shape_Offset" />
      <Function ID="12" Name="Rand Pixel Var" Display="'Rand Pixel Var'" Dmx="22~22" Update="Shape_Speed, Shape_Offset" />
      <Function ID="13" Name="Rainbow 1" Display="'Rainbow 1'" Dmx="23~23" Update="Shape_Speed, Shape_Offset" />
      <Function ID="14" Name="Rainbow 2" Display="'Rainbow 2'" Dmx="24~24" Update="Shape_Speed, Shape_Offset" />
      <Function ID="15" Name="Fan" Display="'Fan'" Dmx="25~25" Update="Shape_Speed, Shape_Offset" />
      <Function ID="16" Name="Bar" Display="'Bar'" Dmx="26~26" Update="Shape_Speed, Shape_Offset" />
      <Function ID="17" Name="Half Moon" Display="'Half Moon'" Dmx="27~27" Update="Shape_Speed, Shape_Offset" />
      <Function ID="18" Name="Triangle" Display="'Triangle'" Dmx="28~28" Update="Shape_Speed, Shape_Offset" />
      <Function ID="19" Name="Rot Bars" Display="'Rot Bars'" Dmx="29~29" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="10:0" PowerOn="10:0" />
      <Condition Name="Speed" ID="1,2,3,4" If="'Shape'==5||'Shape'==6||'Shape'==7||'Shape'==8" />
      <Condition Name="Radius" ID="5" If="'Shape'==9||'Shape'==10" />
      <Condition Name="Spin" ID="6,7,8,9" If="'Shape'==11||'Shape'==12||'Shape'==13||'Shape'==14||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19" />
      <Else ID="10" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="2" Name="Closing" Display="'Closing %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="4" Name="Opening" Display="'Opening %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="5" Name="Radius" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="7" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~126" />
      <Function ID="8" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="9" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shape_Smooth" Name="Shape Smooth" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Gamma" Display="'Gamma %.f',1~229" Dmx="16~245" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Shape_Red" Name="Shape Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Shape_Green" Name="Shape Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Shape_Blue" Name="Shape Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shape_White" Name="Shape White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shape_Dimmer" Name="Shape Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Back_Dimmer" Name="Back Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Opening" ID="1,2" If="'Shape'==5||'Shape'==6||'Shape'==7||'Shape'==8||'Shape'==11" />
      <Condition Name="Rand Pixel Var" ID="3" If="'Shape'==12" />
      <Condition Name="Rainbow 1" ID="4" If="'Shape'==9||'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19" />
      <Else ID="5" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Rand Flash" Display="'Rand Flash %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="3" Name="Pixel Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Index" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

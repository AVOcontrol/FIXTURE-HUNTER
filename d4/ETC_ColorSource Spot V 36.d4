      <Function ID="7" Name="Flicker" Display="'Flicker %.f%%',0~100" Dmx="161~200" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="10~19" />
      <Function ID="3" Name="Slow" Display="'Slow'" Dmx="20~20" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="21~248" />
      <Function ID="5" Name="Fast" Display="'Fast'" Dmx="249~249" />
    </Attribute>
    <Attribute ID="Curve" Name="Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Incandescent" Display="'Incandescent'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~19" />
      <Function ID="3" Name="Incandescent Red Shift" Display="'Incandescent Red Shift'" Dmx="20~29" />
      <Function ID="4" Name="Linear Red Shift" Display="'Linear Red Shift'" Dmx="30~39" />
      <Function ID="5" Name="Quick" Display="'Quick'" Dmx="40~49" />
      <Function ID="6" Name="Quick Linear" Display="'Quick Linear'" Dmx="50~59" />
      <Function ID="7" Name="Unregulated" Display="'Unregulated'" Dmx="60~69" />
      <Function ID="8" Name="Standard" Display="'Standard'" Dmx="70~79" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1900-5975" Display="'1900-5975 %.2fK',1900.00~5975.00" Dmx="257~42148" Colour="255,240,200" />
      <Function ID="3" Name="6000-10450" Display="'6000-10450 %.2fK',6000.00~10450.00" Dmx="42405~65278" Colour="255,240,200" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="65535~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Green" Display="'Full Green'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="3" Name="+ Green" Display="'+ Green %.1f',10.0~0.0" Dmx="2~127" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="5" Name="+ Magenta" Display="'+ Magenta %.1f',0.0~10.0" Dmx="129~254" Colour="0,0,0" />
      <Function ID="6" Name="Full Magenta" Display="'Full Magenta'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tune" Name="Tune" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Brightest" Display="'Brightest'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Best Spectral" Display="'Best Spectral'" Dmx="50~99" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Focus2" Name="AutoFocusFunc" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto Off" Display="'Auto Off'" Dmx="0~0" Update="Focus1" Iris="0~0" Zoom="0~0" />

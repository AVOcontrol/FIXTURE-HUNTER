<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VK280FLX" ShortName="VK280FLX" Company="Viking Lighting">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>e07ff015-d71f-452d-ae56-1a421bb9d065</Thumbnail>
  <History Date="09-09-10" Author="Jonathan Moreton" Comment="Created from Robe Robin 300E Spot" />
  <History Date="09-11-10" Author="John Rogers" Comment="Edited Colour order." />
  <History Date="09-11-10" Author="John Rogers" Comment="Tested against fixture." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Inverted speed ranges.  Reordered some attribute functions.  Removed PT Speed update from Control." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Standardised func names.  Renamed colour spit to index.  Simplified index ranges." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Increased wheel resolution.  Fixed 16bit raw ranges.  Added function indexs." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Shortened names for Expert LCD.  Added index/spin options to gobo2 scroll and random." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added highlight and lowlight." />
  <History Date="07-03-13" Author="Peter Budd" Comment="Created from Robe Robin 300 Spot Classic to Robe Robin Pointe V0.9 Spec" />
  <History Date="27-03-13" Author="Peter Budd" Comment="Edited updated to V0.91 of the spec" />
  <History Date="22-04-13" Author="Peter Budd" Comment="Added Auto Focus channel." />
  <History Date="22-04-13" Author="Peter Budd" Comment="Added Esta Manufacturer ID." />
  <History Date="02-05-13" Author="Peter Budd" Comment="Updated to V1.1 Spec. Including change to colour wheel, gobo 2 and autofocus ranges." />
  <History Date="07-05-13" Author="Peter Budd" Comment="Corrected wheel mapping." />
  <History Date="21-05-13" Author="Peter Budd" Comment="Fixed the Open/Hole effect on Gobo 2." />
  <History Date="22-05-13" Author="Peter Budd" Comment="Corrected Lamp Off Macro." />
  <History Date="24-07-13" Author="Peter Budd" Comment="Updated gobo 1 locate value." />
  <History Date="24-03-14" Author="Nic Morris" Comment="Adjusted physical max pan.  Added standard function to P/T speed.  Tidied macros." />
  <History Date="24-03-14" Author="Nic Morris" Comment="Added function index to colour.  Removed electronic strobe function from shutter." />
  <History Date="24-03-14" Author="Nic Morris" Comment="Added mode 3.  Changed gobo 1 to 8 bit." />
  <History Date="01-02-15" Author="Nic Morris" Comment="Recreated palettes in response to customer bug report (library re-sync)" />
  <History Date="07-05-16" Author="Nic Morris" Comment="Created from Robe Robin Pointe" />
  <History Date="19-08-16" Author="Nic Morris" Comment="Added Atlabase ID's (used Robe)" />
  <History Date="14-05-18" Author="Nic Morris" Comment="Revised Atlabase ID's for compatibility.  Removed 30 channel mode.  Added product thumbnail." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1bc38223-b193-4f40-8478-4d6e817123a9" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

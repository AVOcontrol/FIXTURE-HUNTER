    <Attribute ID="Focus1" Name="Auto Focus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Auto Off" ID="1" If="'Focus2'==1" />
      <Condition Name="Gobo 2" ID="2,3,4,5,6,7,8,9" If="'Focus2'==2" />
      <Condition Name="Gobo 1" ID="10,11,12,13,14,15,16,17,18" If="'Focus2'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Auto Focus Off" Display="'Auto Focus Off'" Dmx="0~0" Iris="0~0" Zoom="0~0" />

    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5||'Gobo2Func'==7" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6||'Gobo2Func'==8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="257~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~33153" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33410~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Prism Index" Display="'Prism Index'" Dmx="0~0" Update="Prism, Prism_Rot" />
      <Function ID="2" Name="Prism Spin" Display="'Prism Spin'" Dmx="0~0" Update="Prism, Prism_Rot" />
      <Function ID="3" Name="Macro" Display="'Macro'" Dmx="0~0" Update="Prism, Prism_Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Prism, Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Macro" ID="4,5" If="'Prism_Func'==3" />
      <Condition Name="Prism Index" ID="1,2,7" If="'Prism_Func'==1" />
      <Condition Name="Prism Spin" ID="3,8,9" If="'Prism_Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~19" />
      <Function ID="2" Name="6 Facet Prism Index" Display="'6 Facet Prism Index'" Dmx="20~49" />
      <Function ID="3" Name="6 Facet Prism Spin" Display="'6 Facet Prism Spin'" Dmx="50~75" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~19" />
      <Function ID="5" Name="Macro" Display="'Macro %.f',1~16" Dmx="128~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="7" Name="8 Facet Prim Index" Display="'8 Facet Prim Index'" Dmx="76~105" />
      <Function ID="8" Name="8 Facet Prism Spin" Display="'8 Facet Prism Spin'" Dmx="106~127" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~19" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism" ID="1,2,3,4" If="'Prism_Func'==2" />
      <Condition Name="Prism Index" ID="6" If="'Prism_Func'==1" />
      <Else ID="5" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~129" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="6" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~189" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~211" Iris="0~0" Zoom="0~0" />

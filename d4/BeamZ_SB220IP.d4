  <Mode Name="8 DMX" Channels="8" Id="3580b38a-fba2-4b33-9bbb-cc45833d46c0">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="35019fee-e42b-4dea-8456-a257e09acadd" />
    <Include />

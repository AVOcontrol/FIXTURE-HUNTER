  <Thumbnail>0317c331-23c4-4a1c-90b5-6ffe85ffbe1e</Thumbnail>
  <History Date="12-03-24" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="15-03-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c39cbef9-93c0-45af-9436-2f5a70074b3b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Dim/Auto_Spd" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="51~100" Update="Dim/Auto_Spd" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="101~150" Update="Dim/Auto_Spd" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="151~255" Update="Dim/Auto_Spd" />
    </Attribute>
    <Attribute ID="Dim/Auto_Spd" Name="Dim/Auto Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Else ID="1" />
      <Condition Name="Auto Spd" ID="2" If="'Auto'&gt;1" />
      <Function ID="1" Name="Dimmer Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Auto Spd" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="51e62bd5-bece-4a00-84d7-e9c85ec07f80">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d04e0937-2e45-4572-a2d8-02070ab0f22a" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>

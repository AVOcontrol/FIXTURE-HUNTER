<Fixture Name="ArcPower DRS System" ShortName="ArcPwrDRS" Company="Anolis">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>960c5287-86b3-4338-b75a-ef241e1bcd8a</Thumbnail>
  <History Date="08-12-17" Author="Nic Morris" Comment="Created (very confusing documentation - implemented as single zones only with global effects as a separate mode)" />
  <History Date="16-06-18" Author="Nic Morris" Comment="Created from Anolis ArcPower Rack Unit" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="143~128" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="159~144" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CH1" Name="CH1" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CH2" Name="CH2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CH3" Name="CH3" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CH4" Name="CH4" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CH116" Name="CH1" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CH216" Name="CH2" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CH316" Name="CH3" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CH416" Name="CH4" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO %.f%%',0~100" Dmx="1~15" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="4" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="16~56" Colour="0,0,255" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />
      <Function ID="6" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="56~96" Colour="0,128,255" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="8" Name="Grn - Y Grn" Display="'Grn - Y Grn %.f%%',0~100" Dmx="96~135" Colour="0,255,0" />
      <Function ID="9" Name="Yellow Green" Display="'Yellow Green'" Dmx="135~135" Colour="180,180,0" />
      <Function ID="10" Name="Y Grn - Rd" Display="'Y Grn - Rd %.f%%',0~100" Dmx="135~175" Colour="180,180,0" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="12" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="175~215" Colour="255,0,0" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="14" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="215~255" Colour="255,0,255" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="255~255" Colour="0,0,255" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="WW" Display="'WW'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- CW" Display="'- CW %.1f%%',0.0~100.0" Dmx="0~128" Colour="255,255,255" />
      <Function ID="3" Name="WW+CW" Display="'WW+CW'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="- WW" Display="'- WW %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
      <Function ID="5" Name="CW" Display="'CW'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>

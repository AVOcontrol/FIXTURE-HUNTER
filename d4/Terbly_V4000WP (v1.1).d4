<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="V4000WP (v1.1)" ShortName="V4000WP" Company="Terbly" Version="17">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>e0b2dc57-30fb-4352-8b43-bf1d5146ccc1</Thumbnail>
  <History Date="27-05-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="02-11-15" Author="Nic Morris" Comment="Updated to latest spec in response to manufacturer request" Version="2" />
  <History Date="14-04-16" Author="Nic Morris" Comment="Split autofocus into two separate 8bit controls in response to manufacturer request." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="4" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Changed All Blade Rot to locate and power on at 50% in response to customer bug report." Version="5" />
  <History Date="11-05-17" Author="Nic Morris" Comment="Reverted blade rot to locate and power on at zero." Version="6" />
  <History Date="21-12-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel counts to mode names." Version="7" />
  <History Date="21-12-17" Author="Nic Morris" Comment="Added product thumbnail" Version="8" />
  <History Date="30-12-17" Author="Nic Morris" Comment="Changed blades to two-point system in response to manufacturer request (documentation is incorrect)." Version="9" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Revised blade ID's in response to manufacturer calibration data." Version="10" />
  <History Date="20-05-18" Author="Nic Morris" Comment="Created from Terbly GL-6" Version="11" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Changed RGB to default at zero in response to manufacturer bug report." Version="12" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Removed RGB from highlight/lowlight in response to manufacturer request." Version="13" />
  <History Date="26-06-18" Author="Nic Morris" Comment="Minor revision to colour 2 function names in line with latest documentation in response to manufacturer request." Version="14" />
  <History Date="27-06-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail." Version="15" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="16" />
  <History Date="09-10-23" Author="Nic Morris" Comment="Changed name from V4000WP to V4000WP (v1.1) to distinguish from updated version." Version="17" />
  <Manual Filename="" Summary="" />

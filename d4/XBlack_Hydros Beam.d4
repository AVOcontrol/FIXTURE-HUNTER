      <Function ID="24" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="108~113" WheelPosition="10" />
      <Function ID="25" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="114~119" WheelPosition="11" />
      <Function ID="26" Name="Gobo 12 Shake" Display="'Gobo 12 Shake %.f%%',0~100" Dmx="120~125" WheelPosition="12" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="188~195" />
      <Function ID="28" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="187~128" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="188~195" />
      <Function ID="30" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="196~255" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

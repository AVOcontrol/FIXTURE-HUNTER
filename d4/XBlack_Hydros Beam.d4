      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="49~51" WheelPosition="12" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="15" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="54~59" WheelPosition="1" />
      <Function ID="16" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="60~65" WheelPosition="2" />

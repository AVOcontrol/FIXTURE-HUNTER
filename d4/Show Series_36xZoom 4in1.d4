<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="36xZoom 4in1" ShortName="36xZoom" Company="Show Series">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="14-11-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~6" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="7~65" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="70~128" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="133~191" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="196~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~4" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Colour="255,0,0" />
      <Function ID="3" Name="Colour " Display="'Colour'" Dmx="10~14" Colour="0,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="15~19" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~24" Colour="0,255,0" />
      <Function ID="6" Name="Light Blue" Display="'Light Blue'" Dmx="25~29" Colour="0,128,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="30~34" Colour="0,0,255" />
      <Function ID="8" Name="Deep Magenta" Display="'Deep Magenta'" Dmx="35~39" Colour="180,0,180" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="40~44" Colour="255,0,255" />
      <Function ID="10" Name="White" Display="'White'" Dmx="45~49" Colour="255,255,255" />
      <Function ID="11" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="50~94" Colour="0,0,0" />
      <Function ID="12" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="95~99" Colour="0,0,0" />
      <Function ID="13" Name="Macro 3" Display="'Macro 3'" Dmx="100~149" Colour="0,0,0" />
      <Function ID="14" Name="Macro 4" Display="'Macro 4'" Dmx="150~154" Colour="0,0,0" />
      <Function ID="15" Name="Macro 5" Display="'Macro 5'" Dmx="155~166" Colour="0,0,0" />
      <Function ID="16" Name="Macro 6" Display="'Macro 6'" Dmx="167~178" Colour="0,0,0" />
      <Function ID="17" Name="Macro 7" Display="'Macro 7'" Dmx="179~190" Colour="0,0,0" />
      <Function ID="18" Name="Macro 8" Display="'Macro 8'" Dmx="191~202" Colour="0,0,0" />
      <Function ID="19" Name="Macro 9" Display="'Macro 9'" Dmx="203~214" Colour="0,0,0" />
      <Function ID="20" Name="Macro 10" Display="'Macro 10'" Dmx="215~226" Colour="0,0,0" />
      <Function ID="21" Name="Macro 11" Display="'Macro 11'" Dmx="227~238" Colour="0,0,0" />
      <Function ID="22" Name="Macro 12" Display="'Macro 12'" Dmx="239~250" Colour="0,0,0" />
      <Function ID="23" Name="Macro 13" Display="'Macro 13'" Dmx="251~255" Colour="0,0,0" />
      <Function ID="24" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~80" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="96~110" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="126~175" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="191~240" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pan/Tilt Normal" Display="'Pan/Tilt Normal'" Dmx="0~63" />
      <Function ID="2" Name="Pan Invert" Display="'Pan Invert'" Dmx="64~127" />
      <Function ID="3" Name="Pan/Tilt Invert" Display="'Pan/Tilt Invert'" Dmx="128~191" />
      <Function ID="4" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="UK_SS36Z" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
      <Attribute ID="Direction" ChannelOffset="14" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
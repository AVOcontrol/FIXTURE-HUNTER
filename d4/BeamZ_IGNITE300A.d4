  <History Date="22-05-23" Author="Nic Morris" Comment="Created (poor documentation.  there appear to be two ways to set prism index - this doesn't make sense)" Version="0" />
  <History Date="24-05-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="04-09-24" Author="Nic Morris" Comment="Created from BeamZ IGNITE 300" Version="2" />
  <History Date="10-09-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="07-08-25" Author="Nic Morris" Comment="Updated with colour names/swatches/highlight/lowlight and palettes in response to latest information (not documented)" Version="4" />
  <History Date="19-03-26" Author="Nic Morris" Comment="Changed colour ranges to be fixed at the start value to try and solve customer bug report (this is contrary to the documentation)" Version="5" />
  <History Date="02-04-26" Author="Nic Morris" Comment="Separated colour into two 8bit controls (further attempt to solve customer bug report)" Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b5aa0cf5-eda0-46b6-833a-fcbcefab060b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~239" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="100~199" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="9" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Else ID="16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="20~20" Colour="0,0,255" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="40~40" Colour="255,150,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="60~60" Colour="255,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="80~80" Colour="0,255,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="100~100" Colour="255,0,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="120~120" Colour="0,255,0" />
      <Function ID="8" Name="Violet" Display="'Violet'" Dmx="140~140" Colour="100,0,200" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="160~160" Colour="255,255,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Skipped Rot" Display="'Skipped Rot %.f%%',0~100" Dmx="180~199" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~227" Colour="0,0,0" />
      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="15" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="228~255" Colour="0,0,0" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Fine" Name="Colour Fine" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

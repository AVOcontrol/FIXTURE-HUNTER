  <History Date="03-07-16" Author="Nic Morris" Comment="Created" />
  <History Date="30-08-18" Author="Nic Morris" Comment="Revised Atlabase model ID and added missing mode ID's.  Added product thumbnail." />
  <History Date="30-08-18" Author="Nic Morris" Comment="Fixed 7 DMX mode (dimmer was 16bit)" />
  <History Date="13-09-18" Author="Nic Morris" Comment="Changed name from Compact Power Lightset V2 to Compact Power Lightset MKII (30268) - this is suitable for all versions (1,2 and 3)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a5d364ba-ced5-4c06-ba26-b36d6db562ed" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Auto_Spd" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Update="Auto_Spd" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Update="Auto_Spd" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="40~49" Update="Auto_Spd" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Update="Auto_Spd" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Update="Auto_Spd" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="12" Name="Program 4" Display="'Program 4'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="13" Name="Program 5" Display="'Program 5'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="14" Name="Program 6" Display="'Program 6'" Dmx="130~139" Update="Auto_Spd" />
      <Function ID="15" Name="Program 7" Display="'Program 7'" Dmx="140~149" Update="Auto_Spd" />
      <Function ID="16" Name="Program 8" Display="'Program 8'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="17" Name="Program 9" Display="'Program 9'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="18" Name="Program 10" Display="'Program 10'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="19" Name="Program 11" Display="'Program 11'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="20" Name="Program 12" Display="'Program 12'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="21" Name="Program 13" Display="'Program 13'" Dmx="200~209" Update="Auto_Spd" />
      <Function ID="22" Name="Program 14" Display="'Program 14'" Dmx="210~219" Update="Auto_Spd" />
      <Function ID="23" Name="Program 15" Display="'Program 15'" Dmx="220~229" Update="Auto_Spd" />
      <Function ID="24" Name="Program 16" Display="'Program 16'" Dmx="230~239" Update="Auto_Spd" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==25" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="10~249" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

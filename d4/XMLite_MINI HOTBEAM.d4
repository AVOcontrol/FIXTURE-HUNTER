      <Function ID="30" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="190~220" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="221~250" Colour="0,0,0" />
      <Function ID="33" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="251~255" Colour="0,0,0" />
      <Function ID="34" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

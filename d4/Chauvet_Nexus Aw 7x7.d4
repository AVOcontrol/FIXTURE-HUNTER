  <AtlaBase TypeID="8a3a6f5e-ab05-4e44-bcbb-b54f17f55c6f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:4" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="FG_Dimmer" Name="FG Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Alphanumeric" Name="Alphanumeric" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Numeric 1-0" Display="'Numeric 1-0 %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="Alpha A-Z" Display="'Alpha A-Z %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Virtual_Gobo" Name="Virtual Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Simple Cross" Display="'Simple Cross'" Dmx="11~20" />
      <Function ID="3" Name="Simple box" Display="'Simple box'" Dmx="21~29" />
      <Function ID="4" Name="Square Imploder" Display="'Square Imploder'" Dmx="30~38" />
      <Function ID="5" Name="Square Exploder" Display="'Square Exploder'" Dmx="39~47" />
      <Function ID="6" Name="Diamond Imploder" Display="'Diamond Imploder'" Dmx="48~56" />
      <Function ID="7" Name="Diamond Exploder" Display="'Diamond Exploder'" Dmx="57~65" />
      <Function ID="8" Name="Two-Line Spinner" Display="'Two-Line Spinner'" Dmx="66~74" />
      <Function ID="9" Name="Triangle Spinner" Display="'Triangle Spinner'" Dmx="75~83" />
      <Function ID="10" Name="Tri-Downer" Display="'Tri-Downer'" Dmx="84~92" />
      <Function ID="11" Name="Tri-Upper" Display="'Tri-Upper'" Dmx="93~101" />
      <Function ID="12" Name="Bowtie Spinner" Display="'Bowtie Spinner'" Dmx="102~110" />
      <Function ID="13" Name="One-Liner" Display="'One-Liner'" Dmx="111~119" />
      <Function ID="14" Name="Line Hop Up" Display="'Line Hop Up'" Dmx="120~128" />
      <Function ID="15" Name="Line Hop Down" Display="'Line Hop Down'" Dmx="129~137" />
      <Function ID="16" Name="Line Hop Up/Down" Display="'Line Hop Up/Down'" Dmx="138~146" />
      <Function ID="17" Name="T-Spin" Display="'T-Spin'" Dmx="147~155" />
      <Function ID="18" Name="Upside Down T-Spin" Display="'Upside Down T-Spin'" Dmx="156~164" />
      <Function ID="19" Name="Diamond Spoke Spin" Display="'Diamond Spoke Spin'" Dmx="165~173" />
      <Function ID="20" Name="Line Hop Left" Display="'Line Hop Left'" Dmx="174~182" />
      <Function ID="21" Name="Line Hop Right" Display="'Line Hop Right'" Dmx="183~191" />
      <Function ID="22" Name="Line Hop Left/Right" Display="'Line Hop Left/Right'" Dmx="192~200" />
      <Function ID="23" Name="Double Verticals" Display="'Double Verticals'" Dmx="201~209" />
      <Function ID="24" Name="Double Horizontals" Display="'Double Horizontals'" Dmx="210~218" />
      <Function ID="25" Name="Diagonal Right" Display="'Diagonal Right'" Dmx="219~227" />
      <Function ID="26" Name="Diagonal Left" Display="'Diagonal Left'" Dmx="228~236" />
      <Function ID="27" Name="Moving Squares" Display="'Moving Squares'" Dmx="237~246" />
      <Function ID="28" Name="Clock" Display="'Clock'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~38" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="39~66" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="67~94" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="95~122" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="123~150" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="151~178" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="179~206" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="207~234" />
      <Function ID="10" Name="Auto 0" Display="'Auto 0'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Curve 1 (Fastest)" Display="'Curve 1 (Fastest)'" Dmx="102~152" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="153~203" />
      <Function ID="5" Name="Curve 3 (Slowest)" Display="'Curve 3 (Slowest)'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

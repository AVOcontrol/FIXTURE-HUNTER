  <RDM>
    <Device ManufacturerID="5584" ModelID="53554" />
  </RDM>
  <AtlaBase TypeID="8fed2422-5a9a-4e6a-bf62-94c82d941b45" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:1850" PowerOn="1:1850" />
      <Else ID="1" />
      <Condition Name="2200-15000K" ID="2" If="'CCT_Range'==2" />
      <Condition Name="2800-10000K" ID="3" If="'CCT_Range'==3" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',1850.0~20000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.1fK',2200.0~15000.0" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="CCT C-Mix" Display="'%.1fK',2800.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="2~3" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.1f%%',99.0~1.0" Dmx="4~126" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.1f%%',1.0~99.0" Dmx="129~253" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="254~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xFade_CCT-&gt;RGB" Name="xFade CCT-&gt;RGB" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CCT-&gt;RGB" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />

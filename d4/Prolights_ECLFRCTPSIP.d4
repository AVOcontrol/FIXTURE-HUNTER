    </Attribute>
    <Attribute ID="CCT_Range" Name="CCT Range" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1850-20000K" Display="'1850-20000K'" Dmx="0~0" Update="CCT" Colour="0,0,0" />
      <Function ID="2" Name="2200-15000K" Display="'2200-15000K'" Dmx="10~19" Update="CCT" Colour="0,0,0" />
      <Function ID="3" Name="2800-10000K" Display="'2800-10000K'" Dmx="20~29" Update="CCT" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="White_Point" Name="White Point" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic %.1fK',2800.0~10000.0" Dmx="514~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C" Size="2">

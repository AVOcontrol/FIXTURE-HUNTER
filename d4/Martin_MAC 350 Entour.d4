      <Function ID="26" Name="Chase Fast" Display="'Chase Fast'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="27" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />

      <Condition Name="Random" ID="27,28,29,30" If="'Colour1Func'==5" />
      <Else ID="31" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="173~176" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="169~172" WheelPosition="2" Colour="0,255,0" />

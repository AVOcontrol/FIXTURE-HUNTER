  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Shutter:1,Dimmer:1:232,Control:2" Delay="5000" />
      <Set Channel="Control:1,Shutter:2,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Shutter:1,Dimmer:1:232,Control:3" Delay="5000" />
      <Set Channel="Control:1,Shutter:2,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Shutter:1,Dimmer:1:232,Control:4" Delay="5000" />
      <Set Channel="Control:1,Shutter:2,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="P/T Speed Normal">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Speed Fast">

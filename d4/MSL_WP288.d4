      <Function ID="7" Name="Image 1" Display="'Image 1'" Dmx="96~111" />
      <Function ID="8" Name="Image 2" Display="'Image 2'" Dmx="112~127" />
      <Function ID="9" Name="Image 3" Display="'Image 3'" Dmx="128~143" />
      <Function ID="10" Name="Image 4" Display="'Image 4'" Dmx="144~159" />
      <Function ID="11" Name="Image 5" Display="'Image 5'" Dmx="160~175" />
      <Function ID="12" Name="Image 6" Display="'Image 6'" Dmx="176~190" />
      <Function ID="13" Name="Total Program" Display="'Total Program'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Wash_Shutter" Name="Wash Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Wash_Master" Name="Wash Master" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <History Date="13-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="13-08-16" Author="Nic Morris" Comment="Moved auto, auto spd and auto dimmer into effect group and wheel slots." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ff99c826-27f5-462c-a2da-6cb5eb936460" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~38" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="39~66" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="67~94" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="95~122" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="123~150" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="151~178" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="179~206" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="207~234" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="52~101" />
      <Function ID="3" Name="Dimmer 1" Display="'Dimmer 1'" Dmx="102~152" />
      <Function ID="4" Name="Dimmer 2" Display="'Dimmer 2'" Dmx="153~203" />
      <Function ID="5" Name="Dimmer 3" Display="'Dimmer 3'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Auto_Dimmer" Name="Auto Dimmer" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

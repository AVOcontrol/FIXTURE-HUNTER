  <History Date="11-08-24" Author="Nic Morris" Comment="Created (colour macros not documented properly and don't make sense)" Version="0" />
  <History Date="15-08-24" Author="Nic Morris" Comment="Added missing 3 DMX Art-net mode.  Added Atlabase ID's." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="afb13de8-6cb8-4a82-8bdd-5a4c5331b504" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Strobe" Name="Beam Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe Mode 1" Display="'Strobe Mode 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Strobe Mode 2" Display="'Strobe Mode 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Strobe Mode 3" Display="'Strobe Mode 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Strobe Mode 4" Display="'Strobe Mode 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Strobe Mode 5" Display="'Strobe Mode 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Strobe Mode 6" Display="'Strobe Mode 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="W_FX" Name="W FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro Mode 1" Display="'Macro Mode 1 %.f%%',0~100" Dmx="6~42" />
      <Function ID="3" Name="Macro Mode 2" Display="'Macro Mode 2 %.f%%',0~100" Dmx="43~85" />
      <Function ID="4" Name="Macro Mode 3" Display="'Macro Mode 3 %.f%%',0~100" Dmx="86~128" />
      <Function ID="5" Name="Macro Mode 4" Display="'Macro Mode 4 %.f%%',0~100" Dmx="129~171" />
      <Function ID="6" Name="Macro Mode 5" Display="'Macro Mode 5 %.f%%',0~100" Dmx="172~214" />
      <Function ID="7" Name="Macro Mode 6" Display="'Macro Mode 6 %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="W_FX_Spd" Name="W FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Macro" Name="Col Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="FX" Display="'FX %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Col_Macro_Spd" Name="Col Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Macro_CF" Name="Col Macro CF" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Effect Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Macro_CB" Name="Col Macro CB" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="BG Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="W_Master" Name="W Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="RGB_Master" Name="RGB Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

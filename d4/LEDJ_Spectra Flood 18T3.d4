      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="9~17" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="18~26" Colour="255,255,0" />
      <Function ID="5" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="27~35" Colour="255,255,0" />

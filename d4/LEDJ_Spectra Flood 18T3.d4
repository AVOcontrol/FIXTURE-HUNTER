      <Function ID="20" Name="Light Pink" Display="'Light Pink'" Dmx="162~170" Colour="255,200,200" />
      <Function ID="21" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="171~179" Colour="0,128,255" />
      <Function ID="22" Name="Pastel Green" Display="'Pastel Green'" Dmx="180~188" Colour="128,255,0" />
      <Function ID="23" Name="Pastel Yellow" Display="'Pastel Yellow'" Dmx="189~197" Colour="255,255,128" />
      <Function ID="24" Name="Pastel Purple" Display="'Pastel Purple'" Dmx="198~206" Colour="255,128,255" />
      <Function ID="25" Name="Pastel Cyan" Display="'Pastel Cyan'" Dmx="207~215" Colour="128,255,255" />
      <Function ID="26" Name="Turquoise" Display="'Turquoise'" Dmx="216~224" Colour="0,255,128" />
      <Function ID="27" Name="Pastel Pink" Display="'Pastel Pink'" Dmx="225~233" Colour="255,200,200" />
      <Function ID="28" Name="Neutral White" Display="'Neutral White'" Dmx="234~242" Colour="255,255,255" />
      <Function ID="29" Name="Warm White" Display="'Warm White'" Dmx="243~251" Colour="255,240,200" />
      <Function ID="30" Name="Cool White" Display="'Cool White'" Dmx="252~255" Colour="230,230,255" />

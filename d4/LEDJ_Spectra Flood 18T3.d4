    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="1~25" Update="Red" />
      <Function ID="3" Name="7 Col Pulse" Display="'7 Col Pulse'" Dmx="26~51" Update="Red" />
      <Function ID="4" Name="3 Col Pulse" Display="'3 Col Pulse'" Dmx="52~77" Update="Red" />
      <Function ID="5" Name="7 Col Change" Display="'7 Col Change'" Dmx="78~103" Update="Red" />
      <Function ID="6" Name="3 Col Change" Display="'3 Col Change'" Dmx="104~129" Update="Red" />
      <Function ID="7" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="130~155" Update="Red" />
      <Function ID="8" Name="3 Col Fade" Display="'3 Col Fade'" Dmx="156~181" Update="Red" />
      <Function ID="9" Name="Red Pulse" Display="'Red Pulse'" Dmx="182~207" Update="Red" />
      <Function ID="10" Name="Green Pulse" Display="'Green Pulse'" Dmx="208~233" Update="Red" />
      <Function ID="11" Name="Blue Pulse" Display="'Blue Pulse'" Dmx="234~255" Update="Red" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="69~91" Colour="0,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="92~114" Colour="255,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="115~137" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="138~160" Colour="255,150,150" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="161~183" Colour="128,0,255" />
      <Function ID="10" Name="Dark Blue" Display="'Dark Blue'" Dmx="184~206" Colour="0,0,180" />
      <Function ID="11" Name="Pale Green" Display="'Pale Green'" Dmx="207~229" Colour="128,255,0" />
      <Function ID="12" Name="White" Display="'White'" Dmx="230~252" Colour="255,255,255" />
      <Function ID="13" Name="Warm White" Display="'Warm White'" Dmx="253~255" Colour="255,240,200" />
    </Attribute>
  </Control>

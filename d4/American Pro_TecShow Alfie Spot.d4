  <AtlaBase TypeID="ec77588e-5c2b-417e-bed9-acd98f00a042" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="0~63" WheelPosition="0" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="64~127" WheelPosition="0" />
      <Function ID="3" Name="Blank" Display="'Blank'" Dmx="128~143" WheelPosition="0" />
      <Function ID="4" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="144~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~127" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="32~47" />
      <Function ID="4" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="48~63" />
      <Function ID="5" Name="All in Dark" Display="'All in Dark'" Dmx="64~79" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="80~95" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="96~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Intimidator Spot 250" ShortName="IntSp250" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>4a372cf8-c5d0-4a1b-804b-fcf1263a6876</Thumbnail>
  <History Date="11-06-09" Author="David Hunt" Comment="Created" />
  <History Date="19-06-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="18-01-18" Author="Oliver Waits" Comment="Added fixture and gobo images" />
  <History Date="20-01-18" Author="Nic Morris" Comment="Revised gobo images (previously they were from the LED version)." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Added channel counts to mode names.  Added physical pan/tilt ranges." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Standardised conditionals.  Changed split colours from variable to fixed and added function index." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Fixed gobo 1 shake DMX range.  Inverted gobo shake ranges." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Increased wheel resolution.  Swapped gobo rot spin ranges.  Added highlight/lowlight." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Revised effect with discreet functions." />
  <History Date="20-01-18" Author="Nic Morris" Comment="Replaced product thumbnail (previous version wasn't displaying)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7f5dbabf-69f4-4887-b267-db109f3717f3" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="6" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="8~15" WheelPosition="1" Colour="0,128,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="16~23" WheelPosition="2" Colour="255,0,0" />
      <Function ID="4" Name="Peachblow" Display="'Peachblow'" Dmx="24~31" WheelPosition="3" Colour="255,180,120" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="40~47" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="48~55" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="56~63" WheelPosition="7" Colour="180,0,255" />
      <Function ID="9" Name="Op/ L Blu" Display="'Op/ L Blu'" Dmx="67~78" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="L Blu/ Rd" Display="'L Blu/ Rd'" Dmx="79~92" WheelPosition="1" Colour="0,128,255" />
      <Function ID="11" Name="Rd/ PchBl" Display="'Rd/ PchBl'" Dmx="93~107" WheelPosition="2" Colour="255,0,0" />
      <Function ID="12" Name="PchBl/ Grn" Display="'PchBl/ Grn'" Dmx="108~120" WheelPosition="3" Colour="255,180,120" />
      <Function ID="13" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="121~136" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="137~152" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="Pk/ UV" Display="'Pk/ UV'" Dmx="153~170" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="212~171" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="213~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ca0df305-13b0-4256-80ef-baf5bd7f60c7</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>44bd2720-04bb-432e-aa0e-4de02ad8c533</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>3eeca8aa-a1dc-4090-9407-788589775761</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6dd5b880-8b69-4dd1-b9a9-f08465dddef9</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ade175ee-b656-4699-b8b8-ddc54fcfd23a</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>46f24908-6ac6-4a50-a52f-ba90164f9805</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~69" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>c7b62485-f8f2-47d9-90d8-49c3ff3c0869</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="70~79" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>678f119d-8edd-4c85-a48e-03b367765a36</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ca0df305-13b0-4256-80ef-baf5bd7f60c7</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="99~80" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>44bd2720-04bb-432e-aa0e-4de02ad8c533</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="119~100" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>3eeca8aa-a1dc-4090-9407-788589775761</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="139~120" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6dd5b880-8b69-4dd1-b9a9-f08465dddef9</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="159~140" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>ade175ee-b656-4699-b8b8-ddc54fcfd23a</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="179~160" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>46f24908-6ac6-4a50-a52f-ba90164f9805</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="199~180" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>c7b62485-f8f2-47d9-90d8-49c3ff3c0869</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="219~200" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>678f119d-8edd-4c85-a48e-03b367765a36</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="220~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="11~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="23~85" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="181~246" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="101~165" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="10~14" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="15~19" />
      <Function ID="4" Name="Col in Dark On" Display="'Col in Dark On'" Dmx="20~24" />
      <Function ID="5" Name="Col in Dark Off" Display="'Col in Dark Off'" Dmx="25~29" />
      <Function ID="6" Name="Gobo in Dark On" Display="'Gobo in Dark On'" Dmx="30~34" />
      <Function ID="7" Name="Gobo in Dark Off" Display="'Gobo in Dark Off'" Dmx="35~39" />
      <Function ID="8" Name="All in Dark on" Display="'All in Dark on'" Dmx="40~44" />
      <Function ID="9" Name="All in Dark Off" Display="'All in Dark Off'" Dmx="45~49" />
      <Function ID="10" Name="Reset P/T" Display="'Reset P/T'" Dmx="50~54" />
      <Function ID="11" Name="Reset Col" Display="'Reset Col'" Dmx="55~59" />
      <Function ID="12" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="60~64" />
      <Function ID="13" Name="Reset Shutter" Display="'Reset Shutter'" Dmx="65~69" />
      <Function ID="14" Name="Reset Focus" Display="'Reset Focus'" Dmx="70~74" />
      <Function ID="15" Name="Reset Prism" Display="'Reset Prism'" Dmx="75~79" />
      <Function ID="16" Name="Reset All" Display="'Reset All'" Dmx="80~89" />
      <Function ID="17" Name="Lamp Off" Display="'Lamp Off'" Dmx="112~119" />
      <Function ID="18" Name="Lamp On" Display="'Lamp On'" Dmx="120~127" />
      <Function ID="19" Name="Auto" Display="'Auto'" Dmx="130~192" />
      <Function ID="20" Name="Sound" Display="'Sound'" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="10~19" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="20~29" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="30~39" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="40~49" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="50~59" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="60~69" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="70~79" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="80~89" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="90~99" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="100~109" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="110~119" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="120~129" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="130~139" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="140~149" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="150~159" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="160~169" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="170~179" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="180~189" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="190~199" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="200~209" />
      <Function ID="22" Name="Effect 21" Display="'Effect 21'" Dmx="210~219" />
      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="220~229" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="230~239" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="240~249" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Prism_Func" Name="Prism Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Prism" Display="'Prism'" Dmx="0~0" Update="Prism" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Prism" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Prism" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Prism" ID="1,2" If="'Prism_Func'==1" />
      <Condition Name="Spin" ID="3,4" If="'Prism_Func'==2" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="240~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="16~239" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Advanced, 14 DMX" Channels="14">
    <Import PearlRef="CH_IntS250A" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="20fd4109-f239-4354-bc86-41fb69ad674c" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="8" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Effect" ChannelOffset="12" Wheel="24" />
      <Attribute ID="Prism_Func" Wheel="22" />
      <Attribute ID="Prism" ChannelOffset="13" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Basic, 10 DMX" Channels="10">
    <Import PearlRef="CH_IntS250B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b096a9b4-32ae-431b-8c8b-1f7a1f301ab3" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="5" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Prism_Func" Wheel="22" />
      <Attribute ID="Prism" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:18" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:17" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:10" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:11" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:12" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Shutter">
      <Set Channel="Control:13" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Focus">
      <Set Channel="Control:14" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Prism">
      <Set Channel="Control:15" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:16" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

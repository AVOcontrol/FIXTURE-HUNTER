  <History Date="14-04-17" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="08-06-17" Author="Nic Morris" Comment="Changed master fixture RGB to RGB Masters and locate at zero in attempt to fix bug report." Version="2" />
  <History Date="21-09-17" Author="Nic Morris" Comment="Created from Chauvet Maverick MK3 Wash" Version="3" />
  <History Date="22-09-17" Author="Nic Morris" Comment="Revised cell implementation." Version="4" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Fixed channel mapping error in Dual:Basic Movement, 13 DMX mode in response to customer bug report (dimmer was set to 16bit and LSB conflicted)" Version="5" />
  <History Date="31-12-17" Author="Nic Morris" Comment="Added product thumbnail.  Added compatibility for R20 export." Version="6" />
  <History Date="30-08-22" Author="Nic Morris" Comment="Inverted zoom in response to customer feedback (this is contrary to the documentation)." Version="7" />

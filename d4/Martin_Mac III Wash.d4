  <History Date="18-07-12" Author="Peter Budd" Comment="Created" />
  <History Date="02-08-12" Author="Peter Budd" Comment="Updated to spec" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Edited corrected Gobo 2 Func" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Edited corrected iris locate to 0%" />
  <History Date="28-01-13" Author="Peter Budd" Comment="Corrected Gobo function channels." />
  <History Date="16-04-13" Author="Peter Budd" Comment="Created from Mac Viper Profile" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="03-06-13" Author="Peter Budd" Comment="Created from Martin Mac Viper AirFX." />
  <History Date="03-06-13" Author="Peter Budd" Comment="Created from the Martin Mac Viper Wash DX." />
  <History Date="22-02-19" Author="Nic Morris" Comment="Changed name from Mac 3 Wash to Mac III Wash.  Added physical pan/tilt ranges." />
  <History Date="22-02-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Major overhaul." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8bdfe3da-a384-4a22-ba59-42fb1689e54f" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~50" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="124~110" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="84~70" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse    %.f%%',0~100" Dmx="104~90" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pulse" Display="'Rnd Op Pulse  %.f%%',0~100" Dmx="144~130" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pulse" Display="'Rnd Cl Pulse  %.f%%',0~100" Dmx="164~150" Intensity="0~0" />
      <Function ID="9" Name="Burst Pulse" Display="'Burst Pulse   %.f%%',0~100" Dmx="184~170" Intensity="0~0" />
      <Function ID="10" Name="Rnd Bst Pls" Display="'Rnd Bst Pls %.f%%',0~100" Dmx="204~190" Intensity="0~0" />
      <Function ID="11" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="224~210" Intensity="0~0" />
      <Function ID="12" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="244~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Rnd CMY Fast" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
      <Function ID="2" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Rnd CMY Fast" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
      <Function ID="2" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Condition Name="Rnd CMY Fast" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
      <Function ID="2" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:6000" PowerOn="1:6000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',3200~6000" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="21,22,23,24" If="'Colour1Func'==4" />
      <Else ID="25" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="185~188" WheelPosition="1" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="181~184" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="177~180" WheelPosition="3" Colour="255,128,0" />
      <Function ID="5" Name="Minus Green" Display="'Minus Green'" Dmx="173~176" WheelPosition="4" Colour="255,195,210" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="169~172" WheelPosition="5" Colour="255,255,0" />
      <Function ID="7" Name="Congo" Display="'Congo'" Dmx="165~168" WheelPosition="6" Colour="0,0,180" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="161~164" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op - Blu" Display="'Op - Blu %.f%%',0~100" Dmx="0~20" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Blu - Grn" Display="'Blu - Grn %.f%%',0~100" Dmx="20~40" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="40~60" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Org - MG" Display="'Org - MG %.f%%',0~100" Dmx="60~80" WheelPosition="3" Colour="255,128,0" />
      <Function ID="13" Name="MG - Yel" Display="'MG - Yel %.f%%',0~100" Dmx="80~100" WheelPosition="4" Colour="255,195,210" />
      <Function ID="14" Name="Yel - Cgo" Display="'Yel - Cgo %.f%%',0~100" Dmx="100~120" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="Cgo - Rd" Display="'Cgo - Rd %.f%%',0~100" Dmx="120~140" WheelPosition="6" Colour="0,0,180" />
      <Function ID="16" Name="Rd - Op" Display="'Rd - Op %.f%%',0~100" Dmx="140~160" WheelPosition="7" Colour="255,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~214" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="215~221" Colour="0,0,0" />
      <Function ID="20" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="22" Name="Slow" Display="'Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="23" Name="Medium" Display="'Medium'" Dmx="248~251" Colour="0,0,0" />
      <Function ID="24" Name="Fast" Display="'Fast'" Dmx="244~247" Colour="0,0,0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="C/CMY/Gobo" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Col Shake" Display="'Col Shake %.f%%',0~100" Dmx="57~19" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="3" Name="Rnd CMY Fast" Display="'Rnd CMY Fast'" Dmx="58~83" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="4" Name="Rnd CMY Medium" Display="'Rnd CMY Medium'" Dmx="84~109" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="5" Name="Rnd CMY Slow" Display="'Rnd CMY Slow'" Dmx="110~135" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="6" Name="Store Cal" Display="'Store Cal'" Dmx="5~10" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="200~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="229~216" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse    %.f%%',0~100" Dmx="243~230" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Rnd Op Pulse" Display="'Rnd Op Pulse  %.f%%',0~100" Dmx="249~244" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Rnd Cl Pulse" Display="'Rnd Cl Pulse  %.f%%',0~100" Dmx="255~250" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:33" PowerOn="1:33" />
      <Function ID="1" Name="Zoom" Display="'%.1f°',11.0~55.0" Dmx="65535~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Reset Intensity" Display="'Reset Intensity'" Dmx="15~19" />
      <Function ID="4" Name="Reset Colour" Display="'Reset Colour'" Dmx="20~24" />
      <Function ID="5" Name="Reset Barndoor" Display="'Reset Barndoor'" Dmx="25~29" />
      <Function ID="6" Name="Reset Beam" Display="'Reset Beam'" Dmx="30~34" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="35~39" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="45~49" />
      <Function ID="9" Name="Lamp Off" Display="'Lamp Off'" Dmx="50~54" />
      <Function ID="10" Name="Store Cal" Display="'Store Cal'" Dmx="55~59" />
      <Function ID="11" Name="Dim Linear" Display="'Dim Linear'" Dmx="60~64" />
      <Function ID="12" Name="Dim Square" Display="'Dim Square'" Dmx="65~69" />
      <Function ID="13" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="70~74" />
      <Function ID="14" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="75~79" />
      <Function ID="15" Name="P/T Normal" Display="'P/T Normal'" Dmx="85~89" />
      <Function ID="16" Name="P/T Fast" Display="'P/T Fast'" Dmx="90~94" />
      <Function ID="17" Name="P/T Slow" Display="'P/T Slow'" Dmx="95~99" />
      <Function ID="18" Name="Param Shortcut On" Display="'Param Shortcut On'" Dmx="140~144" />
      <Function ID="19" Name="Param Shortcut Off" Display="'Param Shortcut Off'" Dmx="145~149" />
      <Function ID="20" Name="AutoFocus Off" Display="'AutoFocus Off'" Dmx="155~159" />
      <Function ID="21" Name="Ballast 100%" Display="'Ballast 100%'" Dmx="195~199" />
      <Function ID="22" Name="Ballast 90%" Display="'Ballast 90%'" Dmx="200~204" />
      <Function ID="23" Name="Ballast 80%" Display="'Ballast 80%'" Dmx="205~209" />
      <Function ID="24" Name="Ballast 70%" Display="'Ballast 70%'" Dmx="210~214" />
      <Function ID="25" Name="Ballast 60%" Display="'Ballast 60%'" Dmx="215~219" />
      <Function ID="26" Name="Display On" Display="'Display On'" Dmx="235~239" />
      <Function ID="27" Name="Display Off" Display="'Display Off'" Dmx="240~244" />
    </Attribute>
    <Attribute ID="FAControl" Name="Fix Adj/Cal" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Enable P/T Limit" Display="'Enable P/T Limit'" Dmx="40~44" />
      <Function ID="3" Name="Disable P/T Limit" Display="'Disable P/T Limit'" Dmx="50~54" />
      <Function ID="4" Name="P/T Inside Limit" Display="'P/T Inside Limit'" Dmx="60~64" />
      <Function ID="5" Name="P/T Outside Limit" Display="'P/T Outside Limit'" Dmx="70~74" />
      <Function ID="6" Name="Store Pan Low Limit" Display="'Store Pan Low Limit'" Dmx="80~84" />
      <Function ID="7" Name="Store Pan High Limit" Display="'Store Pan High Limit'" Dmx="85~89" />
      <Function ID="8" Name="Store Tilt Low Limit" Display="'Store Tilt Low Limit'" Dmx="95~99" />
      <Function ID="9" Name="Store Tilt High Limit" Display="'Store Tilt High Limit'" Dmx="100~104" />
      <Function ID="10" Name="Reset P/T Limit" Display="'Reset P/T Limit'" Dmx="110~114" />
      <Function ID="11" Name="Store Dim Cal" Display="'Store Dim Cal'" Dmx="125~129" />
      <Function ID="12" Name="Store Cyan Cal" Display="'Store Cyan Cal'" Dmx="130~134" />
      <Function ID="13" Name="Store Magenta Cal" Display="'Store Magenta Cal'" Dmx="135~139" />
      <Function ID="14" Name="Store Yellow Cal" Display="'Store Yellow Cal'" Dmx="140~144" />
      <Function ID="15" Name="Store CTO Cal" Display="'Store CTO Cal'" Dmx="145~149" />
      <Function ID="16" Name="Store CMYC Cal" Display="'Store CMYC Cal'" Dmx="150~154" />
      <Function ID="17" Name="Store Barndoor Cal" Display="'Store Barndoor Cal'" Dmx="210~214" />
      <Function ID="18" Name="Store Iris Cal" Display="'Store Iris Cal'" Dmx="215~219" />
      <Function ID="19" Name="Store Focus Cal" Display="'Store Focus Cal'" Dmx="220~224" />
      <Function ID="20" Name="Store Zoom Cal" Display="'Store Zoom Cal'" Dmx="225~229" />
      <Function ID="21" Name="Store Pan Cal" Display="'Store Pan Cal'" Dmx="230~234" />
      <Function ID="22" Name="Store Tilt Cal" Display="'Store Tilt Cal'" Dmx="235~239" />
      <Function ID="23" Name="Reset All Cal" Display="'Reset All Cal'" Dmx="245~249" />
    </Attribute>
    <Attribute ID="Barndoor_1" Name="Barndoor 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Barndoor_Rot" Name="Barndoor Rot" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-10° -&gt; -1°" Display="'-10° -&gt; -1° %.1f°',-10.0~-1.0" Dmx="0~22" />
      <Function ID="2" Name="0° (Vertical)" Display="'0° (Vertical)'" Dmx="23~23" />
      <Function ID="3" Name="+1° -&gt; +89°" Display="'+1° -&gt; +89° %.1f°',1.0~89.0" Dmx="24~230" />
      <Function ID="4" Name="+90° (Horizontal)" Display="'+90° (Horizontal)'" Dmx="231~231" />
      <Function ID="5" Name="+91° -&gt; +100°" Display="'+91° -&gt; +100° %.f°',91~100" Dmx="232~255" />
    </Attribute>
    <Attribute ID="Barndoor_2" Name="Barndoor 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="21 DMX" Channels="21">
    <Import PearlRef="MT_Mac3Wash" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="268" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f8209dd1-3576-460d-acb1-a32933201c07" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2,3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="16,17" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="18,19" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="6" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="C/CMY/Gobo" ChannelOffset="9" Wheel="37" />
      <Attribute ID="Iris" ChannelOffset="10" Wheel="21" />
      <Attribute ID="Barndoor_1" ChannelOffset="11" Wheel="49" />
      <Attribute ID="Barndoor_Rot" ChannelOffset="13" Wheel="51" />
      <Attribute ID="Focus" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Zoom" ChannelOffset="15" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
      <Attribute ID="FAControl" ChannelOffset="21" Wheel="29" />
      <Attribute ID="Barndoor_2" ChannelOffset="12" Wheel="50" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:9,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Intensity">
      <Set Channel="Control:3,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:4,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Barndoor">
      <Set Channel="Control:5,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Beam">
      <Set Channel="Control:6,Colour1Func:2,Colour1:10:0" Delay="6000" />
      <Set Channel="Control:1,Colour1Func:1,Colour1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:7,Colour1Func:2,Colour1:10:0" Delay="6000" />

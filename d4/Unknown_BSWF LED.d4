      <Condition Name="Prism Spin" ID="3,4,5,6" If="'Prism'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Reserved11" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved12" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.2f%%',0.00~100.00" Dmx="49087~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.2f%%',0.00~100.00" Dmx="49344~56283" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.2f%%',100.00~0.00" Dmx="56540~63479" />
      <Function ID="4" Name="Closed" Display="'Closed %.2f%%',0.00~100.00" Dmx="63736~65535" />

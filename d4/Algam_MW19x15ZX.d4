      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="12~13" Colour="128,0,255" />
      <Function ID="8" Name="Light Pink" Display="'Light Pink'" Dmx="14~15" Colour="255,200,200" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="16~17" Colour="0,0,255" />
      <Function ID="10" Name="Cyan" Display="'Cyan'" Dmx="18~19" Colour="0,255,255" />
      <Function ID="11" Name="Cold White" Display="'Cold White'" Dmx="20~21" Colour="230,230,255" />
      <Function ID="12" Name="Cold White (repeated)" Display="'Cold White (repeated)'" Dmx="22~23" Colour="230,230,255" />
      <Function ID="13" Name="LED Jump Mode" Display="'LED Jump Mode'" Dmx="24~25" Colour="255,255,255" />
      <Function ID="14" Name="LED Gradient Mode" Display="'LED Gradient Mode'" Dmx="26~27" Colour="255,255,255" />
      <Function ID="15" Name="LED Pulse Mode" Display="'LED Pulse Mode'" Dmx="28~29" Colour="255,255,255" />
      <Function ID="16" Name="Effect Mode Sel" Display="'Effect Mode Sel %.1f%%',0.0~100.0" Dmx="30~251" Colour="255,255,255" />
      <Function ID="17" Name="LED Random Mode" Display="'LED Random Mode'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Aura Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Aura Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Aura Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Beam Strobe" Display="'Beam Strobe %.f%%',0~100" Dmx="6~85" />
      <Function ID="3" Name="Beam Rnd" Display="'Beam Rnd %.f%%',0~100" Dmx="86~90" />
      <Function ID="4" Name="Aura Strobe" Display="'Aura Strobe %.f%%',0~100" Dmx="91~170" />
      <Function ID="5" Name="Aura Rnd" Display="'Aura Rnd %.f%%',0~100" Dmx="171~175" />
      <Function ID="6" Name="Bm+Aura Strobe" Display="'Bm+Aura Strobe %.f%%',0~100" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Beam_Strobe" Name="Beam Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~128" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="129~171" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="172~214" />
      <Function ID="5" Name="Spikes" Display="'Spikes %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Aura_Strobe" Name="Aura Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="50~200" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Beam_Effect" Name="Beam Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up %.f%%',0~100" Dmx="11~90" />
      <Function ID="3" Name="Ramp Dn" Display="'Ramp Dn %.f%%',0~100" Dmx="91~170" />
      <Function ID="4" Name="Ramp Up/Dn" Display="'Ramp Up/Dn %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Aura_Effect" Name="Aura Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Ramp" Display="'Ramp %.f%%',0~100" Dmx="11~90" />
      <Function ID="3" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="91~170" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="0~126" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2000K" Display="'2000K'" Dmx="16~45" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="46~85" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="86~125" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="126~165" Colour="255,255,255" />
      <Function ID="6" Name="7200K" Display="'7200K'" Dmx="166~205" Colour="255,255,255" />
      <Function ID="7" Name="11000K" Display="'11000K'" Dmx="206~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

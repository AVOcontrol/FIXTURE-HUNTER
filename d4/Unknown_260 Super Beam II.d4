    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="200~209" />
      <Function ID="4" Name="Effect Reduction" Display="'Effect Reduction'" Dmx="210~219" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="220~229" />
      <Function ID="6" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>

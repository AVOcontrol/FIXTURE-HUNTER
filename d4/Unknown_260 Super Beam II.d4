      <Function ID="3" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="70~114" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="115~159" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">

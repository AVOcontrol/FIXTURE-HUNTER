  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2dc2d9e6-af68-4f75-98dd-e5213f2514ac" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.1fms',1.0~85.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Dimmer Timing" Display="'Dimmer Timing %.fms',4000~100" Dmx="250~0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="RDM Disabled" Display="'RDM Disabled'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2200" PowerOn="1:2200" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2200~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Balance" Name="Balance" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="DS" Display="'DS'" Dmx="0~0" />
      <Function ID="2" Name="DS-&gt;DS+US" Display="'DS-&gt;DS+US %.1f%%',0.0~100.0" Dmx="1~127" />
      <Function ID="3" Name="DS+US" Display="'DS+US'" Dmx="128~128" />
      <Function ID="4" Name="DS+US-&gt;US" Display="'DS+US-&gt;US %.1f%%',0.0~100.0" Dmx="129~254" />
      <Function ID="5" Name="US" Display="'US'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Blue_Position" Name="Blue Position" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Position" Display="'No Position'" Dmx="0~0" />
      <Function ID="2" Name="A/B" Display="'A/B'" Dmx="11~20" />
      <Function ID="3" Name="B" Display="'B'" Dmx="21~30" />

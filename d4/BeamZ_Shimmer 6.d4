<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Shimmer 6" ShortName="Shimmer 6" Company="BeamZ" Version="2">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="08-09-25" Author="Nic Morris" Comment="Created (poor documentation)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Magic_Ball_Col" Name="Magic Ball Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~15" Colour="0,0,0" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="16~29" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~43" Colour="0,0,0" />
      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="44~57" Colour="0,0,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="58~71" Colour="0,0,0" />
      <Function ID="7" Name="B+W" Display="'B+W'" Dmx="72~85" Colour="0,0,0" />
      <Function ID="8" Name="White" Display="'White'" Dmx="86~99" Colour="0,0,0" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="100~113" Colour="0,0,0" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="114~127" Colour="0,0,0" />
      <Function ID="11" Name="R+B" Display="'R+B'" Dmx="128~141" Colour="0,0,0" />
      <Function ID="12" Name="G+B+W" Display="'G+B+W'" Dmx="142~155" Colour="0,0,0" />
      <Function ID="13" Name="R+G+B" Display="'R+G+B'" Dmx="156~169" Colour="0,0,0" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="170~183" Colour="0,0,0" />
      <Function ID="15" Name="R+G+W" Display="'R+G+W'" Dmx="184~197" Colour="0,0,0" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="198~209" Colour="0,0,0" />
      <Function ID="17" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="210~250" Colour="0,0,0" />
      <Function ID="18" Name="Strobe" Display="'Strobe'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magic_Ball_Rot" Name="Magic Ball Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pattern_Col" Name="Pattern Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~15" Colour="0,0,0" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="16~29" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~43" Colour="0,0,0" />
      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="44~57" Colour="0,0,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="58~71" Colour="0,0,0" />
      <Function ID="7" Name="B+W" Display="'B+W'" Dmx="72~85" Colour="0,0,0" />
      <Function ID="8" Name="White" Display="'White'" Dmx="86~99" Colour="0,0,0" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="100~113" Colour="0,0,0" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="114~127" Colour="0,0,0" />
      <Function ID="11" Name="R+B" Display="'R+B'" Dmx="128~141" Colour="0,0,0" />
      <Function ID="12" Name="G+B+W" Display="'G+B+W'" Dmx="142~155" Colour="0,0,0" />
      <Function ID="13" Name="R+G+B" Display="'R+G+B'" Dmx="156~169" Colour="0,0,0" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="170~183" Colour="0,0,0" />
      <Function ID="15" Name="R+G+W" Display="'R+G+W'" Dmx="184~197" Colour="0,0,0" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="198~209" Colour="0,0,0" />
      <Function ID="17" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="210~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pattern_Rot" Name="Pattern Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Laser_Col" Name="Laser Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="3~63" Colour="0,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~127" Colour="0,0,0" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="128~191" Colour="0,0,0" />
      <Function ID="5" Name="Red+Green Alternate" Display="'Red+Green Alternate %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="16~75" />
      <Function ID="3" Name="Gradient" Display="'Gradient %.f%%',0~100" Dmx="76~135" />
      <Function ID="4" Name="Chromatin Change" Display="'Chromatin Change %.f%%',0~100" Dmx="136~195" />
      <Function ID="5" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~110" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="111~210" />
      <Function ID="4" Name="Sound 1" Display="'Sound 1'" Dmx="211~235" />
      <Function ID="5" Name="Sound 2" Display="'Sound 2'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16" Id="5cdeeeb9-ddef-486a-bc02-2eb4b9601c57">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
        <Attribute ID="Magic_Ball_Col" ChannelOffset="4" Wheel="7" />
        <Attribute ID="Magic_Ball_Rot" ChannelOffset="5" Wheel="19" />
        <Attribute ID="Pattern_Col" ChannelOffset="6" Wheel="8" />
        <Attribute ID="Pattern_Rot" ChannelOffset="7" Wheel="20" />
        <Attribute ID="Laser_Col" ChannelOffset="8" Wheel="9" />
        <Attribute ID="Laser_Rot" ChannelOffset="9" Wheel="21" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Auto" ChannelOffset="14" Wheel="22" />
        <Attribute ID="Program" ChannelOffset="15" Wheel="23" />
        <Attribute ID="Program_Spd" ChannelOffset="16" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="White Strobe" ChannelOffset="1" ModeLink="Dim cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Purple Strobe" ChannelOffset="2" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="RGBW" ChannelOffset="10" ModeLink="RGBW cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dim cell" Channels="1" Hidden="True" Id="563d4669-fa6e-4985-bbfc-b4aa483d4175">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="RGBW cell" Channels="4" Hidden="True" Id="c6232763-590a-4cde-84a9-2261db695c73">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Legend="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Legend="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Legend="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

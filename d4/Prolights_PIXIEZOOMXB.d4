      <Function ID="30" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="31" Name="Effect 2" Display="'Effect 2'" Dmx="61~110" Colour="255,255,255" />
      <Function ID="32" Name="Effect 3" Display="'Effect 3'" Dmx="111~160" Colour="255,255,255" />
      <Function ID="33" Name="Effect 4" Display="'Effect 4'" Dmx="161~210" Colour="255,255,255" />
      <Function ID="34" Name="Effect 5 (1-4)" Display="'Effect 5 (1-4)'" Dmx="211~255" Colour="255,255,255" />

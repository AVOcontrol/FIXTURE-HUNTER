    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="-25" Display="'-25 %.1f%%',-25.0~0.0" Dmx="0~127" Colour="255,255,255" />

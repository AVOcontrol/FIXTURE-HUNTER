    <Attribute ID="Auto_Spd" Name="Effect Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Hue" ID="2" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Hue" Display="'%.1f°',-25.0~25.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">

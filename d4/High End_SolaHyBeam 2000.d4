<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SolaHyBeam 2000" ShortName="SolaHyBm2K" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>705b6d83-8996-4793-8187-b617ed940e6e</Thumbnail>
  <History Date="01-02-15" Author="Nic Morris" Comment="Created" />
  <History Date="30-03-15" Author="Nic Morris" Comment="Added missing prism function ranges and removed animation functions in response to customer bug report." />
  <History Date="30-03-15" Author="Nic Morris" Comment="Revised blades in line with latest documentation in response to customer bug report." />
  <History Date="30-03-15" Author="Nic Morris" Comment="Revised animation functions in line with latest documentation in response to customer bug report." />
  <History Date="19-09-15" Author="Nic Morris" Comment="Revised blades against actual fixture." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Revised fixed colour function names against physical fixture." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Added stop function to animation in line with latest spec (1.0.7)" />
  <History Date="27-09-15" Author="Nic Morris" Comment="Updated control functions and macros to latest spec (1.0.7)" />
  <History Date="02-12-15" Author="Nic Morris" Comment="Increased macro delay and tested with actual fixture." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed Blade All Rot to a single range for Attribute Editor compatibility." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Added gobo names.  Moved indigo into cell for HTP control." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed AutoFocus to 8bit and added separate AutoFocus Adj control." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Changed indigo func to default at independent dimmer." />
  <History Date="25-07-17" Author="Nic Morris" Comment="Fixed CMY random condition.  Shortened Gobo 1 Rot Func name to comply with 14char limit." />
  <History Date="26-01-18" Author="Nic Morris" Comment="Created from High End SolaSpot Pro 1500 (identical - no gobo images available)" />
  <History Date="21-02-18" Author="Nic Morris" Comment="Created from High End SolaFrame 2000" />
  <History Date="14-04-19" Author="Nic Morris" Comment="Created from High End SolaFrame 750 (note documentation contains errors.  gobo slot 7 name differs between charts and data sheet with images)" />
  <History Date="15-04-19" Author="Nic Morris" Comment="Corrected gobo ranges." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="19538" ModelID="1406" />

  <Control>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',3200~6400" Dmx="1~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Square" Display="'Square'" Dmx="21~40" />
      <Function ID="3" Name="Inv Square" Display="'Inv Square'" Dmx="41~60" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="61~80" />
      <Function ID="5" Name="Preset" Display="'Preset'" Dmx="81~255" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="900Hz" Display="'900Hz'" Dmx="16~40" />
      <Function ID="3" Name="1000Hz" Display="'1000Hz'" Dmx="41~65" />
      <Function ID="4" Name="1200Hz" Display="'1200Hz'" Dmx="66~90" />
      <Function ID="5" Name="1500Hz" Display="'1500Hz'" Dmx="91~115" />
      <Function ID="6" Name="2500Hz" Display="'2500Hz'" Dmx="116~140" />
      <Function ID="7" Name="4000Hz" Display="'4000Hz'" Dmx="141~165" />
      <Function ID="8" Name="5000Hz" Display="'5000Hz'" Dmx="166~190" />
      <Function ID="9" Name="10kHz" Display="'10kHz'" Dmx="191~215" />
      <Function ID="10" Name="15kHz" Display="'15kHz'" Dmx="216~240" />
      <Function ID="11" Name="20kHz" Display="'20kHz'" Dmx="241~255" />
    </Attribute>
  </Control>

      <Attribute ID="Speed" ChannelOffset="8" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="16-Bit, 13 DMX" Channels="13">
    <Import PearlRef="HE_IBeamHi" DiamondRef="IBeam_HiRes" WysiwygRef="" />
    <Physical>
      <Bulb Type="MSD 250/2" Lumens="4000" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="19" />
      <Size Height="0.241" Width="0.323" Depth="0.825" />
      <Focus Type="Mirror" PanMax="180" TiltMax="95" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />

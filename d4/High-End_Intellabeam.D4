  <RDM>
    <Device ManufacturerID="19538" ModelID="0" />
  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="12:0" Lowlight="8:0" />
      <Function ID="1" Name="Open" Display="'Open %.f%%',0~100" Dmx="0~20" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink %.f%%',0~100" Dmx="23~41" Colour="255,150,150" />
      <Function ID="3" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="46~59" Colour="255,0,255" />
      <Function ID="4" Name="Deep Red" Display="'Deep Red %.f%%',0~100" Dmx="64~82" Colour="180,0,0" />
      <Function ID="5" Name="Light Red" Display="'Light Red %.f%%',0~100" Dmx="89~105" Colour="255,100,100" />
      <Function ID="6" Name="Cyan" Display="'Cyan %.f%%',0~100" Dmx="112~122" Colour="0,255,255" />
      <Function ID="7" Name="Dark Blue" Display="'Deep Blue %.f%%',0~100" Dmx="130~148" Colour="0,0,180" />
      <Function ID="8" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="153~168" Colour="0,0,255" />
      <Function ID="9" Name="Light Blue" Display="'Light Blue %.f%%',0~100" Dmx="173~189" Colour="0,128,255" />
      <Function ID="10" Name="Deep Cyan" Display="'Deep Cyan %.f%%',0~100" Dmx="194~214" Colour="0,180,180" />
      <Function ID="11" Name="Green" Display="'Green %.f%%',0~100" Dmx="217~232" Colour="0,255,0" />
      <Function ID="12" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="240~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="ColMode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~54" Colour="255,255,255" />
      <Function ID="2" Name="Shake Big" Display="'Shake Big'" Dmx="71~89" Colour="0,0,0" />
      <Function ID="3" Name="Shake Small" Display="'Shake Small'" Dmx="102~122" Colour="0,0,0" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="128~153" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="163~186" Colour="0,0,0" />
      <Function ID="6" Name="Split" Display="'Split'" Dmx="194~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="22~22" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="44~44" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="66~66" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="88~88" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="110~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="132~132" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="154~154" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="176~176" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="185~185" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="198~198" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="220~220" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="GoboMode" Name="Gobo Mode" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~61" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake Med" Display="'Shake Med'" Dmx="64~92" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Fast" Display="'Shake Fast'" Dmx="99~125" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="133~148" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="166~186" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Shake Slow" Display="'Shake Slow'" Dmx="194~222" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Shake Fast" Display="'Shake Fast'" Dmx="224~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~13" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="15~209" Intensity="0~0" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="214~230" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="242~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.f%%',0~100" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Home" Name="Home" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Home" Display="'%.f%%',0~100" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8-Bit, 8 DMX" Channels="8">
    <Import PearlRef="HE_IBeam_8" DiamondRef="IBeam_8" WysiwygRef="" />

    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="32~47" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~63" Colour="0,255,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="64~79" Colour="255,128,0" />
      <Function ID="6" Name="CTO" Display="'CTO'" Dmx="80~95" Colour="255,240,200" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="96~111" Colour="230,230,255" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="112~127" Colour="180,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~187" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="188~193" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

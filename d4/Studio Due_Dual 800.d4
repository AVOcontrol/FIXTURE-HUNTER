<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dual 800" ShortName="SD_Dual800" Company="Studio Due">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>ca04f4a3-7021-4ff3-8ca8-3badf65a22f8</Thumbnail>
  <History Date="23-06-14" Author="Stephen harris" Comment="Created" />
  <History Date="25-06-14" Author="Peter Budd" Comment="Checked" />
  <History Date="28-06-14" Author="Nic Morris" Comment="Fixed 8 DMX channel mapping.  Fixed dimmer resolution and DMX range." />
  <History Date="28-06-14" Author="Nic Morris" Comment="Changed colour function from scroll to index.  Changed colour index wheel display from value 1dp to percentage 1dp." />
  <History Date="28-06-14" Author="Nic Morris" Comment="Reordered shutter and changed to locate at open.  Changed function names from hz to % to match wheel display." />
  <History Date="28-06-14" Author="Nic Morris" Comment="Updated power on to locate values.  Changed LED fade time to 'Speed' and standardised attribute ID." />
  <History Date="28-06-14" Author="Nic Morris" Comment="Added compatibility for r20 export." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-08-18" Author="Nic Morris" Comment="Added product thumbnail.  Added missing Atlabase ID to 4 DMX mode.  Added vdim to 13 DMX mode cells." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6925663e-0746-4c47-8045-9d3cb2628b6e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~127" Intensity="0~0" />
      <Function ID="3" Name="Rainbow" Display="'Rainbow %.1f%%',0.0~100.0" Dmx="128~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

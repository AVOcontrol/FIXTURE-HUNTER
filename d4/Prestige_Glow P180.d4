<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Glow P180" ShortName="Glow P180" Company="Prestige">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="10-10-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3000K" Display="'3000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="1~13" Colour="255,255,255" />
      <Function ID="3" Name="3400K" Display="'3400K'" Dmx="14~27" Colour="255,255,255" />
      <Function ID="4" Name="3600K" Display="'3600K'" Dmx="28~41" Colour="255,255,255" />
      <Function ID="5" Name="3800K" Display="'3800K'" Dmx="42~55" Colour="255,255,255" />
      <Function ID="6" Name="4000K" Display="'4000K'" Dmx="56~69" Colour="255,255,255" />
      <Function ID="7" Name="4200K" Display="'4200K'" Dmx="70~83" Colour="255,255,255" />
      <Function ID="8" Name="4400K" Display="'4400K'" Dmx="84~97" Colour="255,255,255" />
      <Function ID="9" Name="4600K" Display="'4600K'" Dmx="98~111" Colour="255,255,255" />
      <Function ID="10" Name="4800K" Display="'4800K'" Dmx="112~125" Colour="255,255,255" />
      <Function ID="11" Name="5000K" Display="'5000K'" Dmx="126~139" Colour="255,255,255" />
      <Function ID="12" Name="5200K" Display="'5200K'" Dmx="140~153" Colour="255,255,255" />
      <Function ID="13" Name="5400K" Display="'5400K'" Dmx="154~167" Colour="255,255,255" />
      <Function ID="14" Name="5600K" Display="'5600K'" Dmx="168~181" Colour="255,255,255" />
      <Function ID="15" Name="5800K" Display="'5800K'" Dmx="182~195" Colour="255,255,255" />
      <Function ID="16" Name="6000K" Display="'6000K'" Dmx="196~209" Colour="255,255,255" />
      <Function ID="17" Name="6200K" Display="'6200K'" Dmx="210~223" Colour="255,255,255" />
      <Function ID="18" Name="6400K" Display="'6400K'" Dmx="224~237" Colour="255,255,255" />
      <Function ID="19" Name="6600K" Display="'6600K'" Dmx="238~251" Colour="255,255,255" />
      <Function ID="20" Name="6800K" Display="'6800K'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" />
      <Function ID="5" Name="Fade" Display="'Fade'" Dmx="128~159" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="160~191" />
      <Function ID="7" Name="CTC" Display="'CTC'" Dmx="192~223" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~5" />
      <Function ID="2" Name="Curve 0" Display="'Curve 0'" Dmx="6~55" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="56~105" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="106~155" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="156~205" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKPS1801" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="CTO" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKPS1802" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="UKPS1807" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Effect" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="7" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
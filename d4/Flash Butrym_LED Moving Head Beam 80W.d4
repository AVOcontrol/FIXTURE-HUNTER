      <Function ID="20" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="182~184" WheelPosition="9" Colour="255,120,255" />
      <Function ID="21" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~130" Colour="0,0,0" />
      <Function ID="22" Name="No Scroll" Display="'No Scroll'" Dmx="220~224" Colour="0,0,0" />
      <Function ID="23" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="249~225" Colour="0,0,0" />
      <Function ID="24" Name="No Scroll" Display="'No Scroll'" Dmx="220~224" Colour="0,0,0" />
      <Function ID="25" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="219~195" Colour="0,0,0" />

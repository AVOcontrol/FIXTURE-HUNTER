      <Function ID="11" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="128~130" WheelPosition="0" Colour="255,255,255" />
      <Function ID="12" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="134~136" WheelPosition="1" Colour="255,0,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="140~142" WheelPosition="2" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="146~148" WheelPosition="3" Colour="0,0,255" />
      <Function ID="15" Name="Yel/ Org" Display="'Yel/ Org'" Dmx="152~154" WheelPosition="4" Colour="255,255,0" />

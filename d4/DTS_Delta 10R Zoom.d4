      <Attribute ID="Amber" ChannelOffset="13" Wheel="40" />
      <Attribute ID="White" ChannelOffset="14" Wheel="41" />
      <Attribute ID="CTO" ChannelOffset="15" Wheel="42" />
      <Attribute ID="Colour_Macro" ChannelOffset="16" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="18" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Reserved1" ChannelOffset="6" Wheel="29" />
      <Attribute ID="Reserved2" ChannelOffset="7" Wheel="30" />
      <Attribute ID="Macro" ChannelOffset="17" Wheel="27" />
      <Attribute ID="Zoom_Speed" ChannelOffset="19" Wheel="26" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />
    </Include>

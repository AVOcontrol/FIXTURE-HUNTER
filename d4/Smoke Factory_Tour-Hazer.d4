<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Tour-Hazer" ShortName="Tour-Hazer" Company="Smoke Factory">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="16-10-06" Author="D.Milligan" Comment="Created" />
  <History Date="22-04-14" Author="Nic Morris" Comment="Removed conditionals from Fan to simplify.  Added HTP version in response to customer bug report." />
  <History Date="22-04-14" Author="Nic Morris" Comment="Revised wheel mappings to match attribute groups." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="29-08-18" Author="Nic Morris" Comment="Removed Atlabase ID's (largely irrelevant as can't simulate anyway but was linked to v2 model)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pump" Name="Level" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Level" Display="'Level %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Level" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pump" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="2 DMX, HTP" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Fan" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
</Fixture>
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~199" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="200~239" />
      <Function ID="4" Name="Fast" Display="'Fast'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Jump" Display="'Jump'" Dmx="5~29" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="30~54" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1'" Dmx="55~74" />
      <Function ID="5" Name="Macro 2" Display="'Macro 2'" Dmx="75~94" />
      <Function ID="6" Name="Macro 3" Display="'Macro 3'" Dmx="95~114" />
      <Function ID="7" Name="Macro 4" Display="'Macro 4'" Dmx="115~134" />
      <Function ID="8" Name="Macro 5" Display="'Macro 5'" Dmx="135~154" />
      <Function ID="9" Name="Macro 6" Display="'Macro 6'" Dmx="155~174" />
      <Function ID="10" Name="Macro 7" Display="'Macro 7'" Dmx="175~194" />
      <Function ID="11" Name="Macro 8" Display="'Macro 8'" Dmx="195~214" />
      <Function ID="12" Name="Macro 9" Display="'Macro 9'" Dmx="215~234" />
      <Function ID="13" Name="Macro 10" Display="'Macro 10'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Macro_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LED_Colour" Name="LED Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="29~29" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~59" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~89" Colour="0,0,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="90~119" Colour="255,255,255" />
      <Function ID="6" Name="RB" Display="'RB'" Dmx="120~149" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="150~179" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="180~209" Colour="255,255,255" />
      <Function ID="9" Name="Random" Display="'Random'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto/Sound" Name="Auto/Sound" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="5~127" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Condition Name="Index" ID="29" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="30,31,32,33" If="'Colour1Func'==4" />
      <Else ID="34" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~11" WheelPosition="1" Colour="255,0,0" />

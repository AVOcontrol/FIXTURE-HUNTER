<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RevEAL Studio" ShortName="RevEAL Std" Company="Prism Projection Inc">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <Thumbnail>45ce4e18-6d0f-4691-85d4-78d95b0e46ea</Thumbnail>
  <History Date="23-03-12" Author="Peter Budd" Comment="Created" />
  <History Date="23-03-12" Author="Peter Budd" Comment="Created from Reveal CW" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added product thumbnail." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Removed vdim from non-RGB modes that don't have an intensity control (simply controlling all the attributes together is never going to work!)" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Increased wheel resolution.  Changed dimmer to 16bit for vdim compatibility.  Changed control and CTO to 8bit." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Removed Atlabase model ID (currently only one single channel mode)" />
  <History Date="17-12-17" Author="Nic Morris" Comment="Fixed numerous mapping errors.  Removed CTO from virtual controllers where applicable." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added RGB to virtual dimmer where it wasn't.  What a mess!" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CIE Colours" ID="2" If="'Control'==1" />
      <Condition Name="HSV Colours" ID="3" If="'Control'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="X" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="CIE Colours" ID="2" If="'Control'==1" />
      <Condition Name="HSV Colours" ID="3" If="'Control'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Y" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="CIE Colours" ID="2" If="'Control'==1" />
      <Condition Name="HSV Colours" ID="3" If="'Control'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
      <Function ID="2" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="3" Name="Reserved" Display="'Reserved %.f',0~255" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ECO" Name="ECO" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Fan Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="X" Name="X" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Y" Name="Y" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CIE Colours" Display="'CIE Colours'" Dmx="0~0" Update="Red, Green, Blue" />
      <Function ID="2" Name="RGB Colours" Display="'RGB Colours'" Dmx="102~153" Update="Red, Green, Blue" />
      <Function ID="3" Name="HSV Colours" Display="'HSV Colours'" Dmx="204~255" Update="Red, Green, Blue" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Col Md + BM + CCT + DIM" Channels="7">

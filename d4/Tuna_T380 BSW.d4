      <Palette ID="12" Name="Gobo 1" Number="0" Page="1" SetControl="Gobo2:2,Gobo2Func:2,Gobo1:1,Gobo1Func:1" />
      <Palette ID="13" Name="Gobo 2" Number="0" Page="1" SetControl="Gobo2:3,Gobo2Func:2,Gobo1:1,Gobo1Func:1" />
      <Palette ID="14" Name="Gobo 3" Number="0" Page="1" SetControl="Gobo2:4,Gobo2Func:2,Gobo1:1,Gobo1Func:1" />

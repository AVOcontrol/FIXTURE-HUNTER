  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0c924024-5482-491c-912e-99f37e6d9167" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Select" ID="2" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Condition Name="Disabled" ID="3" If="'Colour_Macro'&lt;28&amp;&amp;'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Col Select %" Display="'Col Select % %.f%%',0~100" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Disabled" Display="'Disabled'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>

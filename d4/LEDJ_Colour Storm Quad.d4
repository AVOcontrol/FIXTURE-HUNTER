    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
      <Function ID="2" Name="Speed %" Display="'Speed % %.f%%',0~100" Dmx="0~65535" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity %" Display="'Sensitivity % %.f%%',0~100" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="ColMix" Display="'ColMix'" Dmx="0~0" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,0,255" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="40~47" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="48~55" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="56~63" Update="Dimmer, Red, Green, Shutter, Blue, White" Colour="0,255,255" />

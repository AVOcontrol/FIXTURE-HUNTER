      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="110~119" Colour="128,255,0" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="120~129" Colour="255,128,0" />
      <Function ID="14" Name="Straw" Display="'Straw'" Dmx="130~139" Colour="255,250,230" />
      <Function ID="15" Name="Lavender" Display="'Lavender'" Dmx="140~149" Colour="255,128,255" />
      <Function ID="16" Name="Light Blue" Display="'Light Blue'" Dmx="150~159" Colour="0,128,255" />
      <Function ID="17" Name="Dark Blue" Display="'Dark Blue'" Dmx="160~169" Colour="0,0,180" />
      <Function ID="18" Name="Pink" Display="'Pink'" Dmx="170~179" Colour="255,150,150" />

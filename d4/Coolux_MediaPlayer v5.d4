<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MediaPlayer v5" ShortName="P PlayerV5" Company="Coolux">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="28-02-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Folder" Display="'No Folder'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folder" Display="'Folder %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Media" Name="Media" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Media" Display="'No Media'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Media" Display="'Media %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="ObjectFolder" Name="Object Folder" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Folder" Display="'No Folder'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folder" Display="'Folder %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="ObjectMedia" Name="Object Media" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Object" Display="'No Object'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Object" Display="'Object %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Opacity" Display="'Opacity %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="VideoControl" Name="Video Control" Description="" Group="G">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Play Once" Display="'Play Once'" Dmx="64~64" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pause" Display="'Pause'" Dmx="128~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Loop" Display="'Loop'" Dmx="192~192" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Slower" Display="'Slower %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="1:1 Speed" Display="'1:1 Speed'" Dmx="128~128" />
      <Function ID="3" Name="Faster" Display="'Faster %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Inpoint" Name="Inpoint" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Inpoint" Display="'Inpoint %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Outpoint" Name="Outpoint" Description="" Group="G" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Outpoint" Display="'Outpoint %.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Volume" Display="'Volume %.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Z_Angle" Name="Z Angle" Description="" Group="B" Size="2">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Indexed" ID="2" If="'Z_Mode'==1" />
      <Condition Name="Cont" ID="3" If="'Z_Mode'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f°',-180.0~180.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Z_Mode" Name="Z Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Indexed" Display="'Indexed'" Dmx="0~0" Update="Z_Angle" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Cont" Display="'Cont'" Dmx="1~1" Update="Z_Angle" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Z_Speed" Name="Z Speed" Description="" Group="S" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="X_Scale" Name="X Scale" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Min" Display="'Min %.1f%%',-100.0~0.0" Dmx="0~999" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="1:1 Scale" Display="'1:1 Scale'" Dmx="1000~1000" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Max" Display="'Max %.2f%%',0.00~100.00" Dmx="1001~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Scale" Name="Y Scale" Description="" Group="B" Size="2">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Min" Display="'Min %.1f%%',-100.0~0.0" Dmx="0~999" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="1:1 Scale" Display="'1:1 Scale'" Dmx="1000~1000" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Max" Display="'Max %.2f%%',0.00~100.00" Dmx="1001~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X_Rot_Pivot" Name="X Rot Pivot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Rot" Display="'X Rot %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Rot_Pivot" Name="Y Rot Pivot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Rot" Display="'Y Rot %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X_Scale_Pivot" Name="X Scale Pivot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Scale" Display="'X Scale %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Scale_Pivot" Name="Y Scale Pivot" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Scale" Display="'Y Scale %.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>

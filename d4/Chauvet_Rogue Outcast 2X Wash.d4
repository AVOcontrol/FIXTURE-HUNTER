<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Rogue Outcast 2X Wash" ShortName="Rg R2X Ws" Company="Chauvet" Version="8">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>7caecb64-ad86-4174-a300-a52f774c6094</Thumbnail>
  <History Date="11-11-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="01-08-15" Author="Nic Morris" Comment="Increased dimmer wheel resolution.  Added master dimmer and updated cells to use virtual dimmer in response to customer request." Version="2" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="3" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Revised Atlabase ID's for 54 + 33 DMX modes in response to customer bug report (2 versions - previously set to 'MS' - unclear what this is)" Version="4" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Added 'Fan Eco' function to control and macros." Version="5" />
  <History Date="07-11-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="18-11-22" Author="Nic Morris" Comment="Created from Chauvet Rogue R2X Wash (effectively identical except for some control functions/macros)" Version="7" />
  <History Date="20-09-23" Author="Nic Morris" Comment="Updated in line with latest charts (manual rev 6 - adds 23 and 55 channel modes)" Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0c1911fb-bc50-4b54-a75f-38a71fee9f03" />

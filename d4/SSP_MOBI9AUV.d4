    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Col Select" Display="'Col Select'" Dmx="9~50" Update="Auto_Spd" />
      <Function ID="3" Name="Auto Col" Display="'Auto Col'" Dmx="51~100" Update="Auto_Spd" />
      <Function ID="4" Name="Auto Sudden" Display="'Auto Sudden'" Dmx="101~150" Update="Auto_Spd" />
      <Function ID="5" Name="Auto Fade" Display="'Auto Fade'" Dmx="151~200" Update="Auto_Spd" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="201~220" Update="Auto_Spd" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="221~240" Update="Auto_Spd" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="241~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Col Select" ID="2" If="'Auto'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

      <Cell ID="Cell7" Name="LED 5" ChannelOffset="9" ModeLink="Colour cell" X="1" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell8" Name="LED 6" ChannelOffset="10" ModeLink="Colour cell" X="2" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell9" Name="LED 7" ChannelOffset="11" ModeLink="Colour cell" X="3" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell10" Name="LED 8" ChannelOffset="12" ModeLink="Colour cell" X="4" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Tilt cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="85" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
    </Include>
  </Mode>
  <Mode Name="Colour cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="85" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>

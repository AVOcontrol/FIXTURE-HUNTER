<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Spider810 RGBW" ShortName="Spider810" Company="Clair Lighting">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>53523e5f-660c-49ec-b22d-6015acf30fe0</Thumbnail>
  <History Date="26-03-18" Author="Nic Morris" Comment="Created" />
  <History Date="30-03-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d49c7bcc-2e60-4df8-9b7b-ec01d8398dac" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="80~95" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="96~111" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="112~127" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="144~159" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="160~175" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="224~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="8~15" />
      <Function ID="3" Name="Effect 1" Display="'Effect 1'" Dmx="16~31" />
      <Function ID="4" Name="Effect 2" Display="'Effect 2'" Dmx="32~47" />
      <Function ID="5" Name="Effect 3" Display="'Effect 3'" Dmx="48~63" />
      <Function ID="6" Name="Effect 4" Display="'Effect 4'" Dmx="64~79" />
      <Function ID="7" Name="Effect 5" Display="'Effect 5'" Dmx="80~95" />
      <Function ID="8" Name="Effect 6" Display="'Effect 6'" Dmx="96~111" />
      <Function ID="9" Name="Effect 7" Display="'Effect 7'" Dmx="112~127" />
      <Function ID="10" Name="Effect 8" Display="'Effect 8'" Dmx="128~143" />
      <Function ID="11" Name="Effect 9" Display="'Effect 9'" Dmx="144~159" />
      <Function ID="12" Name="Effect 10" Display="'Effect 10'" Dmx="160~175" />
      <Function ID="13" Name="Effect 11" Display="'Effect 11'" Dmx="176~191" />
      <Function ID="14" Name="Effect 12" Display="'Effect 12'" Dmx="192~207" />
      <Function ID="15" Name="Effect 13" Display="'Effect 13'" Dmx="208~223" />
      <Function ID="16" Name="Effect 14" Display="'Effect 14'" Dmx="224~239" />
      <Function ID="17" Name="Effect 15" Display="'Effect 15'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="85" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4a2537d2-2111-498a-ae89-21b83676e5ce" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Effect" ChannelOffset="5" Wheel="22" />
        <Attribute ID="Effect_Spd" ChannelOffset="6" Wheel="23" />
        <Attribute ID="Auto" ChannelOffset="7" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="85" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e0fd18a9-ba18-4439-a87a-335b134506c4" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Colour1" Wheel="7" />
      </Master>
      <Cell ID="Cell1" Name="Tilt 1" ChannelOffset="1" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="2" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell3" Name="LED 1" ChannelOffset="5" ModeLink="Colour cell" X="1" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="LED 2" ChannelOffset="6" ModeLink="Colour cell" X="2" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell5" Name="LED 3" ChannelOffset="7" ModeLink="Colour cell" X="3" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />

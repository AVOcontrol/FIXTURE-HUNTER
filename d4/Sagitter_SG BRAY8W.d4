        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="LED 3" ChannelOffset="7" ModeLink="Dimmer cell" X="3" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

      <Cell ID="Cell8" Name="LED 8" ChannelOffset="12" ModeLink="Dimmer cell" X="4" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="Tilt 1" ChannelOffset="1" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell10" Name="Tilt 2" ChannelOffset="2" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Tilt cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

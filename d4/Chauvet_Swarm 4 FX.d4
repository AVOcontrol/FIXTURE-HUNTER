<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Swarm 4 FX" ShortName="Swarm 4 FX" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="27-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="31-01-17" Author="Nic Morris" Comment="Added 11 channel mode (removed laser colour) in response to customer request and in line with paper manual (online shows 12 channel with laser col)." />
  <History Date="06-10-17" Author="Nic Morris" Comment="Changed name from Swarm 4FX to Swarm 4 FX" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Moon_Colour" Name="Moon Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="40~49" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="50~59" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="60~69" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="8" Name="R+A" Display="'R+A'" Dmx="70~79" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="80~89" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="10" Name="G+A" Display="'G+A'" Dmx="90~99" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="11" Name="B+A" Display="'B+A'" Dmx="100~109" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="110~119" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="13" Name="R+G+A" Display="'R+G+A'" Dmx="120~129" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="14" Name="R+B+A" Display="'R+B+A'" Dmx="130~139" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="15" Name="G+B+A" Display="'G+B+A'" Dmx="140~149" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="150~159" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Single Col" Display="'Single Col'" Dmx="160~224" Update="Moon_Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Multi Col" Display="'Multi Col'" Dmx="225~255" Update="Moon_Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Moon_Shutter" Name="Moon Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4,5,6" If="'Moon_Colour'&gt;16" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="5" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~254" Intensity="0~0" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Moon_Rotate" Name="Moon Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="R+G" Display="'R+G'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="R On, G Strobe" Display="'R On, G Strobe'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="G On, R Strobe" Display="'G On, R Strobe'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="R+G Alt" Display="'R+G Alt'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Shutter" Name="Laser Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Laser_Rotate" Name="Laser Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Strobe_Program" Name="Strobe Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Solid On" Display="'Solid On'" Dmx="10~19" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="20~29" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="30~39" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="40~49" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="50~59" />
      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="60~69" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="70~79" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="80~89" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="90~99" />
      <Function ID="11" Name="Program 9" Display="'Program 9'" Dmx="100~109" />
      <Function ID="12" Name="Program 10" Display="'Program 10'" Dmx="110~119" />
      <Function ID="13" Name="Program 11" Display="'Program 11'" Dmx="120~129" />
      <Function ID="14" Name="Program 12" Display="'Program 12'" Dmx="130~139" />
      <Function ID="15" Name="Program 13" Display="'Program 13'" Dmx="140~149" />
      <Function ID="16" Name="Program 14" Display="'Program 14'" Dmx="150~159" />
      <Function ID="17" Name="Program 15" Display="'Program 15'" Dmx="160~169" />
      <Function ID="18" Name="Program 16" Display="'Program 16'" Dmx="170~179" />
      <Function ID="19" Name="Program 17" Display="'Program 17'" Dmx="180~189" />
      <Function ID="20" Name="Program 18" Display="'Program 18'" Dmx="190~199" />
      <Function ID="21" Name="Program 19" Display="'Program 19'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Strobe_Prog_Spd" Name="Strobe Prog Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 0" Display="'Auto 0'" Dmx="10~21" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="22~33" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="34~45" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="46~57" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="58~69" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5'" Dmx="70~81" />
      <Function ID="8" Name="Auto 6" Display="'Auto 6'" Dmx="82~93" />
      <Function ID="9" Name="Auto 7" Display="'Auto 7'" Dmx="94~105" />
      <Function ID="10" Name="Auto 8" Display="'Auto 8'" Dmx="106~117" />
      <Function ID="11" Name="Auto 9" Display="'Auto 9'" Dmx="118~127" />
      <Function ID="12" Name="Sound 0" Display="'Sound 0'" Dmx="128~140" />
      <Function ID="13" Name="Sound 1" Display="'Sound 1'" Dmx="141~153" />
      <Function ID="14" Name="Sound 2" Display="'Sound 2'" Dmx="154~166" />
      <Function ID="15" Name="Sound 3" Display="'Sound 3'" Dmx="167~179" />
      <Function ID="16" Name="Sound 4" Display="'Sound 4'" Dmx="180~192" />
      <Function ID="17" Name="Sound 5" Display="'Sound 5'" Dmx="193~205" />
      <Function ID="18" Name="Sound 6" Display="'Sound 6'" Dmx="206~218" />
      <Function ID="19" Name="Sound 7" Display="'Sound 7'" Dmx="219~231" />
      <Function ID="20" Name="Sound 8" Display="'Sound 8'" Dmx="232~244" />
      <Function ID="21" Name="Sound 9" Display="'Sound 9'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Moon_Colour" Wheel="7" />
        <Attribute ID="Moon_Shutter" Wheel="4" />
        <Attribute ID="Moon_Rotate" Wheel="19" />
        <Attribute ID="Laser_Colour" ChannelOffset="7" Wheel="8" />
        <Attribute ID="Laser_Shutter" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Laser_Rotate" ChannelOffset="9" Wheel="20" />
        <Attribute ID="Strobe_Program" ChannelOffset="10" Wheel="22" />
        <Attribute ID="Strobe_Prog_Spd" ChannelOffset="11" Wheel="23" />
        <Attribute ID="Shutter" ChannelOffset="12" Wheel="6" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Moon_Colour" TargetId="Moon_Colour" />
        <AttributeLink SourceId="Moon_Shutter" TargetId="Moon_Shutter" />
        <AttributeLink SourceId="Moon_Rotate" TargetId="Moon_Rotate" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Moon_Colour" TargetId="Moon_Colour" />
        <AttributeLink SourceId="Moon_Shutter" TargetId="Moon_Shutter" />
        <AttributeLink SourceId="Moon_Rotate" TargetId="Moon_Rotate" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="CHSWM4FX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Moon_Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Moon_Colour" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Moon_Rotate" ChannelOffset="3" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Moon_Shutter" Wheel="4" />
        <Attribute ID="Moon_Colour" Wheel="7" />
        <Attribute ID="Moon_Rotate" Wheel="19" />
        <Attribute ID="Laser_Shutter" ChannelOffset="7" Wheel="5" />
        <Attribute ID="Laser_Rotate" ChannelOffset="8" Wheel="20" />
        <Attribute ID="Strobe_Program" ChannelOffset="9" Wheel="22" />
        <Attribute ID="Strobe_Prog_Spd" ChannelOffset="10" Wheel="23" />
        <Attribute ID="Shutter" ChannelOffset="11" Wheel="6" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Moon_Shutter" TargetId="Moon_Shutter" />
        <AttributeLink SourceId="Moon_Colour" TargetId="Moon_Colour" />
        <AttributeLink SourceId="Moon_Rotate" TargetId="Moon_Rotate" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Moon_Shutter" TargetId="Moon_Shutter" />
        <AttributeLink SourceId="Moon_Colour" TargetId="Moon_Colour" />
        <AttributeLink SourceId="Moon_Rotate" TargetId="Moon_Rotate" />
      </Cell>
    </Cells>
  </Mode>
</Fixture>
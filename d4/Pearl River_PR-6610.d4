      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="20~127" />
      <Function ID="3" Name="Shake 1" Display="'Shake 1 %.f%%',0~100" Dmx="128~170" />
      <Function ID="4" Name="Shake 2" Display="'Shake 2 %.f%%',0~100" Dmx="171~213" />

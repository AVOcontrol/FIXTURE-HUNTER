      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="98~115" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="116~133" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="134~151" />

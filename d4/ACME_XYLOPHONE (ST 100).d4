      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="8~25" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="26~43" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="44~61" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="62~79" />

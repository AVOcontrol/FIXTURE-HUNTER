<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VELVET CYC" ShortName="VELVET CYC" Company="VELVETLight" Version="20">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="03-10-19" Author="Nic Morris" Comment="Created (note 'Changing' modes not implemented)" Version="1" />
  <History Date="09-10-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="03-08-20" Author="Nic Morris" Comment="Created from VELVETLight EVO1 (note 16bit charts not available - assumed identical.  'Changing' modes not implemented)" Version="3" />
  <History Date="03-11-20" Author="Nic Morris" Comment="Added Individual modes in line with latest information in response to manufacturer request." Version="4" />
  <History Date="13-05-22" Author="Nic Morris" Comment="Updated in line with latest charts (Firmware v0204-30-March-22.  Significant differences, particularly 16bit modes.  Documentation linked from website still show original mappings)" Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Very confusing.  Impemented full modes as split patch.  Note 8bit and 16 bit full modes appear to have different options and looks wrong)." Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Lightsources and non-full mode effect ranges not documented - left unchanged for now.  Gels not documented - left as raw)" Version="5" />
  <History Date="13-05-22" Author="Nic Morris" Comment="(Tried to imply effect parameters from full modes)" Version="8" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2500" PowerOn="1:2500" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2500~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+Magenta" Display="'+Magenta %.1f%%',100.0~1.0" Dmx="1~121" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="122~132" Colour="255,255,255" />
      <Function ID="4" Name="+Green" Display="'+Green %.1f%%',1.0~100.0" Dmx="133~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.f°',0~359" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Family" Name="Gel Family" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="LEE" Display="'LEE'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rosco" Display="'Rosco'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Number" Name="Gel Number" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Lightsource" Name="Lightsource" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue Screen" Display="'Blue Screen'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="Green Screen" Display="'Green Screen'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="Candle" Display="'Candle'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="Tungsten" Display="'Tungsten'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Halogen" Display="'Halogen'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="Carbon Arc" Display="'Carbon Arc'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="8" Name="Fluorescent Warm" Display="'Fluorescent Warm'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="Fluorescent Standard" Display="'Fluorescent Standard'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="10" Name="Fluorescent Cool" Display="'Fluorescent Cool'" Dmx="9~9" Colour="255,255,255" />
      <Function ID="11" Name="Fluorescent Black Light" Display="'Fluorescent Black Light'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="12" Name="HMI" Display="'HMI'" Dmx="11~11" Colour="255,255,255" />
      <Function ID="13" Name="Mercury Vapour" Display="'Mercury Vapour'" Dmx="12~12" Colour="255,255,255" />
      <Function ID="14" Name="Moonlight" Display="'Moonlight'" Dmx="13~13" Colour="255,255,255" />
      <Function ID="15" Name="Sky Blue" Display="'Sky Blue'" Dmx="14~14" Colour="255,255,255" />
      <Function ID="16" Name="Sky Overcast" Display="'Sky Overcast'" Dmx="15~15" Colour="255,255,255" />
      <Function ID="17" Name="Sodium High Pressure" Display="'Sodium High Pressure'" Dmx="16~16" Colour="255,255,255" />
      <Function ID="18" Name="Sodium Vapour" Display="'Sodium Vapour'" Dmx="17~17" Colour="255,255,255" />
      <Function ID="19" Name="Sunlight" Display="'Sunlight'" Dmx="18~18" Colour="255,255,255" />
      <Function ID="20" Name="Sunset Sun" Display="'Sunset Sun'" Dmx="19~19" Colour="255,255,255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Preset" Name="Preset" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disco" Display="'Disco'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="2" Name="Flame" Display="'Flame'" Dmx="1~1" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="3" Name="Police" Display="'Police'" Dmx="2~2" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="3~3" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="5" Name="Strobe" Display="'Strobe'" Dmx="4~4" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="6" Name="TV" Display="'TV'" Dmx="5~5" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4, Effect_Param_5, Effect_Param_6" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="FX Param 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Loop Speed" ID="1" If="'Effect'==1||'Effect'==3||'Effect'==4||'Effect'==6" />
      <Condition Name="Saturation" ID="2" If="'Effect'==5" />
      <Condition Name="Flicker Speed" ID="3" If="'Effect'==2" />
      <Else ID="4" />
      <Function ID="1" Name="Loop Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Flicker Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="FX Param 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Saturation" ID="1" If="'Effect'==2||'Effect'==1||'Effect'==6" />
      <Condition Name="Flash Time" ID="2" If="'Effect'==4" />
      <Condition Name="Hue 1" ID="3" If="'Effect'==3" />
      <Condition Name="Hue" ID="4" If="'Effect'==5" />
      <Else ID="5" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Flash Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Hue 1" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="FX Param 3" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Hue" ID="1" If="'Effect'==1||'Effect'==2" />
      <Condition Name="Hue 2" ID="2" If="'Effect'==3" />
      <Condition Name="Fade Out" ID="3" If="'Effect'==4" />
      <Condition Name="Kelvin" ID="5" If="'Effect'==5" />
      <Condition Name="Hue 1" ID="6" If="'Effect'==6" />
      <Else ID="4" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Hue 2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Fade Out" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Kelvin" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Hue 1" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="FX Param 4" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Saturation" ID="1" If="'Effect'==4" />
      <Condition Name="Kelvin" ID="2" If="'Effect'==1||'Effect'==2||'Effect'==3" />
      <Condition Name="Flash Time" ID="4" If="'Effect'==5" />
      <Condition Name="Hue 2" ID="5" If="'Effect'==6" />
      <Else ID="3" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Kelvin" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Flash Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Hue 2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_5" Name="FX Param 5" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Smoothness" ID="2" If="'Effect'==1||'Effect'==2||'Effect'==3||'Effect'==6" />
      <Condition Name="Hue" ID="3" If="'Effect'==4" />
      <Else ID="1" />
      <Function ID="2" Name="Smoothness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_6" Name="FX Param 6" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Direction" ID="2" If="'Effect'==1||'Effect'==6" />
      <Condition Name="Kelvin" ID="3" If="'Effect'==4" />
      <Else ID="1" />
      <Function ID="2" Name="Direction" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="3" Name="Kelvin" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_7" Name="FX Param 7" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_8" Name="FX Param 8" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_9" Name="FX Param 9" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_10" Name="FX Param 10" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control(8bit)" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Common Colour" Display="'Common Colour'" Dmx="0~0" />
      <Function ID="2" Name="Individual" Display="'Individual'" Dmx="10~19" />
      <Function ID="3" Name="Gels" Display="'Gels'" Dmx="20~29" />
      <Function ID="4" Name="Lightsources" Display="'Lightsources'" Dmx="30~39" />
      <Function ID="5" Name="Presets" Display="'Presets'" Dmx="40~49" />
      <Function ID="6" Name="FX Disco" Display="'FX Disco'" Dmx="50~59" />
      <Function ID="7" Name="FX Flame" Display="'FX Flame'" Dmx="60~69" />
      <Function ID="8" Name="FX Police" Display="'FX Police'" Dmx="70~79" />
      <Function ID="9" Name="FX Pulse" Display="'FX Pulse'" Dmx="80~89" />
      <Function ID="10" Name="FX Strobe" Display="'FX Strobe'" Dmx="90~99" />
      <Function ID="11" Name="FX TV" Display="'FX TV'" Dmx="100~109" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control(16bit)" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Base Col" Display="'Base Col'" Dmx="0~0" />
      <Function ID="2" Name="Gels" Display="'Gels'" Dmx="10~29" />
      <Function ID="3" Name="Lightsources" Display="'Lightsources'" Dmx="20~39" />
      <Function ID="4" Name="Presets" Display="'Presets'" Dmx="30~49" />
      <Function ID="5" Name="FX Disco" Display="'FX Disco'" Dmx="40~59" />
      <Function ID="6" Name="FX Flame" Display="'FX Flame'" Dmx="50~69" />
      <Function ID="7" Name="FX Police" Display="'FX Police'" Dmx="60~79" />
      <Function ID="8" Name="FX Pulse" Display="'FX Pulse'" Dmx="70~89" />
      <Function ID="9" Name="FX Strobe" Display="'FX Strobe'" Dmx="80~99" />
      <Function ID="10" Name="FX TV" Display="'FX TV'" Dmx="90~109" />
      <Function ID="11" Name="FX Paparazzi" Display="'FX Paparazzi'" Dmx="100~109" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Loop_Speed" Name="Loop Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Loop Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hue_1" Name="Hue 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue 1" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Hue_2" Name="Hue 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue 2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Smoothness" Name="Smoothness" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Smoothness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Flicker_Speed" Name="Flicker Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flicker Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Flash_Time" Name="Flash Time" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flash Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fade_Out" Name="Fade Out" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade Out" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="CCT (8bit), 3 DMX" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="37" />
      <Attribute ID="Green/Magenta" ChannelOffset="3" Wheel="38" />
    </Include>
  </Mode>
  <Mode Name="CCT (16bit), 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="3" Wheel="37" />
      <Attribute ID="Green/Magenta" ChannelOffset="4" Wheel="38" />
    </Include>
  </Mode>
  <Mode Name="CCT+HSI (8bit), 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="ColourIntensity" ChannelOffset="1" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="37" />
      <Attribute ID="Green/Magenta" ChannelOffset="3" Wheel="38" />
      <Attribute ID="Saturation" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Hue" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="CCT+HSI (16bit), 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="ColourIntensity" ChannelOffset="1,2" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="CCT" ChannelOffset="3" Wheel="37" />

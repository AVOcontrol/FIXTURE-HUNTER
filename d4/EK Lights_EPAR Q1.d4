  <AtlaBase TypeID="7721c766-e700-4e49-90ed-9d89e4261814" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGB Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="CTO 1" Display="'CTO 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="CTO 2" Display="'CTO 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="CTO 3" Display="'CTO 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="CTO 4" Display="'CTO 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="CTO 5" Display="'CTO 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="CTO 6" Display="'CTO 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="CTO 7" Display="'CTO 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="CTO 8" Display="'CTO 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="CTO 9" Display="'CTO 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="CTO 10" Display="'CTO 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="CTO 11" Display="'CTO 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="WW 1" Display="'WW 1'" Dmx="6~25" Colour="255,255,255" />
      <Function ID="3" Name="WW 2" Display="'WW 2'" Dmx="26~50" Colour="255,255,255" />
      <Function ID="4" Name="WW 3" Display="'WW 3'" Dmx="51~75" Colour="255,255,255" />
      <Function ID="5" Name="W 1" Display="'W 1'" Dmx="76~100" Colour="255,255,255" />
      <Function ID="6" Name="W 2" Display="'W 2'" Dmx="101~125" Colour="255,255,255" />
      <Function ID="7" Name="W 3" Display="'W 3'" Dmx="126~150" Colour="255,255,255" />
      <Function ID="8" Name="CW 1" Display="'CW 1'" Dmx="151~175" Colour="255,255,255" />
      <Function ID="9" Name="CW 2" Display="'CW 2'" Dmx="176~200" Colour="255,255,255" />
      <Function ID="10" Name="CW 3" Display="'CW 3'" Dmx="201~225" Colour="255,255,255" />
      <Function ID="11" Name="W" Display="'W'" Dmx="226~250" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5 (1-4)" Display="'Auto 5 (1-4)'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="176~200" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="201~225" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="226~250" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="251~255" />
    </Attribute>
  </Control>

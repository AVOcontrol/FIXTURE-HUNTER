  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="3" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Renamed chase attributes and moved into effect wheel slot in response to manufacturer request." Version="4" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Changed chase attribute groups to match wheel slots.  Increased chase speed wheel resolution." Version="5" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Inverted P/T speed wheel direction.  Added standard mode in response to manufacturer bug report." Version="6" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Increased macro delay in response to manufacturer bug report." Version="7" />
  <History Date="22-05-16" Author="Nic Morris" Comment="Fixed typo in Chase 14 display text" Version="8" />
  <History Date="15-08-17" Author="Nic Morris" Comment="Fixed unsupported wheel mapping.  Added extended compatibility modes and exported R20's." Version="9" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added product thumbnail" Version="10" />
  <History Date="29-12-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="11" />
  <History Date="28-03-18" Author="Nic Morris" Comment="Added pixel layout" Version="12" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="13" />

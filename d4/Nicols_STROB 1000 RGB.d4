  <History Date="02-10-19" Author="Nic Morris" Comment="Created" />
  <History Date="03-10-19" Author="Nic Morris" Comment="Added Atlabase ID to 16 DMX mode.  6 DMX is currently missing." />
  <History Date="04-10-19" Author="Nic Morris" Comment="Added Atlabase ID to 6 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="09237fd6-881c-4801-9ff7-d619e5676d1d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe_Mode" Name="Strobe Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="205~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="5~54" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse'" Dmx="55~104" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse'" Dmx="105~154" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="155~204" />
    </Attribute>
    <Attribute ID="Strobe_Speed" Name="Strobe Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Col_Mode" Name="Col Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~14" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~24" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="25~34" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="35~44" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="45~54" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="55~64" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="65~74" Colour="255,255,255" />
      <Function ID="9" Name="Jump" Display="'Jump %.1f%%',0.0~100.0" Dmx="75~199" Colour="255,255,255" />
      <Function ID="10" Name="Random" Display="'Random %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Gradient" Name="Col Gradient" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="8~39" Colour="255,0,0" />
      <Function ID="3" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="40~71" Colour="255,255,0" />
      <Function ID="4" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="72~103" Colour="0,255,0" />
      <Function ID="5" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="104~135" Colour="0,255,255" />
      <Function ID="6" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="136~167" Colour="0,0,255" />
      <Function ID="7" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="168~199" Colour="255,0,255" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Fade" Name="Effect Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f9ea026d-69bd-44a2-9241-7f77bd366c8c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Strobe_Mode" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Strobe_Speed" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6ef323da-cec1-4474-bfdc-b1f9903a0567" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Strobe_Mode" ChannelOffset="2" Wheel="4" />

      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Frost" ChannelOffset="10,11" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="12,13" Wheel="20" />
      <Attribute ID="Prism_Func" Wheel="22" />
      <Attribute ID="Prism" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Prism_Rot" ChannelOffset="7,8" Wheel="24" />
      <Attribute ID="Effect_Rot" ChannelOffset="9" Wheel="52" />

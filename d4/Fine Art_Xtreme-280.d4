      <Attribute ID="Prism_Rot" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Effect_Rot" ChannelOffset="7" Wheel="52" />
      <Attribute ID="Function" ChannelOffset="14" Wheel="30" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
      <Attribute ID="PT_Speed" ChannelOffset="17" Wheel="25" />
      <Attribute ID="Colour_Speed" ChannelOffset="18" Wheel="26" />
      <Attribute ID="Beam_Speed" ChannelOffset="19" Wheel="27" />
      <Attribute ID="Gobo_Speed" ChannelOffset="20" Wheel="55" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
  </Macro>

  <AtlaBase TypeID="9b1999e6-e106-476d-b268-f49293c63c46" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="5~25" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="26~46" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="55~77" Colour="255,255,255" />
      <Function ID="5" Name="3500K" Display="'3500K'" Dmx="78~98" Colour="255,255,255" />
      <Function ID="6" Name="4000K" Display="'4000K'" Dmx="99~119" Colour="255,255,255" />
      <Function ID="7" Name="4200K" Display="'4200K'" Dmx="120~140" Colour="255,255,255" />
      <Function ID="8" Name="4500K" Display="'4500K'" Dmx="141~161" Colour="255,255,255" />
      <Function ID="9" Name="5600K" Display="'5600K'" Dmx="162~182" Colour="255,255,255" />
      <Function ID="10" Name="6000K" Display="'6000K'" Dmx="183~203" Colour="255,255,255" />
      <Function ID="11" Name="6500K" Display="'6500K'" Dmx="204~224" Colour="255,255,255" />
      <Function ID="12" Name="7200K" Display="'7200K'" Dmx="225~245" Colour="255,255,255" />
      <Function ID="13" Name="8000K" Display="'8000K'" Dmx="246~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Fade" Name="Colour Fade" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Fading" Display="'Colour Fading %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Jump" Display="'Jump %.1f%%',0.0~100.0" Dmx="5~130" Colour="255,255,255" />
      <Function ID="3" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="131~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="6~47" />
      <Function ID="3" Name="Stage" Display="'Stage'" Dmx="48~89" />
      <Function ID="4" Name="TV" Display="'TV'" Dmx="90~131" />
      <Function ID="5" Name="Architectural" Display="'Architectural'" Dmx="132~173" />
      <Function ID="6" Name="Theatre" Display="'Theatre'" Dmx="174~215" />
      <Function ID="7" Name="Custom Curve" Display="'Custom Curve'" Dmx="216~255" />
    </Attribute>
  </Control>

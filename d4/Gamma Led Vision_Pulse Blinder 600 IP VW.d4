      <Function ID="3" Name="Med" Display="'Med'" Dmx="128~191" />
      <Function ID="4" Name="Slow (Halogen)" Display="'Slow (Halogen)'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="16~44" />

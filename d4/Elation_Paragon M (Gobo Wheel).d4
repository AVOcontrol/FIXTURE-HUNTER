    <Attribute ID="CRI" Name="CRI" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- CRI" Display="'- CRI %.1f',73.0~80.0" Dmx="0~126" Colour="0,0,0" />
      <Function ID="2" Name="CRI 80 (Highest Output)" Display="'CRI 80 (Highest Output)'" Dmx="127~127" Colour="0,0,0" />
      <Function ID="3" Name="+ CRI" Display="'+ CRI %.1f',80.0~93.0" Dmx="128~255" Colour="0,0,0" />

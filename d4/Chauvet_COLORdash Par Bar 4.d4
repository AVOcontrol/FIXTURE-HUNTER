  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c2f78a6c-bba2-4a1b-844f-49cc529f8123" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="11~30" Colour="255,0,0" />
      <Function ID="3" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="31~50" Colour="255,255,0" />
      <Function ID="4" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="51~70" Colour="0,255,0" />
      <Function ID="5" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="71~90" Colour="0,255,255" />
      <Function ID="6" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="91~110" Colour="0,0,255" />
      <Function ID="7" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="111~130" Colour="255,0,255" />
      <Function ID="8" Name="Rd - RGB Full" Display="'Rd - RGB Full %.f%%',0~100" Dmx="131~150" Colour="255,0,0" />
      <Function ID="9" Name="RGB Full - Blu" Display="'RGB Full - Blu %.f%%',0~100" Dmx="151~170" Colour="255,255,255" />
      <Function ID="10" Name="RGBA full" Display="'RGBA full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="11" Name="Amber to RGB full" Display="'Amber to RGB full %.f%%',0~100" Dmx="201~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CT" Name="CT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Warm White 1" Display="'Warm White 1'" Dmx="6~25" Colour="0,0,0" />
      <Function ID="3" Name="Warm White 2" Display="'Warm White 2'" Dmx="26~50" Colour="0,0,0" />
      <Function ID="4" Name="Warm White 3" Display="'Warm White 3'" Dmx="51~75" Colour="0,0,0" />
      <Function ID="5" Name="Neutral White 1" Display="'Neutral White 1'" Dmx="76~100" Colour="0,0,0" />
      <Function ID="6" Name="Neutral White 2" Display="'Neutral White 2'" Dmx="101~125" Colour="0,0,0" />
      <Function ID="7" Name="Neutral White 3" Display="'Neutral White 3'" Dmx="126~150" Colour="0,0,0" />
      <Function ID="8" Name="Daylight 1" Display="'Daylight 1'" Dmx="151~175" Colour="0,0,0" />
      <Function ID="9" Name="Daylight 2" Display="'Daylight 2'" Dmx="176~200" Colour="0,0,0" />
      <Function ID="10" Name="Daylight 3" Display="'Daylight 3'" Dmx="201~225" Colour="0,0,0" />
      <Function ID="11" Name="Daylight 4" Display="'Daylight 4'" Dmx="226~250" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~60" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="61~110" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="111~160" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="161~210" />
      <Function ID="6" Name="Auto 5 (Cycle 1-4)" Display="'Auto 5 (Cycle 1-4)'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Mode Off" Display="'Dim Mode Off'" Dmx="6~10" />
      <Function ID="3" Name="Dim Mode 1 (fast)" Display="'Dim Mode 1 (fast)'" Dmx="11~15" />
      <Function ID="4" Name="Dim Mode 2" Display="'Dim Mode 2'" Dmx="16~20" />
      <Function ID="5" Name="Dim Mode 3 (slow)" Display="'Dim Mode 3 (slow)'" Dmx="21~25" />
      <Function ID="6" Name="PWM Freq 600Hz" Display="'PWM Freq 600Hz'" Dmx="26~30" />
      <Function ID="7" Name="PWM Freq 1200Hz" Display="'PWM Freq 1200Hz'" Dmx="31~35" />
      <Function ID="8" Name="PWM Freq 2000Hz" Display="'PWM Freq 2000Hz'" Dmx="36~40" />
      <Function ID="9" Name="PWM Freq 4000Hz" Display="'PWM Freq 4000Hz'" Dmx="41~45" />
      <Function ID="10" Name="PWM Freq 6000Hz" Display="'PWM Freq 6000Hz'" Dmx="46~50" />
      <Function ID="11" Name="PWM Freq 25kHz" Display="'PWM Freq 25kHz'" Dmx="51~55" />
      <Function ID="12" Name="Display Lock On" Display="'Display Lock On'" Dmx="56~60" />
      <Function ID="13" Name="Display Lock Off" Display="'Display Lock Off'" Dmx="61~65" />
      <Function ID="14" Name="Backlight Timer 10s" Display="'Backlight Timer 10s'" Dmx="66~70" />
      <Function ID="15" Name="Backlight Timer 30s" Display="'Backlight Timer 30s'" Dmx="71~75" />
      <Function ID="16" Name="Backlight Timer 2min" Display="'Backlight Timer 2min'" Dmx="76~80" />
      <Function ID="17" Name="Backlight Always On" Display="'Backlight Always On'" Dmx="81~85" />
      <Function ID="18" Name="Steady Mode On" Display="'Steady Mode On'" Dmx="141~145" />
      <Function ID="19" Name="Steady Mode Off" Display="'Steady Mode Off'" Dmx="146~150" />
      <Function ID="20" Name="White Bal Manual" Display="'White Bal Manual'" Dmx="151~155" />
      <Function ID="21" Name="White Bal Off" Display="'White Bal Off'" Dmx="156~160" />
    </Attribute>
  </Control>

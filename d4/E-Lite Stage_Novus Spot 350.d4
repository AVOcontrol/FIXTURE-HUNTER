      </Function>
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="80~89" WheelPosition="9">
        <Swatch>f045c87b-c1ee-4cde-a3ad-64ef97009360</Swatch>
      </Function>
      <Function ID="11" Name="Open" Display="'Open'" Dmx="90~99" WheelPosition="0">
        <Swatch>babdbd61-27c8-40e1-a2fe-83593e675500</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="100~109" WheelPosition="1">
        <Swatch>f1676e51-5ead-4892-882b-209007fd129b</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="110~119" WheelPosition="2">
        <Swatch>8380126e-b0c5-4924-86fa-ffb54877a96d</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="120~129" WheelPosition="3">
        <Swatch>c847841d-d308-4b79-a2c1-c037388677e5</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="130~139" WheelPosition="4">
        <Swatch>5fe4b396-370d-44de-9c9e-6e50e7cd317e</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="140~149" WheelPosition="5">
        <Swatch>671498f6-3cc2-4021-b1e2-4ed70292e61b</Swatch>
      </Function>
      <Function ID="17" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="150~159" WheelPosition="6">
        <Swatch>74c62a32-af62-4ba3-b0a5-6af620f21864</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="160~169" WheelPosition="7">
        <Swatch>ceeb9260-20c3-4ee9-a6b8-dd024c41a2c1</Swatch>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ImageCue 1.1" ShortName="ImgCue 1.1" Company="ImageCue LLC">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-12-16" Author="Nic Morris" Comment="Created" />
  <History Date="06-11-17" Author="Nic Morris" Comment="Revised Saturation ID for compatibility." />
  <Manual Filename="http://imagecue.lighting" Summary="ImageCue website" />
  <RDM>
    <Device ManufacturerID="776" ModelID="257" />
  </RDM>
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stock Folder" Display="'Stock Folder'" Dmx="0~0" />
      <Function ID="2" Name="User" Display="'User %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="File" Name="File" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Image" Display="'No Image'" Dmx="0~0" />
      <Function ID="2" Name="Image" Display="'Image %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Fade_Time" Name="Fade Time" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade Time" Display="'Fade Time %.1f Sec',0.0~6553.0" Dmx="0~65530" />
      <Function ID="2" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="SaturationX" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Color in Front" Display="'Color in Front'" Dmx="64~64" />
      <Function ID="3" Name="Play Once + Exit" Display="'Play Once + Exit'" Dmx="128~128" />
      <Function ID="4" Name="Play Once + Freeze" Display="'Play Once + Freeze'" Dmx="129~129" />
      <Function ID="5" Name="Col in Front + Play Once" Display="'Col in Front + Play Once'" Dmx="192~192" />
      <Function ID="6" Name="Col in Front + Play Once + Freeze" Display="'Col in Front + Play Once + Freeze'" Dmx="193~193" />
      <Function ID="7" Name="Display Version" Display="'Display Version'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Overlay_File" Name="Overlay File" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Image" Display="'No Image'" Dmx="0~0" />
      <Function ID="2" Name="Image" Display="'Image %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Overlay_Opacity" Name="Overlay Opacity" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Opacity %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="12">
    <Import PearlRef="UKIMC1_1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="None" Lumens="N/A" ColourTemp="N/A" />
      <Lens Name="N/A" Degrees="N/A" />
      <Weight Kg="1.5 lb incld bracket" />
      <Size Height="5&quot;  incld bracket" Width="8.5&quot; incld bracket" Depth="1.75&quot;" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Folder" ChannelOffset="2" Wheel="13" />
      <Attribute ID="File" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Fade_Time" ChannelOffset="4,5" Wheel="25" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="SaturationX" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
      <Attribute ID="Overlay_File" ChannelOffset="11" Wheel="16" />
      <Attribute ID="Overlay_Opacity" ChannelOffset="12" Wheel="4" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
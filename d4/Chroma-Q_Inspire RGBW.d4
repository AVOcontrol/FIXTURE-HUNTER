<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Inspire RGBW" ShortName="Insp RGBW" Company="Chroma-Q">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-09-13" Author="Matt Benson" Comment="Created" />
  <History Date="12-09-13" Author="Peter Budd" Comment="Corrected manufacturer and added preset palettes." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed manufacturer name from Chroma Q to Chroma-Q.  Revised mode names." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed Atlabase ID's from white to black version.  Increased wheel resolution." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Revised attribute names and functions.  Added Look Select mode.  Removed invalid shutter palettes." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI mode and linked to vdim for compatibility." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="37067f0a-ff16-4b8a-bfa7-552d9b091fe8" />
  <Control>
    <Attribute ID="Colour_Scroll" Name="Colour Scroll" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Range" Name="Colour Range" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Range" Display="'Range %.1f%%',0.0~100.0" Dmx="1~255" />
      <Function ID="2" Name="Full Spectrum" Display="'Full Spectrum'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Colour_Step" Name="Colour Step" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="255~255" />
      <Function ID="2" Name="Scroll Smooth" Display="'Scroll Smooth %.1f%%',0.0~100.0" Dmx="0~250" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="192~255" Intensity="0~0" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="1~63" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="64~127" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Look" Name="Look" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Full Col Scroll (5s)" Display="'Full Col Scroll (5s)'" Dmx="3~5" />
      <Function ID="3" Name="Full Col Scroll (10s)" Display="'Full Col Scroll (10s)'" Dmx="8~13" />
      <Function ID="4" Name="Full Col Scroll (30s)" Display="'Full Col Scroll (30s)'" Dmx="15~23" />
      <Function ID="5" Name="Warm Col Scroll (5s)" Display="'Warm Col Scroll (5s)'" Dmx="26~28" />
      <Function ID="6" Name="Warm Col Scroll (10s)" Display="'Warm Col Scroll (10s)'" Dmx="31~38" />
      <Function ID="7" Name="Warm Col Scroll (30s)" Display="'Warm Col Scroll (30s)'" Dmx="41~48" />
      <Function ID="8" Name="Cold Col Scroll (5s)" Display="'Cold Col Scroll (5s)'" Dmx="51~56" />
      <Function ID="9" Name="Cold Col Scroll (10s)" Display="'Cold Col Scroll (10s)'" Dmx="59~64" />
      <Function ID="10" Name="Cold Col Scroll (30s)" Display="'Cold Col Scroll (30s)'" Dmx="66~69" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="74~82" />
      <Function ID="12" Name="Pink" Display="'Pink'" Dmx="84~89" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="92~97" />
      <Function ID="14" Name="Light Orange" Display="'Light Orange'" Dmx="99~107" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="110~115" />
      <Function ID="16" Name="Light Yellow" Display="'Light Yellow'" Dmx="117~122" />
      <Function ID="17" Name="Green" Display="'Green'" Dmx="125~130" />
      <Function ID="18" Name="Light Green" Display="'Light Green'" Dmx="133~138" />
      <Function ID="19" Name="Cyan" Display="'Cyan'" Dmx="143~148" />
      <Function ID="20" Name="Light Cyan" Display="'Light Cyan'" Dmx="150~156" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="158~163" />
      <Function ID="22" Name="Light Blue" Display="'Light Blue'" Dmx="166~173" />
      <Function ID="23" Name="White 3200K" Display="'White 3200K'" Dmx="176~181" />
      <Function ID="24" Name="White 5600K" Display="'White 5600K'" Dmx="184~189" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (HSI+FX), 7 DMX" Channels="7">
    <Import PearlRef="CQ_InspM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f18dacfc-f943-45f7-bdd1-e7ce3f88a7a0" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />

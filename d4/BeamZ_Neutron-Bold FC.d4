  <History Date="06-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="30-07-26" Author="Nic Morris" Comment="Created from BeamZ Neutron-Atom FC (213 channel mode charts are not documented fully and don't make sense.  assumed is actually 223 channels.  235 channel mode is titled 223 channels... no pixel layout)" Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hippotizer Master Layer Light V3.2.1" ShortName="Hippo MrLt" Company="Green Hippo">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="03-04-12" Author="Peter Budd" Comment="Created" />
  <History Date="22-05-13" Author="Peter Budd" Comment="Created from Master Lite V3.1" />
  <History Date="05-01-14" Author="Nic Morris" Comment="Created from Green Hippo Master Lite V3.2" />
  <History Date="20-01-14" Author="Nic Morris" Comment="Corrected region map functions and renamed region map select following discussion with manuf." />
  <History Date="24-02-14" Author="Peter Budd" Comment="Corrected Hue and Saturation locate values." />
  <History Date="01-04-14" Author="Nic Morris" Comment="Updated Region Map Select for 3.2.2" />
  <History Date="18-11-16" Author="Nic Morris" Comment="Removed wheel display where attributes only have one function" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Brightness" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Contrast" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Live_Mask" Name="Live Mask" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Live Mask" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Video_Map" Name="Video Map" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Video_Map_Mix" Name="Video Map Mix" Description="" Group="G">
      <Locate Locate="1:255" PowerOn="1:255" />
      <Function ID="1" Name="Mix Mode" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mix_Morph" Name="Mix Morph" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Morph Off" Display="'Morph Off'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Morph On" Display="'Morph On'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Map_Select_A" Name="Map Select A" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select A" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Map_Select_B" Name="Map Select B" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select B" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Audio_Volume" Name="Audio Volume" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Volume" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Region_Mapper" Name="Region Mapper" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable" Display="'Disable'" Dmx="0~0" />
      <Function ID="2" Name="Enable" Display="'Enable'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Region_Map_Enable" Name="Region Map Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Map" Display="'No Map'" Dmx="0~0" />
      <Function ID="2" Name="Map 1-255" Display="'Map 1-255 %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Preset_Select" Name="Preset Select" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Preset" Display="'No Preset'" Dmx="0~0" />
      <Function ID="2" Name="Preset" Display="'Preset %.f',1~255" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Brightness" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Contrast" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Audio_Volume" ChannelOffset="10" Wheel="6" />
      <Attribute ID="Hue" ChannelOffset="12" Wheel="7" />
      <Attribute ID="Saturation" ChannelOffset="13" Wheel="8" />
      <Attribute ID="Live_Mask" ChannelOffset="4" Wheel="46" />
      <Attribute ID="Video_Map" ChannelOffset="5" Wheel="13" />
      <Attribute ID="Video_Map_Mix" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Mix_Morph" ChannelOffset="7" Wheel="15" />
      <Attribute ID="Map_Select_A" ChannelOffset="8" Wheel="43" />
      <Attribute ID="Map_Select_B" ChannelOffset="9" Wheel="44" />
      <Attribute ID="Region_Mapper" ChannelOffset="11" Wheel="28" />
      <Attribute ID="Region_Map_Enable" ChannelOffset="14" Wheel="29" />
      <Attribute ID="Preset_Select" ChannelOffset="15" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
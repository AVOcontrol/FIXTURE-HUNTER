  <History Date="03-01-19" Author="Nic Morris" Comment="Created (note majority of existing Capture modes don't match)" Version="1" />
  <History Date="09-01-19" Author="Nic Morris" Comment="Revised pixel mode mapping (charts are missing offsets for channels 1-9 in 2,3,4 and 6 pixel modes)" Version="2" />
  <History Date="09-01-19" Author="Nic Morris" Comment="Added remaining Atlabase ID's." Version="3" />
  <History Date="12-07-23" Author="Nic Morris" Comment="Updated in line with latest documentation (software &gt;=v1.5)" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5d79e765-df1f-45b7-a914-f9dd3319270d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Single Flash" Display="'Single Flash'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="1~5" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'Duration %.1f%%',0.0~100.0" Dmx="0~254" />
      <Function ID="2" Name="Hyper Flash" Display="'Hyper Flash'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shutter_Mode" Name="Shutter Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="3~4" />
      <Function ID="3" Name="Wash Alternative" Display="'Wash Alternative'" Dmx="5~5" />
      <Function ID="4" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="5" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="6" Name="Ramp Up/Down" Display="'Ramp Up/Down'" Dmx="86~128" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="8" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="9" Name="Spikes" Display="'Spikes'" Dmx="215~240" />
      <Function ID="10" Name="Burst" Display="'Burst'" Dmx="241~245" />
      <Function ID="11" Name="Solid+Rnd Pixel Strobe" Display="'Solid+Rnd Pixel Strobe'" Dmx="246~248" />
      <Function ID="12" Name="Burst+Rnd Pixel Strobe" Display="'Burst+Rnd Pixel Strobe'" Dmx="249~251" />
      <Function ID="13" Name="Single Flash Mode Normal" Display="'Single Flash Mode Normal'" Dmx="252~253" />
      <Function ID="14" Name="Single Flash Mode Always" Display="'Single Flash Mode Always'" Dmx="254~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">

  <AtlaBase TypeID="95347023-3cae-4b80-b656-50f47736f4b6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2000~8500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer_Change" Name="Dimmer Change" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT Adjustment" Display="'CCT Adjustment'" Dmx="0~0" />
      <Function ID="2" Name="Single Colour Dimmer" Display="'Single Colour Dimmer'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Jump" Display="'Col Jump'" Dmx="6~100" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="101~150" />
      <Function ID="4" Name="Strobe" Display="'Strobe'" Dmx="151~200" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="0f9d8735-9ed6-4242-8919-2a46e65f273a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

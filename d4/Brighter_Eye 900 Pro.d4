    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Opening" ID="2,3" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Rand Pixel Var" ID="4" If="'Shape'==12" />
      <Condition Name="Rainbow 1" ID="5" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21" />
      <Condition Name="Distribution" ID="6" If="'Shape'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="3" Name="Random Flash" Display="'Random Flash %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="4" Name="Pixel Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Index" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="6" Name="Rand Dist" Display="'%.f',2~20" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lens_Rot" Name="Lens Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CCW" Display="'Spin CCW %.1f',10.0~3.0" Dmx="128~190" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f',3.0~10.0" Dmx="193~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="FG_Strobe" Name="FG Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Strobe" Name="BG Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Select" Name="BG Select" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

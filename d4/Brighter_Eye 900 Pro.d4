    <Attribute ID="Shape" Name="Shape" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Shape" Display="'No Shape'" Dmx="0~0" Update="Shape_Speed, Shape_Offset" />
      <Function ID="2" Name="Ring 1" Display="'Ring 1'" Dmx="8~8" Update="Shape_Speed, Shape_Offset" />
      <Function ID="3" Name="Ring 2" Display="'Ring 2'" Dmx="9~9" Update="Shape_Speed, Shape_Offset" />
      <Function ID="4" Name="Ring 3" Display="'Ring 3'" Dmx="10~10" Update="Shape_Speed, Shape_Offset" />
      <Function ID="5" Name="Ring 1+2" Display="'Ring 1+2'" Dmx="12~12" Update="Shape_Speed, Shape_Offset" />
      <Function ID="6" Name="Ring 1+3" Display="'Ring 1+3'" Dmx="13~13" Update="Shape_Speed, Shape_Offset" />
      <Function ID="7" Name="Opening" Display="'Opening'" Dmx="15~15" Update="Shape_Speed, Shape_Offset" />
      <Function ID="8" Name="Opening Filled" Display="'Opening Filled'" Dmx="16~16" Update="Shape_Speed, Shape_Offset" />
      <Function ID="9" Name="Open/Close" Display="'Open/Close'" Dmx="17~17" Update="Shape_Speed, Shape_Offset" />
      <Function ID="10" Name="Open/Close Fill" Display="'Open/Close Fill'" Dmx="18~18" Update="Shape_Speed, Shape_Offset" />
      <Function ID="11" Name="Rand Pixel" Display="'Rand Pixel'" Dmx="19~19" Update="Shape_Speed, Shape_Offset" />
      <Function ID="12" Name="Rand Pixel Var" Display="'Rand Pixel Var'" Dmx="20~20" Update="Shape_Speed, Shape_Offset" />
      <Function ID="13" Name="Rainbow 1" Display="'Rainbow 1'" Dmx="21~21" Update="Shape_Speed, Shape_Offset" />
      <Function ID="14" Name="Rainbow 2" Display="'Rainbow 2'" Dmx="22~22" Update="Shape_Speed, Shape_Offset" />
      <Function ID="15" Name="Fan" Display="'Fan'" Dmx="23~23" Update="Shape_Speed, Shape_Offset" />
      <Function ID="16" Name="Bar" Display="'Bar'" Dmx="24~24" Update="Shape_Speed, Shape_Offset" />
      <Function ID="17" Name="Half Moon" Display="'Half Moon'" Dmx="25~25" Update="Shape_Speed, Shape_Offset" />
      <Function ID="18" Name="Triangle" Display="'Triangle'" Dmx="26~26" Update="Shape_Speed, Shape_Offset" />
      <Function ID="19" Name="Rot Bars" Display="'Rot Bars'" Dmx="27~27" Update="Shape_Speed, Shape_Offset" />
      <Function ID="20" Name="Rot Arcs" Display="'Rot Arcs'" Dmx="28~28" Update="Shape_Speed, Shape_Offset" />
      <Function ID="21" Name="Rot Arcs Col+Dir" Display="'Rot Arcs Col+Dir'" Dmx="29~29" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==11||'Shape'==12" />
      <Condition Name="Rainbow" ID="10,11,12,13" If="'Shape'==13||'Shape'==14" />
      <Condition Name="Speed" ID="14,15,16,17" If="'Shape'&gt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="8" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="11" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="12" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="13" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
      <Function ID="14" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="15" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="17" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
    </Attribute>

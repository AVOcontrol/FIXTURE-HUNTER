<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORado Batten 80i" ShortName="Batten 80i" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="16-09-08" Author="David Hunt" Comment="Created" />
  <History Date="10-10-08" Author="User" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="24-04-11" Author="Nic Morris" Comment="Added v-dim.  Standardised wheel mapping. Fixed power on and locate.  Increase wheel res." />
  <History Date="24-04-11" Author="Nic Morris" Comment="Added Control_Func to macros." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Removed Value and replaced with Dimmer for HTP.  Added pixel mapper compatibility" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Fixed STAGE 1 and 2 mode mapping.  Tidied up." />
  <History Date="21-08-16" Author="Nic Morris" Comment="Changed RGB and RGBW 8 bit modes to hidden." />
  <History Date="21-08-16" Author="Nic Morris" Comment="Renamed RGB+dim, 8bit mode to ARC 1+D, 4 DMX" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Renamed RGBW+dim, 8 bit to ARC 2+D, 5 DMX" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added ARC 1, ARC 2, PIXEL 1 and PIXEL 2 modes." />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="26-09-17" Author="Nic Morris" Comment="Changed name from Colorado Batten 80i to COLORado Batten 80i" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Revised colour macro white temp function names (previously all started 'White1:')" />
  <History Date="26-09-17" Author="Nic Morris" Comment="Shortened Module Select and Mod/Col Select attribute names to comply with 14char limit." />
  <History Date="25-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c380c411-47e6-4934-a3af-a694d466e54a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

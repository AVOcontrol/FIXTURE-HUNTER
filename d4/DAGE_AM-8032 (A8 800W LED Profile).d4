      <Function ID="20" Name="Blu - Yel" Display="'Blu - Yel %.f%%',0~100" Dmx="60~80" WheelPosition="3" Colour="0,0,255" />
      <Function ID="21" Name="Yel - B Grn" Display="'Yel - B Grn %.f%%',0~100" Dmx="80~100" WheelPosition="4" Colour="255,255,0" />
      <Function ID="22" Name="B Grn - Pk" Display="'B Grn - Pk %.f%%',0~100" Dmx="100~120" WheelPosition="5" Colour="0,255,200" />
      <Function ID="23" Name="Pk - Org" Display="'Pk - Org %.f%%',0~100" Dmx="120~140" WheelPosition="6" Colour="255,150,150" />
      <Function ID="24" Name="Org - Op" Display="'Org - Op %.f%%',0~100" Dmx="140~159" WheelPosition="7" Colour="255,128,0" />
      <Function ID="25" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~160" Colour="0,0,0" />

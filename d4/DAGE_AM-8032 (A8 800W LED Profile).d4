      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="70~70" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ B Grn" Display="'Yel/ B Grn'" Dmx="90~90" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="B Grn/ Pk" Display="'B Grn/ Pk'" Dmx="110~110" WheelPosition="5" Colour="0,255,200" />

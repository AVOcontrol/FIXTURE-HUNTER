    <Attribute ID="Sync_Rot" Name="Sync Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~19" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="0 deg Offset" Display="'0 deg Offset'" Dmx="20~39" Iris="0~0" Zoom="0~0" />

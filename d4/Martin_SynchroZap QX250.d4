      <Function ID="15" Name="Mag/ L Bl" Display="'Mag/ L Bl'" Dmx="81~89" WheelPosition="4" Colour="255,0,255" />
      <Function ID="16" Name="L Bl/ Grn" Display="'L Bl/ Grn'" Dmx="99~107" WheelPosition="5" Colour="0,128,255" />
      <Function ID="17" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="117~125" WheelPosition="6" Colour="0,255,0" />
      <Function ID="18" Name="Org/ Bl" Display="'Org/ Bl'" Dmx="135~143" WheelPosition="7" Colour="255,128,0" />
      <Function ID="19" Name="Bl/ D Org" Display="'Bl/ D Org'" Dmx="153~161" WheelPosition="8" Colour="0,0,255" />
      <Function ID="20" Name="D Org/ Op" Display="'D Org/ Op'" Dmx="171~179" WheelPosition="9" Colour="255,100,0" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="180~187" Colour="255,255,255" />
      <Function ID="22" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="188~237" Colour="0,0,0" />
      <Function ID="23" Name="Open" Display="'Open'" Dmx="238~248" Colour="255,255,255" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="249~255" Colour="255,255,255" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />

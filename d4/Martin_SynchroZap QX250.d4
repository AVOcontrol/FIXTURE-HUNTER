      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="249~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Drum_1_Rot" Name="Drum 1 Rot" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~2" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="90~176" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="177~209" Iris="0~0" Zoom="0~0" />

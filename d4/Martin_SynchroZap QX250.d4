  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:9,Colour1Func:1,Colour1:7,Gobo1Func:1,Gobo1:10" Delay="6000" />
      <Set Channel="Shutter:2,Colour1:1,Gobo1:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Shutter:7" Delay="6000" />
      <Set Channel="Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Shutter:8" Delay="6000" />
      <Set Channel="Shutter:2" Delay="0" />
    </Macro>
  </Macro>

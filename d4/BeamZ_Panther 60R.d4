      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="10" Wheel="7" />
      <Attribute ID="Effect" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
      <Attribute ID="Lamp_Strip_FX" ChannelOffset="13" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="15 DMX" Channels="15" Id="656dfc70-8d7f-4698-a59c-32e963288fa6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />

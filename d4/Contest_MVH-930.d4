      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:9,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:3,Colour1Func:1" />

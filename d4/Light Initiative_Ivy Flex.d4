    <Attribute ID="Preset_FX_Func" Name="Preset FX Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Preset_FX" />
      <Function ID="2" Name="1 Col Paparazzi Snap" Display="'1 Col Paparazzi Snap'" Dmx="0~0" Update="Preset_FX" />

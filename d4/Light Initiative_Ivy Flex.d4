      <Function ID="2" Name="Pause if PAP" Display="'Pause if PAP'" Dmx="1~1" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Index" Name="Index" Description="" Group="E">

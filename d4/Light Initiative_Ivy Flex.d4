  <Control>
    <Attribute ID="Modes" Name="Modes" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="(L1 Mix L2) HTP L3" Display="'(L1 Mix L2) HTP L3'" Dmx="0~0" />
      <Function ID="2" Name="(L1 Mix L2) Trans L3" Display="'(L1 Mix L2) Trans L3'" Dmx="29~57" />
      <Function ID="3" Name="(L1 Mix L2) Mix L3" Display="'(L1 Mix L2) Mix L3'" Dmx="58~85" />

  <History Date="15-11-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="10-06-25" Author="Nic Morris" Comment="Corrected 7 channel mode mapping.  Corrected colour macro functions.  Corrected program functions." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a54fc8a2-bb9d-4df7-8247-2af748501ec6" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Linear_Strobe" Name="Linear Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Random_Strobe" Name="Random Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="All WW" Display="'All WW'" Dmx="11~23" Colour="255,255,255" />
      <Function ID="3" Name="All Amber" Display="'All Amber'" Dmx="24~36" Colour="255,255,255" />
      <Function ID="4" Name="1 WW/ 2 A" Display="'1 WW/ 2 A'" Dmx="37~49" Colour="255,255,255" />
      <Function ID="5" Name="1 A/ 2 WW" Display="'1 A/ 2 WW'" Dmx="50~62" Colour="255,255,255" />
      <Function ID="6" Name="All WW+A" Display="'All WW+A'" Dmx="63~75" Colour="255,255,255" />
      <Function ID="7" Name="All Red" Display="'All Red'" Dmx="76~88" Colour="255,0,0" />
      <Function ID="8" Name="All Green" Display="'All Green'" Dmx="89~101" Colour="0,255,0" />
      <Function ID="9" Name="All Blue" Display="'All Blue'" Dmx="102~114" Colour="0,0,255" />
      <Function ID="10" Name="All Orange" Display="'All Orange'" Dmx="115~127" Colour="255,128,0" />
      <Function ID="11" Name="All Medium Yellow" Display="'All Medium Yellow'" Dmx="128~140" Colour="255,255,0" />
      <Function ID="12" Name="All Yellow" Display="'All Yellow'" Dmx="141~153" Colour="255,255,0" />
      <Function ID="13" Name="All Magenta" Display="'All Magenta'" Dmx="154~166" Colour="255,0,255" />
      <Function ID="14" Name="All Hot Pink" Display="'All Hot Pink'" Dmx="167~179" Colour="255,150,150" />
      <Function ID="15" Name="All Cyan" Display="'All Cyan'" Dmx="180~192" Colour="0,255,255" />
      <Function ID="16" Name="All Coral" Display="'All Coral'" Dmx="193~205" Colour="255,255,255" />
      <Function ID="17" Name="All Mint Green" Display="'All Mint Green'" Dmx="206~218" Colour="128,255,0" />
      <Function ID="18" Name="All Lilac" Display="'All Lilac'" Dmx="219~231" Colour="180,0,255" />
      <Function ID="19" Name="All Dark Yellow" Display="'All Dark Yellow'" Dmx="232~244" Colour="180,180,0" />
      <Function ID="20" Name="All White (RGB)" Display="'All White (RGB)'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 2" Display="'Program 2'" Dmx="16~30" />
      <Function ID="3" Name="Program 3" Display="'Program 3'" Dmx="31~45" />
      <Function ID="4" Name="Program 4" Display="'Program 4'" Dmx="46~60" />
      <Function ID="5" Name="Program 5" Display="'Program 5'" Dmx="61~75" />
      <Function ID="6" Name="Program 6" Display="'Program 6'" Dmx="76~90" />
      <Function ID="7" Name="Program 7" Display="'Program 7'" Dmx="91~105" />
      <Function ID="8" Name="Program 8" Display="'Program 8'" Dmx="106~120" />
      <Function ID="9" Name="Program 9" Display="'Program 9'" Dmx="121~135" />
      <Function ID="10" Name="Program 10" Display="'Program 10'" Dmx="136~150" />
      <Function ID="11" Name="Program 11" Display="'Program 11'" Dmx="151~165" />
      <Function ID="12" Name="Program 12" Display="'Program 12'" Dmx="166~180" />
      <Function ID="13" Name="Program 13" Display="'Program 13'" Dmx="181~195" />
      <Function ID="14" Name="Program 14" Display="'Program 14'" Dmx="196~210" />
      <Function ID="15" Name="Program 15" Display="'Program 15'" Dmx="211~225" />
      <Function ID="16" Name="Program 16" Display="'Program 16'" Dmx="226~240" />
      <Function ID="17" Name="Program 17" Display="'Program 17'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Halogen_Master" Name="Halogen Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Back_Master" Name="Back Master" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

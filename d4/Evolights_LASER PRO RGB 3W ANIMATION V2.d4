      <Function ID="14" Name="Col Dynamic Eotic 5" Display="'Col Dynamic Eotic 5'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="15" Name="Col Dynamic Eotic 6" Display="'Col Dynamic Eotic 6'" Dmx="250~255" Colour="255,255,255" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Eotic_Spd" Name="Col Eotic Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Eotic" Display="'No Eotic'" Dmx="0~0" Colour="255,255,255" />

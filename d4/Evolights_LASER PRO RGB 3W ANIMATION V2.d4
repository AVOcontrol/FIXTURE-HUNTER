  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Col_Control" Name="Col Control" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fixed Col" Display="'Fixed Col %.f%%',0~100" Dmx="0~69" Colour="255,255,255" />
      <Function ID="2" Name="Col Change" Display="'Col Change'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="3" Name="Default Col" Display="'Default Col'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="4" Name="Rainbow Col" Display="'Rainbow Col'" Dmx="90~94" Colour="255,255,255" />
      <Function ID="5" Name="2-Segment Col Selection 5 Numerical Steps" Display="'2-Segment Col Selection 5 Numerical Steps'" Dmx="95~114" Colour="255,255,255" />
      <Function ID="6" Name="3-Segment Col Selection 5 Numerical Steps" Display="'3-Segment Col Selection 5 Numerical Steps'" Dmx="115~139" Colour="255,255,255" />
      <Function ID="7" Name="4-Segment Col Selection 5 Numerical Steps" Display="'4-Segment Col Selection 5 Numerical Steps'" Dmx="140~164" Colour="255,255,255" />
      <Function ID="8" Name="8-Segment Col Selection 5 Numerical Steps" Display="'8-Segment Col Selection 5 Numerical Steps'" Dmx="165~189" Colour="255,255,255" />
      <Function ID="9" Name="16-Segment Col Selection 5 Numerical Steps" Display="'16-Segment Col Selection 5 Numerical Steps'" Dmx="190~224" Colour="255,255,255" />
      <Function ID="10" Name="Col Dynamic Eotic 1" Display="'Col Dynamic Eotic 1'" Dmx="225~229" Colour="255,255,255" />
      <Function ID="11" Name="Col Dynamic Eotic 2" Display="'Col Dynamic Eotic 2'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="12" Name="Col Dynamic Eotic 3" Display="'Col Dynamic Eotic 3'" Dmx="235~239" Colour="255,255,255" />

      <Function ID="10" Name="Reset Colour" Display="'Reset Colour'" Dmx="120~129" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="130~139" />
      <Function ID="12" Name="Reset Prism" Display="'Reset Prism'" Dmx="150~159" />

    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="21~127" Update="Prism_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="128~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="2" If="'Prism'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==3" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="40~49" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="50~59" />

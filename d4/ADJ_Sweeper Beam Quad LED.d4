      <Function ID="6" Name="30-210 deg" Display="'30-210 deg'" Dmx="152~187" />
      <Function ID="7" Name="0-90 deg" Display="'0-90 deg'" Dmx="188~223" />
      <Function ID="8" Name="90-180 deg" Display="'90-180 deg'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Tilt_Macro_Spd" Name="Tilt Macro Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />

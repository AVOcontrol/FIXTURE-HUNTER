  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d6410c21-45a9-4332-8308-3034f3144a79" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="225~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="226~235" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="80~95" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="96~111" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="112~127" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="128~143" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="144~159" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="160~175" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="176~191" />
      <Function ID="13" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="192~207" />
      <Function ID="14" Name="Jump" Display="'Jump'" Dmx="208~223" />
      <Function ID="15" Name="Fade" Display="'Fade'" Dmx="224~239" />
      <Function ID="16" Name="Auto" Display="'Auto'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />
      <Function ID="4" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="97~99" />
      <Function ID="5" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="6" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="7" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="8" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="9" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="10" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="11" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
  </Control>
  <Mode Name="16bit, 15 DMX" Channels="15">

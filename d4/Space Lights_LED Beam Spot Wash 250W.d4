    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="3,4,5,6" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="7" />

    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,5" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="6" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="12" Wheel="8" />
      <Attribute ID="UV" ChannelOffset="13" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />

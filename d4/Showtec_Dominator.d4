  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="16" PowerOn="16" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~24" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="25~39" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="40~54" />

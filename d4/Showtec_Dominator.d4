      <Function ID="34" Name="2 Col Auto" Display="'2 Col Auto'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Derby_Col_Spd" Name="Derby Col Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="LED_Shutter" Name="LED Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~6" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~254" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="LED_Control" Name="LED Control" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1 %.f%%',0~100" Dmx="10~19" Intensity="0~0" />
      <Function ID="3" Name="Program 2" Display="'Program 2 %.f%%',0~100" Dmx="20~29" Intensity="0~0" />
      <Function ID="4" Name="Program 3" Display="'Program 3 %.f%%',0~100" Dmx="30~39" Intensity="0~0" />
      <Function ID="5" Name="Program 4" Display="'Program 4 %.f%%',0~100" Dmx="40~49" Intensity="0~0" />
      <Function ID="6" Name="Program 5" Display="'Program 5 %.f%%',0~100" Dmx="50~59" Intensity="0~0" />
      <Function ID="7" Name="Program 6" Display="'Program 6 %.f%%',0~100" Dmx="60~69" Intensity="0~0" />
      <Function ID="8" Name="Program 7" Display="'Program 7 %.f%%',0~100" Dmx="70~79" Intensity="0~0" />
      <Function ID="9" Name="Program 8" Display="'Program 8 %.f%%',0~100" Dmx="80~89" Intensity="0~0" />
      <Function ID="10" Name="Program 9" Display="'Program 9 %.f%%',0~100" Dmx="90~99" Intensity="0~0" />
      <Function ID="11" Name="Program 10" Display="'Program 10 %.f%%',0~100" Dmx="100~109" Intensity="0~0" />
      <Function ID="12" Name="All on" Display="'All on'" Dmx="110~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" />
      <Function ID="4" Name="R+G Alt" Display="'R+G Alt'" Dmx="90~129" />
      <Function ID="5" Name="G Strobe + R" Display="'G Strobe + R'" Dmx="130~169" />
      <Function ID="6" Name="R Strobe + G" Display="'R Strobe + G'" Dmx="170~209" />
      <Function ID="7" Name="R+G Sync" Display="'R+G Sync'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Laser_Shutter" Name="Laser Shutter" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~4" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~254" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Derby_Rot" Name="Derby Rot" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" Colour="255,255,255" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',0.0~100.0" Dmx="5~254" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~4" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="SHDOMNTR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="LED_Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="LED_Control" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Derby_Col" ChannelOffset="2" Wheel="7" />
      <Attribute ID="Derby_Col_Spd" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Derby_Rot" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Laser" ChannelOffset="6" Wheel="22" />
      <Attribute ID="Laser_Shutter" ChannelOffset="7" Wheel="24" />
      <Attribute ID="Laser_Rot" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~116" Colour="255,255,255" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="117~128" Colour="255,255,255" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="129~140" Colour="255,255,255" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="141~152" Colour="255,255,255" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="153~164" Colour="255,255,255" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="165~176" Colour="255,255,255" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="177~188" Colour="255,255,255" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="189~200" Colour="255,255,255" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="201~212" Colour="255,255,255" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="213~224" Colour="255,255,255" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="225~236" Colour="255,255,255" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="237~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~21" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="22~34" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="35~47" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="48~60" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~73" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="74~86" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="87~99" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="100~112" />

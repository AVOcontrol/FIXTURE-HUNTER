      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="152~164" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="165~177" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="178~190" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="191~203" />

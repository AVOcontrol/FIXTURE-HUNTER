      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="71~132" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="133~194" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="195~255" />
    </Attribute>
  </Control>

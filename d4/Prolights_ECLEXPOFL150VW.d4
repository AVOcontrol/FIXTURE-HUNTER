    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',2700.0~6500.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="C">

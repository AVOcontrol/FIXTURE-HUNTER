  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3180e041-c3f7-4426-b521-b2e2fa86bf9a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="10" Name="R+W" Display="'R+W'" Dmx="90~99" Colour="255,255,255" />
      <Function ID="11" Name="R+A" Display="'R+A'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="12" Name="R+UV" Display="'R+UV'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="G+B" Display="'G+B'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="G+W" Display="'G+W'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="G+A" Display="'G+A'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="G+UV" Display="'G+UV'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="R+G+B" Display="'R+G+B'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="18" Name="G+B+W" Display="'G+B+W'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="19" Name="B+W+A" Display="'B+W+A'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="20" Name="W+A+UV" Display="'W+A+UV'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="21" Name="A+UV+R" Display="'A+UV+R'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="22" Name="R+B+W+UV" Display="'R+B+W+UV'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="23" Name="R+G+W+UV" Display="'R+G+W+UV'" Dmx="220~229" Colour="255,255,255" />
      <Function ID="24" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="230~239" Colour="255,255,255" />
      <Function ID="25" Name="G+B+W+UV" Display="'G+B+W+UV'" Dmx="240~249" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W+A+UV" Display="'R+G+B+W+A+UV'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="10~119" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="120~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

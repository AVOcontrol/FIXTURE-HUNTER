  <AtlaBase TypeID="c19808da-7e01-409d-bf5f-c215b6a0a652" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Strobe" Display="'No Strobe'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.1fms',1.0~20.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Strobe Speed" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Response_Time" Name="Response Time" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Tungsten" Display="'%fW',500~5000" Dmx="1~127" />
      <Function ID="3" Name="Linear" Display="'Linear %.1f Sec',0.0~4.0" Dmx="128~191" />
      <Function ID="4" Name="Linear (Flash bypass)" Display="'Linear (Flash bypass) %.1f Sec',0.0~4.0" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="RDM Off" Display="'RDM Off'" Dmx="1~10" />
      <Function ID="3" Name="RDM On" Display="'RDM On'" Dmx="11~20" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="21~30" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="31~40" />
      <Function ID="6" Name="Dim Square" Display="'Dim Square'" Dmx="41~50" />
      <Function ID="7" Name="Dim Tungsten" Display="'Dim Tungsten'" Dmx="51~60" />
      <Function ID="8" Name="Col Space Native" Display="'Col Space Native'" Dmx="61~70" />
      <Function ID="9" Name="Col Space sRGB/ Rec. 709" Display="'Col Space sRGB/ Rec. 709'" Dmx="71~80" />
      <Function ID="10" Name="Col Space Rec. 2020" Display="'Col Space Rec. 2020'" Dmx="81~90" />
      <Function ID="11" Name="Col Space ProPhoto RGB" Display="'Col Space ProPhoto RGB'" Dmx="91~100" />
      <Function ID="12" Name="Fan Silent" Display="'Fan Silent'" Dmx="101~110" />
      <Function ID="13" Name="Fan Normal" Display="'Fan Normal'" Dmx="111~120" />
      <Function ID="14" Name="Fan Full" Display="'Fan Full'" Dmx="121~130" />
    </Attribute>
    <Attribute ID="Source_Type" Name="Source Type" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Tungsten 3200K High Quality - DimShift" Display="'Tungsten 3200K High Quality - DimShift'" Dmx="0~0" />
      <Function ID="2" Name="Tungsten 3000K High Quality - DimShift" Display="'Tungsten 3000K High Quality - DimShift'" Dmx="11~20" />
      <Function ID="3" Name="Tungsten 3200K High Quality" Display="'Tungsten 3200K High Quality'" Dmx="21~30" />
      <Function ID="4" Name="Tungsten 3000K High Quality" Display="'Tungsten 3000K High Quality'" Dmx="31~40" />

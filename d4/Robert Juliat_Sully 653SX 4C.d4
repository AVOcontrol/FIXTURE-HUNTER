    <Attribute ID="Gel_Saturation" Name="Gel Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Trans" Name="Gel Trans" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Transmission" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_Fade_Time" Name="Gel Fade Time" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0s" Display="'0s'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Fade Time" Display="'Fade Time %.fms',100~25500" Dmx="1~255" WheelPosition="0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel_Fade_Mode" Name="Gel Fade Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Direct XY+Limit Brightness" Display="'Direct XY+Limit Brightness'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Direct XY" Display="'Direct XY'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="Open Frame+Limit Brightness" Display="'Open Frame+Limit Brightness'" Dmx="21~30" Colour="0,0,0" />
      <Function ID="4" Name="Open Frame" Display="'Open Frame'" Dmx="31~40" Colour="0,0,0" />
      <Function ID="5" Name="Through Black" Display="'Through Black'" Dmx="41~50" Colour="0,0,0" />
      <Function ID="6" Name="Reserved/ Off (0s)" Display="'Reserved/ Off (0s)'" Dmx="51~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:1700" PowerOn="1:1700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.1fK',1700.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="DeltaUV" Name="DeltaUV" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="+ Mag" Display="'+ Mag %.1f%%',100.0~0.0" Dmx="0~126" Colour="0,0,0" />

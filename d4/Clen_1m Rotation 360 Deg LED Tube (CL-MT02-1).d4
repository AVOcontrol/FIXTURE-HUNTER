  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotation_Spd" Name="Rotation Spd" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="16~31" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="32~47" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="48~63" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="64~79" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="80~95" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="96~111" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="112~127" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="128~143" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="144~159" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="160~175" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="176~191" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="192~207" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="208~223" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="224~239" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',0.0~100.0" Dmx="255~129" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="127~128" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="126~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="16~31" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="32~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

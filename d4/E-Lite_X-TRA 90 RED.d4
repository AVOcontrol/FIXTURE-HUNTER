  <AtlaBase TypeID="375fe4ed-5bf7-4549-bd01-0c07b1930a60" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="31~90" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="181~240" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="106~165" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="11~26" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="27~32" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="33~48" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="49~64" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="65~80" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="81~96" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="97~112" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="113~128" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="129~144" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="145~160" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="161~176" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="177~192" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="193~208" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="209~224" />
      <Function ID="16" Name="Auto 1" Display="'Auto 1'" Dmx="225~240" />
      <Function ID="17" Name="Auto 2" Display="'Auto 2'" Dmx="241~250" />
      <Function ID="18" Name="Reset" Display="'Reset'" Dmx="251~255" />

    <Attribute ID="Reflector_Rot" Name="Reflector Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~90" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="91~120" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="121~127" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="190~128" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="191~192" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Drum Swivel" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~120" />
      <Function ID="2" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="121~127" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Wide Shk" Display="'Wide Shk %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Drum Rot" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'Tilt %.f%%',0~100" Dmx="0~90" />
      <Function ID="2" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="91~120" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="121~127" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="190~128" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>

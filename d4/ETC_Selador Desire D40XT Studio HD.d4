    <Attribute ID="Warm_White_Adj" Name="Warm White Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',100.0~0.0" Dmx="0~127" Colour="255,255,255" />

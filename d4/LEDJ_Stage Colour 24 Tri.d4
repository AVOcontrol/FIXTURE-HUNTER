  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~10" Colour="0,0,0" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="11~21" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="22~32" Colour="255,0,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="33~43" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="44~54" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="55~65" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="66~76" Colour="0,0,255" />

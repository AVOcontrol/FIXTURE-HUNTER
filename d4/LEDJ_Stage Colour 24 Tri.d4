      <Function ID="10" Name="Dream" Display="'Dream'" Dmx="99~109" Colour="0,0,0" />
      <Function ID="11" Name="Meteor" Display="'Meteor'" Dmx="110~120" Colour="0,0,0" />
      <Function ID="12" Name="Fade" Display="'Fade'" Dmx="121~131" Colour="0,0,0" />
      <Function ID="13" Name="Change" Display="'Change'" Dmx="132~142" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Equinox Fusion 100 Spot MKII" ShortName="Fsn 100 v2" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>a8af4ec9-cc82-492c-b73a-8ca34d869ed1</Thumbnail>
  <History Date="02-02-17" Author="Nic Morris" Comment="Created" />
  <History Date="14-02-18" Author="Nic Morris" Comment="Created from Prolight Equinox Fusion 100" />
  <History Date="15-02-18" Author="Nic Morris" Comment="Changed name from Equinox Fusion Spot MKII to Equinox Fusion 100 Spot MKII (conflicted)" />
  <History Date="15-02-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c7e76bf0-8232-49a1-ad3c-d8a12808114e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~245" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~31" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~49" Colour="255,255,0" />
      <Function ID="4" Name="Cyan" Display="'Cyan'" Dmx="50~67" Colour="0,255,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="68~85" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="86~103" Colour="255,128,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="104~121" Colour="255,0,255" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="122~130" Colour="0,0,255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="131~139" Colour="255,255,255" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="140~195" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'Gobo1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>9aedb648-7e4a-4bf6-a032-92afc20c48a2</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="9~33" WheelPosition="1">
        <Swatch>cb44afe7-a42e-48d3-9ff5-56fac5e579a4</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="34~58" WheelPosition="2">
        <Swatch>8d8d72a6-c6c1-40e4-aaa3-6b1ffac40e75</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="59~83" WheelPosition="3">
        <Swatch>3cc183b5-98a7-40aa-945e-5d94d18541f1</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="84~108" WheelPosition="4">
        <Swatch>f41650d5-c862-464e-9aab-f5caa610a794</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="109~133" WheelPosition="5">
        <Swatch>c41855ee-46d2-4086-9a6d-d299e85d5ea3</Swatch>
      </Function>
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="134~194" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="195~255" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="130~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="LED_Macro" Name="LED Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~47" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="48~87" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="88~127" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="128~167" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="168~207" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="208~247" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~58" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="59~110" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="111~162" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="163~240" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="High Speed" Display="'High Speed'" Dmx="51~100" />
      <Function ID="3" Name="Low Speed" Display="'Low Speed'" Dmx="151~200" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="PTEQ1021" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="15acb97f-5ae8-4eae-af59-c80087916979" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="LED_Macro" ChannelOffset="3" Wheel="23" />
      <Attribute ID="P/T_Macro" ChannelOffset="4" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="PTEQ1022" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="40fb655e-9278-445f-94f1-6b5404a6cb82" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="10" Wheel="15" />
      <Attribute ID="Focus" ChannelOffset="11" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="12" Wheel="22" />
      <Attribute ID="LED_Macro" ChannelOffset="13" Wheel="23" />
      <Attribute ID="P/T_Macro" ChannelOffset="14" Wheel="24" />

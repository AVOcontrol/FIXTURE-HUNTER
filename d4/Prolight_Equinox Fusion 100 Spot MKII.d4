    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="PTEQ1023" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="210" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6f770ce5-5d62-4d17-870a-102e4d901ad8" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />

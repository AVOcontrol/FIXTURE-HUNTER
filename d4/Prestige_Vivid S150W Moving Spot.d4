      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="3,4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5,6" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Colour2" ChannelOffset="12" Wheel="38" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="8" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="9" Wheel="15" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Gobo2" ChannelOffset="10" Wheel="17" />
      <Attribute ID="Iris" ChannelOffset="13" Wheel="21" />
      <Attribute ID="Zoom" ChannelOffset="14" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="15" Wheel="20" />
      <Attribute ID="Frost" ChannelOffset="17" Wheel="49" />
      <Attribute ID="Prism" ChannelOffset="16" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Move_in_Dark" ChannelOffset="18" Wheel="29" />

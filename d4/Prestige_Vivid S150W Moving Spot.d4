      <Attribute ID="Iris" ChannelOffset="11" Wheel="21" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="13" Wheel="20" />
      <Attribute ID="Frost" ChannelOffset="15" Wheel="49" />
      <Attribute ID="Prism" ChannelOffset="14" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Move_in_Dark" ChannelOffset="16" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="UKPSS152" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

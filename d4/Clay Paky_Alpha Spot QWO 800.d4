<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot QWO 800" ShortName="ASpQWO 800" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ae033d35-3b64-42e0-bf54-ffb438edba7a</Thumbnail>
  <History Date="07-04-09" Author="David Hunt" Comment="Created" />
  <History Date="14-05-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="09-06-09" Author="David Hunt" Comment="Updated Shutter and Colour channels" />
  <History Date="08-06-10" Author="John Rogers" Comment="Edited 16bit Gobo Rotation functions to the appropriate number of decimal places." />
  <History Date="02-02-11" Author="John Rogers" Comment="Edited Reset in response to Clay Paky tech update." />
  <History Date="16-01-12" Author="Peter Budd" Comment="Created from Clay Paky 700 HPE" />
  <History Date="04-01-13" Author="Peter Budd" Comment="Made the colour macro func virtual in the 36 DMX mode, corrected iris and speed ranges." />
  <History Date="09-04-13" Author="John Rogers" Comment="Edited fixed Colour values to hit exact DMX values after feedback from Neg Earth." />
  <History Date="09-04-13" Author="John Rogers" Comment="Edited Autofocus to locate at 0%." />
  <History Date="04-06-15" Author="Nic Morris" Comment="Fixed typo on Animation Rot.  Changed AutoFocus Adj to locate at DMX 0 in attempt to fix customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="08-08-16" Author="Nic Morris" Comment="Changed Atlabase mode ID's to CMY versions." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Tidied colour function ID order.  Increased wheel resolution." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Renamed colour func spin to scroll.  Changed shutter Rnd Fast Strobe from percentage to text only." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Standardised conditionals.  Added function index's.  Simplified prism." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Removed macro func as it had no purpose.  Revised macro function names." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Revised animation, autofocus dist and time attribute functions.  Aligned attribute group ID's with wheel slots." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly.  Added physical pan/tilt limits." />
  <History Date="26-06-17" Author="Nic Morris" Comment="Added random range to colour macro.  Added function control macros." />
  <History Date="14-02-19" Author="Nic Morris" Comment="Added product thumbnail.  Added RDM ID's." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="17232" ModelID="384" />

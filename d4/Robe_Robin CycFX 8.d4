<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin CycFX 8" ShortName="CycFX8" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>5f2566d5-fffe-47e1-9871-4d1699298f6e</Thumbnail>
  <History Date="24-10-13" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="10-04-14" Author="Nic Morris" Comment="Added master RGB and dimmer attributes in attempt to fix manufacturer multi-cell locate bug report." />
  <History Date="13-05-14" Author="Nic Morris" Comment="Changed master dimmer, master red, master green and master blue to default to zero in attempt to fix customer bug report." />
  <History Date="14-06-15" Author="Nic Morris" Comment="Added modes 5 and 6 in line with latest documentation in response to customer bug report." />
  <History Date="13-10-15" Author="Nic Morris" Comment="Added mode 7 in response to manufacturer request and in line with v1.4 spec." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="27-08-18" Author="Nic Morris" Comment="Added missing Atlabase ID's to modes 5, 6 and 7.  Added product thumbnail." />
  <History Date="03-10-18" Author="Nic Morris" Comment="Added vdim to mode 3 and mode 6 cells." />
  <History Date="05-03-19" Author="Nic Morris" Comment="Standardised control function names across product range.  Changed P/T Speed to Tilt Speed." />
  <History Date="05-03-19" Author="Nic Morris" Comment="Simplified and standardised colour macro across product range.  Added shutter and zoom palettes." />
  <Manual Filename="" Summary="" />

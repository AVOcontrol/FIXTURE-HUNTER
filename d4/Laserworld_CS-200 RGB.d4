<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CS-200 RGB" ShortName="CS-200 RGB" Company="Laserworld">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="23-09-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Control" Description="" Group="S">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~70" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="71~142" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="143~214" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~32" Colour="255,255,255" />
      <Function ID="2" Name="Green/Blue" Display="'Green/Blue'" Dmx="33~64" Colour="0,255,255" />
      <Function ID="3" Name="Red/Blue" Display="'Red/Blue'" Dmx="65~97" Colour="255,0,255" />
      <Function ID="4" Name="Red/Green" Display="'Red/Green'" Dmx="98~130" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="131~162" Colour="0,0,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="163~195" Colour="255,0,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="196~228" Colour="0,255,0" />
      <Function ID="8" Name="Audio" Display="'Audio'" Dmx="229~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Rotate_X" Name="Rotate X" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X Rot" Display="'X Rot %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate_Y" Name="Rotate Y" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y Rot" Display="'Y Rot %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate_Z" Name="Rotate Z" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Z Rot" Display="'Z Rot %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX, 8bit" Channels="11">
    <Import PearlRef="LZ_CS200RGB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Gobo1Rot" ChannelOffset="3" Wheel="15" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Display_Mode" ChannelOffset="4" Wheel="29" />
      <Attribute ID="Rotate_X" ChannelOffset="9" Wheel="25" />
      <Attribute ID="Rotate_Y" ChannelOffset="10" Wheel="26" />
      <Attribute ID="Rotate_Z" ChannelOffset="11" Wheel="27" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6" />
      <Palette ID="3" Name="Red/Green" Number="3" Page="1" SetControl="Colour1:4" />
      <Palette ID="4" Name="Red/Green" Number="4" Page="1" SetControl="Colour1:4" />
      <Palette ID="5" Name="Red/Green" Number="0" Page="1" SetControl="Colour1:4" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:7" />
      <Palette ID="7" Name="Green/Blue" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="8" Name="Green/Blue" Number="6" Page="1" SetControl="Colour1:2" />
      <Palette ID="9" Name="Green/Blue" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:5" />
      <Palette ID="11" Name="Red/Blue" Number="9" Page="1" SetControl="Colour1:3" />
      <Palette ID="12" Name="Red/Blue" Number="10" Page="1" SetControl="Colour1:3" />
      <Palette ID="13" Name="Red/Blue" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="14" Name="Red/Blue" Number="8" Page="1" SetControl="Colour1:3" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="812a387e-d596-4bca-a764-8102d557deda" />
  <Control>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red" Display="'Red %.f%%',0~100" Dmx="0~85" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green %.f%%',0~100" Dmx="86~170" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="171~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer 0-100" Display="'Dimmer 0-100 %.f%%',0~100" Dmx="0~80" />
      <Function ID="2" Name="Dimmer 100-0" Display="'Dimmer 100-0 %.f%%',0~100" Dmx="81~160" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="161~240" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="White_Strobe_1" Name="White Strobe 1" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />

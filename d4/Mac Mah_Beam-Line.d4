        <Attribute ID="Beam_FX" ChannelOffset="15" Wheel="22" />
        <Attribute ID="Beam_FX_Spd" ChannelOffset="16" Wheel="23" />
        <Attribute ID="Halo_Shutter" ChannelOffset="17" Wheel="6" />

    </Physical>
    <AtlaBase ModeID="dabc2cff-5c4a-42e1-8497-13bc0e3d68a5" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />

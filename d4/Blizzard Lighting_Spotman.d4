  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ea6b36e3-3752-4e80-b869-4b640f8e5dbd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Orange" Display="'Orange'" Dmx="10~19" WheelPosition="1" Colour="255,128,0" />
      <Function ID="3" Name="Cyan" Display="'Cyan'" Dmx="20~29" WheelPosition="2" Colour="0,255,255" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="30~39" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~49" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="50~59" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="60~69" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="70~79" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Org/ Cy" Display="'Org/ Cy'" Dmx="80~89" WheelPosition="1" Colour="255,128,0" />
      <Function ID="11" Name="Cy/ Mag" Display="'Cy/ Mag'" Dmx="90~99" WheelPosition="2" Colour="0,255,255" />
      <Function ID="12" Name="Mag/ Yel" Display="'Mag/ Yel'" Dmx="100~109" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="110~119" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="120~129" WheelPosition="5" Colour="0,255,0" />
      <Function ID="15" Name="Blu/ Rd" Display="'Blu/ Rd'" Dmx="130~139" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="140~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>3a0cbf58-5f60-4644-ba33-8764790a3b15</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~15" WheelPosition="1">
        <Swatch>12a6e272-d318-4b38-8591-82af31c4fa30</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="16~23" WheelPosition="2">
        <Swatch>c77005a7-e7c5-442a-92dd-1f4b88d31193</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~31" WheelPosition="3">
        <Swatch>4aba4c99-4781-454d-be1e-9e7395e3f4ce</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="32~39" WheelPosition="4">
        <Swatch>6a16da19-5e8c-447b-9142-c13b523ffde1</Swatch>

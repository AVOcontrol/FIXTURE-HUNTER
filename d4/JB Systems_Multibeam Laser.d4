  <History Date="21-05-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~35" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="36~55" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="56~75" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="76~95" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="96~115" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="116~135" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="136~155" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="156~175" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="176~195" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="196~215" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="216~235" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="236~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~200" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~169" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="170~209" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="210~255" />
    </Attribute>
    <Attribute ID="X-Roll" Name="X-Roll" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Y-Roll" Name="Y-Roll" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">

  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="JBMBLSR1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pattern" ChannelOffset="4" Wheel="13" />

    </Attribute>
    <Attribute ID="Mode(AllModes)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="''" Dmx="0~0" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
      <Function ID="2" Name="HSI" Display="''" Dmx="52~103" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
      <Function ID="3" Name="RGBW" Display="''" Dmx="104~155" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
      <Function ID="4" Name="FX" Display="''" Dmx="156~207" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
      <Function ID="5" Name="Filters" Display="''" Dmx="255~255" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Parameter_1, Parameter_2, Parameter_3, Parameter_4" />
    </Attribute>
    <Attribute ID="Parameter_1" Name="Parameter 1" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Condition Name="CCT" ID="1" If="'Mode(AllModes)'==1" />
      <Condition Name="HSI" ID="2" If="'Mode(AllModes)'==2" />
      <Condition Name="RGBW" ID="3" If="'Mode(AllModes)'==3" />
      <Condition Name="FX" ID="4" If="'Mode(AllModes)'==4" />
      <Condition Name="Filters" ID="5,6,7" If="'Mode(AllModes)'==5" />
      <Else ID="8" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="Hue" Display="'%.f°',0~360" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="4" Name="Effect" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="5" Name="Brand = Lee" Display="'Brand = Lee'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="Brand = Rosco" Display="'Brand = Rosco'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Parameter_2" Name="Parameter 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="CCT" ID="1" If="'Mode(AllModes)'==1" />
      <Condition Name="HSI" ID="2" If="'Mode(AllModes)'==2" />
      <Condition Name="RGBW" ID="3" If="'Mode(AllModes)'==3" />
      <Condition Name="FX" ID="4,5,6,7" If="'Mode(AllModes)'==4" />
      <Condition Name="Filters" ID="8" If="'Mode(AllModes)'==5" />
      <Else ID="9" />
      <Function ID="1" Name="G/M" Display="'%.1f%%',-50.0~50.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="2" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="4" Name="Effect Type I" Display="'Effect Type I'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="5" Name="Effect Type II" Display="'Effect Type II'" Dmx="86~171" Colour="0,0,0" />
      <Function ID="6" Name="Effect Type III" Display="'Effect Type III'" Dmx="255~255" Colour="0,0,0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Gel" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Parameter_3" Name="Parameter 3" Description="" Group="C">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="RGBW" ID="1" If="'Mode(AllModes)'==3" />
      <Else ID="2" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Parameter_4" Name="Parameter 4" Description="" Group="C">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="RGBW" ID="1" If="'Mode(AllModes)'==3" />
      <Else ID="2" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

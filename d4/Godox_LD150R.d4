      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="G/M" Name="G/M" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="G/M" Display="'%.1f%%',-50.0~50.0" Dmx="0~255" Colour="255,255,255" />

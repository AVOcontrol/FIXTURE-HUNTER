<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Bronco" ShortName="Bronco" Company="KAM">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>07e86e95-794a-4e45-bca2-775b10cce6fb</Thumbnail>
  <History Date="21-11-13" Author="Peter Budd" Comment="Created" />
  <History Date="10-02-18" Author="Nic Morris" Comment="Changed manufacturer name from Kam to KAM.  Fixed gobo spd ranges." />
  <History Date="10-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="64~79" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="80~95" Colour="255,255,0" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="96~111" Colour="255,0,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="112~127" Colour="255,100,100" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="128~143" Colour="0,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="144~159" Colour="128,255,0" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="160~175" Colour="0,128,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="192~207" Colour="255,255,128" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="208~223" Colour="255,128,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="224~239" Colour="128,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Spd" Name="Gobo Spd" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select" Display="'Select %.f%%',0~100" Dmx="0~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="101~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="11~200" Update="Auto_Spd" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="201~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Gobo1" ChannelOffset="1" Wheel="13" />
      <Attribute ID="Gobo_Spd" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour1" Wheel="7" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="White" Number="1" Page="1" SetControl="Colour1:5" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Red/White" Number="3" Page="1" SetControl="Colour1:8" />
      <Palette ID="4" Name="Red/Green" Number="4" Page="1" SetControl="Colour1:6" />
      <Palette ID="5" Name="Green/White" Number="0" Page="1" SetControl="Colour1:10" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Green/Blue" Number="0" Page="1" SetControl="Colour1:9" />
      <Palette ID="8" Name="Green/Blue" Number="6" Page="1" SetControl="Colour1:9" />
      <Palette ID="9" Name="Blue/White" Number="0" Page="1" SetControl="Colour1:11" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:4" />
      <Palette ID="11" Name="Red/Blue" Number="9" Page="1" SetControl="Colour1:7" />
      <Palette ID="12" Name="Red/Blue" Number="10" Page="1" SetControl="Colour1:7" />
      <Palette ID="13" Name="Red/White" Number="0" Page="1" SetControl="Colour1:8" />
      <Palette ID="14" Name="R/B/White" Number="8" Page="1" SetControl="Colour1:14" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:4" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="07e86e95-794a-4e45-bca2-775b10cce6fb"></Swatch>
  </swatchLibrary>
</Fixture>
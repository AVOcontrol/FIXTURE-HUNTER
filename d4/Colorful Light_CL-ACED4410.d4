      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="51~101" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="102~152" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="153~203" />
      <Function ID="6" Name="Curve 5" Display="'Curve 5'" Dmx="204~249" />
      <Function ID="7" Name="Curve 6" Display="'Curve 6'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />

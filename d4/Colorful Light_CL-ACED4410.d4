    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Change" Display="'Change'" Dmx="10~50" />
      <Function ID="3" Name="Fade" Display="'Fade'" Dmx="51~100" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="101~150" />
      <Function ID="5" Name="Mixed" Display="'Mixed'" Dmx="151~200" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">

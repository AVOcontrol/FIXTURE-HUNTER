    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="11~127" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~160" />
      <Function ID="4" Name="Gradient 1" Display="'Gradient 1 %.f%%',0~100" Dmx="161~200" />
      <Function ID="5" Name="Gradient 2" Display="'Gradient 2 %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

      <Function ID="20" Name="Rd - CTB" Display="'Rd - CTB %.f%%',0~100" Dmx="15~30" WheelPosition="1" Colour="255,0,0" />
      <Function ID="21" Name="CTB - 3200" Display="'CTB - 3200 %.f%%',0~100" Dmx="30~45" WheelPosition="2" Colour="230,230,255" />
      <Function ID="22" Name="3200 - 2500" Display="'3200 - 2500 %.f%%',0~100" Dmx="45~60" WheelPosition="3" Colour="255,240,200" />

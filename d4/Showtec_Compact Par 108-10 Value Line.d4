  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c1033986-0fb8-4db4-951e-3534142c797b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Colour" ID="2" If="'Program'&gt;1&amp;&amp;'Program'&lt;12" />
      <Condition Name="Speed" ID="3" If="'Program'==3" />
      <Condition Name="Sensitivity" ID="4" If="'Program'==12" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Red" />
      <Function ID="2" Name="Static Col" Display="'Static Col'" Dmx="1~24" Update="Red" />
      <Function ID="3" Name="7-Col Gradual Change" Display="'7-Col Gradual Change'" Dmx="25~49" Update="Red" />
      <Function ID="4" Name="3-Col Gradual Change" Display="'3-Col Gradual Change'" Dmx="50~74" Update="Red" />
      <Function ID="5" Name="7-Col Switch" Display="'7-Col Switch'" Dmx="75~99" Update="Red" />
      <Function ID="6" Name="3-Col Switch" Display="'3-Col Switch'" Dmx="100~124" Update="Red" />
      <Function ID="7" Name="Fantasy Change 1" Display="'Fantasy Change 1'" Dmx="125~149" Update="Red" />
      <Function ID="8" Name="Fantasy Change 2" Display="'Fantasy Change 2'" Dmx="150~174" Update="Red" />
      <Function ID="9" Name="Red Gradual Change" Display="'Red Gradual Change'" Dmx="175~199" Update="Red" />
      <Function ID="10" Name="Green Gradual Change" Display="'Green Gradual Change'" Dmx="200~224" Update="Red" />
      <Function ID="11" Name="Blue Gradual Change" Display="'Blue Gradual Change'" Dmx="225~249" Update="Red" />
      <Function ID="12" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Red" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="69~91" Colour="0,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="92~114" Colour="255,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="115~137" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="138~160" Colour="255,150,150" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="161~183" Colour="128,0,255" />
      <Function ID="10" Name="Dark Blue" Display="'Dark Blue'" Dmx="184~206" Colour="0,0,180" />
      <Function ID="11" Name="Light Green" Display="'Light Green'" Dmx="207~229" Colour="128,255,0" />
      <Function ID="12" Name="White" Display="'White'" Dmx="230~252" Colour="255,255,255" />
      <Function ID="13" Name="Cool White" Display="'Cool White'" Dmx="253~255" Colour="230,230,255" />
    </Attribute>
  </Control>

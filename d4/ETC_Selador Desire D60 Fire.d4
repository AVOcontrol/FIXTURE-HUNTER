<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Selador Desire D60 Fire" ShortName="D60 Fire" Company="ETC">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="29-08-16" Author="Nic Morris" Comment="Created" />
  <History Date="14-01-17" Author="Nic Morris" Comment="Changed Red-Orange attribute ID to YellowAdditive" />
  <History Date="09-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="09-12-17" Author="Nic Morris" Comment="Fixed Amber Adj typo" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="7300d081-341d-4ba3-b990-2cd4ba70c0b3" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="YellowAdditive" Name="Red-Orange" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Rd-Org C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="Indigo" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Indigo C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Red_Adj" Name="Red Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Default" Display="'Default'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Adj" Display="'+ Adj %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red-Orange_Adj" Name="Red-Orange Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Default" Display="'Default'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Adj" Display="'+ Adj %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber_Adj" Name="Amber Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Default" Display="'Default'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Adj" Display="'+ Adj %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green_Adj" Name="Green Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Default" Display="'Default'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Adj" Display="'+ Adj %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved4" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Indigo_Adj" Name="Indigo Adj" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Adj" Display="'- Adj %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Default" Display="'Default'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="3" Name="+ Adj" Display="'+ Adj %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2:4608" PowerOn="2:4608" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2700~6500" Dmx="1~254" Colour="255,240,200" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+Grn" Display="'+Grn %.1f%%',100.0~0.0" Dmx="1~127" Colour="128,255,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="-Grn" Display="'-Grn %.1f%%',0.0~100.0" Dmx="129~255" Colour="128,255,0" />
    </Attribute>
    <Attribute ID="Plus7" Name="Plus7" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Enabled" Display="'Enabled'" Dmx="255~255" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto" Display="'Auto'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~254" />
      <Function ID="3" Name="Max" Display="'Max'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Curve 1" Display="'Curve 1'" Dmx="0~0" />
      <Function ID="2" Name="Curve 2" Display="'Curve 2'" Dmx="64~127" />
      <Function ID="3" Name="Curve 3" Display="'Curve 3'" Dmx="128~191" />
      <Function ID="4" Name="Curve 4" Display="'Curve 4'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

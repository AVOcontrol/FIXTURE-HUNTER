    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:1800" PowerOn="1:1800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',1800~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Fade" Display="'Col Fade %.1f%%',0.0~100.0" Dmx="10~134" />
      <Function ID="3" Name="Col Change" Display="'Col Change %.1f%%',0.0~100.0" Dmx="135~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />

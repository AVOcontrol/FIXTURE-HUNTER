<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="CTL-HM" ShortName="CTL-HM" Company="Casa">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="12-02-16" Author="Nic Morris" Comment="Created" />
  <History Date="24-03-16" Author="Nic Morris" Comment="Merged revised colour functions in response to customer information." />
  <History Date="02-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="05-07-16" Author="Nic Morris" Comment="Changed mode power on to laser off in response to customer request.  Fixed missing conditional statement." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fcd24d06-af2f-4926-b15f-61aa9404138c" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="I">
      <Locate Locate="4" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Pattern, Dynamic_Spd, Static_Spd" Intensity="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="50~99" Update="Pattern, Dynamic_Spd, Static_Spd" Intensity="0~0" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="100~149" Update="Pattern, Dynamic_Spd, Static_Spd" Intensity="0~0" />
      <Function ID="4" Name="Static Pattern" Display="'Static Pattern'" Dmx="150~199" Update="Pattern, Dynamic_Spd, Static_Spd" Intensity="0~0" />
      <Function ID="5" Name="Dynamic Pattern" Display="'Dynamic Pattern'" Dmx="200~255" Update="Pattern, Dynamic_Spd, Static_Spd" Intensity="0~0" />
    </Attribute>

      <Condition Name="6 Colour" ID="120,121,122,123,124,125,126" If="'Colour1Func'==6" />
      <Condition Name="7 Colour" ID="127" If="'Colour1Func'==7" />
      <Condition Name="Moving" ID="128" If="'Colour1Func'==8" />
      <Else ID="129" />
      <Function ID="1" Name="Silver" Display="'Silver'" Dmx="0~0" Colour="220,240,255" />
      <Function ID="2" Name="Magenta" Display="'Magenta'" Dmx="2~3" Colour="255,0,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ProVideoPlayer" ShortName="RVPVP" Company="Renewed Vision">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="01-02-12" Author="Peter Budd" Comment="Created" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Changed hue and saturation IDs for compatibility." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Playlist_Index" Name="Playlist Index" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Playlist" Display="'Playlist %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Clip_Index" Name="Clip Index" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Clip" Display="'Clip %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Transition_Time" Name="Trans Time" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Trans Time" Display="'Trans Time %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name=" Manual Transition Mode" Display="'Manual Transition Mode'" Dmx="1~5" />
      <Function ID="2" Name=" Auto Transition Mode" Display="'Auto Transition Mode'" Dmx="6~10" />
      <Function ID="3" Name=" Mapping Preset 1" Display="'Mapping Preset 1'" Dmx="11~15" />
      <Function ID="4" Name=" Mapping Preset 2" Display="'Mapping Preset 2'" Dmx="16~20" />
      <Function ID="5" Name=" Mapping Preset 3" Display="'Mapping Preset 3'" Dmx="21~25" />
      <Function ID="6" Name=" Mapping Preset 4" Display="'Mapping Preset 4'" Dmx="26~30" />
      <Function ID="7" Name=" Mapping Preset 5" Display="'Mapping Preset 5'" Dmx="31~35" />
      <Function ID="8" Name=" Mapping Preset 6" Display="'Mapping Preset 6'" Dmx="36~40" />
      <Function ID="9" Name=" Mapping Preset 7" Display="'Mapping Preset 7'" Dmx="41~45" />
      <Function ID="10" Name=" Mapping Preset 8" Display="'Mapping Preset 8'" Dmx="46~50" />
      <Function ID="11" Name=" Mapping Preset 9" Display="'Mapping Preset 9'" Dmx="51~55" />
      <Function ID="12" Name=" Mapping Preset 10" Display="'Mapping Preset 10'" Dmx="56~60" />
      <Function ID="13" Name=" Unused" Display="'Unused'" Dmx="61~250" />
      <Function ID="14" Name=" Go To Black" Display="'Go To Black'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Transition" Name="Transition" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Transition" Display="'Transition %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Rate" Display="'Rate %.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'Hue %.f%%',0~100" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Saturation" Display="'Saturation %.f%%',0~100" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Contrast" Display="'Contrast %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Volume" Display="'Volume %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Basic" Channels="4">
    <Import PearlRef="RVPVPB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Playlist_Index" ChannelOffset="1" Wheel="30" />
      <Attribute ID="Clip_Index" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Transition_Time" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended" Channels="11">
    <Import PearlRef="RVPVPX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Contrast" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Volume" ChannelOffset="11" Wheel="5" />
      <Attribute ID="xHue" ChannelOffset="7" Wheel="37" />
      <Attribute ID="xSaturation" ChannelOffset="8" Wheel="38" />
      <Attribute ID="Transition" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Playlist_Index" ChannelOffset="1" Wheel="30" />
      <Attribute ID="Clip_Index" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Transition_Time" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
      <Attribute ID="Rate" ChannelOffset="6" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
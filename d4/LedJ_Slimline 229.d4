<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Slimline 229" ShortName="Slim 229" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-12-09" Author="John Rogers" Comment="Created" />
  <History Date="06-04-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution." />
  <History Date="06-04-11" Author="Nic Morris" Comment="Adapted from Unknown_Lightmaxx Studio Par64 36x3w" />
  <History Date="09-05-11" Author="John Rogers" Comment="Edited manufacturer name." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="08-07-15" Author="Nic Morris" Comment="Added missing modes" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="11-01-17" Author="Nic Morris" Comment="Added Atlabase ID's to 2, 3 and 4 DMX modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c6b990ba-38da-410a-a933-57025c513cf0" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="2 DMX" ID="2,3" If="'Colour_Macro'&gt;1||'Colour_Macro'&lt;4" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~240" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="241~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro'" Dmx="5~80" />
      <Function ID="3" Name="Colour Jump" Display="'Colour Jump'" Dmx="81~150" />
      <Function ID="4" Name="Colour Fade" Display="'Colour Fade'" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Dimmer" Colour="0,0,0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro'" Dmx="5~80" Update="Dimmer" Colour="0,0,0" />
      <Function ID="3" Name="Colour Jump" Display="'Colour Jump'" Dmx="81~150" Update="Dimmer" Colour="0,0,0" />
      <Function ID="4" Name="Colour Fade" Display="'Colour Fade'" Dmx="151~255" Update="Dimmer" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="LJ_SLIM229" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4e3fd9ed-e700-449d-9957-9bc49f77ee9f" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="Amber" ChannelOffset="6" Wheel="7" />
      <Attribute ID="Macro" ChannelOffset="7" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="LJSL2292" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0d98c020-1e00-401e-9b6f-ace221fd97a0" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="2" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="LJSL2293" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c9dd8949-70ef-4311-b3cb-04c41e52f604" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="LJSL2294" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="78e525a3-36d3-4b5f-8e19-4c0c0de21a70" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="4" Wheel="7" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
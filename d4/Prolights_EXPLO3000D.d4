      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~249" Intensity="0~0" />
      <Function ID="3" Name="Blinder" Display="'Blinder'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
  </Control>

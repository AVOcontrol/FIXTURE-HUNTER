      <Function ID="6" Name="Random" Display="'Random'" Dmx="172~250" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 Salvo 3500 Vertical Fogger" ShortName="Salvo 3500" Company="Prolight" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>b16ff4ed-3a18-4814-95b4-ab18e13e8a52</Thumbnail>
  <History Date="14-12-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="18-12-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0cda29d0-4e51-471d-97f2-2e887e2200a5" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Fan" Display="'Fan'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Col Spd" Display="'Auto Col Spd %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Safety" Name="Safety" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safety On" Display="'Safety On'" Dmx="0~0" />
      <Function ID="2" Name="Safety Off" Display="'Safety Off'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3" Id="c75469f7-a17a-4a00-ad09-39179c5f3e3a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="420e3a64-d81a-4817-8495-3f14b19567f0" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Fog" Wheel="5" />
        <Attribute ID="Fan" ChannelOffset="2" Wheel="6" />
        <Attribute ID="Safety" ChannelOffset="3" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Fog cell" X="0" Y="0">
        <AttributeLink SourceId="Fog" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16 DMX" Channels="16" Id="440587e2-a2a9-4048-b942-bb7178d55993">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f2d1a48d-7964-401d-80d5-77478a963195" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Fog" Wheel="5" />
        <Attribute ID="Fan" ChannelOffset="2" Wheel="6" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Amber" Wheel="40" />
        <Attribute ID="Colour_Macro" Wheel="7" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Auto" ChannelOffset="13" Wheel="22" />
        <Attribute ID="Shutter" ChannelOffset="14" Wheel="34" />
        <Attribute ID="Master_Dimmer" ChannelOffset="15" Wheel="4" />
        <Attribute ID="Safety" ChannelOffset="16" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Fog cell" X="0" Y="0">
        <AttributeLink SourceId="Fog" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Outer LED" ChannelOffset="3" ModeLink="Outer cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Inner LED" ChannelOffset="7" ModeLink="Inner cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Fog cell" Channels="1" Hidden="True" Id="0e6a93b5-8340-4db1-9528-9247256a6996">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Outer cell" Channels="5" Hidden="True" Id="a585a6f0-bce2-4e8a-a391-0591d897b5f1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

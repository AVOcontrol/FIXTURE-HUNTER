  <History Date="23-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="05-12-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added discreet colour index functions." />
  <History Date="05-12-19" Author="Nic Morris" Comment="Added gobo swatches.  Revised control functions and macros in line with latest documentation." />
  <History Date="06-12-19" Author="Nic Morris" Comment="Fixed Colour 2 update.  Changed colour index ranges to full field." />
  <History Date="07-12-19" Author="Nic Morris" Comment="Fixed D Blue - L Yel range." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="95b183bb-22be-4618-881b-184ce1fa620e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Blue" Display="'Dark Blue'" Dmx="8~15" WheelPosition="1" Colour="0,0,180" />
      <Function ID="3" Name="Light Yellow" Display="'Yellow'" Dmx="16~23" WheelPosition="2" Colour="255,255,128" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="24~31" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="40~47" WheelPosition="5" Colour="255,0,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="48~55" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="56~63" WheelPosition="7" Colour="255,128,0" />
      <Function ID="9" Name="Op - D Blu" Display="'Op - D Blu %.f%%',0~100" Dmx="64~81" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="D Blu - L Yel" Display="'D Blu - L Yel %.f%%',0~100" Dmx="81~95" WheelPosition="1" Colour="0,0,180" />
      <Function ID="11" Name="L Yel - Pk" Display="'L Yel - Pk %.f%%',0~100" Dmx="95~110" WheelPosition="2" Colour="255,255,128" />
      <Function ID="12" Name="Pk - Grn" Display="'Pk - Grn %.f%%',0~100" Dmx="110~125" WheelPosition="3" Colour="255,150,150" />
      <Function ID="13" Name="Grn - Rd" Display="'Grn - Rd %.f%%',0~100" Dmx="125~140" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Rd - L Blu" Display="'Rd - L Blu %.f%%',0~100" Dmx="140~155" WheelPosition="5" Colour="255,0,0" />
      <Function ID="15" Name="L Blu - Org" Display="'L Blu - Org %.f%%',0~100" Dmx="155~170" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="Index" Display="'%.f%%',0~100" Dmx="64~170" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="212~171" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="213~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour2Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="UV" Display="'UV'" Dmx="8~15" WheelPosition="1" Colour="180,0,255" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="16~23" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Light Green" Display="'Light Green'" Dmx="24~31" WheelPosition="3" Colour="128,255,0" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="32~39" WheelPosition="4" Colour="255,240,200" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="40~47" WheelPosition="5" Colour="230,230,255" />
      <Function ID="7" Name="Red Pink" Display="'Red Pink'" Dmx="48~55" WheelPosition="6" Colour="255,0,255" />
      <Function ID="8" Name="Dark Blue" Display="'Dark Blue'" Dmx="56~63" WheelPosition="7" Colour="0,0,180" />
      <Function ID="9" Name="Op - UV" Display="'Op - UV %.f%%',0~100" Dmx="64~81" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="UV - Org" Display="'UV - Org %.f%%',0~100" Dmx="81~95" WheelPosition="1" Colour="180,0,255" />
      <Function ID="11" Name="Org - L Grn" Display="'Org - L Grn %.f%%',0~100" Dmx="95~110" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="L Grn - 3200K" Display="'L Grn - 3200K %.f%%',0~100" Dmx="110~125" WheelPosition="3" Colour="128,255,0" />
      <Function ID="13" Name="3200 - 5600K" Display="'3200 - 5600K %.f%%',0~100" Dmx="125~140" WheelPosition="4" Colour="255,240,200" />
      <Function ID="14" Name="5600 - Pk" Display="'5600 - Pk %.f%%',0~100" Dmx="140~155" WheelPosition="5" Colour="230,230,255" />
      <Function ID="15" Name="Pk - Blu" Display="'Pk - Blu %.f%%',0~100" Dmx="155~170" WheelPosition="6" Colour="255,0,255" />
      <Function ID="16" Name="Index" Display="'Index %.f%%',0~100" Dmx="64~170" Colour="0,0,0" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="212~171" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="213~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>9b69c199-d82a-42f8-a23c-216a4eaa5612</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>68269623-5a0a-4efa-9ec1-f0d6571a8a1b</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0">

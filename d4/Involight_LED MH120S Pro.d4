      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="160~179" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>9cc7c7dc-217c-4247-9dcf-49b15189ab2f</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="180~199" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>6e61bfc5-620c-436a-9d71-5d3476923dac</Swatch>

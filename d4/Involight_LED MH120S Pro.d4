      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="140~159" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>e21cb3c9-ae37-4c26-a877-e3d7110e8d8a</Swatch>

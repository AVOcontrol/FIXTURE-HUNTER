      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="120~139" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>2aa21051-742e-4d7c-a6da-8a733ae8fe20</Swatch>

    <Attribute ID="FX_Wheel_A" Name="FX Wheel A" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="FX_Wheel_A_Rot" />
      <Function ID="2" Name="8 Facet Circular Prism Index" Display="'8 Facet Circular Prism Index'" Dmx="30~49" Update="FX_Wheel_A_Rot" />
      <Function ID="3" Name="4 Facet Linear Prism Index" Display="'4 Facet Linear Prism Index'" Dmx="50~69" Update="FX_Wheel_A_Rot" />
      <Function ID="4" Name="6 Facet Linear Prism Index" Display="'6 Facet Linear Prism Index'" Dmx="70~89" Update="FX_Wheel_A_Rot" />

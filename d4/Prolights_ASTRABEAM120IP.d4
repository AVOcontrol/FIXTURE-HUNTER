    </Attribute>
    <Attribute ID="FX_Wheel_A_Rot" Name="FX Wheel A Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Index" ID="2" If="'FX_Wheel_A'==2||'FX_Wheel_A'==3||'FX_Wheel_A'==4" />
      <Condition Name="Spin" ID="3,4,5,6" If="'FX_Wheel_A'==5||'FX_Wheel_A'==6||'FX_Wheel_A'==7" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="FX_Wheel_B" Name="FX Wheel B" Description="" Group="E">

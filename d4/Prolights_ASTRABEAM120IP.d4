      <Function ID="6" Name="4 Facet Linear Prism Spin" Display="'4 Facet Linear Prism Spin'" Dmx="110~129" Update="FX_Wheel_A_Rot" />
      <Function ID="7" Name="6 Facet Linear Prism Spin" Display="'6 Facet Linear Prism Spin'" Dmx="130~149" Update="FX_Wheel_A_Rot" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Max" ShortName="Max" Company="DTS">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-01-10" Author="John Rogers" Comment="Created" />
  <History Date="08-02-12" Author="Peter Budd" Comment="Edited added 17ch mode and added CTO attribute" />
  <History Date="15-05-13" Author="Peter Budd" Comment="Created from the DTS XR300 Beam." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="08-08-17" Author="Nic Morris" Comment="Renamed Pan Far to Pan Spin and revised function names and wheel direction." />
  <History Date="08-08-17" Author="Nic Morris" Comment="Standardised shutter.  Added colour names and swatches.  Added colour function index.  Increased wheel resolution." />
  <History Date="08-08-17" Author="Nic Morris" Comment="Fixed 16bit raw range.  Fixed duplicate functions in else conditions.  Revised Gobo 1 Shake function names." />
  <History Date="08-08-17" Author="Nic Morris" Comment="Shortened iris macro function names to fit in displays.  Standardised conditionals." />
  <History Date="08-08-17" Author="Nic Morris" Comment="Recreated palettes.  Fixed iris in 24 channel mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="739a3ef7-6564-48e5-9b19-195634e92a91" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Reaction" Display="'Reaction %.f%%',0~100" Dmx="247~128" />
      <Function ID="5" Name="Silent" Display="'Silent'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard (540°)" Display="'Standard (540°)'" Dmx="0~0" />
      <Function ID="2" Name="1 Turn (360°)" Display="'1 Turn (360°)'" Dmx="11~20" />
      <Function ID="3" Name="2 Turns (720°)" Display="'2 Turns (720°)'" Dmx="21~30" />
      <Function ID="4" Name="3 Turns (1080°)" Display="'3 Turns (1080°)'" Dmx="31~40" />
      <Function ID="5" Name="4 Turns (1440°)" Display="'4 Turns (1440°)'" Dmx="41~50" />
      <Function ID="6" Name="5 Turns (1800°)" Display="'5 Turns (1800°)'" Dmx="51~60" />
      <Function ID="7" Name="6 Turns (2160°)" Display="'6 Turns (2160°)'" Dmx="61~70" />
      <Function ID="8" Name="7 Turns (2520°)" Display="'7 Turns (2520°)'" Dmx="71~80" />
      <Function ID="9" Name="8 Turns (2880°)" Display="'8 Turns (2880°)'" Dmx="81~90" />
      <Function ID="10" Name="9 Turns (3240°)" Display="'9 Turns (3240°)'" Dmx="91~100" />
      <Function ID="11" Name="10 Turns (3600°)" Display="'10 Turns (3600°)'" Dmx="101~110" />
      <Function ID="12" Name="Smart Path (360°)" Display="'Smart Path (360°)'" Dmx="111~120" />
      <Function ID="13" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="121~182" />
      <Function ID="14" Name="No Spin" Display="'No Spin'" Dmx="183~193" />
      <Function ID="15" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

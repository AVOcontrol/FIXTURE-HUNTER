<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Video Player" ShortName="Vid Player" Company="Capture">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pause" Display="'Pause'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="8~15" />
      <Function ID="3" Name="Replay (restart)" Display="'Replay (restart)'" Dmx="16~23" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="24~31" />
    </Attribute>
    <Attribute ID="Playlist_Index" Name="Playlist Index" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Playlist Entry 1" Display="'Playlist Entry 1'" Dmx="0~0" />
      <Function ID="2" Name="Playlist Entry 2" Display="'Playlist Entry 2'" Dmx="32~63" />
      <Function ID="3" Name="Playlist Entry 3" Display="'Playlist Entry 3'" Dmx="64~95" />
      <Function ID="4" Name="Playlist Entry 4" Display="'Playlist Entry 4'" Dmx="96~127" />
      <Function ID="5" Name="Playlist Entry 5" Display="'Playlist Entry 5'" Dmx="128~159" />
      <Function ID="6" Name="Playlist Entry 6" Display="'Playlist Entry 6'" Dmx="160~191" />
      <Function ID="7" Name="Playlist Entry 7" Display="'Playlist Entry 7'" Dmx="192~223" />
      <Function ID="8" Name="Playlist Entry 8" Display="'Playlist Entry 8'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Control" ChannelOffset="1" Wheel="13" />
      <Attribute ID="Playlist_Index" ChannelOffset="2" Wheel="14" />
    </Include>
  </Mode>
</Fixture>
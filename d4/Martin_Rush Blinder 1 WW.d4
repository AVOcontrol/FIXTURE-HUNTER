  <AtlaBase TypeID="22d9ca07-ae7b-47c5-89bb-2ed8a57e7e8a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="60~64" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="65~69" />
      <Function ID="4" Name="Dim Inv Sqare" Display="'Dim Inv Sqare'" Dmx="70~74" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="75~79" />
      <Function ID="6" Name="Smoothing On" Display="'Smoothing On'" Dmx="135~139" />
      <Function ID="7" Name="Smoothing Off" Display="'Smoothing Off'" Dmx="140~144" />
      <Function ID="8" Name="Auto Blackout On" Display="'Auto Blackout On'" Dmx="145~149" />
      <Function ID="9" Name="Auto Blackout Off" Display="'Auto Blackout Off'" Dmx="150~154" />
      <Function ID="10" Name="Display On" Display="'Display On'" Dmx="155~159" />
      <Function ID="11" Name="Display Off" Display="'Display Off'" Dmx="160~164" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Congo Blue (UV)" Display="'Congo Blue (UV)'" Dmx="4~7" Colour="180,0,255" />

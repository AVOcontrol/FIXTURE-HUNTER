    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="7,8,9,10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="14,15,16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="166~171" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Dark Green" Display="'Dark Green'" Dmx="172~177" WheelPosition="2" Colour="0,180,0" />
      <Function ID="4" Name="Dark Blue" Display="'Dark Blue'" Dmx="178~183" WheelPosition="3" Colour="0,0,180" />
      <Function ID="5" Name="Dark Magenta" Display="'Dark Magenta'" Dmx="184~189" WheelPosition="4" Colour="180,0,180" />
      <Function ID="6" Name="Congo Blue" Display="'Congo Blue'" Dmx="190~199" WheelPosition="5" Colour="180,0,255" />
      <Function ID="7" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~26" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="D Rd - D Grn" Display="'D Rd - D Grn %.f%%',0~100" Dmx="26~52" WheelPosition="1" Colour="180,0,0" />
      <Function ID="9" Name="D Grn - D Blu" Display="'D Grn - D Blu %.f%%',0~100" Dmx="52~78" WheelPosition="2" Colour="0,180,0" />
      <Function ID="10" Name="D Blu - D Mag" Display="'D Blu - D Mag %.f%%',0~100" Dmx="78~104" WheelPosition="3" Colour="0,0,180" />
      <Function ID="11" Name="D Mag - C Blu" Display="'D Mag - C Blu %.f%%',0~100" Dmx="104~130" WheelPosition="4" Colour="180,0,180" />
      <Function ID="12" Name="C Blu - Op" Display="'C Blu - Op %.f%%',0~100" Dmx="130~156" WheelPosition="5" Colour="180,0,255" />
      <Function ID="13" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~156" Colour="0,0,0" />
      <Function ID="14" Name="No Scroll" Display="'No Scroll'" Dmx="225~230" Colour="0,0,0" />
      <Function ID="15" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="200~224" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="225~230" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="231~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ovaliser" Name="Ovaliser" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Ovaliser_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="30~59" Update="Ovaliser_Rot" />
      <Function ID="3" Name="Spin" Display="'Spin'" Dmx="60~89" Update="Ovaliser_Rot" />
    </Attribute>
    <Attribute ID="Ovaliser_Rot" Name="Ovaliser Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Prism Index" ID="2" If="'Ovaliser'==2" />
      <Condition Name="Prism Spin" ID="3,4,5,6" If="'Ovaliser'==3" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">

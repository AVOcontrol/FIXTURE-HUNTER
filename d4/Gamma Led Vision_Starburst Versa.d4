  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_1" Name="Macro 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Jump 1" Display="'Col Jump 1'" Dmx="15~34" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="35~54" />
      <Function ID="4" Name="Col Choose" Display="'Col Choose'" Dmx="55~74" />
      <Function ID="5" Name="Col Jump 2" Display="'Col Jump 2'" Dmx="75~94" />
      <Function ID="6" Name="Col Fade+Pulse" Display="'Col Fade+Pulse'" Dmx="95~114" />
      <Function ID="7" Name="Effect 1" Display="'Effect 1'" Dmx="115~134" />
      <Function ID="8" Name="Effect 2" Display="'Effect 2'" Dmx="135~154" />
      <Function ID="9" Name="Effect 3" Display="'Effect 3'" Dmx="155~174" />
      <Function ID="10" Name="Effect 4" Display="'Effect 4'" Dmx="175~194" />
      <Function ID="11" Name="Effect 5" Display="'Effect 5'" Dmx="195~214" />
      <Function ID="12" Name="Effect 6" Display="'Effect 6'" Dmx="215~255" />

      </Cell>
      <Cell ID="Cell5" Name="M1 LED 4" ChannelOffset="8" ModeLink="Dim cell" X="4" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="M2 Tilt" ChannelOffset="9" ModeLink="Tilt cell" X="0" Y="1">

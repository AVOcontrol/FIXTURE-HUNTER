      </Cell>
      <Cell ID="Cell7" Name="M2 LED 1" ChannelOffset="13" ModeLink="Dim cell" X="1" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="M2 LED 2" ChannelOffset="14" ModeLink="Dim cell" X="2" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="M2 LED 3" ChannelOffset="15" ModeLink="Dim cell" X="3" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="M2 LED 4" ChannelOffset="16" ModeLink="Dim cell" X="4" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

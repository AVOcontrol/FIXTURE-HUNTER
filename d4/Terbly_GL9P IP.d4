  <History Date="17-03-26" Author="Nic Morris" Comment="Created from Elation Proteus Odeon (effectively identical.  only difference is p/t break control functions/macros and p/t smoot/fast DMX values.  Note colours in charts are different to colour wheel drawing)" Version="5" />
  <History Date="06-04-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />

  <History Date="23-03-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="30-03-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="19-12-21" Author="Nic Morris" Comment="Updated in line with firmware 1.5.0 in response to manufacturer request (adds keylight control functions/macros.  adds discreet FX functions.  adds Extended mode with 16bit iris and framing.  renamed existing mode to Basic)" Version="2" />
  <History Date="22-12-21" Author="Nic Morris" Comment="Added Extended mode Atlabase ID and updated basic to v1.5.0" Version="5" />
  <History Date="03-05-22" Author="Nic Morris" Comment="Updated in line with firmware 1.6.0 in response to manufacturer request (adds colour mode control functions/macros)." Version="7" />
  <History Date="27-02-23" Author="Nic Morris" Comment="Updated in line with firmware v2.0.0 (manual rev E) (adds gobo scroll and extended gamut colour mode control function/macro)" Version="8" />
  <History Date="27-01-24" Author="Nic Morris" Comment="Corrected middle gobo rotate stop end dmx value (16bit value typo)" Version="9" />
  <History Date="08-05-25" Author="Nic Morris" Comment="Updated in line with firmwave v2.2.0 (manual rev G) in response to manufacturer request (adds framing mode control functions/macros)" Version="10" />
  <History Date="04-12-25" Author="Nic Morris" Comment="Updated animation functions in line with latest charts." Version="11" />
  <History Date="27-02-26" Author="Nic Morris" Comment="Added Compact mode in response to manufacturer mailout (not currently documented)" Version="12" />

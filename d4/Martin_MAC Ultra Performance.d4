    <Attribute ID="FX_1_Spd" Name="FX 1 Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Effect" ID="1" If="'FX_1_Func'==1" />
      <Condition Name="Speed" ID="2,3,4" If="'FX_1_Func'&gt;1&amp;&amp;'FX_1_Func'&lt;9" />
      <Condition Name="Frequency" ID="5" If="'FX_1_Func'==9" />
      <Else ID="6" />
      <Function ID="1" Name="No Effect" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~130" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="128~128" WheelPosition="0" />
      <Function ID="4" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="126~0" />
      <Function ID="5" Name="Frequency" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>

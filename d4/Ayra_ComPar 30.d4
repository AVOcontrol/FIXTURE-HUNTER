    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Spd" Display="'Auto Spd %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="51~67" Colour="255,255,255" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="68~84" Colour="255,128,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="85~101" Colour="0,255,255" />
      <Function ID="7" Name="Lavender" Display="'Lavender'" Dmx="102~118" Colour="255,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="119~135" Colour="255,150,150" />
      <Function ID="9" Name="Bright Green" Display="'Bright Green'" Dmx="136~152" Colour="128,255,0" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="153~169" Colour="255,0,255" />
      <Function ID="11" Name="Pale Pink" Display="'Pale Pink'" Dmx="170~186" Colour="255,200,200" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="187~203" Colour="255,100,0" />
      <Function ID="13" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="204~220" Colour="255,0,255" />
      <Function ID="14" Name="Pale Cyan" Display="'Pale Cyan'" Dmx="221~237" Colour="128,255,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="238~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour" Display="'Colour %.f%%',0~100" Dmx="5~80" Colour="0,0,0" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="81~150" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="151~220" Colour="0,0,0" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
  </Control>

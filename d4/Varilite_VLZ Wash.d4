    <Attribute ID="Beam_Shape" Name="Beam Shape" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Beam_Shape_Rot" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="6~10" Update="Beam_Shape_Rot" />
      <Function ID="3" Name="Spin Normal" Display="'Spin Normal'" Dmx="11~15" Update="Beam_Shape_Rot" />
      <Function ID="4" Name="Spin Step" Display="'Spin Step'" Dmx="16~20" Update="Beam_Shape_Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Beam_Shape_Rot" />
    </Attribute>
    <Attribute ID="Beam_Shape_Rot" Name="Beam Shape Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Beam_Shape'==2" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Beam_Shape'==3||'Beam_Shape'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~65535" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32781" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="32757~32780" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32756~0" />
    </Attribute>

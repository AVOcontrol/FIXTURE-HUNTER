      <Function ID="10" Name="M Grn - L Blu" Display="'M Grn - L Blu %.f%%',0~100" Dmx="145~181" Colour="230,230,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="181~181" Colour="0,128,255" />
      <Function ID="12" Name="L Blu - Org" Display="'L Blu - Org %.f%%',0~100" Dmx="181~220" Colour="0,128,255" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="220~220" Colour="255,128,0" />
      <Function ID="14" Name="Org - Op" Display="'Org - Op %.f%%',0~100" Dmx="220~255" Colour="255,128,0" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="16" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Short" Display="'Fixed Short'" Dmx="0~0" Update="Colour2" Colour="255,255,255" />
      <Function ID="2" Name="Fixed Normal" Display="'Fixed Normal'" Dmx="6~10" Update="Colour2" Colour="255,255,255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Colour Bar" ShortName="LED Col Br" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="17-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="22-09-16" Author="Nic Morris" Comment="Added Atlabase ID's (Bar 10 RGBA)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="31e8b4d3-e700-4aec-b3cf-d395e4cf6e6b" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="1~5" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="Single" Display="'Single'" Dmx="6~10" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="Multi" Display="'Multi'" Dmx="11~15" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="4" Name="R" Display="'R'" Dmx="16~20" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="5" Name="G" Display="'G'" Dmx="21~25" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="6" Name="B" Display="'B'" Dmx="26~30" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="7" Name="A" Display="'A'" Dmx="31~35" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="8" Name="RA" Display="'RA'" Dmx="36~40" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="9" Name="RG" Display="'RG'" Dmx="41~45" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="RB" Display="'RB'" Dmx="46~50" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="11" Name="GB" Display="'GB'" Dmx="51~55" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="12" Name="AB" Display="'AB'" Dmx="56~60" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="13" Name="AG" Display="'AG'" Dmx="61~65" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="14" Name="RGB" Display="'RGB'" Dmx="66~70" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="15" Name="RGA" Display="'RGA'" Dmx="71~75" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="16" Name="RBA" Display="'RBA'" Dmx="76~80" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="17" Name="GBA" Display="'GBA'" Dmx="81~85" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="18" Name="RGBA" Display="'RGBA'" Dmx="86~90" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="19" Name="Col Jump" Display="'Col Jump'" Dmx="91~100" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="20" Name="Col Fade" Display="'Col Fade'" Dmx="101~110" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="21" Name="Dreaming" Display="'Dreaming'" Dmx="111~120" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="22" Name="Col Flow" Display="'Col Flow'" Dmx="121~130" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="23" Name="Overlap Flow" Display="'Overlap Flow'" Dmx="131~140" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="24" Name="Col Chase" Display="'Col Chase'" Dmx="141~150" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="25" Name="Multi Col" Display="'Multi Col'" Dmx="151~160" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="26" Name="Fade Flow" Display="'Fade Flow'" Dmx="161~170" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="27" Name="Two Row" Display="'Two Row'" Dmx="171~180" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="28" Name="One Way" Display="'One Way'" Dmx="181~190" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="29" Name="Two Way" Display="'Two Way'" Dmx="191~200" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="30" Name="Two Col" Display="'Two Col'" Dmx="201~210" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="31" Name="Sound" Display="'Sound'" Dmx="211~255" Update="Dimmer, Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;18&amp;&amp;'Colour_Macro'&lt;31" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==31" />
      <Condition Name="Speed" ID="4" If="'Colour_Macro2'&gt;15" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;26&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~16" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,255" />
      <Function ID="4" Name="Amber" Display="'Amber'" Dmx="51~67" Colour="255,100,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="85~101" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="102~118" Colour="255,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="119~135" Colour="255,150,150" />
      <Function ID="9" Name="Light Green" Display="'Light Green'" Dmx="136~152" Colour="128,255,0" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="153~169" Colour="255,0,255" />
      <Function ID="11" Name="Turquoise" Display="'Turquoise'" Dmx="170~186" Colour="0,255,128" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="187~203" Colour="255,128,0" />
      <Function ID="13" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="204~220" Colour="255,128,255" />
      <Function ID="14" Name="Cold White" Display="'Cold White'" Dmx="221~237" Colour="230,230,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="238~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro2" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R" Display="'R'" Dmx="0~5" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="G" Display="'G'" Dmx="6~11" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="B" Display="'B'" Dmx="12~17" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="A" Display="'A'" Dmx="18~23" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="RA" Display="'RA'" Dmx="24~29" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="30~35" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="36~41" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="GB" Display="'GB'" Dmx="42~47" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="AB" Display="'AB'" Dmx="48~53" Update="Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="AG" Display="'AG'" Dmx="54~59" Update="Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="60~65" Update="Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="RGA" Display="'RGA'" Dmx="66~71" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="RBA" Display="'RBA'" Dmx="72~77" Update="Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="GBA" Display="'GBA'" Dmx="78~83" Update="Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="RGBA" Display="'RGBA'" Dmx="84~89" Update="Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="Col Jump" Display="'Col Jump'" Dmx="90~99" Update="Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Col Fade" Display="'Col Fade'" Dmx="100~109" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Dreaming" Display="'Dreaming'" Dmx="110~119" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Col Flow" Display="'Col Flow'" Dmx="120~129" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Overlap Flow" Display="'Overlap Flow'" Dmx="130~139" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Col Chase" Display="'Col Chase'" Dmx="140~149" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Multi Col" Display="'Multi Col'" Dmx="150~159" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Fade Flow" Display="'Fade Flow'" Dmx="160~169" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Two Row" Display="'Two Row'" Dmx="170~179" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="One Way" Display="'One Way'" Dmx="180~189" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Two Way" Display="'Two Way'" Dmx="190~199" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Two Col" Display="'Two Col'" Dmx="200~209" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Sound" Display="'Sound'" Dmx="210~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="1~5" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKCMLCB2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c442f1b2-43db-44fd-89af-ade5570bbcc8" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour_Macro1" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>

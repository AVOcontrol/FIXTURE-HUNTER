  <History Date="12-06-11" Author="Nic Morris" Comment="Fixed power on, locate, highlight, lowlight" />
  <History Date="12-06-11" Author="Nic Morris" Comment="Added cell 1 attributes and replaced in modes.  Added v-dim" />
  <History Date="12-06-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="14-10-17" Author="Nic Morris" Comment="Split from Chroma Q Colour Span for Capture.  Added Atlabase ID's.  " />
  <History Date="14-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." />
  <History Date="14-10-17" Author="Nic Morris" Comment="Changed manufacturer name from Chroma Q to Chroma-Q.  Changed name from Colour Span to Color Span 1200." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="944aafbf-6cb4-44eb-84bd-470caace73cb" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

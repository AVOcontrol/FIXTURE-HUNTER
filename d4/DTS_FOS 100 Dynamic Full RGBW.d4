    </Attribute>
    <Attribute ID="Custom_W_Func" Name="Custom W Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Recall" Display="'Recall'" Dmx="0~0" Update="Custom_White" />

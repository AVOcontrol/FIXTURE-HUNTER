    <Attribute ID="Custom_White" Name="Custom White" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Create" ID="6,7,8,9,10" If="'Custom_W_Func'==2" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="RGBW Full" Display="'RGBW Full'" Dmx="56~105" Colour="255,255,255" />
      <Function ID="3" Name="DTS White" Display="'DTS White'" Dmx="106~155" Colour="255,255,255" />
      <Function ID="4" Name="Recall Custom" Display="'Recall Custom'" Dmx="156~205" Colour="255,255,255" />
      <Function ID="5" Name="CTO On" Display="'CTO On'" Dmx="206~255" Colour="255,255,255" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="7" Name="RGBW Full" Display="'RGBW Full'" Dmx="56~105" Colour="255,255,255" />
      <Function ID="8" Name="DTS White" Display="'DTS White'" Dmx="106~155" Colour="255,255,255" />
      <Function ID="9" Name="Create Custom" Display="'Create Custom'" Dmx="156~205" Colour="255,255,255" />
      <Function ID="10" Name="CTO On" Display="'CTO On'" Dmx="206~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />

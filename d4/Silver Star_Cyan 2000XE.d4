      <Function ID="2" Name="UC/RGBTW" Display="'UC/RGBTW'" Dmx="8~19" />
      <Function ID="3" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="20~39" />
      <Function ID="4" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="40~59" />

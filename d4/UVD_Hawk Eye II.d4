    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="51~100" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="101~150" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="151~249" />

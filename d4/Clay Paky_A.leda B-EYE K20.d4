    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Opening" ID="2,3" If="'Shape'&gt;8&amp;&amp;'Shape'&lt;13" />

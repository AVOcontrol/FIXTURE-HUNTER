      <Condition Name="Rainbow 1" ID="5" If="'Shape'==15||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21||'Shape'==22||'Shape'==23" />
      <Condition Name="Distribution" ID="6" If="'Shape'==14||'Shape'==25||'Shape'==55||'Shape'==56||'Shape'==57||'Shape'==58||'Shape'==59||'Shape'==60" />
      <Condition Name="Width" ID="7" If="'Shape'==24||'Shape'==26||'Shape'==30||'Shape'==31||'Shape'==32||'Shape'==33||'Shape'==39||'Shape'==40||'Shape'==41||'Shape'==42||'Shape'==43||'Shape'==44||'Shape'==45||'Shape'==48||'Shape'==49||'Shape'==54||'Shape'==64" />
      <Condition Name="Offset" ID="8" If="'Shape'==27||'Shape'==28||'Shape'==29||'Shape'==34||'Shape'==35||'Shape'==36||'Shape'==37||'Shape'==38||'Shape'==46||'Shape'==47||'Shape'==50||'Shape'==51||'Shape'==52||'Shape'==53" />

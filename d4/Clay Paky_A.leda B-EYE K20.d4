    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;8&amp;&amp;'Shape'&lt;13" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==13||'Shape'==14" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FOG Machine GEIZER" ShortName="GEIZER" Company="Flash Butrym">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>695e67d3-a2c5-4530-9546-b79e445c3c41</Thumbnail>
  <History Date="10-03-19" Author="Nic Morris" Comment="Created" />
  <History Date="16-03-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a4a27c4b-d897-481e-8fec-a84b6de41280" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~10" Update="Col Mac Spd" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Update="Col Mac Spd" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Update="Col Mac Spd" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="21~25" Update="Col Mac Spd" Colour="0,255,255" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="26~30" Update="Col Mac Spd" Colour="255,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="31~35" Update="Col Mac Spd" Colour="255,255,0" />
      <Function ID="8" Name="Light Red" Display="'Light Red'" Dmx="36~40" Update="Col Mac Spd" Colour="255,100,100" />
      <Function ID="9" Name="Light Green" Display="'Light Green'" Dmx="41~45" Update="Col Mac Spd" Colour="128,255,0" />
      <Function ID="10" Name="Light Blue" Display="'Light Blue'" Dmx="46~50" Update="Col Mac Spd" Colour="0,128,255" />
      <Function ID="11" Name="Orange" Display="'Orange'" Dmx="51~55" Update="Col Mac Spd" Colour="255,128,0" />
      <Function ID="12" Name="Mint" Display="'Mint'" Dmx="56~60" Update="Col Mac Spd" Colour="128,255,0" />
      <Function ID="13" Name="Sky Blue" Display="'Sky Blue'" Dmx="61~65" Update="Col Mac Spd" Colour="0,128,255" />
      <Function ID="14" Name="Light Cyan" Display="'Light Cyan'" Dmx="66~70" Update="Col Mac Spd" Colour="128,255,255" />
      <Function ID="15" Name="Light Magenta" Display="'Light Magenta'" Dmx="71~75" Update="Col Mac Spd" Colour="255,128,255" />
      <Function ID="16" Name="Light Yellow" Display="'Light Yellow'" Dmx="76~80" Update="Col Mac Spd" Colour="255,255,128" />
      <Function ID="17" Name="White" Display="'White'" Dmx="81~85" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="18" Name="White 9000K" Display="'White 9000K'" Dmx="86~90" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="19" Name="White 6500K" Display="'White 6500K'" Dmx="91~95" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="20" Name="White 5600K" Display="'White 5600K'" Dmx="96~100" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="21" Name="White 5000K" Display="'White 5000K'" Dmx="101~105" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="22" Name="White 4500K" Display="'White 4500K'" Dmx="106~110" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="23" Name="White 3200K" Display="'White 3200K'" Dmx="111~115" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="24" Name="White 2500K" Display="'White 2500K'" Dmx="116~120" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="25" Name="White 2200K" Display="'White 2200K'" Dmx="121~125" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="26" Name="Step RGB" Display="'Step RGB'" Dmx="126~130" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="27" Name="Step RGBCMYW" Display="'Step RGBCMYW'" Dmx="131~135" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="28" Name="Step RGBCMY" Display="'Step RGBCMY'" Dmx="136~140" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="29" Name="Step RMBCGY" Display="'Step RMBCGY'" Dmx="141~145" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="30" Name="Fade RGB" Display="'Fade RGB'" Dmx="146~150" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="31" Name="Fade RGBCMYW" Display="'Fade RGBCMYW'" Dmx="151~155" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="32" Name="Fade RGBCMY" Display="'Fade RGBCMY'" Dmx="156~160" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="33" Name="Fade RMBCGY" Display="'Fade RMBCGY'" Dmx="161~165" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="34" Name="Fade ROY" Display="'Fade ROY'" Dmx="166~170" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="35" Name="Fade RVBM" Display="'Fade RVBM'" Dmx="171~175" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="36" Name="Fade GCBV" Display="'Fade GCBV'" Dmx="176~180" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="37" Name="Fog RGB" Display="'Fog RGB'" Dmx="181~185" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="38" Name="Fog RGBCMYW" Display="'Fog RGBCMYW'" Dmx="186~190" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="39" Name="Fog RGBCMY" Display="'Fog RGBCMY'" Dmx="191~195" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="40" Name="Fog RMBCGY" Display="'Fog RMBCGY'" Dmx="196~200" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="41" Name="Fog Change" Display="'Fog Change'" Dmx="201~205" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="42" Name="Fog Fade" Display="'Fog Fade'" Dmx="206~210" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="43" Name="Fog Pulse" Display="'Fog Pulse'" Dmx="211~215" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="44" Name="Fog Ramp" Display="'Fog Ramp'" Dmx="216~220" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="45" Name="Fog Random" Display="'Fog Random'" Dmx="221~225" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="46" Name="Sound RGB" Display="'Sound RGB'" Dmx="236~240" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="47" Name="Sound RGBCMYW" Display="'Sound RGBCMYW'" Dmx="241~245" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="48" Name="Sound RGBCMY" Display="'Sound RGBCMY'" Dmx="246~250" Update="Col Mac Spd" Colour="255,255,255" />
      <Function ID="49" Name="Sound RMBCGY" Display="'Sound RMBCGY'" Dmx="251~255" Update="Col Mac Spd" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;26" />
      <Condition Name="Macro" ID="4" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;37" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Pulse Spd" Display="'Pulse Spd %.1f%%',0.0~100.0" Dmx="6~255" Colour="255,255,255" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Classic 6, 7 DMX" Channels="7">

      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="30~44" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="45~59" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="60~74" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="75~89" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="90~104" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="105~119" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="120~134" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="135~149" />
      <Function ID="10" Name="Show 9" Display="'Show 9'" Dmx="150~164" />
      <Function ID="11" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="195~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

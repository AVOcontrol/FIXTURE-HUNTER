  <AtlaBase TypeID="af29930b-ce2e-4930-b0d3-5cc406b962fd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~0" />
      <Function ID="2" Name="Col/Gobo/Effect in Dark" Display="'Col/Gobo/Effect in Dark'" Dmx="250~252" />
      <Function ID="3" Name="All in Dark" Display="'All in Dark'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="255~255" />
      <Function ID="2" Name="Fan Speed" Display="'Fan Speed %.f%%',0~100" Dmx="127~0" />
      <Function ID="3" Name="Lamp On/ Reset" Display="'Lamp On/ Reset'" Dmx="128~139" />
      <Function ID="4" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1, Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1, Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Macro" Display="'Macro'" Dmx="0~0" Update="Colour1, Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1, Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==2" />
      <Condition Name="Macro" ID="14,15" If="'Colour1Func'==3" />
      <Else ID="16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="14~14" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="28~28" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="43~43" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="57~57" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="71~71" Colour="255,0,255" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="85~85" Colour="0,128,255" />
      <Function ID="8" Name="Turquoise" Display="'Turquoise'" Dmx="100~100" Colour="0,255,128" />
      <Function ID="9" Name="Orange" Display="'Orange'" Dmx="114~114" Colour="255,128,0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="127~127" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="15" Name="Macro" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1||'Colour1Func'==2" />
      <Condition Name="Macro" ID="10,11" If="'Colour1Func'==3" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Pink" Display="'Pink'" Dmx="14~14" Colour="255,150,150" />
      <Function ID="3" Name="Yellow-Green" Display="'Yellow-Green'" Dmx="28~28" Colour="255,255,0" />
      <Function ID="4" Name="Light Blue" Display="'Light Blue'" Dmx="43~43" Colour="0,128,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="57~57" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="71~71" Colour="255,0,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="85~85" Colour="255,240,200" />
      <Function ID="8" Name="3200K" Display="'3200K'" Dmx="100~100" Colour="230,230,255" />
      <Function ID="9" Name="UV" Display="'UV'" Dmx="114~114" Colour="50,0,200" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="11" Name="Enable Macro" Display="'Enable Macro'" Dmx="128~255" Colour="255,255,255" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Prism 1" Display="'Prism 1'" Dmx="0~0" Update="Effect" />
      <Function ID="4" Name="Prism 2" Display="'Prism 2'" Dmx="0~0" Update="Effect" />
      <Function ID="5" Name="Prism 3" Display="'Prism 3'" Dmx="0~0" Update="Effect" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~0" Update="Effect" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Effect" ID="1" If="'Effect_Func'==1" />
      <Condition Name="Frost" ID="2" If="'Effect_Func'==2" />
      <Condition Name="Prism 1" ID="3,4,5,6" If="'Effect_Func'==3" />
      <Condition Name="Prism 2" ID="7,8,9,10" If="'Effect_Func'==4" />
      <Condition Name="Prism 3" ID="11,12,13,14,15" If="'Effect_Func'==5" />
      <Else ID="16" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Frost" Display="''" Dmx="96~127" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~142" WheelPosition="1" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="143~144" WheelPosition="2" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="145~159" WheelPosition="3" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="8" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~177" WheelPosition="1" />
      <Function ID="9" Name="No Spin" Display="'No Spin'" Dmx="175~176" WheelPosition="2" />
      <Function ID="10" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="174~160" WheelPosition="3" />
      <Function ID="11" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="12" Name="Index" Display="'Index %.f%%',0~100" Dmx="224~255" />
      <Function ID="13" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="192~206" WheelPosition="1" />
      <Function ID="14" Name="No Spin" Display="'No Spin'" Dmx="207~208" WheelPosition="2" />
      <Function ID="15" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="209~223" WheelPosition="3" />
      <Function ID="16" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Gobo1Func'==1" />
      <Condition Name="Scroll" ID="7,8" If="'Gobo1Func'==2" />
      <Else ID="9" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="32~63" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="128~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="160~191" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="64~95" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="96~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="128~159" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="160~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="180~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="223~192" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="255~224" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="2:50" PowerOn="2:50" />
      <Function ID="1" Name="Zoom 15°" Display="'Zoom 15° %.f%%',0~100" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom 21°" Display="'Zoom 21° %.f%%',0~100" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom 28°" Display="'Zoom 28° %.f%%',0~100" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="EVA 1940Z" ShortName="EVA 1940Z" Company="Ablelite">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>5f7f0a1e-084e-4ad8-ae57-4d7fe58f1b42</Thumbnail>
  <History Date="05-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="09-01-15" Author="Nic Morris" Comment="Changed RGB Pixel to RGB and RGB to RGB Master so that it works with pixel mapper in response to manufacturer bug report." />
  <History Date="09-01-15" Author="Nic Morris" Comment="Applied cell layout in response to manufacturer information." />
  <History Date="11-03-15" Author="Nic Morris" Comment="Revised basic shutter ranges in line with revised documentation in response to manufacturer bug report." />
  <History Date="19-09-15" Author="Nic Morris" Comment="Inverted zoom (checked on actual fixture - documentation is incorrect)" />
  <History Date="27-09-15" Author="Nic Morris" Comment="Changed FG/BG Col and Pattern attributes to Effect group and revised wheel mapping to suit." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Swapped FG and BG col in line with physical fixture." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Revised FG and BG colour functions in line with physical fixture." />
  <History Date="27-09-15" Author="Nic Morris" Comment="Revised Pattern functions in line with physical fixture." />
  <History Date="02-12-15" Author="Nic Morris" Comment="Added new modes for latest firmware version (affects FG Col, BG Col, Pattern and Patt Spd)." />
  <History Date="02-12-15" Author="Nic Morris" Comment="Moved FG col, BG col, Pattern and Patt Spd to gobo wheel slots and adjusted attribute ID's to suit." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="10-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="10-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="12-08-16" Author="Nic Morris" Comment="Added physical pan/tilt range.  Note manufacturer data is wrong - calibrated against actual fixture." />
  <History Date="03-07-18" Author="Nic Morris" Comment="Created from Prolights DIAMOND19" />
  <History Date="06-07-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6e75e915-3cf5-4c99-be13-86e1f8db1e19" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Pulse FWD" Display="'Pulse FWD'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Pulse REV" Display="'Pulse REV'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll FW" Display="'Scroll FW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll REV" Display="'Scroll REV'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Index" Display="'Index'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="13:0" PowerOn="13:0" />
      <Condition Name="CTC" ID="1,2,3,4,5" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="6" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Index" ID="7,8,9,10,11,12" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Else ID="13" />
      <Function ID="1" Name="CTC" Display="'CTC %.1f%%',0.0~100.0" Dmx="0~223" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="224~231" Colour="255,255,255" />
      <Function ID="3" Name="4200K" Display="'4200K'" Dmx="232~239" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="240~247" Colour="255,255,255" />
      <Function ID="5" Name="8000K" Display="'8000K'" Dmx="248~255" Colour="255,255,255" />
      <Function ID="6" Name="Scroll" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="7" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="5~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red_Master" Name="Red Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Master" Name="Green Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Master" Name="Blue Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Master" Name="White Master" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="FG_Col" Name="FG Col" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="BG_Col" Name="BG Col" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="32~47" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Pattern 2" Display="'Pattern 2'" Dmx="48~63" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Pattern 3" Display="'Pattern 3'" Dmx="64~79" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Pattern 4" Display="'Pattern 4'" Dmx="80~95" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Pattern 5" Display="'Pattern 5'" Dmx="96~111" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Pattern 6" Display="'Pattern 6'" Dmx="112~127" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="128~143" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="144~159" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="160~175" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~191" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Pattern 11" Display="'Pattern 11'" Dmx="192~207" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Pattern 12" Display="'Pattern 12'" Dmx="208~223" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Pattern 13" Display="'Pattern 13'" Dmx="224~239" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Pattern 14" Display="'Pattern 14'" Dmx="240~255" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Control" Display="'Control'" Dmx="16~31" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Spd" Name="Patt Spd" Description="" Group="G">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Control" ID="1,2" If="'Pattern'==2" />
      <Condition Name="Effect" ID="3" If="'Pattern'&gt;1&amp;&amp;'Pattern'&lt;16" />
      <Else ID="4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~250" Dmx="3~252" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Function" Display="''" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="DJ Roboscan" ShortName="DJ Roboscn" Company="Aztec">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="06-02-16" Author="Nic Morris" Comment="Created (no manual or ranges - just channel list)" />
  <History Date="09-02-16" Author="Nic Morris" Comment="Updated with colour, gobo and shutter function ranges in response to customer information." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~17" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~35" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="36~53" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="54~71" Colour="128,0,255" />
      <Function ID="5" Name="Dark Green" Display="'Dark Green'" Dmx="72~90" Colour="0,180,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="91~107" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="108~125" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="126~143" Colour="255,150,150" />
      <Function ID="9" Name="Green" Display="'Green'" Dmx="144~161" Colour="0,255,0" />
      <Function ID="10" Name="Light Blue" Display="'Light Blue'" Dmx="162~179" Colour="0,128,255" />
      <Function ID="11" Name="Deep Orange" Display="'Deep Orange'" Dmx="180~198" Colour="255,100,0" />
      <Function ID="12" Name="Lime" Display="'Lime'" Dmx="199~216" Colour="128,255,0" />
      <Function ID="13" Name="Deep Pink" Display="'Deep Pink'" Dmx="217~234" Colour="255,150,150" />
      <Function ID="14" Name="Red/ Blue" Display="'Red/ Blue'" Dmx="235~251" Colour="255,0,0" />
      <Function ID="15" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="252~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~22" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="23~35" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="36~53" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="54~71" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="72~89" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="90~107" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="108~125" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="126~143" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="144~161" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="162~179" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="180~197" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="198~215" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="216~233" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="234~251" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="252~255" WheelPosition="14" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="15~29" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="30~250" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="251~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="AZRBSCAN" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="2" Wheel="14" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
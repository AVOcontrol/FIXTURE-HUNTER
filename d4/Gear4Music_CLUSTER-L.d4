  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b249a5d6-6260-494f-9b25-986b8fd11b5e" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Derby+Laser" Display="'Derby+Laser'" Dmx="6~90" />
      <Function ID="3" Name="Derby" Display="'Derby'" Dmx="91~173" />
      <Function ID="4" Name="Laser" Display="'Laser'" Dmx="174~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Derby_Colour" Name="Derby Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~35" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~50" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="51~65" Colour="255,255,255" />
      <Function ID="6" Name="Red/Green" Display="'Red/Green'" Dmx="66~80" Colour="255,255,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue'" Dmx="81~95" Colour="255,255,255" />
      <Function ID="8" Name="Red/White" Display="'Red/White'" Dmx="96~110" Colour="255,255,255" />
      <Function ID="9" Name="Green/Blue" Display="'Green/Blue'" Dmx="111~125" Colour="255,255,255" />
      <Function ID="10" Name="Green/White" Display="'Green/White'" Dmx="126~140" Colour="255,255,255" />
      <Function ID="11" Name="Blue/White" Display="'Blue/White'" Dmx="141~155" Colour="255,255,255" />
      <Function ID="12" Name="Red/Green/Blue" Display="'Red/Green/Blue'" Dmx="156~170" Colour="255,255,255" />
      <Function ID="13" Name="Red/Green/White" Display="'Red/Green/White'" Dmx="171~185" Colour="255,255,255" />
      <Function ID="14" Name="Green/Blue/White" Display="'Green/Blue/White'" Dmx="186~200" Colour="255,255,255" />
      <Function ID="15" Name="Red/Green/Blue/White" Display="'Red/Green/Blue/White'" Dmx="201~215" Colour="255,255,255" />
      <Function ID="16" Name="4-Col Chase" Display="'4-Col Chase'" Dmx="216~230" Colour="255,255,255" />
      <Function ID="17" Name="7-Col Chase" Display="'7-Col Chase'" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Derby_Strobe" Name="Derby Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Derby_Motor" Name="Derby Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~47" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="48~89" Colour="0,255,0" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="90~131" Colour="255,255,255" />
      <Function ID="5" Name="Red On+Green Strobe" Display="'Red On+Green Strobe'" Dmx="132~172" Colour="255,255,255" />
      <Function ID="6" Name="Green On+Red Strobe" Display="'Green On+Red Strobe'" Dmx="173~214" Colour="255,255,255" />
      <Function ID="7" Name="Red+Green (Alternate Strobe)" Display="'Red+Green (Alternate Strobe)'" Dmx="215~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Laser_Motor" Name="Laser Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~127" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cc75b34a-b4a8-443f-9ee9-b971cd2e9a13" />
    <Include>
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7f3952fb-95b1-4fee-8f2b-da6b7fb54cfc" />
    <Include>
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />

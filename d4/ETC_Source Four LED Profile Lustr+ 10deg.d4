    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2:4608" PowerOn="2:4608" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2700~6500" Dmx="1~254" Colour="255,240,200" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+Grn" Display="'+Grn %.1f%%',100.0~0.0" Dmx="1~127" Colour="128,255,0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="-Grn" Display="'-Grn %.1f%%',0.0~100.0" Dmx="129~255" Colour="128,255,0" />
    </Attribute>
    <Attribute ID="Plus7" Name="Plus7" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Enabled" Display="'Enabled'" Dmx="255~255" />
      <Function ID="2" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />

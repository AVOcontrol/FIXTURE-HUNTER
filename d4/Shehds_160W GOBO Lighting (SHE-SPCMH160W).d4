      <Function ID="26" Name="Blue-Green mode" Display="'Blue-Green mode'" Dmx="202~211" />
      <Function ID="27" Name="Yellow-Blue mode" Display="'Yellow-Blue mode'" Dmx="212~221" />
      <Function ID="28" Name="Light blue-Yellow mode" Display="'Light blue-Yellow mode'" Dmx="222~231" />
      <Function ID="29" Name="Pink-Light blue mode" Display="'Pink-Light blue mode'" Dmx="232~241" />
      <Function ID="30" Name="Green-Red mode" Display="'Green-Red mode'" Dmx="242~251" />
      <Function ID="31" Name="Random mode" Display="'Random mode'" Dmx="252~255" />

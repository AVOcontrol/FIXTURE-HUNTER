      <Function ID="21" Name="Pink-Light blue mode" Display="'Pink-Light blue mode'" Dmx="152~161" />
      <Function ID="22" Name="Light blue - Pink mode" Display="'Light blue - Pink mode'" Dmx="162~171" />
      <Function ID="23" Name="RGB Loot mode" Display="'RGB Loot mode'" Dmx="172~181" />

  <History Date="21-09-24" Author="Nic Morris" Comment="Created (hopeless documentation.  vague.  charts in digital manual are titled 16-Channels Mode but only list 15.  Specs in digital manual are 15 but menu system shows 16.  Specs on website say 17.  Product image in digital manual is clearly a different product.  Used customer paper copy of charts which list 17)" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="86154d7e-0e63-41b2-a9cc-ebe58b6f68d4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">

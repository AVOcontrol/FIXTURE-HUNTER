  <History Date="20-01-26" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="22-01-26" Author="Nic Morris" Comment="Corrected 16bit pan/tilt mapping." Version="1" />
  <History Date="26-01-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8f3398d4-285c-4045-87fe-93a71f301df7" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Lens_Rot" Name="Lens Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="60~69" Colour="0,0,0" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="90~99" Colour="0,0,0" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="100~109" Colour="0,0,0" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="110~119" Colour="0,0,0" />
      <Function ID="13" Name="All On" Display="'All On'" Dmx="120~129" Colour="0,0,0" />
      <Function ID="14" Name="Transient" Display="'Transient %.f%%',0~100" Dmx="171~130" Colour="0,0,0" />
      <Function ID="15" Name="Gradually" Display="'Gradually %.f%%',0~100" Dmx="213~172" Colour="0,0,0" />
      <Function ID="16" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="255~214" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto/Sound" Name="Auto/Sound" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Run Fast" Display="'Run Fast'" Dmx="64~127" />
      <Function ID="3" Name="Run Slow" Display="'Run Slow'" Dmx="128~191" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Small Motor" Display="'Reset Small Motor'" Dmx="64~127" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="128~191" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16" Id="2fae9c25-17c1-4372-a255-3b5e16cb894c">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="fd69ff33-ca3d-4d4c-90cc-140dfaaa378a" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Red" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="10" Wheel="12" />
      <Attribute ID="White" ChannelOffset="11" Wheel="40" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Lens_Rot" ChannelOffset="13" Wheel="20" />
      <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="7" />
      <Attribute ID="Auto/Sound" ChannelOffset="15" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Small Motor">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

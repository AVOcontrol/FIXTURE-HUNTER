      <Attribute ID="Dim_Mode" ChannelOffset="5" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Linear">
      <Set Channel="Dim_Curve:2" Delay="4000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="Sqyare">
      <Set Channel="Dim_Curve:3" Delay="4000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="Inv Square">
      <Set Channel="Dim_Curve:4" Delay="4000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="S-Curve">
      <Set Channel="Dim_Curve:5" Delay="4000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="LED Dimmer Mode">
      <Set Channel="Dim_Mode:2" Delay="4000" />
      <Set Channel="Dim_Mode:1" Delay="0" />
    </Macro>
    <Macro Name="Halogen Dimmer Mode">
      <Set Channel="Dim_Mode:3" Delay="4000" />
      <Set Channel="Dim_Mode:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>

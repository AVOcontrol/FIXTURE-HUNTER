    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="8~13" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="14~19" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="20~25" />

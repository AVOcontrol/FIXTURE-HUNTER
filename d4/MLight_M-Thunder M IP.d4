  <History Date="02-07-25" Author="Nic Morris" Comment="Created (hopeless documentation.  most of the control functions/macros are nonsense)" Version="0" />
  <History Date="05-07-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="35f0e457-941a-44fc-8316-0d7e77ebcb29" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Atomization" Display="'Atomization %.f%%',0~100" Dmx="5~69" />
      <Function ID="3" Name="CH1" Display="'CH1'" Dmx="70~74" />
      <Function ID="4" Name="CH2" Display="'CH2'" Dmx="75~79" />
      <Function ID="5" Name="CH3" Display="'CH3'" Dmx="80~84" />
      <Function ID="6" Name="CH4" Display="'CH4'" Dmx="85~89" />
      <Function ID="7" Name="No DMX Light Off" Display="'No DMX Light Off'" Dmx="90~94" />
      <Function ID="8" Name="No DMX Light On" Display="'No DMX Light On'" Dmx="95~99" />
      <Function ID="9" Name="No DMX Hold" Display="'No DMX Hold'" Dmx="100~104" />
      <Function ID="10" Name="No DMX Menu" Display="'No DMX Menu'" Dmx="105~109" />
      <Function ID="11" Name="No DMX Auto" Display="'No DMX Auto'" Dmx="110~114" />
      <Function ID="12" Name="Fan High" Display="'Fan High'" Dmx="115~119" />
      <Function ID="13" Name="Fan Auto" Display="'Fan Auto'" Dmx="120~124" />
      <Function ID="14" Name="Fan Low" Display="'Fan Low'" Dmx="125~129" />
      <Function ID="15" Name="Shutter Time" Display="'Shutter Time'" Dmx="130~134" />
      <Function ID="16" Name="Shutter Hz" Display="'Shutter Hz'" Dmx="135~139" />
      <Function ID="17" Name="Dim Spd Auto" Display="'Dim Spd Auto'" Dmx="140~144" />
      <Function ID="18" Name="Dim Spd 1" Display="'Dim Spd 1'" Dmx="145~149" />
      <Function ID="19" Name="Dim Spd 2" Display="'Dim Spd 2'" Dmx="150~154" />
      <Function ID="20" Name="Dim Spd 3" Display="'Dim Spd 3'" Dmx="155~159" />
      <Function ID="21" Name="LED 1200Hz" Display="'LED 1200Hz'" Dmx="160~164" />
      <Function ID="22" Name="LED 2400Hz" Display="'LED 2400Hz'" Dmx="165~169" />
      <Function ID="23" Name="LED 4800Hz" Display="'LED 4800Hz'" Dmx="170~174" />
      <Function ID="24" Name="LED 9600Hz" Display="'LED 9600Hz'" Dmx="175~179" />
      <Function ID="25" Name="19200Hz" Display="'19200Hz'" Dmx="180~184" />
      <Function ID="26" Name="RGBW 1-2" Display="'RGBW 1-2'" Dmx="185~189" />
      <Function ID="27" Name="RGBW 1&lt;-&gt;2" Display="'RGBW 1&lt;-&gt;2'" Dmx="190~194" />
      <Function ID="28" Name="RGBW 1-&gt;" Display="'RGBW 1-&gt;'" Dmx="195~199" />
      <Function ID="29" Name="RGBW 1&lt;-" Display="'RGBW 1&lt;-'" Dmx="200~204" />
      <Function ID="30" Name="RGBW 2-&gt;" Display="'RGBW 2-&gt;'" Dmx="205~209" />
      <Function ID="31" Name="RGBW 2-&lt;" Display="'RGBW 2-&lt;'" Dmx="210~214" />
      <Function ID="32" Name="Tilt" Display="'Tilt'" Dmx="215~219" />
      <Function ID="33" Name="Tilt Invert" Display="'Tilt Invert'" Dmx="220~224" />
      <Function ID="34" Name="Tilt Sensor Yes" Display="'Tilt Sensor Yes'" Dmx="225~229" />
      <Function ID="35" Name="Tilt Sensor No" Display="'Tilt Sensor No'" Dmx="230~234" />
      <Function ID="36" Name="Tilt Reset Yes" Display="'Tilt Reset Yes'" Dmx="235~239" />
      <Function ID="37" Name="Tilt Reset No" Display="'Tilt Reset No'" Dmx="240~244" />
      <Function ID="38" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~151" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~244" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="152~175" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="176~199" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_F" Name="Macro F" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro_B" Name="Macro B" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

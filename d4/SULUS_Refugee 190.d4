    </Attribute>
    <Attribute ID="Col_Mac_1" Name="Col Mac 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="51~60" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="B+W" Display="'B+W'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="R+W" Display="'R+W'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="RGB" Display="'RGB'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="GBW" Display="'GBW'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="151~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_2" Name="Col Mac 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="21~180" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="201~225" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0819ec5a-bd4f-46ea-a4ca-f74a7fd36a79" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~17" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="18~27" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="28~37" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="38~47" Colour="255,255,255" />
      <Function ID="6" Name="R/G" Display="'R/G'" Dmx="48~57" Colour="255,255,255" />
      <Function ID="7" Name="G/B" Display="'G/B'" Dmx="58~67" Colour="255,255,255" />
      <Function ID="8" Name="B/W" Display="'B/W'" Dmx="68~77" Colour="255,255,255" />
      <Function ID="9" Name="R/W" Display="'R/W'" Dmx="78~87" Colour="255,255,255" />
      <Function ID="10" Name="R/G/B" Display="'R/G/B'" Dmx="88~97" Colour="255,255,255" />
      <Function ID="11" Name="G/B/W" Display="'G/B/W'" Dmx="98~107" Colour="255,255,255" />
      <Function ID="12" Name="R/B/W" Display="'R/B/W'" Dmx="108~117" Colour="255,255,255" />
      <Function ID="13" Name="R/G/W" Display="'R/G/W'" Dmx="118~127" Colour="255,255,255" />
      <Function ID="14" Name="R/G/B/W" Display="'R/G/B/W'" Dmx="128~137" Colour="255,255,255" />
      <Function ID="15" Name="Change" Display="'Change'" Dmx="138~188" Colour="255,255,255" />
      <Function ID="16" Name="Fade" Display="'Fade'" Dmx="189~239" Colour="255,255,255" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~8" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt_Movement" Name="Tilt Movement" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="8~32" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="33~58" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="59~84" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="85~110" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="111~136" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="137~162" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="163~188" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="189~214" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="215~240" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Macro Speed High" Display="'P/T Macro Speed High'" Dmx="51~100" />
      <Function ID="3" Name="P/T Macro Speed Low" Display="'P/T Macro Speed Low'" Dmx="151~200" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX" Channels="17">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8dc5e7eb-3eec-4233-8842-7a9c162296b3" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="White" ChannelOffset="8" Wheel="40" />
      <Attribute ID="Colour_Macro" ChannelOffset="9" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="5" />
      <Attribute ID="Pan_Spin" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Pan_Speed" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Tilt_Movement" ChannelOffset="14" Wheel="26" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="15" Wheel="8" />
      <Attribute ID="P/T_Macro" ChannelOffset="16" Wheel="22" />
      <Attribute ID="Control" ChannelOffset="17" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="bc4f4353-aeb0-4fe1-b5c1-9413764905c6" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="4" Wheel="8" />
      <Attribute ID="P/T_Macro" ChannelOffset="5" Wheel="22" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Macro Speed High">
      <Set Channel="Control:2" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="P/T Macro Speed Low">
      <Set Channel="Control:3" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

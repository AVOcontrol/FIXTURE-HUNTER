    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1 - Fast" Display="'Auto 1 - Fast'" Dmx="128~169" />
      <Function ID="3" Name="Auto 2 - Slow" Display="'Auto 2 - Slow'" Dmx="170~209" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="210~249" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>

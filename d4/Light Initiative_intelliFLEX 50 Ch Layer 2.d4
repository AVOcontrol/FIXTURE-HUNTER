<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="intelliFLEX 50 Ch Layer 2" ShortName="iFLEX L2" Company="Light Initiative">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="08-07-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Col_Mix" Name="Col Mix" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="FX_Select" Name="FX Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Pap 1 Col Snap" Display="'Pap 1 Col Snap'" Dmx="26~32" />
      <Function ID="3" Name="Pap 1 Col Fade" Display="'Pap 1 Col Fade'" Dmx="33~38" />
      <Function ID="4" Name="Pap 2 Col Snap" Display="'Pap 2 Col Snap'" Dmx="39~44" />
      <Function ID="5" Name="Pap 2 Col Fade" Display="'Pap 2 Col Fade'" Dmx="45~51" />
      <Function ID="6" Name="Uniform Decay" Display="'Uniform Decay'" Dmx="52~76" />
      <Function ID="7" Name="Uniform Col" Display="'Uniform Col'" Dmx="77~102" />
      <Function ID="8" Name="Tears White" Display="'Tears White'" Dmx="103~127" />
      <Function ID="9" Name="Crazy" Display="'Crazy'" Dmx="128~153" />
      <Function ID="10" Name="Anim 1" Display="'Anim 1'" Dmx="154~169" />
      <Function ID="11" Name="Anim 2" Display="'Anim 2'" Dmx="170~179" />
      <Function ID="12" Name="Jockey" Display="'Jockey'" Dmx="180~189" />
      <Function ID="13" Name="Checkers" Display="'Checkers'" Dmx="190~199" />
      <Function ID="14" Name="Col Merge" Display="'Col Merge'" Dmx="200~209" />
      <Function ID="15" Name="Wave" Display="'Wave'" Dmx="210~219" />
      <Function ID="16" Name="Sweep Continuous" Display="'Sweep Continuous'" Dmx="220~254" />
      <Function ID="17" Name="Sweep Indexed" Display="'Sweep Indexed'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Index" Name="Index" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="64~127" />
      <Function ID="3" Name="Mirror Out" Display="'Mirror Out'" Dmx="128~191" />
      <Function ID="4" Name="Mirror In" Display="'Mirror In'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Tail" Name="Tail" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Tail" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Head" Name="Head" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Head" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Offset" Name="Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Density" Name="Density" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Repeat" Name="Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full" Display="'Full'" Dmx="0~0" />
      <Function ID="2" Name="x2" Display="'x2'" Dmx="26~26" />
      <Function ID="3" Name="x4" Display="'x4'" Dmx="64~127" />
      <Function ID="4" Name="x8" Display="'x8'" Dmx="128~195" />
      <Function ID="5" Name="x16" Display="'x16'" Dmx="196~254" />
      <Function ID="6" Name="x32" Display="'x32'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Randomise" Name="Randomise" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Randomise" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Map_Start" Name="Map Start" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Map Start" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Map_Size" Name="Map Size" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Map Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pre_Built_FX" Name="Pre Built FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="5 Dots" Display="'5 Dots'" Dmx="1~10" />
      <Function ID="3" Name="Dots Move" Display="'Dots Move'" Dmx="11~20" />
      <Function ID="4" Name="Wave Out" Display="'Wave Out'" Dmx="21~30" />
      <Function ID="5" Name="Gentle Pap" Display="'Gentle Pap'" Dmx="31~40" />
      <Function ID="6" Name="Pap Move 2 Col" Display="'Pap Move 2 Col'" Dmx="41~50" />
      <Function ID="7" Name="Slow Large Wave" Display="'Slow Large Wave'" Dmx="51~60" />
      <Function ID="8" Name="More Waves Down" Display="'More Waves Down'" Dmx="61~70" />
      <Function ID="9" Name="More Waves Up" Display="'More Waves Up'" Dmx="71~80" />
      <Function ID="10" Name="Quick Waves" Display="'Quick Waves'" Dmx="81~90" />
      <Function ID="11" Name="Quick Pap 1 Col" Display="'Quick Pap 1 Col'" Dmx="91~100" />
      <Function ID="12" Name="Quick Pap 2 Col" Display="'Quick Pap 2 Col'" Dmx="101~110" />
      <Function ID="13" Name="Quick Trace" Display="'Quick Trace'" Dmx="111~120" />
      <Function ID="14" Name="Racing 1" Display="'Racing 1'" Dmx="121~130" />
      <Function ID="15" Name="Racing 2" Display="'Racing 2'" Dmx="131~140" />
      <Function ID="16" Name="Random Sweeps" Display="'Random Sweeps'" Dmx="141~150" />
      <Function ID="17" Name="Rocket" Display="'Rocket'" Dmx="151~160" />
      <Function ID="18" Name="Pap Hardcore" Display="'Pap Hardcore'" Dmx="161~170" />
      <Function ID="19" Name="Mental" Display="'Mental'" Dmx="171~180" />
      <Function ID="20" Name="Lighting" Display="'Lighting'" Dmx="181~190" />
      <Function ID="21" Name="None" Display="'None'" Dmx="191~255" />
    </Attribute>
  </Control>
  <Mode Name="22 DMX" Channels="22">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Rotate" ChannelOffset="2" Wheel="19" />
        <Attribute ID="Col_Mix" ChannelOffset="3" Wheel="8" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="FX_Select" ChannelOffset="10" Wheel="22" />
        <Attribute ID="Speed" ChannelOffset="11" Wheel="23" />
        <Attribute ID="Index" ChannelOffset="12" Wheel="24" />
        <Attribute ID="Direction" ChannelOffset="13" Wheel="52" />
        <Attribute ID="Tail" ChannelOffset="14" Wheel="53" />
        <Attribute ID="Head" ChannelOffset="15" Wheel="54" />
        <Attribute ID="Offset" ChannelOffset="16" Wheel="82" />
        <Attribute ID="Density" ChannelOffset="17" Wheel="83" />
        <Attribute ID="Repeat" ChannelOffset="18" Wheel="84" />
        <Attribute ID="Randomise" ChannelOffset="19" Wheel="112" />
        <Attribute ID="Map_Start" ChannelOffset="20" Wheel="113" />
        <Attribute ID="Map_Size" ChannelOffset="21" Wheel="114" />
        <Attribute ID="Pre_Built_FX" ChannelOffset="22" Wheel="142" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
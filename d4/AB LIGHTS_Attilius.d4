  <Macro>
    <Macro Name="Battery Full">
      <Set Channel="Control:2,Dimmer:1:100" Delay="11000" />
      <Set Channel="Control:1,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Battery Med">
      <Set Channel="Control:3,Dimmer:1:100" Delay="11000" />
      <Set Channel="Control:1,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Battery Eco">
      <Set Channel="Control:4,Dimmer:1:100" Delay="11000" />
      <Set Channel="Control:1,Dimmer:1:0" Delay="0" />
    </Macro>
    <Macro Name="Unlink">
      <Set Channel="Control:5" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Factory Reset">
      <Set Channel="Control:6" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

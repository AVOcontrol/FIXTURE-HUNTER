  <AtlaBase TypeID="ac6c6bed-2b5c-4382-b0d6-18c7d20d1c9b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" />
      <Function ID="3" Name="Rnd Strobe 1" Display="'Rnd Strobe 1 %.f%%',0~100" Dmx="162~207" />
      <Function ID="4" Name="Rnd Strobe 2" Display="'Rnd Strobe 2 %.f%%',0~100" Dmx="210~255" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="60~108" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="111~159" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SPP20ZX3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

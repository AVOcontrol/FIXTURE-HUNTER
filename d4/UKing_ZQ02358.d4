  <AtlaBase TypeID="3fe1caa1-a99e-4c20-a336-0b268f75714e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~8500" Dmx="255~1" Colour="255,240,200" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Beam_Effect" Name="Beam Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Gradient Effect" Display="'Gradient Effect'" Dmx="1~25" />
      <Function ID="3" Name="Chase Effect" Display="'Chase Effect'" Dmx="26~51" />
      <Function ID="4" Name="Rainbow Effect" Display="'Rainbow Effect'" Dmx="52~77" />
      <Function ID="5" Name="Fade Effect 1" Display="'Fade Effect 1'" Dmx="78~103" />
      <Function ID="6" Name="Fade Effect 2" Display="'Fade Effect 2'" Dmx="104~129" />
      <Function ID="7" Name="Fade 3" Display="'Fade 3'" Dmx="130~155" />
      <Function ID="8" Name="Fade 4" Display="'Fade 4'" Dmx="156~181" />
      <Function ID="9" Name="Gradient 5" Display="'Gradient 5'" Dmx="182~207" />
      <Function ID="10" Name="Gradient 6" Display="'Gradient 6'" Dmx="208~233" />
      <Function ID="11" Name="Fade Effect 7" Display="'Fade Effect 7'" Dmx="234~255" />
    </Attribute>
    <Attribute ID="Strip_Effect" Name="Strip Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="1~63" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="64~127" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="128~191" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~205" />
    </Attribute>
  </Control>

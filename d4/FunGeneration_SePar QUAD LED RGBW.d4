  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e39135ba-6bec-4ffe-a7ce-db59a9850ada" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~9" Update="Auto_Spd" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="10~14" Update="Auto_Spd" />
      <Function ID="4" Name="Fawn" Display="'Fawn'" Dmx="15~19" Update="Auto_Spd" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="20~24" Update="Auto_Spd" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="25~29" Update="Auto_Spd" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="30~34" Update="Auto_Spd" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="35~39" Update="Auto_Spd" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="40~44" Update="Auto_Spd" />
      <Function ID="10" Name="Amber" Display="'Amber'" Dmx="45~49" Update="Auto_Spd" />
      <Function ID="11" Name="Light Red" Display="'Light Red'" Dmx="50~54" Update="Auto_Spd" />
      <Function ID="12" Name="Light Green" Display="'Light Green'" Dmx="55~59" Update="Auto_Spd" />
      <Function ID="13" Name="Light Blue" Display="'Light Blue'" Dmx="60~64" Update="Auto_Spd" />
      <Function ID="14" Name="Cold White" Display="'Cold White'" Dmx="65~69" Update="Auto_Spd" />
      <Function ID="15" Name="White" Display="'White'" Dmx="70~74" Update="Auto_Spd" />
      <Function ID="16" Name="Warm White" Display="'Warm White'" Dmx="75~79" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 2" Display="'Auto 2'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 3" Display="'Auto 3'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="19" Name="Auto 4" Display="'Auto 4'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="20" Name="Auto 5" Display="'Auto 5'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="21" Name="Auto 6" Display="'Auto 6'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="22" Name="Auto 7" Display="'Auto 7'" Dmx="130~139" Update="Auto_Spd" />
      <Function ID="23" Name="Auto 8" Display="'Auto 8'" Dmx="140~149" Update="Auto_Spd" />
      <Function ID="24" Name="Auto 9" Display="'Auto 9'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="25" Name="Auto 10" Display="'Auto 10'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="26" Name="Auto 11" Display="'Auto 11'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="27" Name="Auto 12" Display="'Auto 12'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="28" Name="Sound" Display="'Sound'" Dmx="190~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==28" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKFGSPQ2" DiamondRef="" WysiwygRef="" />
    <Physical>

      <Function ID="8" Name="White Fade" Display="'White Fade %.f%%',0~100" Dmx="120~139" />
      <Function ID="9" Name="Effect 1" Display="'Effect 1'" Dmx="140~159" />
      <Function ID="10" Name="Effect 2" Display="'Effect 2'" Dmx="160~179" />
      <Function ID="11" Name="Effect 3" Display="'Effect 3'" Dmx="180~199" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="intelliFLEX 2" ShortName="LI intFlx2" Company="Light Initiative">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="09-03-12" Author="Peter Budd" Comment="Created" />
  <History Date="15-11-12" Author="Peter Budd" Comment="Updated to include 20 channel mode" />
  <History Date="24-05-13" Author="Peter Budd" Comment="Created from Light Initiative intelliFlex" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~25" />
      <Function ID="2" Name="1 Col Snap" Display="'1 Col Snap'" Dmx="26~32" />
      <Function ID="3" Name="1 Col Fade" Display="'1 Col Fade'" Dmx="33~38" />
      <Function ID="4" Name="2 Col Snap" Display="'2 Col Snap'" Dmx="39~44" />
      <Function ID="5" Name="2 Col Fade" Display="'2 Col Fade'" Dmx="45~51" />
      <Function ID="6" Name="Uniform Decay" Display="'Uniform Decay'" Dmx="52~76" />
      <Function ID="7" Name="Uniform Colour" Display="'Uniform Colour'" Dmx="77~102" />
      <Function ID="8" Name="Tears White" Display="'Tears White'" Dmx="103~127" />
      <Function ID="9" Name="Crazy" Display="'Crazy'" Dmx="128~153" />
      <Function ID="10" Name="Lightning" Display="'Lightning'" Dmx="154~169" />
      <Function ID="11" Name="Lightning" Display="'Lightning'" Dmx="170~179" />
      <Function ID="12" Name="Jockey" Display="'Jockey'" Dmx="180~189" />
      <Function ID="13" Name="Checkers" Display="'Checkers'" Dmx="190~199" />
      <Function ID="14" Name="Color Merge" Display="'Color Merge'" Dmx="200~209" />
      <Function ID="15" Name="Wave" Display="'Wave'" Dmx="210~219" />
      <Function ID="16" Name="Continuos" Display="'Continuos'" Dmx="220~254" />
      <Function ID="17" Name="Indexed" Display="'Indexed'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Effect Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Effect_Dir" Name="Effect Dir" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~63" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="64~127" />
      <Function ID="3" Name="Mirror Out" Display="'Mirror Out'" Dmx="128~191" />
      <Function ID="4" Name="Mirror In" Display="'Mirror In'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Effect_TraceTail" Name="Effect Trc Tail" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Trace" Display="'Trace %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_TraceHead" Name="Effect Trc Hd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Head" Display="'Head %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Off" Name="Effect Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'Offset %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Int" Name="Eff Intensity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'Intensity %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect Repeat" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full" Display="'Full'" Dmx="0~0" />
      <Function ID="2" Name="Half" Display="'Half'" Dmx="1~63" />
      <Function ID="3" Name="Quarter" Display="'Quarter'" Dmx="64~127" />
      <Function ID="4" Name="Eigth" Display="'Eigth'" Dmx="128~195" />
      <Function ID="5" Name="Sixteenth" Display="'Sixteenth'" Dmx="196~254" />
      <Function ID="6" Name="1/32" Display="'1/32'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect2" Name="Effect Fan" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'Fan %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Move" Name="Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Move" Display="'Move %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Mix" Display="'No Mix'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Mix" Display="'Mix'" Dmx="1~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="EffectRnd" Name="Effect Random" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Randomizer" Display="'Randomizer %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_ElMap" Name="Element Map" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Map On" Display="'Map On'" Dmx="0~0" />
      <Function ID="2" Name="Map Off" Display="'Map Off'" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="21 DMX, 8bit" Channels="21">
    <Import PearlRef="UK_LIIFLX_2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Effect_Int" ChannelOffset="17" Wheel="4" />
      <Attribute ID="Move" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Red1" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Red2" ChannelOffset="7" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="8" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="9" Wheel="42" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="10" Wheel="22" />
      <Attribute ID="Effect_Dir" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Effect_TraceTail" ChannelOffset="14" Wheel="52" />
      <Attribute ID="Effect_TraceHead" ChannelOffset="15" Wheel="53" />
      <Attribute ID="Effect_Off" ChannelOffset="16" Wheel="24" />
      <Attribute ID="Effect1" ChannelOffset="18" Wheel="82" />
      <Attribute ID="EffectRnd" ChannelOffset="19" Wheel="83" />
      <Attribute ID="Effect_ElMap" ChannelOffset="20" Wheel="54" />
      <Attribute ID="Effect2" ChannelOffset="21" Wheel="112" />
      <Attribute ID="Speed" ChannelOffset="11" Wheel="25" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Move" ChannelOffset="2" Wheel="3" />
        <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="9" />
        <Attribute ID="Effect" ChannelOffset="10" Wheel="22" />
        <Attribute ID="Speed" ChannelOffset="11" Wheel="25" />
        <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
        <Attribute ID="Effect_Dir" ChannelOffset="13" Wheel="23" />
        <Attribute ID="Effect_TraceTail" ChannelOffset="14" Wheel="52" />
        <Attribute ID="Effect_TraceHead" ChannelOffset="15" Wheel="53" />
        <Attribute ID="Effect_Off" ChannelOffset="16" Wheel="24" />
        <Attribute ID="Effect_Int" ChannelOffset="17" Wheel="4" />
        <Attribute ID="Effect1" ChannelOffset="18" Wheel="82" />
        <Attribute ID="EffectRnd" ChannelOffset="19" Wheel="83" />
        <Attribute ID="Effect_ElMap" ChannelOffset="20" Wheel="54" />
        <Attribute ID="Effect2" ChannelOffset="21" Wheel="112" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="7" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>

  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="02-10-08" Author="David Hunt" Comment="Created" />
  <History Date="13-10-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="17-09-11" Author="Nic Morris" Comment="Simplified attributes and modes.  Increased wheel resolution.  Added pixel mapper compatibility." />
  <History Date="17-09-11" Author="Nic Morris" Comment="Fixed power on and locate." />
  <History Date="06-11-12" Author="Peter Budd" Comment="Removed virtual dimmer from the cells." />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VL-65" ShortName="VL-65" Company="QTX Light">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="06-06-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro %.f%%',0~100" Dmx="5~80" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="81~150" />
      <Function ID="4" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="151~220" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="9~16" Colour="255,255,255" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="17~24" Colour="255,255,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="25~32" Colour="255,255,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="33~40" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="41~48" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="49~56" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="57~64" Colour="255,255,255" />
      <Function ID="9" Name="R+A" Display="'R+A'" Dmx="65~72" Colour="255,255,255" />
      <Function ID="10" Name="G+B" Display="'G+B'" Dmx="73~80" Colour="255,255,255" />
      <Function ID="11" Name="G+W" Display="'G+W'" Dmx="81~88" Colour="255,255,255" />
      <Function ID="12" Name="G+A" Display="'G+A'" Dmx="89~96" Colour="255,255,255" />
      <Function ID="13" Name="B+W" Display="'B+W'" Dmx="97~104" Colour="255,255,255" />
      <Function ID="14" Name="B+A" Display="'B+A'" Dmx="105~112" Colour="255,255,255" />
      <Function ID="15" Name="W+A" Display="'W+A'" Dmx="113~120" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B" Display="'R+G+B'" Dmx="121~128" Colour="255,255,255" />
      <Function ID="17" Name="R+G+W" Display="'R+G+W'" Dmx="129~136" Colour="255,255,255" />
      <Function ID="18" Name="R+G+A" Display="'R+G+A'" Dmx="137~144" Colour="255,255,255" />
      <Function ID="19" Name="R+B+W" Display="'R+B+W'" Dmx="145~152" Colour="255,255,255" />
      <Function ID="20" Name="R+B+A" Display="'R+B+A'" Dmx="153~160" Colour="255,255,255" />
      <Function ID="21" Name="R+W+A" Display="'R+W+A'" Dmx="161~168" Colour="255,255,255" />
      <Function ID="22" Name="G+B+W" Display="'G+B+W'" Dmx="169~176" Colour="255,255,255" />
      <Function ID="23" Name="G+B+A" Display="'G+B+A'" Dmx="177~184" Colour="255,255,255" />
      <Function ID="24" Name="G+W+A" Display="'G+W+A'" Dmx="185~192" Colour="255,255,255" />
      <Function ID="25" Name="B+W+A" Display="'B+W+A'" Dmx="193~200" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="201~208" Colour="255,255,255" />
      <Function ID="27" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="209~216" Colour="255,255,255" />
      <Function ID="28" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="217~224" Colour="255,255,255" />
      <Function ID="29" Name="R+B+W+A" Display="'R+B+W+A'" Dmx="225~232" Colour="255,255,255" />
      <Function ID="30" Name="G+B+W+A" Display="'G+B+W+A'" Dmx="233~240" Colour="255,255,255" />
      <Function ID="31" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKQTX651" DiamondRef="" WysiwygRef="" />
    <Physical>

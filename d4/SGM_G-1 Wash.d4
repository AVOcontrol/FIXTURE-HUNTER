<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="G-1 Wash" ShortName="G-1 Wash" Company="SGM">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="02-02-16" Author="Nic Morris" Comment="Created" />
  <History Date="14-04-17" Author="Nic Morris" Comment="Created from SGM G-1 Beam" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c9f9f8f6-4ef3-4c9f-a5e4-151fe3eb185f" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~10" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="18~88" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="129~178" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="89~108" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="109~128" Intensity="0~0" />
      <Function ID="7" Name="Rnd Ltning" Display="'Rnd Ltning %.f%%',0~100" Dmx="198~179" Intensity="0~0" />
      <Function ID="8" Name="Rnd Double" Display="'Rnd Double %.f%%',0~100" Dmx="208~199" Intensity="0~0" />
      <Function ID="9" Name="Rnd Triple" Display="'Rnd Triple %.f%%',0~100" Dmx="218~209" Intensity="0~0" />
      <Function ID="10" Name="White Noise" Display="'White Noise %.f%%',0~100" Dmx="228~219" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="5~9" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="10~14" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="15~19" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="20~24" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="25~29" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="30~34" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="35~39" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="40~44" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="45~49" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="50~54" />
      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="55~59" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="60~64" />
      <Function ID="14" Name="Colour 13" Display="'Colour 13'" Dmx="65~69" />
      <Function ID="15" Name="Colour 14" Display="'Colour 14'" Dmx="70~74" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="75~79" />
      <Function ID="17" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="80~84" />
      <Function ID="18" Name="Random" Display="'Random'" Dmx="85~89" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Spin" ID="2,3,4" If="'Pan_Mode'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="65535~32768" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32767~32767" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32766~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan_Mode" Name="Pan Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="540 deg" Display="'540 deg'" Dmx="0~0" Update="Pan" />
      <Function ID="2" Name="360 deg" Display="'360 deg'" Dmx="8~15" Update="Pan" />
      <Function ID="3" Name="360 shortest" Display="'360 shortest'" Dmx="16~23" Update="Pan" />
      <Function ID="4" Name="Spin" Display="'Spin'" Dmx="24~31" Update="Pan" />
      <Function ID="5" Name="360 deg North Cal" Display="'360 deg North Cal'" Dmx="32~39" Update="Pan" />
      <Function ID="6" Name="Store Pos 1" Display="'Store Pos 1'" Dmx="144~151" Update="Pan" />
      <Function ID="7" Name="Store Pos 2" Display="'Store Pos 2'" Dmx="152~159" Update="Pan" />
      <Function ID="8" Name="Store Pos 3" Display="'Store Pos 3'" Dmx="160~167" Update="Pan" />
      <Function ID="9" Name="Store Pos 4" Display="'Store Pos 4'" Dmx="168~175" Update="Pan" />
      <Function ID="10" Name="Store Pos 5" Display="'Store Pos 5'" Dmx="176~183" Update="Pan" />
      <Function ID="11" Name="Store Pos 6" Display="'Store Pos 6'" Dmx="184~191" Update="Pan" />
      <Function ID="12" Name="Store Pos 7" Display="'Store Pos 7'" Dmx="192~199" Update="Pan" />
      <Function ID="13" Name="Store Pos 8" Display="'Store Pos 8'" Dmx="200~207" Update="Pan" />
      <Function ID="14" Name="Store Pos 9" Display="'Store Pos 9'" Dmx="208~215" Update="Pan" />
      <Function ID="15" Name="Seq Fade" Display="'Seq Fade %.f%%',0~100" Dmx="216~223" Update="Pan" />
      <Function ID="16" Name="Seq Snap" Display="'Seq Snap %.f%%',0~100" Dmx="224~231" Update="Pan" />
      <Function ID="17" Name="Rnd Fade" Display="'Rnd Fade %.f%%',0~100" Dmx="232~239" Update="Pan" />
      <Function ID="18" Name="Rnd Snap" Display="'Rnd Snap %.f%%',0~100" Dmx="240~247" Update="Pan" />
      <Function ID="19" Name="540 Deg" Display="'540 Deg'" Dmx="248~255" Update="Pan" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Col Mode CTC" Display="'Col Mode CTC'" Dmx="0~0" Update="CTO" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="5~9" Update="CTO" />
      <Function ID="3" Name="Reset Pan" Display="'Reset Pan'" Dmx="10~14" Update="CTO" />
      <Function ID="4" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="15~19" Update="CTO" />
      <Function ID="5" Name="Reset Head" Display="'Reset Head'" Dmx="20~24" Update="CTO" />
      <Function ID="6" Name="Col Mode RAW" Display="'Col Mode RAW'" Dmx="25~29" Update="CTO" />
      <Function ID="7" Name="Col Mode Cal" Display="'Col Mode Cal'" Dmx="30~34" Update="CTO" />
      <Function ID="8" Name="Display ON" Display="'Display ON'" Dmx="35~39" Update="CTO" />
      <Function ID="9" Name="Display OFF" Display="'Display OFF'" Dmx="40~44" Update="CTO" />
      <Function ID="10" Name="Power OFF" Display="'Power OFF'" Dmx="45~49" Update="CTO" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="3:7664" PowerOn="3:7664" />
      <Condition Name="Raw" ID="4" If="'Control'==6||'Control'==7" />
      <Else ID="1,2,3" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No CTC (RAW)" Display="'No CTC (RAW)'" Dmx="1~4" Colour="255,255,255" />
      <Function ID="3" Name="CTC" Display="'%.fK',2000~10000" Dmx="5~255" Colour="255,255,255" />
      <Function ID="4" Name="No W-&gt;Max" Display="'No W-&gt;Max %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SM_G-1WS" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="240" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0c4e2324-0315-4333-bfdb-f0ded934d5d3" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Macro" ChannelOffset="3" Wheel="22" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="7" Wheel="7" />
      <Attribute ID="Pan" ChannelOffset="8,9" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="10,11" Wheel="3" />
      <Attribute ID="Pan_Mode" ChannelOffset="12" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Pan">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Tilt">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Head">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display ON">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display OFF">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Power OFF">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
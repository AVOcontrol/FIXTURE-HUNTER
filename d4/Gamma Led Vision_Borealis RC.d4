    </Attribute>
    <Attribute ID="Effect1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Dimmer Sync" Display="'Dimmer Sync'" Dmx="10~12" />

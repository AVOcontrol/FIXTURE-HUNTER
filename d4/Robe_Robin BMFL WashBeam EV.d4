  <History Date="02-07-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-04-16" Author="Nic Morris" Comment="Renamed control function and associated macro from 'silent' to 'quiet' in response to manufacturer request." Version="2" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="3" />
  <History Date="20-07-16" Author="Nic Morris" Comment="Created from Robe Robin BMFL WashBeam" Version="4" />
  <History Date="28-07-16" Author="Nic Morris" Comment="Changed Gobo1Rot to 8bit in Mode 2 in response to manufacturer request." Version="5" />
  <History Date="08-11-16" Author="Nic Morris" Comment="Added Home Pos control functions and macros in response to manufacturer request." Version="6" />
  <History Date="12-08-17" Author="Nic Morris" Comment="Added LightMaster (LM)/ RoboSpot (RS) control functions and macros in reponse to manufacturer request." Version="7" />
  <History Date="01-09-17" Author="Nic Morris" Comment="Minor revision to LM/RS control function and macro names." Version="8" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed all colour index ranges to full field." Version="9" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Added gobo swatches.  Added channel counts to mode names.  Inverted zoom." Version="10" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Changed blade controls to single variable functions for compatibility.  Standardised across range." Version="11" />
  <History Date="14-01-18" Author="Nic Morris" Comment="Added gobo and iris palettes." Version="12" />
  <History Date="27-06-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="14" />

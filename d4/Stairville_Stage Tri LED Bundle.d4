  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>f5baeeb8-f5fe-49ce-8ac3-310643b07c1a</Thumbnail>
  <History Date="26-09-12" Author="Peter Budd" Comment="Created" />
  <History Date="08-11-12" Author="Peter Budd" Comment="Created from the Showtec LED Light Bar RGB V3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-07-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added virtual dimmer to cells." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4112d5a2-67f4-4bdd-ac0c-ac4098006905" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Col_Mac_Spd" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Update="Col_Mac_Spd" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Update="Col_Mac_Spd" Colour="0,255,0" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="40~49" Update="Col_Mac_Spd" Colour="0,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Update="Col_Mac_Spd" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Update="Col_Mac_Spd" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Update="Col_Mac_Spd" Colour="255,255,255" />
      <Function ID="9" Name="Auto 1" Display="'Auto 1'" Dmx="80~89" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="10" Name="Auto 2" Display="'Auto 2'" Dmx="90~99" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="11" Name="Auto 3" Display="'Auto 3'" Dmx="100~109" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="12" Name="Auto 4" Display="'Auto 4'" Dmx="110~119" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="13" Name="Auto 5" Display="'Auto 5'" Dmx="120~129" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="14" Name="Auto 6" Display="'Auto 6'" Dmx="130~139" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="15" Name="Auto 7" Display="'Auto 7'" Dmx="140~149" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="16" Name="Auto 8" Display="'Auto 8'" Dmx="150~159" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="17" Name="Auto 9" Display="'Auto 9'" Dmx="160~169" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="18" Name="Auto 10" Display="'Auto 10'" Dmx="170~179" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="19" Name="Auto 11" Display="'Auto 11'" Dmx="180~189" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="20" Name="LEDs off" Display="'LEDs off'" Dmx="190~199" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="21" Name="Red" Display="'Red'" Dmx="200~209" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="22" Name="Auto 12" Display="'Auto 12'" Dmx="210~219" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="23" Name="Auto 13" Display="'Auto 13'" Dmx="220~229" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="24" Name="Auto 14" Display="'Auto 14'" Dmx="230~239" Update="Col_Mac_Spd" Colour="0,0,0" />
      <Function ID="25" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Col_Mac_Spd" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==25" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="10~249" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

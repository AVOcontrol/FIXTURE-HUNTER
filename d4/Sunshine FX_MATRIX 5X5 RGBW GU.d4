  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="20-01-18" Author="Nic Morris" Comment="Created (poor documentation.  very limited information)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="14~21" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="22~29" />
      <Function ID="4" Name="Change" Display="'Change'" Dmx="30~37" />
      <Function ID="5" Name="Auto 1" Display="'Auto 1'" Dmx="38~45" />
      <Function ID="6" Name="Auto 2" Display="'Auto 2'" Dmx="46~53" />
      <Function ID="7" Name="Auto 3" Display="'Auto 3'" Dmx="54~61" />
      <Function ID="8" Name="Auto 4" Display="'Auto 4'" Dmx="62~69" />
      <Function ID="9" Name="Auto 5" Display="'Auto 5'" Dmx="70~77" />
      <Function ID="10" Name="Auto 6" Display="'Auto 6'" Dmx="78~85" />
      <Function ID="11" Name="Auto 7" Display="'Auto 7'" Dmx="86~93" />
      <Function ID="12" Name="Auto 8" Display="'Auto 8'" Dmx="94~101" />
      <Function ID="13" Name="Auto 9" Display="'Auto 9'" Dmx="102~109" />
      <Function ID="14" Name="Auto 10" Display="'Auto 10'" Dmx="110~117" />
      <Function ID="15" Name="Auto 11" Display="'Auto 11'" Dmx="118~125" />
      <Function ID="16" Name="Auto 12" Display="'Auto 12'" Dmx="126~133" />
      <Function ID="17" Name="Auto 13" Display="'Auto 13'" Dmx="134~141" />
      <Function ID="18" Name="Auto 14" Display="'Auto 14'" Dmx="142~149" />
      <Function ID="19" Name="Auto 15" Display="'Auto 15'" Dmx="150~157" />
      <Function ID="20" Name="Auto 16" Display="'Auto 16'" Dmx="158~165" />
      <Function ID="21" Name="Auto 17" Display="'Auto 17'" Dmx="166~173" />
      <Function ID="22" Name="Auto 18" Display="'Auto 18'" Dmx="174~181" />
      <Function ID="23" Name="Auto 19" Display="'Auto 19'" Dmx="182~189" />
      <Function ID="24" Name="Auto 20" Display="'Auto 20'" Dmx="190~197" />
      <Function ID="25" Name="Auto 21" Display="'Auto 21'" Dmx="198~205" />
      <Function ID="26" Name="Auto 22" Display="'Auto 22'" Dmx="206~213" />
      <Function ID="27" Name="Auto 23" Display="'Auto 23'" Dmx="214~221" />
      <Function ID="28" Name="Auto 24" Display="'Auto 24'" Dmx="222~229" />
      <Function ID="29" Name="Sound" Display="'Sound'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

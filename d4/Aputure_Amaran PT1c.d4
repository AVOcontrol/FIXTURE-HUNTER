      <Function ID="7" Name="CCT Range: Warmer" Display="'CCT Range: Warmer'" Dmx="0~0" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="8" Name="CCT Range: Natural" Display="'CCT Range: Natural'" Dmx="10~19" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="9" Name="CCT Range: Cooler" Display="'CCT Range: Cooler'" Dmx="20~29" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="10" Name="Mode: CCT" Display="'Mode: CCT'" Dmx="0~0" Update="FX_Param_3, FX_Param_4, FX_Param_5" />
      <Function ID="11" Name="Mode: HSI" Display="'Mode: HSI'" Dmx="10~19" Update="FX_Param_3, FX_Param_4, FX_Param_5" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Phoenix" ShortName="SA Phoenix" Company="Stage Ape">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="01-05-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18,22" If="'Gobo1Func'==3" />
      <Condition Name="Control" ID="19,20" If="'Gobo1Func'==4" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="252~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="12~17" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="18~23" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="24~29" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="30~35" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="36~41" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="42~47" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="48~53" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="54~59" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="60~65" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="66~71" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="72~77" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="78~83" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="84~89" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="90~95" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="96~101" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="252~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="102~171" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Lamp On" Display="'Lamp On'" Dmx="6~11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="172~251" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Control" Display="'Control'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~7" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="8~247" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="UK_STAPEPHN" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Gobo1" ChannelOffset="1" Wheel="14" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="10" Name="Pink" Display="'Pink'" Dmx="77~81" WheelPosition="9" Colour="255,150,150" />
      <Function ID="11" Name="Warming 1" Display="'Warming 1'" Dmx="86~89" WheelPosition="10" Colour="255,240,200" />
      <Function ID="12" Name="Fluorescence" Display="'Fluorescence'" Dmx="94~98" WheelPosition="11" Colour="255,255,255" />
      <Function ID="13" Name="Cooling 1" Display="'Cooling 1'" Dmx="103~106" WheelPosition="12" Colour="230,230,255" />
      <Function ID="14" Name="Cooling 2" Display="'Cooling 2'" Dmx="111~115" WheelPosition="13" Colour="230,230,255" />

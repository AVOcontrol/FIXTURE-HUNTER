      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="52~55" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Light Blue" Display="'Light Blue'" Dmx="60~63" WheelPosition="7" Colour="0,128,255" />

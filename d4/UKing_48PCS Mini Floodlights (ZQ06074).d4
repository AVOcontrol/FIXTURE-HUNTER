      <Function ID="18" Name="Red Gradient" Display="'Red Gradient'" Dmx="182~192" />
      <Function ID="19" Name="Green Gradient" Display="'Green Gradient'" Dmx="193~203" />
      <Function ID="20" Name="Blue Gradient" Display="'Blue Gradient'" Dmx="204~214" />

      <Attribute ID="Control" ChannelOffset="5" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True" Id="b990ec31-23c5-45d4-9b19-acd99924378d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="WX2512" ShortName="WX2512" Company="Xine Robotics" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="16-12-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Winch" Description="" Group="P" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Motor_Control" Name="Motor Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable" Display="'Disable'" Dmx="0~0" />
      <Function ID="2" Name="Enable" Display="'Enable'" Dmx="121~140" />
      <Function ID="3" Name="Disable" Display="'Disable'" Dmx="141~255" />
    </Attribute>
    <Attribute ID="Motion_Speed" Name="Motion Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="246~250" />
    </Attribute>
  </Control>
  <Mode Name="KLSTR Dual Winch, 7 DMX" Channels="7" Id="8cf890af-a497-4962-9a4f-ebbf1384d523">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Motor_Control" ChannelOffset="5" Wheel="28" />
        <Attribute ID="Motion_Speed" ChannelOffset="6" Wheel="25" />
        <Attribute ID="Control" ChannelOffset="7" Wheel="29" />
      </Master>
      <Cell ID="Cell1" Name="Winch A" ChannelOffset="1" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Winch B" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="16Bit, 5 DMX" Channels="5" Id="dabb64a1-beb2-4ae1-8c6f-7ed059d92eb5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Motor_Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Tilt" ChannelOffset="2,3" Wheel="3" />

      <Function ID="10" Name="Horse Racing 2" Display="'Horse Racing 2'" Dmx="64~95" />
      <Function ID="11" Name="Background" Display="'Background'" Dmx="96~127" />
      <Function ID="12" Name="Warm" Display="'Warm'" Dmx="128~149" />
      <Function ID="13" Name="Gradual" Display="'Gradual %.f%%',0~100" Dmx="150~199" />
      <Function ID="14" Name="Change" Display="'Change %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset P/T" Display="'Reset P/T'" Dmx="26~76" />
      <Function ID="3" Name="Reset Effect" Display="'Reset Effect'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>

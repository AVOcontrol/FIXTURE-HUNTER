      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="128~142" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="143~157" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="158~172" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />

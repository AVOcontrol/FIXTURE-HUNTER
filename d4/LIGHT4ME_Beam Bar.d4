    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="16~35" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="36~56" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="57~76" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="78~97" />

      <Function ID="2" Name="8000K" Display="'8000K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="6600K" Display="'6600K'" Dmx="65~65" Colour="255,255,255" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="110~110" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="180~180" Colour="255,255,255" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="230~230" Colour="255,255,255" />
      <Function ID="7" Name="2700K" Display="'2700K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Shift" Display="'No Shift'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Green" Display="'- Green %.1f%%',100.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="No Shift" Display="'No Shift'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mix_Func" Name="Col Mix Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Virtual" Display="'Virtual'" Dmx="0~0" />
      <Function ID="2" Name="HTP" Display="'HTP'" Dmx="10~19" />
      <Function ID="3" Name="LTP" Display="'LTP'" Dmx="20~29" />
      <Function ID="4" Name="MIX" Display="'MIX'" Dmx="30~39" />
      <Function ID="5" Name="ADD" Display="'ADD'" Dmx="45~45" />
      <Function ID="6" Name="SUB" Display="'SUB'" Dmx="50~59" />
      <Function ID="7" Name="INV SUB" Display="'INV SUB'" Dmx="60~69" />
      <Function ID="8" Name="White Point Off" Display="'White Point Off'" Dmx="70~79" />
      <Function ID="9" Name="Virtual" Display="'Virtual'" Dmx="129~129" />
      <Function ID="10" Name="Xfade" Display="'Xfade %.1f%%',0.0~100.0" Dmx="130~254" />
      <Function ID="11" Name="Colour Mix" Display="'Colour Mix'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="5~9" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="10~14" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="15~19" WheelPosition="3" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2,Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2,Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2,Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed Index" ID="1,2,3" If="'Gobo2Func'==1" />
      <Condition Name="Fixed Spin" ID="4,5,6" If="'Gobo2Func'==2" />
      <Else ID="7" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="5~9" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="10~14" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 1" Display="'Gobo 1'" Dmx="15~19" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~24" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="257~32639" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32896~32896" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="33153~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.2f%%',0.00~100.00" Dmx="49087~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.2f%%',0.00~100.00" Dmx="49344~56283" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse   %.2f%%',100.00~0.00" Dmx="56540~63479" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Rnd Op Pls Slow" Display="'Rnd Op Pls Slow'" Dmx="64250~64507" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Rnd Op Pls Fast" Display="'Rnd Op Pls Fast'" Dmx="63736~63993" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Rnd Cl Pls Slow" Display="'Rnd Cl Pls Slow'" Dmx="65278~65535" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Rnd Cl Pls Fast" Display="'Rnd Cl Pls Fast'" Dmx="64764~65021" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
  </Control>

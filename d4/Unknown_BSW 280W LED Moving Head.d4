      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="12~17" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="24~29" WheelPosition="2" Colour="0,0,0" />

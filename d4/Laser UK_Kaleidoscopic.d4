<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kaleidoscopic" ShortName="Kaldoscpic" Company="Laser UK">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="23-05-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~69" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="70~139" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="140~209" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CW" Display="'CW %.f%%',0~100" Dmx="0~84" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="CCW" Display="'CCW %.f%%',0~100" Dmx="85~169" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="170~251" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="252~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~16" Colour="0,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="17~33" Colour="0,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="34~50" Colour="0,0,0" />
      <Function ID="4" Name="R+G" Display="'R+G'" Dmx="51~67" Colour="0,0,0" />
      <Function ID="5" Name="R+B" Display="'R+B'" Dmx="68~84" Colour="0,0,0" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="85~101" Colour="0,0,0" />
      <Function ID="7" Name="R+G+B" Display="'R+G+B'" Dmx="102~118" Colour="0,0,0" />
      <Function ID="8" Name="R+G+B Auto" Display="'R+G+B Auto'" Dmx="119~240" Colour="0,0,0" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="241~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Twinkle" Name="Twinkle" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Twinkle" Display="'No Twinkle'" Dmx="0~20" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="21~240" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Oscillate" Name="Oscillate" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="UKLUKKSC" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Direction" ChannelOffset="2" Wheel="15" />
      <Attribute ID="Twinkle" ChannelOffset="4" Wheel="23" />
      <Attribute ID="Oscillate" ChannelOffset="5" Wheel="24" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
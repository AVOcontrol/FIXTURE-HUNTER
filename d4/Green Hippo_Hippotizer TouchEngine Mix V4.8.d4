<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Hippotizer TouchEngine Mix V4.8" ShortName="Hp TE Mix" Company="Green Hippo" Version="53">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="08-02-07" Author="D.Milligan" Comment="Created" Version="1" />
  <History Date="31-01-08" Author="Ion Balan" Comment="Updated to V 3.0.11" Version="2" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" Version="3" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" Version="4" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" Version="5" />
  <History Date="05-03-09" Author="Jonathan Moreton" Comment="Changed Raw Dmx to individual functions 0-255  Changed generator attributes to percentage" Version="6" />
  <History Date="27-07-09" Author="David Hunt" Comment="Upgraded to V3.0.13" Version="7" />
  <History Date="27-07-09" Author="Jonathan Moreton" Comment="Re ordered wheel mapping for effects" Version="8" />
  <History Date="22-10-09" Author="Gregory Haynes" Comment="Changed parameters to Raw DMX, fixed Aspect Ratio channel, moved some wheels to reduce the number of pages and some other minor fixes." Version="9" />
  <History Date="02-03-10" Author="John Rogers" Comment="Edited Zoom and Speed percentage ranges." Version="10" />
  <History Date="14-07-10" Author="John Rogers" Comment="Effect 1 and 2 Parameters updated, Generator channels updated." Version="11" />
  <History Date="18-10-10" Author="John Rogers" Comment="Removed Clear values from Bank and Clip channels." Version="12" />
  <History Date="03-04-12" Author="Peter Budd" Comment="Created from V3" Version="13" />
  <History Date="05-04-12" Author="Peter Budd" Comment="Edited updated locate values." Version="14" />
  <History Date="05-04-12" Author="Peter Budd" Comment="Edited edited rotate locate values." Version="15" />
  <History Date="27-04-12" Author="Peter Budd" Comment="Edited swapped speed and relay select." Version="16" />
  <History Date="10-05-12" Author="Peter Budd" Comment="Edited changed live mask to values" Version="17" />
  <History Date="26-09-12" Author="Peter Budd" Comment="Edited re-arranged wheel assignment." Version="18" />
  <History Date="22-05-13" Author="Peter Budd" Comment="Updated to deal with V6 locate and raw DMX issues." Version="19" />
  <History Date="05-01-14" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Media Layer V3.2" Version="20" />
  <History Date="20-01-14" Author="Nic Morris" Comment="Updated generator" Version="21" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="22" />
  <History Date="18-11-16" Author="Nic Morris" Comment="Fixed channel mapping error" Version="23" />
  <History Date="18-11-16" Author="Nic Morris" Comment="Revised FX parameter and Text Eng Show locate." Version="24" />
  <History Date="18-11-16" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Media Layer V3.2.1 (partial - charts are missing some channels)" Version="25" />
  <History Date="20-11-16" Author="Nic Morris" Comment="Updated Effects and parameters in line with v4.0.2 charts" Version="26" />
  <History Date="21-11-16" Author="Nic Morris" Comment="Added missing channels as reserved in response to manufacturer information." Version="27" />
  <History Date="22-11-16" Author="Nic Morris" Comment="Adjusted wheel slots.  Changed RGB attribute ID's to non-reserved to prevent colour picker as they are not standard RGB channels." Version="28" />
  <History Date="22-11-16" Author="Nic Morris" Comment="Tidied function names.  Fixed Gen Param 9 locate.  Added missing Tyear to Generator Countdown param 6." Version="29" />
  <History Date="06-11-17" Author="Nic Morris" Comment="Revised hue and saturation ID's for compatibility." Version="30" />
  <History Date="23-05-18" Author="Nic Morris" Comment="Fixed rotation, x-pos, y-pos and zoom 16bit values in response to customer bug report (bug where builder rounds if opened in 8bit mode)" Version="31" />
  <History Date="14-09-18" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Layer V4.2 (note 24bit controls are not currently supported)" Version="32" />
  <History Date="02-05-19" Author="Nic Morris" Comment="Changed Bank and Clip attribute IDs to Folder and File respectively for compatibility." Version="33" />
  <History Date="03-05-21" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Layer V4.4 (note channel 71 missing.  assumed is NDI Refresh.  Zoom XY Enable missing 129-255 - assumed is enable)" Version="34" />
  <History Date="20-08-23" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Layer V4.6" Version="41" />
  <History Date="21-08-23" Author="Nic Morris" Comment="Created from Green Hippo Hippotizer Layer V4.7" Version="52" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="TE_File" Name="TE File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="File" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="TE_Framerate" Name="TE Framerate" Description="" Group="S">
      <Locate Locate="12" PowerOn="12" />

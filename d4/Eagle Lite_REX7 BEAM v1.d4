      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="64~67" WheelPosition="16" />
      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="68~71" WheelPosition="17" />
      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="20" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="160~166" WheelPosition="2" />
      <Function ID="21" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="167~172" WheelPosition="3" />

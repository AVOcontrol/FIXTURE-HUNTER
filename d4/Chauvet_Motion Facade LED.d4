      <Function ID="6" Name="Stack" Display="'Stack'" Dmx="80~95" Colour="0,0,0" />
      <Function ID="7" Name="Freeway" Display="'Freeway'" Dmx="96~111" Colour="0,0,0" />
      <Function ID="8" Name="Wave L-R" Display="'Wave L-R'" Dmx="112~127" Colour="0,0,0" />
      <Function ID="9" Name="Wave R-L" Display="'Wave R-L'" Dmx="128~143" Colour="0,0,0" />
      <Function ID="10" Name="Chase L-R" Display="'Chase L-R'" Dmx="144~159" Colour="0,0,0" />
      <Function ID="11" Name="Chase R-L" Display="'Chase R-L'" Dmx="160~175" Colour="0,0,0" />
      <Function ID="12" Name="Windmill" Display="'Windmill'" Dmx="176~191" Colour="0,0,0" />
      <Function ID="13" Name="Fan" Display="'Fan'" Dmx="192~207" Colour="0,0,0" />
      <Function ID="14" Name="Whirlpool" Display="'Whirlpool'" Dmx="208~223" Colour="0,0,0" />
      <Function ID="15" Name="Falling Snow" Display="'Falling Snow'" Dmx="224~239" Colour="0,0,0" />

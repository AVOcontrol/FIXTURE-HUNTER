      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~15" Colour="0,0,0" />
      <Function ID="2" Name="Falling Star" Display="'Falling Star'" Dmx="16~31" Colour="0,0,0" />
      <Function ID="3" Name="Diagonal Color" Display="'Diagonal Color'" Dmx="32~47" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Followspot LED 75" ShortName="FollowSp75" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="11-01-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="32~63" Colour="0,0,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="96~127" Colour="255,150,150" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="128~159" Colour="128,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="160~191" Colour="255,0,0" />
      <Function ID="7" Name="Aqua" Display="'Aqua'" Dmx="192~223" Colour="0,255,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="224~255" Colour="255,128,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~215" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SHFSLD75" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:6" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:8" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="6" Name="Lime" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="8" Name="Aqua" Number="6" Page="1" SetControl="Colour1:7" />
      <Palette ID="9" Name="Aqua" Number="0" Page="1" SetControl="Colour1:7" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:2" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:2" />
      <Palette ID="12" Name="Pink" Number="10" Page="1" SetControl="Colour1:4" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:4" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:2" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
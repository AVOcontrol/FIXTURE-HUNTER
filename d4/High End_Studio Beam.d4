  <History Date="04-09-01" Author="Edward" Comment="Created" />
  <History Date="28-11-02" Author="D.Shelton" Comment="Updated to work with current software version" />
  <History Date="16-12-02" Author="D.Shelton" Comment="Updated referencing of 16-bit channels" />
  <History Date="27-05-03" Author="D.Shelton" Comment="Added If Statemenets and cleaned up table information" />
  <History Date="12-06-03" Author="D.Shelton" Comment="Altered Pan/Tilt to 2dp" />
  <History Date="15-07-03" Author="D.Shelton" Comment="Added head type" />
  <History Date="29-03-04" Author="Greg Brown" Comment="Above Errors Corrected" />
  <History Date="07-04-04" Author="Greg Brown" Comment="Macros changed so shutter gets set before Control" />
  <History Date="24-01-05" Author="Phil" Comment="Added &quot;PC&quot; to fixture name." />
  <History Date="25-01-05" Author="Phil Rogers" Comment="Modified to include both control channels on same wheel. Probably Need to function wheelise it." />
  <History Date="08-02-05" Author="Phil" Comment="Adjusted wheel allocations, and changed display ranges for frost." />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 1: Colour Func wheel needs legends revising" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 2: MSpeed doesn't allow ranges" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 3: Control only reaches 172" />
  <History Date="09-03-05" Author="Phil Rogers" Comment="Fixed all above problems." />
  <History Date="04-08-05" Author="Ed" Comment="Fixed beam shaping values" />
  <History Date="04-08-05" Author="Ed" Comment="Fixed some macro values to be ranges" />
  <History Date="05-08-05" Author="Ed" Comment="Inserted missing function into control channel" />
  <History Date="07-07-06" Author="Ed" Comment="Fixed All colour mix attributes to be Cmixes" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="11-06-10" Author="Gregory Haynes" Comment="Fixed Else conditions" />
  <History Date="08-07-11" Author="John Rogers" Comment="Removed rogue Higlight/Lowlight values. Added palettes." />
  <History Date="12-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="19-04-15" Author="Nic Morris" Comment="Inverted zoom mapping in response to customer bug report." />
  <History Date="29-05-15" Author="Nic Morris" Comment="Fixed hilight/lolight in response to customer bug report" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-06-18" Author="Nic Morris" Comment="Moved main CMY functions to first function for compatibility in response to bug report." />
  <History Date="06-06-18" Author="Nic Morris" Comment="Attempt at tidying up CMY conditions (previously some of the logic conflicted)" />
  <History Date="06-06-18" Author="Nic Morris" Comment="Added product thumbnail.  Tidied up some more of this mess.  Added channel counts to mode names." />
  <History Date="10-10-19" Author="Nic Morris" Comment="Fixed colour palettes." />
  <History Date="05-12-19" Author="Nic Morris" Comment="Fixed flat mode attribute names." />
  <History Date="06-12-19" Author="Nic Morris" Comment="Added Atlabase ID to Flat mode." />
  <History Date="07-12-19" Author="Nic Morris" Comment="Simplified and changed flat mode CMY controls to variable.  Merged into main CMY controls for compatibility." />
  <History Date="07-12-19" Author="Nic Morris" Comment="Revised control function names.  Fixed flat mode channel assignments." />
  <Manual Filename="/manual/High-End_Studio Beam.pdf" Summary="Created:Susan Gilg, 05/10/2001" />

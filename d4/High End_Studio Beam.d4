  <AtlaBase TypeID="50ced9c1-32cd-4983-a926-708080b6a949" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="ColMode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Pure Mix" Display="'Pure Mix'" Dmx="32~47" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="3" Name="Fixed" Display="'Fixed'" Dmx="16~31" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="48~63" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="5" Name="Cycle" Display="'Cycle'" Dmx="64~79" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="6" Name="Scan" Display="'Scan'" Dmx="80~95" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="96~111" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="8" Name="Blink Indexed" Display="'Blink Indexed'" Dmx="112~127" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="9" Name="MSpd: Pure Mix" Display="'MSpd: Pure Mix'" Dmx="160~175" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="10" Name="MSpd: Index" Display="'MSpd: Index'" Dmx="128~143" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="11" Name="MSpd: Fixed" Display="'MSpd: Fixed'" Dmx="144~159" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="12" Name="MSpd: Scroll" Display="'MSpd: Scroll'" Dmx="176~191" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="13" Name="MSpd: Cycle" Display="'MSpd: Cycle'" Dmx="192~207" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="14" Name="MSpd: Scan" Display="'MSpd: Scan'" Dmx="208~223" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="15" Name="MSpd: Random" Display="'MSpd: Random'" Dmx="224~239" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="16" Name="MSpd: Blink Idx" Display="'MSpd: Blink Idx'" Dmx="240~255" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Pure Mix" ID="1" If="'ColMode'==1||'ColMode'==9" />
      <Condition Name="Index" ID="2,3,4" If="'ColMode'==2||'ColMode'==8||'ColMode'==10" />

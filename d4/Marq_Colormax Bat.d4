<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Colormax Bat" ShortName="ColMax Bat" Company="Marq">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-10-17" Author="Nic Morris" Comment="Created" />
  <History Date="25-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="97201c3e-60b4-4f2f-b298-6fece8ddfed2" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~35" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="36~55" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="56~75" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="76~95" Colour="0,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="96~115" Colour="255,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="116~135" Colour="255,128,0" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="136~155" Colour="255,150,150" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="156~175" Colour="128,0,255" />
      <Function ID="10" Name="Dark Blue" Display="'Dark Blue'" Dmx="176~195" Colour="0,0,180" />
      <Function ID="11" Name="Light Cyan" Display="'Light Cyan'" Dmx="196~215" Colour="128,255,255" />
      <Function ID="12" Name="White" Display="'White'" Dmx="216~235" Colour="255,255,255" />
      <Function ID="13" Name="Warm White" Display="'Warm White'" Dmx="236~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="3 Col Snap" Display="'3 Col Snap'" Dmx="16~35" Update="Auto_Spd" />
      <Function ID="3" Name="7 Col Snap" Display="'7 Col Snap'" Dmx="36~55" Update="Auto_Spd" />
      <Function ID="4" Name="3 Col Fade" Display="'3 Col Fade'" Dmx="56~75" Update="Auto_Spd" />
      <Function ID="5" Name="7 Col Fade" Display="'7 Col Fade'" Dmx="76~95" Update="Auto_Spd" />
      <Function ID="6" Name="3 Col xfade" Display="'3 Col xfade'" Dmx="96~115" Update="Auto_Spd" />
      <Function ID="7" Name="7 Col xfade" Display="'7 Col xfade'" Dmx="116~135" Update="Auto_Spd" />
      <Function ID="8" Name="Red Pulse" Display="'Red Pulse'" Dmx="136~155" Update="Auto_Spd" />
      <Function ID="9" Name="Green Pulse" Display="'Green Pulse'" Dmx="156~175" Update="Auto_Spd" />
      <Function ID="10" Name="Blue Pulse" Display="'Blue Pulse'" Dmx="176~195" Update="Auto_Spd" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="196~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="16~25" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="26~35" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="36~45" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="46~55" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="56~65" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="66~75" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="76~85" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="86~95" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="96~105" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="106~115" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="116~125" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="126~135" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="136~145" />
      <Function ID="15" Name="Chase 14" Display="'Chase 14'" Dmx="146~155" />
      <Function ID="16" Name="Chase 15" Display="'Chase 15'" Dmx="156~165" />
      <Function ID="17" Name="Chase 16" Display="'Chase 16'" Dmx="166~175" />
      <Function ID="18" Name="Chase 17" Display="'Chase 17'" Dmx="176~185" />
      <Function ID="19" Name="Chase 18" Display="'Chase 18'" Dmx="186~195" />
      <Function ID="20" Name="Chase 19" Display="'Chase 19'" Dmx="196~205" />
      <Function ID="21" Name="Chase 20" Display="'Chase 20'" Dmx="206~215" />
      <Function ID="22" Name="Chase 21" Display="'Chase 21'" Dmx="216~225" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="226~255" />
    </Attribute>
  </Control>

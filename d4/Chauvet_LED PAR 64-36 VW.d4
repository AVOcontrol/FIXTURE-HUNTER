<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED PAR 64-36 VW" ShortName="64-36 VW" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="28-02-11" Author="Nic Morris" Comment="Created" />
  <History Date="07-10-17" Author="Nic Morris" Comment="Changed name from LED PAR 64 VW to LED PAR 64-36 VW.  Added Atlabase ID's." />
  <History Date="07-10-17" Author="Nic Morris" Comment="Revised warm white and cool white attribute ID's for compatibility.  Revised power on and locate values." />
  <History Date="07-10-17" Author="Nic Morris" Comment="Revised shutter with open function." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1ddb39e5-a855-49dc-9f36-bbeb9975a5f7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Warm White" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Cool White" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CH_LP64VW4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f6c3b56e-3ccd-4f0b-9c48-42719d8c5287" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="CH_LP64VW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="482a5c7f-b4bc-44c9-8496-3f3e02e01d51" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
    </Include>
  </Mode>
</Fixture>
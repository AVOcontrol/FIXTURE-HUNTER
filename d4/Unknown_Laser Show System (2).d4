<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Laser Show System (2)" ShortName="LaserShow2" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="01-07-23" Author="Nic Morris" Comment="Created (poor documentation)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="40~79" Update="Auto_Spd" />
      <Function ID="3" Name="Auto 0" Display="'Auto 0'" Dmx="80~99" Update="Auto_Spd" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="100~119" Update="Auto_Spd" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="120~139" Update="Auto_Spd" />
      <Function ID="6" Name="Auto 3" Display="'Auto 3'" Dmx="140~159" Update="Auto_Spd" />
      <Function ID="7" Name="Sound 0" Display="'Sound 0'" Dmx="160~179" Update="Auto_Spd" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="180~199" Update="Auto_Spd" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="200~219" Update="Auto_Spd" />
      <Function ID="10" Name="Sound 3" Display="'Sound 3'" Dmx="220~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Sensitivity" ID="2" If="'Mode'&gt;6" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.f%%',0~100" Dmx="10~79" Colour="255,255,255" />
      <Function ID="3" Name="Change" Display="'Change'" Dmx="80~89" Colour="255,255,255" />
      <Function ID="4" Name="Rainbow" Display="'Rainbow'" Dmx="90~93" Colour="255,255,255" />
      <Function ID="5" Name="2 Segment Step" Display="'2 Segment Step'" Dmx="94~109" Colour="255,255,255" />
      <Function ID="6" Name="3 Segment Step" Display="'3 Segment Step'" Dmx="110~129" Colour="255,255,255" />
      <Function ID="7" Name="4 Segment Step" Display="'4 Segment Step'" Dmx="130~145" Colour="255,255,255" />
      <Function ID="8" Name="8 Segment Step" Display="'8 Segment Step'" Dmx="146~161" Colour="255,255,255" />
      <Function ID="9" Name="16 Segment Step" Display="'16 Segment Step'" Dmx="162~209" Colour="255,255,255" />
      <Function ID="10" Name="32 Segment Step" Display="'32 Segment Step'" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Scroll CW" Display="'Scroll CW %.1f%%',100.0~0.0" Dmx="127~10" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CCW" Display="'Scroll CCW %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Size" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~63" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="128~191" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Z_Rot" Name="Z Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X_Rot" Name="X Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Y_Rot" Name="Y Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Wave" Display="'Wave %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Gradient" Display="'No Gradient'" Dmx="0~0" />
      <Function ID="2" Name="Manual Gradient 1" Display="'Manual Gradient 1'" Dmx="2~63" />
      <Function ID="3" Name="Manual Gradient 2" Display="'Manual Gradient 2'" Dmx="64~127" />
      <Function ID="4" Name="Auto Gradient (Increment)" Display="'Auto Gradient (Increment)'" Dmx="128~153" />
      <Function ID="5" Name="Auto Gradient (Subtract)" Display="'Auto Gradient (Subtract)'" Dmx="154~179" />
      <Function ID="6" Name="Auto Gradient (Increase -&gt; Decrease Rev)" Display="'Auto Gradient (Increase -&gt; Decrease Rev)'" Dmx="180~205" />
      <Function ID="7" Name="Auto Gradient (Increase -&gt; Decrease)" Display="'Auto Gradient (Increase -&gt; Decrease)'" Dmx="206~255" />
    </Attribute>
    <Attribute ID="Scan_Spd" Name="Scan Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Highlight" Display="'Highlight'" Dmx="10~127" />
      <Function ID="3" Name="Point" Display="'Point'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16" Id="e10c5241-f6a9-4c1b-8ac4-d1b32eae4708">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="29" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="4" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Size" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Zoom" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Z_Rot" ChannelOffset="8" Wheel="49" />
      <Attribute ID="X_Rot" ChannelOffset="9" Wheel="50" />
      <Attribute ID="Y_Rot" ChannelOffset="10" Wheel="51" />
      <Attribute ID="Pan" ChannelOffset="11" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12" Wheel="3" />
      <Attribute ID="Wave" ChannelOffset="13" Wheel="22" />
      <Attribute ID="Drawing" ChannelOffset="14" Wheel="4" />
      <Attribute ID="Scan_Spd" ChannelOffset="15" Wheel="25" />
      <Attribute ID="Display_Mode" ChannelOffset="16" Wheel="26" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
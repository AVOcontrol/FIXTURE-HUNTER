      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Iris" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Reset" ChannelOffset="13" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="GN_OBY-5_M2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="Philips MSI-575" Lumens="" ColourTemp="6000k" />
      <Lens Name="" Degrees="" />
      <Weight Kg="26" />
      <Size Height="380" Width="540" Depth="400" />
      <Focus Type="Head" PanMax="570" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7c7cc966-2d2e-4c32-bc1b-cd705acc526b" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="11,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="12,14" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="4" Wheel="38" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Gobo1" ChannelOffset="5" Wheel="14" />
      <Attribute ID="Gobo2" ChannelOffset="6" Wheel="17" />
      <Attribute ID="Gobo2Rot" ChannelOffset="7" Wheel="18" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo2Func" Wheel="16" />
      <Attribute ID="Iris" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Focus" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="22" />
      <Attribute ID="Reset" ChannelOffset="15" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:2" Delay="0" />
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:3" Delay="0" />
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Reset:2" Delay="0" />
      <Set Channel="Reset:1" Delay="5000" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="4" Name="Gobo 3" Number="14" Page="1" SetControl="Gobo1:4,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="5" Name="Gobo 4" Number="15" Page="1" SetControl="Gobo1:5,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="6" Name="Gobo 5" Number="16" Page="1" SetControl="Gobo1:6,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="7" Name="Gobo 6" Number="17" Page="1" SetControl="Gobo1:7,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="8" Name="Gobo 7" Number="18" Page="1" SetControl="Gobo1:8,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="9" Name="Gobo 8" Number="19" Page="1" SetControl="Gobo1:9,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="10" Name="Gobo 9" Number="20" Page="1" SetControl="Gobo1:10,Gobo1Func:1,Gobo2:1,Gobo2Func:2" />
      <Palette ID="11" Name="Gobo 1" Number="0" Page="1" SetControl="Gobo2:2,Gobo2Func:2,Gobo1:1,Gobo1Func:1" />

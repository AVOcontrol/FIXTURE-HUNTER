<Fixture Name="STRIKE Array 1" ShortName="STRIKE Ar1" Company="Chauvet" Version="2">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <Thumbnail>e310e392-b5d1-42e3-bcc4-7ffae9a7bb3a</Thumbnail>
  <History Date="20-06-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="15-02-24" Author="Nic Morris" Comment="Updated in line with DMX Chart Rev 2 (adds 13 channel mode and revises 5 channel mode shutter functions)" Version="1" />
  <History Date="10-05-24" Author="Nic Morris" Comment="Created from Chauvet STRIKE Array 4 (Capture modes don't make much sense at the moment.  4P 23, 14 and 5 DMX are currently missing)" Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ad53b0ed-6fe0-43b4-8b00-6c774556ccac" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~132" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2 %.f%%',0~100" Dmx="41~80" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3 %.f%%',0~100" Dmx="81~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4 %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5 %.f%%',0~100" Dmx="161~200" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6 %.f%%',0~100" Dmx="201~240" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Dimmer" Display="'Reset Dimmer'" Dmx="8~15" />
      <Function ID="3" Name="Red Shift On" Display="'Red Shift On'" Dmx="16~23" />
      <Function ID="4" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="24~31" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="32~39" />
      <Function ID="6" Name="Dim Linear" Display="'Dim Linear'" Dmx="40~47" />
      <Function ID="7" Name="Dim Square" Display="'Dim Square'" Dmx="48~55" />
      <Function ID="8" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="56~63" />
      <Function ID="9" Name="Dim Mode Off" Display="'Dim Mode Off'" Dmx="64~71" />
      <Function ID="10" Name="Dim Mode 1 (Fast)" Display="'Dim Mode 1 (Fast)'" Dmx="72~79" />
      <Function ID="11" Name="Dim Mode 2" Display="'Dim Mode 2'" Dmx="80~87" />
      <Function ID="12" Name="Dim Mode 3 (Slow)" Display="'Dim Mode 3 (Slow)'" Dmx="88~95" />
      <Function ID="13" Name="Re-Address Pods" Display="'Re-Address Pods'" Dmx="96~103" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Master_Shutter" Name="Master Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~132" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="133~255" />
    </Attribute>
  </Control>

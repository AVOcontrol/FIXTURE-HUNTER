<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Mushroom" ShortName="Mushroom" Company="Ibiza Light">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-03-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Rotate_Func" Name="Rotate Func" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Rotate" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="16~255" Update="Rotate" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Spin" ID="2" If="'Rotate_Func'==2" />
      <Else ID="1" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~232" />
    </Attribute>
    <Attribute ID="Strobe_Space" Name="Strobe Space" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Space" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Red" Colour="0,0,0" />
      <Function ID="2" Name="R+G+B" Display="'R+G+B'" Dmx="18~34" Update="Red" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="35~51" Update="Red" Colour="0,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="52~68" Update="Red" Colour="0,0,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="69~85" Update="Red" Colour="0,0,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="86~102" Update="Red" Colour="0,0,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="103~119" Update="Red" Colour="0,0,0" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="120~136" Update="Red" Colour="0,0,0" />
      <Function ID="9" Name="Red Shade" Display="'Red Shade'" Dmx="137~153" Update="Red" Colour="0,0,0" />
      <Function ID="10" Name="Green Shade" Display="'Green Shade'" Dmx="154~170" Update="Red" Colour="0,0,0" />
      <Function ID="11" Name="Blue Shade" Display="'Blue Shade'" Dmx="171~187" Update="Red" Colour="0,0,0" />
      <Function ID="12" Name="White Shade" Display="'White Shade'" Dmx="188~204" Update="Red" Colour="0,0,0" />
      <Function ID="13" Name="Colour Shade" Display="'Colour Shade'" Dmx="205~221" Update="Red" Colour="0,0,0" />
      <Function ID="14" Name="RGB Swat Change" Display="'RGB Swat Change'" Dmx="222~238" Update="Red" Colour="0,0,0" />
      <Function ID="15" Name="RGB Shade" Display="'RGB Shade'" Dmx="239~255" Update="Red" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;8" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="20~39" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="40~59" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="60~79" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="80~99" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="100~119" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="120~139" />
      <Function ID="8" Name="Sound 1 (RGB Strobe)" Display="'Sound 1 (RGB Strobe)'" Dmx="140~159" />
      <Function ID="9" Name="Sound 2 (R Strobe)" Display="'Sound 2 (R Strobe)'" Dmx="160~179" />
      <Function ID="10" Name="Sound 3 (G Strobe)" Display="'Sound 3 (G Strobe)'" Dmx="180~199" />
      <Function ID="11" Name="Sound 4 (B Strobe)" Display="'Sound 4 (B Strobe)'" Dmx="200~219" />
      <Function ID="12" Name="Sound 5" Display="'Sound 5'" Dmx="220~239" />
      <Function ID="13" Name="Sound 6 (7 Col Jump)" Display="'Sound 6 (7 Col Jump)'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="UKILMSRM" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Rotate_Func" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Rotate" ChannelOffset="2" Wheel="20" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Strobe_Space" ChannelOffset="4" Wheel="5" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Auto" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
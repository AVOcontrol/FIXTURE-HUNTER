<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORado Range IP" ShortName="CR RangeIP" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>f4fbd5ba-2bb3-4d1e-83be-c6d36955b2af</Thumbnail>
  <History Date="29-03-11" Author="John Rogers" Comment="Created" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Added Macro dependant conditionals.  Changed shutter locate and power on to open." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed ID power on and locate to All IDs." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed dimmer speed non-linear to explicit values." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed HSV attribute groups and wheel mapping.  Added v-dim to PIXEL mode." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado 3P Tour." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado Ridge IP" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed Value and replaced with Dimmer for HTP" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Added pixel mapper compatibility." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="13-12-16" Author="Nic Morris" Comment="Added Atlabase ID to HSV mode." />
  <History Date="28-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="28-10-17" Author="Nic Morris" Comment="Added conditions to main RGB controls.  Added channel counts to mode names." />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added product thumbnail.  Fixed tour mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="997256db-31fb-4f97-9ff7-4a63c7cb2122" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="0,0,0" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="4" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',0.0~20.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="41~50" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~60" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~70" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="71~80" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="81~90" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="91~100" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="101~110" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~120" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~130" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="131~140" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="141~150" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="151~160" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="161~170" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="171~180" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="181~190" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="191~200" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="201~210" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="211~220" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="221~230" Update="Red1, Green1, Blue1, Red, Green, Blue" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="231~255" Update="Red1, Green1, Blue1, Red, Green, Blue" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

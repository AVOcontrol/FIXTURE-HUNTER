      <Function ID="3" Name="Light Violet" Display="'Light Violet'" Dmx="19~29" Colour="128,0,255" />
      <Function ID="4" Name="Light Yellow" Display="'Light Yellow'" Dmx="30~40" Colour="255,255,128" />

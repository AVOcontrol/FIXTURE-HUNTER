<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Synergy" ShortName="Syn Layer" Company="Avolites" Version="33">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="21-03-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="22-03-15" Author="Nic Morris" Comment="Renamed first XFade Mode function to 'Alpha' and added to Blend Mode." Version="2" />
  <History Date="22-03-15" Author="Nic Morris" Comment="Inverted Auto CCW wheel direction" Version="3" />
  <History Date="24-03-15" Author="Gregory Haynes" Comment="Moved Library select to Gobo 1 and FX to Beam and Effects. Removed Adj off names for Hue, Saturation and Contrast. Put Aspect Mode and Aspect Ratio together on Gobo 2." Version="4" />
  <History Date="24-03-15" Author="Gregory Haynes" Comment="Changed Play Speed ranges to match percentages and changed locate to Optimal. Added Normal to Aspect Ratio and Open to Shutter. Added preset palettes. Removed additional Alpha functions from XFade and Blend Mode." Version="5" />
  <History Date="09-04-15" Author="Nic Morris" Comment="Changed FX opacity's to locate at zero" Version="6" />
  <History Date="09-04-15" Author="Nic Morris" Comment="Fixed x/y/z rotation, x/y pos and image size 16-bit ranges.  Adjusted to locate at MSB 128, LSB 0." Version="7" />
  <History Date="09-04-15" Author="Nic Morris" Comment="Adjusted contrast and saturation ranges to locate at 127" Version="8" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Reverted contrast and saturation to percentage ranges.  Inverted Y-Pos" Version="9" />
  <History Date="12-04-15" Author="Nic Morris" Comment="Inverted Movement Spd.  Fixed Levels Param 4.  Adjusted X/Y/Z rot, X/Y Pos and Image size display ranges." Version="10" />
  <History Date="14-04-15" Author="Ciaran Abrams" Comment="Edited the way in which rotation values are announced" Version="11" />
  <History Date="17-04-15" Author="Nic Morris" Comment="Changed file and folder to fixed functions" Version="12" />
  <History Date="22-04-15" Author="Nic Morris" Comment="Changed X and Y Pos to single ranges for fade and shape compatibility.  Set DMX range limit at 65534 to force 50% at 127 MSB 255 LSB." Version="13" />
  <History Date="16-12-15" Author="Peter Budd" Comment="Changed the X and Y Pos to Pan and Tilt to make it possible to run position shapes." Version="14" />
  <History Date="11-02-16" Author="Peter Budd" Comment="Created from AI V8 personality." Version="15" />
  <History Date="09-05-16" Author="Peter Budd" Comment="Added the BPM Sync Channels, Spout Input Channel, and re-ordered Reserved channels to make a little more sense." Version="16" />
  <History Date="11-05-16" Author="Peter Budd" Comment="Updated the Rotate Values, and Image Size so they can locate in the correct place (32768). Changed Library Channels to start counting from 0." Version="17" />
  <History Date="06-02-17" Author="Nic Morris" Comment="Created from Avolites Media Ai v9" Version="18" />
  <History Date="11-09-17" Author="Peter Budd" Comment="Updated for Notch, and made the attribute editor image plugin work." Version="19" />
  <History Date="09-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed hue and saturation ID's for compatibility." Version="20" />
  <History Date="08-03-18" Author="Nic Morris" Comment="Added new improved product thumbnail!" Version="21" />
  <History Date="06-06-18" Author="Lawrence Gow" Comment="Created from Ai v10" Version="22" />
  <History Date="06-06-18" Author="Lawrence Gow" Comment="Added extra functions to FX seletion so the whole range is covered. Made the FX parameters only use one function as names are now handled in code." Version="23" />
  <History Date="10-07-18" Author="Lawrence Gow" Comment="Added FX_1_Param_16 and FX_2_Param_16 to the update lists of their respective selection attributes. Changed the locate function of File from 7 to 0." Version="24" />
  <History Date="28-02-19" Author="Peter Budd" Comment="Changed Folder and File to Bank and Clip to align with AI and media browser." Version="25" />
  <History Date="24-05-19" Author="Lawrence Gow" Comment="Flipped the Y-Pos DMX range so XY 0,0 is in the top left as expected with screens. Changed XFade Period so it displays as seconds." Version="26" />
  <History Date="06-11-20" Author="Nic Morris" Comment="Added latest FX and Aspect Mode functions in line with v12.1." Version="27" />
  <History Date="15-02-22" Author="Nic Morris" Comment="Added condition to In and Out Point to ensure they are fixed at zero when Play Mode is set to Sync MTC (note used value range 0-0 rather than text only to avoid -1 display in media control)" Version="28" />
  <History Date="01-02-23" Author="Nic Morris" Comment="Updated texture input functions in line with latest version (removes Notch and bunches up)" Version="33" />
  <Manual Filename="" Summary="" />

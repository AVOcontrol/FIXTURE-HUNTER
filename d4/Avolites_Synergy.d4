    <Attribute ID="In_Point" Name="In Point" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sync MTC" ID="2" If="'Play_Mode'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Frame" Display="'%.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Function" Display="'%.f',0~0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Out_Point" Name="Out Point" Description="" Group="G" Size="2">
      <Locate Locate="1:65535" PowerOn="1:65535" />
      <Condition Name="Sync MTC" ID="2" If="'Play_Mode'==16" />
      <Else ID="1" />
      <Function ID="1" Name="Frame" Display="'%.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Function" Display="'%.f',0~0" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Play_Mode" Name="Play Mode" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="In Frame" Display="'In Frame'" Dmx="0~0" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Out Frame" Display="'Out Frame'" Dmx="1~1" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Loop FWD" Display="'Loop FWD'" Dmx="2~2" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Loop REV" Display="'Loop REV'" Dmx="3~3" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Once FWD" Display="'Once FWD'" Dmx="4~4" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Once REV" Display="'Once REV'" Dmx="5~5" Update="Out_Point, In_Point" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="6" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Update="Strobe/Play" />
      <Function ID="2" Name="FRG" Display="'FRG'" Dmx="10~49" Update="Strobe/Play" />
      <Function ID="3" Name="ILD" Display="'ILD'" Dmx="50~99" Update="Strobe/Play" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="100~149" Update="Strobe/Play" />
      <Function ID="5" Name="Auto" Display="'Auto'" Dmx="150~199" Update="Strobe/Play" />
      <Function ID="6" Name="Manual" Display="'Manual'" Dmx="200~255" Update="Strobe/Play" />
    </Attribute>
    <Attribute ID="Pattern/Folder" Name="Pattern/Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Strobe/Play" Name="Strobe/Play" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="FRG/ILD" ID="1" If="'Mode'==2||'Mode'==3" />
      <Else ID="2,3,4" />
      <Function ID="1" Name="Play" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Skip L-R" Display="'Skip L-R %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Skip L-R" Display="'Skip L-R %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Scaling" Display="'No Scaling'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~100" />
      <Function ID="3" Name="Magnify" Display="'Magnify %.f%%',0~100" Dmx="101~150" />
      <Function ID="4" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="Loop Playback" Display="'Loop Playback %.f%%',0~100" Dmx="201~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Rotation" Display="'No Rotation'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="11~180" />
      <Function ID="3" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="181~217" />
      <Function ID="4" Name="Auto CCW" Display="'Auto CCW %.f%%',0~100" Dmx="218~255" />
    </Attribute>
    <Attribute ID="Gradual_Draw" Name="Gradual Draw" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Constant" Display="'Constant'" Dmx="0~0" />
      <Function ID="2" Name="Manual Fade" Display="'Manual Fade %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Auto Fade (Add)" Display="'Auto Fade (Add) %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Auto Clip (Minus)" Display="'Auto Clip (Minus) %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Auto Cycle Fade" Display="'Auto Cycle Fade %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Asymptotic (Increasing)" Display="'Asymptotic (Increasing) %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Asymptotic (Subtraction)" Display="'Asymptotic (Subtraction) %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Med" Display="'Med %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Large" Display="'Large %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Max" Display="'Max %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Wave" Display="'No Wave'" Dmx="0~0" />
      <Function ID="2" Name="Small" Display="'Small %.f%%',0~100" Dmx="10~69" />
      <Function ID="3" Name="Med" Display="'Med %.f%%',0~100" Dmx="70~129" />
      <Function ID="4" Name="Large" Display="'Large %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Max" Display="'Max %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Display_Mode" Name="Display Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Highlight" Display="'Highlight'" Dmx="64~127" />
      <Function ID="3" Name="Segmented" Display="'Segmented'" Dmx="128~191" />
      <Function ID="4" Name="Dot" Display="'Dot'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Green Grass" Display="'Green Grass'" Dmx="102~118" Colour="0,255,0" />
      <Function ID="8" Name="W, R, G, B Subsection" Display="'W, R, G, B Subsection'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="B, Y, P, C Subsection" Display="'B, Y, P, C Subsection'" Dmx="136~151" Colour="255,255,255" />
      <Function ID="10" Name="W, R, G, B, Y, C, P Subsection" Display="'W, R, G, B, Y, C, P Subsection'" Dmx="152~169" Colour="255,255,255" />
      <Function ID="11" Name="W, R, G, B Flow" Display="'W, R, G, B Flow'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="B, Y, P, B Flow" Display="'B, Y, P, B Flow'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="W, R, G, Y, P, B Flow" Display="'W, R, G, Y, P, B Flow'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Display by Breakpoint Section" Display="'Display by Breakpoint Section'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="255~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Nick NRG 801" ShortName="NRG 801" Company="DTS" Version="12">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <Thumbnail>c3d2d52f-1d03-4877-8a24-185a88a92dfc</Thumbnail>
  <History Date="07-04-11" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="13-03-12" Author="Peter Budd" Comment="Created from Nick wash 600" Version="2" />
  <History Date="17-05-12" Author="Peter Budd" Comment="Edited added physical pan tilt properties." Version="3" />
  <History Date="20-12-12" Author="Peter Budd" Comment="Made dimmer continuous range." Version="4" />
  <History Date="15-03-13" Author="John Rogers" Comment="Edited Pan FAR and Tilt FAR to Effects attribute group. Was causing clashes with position palettes." Version="5" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="6" />
  <History Date="24-02-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Removed tilt spin and zoom speed as they were not used." Version="7" />
  <History Date="24-02-17" Author="Nic Morris" Comment="Renamed Pan FAR to Pan Spin and moved into beam group for standardisation." Version="8" />
  <History Date="22-09-18" Author="Nic Morris" Comment="Added product thumbnail.  Changed random strobe ranges from fixed to variable in response to customer bug report." Version="9" />
  <History Date="22-09-18" Author="Nic Morris" Comment="Revised standard mode colour macro ranges.  Updated reserved controls to frequency and zoom speed." Version="10" />
  <History Date="10-08-20" Author="Nic Morris" Comment="Created from DTS Nick NRG1201" Version="11" />
  <History Date="12-08-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="12" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ae2b8bc7-4df8-4564-b30d-d4acb4599e9e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="127~0" />
      <Function ID="2" Name="Max" Display="'Max'" Dmx="128~247" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="540° (Standard Path)" Display="'540° (Standard Path)'" Dmx="0~0" />
      <Function ID="2" Name="360° (1 Turn)" Display="'360° (1 Turn)'" Dmx="11~20" />
      <Function ID="3" Name="720° (2 Turns)" Display="'720° (2 Turns)'" Dmx="21~30" />
      <Function ID="4" Name="1080° (3 Turns)" Display="'1080° (3 Turns)'" Dmx="31~40" />
      <Function ID="5" Name="1440° (4 Turns)" Display="'1440° (4 Turns)'" Dmx="41~50" />
      <Function ID="6" Name="1800° (5 Turns)" Display="'1800° (5 Turns)'" Dmx="51~60" />
      <Function ID="7" Name="2160° (6 Turns)" Display="'2160° (6 Turns)'" Dmx="61~70" />
      <Function ID="8" Name="2520° (7 Turns)" Display="'2520° (7 Turns)'" Dmx="71~80" />
      <Function ID="9" Name="2880° (8 Turns)" Display="'2880° (8 Turns)'" Dmx="81~90" />
      <Function ID="10" Name="3240° (9 Turns)" Display="'3240° (9 Turns)'" Dmx="91~100" />
      <Function ID="11" Name="3600° (10 Turns)" Display="'3600° (10 Turns)'" Dmx="101~110" />
      <Function ID="12" Name="360° (Smart Path)" Display="'360° (Smart Path)'" Dmx="111~120" />
      <Function ID="13" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="121~182" />
      <Function ID="14" Name="No Spin" Display="'No Spin'" Dmx="183~193" />
      <Function ID="15" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" Intensity="0~0" />
      <Function ID="4" Name="Rnd Ind" Display="'Rnd Ind %.f%%',0~100" Dmx="205~229" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="180~204" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="120~149" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="150~179" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WhiteMacro" Name="White Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="CTO, Function" Colour="0,0,0" />
      <Function ID="2" Name="Full" Display="'Full'" Dmx="56~105" Update="CTO, Function" Colour="0,0,0" />
      <Function ID="3" Name="White DTS" Display="'White DTS'" Dmx="106~155" Update="CTO, Function" Colour="0,0,0" />
      <Function ID="4" Name="Custom Create" Display="'Custom Create'" Dmx="156~205" Update="CTO, Function" Colour="0,0,0" />
      <Function ID="5" Name="CTC enable" Display="'CTC enable'" Dmx="206~255" Update="CTO, Function" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="WhiteCTC" ID="2" If="'WhiteMacro'==5" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="CTO Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="15~30" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~46" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="47~62" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="63~78" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="79~94" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="95~110" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="111~126" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="127~142" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="143~158" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="159~174" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="175~190" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="191~206" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="207~222" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="223~238" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="239~254" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="15~24" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="25~34" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="35~44" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="45~54" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="55~64" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="65~74" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="75~84" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="85~94" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="95~104" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="105~114" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="115~124" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="125~134" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="135~144" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="145~154" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="155~164" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="165~174" Colour="0,0,0" />
      <Function ID="18" Name="Rainbow 1" Display="'Rainbow 1'" Dmx="175~184" Colour="0,0,0" />
      <Function ID="19" Name="Rainbow 2" Display="'Rainbow 2'" Dmx="185~194" Colour="0,0,0" />
      <Function ID="20" Name="Rainbow 3" Display="'Rainbow 3'" Dmx="195~204" Colour="0,0,0" />
      <Function ID="21" Name="Rainbow 4" Display="'Rainbow 4'" Dmx="205~214" Colour="0,0,0" />
      <Function ID="22" Name="Rainbow 5" Display="'Rainbow 5'" Dmx="215~224" Colour="0,0,0" />
      <Function ID="23" Name="Rainbow 6" Display="'Rainbow 6'" Dmx="225~234" Colour="0,0,0" />
      <Function ID="24" Name="Rainbow 7" Display="'Rainbow 7'" Dmx="235~244" Colour="0,0,0" />
      <Function ID="25" Name="Rainbow 8" Display="'Rainbow 8'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Function" Name="White Mac Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="CustomWhite" ID="2,3,4" If="'WhiteMacro'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Custom Recall" Display="'Custom Recall'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Custom Create" Display="'Custom Create'" Dmx="80~160" Colour="0,0,0" />
      <Function ID="4" Name="Custom Store" Display="'Custom Store'" Dmx="161~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom_Spd" Name="Zoom Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="128~0" />
      <Function ID="2" Name="Max" Display="'Max'" Dmx="129~247" />
      <Function ID="3" Name="Med" Display="'Med'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="16~255" />
    </Attribute>
  </Control>
  <Mode Name="20 DMX (Macro = STD)" Channels="20">

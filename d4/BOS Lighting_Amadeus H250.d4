  <History Date="22-02-22" Author="Nic Morris" Comment="Created (poor documentation.  charts contain errors)" Version="0" />
  <History Date="26-02-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="24-07-22" Author="Nic Morris" Comment="Created from LIGHT4ME Venom Zoom 350 (messy documentation.  contains errors.  identical)" Version="2" />
  <History Date="28-07-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="12-12-22" Author="Nic Morris" Comment="Created from ArtFox Hybrid LED 350W (identical) (documentation available only contained 18 channel mode but Capture has 18+16.  Assumed identical)" Version="4" />
  <History Date="08-03-23" Author="Nic Morris" Comment="Created from V-Show BSW250 (gobo 2 rot ranges missing - assumed identical.  gobo 1 slot 8 image missing)" Version="5" />
  <History Date="10-03-23" Author="Nic Morris" Comment="Added Atlabase ID's (previously B on Stage Lighting)" Version="6" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="183a8f93-256e-4240-8b8e-8b836d584fdd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~250" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="32~47" Colour="255,150,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="48~63" Colour="0,255,0" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="64~79" Colour="255,0,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="80~95" Colour="0,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="96~111" Colour="255,255,0" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="112~127" Colour="50,0,200" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Effect" Name="Colour Effect" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Col Fine" Display="'Col Fine %.1f%%',0.0~100.0" Dmx="11~209" Colour="255,255,255" />
      <Function ID="3" Name="Col Shake" Display="'Col Shake %.f%%',0~100" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>d90c9104-cbcf-4cf7-ba6f-865d33b20748</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="7~13" WheelPosition="1">
        <Swatch>3bb29fbf-42cd-4bd2-a441-9b6582576211</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="14~20" WheelPosition="2">
        <Swatch>14d64031-441b-458d-9e59-7a3cfd933862</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="21~27" WheelPosition="3">
        <Swatch>f51da2ac-3bdb-4480-bae4-0a0e56ee41d2</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="28~34" WheelPosition="4">
        <Swatch>1d6811e5-33eb-4be0-9ad9-8b818385b4cc</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="35~41" WheelPosition="5">
        <Swatch>0e9fc15e-63e6-4e9e-adb6-26f685823e84</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="42~48" WheelPosition="6">
        <Swatch>c4a83d44-9a52-4df2-8501-0fd95a8a2bbf</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="49~55" WheelPosition="7">
        <Swatch>6669fa83-972e-438b-adf7-eb13b8f2440a</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="56~63" WheelPosition="8" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>d90c9104-cbcf-4cf7-ba6f-865d33b20748</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="113~119" WheelPosition="1">
        <Swatch>3bb29fbf-42cd-4bd2-a441-9b6582576211</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="106~112" WheelPosition="2">
        <Swatch>14d64031-441b-458d-9e59-7a3cfd933862</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="99~105" WheelPosition="3">
        <Swatch>f51da2ac-3bdb-4480-bae4-0a0e56ee41d2</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="92~98" WheelPosition="4">
        <Swatch>1d6811e5-33eb-4be0-9ad9-8b818385b4cc</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="85~91" WheelPosition="5">
        <Swatch>0e9fc15e-63e6-4e9e-adb6-26f685823e84</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="78~84" WheelPosition="6">
        <Swatch>c4a83d44-9a52-4df2-8501-0fd95a8a2bbf</Swatch>
      </Function>
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="71~77" WheelPosition="7">
        <Swatch>6669fa83-972e-438b-adf7-eb13b8f2440a</Swatch>
      </Function>
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="64~70" WheelPosition="8" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Gobo2Func'==3||'Gobo2Func'==4" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>d90c9104-cbcf-4cf7-ba6f-865d33b20748</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="16~31" WheelPosition="1">
        <Swatch>4e21c9f4-adab-4256-b9a7-418b24e363f8</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="32~47" WheelPosition="2">
        <Swatch>735ebf84-4bb3-44ed-b16b-47ed09947b81</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="48~63" WheelPosition="3">
        <Swatch>a4480066-8291-4c40-a091-0dfd62139b73</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" WheelPosition="4">
        <Swatch>fc895351-3a30-474c-a304-e49d564a849d</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="80~95" WheelPosition="5">
        <Swatch>20a42261-ff5c-436d-8c07-446ae29c188a</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="96~111" WheelPosition="6">
        <Swatch>a52e62cf-4cac-4b86-b0e8-ea7dd7cafade</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="112~127" WheelPosition="7">
        <Swatch>77605155-8539-496c-881a-55c7de676495</Swatch>
      </Function>
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==3" />
      <Condition Name="Spin" ID="6,7,8,9" If="'Gobo2Func'==2||'Gobo2Func'==4" />
      <Else ID="10" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index 0-250" Display="'Index 0-250 %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Index 0-90" Display="'Index 0-90 %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="Index 0-300" Display="'Index 0-300 %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="Index 0-360" Display="'Index 0-360 %.f%%',0~100" Dmx="156~175" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="7" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="215~176" />
      <Function ID="8" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="9" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="216~255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Index 0-250" Display="'Index 0-250 %.f%%',0~100" Dmx="16~95" />
      <Function ID="3" Name="Index 0-90" Display="'Index 0-90 %.f%%',0~100" Dmx="96~135" />
      <Function ID="4" Name="Index 0-300" Display="'Index 0-300 %.f%%',0~100" Dmx="136~155" />
      <Function ID="5" Name="Index 0-360" Display="'Index 0-360 %.f%%',0~100" Dmx="156~175" />

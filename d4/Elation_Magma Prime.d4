  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Fog_Output" Name="Fog Output" Description="" Group="I">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Fog_Volume" Name="Fog Volume" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Duration" Display="'No Duration'" Dmx="0~0" />
      <Function ID="2" Name="Duration" Display="'%.fms',1~250" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Interval" Name="Interval" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Interval" Display="'No Interval'" Dmx="0~0" />
      <Function ID="2" Name="No Interval" Display="'No Interval %.f Sec',10~2500" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:20" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',20.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">

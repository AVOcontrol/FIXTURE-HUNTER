      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="103~106" WheelPosition="12" Colour="255,100,0" />
      <Function ID="14" Name="UV" Display="'UV'" Dmx="111~115" WheelPosition="13" Colour="180,0,255" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="13~17" WheelPosition="1" Colour="255,0,0" />

      <Function ID="20" Name="Mag/ L Grn" Display="'Mag/ L Grn'" Dmx="47~51" WheelPosition="5" Colour="255,0,255" />
      <Function ID="21" Name="L Grn/ Cy" Display="'L Grn/ Cy'" Dmx="56~59" WheelPosition="6" Colour="128,255,0" />
      <Function ID="22" Name="Cy/ WW" Display="'Cy/ WW'" Dmx="64~68" WheelPosition="7" Colour="0,255,255" />
      <Function ID="23" Name="WW/ Rs" Display="'WW/ Rs'" Dmx="73~76" WheelPosition="8" Colour="255,240,200" />
      <Function ID="24" Name="Rs/ CTB" Display="'Rs/ CTB'" Dmx="82~85" WheelPosition="9" Colour="255,0,127" />
      <Function ID="25" Name="CTB/ CTO" Display="'CTB/ CTO'" Dmx="90~93" WheelPosition="10" Colour="230,230,255" />
      <Function ID="26" Name="CTO/ Amb" Display="'CTO/ Amb'" Dmx="99~102" WheelPosition="11" Colour="255,240,200" />
      <Function ID="27" Name="Amb/ UV" Display="'Amb/ UV'" Dmx="107~110" WheelPosition="12" Colour="255,100,0" />
      <Function ID="28" Name="UV/ Op" Display="'UV/ Op'" Dmx="116~119" WheelPosition="13" Colour="180,0,255" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="30" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="31" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Fadeout" Display="'Fadeout %.f%%',0~100" Dmx="4~103" />

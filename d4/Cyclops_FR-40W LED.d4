<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="FR-40W LED" ShortName="FR-40W LED" Company="Cyclops">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>a6d5af3f-2e3f-4433-a0ea-82114c1a5b1c</Thumbnail>
  <History Date="14-10-18" Author="Nic Morris" Comment="Created (note charts are missing DMX ranges for dim mode functions)" />
  <History Date="17-10-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="96729799-1403-41d4-8ef4-8bf2ce9a8fbd" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="IDs 1-20" Display="'IDs 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="IDs 21-66" Display="'IDs 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="UKCYF4W1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="edcfa62a-d71f-4e83-9111-b4c6a59d1175" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">

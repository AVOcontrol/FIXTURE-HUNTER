  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rand Slow" Display="'Rand Slow'" Dmx="213~225" Intensity="0~0" />
      <Function ID="5" Name="Rand Med" Display="'Rand Med'" Dmx="226~238" Intensity="0~0" />
      <Function ID="6" Name="Rand Fast" Display="'Rand Fast'" Dmx="239~251" Intensity="0~0" />
      <Function ID="7" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Fast" Display="'P/T Fast'" Dmx="12~24" />
      <Function ID="3" Name="P/T Normal" Display="'P/T Normal'" Dmx="25~37" />
      <Function ID="4" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="38~42" />
      <Function ID="5" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="43~47" />
      <Function ID="6" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="48~52" />
      <Function ID="7" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="53~57" />
      <Function ID="8" Name="No Function" Display="'No Function'" Dmx="103~250" />
      <Function ID="9" Name="Reset to Default" Display="'Reset to Default'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">

    </Macro>
    <Macro Name="Dim Curve 3">
      <Set Channel="Function:6" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Curve 4">
      <Set Channel="Function:7" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reset to Default">
      <Set Channel="Function:18" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
  </Macro>

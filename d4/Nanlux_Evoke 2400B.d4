  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',2700.00~6500.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="-80 Green" Display="'-80 Green'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="- Green" Display="'- Green %.f',79~1" Dmx="21~99" Colour="0,0,0" />

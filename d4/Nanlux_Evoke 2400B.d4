      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30000~40000" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.2f',1.00~79.00" Dmx="40001~59999" Colour="0,0,0" />
      <Function ID="6" Name="+80 Green" Display="'+80 Green'" Dmx="60000~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Smart" Display="'Smart'" Dmx="0~0" />
      <Function ID="2" Name="Full Speed" Display="'Full Speed'" Dmx="64~127" />
      <Function ID="3" Name="Low Speed" Display="'Low Speed'" Dmx="128~191" />
      <Function ID="4" Name="Fan Off" Display="'Fan Off'" Dmx="192~255" />

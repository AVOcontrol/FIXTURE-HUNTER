      <Function ID="3" Name="Int Loop Effect" Display="'Int Loop Effect'" Dmx="19~36" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />
      <Function ID="4" Name="Flash Effect" Display="'Flash Effect'" Dmx="37~54" Update="Param_2, Param_3, Param_4, Param_5, Param_6, Param_8, Param_7" />

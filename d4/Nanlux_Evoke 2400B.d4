    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CCT" Display="'CCT'" Dmx="0~0" Update="Param_1, Param_2" />
      <Function ID="2" Name="Effect" Display="'Effect'" Dmx="64~127" Update="Param_1, Param_2" />

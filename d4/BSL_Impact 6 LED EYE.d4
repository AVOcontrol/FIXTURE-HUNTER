<Fixture Name="Impact 6 LED EYE" ShortName="Ipct 6 EYE" Company="BSL">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="21-02-15" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="27-09-17" Author="Nic Morris" Comment="Revised standard and extended mode shutter effect functions in line with udpated charts." />
  <History Date="27-09-17" Author="Nic Morris" Comment="Revised Basic mode names and added channel counts." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5a8bcd04-52f0-43dc-9089-d131a19244f2" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
      <Function ID="3" Name="Tilt Sync" Display="'Tilt Sync'" Dmx="32~37" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" Intensity="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" Intensity="0~0" />
      <Function ID="5" Name="Effect 1" Display="'Effect 1'" Dmx="64~67" />
      <Function ID="6" Name="Effect 2" Display="'Effect 2'" Dmx="68~71" />
      <Function ID="7" Name="Effect 3" Display="'Effect 3'" Dmx="72~75" />
      <Function ID="8" Name="Effect 4" Display="'Effect 4'" Dmx="76~79" />
      <Function ID="9" Name="Effect 5" Display="'Effect 5'" Dmx="80~83" />
      <Function ID="10" Name="Effect 6" Display="'Effect 6'" Dmx="84~87" />
      <Function ID="11" Name="Effect 7" Display="'Effect 7'" Dmx="88~91" />
      <Function ID="12" Name="Effect 8" Display="'Effect 8'" Dmx="92~95" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" Intensity="0~0" />
      <Function ID="6" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="32~47" Intensity="0~0" />
      <Function ID="7" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="48~63" Intensity="0~0" />
      <Function ID="8" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="9" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="112~127" Intensity="0~0" />
      <Function ID="10" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="11" Name="Effect 6" Display="'Effect 6 %.f%%',0~100" Dmx="176~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="8~15" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="16~23" />
      <Function ID="4" Name="Display OFF" Display="'Display OFF'" Dmx="56~63" />
      <Function ID="5" Name="Display ON" Display="'Display ON'" Dmx="64~71" />
      <Function ID="6" Name="Hibernate" Display="'Hibernate'" Dmx="88~95" />
    </Attribute>
    <Attribute ID="Tilt_1" Name="Tilt 1" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_2" Name="Tilt 2" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />

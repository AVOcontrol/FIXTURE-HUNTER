  <History Date="21-07-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="22-03-24" Author="Nic Morris" Comment="Swapped open and closed shutter values in response to customer feedback (documentation is misleading where 0-5 is 'ON' and 6-10 is 'OFF')" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="446dc5f8-aed7-4e31-aade-b405483e4173" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~90" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="91~170" />
      <Function ID="5" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim0" Display="'Dim0'" Dmx="11~20" />
      <Function ID="3" Name="Dim1" Display="'Dim1'" Dmx="21~30" />
      <Function ID="4" Name="Dim2" Display="'Dim2'" Dmx="31~40" />
      <Function ID="5" Name="Dim3" Display="'Dim3'" Dmx="41~50" />
      <Function ID="6" Name="Dim4" Display="'Dim4'" Dmx="51~60" />
      <Function ID="7" Name="Regulated Power On" Display="'Regulated Power On'" Dmx="61~70" />
      <Function ID="8" Name="Regulated Power Off" Display="'Regulated Power Off'" Dmx="71~80" />
      <Function ID="9" Name="Fan Silent" Display="'Fan Silent'" Dmx="101~110" />
      <Function ID="10" Name="Fan Quiet" Display="'Fan Quiet'" Dmx="111~120" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="121~130" />
      <Function ID="12" Name="Fan High" Display="'Fan High'" Dmx="131~140" />
      <Function ID="13" Name="Fast Dimmer Off" Display="'Fast Dimmer Off'" Dmx="141~150" />
      <Function ID="14" Name="Fast Dimmer On" Display="'Fast Dimmer On'" Dmx="151~160" />
      <Function ID="15" Name="Dim Linear" Display="'Dim Linear'" Dmx="161~170" />
      <Function ID="16" Name="Dim Square" Display="'Dim Square'" Dmx="171~180" />
      <Function ID="17" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="181~190" />
      <Function ID="18" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="191~200" />
      <Function ID="19" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="201~255" />
    </Attribute>
  </Control>

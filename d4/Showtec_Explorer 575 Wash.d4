<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Explorer 575 Wash" ShortName="Explr575Ws" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>a94b63b9-9a32-429f-9d58-fd0b678cfadd</Thumbnail>
  <History Date="20-06-07" Author="D.Milligan" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="15-11-10" Author="John Rogers" Comment="Added palettes." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="18-03-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Standardised conditionals.  Moved raw functions into else conditions." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="64b76639-1671-4ed8-b64c-17bca16e2caa" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Keep" Name="Keep" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="9,10" If="'Colour1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="25~49" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="50~74" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="75~99" Colour="0,255,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="100~124" Colour="255,128,0" />
      <Function ID="6" Name="3200K" Display="'3200K'" Dmx="125~149" Colour="255,240,200" />
      <Function ID="7" Name="6000K" Display="'6000K'" Dmx="150~174" Colour="230,230,255" />
      <Function ID="8" Name="UV" Display="'UV'" Dmx="175~199" Colour="180,0,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="10" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="200~255" Colour="0,0,0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Col_Speed" Name="Col Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="CMY_Macro" Name="CMY Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CMY" Display="'CMY'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="8~13" Colour="0,0,0" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="14~28" Colour="0,0,0" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="29~43" Colour="0,0,0" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="44~58" Colour="0,0,0" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="59~73" Colour="0,0,0" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="74~88" Colour="0,0,0" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="89~103" Colour="0,0,0" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="104~118" Colour="0,0,0" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="119~133" Colour="0,0,0" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="134~148" Colour="0,0,0" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="149~163" Colour="0,0,0" />
      <Function ID="13" Name="Macro 11" Display="'Macro 11'" Dmx="164~178" Colour="0,0,0" />
      <Function ID="14" Name="Macro 12" Display="'Macro 12'" Dmx="179~193" Colour="0,0,0" />
      <Function ID="15" Name="Macro 13" Display="'Macro 13'" Dmx="194~208" Colour="0,0,0" />
      <Function ID="16" Name="Macro 14" Display="'Macro 14'" Dmx="209~223" Colour="0,0,0" />
      <Function ID="17" Name="Macro 15" Display="'Macro 15'" Dmx="224~238" Colour="0,0,0" />
      <Function ID="18" Name="Macro 16" Display="'Macro 16'" Dmx="239~253" Colour="0,0,0" />
      <Function ID="19" Name="Macro 17" Display="'Macro 17'" Dmx="254~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Lambency" Display="'Lambency'" Dmx="50~99" />
      <Function ID="3" Name="L Radiate" Display="'L Radiate %.1f%%',0.0~100.0" Dmx="100~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="41~250" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX, 16bit" Channels="16">
    <Import PearlRef="SH_Ex575W" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2de6f4c6-e5e0-4c3d-9ab4-a5f4acf39f2a" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="15" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="16" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,3" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,4" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
      <Attribute ID="Cyan" ChannelOffset="8" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="9" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="10" Wheel="12" />
      <Attribute ID="Zoom" ChannelOffset="14" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="13" Wheel="23" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Keep" ChannelOffset="6" Wheel="29" />
      <Attribute ID="Col_Speed" ChannelOffset="11" Wheel="26" />
      <Attribute ID="CMY_Macro" ChannelOffset="12" Wheel="9" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="a94b63b9-9a32-429f-9d58-fd0b678cfadd"></Swatch>
  </swatchLibrary>
</Fixture>
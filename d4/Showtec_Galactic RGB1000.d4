<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Galactic RGB1000" ShortName="Galactic R" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="22-05-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~73" Update="Folders, Shutter" />
      <Function ID="2" Name="PRG Show" Display="'PRG Show'" Dmx="74~110" Update="Folders, Shutter" />
      <Function ID="3" Name="ILD Show" Display="'ILD Show'" Dmx="111~147" Update="Folders, Shutter" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="148~165" Update="Folders, Shutter" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="166~184" Update="Folders, Shutter" />
      <Function ID="6" Name="Music 1" Display="'Music 1'" Dmx="185~202" Update="Folders, Shutter" />
      <Function ID="7" Name="Music 2" Display="'Music 2'" Dmx="203~221" Update="Folders, Shutter" />
      <Function ID="8" Name="DMX Mode" Display="'DMX Mode'" Dmx="222~255" Update="Folders, Shutter" />
    </Attribute>
    <Attribute ID="Folders" Name="Folders" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="PRG Show" ID="1" If="'Control'==2||'Control'==3" />
      <Else ID="2" />
      <Function ID="1" Name="Folder" Display="'Folder %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="PRG Show" ID="1" If="'Control'==2||'Control'==3" />
      <Else ID="2,3,4" />
      <Function ID="1" Name="Show" Display="'Show %.f',0~255" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~10" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~199" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X-Move" Display="'X-Move %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="126~185" />
      <Function ID="3" Name="Rand Speed" Display="'Rand Speed %.1f%%',0.0~100.0" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y-Move" Display="'Y-Move %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="126~185" />
      <Function ID="3" Name="Rand Speed" Display="'Rand Speed %.1f%%',0.0~100.0" Dmx="186~225" />
      <Function ID="4" Name="Rand Pos" Display="'Rand Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="101~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="YRoll" Name="Y-Roll" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" />
    </Attribute>
    <Attribute ID="XRoll" Name="X-Roll" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" />
    </Attribute>
    <Attribute ID="ZRoll" Name="Z-Roll" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" />
      <Function ID="3" Name="Spin" Display="'Spin %.f%%',0~100" Dmx="111~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Clipping" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~9" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="10~74" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="75~104" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="105~144" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Pulse " Display="'Pulse  %.f%%',0~100" Dmx="145~184" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Clipping On" Display="'Clipping On'" Dmx="185~223" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Clipping Off" Display="'Clipping Off'" Dmx="224~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~9" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="10~199" />
      <Function ID="3" Name="Amplitude" Display="'Amplitude %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~17" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="4 Fixed 1" Display="'4 Fixed 1'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="4 Fixed 2" Display="'4 Fixed 2'" Dmx="136~152" Colour="0,0,255" />
      <Function ID="10" Name="7 Colour" Display="'7 Colour'" Dmx="153~169" Colour="0,0,0" />
      <Function ID="11" Name="4 Loop" Display="'4 Loop'" Dmx="170~186" Colour="0,0,0" />
      <Function ID="12" Name="4 Loop" Display="'4 Loop'" Dmx="187~203" Colour="0,0,0" />
      <Function ID="13" Name="7 Colour Loop" Display="'7 Colour Loop'" Dmx="204~220" Colour="0,0,0" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="221~237" Colour="0,0,0" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~63" />
      <Function ID="2" Name="Bright Points" Display="'Bright Points'" Dmx="64~127" />
      <Function ID="3" Name="Blanking" Display="'Blanking'" Dmx="128~191" />
      <Function ID="4" Name="Points" Display="'Points'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX, 8bit" Channels="13">
    <Import PearlRef="SH_GRGB1000" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour_Macro" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Folders" ChannelOffset="2" Wheel="14" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Iris" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="YRoll" ChannelOffset="7" Wheel="26" />
      <Attribute ID="XRoll" ChannelOffset="8" Wheel="25" />
      <Attribute ID="ZRoll" ChannelOffset="9" Wheel="27" />
      <Attribute ID="Wave" ChannelOffset="11" Wheel="21" />
      <Attribute ID="Pattern" ChannelOffset="13" Wheel="15" />
    </Include>
  </Mode>
</Fixture>
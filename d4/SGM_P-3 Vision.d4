    </Attribute>
    <Attribute ID="Wash_Effect" Name="Wash Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Flicker" Display="'Flicker'" Dmx="6~10" />
      <Function ID="3" Name="Random Strobe Panel" Display="'Random Strobe Panel'" Dmx="11~15" />

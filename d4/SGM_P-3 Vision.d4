      <Function ID="1" Name="Default (2440Hz)" Display="'Default (2440Hz)'" Dmx="0~0" />
      <Function ID="2" Name="Frequency" Display="'Frequency %.f Hz',2440~22220" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default (Auto)" Display="'Default (Auto)'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Source 1-&gt;2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Wash_Master" Name="Wash Master" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Wash_Dur" Name="Wash Dur" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />

  <History Date="22-07-15" Author="Nic Morris" Comment="Created" />
  <History Date="05-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="11-07-16" Author="Nic Morris" Comment="Added 14 and 22 DMX modes" />
  <History Date="08-01-17" Author="Nic Morris" Comment="Added Atlabase ID's to 14 and 22 DMX modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0488a2d8-b977-4839-b9ca-bd958fed642b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Custom" Name="Custom" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Custom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour'" Dmx="6~20" />
      <Function ID="3" Name="Step" Display="'Step'" Dmx="21~40" />
      <Function ID="4" Name="Gradual" Display="'Gradual'" Dmx="41~60" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="61~80" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="81~100" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="101~120" />
      <Function ID="8" Name="Auto Col" Display="'Auto Col'" Dmx="121~140" />
      <Function ID="9" Name="Auto Step" Display="'Auto Step'" Dmx="141~160" />
      <Function ID="10" Name="Auto Gradual" Display="'Auto Gradual'" Dmx="161~180" />
      <Function ID="11" Name="Auto Pulse" Display="'Auto Pulse'" Dmx="181~200" />
      <Function ID="12" Name="Auto Sound 1" Display="'Auto Sound 1'" Dmx="201~220" />
      <Function ID="13" Name="Auto Sound 2" Display="'Auto Sound 2'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="ID 1" Display="'ID 1'" Dmx="10~19" />
      <Function ID="3" Name="ID 2" Display="'ID 2'" Dmx="20~29" />
      <Function ID="4" Name="ID 3" Display="'ID 3'" Dmx="30~39" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="iWash Flex" ShortName="iWash Flex" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="26-01-04" Author="Greg Brown" Comment="Created" />
  <History Date="27-01-04" Author="Pete" Comment="Checked" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 1. Dimmer - (Power On) Not 0" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 2. Shutter - Invert legend 100%-0 for range 128-184" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 3. Blade Rot - Locate at 50%" />
  <History Date="12-01-04" Author="L.Gallagher" Comment="Error Found 4. Zoom - Invert legend 0 is 7 degrees, 255 is 30 degrees" />
  <History Date="12-07-04" Author="Phil Rogers" Comment="Above errors fixed" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Close pulse inverted on shutter channel" />
  <History Date="11-08-05" Author="Ed" Comment="Error: Blade rot should power on and locate at 0 needs no effect at 0 to 9." />
  <History Date="11-08-05" Author="Ed" Comment="Error: Should power on and locate to 50%. Should be a %" />
  <History Date="11-08-05" Author="Ed" Comment="Fixed above problems" />
  <History Date="06-04-06" Author="Ed" Comment="Moved all Blade attributes into Beam group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="17-08-06" Author="David" Comment="Updated Pan/Tilt Max and Light Type" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Attributes in Macros" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Modified Attribute Channel Size" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Modified Attribute Channel Size" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-10-17" Author="Nic Morris" Comment="Changed name from IWash Flex to iWash Flex.  Simplified shutter." />
  <History Date="16-10-17" Author="Nic Morris" Comment="Moved raw functions into else conditions.  Fixed duplicate else functions.  Fixed updates." />
  <History Date="16-10-17" Author="Nic Morris" Comment="Revised blade attribute ID's for compatibility.  Added palettes.  Added highlight/lowlight." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1ed7c47d-6d43-49de-bc9d-f132d1795b4e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~200" />
      <Function ID="3" Name="Fast Movement" Display="'Fast Movement'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~66" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="188~244" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="69~125" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="128~184" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'Colour1Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="6~15" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~25" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="26~35" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="36~45" Colour="0,0,0" />
      <Function ID="6" Name="Index" Display="'%.f%%',0~100" Dmx="46~127" Colour="255,255,255" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" Colour="255,255,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="6" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="7,8,9,10" If="'Colour2Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="6~15" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~25" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="26~35" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="36~45" Colour="0,0,0" />
      <Function ID="6" Name="Index" Display="'%.f%%',0~100" Dmx="46~127" Colour="255,255,255" />
      <Function ID="7" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="8" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~191" Colour="255,255,255" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="255,255,255" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Zap" Name="Zap" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="11~249" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Lamp_Power" Name="Lamp Power" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Power" ID="2" If="'Control'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Auto" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Power" Display="'%.fW',800~2000" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Lamp_Power" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="11~32" Update="Lamp_Power" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="33~76" Update="Lamp_Power" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="77~120" Update="Lamp_Power" />
      <Function ID="5" Name="Lamp On (Manual Power)" Display="'Lamp On (Manual Power)'" Dmx="121~195" Update="Lamp_Power" />
      <Function ID="6" Name="Lamp On (Auto Power)" Display="'Lamp On (Auto Power)'" Dmx="196~255" Update="Lamp_Power" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blade_1" Name="Blade Top" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_3" Name="Blade Bottom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_2" Name="Blade Right" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Blade_4" Name="Blade Left" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Blade_All_Rot" Name="Blade Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Angle" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="22 DMX" Channels="22">
    <Import PearlRef="CM_IWSFLEX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="500" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="41a3313d-9e2c-4ead-add9-d2ce3da14deb" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="14" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="15" Wheel="38" />
      <Attribute ID="Cyan" ChannelOffset="16" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="17" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="18" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="19" Wheel="9" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour2Func" Wheel="37" />
      <Attribute ID="Blade_1" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Blade_3" ChannelOffset="9" Wheel="21" />
      <Attribute ID="Blade_2" ChannelOffset="10" Wheel="50" />
      <Attribute ID="Blade_4" ChannelOffset="11" Wheel="49" />
      <Attribute ID="Blade_All_Rot" ChannelOffset="12" Wheel="51" />
      <Attribute ID="Zoom" ChannelOffset="13" Wheel="19" />
      <Attribute ID="Zap" ChannelOffset="20" Wheel="5" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Lamp_Power" ChannelOffset="21" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="22" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Manual Power)">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Auto Power)">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="On" Display="'On'" Dmx="0~0" Update="Pattern_Speed" />
      <Function ID="2" Name="Control" Display="'Control'" Dmx="16~31" Update="Pattern_Speed" />
      <Function ID="3" Name="Effect" Display="'Effect %.f',1~22" Dmx="32~229" Update="Pattern_Speed" />
      <Function ID="4" Name="Rnd Effect" Display="'Rnd Effect %.f',1~22" Dmx="230~255" Update="Pattern_Speed" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pattern_Speed" />
    </Attribute>
    <Attribute ID="Pattern_Speed" Name="Pattern Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Control" ID="2,3" If="'Pattern'==2" />
      <Condition Name="Effect" ID="4,5,6,7" If="'Pattern'==3||'Pattern'==4" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="3" Name="Effect" Display="'Effect %.f',1~250" Dmx="3~252" />
      <Function ID="4" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~37" />
      <Function ID="5" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="144~38" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="145~148" />
      <Function ID="7" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="149~255" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SmokeBubble Blaster" ShortName="SmokeBbble" Company="MagicFX">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>25a056e7-65c9-4d11-8cbe-d393c978ebf8</Thumbnail>
  <History Date="17-07-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Safety" Name="Safety" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="100~155" />
      <Function ID="3" Name="Disabled" Display="'Disabled'" Dmx="156~255" />
    </Attribute>
    <Attribute ID="Bubble" Name="Bubble" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="50%" Display="'50%'" Dmx="0~0" />
      <Function ID="2" Name="100%" Display="'100% %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Smoke" Name="Smoke" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Smoke" Display="'No Smoke'" Dmx="0~0" />
      <Function ID="2" Name="50% bubbles w/smoke" Display="'50% bubbles w/smoke'" Dmx="86~170" />
      <Function ID="3" Name="100% bubbles w/smoke" Display="'100% bubbles w/smoke'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Fire" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Fire" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Safety, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Safety" ChannelOffset="1" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="Fire, 4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Bubble" ChannelOffset="1" Wheel="5" />
      <Attribute ID="Smoke" ChannelOffset="2" Wheel="6" />
      <Attribute ID="Fan" ChannelOffset="3" Wheel="34" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="25a056e7-65c9-4d11-8cbe-d393c978ebf8"></Swatch>
  </swatchLibrary>
</Fixture>
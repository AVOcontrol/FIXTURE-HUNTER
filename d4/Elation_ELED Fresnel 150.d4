  <History Date="24-06-25" Author="Nic Morris" Comment="Created (documentation is a mess.  vague.  manual refers to 3 channel mode but only contains 1 and 2 channel modes.  separate DMX chart has 3 channel modes but no 2 channel modes.  It is not clear what the second dimmer control is.  assumed 16bit...)" Version="0" />
  <History Date="25-06-25" Author="Nic Morris" Comment="Added Atlabase IDs for 3 channel modes." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0b6010b7-637a-4ecc-afb7-d91ed6da8b67" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DC-0" Display="'DC-0'" Dmx="0~0" />
      <Function ID="2" Name="DC-1" Display="'DC-1'" Dmx="21~40" />
      <Function ID="3" Name="DC-2" Display="'DC-2'" Dmx="41~60" />
      <Function ID="4" Name="DC-3" Display="'DC-3'" Dmx="61~80" />
      <Function ID="5" Name="DC-4" Display="'DC-4'" Dmx="81~100" />
      <Function ID="6" Name="Dim Curve Setting Active" Display="'Dim Curve Setting Active'" Dmx="101~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="5aa07e6b-fd2a-43a4-812f-1a9ed5b3856c">

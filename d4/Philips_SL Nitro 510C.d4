      <Condition Name="Chase" ID="81,82,83,84,85,86,87,88,89,90" If="'Colour1Func'==3" />
      <Condition Name="User Chase" ID="91,92,93,94,95,96,97,98" If="'Colour1Func'==4" />
      <Else ID="99" />

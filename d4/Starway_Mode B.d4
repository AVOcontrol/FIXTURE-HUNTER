  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2,Control1:6" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:2,Control1:2" Delay="6000" />
      <Set Channel="Lamp:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:4,Control1:4" Delay="6000" />
      <Set Channel="Lamp:1,Control1:1" Delay="0" />
    </Macro>
  </Macro>

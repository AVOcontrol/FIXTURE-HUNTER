      <Function ID="13" Name="3/ 4" Display="'3/ 4'" Dmx="35~39" WheelPosition="3" Colour="0,0,0" />
      <Function ID="14" Name="4/ 5" Display="'4/ 5'" Dmx="45~49" WheelPosition="4" Colour="0,0,0" />
      <Function ID="15" Name="5/ 6" Display="'5/ 6'" Dmx="55~59" WheelPosition="5" Colour="0,0,0" />
      <Function ID="16" Name="6/ 7" Display="'6/ 7'" Dmx="65~69" WheelPosition="6" Colour="0,0,0" />

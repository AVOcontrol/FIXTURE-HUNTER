  <AtlaBase TypeID="8c814894-2b03-49d7-85da-bead0554b957" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Main_Shutter" Name="Main Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="10~19" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~121" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="130~245" />
    </Attribute>
    <Attribute ID="Glow_Shutter" Name="Glow Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="10~19" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="20~121" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="130~245" />
    </Attribute>
    <Attribute ID="Glow_Colour" Name="Glow Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White" Display="'White %.fK',2800~5000" Dmx="10~39" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="40~40" Colour="255,0,0" />
      <Function ID="4" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="40~72" Colour="255,0,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="72~72" Colour="255,255,0" />
      <Function ID="6" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="72~104" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="104~104" Colour="0,255,0" />
      <Function ID="8" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="104~141" Colour="0,255,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="141~141" Colour="0,255,255" />
      <Function ID="10" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="141~173" Colour="0,255,255" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="173~173" Colour="0,0,255" />
      <Function ID="12" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="173~205" Colour="0,0,255" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="205~205" Colour="255,0,255" />
      <Function ID="14" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="205~237" Colour="255,0,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="40~237" Colour="255,255,255" />
      <Function ID="16" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="238~254" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Macro_Dimmer" Name="Macro Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Macro Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Flicker Mode 1" Display="'Flicker Mode 1'" Dmx="31~40" />
      <Function ID="3" Name="Flicker Mode 2" Display="'Flicker Mode 2'" Dmx="41~50" />
      <Function ID="4" Name="Flicker Mode 3" Display="'Flicker Mode 3'" Dmx="51~60" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="61~70" />
      <Function ID="6" Name="Dim Logarithmic" Display="'Dim Logarithmic'" Dmx="71~80" />
      <Function ID="7" Name="Default" Display="'Default'" Dmx="246~255" />
    </Attribute>
  </Control>

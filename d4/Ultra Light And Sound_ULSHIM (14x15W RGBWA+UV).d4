  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="05-07-18" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="User Chase 1" Display="'User Chase 1'" Dmx="6~15" />
      <Function ID="3" Name="User Chase 2" Display="'User Chase 2'" Dmx="16~25" />
      <Function ID="4" Name="User Chase 3" Display="'User Chase 3'" Dmx="26~35" />
      <Function ID="5" Name="User Chase 4" Display="'User Chase 4'" Dmx="36~45" />
      <Function ID="6" Name="User Chase 5" Display="'User Chase 5'" Dmx="46~55" />
      <Function ID="7" Name="User Chase 6" Display="'User Chase 6'" Dmx="56~65" />
      <Function ID="8" Name="User Chase 7" Display="'User Chase 7'" Dmx="66~75" />
      <Function ID="9" Name="User Chase 8" Display="'User Chase 8'" Dmx="76~85" />
      <Function ID="10" Name="User Chase 9" Display="'User Chase 9'" Dmx="86~95" />
      <Function ID="11" Name="User Chase 10" Display="'User Chase 10'" Dmx="96~105" />
      <Function ID="12" Name="User Chase 11" Display="'User Chase 11'" Dmx="106~115" />
      <Function ID="13" Name="User Chase 12" Display="'User Chase 12'" Dmx="116~125" />
      <Function ID="14" Name="User Chase 13" Display="'User Chase 13'" Dmx="126~135" />
      <Function ID="15" Name="Simple Chase 1" Display="'Simple Chase 1'" Dmx="136~145" />
      <Function ID="16" Name="Simple Chase 2" Display="'Simple Chase 2'" Dmx="146~155" />
      <Function ID="17" Name="Simple Chase 3" Display="'Simple Chase 3'" Dmx="156~165" />
      <Function ID="18" Name="Simple Chase 4" Display="'Simple Chase 4'" Dmx="166~175" />
      <Function ID="19" Name="Simple Chase 5" Display="'Simple Chase 5'" Dmx="176~185" />
      <Function ID="20" Name="Simple Chase 6" Display="'Simple Chase 6'" Dmx="186~195" />
      <Function ID="21" Name="Simple Chase 7" Display="'Simple Chase 7'" Dmx="196~205" />
      <Function ID="22" Name="Simple Chase 8" Display="'Simple Chase 8'" Dmx="206~215" />
      <Function ID="23" Name="Cycle Simple" Display="'Cycle Simple'" Dmx="216~225" />
      <Function ID="24" Name="Yellow Fade" Display="'Yellow Fade'" Dmx="226~235" />
      <Function ID="25" Name="Colour Scroll" Display="'Colour Scroll'" Dmx="236~245" />
      <Function ID="26" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

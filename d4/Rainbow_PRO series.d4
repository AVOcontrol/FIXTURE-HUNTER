  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="16-02-17" Author="Nic Morris" Comment="Created" />
  <History Date="17-02-17" Author="Nic Morris" Comment="Adjusted pending dimmer mode attribute order for compatibility" />
  <History Date="25-10-17" Author="Nic Morris" Comment="Recreated using Rainbow PRO2 series as a base." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Spd" Name="Col Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan_Spd" Name="Fan Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 0, Part 1 (address as device)" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

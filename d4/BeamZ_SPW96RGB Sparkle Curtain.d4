      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="7 Colour Control" Display="'7 Colour Control %.1f%%',0.0~100.0" Dmx="0~150" />
      <Function ID="2" Name="Colourful Strobe" Display="'Colourful Strobe'" Dmx="151~171" />
      <Function ID="3" Name="Colourful Jumping" Display="'Colourful Jumping'" Dmx="172~182" />
      <Function ID="4" Name="Colourful Gradient" Display="'Colourful Gradient'" Dmx="183~213" />
      <Function ID="5" Name="Effect 1" Display="'Effect 1'" Dmx="214~234" />
      <Function ID="6" Name="Effect 2" Display="'Effect 2'" Dmx="235~255" />
    </Attribute>
  </Control>

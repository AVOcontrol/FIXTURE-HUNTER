      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~201" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

      <Function ID="15" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="70~74" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="75~79" WheelPosition="1" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8a5b00f7-7b80-4c1e-aa4c-4414ac41185d" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lighting" Display="'Lighting'" Dmx="0~0" />
      <Function ID="2" Name="Effects" Display="'Effects'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Paparazzi" Display="'Paparazzi'" Dmx="0~0" Update="Effect_Param" />
      <Function ID="2" Name="Fireworks" Display="'Fireworks'" Dmx="20~39" Update="Effect_Param" />
      <Function ID="3" Name="Faulty Bulb" Display="'Faulty Bulb'" Dmx="40~59" Update="Effect_Param" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="60~79" Update="Effect_Param" />
      <Function ID="5" Name="TV" Display="'TV'" Dmx="80~99" Update="Effect_Param" />
      <Function ID="6" Name="Pulsing" Display="'Pulsing'" Dmx="100~119" Update="Effect_Param" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="120~139" Update="Effect_Param" />
      <Function ID="8" Name="Explosion" Display="'Explosion'" Dmx="140~159" Update="Effect_Param" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="2" Name="2" Display="'2'" Dmx="20~39" />
      <Function ID="3" Name="3" Display="'3'" Dmx="40~59" />
      <Function ID="4" Name="4" Display="'4'" Dmx="60~79" />
      <Function ID="5" Name="5" Display="'5'" Dmx="80~99" />
      <Function ID="6" Name="6" Display="'6'" Dmx="100~119" />
      <Function ID="7" Name="7" Display="'7'" Dmx="120~139" />
      <Function ID="8" Name="8" Display="'8'" Dmx="140~159" />
      <Function ID="9" Name="9" Display="'9'" Dmx="160~179" />
      <Function ID="10" Name="10" Display="'10'" Dmx="180~199" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="200~219" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param" Name="Effect Param" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Lightning" ID="2,3,4" If="'Effect'==4" />
      <Condition Name="Explosion" ID="5,6" If="'Effect'==8" />
      <Else ID="1" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="Trigger" Display="'Trigger'" Dmx="11~127" />
      <Function ID="4" Name="Loop" Display="'Loop'" Dmx="128~255" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="6" Name="Trigger" Display="'Trigger'" Dmx="11~127" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 (Lighting 8-bit), 1 DMX" Channels="1">

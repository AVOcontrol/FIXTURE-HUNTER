<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="4xPAR-36 QCL Audience Blinder" ShortName="P36 Blind" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="25-07-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="03a77be4-58a9-4dfe-adeb-3b2e8a74c95c" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="All Cells" Display="'All Cells'" Dmx="6~10" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="Individual Cells" Display="'Individual Cells'" Dmx="11~15" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="R" Display="'R'" Dmx="16~20" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="G" Display="'G'" Dmx="21~25" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="B" Display="'B'" Dmx="26~30" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="W" Display="'W'" Dmx="31~35" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="RB" Display="'RB'" Dmx="36~40" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="RG" Display="'RG'" Dmx="41~45" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="RB" Display="'RB'" Dmx="46~50" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="GB" Display="'GB'" Dmx="51~55" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="WB" Display="'WB'" Dmx="56~60" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="WG" Display="'WG'" Dmx="61~65" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="RGB" Display="'RGB'" Dmx="66~70" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="RGW" Display="'RGW'" Dmx="71~75" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="RBW" Display="'RBW'" Dmx="76~80" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="GBW" Display="'GBW'" Dmx="81~85" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="RGBW" Display="'RGBW'" Dmx="86~90" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Col Jump" Display="'Col Jump'" Dmx="91~100" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Col Fade" Display="'Col Fade'" Dmx="101~110" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Dreaming" Display="'Dreaming'" Dmx="111~120" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Col Flow" Display="'Col Flow'" Dmx="121~130" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Overlap" Display="'Overlap'" Dmx="131~140" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Col Chase" Display="'Col Chase'" Dmx="141~150" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Multi Col" Display="'Multi Col'" Dmx="151~160" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Fade Flow" Display="'Fade Flow'" Dmx="161~170" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="2 Flow" Display="'2 Flow'" Dmx="171~180" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="1 Direction" Display="'1 Direction'" Dmx="181~190" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="2 Directions" Display="'2 Directions'" Dmx="191~200" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="2 Col Flow" Display="'2 Col Flow'" Dmx="201~210" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
      <Function ID="31" Name="Sound" Display="'Sound'" Dmx="211~255" Update="Red, Green, Master_Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2" If="'Colour_Macro'&gt;26&amp;&amp;'Colour_Macro'&lt;31" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Select" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;18&amp;&amp;'Colour_Macro'&lt;31" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==31" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="EX4XP364" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5bd0a785-c3c4-42d5-83d8-812b8a0060a8" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="EX4XP366" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="113e88d0-7f33-46e2-b932-a2d13224302e" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="White" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter1" ChannelOffset="6" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="19 DMX" Channels="19">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e01aff7f-2bfe-4207-be48-77ff51d0c0f3" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="8" />
        <Attribute ID="Master_Dimmer" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="7" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="4" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Cell" X="1" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="12" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="16" ModeLink="Cell" X="1" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
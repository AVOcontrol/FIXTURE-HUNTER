    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Colour_Macro:18" Delay="6000" />
      <Set Channel="Colour_Macro:1" Delay="0" />
    </Macro>
  </Macro>

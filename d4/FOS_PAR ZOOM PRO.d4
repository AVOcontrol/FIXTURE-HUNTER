  <AtlaBase TypeID="e0e276e8-4b71-49dc-aab1-df26b0a1948b" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="6~85" Colour="255,255,255" />
      <Function ID="3" Name="All Full" Display="'RGB Full'" Dmx="86~95" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="96~100" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="101~105" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="106~110" Colour="255,255,255" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="111~115" Colour="255,255,255" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="116~120" Colour="255,255,255" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="121~125" Colour="255,255,255" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="126~130" Colour="255,255,255" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="131~135" Colour="255,255,255" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="136~140" Colour="255,255,255" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="141~145" Colour="255,255,255" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="146~150" Colour="255,255,255" />
      <Function ID="15" Name="Auto 1" Display="'Auto 1'" Dmx="151~180" Colour="0,0,0" />
      <Function ID="16" Name="Auto 2" Display="'Auto 2'" Dmx="181~210" Colour="0,0,0" />
      <Function ID="17" Name="Auto 3" Display="'Auto 3'" Dmx="210~240" Colour="0,0,0" />
      <Function ID="18" Name="Reset" Display="'Reset'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="800W IP 4Eye Ring Blinder" ShortName="IP4EyeRing" Company="BSM" Version="0">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="12-05-26" Author="Nic Morris" Comment="Created (hopeless documentation.  vague.  very confusing.  made best guess)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Main_Shutter" Name="Main Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Main_FX" Name="Main FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Main_FX_Spd" />
      <Function ID="2" Name="Static Col Mix" Display="'Static Col Mix'" Dmx="10~50" Update="Main_FX_Spd" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="51~100" Update="Main_FX_Spd" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="101~150" Update="Main_FX_Spd" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="151~200" Update="Main_FX_Spd" />
      <Function ID="6" Name="All Auto" Display="'All Auto'" Dmx="201~255" Update="Main_FX_Spd" />
    </Attribute>
    <Attribute ID="Main_FX_Spd" Name="Main FX Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Static Col Mix" ID="2,3,4" If="'Main_FX'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Mixed Cols 1" Display="'Mixed Cols 1 %.1f%%',0.0~100.0" Dmx="0~0" />
      <Function ID="3" Name="Mixed Cols 2" Display="'Mixed Cols 2 %.1f%%',0.0~100.0" Dmx="85~169" />
      <Function ID="4" Name="Mixed Cols 3" Display="'Mixed Cols 3 %.1f%%',0.0~100.0" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Ring_Shutter" Name="Ring Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Ring_Colour" Name="Ring Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~41" Colour="0,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="42~83" Colour="0,0,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="84~125" Colour="0,0,0" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="126~167" Colour="0,0,0" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="168~209" Colour="0,0,0" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="210~251" Colour="0,0,0" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="252~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ring_FX" Name="Ring FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="11~16" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="17~22" />

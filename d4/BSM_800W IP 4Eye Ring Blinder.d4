      <Function ID="23" Name="Effect 22" Display="'Effect 22'" Dmx="137~142" />
      <Function ID="24" Name="Effect 23" Display="'Effect 23'" Dmx="143~148" />
      <Function ID="25" Name="Effect 24" Display="'Effect 24'" Dmx="149~154" />
      <Function ID="26" Name="Effect 25" Display="'Effect 25'" Dmx="155~160" />
      <Function ID="27" Name="Effect 26" Display="'Effect 26'" Dmx="161~166" />
      <Function ID="28" Name="Effect 27" Display="'Effect 27'" Dmx="167~172" />
      <Function ID="29" Name="Effect 28" Display="'Effect 28'" Dmx="173~178" />
      <Function ID="30" Name="Effect 29" Display="'Effect 29'" Dmx="179~184" />

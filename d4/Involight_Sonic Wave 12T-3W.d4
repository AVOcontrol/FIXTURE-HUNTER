<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Sonic Wave 12T-3W" ShortName="Sonic Wave" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-03-15" Author="Nic Morris" Comment="Created" />
  <History Date="13-01-17" Author="Nic Morris" Comment="Added Atlabase ID's (used Involight SONICWAVE1231 - looks identical)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3a5d98c6-1733-40ae-a960-e3c7357a7683" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="7~13" Update="Auto_Spd" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="14~20" Update="Auto_Spd" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="21~27" Update="Auto_Spd" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="28~34" Update="Auto_Spd" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="35~41" Update="Auto_Spd" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="42~48" Update="Auto_Spd" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="49~55" Update="Auto_Spd" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="56~62" Update="Auto_Spd" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="63~69" Update="Auto_Spd" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="70~76" Update="Auto_Spd" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="77~83" Update="Auto_Spd" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="84~90" Update="Auto_Spd" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="91~97" Update="Auto_Spd" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="98~104" Update="Auto_Spd" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="105~111" Update="Auto_Spd" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="112~118" Update="Auto_Spd" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="119~125" Update="Auto_Spd" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="126~132" Update="Auto_Spd" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="133~139" Update="Auto_Spd" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="140~146" Update="Auto_Spd" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="147~153" Update="Auto_Spd" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="154~160" Update="Auto_Spd" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="161~167" Update="Auto_Spd" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="168~174" Update="Auto_Spd" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="175~181" Update="Auto_Spd" />
      <Function ID="27" Name="Macro 26" Display="'Macro 26'" Dmx="182~188" Update="Auto_Spd" />
      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="189~195" Update="Auto_Spd" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="196~202" Update="Auto_Spd" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="203~209" Update="Auto_Spd" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="210~216" Update="Auto_Spd" />
      <Function ID="32" Name="Macro 31" Display="'Macro 31'" Dmx="217~223" Update="Auto_Spd" />
      <Function ID="33" Name="Macro 32" Display="'Macro 32'" Dmx="224~230" Update="Auto_Spd" />
      <Function ID="34" Name="Macro 33" Display="'Macro 33'" Dmx="231~237" Update="Auto_Spd" />
      <Function ID="35" Name="Macro 34" Display="'Macro 34'" Dmx="238~244" Update="Auto_Spd" />
      <Function ID="36" Name="Macro 35" Display="'Macro 35'" Dmx="245~251" Update="Auto_Spd" />
      <Function ID="37" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==37" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="16~84" Intensity="0~0" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="85~169" Intensity="0~0" />
      <Function ID="4" Name="Strobe 3" Display="'Strobe 3 %.f%%',0~100" Dmx="170~255" Intensity="0~0" />
    </Attribute>
  </Control>

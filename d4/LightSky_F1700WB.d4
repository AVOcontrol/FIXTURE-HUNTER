    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="2" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Condition Name="Random" ID="15,16" If="'Colour1Func'==4" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue" Display="'Blue'" Dmx="100~109" Colour="0,0,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="110~119" Colour="0,255,0" />
      <Function ID="4" Name="1/2 Minus Green" Display="'1/2 Minus Green'" Dmx="120~129" Colour="255,200,200" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="130~139" Colour="255,128,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="140~149" Colour="255,0,255" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="150~159" Colour="230,230,255" />
      <Function ID="8" Name="Congo" Display="'Congo'" Dmx="160~169" Colour="128,0,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="170~179" Colour="255,0,0" />
      <Function ID="10" Name="Index" Display="'%.f%%',0~100" Dmx="0~89" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="214~180" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="249~215" Colour="0,0,0" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="16" Name="Random" Display="'Random'" Dmx="250~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

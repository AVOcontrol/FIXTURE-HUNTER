      <Function ID="9" Name="Lamp Off" Display="'Lamp Off'" Dmx="45~49" />
      <Function ID="10" Name="Always" Display="'Always'" Dmx="50~54" />
      <Function ID="11" Name="Auto (30s)" Display="'Auto (30s)'" Dmx="55~59" />
      <Function ID="12" Name="Power Mode 1200W" Display="'Power Mode 1200W'" Dmx="60~64" />
      <Function ID="13" Name="Power Mode 1400W" Display="'Power Mode 1400W'" Dmx="65~69" />
      <Function ID="14" Name="Power Mode 1700W" Display="'Power Mode 1700W'" Dmx="70~74" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">

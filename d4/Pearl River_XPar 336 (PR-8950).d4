  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="baaf01d6-dd5c-4a8c-9217-d2055e026d53" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="1~15" Colour="255,240,200" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="16~31" Colour="230,230,255" />
      <Function ID="4" Name="7200K" Display="'7200K'" Dmx="32~47" Colour="240,241,255" />
      <Function ID="5" Name="10000K" Display="'10000K'" Dmx="48~63" Colour="204,219,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="64~79" Colour="255,0,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="80~95" Colour="0,255,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="96~111" Colour="0,0,255" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="112~127" Colour="128,0,255" />
      <Function ID="10" Name="Blue/White" Display="'Blue/White'" Dmx="128~143" Colour="0,0,255" />
      <Function ID="11" Name="Red/White" Display="'Red/White'" Dmx="144~159" Colour="255,0,0" />
      <Function ID="12" Name="Green/White" Display="'Green/White'" Dmx="160~175" Colour="0,255,0" />
      <Function ID="13" Name="White" Display="'White'" Dmx="176~191" Colour="255,255,255" />
      <Function ID="14" Name="Yellow/White" Display="'Yellow/White'" Dmx="192~207" Colour="255,255,0" />
      <Function ID="15" Name="Purple/White" Display="'Purple/White'" Dmx="208~223" Colour="128,0,255" />
      <Function ID="16" Name="Effect 1" Display="'Effect 1'" Dmx="224~239" Colour="0,0,0" />
      <Function ID="17" Name="Effect 2" Display="'Effect 2'" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f440ef53-c4d8-4ce2-a8f7-942829e7527f" />
  <Control>
    <Attribute ID="Water_Col" Name="Water Col" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="25~255" />
    </Attribute>
    <Attribute ID="White_LED" Name="White LED" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Fireball_Col" Name="Fireball Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~44" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="45~79" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="80~114" Colour="0,0,255" />
      <Function ID="5" Name="Red+Green" Display="'Red+Green'" Dmx="115~149" Colour="255,255,255" />
      <Function ID="6" Name="Green+Blue" Display="'Green+Blue'" Dmx="150~184" Colour="255,255,255" />
      <Function ID="7" Name="Red+Blue" Display="'Red+Blue'" Dmx="185~219" Colour="255,255,255" />
      <Function ID="8" Name="Red+Green+Blue" Display="'Red+Green+Blue'" Dmx="220~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Col" Name="Laser Col" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~99" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="100~199" />
      <Function ID="4" Name="Red+Green" Display="'Red+Green'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="xUV" Name="UV" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Effects On" Display="'All Effects On'" Dmx="0~0" />
      <Function ID="2" Name="Combination" Display="'Combination %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Water_Motor" Name="Water Motor" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" />
    </Attribute>
    <Attribute ID="Fireball_Motor" Name="Fireball Motor" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~10" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Laser_Motor" Name="Laser Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~127" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="51~150" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="151~200" />
      <Function ID="4" Name="Sound 1" Display="'Sound 1'" Dmx="201~250" />
      <Function ID="5" Name="Sound 2" Display="'Sound 2'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="57e4a8fb-1e76-40ba-a63a-132f0a143d50" />
    <Include>
      <Attribute ID="Water_Col" ChannelOffset="1" Wheel="22" />
      <Attribute ID="White_LED" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Fireball_Col" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Laser_Col" ChannelOffset="4" Wheel="13" />
      <Attribute ID="xUV" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Effect" ChannelOffset="6" Wheel="24" />
      <Attribute ID="Strobe" ChannelOffset="7" Wheel="6" />
      <Attribute ID="Water_Motor" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Fireball_Motor" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Laser_Motor" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Auto" ChannelOffset="11" Wheel="52" />
    </Include>
  </Mode>

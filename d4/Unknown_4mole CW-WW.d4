      <Function ID="18" Name="Jump 7" Display="'Jump 7'" Dmx="203~214" />
      <Function ID="19" Name="Jump 8" Display="'Jump 8'" Dmx="215~226" />
      <Function ID="20" Name="Jump 1-8 Cycle" Display="'Jump 1-8 Cycle'" Dmx="227~238" />
      <Function ID="21" Name="Pulse" Display="'Pulse'" Dmx="239~250" />
      <Function ID="22" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">

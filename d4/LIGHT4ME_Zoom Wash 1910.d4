      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="6~10" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="11~20" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="21~30" />

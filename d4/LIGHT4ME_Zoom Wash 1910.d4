<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Zoom Wash 1910" ShortName="Zm Ws 1910" Company="LIGHT4ME">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="08-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="09-04-16" Author="Nic Morris" Comment="Renamed cells as 'Beam' and 'Aura'" />
  <History Date="13-05-16" Author="Nic Morris" Comment="Fixed auto function names" />
  <History Date="09-07-16" Author="Nic Morris" Comment="Created from Showtec Phantom 120 Wash" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Full" ID="1" If="'Pan_Spin'&gt;1||'Pan_Spin'&lt;3" />
      <Else ID="2,3,4" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Pan" Display="'Pan %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~49087" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49344~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Full" ID="1" If="'Tilt_Spin'&gt;1||'Tilt_Spin'&lt;3" />
      <Else ID="2,3,4" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Tilt" Display="'Tilt %.2f%%',0.00~100.00" Dmx="0~32639" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32896~49087" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49344~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Pan" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="16~135" Update="Pan" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="136~255" Update="Pan" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Tilt" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="16~135" Update="Tilt" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="136~255" Update="Tilt" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mercury" ShortName="Mercury" Company="X-Laser">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="07-11-17" Author="Nic Morris" Comment="Created (confusing documentation with errors and missing most of the function ranges, defaults and detail)." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Revised PrismSpacing function ranges and defaults.  Revised wave parameter display ranges." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Changed Geo and Wave attribute groups to match wheel slots." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Revised Waves with discreet functions and added conditionals." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Revised modes with standard and advanced builder options in response to manufacturer information." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Added ESTA manufacturer ID.  Linked Col FX P7-12 to cells in attempt to add (RGB) colour picker functionality." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Revised Col FX and Wave DMX ranges in line with latest charts." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Changed prism spacing controls to a single range with default at zero." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Renamed Width function in Col FX P6 to Fade Width." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Revised geometric control functions.  Inverted master scale ranges." />
  <History Date="10-11-17" Author="Nic Morris" Comment="Updated effect control functions in line with latest charts." />
  <History Date="13-11-17" Author="Nic Morris" Comment="Changed Col FX P7-P12 and RGB to just RGB functions in line with latest implementation." />
  <History Date="13-11-17" Author="Nic Morris" Comment="Revised Geo position functions to just center (zero, default) and a single variable range in response to manufacturer request." />
  <History Date="13-11-17" Author="Nic Morris" Comment="Corrected Col FX ranges (mid 1, mid 2, mid 3 and post were all out by +1)" />
  <History Date="15-11-17" Author="Nic Morris" Comment="Changed all Geo Position attributes to a single function range running DMX 1-255 display 0-100%, default 50% (128) in response to manufacturer request." />
  <History Date="15-11-17" Author="Nic Morris" Comment="Renamed Col FX Param 7-9 and 10-12 RGB 1 and RGB 2 respectively and reassigned wheel slots so they appear before Col FX." />
  <History Date="15-11-17" Author="Nic Morris" Comment="Revised Geo Position attribute ID's to work with positional shapes." />
  <History Date="15-11-17" Author="Nic Morris" Comment="Changed all scale attributes to a single 255 -&gt; 0 function display -100 -&gt; 100%, default 100% (0)" />
  <History Date="15-11-17" Author="Nic Morris" Comment="Added alternative celled mode options." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Removed mode options and settled on final following manufacturer testing." />
  <History Date="10-12-17" Author="Nic Morris" Comment="Changed geo position controls to 16bit + added scan rate and reserved channels in line with latest charts in response to manufacturer request." />
  <History Date="30-01-18" Author="Nic Morris" Comment="Corrected Prism Spacing Y function name (previously was Prism Spacing X)" />
  <History Date="30-01-18" Author="Nic Morris" Comment="Added Basic Builder mode.  Added Center X and Center Y parameters to Angular Bands Col FX." />
  <History Date="30-01-18" Author="Nic Morris" Comment="Changed Pattern attribute ID to 'Gobo1' for shape gen compatibility in response to manufacturer request." />
  <History Date="30-01-18" Author="Nic Morris" Comment="Consolidated X and Y scale attributes as they are now identical and changed X Scale attribute ID to Zoom for shape gen compatibility." />
  <History Date="30-01-18" Author="Nic Morris" Comment="Changed Z Rotate attribute ID to 'Gobo1Rot' for shape gen compatibility." />
  <History Date="17-05-18" Author="Nic Morris" Comment="Removed Builder (Standard), 60 DMX mode in response to manufacturer request." />
  <History Date="22-05-18" Author="Nic Morris" Comment="Changed X and Y Offset to a single range display -100 -&gt; 100 default 128 in response to manufacturer request." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Added discreet Builder (Basic) Col FX and Motion functions in line with latest documentation in response to manufacturer request." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Set Builder Basic mode Col FX to default at 1 in response to manufacturer request." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Added RGB highlight/lowlight in response to manufacturer request." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Added 2x3, 3x2 and 2x2+1 PrismMode functions in line with latest documentation." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Revised post wave radial function ranges in line with latest documetation.  Revised wave and effect P5 funtions." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Revised Builder (Advanced) mode Mid 1 Col FX ranges in line with latest documentation." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Note latest charts appear to be missing 'Mid 2' color functions and have nothing above 173.  Left as before for now." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Corrected Effect Func Post typo (was Pose!).  Swapped Keystone BL and BR channel assignments." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Renamed Pattern Page to Page to avoid regex conflict.  Added discreet page functions." />
  <History Date="24-07-19" Author="Nic Morris" Comment="Added pattern conditions and discreet functions with page and pattern number prefix for regex." />
  <History Date="06-12-19" Author="Nic Morris" Comment="Added Pieterjan Ruysch pattern functions and merged reduced size pattern swatches into Olies changes." />
  <History Date="07-12-19" Author="Nic Morris" Comment="Removed virtual RGB controls and associated dependencies from Builder (Flat) mode - at the moment only ID Dimmer can be used as a virtual controller and even if it worked it probably would be proportional which might be confusing." />
  <History Date="07-12-19" Author="Nic Morris" Comment="Unhid Basic flat mode and renamed for improved clarity." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="22604" />
  </RDM>
  <Control>
    <Attribute ID="Master_Mode" Name="Master Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixture Disabled" Display="'Fixture Disabled'" Dmx="0~0" />
      <Function ID="2" Name="External Input" Display="'External Input'" Dmx="4~7" />
      <Function ID="3" Name="Builders Enabled" Display="'Builders Enabled'" Dmx="12~15" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="X Scale" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Scale" Display="'%.1f%%',-100.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Y_Scale" Name="Y Scale" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Scale" Display="'%.1f%%',-100.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="X_Offset" Name="X Offset" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.1f%%',-100.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Y_Offset" Name="Y Offset" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.1f%%',-100.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Mode_Control" Name="Mode Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Folder" Name="Page" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />

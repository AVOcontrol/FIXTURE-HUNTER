<Fixture Name="Panning LED Strip" ShortName="Pan Strip" Company="LED Arts" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>6196228d-7442-475f-926e-d13b3b548f0e</Thumbnail>
  <History Date="22-04-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="24-04-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eceef4f2-60c5-458d-82f5-d083f0d63710" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~151" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="152~175" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="176~199" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1 (Rainbow Slow - 5s Stand)" Display="'Macro 1 (Rainbow Slow - 5s Stand)'" Dmx="8~15" />
      <Function ID="3" Name="Macro 2 (Rainbow Med - 5s Stand)" Display="'Macro 2 (Rainbow Med - 5s Stand)'" Dmx="16~23" />
      <Function ID="4" Name="Macro 3 (Rainbow Fast - 5s Stand)" Display="'Macro 3 (Rainbow Fast - 5s Stand)'" Dmx="24~31" />
      <Function ID="5" Name="Macro 4 (Rainbow Slow - no Stand)" Display="'Macro 4 (Rainbow Slow - no Stand)'" Dmx="32~39" />
      <Function ID="6" Name="Macro 5 (Rainbow Med - no Stand)" Display="'Macro 5 (Rainbow Med - no Stand)'" Dmx="40~47" />
      <Function ID="7" Name="Macro 6 (Rainbow Fast - no Stand)" Display="'Macro 6 (Rainbow Fast - no Stand)'" Dmx="48~55" />
      <Function ID="8" Name="Macro 7 (Rainbow Very Slot - no Stand)" Display="'Macro 7 (Rainbow Very Slot - no Stand)'" Dmx="56~63" />
      <Function ID="9" Name="Macro 8 (Random Slow)" Display="'Macro 8 (Random Slow)'" Dmx="64~71" />
      <Function ID="10" Name="Macro 9 (Random Med)" Display="'Macro 9 (Random Med)'" Dmx="72~79" />
      <Function ID="11" Name="Macro 10 (Random Fast)" Display="'Macro 10 (Random Fast)'" Dmx="80~87" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

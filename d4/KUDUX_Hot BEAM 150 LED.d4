    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Energy Saving (230W)" Display="'Energy Saving (230W)'" Dmx="20~24" />
      <Function ID="3" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />

    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~87" />
      <Function ID="3" Name="Dim Fast" Display="'Dim Fast'" Dmx="88~90" />
      <Function ID="4" Name="Dim Smooth" Display="'Dim Smooth'" Dmx="91~93" />
      <Function ID="5" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="6" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="7" Name="Program 3" Display="'Program 3'" Dmx="140~159" />

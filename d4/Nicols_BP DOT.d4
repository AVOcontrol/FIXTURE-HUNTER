    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="6~69" />
      <Function ID="4" Name="Linear Burst On" Display="'Linear Burst On %.f%%',0~100" Dmx="70~89" />
      <Function ID="5" Name="Burst" Display="'Burst %.f%%',0~100" Dmx="90~109" />
      <Function ID="6" Name="Random" Display="'Random %.f%%',0~100" Dmx="110~129" />
      <Function ID="7" Name="Rnd Burst" Display="'Rnd Burst %.f%%',0~100" Dmx="130~149" />
      <Function ID="8" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="150~169" />
      <Function ID="9" Name="Op Pulse" Display="'Op Pulse %.f%%',0~100" Dmx="170~189" />
      <Function ID="10" Name="Cl Pulse" Display="'Cl Pulse %.f%%',0~100" Dmx="190~209" />
      <Function ID="11" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="210~229" />
      <Function ID="12" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="230~249" />

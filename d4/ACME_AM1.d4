  <History Date="29-05-19" Author="Nic Morris" Comment="Created" />
  <History Date="01-06-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="06-06-19" Author="Nic Morris" Comment="Changed shutter to control in 9 DMX mode in line with latest charts in response to manufacturer request." />
  <History Date="06-06-19" Author="Nic Morris" Comment="Added default RDM mode ID's." />
  <History Date="12-06-19" Author="Nic Morris" Comment="Inverted zoom and revised reset function ranges in response to manufacturer feedback." />
  <History Date="03-07-19" Author="Nic Morris" Comment="Added RDM ID's.  Changed shutter to control in 7 channel mode in line with latest charts in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="14342" ModelID="8091" />
  </RDM>
  <AtlaBase TypeID="478f66fb-5748-49ec-a42b-ce134550c579" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="70~79" />
      <Function ID="3" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="80~89" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="5" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="170~179" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
  </Control>

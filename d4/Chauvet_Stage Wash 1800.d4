<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Wash 1800" ShortName="StgWs1800" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="28-11-06" Author="D.Milligan" Comment="Created" />
  <History Date="28-11-06" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added missing Atlabase ID's.  Added palettes." />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added v-dim to RGB-Chase Mode" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0a4924cf-2a9b-4cdf-871d-438ba859030f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Mode" Display="'RGB Mode'" Dmx="0~0" />
      <Function ID="2" Name="Macro (Auto)" Display="'Macro (Auto)'" Dmx="30~93" />
      <Function ID="3" Name="Macro (Music)" Display="'Macro (Music)'" Dmx="94~159" />
      <Function ID="4" Name="Chase (Auto)" Display="'Chase (Auto)'" Dmx="160~184" />
      <Function ID="5" Name="Chase (Music)" Display="'Chase (Music)'" Dmx="185~209" />
      <Function ID="6" Name="40 Col Chase (Auto)" Display="'40 Col Chase (Auto)'" Dmx="210~234" />
      <Function ID="7" Name="40 Col Chase (Music)" Display="'40 Col Chase (Music)'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Clear="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~2" Colour="255,0,0" />
      <Function ID="3" Name="R/G" Display="'R/G %.f%%',0~100" Dmx="3~33" Colour="0,0,0" />
      <Function ID="4" Name="R/G Full" Display="'R/G Full'" Dmx="34~34" Colour="0,0,0" />
      <Function ID="5" Name="R/G" Display="'R/G %.f%%',100~0" Dmx="35~65" Colour="0,0,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="66~69" Colour="0,255,0" />
      <Function ID="7" Name="G/B" Display="'G/B %.f%%',0~100" Dmx="70~100" Colour="0,0,0" />
      <Function ID="8" Name="G/B Full" Display="'G/B Full'" Dmx="101~101" Colour="0,0,0" />
      <Function ID="9" Name="G/B" Display="'G/B %.f%%',100~0" Dmx="102~132" Colour="0,0,0" />
      <Function ID="10" Name="Blue" Display="'Blue'" Dmx="133~136" Colour="0,0,255" />
      <Function ID="11" Name="B with R" Display="'B with R %.f%%',0~100" Dmx="137~167" Colour="0,0,0" />
      <Function ID="12" Name="R/B Full" Display="'R/B Full'" Dmx="168~168" Colour="0,0,0" />
      <Function ID="13" Name="R with B" Display="'R with B %.f%%',0~100" Dmx="169~199" Colour="0,0,0" />
      <Function ID="14" Name="R with G/B" Display="'R with G/B %.f%%',0~100" Dmx="200~206" Colour="0,0,0" />
      <Function ID="15" Name="R/B Full G 50%" Display="'R/B Full G 50%'" Dmx="207~207" Colour="0,0,0" />
      <Function ID="16" Name="B with R/G" Display="'B with R/G %.f%%',0~100" Dmx="208~210" Colour="0,0,0" />
      <Function ID="17" Name="G/B Full R 50%" Display="'G/B Full R 50%'" Dmx="211~211" Colour="0,0,0" />
      <Function ID="18" Name="G with R/B" Display="'G with R/B %.f%%',0~100" Dmx="212~228" Colour="0,0,0" />
      <Function ID="19" Name="R/G Full B 50%" Display="'R/G Full B 50%'" Dmx="229~229" Colour="0,0,0" />
      <Function ID="20" Name="R with G/B" Display="'R with G/B %.f%%',0~100" Dmx="230~232" Colour="0,0,0" />
      <Function ID="21" Name="R/B Full G 50%" Display="'R/B Full G 50%'" Dmx="233~233" Colour="0,0,0" />
      <Function ID="22" Name="B with R/G" Display="'B with R/G %.f%%',0~100" Dmx="234~251" Colour="0,0,0" />
      <Function ID="23" Name="B/G with R" Display="'B/G with R %.f%%',0~100" Dmx="252~254" Colour="0,0,0" />
      <Function ID="24" Name="R/G/B Full" Display="'R/G/B Full'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="RGB-D Mode" Channels="4">
    <Import PearlRef="CH_SW180RGB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1825a62a-37e7-4401-9e74-e3bd579df611" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="C-B Mode" Channels="2">
    <Import PearlRef="CH_SW180CB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="61580ceb-b453-4813-a2f8-59e88b09aaef" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="RGB-Chase Mode" Channels="4">
    <Import PearlRef="CH_SW180Chs" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2d033d3e-b3a8-4171-899c-54e2fe52331f" />
    <Include>
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>

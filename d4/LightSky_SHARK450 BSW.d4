    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="6" PowerOn="6" />
      <Condition Name="Index" ID="1" If="'Effect'&gt;1&amp;&amp;'Effect'&lt;9" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Effect'&gt;8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="6" Name="No Function" Display="''" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="20~128" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="129~169" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="170~210" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="255~211" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">

      <Function ID="9" Name="Macro 1 (Spin)" Display="'Macro 1 (Spin)'" Dmx="81~91" Update="Effect_Rot" />
      <Function ID="10" Name="Macro 2 (Spin)" Display="'Macro 2 (Spin)'" Dmx="92~102" Update="Effect_Rot" />
      <Function ID="11" Name="Macro 3 (Spin)" Display="'Macro 3 (Spin)'" Dmx="103~113" Update="Effect_Rot" />
      <Function ID="12" Name="Macro 4 (Spin)" Display="'Macro 4 (Spin)'" Dmx="114~124" Update="Effect_Rot" />
      <Function ID="13" Name="Macro 5 (Spin)" Display="'Macro 5 (Spin)'" Dmx="125~135" Update="Effect_Rot" />
      <Function ID="14" Name="Macro 6 (Spin)" Display="'Macro 6 (Spin)'" Dmx="136~146" Update="Effect_Rot" />

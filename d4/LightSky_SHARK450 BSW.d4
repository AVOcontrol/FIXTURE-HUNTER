    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="AutoFocus_Adj" Name="AutoFocus Adj" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Adjust" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="AutoFocus" Name="AutoFocus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="10m" Display="'10m'" Dmx="16~55" />
      <Function ID="3" Name="15m" Display="'15m'" Dmx="56~95" />
      <Function ID="4" Name="20m" Display="'20m'" Dmx="96~135" />
      <Function ID="5" Name="30m" Display="'30m'" Dmx="136~175" />
      <Function ID="6" Name="40m" Display="'40m'" Dmx="176~215" />
      <Function ID="7" Name="50m" Display="'50m'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~25" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="26~35" />
    </Attribute>
  </Control>

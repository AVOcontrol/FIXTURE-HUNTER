<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="P-10" ShortName="P-10" Company="SGM">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>dc4111c7-9ed7-47e7-8dc8-6eaf001b61d3</Thumbnail>
  <History Date="20-01-18" Author="Nic Morris" Comment="Created" />
  <History Date="20-07-18" Author="Nic Morris" Comment="Updated in line with 'Protocol Rev. 2' charts (firmware v01.03).  Note 21 channel (Studio) mode charts are vague." />
  <History Date="25-07-18" Author="Nic Morris" Comment="Added Atlabase ID's to new modes." />
  <History Date="02-08-19" Author="Nic Morris" Comment="Revised shutter function ranges and duration locate values following testing on real-world fixture." />
  <History Date="02-08-19" Author="Nic Morris" Comment="Removed unused rate control.  " />
  <History Date="07-08-19" Author="Nic Morris" Comment="Changed duration to master dimmer in 27 and 35 channel modes (charts are wrong)." />
  <History Date="07-08-19" Author="Nic Morris" Comment="Inverted strobe and random strobe ranges in shutter control." />
  <History Date="08-08-19" Author="Nic Morris" Comment="Inverted strobe function in rate control." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b1f68739-0799-48ee-9453-61039f4aa895" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Rate" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" />
    </Attribute>

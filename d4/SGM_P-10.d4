    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="CTC RGB" Display="'CTC RGB'" Dmx="0~0" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="2" Name="xy Control (CIE 1931)" Display="'xy Control (CIE 1931)'" Dmx="5~9" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="3" Name="CTC RGBW" Display="'CTC RGBW'" Dmx="10~14" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="4" Name="HSI" Display="'HSI'" Dmx="15~19" Update="Red, Green, Blue" Colour="255,255,255" />
      <Function ID="5" Name="CMY" Display="'CMY'" Dmx="20~24" Update="Red, Green, Blue" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="+/-_Green" Name="+/- Green" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="- Grn" Display="'- Grn %.1f%%',100.0~0.0" Dmx="5~125" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="126~134" Colour="255,255,255" />
      <Function ID="4" Name="+ Grn" Display="'+ Grn %.1f%%',0.0~100.0" Dmx="135~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Frequency" Name="Frequency" Description="" Group="S" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Frequency" Display="'Frequency %.1f Hz',3324.0~21303.0" Dmx="1285~65535" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Halogen" Display="'Halogen'" Dmx="5~9" />
      <Function ID="3" Name="Linear" Display="'Linear'" Dmx="10~14" />
      <Function ID="4" Name="Gamma Corrected" Display="'Gamma Corrected'" Dmx="15~255" />
    </Attribute>
    <Attribute ID="CTO1" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'%.fK',3200~10000" Dmx="5~255" Colour="255,240,200" />
    </Attribute>
  </Control>

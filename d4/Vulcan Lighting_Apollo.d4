  <AtlaBase TypeID="748c5829-fd99-4a68-8bed-c03a93aac010" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="5~49" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="155~199" />
      <Function ID="4" Name="Rnd Pix" Display="'Rnd Pix %.f%%',0~100" Dmx="205~249" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="55~99" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="105~149" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2700~8000" Dmx="10~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro %.1f%%',0.0~100.0" Dmx="1~179" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="180~201" Colour="0,0,0" />
      <Function ID="4" Name="No Scroll" Display="'No Scroll'" Dmx="202~207" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="208~229" Colour="0,0,0" />
      <Function ID="6" Name="No Scroll" Display="'No Scroll'" Dmx="230~234" Colour="0,0,0" />
      <Function ID="7" Name="Rnd Fast" Display="'Rnd Fast'" Dmx="235~239" Colour="0,0,0" />
      <Function ID="8" Name="Rnd Med" Display="'Rnd Med'" Dmx="240~244" Colour="0,0,0" />
      <Function ID="9" Name="Rnd Slow" Display="'Rnd Slow'" Dmx="245~249" Colour="0,0,0" />

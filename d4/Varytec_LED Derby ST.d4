  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Show" Display="'Auto Show'" Dmx="10~50" />
      <Function ID="3" Name="Auto Program" Display="'Auto Program'" Dmx="51~90" />
      <Function ID="4" Name="Strobe Program" Display="'Strobe Program'" Dmx="91~130" />

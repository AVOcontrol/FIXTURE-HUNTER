      <Function ID="18" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="19" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">

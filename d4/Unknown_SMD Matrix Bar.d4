<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SMD Matrix Bar" ShortName="SMD Bar" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="03-10-24" Author="Nic Morris" Comment="Created (very poor documentation)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~250" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="80~102" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="11~33" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="34~56" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="57~79" />
      <Function ID="8" Name="Lightniing" Display="'Lightniing %.f%%',0~100" Dmx="103~127" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Fixed Col" Display="'Fixed Col %.1f%%',0.0~100.0" Dmx="8~127" Colour="0,0,0" />
      <Function ID="3" Name="Col Jump" Display="'Col Jump %.f%%',0~100" Dmx="128~191" Colour="0,0,0" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="10~20" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="21~31" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="32~42" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="43~53" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="54~64" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="65~75" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="76~86" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="87~97" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="98~108" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="109~119" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="120~130" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="131~141" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="142~152" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="153~163" />
      <Function ID="16" Name="Effect 15" Display="'Effect 15'" Dmx="164~174" />
      <Function ID="17" Name="Effect 16" Display="'Effect 16'" Dmx="175~185" />
      <Function ID="18" Name="Effect 17" Display="'Effect 17'" Dmx="186~196" />
      <Function ID="19" Name="Effect 18" Display="'Effect 18'" Dmx="197~207" />
      <Function ID="20" Name="Effect 19" Display="'Effect 19'" Dmx="208~218" />
      <Function ID="21" Name="Effect 20" Display="'Effect 20'" Dmx="219~229" />
      <Function ID="22" Name="Random" Display="'Random'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~249" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Fade" Name="Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.1f%%',0.0~100.0" Dmx="6~127" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Mirror" Name="Mirror" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="FWD" Display="'FWD'" Dmx="0~0" />
      <Function ID="2" Name="REV" Display="'REV'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

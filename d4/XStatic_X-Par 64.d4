      <Function ID="8" Name="Program 26" Display="'Program 26'" Dmx="114~132" />
      <Function ID="9" Name="Program 27" Display="'Program 27'" Dmx="133~151" />
      <Function ID="10" Name="Program 28" Display="'Program 28'" Dmx="152~170" />
      <Function ID="11" Name="Program 29" Display="'Program 29'" Dmx="171~189" />
      <Function ID="12" Name="Sound 1" Display="'Sound 1'" Dmx="190~208" />
      <Function ID="13" Name="Sound 2" Display="'Sound 2'" Dmx="209~227" />
      <Function ID="14" Name="Sound 3" Display="'Sound 3'" Dmx="228~246" />
      <Function ID="15" Name="Sound 4" Display="'Sound 4'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKXSXP64" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Program_1" ChannelOffset="7" Wheel="28" />
      <Attribute ID="Program_2" ChannelOffset="8" Wheel="29" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />

      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="238~251" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Program_2" Name="Program 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Program 20" Display="'Program 20'" Dmx="1~18" />
      <Function ID="3" Name="Program 21" Display="'Program 21'" Dmx="19~37" />
      <Function ID="4" Name="Program 22" Display="'Program 22'" Dmx="38~56" />
      <Function ID="5" Name="Program 23" Display="'Program 23'" Dmx="57~75" />
      <Function ID="6" Name="Program 24" Display="'Program 24'" Dmx="76~94" />

    </Attribute>
    <Attribute ID="Spin_Spd" Name="Spin Spd" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Spin_Direction" Name="Spin Direction" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW'" Dmx="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="100~199" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

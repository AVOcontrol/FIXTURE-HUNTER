  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Laser Off (Built-in Pattern)" Display="'Laser Off (Built-in Pattern)'" Dmx="0~0" Update="Page" />
      <Function ID="2" Name="Manual (Buit-in Pattern)" Display="'Manual (Buit-in Pattern)'" Dmx="32~63" Update="Page" />
      <Function ID="3" Name="Auto (Buit-in Pattern)" Display="'Auto (Buit-in Pattern)'" Dmx="64~95" Update="Page" />
      <Function ID="4" Name="Sound (Buit-in Pattern)" Display="'Sound (Buit-in Pattern)'" Dmx="96~127" Update="Page" />
      <Function ID="5" Name="Manual (SD Card)" Display="'Manual (SD Card)'" Dmx="128~159" Update="Page" />
      <Function ID="6" Name="Folder Play (SD Card)" Display="'Folder Play (SD Card)'" Dmx="160~191" Update="Page" />
      <Function ID="7" Name="Manual Picture Selection (SD Card)" Display="'Manual Picture Selection (SD Card)'" Dmx="192~223" Update="Page" />
      <Function ID="8" Name="Sound (SD Card)" Display="'Sound (SD Card)'" Dmx="224~255" Update="Page" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Page" Name="Page" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Macro" ID="9,10,11,12" If="'Mode'==3||'Mode'==4" />
      <Else ID="1,2,3,4,5,6,7,8" />
      <Function ID="1" Name="Page 1" Display="'Page 1'" Dmx="0~0" />
      <Function ID="2" Name="Page 2" Display="'Page 2'" Dmx="32~63" />
      <Function ID="3" Name="Page 3" Display="'Page 3'" Dmx="64~95" />
      <Function ID="4" Name="Page 4" Display="'Page 4'" Dmx="96~127" />
      <Function ID="5" Name="Page 5" Display="'Page 5'" Dmx="128~159" />
      <Function ID="6" Name="Page 6" Display="'Page 6'" Dmx="160~191" />
      <Function ID="7" Name="Page 7" Display="'Page 7'" Dmx="192~223" />
      <Function ID="8" Name="Page 8" Display="'Page 8'" Dmx="224~255" />
      <Function ID="9" Name="Macro 1" Display="'Macro 1'" Dmx="0~0" />
      <Function ID="10" Name="Macro 2" Display="'Macro 2'" Dmx="64~127" />
      <Function ID="11" Name="Macro 3" Display="'Macro 3'" Dmx="128~191" />
      <Function ID="12" Name="Macro 4" Display="'Macro 4'" Dmx="192~255" />
    </Attribute>

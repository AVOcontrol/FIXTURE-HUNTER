<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Dynamic LED V3" ShortName="Dynamic V3" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~5" Update="Effect_Spd" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="6~11" Update="Effect_Spd" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="12~17" Update="Effect_Spd" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="18~23" Update="Effect_Spd" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="24~29" Update="Effect_Spd" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="30~35" Update="Effect_Spd" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="36~41" Update="Effect_Spd" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="42~47" Update="Effect_Spd" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="48~53" Update="Effect_Spd" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="54~59" Update="Effect_Spd" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="60~65" Update="Effect_Spd" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="66~71" Update="Effect_Spd" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="72~77" Update="Effect_Spd" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="78~83" Update="Effect_Spd" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="84~89" Update="Effect_Spd" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="90~95" Update="Effect_Spd" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="96~101" Update="Effect_Spd" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="102~107" Update="Effect_Spd" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="108~113" Update="Effect_Spd" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="114~119" Update="Effect_Spd" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="120~125" Update="Effect_Spd" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="126~131" Update="Effect_Spd" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="132~137" Update="Effect_Spd" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="138~143" Update="Effect_Spd" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="144~149" Update="Effect_Spd" />
      <Function ID="27" Name="Macro 26" Display="'Macro 26'" Dmx="150~155" Update="Effect_Spd" />
      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="156~161" Update="Effect_Spd" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="162~167" Update="Effect_Spd" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="168~173" Update="Effect_Spd" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="174~179" Update="Effect_Spd" />
      <Function ID="32" Name="Macro 31" Display="'Macro 31'" Dmx="180~185" Update="Effect_Spd" />
      <Function ID="33" Name="Macro 32" Display="'Macro 32'" Dmx="186~191" Update="Effect_Spd" />
      <Function ID="34" Name="Macro 33" Display="'Macro 33'" Dmx="192~197" Update="Effect_Spd" />
      <Function ID="35" Name="Macro 34" Display="'Macro 34'" Dmx="198~203" Update="Effect_Spd" />
      <Function ID="36" Name="Macro 35" Display="'Macro 35'" Dmx="204~209" Update="Effect_Spd" />
      <Function ID="37" Name="Macro 36" Display="'Macro 36'" Dmx="210~215" Update="Effect_Spd" />
      <Function ID="38" Name="Macro 37" Display="'Macro 37'" Dmx="216~221" Update="Effect_Spd" />
      <Function ID="39" Name="Macro 38" Display="'Macro 38'" Dmx="222~227" Update="Effect_Spd" />
      <Function ID="40" Name="Macro 39" Display="'Macro 39'" Dmx="228~233" Update="Effect_Spd" />
      <Function ID="41" Name="Macro 40" Display="'Macro 40'" Dmx="234~239" Update="Effect_Spd" />
      <Function ID="42" Name="Macro 41" Display="'Macro 41'" Dmx="240~245" Update="Effect_Spd" />
      <Function ID="43" Name="Macro 42" Display="'Macro 42'" Dmx="246~251" Update="Effect_Spd" />
      <Function ID="44" Name="Sound" Display="'Sound'" Dmx="252~255" Update="Effect_Spd" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Effect'==44" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter1" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Update="Shutter1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Update="Shutter1" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Update="Shutter1" Colour="0,0,255" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="69~91" Update="Shutter1" Colour="255,128,0" />
      <Function ID="6" Name="White" Display="'White'" Dmx="92~114" Update="Shutter1" Colour="255,255,255" />
      <Function ID="7" Name="A+W" Display="'A+W'" Dmx="115~137" Update="Shutter1" Colour="255,255,255" />
      <Function ID="8" Name="R+G" Display="'R+G'" Dmx="138~160" Update="Shutter1" Colour="255,255,255" />
      <Function ID="9" Name="R+B" Display="'R+B'" Dmx="161~183" Update="Shutter1" Colour="255,255,255" />
      <Function ID="10" Name="G+B" Display="'G+B'" Dmx="184~206" Update="Shutter1" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="207~229" Update="Shutter1" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="230~252" Update="Shutter1" Colour="255,255,255" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="253~255" Update="Shutter1" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Colour_Macro'==13" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SHDYNV33" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Effect" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Effect_Spd" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="SHDYNV32" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter1" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
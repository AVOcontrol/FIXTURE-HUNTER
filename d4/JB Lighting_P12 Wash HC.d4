      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour2Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="8~9" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="12~13" Colour="255,255,255" />
      <Function ID="5" Name="7000K" Display="'7000K'" Dmx="16~17" Colour="255,255,255" />
      <Function ID="6" Name="9000K" Display="'9000K'" Dmx="20~21" Colour="255,255,255" />
      <Function ID="7" Name="12000K" Display="'12000K'" Dmx="24~25" Colour="255,255,255" />
      <Function ID="8" Name="Dark Blue" Display="'Dark Blue'" Dmx="28~29" Colour="0,0,180" />
      <Function ID="9" Name="Dark Red" Display="'Dark Red'" Dmx="32~33" Colour="180,0,0" />
      <Function ID="10" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~223" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Sparkle" Name="Sparkle" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Intensity" Display="'Intensity %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Sparkle_Spd" Name="Sparkle Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="0~31" />
      <Function ID="2" Name="Switch" Display="'Switch %.f%%',0~100" Dmx="32~63" />
      <Function ID="3" Name="Repeat" Display="'Repeat %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Frost_1" Name="Frost 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost 1" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost_2" Name="Frost 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost 2" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Effect_Speed" Name="Effect Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Move_in_Dark" Name="Move in Dark" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="96~127" />
      <Function ID="3" Name="C/CMY/I/FR in Dark" Display="'C/CMY/I/FR in Dark'" Dmx="128~159" />
      <Function ID="4" Name="C/CMY/I/FR/Z/FC in Dark" Display="'C/CMY/I/FR/Z/FC in Dark'" Dmx="160~191" />
      <Function ID="5" Name="C/CMY/I/FR/PT in Dark" Display="'C/CMY/I/FR/PT in Dark'" Dmx="192~223" />
      <Function ID="6" Name="All in Dark" Display="'All in Dark'" Dmx="224~255" />
    </Attribute>
  </Control>

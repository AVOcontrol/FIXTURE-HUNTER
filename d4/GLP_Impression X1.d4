<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Impression X1" ShortName="Imp X1" Company="GLP">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="30-05-15" Author="Nic Morris" Comment="Created" />
  <History Date="18-04-17" Author="Nic Morris" Comment="Removed Extended mode and revised Normal and Compressed mappings in line with latest charts in response to customer bug report." />
  <History Date="18-04-17" Author="Nic Morris" Comment="Revised control functions and added associated macros in line with latest charts.  Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="312bb208-3f17-45df-8e34-72c46b905a1e" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="16~23" Colour="255,100,0" />
      <Function ID="4" Name="Warm Yellow" Display="'Warm Yellow'" Dmx="24~31" Colour="255,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="32~39" Colour="255,255,0" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="40~47" Colour="0,255,0" />
      <Function ID="7" Name="Turquoise" Display="'Turquoise'" Dmx="48~55" Colour="0,255,128" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="56~63" Colour="0,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="64~71" Colour="0,0,255" />
      <Function ID="10" Name="Lavender" Display="'Lavender'" Dmx="72~79" Colour="255,128,255" />
      <Function ID="11" Name="Mauve" Display="'Mauve'" Dmx="80~87" Colour="180,0,180" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="88~95" Colour="255,0,255" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="96~103" Colour="255,150,150" />
      <Function ID="14" Name="White 3200K" Display="'White 3200K'" Dmx="104~111" Colour="255,240,200" />
      <Function ID="15" Name="White 5600K" Display="'White 5600K'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="White 7200K" Display="'White 7200K'" Dmx="120~127" Colour="230,230,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="129~223" Colour="255,255,255" />
      <Function ID="19" Name="Random" Display="'Random %.f%%',0~100" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="200~239" Intensity="0~0" />
      <Function ID="4" Name="Random" Display="'Random %.f%%',0~100" Dmx="144~199" Intensity="0~0" />
      <Function ID="5" Name="Rand Pls" Display="'Rand Pls %.f%%',0~100" Dmx="16~47" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="48~79" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="80~111" Intensity="0~0" />
      <Function ID="8" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="112~143" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'CTO C-Mix %.1f%%',0.0~100.0" Dmx="8~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Pan" Display="'Pan %.f',1~16" Dmx="1~31" />
      <Function ID="3" Name="Tilt" Display="'Tilt %.f',1~16" Dmx="32~63" />
      <Function ID="4" Name="P/T" Display="'P/T %.f',1~16" Dmx="64~95" />
      <Function ID="5" Name="P/T Inv" Display="'P/T Inv %.f',1~16" Dmx="96~127" />
      <Function ID="6" Name="Circle" Display="'Circle %.f',1~16" Dmx="128~159" />
      <Function ID="7" Name="Circ Inv" Display="'Circ Inv %.f',1~16" Dmx="160~191" />
      <Function ID="8" Name="Lying 8" Display="'Lying 8 %.f',1~16" Dmx="192~223" />
      <Function ID="9" Name="Random" Display="'Random %.f',1~16" Dmx="224~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="2~255" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="130~6" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~131" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="130~6" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~131" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Normal" Channels="18">
    <Import PearlRef="GLPIMX1N" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

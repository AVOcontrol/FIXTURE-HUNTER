    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~15" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~23" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="24~31" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="32~39" WheelPosition="4" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="40~47" WheelPosition="5" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="48~55" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="56~63" WheelPosition="7" Colour="0,0,0" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="65~189" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~224" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="221~190" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1,Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1,Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1,Gobo1Rot" />

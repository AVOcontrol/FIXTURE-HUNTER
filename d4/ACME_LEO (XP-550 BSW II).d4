    <Macro Name="Reset P/T">
      <Set Channel="Control:3,Control1:3" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Effect">
      <Set Channel="Control:4,Control1:4" Delay="6000" />
      <Set Channel="Control:1,Control1:1" Delay="0" />
    </Macro>

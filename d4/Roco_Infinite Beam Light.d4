      <Function ID="18" Name="Single Col" Display="'Single Col'" Dmx="170~179" />
      <Function ID="19" Name="Double Col" Display="'Double Col'" Dmx="180~189" />
      <Function ID="20" Name="RGB Flower" Display="'RGB Flower'" Dmx="190~199" />
      <Function ID="21" Name="BGW Flower" Display="'BGW Flower'" Dmx="200~209" />
      <Function ID="22" Name="RBW Flower" Display="'RBW Flower'" Dmx="210~219" />
      <Function ID="23" Name="RB-W Strobe" Display="'RB-W Strobe'" Dmx="220~229" />
      <Function ID="24" Name="B-GW Strobe" Display="'B-GW Strobe'" Dmx="230~239" />
      <Function ID="25" Name="R-BG Strobe" Display="'R-BG Strobe'" Dmx="240~249" />
      <Function ID="26" Name="RW-GW-BW-RGW" Display="'RW-GW-BW-RGW'" Dmx="250~255" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_FX" Name="Beam FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Mini Blue" Display="'Mini Blue'" Dmx="10~19" />
      <Function ID="3" Name="Mini White" Display="'Mini White'" Dmx="20~29" />
      <Function ID="4" Name="Mini Red" Display="'Mini Red'" Dmx="30~39" />
      <Function ID="5" Name="Mini Green" Display="'Mini Green'" Dmx="40~49" />
      <Function ID="6" Name="Mini RW" Display="'Mini RW'" Dmx="50~59" />
      <Function ID="7" Name="Mini GW" Display="'Mini GW'" Dmx="60~69" />
      <Function ID="8" Name="Mini BW" Display="'Mini BW'" Dmx="70~79" />
      <Function ID="9" Name="Mini RB" Display="'Mini RB'" Dmx="80~89" />
      <Function ID="10" Name="Rainbow Up" Display="'Rainbow Up'" Dmx="90~99" />
      <Function ID="11" Name="Rainbow Down" Display="'Rainbow Down'" Dmx="100~109" />
      <Function ID="12" Name="Rainbow Left" Display="'Rainbow Left'" Dmx="110~119" />
      <Function ID="13" Name="Rainbow Right" Display="'Rainbow Right'" Dmx="120~129" />
      <Function ID="14" Name="Medium RB" Display="'Medium RB'" Dmx="130~139" />
      <Function ID="15" Name="Medium RG" Display="'Medium RG'" Dmx="140~149" />
      <Function ID="16" Name="Medium BG" Display="'Medium BG'" Dmx="150~159" />
      <Function ID="17" Name="Medium RGBW" Display="'Medium RGBW'" Dmx="160~169" />
      <Function ID="18" Name="Medium RW" Display="'Medium RW'" Dmx="170~179" />
      <Function ID="19" Name="Medium BG" Display="'Medium BG'" Dmx="180~189" />
      <Function ID="20" Name="Large BRW" Display="'Large BRW'" Dmx="190~199" />
      <Function ID="21" Name="Large BGW" Display="'Large BGW'" Dmx="200~209" />
      <Function ID="22" Name="Large BW" Display="'Large BW'" Dmx="210~219" />
      <Function ID="23" Name="Large RW" Display="'Large RW'" Dmx="220~229" />
      <Function ID="24" Name="Large BG" Display="'Large BG'" Dmx="230~239" />
      <Function ID="25" Name="Large GW" Display="'Large GW'" Dmx="240~249" />
      <Function ID="26" Name="Large RB" Display="'Large RB'" Dmx="250~255" />
      <Function ID="27" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Func" Name="FX Func" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Gobo FX" Display="'Gobo FX'" Dmx="50~99" />
      <Function ID="3" Name="Beam FX" Display="'Beam FX'" Dmx="100~149" />
      <Function ID="4" Name="Colours" Display="'Colours %.f%%',0~100" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="FX_Speed" Name="FX Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Slow" Display="'Slow'" Dmx="50~100" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="101~149" />
      <Function ID="4" Name="Slow/Fast" Display="'Slow/Fast'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="UKRCIBML" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="200" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0d731d65-7634-4414-a66f-46f25ac9f59c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="9" />
      <Attribute ID="Gobo_FX" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Beam_FX" ChannelOffset="14" Wheel="24" />
      <Attribute ID="LED_Rot" ChannelOffset="6" Wheel="19" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="FX_Func" ChannelOffset="15" Wheel="22" />
      <Attribute ID="FX_Speed" ChannelOffset="16" Wheel="52" />
      <Attribute ID="P/T_Macro" ChannelOffset="17" Wheel="53" />
      <Attribute ID="Control" ChannelOffset="18" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

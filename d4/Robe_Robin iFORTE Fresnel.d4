    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Beam_Speed" Name="Beam Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Scrim_Position" Name="Scrim Position" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Insert" Display="'Insert %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Scrim_Index" Name="Scrim Index" Description="" Group="E">
      <Locate Locate="1:180" PowerOn="1:180" />
      <Function ID="1" Name="Index" Display="'Index %.f°',0~360" Dmx="0~255" />
      <Function ID="2" Name="0°" Display="'0°'" Dmx="0~0" />
      <Function ID="3" Name="90°" Display="'90°'" Dmx="64~64" />
      <Function ID="4" Name="180°" Display="'180°'" Dmx="128~128" />
      <Function ID="5" Name="270°" Display="'270°'" Dmx="192~192" />
      <Function ID="6" Name="360°" Display="'360°'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Frost_Func" Name="Frost Func" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Frost" Display="'No Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="2" Name="Light" Display="'Light'" Dmx="0~0" Update="Frost" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="0~0" Update="Frost" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Frost" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Frost" ID="1" If="'Frost_Func'==1" />
      <Condition Name="Light" ID="2,3,4,5,6,7" If="'Frost_Func'==2" />
      <Condition Name="Medium" ID="8,9,10,11,12,13" If="'Frost_Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="''" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="1~53" WheelPosition="1" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="63~54" WheelPosition="2" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="73~64" WheelPosition="3" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',100~0" Dmx="74~83" WheelPosition="4" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="84~86" WheelPosition="5" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="9" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="87~139" WheelPosition="1" />
      <Function ID="10" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="149~140" WheelPosition="2" />
      <Function ID="11" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="159~150" WheelPosition="3" />
      <Function ID="12" Name="Pulse" Display="'Pulse %.f%%',100~0" Dmx="160~169" WheelPosition="4" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="170~255" WheelPosition="5" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Edge_Correct" Name="Edge Correct" Description="" Group="B">

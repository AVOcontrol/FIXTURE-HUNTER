  <History Date="19-02-20" Author="Nic Morris" Comment="Created from Robe Esprite" Version="5" />
  <History Date="14-01-21" Author="Nic Morris" Comment="Added product thumbnail.  Updated in line with v1.3 charts in response to manufacturer request (adds modes 3+4)" Version="6" />
  <History Date="11-02-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="7" />
  <History Date="30-08-21" Author="Nic Morris" Comment="Updated in line with v1.4 charts in response to manufacturer request (adds individual pan and tilt reset control functions and macros)." Version="8" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Updated in line wtih v1.5 charts in response to manufacturer request (adds ultra square dim curve control function and macro)" Version="9" />
  <History Date="19-04-23" Author="Nic Morris" Comment="Created from Robe Robin Esprite Fresnel" Version="11" />
  <History Date="21-09-23" Author="Nic Morris" Comment="Changed name from Robin Forte Fresnel to Robin FORTE Fresnel and added product image for release version." Version="12" />
  <History Date="03-06-24" Author="Nic Morris" Comment="Created from Robe Robin FORTE Fresnel" Version="13" />
  <History Date="09-10-24" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail" Version="14" />

  <History Date="25-03-18" Author="Nic Morris" Comment="Created (very poor documentation.  lots of guesses)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Swing" Name="Tilt Swing" Description="" Group="P">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~21" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="51~100" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Jump 1" Display="'Jump 1'" Dmx="36~45" />
      <Function ID="3" Name="Jump 2" Display="'Jump 2'" Dmx="116~125" />
      <Function ID="4" Name="Sound 1" Display="'Sound 1'" Dmx="126~135" />
      <Function ID="5" Name="Sound 2" Display="'Sound 2'" Dmx="136~145" />
      <Function ID="6" Name="Auto Jump 1" Display="'Auto Jump 1'" Dmx="146~155" />
      <Function ID="7" Name="Auto Jump 2" Display="'Auto Jump 2'" Dmx="226~235" />
      <Function ID="8" Name="Auto Sound 1" Display="'Auto Sound 1'" Dmx="236~245" />
      <Function ID="9" Name="Auto Sound 2" Display="'Auto Sound 2'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">

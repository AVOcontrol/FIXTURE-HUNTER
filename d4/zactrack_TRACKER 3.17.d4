  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Height" Name="Height" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable Height Offset" Display="'Disable Height Offset'" Dmx="0~0" />
      <Function ID="2" Name="Target Height" Display="'%.2fm',-2~2" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Speed_Preset" Name="Speed Preset" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Slow" Display="'Slow'" Dmx="0~0" />
      <Function ID="2" Name="Medium" Display="'Medium'" Dmx="86~170" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Smart_Beam" Name="Smart Beam" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disable Smart Beam" Display="'Disable Smart Beam'" Dmx="0~0" />
      <Function ID="2" Name="Diameter" Display="'Diameter %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Freeze_Filter" Name="Freeze Filter" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Freeze Intensity" Display="'Freeze Intensity %.1f%%',0.0~100.0" Dmx="0~254" />
      <Function ID="2" Name="Freeze Position" Display="'Freeze Position'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Tracker_Mode" Name="Tracker Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="0~0" />
      <Function ID="2" Name="Force 2D (Actice 2D Tracker)" Display="'Force 2D (Actice 2D Tracker)'" Dmx="20~20" />
      <Function ID="3" Name="Dimmer 0%" Display="'Dimmer 0%'" Dmx="175~175" />
      <Function ID="4" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="176~253" />
      <Function ID="5" Name="Inactive Tracker" Display="'Inactive Tracker'" Dmx="254~254" />
      <Function ID="6" Name="Active 3D Tracker" Display="'Active 3D Tracker'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5" Id="33878ef4-2739-41c8-b8c4-5ff93c1aec8f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Height" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Speed_Preset" ChannelOffset="2" Wheel="20" />
      <Attribute ID="Smart_Beam" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Freeze_Filter" ChannelOffset="4" Wheel="49" />
      <Attribute ID="Tracker_Mode" ChannelOffset="5" Wheel="50" />
    </Include>
  </Mode>
</Fixture>
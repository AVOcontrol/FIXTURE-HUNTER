  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BG_Dim" Name="BG Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Static" Name="Static" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Scenes" Display="'Scenes %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Dynamic" Name="Dynamic" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Chases" Display="'Chases %.f',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="127~1" />
      <Function ID="3" Name="Frame" Display="'Frame %.f',1~32" Dmx="128~254" />
      <Function ID="4" Name="Sync" Display="'Sync'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="FG On" Display="'FG On %.f%%',0~100" Dmx="30~1" Intensity="0~0" />
      <Function ID="3" Name="FG Off" Display="'FG Off %.f%%',0~100" Dmx="62~31" Intensity="0~0" />
      <Function ID="4" Name="BG On" Display="'BG On %.f%%',0~100" Dmx="94~63" Intensity="0~0" />
      <Function ID="5" Name="BG Off" Display="'BG Off %.f%%',0~100" Dmx="126~95" Intensity="0~0" />
      <Function ID="6" Name="Rnd FG On" Display="'Rnd FG On %.f%%',0~100" Dmx="158~127" Intensity="0~0" />
      <Function ID="7" Name="Rnd FG Off" Display="'Rnd FG Off %.f%%',0~100" Dmx="191~159" Intensity="0~0" />
      <Function ID="8" Name="Rnd BG On" Display="'Rnd BG On %.f%%',0~100" Dmx="222~192" Intensity="0~0" />
      <Function ID="9" Name="Rnd BG Off" Display="'Rnd BG Off %.f%%',0~100" Dmx="254~223" Intensity="0~0" />
      <Function ID="10" Name="Sync" Display="'Sync'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cross_Fade" Name="Cross Fade" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Intensity="0~0" />

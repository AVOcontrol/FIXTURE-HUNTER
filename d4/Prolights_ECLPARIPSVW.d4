  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',2700.00~6500.00" Dmx="1~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />

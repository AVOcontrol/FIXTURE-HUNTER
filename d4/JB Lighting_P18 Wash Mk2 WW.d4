    <Attribute ID="Sparkle_Spd" Name="Sparkle Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="0~31" />
      <Function ID="2" Name="Switch" Display="'Switch %.f%%',0~100" Dmx="32~63" />
      <Function ID="3" Name="Repeat" Display="'Repeat %.1f%%',0.0~100.0" Dmx="64~255" />
    </Attribute>
    <Attribute ID="Frost_1" Name="Frost 1" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost_2" Name="Frost 2" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Effect_Speed" Name="Effect Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~4" />
      <Function ID="2" Name="Full Spd" Display="'Full Spd'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Move_in_Dark" Name="Move in Dark" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="96~127" />
      <Function ID="3" Name="C/CMY/I/FR in Dark" Display="'C/CMY/I/FR in Dark'" Dmx="128~159" />
      <Function ID="4" Name="C/CMY/I/FR/Z/FC in Dark" Display="'C/CMY/I/FR/Z/FC in Dark'" Dmx="160~191" />

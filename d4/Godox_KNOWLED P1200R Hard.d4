    <Attribute ID="Effect_Type" Name="Effect Type" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="2" Name="Flash" Display="'Flash'" Dmx="10~19" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="3" Name="Lightning" Display="'Lightning'" Dmx="20~29" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="4" Name="Cloudy" Display="'Cloudy'" Dmx="30~39" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="5" Name="Broken Blub" Display="'Broken Blub'" Dmx="40~49" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="6" Name="TV" Display="'TV'" Dmx="50~59" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="7" Name="Candle" Display="'Candle'" Dmx="60~69" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="8" Name="Fire" Display="'Fire'" Dmx="70~79" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="9" Name="Firework" Display="'Firework'" Dmx="80~89" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="10" Name="Explosion" Display="'Explosion'" Dmx="90~99" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="11" Name="Welding" Display="'Welding'" Dmx="100~109" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="12" Name="Police Car" Display="'Police Car'" Dmx="110~119" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="13" Name="SOS" Display="'SOS'" Dmx="120~129" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="14" Name="RGB Cycle" Display="'RGB Cycle'" Dmx="130~139" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="15" Name="Party" Display="'Party'" Dmx="140~149" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Effect" ID="1" If="'Effect_Type'==1" />

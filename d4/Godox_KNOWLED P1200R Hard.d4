      <Condition Name="Explosion" ID="13,14" If="'Effect_Type'==10" />
      <Condition Name="Welding" ID="15,16" If="'Effect_Type'==11" />
      <Condition Name="Police Car" ID="17" If="'Effect_Type'==12" />
      <Condition Name="SOS" ID="18,19" If="'Effect_Type'==13" />
      <Condition Name="RGB Cycle" ID="20" If="'Effect_Type'==14" />
      <Condition Name="Party" ID="21" If="'Effect_Type'==15" />
      <Else ID="22" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Effect_Param_2" />
      <Function ID="2" Name="Type: CCT" Display="'Type: CCT'" Dmx="0~0" Update="Effect_Param_2" />
      <Function ID="3" Name="Type: HSI" Display="'Type: HSI'" Dmx="255~255" Update="Effect_Param_2" />

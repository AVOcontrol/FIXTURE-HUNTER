    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Effect" ID="1" If="'Effect_Type'==1" />
      <Condition Name="Flash" ID="2" If="'Effect_Type'==2" />

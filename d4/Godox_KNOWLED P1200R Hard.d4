      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_2" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Effect" ID="1" If="'Effect_Type'==1" />
      <Condition Name="Flash CCT" ID="2" If="'Effect_Param_1'==2" />

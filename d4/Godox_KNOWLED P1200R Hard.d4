      <Function ID="17" Name="Colour" Display="'%.2f',0.00~7.00" Dmx="0~255" Update="Effect_Param_2" />
      <Function ID="18" Name="Type: CCT" Display="'Type: CCT'" Dmx="0~0" Update="Effect_Param_2" />

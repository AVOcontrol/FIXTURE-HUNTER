      <Function ID="7" Name="Type: HSI" Display="'Type: HSI'" Dmx="255~255" Update="Effect_Param_2" />
      <Function ID="8" Name="Type: CCT" Display="'Type: CCT'" Dmx="0~0" Update="Effect_Param_2" />
      <Function ID="9" Name="Type: HSI" Display="'Type: HSI'" Dmx="255~255" Update="Effect_Param_2" />

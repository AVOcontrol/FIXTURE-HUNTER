<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stagebar Pro 1W" ShortName="StgBrPro1W" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="01-04-08" Author="Gregory Haynes" Comment="Created" />
  <History Date="04-04-08" Author="Ion" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Zoom Manufacturing to Unknown" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-07-10" Author="John Rogers" Comment="Edited Dimmer wheel name to 'Dimmer' from 'Master Dimmer'. Added palettes." />
  <History Date="12-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="30-04-12" Author="Peter Budd" Comment="Edited changed filename from Unknown(Generic) to Unknown" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="20-12-15" Author="Nic Morris" Comment="Changed classic pearl ref to match revised device names" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1" Display="'1'" Dmx="0~30" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2,Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
      <Function ID="2" Name="Mode 2" Display="'2'" Dmx="31~70" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2, Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
      <Function ID="3" Name="Mode 3" Display="'3'" Dmx="71~100" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2, Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
      <Function ID="4" Name="Mode 4" Display="'4'" Dmx="101~130" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2, Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
      <Function ID="5" Name="Mode 5" Display="'5'" Dmx="131~190" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2, Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
      <Function ID="6" Name="Mode 6" Display="'6'" Dmx="191~255" Update="Red, Blue, Green, Dimmer1, Red2, Blue2, Green2, Dimmer2, Red3, Blue3, Green3, Dimmer3, Red4, Blue4, Green4, Dimmer4, Red5, Blue5, Green5, Dimmer5, Red6, Blue6, Green6, Dimmer6, Red7, Blue7, Green7, Dimmer7, Red8, Blue8, Green8, Dimmer8, Program, Speed" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Modes 1 to 4" ID="1" If="'Mode'&lt;5" />
      <Else ID="2" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Program" Display="'Program %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Modes 1 to 4" ID="1" If="'Mode'&lt;5" />
      <Else ID="2" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Modes 1 to 4" ID="1" If="'Mode'&lt;5" />
      <Condition Name="Mode 5" ID="2" If="'Mode'==5" />
      <Else ID="3" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',100.0~0.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Dimmer 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Modes 1 to 4" ID="1" If="'Mode'&lt;5" />
      <Condition Name="Mode 5" ID="2" If="'Mode'==5" />
      <Else ID="3" />
      <Function ID="1" Name="8bit HTP" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Modes 1 to 3" ID="1" If="'Mode'&lt;4" />
      <Condition Name="Modes 4 and 5" ID="2" If="'Mode'==4||'Mode'==5" />
      <Else ID="3" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Func" Display="'No Func'" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Modes 1 to 3" ID="1" If="'Mode'&lt;4" />
      <Else ID="2" />

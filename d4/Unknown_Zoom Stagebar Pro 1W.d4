    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Modes 5 and 6" ID="1" If="'Mode'&gt;4" />
      <Else ID="2" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

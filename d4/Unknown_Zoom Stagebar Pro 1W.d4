  <Mode Name="Mode 1, 34 DMX" Channels="34">
    <Import PearlRef="UKZStgbrPr1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Dimmer1" ChannelOffset="5" Wheel="6" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer2" ChannelOffset="9" Wheel="34" VirtualControl="Dimmer" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Zoom 1200" ShortName="SZoom 1200" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-07-06" Author="Ed" Comment="Checked" />
  <History Date="01-05-07" Author="D.Milligan" Comment="Added Dimmer func wheel" />
  <History Date="11-06-09" Author="David Hunt" Comment="Inverted CMY channels" />
  <History Date="15-06-09" Author="David Hunt" Comment="Fixed CMY and changed Control to CMY" />
  <History Date="23-09-09" Author="Gregory Haynes" Comment="Added Prism Func, added Control functions, added macros and fixed highlight/lowlight" />
  <History Date="10-09-10" Author="Rui Barreiros (audioluz.net)" Comment="Added 19 DMX 16b CMY Mode" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated Raw DMX function to have no range." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="20-04-12" Author="Peter Budd" Comment="Edited added 19 channel RGB mode." />
  <History Date="22-08-12" Author="Peter Budd" Comment="Fixed control range" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-06-17" Author="Nic Morris" Comment="Standardised conditionals.  Revised mode names to reflect settings more clearly." />
  <History Date="14-06-17" Author="Nic Morris" Comment="Revised colour index for full field control.  Standardised highlight/lowlight." />
  <History Date="14-06-17" Author="Nic Morris" Comment="Increased wheel resolution.  Inverted zoom.  Changed display type from value to degrees." />
  <History Date="14-06-17" Author="Nic Morris" Comment="Fixed 16bit raw display range.  Inverted RGB.  Recreated palettes." />
  <Manual Filename="/manual/Clay-Paky_Stage Zoom 1200.pdf" Summary="Creator:mac11-gianluigi, 20-06-2002" />
  <AtlaBase TypeID="81cefd7a-0b05-4df4-b652-d181054f170d" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Warm Filter" Display="'Warm Filter'" Dmx="16~16" WheelPosition="1" Colour="255,245,230" />
      <Function ID="3" Name="Cold Filter" Display="'Cold Filter'" Dmx="32~32" WheelPosition="2" Colour="230,245,255" />
      <Function ID="4" Name="Blue w/Hole" Display="'Blue w/Hole'" Dmx="48~48" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow w/Hole" Display="'Yellow w/Hole'" Dmx="64~64" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="80~80" WheelPosition="5" Colour="255,0,0" />
      <Function ID="7" Name="4 Colour Filter" Display="'4 Colour Filter'" Dmx="96~96" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="UV Filter" Display="'UV Filter'" Dmx="112~112" WheelPosition="7" Colour="128,0,192" />
      <Function ID="9" Name="Op/ CTO" Display="'Op/ CTO'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="CTO/ CTB" Display="'CTO/ CTB'" Dmx="24~24" WheelPosition="1" Colour="255,245,230" />
      <Function ID="11" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="40~49" WheelPosition="2" Colour="230,245,255" />
      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="56~56" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ Rd" Display="'Yel/ Rd'" Dmx="72~72" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Rd/ 4 Col" Display="'Rd/ 4 Col'" Dmx="88~88" WheelPosition="5" Colour="255,0,0" />
      <Function ID="15" Name="4 Col/ UV" Display="'4 Col/ UV'" Dmx="104~104" WheelPosition="6" Colour="0,0,0" />
      <Function ID="16" Name="UV/ Op" Display="'UV/ Op'" Dmx="120~120" WheelPosition="7" Colour="128,0,192" />
      <Function ID="17" Name="Op - CTO" Display="'Op - CTO %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="CTO - CTB" Display="'CTO - CTB %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="255,245,230" />
      <Function ID="19" Name="CTB - Blu" Display="'CTB - Blu %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="230,245,255" />
      <Function ID="20" Name="Blu - Yel" Display="'Blu - Yel %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="0,0,255" />
      <Function ID="21" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="255,255,0" />
      <Function ID="22" Name="Rd - 4 Col" Display="'Rd - 4 Col %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="255,0,0" />
      <Function ID="23" Name="4 Col - UV" Display="'4 Col - UV %.f%%',0~100" Dmx="96~112" WheelPosition="6" Colour="0,0,0" />
      <Function ID="24" Name="UV - Op" Display="'UV - Op %.f%%',0~100" Dmx="112~127" WheelPosition="7" Colour="128,0,192" />
      <Function ID="25" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="27" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~139" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.1f Hz',1.0~11.0" Dmx="140~243" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:20" PowerOn="1:20" />
      <Function ID="1" Name="Zoom" Display="'%.2f°',16.00~24.00" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="4 Facet" Display="'4 Facet'" Dmx="52~103" />
      <Function ID="3" Name="5 Facet" Display="'5 Facet'" Dmx="104~155" />
      <Function ID="4" Name="2 Facet" Display="'2 Facet'" Dmx="156~207" />
      <Function ID="5" Name="5 Facet 3D" Display="'5 Facet 3D'" Dmx="208~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f°',0~540" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo1Func'==1" />
      <Condition Name="Index" ID="6,7,8,9,10" If="'Gobo1Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="64~64" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="128~128" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="192~192" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="255~255" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Op - 1" Display="'Op - 1 %.f%%',0~100" Dmx="0~64" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="1 - 2" Display="'1 - 2 %.f%%',0~100" Dmx="64~128" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="2 - 3" Display="'2 - 3 %.f%%',0~100" Dmx="128~192" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="3 - 4" Display="'3 - 4 %.f%%',0~100" Dmx="192~255" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo2Func'==1||'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="52~103" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="104~156" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="157~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="208~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.2f%%',0.00~100.00" Dmx="0~32727" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="48896~49407" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="32768~48895" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="48896~49407" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49408~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="17 DMX (3-ON, 4-OFF, 7-OFF, 8-ON)" Channels="17">
    <Import PearlRef="CPStgZoom" DiamondRef="CPStgZoom" WysiwygRef="" />
    <Physical>
      <Bulb Type="HMI 1200W/S" Lumens="110000" ColourTemp="" />
      <Lens Name="Zoom lens" Degrees="13.5~21.6" />
      <Weight Kg="63.5" />
      <Size Height="0.800" Width="0.590" Depth="0.390" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="90" TiltMaxSpeed="79" />
    </Physical>

    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+ Green" Display="'+ Green %.1f%%',10.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="- Green" Display="'- Green %.1f%%',0.0~-10.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tuning" Name="Tuning" Description="" Group="S">

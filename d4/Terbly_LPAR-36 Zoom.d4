      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="112~119" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="120~127" Colour="0,0,0" />
      <Function ID="18" Name="Macro 17" Display="'Macro 17'" Dmx="128~135" Colour="0,0,0" />
      <Function ID="19" Name="Macro 18" Display="'Macro 18'" Dmx="136~143" Colour="0,0,0" />
      <Function ID="20" Name="Macro 19" Display="'Macro 19'" Dmx="144~151" Colour="0,0,0" />
      <Function ID="21" Name="Macro 20" Display="'Macro 20'" Dmx="152~159" Colour="0,0,0" />
      <Function ID="22" Name="Macro 21" Display="'Macro 21'" Dmx="160~167" Colour="0,0,0" />
      <Function ID="23" Name="Macro 22" Display="'Macro 22'" Dmx="168~175" Colour="0,0,0" />
      <Function ID="24" Name="Macro 23" Display="'Macro 23'" Dmx="176~183" Colour="0,0,0" />
      <Function ID="25" Name="Macro 24" Display="'Macro 24'" Dmx="184~191" Colour="0,0,0" />
      <Function ID="26" Name="Macro 25" Display="'Macro 25'" Dmx="192~199" Colour="0,0,0" />
      <Function ID="27" Name="Macro 26" Display="'Macro 26'" Dmx="200~207" Colour="0,0,0" />
      <Function ID="28" Name="Macro 27" Display="'Macro 27'" Dmx="208~215" Colour="0,0,0" />
      <Function ID="29" Name="Macro 28" Display="'Macro 28'" Dmx="216~223" Colour="0,0,0" />
      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="224~231" Colour="0,0,0" />
      <Function ID="31" Name="Macro 30" Display="'Macro 30'" Dmx="232~239" Colour="0,0,0" />
      <Function ID="32" Name="Macro 31" Display="'Macro 31'" Dmx="240~247" Colour="0,0,0" />
      <Function ID="33" Name="Macro 32" Display="'Macro 32'" Dmx="248~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~40" Update="Dimmer" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="41~70" Update="Dimmer" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="71~100" Update="Dimmer" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="101~130" Update="Dimmer" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="131~160" Update="Dimmer" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="161~190" Update="Dimmer" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="191~220" Update="Dimmer" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="221~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="TBLP36Z" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f14416a6-36af-489b-8ff0-bd050495423f" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Macro" ChannelOffset="5" Wheel="22" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>

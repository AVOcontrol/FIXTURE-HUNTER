    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="241~254" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="3" Name="Dark Strobe" Display="'Dark Strobe %.f%%',0~100" Dmx="1~40" />
      <Function ID="4" Name="Bright Strobe" Display="'Bright Strobe %.f%%',0~100" Dmx="41~80" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="121~160" />
      <Function ID="6" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="81~120" />
      <Function ID="7" Name="Flicker" Display="'Flicker %.f%%',0~100" Dmx="161~200" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Incandescent" Display="'Incandescent'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~19" />
      <Function ID="3" Name="Incandescent Red Shift" Display="'Incandescent Red Shift'" Dmx="20~29" />
      <Function ID="4" Name="Linear Red Shift" Display="'Linear Red Shift'" Dmx="30~39" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1900-6000K" Display="'1900-6000K %.fK',1900~6000" Dmx="1~165" Colour="255,240,200" />
      <Function ID="3" Name="6050-10450K" Display="'6050-10450K %.fK',6050~10450" Dmx="166~254" Colour="255,240,200" />
      <Function ID="4" Name="5600K" Display="'5600K'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+ Green" Display="'+ Green %.2f',10.00~0.00" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="- Green" Display="'- Green %.2f',0.00~-10.00" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Tuning" Name="Tuning" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Brightest" Display="'Brightest'" Dmx="0~0" />
      <Function ID="2" Name="Hybrid" Display="'Hybrid'" Dmx="50~99" />
      <Function ID="3" Name="Spectral" Display="'Spectral'" Dmx="100~149" />
    </Attribute>
    <Attribute ID="Mix" Name="Mix" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Studio-&gt;RGB" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

      <Function ID="26" Name="Lime Green" Display="'Lime Green'" Dmx="130~134" Colour="0,255,0" />
      <Function ID="27" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="135~139" Colour="255,255,0" />
      <Function ID="28" Name="Deep Amber" Display="'Deep Amber'" Dmx="140~144" Colour="232,180,23" />

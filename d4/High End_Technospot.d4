      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="10~19" />
      <Function ID="3" Name="Display Off" Display="'Display Off'" Dmx="20~28" />
      <Function ID="4" Name="Display On" Display="'Display On'" Dmx="40~48" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="60~68" />
      <Function ID="6" Name="Lamp On" Display="'Lamp On'" Dmx="80~88" />
      <Function ID="7" Name="Lamp Off" Display="'Lamp Off'" Dmx="90~98" />
      <Function ID="8" Name="Shutdown" Display="'Shutdown'" Dmx="120~130" />
      <Function ID="9" Name="Reserved" Display="'Reserved'" Dmx="141~255" />
    </Attribute>
    <Attribute ID="Indigo_Highlight" Name="Ind Highlight" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cont Track" Display="'Cont Track %.f%%',0~100" Dmx="0~15" />
      <Function ID="2" Name="Strobe Track" Display="'Strobe Track %.1f%%',0.0~100.0" Dmx="16~41" />
      <Function ID="3" Name="Cont Ind" Display="'Cont Ind %.f%%',0~100" Dmx="128~143" />
      <Function ID="4" Name="Strobe Ind" Display="'Strobe Ind %.f%%',0~100" Dmx="144~169" />
      <Function ID="5" Name="Reserved" Display="'Reserved'" Dmx="170~255" />
    </Attribute>
    <Attribute ID="Indigo_Dim" Name="Indigo Dim" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dim" Display="'Dim %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disengage" Display="'Disengage'" Dmx="0~15" Update="Anim_Rot" />
      <Function ID="2" Name="Continuous" Display="'Continuous'" Dmx="16~31" Update="Anim_Rot" />
      <Function ID="3" Name="Fwd Spin" Display="'Fwd Spin'" Dmx="32~47" Update="Anim_Rot" />
      <Function ID="4" Name="Rev Spin" Display="'Rev Spin'" Dmx="48~63" Update="Anim_Rot" />
      <Function ID="5" Name="Fwd Anim" Display="'Fwd Anim'" Dmx="64~79" Update="Anim_Rot" />
      <Function ID="6" Name="Rev Anim" Display="'Rev Anim'" Dmx="80~95" Update="Anim_Rot" />
      <Function ID="7" Name="No Function" Display="'No Function'" Dmx="96~255" Update="Anim_Rot" />
    </Attribute>
    <Attribute ID="Anim_Rot" Name="Anim Rot" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Continuous" ID="1" If="'Animation'==2" />
      <Else ID="2,3" />
      <Function ID="1" Name="Continuous" Display="'Continuous %.2f%%',0.00~100.00" Dmx="0~255" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="3" Name="Rotate" Display="'Rotate %.2f%%',0.00~100.00" Dmx="0~255" />
    </Attribute>
  </Control>

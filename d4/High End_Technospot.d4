    <Attribute ID="CMYFunc" Name="CMY Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pure Mix" Display="'Pure Mix'" Dmx="0~47" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />
      <Function ID="2" Name="Cycle" Display="'Cycle'" Dmx="48~63" Update="Cyan, Magenta, Yellow" Colour="0,0,0" />

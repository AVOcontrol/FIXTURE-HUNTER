<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORband PiX-M" ShortName="Cband PiXM" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="01-12-10" Author="John Rogers" Comment="Created" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Fixed wheel mapping errors." />
  <History Date="19-06-11" Author="Nic Morris" Comment="Added pixel mapper combatibility." />
  <History Date="03-08-12" Author="Peter Budd" Comment="Created from COLORband Tri" />
  <History Date="15-05-13" Author="Peter Budd" Comment="Created from the Chauvet COLORband Pix." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="12-02-15" Author="Nic Morris" Comment="Added master dimmer to 42 DMX mode and changed cells to use virtual dimmer in response to customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Changed Tilt Dim Cell to hidden.  Added missing Atlabase ID to 6 DMX mode." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from COLORband Pix-M to COLORband PiX-M" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Removed 3 DMX mode (invalid).  Changed multi-cell to use hidden cell mode (previously unused)." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Removed tilt cell and tilt dim cell modes (unused).  Added physical tilt limit." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3f24ddce-a3d7-42ea-a3b4-cdea8f6b550f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macros" Display="'Macros %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;16" />
      <Condition Name="Sensitivity" ID="4" If="'Auto'==16" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="32~45" Update="Shutter" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="46~59" Update="Shutter" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="60~72" Update="Shutter" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="73~86" Update="Shutter" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="87~100" Update="Shutter" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="101~113" Update="Shutter" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="114~127" Update="Shutter" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="128~141" Update="Shutter" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="142~154" Update="Shutter" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="155~168" Update="Shutter" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="169~182" Update="Shutter" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="183~195" Update="Shutter" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="196~209" Update="Shutter" />
      <Function ID="15" Name="Chase 14 (Random)" Display="'Chase 14 (Random)'" Dmx="210~223" Update="Shutter" />

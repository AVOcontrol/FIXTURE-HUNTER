<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Storm-8x10QC" ShortName="Stm 8x10QC" Company="Contest">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="31-01-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~69" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="70~131" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="132~193" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="194~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~7" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="8~131" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" Intensity="0~0" />
      <Function ID="6" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="240~247" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~7" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="16~23" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="24~31" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="32~39" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="40~47" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="48~55" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="56~63" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="64~71" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="72~79" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="80~87" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="88~95" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="96~103" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="104~111" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="112~119" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~247" Colour="255,255,255" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="248~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

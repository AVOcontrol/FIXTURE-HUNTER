    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="248~255" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~7" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="8~22" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="23~37" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="38~52" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="53~67" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="68~82" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="83~97" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="98~112" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="113~127" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="128~142" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="143~157" />
      <Function ID="13" Name="Macro 11" Display="'Macro 11'" Dmx="158~172" />
      <Function ID="14" Name="Macro 12" Display="'Macro 12'" Dmx="173~187" />
      <Function ID="15" Name="Macro 13" Display="'Macro 13'" Dmx="188~202" />
      <Function ID="16" Name="Macro 14" Display="'Macro 14'" Dmx="203~217" />
      <Function ID="17" Name="Macro 15" Display="'Macro 15'" Dmx="218~232" />
      <Function ID="18" Name="Sound" Display="'Sound'" Dmx="233~247" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

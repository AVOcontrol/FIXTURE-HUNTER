  <Mode Name="22 DMX, 16bit" Channels="22">
    <Import PearlRef="SV_NSp25022" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="600" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b564177c-97b3-48b9-b3ee-52e91f4fdf71" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer_Effect" ChannelOffset="22" Wheel="5" />
      <Attribute ID="Pan" ChannelOffset="1,17" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2,18" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />

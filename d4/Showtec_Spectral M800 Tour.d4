<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Spectral M800 Tour" ShortName="SpecM800T" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>916a964b-5a1a-4015-a1a0-b134105f616e</Thumbnail>
  <History Date="11-05-10" Author="John Rogers" Comment="Created" />
  <History Date="25-02-11" Author="Nic Morris" Comment="Fixed power on and locate.  Increased wheel resolution" />
  <History Date="25-02-11" Author="Nic Morris" Comment="Adapted from Chauvet Colorado 1 Tri Tour" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="18-10-15" Author="Nic Morris" Comment="Revised dimmer speed functions in response to customer bug report" />
  <History Date="30-06-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="30-06-16" Author="Nic Morris" Comment="Replaced 'value' with dimmer in HSV mode.  Changed hue, saturation, macro and macro spd attribute groups to match wheel slots." />
  <History Date="08-08-16" Author="Nic Morris" Comment="Revised ID functions.  Revised Dimmer Speed functions." />
  <History Date="04-05-17" Author="Nic Morris" Comment="Changed name from Spectral M800 Tr to Spectral M800 Tour." />
  <History Date="01-02-18" Author="Nic Morris" Comment="Added product thumbnail" />
  <History Date="01-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d4e5d139-167b-4281-b803-c6b6894f8108" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~200" Colour="0,0,0" />
      <Function ID="3" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="4" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="5" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="6" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="7" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="8" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="9" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="10" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="11" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="12" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="13" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="21~30" Update="Red, Green" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="31~40" Update="Red, Green" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="41~50" Update="Red, Green" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~60" Update="Red, Green" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="61~70" Update="Red, Green" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="71~80" Update="Red, Green" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="81~90" Update="Red, Green" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="91~100" Update="Red, Green" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="101~110" Update="Red, Green" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="111~120" Update="Red, Green" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="121~130" Update="Red, Green" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="131~140" Update="Red, Green" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="141~150" Update="Red, Green" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="151~160" Update="Red, Green" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="161~170" Update="Red, Green" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="171~180" Update="Red, Green" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="181~190" Update="Red, Green" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="191~200" Update="Red, Green" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="201~210" Update="Red, Green" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="211~220" Update="Red, Green" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="10~69" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All IDs" Display="'All IDs'" Dmx="0~0" />
      <Function ID="2" Name="ID 1-20" Display="'ID 1-20 %.f',1~20" Dmx="10~209" />
      <Function ID="3" Name="ID 21-66" Display="'ID 21-66 %.f',21~66" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Tour, 10 DMX" Channels="10">
    <Import PearlRef="ST_SPM800T1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c0fad8bd-3e9f-45a5-885c-179ce75e8644" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="37" />
      <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="23" />
      <Attribute ID="Dim_Spd" ChannelOffset="9" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="ARC1, 3 DMX" Channels="3">
    <Import PearlRef="ST_SPM800T2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d4dd960d-af09-4092-8fa4-54216873f9ff" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="AR1+D, 4 DMX" Channels="4">
    <Import PearlRef="ST_SPM800T3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

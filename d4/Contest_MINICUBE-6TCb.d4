  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="849f8b50-e0fc-4091-9f96-fe46cff75b5d" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;25" />
      <Condition Name="Auto" ID="3" If="'Colour_Macro'==25" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Update="Dimmer" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="21~30" Update="Dimmer" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="31~40" Update="Dimmer" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="41~51" Update="Dimmer" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="52~61" Update="Dimmer" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="62~71" Update="Dimmer" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="72~81" Update="Dimmer" Colour="255,150,150" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="82~92" Update="Dimmer" Colour="255,0,255" />
      <Function ID="10" Name="Cool White" Display="'Cool White'" Dmx="93~102" Update="Dimmer" Colour="230,230,255" />
      <Function ID="11" Name="Warm White" Display="'Warm White'" Dmx="101~110" Update="Dimmer" Colour="255,240,200" />
      <Function ID="12" Name="Colour Macro 1" Display="'Colour Macro 1'" Dmx="113~122" Update="Dimmer" Colour="0,0,0" />
      <Function ID="13" Name="Colour Macro 2" Display="'Colour Macro 2'" Dmx="123~133" Update="Dimmer" Colour="0,0,0" />
      <Function ID="14" Name="Colour Macro 3" Display="'Colour Macro 3'" Dmx="134~143" Update="Dimmer" Colour="0,0,0" />
      <Function ID="15" Name="Colour Macro 4" Display="'Colour Macro 4'" Dmx="144~153" Update="Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Colour Macro 5" Display="'Colour Macro 5'" Dmx="154~163" Update="Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Colour Macro 6" Display="'Colour Macro 6'" Dmx="164~174" Update="Dimmer" Colour="0,0,0" />
      <Function ID="18" Name="Colour Macro 7" Display="'Colour Macro 7'" Dmx="175~184" Update="Dimmer" Colour="0,0,0" />
      <Function ID="19" Name="Colour Macro 8" Display="'Colour Macro 8'" Dmx="185~194" Update="Dimmer" Colour="0,0,0" />
      <Function ID="20" Name="Colour Macro 9" Display="'Colour Macro 9'" Dmx="195~204" Update="Dimmer" Colour="0,0,0" />
      <Function ID="21" Name="Colour Macro 10" Display="'Colour Macro 10'" Dmx="205~215" Update="Dimmer" Colour="0,0,0" />
      <Function ID="22" Name="Colour Macro 11" Display="'Colour Macro 11'" Dmx="216~225" Update="Dimmer" Colour="0,0,0" />
      <Function ID="23" Name="Colour Macro 12" Display="'Colour Macro 12'" Dmx="226~235" Update="Dimmer" Colour="0,0,0" />
      <Function ID="24" Name="Colour Macro 13" Display="'Colour Macro 13'" Dmx="236~245" Update="Dimmer" Colour="0,0,0" />
      <Function ID="25" Name="Auto" Display="'Auto'" Dmx="246~255" Update="Dimmer" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="189~189" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" />
    </Attribute>
  </Control>

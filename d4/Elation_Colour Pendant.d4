  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="18-08-16" Author="Nic Morris" Comment="Created" />
  <History Date="02-11-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="02-11-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ce6f1081-f3f6-4b84-9671-6cb30fb102e5" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Scroll Full Fast" Display="'Scroll Full Fast'" Dmx="1~7" Colour="255,255,255" />
      <Function ID="3" Name="Scroll Full Med" Display="'Scroll Full Med'" Dmx="8~15" Colour="255,255,255" />
      <Function ID="4" Name="Scroll Full Slow" Display="'Scroll Full Slow'" Dmx="16~25" Colour="255,255,255" />
      <Function ID="5" Name="Scroll Warm Fast" Display="'Scroll Warm Fast'" Dmx="26~29" Colour="255,255,255" />
      <Function ID="6" Name="Scroll Warm Med" Display="'Scroll Warm Med'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="7" Name="Scroll Warm Slow" Display="'Scroll Warm Slow'" Dmx="40~50" Colour="255,255,255" />
      <Function ID="8" Name="Scroll Cool Fast" Display="'Scroll Cool Fast'" Dmx="51~57" Colour="255,255,255" />
      <Function ID="9" Name="Scroll Cool Med" Display="'Scroll Cool Med'" Dmx="58~65" Colour="255,255,255" />
      <Function ID="10" Name="Scroll Cool Slow" Display="'Scroll Cool Slow'" Dmx="66~73" Colour="255,255,255" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="74~84" Colour="255,255,255" />
      <Function ID="12" Name="Pink" Display="'Pink'" Dmx="85~91" Colour="255,255,255" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="92~99" Colour="255,255,255" />
      <Function ID="14" Name="Light Orange" Display="'Light Orange'" Dmx="100~109" Colour="255,255,255" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="110~118" Colour="255,255,255" />
      <Function ID="16" Name="Light Yellow" Display="'Light Yellow'" Dmx="119~124" Colour="255,255,255" />
      <Function ID="17" Name="Green" Display="'Green'" Dmx="125~132" Colour="255,255,255" />
      <Function ID="18" Name="Light Green" Display="'Light Green'" Dmx="133~142" Colour="255,255,255" />
      <Function ID="19" Name="Cyan" Display="'Cyan'" Dmx="143~150" Colour="255,255,255" />
      <Function ID="20" Name="Light Cyan" Display="'Light Cyan'" Dmx="151~158" Colour="255,255,255" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="159~165" Colour="255,255,255" />
      <Function ID="22" Name="Light Blue" Display="'Light Blue'" Dmx="166~175" Colour="255,255,255" />
      <Function ID="23" Name="Warm White" Display="'Warm White'" Dmx="176~183" Colour="255,255,255" />
      <Function ID="24" Name="Cool White" Display="'Cool White'" Dmx="184~191" Colour="255,255,255" />
      <Function ID="25" Name="White" Display="'White'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Speed" Name="Col Speed" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Range" Name="Col Range" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Range" Display="'Range %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Steps" Name="Col Steps" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Smooth" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="32~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="96~127" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~159" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="160~191" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

    </Attribute>
    <Attribute ID="Laser_Colour" Name="Laser Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~8" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="9~9" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="10~10" Colour="0,0,255" />

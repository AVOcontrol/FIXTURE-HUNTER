    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="E">
      <Locate Locate="6:0" PowerOn="6:0" />
      <Condition Name="Dynamic" ID="2,3,4,5" If="'Pattern'&gt;2" />
      <Condition Name="Static" ID="1" If="'Pattern'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Select" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~37" />
      <Function ID="3" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="144~39" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="145~148" />
      <Function ID="5" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="149~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">

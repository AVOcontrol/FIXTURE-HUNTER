    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="11~40" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="41~80" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="81~120" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="121~160" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="161~200" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="201~240" />

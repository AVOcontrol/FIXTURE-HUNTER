      <Function ID="16" Name="Op/ 1" Display="'Op/ 1'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="1/ 2" Display="'1/ 2'" Dmx="12~16" WheelPosition="1" Colour="0,0,0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SG HalfPar18" ShortName="HalfPar 18" Company="Sagitter">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-03-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cold_White" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="1~50" Update="Speed" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="51~101" Update="Speed" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="102~152" Update="Speed" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="153~203" Update="Speed" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="204~254" Update="Speed" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="255~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Macro 1" ID="2,3,4,5" If="'Macro'==2" />
      <Condition Name="Speed" ID="6" If="'Macro'&gt;2" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="OFF" Display="'OFF'" Dmx="0~84" />
      <Function ID="3" Name="WW" Display="'WW'" Dmx="85~169" />
      <Function ID="4" Name="CW" Display="'CW'" Dmx="170~254" />
      <Function ID="5" Name="Full On" Display="'Full On'" Dmx="255~255" />
      <Function ID="6" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 2 DMX" Channels="2">
    <Import PearlRef="SGHP181" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Warm_White" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Cold_White" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 4 DMX" Channels="4">
    <Import PearlRef="SGHP182" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Warm_White" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Cold_White" ChannelOffset="2" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 6 DMX" Channels="6">
    <Import PearlRef="SGHP183" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Warm_White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Cold_White" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Macro" ChannelOffset="4" Wheel="28" />
      <Attribute ID="Speed" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
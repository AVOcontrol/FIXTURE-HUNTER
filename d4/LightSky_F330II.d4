      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="86~86" WheelPosition="10" Colour="0,255,255" />
      <Function ID="12" Name="CTO 2" Display="'CTO 2'" Dmx="94~94" WheelPosition="11" Colour="255,240,200" />

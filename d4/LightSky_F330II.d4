  <Macro>
    <Macro Name="Reset FX">
      <Set Channel="Control:2,Reset:2" Delay="6000" />
      <Set Channel="Control:1,Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:3,Reset:3" Delay="6000" />
      <Set Channel="Control:1,Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:4,Reset:4" Delay="6000" />
      <Set Channel="Control:1,Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:5,Lamp:2" Delay="6000" />
      <Set Channel="Control:1,Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:6,Lamp:3" Delay="6000" />
      <Set Channel="Control:1,Lamp:1" Delay="0" />
    </Macro>
  </Macro>

      <Function ID="7" Name="Lavender" Display="'Lavender'" Dmx="52~52" WheelPosition="6" Colour="255,128,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="60~60" WheelPosition="7" Colour="255,150,200" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Conbox" ShortName="Conbox" Company="ShowLED">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="08-01-20" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Chase 1 (1 Channel @ Full)" Display="'Chase 1 (1 Channel @ Full)'" Dmx="0~0" />
      <Function ID="2" Name="Chase 2 (2 Channels @ Full)" Display="'Chase 2 (2 Channels @ Full)'" Dmx="32~63" />
      <Function ID="3" Name="Chase 3 (3 Channels @ Full)" Display="'Chase 3 (3 Channels @ Full)'" Dmx="64~95" />
      <Function ID="4" Name="Chase 4 (4 Channels @ Full)" Display="'Chase 4 (4 Channels @ Full)'" Dmx="96~127" />
      <Function ID="5" Name="Chase 5 (5 Channels @ Full)" Display="'Chase 5 (5 Channels @ Full)'" Dmx="128~159" />
      <Function ID="6" Name="Chase 6 (6 Channels @ Full)" Display="'Chase 6 (6 Channels @ Full)'" Dmx="160~191" />
      <Function ID="7" Name="Chase 7 (7 Channels @ Full)" Display="'Chase 7 (7 Channels @ Full)'" Dmx="192~223" />
      <Function ID="8" Name="Chase 8 (Strobe Effect)" Display="'Chase 8 (Strobe Effect)'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Chase_Fade" Name="Chase Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Soft Chase" Display="'Soft Chase'" Dmx="0~0" />
      <Function ID="2" Name="Hard Chase" Display="'Hard Chase'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Min_Intensity" Name="Min Intensity" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Max Intensity" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Type" Name="Colour Type" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Colour" Display="'1 Colour'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2 Colours" Display="'2 Colours'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="3 Colours" Display="'3 Colours'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="4 Colours" Display="'4 Colours'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="4 Colours Rotating" Display="'4 Colours Rotating'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="3 Colours Rotating" Display="'3 Colours Rotating'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="2 Colours Rotating" Display="'2 Colours Rotating'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="Chameleon Colour Change" Display="'Chameleon Colour Change'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" Colour="0,0,255" />
      <Function ID="2" Name="Blu - Wht" Display="'Blu - Wht %.f%%',0~100" Dmx="1~31" Colour="0,0,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="32~32" Colour="255,255,255" />
      <Function ID="4" Name="Wht - Yel" Display="'Wht - Yel %.f%%',0~100" Dmx="33~63" Colour="255,255,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="64~64" Colour="255,255,0" />
      <Function ID="6" Name="Yel - Grn" Display="'Yel - Grn %.f%%',0~100" Dmx="65~95" Colour="255,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="8" Name="Grn - Cy" Display="'Grn - Cy %.f%%',0~100" Dmx="97~127" Colour="0,255,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="128~128" Colour="0,255,255" />
      <Function ID="10" Name="Cy - Blu" Display="'Cy - Blu %.f%%',0~100" Dmx="129~159" Colour="0,255,255" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="160~160" Colour="0,0,255" />
      <Function ID="12" Name="Blu - Mag" Display="'Blu - Mag %.f%%',0~100" Dmx="161~191" Colour="0,0,255" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="192~192" Colour="255,0,255" />
      <Function ID="14" Name="Mag - Rd" Display="'Mag - Rd %.f%%',0~100" Dmx="193~223" Colour="255,0,255" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="224~224" Colour="255,0,0" />
      <Function ID="16" Name="Rd - Org" Display="'Rd - Org %.f%%',0~100" Dmx="225~254" Colour="255,0,0" />
      <Function ID="17" Name="Orange" Display="'Orange'" Dmx="255~255" Colour="255,128,0" />
      <Function ID="18" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Chase" ChannelOffset="1" Wheel="22" />
        <Attribute ID="Chase_Fade" ChannelOffset="2" Wheel="23" />
        <Attribute ID="Chase_Spd" ChannelOffset="3" Wheel="24" />
        <Attribute ID="Min_Intensity" ChannelOffset="4" Wheel="4" />
        <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
        <Attribute ID="Colour_Type" ChannelOffset="6" Wheel="7" />
        <Attribute ID="Colour1" Wheel="8" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="Col cell" X="0" Y="0">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Col cell" X="0" Y="1">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Col cell" X="0" Y="2">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="Col cell" X="0" Y="3">
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="24 DMX" Channels="24">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="RGB cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="RGB cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="RGB cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="RGB cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="13" ModeLink="RGB cell" X="0" Y="4">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="16" ModeLink="RGB cell" X="0" Y="5">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="19" ModeLink="RGB cell" X="0" Y="6">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="22" ModeLink="RGB cell" X="0" Y="7">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Col cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
    </Include>
  </Mode>
  <Mode Name="RGB cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
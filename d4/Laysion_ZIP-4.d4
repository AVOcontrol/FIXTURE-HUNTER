    <Attribute ID="Mode_GEL" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="GEL" Display="''" Dmx="171~213" />
    </Attribute>
    <Attribute ID="Effect_Sel" Name="Effect Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blink" Display="'Blink'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="2" Name="Breathe" Display="'Breathe'" Dmx="32~63" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="3" Name="Lighting" Display="'Lighting'" Dmx="64~95" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="4" Name="CCT Drift" Display="'CCT Drift'" Dmx="96~127" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="5" Name="Fire" Display="'Fire'" Dmx="128~159" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="6" Name="Party" Display="'Party'" Dmx="160~191" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="7" Name="TV" Display="'TV'" Dmx="192~223" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="8" Name="Red+Blue" Display="'Red+Blue'" Dmx="224~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Blink/Breathe/Lighting" ID="1" If="'Effect_Sel'==1||'Effect_Sel'==2||'Effect_Sel'==3" />
      <Condition Name="CCT Drift/TV/Red+Blue" ID="2" If="'Effect_Sel'==4||'Effect_Sel'==7||'Effect_Sel'==8" />
      <Condition Name="Fire" ID="3" If="'Effect_Sel'==5" />
      <Condition Name="Party" ID="4" If="'Effect_Sel'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',1.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',5.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Blink/Breathe/Lighting" ID="1" If="'Effect_Sel'==1||'Effect_Sel'==2||'Effect_Sel'==3" />
      <Condition Name="CCT Drift" ID="2" If="'Effect_Sel'==4" />
      <Condition Name="Fire" ID="3" If="'Effect_Sel'==5" />
      <Condition Name="Party" ID="4" If="'Effect_Sel'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="CCT 1" Display="'%.fK',1000~20000" Dmx="0~255" />
      <Function ID="3" Name="Magnitude" Display="'%.1f%%',40.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',1.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Condition Name="Blink/Breathe" ID="1" If="'Effect_Sel'==1||'Effect_Sel'==2" />
      <Condition Name="Lighting" ID="2" If="'Effect_Sel'==3" />
      <Condition Name="CCT Drift" ID="3" If="'Effect_Sel'==4" />
      <Else ID="4" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',1.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Magnitude" Display="'%.1f%%',1.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="CCT 2" Display="'%.fK',1000~20000" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Condition Name="Blink" ID="1" If="'Effect_Sel'==1" />
      <Else ID="2" />
      <Function ID="1" Name="Duty" Display="'%.1f%%',1.0~99.0" Dmx="0~255" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode_EFFECT" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="EFFECT" Display="''" Dmx="214~255" />
    </Attribute>

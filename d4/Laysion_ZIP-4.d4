    <Attribute ID="Red_Fine" Name="Red Fine" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Red" Display="'- Red %.1f%%',-30.0~0.0" Dmx="10~133" Colour="255,0,0" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="+ Red" Display="'+ Red %.1f%%',0.0~30.0" Dmx="134~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Fine" Name="Green Fine" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="- Green" Display="'- Green %.1f%%',-30.0~0.0" Dmx="10~133" Colour="0,255,0" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />

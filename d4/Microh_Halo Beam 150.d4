      <Palette ID="14" Name="Pink" Number="8" Page="1" SetControl="Colour1:7,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:10,Colour1Func:1" />
    </Group>

  <History Date="01-05-18" Author="Nic Morris" Comment="Created" />
  <History Date="21-12-18" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="11-02-19" Author="Nic Morris" Comment="Adjusted gobo open values, increased gobo wheel 1 to 10 gobos and renamed shakes according to latest information.  Very strange and confusing." />
  <History Date="11-02-19" Author="Nic Morris" Comment="Added gobo swatches where possible (documentation is confusing and images are poor quality)" />
  <History Date="20-02-19" Author="Nic Morris" Comment="Reverted gobo wheel 1 and 2 open range to 0 and removed gobo wheel 1 slot 10 in response to customer feedback." />
  <History Date="20-02-19" Author="Nic Morris" Comment="Removed extra gobo wheel 1 slot 10 shake function.  Documentation is terrible and gobo images don't make any sense." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6a9f6547-fdef-4bb0-962f-389ecdc8518a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="225~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

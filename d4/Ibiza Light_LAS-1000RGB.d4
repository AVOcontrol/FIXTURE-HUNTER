<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LAS-1000RGB" ShortName="LAS1000RGB" Company="Ibiza Light">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-01-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" />
      <Function ID="2" Name="Auto Beam" Display="'Auto Beam'" Dmx="50~99" />
      <Function ID="3" Name="Auto Anim" Display="'Auto Anim'" Dmx="100~149" />
      <Function ID="4" Name="Manual" Display="'Manual'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y-Move" Name="Y-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Down-Up" Display="'Down-Up %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Up-Down" Display="'Up-Down %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="X-Move" Name="X-Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="R-L" Display="'R-L %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="L-R" Display="'L-R %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="192~255" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="128~191" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" />
      <Function ID="2" Name="Small-Big" Display="'Small-Big %.f%%',0~100" Dmx="1~85" />
      <Function ID="3" Name="Big-Small" Display="'Big-Small %.f%%',0~100" Dmx="86~170" />
      <Function ID="4" Name="Auto" Display="'Auto %.f%%',0~100" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Patt_Size" Name="Patt Size" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Spot/Line" Name="Spot/Line" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line-Spot" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Twinkle" Name="Twinkle" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKILLAS1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Pattern" ChannelOffset="3" Wheel="13" />
      <Attribute ID="Y-Move" ChannelOffset="4" Wheel="3" />
      <Attribute ID="X-Move" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Y-Rot" ChannelOffset="6" Wheel="20" />
      <Attribute ID="X-Rot" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Rotate" ChannelOffset="8" Wheel="21" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="49" />
      <Attribute ID="Patt_Size" ChannelOffset="10" Wheel="14" />
      <Attribute ID="Spot/Line" ChannelOffset="11" Wheel="22" />
      <Attribute ID="Twinkle" ChannelOffset="12" Wheel="23" />
    </Include>
  </Mode>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Nick NRG 1401" ShortName="Nick 1401" Company="DTS">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>24da2be1-4e65-498d-bcc6-003b258d9256</Thumbnail>
  <History Date="13-06-12" Author="Peter Budd" Comment="Created" />
  <History Date="23-08-12" Author="Peter Budd" Comment="Created from Terbly OV370Z-R" />
  <History Date="28-08-12" Author="Peter Budd" Comment="Created from Elation Platinum Wash ZXF Pro XL" />
  <History Date="30-10-12" Author="Peter Budd" Comment="Edited added cell layout." />
  <History Date="17-06-13" Author="Peter Budd" Comment="Updated to include shape channels in standard mode, and colour channels." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Increased 16-bit functions to 2dp.  Increased shape speed functions to 1dp." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Standardised shutted function order.  Reversed shape transition and offset wheel direction." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Removed smoothing update from shape." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Added Extended RGBW mode." />
  <History Date="27-10-13" Author="Nic Morris" Comment="Created from Clay Paky A.leda Wash K20" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="02-03-14" Author="Nic Morris" Comment="Added 'Full' mode and brought in line with latest spec." />
  <History Date="05-06-14" Author="Remi Derruau" Comment="Updated Shape strobe, Back strobe and back select to latest spec." />
  <History Date="05-06-14" Author="Remi Derruau" Comment="Updated shapes." />
  <History Date="05-06-14" Author="Nic Morris" Comment="Checked Remi's edits against documentation.  Increased back strobe wheel resolution." />
  <History Date="05-06-14" Author="Nic Morris" Comment="Changed back select to locate to wash mode.  Fixed spiral shape range." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Added shape offset conditional functions for new shapes." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Changed colour macro to effect group to match new wheel mappings." />
  <History Date="08-06-14" Author="Nic Morris" Comment="Fixed lens rot CW spin range.  Changed lens rot spin display to value 1dp to provide full resolution." />
  <History Date="02-01-15" Author="Nic Morris" Comment="Updated to 11.2014 spec" />
  <History Date="02-02-15" Author="Peter Budd" Comment="Added pixel map on macro." />
  <History Date="23-04-16" Author="Nic Morris" Comment="Created from Clay Paky A.leda B-EYE K20 (firmware incomplete)" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="26-07-16" Author="Nic Morris" Comment="Added compatibility for R20 export" />
  <History Date="29-05-18" Author="Nic Morris" Comment="Added channel counts to mode names.  Set multi-part modes to hidden.  Added extended mode pixel layout." />
  <History Date="29-05-18" Author="Nic Morris" Comment="Added 'Sectors' mode.  Changed RGB masters to default at zero." />
  <Manual Filename=" Summary=" Summary="" />

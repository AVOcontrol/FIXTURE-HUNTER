  <AtlaBase TypeID="285ccc85-446f-46d2-b738-2b5ad7e8ed2e" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="16~16" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="32~32" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="48~48" WheelPosition="3" Colour="0,0,0" />
      <Function ID="5" Name="Half Minus Green" Display="'Half Minus Green'" Dmx="64~64" WheelPosition="4" Colour="255,255,255" />
      <Function ID="6" Name="CTB" Display="'CTB'" Dmx="80~80" WheelPosition="5" Colour="230,230,255" />
      <Function ID="7" Name="Brilliant Blue" Display="'Brilliant Blue'" Dmx="96~96" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="112~112" WheelPosition="7" Colour="0,255,0" />
      <Function ID="9" Name="UV Filter" Display="'UV Filter'" Dmx="127~127" WheelPosition="8" Colour="180,0,255" />
      <Function ID="10" Name="Op/ 1" Display="'Op/ 1'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="1/ 2" Display="'1/ 2'" Dmx="24~24" WheelPosition="1" Colour="0,0,0" />
      <Function ID="12" Name="2/ 3" Display="'2/ 3'" Dmx="40~40" WheelPosition="2" Colour="0,0,0" />
      <Function ID="13" Name="3/ HMG" Display="'3/ HMG'" Dmx="56~56" WheelPosition="3" Colour="0,0,0" />
      <Function ID="14" Name="HMG/ CTB" Display="'HMG/ CTB'" Dmx="72~72" WheelPosition="4" Colour="255,255,255" />
      <Function ID="15" Name="CTB/ B Blu" Display="'CTB/ B Blu'" Dmx="88~88" WheelPosition="5" Colour="230,230,255" />
      <Function ID="16" Name="B Blu/ Grn" Display="'B Blu/ Grn'" Dmx="104~104" WheelPosition="6" Colour="0,0,255" />
      <Function ID="17" Name="Grn/ UV" Display="'Grn/ UV'" Dmx="120~120" WheelPosition="7" Colour="0,255,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="18,19" If="'Colour2Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Dark Red" Display="'Dark Red'" Dmx="16~16" WheelPosition="1" Colour="180,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~32" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="48~48" WheelPosition="3" Colour="255,128,0" />
      <Function ID="5" Name="Light Pink" Display="'Light Pink'" Dmx="64~64" WheelPosition="4" Colour="255,200,200" />
      <Function ID="6" Name="Lavender" Display="'Lavender'" Dmx="80~80" WheelPosition="5" Colour="255,128,255" />
      <Function ID="7" Name="Aquamarine" Display="'Aquamarine'" Dmx="96~96" WheelPosition="6" Colour="0,255,200" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="112~112" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Dark Blue" Display="'Dark Blue'" Dmx="127~127" WheelPosition="8" Colour="0,0,180" />
      <Function ID="10" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="D Rd/ Grn" Display="'D Rd/ Grn'" Dmx="24~24" WheelPosition="1" Colour="180,0,0" />
      <Function ID="12" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="40~40" WheelPosition="2" Colour="0,255,0" />
      <Function ID="13" Name="Org/ L Pk" Display="'Org/ L Pk'" Dmx="56~56" WheelPosition="3" Colour="255,128,0" />
      <Function ID="14" Name="L Pk/ Lav" Display="'L Pk/ Lav'" Dmx="72~72" WheelPosition="4" Colour="255,200,200" />
      <Function ID="15" Name="Lav/ Aq" Display="'Lav/ Aq'" Dmx="88~88" WheelPosition="5" Colour="255,128,255" />
      <Function ID="16" Name="Aq/ Rd" Display="'Aq/ Rd'" Dmx="104~104" WheelPosition="6" Colour="0,255,200" />
      <Function ID="17" Name="Rd/ D Blu" Display="'Rd/ D Blu'" Dmx="120~120" WheelPosition="7" Colour="255,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />

  <AtlaBase TypeID="e3c9e979-44b7-4205-82f6-4a1f508025b9" />
  <Control>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.1fK',2700.0~6500.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />

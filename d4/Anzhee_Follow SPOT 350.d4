      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />

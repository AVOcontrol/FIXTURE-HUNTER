  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Prolights to Prolight" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="04-01-15" Author="Nic Morris" Comment="Corrected manufacturer name from Prolight to Prolights.  Added physical." />
  <History Date="04-01-15" Author="Nic Morris" Comment="Inverted P/T Speed wheel direction.  Increased wheel resolution." />
  <History Date="04-01-15" Author="Nic Morris" Comment="Inverted iris range.  Standardised conditionals.  Added highlight." />
  <History Date="18-08-16" Author="Nic Morris" Comment="Capitalised and removed spaces from fixture name in response to manufacturer request." />
  <History Date="18-08-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="75766eb8-b9a3-4552-9837-64509066704c" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

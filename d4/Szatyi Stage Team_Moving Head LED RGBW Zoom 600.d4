  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ebf68a24-4a4d-4cdc-9363-1889989e98ce" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="3" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="4" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="5" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="6" Name="Theatre ON" Display="'Theatre ON'" Dmx="90~99" />
      <Function ID="7" Name="Theatre OFF" Display="'Theatre OFF'" Dmx="100~109" />
      <Function ID="8" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="9" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="10" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Beam_Col_Macro" Name="Beam Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="1~2" Colour="255,255,255" />
      <Function ID="3" Name="2700K Hal" Display="'2700K Hal'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="5" Name="3200K Hal" Display="'3200K Hal'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="7~9" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="10" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="17~55" Colour="0,0,255" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />

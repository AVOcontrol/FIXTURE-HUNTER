<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Mini Wash" ShortName="Mini Wash" Company="SVS" Version="2">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="11-01-24" Author="Nic Morris" Comment="Created (very poor documentation.  Focus doesn't make any sense in this fixture and zoom is defined separately.  There is also no dimmer.  Assumed focus is actually dimmer.  Extended mode has two controls on offset 6.  assumed 'LED Marco' is channel 9)" Version="0" />
  <History Date="16-01-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="08-02-24" Author="Nic Morris" Comment="Revised colour macro names." Version="2" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a3f885aa-d096-469e-a3e0-936bdb1bed73" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~11" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="124~110" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="84~70" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="104~90" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="144~130" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="164~150" />
      <Function ID="9" Name="Thunder" Display="'Thunder %.f%%',0~100" Dmx="184~170" />
      <Function ID="10" Name="Rnd Thunder" Display="'Rnd Thunder %.f%%',0~100" Dmx="204~190" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="80~100" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Colour="255,255,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Colour="0,255,0" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="40~49" Colour="100,200,255" />
      <Function ID="6" Name="Dark Blue" Display="'Dark Blue'" Dmx="50~59" Colour="0,0,200" />
      <Function ID="7" Name="Hot Pink" Display="'Hot Pink'" Dmx="60~69" Colour="255,100,200" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="Light Pink" Display="'Light Pink'" Dmx="80~89" Colour="255,200,220" />
      <Function ID="10" Name="Light Green" Display="'Light Green'" Dmx="90~99" Colour="150,255,150" />
      <Function ID="11" Name="Very Light Blue" Display="'Very Light Blue'" Dmx="100~109" Colour="150,200,255" />
      <Function ID="12" Name="Light Yellow" Display="'Light Yellow'" Dmx="110~119" Colour="255,150,200" />
      <Function ID="13" Name="Pink" Display="'Pink'" Dmx="120~127" Colour="255,255,255" />
      <Function ID="14" Name="Rainbow Effect 1" Display="'Rainbow Effect 1'" Dmx="128~165" Colour="0,0,0" />
      <Function ID="15" Name="Rainbow Effect 2" Display="'Rainbow Effect 2'" Dmx="166~202" Colour="0,0,0" />
      <Function ID="16" Name="Rainbow Effect 3" Display="'Rainbow Effect 3'" Dmx="203~239" Colour="0,0,0" />
      <Function ID="17" Name="Colour Flow Random" Display="'Colour Flow Random'" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 10 DMX" Channels="10" Id="9d92b321-377f-4bc7-91ba-b178482a1081">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

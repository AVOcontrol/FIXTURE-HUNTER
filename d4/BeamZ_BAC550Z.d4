  <AtlaBase TypeID="978ce362-c6aa-438a-959e-dd7d4d8af913" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe (All Zone)" Display="'Strobe (All Zone) %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Strobe (Zone 3)" Display="'Strobe (Zone 3) %.f%%',0~100" Dmx="32~63" />
      <Function ID="5" Name="Rnd (All Zone)" Display="'Rnd (All Zone) %.f%%',0~100" Dmx="192~223" />
      <Function ID="6" Name="Rnd (Rnd Zone) 1" Display="'Rnd (Rnd Zone) 1 %.f%%',0~100" Dmx="160~175" />
      <Function ID="7" Name="Rnd (Rnd Zone) 2" Display="'Rnd (Rnd Zone) 2 %.f%%',0~100" Dmx="176~191" />
      <Function ID="8" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" />
      <Function ID="10" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="96~111" />
      <Function ID="11" Name="Effect 2" Display="'Effect 2 %.f%%',100~0" Dmx="112~127" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTC C-Mix" Display="'%.fK',2700~20000" Dmx="255~1" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 2700K" Display="'White 2700K'" Dmx="1~3" Colour="255,255,255" />
      <Function ID="3" Name="White 3200K" Display="'White 3200K'" Dmx="4~5" Colour="255,255,255" />
      <Function ID="4" Name="White 4200K" Display="'White 4200K'" Dmx="6~9" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="6" Name="White 8000K" Display="'White 8000K'" Dmx="13~15" Colour="255,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="8" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="17~55" Colour="0,0,255" />
      <Function ID="9" Name="Light Blue" Display="'Light Blue'" Dmx="56~56" Colour="0,128,255" />
      <Function ID="10" Name="L Blu - Grn" Display="'L Blu - Grn %.f%%',0~100" Dmx="57~95" Colour="0,128,255" />
      <Function ID="11" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="12" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="97~134" Colour="0,255,0" />
      <Function ID="13" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="255,255,0" />
      <Function ID="14" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="136~174" Colour="255,255,0" />
      <Function ID="15" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="16" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="176~214" Colour="255,0,0" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="18" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="216~246" Colour="255,0,255" />
      <Function ID="19" Name="Blue" Display="'Blue'" Dmx="247~247" Colour="0,0,255" />
      <Function ID="20" Name="Rainbow (w/fade)" Display="'Rainbow (w/fade)'" Dmx="248~248" Colour="255,255,255" />
      <Function ID="21" Name="Rainbow" Display="'Rainbow'" Dmx="249~249" Colour="255,255,255" />
      <Function ID="22" Name="Zone Effects" Display="'Zone Effects'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fade Time" Display="'Fade Time %.1f%%',0.0~100.0" Dmx="50~179" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="200~209" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />

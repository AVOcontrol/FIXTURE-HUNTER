    </Attribute>
    <Attribute ID="Flash_Int" Name="Flash Int" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Flash1" Name="Flash" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Random_Strobe" Name="Random Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />

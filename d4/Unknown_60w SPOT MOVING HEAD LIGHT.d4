  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="abd537b8-e3db-4e8b-ae20-2bba0fd965ed" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="22~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Amber" Display="'Amber'" Dmx="44~54" WheelPosition="2" Colour="255,100,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="66~76" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="88~98" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="110~120" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="132~142" WheelPosition="6" Colour="128,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="154~159" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="11~21" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Amb" Display="'Rd/ Amb'" Dmx="33~43" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Amb/ Yel" Display="'Amb/ Yel'" Dmx="55~65" WheelPosition="2" Colour="255,100,0" />
      <Function ID="12" Name="Yel/ Grn" Display="'Yel/ Grn'" Dmx="77~87" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="99~109" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Ppl" Display="'Blu/ Ppl'" Dmx="121~131" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="Ppl/ Cy" Display="'Ppl/ Cy'" Dmx="143~153" WheelPosition="6" Colour="128,0,255" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~208" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="160~207" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>278ad207-a248-4bba-8469-730fbdec9aac</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1">
        <Swatch>5fda094a-9bda-4a7c-adcf-8cf13fb2d71b</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2">
        <Swatch>db0c66ae-7a30-4663-8759-8aedceafd137</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3">

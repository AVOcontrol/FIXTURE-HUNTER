      <Attribute ID="Pan" ChannelOffset="12,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="14,15" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="11" Wheel="19" />
      <Attribute ID="Beam_Shape" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Beam_Shape_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Function" ChannelOffset="16" Wheel="30" />
      <Attribute ID="Reset" ChannelOffset="17" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="18" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Vector (CMY), 21 DMX" Channels="21">
    <Import PearlRef="CP_AlpW700V" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="250" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <RDM>
      <Version SoftwareID="-1" PersonalityID="2" />
    </RDM>
    <AtlaBase ModeID="fbb14641-593b-49a8-8853-9efe722ba96d" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="7,8" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="12,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="14,15" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Zoom" ChannelOffset="11" Wheel="19" />
      <Attribute ID="Beam_Shape" ChannelOffset="9" Wheel="22" />
      <Attribute ID="Beam_Shape_Rot" ChannelOffset="10" Wheel="23" />
      <Attribute ID="Function" ChannelOffset="16" Wheel="30" />
      <Attribute ID="Reset" ChannelOffset="17" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="18" Wheel="28" />
      <Attribute ID="P/T_Speed" ChannelOffset="19" Wheel="25" />
      <Attribute ID="Colour_Speed" ChannelOffset="20" Wheel="26" />

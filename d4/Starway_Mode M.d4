<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mode M" ShortName="Mode M" Company="Starway">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="06-05-15" Author="Gabi de Moitelle" Comment="Created" />
  <History Date="07-05-15" Author="Nic Morris" Comment="Changed mode 1 dimmer resolution to none and removed from mapping." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Changed 'Dim Cell' mode to use 'Dimmer' attribute for HTP compatibility.  Removed 'dimmer cell' attribute." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Recreated mode 6.  Changed RGB DimV cell mode to use Red Green Blue and Dimmer attributes for shape and HTP compatibility." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Recreated mode 4.  Increased wheel resolution.  Removed clear value from dimmer as it has no function." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Merged mode 5 conditionals into RGB channels for shape compatibility.  Also fixed mode 5 RGB locates as by-product." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Changed Dimmer 1 in mode 5 to Dimmer.  Removed extraneous attributes." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Changed speed else condition function to Raw DMX.  Changed effect speed and audio sensitivity to full 0-255 DMX ranges." />
  <History Date="07-05-15" Author="Nic Morris" Comment="Recreated palettes.  Updated power on to locate values." />
  <History Date="19-05-15" Author="Nic Morris" Comment="Revised Effect functions.  Added 78 DMX mode." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Character" ID="2" If="'Effect_Mode'&gt;16&amp;&amp;'Effect_Mode'&lt;21" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Character" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Character" ID="2" If="'Effect_Mode'&gt;16&amp;&amp;'Effect_Mode'&lt;21" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Char Color" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Character" ID="2" If="'Effect_Mode'&gt;16&amp;&amp;'Effect_Mode'&lt;21" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Back Color" Display="'%.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect_Mode" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~12" Update="Speed, Red, Green, Blue" />
      <Function ID="2" Name="R" Display="'R'" Dmx="13~19" Update="Speed, Red, Green, Blue" />
      <Function ID="3" Name="G" Display="'G'" Dmx="20~26" Update="Speed, Red, Green, Blue" />
      <Function ID="4" Name="B" Display="'B'" Dmx="27~33" Update="Speed, Red, Green, Blue" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="34~40" Update="Speed, Red, Green, Blue" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="41~47" Update="Speed, Red, Green, Blue" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="48~54" Update="Speed, Red, Green, Blue" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="55~61" Update="Speed, Red, Green, Blue" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="62~68" Update="Speed, Red, Green, Blue" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="69~75" Update="Speed, Red, Green, Blue" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="76~82" Update="Speed, Red, Green, Blue" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="83~89" Update="Speed, Red, Green, Blue" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="90~96" Update="Speed, Red, Green, Blue" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="97~103" Update="Speed, Red, Green, Blue" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="104~110" Update="Speed, Red, Green, Blue" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="111~117" Update="Speed, Red, Green, Blue" />
      <Function ID="17" Name="Char 0 deg" Display="'Char 0 deg'" Dmx="118~124" Update="Speed, Red, Green, Blue" />
      <Function ID="18" Name="Char 90 deg" Display="'Char 90 deg'" Dmx="125~131" Update="Speed, Red, Green, Blue" />
      <Function ID="19" Name="Char 180 deg" Display="'Char 180 deg'" Dmx="132~138" Update="Speed, Red, Green, Blue" />
      <Function ID="20" Name="Char 270 deg" Display="'Char 270 deg'" Dmx="139~145" Update="Speed, Red, Green, Blue" />
      <Function ID="21" Name="Dream" Display="'Dream'" Dmx="146~152" Update="Speed, Red, Green, Blue" />
      <Function ID="22" Name="Meteor" Display="'Meteor'" Dmx="153~159" Update="Speed, Red, Green, Blue" />
      <Function ID="23" Name="Fade" Display="'Fade'" Dmx="160~166" Update="Speed, Red, Green, Blue" />
      <Function ID="24" Name="Change" Display="'Change'" Dmx="167~173" Update="Speed, Red, Green, Blue" />
      <Function ID="25" Name="Flow 1" Display="'Flow 1'" Dmx="174~180" Update="Speed, Red, Green, Blue" />
      <Function ID="26" Name="Flow 2" Display="'Flow 2'" Dmx="181~187" Update="Speed, Red, Green, Blue" />
      <Function ID="27" Name="Flow 3" Display="'Flow 3'" Dmx="188~194" Update="Speed, Red, Green, Blue" />
      <Function ID="28" Name="Flow 4" Display="'Flow 4'" Dmx="195~201" Update="Speed, Red, Green, Blue" />
      <Function ID="29" Name="Flow 5" Display="'Flow 5'" Dmx="202~208" Update="Speed, Red, Green, Blue" />
      <Function ID="30" Name="Flow 6" Display="'Flow 6'" Dmx="209~215" Update="Speed, Red, Green, Blue" />
      <Function ID="31" Name="Flow 7" Display="'Flow 7'" Dmx="216~222" Update="Speed, Red, Green, Blue" />
      <Function ID="32" Name="Flow 8" Display="'Flow 8'" Dmx="223~229" Update="Speed, Red, Green, Blue" />
      <Function ID="33" Name="Flow 9" Display="'Flow 9'" Dmx="230~236" Update="Speed, Red, Green, Blue" />
      <Function ID="34" Name="Sound" Display="'Sound'" Dmx="237~255" Update="Speed, Red, Green, Blue" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fade Speed" ID="2" If="'Effect_Mode'&gt;1&amp;&amp;'Effect_Mode'&lt;21" />
      <Condition Name="Effect Speed" ID="3" If="'Effect_Mode'&gt;20&amp;&amp;'Effect_Mode'&lt;34" />
      <Condition Name="Sensitivity" ID="4" If="'Effect_Mode'==34" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Fade Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Effect Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Sensitivitiy" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="1~85" Intensity="0~0" />
      <Function ID="3" Name="Pixel Irreg" Display="'Pixel Irreg %.f%%',0~100" Dmx="86~170" Intensity="0~0" />
      <Function ID="4" Name="Panel Irreg" Display="'Panel Irreg %.f%%',0~100" Dmx="171~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~12" Update="Master_Dimmer" />
      <Function ID="2" Name="R" Display="'R'" Dmx="13~19" Update="Master_Dimmer" />
      <Function ID="3" Name="G" Display="'G'" Dmx="20~26" Update="Master_Dimmer" />
      <Function ID="4" Name="B" Display="'B'" Dmx="27~33" Update="Master_Dimmer" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="34~40" Update="Master_Dimmer" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="41~47" Update="Master_Dimmer" />
      <Function ID="7" Name="RB" Display="'RB'" Dmx="48~54" Update="Master_Dimmer" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="55~61" Update="Master_Dimmer" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="62~68" Update="Master_Dimmer" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="69~75" Update="Master_Dimmer" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="76~82" Update="Master_Dimmer" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="83~89" Update="Master_Dimmer" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="90~96" Update="Master_Dimmer" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="97~103" Update="Master_Dimmer" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="104~110" Update="Master_Dimmer" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="111~117" Update="Master_Dimmer" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="146~152" Update="Master_Dimmer" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="153~159" Update="Master_Dimmer" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="160~166" Update="Master_Dimmer" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="167~173" Update="Master_Dimmer" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="174~180" Update="Master_Dimmer" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="181~187" Update="Master_Dimmer" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="188~194" Update="Master_Dimmer" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="195~201" Update="Master_Dimmer" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="202~208" Update="Master_Dimmer" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="209~215" Update="Master_Dimmer" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~222" Update="Master_Dimmer" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="223~229" Update="Master_Dimmer" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="230~236" Update="Master_Dimmer" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="237~255" Update="Master_Dimmer" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Speed" ID="2" If="'Effect1'&gt;16&amp;&amp;'Effect1'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Effect1'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1 - 3dmx" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
    </Include>
  </Mode>

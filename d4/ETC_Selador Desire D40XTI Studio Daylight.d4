<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Selador Desire D40XTI Studio Daylight" ShortName="D40XTI DL" Company="ETC">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="27-08-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~254" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="Direct, 2 DMX" Channels="2">
    <Import PearlRef="ETC40ID1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="Studio, 2 DMX" Channels="2">
    <Import PearlRef="ETC40ID2" DiamondRef="" WysiwygRef="" />

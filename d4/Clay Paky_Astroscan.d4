<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Astroscan" ShortName="Astroscan" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-10-04" Author="Phil Rogers" Comment="Created" />
  <History Date="04-10-04" Author="Tom Peck" Comment="Checked" />
  <History Date="25-07-05" Author="D Trounce" Comment="Error: Iris wheel goes anticlockwise for up" />
  <History Date="25-07-05" Author="D Trounce" Comment="Error: No Macros" />
  <History Date="25-07-05" Author="D Trounce" Comment="Error: Colour speeds are inverted (14 rain on)" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed colour scroll ranges by inverting them" />
  <History Date="27-07-05" Author="E Spencer" Comment="Created Macros" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed Direction of iris wheel by inverting both ranges and DMX values" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved all Shake functions into special group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo ID to Gobo1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated GoboRot ID to Gobo1Rot" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="20-07-06" Author="Ed" Comment="Checked - changed col rain on ID to colour" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="15-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to 14 DMX modes.  Standardised conditionals.  Fixed duplicate ID's in else conditions." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed colour func updates.  Added function index.  Added palettes.  Added missing Mir Rot Func to 9 DMX modes." />
  <History Date="16-12-16" Author="Nic Morris" Comment="Added Atlabase ID's to 9 DMX mdoes." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Added colour index options and adjusted fixed and split ranges to be compatible with switch 2 on and off." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Changed gobo rot and mirror rot index range display from value to degrees.  Corrected mirror rot index display range." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Added missing raw DMX option to mirror func." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c37346c5-7e82-4df7-a28b-92d9d0cbd9cf" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour2Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour2Func'==3" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~64" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="96~96" WheelPosition="3" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~128" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="160~160" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="192~192" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="224~224" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="16~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="48~48" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Vlt" Display="'Yel/ Vlt'" Dmx="80~80" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="112~112" WheelPosition="3" Colour="128,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="144~144" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="176~176" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="208~208" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="240~240" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~32" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="32~64" WheelPosition="1" Colour="255,0,0" />
      <Function ID="19" Name="Yel - Vlt" Display="'Yel - Vlt %.f%%',0~100" Dmx="64~96" WheelPosition="2" Colour="255,255,0" />
      <Function ID="20" Name="Vlt - Grn" Display="'Vlt - Grn %.f%%',0~100" Dmx="96~128" WheelPosition="3" Colour="128,0,255" />
      <Function ID="21" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="128~160" WheelPosition="4" Colour="0,255,0" />
      <Function ID="22" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="160~192" WheelPosition="5" Colour="255,128,0" />
      <Function ID="23" Name="Blu - Pk" Display="'Blu - Pk %.f%%',0~100" Dmx="192~224" WheelPosition="6" Colour="0,0,255" />
      <Function ID="24" Name="Pk - Op" Display="'Pk - Op %.f%%',0~100" Dmx="224~255" WheelPosition="7" Colour="255,150,150" />
      <Function ID="25" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lamp On" Display="'Lamp On'" Dmx="128~255" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~127" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~139" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="244~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="140~243" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="52~103" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="104~155" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="156~207" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="208~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.f°',0~540" Dmx="0~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mirror_Rot" Name="Mirror Rot" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Mir_Rot_Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Mir_Rot_Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.f°',0~360" Dmx="0~127" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~190" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Osc_Spd" Name="Pan Osc Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Pan_Osc_Size" Name="Pan Osc Size" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Tilt_Osc_Spd" Name="Tilt Osc Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Tilt_Osc_Size" Name="Tilt Osc Size" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="P+T_Osc_Spd" Name="P+T Osc Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="13~255" />
    </Attribute>
    <Attribute ID="Mir_Rot_Func" Name="Mir Rot Func" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Mirror_Rot" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Mirror_Rot" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Mirror_Rot" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split" Display="'Split'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="17,18,19,20,21,22,23,24,25" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="26,27" If="'Colour1Func'==4" />
      <Else ID="28" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~16" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~32" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Violet" Display="'Violet'" Dmx="48~48" WheelPosition="3" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~64" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="80~80" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~96" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="112~112" WheelPosition="7" Colour="255,150,150" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="8~8" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="24~24" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Yel/ Vlt" Display="'Yel/ Vlt'" Dmx="40~40" WheelPosition="2" Colour="255,255,0" />
      <Function ID="12" Name="Vlt/ Grn" Display="'Vlt/ Grn'" Dmx="56~56" WheelPosition="3" Colour="128,0,255" />
      <Function ID="13" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="72~72" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="88~88" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="104~104" WheelPosition="6" Colour="0,0,255" />
      <Function ID="16" Name="Pk/ Op" Display="'Pk/ Op'" Dmx="120~120" WheelPosition="7" Colour="255,150,150" />
      <Function ID="17" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="0~16" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="Rd - Yel" Display="'Rd - Yel %.f%%',0~100" Dmx="16~32" WheelPosition="1" Colour="255,0,0" />
      <Function ID="19" Name="Yel - Vlt" Display="'Yel - Vlt %.f%%',0~100" Dmx="32~48" WheelPosition="2" Colour="255,255,0" />
      <Function ID="20" Name="Vlt - Grn" Display="'Vlt - Grn %.f%%',0~100" Dmx="48~64" WheelPosition="3" Colour="128,0,255" />
      <Function ID="21" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="64~80" WheelPosition="4" Colour="0,255,0" />
      <Function ID="22" Name="Org - Blu" Display="'Org - Blu %.f%%',0~100" Dmx="80~96" WheelPosition="5" Colour="255,128,0" />
      <Function ID="23" Name="Blu - Pk" Display="'Blu - Pk %.f%%',0~100" Dmx="96~112" WheelPosition="6" Colour="0,0,255" />
      <Function ID="24" Name="Pk - Op" Display="'Pk - Op %.f%%',0~100" Dmx="112~127" WheelPosition="7" Colour="255,150,150" />
      <Function ID="25" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="27" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

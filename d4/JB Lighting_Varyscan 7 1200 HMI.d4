      <Function ID="9" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="152~159" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="160~167" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW %.1f%%',100.0~0.0" Dmx="192~223" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />

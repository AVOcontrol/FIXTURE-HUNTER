      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="64~79" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Open Shake" Display="'Open Shake %.f%%',0~100" Dmx="128~135" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />

    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="6,7,8,9,10" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="15" />

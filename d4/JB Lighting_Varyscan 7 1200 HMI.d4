    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Split Gel" ID="10,11,12,13,14,15,16,17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~11" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="16~19" WheelPosition="2" Colour="255,255,0" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="24~27" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="32~35" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="40~43" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="48~51" WheelPosition="6" Colour="0,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="56~59" WheelPosition="7" Colour="0,255,255" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~191" Colour="255,255,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="4~7" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="12~15" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Yel/ Mag" Display="'Yel/ Mag'" Dmx="20~23" WheelPosition="2" Colour="255,255,0" />
      <Function ID="13" Name="Mag/ Grn" Display="'Mag/ Grn'" Dmx="28~31" WheelPosition="3" Colour="255,0,255" />
      <Function ID="14" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="36~39" WheelPosition="4" Colour="0,255,0" />
      <Function ID="15" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="44~47" WheelPosition="5" Colour="255,128,0" />
      <Function ID="16" Name="Blu/ Cy" Display="'Blu/ Cy'" Dmx="52~55" WheelPosition="6" Colour="0,0,255" />
      <Function ID="17" Name="Cy/ Op" Display="'Cy/ Op'" Dmx="60~63" WheelPosition="7" Colour="0,255,255" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.1f%%',100.0~0.0" Dmx="222~192" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="223~224" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.1f%%',0.0~100.0" Dmx="225~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Effect" Name="Colour Effect" Description="" Group="C">

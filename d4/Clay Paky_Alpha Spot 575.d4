<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Spot 575" ShortName="AlphaSp575" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>a9f2f755-384f-4d82-80a1-f7c87b8581b5</Thumbnail>
  <History Date="16-07-10" Author="John Rogers" Comment="Created from Clay Paky_Alpha Spot HPE575.d4" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-06-17" Author="Nic Morris" Comment="Added RainON and VectOFF modes.  Renamed existing modes to reflect settings more clearly." />
  <History Date="16-06-17" Author="Nic Morris" Comment="Revised speed controls.  Added highlight/lowlight.  Removed clear values.  Recreated palettes." />
  <History Date="16-06-17" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised conditionals.  Fixed macros and removed duplicates." />
  <History Date="16-06-17" Author="Nic Morris" Comment="Inverted zoom.  Added colour index functions and fixed RainON index range." />
  <History Date="16-06-17" Author="Nic Morris" Comment="Added colour function index.  Standardised shutter.  Fixed 16bit raw display range." />
  <History Date="20-06-17" Author="Nic Morris" Comment="Revised existing Atlabase mode ID's and added missing.  Fixed mapping for 16-Bit and Extended (RainON, VectOFF) modes." />
  <History Date="07-03-19" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches (note usable images for wheel 1 slots 3-6 not currently available)" />
  <Manual Filename="\manuals\fixtures\clay paky" Summary="" />
  <AtlaBase TypeID="8f92c178-b7dd-4fcd-b41d-7c777a194a6c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

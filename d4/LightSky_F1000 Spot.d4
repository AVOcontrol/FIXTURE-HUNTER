      <Function ID="9" Name="Position 8" Display="'Position 8'" Dmx="146~150" />
      <Function ID="10" Name="Position 9" Display="'Position 9'" Dmx="151~155" />
      <Function ID="11" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~110" />
      <Function ID="12" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="161~189" />
      <Function ID="13" Name="No Spin" Display="'No Spin'" Dmx="190~190" />

      <Function ID="10" Name="Gobo 4" Display="'Gobo 4'" Dmx="50~54" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 5" Display="'Gobo 5'" Dmx="55~59" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="60~89" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="90~119" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="120~149" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="150~179" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="180~209" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="210~232" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="233~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo 1 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="0 degree" Display="'0 degree'" Dmx="0~600" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="601~32130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="32131~32895" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="32896~64515" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="90 degree" Display="'90 degree'" Dmx="64516~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">

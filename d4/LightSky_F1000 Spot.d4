      <Function ID="17" Name="Metronome" Display="'Metronome'" Dmx="233~235" />
      <Function ID="18" Name="Open Pulse" Display="'Open Pulse'" Dmx="236~238" />
      <Function ID="19" Name="Close Pulse" Display="'Close Pulse'" Dmx="239~241" />
      <Function ID="20" Name="Rnd Bounce" Display="'Rnd Bounce'" Dmx="242~243" />

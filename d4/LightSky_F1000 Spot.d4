      <Condition Name="Fixed Index" ID="1,2,3,4,5,6" If="'Gobo2Func'==1" />
      <Condition Name="Fixed Spin" ID="7,8,9,10,11" If="'Gobo2Func'==2" />
      <Condition Name="Shake" ID="12,13,14,15,16" If="'Gobo2Func'==3" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo2Func'==4" />
      <Else ID="19" />

      <Function ID="7" Name="Open" Display="'Open'" Dmx="100~116" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 1" Display="'Gobo 1'" Dmx="117~134" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 2" Display="'Gobo 2'" Dmx="135~153" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 3" Display="'Gobo 3'" Dmx="154~172" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 4" Display="'Gobo 4'" Dmx="173~191" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 5" Display="'Gobo 5'" Dmx="192~216" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="217~236" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="237~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~83" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="84~94" />
      <Function ID="3" Name="Lamp ON" Display="'Lamp ON'" Dmx="166~176" />
      <Function ID="4" Name="Lamp OFF" Display="'Lamp OFF'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~19" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="20~49" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="72~50" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="187~128" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="99~80" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="119~100" Intensity="0~0" />
      <Function ID="7" Name="Rnd Op Pls" Display="'Rnd Op Pls %.f%%',0~100" Dmx="196~191" Intensity="0~0" />
      <Function ID="8" Name="Rnd Cl Pls" Display="'Rnd Cl Pls %.f%%',0~100" Dmx="202~197" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="203~207" Intensity="0~0" />
      <Function ID="10" Name="Reset" Display="'Reset'" Dmx="208~217" Intensity="0~0" />
      <Function ID="11" Name="Lamp On" Display="'Lamp On'" Dmx="228~237" Intensity="0~0" />
      <Function ID="12" Name="Lamp Off" Display="'Lamp Off'" Dmx="248~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour12" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="8" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="9,10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="160~163" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="164~167" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="168~171" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="172~175" Colour="0,0,0" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="176~179" Colour="0,0,0" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="180~183" Colour="0,0,0" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="184~187" Colour="0,0,0" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~159" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="192~217" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="218~243" Colour="0,0,0" />
      <Function ID="11" Name="Rand Fast" Display="'Rand Fast'" Dmx="244~247" Colour="255,255,255" />
      <Function ID="12" Name="Rand Med" Display="'Rand Med'" Dmx="248~251" Colour="255,255,255" />
      <Function ID="13" Name="Rand Slow" Display="'Rand Slow'" Dmx="252~55" Colour="255,255,255" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Iris1" Name="Iris" Description="" Group="B">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="200~215" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="199~0" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="216~229" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="230~243" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Rnd Cl Pls F" Display="'Rnd Cl Pls F'" Dmx="244~246" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Rnd Cl Pls S" Display="'Rnd Cl Pls S'" Dmx="247~249" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Rnd Op Pls F" Display="'Rnd Op Pls F'" Dmx="250~252" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Rnd Op Pls S" Display="'Rnd Op Pls S'" Dmx="253~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism1" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="1~175" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="176~191" />
      <Function ID="4" Name="Spin" Display="'Spin'" Dmx="192~207" />
      <Function ID="5" Name="Off" Display="'Off'" Dmx="208~215" />
      <Function ID="6" Name="Macro 1" Display="'Macro 1'" Dmx="216~220" />
      <Function ID="7" Name="Macro 2" Display="'Macro 2'" Dmx="221~225" />
      <Function ID="8" Name="Macro 3" Display="'Macro 3'" Dmx="226~230" />
      <Function ID="9" Name="Macro 4" Display="'Macro 4'" Dmx="231~235" />
      <Function ID="10" Name="Macro 5" Display="'Macro 5'" Dmx="236~240" />
      <Function ID="11" Name="Macro 6" Display="'Macro 6'" Dmx="241~245" />
      <Function ID="12" Name="Macro 7" Display="'Macro 7'" Dmx="246~250" />
      <Function ID="13" Name="Macro 8" Display="'Macro 8'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="CMY_Speed" Name="CMY Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="0~175" />
      <Function ID="2" Name="Prism Index" Display="'Prism Index'" Dmx="176~199" />
      <Function ID="3" Name="Prism Spin" Display="'Prism Spin'" Dmx="200~255" />
    </Attribute>
  </Control>

  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:2,Control1:2,Shutter1:10" Delay="6000" />
      <Set Channel="Control:1,Control1:1,Shutter1:2" Delay="0" />
    </Macro>
    <Macro Name="Reset FX">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp ON">
      <Set Channel="Control:8,Control1:3,Shutter1:11" Delay="6000" />
      <Set Channel="Control:1,Control1:1,Shutter1:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp OFF">
      <Set Channel="Control:9,Control1:4,Shutter1:12" Delay="6000" />
      <Set Channel="Control:1,Control1:1,Shutter1:2" Delay="0" />
    </Macro>
    <Macro Name="Lamp Full">
      <Set Channel="Control:21" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Half">
      <Set Channel="Control:22" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="60~119" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="120~179" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="180~239" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="240~255" />
    </Attribute>
  </Control>

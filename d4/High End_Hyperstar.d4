      <Function ID="6" Name="Random Fast (Full Speed)" Display="'Random Fast (Full Speed)'" Dmx="96~111" Update="Cyan, Magenta, Yellow" />
      <Function ID="7" Name="Pure Mix (mSpeed)" Display="'Pure Mix (mSpeed)'" Dmx="128~159" Update="Cyan, Magenta, Yellow" />
      <Function ID="8" Name="Cycle  (mSpeed)" Display="'Cycle  (mSpeed)'" Dmx="160~175" Update="Cyan, Magenta, Yellow" />
      <Function ID="9" Name="Random (mSpeed)" Display="'Random (mSpeed)'" Dmx="176~191" Update="Cyan, Magenta, Yellow" />
      <Function ID="10" Name="Pure Mix Fast (mSpeed)" Display="'Pure Mix Fast (mSpeed)'" Dmx="192~207" Update="Cyan, Magenta, Yellow" />
      <Function ID="11" Name="Cycle  Fast (mSpeed)" Display="'Cycle  Fast (mSpeed)'" Dmx="208~223" Update="Cyan, Magenta, Yellow" />
      <Function ID="12" Name="Random Fast (mSpeed)" Display="'Random Fast (mSpeed)'" Dmx="224~239" Update="Cyan, Magenta, Yellow" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Cyan, Magenta, Yellow" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Pure Mix" ID="1" If="'C-Mix_Func'==1||'C-Mix_Func'==4||'C-Mix_Func'==7||'C-Mix_Func'==10" />
      <Condition Name="Cycle" ID="2" If="'C-Mix_Func'==2||'C-Mix_Func'==3||'C-Mix_Func'==5||'C-Mix_Func'==6||'C-Mix_Func'==8||'C-Mix_Func'==9||'C-Mix_Func'==11||'C-Mix_Func'==12" />
      <Else ID="3" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Pure Mix" ID="1" If="'C-Mix_Func'==1||'C-Mix_Func'==4||'C-Mix_Func'==7||'C-Mix_Func'==10" />
      <Condition Name="Cycle" ID="2" If="'C-Mix_Func'==2||'C-Mix_Func'==3||'C-Mix_Func'==5||'C-Mix_Func'==6||'C-Mix_Func'==8||'C-Mix_Func'==9||'C-Mix_Func'==11||'C-Mix_Func'==12" />
      <Else ID="3" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Condition Name="Pure Mix" ID="1" If="'C-Mix_Func'==1||'C-Mix_Func'==4||'C-Mix_Func'==7||'C-Mix_Func'==10" />

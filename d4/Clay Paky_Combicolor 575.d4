  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4fc399ba-0b93-498f-a375-dd1b05043df3" />
  <Control>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gobo" Display="'Gobo %.1f%%',0.0~100.0" Dmx="0~241" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="255~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="140~242" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

<Fixture Name="Color Force Compact" ShortName="Col ForceC" Company="Chroma-Q">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="01-08-15" Author="Nic Morris" Comment="Created" />
  <History Date="22-04-16" Author="Gregory Haynes" Comment="Added short name" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added missing supported Atlabase ID's." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed name from Chroma Q to Chroma-Q.  Revised mode names." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="99c6a62a-863b-4d1b-a8d9-96d2c1fe416f" />
  <Control>
    <Attribute ID="FX_Group" Name="FX Group" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Grouping" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Scroll" Name="Colour Scroll" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Fan" Name="Colour Fan" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Range" Name="Colour Range" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Range" Display="'Range %.f',0~255" Dmx="1~255" />
      <Function ID="2" Name="Full Spectrum" Display="'Full Spectrum'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Colour_Step" Name="Colour Step" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB" Display="'RGB'" Dmx="255~255" />
      <Function ID="2" Name="Scroll Smooth" Display="'Scroll Smooth %.1f%%',0.0~100.0" Dmx="0~250" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="192~255" Intensity="0~0" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="1~63" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="64~127" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="128~191" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter_Fan" Name="Shutter Fan" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fan" Display="'%.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Look" Name="Look" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Full Col Scroll 5" Display="'Full Col Scroll 5'" Dmx="1~2" />
      <Function ID="3" Name="Full Col Scroll 10s" Display="'Full Col Scroll 10s'" Dmx="3~5" />
      <Function ID="4" Name="Full Col Scroll 30s" Display="'Full Col Scroll 30s'" Dmx="6~9" />
      <Function ID="5" Name="Warm Col Scroll 5s" Display="'Warm Col Scroll 5s'" Dmx="10~11" />
      <Function ID="6" Name="Warm Col Scroll 10s" Display="'Warm Col Scroll 10s'" Dmx="12~15" />
      <Function ID="7" Name="Warm Col Scroll 30s" Display="'Warm Col Scroll 30s'" Dmx="16~19" />
      <Function ID="8" Name="Cold Col Scroll 5s" Display="'Cold Col Scroll 5s'" Dmx="20~22" />
      <Function ID="9" Name="Cold Col Scroll 10s" Display="'Cold Col Scroll 10s'" Dmx="23~25" />
      <Function ID="10" Name="Cold Col Scroll 30s" Display="'Cold Col Scroll 30s'" Dmx="26~27" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="28~32" />
      <Function ID="12" Name="Pink" Display="'Pink'" Dmx="33~35" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="36~38" />
      <Function ID="14" Name="Light Orange" Display="'Light Orange'" Dmx="39~42" />
      <Function ID="15" Name="Yellow" Display="'Yellow'" Dmx="43~45" />
      <Function ID="16" Name="Light Yellow" Display="'Light Yellow'" Dmx="46~48" />
      <Function ID="17" Name="Green" Display="'Green'" Dmx="49~51" />
      <Function ID="18" Name="Light Green" Display="'Light Green'" Dmx="52~54" />
      <Function ID="19" Name="Cyan" Display="'Cyan'" Dmx="55~58" />
      <Function ID="20" Name="Light Cyan" Display="'Light Cyan'" Dmx="59~61" />
      <Function ID="21" Name="Blue" Display="'Blue'" Dmx="62~64" />
      <Function ID="22" Name="Light Blue" Display="'Light Blue'" Dmx="65~68" />
      <Function ID="23" Name="3200K" Display="'3200K'" Dmx="69~71" />
      <Function ID="24" Name="5600K" Display="'5600K'" Dmx="72~74" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>

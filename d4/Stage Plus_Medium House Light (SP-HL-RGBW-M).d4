      <Function ID="7" Name="Dim Mode Preset" Display="'Dim Mode Preset'" Dmx="61~254" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standby" Display="'Standby'" Dmx="0~0" />
      <Function ID="2" Name="Show1-Show5" Display="'Show1-Show5 %.f%%',0~100" Dmx="111~160" />
      <Function ID="3" Name="Fade1-Fade5" Display="'Fade1-Fade5 %.f%%',0~100" Dmx="161~210" />

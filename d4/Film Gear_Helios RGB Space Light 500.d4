      <Function ID="305" Name="LCF0052 (Light Lavender)" Display="'LCF0052 (Light Lavender)'" Dmx="42~43" Colour="0,0,0" />
      <Function ID="306" Name="LCF0053 (Paler Lavender)" Display="'LCF0053 (Paler Lavender)'" Dmx="44~45" Colour="0,0,0" />
      <Function ID="307" Name="LCF0058 (Lavender)" Display="'LCF0058 (Lavender)'" Dmx="46~47" Colour="0,0,0" />
      <Function ID="308" Name="LCF0136 (Pale Lavender)" Display="'LCF0136 (Pale Lavender)'" Dmx="48~49" Colour="0,0,0" />
      <Function ID="309" Name="LCF0137 (Special Lavender)" Display="'LCF0137 (Special Lavender)'" Dmx="50~51" Colour="0,0,0" />
      <Function ID="310" Name="LCF0142 (Pale Violet)" Display="'LCF0142 (Pale Violet)'" Dmx="52~53" Colour="0,0,0" />
      <Function ID="311" Name="LCF0169 (Lilac Tint)" Display="'LCF0169 (Lilac Tint)'" Dmx="54~55" Colour="0,0,0" />
      <Function ID="312" Name="LCF0170 (Deep Lavender)" Display="'LCF0170 (Deep Lavender)'" Dmx="56~57" Colour="0,0,0" />
      <Function ID="313" Name="LCF0180 (Dark Lavender)" Display="'LCF0180 (Dark Lavender)'" Dmx="58~59" Colour="0,0,0" />
      <Function ID="314" Name="LCF0194 (Surprise Pink)" Display="'LCF0194 (Surprise Pink)'" Dmx="60~61" Colour="255,255,255" />
      <Function ID="315" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Reserved4" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X1_Coordinate" Name="X1 Coordinate" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Coordinate" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Y1_Coordinate" Name="Y1 Coordinate" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Coordinate" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Xfade_X/Y" Name="Xfade X/Y" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="1&gt;2" Display="'1&gt;2 %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="3" Name="2" Display="'2'" Dmx="65535~65535" />
    </Attribute>
    <Attribute ID="X2_Coordinate" Name="X2 Coordinate" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Coordinate" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Y2_Coordinate" Name="Y2 Coordinate" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Coordinate" Display="'%.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Select" Name="FX Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="2" Name="Party Effect" Display="'Party Effect'" Dmx="10~19" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="3" Name="Candle" Display="'Candle'" Dmx="20~29" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="4" Name="Clouds Passing" Display="'Clouds Passing'" Dmx="30~39" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="5" Name="Colour Chase" Display="'Colour Chase'" Dmx="40~49" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="6" Name="Fire" Display="'Fire'" Dmx="50~59" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="7" Name="Fireworks" Display="'Fireworks'" Dmx="60~69" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="8" Name="Flu. Flicker" Display="'Flu. Flicker'" Dmx="70~79" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="9" Name="Lightning" Display="'Lightning'" Dmx="80~89" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="10" Name="Pulsing" Display="'Pulsing'" Dmx="90~99" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="11" Name="Strobe" Display="'Strobe'" Dmx="100~109" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="12" Name="Television" Display="'Television'" Dmx="110~119" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="FX_Param_1, FX_Param_2, FX_Param_3, FX_Param_4, FX_Param_5, FX_Param_6, FX_Param_7" />
    </Attribute>
    <Attribute ID="FX_Param_1" Name="FX Param 1" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'FX_Select'==2||'FX_Select'==3||'FX_Select'==4||'FX_Select'==5||'FX_Select'==6||'FX_Select'==7||'FX_Select'==8||'FX_Select'==12" />
      <Condition Name="Speed On" ID="3" If="'FX_Select'==11" />
      <Condition Name="Frequency" ID="4" If="'FX_Select'==9||'FX_Select'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="Speed On" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="4" Name="Frequency" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_2" Name="FX Param 2" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Saturation" ID="2" If="'FX_Select'==2" />
      <Condition Name="Colour Temperature" ID="3,4,5" If="'FX_Select'==3||'FX_Select'==6||'FX_Select'==12" />
      <Condition Name="Colour Temperature (Fireworks)" ID="6,7,8" If="'FX_Select'==7" />
      <Condition Name="Speed Off" ID="9" If="'FX_Select'==11" />
      <Condition Name="Density" ID="10,11,12,13,14,15" If="'FX_Select'==9" />
      <Condition Name="Offset" ID="16" If="'FX_Select'==4||'FX_Select'==5" />
      <Condition Name="Frequency" ID="17" If="'FX_Select'==8" />
      <Condition Name="Duration" ID="18" If="'FX_Select'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="Warm" Display="'Warm'" Dmx="0~0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="21845~43690" />
      <Function ID="5" Name="Cold" Display="'Cold'" Dmx="43947~65535" />
      <Function ID="6" Name="White" Display="'White'" Dmx="0~0" />
      <Function ID="7" Name="RGB" Display="'RGB'" Dmx="21845~43690" />
      <Function ID="8" Name="RGB+White" Display="'RGB+White'" Dmx="43947~65535" />
      <Function ID="9" Name="Speed Off" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="10" Name="1" Display="'1'" Dmx="0~0" />
      <Function ID="11" Name="2" Display="'2'" Dmx="2570~14649" />
      <Function ID="12" Name="3" Display="'3'" Dmx="14906~26985" />
      <Function ID="13" Name="4" Display="'4'" Dmx="27242~39321" />
      <Function ID="14" Name="5" Display="'5'" Dmx="39578~51657" />
      <Function ID="15" Name="6" Display="'6'" Dmx="51914~63993" />
      <Function ID="16" Name="Offset" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="17" Name="Frequency" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="18" Name="Duration" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_3" Name="FX Param 3" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Colour Temperature" ID="5" If="'FX_Select'==10||'FX_Select'==11" />
      <Condition Name="Sync" ID="2,3" If="'FX_Select'==4||'FX_Select'==5||'FX_Select'==9" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="3" Name="Sync" Display="'Sync'" Dmx="65535~65535" />
      <Function ID="5" Name="CCT" Display="'%.1fK',2800.0~10000.0" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_4" Name="FX Param 4" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="GM Point" ID="2,3,4,5,6,7" If="'FX_Select'==10||'FX_Select'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="0~0" />
      <Function ID="3" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="2827~5140" />
      <Function ID="4" Name="-" Display="'- %.2f%%',-99.00~-1.00" Dmx="5397~30583" />
      <Function ID="5" Name="Neutral" Display="'Neutral'" Dmx="30840~37265" />
      <Function ID="6" Name="+" Display="'+ %.2f%%',1.00~99.00" Dmx="37522~62708" />
      <Function ID="7" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="62965~65535" />
    </Attribute>
    <Attribute ID="FX_Param_5" Name="FX Param 5" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Crossfade" ID="2" If="'FX_Select'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="CCT&gt;RGBW" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_6" Name="FX Param 6" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Hue" ID="2" If="'FX_Select'==8||'FX_Select'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="FX_Param_7" Name="FX Param 7" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Saturation" ID="2" If="'FX_Select'==8||'FX_Select'==11" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Saturation" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Transition" Name="Transition" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Direct" Display="'Direct'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Through White Point" Display="'Through White Point'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="Through Black Point" Display="'Through Black Point'" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Dissolve" Display="'Dissolve'" Dmx="120~145" Colour="255,255,255" />
      <Function ID="5" Name="Over White Point" Display="'Over White Point'" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="Under White Point" Display="'Under White Point'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
  </Control>

    <Attribute ID="Xfade_Gel1&gt;2" Name="Xfade Gel1&gt;2" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Gel1-&gt;Gel2" Display="'Gel1-&gt;Gel2 %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Gel 1" Display="'Gel 1'" Dmx="0~0" />
      <Function ID="3" Name="Gel 2" Display="'Gel 2'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Gel_2_CCT" Name="Gel 2 CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="5600K" Display="'5600K'" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_2_Category" Name="Gel 2 Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Col Correction" Display="'Col Correction'" Dmx="0~0" Update="Gel_2_Class" Colour="255,255,255" />
      <Function ID="2" Name="Col Filter" Display="'Col Filter'" Dmx="255~255" Update="Gel_2_Class" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel_2_Class" Name="Gel 2 Class" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Col Filter" ID="7,8,9,10,11,12,13" If="'Gel_2_Category'==2" />
      <Else ID="1,2,3,4,5,6" />
      <Function ID="1" Name="CTB" Display="'CTB'" Dmx="0~0" Update="Gel_2" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO'" Dmx="10~57" Update="Gel_2" Colour="255,255,255" />
      <Function ID="3" Name="CTS" Display="'CTS'" Dmx="58~105" Update="Gel_2" Colour="255,255,255" />
      <Function ID="4" Name="+/- Green" Display="'+/- Green'" Dmx="106~153" Update="Gel_2" Colour="255,255,255" />
      <Function ID="5" Name="Misc" Display="'Misc'" Dmx="154~201" Update="Gel_2" Colour="255,255,255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Gel_2" Colour="0,0,0" />

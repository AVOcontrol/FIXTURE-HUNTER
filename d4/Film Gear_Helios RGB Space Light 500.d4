    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2700~10000" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="3000~3000" Colour="0,0,0" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="4800~4800" Colour="0,0,0" />
      <Function ID="5" Name="4300K" Display="'4300K'" Dmx="15100~15100" Colour="0,0,0" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="27200~27200" Colour="0,0,0" />
      <Function ID="7" Name="6000K" Display="'6000K'" Dmx="31000~31000" Colour="0,0,0" />
      <Function ID="8" Name="7000K" Display="'7000K'" Dmx="41000~41000" Colour="0,0,0" />
      <Function ID="9" Name="8000K" Display="'8000K'" Dmx="51000~51000" Colour="0,0,0" />
      <Function ID="10" Name="10000K" Display="'10000K'" Dmx="65535~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />

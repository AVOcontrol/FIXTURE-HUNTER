    <Attribute ID="Fan_Spd" Name="Fan Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Quiet Mode" Display="'Quiet Mode'" Dmx="10~49" />
      <Function ID="3" Name="Auto Mode" Display="'Auto Mode'" Dmx="50~99" />
      <Function ID="4" Name="Variable" Display="'Variable'" Dmx="100~150" />
      <Function ID="5" Name="Full Speed" Display="'Full Speed'" Dmx="151~175" />
      <Function ID="6" Name="Full Speed (Limit 80%)" Display="'Full Speed (Limit 80%)'" Dmx="176~200" />
      <Function ID="7" Name="Full Speed (Limit 60%)" Display="'Full Speed (Limit 60%)'" Dmx="201~225" />
      <Function ID="8" Name="Full Speed (Limit 40%)" Display="'Full Speed (Limit 40%)'" Dmx="226~249" />
      <Function ID="9" Name="Off" Display="'Off'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved3" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

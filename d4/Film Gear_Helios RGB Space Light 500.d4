    <Attribute ID="GN_Saturation1" Name="GN Saturation" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="5001~10000" Colour="0,0,0" />
      <Function ID="3" Name="-" Display="'- %.2f%%',99.00~1.00" Dmx="10001~29999" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="30000~40000" Colour="0,0,0" />
      <Function ID="5" Name="+" Display="'+ %.2f%%',1.00~99.00" Dmx="40001~59999" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="60000~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Xfade_W-&gt;Col" Name="Xfade W-&gt;Col" Description="" Group="I" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White&gt;Colour" Display="'White&gt;Colour %.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="White" Display="'White'" Dmx="0~0" />
      <Function ID="3" Name="Colour" Display="'Colour'" Dmx="65535~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />

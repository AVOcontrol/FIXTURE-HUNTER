  </RDM>
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Wired DMX" Display="'Wired DMX'" Dmx="10~14" />
      <Function ID="3" Name="Wireless DMX" Display="'Wireless DMX'" Dmx="15~19" />
      <Function ID="4" Name="P/T Speed" Display="'P/T Speed'" Dmx="50~59" />
      <Function ID="5" Name="P/T Time" Display="'P/T Time'" Dmx="60~69" />
      <Function ID="6" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="70~79" />
      <Function ID="7" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="80~89" />
      <Function ID="8" Name="Theatre Mode ON" Display="'Theatre Mode ON'" Dmx="90~99" />
      <Function ID="9" Name="Theatre Mode OFF" Display="'Theatre Mode OFF'" Dmx="100~109" />
      <Function ID="10" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="11" Name="Reset Zoom" Display="'Reset Zoom'" Dmx="180~189" />
      <Function ID="12" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="13" Name="Silent Fan OFF" Display="'Silent Fan OFF'" Dmx="240~240" />
      <Function ID="14" Name="Silent Fan" Display="'Silent Fan %.f%%',0~100" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Warm_White" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cool_White" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="1~2" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="3~4" />
      <Function ID="4" Name="3800K" Display="'3800K'" Dmx="5~6" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="7~8" />
      <Function ID="6" Name="4600K" Display="'4600K'" Dmx="9~10" />
      <Function ID="7" Name="5000K" Display="'5000K'" Dmx="11~12" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="13~14" />
      <Function ID="9" Name="6300K" Display="'6300K'" Dmx="15~16" />
      <Function ID="10" Name="CTO" Display="'CTO %.1f%%',0.0~100.0" Dmx="17~247" />
      <Function ID="11" Name="Rainbow w/fade" Display="'Rainbow w/fade'" Dmx="248~248" />
      <Function ID="12" Name="Rainbow" Display="'Rainbow'" Dmx="249~249" />
      <Function ID="13" Name="Zone FX 1" Display="'Zone FX 1'" Dmx="250~250" />
      <Function ID="14" Name="Zone FX 2" Display="'Zone FX 2'" Dmx="251~251" />
      <Function ID="15" Name="Zone FX 3" Display="'Zone FX 3'" Dmx="252~252" />
      <Function ID="16" Name="Zone FX 4" Display="'Zone FX 4'" Dmx="253~253" />
      <Function ID="17" Name="Zone FX 5" Display="'Zone FX 5'" Dmx="254~254" />
      <Function ID="18" Name="Zone FX 6" Display="'Zone FX 6'" Dmx="255~255" />

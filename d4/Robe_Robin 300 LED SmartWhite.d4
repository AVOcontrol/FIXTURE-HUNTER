    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strb All Zone" Display="'Strb All Zone %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Strb Zn 3" Display="'Strb Zn 3 %.f%%',0~100" Dmx="32~63" Intensity="0~0" />
      <Function ID="5" Name="Rnd All Zone" Display="'Rnd All Zone %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="6" Name="Rnd Zone" Display="'Rnd Zone %.f%%',0~100" Dmx="160~175" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strb + Zn" Display="'Rnd Strb + Zn %.f%%',0~100" Dmx="176~191" Intensity="0~0" />
      <Function ID="8" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="9" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
      <Function ID="10" Name="Zone FX FW" Display="'Zone FX FW %.f%%',0~100" Dmx="96~111" Intensity="0~0" />
      <Function ID="11" Name="Zone FX REV" Display="'Zone FX REV %.f%%',100~0" Dmx="112~127" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TwinBeam 2410" ShortName="TwnBm 2410" Company="Involight">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="02-07-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~10" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1 %.1f%%',0.0~100.0" Dmx="11~120" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2 %.1f%%',0.0~100.0" Dmx="121~243" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="244~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Combination" Display="'Combination %.1f%%',0.0~100.0" Dmx="11~127" Colour="255,255,255" />
      <Function ID="3" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="128~160" Colour="255,255,255" />
      <Function ID="4" Name="Gradual 1" Display="'Gradual 1 %.f%%',0~100" Dmx="161~200" Colour="255,255,255" />
      <Function ID="5" Name="Gradual 2" Display="'Gradual 2 %.f%%',0~100" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="150~200" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Tilt_Speed" Wheel="25" />
        <Attribute ID="Master_Dimmer" Wheel="5" />
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="1 Master" ChannelOffset="1" ModeLink="Control cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Master_Dimmer" TargetId="Master_Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell2" Name="1 LED 1" ChannelOffset="5" ModeLink="Dimmer cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="1 LED 2" ChannelOffset="6" ModeLink="Dimmer cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="1 LED 3" ChannelOffset="7" ModeLink="Dimmer cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="1 LED 4" ChannelOffset="8" ModeLink="Dimmer cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="2 Master" ChannelOffset="9" ModeLink="Control cell" X="0" Y="5">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Tilt_Speed" TargetId="Tilt_Speed" />
        <AttributeLink SourceId="Master_Dimmer" TargetId="Master_Dimmer" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
      </Cell>
      <Cell ID="Cell7" Name="2 LED 1" ChannelOffset="13" ModeLink="Dimmer cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="2 LED 2" ChannelOffset="14" ModeLink="Dimmer cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="2 LED 3" ChannelOffset="15" ModeLink="Dimmer cell" X="0" Y="8">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="2 LED 4" ChannelOffset="16" ModeLink="Dimmer cell" X="0" Y="9">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="18 DMX" Channels="18">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
        <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="23" />
        <Attribute ID="Colour_Macro" ChannelOffset="3" Wheel="7" />
        <Attribute ID="Col_Mac_Spd" ChannelOffset="4" Wheel="26" />
        <Attribute ID="Tilt" Wheel="3" />
        <Attribute ID="Tilt_Speed" ChannelOffset="7" Wheel="25" />
        <Attribute ID="Master_Dimmer" ChannelOffset="8" Wheel="5" />
        <Attribute ID="Shutter" ChannelOffset="9" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Control" ChannelOffset="18" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Tilt 1" ChannelOffset="5" ModeLink="Tilt cell" X="0" Y="0">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell2" Name="Tilt 2" ChannelOffset="6" ModeLink="Tilt cell" X="0" Y="1">
        <AttributeLink SourceId="Tilt" TargetId="Tilt" />
      </Cell>
      <Cell ID="Cell3" Name="LED 1" ChannelOffset="10" ModeLink="Dimmer cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="LED 2" ChannelOffset="11" ModeLink="Dimmer cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="LED 3" ChannelOffset="12" ModeLink="Dimmer cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="LED 4" ChannelOffset="13" ModeLink="Dimmer cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="LED 5" ChannelOffset="14" ModeLink="Dimmer cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="LED 6" ChannelOffset="15" ModeLink="Dimmer cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell9" Name="LED 7" ChannelOffset="16" ModeLink="Dimmer cell" X="0" Y="8">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell10" Name="LED 8" ChannelOffset="17" ModeLink="Dimmer cell" X="0" Y="9">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Control cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Master_Dimmer" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
      <Attribute ID="Tilt_Speed" ChannelOffset="2" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Dimmer cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Tilt cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Tilt" ChannelOffset="1" Wheel="3" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
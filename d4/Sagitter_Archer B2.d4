      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="71~75" WheelPosition="13" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="76~85" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="86~95" WheelPosition="2" />

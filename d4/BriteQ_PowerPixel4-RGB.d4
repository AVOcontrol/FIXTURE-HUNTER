<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PowerPixel4-RGB" ShortName="PowerPix 4" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="15-04-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="20-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="27-05-17" Author="Nic Morris" Comment="Added vdim to 15 DMX mode.  Changed name from PowerPixel4 to PowerPixel 4-RGB" />
  <History Date="27-05-17" Author="Nic Morris" Comment="Fixed shutter strobe DMX range.  Added compatibility for R20 export." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6fcfe458-170e-4c54-9879-431cc6e06596" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="5" Name="Red/ Green" Display="'Red/ Green'" Dmx="40~47" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="6" Name="Green/ Blue" Display="'Green/ Blue'" Dmx="48~55" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="7" Name="Red/ Blue" Display="'Red/ Blue'" Dmx="56~63" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="64~71" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Dimmer, Red, Green" Colour="0,0,0" />
      <Function ID="17" Name="CFade" Display="'CFade'" Dmx="136~143" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer, Red, Green" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer, Red, Green" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Condition Name="4 DMX" ID="4,5,6,7" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="6" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="191~200" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2,3,4,5,6,7,8,9" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="RB" Display="'RB'" Dmx="36~71" Colour="255,255,255" />
      <Function ID="4" Name="GB" Display="'GB'" Dmx="72~107" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="6" Name="B" Display="'B'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="7" Name="G" Display="'G'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="8" Name="R" Display="'R'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="9" Name="OFF" Display="'OFF'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Select" ID="2,3,4,5,6,7,8,9" If="'Colour_Macro'==28||'Colour_Macro'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="OFF" Display="'OFF'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="36~71" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="72~107" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="8" Name="RB" Display="'RB'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="9" Name="RGB" Display="'RGB'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="35~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="25~34" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="5~24" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

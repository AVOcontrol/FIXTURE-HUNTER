<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RGBL Series" ShortName="RGBL" Company="img Stage Line">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="21-11-07" Author="Ion Balan" Comment="Created" />
  <History Date="21-11-07" Author="Ion Balan" Comment="Checked" />
  <History Date="17-09-11" Author="Nic Morris" Comment="Aligned attribute ID numbers with attribute names.  Added Red1,Green1,Blue1 and replaced first cell in multi-cell modes." />
  <History Date="17-09-11" Author="Nic Morris" Comment="Renamed attributes.  Removed duplicate ID's.  Increased wheel resolution.  Adjusted wheel mapping." />
  <History Date="17-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added v-dim.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shows" Name="Shows" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Auto Fd" Display="'Auto Fd'" Dmx="0~28" Update="Control" />
      <Function ID="2" Name="Show" Display="'Show %.f',1~9" Dmx="29~255" Update="Control" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Safe" ID="1,2" If="'Shows'==1" />
      <Condition Name="Show" ID="3,4" If="'Shows'==2" />
      <Else ID="" />
      <Function ID="1" Name="RGB Cntr" Display="'RGB Cntr %.f%%',0~100" Dmx="0~15" />
      <Function ID="2" Name="Fade Spd" Display="'Fade Spd %.1f%%',0.0~100.0" Dmx="255~16" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="242~0" />
      <Function ID="4" Name="Mus Cntr" Display="'Mus Cntr %.f%%',0~100" Dmx="243~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>

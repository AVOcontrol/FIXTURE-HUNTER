<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Moving Yoke" ShortName="MY-1" Company="Denkriser">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="12-09-15" Author="Nic Morris" Comment="(created by customer - no documentation seen)" />
  <History Date="12-09-15" Author="Nic Morris" Comment="Fixed errors.  Added palettes.  Standardised mode name.  Added Pearl ref.  Added hilight/lolight" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="3~9" Colour="255,255,255" />
      <Function ID="2" Name="CTB" Display="'CTB'" Dmx="16~21" Colour="230,230,255" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="28~33" Colour="255,150,150" />
      <Function ID="4" Name="Light Pink" Display="'Light Pink'" Dmx="40~45" Colour="255,200,200" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="52~57" Colour="255,255,0" />
      <Function ID="6" Name="Deep Yellow" Display="'Yellow'" Dmx="64~70" Colour="180,180,0" />
      <Function ID="7" Name="CTO" Display="'CTO'" Dmx="77~82" Colour="255,240,200" />
      <Function ID="8" Name="Light Yellow" Display="'Yellow'" Dmx="89~94" Colour="255,255,128" />
      <Function ID="9" Name="Amber" Display="'Amber'" Dmx="101~106" Colour="255,100,0" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="113~118" Colour="255,0,255" />
      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="125~131" Colour="128,0,255" />
      <Function ID="12" Name="Surprise Pink" Display="'Surprise Pink'" Dmx="138~143" Colour="255,150,230" />
      <Function ID="13" Name="Red" Display="'Red'" Dmx="150~155" Colour="255,0,0" />
      <Function ID="14" Name="Amber" Display="'Amber'" Dmx="162~167" Colour="255,100,0" />
      <Function ID="15" Name="Light Magenta" Display="'Light Magenta'" Dmx="173~179" Colour="255,128,255" />
      <Function ID="16" Name="Cyan" Display="'Cyan'" Dmx="186~192" Colour="0,255,255" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="199~204" Colour="255,255,255" />
      <Function ID="18" Name="Green" Display="'Green'" Dmx="211~216" Colour="0,255,0" />
      <Function ID="19" Name="Blue" Display="'Blue'" Dmx="223~228" Colour="0,0,255" />
      <Function ID="20" Name="Purple" Display="'Purple'" Dmx="235~240" Colour="128,0,255" />
      <Function ID="21" Name="Steel" Display="'Steel'" Dmx="247~252" Colour="220,240,255" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKDRMY-1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="5" Wheel="7" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:13" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Colour1:9" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:5" />
      <Palette ID="5" Name="Deep Yellow" Number="0" Page="1" SetControl="Colour1:6" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:18" />
      <Palette ID="7" Name="Cyan" Number="0" Page="1" SetControl="Colour1:16" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:16" />
      <Palette ID="9" Name="Cyan" Number="0" Page="1" SetControl="Colour1:16" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:19" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:11" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:10" />
      <Palette ID="13" Name="Magenta" Number="0" Page="1" SetControl="Colour1:10" />
      <Palette ID="14" Name="Light Magenta" Number="8" Page="1" SetControl="Colour1:15" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:19" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
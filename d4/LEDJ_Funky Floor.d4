    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="18~18" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="19~37" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="3" Name="Colour Dream" Display="'Colour Dream'" Dmx="38~56" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="4" Name="Fading" Display="'Fading'" Dmx="57~75" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="5" Name="Colour Change" Display="'Colour Change'" Dmx="76~94" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="6" Name="Colour Jump" Display="'Colour Jump'" Dmx="95~113" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="7" Name="Flow 1" Display="'Flow 1'" Dmx="114~132" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="8" Name="Flow 2" Display="'Flow 2'" Dmx="133~151" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="9" Name="Chase 1" Display="'Chase 1'" Dmx="152~170" Update="Red, Green, Blue" Colour="0,0,0" />
      <Function ID="10" Name="Chase 2" Display="'Chase 2'" Dmx="171~189" Update="Red, Green, Blue" Colour="0,0,0" />

  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-10-11" Author="Nic Morris" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-01-17" Author="Nic Morris" Comment="Added conditions for 4 DMX mode." />
  <History Date="10-01-17" Author="Nic Morris" Comment="Added Atlabase ID to 4 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="35af4e89-71c6-4dad-a8e4-aee302ca684f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Shutter" ID="2" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Condition Name="No Function" ID="3" If="'Colour_Macro'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="''" Dmx="0~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="Col Select" ID="2" If="'Colour_Macro'==12||'Colour_Macro'==13" />
      <Condition Name="No Function" ID="3" If="'Colour_Macro'==2||'Colour_Macro'==3||'Colour_Macro'==4||'Colour_Macro'==5||'Colour_Macro'==6||'Colour_Macro'==7||'Colour_Macro'==8||'Colour_Macro'==9||'Colour_Macro'==10||'Colour_Macro'==11||'Colour_Macro'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="''" Dmx="0~0" Colour="0,0,0" />
    </Attribute>

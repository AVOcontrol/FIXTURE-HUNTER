<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Laser Show System" ShortName="Laser Show" Company="Unknown" Version="7">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="05-08-19" Author="Nic Morris" Comment="Created (note charts have conditional Manual/PRG/ILD ranges depending on channel 1 functions that are not listed)" Version="1" />
  <History Date="23-09-19" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request." Version="2" />
  <History Date="23-09-19" Author="Nic Morris" Comment="Created from Cyclops Comet 5000" Version="3" />
  <History Date="25-09-19" Author="Nic Morris" Comment="Inverted RGB and added virtual dimmer." Version="4" />
  <History Date="04-09-21" Author="Nic Morris" Comment="Created from Cyclops Comet 3000" Version="5" />
  <History Date="21-09-21" Author="Nic Morris" Comment="Added 21 channel Expert mode (not in manual. completely different. poor documentation - majority of controls missing function range details)" Version="6" />
  <History Date="08-09-22" Author="Nic Morris" Comment="Created from E-Lite JUNO RGB3000 (poor documentation)" Version="7" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Image" Name="Image" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Image_Size" Name="Image Size" Description="" Group="G">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Size" Display="'Size %.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="X Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y Pos" Description="" Group="P">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="7 Colour Select" Display="'7 Colour Select %.f%%',0~100" Dmx="0~63" Colour="255,255,255" />
      <Function ID="2" Name="Col Spd Change (1)" Display="'Col Spd Change (1) %.f%%',0~100" Dmx="64~95" Colour="255,255,255" />
      <Function ID="3" Name="Col Spd Change (2)" Display="'Col Spd Change (2) %.f%%',0~100" Dmx="96~127" Colour="255,255,255" />
      <Function ID="4" Name="Wave FX Spd (1)" Display="'Wave FX Spd (1) %.f%%',0~100" Dmx="128~159" Colour="0,0,0" />
      <Function ID="5" Name="Wave FX Spd (2)" Display="'Wave FX Spd (2) %.f%%',0~100" Dmx="160~191" Colour="0,0,0" />
      <Function ID="6" Name="Wave FX Spd (3)" Display="'Wave FX Spd (3) %.f%%',0~100" Dmx="192~223" Colour="0,0,0" />
      <Function ID="7" Name="Drawing Effect Spd" Display="'Drawing Effect Spd %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Flash" Name="Flash" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Image_Type" Name="Image Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Image_Spd" Name="Image Spd" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Auto Spd" Display="'Auto Spd %.1f%%',0.0~100.0" Dmx="0~127" WheelPosition="0" />
      <Function ID="2" Name="Sound Sensitivity" Display="'Sound Sensitivity %.1f%%',0.0~100.0" Dmx="128~255" WheelPosition="0" />
    </Attribute>
    <Attribute ID="Rotation" Name="Rotation" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X_Rot" Name="X Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y_Rot" Name="Y Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X_Move" Name="X Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Y_Move" Name="Y Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom1" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gradual_Draw" Name="Gradual Draw" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Draw Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Scan" Name="Scan" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Line Scan Spd" Display="'Line Scan Spd %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spot Scan Spd" Display="'Spot Scan Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X Wave Spd" Display="'X Wave Spd %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Y Wave Spd" Display="'Y Wave Spd %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="Normal, 12 DMX" Channels="12">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Image" ChannelOffset="5" Wheel="13" />
      <Attribute ID="Image_Size" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Pan" ChannelOffset="7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="8" Wheel="3" />
      <Attribute ID="Colour" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Flash" ChannelOffset="10" Wheel="5" />
      <Attribute ID="Image_Type" ChannelOffset="11" Wheel="15" />
      <Attribute ID="Image_Spd" ChannelOffset="12" Wheel="43" />
    </Include>
  </Mode>
  <Mode Name="Expert, 21 DMX" Channels="21">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Image" ChannelOffset="5" Wheel="13" />
      <Attribute ID="Image_Size" ChannelOffset="6" Wheel="14" />
      <Attribute ID="Pan" ChannelOffset="7" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="8" Wheel="3" />
      <Attribute ID="Colour" ChannelOffset="9" Wheel="8" />
      <Attribute ID="Flash" ChannelOffset="10" Wheel="5" />
      <Attribute ID="Image_Type" ChannelOffset="11" Wheel="15" />
      <Attribute ID="Image_Spd" ChannelOffset="12" Wheel="43" />
      <Attribute ID="Rotation" ChannelOffset="13" Wheel="19" />
      <Attribute ID="X_Rot" ChannelOffset="14" Wheel="20" />
      <Attribute ID="Y_Rot" ChannelOffset="15" Wheel="21" />
      <Attribute ID="X_Move" ChannelOffset="16" Wheel="49" />
      <Attribute ID="Y_Move" ChannelOffset="17" Wheel="50" />
      <Attribute ID="Zoom1" ChannelOffset="18" Wheel="51" />
      <Attribute ID="Gradual_Draw" ChannelOffset="19" Wheel="28" />
      <Attribute ID="Scan" ChannelOffset="20" Wheel="29" />
      <Attribute ID="Wave" ChannelOffset="21" Wheel="22" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary />
</Fixture>
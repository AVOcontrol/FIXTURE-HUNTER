    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Reset Specification" Display="'Reset Specification'" Dmx="15~29" />
      <Function ID="4" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~34" />
      <Function ID="5" Name="1.2kHz" Display="'1.2kHz'" Dmx="50~54" />
      <Function ID="6" Name="6kHz" Display="'6kHz'" Dmx="55~59" />
      <Function ID="7" Name="12kHz" Display="'12kHz'" Dmx="60~64" />
      <Function ID="8" Name="24kHz" Display="'24kHz'" Dmx="65~69" />
      <Function ID="9" Name="25kHz" Display="'25kHz'" Dmx="70~74" />
      <Function ID="10" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="80~84" />
      <Function ID="11" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="85~89" />
      <Function ID="12" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="90~94" />
      <Function ID="13" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="95~99" />
      <Function ID="14" Name="Scene Mode Theatre" Display="'Scene Mode Theatre'" Dmx="100~104" />
      <Function ID="15" Name="Scene Mode Quiet" Display="'Scene Mode Quiet'" Dmx="105~109" />
      <Function ID="16" Name="Scene Mode Auto" Display="'Scene Mode Auto'" Dmx="110~114" />
      <Function ID="17" Name="Scene Mode High" Display="'Scene Mode High'" Dmx="115~119" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Speed" Name="Colour Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Focus_Speed" Name="Focus Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Gobo_Speed" Name="Gobo Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Animation1" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Animation" Display="'Animation'" Dmx="1~10" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="11~130" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="131~133" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism 1 Index" Display="'Prism 1 Index'" Dmx="11~71" Update="Prism_Rot" />
      <Function ID="3" Name="Prism 1 Spin" Display="'Prism 1 Spin'" Dmx="72~133" Update="Prism_Rot" />
      <Function ID="4" Name="Prism 2 Index" Display="'Prism 2 Index'" Dmx="134~195" Update="Prism_Rot" />
      <Function ID="5" Name="Prism 2 Spin" Display="'Prism 2 Spin'" Dmx="196~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Index" ID="2" If="'Prism'==2||'Prism'==4" />
      <Condition Name="Spin" ID="3,4" If="'Prism'==3||'Prism'==5" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~192" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="191~128" />
    </Attribute>
  </Control>

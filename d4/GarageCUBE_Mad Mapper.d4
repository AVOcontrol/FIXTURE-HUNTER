<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mad Mapper" ShortName="Mad Mapper" Company="GarageCUBE">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="14-08-12" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="BGHighlight" Name="BG Highlight" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Test_Pattern" Name="Test Pattern" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Media" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Media" Display="'Media %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Play" Name="Play" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Play" Display="'Play'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Beginning" Name="Beginning" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Loop" Name="Loop" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Scrub" Name="Scrub" Description="" Group="S" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Scrub" Display="'Scrub %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Preset" Name="Preset" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Preset" Display="'Preset %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Opacity" Name="Opacity" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Opacity" Display="'Opacity %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Blend_Mode" Name="Blend Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Ignore Alpha" Display="'Ignore Alpha'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Add" Display="'Add'" Dmx="1~1" Colour="0,0,0" />
      <Function ID="3" Name="Over" Display="'Over'" Dmx="2~2" Colour="0,0,0" />
      <Function ID="4" Name="Over Pre-Multiplied" Display="'Over Pre-Multiplied'" Dmx="3~3" Colour="0,0,0" />
      <Function ID="5" Name="Reserved" Display="'Reserved %.f',4~255" Dmx="4~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Flip" Name="Flip" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Flip" Display="'No Flip'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Horizontal" Display="'Horizontal'" Dmx="1~1" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Horizontal+Vertical" Display="'Horizontal+Vertical'" Dmx="2~2" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Vertical" Display="'Vertical'" Dmx="3~3" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Reserved" Display="'Reserved %.f',4~255" Dmx="4~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="Master" Channels="3">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="BGHighlight" ChannelOffset="2" Wheel="28" />
      <Attribute ID="Test_Pattern" ChannelOffset="3" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="Media" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Gobo1" ChannelOffset="1" Wheel="14" />
      <Attribute ID="Play" ChannelOffset="2" Wheel="28" />
      <Attribute ID="Beginning" ChannelOffset="3" Wheel="29" />
      <Attribute ID="Loop" ChannelOffset="4" Wheel="30" />
      <Attribute ID="Scrub" ChannelOffset="5,6" Wheel="26" />
      <Attribute ID="Preset" ChannelOffset="7" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="Surface" Channels="7">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Opacity" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Blend_Mode" ChannelOffset="3" Wheel="7" />
      <Attribute ID="Red" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="7" Wheel="12" />
      <Attribute ID="Flip" ChannelOffset="4" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
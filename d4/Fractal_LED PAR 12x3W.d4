  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0183f93d-bcbd-450e-9b8d-9351580ced5a" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="11~50" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~255" />
      <Function ID="4" Name="Jump" Display="'Jump %.f%%',0~100" Dmx="51~100" />
      <Function ID="5" Name="Gradient" Display="'Gradient %.f%%',0~100" Dmx="101~150" />
      <Function ID="6" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="151~200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~59" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="60~69" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="70~79" Colour="255,255,255" />

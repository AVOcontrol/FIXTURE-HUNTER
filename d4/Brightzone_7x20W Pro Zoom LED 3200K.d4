<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="7x20W Pro Zoom LED 3200K" ShortName="ProZm3200K" Company="Brightzone">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-08-17" Author="Nic Morris" Comment="Created" />
  <History Date="11-08-17" Author="Nic Morris" Comment="Split colour temperature options for Capture." />
  <History Date="11-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5a6a0912-3343-40b0-8f98-36250be0bde3" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Curve 1" Display="'Curve 1'" Dmx="0~0" />
      <Function ID="2" Name="Curve 2" Display="'Curve 2'" Dmx="64~127" />
      <Function ID="3" Name="Curve 3" Display="'Curve 3'" Dmx="128~191" />
      <Function ID="4" Name="Curve 4" Display="'Curve 4'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:49" PowerOn="1:49" />
      <Function ID="1" Name="Zoom" Display="'%.1f°',28.0~70.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKBNPZW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f4610fee-c878-4f82-b722-6c5e1b339cd2" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dim_Spd" ChannelOffset="4" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:28" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:49" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:70" />
    </Group>
  </Palettes>
</Fixture>
      <Function ID="4" Name="Fade Sound" Display="'Fade Sound %.f%%',0~100" Dmx="130~189" />
      <Function ID="5" Name="Change Sound" Display="'Change Sound %.f%%',0~100" Dmx="190~255" />
    </Attribute>
  </Control>

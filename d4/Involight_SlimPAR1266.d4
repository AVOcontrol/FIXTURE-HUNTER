      <Function ID="3" Name="Green" Display="'Green %.f%%',0~100" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White %.f%%',0~100" Dmx="40~49" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber %.f%%',0~100" Dmx="50~59" Colour="255,100,0" />
      <Function ID="7" Name="UV" Display="'UV %.f%%',0~100" Dmx="60~69" Colour="180,0,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="70~79" Colour="255,255,0" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="80~89" Colour="255,0,255" />
      <Function ID="10" Name="Cyan" Display="'Cyan'" Dmx="90~99" Colour="0,255,255" />
      <Function ID="11" Name="Dark Orange" Display="'Dark Orange'" Dmx="100~109" Colour="255,100,0" />

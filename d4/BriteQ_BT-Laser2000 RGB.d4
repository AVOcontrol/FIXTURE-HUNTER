  <Thumbnail>c514d05c-bd84-4b7b-a1d9-7756da518751</Thumbnail>
  <History Date="28-02-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-01-22" Author="Nic Morris" Comment="Created from CR-Laser Surpass-7mk3" Version="2" />
  <History Date="19-07-22" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (adds 17 channel mode)" Version="3" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Gobo1, Shutter" />
      <Function ID="2" Name="PRG show" Display="'PRG show'" Dmx="74~110" Update="Gobo1, Shutter" />
      <Function ID="3" Name="ILD show" Display="'ILD show'" Dmx="111~147" Update="Gobo1, Shutter" />
      <Function ID="4" Name="Auto Show 1" Display="'Auto Show 1'" Dmx="148~165" Update="Gobo1, Shutter" />
      <Function ID="5" Name="Auto Show 2" Display="'Auto Show 2'" Dmx="166~184" Update="Gobo1, Shutter" />
      <Function ID="6" Name="Music Show 1" Display="'Music Show 1'" Dmx="185~202" Update="Gobo1, Shutter" />
      <Function ID="7" Name="Music Show 2" Display="'Music Show 2'" Dmx="203~221" Update="Gobo1, Shutter" />
      <Function ID="8" Name="DMX Mode" Display="'DMX Mode'" Dmx="222~255" Update="Gobo1, Shutter" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Folders" ID="2" If="'Mode'==2||'Mode'==3" />
      <Else ID="1" />
      <Function ID="1" Name="Patterns" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folders" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Shows" ID="5" If="'Mode'==2||'Mode'==3" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" Intensity="0~0" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~255" Intensity="0~0" />
      <Function ID="5" Name="Shows" Display="'%.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="X-Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="X Position" Display="'X Position %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Random Spd" Display="'Random Spd'" Dmx="186~225" />
      <Function ID="4" Name="Random Pos" Display="'Random Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Y-Moving" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Y Position" Display="'Y Position %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Random Spd" Display="'Random Spd'" Dmx="186~225" />
      <Function ID="4" Name="Random Pos" Display="'Random Pos'" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="11~87" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="88~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom In" Display="'Zoom In %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Bounce" Display="'Bounce %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y_Roll" Name="Y Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="129~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X_Roll" Name="X Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="129~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Z_Roll" Name="Z Roll" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="129~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="193~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Clipping" Name="Clipping" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.f%%',0~100" Dmx="10~74" />
      <Function ID="3" Name="Clip Out" Display="'Clip Out %.f%%',0~100" Dmx="75~104" />
      <Function ID="4" Name="Clip In" Display="'Clip In %.f%%',0~100" Dmx="105~144" />
      <Function ID="5" Name="Clip In/ Out" Display="'Clip In/ Out %.f%%',0~100" Dmx="145~184" />
      <Function ID="6" Name="Clip On" Display="'Clip On %.f%%',0~100" Dmx="185~224" />
      <Function ID="7" Name="Clip Off" Display="'Clip Off %.f%%',0~100" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~189" />
      <Function ID="3" Name="Size" Display="'Size %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="White" Display="'White'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="WRGB fixed" Display="'WRGB fixed'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="BYPC fixed" Display="'BYPC fixed'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="7 Col" Display="'7 Col'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="WRGB loop" Display="'WRGB loop'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="BYPC loop" Display="'BYPC loop'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="7 Col loop" Display="'7 Col loop'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dots" Name="Dots" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Bright Dots" Display="'Bright Dots'" Dmx="64~127" />
      <Function ID="3" Name="Blanking" Display="'Blanking'" Dmx="128~191" />
      <Function ID="4" Name="Points" Display="'Points'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Mode1" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="PRG show" Display="'PRG show'" Dmx="74~110" />
      <Function ID="3" Name="ILD show" Display="'ILD show'" Dmx="111~147" />
      <Function ID="4" Name="Auto Show 1" Display="'Auto Show 1'" Dmx="148~165" />
      <Function ID="5" Name="Auto Show 2" Display="'Auto Show 2'" Dmx="166~184" />
      <Function ID="6" Name="Music Show 1" Display="'Music Show 1'" Dmx="185~202" />
      <Function ID="7" Name="Music Show 2" Display="'Music Show 2'" Dmx="203~255" />
    </Attribute>
    <Attribute ID="X-Wave" Name="X-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~189" />
      <Function ID="3" Name="Size" Display="'Size %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Y-Wave" Name="Y-Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~189" />
      <Function ID="3" Name="Size" Display="'Size %.f%%',0~100" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">

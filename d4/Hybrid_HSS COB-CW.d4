<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HSS COB-CW" ShortName="HSS COB-CW" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>77aa4718-0b81-4e56-82e1-5fd10d318e0e</Thumbnail>
  <History Date="10-04-19" Author="Nic Morris" Comment="Created" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="29006e14-1395-48c1-ac7b-f410a09363fe" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="6~180" Update="Dimmer" />
      <Function ID="3" Name="Sound 1" Display="'Sound 1'" Dmx="181~205" Update="Dimmer" />
      <Function ID="4" Name="Sound 2" Display="'Sound 2'" Dmx="206~230" Update="Dimmer" />
      <Function ID="5" Name="Sound 3" Display="'Sound 3'" Dmx="231~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Auto'==2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;2" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4fa6e98e-a3e7-4c5a-b66c-ff9f6c18a324" />
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="ColdWhite" ChannelOffset="4" Wheel="7" />
      <Attribute ID="WarmWhite" ChannelOffset="5" Wheel="8" />
    </Include>
  </Mode>
  <swatchLibrary>
    <Swatch id="77aa4718-0b81-4e56-82e1-5fd10d318e0e"></Swatch>
  </swatchLibrary>
</Fixture>
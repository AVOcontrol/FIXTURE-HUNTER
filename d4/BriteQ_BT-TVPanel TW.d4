  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d675cba6-f44c-443b-ad65-2135b7a3cc23" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2800K" Display="'2800K'" Dmx="6~10" Colour="255,255,255" />
      <Function ID="3" Name="3000K" Display="'3000K'" Dmx="11~15" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="16~20" Colour="255,255,255" />
      <Function ID="5" Name="4000K" Display="'4000K'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="6" Name="4300K" Display="'4300K'" Dmx="26~30" Colour="255,255,255" />
      <Function ID="7" Name="5600K" Display="'5600K'" Dmx="31~35" Colour="255,255,255" />
      <Function ID="8" Name="WW-&gt;CW" Display="'WW-&gt;CW %.1f%%',0.0~100.0" Dmx="36~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~125" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="131~250" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Spd" Display="'Dim Spd %.f%%',0~100" Dmx="6~105" />
      <Function ID="3" Name="Fan Low" Display="'Fan Low'" Dmx="111~115" />
      <Function ID="4" Name="Fan Auto" Display="'Fan Auto'" Dmx="116~120" />
      <Function ID="5" Name="Dim Linear" Display="'Dim Linear'" Dmx="126~130" />
      <Function ID="6" Name="Dim Square" Display="'Dim Square'" Dmx="131~135" />
      <Function ID="7" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="136~140" />
      <Function ID="8" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="141~145" />
      <Function ID="9" Name="Refresh Rate 900Hz" Display="'Refresh Rate 900Hz'" Dmx="151~155" />
      <Function ID="10" Name="Refresh Rate 1000Hz" Display="'Refresh Rate 1000Hz'" Dmx="156~160" />
      <Function ID="11" Name="Refresh Rate 1100Hz" Display="'Refresh Rate 1100Hz'" Dmx="161~165" />
      <Function ID="12" Name="Refresh Rate 1200Hz" Display="'Refresh Rate 1200Hz'" Dmx="166~170" />
      <Function ID="13" Name="Refresh Rate 1300Hz" Display="'Refresh Rate 1300Hz'" Dmx="171~175" />
      <Function ID="14" Name="Refresh Rate 1400Hz" Display="'Refresh Rate 1400Hz'" Dmx="176~180" />
      <Function ID="15" Name="Refresh Rate 1500Hz" Display="'Refresh Rate 1500Hz'" Dmx="181~185" />
      <Function ID="16" Name="Refresh Rate 2500Hz" Display="'Refresh Rate 2500Hz'" Dmx="186~190" />
      <Function ID="17" Name="Refresh Rate 4000Hz" Display="'Refresh Rate 4000Hz'" Dmx="191~195" />
      <Function ID="18" Name="Refresh Rate 5000Hz" Display="'Refresh Rate 5000Hz'" Dmx="196~200" />
      <Function ID="19" Name="Refresh Rate 10000Hz" Display="'Refresh Rate 10000Hz'" Dmx="201~205" />
      <Function ID="20" Name="Refresh Rate 15000Hz" Display="'Refresh Rate 15000Hz'" Dmx="206~210" />
      <Function ID="21" Name="Refresh Rate 20000Hz" Display="'Refresh Rate 20000Hz'" Dmx="211~215" />
      <Function ID="22" Name="Refresh Rate 25000Hz" Display="'Refresh Rate 25000Hz'" Dmx="216~220" />
    </Attribute>
  </Control>
  <Mode Name="8Bit CCT, 2 DMX" Channels="2">

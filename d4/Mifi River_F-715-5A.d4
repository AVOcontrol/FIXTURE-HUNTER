      <Function ID="2" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="1~120" Colour="255,255,255" />
      <Function ID="3" Name="Auto Spd" Display="'Auto Spd %.1f%%',0.0~100.0" Dmx="121~255" Colour="255,255,255" />

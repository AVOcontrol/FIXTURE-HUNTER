<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Spin4" ShortName="Spin4" Company="KAM">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-02-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="10~120" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="121~134" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="135~245" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="9~24" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="25~41" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="42~57" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="58~74" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="75~90" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="91~107" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="108~123" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="124~140" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="141~156" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="157~173" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="174~189" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="190~206" Colour="255,255,255" />
      <Function ID="14" Name="R+B+W" Display="'R+B+W'" Dmx="207~222" Colour="255,255,255" />
      <Function ID="15" Name="G+B+W" Display="'G+B+W'" Dmx="223~239" Colour="255,255,255" />
      <Function ID="16" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~37" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="38~67" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="68~97" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="98~127" />
      <Function ID="6" Name="Show 5" Display="'Show 5'" Dmx="128~157" />
      <Function ID="7" Name="Show 6" Display="'Show 6'" Dmx="158~187" />
      <Function ID="8" Name="Show 7" Display="'Show 7'" Dmx="188~217" />
      <Function ID="9" Name="Show 8" Display="'Show 8'" Dmx="218~247" />
      <Function ID="10" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="KASPIN41" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Show" ChannelOffset="1" Wheel="22" />
    </Include>
  </Mode>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
        <Attribute ID="Rotate" Wheel="19" />
        <Attribute ID="Colour1" Wheel="7" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="3" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="5" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="7" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="9" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Rotate" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
</Fixture>
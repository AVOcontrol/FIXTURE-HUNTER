<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORstrip" ShortName="Col Strip" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="14-07-08" Author="David Hunt" Comment="Created" />
  <History Date="26-01-09" Author="D4 Personality Fixer 2009" Comment="Modified Condition statements" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated fixture type from nothing to fixed" />
  <History Date="12-02-13" Author="Peter Budd" Comment="Added virtual dimmer channel." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="11-04-14" Author="Nic Morris" Comment="Changed control to Colour Macro and setl to default to RGB Mode." />
  <History Date="11-04-14" Author="Nic Morris" Comment="Re-built RGB and conditions.  Added palettes.  Re-built mode and re-exported r20 in attempt to fix customer bug report." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="07-09-17" Author="Nic Morris" Comment="Changed name from ColourStrip to COLORstrip.  Revised Atlabase mode ID (was using 'auto' version.  changed to 'RGB')." />
  <History Date="07-09-17" Author="Nic Morris" Comment="Changed colour macros to variable ranges and revised names." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f363ee7d-1de9-4941-a2d8-39b5594eb29b" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Mode" Display="'RGB Mode'" Dmx="210~219" Update="Red, Green" Colour="0,0,0" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Red, Green" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red %.f%%',0~100" Dmx="10~19" Update="Red, Green" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green %.f%%',0~100" Dmx="20~29" Update="Red, Green" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue %.f%%',0~100" Dmx="30~39" Update="Red, Green" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow %.f%%',0~100" Dmx="40~49" Update="Red, Green" Colour="255,255,0" />
      <Function ID="7" Name="Magenta" Display="'Magenta %.f%%',0~100" Dmx="50~59" Update="Red, Green" Colour="128,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan %.f%%',0~100" Dmx="60~69" Update="Red, Green" Colour="0,255,255" />
      <Function ID="9" Name="White" Display="'White %.f%%',0~100" Dmx="70~79" Update="Red, Green" Colour="255,255,255" />
      <Function ID="10" Name="Colour Chase 1" Display="'Colour Chase 1'" Dmx="80~89" Update="Red, Green" Colour="0,0,0" />
      <Function ID="11" Name="Colour Chase 2" Display="'Colour Chase 2'" Dmx="90~99" Update="Red, Green" Colour="0,0,0" />
      <Function ID="12" Name="Colour Chase 3" Display="'Colour Chase 3'" Dmx="100~109" Update="Red, Green" Colour="0,0,0" />
      <Function ID="13" Name="Colour Chase 4" Display="'Colour Chase 4'" Dmx="110~119" Update="Red, Green" Colour="0,0,0" />
      <Function ID="14" Name="Colour Chase 5" Display="'Colour Chase 5'" Dmx="120~129" Update="Red, Green" Colour="0,0,0" />
      <Function ID="15" Name="Colour Chase 6" Display="'Colour Chase 6'" Dmx="130~139" Update="Red, Green" Colour="0,0,0" />
      <Function ID="16" Name="Colour Chase 7" Display="'Colour Chase 7'" Dmx="140~149" Update="Red, Green" Colour="0,0,0" />
      <Function ID="17" Name="Colour Chase 8" Display="'Colour Chase 8'" Dmx="150~159" Update="Red, Green" Colour="0,0,0" />
      <Function ID="18" Name="Colour Chase 9" Display="'Colour Chase 9'" Dmx="160~169" Update="Red, Green" Colour="0,0,0" />
      <Function ID="19" Name="Colour Chase 10" Display="'Colour Chase 10'" Dmx="170~179" Update="Red, Green" Colour="0,0,0" />
      <Function ID="20" Name="Colour Chase 11" Display="'Colour Chase 11'" Dmx="180~189" Update="Red, Green" Colour="0,0,0" />
      <Function ID="21" Name="Colour Chase 12" Display="'Colour Chase 12'" Dmx="190~199" Update="Red, Green" Colour="0,0,0" />
      <Function ID="22" Name="Colour Chase 13" Display="'Colour Chase 13'" Dmx="200~209" Update="Red, Green" Colour="0,0,0" />
      <Function ID="23" Name="Colour Fade" Display="'Colour Fade'" Dmx="220~229" Update="Red, Green" Colour="0,0,0" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="230~255" Update="Red, Green" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Auto" ID="2,3" If="'Colour_Macro'&gt;9&amp;&amp;'Colour_Macro'&lt;23" />
      <Condition Name="Fade" ID="4" If="'Colour_Macro'==23" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Run Speed" Display="'Run Speed %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="128~255" Colour="255,255,255" />
      <Function ID="4" Name="Fade Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Shutter" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~249" Colour="255,255,255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CHCOLSTR" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2dcb1930-c2a9-46f1-bf89-20b0f86f09fb" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Striker 10" ShortName="Striker 10" Company="Stagg">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="27-11-13" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blinder" Display="'Blinder'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter_Macro" Name="Shutter Macro" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.f%%',0~100" Dmx="6~42" Intensity="0~0" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.f%%',0~100" Dmx="43~79" Intensity="0~0" />
      <Function ID="4" Name="Fade In/ Out" Display="'Fade In/ Out %.f%%',0~100" Dmx="80~116" Intensity="0~0" />
      <Function ID="5" Name="Strb In/ Fd Out" Display="'Strb In/ Fd Out %.f%%',0~100" Dmx="117~153" Intensity="0~0" />
      <Function ID="6" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="154~190" Intensity="0~0" />
      <Function ID="7" Name="Strobe Slow" Display="'Strobe Slow %.f%%',0~100" Dmx="191~227" Intensity="0~0" />
      <Function ID="8" Name="Blind/ Strobe" Display="'Blind/ Strobe %.f%%',0~100" Dmx="228~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="SASTR101" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SASTR103" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter1" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Shutter_Macro" ChannelOffset="3" Wheel="5" />
    </Include>
  </Mode>
</Fixture>
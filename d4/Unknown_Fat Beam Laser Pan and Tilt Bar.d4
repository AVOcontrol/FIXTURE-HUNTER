        <Attribute ID="Tilt" ChannelOffset="9" Wheel="3" />
        <Attribute ID="Tilt_Speed" ChannelOffset="10" Wheel="26" />
        <Attribute ID="P/T_Macro" ChannelOffset="11" Wheel="22" />
        <Attribute ID="P/T_Mac_Spd" ChannelOffset="12" Wheel="23" />
        <Attribute ID="Dimmer" ChannelOffset="13" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="14" Wheel="5" />
        <Attribute ID="Red" ChannelOffset="15" Wheel="10" />
        <Attribute ID="Green" ChannelOffset="16" Wheel="11" />
        <Attribute ID="Blue" ChannelOffset="17" Wheel="12" />
        <Attribute ID="Auto" ChannelOffset="24" Wheel="52" />

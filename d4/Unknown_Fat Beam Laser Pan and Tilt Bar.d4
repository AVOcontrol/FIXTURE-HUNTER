      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="6" ModeLink="TiltCol cell" X="0" Y="3">
        <AttributeLink SourceId="All_Head_Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="7" ModeLink="TiltCol cell" X="0" Y="4">
        <AttributeLink SourceId="All_Head_Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="8" ModeLink="TiltCol cell" X="0" Y="5">
        <AttributeLink SourceId="All_Head_Tilt" TargetId="Tilt" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
      </Cell>
    </Cells>

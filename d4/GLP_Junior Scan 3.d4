      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="32~63" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="64~67" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 1" Display="'Gobo 1'" Dmx="68~71" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2" Display="'Gobo 2'" Dmx="72~75" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 3" Display="'Gobo 3'" Dmx="76~79" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 4" Display="'Gobo 4'" Dmx="80~83" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 5" Display="'Gobo 5'" Dmx="84~87" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6" Display="'Gobo 6'" Dmx="88~91" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 7" Display="'Gobo 7'" Dmx="92~95" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 8" Display="'Gobo 8'" Dmx="96~127" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="191~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="253~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="24" Name="Audio Slow" Display="'Audio Slow'" Dmx="254~254" GoboSpin="0~0" GoboOrientation="0~0" />

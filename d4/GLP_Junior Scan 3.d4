      <Function ID="9" Name="Neon Green" Display="'Neon Green'" Dmx="32~33" WheelPosition="8" Colour="128,255,0" />
      <Function ID="10" Name="UV Blue" Display="'UV Blue'" Dmx="36~37" WheelPosition="9" Colour="180,0,255" />
      <Function ID="11" Name="Dark Blue" Display="'Deep Blue'" Dmx="40~41" WheelPosition="10" Colour="0,0,180" />

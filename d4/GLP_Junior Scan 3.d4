      <Function ID="13" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fast" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Slow" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==7||'Gobo1Func'==8||'Gobo1Func'==9" />
      <Condition Name="Audio" ID="23,24,25" If="'Gobo1Func'==10||'Gobo1Func'==11||'Gobo1Func'==12" />
      <Else ID="26" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="4~7" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="8~11" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="12~15" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />

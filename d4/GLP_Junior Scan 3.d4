    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==2||'Gobo1Func'==7||'Gobo1Func'==10" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==3||'Gobo1Func'==4||'Gobo1Func'==8||'Gobo1Func'==11" />
      <Condition Name="Audio" ID="6,7" If="'Gobo1Func'==5||'Gobo1Func'==6||'Gobo1Func'==9||'Gobo1Func'==12" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~131" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~132" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="253~192" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Audio Slow" Display="'Audio Slow'" Dmx="254~254" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Audio Fast" Display="'Audio Fast'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="6~129" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="191~130" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="253~192" />

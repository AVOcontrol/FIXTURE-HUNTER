  <AtlaBase TypeID="6765de2e-0c0d-49bb-be91-95c76de6f477" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="21~25" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="26~30" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~35" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="36~40" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="41~45" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="46~50" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="51~55" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B" Display="'R+G+B'" Dmx="56~60" Colour="255,255,255" />
      <Function ID="10" Name="Colour Macro 1" Display="'Colour Macro 1'" Dmx="61~90" Colour="0,0,0" />
      <Function ID="11" Name="Colour Macro 2" Display="'Colour Macro 2'" Dmx="91~120" Colour="0,0,0" />
      <Function ID="12" Name="Colour Macro 3" Display="'Colour Macro 3'" Dmx="121~150" Colour="0,0,0" />
      <Function ID="13" Name="Colour Macro 4" Display="'Colour Macro 4'" Dmx="151~180" Colour="0,0,0" />
      <Function ID="14" Name="Colour Macro 5" Display="'Colour Macro 5'" Dmx="181~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

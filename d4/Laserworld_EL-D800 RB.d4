      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~150" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.1f%%',0.0~100.0" Dmx="151~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />

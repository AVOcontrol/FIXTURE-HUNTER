    </Attribute>
    <Attribute ID="Control1" Name="Control" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~63" />
      <Function ID="2" Name="DMX" Display="'DMX'" Dmx="64~139" />
      <Function ID="3" Name="Automatic" Display="'Automatic'" Dmx="140~209" />
      <Function ID="4" Name="Laser Off" Display="'Laser Off'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />

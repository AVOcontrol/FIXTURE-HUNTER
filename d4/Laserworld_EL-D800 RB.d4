  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Gobo1" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Point Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed1" Name="Line Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />

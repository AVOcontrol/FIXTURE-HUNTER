    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~15" />
      <Function ID="2" Name="Sound 1" Display="'Sound 1'" Dmx="16~100" />
      <Function ID="3" Name="Sound 2" Display="'Sound 2'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="RGBW_Red" Name="RGBW Red" Description="" Group="C">

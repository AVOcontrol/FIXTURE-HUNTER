  <Thumbnail>d4d7e5b8-0b3f-4341-ad15-ebab45230b54</Thumbnail>
  <History Date="12-09-24" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="6d3ab011-a6ff-45af-8b45-fe710b445846" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4,5,6,7,8" />
      <Condition Name="Speed" ID="9,10" If="'Auto'&gt;1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~45" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="46~80" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="81~115" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="116~150" Colour="255,255,0" />
      <Function ID="6" Name="Magenta" Display="'Magenta'" Dmx="151~185" Colour="255,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="186~220" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="221~255" Colour="255,255,255" />
      <Function ID="9" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" Colour="0,0,0" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Colour1" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="6~20" Update="Colour1" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="21~35" Update="Colour1" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="36~50" Update="Colour1" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="51~65" Update="Colour1" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="66~80" Update="Colour1" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="81~95" Update="Colour1" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="96~110" Update="Colour1" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~125" Update="Colour1" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="126~140" Update="Colour1" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="141~155" Update="Colour1" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="156~170" Update="Colour1" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="171~185" Update="Colour1" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="186~200" Update="Colour1" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="201~215" Update="Colour1" />
      <Function ID="16" Name="Auto 15" Display="'Auto 15'" Dmx="216~230" Update="Colour1" />
      <Function ID="17" Name="Auto 16" Display="'Auto 16'" Dmx="231~255" Update="Colour1" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="e43fa6c2-cac9-4df9-ad8e-eac84b10e87a">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

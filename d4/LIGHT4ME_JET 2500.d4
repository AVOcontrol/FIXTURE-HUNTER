    <AtlaBase ModeID="e9d55493-ff1a-47e8-8be1-cedda2e0619b" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="7" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Colour_Macro" Wheel="9" />

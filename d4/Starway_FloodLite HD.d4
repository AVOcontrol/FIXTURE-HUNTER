  <AtlaBase TypeID="e7b3ba61-5719-4db6-9a1d-80467faf7d66" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~240" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 10000K" Display="'White 10000K'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="White 8000K" Display="'White 8000K'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="White 6500K" Display="'White 6500K'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="White 5600K" Display="'White 5600K'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="White 5000K" Display="'White 5000K'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="White 4500K" Display="'White 4500K'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="8" Name="White 4000K" Display="'White 4000K'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="White 3200K" Display="'White 3200K'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="10" Name="White 3000K" Display="'White 3000K'" Dmx="9~9" Colour="255,255,255" />
      <Function ID="11" Name="White 2700K" Display="'White 2700K'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="12" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~251" Colour="255,255,255" />
      <Function ID="13" Name="Scroll FWD 1" Display="'Scroll FWD 1'" Dmx="252~252" Colour="255,255,255" />
      <Function ID="14" Name="Scroll FWD 2" Display="'Scroll FWD 2'" Dmx="253~253" Colour="255,255,255" />
      <Function ID="15" Name="Scroll REV 1" Display="'Scroll REV 1'" Dmx="254~254" Colour="255,255,255" />
      <Function ID="16" Name="Scroll REV 2" Display="'Scroll REV 2'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Tungsten" Display="'Tungsten'" Dmx="36~41" />
      <Function ID="3" Name="Ramp Up" Display="'Ramp Up'" Dmx="42~71" />
      <Function ID="4" Name="Ramp Down" Display="'Ramp Down'" Dmx="72~107" />
      <Function ID="5" Name="Ramp Up/Down" Display="'Ramp Up/Down'" Dmx="108~143" />
      <Function ID="6" Name="4 Colours" Display="'4 Colours'" Dmx="144~215" />
      <Function ID="7" Name="Random" Display="'Random'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Square" Display="'Square'" Dmx="64~127" />
      <Function ID="3" Name="Inv Square" Display="'Inv Square'" Dmx="128~191" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dim_Spd1" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

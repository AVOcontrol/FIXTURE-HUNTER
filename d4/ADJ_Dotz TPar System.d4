  <History Date="23-06-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="23-09-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added vdim to 18 channel mode cells." Version="2" />
  <History Date="30-03-23" Author="Nic Morris" Comment="Revised so that the colour macro dependencies in the 18 channel mode affect the master dimmer rather than the virtual cell dimmer in attempt to fix customer bug report." Version="3" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Dotz TPar System.d4 to ADJ_Dotz TPar System.d4." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c572630d-ae58-48d5-9eca-7e840d4c0767" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Dimmer" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Dimmer" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Dimmer" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="40~47" Update="Dimmer" Colour="255,255,255" />
      <Function ID="6" Name="G+B" Display="'G+B'" Dmx="48~55" Update="Dimmer" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="56~63" Update="Dimmer" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="64~71" Update="Dimmer" Colour="255,255,255" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Dimmer" Colour="0,0,0" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Dimmer" Colour="0,0,0" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Dimmer" Colour="0,0,0" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Dimmer" Colour="0,0,0" />

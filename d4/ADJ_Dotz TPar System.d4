      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Master_Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Col Fade 1" Display="'Col Fade 1'" Dmx="136~143" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Col Snake" Display="'Col Snake'" Dmx="144~151" Update="Master_Dimmer" Colour="255,255,255" />

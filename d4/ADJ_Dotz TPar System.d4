      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Dimmer" Colour="0,0,0" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Dimmer" Colour="0,0,0" />
      <Function ID="17" Name="Col Fade 1" Display="'Col Fade 1'" Dmx="136~143" Update="Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Col Snake" Display="'Col Snake'" Dmx="144~151" Update="Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Col Fade 2" Display="'Col Fade 2'" Dmx="152~159" Update="Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Col Change" Display="'Col Change'" Dmx="160~167" Update="Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Col Flow 1" Display="'Col Flow 1'" Dmx="168~175" Update="Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Col Flow 2" Display="'Col Flow 2'" Dmx="176~183" Update="Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Col Flow 3" Display="'Col Flow 3'" Dmx="184~191" Update="Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Col Flow 4" Display="'Col Flow 4'" Dmx="192~199" Update="Dimmer" Colour="255,255,255" />
      <Function ID="25" Name="Col Flow 5" Display="'Col Flow 5'" Dmx="200~207" Update="Dimmer" Colour="255,255,255" />
      <Function ID="26" Name="Col Flow 6" Display="'Col Flow 6'" Dmx="208~215" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Col Flow 7" Display="'Col Flow 7'" Dmx="216~223" Update="Dimmer" Colour="255,255,255" />
      <Function ID="28" Name="Col Flow 8" Display="'Col Flow 8'" Dmx="224~231" Update="Dimmer" Colour="255,255,255" />
      <Function ID="29" Name="Col Flow 9" Display="'Col Flow 9'" Dmx="232~239" Update="Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;16&amp;&amp;'Colour_Macro'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==30" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="42~84" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="85~127" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="128~170" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="171~213" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="214~255" />
    </Attribute>
    <Attribute ID="Light_1" Name="Light 1" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Light_2" Name="Light 2" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Else ID="1" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro1'&gt;16&amp;&amp;'Colour_Macro1'&lt;30" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro1'==30" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro1" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Master_Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Master_Dimmer" Colour="255,255,255" />

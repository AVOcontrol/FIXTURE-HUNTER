      <Function ID="6" Name="Halogen" Display="'Halogen'" Dmx="101~120" Colour="0,0,0" />
      <Function ID="7" Name="ArcLamp" Display="'ArcLamp'" Dmx="121~140" Colour="0,0,0" />
      <Function ID="8" Name="Candle" Display="'Candle'" Dmx="141~160" Colour="0,0,0" />
      <Function ID="9" Name="Sunset/Sunrise" Display="'Sunset/Sunrise'" Dmx="161~180" Colour="0,0,0" />
      <Function ID="10" Name="Daylight" Display="'Daylight'" Dmx="181~200" Colour="0,0,0" />
      <Function ID="11" Name="OvercastSky" Display="'OvercastSky'" Dmx="201~220" Colour="0,0,0" />
      <Function ID="12" Name="CFL Cool White" Display="'CFL Cool White'" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Mode(SOURCEMATCHING)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="SOURCEMATCHING" Display="'SOURCEMATCHING'" Dmx="86~170" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lightning" Display="'Lightning'" Dmx="0~0" />
      <Function ID="2" Name="CCT Loop" Display="'CCT Loop'" Dmx="11~20" />
      <Function ID="3" Name="Candle" Display="'Candle'" Dmx="21~30" />

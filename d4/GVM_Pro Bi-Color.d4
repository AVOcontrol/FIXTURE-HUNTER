      <Function ID="7" Name="Rate 7" Display="'Rate 7'" Dmx="138~160" />
      <Function ID="8" Name="Rate 8" Display="'Rate 8'" Dmx="161~183" />
      <Function ID="9" Name="Rate 9" Display="'Rate 9'" Dmx="184~206" />
      <Function ID="10" Name="Rate 10" Display="'Rate 10'" Dmx="207~229" />
      <Function ID="11" Name="Random" Display="'Random'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="Mode(EFFECTS)" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="EFFECTS" Display="'EFFECTS'" Dmx="171~255" />

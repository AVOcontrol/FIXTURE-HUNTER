      <Function ID="5" Name="Beam Shape 4 Index" Display="'Beam Shape 4 Index'" Dmx="16~19" Update="Beam_Shape_Rot" />
      <Function ID="6" Name="Beam Shape 1 Spin" Display="'Beam Shape 1 Spin'" Dmx="20~23" Update="Beam_Shape_Rot" />
      <Function ID="7" Name="Beam Shape 2 Spin" Display="'Beam Shape 2 Spin'" Dmx="24~27" Update="Beam_Shape_Rot" />
      <Function ID="8" Name="Beam Shape 3 Spin" Display="'Beam Shape 3 Spin'" Dmx="28~31" Update="Beam_Shape_Rot" />
      <Function ID="9" Name="Beam Shape 4 Spin" Display="'Beam Shape 4 Spin'" Dmx="32~35" Update="Beam_Shape_Rot" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Beam_Shape_Rot" />
    </Attribute>
    <Attribute ID="Beam_Shape_Rot" Name="Beam Shape Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Beam_Shape'==1" />
      <Condition Name="Index" ID="2" If="'Beam_Shape'&gt;1&amp;&amp;'Beam_Shape'&lt;6" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Beam_Shape'&gt;5&amp;&amp;'Beam_Shape'&lt;10" />
      <Else ID="7" />
      <Function ID="1" Name="Disabled" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost_Func" Name="Frost Func" Description="" Group="B" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Frost" />
      <Function ID="2" Name="Light Frost" Display="'Light Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="3" Name="Medium Frost" Display="'Medium Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="4" Name="Combined Frost" Display="'Combined Frost'" Dmx="0~0" Update="Frost" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Frost" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Open" ID="1" If="'Frost_Func'==1" />
      <Condition Name="Light Frost" ID="2,3,4,5,6,7,8" If="'Frost_Func'==2" />
      <Condition Name="Medium Frost" ID="9,10,11,12,13,14,15" If="'Frost_Func'==3" />
      <Condition Name="Combined Frost" ID="16,17,18,19,20,21,22" If="'Frost_Func'==4" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="3" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="1~50" WheelPosition="1" />
      <Function ID="4" Name="Full" Display="'Full'" Dmx="51~53" WheelPosition="2" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="54~63" WheelPosition="3" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="64~73" WheelPosition="4" />
      <Function ID="7" Name="Ramping" Display="'Ramping %.f%%',0~100" Dmx="83~74" WheelPosition="5" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="84~86" WheelPosition="6" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="87~136" WheelPosition="1" />
      <Function ID="11" Name="Full" Display="'Full'" Dmx="137~139" WheelPosition="2" />
      <Function ID="12" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="140~149" WheelPosition="3" />
      <Function ID="13" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="150~159" WheelPosition="4" />
      <Function ID="14" Name="Ramping" Display="'Ramping %.f%%',0~100" Dmx="169~160" WheelPosition="5" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="170~172" WheelPosition="6" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Frost" Display="'Frost %.f%%',0~100" Dmx="173~222" WheelPosition="1" />
      <Function ID="18" Name="Full" Display="'Full'" Dmx="223~225" WheelPosition="2" />
      <Function ID="19" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="226~235" WheelPosition="3" />
      <Function ID="20" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="236~245" WheelPosition="4" />
      <Function ID="21" Name="Ramping" Display="'Ramping %.f%%',0~100" Dmx="255~246" WheelPosition="5" />
      <Function ID="22" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="6" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="65535~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Hot-Spot" Name="Hot-Spot" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Automatic" Display="'Automatic'" Dmx="0~0" />
      <Function ID="2" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="32~32" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~143" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="25-03-17" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Updated in line with v0.91 charts in response to manufacturer request." Version="2" />
  <History Date="28-06-17" Author="Nic Morris" Comment="Updated in line with 1.0 charts in response to manufacturer request (significantly different)" Version="3" />
  <History Date="13-07-17" Author="Nic Morris" Comment="Fixed magenta range and updated to 1.1 charts in response to manufacturer request." Version="4" />
  <History Date="25-08-17" Author="Nic Morris" Comment="Update to v1.2 charts in response to manufacturer request." Version="5" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Updated to 1.3 specs (added dim curve functions and macros)." Version="6" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated to v1.4 specs in response to manufacturer request (Parking+RoboSpot control functions/macros and dynamic patterns)." Version="7" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Changed name from Robin Megapointe to Robin MegaPointe.  Added channel counts to mode names." Version="8" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="9" />
  <History Date="06-01-18" Author="Nic Morris" Comment="Added product thumbnail" Version="10" />
  <History Date="06-01-18" Author="Nic Morris" Comment="Added gobo swatches" Version="11" />
  <History Date="18-01-18" Author="Nic Morris" Comment="Added missing swatch to gobo wheel 1 slot 5." Version="12" />
  <History Date="26-06-20" Author="Nic Morris" Comment="Created from Robe Robin MegaPointe (identical)" Version="13" />
  <History Date="08-04-21" Author="Nic Morris" Comment="Updated in line with v1.1 charts in response to manufacturer request (renames autofocus control functions and macros to p/t compatibility)" Version="14" />
  <History Date="18-05-21" Author="Nic Morris" Comment="Minor revision to power in eco and standard control functions/macros." Version="15" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="16" />
  <History Date="04-06-26" Author="Nic Morris" Comment="Created from Robe Robin iPointe (poor documentation.  charts contain range conflicts.  remarkably similar to Robe...)" Version="17" />
  <History Date="14-06-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="18" />

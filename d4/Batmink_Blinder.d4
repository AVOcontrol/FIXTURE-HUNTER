<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Blinder" ShortName="Blinder" Company="Batmink">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="21-12-07" Author="Ion Balan" Comment="Created" />
  <History Date="21-12-07" Author="Ion Balan" Comment="Checked" />
  <History Date="19-03-08" Author="Gregory Haynes" Comment="Converted to Blinder" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed Function IDs" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="09-09-11" Author="Nic Morris" Comment="Added Red1, Green1, Blue1 and replaced Red,Green,Blue in multi-cell modes." />
  <History Date="09-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Added palettes.  Added pixel mapper compatibility." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Changed cell layout to be more like a 4 cell blinder would probably be." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~15" />
      <Function ID="2" Name="Mode 1" Display="'Mode 1'" Dmx="16~49" />
      <Function ID="3" Name="Mode 2" Display="'Mode 2'" Dmx="50~99" />
      <Function ID="4" Name="Mode 3" Display="'Mode 3'" Dmx="100~149" />
      <Function ID="5" Name="Mode 4" Display="'Mode 4'" Dmx="150~199" />
      <Function ID="6" Name="Sound Mode" Display="'Sound Mode'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rolling Effect" Display="'Rolling Effect'" Dmx="0~22" />
      <Function ID="2" Name="Flowing Effect" Display="'Flowing Effect'" Dmx="23~45" />
      <Function ID="3" Name="Recycle Flowing Effect" Display="'Recycling     Flowing Effect'" Dmx="46~68" />
      <Function ID="4" Name="Recycling Chase 1" Display="'Recycling     Chase 1'" Dmx="69~91" />
      <Function ID="5" Name="Recycling Chase 2" Display="'Recycling     Chase 2'" Dmx="92~114" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="115~137" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="138~160" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="161~183" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="184~206" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="207~229" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="230~252" />
      <Function ID="12" Name="White" Display="'White'" Dmx="253~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe Hz" Display="'Strobe %.1f Hz',1.0~20.0" Dmx="16~200" Intensity="0~0" />
      <Function ID="3" Name="Strobe Slow" Display="'Strobe Slow'" Dmx="201~210" Intensity="0~0" />
      <Function ID="4" Name="Strobe Medium" Display="'Strobe Medium'" Dmx="210~220" Intensity="0~0" />
      <Function ID="5" Name="Strobe Fast" Display="'Strobe Fast'" Dmx="221~230" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="231~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red3" Name="Red 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green3" Name="Green 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue3" Name="Blue 3" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red4" Name="Red 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green4" Name="Green 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue4" Name="Blue 4" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="BM_BLINDER4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Macro" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX, 8bit" Channels="16">
    <Import PearlRef="BM_BLINDR16" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

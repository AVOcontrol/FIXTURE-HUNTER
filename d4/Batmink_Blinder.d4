    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Red1" ChannelOffset="5" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="6" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="7" Wheel="12" />
      <Attribute ID="Red2" ChannelOffset="8" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="9" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="10" Wheel="42" />
      <Attribute ID="Red3" ChannelOffset="11" Wheel="70" />
      <Attribute ID="Green3" ChannelOffset="12" Wheel="71" />
      <Attribute ID="Blue3" ChannelOffset="13" Wheel="72" />
      <Attribute ID="Red4" ChannelOffset="14" Wheel="100" />

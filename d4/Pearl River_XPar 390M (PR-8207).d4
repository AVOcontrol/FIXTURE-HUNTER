  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="1~15" Colour="255,240,200" />
      <Function ID="3" Name="5600K" Display="'5600K'" Dmx="16~31" Colour="255,240,200" />
      <Function ID="4" Name="7200K" Display="'7200K'" Dmx="32~47" Colour="230,230,255" />
      <Function ID="5" Name="10000K" Display="'10000K'" Dmx="48~63" Colour="230,230,255" />
      <Function ID="6" Name="Red" Display="'Red'" Dmx="64~79" Colour="255,128,64" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="80~95" Colour="255,0,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="96~111" Colour="0,255,0" />
      <Function ID="9" Name="Purple" Display="'Purple'" Dmx="112~127" Colour="0,0,255" />
      <Function ID="10" Name="Bl+White" Display="'Bl+White'" Dmx="128~143" Colour="255,255,255" />
      <Function ID="11" Name="Rd+White" Display="'Rd+White'" Dmx="144~159" Colour="255,255,0" />
      <Function ID="12" Name="Grn+White" Display="'Grn+White'" Dmx="160~175" Colour="0,255,255" />
      <Function ID="13" Name="White" Display="'White'" Dmx="176~191" Colour="128,0,255" />
      <Function ID="14" Name="Yel+White" Display="'Yel+White'" Dmx="192~207" Colour="255,255,255" />
      <Function ID="15" Name="Pl+white" Display="'Pl+white'" Dmx="208~223" Colour="255,255,255" />
      <Function ID="16" Name="Effect 1" Display="'Effect 1'" Dmx="224~239" Colour="255,255,0" />
      <Function ID="17" Name="Effect 2" Display="'Effect 2'" Dmx="240~255" Colour="255,128,64" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

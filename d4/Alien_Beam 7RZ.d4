      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="40~43" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="44~47" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="48~51" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />

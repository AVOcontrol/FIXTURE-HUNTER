      <Function ID="19" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="20" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="160~166" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="27-04-09" Author="Jonathan Moreton" Comment="Created" />
  <History Date="29-04-09" Author="David Hunt" Comment="Checked" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-07-19" Author="Nic Morris" Comment="Inverted strobe.  Simplified shutter (LoFF is a fixture level setting and so should not have been conditional but the ranges are compatible anyway)" />
  <History Date="06-07-19" Author="Nic Morris" Comment="Standardised conditionals.  Fixed colour 1 func conditions (index and scroll were swapped)" />
  <History Date="06-07-19" Author="Nic Morris" Comment="Renamed split functions to index.  Changed index ranges to full field.  Added function index.  Added factory gobo names." />
  <History Date="06-07-19" Author="Nic Morris" Comment="Fixed far focus range." />

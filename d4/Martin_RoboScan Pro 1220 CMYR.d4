  <Control>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Shutter" Display="'Shutter'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
      <Function ID="2" Name="Control" Display="'Control'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Shutter" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Strobe" ID="1,2" If="'Shutter_Func'==1" />
      <Condition Name="Control" ID="3,4,5,6,7" If="'Shutter_Func'==2" />
      <Else ID="8" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="177~50" Intensity="0~0" />
      <Function ID="3" Name="Safe" Display="'Safe'" Dmx="178~199" Intensity="0~0" />
      <Function ID="4" Name="Fan Low" Display="'Fan Low'" Dmx="200~243" Intensity="0~0" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="244~247" Intensity="0~0" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="248~251" Intensity="0~0" />
      <Function ID="7" Name="Lamp On" Display="'Lamp On'" Dmx="252~255" Intensity="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>

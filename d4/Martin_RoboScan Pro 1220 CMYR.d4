    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Speed_Func" Name="Speed Func" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dimmer, CMY, Beam" Display="'Dimmer, CMY, Beam'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Colour, Gobo 1, Prism" Display="'Colour, Gobo 1, Prism'" Dmx="0~0" Update="Speed" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="0~0" Update="Speed" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Dimmer, CMY, Beam" ID="1,2,3" If="'Speed_Func'==1" />
      <Condition Name="Colour, Gobo 1, Prism" ID="4,5,6" If="'Speed_Func'==2" />
      <Condition Name="Gobo 2" ID="7,8" If="'Speed_Func'==3" />
      <Else ID="9" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="252~255" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~1" />
      <Function ID="5" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="6" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
      <Function ID="7" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="0~0" />
      <Function ID="8" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="252~255" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AL-P1800+" ShortName="AL-P1800+" Company="ArtLaser">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="03-11-09" Author="John Rogers" Comment="Created" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="06-05-17" Author="Nic Morris" Comment="Changed manufacturer name from Art Laser to ArtLaser.  Changed name from P1800 + to AL-P1800+" />
  <History Date="06-05-17" Author="Nic Morris" Comment="Changed mode to power on and locate in DMX mode." />
  <History Date="06-05-17" Author="Nic Morris" Comment="Fixed pan DMX ranges.  Fixed percentage display ranges." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Sound" Display="'Sound'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="51~100" />
      <Function ID="3" Name="Animation" Display="'Animation'" Dmx="101~150" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Laser_Control" Name="Laser Control" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Blanking" Display="'Blanking %.1f%%',0.0~100.0" Dmx="16~135" />
      <Function ID="3" Name="Flash" Display="'Flash %.1f%%',0.0~100.0" Dmx="136~255" />
    </Attribute>
    <Attribute ID="Patterns" Name="Patterns" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'Tilt %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto Down" Display="'Auto Down     %.f%%',0~100" Dmx="128~192" />
      <Function ID="3" Name="Auto Up" Display="'Auto Up %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'Pan %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto Right" Display="'Auto Right    %.f%%',0~100" Dmx="128~192" />
      <Function ID="3" Name="Auto Left" Display="'Auto Left     %.f%%',0~100" Dmx="193~255" />
    </Attribute>
    <Attribute ID="X_Rotate" Name="X Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Automatic" Display="'Automatic     %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Y_Rotate" Name="Y Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Automatic" Display="'Automatic     %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Z_Rotate" Name="Z Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Manual" Display="'Manual %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Auto CCW" Display="'Auto CCW %.f%%',0~100" Dmx="128~191" />
      <Function ID="3" Name="Auto CW" Display="'Auto CW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Auto_Zoom" Name="Auto Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Auto In" Display="'Auto In %.f%%',0~100" Dmx="0~85" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto Out" Display="'Auto Out %.f%%',0~100" Dmx="86~170" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Auto Zoom" Display="'Auto Zoom %.f%%',0~100" Dmx="171~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Manual_Zoom" Name="Manual Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Plot_Speed" Name="Plot Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="ATLP1K8+" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Patterns" ChannelOffset="3" Wheel="13" />
      <Attribute ID="Auto_Zoom" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Manual_Zoom" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Laser_Control" ChannelOffset="2" Wheel="5" />
      <Attribute ID="X_Rotate" ChannelOffset="6" Wheel="49" />
      <Attribute ID="Y_Rotate" ChannelOffset="7" Wheel="50" />
      <Attribute ID="Z_Rotate" ChannelOffset="8" Wheel="51" />
      <Attribute ID="Plot_Speed" ChannelOffset="12" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
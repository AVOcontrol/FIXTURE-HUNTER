  <History Date="08-10-19" Author="Nic Morris" Comment="Updated in line with software versions 1.4.1 charts (adds dim mode to standard mode, revises blade all rot functions and changes beam shape to linear prism) (charts contain errors)" Version="2" />
  <History Date="11-01-23" Author="Nic Morris" Comment="Calibrated blades in response to feedback (not currently documented)." Version="3" />
  <History Date="11-01-23" Author="Nic Morris" Comment="Added hibernation and sun protection control functions/macros and updated blade all rot functions (again)  in line with latest software version." Version="3" />
  <History Date="11-01-23" Author="Nic Morris" Comment="Added gobo swatches." Version="3" />
  <History Date="13-01-23" Author="Nic Morris" Comment="Changed Atlabase IDs to v1.8.0 modes." Version="4" />

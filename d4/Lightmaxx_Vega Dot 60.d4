<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Vega Dot 60" ShortName="Vega Dot60" Company="Lightmaxx">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-01-17" Author="Nic Morris" Comment="Created" />
  <History Date="19-01-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="21-01-17" Author="Nic Morris" Comment="Revised P/T spin ranges." />
  <History Date="22-01-17" Author="Nic Morris" Comment="Fixed P/T Spin CW range." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="85905ea8-ffbc-4e36-8d10-fb8006a14e9c" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~8" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Pan_Speed" Name="Pan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Spin" Name="Tilt Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Bounce" Display="'Bounce %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~250" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="8~17" Colour="255,255,255" />
      <Function ID="3" Name="G" Display="'G'" Dmx="18~27" Colour="255,255,255" />
      <Function ID="4" Name="B" Display="'B'" Dmx="28~37" Colour="255,255,255" />
      <Function ID="5" Name="W" Display="'W'" Dmx="38~47" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="48~57" Colour="255,255,255" />
      <Function ID="7" Name="G+B" Display="'G+B'" Dmx="58~67" Colour="255,255,255" />
      <Function ID="8" Name="B+W" Display="'B+W'" Dmx="68~77" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="78~87" Colour="255,255,255" />
      <Function ID="10" Name="R+G+B" Display="'R+G+B'" Dmx="88~97" Colour="255,255,255" />
      <Function ID="11" Name="G+B+W" Display="'G+B+W'" Dmx="98~107" Colour="255,255,255" />
      <Function ID="12" Name="R+B+W" Display="'R+B+W'" Dmx="108~117" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="118~127" Colour="255,255,255" />
      <Function ID="14" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="128~137" Colour="255,255,255" />
      <Function ID="15" Name="Jump" Display="'Jump'" Dmx="138~188" Colour="255,255,255" />
      <Function ID="16" Name="Line" Display="'Line'" Dmx="189~239" Colour="255,255,255" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="8~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~58" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="59~84" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="85~110" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="111~136" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="137~162" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="163~188" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="189~214" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="215~240" />
      <Function ID="11" Name="Sound" Display="'Sound'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Speed High" Display="'Speed High'" Dmx="51~100" />
      <Function ID="3" Name="Speed Low" Display="'Speed Low'" Dmx="151~200" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKLMD601" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="999988db-e204-43f0-97b5-3d7a585d3935" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Pan_Spin" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Tilt_Spin" ChannelOffset="4" Wheel="20" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Auto_Spd" ChannelOffset="6" Wheel="24" />
      <Attribute ID="P/T_Macro" ChannelOffset="7" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="UKLMD602" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7063282b-f1be-4383-b1af-9db2d7d0a853" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Pan_Spin" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Pan_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Tilt" ChannelOffset="4" Wheel="3" />
      <Attribute ID="Tilt_Spin" ChannelOffset="5" Wheel="20" />
      <Attribute ID="Tilt_Speed" ChannelOffset="6" Wheel="26" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="9" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="10" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="11" Wheel="12" />
      <Attribute ID="White" ChannelOffset="12" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="13" Wheel="9" />
      <Attribute ID="Auto_Spd" ChannelOffset="14" Wheel="24" />
      <Attribute ID="P/T_Macro" ChannelOffset="15" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Speed High">
      <Set Channel="Control:2" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Speed Low">
      <Set Channel="Control:3" Delay="11000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>

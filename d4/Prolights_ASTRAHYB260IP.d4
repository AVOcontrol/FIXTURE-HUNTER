      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="129~255" />
    </Attribute>
    <Attribute ID="FX_Wheel_B" Name="FX Wheel B" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="FX_Wheel_B_Rot" />
      <Function ID="2" Name="Prism B.1 (Index)" Display="'Prism B.1 (Index)'" Dmx="30~49" Update="FX_Wheel_B_Rot" />
      <Function ID="3" Name="Prism B.2 (Index)" Display="'Prism B.2 (Index)'" Dmx="50~69" Update="FX_Wheel_B_Rot" />
      <Function ID="4" Name="Prism B.3 (Index)" Display="'Prism B.3 (Index)'" Dmx="70~89" Update="FX_Wheel_B_Rot" />
      <Function ID="5" Name="Prism B.4 (Index)" Display="'Prism B.4 (Index)'" Dmx="90~109" Update="FX_Wheel_B_Rot" />
      <Function ID="6" Name="Prism B.1 (Spin)" Display="'Prism B.1 (Spin)'" Dmx="110~129" Update="FX_Wheel_B_Rot" />
      <Function ID="7" Name="Prism B.2 (Spin)" Display="'Prism B.2 (Spin)'" Dmx="130~149" Update="FX_Wheel_B_Rot" />
      <Function ID="8" Name="Prism B.3 (Spin)" Display="'Prism B.3 (Spin)'" Dmx="150~169" Update="FX_Wheel_B_Rot" />
      <Function ID="9" Name="Prism B.4 (Spin)" Display="'Prism B.4 (Spin)'" Dmx="170~189" Update="FX_Wheel_B_Rot" />
      <Function ID="10" Name="Frost B.1" Display="'Frost B.1 %.f%%',0~100" Dmx="190~255" Update="FX_Wheel_B_Rot" />
    </Attribute>
    <Attribute ID="FX_Wheel_B_Rot" Name="FX Wheel B Rot" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Index" ID="2" If="'FX_Wheel_B'==2||'FX_Wheel_B'==3||'FX_Wheel_B'==4||'FX_Wheel_B'==5" />
      <Condition Name="Spin" ID="3,4,5,6" If="'FX_Wheel_B'==6||'FX_Wheel_B'==7||'FX_Wheel_B'==8||'FX_Wheel_B'==9" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~255" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="1~127" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="128~128" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">

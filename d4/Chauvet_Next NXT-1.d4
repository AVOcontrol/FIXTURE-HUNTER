    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2" If="'Gobo1Func'==1" />
      <Condition Name="Spin" ID="3,4,5" If="'Gobo1Func'==2" />
      <Condition Name="Alpha" ID="6,7,8,9,10" If="'Gobo1Func'==3" />
      <Else ID="11" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~100" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="101~149" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="150~202" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="203~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="0°" Display="'0°'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="90°" Display="'90°'" Dmx="64~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="180°" Display="'180°'" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="270°" Display="'270°'" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

  <AtlaBase TypeID="15609054-f574-4e57-bad6-7feb86ee2de8" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~196" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="197~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Fade All" Display="'Fade All %.f%%',0~100" Dmx="1~19" Colour="255,255,255" />
      <Function ID="3" Name="Snap All" Display="'Snap All %.f%%',0~100" Dmx="20~39" Colour="255,255,255" />
      <Function ID="4" Name="Rnd Snap" Display="'Rnd Snap %.f%%',0~100" Dmx="40~59" Colour="255,255,255" />
      <Function ID="5" Name="Fade Red" Display="'Fade Red %.f%%',0~100" Dmx="60~79" Colour="255,255,255" />
      <Function ID="6" Name="Fade Green" Display="'Fade Green %.f%%',0~100" Dmx="80~99" Colour="255,255,255" />
      <Function ID="7" Name="Fade Blue" Display="'Fade Blue %.f%%',0~100" Dmx="100~119" Colour="255,255,255" />
      <Function ID="8" Name="Fade White" Display="'Fade White %.f%%',0~100" Dmx="120~139" Colour="255,255,255" />
      <Function ID="9" Name="Macro 1" Display="'Macro 1'" Dmx="140~159" Colour="0,0,0" />
      <Function ID="10" Name="Macro 2" Display="'Macro 2'" Dmx="160~179" Colour="0,0,0" />
      <Function ID="11" Name="Macro 3" Display="'Macro 3'" Dmx="180~199" Colour="0,0,0" />
      <Function ID="12" Name="Macro 4" Display="'Macro 4'" Dmx="200~219" Colour="0,0,0" />
      <Function ID="13" Name="Macro 5" Display="'Macro 5'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="14" Name="Macro 6" Display="'Macro 6'" Dmx="230~249" Colour="0,0,0" />
      <Function ID="15" Name="Macro 7" Display="'Macro 7'" Dmx="250~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="16~45" />
      <Function ID="3" Name="Square Smooth" Display="'Square Smooth'" Dmx="46~75" />
      <Function ID="4" Name="Inv Square Smooth" Display="'Inv Square Smooth'" Dmx="76~105" />
      <Function ID="5" Name="S-Curve Smooth" Display="'S-Curve Smooth'" Dmx="106~135" />
      <Function ID="6" Name="Linear Fast" Display="'Linear Fast'" Dmx="136~165" />
      <Function ID="7" Name="Square Fast" Display="'Square Fast'" Dmx="166~195" />
      <Function ID="8" Name="Inv Square Fast" Display="'Inv Square Fast'" Dmx="196~225" />
      <Function ID="9" Name="S-Curve Fast" Display="'S-Curve Fast'" Dmx="226~255" />
    </Attribute>
  </Control>

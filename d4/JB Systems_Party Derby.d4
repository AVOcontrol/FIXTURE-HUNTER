  <AtlaBase TypeID="e21b8f83-25d9-4df6-8951-a0fbebf4f3df" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Mix" Display="'Auto Mix'" Dmx="10~50" />
      <Function ID="3" Name="Auto Derby" Display="'Auto Derby'" Dmx="51~90" />
      <Function ID="4" Name="Auto Strobe" Display="'Auto Strobe'" Dmx="91~130" />
      <Function ID="5" Name="Sound Mix" Display="'Sound Mix'" Dmx="131~170" />
      <Function ID="6" Name="Sound Derby" Display="'Sound Derby'" Dmx="171~210" />
      <Function ID="7" Name="Sound Strobe" Display="'Sound Strobe'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~35" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="36~50" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="51~65" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="66~80" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="81~95" Colour="255,255,255" />
      <Function ID="8" Name="R+W" Display="'R+W'" Dmx="96~110" Colour="255,255,255" />
      <Function ID="9" Name="G+B" Display="'G+B'" Dmx="111~125" Colour="255,255,255" />
      <Function ID="10" Name="G+W" Display="'G+W'" Dmx="126~140" Colour="255,255,255" />
      <Function ID="11" Name="B+W" Display="'B+W'" Dmx="141~155" Colour="255,255,255" />
      <Function ID="12" Name="R+G+B" Display="'R+G+B'" Dmx="156~170" Colour="255,255,255" />
      <Function ID="13" Name="R+G+W" Display="'R+G+W'" Dmx="171~185" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="186~200" Colour="255,255,255" />

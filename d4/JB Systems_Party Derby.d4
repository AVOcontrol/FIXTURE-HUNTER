      <Function ID="17" Name="Auto Single/Multi-Col Chase" Display="'Auto Single/Multi-Col Chase'" Dmx="231~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Motor_Rot" Name="Motor Rot" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />

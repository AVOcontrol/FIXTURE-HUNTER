    </Attribute>
    <Attribute ID="Shape_Mode" Name="Shape Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" Update="Shape_Spd" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="6~130" Update="Shape_Spd" />
      <Function ID="3" Name="Dynamic" Display="'Dynamic'" Dmx="131~255" Update="Shape_Spd" />
    </Attribute>
    <Attribute ID="Shape_Select" Name="Shape Select" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Effect" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shape_Spd" Name="Shape Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1" />
      <Condition Name="Static" ID="2" If="'Shape_Mode'==2" />
      <Condition Name="Dynamic" ID="3,4,5" If="'Shape_Mode'==3" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~124" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="125~130" />
      <Function ID="5" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="131~255" />
    </Attribute>
    <Attribute ID="Shape_Fade" Name="Shape Fade" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.1f%%',0.0~100.0" Dmx="130~6" />
      <Function ID="3" Name="Wake" Display="'Wake %.1f%%',0.0~100.0" Dmx="255~131" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pixels_Shutter" Name="Pixels Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />

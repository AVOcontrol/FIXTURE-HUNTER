      <Cell ID="Cell1" Name="White" ChannelOffset="2" ModeLink="W Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="W_Strobe_Dim" TargetId="W_Strobe_Dim" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Auto" TargetId="Auto" />
        <AttributeLink SourceId="Auto_Spd" TargetId="Auto_Spd" />
      </Cell>
      <Cell ID="Cell2" Name="RGB" ChannelOffset="3" ModeLink="RGB Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Auto" TargetId="Auto" />
        <AttributeLink SourceId="Auto_Spd" TargetId="Auto_Spd" />
        <AttributeLink SourceId="Colour_Macro" TargetId="Colour_Macro" />
        <AttributeLink SourceId="Col_Backlite" TargetId="Col_Backlite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>

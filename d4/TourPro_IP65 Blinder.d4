    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="5,6" Wheel="1" />
      <Attribute ID="Dim_Mode" ChannelOffset="7" Wheel="25" />

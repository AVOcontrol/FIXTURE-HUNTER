        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="CTO" ChannelOffset="5" Wheel="9" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="WWA cell" X="0" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="Amber" TargetId="Amber" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="WWA cell" X="0" Y="1">

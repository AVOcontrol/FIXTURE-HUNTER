      <Attribute ID="Dim_Mode" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="5 DMX 1" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="WarmWhite" Wheel="7" />

      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~70" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="71~100" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="101~130" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="131~160" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="161~190" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="191~220" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />

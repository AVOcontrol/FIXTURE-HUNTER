<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="AIRLITE 1000W Balloon" ShortName="1000W Blln" Company="Lightstar" Version="2">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>4ad28aa0-e0ef-4afe-8036-0350741e4f83</Thumbnail>
  <History Date="29-11-22" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2800" PowerOn="1:2800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2800~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f Hz',0.0~50.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:1" PowerOn="1:1" />
      <Function ID="1" Name="Duration" Display="'Duration %.f%%',1~99" Dmx="1~99" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:10" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',10.0~100.0" Dmx="0~100" />
      <Function ID="2" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Bi-Color, 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="9" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Duration" ChannelOffset="4" Wheel="6" />
      <Attribute ID="Fan" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:1:25" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:1:50" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="4ad28aa0-e0ef-4afe-8036-0350741e4f83"></Swatch>
  </swatchLibrary>
</Fixture>
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Speed" ID="3" If="'Program'&gt;5&amp;&amp;'Program'&lt;16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dim Speed 4 (Slowest and Smoothest)" Display="'Dim Speed 4 (Slowest and Smoothest)'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Dim Speed 3" Display="'Dim Speed 3'" Dmx="21~40" Update="Shutter" />
      <Function ID="3" Name="Dim Speed 2" Display="'Dim Speed 2'" Dmx="41~60" Update="Shutter" />

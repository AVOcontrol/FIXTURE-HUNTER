      <Function ID="13" Name="Program 8" Display="'Program 8'" Dmx="170~179" Update="Shutter" />
      <Function ID="14" Name="Program 9" Display="'Program 9'" Dmx="180~189" Update="Shutter" />
      <Function ID="15" Name="Program 10" Display="'Program 10'" Dmx="190~199" Update="Shutter" />

      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Effect" Display="'Reset Effect'" Dmx="61~65" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="66~70" />
      <Function ID="4" Name="Reset Lamp" Display="'Reset Lamp'" Dmx="71~75" />

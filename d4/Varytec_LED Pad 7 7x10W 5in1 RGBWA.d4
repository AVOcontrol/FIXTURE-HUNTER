    <AtlaBase ModeID="b658a604-06ea-442a-a807-97ca3deff13f" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

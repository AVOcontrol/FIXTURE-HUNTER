      <Function ID="31" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="221~190" />
      <Function ID="32" Name="No Scroll" Display="'No Scroll'" Dmx="222~223" />
      <Function ID="33" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" />
      <Function ID="34" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1||'Gobo2Func'==3||'Gobo2Func'==5" />
      <Condition Name="Spin" ID="2,3,4" If="'Gobo2Func'==2||'Gobo2Func'==4||'Gobo2Func'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32639" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32639~32896" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="65535~32896" />
      <Function ID="5" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="51~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Prism_Rot" />
      <Function ID="2" Name="Prism 1 Index" Display="'Prism 1 Index'" Dmx="24~49" Update="Prism_Rot" />
      <Function ID="3" Name="Prism 2 Index" Display="'Prism 2 Index'" Dmx="50~75" Update="Prism_Rot" />
      <Function ID="4" Name="Prism 1 Spin" Display="'Prism 1 Spin'" Dmx="76~101" Update="Prism_Rot" />
      <Function ID="5" Name="Prism 2 Spin" Display="'Prism 2 Spin'" Dmx="102~127" Update="Prism_Rot" />
      <Function ID="6" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Prism_Rot" />
      <Function ID="7" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Prism_Rot" />
      <Function ID="8" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Prism_Rot" />
      <Function ID="9" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Prism_Rot" />
      <Function ID="10" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Prism_Rot" />
      <Function ID="11" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Prism_Rot" />
      <Function ID="12" Name="Macro 7" Display="'Macro 7'" Dmx="176~183" Update="Prism_Rot" />
      <Function ID="13" Name="Macro 8" Display="'Macro 8'" Dmx="184~191" Update="Prism_Rot" />
      <Function ID="14" Name="Macro 9" Display="'Macro 9'" Dmx="192~199" Update="Prism_Rot" />
      <Function ID="15" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Prism_Rot" />
      <Function ID="16" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Prism_Rot" />
      <Function ID="17" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" Update="Prism_Rot" />
      <Function ID="18" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" Update="Prism_Rot" />
      <Function ID="19" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" Update="Prism_Rot" />
      <Function ID="20" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Prism_Rot" />
      <Function ID="21" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" Update="Prism_Rot" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="2" If="'Prism'==2||'Prism'==3" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Prism'==4||'Prism'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX 16bit" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
      <Function ID="2" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="32639~32896" />
      <Function ID="4" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="0~32639" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="32639~32896" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="65535~32896" />
    </Attribute>
    <Attribute ID="Wash_Mode" Name="Wash Mode" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Wash" Display="'Wash'" Dmx="101~200" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">

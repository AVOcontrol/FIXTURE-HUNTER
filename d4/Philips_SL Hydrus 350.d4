      <Function ID="20" Name="7/ 8" Display="'7/ 8'" Dmx="96~100" WheelPosition="8" Colour="0,0,0" />
      <Function ID="21" Name="8/ 9" Display="'8/ 9'" Dmx="101~105" WheelPosition="9" Colour="0,0,0" />
      <Function ID="22" Name="9/ 10" Display="'9/ 10'" Dmx="106~110" WheelPosition="10" Colour="0,0,0" />
      <Function ID="23" Name="10/ Op" Display="'10/ Op'" Dmx="111~115" WheelPosition="11" Colour="0,0,0" />
      <Function ID="24" Name="No Scroll" Display="'No Scroll'" Dmx="116~120" Colour="255,255,255" />
      <Function ID="25" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="180~121" Colour="0,0,0" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="181~185" Colour="255,255,255" />
      <Function ID="27" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="186~245" Colour="0,0,0" />
      <Function ID="28" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />

      <Function ID="11" Name="Gobo 8" Display="'Gobo 8'" Dmx="71~77" WheelPosition="8" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="13" Name="Gobo 1" Display="'Gobo 1'" Dmx="78~84" WheelPosition="1" />
      <Function ID="14" Name="Gobo 2" Display="'Gobo 2'" Dmx="85~91" WheelPosition="2" />
      <Function ID="15" Name="Gobo 3" Display="'Gobo 3'" Dmx="92~98" WheelPosition="3" />
      <Function ID="16" Name="Gobo 4" Display="'Gobo 4'" Dmx="99~105" WheelPosition="4" />
      <Function ID="17" Name="Gobo 5" Display="'Gobo 5'" Dmx="106~112" WheelPosition="5" />
      <Function ID="18" Name="Gobo 6" Display="'Gobo 6'" Dmx="113~119" WheelPosition="6" />
      <Function ID="19" Name="Gobo 7" Display="'Gobo 7'" Dmx="120~126" WheelPosition="7" />
      <Function ID="20" Name="Gobo 8" Display="'Gobo 8'" Dmx="127~133" WheelPosition="8" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="22" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="134~140" WheelPosition="1" />
      <Function ID="23" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="141~147" WheelPosition="2" />
      <Function ID="24" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="148~154" WheelPosition="3" />
      <Function ID="25" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="155~161" WheelPosition="4" />
      <Function ID="26" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="162~168" WheelPosition="5" />
      <Function ID="27" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="169~175" WheelPosition="6" />
      <Function ID="28" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="176~182" WheelPosition="7" />
      <Function ID="29" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="183~189" WheelPosition="8" />

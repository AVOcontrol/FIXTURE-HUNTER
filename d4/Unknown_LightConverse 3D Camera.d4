    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'Position %.f%%',0~100" Dmx="0~15" />
      <Function ID="2" Name="X CCW" Display="'X CCW'" Dmx="16~31" />
      <Function ID="3" Name="X CW" Display="'X CW'" Dmx="32~47" />
      <Function ID="4" Name="Position" Display="'Position'" Dmx="48~63" />
      <Function ID="5" Name="Y Down-Up" Display="'Y Down-Up'" Dmx="64~79" />
      <Function ID="6" Name="XY CCW Down-Up" Display="'XY CCW Down-Up'" Dmx="80~95" />
      <Function ID="7" Name="XY CW Down-Up" Display="'XY CW Down-Up'" Dmx="96~111" />
      <Function ID="8" Name="Y Down-Up" Display="'Y Down-Up'" Dmx="112~127" />
      <Function ID="9" Name="Y Up-Down" Display="'Y Up-Down'" Dmx="128~143" />
      <Function ID="10" Name="XY CCW Up-Down" Display="'XY CCW Up-Down'" Dmx="144~159" />
      <Function ID="11" Name="XY CW Up-Down" Display="'XY CW Up-Down'" Dmx="160~175" />
      <Function ID="12" Name="Y Up-Down" Display="'Y Up-Down'" Dmx="176~191" />

      <Function ID="6" Name="2,3" Display="'2,3'" Dmx="20~23" />
      <Function ID="7" Name="1,3" Display="'1,3'" Dmx="24~27" />
      <Function ID="8" Name="All Rings" Display="'All Rings %.f%%',0~100" Dmx="28~31" />
      <Function ID="9" Name="In-Out" Display="'In-Out %.f%%',0~100" Dmx="32~87" />
      <Function ID="10" Name="Out-In" Display="'Out-In %.f%%',0~100" Dmx="88~143" />

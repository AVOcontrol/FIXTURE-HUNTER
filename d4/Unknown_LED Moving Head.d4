    <Attribute ID="Ring" Name="Ring" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All Rings" Display="'All Rings'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="4~7" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Moving Head" ShortName="LED MH" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="22-10-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="30-03-17" Author="Nic Morris" Comment="Fixed wheel mapping conflict in response to bug report.  Moved 'Ring' and 'Auto Col' into Effect group and wheel slots." />
  <History Date="31-03-17" Author="Nic Morris" Comment="Removed Atlabase ID (wrong fixture)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~59" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="65~114" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="120~169" Intensity="0~0" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="175~224" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="225~234" Intensity="0~0" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="235~244" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="3" Name="RW" Display="'RW'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="RG" Display="'RG'" Dmx="5~7" Colour="255,255,255" />
      <Function ID="5" Name="RGW" Display="'RGW'" Dmx="8~9" Colour="255,255,255" />
      <Function ID="6" Name="G" Display="'G'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="7" Name="GW" Display="'GW'" Dmx="13~14" Colour="255,255,255" />
      <Function ID="8" Name="GB" Display="'GB'" Dmx="15~17" Colour="255,255,255" />
      <Function ID="9" Name="GBW" Display="'GBW'" Dmx="18~19" Colour="255,255,255" />
      <Function ID="10" Name="B" Display="'B'" Dmx="20~22" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="23~24" Colour="255,255,255" />
      <Function ID="12" Name="RB" Display="'RB'" Dmx="25~27" Colour="255,255,255" />
      <Function ID="13" Name="RBW" Display="'RBW'" Dmx="28~29" Colour="255,255,255" />
      <Function ID="14" Name="W" Display="'W'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="16" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="50~83" Colour="255,255,255" />
      <Function ID="17" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="84~117" Colour="255,255,255" />
      <Function ID="18" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="118~151" Colour="255,255,255" />
      <Function ID="19" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="152~185" Colour="255,255,255" />
      <Function ID="20" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="186~218" Colour="255,255,255" />
      <Function ID="21" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="219~252" Colour="255,255,255" />
      <Function ID="22" Name="RGBWA" Display="'RGBWA'" Dmx="253~255" Colour="255,255,255" />

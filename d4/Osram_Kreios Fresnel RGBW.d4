      <Attribute ID="Red" ChannelOffset="4,5" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="6,7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8,9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10,11" Wheel="7" />
      <Attribute ID="CTO" ChannelOffset="13" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="9" />

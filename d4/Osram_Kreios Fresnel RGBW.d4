<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Kreios Fresnel RGBW" ShortName="Kr Fr RGBW" Company="Osram">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="22-02-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="10~19" Intensity="0~0" />
      <Function ID="3" Name="Closed" Display="'Closed'" Dmx="20~29" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="120~149" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="150~179" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="180~204" Intensity="0~0" />
      <Function ID="8" Name="Ind Rnd" Display="'Ind Rnd %.f%%',0~100" Dmx="205~229" Intensity="0~0" />
      <Function ID="9" Name="Col Strb" Display="'Col Strb %.f%%',0~100" Dmx="230~234" Intensity="0~0" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="235~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Custom" Name="Custom" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Recall" ID="1,2,3,4,5" If="'Custom_Mode'==1" />
      <Condition Name="Create" ID="6,7,8,9,10" If="'Custom_Mode'==2" />
      <Else ID="1,11" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~55" />
      <Function ID="2" Name="Full" Display="'Full'" Dmx="56~105" />
      <Function ID="3" Name="Preset" Display="'Preset'" Dmx="106~155" />
      <Function ID="4" Name="Recall" Display="'Recall'" Dmx="156~205" />
      <Function ID="5" Name="CTC On" Display="'CTC On'" Dmx="206~255" />
      <Function ID="6" Name="Safe" Display="'Safe'" Dmx="0~55" />
      <Function ID="7" Name="Full" Display="'Full'" Dmx="56~105" />
      <Function ID="8" Name="Preset" Display="'Preset'" Dmx="106~155" />
      <Function ID="9" Name="Create" Display="'Create'" Dmx="156~205" />
      <Function ID="10" Name="CTC On" Display="'CTC On'" Dmx="206~255" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTC" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTC C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Colour="255,255,255" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="15~22" Colour="0,0,0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="23~30" Colour="0,0,0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="31~38" Colour="0,0,0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="39~46" Colour="0,0,0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="47~54" Colour="0,0,0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="55~62" Colour="0,0,0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="63~70" Colour="0,0,0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="71~78" Colour="0,0,0" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="79~86" Colour="0,0,0" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="87~94" Colour="0,0,0" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="95~102" Colour="0,0,0" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="103~110" Colour="0,0,0" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="111~118" Colour="0,0,0" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="119~126" Colour="0,0,0" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="127~134" Colour="0,0,0" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="135~142" Colour="0,0,0" />
      <Function ID="18" Name="Rainbow 1" Display="'Rainbow 1'" Dmx="143~150" Colour="255,255,255" />
      <Function ID="19" Name="Rainbow 2" Display="'Rainbow 2'" Dmx="151~158" Colour="255,255,255" />
      <Function ID="20" Name="Rainbow 3" Display="'Rainbow 3'" Dmx="159~166" Colour="255,255,255" />
      <Function ID="21" Name="Rainbow 4" Display="'Rainbow 4'" Dmx="167~174" Colour="255,255,255" />
      <Function ID="22" Name="Rainbow 5" Display="'Rainbow 5'" Dmx="175~182" Colour="255,255,255" />
      <Function ID="23" Name="Rainbow 6" Display="'Rainbow 6'" Dmx="183~190" Colour="255,255,255" />
      <Function ID="24" Name="Rainbow 7" Display="'Rainbow 7'" Dmx="191~198" Colour="255,255,255" />
      <Function ID="25" Name="Rainbow 8" Display="'Rainbow 8'" Dmx="199~206" Colour="255,255,255" />
      <Function ID="26" Name="Random 1" Display="'Random 1'" Dmx="207~214" Colour="255,255,255" />
      <Function ID="27" Name="Random 2" Display="'Random 2'" Dmx="215~222" Colour="255,255,255" />
      <Function ID="28" Name="Random 3" Display="'Random 3'" Dmx="223~230" Colour="255,255,255" />
      <Function ID="29" Name="Random 4" Display="'Random 4'" Dmx="231~238" Colour="255,255,255" />
      <Function ID="30" Name="Random 5" Display="'Random 5'" Dmx="239~246" Colour="255,255,255" />
      <Function ID="31" Name="Random 6" Display="'Random 6'" Dmx="247~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Custom_Mode" Name="Custom Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Recall" Display="'Recall'" Dmx="0~79" Update="Custom" />
      <Function ID="2" Name="Create" Display="'Create'" Dmx="80~160" Update="Custom" />
      <Function ID="3" Name="Store" Display="'Store'" Dmx="161~255" Update="Custom" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX" Channels="10">
    <Import PearlRef="UKOSKFC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="7" />
      <Attribute ID="CTO" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Colour_Macro" ChannelOffset="9" Wheel="9" />
      <Attribute ID="Custom" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Custom_Mode" ChannelOffset="10" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">

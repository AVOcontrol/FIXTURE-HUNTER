      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="98~104" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="105~111" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 16" Display="'Gobo 16'" Dmx="112~118" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 17" Display="'Gobo 17'" Dmx="119~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~191" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="192~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo_Shk" Name="Gobo Shk" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Shake" Display="'Shake %.1f%%',0.0~100.0" Dmx="1~191" GoboSpin="0~0" GoboOrientation="0~0" />

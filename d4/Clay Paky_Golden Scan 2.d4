<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Golden Scan 2" ShortName="GoldnScan2" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="25-10-04" Author="Phil Rogers" Comment="Created" />
  <History Date="02-11-04" Author="Tom Peck" Comment="Checked" />
  <History Date="22-07-05" Author="D Trounce" Comment="Error: Iris wheel goes anticlockwise for up" />
  <History Date="22-07-05" Author="D Trounce" Comment="Error: Strobe: 255 should be open not 100% strobe" />
  <History Date="22-07-05" Author="D Trounce" Comment="Error: colour: 16 is red/white" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed Iris wheel directions" />
  <History Date="27-07-05" Author="E Spencer" Comment="Checked that the right colours were in the right modes" />
  <History Date="27-07-05" Author="E Spencer" Comment="Added an open attribute under dimmer at 255" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo ID to Gobo1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="20-07-06" Author="Ed" Comment="Checked, changed colour func rain on id to colour1func" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="30-03-12" Author="Peter Budd" Comment="Updated Raw DMX function to have no range." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Added Atlabase ID's ('Standard' is Rain Off, 'Option 1' is Rain On.  'Option 2' is linear colour change)" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Standardised conditionals.  Increased wheel resolution.  Fixed colour func updates." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed duplicate ID's in else conditions.  Changed colour index to single range.  Added palettes." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Added highlight/lowlight.  Fixed rain off mapping (previously had the rain on colour attributes)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e2a6ead0-7167-4daa-9cd8-46a5996b07a4" />
  <Control>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Wheel 1 Gobo 1" Display="'Wheel 1 Gobo 1'" Dmx="14~27" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Wheel 1 Gobo 2" Display="'Wheel 1 Gobo 2'" Dmx="28~41" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Wheel 1 Gobo 3" Display="'Wheel 1 Gobo 3'" Dmx="42~56" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Wheel 1 Gobo 4" Display="'Wheel 1 Gobo 4'" Dmx="57~70" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Wheel 2 Gobo 4" Display="'Wheel 2 Gobo 4'" Dmx="228~238" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Wheel 2 Gobo 3" Display="'Wheel 2 Gobo 3'" Dmx="214~227" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Wheel 2 Gobo 2" Display="'Wheel 2 Gobo 2'" Dmx="199~213" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Wheel 2 Gobo 1" Display="'Wheel 2 Gobo 1'" Dmx="184~198" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 2/Gobo 1" Display="'Gobo 2/Gobo 1'" Dmx="71~84" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 2/Gobo 2" Display="'Gobo 2/Gobo 2'" Dmx="85~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2/Gobo 3" Display="'Gobo 2/Gobo 3'" Dmx="100~113" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 2/Gobo 4" Display="'Gobo 2/Gobo 4'" Dmx="114~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 1/Gobo 4" Display="'Gobo 1/Gobo 4'" Dmx="128~142" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 1/Gobo 3" Display="'Gobo 1/Gobo 3'" Dmx="143~156" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 1/Gobo 2" Display="'Gobo 1/Gobo 2'" Dmx="157~169" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 1/Gobo 1" Display="'Gobo 1/Gobo 1'" Dmx="170~183" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~127" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="128~254" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11" If="'Colour1Func'==3" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="32~47" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="48~63" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="64~79" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="80~95" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="96~111" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="112~127" Colour="255,150,150" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" Colour="255,255,255" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="11" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Func_Rain_Off" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour_Rain_Off" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour_Rain_Off" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour_Rain_Off" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Rain_Off" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="3" Lowlight="7" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour_Func_Rain_Off'==1" />
      <Condition Name="Index" ID="9" If="'Colour_Func_Rain_Off'==2" />
      <Else ID="10" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="64~95" Colour="255,255,0" />
      <Function ID="4" Name="Purple" Display="'Purple'" Dmx="96~127" Colour="128,0,255" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="128~159" Colour="0,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="160~191" Colour="255,128,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="192~223" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="224~255" Colour="255,150,150" />
      <Function ID="9" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX, Rain On" Channels="6">
    <Import PearlRef="CPGScan2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="150" TiltMax="110" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0ef17ffc-f3ee-4447-9b01-099fabd1259c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
    </Include>
  </Mode>
  <Mode Name="6 DMX, Rain Off" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="150" TiltMax="110" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="b2c508d1-4285-4d7c-8be8-a974dc5611e1" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="5" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="6" Wheel="3" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Iris" ChannelOffset="1" Wheel="21" />
      <Attribute ID="Colour_Func_Rain_Off" Wheel="7" />
      <Attribute ID="Colour_Rain_Off" ChannelOffset="2" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="8" Name="Open" Number="6" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour_Rain_Off:1,Colour_Func_Rain_Off:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1" />
      <Palette ID="2" Name="Wheel 1 Gobo 1" Number="12" Page="1" SetControl="Gobo1:2" />
      <Palette ID="3" Name="Wheel 1 Gobo 2" Number="13" Page="1" SetControl="Gobo1:3" />
      <Palette ID="4" Name="Wheel 1 Gobo 3" Number="14" Page="1" SetControl="Gobo1:4" />
      <Palette ID="5" Name="Wheel 1 Gobo 4" Number="15" Page="1" SetControl="Gobo1:5" />
      <Palette ID="6" Name="Wheel 2 Gobo 4" Number="16" Page="1" SetControl="Gobo1:6" />
      <Palette ID="7" Name="Wheel 2 Gobo 3" Number="17" Page="1" SetControl="Gobo1:7" />
      <Palette ID="8" Name="Wheel 2 Gobo 2" Number="18" Page="1" SetControl="Gobo1:8" />
      <Palette ID="9" Name="Wheel 2 Gobo 1" Number="19" Page="1" SetControl="Gobo1:9" />
      <Palette ID="10" Name="Gobo 2/Gobo 1" Number="20" Page="1" SetControl="Gobo1:10" />
      <Palette ID="11" Name="Gobo 2/Gobo 2" Number="0" Page="1" SetControl="Gobo1:11" />
      <Palette ID="12" Name="Gobo 2/Gobo 3" Number="0" Page="1" SetControl="Gobo1:12" />
      <Palette ID="13" Name="Gobo 2/Gobo 4" Number="0" Page="1" SetControl="Gobo1:13" />
      <Palette ID="14" Name="Gobo 1/Gobo 4" Number="0" Page="1" SetControl="Gobo1:14" />
      <Palette ID="15" Name="Gobo 1/Gobo 3" Number="0" Page="1" SetControl="Gobo1:15" />
      <Palette ID="16" Name="Gobo 1/Gobo 2" Number="0" Page="1" SetControl="Gobo1:16" />
      <Palette ID="17" Name="Gobo 1/Gobo 1" Number="0" Page="1" SetControl="Gobo1:17" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Beam">
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
</Fixture>
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>04c128a9-4172-4537-8d02-93b136d9b7d0</Thumbnail>
  <History Date="17-07-18" Author="Nic Morris" Comment="Created" />
  <History Date="18-07-18" Author="Nic Morris" Comment="Added Atlabase ID's (note multi-part patch mode options are not currently supported).  Removed 4 pixel modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="efe00557-18da-4b45-8ee6-42e59f721716" />
  <Control>
    <Attribute ID="Red_Strobe" Name="Red Strobe" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green_Strobe" Name="Green Strobe" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue_Strobe" Name="Blue Strobe" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White_Strobe" Name="White Strobe" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Strobe_Dimmer" Name="Strobe Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.fms',0~650" Dmx="0~254" />
      <Function ID="2" Name="Hyper" Display="'Hyper'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Rate" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Strobe_FX" Name="Strobe FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Wash Override" Display="'Wash Override'" Dmx="5~5" />
      <Function ID="3" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" />
      <Function ID="4" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" />
      <Function ID="5" Name="Ramp Up/Dn" Display="'Ramp Up/Dn'" Dmx="86~128" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="129~171" />
      <Function ID="7" Name="Lightning" Display="'Lightning'" Dmx="172~214" />
      <Function ID="8" Name="Spikes" Display="'Spikes'" Dmx="215~240" />
      <Function ID="9" Name="Burst" Display="'Burst'" Dmx="241~245" />
      <Function ID="10" Name="Rnd Pix w/Solid BG" Display="'Rnd Pix w/Solid BG'" Dmx="246~250" />
      <Function ID="11" Name="Rnd Pix w/Burst BG" Display="'Rnd Pix w/Burst BG'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

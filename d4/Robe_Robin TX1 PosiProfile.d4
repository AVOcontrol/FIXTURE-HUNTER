  <History Date="08-11-16" Author="Nic Morris" Comment="Revised Cyan and Lt Green attributes to use CyanAdditive and Lime reserved ID's." Version="8" />
  <History Date="25-01-17" Author="Peter Budd" Comment="Added Open ranges on Gobo Wheels, corrected blade rotate functions, re-implemented Nics V1.6 changes and added P/T Speed." Version="9" />
  <History Date="21-10-17" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (RoboSpot control functions/macros)" Version="10" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised colour macro function names.  Added gobo 1 index functions.  Revised gobo 1 scroll ranges." Version="11" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised mode names with channel counts.  Simplified frost and iris ranges.  Inverted zoom." Version="12" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Revised frame attribute ID's for correct alighnment with Attribute Editor controls." Version="13" />
  <History Date="22-10-17" Author="Nic Morris" Comment="Recreated palettes with frost and iris." Version="14" />
  <History Date="24-10-17" Author="Nic Morris" Comment="Unification across product range." Version="15" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added product thumbnail" Version="16" />
  <History Date="27-03-18" Author="Nic Morris" Comment="Added gobo swatches" Version="17" />
  <History Date="06-09-18" Author="Nic Morris" Comment="Created from Robe Robin DL7S Profile" Version="18" />
  <History Date="11-09-18" Author="Nic Morris" Comment="Added R20" Version="19" />
  <History Date="11-10-18" Author="Nic Morris" Comment="Updated in line with v1.3 charts." Version="20" />
  <History Date="19-11-18" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches.  Updated in line with v1.4 charts." Version="21" />
  <History Date="22-02-19" Author="Nic Morris" Comment="Added Atlabase ID's.  Minor correction to Colour Macro function typo ('Filter 120 Deep Blue' was 'Filter 120 Beep Blue')" Version="22" />
  <History Date="10-08-20" Author="Nic Morris" Comment="Created from Robe Robin T1 Profile" Version="23" />
  <History Date="25-09-20" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request." Version="27" />
  <History Date="20-11-20" Author="Nic Morris" Comment="Updated in line with v1.3 charts (minor change to gobo scroll ranges)." Version="28" />
  <History Date="18-12-20" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (removes combined frost)." Version="29" />
  <History Date="25-01-21" Author="Nic Morris" Comment="Changed Colour Macro to Virtual Col for compatibility across range in response to manufacturer query." Version="30" />
  <History Date="22-02-21" Author="Nic Morris" Comment="Updated in line with v1.6 charts in response to manufacturer request (adds quiet mode fan and dimmer curve control functions and macros)" Version="31" />
  <History Date="21-04-21" Author="Nic Morris" Comment="Updated in line with v1.7 charts (removes dimmer curve control functions and revises quiet mode ranges)" Version="32" />
  <History Date="21-04-21" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches." Version="32" />
  <History Date="23-04-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="33" />
  <History Date="13-12-21" Author="Nic Morris" Comment="Created from Robe Robin T2 Profile (v1.1)" Version="34" />
  <History Date="28-02-22" Author="Nic Morris" Comment="Updated in line with v1.2 charts in response to manufacturer request (adds Iris control and High function to LED Freq Sel)." Version="39" />
  <History Date="23-08-22" Author="Nic Morris" Comment="Updated in line with v1.5 charts in response to manufacturer request (changes name from Robin T21 Profile to Robin TX1 PosiProfile, adds control functions/macros, reassigns mode numbers, revises gobo 2 functions and changes resolution to 16bit. adds new modes)" Version="40" />
  <History Date="19-10-22" Author="Nic Morris" Comment="Added product thumbnail" Version="42" />
  <History Date="25-10-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="43" />
  <History Date="20-03-23" Author="Nic Morris" Comment="Updated in line with v1.7 charts in response to manufacturer request (adds cue playback off control function/macro)" Version="44" />
  <History Date="02-06-23" Author="Nic Morris" Comment="Added variable (full range) CTO function." Version="45" />
  <History Date="19-01-24" Author="Nic Morris" Comment="Updated in line with v1.8 charts in response to manufacturer request (adds theatre mode and optics+p/t brakes control functions and macros)" Version="46" />
  <History Date="03-09-25" Author="Nic Morris" Comment="Removed Scroll Index gobo 2 func in response to manufacturer request." Version="47" />

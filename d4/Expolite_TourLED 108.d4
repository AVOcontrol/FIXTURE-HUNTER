<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="TourLED 108" ShortName="TourLED108" Company="Expolite">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>bc594877-1e30-43b7-a99b-f8fa3bb3b6ef</Thumbnail>
  <History Date="22-05-07" Author="D.Milligan" Comment="Created" />
  <History Date="22-05-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed duplicate ID's.  Simplified module select conditions." />
  <History Date="19-06-11" Author="Nic Morris" Comment="Added palettes.  Removed non v-dim mode.  Increased wheel resolution." />
  <History Date="30-03-12" Author="Peter Budd" Comment="Edited dimmer so size is no longer 0 for version 6." />
  <History Date="12-10-12" Author="Peter Budd" Comment="Created from Chauvet Colorado 3" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Revised reserved c-mix attribute ID's.  Fixed highlight/lowlight.  Removed clear values." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Removed 'Mode 2' function from Control (Mode 1) and removed all but 'Mode 2' function from Control 1 (Mode 2) to fix to respective modes." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Removed module update from Control1 as wasn't included in modes or conditions." />
  <History Date="05-02-17" Author="Nic Morris" Comment="Changed shutter 'Safe' to 'Open'." />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added product thumbnail.  Fixed PIXEL mode cell links." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

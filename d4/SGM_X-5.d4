  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="18-05-12" Author="Peter Budd" Comment="Created" />
  <History Date="03-08-12" Author="Peter Budd" Comment="Corrected on customer comment" />
  <History Date="04-01-13" Author="Peter Budd" Comment="Edited removed shutter channel from 6 and 7 channel mode and replaced with dimmer." />
  <History Date="05-03-14" Author="Nic Morris" Comment="Increased wheel resolution.  Added new 7 ch mode and Pixel mode." />
  <History Date="05-03-14" Author="Nic Morris" Comment="Added Master Dimmer to cell modes to avoid linking cells to physical channel." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="11-10-16" Author="Nic Morris" Comment="Added Atlabase ID's to 3 DMX and Pixel modes." />
  <History Date="13-10-16" Author="Nic Morris" Comment="Added Atlabase ID's to 7 channel modes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fb22a578-8739-4aa6-ac52-4285d723600e" />
  <Control>
    <Attribute ID="Duration" Name="Duration" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'Duration %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Flash" Display="'No Flash'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Ramp Up" Display="'Ramp Up'" Dmx="6~42" Intensity="0~0" />
      <Function ID="3" Name="Ramp Down" Display="'Ramp Down'" Dmx="43~85" Intensity="0~0" />
      <Function ID="4" Name="Ramp" Display="'Ramp'" Dmx="86~128" Intensity="0~0" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="129~171" Intensity="0~0" />
      <Function ID="6" Name="Lighting" Display="'Lighting'" Dmx="172~214" Intensity="0~0" />
      <Function ID="7" Name="Spikes" Display="'Spikes'" Dmx="215~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer1" Name="Segment 1" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer2" Name="Segment 2" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer3" Name="Segment 3" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

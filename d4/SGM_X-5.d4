    </Attribute>
    <Attribute ID="Dimmer4" Name="Master Dim" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX, 8bit" Channels="1">

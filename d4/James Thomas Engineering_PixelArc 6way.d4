  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_1" Name="FX 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Rainbow Chase FWD" Display="'Rainbow Chase FWD'" Dmx="8~15" />
      <Function ID="3" Name="Rainbow Chase REV" Display="'Rainbow Chase REV'" Dmx="16~23" />
      <Function ID="4" Name="White Single FWD" Display="'White Single FWD'" Dmx="24~31" />
      <Function ID="5" Name="White Single REV" Display="'White Single REV'" Dmx="32~39" />
      <Function ID="6" Name="Double Head Chase" Display="'Double Head Chase'" Dmx="40~47" />
      <Function ID="7" Name="Strobe White" Display="'Strobe White'" Dmx="48~55" />
      <Function ID="8" Name="Strobe Red" Display="'Strobe Red'" Dmx="56~63" />
      <Function ID="9" Name="Strobe Blue" Display="'Strobe Blue'" Dmx="64~71" />
      <Function ID="10" Name="Strobe Yellow" Display="'Strobe Yellow'" Dmx="72~79" />
      <Function ID="11" Name="Strobe Green" Display="'Strobe Green'" Dmx="80~87" />
      <Function ID="12" Name="Pulse White Strobe" Display="'Pulse White Strobe'" Dmx="88~95" />
      <Function ID="13" Name="Pulse Blue Strobe" Display="'Pulse Blue Strobe'" Dmx="96~103" />
      <Function ID="14" Name="Pulse Rainbow Strobe" Display="'Pulse Rainbow Strobe'" Dmx="104~111" />
      <Function ID="15" Name="Pulse R/G/B Strobe" Display="'Pulse R/G/B Strobe'" Dmx="112~119" />
      <Function ID="16" Name="Primary/ Secondary Chase" Display="'Primary/ Secondary Chase'" Dmx="120~127" />
      <Function ID="17" Name="Rainbow Chase" Display="'Rainbow Chase'" Dmx="128~135" />
      <Function ID="18" Name="Yellow/ Blue Chase" Display="'Yellow/ Blue Chase'" Dmx="136~143" />
      <Function ID="19" Name="R/G/B Wipe" Display="'R/G/B Wipe'" Dmx="144~151" />
      <Function ID="20" Name="Yellow/ Blue Alt Chase" Display="'Yellow/ Blue Alt Chase'" Dmx="152~159" />
      <Function ID="21" Name="Red/ Blue Alt Chase" Display="'Red/ Blue Alt Chase'" Dmx="160~167" />
      <Function ID="22" Name="Red/ Yellow Chase" Display="'Red/ Yellow Chase'" Dmx="168~175" />
      <Function ID="23" Name="Red Wipe" Display="'Red Wipe'" Dmx="176~183" />

      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="72~79" WheelPosition="9" Colour="0,0,0" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="80~87" WheelPosition="10" Colour="0,0,0" />

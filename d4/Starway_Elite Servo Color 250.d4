      <Function ID="18" Name="Colour 17" Display="'Colour 17'" Dmx="136~143" WheelPosition="17" Colour="0,0,0" />
      <Function ID="19" Name="Colour 18" Display="'Colour 18'" Dmx="144~151" WheelPosition="18" Colour="0,0,0" />
      <Function ID="20" Name="Colour 19" Display="'Colour 19'" Dmx="152~159" WheelPosition="19" Colour="0,0,0" />
      <Function ID="21" Name="Colour 20" Display="'Colour 20'" Dmx="160~167" WheelPosition="20" Colour="0,0,0" />
      <Function ID="22" Name="Colour 21" Display="'Colour 21'" Dmx="168~175" WheelPosition="21" Colour="0,0,0" />
      <Function ID="23" Name="Colour 22" Display="'Colour 22'" Dmx="176~183" WheelPosition="22" Colour="0,0,0" />
      <Function ID="24" Name="Colour 23" Display="'Colour 23'" Dmx="184~191" WheelPosition="23" Colour="0,0,0" />
      <Function ID="25" Name="Colour 24" Display="'Colour 24'" Dmx="192~199" WheelPosition="24" Colour="0,0,0" />
      <Function ID="26" Name="Colour 25" Display="'Colour 25'" Dmx="200~207" WheelPosition="25" Colour="0,0,0" />
      <Function ID="27" Name="Colour 26" Display="'Colour 26'" Dmx="208~215" WheelPosition="26" Colour="0,0,0" />
      <Function ID="28" Name="Colour 27" Display="'Colour 27'" Dmx="216~223" WheelPosition="27" Colour="0,0,0" />
      <Function ID="29" Name="Colour 28" Display="'Colour 28'" Dmx="224~231" WheelPosition="28" Colour="0,0,0" />
      <Function ID="30" Name="Colour 29" Display="'Colour 29'" Dmx="232~239" WheelPosition="29" Colour="0,0,0" />
      <Function ID="31" Name="Colour 30" Display="'Colour 30'" Dmx="240~247" WheelPosition="30" Colour="0,0,0" />
      <Function ID="32" Name="Colour 31" Display="'Colour 31'" Dmx="248~255" WheelPosition="31" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Beam Shape" Display="'Beam Shape %.1f%%',0.0~100.0" Dmx="71~180" />
      <Function ID="3" Name="Frost" Display="'Frost'" Dmx="181~255" />
    </Attribute>
    <Attribute ID="Reserved" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16-Bit, 16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="530" TiltMax="280" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="1fc7e668-de0a-4561-aa97-a74d4528c600" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />

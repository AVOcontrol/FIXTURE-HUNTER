  <History Date="08-09-20" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="09-09-20" Author="Nic Morris" Comment="Fixed pan/tilt mapping (16/8bit modes were swapped)" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3b575924-2b7b-4616-98c3-e2c9f1c1529c" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="249~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On/ Reset" Display="'Lamp On/ Reset'" Dmx="128~139" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="230~239" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Colour1Func'==2" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="18~35" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="36~53" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="54~72" Colour="0,255,0" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="73~90" Colour="255,240,200" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="91~108" Colour="230,230,255" />
      <Function ID="7" Name="UV" Display="'UV'" Dmx="109~127" Colour="180,0,255" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~190" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="191~192" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="193~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CMY/Dimmer_Spd" Name="CMY/Dimmer Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="8~15" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~23" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="24~31" WheelPosition="3" Colour="0,0,0" />

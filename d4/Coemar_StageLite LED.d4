<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="StageLite LED" ShortName="StgLte LED" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="17-11-08" Author="David Hunt" Comment="Created" />
  <History Date="21-11-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="10-09-11" Author="Nic Morris" Comment="Aligned attribute ID numbers with attribute names.  Fixed power on and locate." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Replaced Red1,Green1,Blue1,White1 with Red,Green,Blue.White in 12 DMX mode." />
  <History Date="10-09-11" Author="Nic Morris" Comment="Added pixel mapper compatibility.  Shortened function names for Expert LCD." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green1" Name="Green 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue1" Name="Blue 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White1" Name="White 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red2" Name="Red 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green2" Name="Green 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue2" Name="Blue 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White2" Name="White 2" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~57" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="58~59" Intensity="0~0" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="60~108" Intensity="0~0" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="109~110" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="111~159" Intensity="0~0" />
      <Function ID="7" Name="Open" Display="'Open'" Dmx="160~161" Intensity="0~0" />
      <Function ID="8" Name="Rnd Stb w Cols" Display="'Rnd Stb, Sync  Cols %.f%%',0~100" Dmx="162~207" Intensity="0~0" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="208~209" Intensity="0~0" />
      <Function ID="10" Name="Rnd Strobe" Display="'Rnd Stb,  Rnd Cols %.f%%',0~100" Dmx="210~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="LEDLine1" Name="LED Line 1" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="8bit" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LEDLine2" Name="LED Line 2" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="8bit" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="LEDLine3" Name="LED Line 3" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:0" />
      <Function ID="1" Name="8bit" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Func" Name="Auto Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Auto Col 1" Display="'Auto Col 1 %.f%%',0~100" Dmx="10~50" />
      <Function ID="3" Name="Auto Col 2" Display="'Auto Col 2 %.f%%',0~100" Dmx="51~91" />
      <Function ID="4" Name="Auto Col 3" Display="'Auto Col 3 %.f%%',0~100" Dmx="92~132" />
      <Function ID="5" Name="Auto Col 4" Display="'Auto Col 4 %.f%%',0~100" Dmx="133~173" />
      <Function ID="6" Name="Random" Display="'Random %.f%%',0~100" Dmx="174~214" />
      <Function ID="7" Name="Repeat" Display="'Repeat %.f%%',0~100" Dmx="215~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" />
      <Function ID="2" Name="Position 1" Display="'Position 1'" Dmx="10~19" />
      <Function ID="3" Name="Position 2" Display="'Position 2'" Dmx="20~39" />
      <Function ID="4" Name="Position 3" Display="'Position 3'" Dmx="40~59" />
      <Function ID="5" Name="Position 4" Display="'Position 4'" Dmx="60~79" />
      <Function ID="6" Name="Position 5" Display="'Position 5'" Dmx="80~99" />
      <Function ID="7" Name="Position 6" Display="'Position 6'" Dmx="100~119" />
      <Function ID="8" Name="Auto Pos 1" Display="'Auto Pos 1 %.f%%',0~100" Dmx="120~146" />
      <Function ID="9" Name="Auto Pos 2" Display="'Auto Pos 2 %.f%%',0~100" Dmx="147~173" />
      <Function ID="10" Name="Auto Pos 3" Display="'Auto Pos 3 %.f%%',0~100" Dmx="174~200" />
      <Function ID="11" Name="Auto Pos 4" Display="'Auto Pos 4 %.f%%',0~100" Dmx="201~227" />
      <Function ID="12" Name="Auto Pos 5" Display="'Auto Pos 5 %.f%%',0~100" Dmx="228~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Pause Time" Display="'Pause Time    %.f%%',0~100" Dmx="10~135" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="136~170" />
      <Function ID="4" Name="Park" Display="'Park'" Dmx="171~179" />
      <Function ID="5" Name="LED Freq 1000Hz" Display="'LED Freq      1000Hz'" Dmx="180~188" />
      <Function ID="6" Name="LED Freq 1500Hz" Display="'LED Freq      1500Hz'" Dmx="189~197" />
      <Function ID="7" Name="LED Freq 2000Hz" Display="'LED Freq      2000Hz'" Dmx="198~206" />
      <Function ID="8" Name="LED Freq 2500Hz" Display="'LED Freq      2500Hz'" Dmx="207~215" />
      <Function ID="9" Name="LED Freq 3000Hz" Display="'LED Freq      3000Hz'" Dmx="216~224" />
      <Function ID="10" Name="LED Freq 3500Hz" Display="'LED Freq      3500Hz'" Dmx="225~233" />
      <Function ID="11" Name="LED Freq 4000Hz" Display="'LED Freq      4000Hz'" Dmx="234~242" />
      <Function ID="12" Name="LED Freq 4500Hz" Display="'LED Freq      4500Hz'" Dmx="243~251" />
      <Function ID="13" Name="LED Freq 5000Hz" Display="'LED Freq      5000Hz'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX, 8bit" Channels="16">
    <Import PearlRef="CM_StLtLED1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Red1" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green1" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue1" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White1" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Red2" ChannelOffset="6" Wheel="40" />
      <Attribute ID="Green2" ChannelOffset="7" Wheel="41" />
      <Attribute ID="Blue2" ChannelOffset="8" Wheel="42" />
      <Attribute ID="White2" ChannelOffset="9" Wheel="37" />
      <Attribute ID="Effect" ChannelOffset="15" Wheel="23" />
      <Attribute ID="LEDLine1" ChannelOffset="11" Wheel="25" />
      <Attribute ID="LEDLine2" ChannelOffset="12" Wheel="26" />
      <Attribute ID="LEDLine3" ChannelOffset="13" Wheel="27" />
      <Attribute ID="Auto_Func" ChannelOffset="14" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
    <Cells>
      <Master>
        <Attribute ID="White" Wheel="9" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
        <Attribute ID="LEDLine1" ChannelOffset="11" Wheel="25" />
        <Attribute ID="LEDLine2" ChannelOffset="12" Wheel="26" />
        <Attribute ID="LEDLine3" ChannelOffset="13" Wheel="27" />
        <Attribute ID="Auto_Func" ChannelOffset="14" Wheel="29" />
        <Attribute ID="Effect" ChannelOffset="15" Wheel="23" />
        <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="RGBW cell, 4 DMX" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="6" ModeLink="RGBW cell, 4 DMX" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="12 DMX, 8bit" Channels="12">
    <Import PearlRef="CM_StLtLED2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Effect" ChannelOffset="11" Wheel="23" />
      <Attribute ID="LEDLine1" ChannelOffset="7" Wheel="25" />
      <Attribute ID="LEDLine2" ChannelOffset="8" Wheel="26" />
      <Attribute ID="LEDLine3" ChannelOffset="9" Wheel="27" />
      <Attribute ID="Auto_Func" ChannelOffset="10" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="RGBW cell, 4 DMX" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>

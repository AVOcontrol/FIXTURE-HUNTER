    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~203" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="180~202" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="179~128" />
    </Attribute>
    <Attribute ID="Chase_xFade" Name="Chase xFade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase_Offset" Name="Chase Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.f°',0~360" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase_Time" Name="Chase Time" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Fade" Display="'No Fade'" Dmx="0~0" />
      <Function ID="2" Name="Time" Display="'%.fms',0~4000" Dmx="1~255" />
    </Attribute>
  </Control>

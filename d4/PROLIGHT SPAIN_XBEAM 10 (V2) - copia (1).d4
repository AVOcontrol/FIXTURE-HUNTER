      <Function ID="30" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="100~107" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="31" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="108~115" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />

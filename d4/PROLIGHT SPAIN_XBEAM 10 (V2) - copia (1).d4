      <Function ID="35" Name="Hole" Display="'Hole'" Dmx="1~4" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="36" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="130~137" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="37" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="138~145" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="38" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="146~153" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />

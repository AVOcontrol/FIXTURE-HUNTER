      <Palette ID="11" Name="UV Filter" Number="9" Page="1" SetControl="Colour1:14,Colour1Func:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:6,Colour1Func:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:8,Colour1Func:1" />
      <Palette ID="14" Name="UV Filter" Number="8" Page="1" SetControl="Colour1:14,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:11,Colour1Func:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:12,Gobo2Func:2" />
      <Palette ID="2" Name="Gobo 1" Number="12" Page="1" SetControl="Gobo1:2,Gobo1Func:1,Gobo2:12,Gobo2Func:2" />
      <Palette ID="3" Name="Gobo 2" Number="13" Page="1" SetControl="Gobo1:3,Gobo1Func:1,Gobo2:12,Gobo2Func:2" />

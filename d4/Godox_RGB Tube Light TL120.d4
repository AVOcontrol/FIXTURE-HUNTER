    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Cycle" Display="'RGB Cycle'" Dmx="0~0" />
      <Function ID="2" Name="Flash" Display="'Flash'" Dmx="18~35" />
      <Function ID="3" Name="Disco" Display="'Disco'" Dmx="36~53" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="54~71" />
      <Function ID="5" Name="Broken Bulb" Display="'Broken Bulb'" Dmx="72~89" />
      <Function ID="6" Name="TV" Display="'TV'" Dmx="90~107" />
      <Function ID="7" Name="Candle" Display="'Candle'" Dmx="108~125" />
      <Function ID="8" Name="Fire" Display="'Fire'" Dmx="126~143" />
      <Function ID="9" Name="Firework" Display="'Firework'" Dmx="144~161" />
      <Function ID="10" Name="Police Car" Display="'Police Car'" Dmx="162~179" />
      <Function ID="11" Name="Fire Truck" Display="'Fire Truck'" Dmx="180~197" />
      <Function ID="12" Name="Ambulance" Display="'Ambulance'" Dmx="198~215" />
      <Function ID="13" Name="Music" Display="'Music'" Dmx="216~233" />
      <Function ID="14" Name="SOS" Display="'SOS'" Dmx="234~255" />

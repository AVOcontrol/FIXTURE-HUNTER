    <Attribute ID="Effect_Type" Name="Effect Type" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="I" Display="'I'" Dmx="0~0" />
      <Function ID="2" Name="II" Display="'II'" Dmx="86~171" />
      <Function ID="3" Name="III" Display="'III'" Dmx="255~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lee" Display="'Lee'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Rosco" Display="'Rosco'" Dmx="255~255" Colour="255,255,255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gel" Name="Gel" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />

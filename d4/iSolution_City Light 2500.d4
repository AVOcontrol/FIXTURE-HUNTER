<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="City Light 2500" ShortName="CityL2500" Company="iSolution">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="20-02-07" Author="D.Milligan" Comment="Created" />
  <History Date="20-02-07" Author="D.Milligan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="01-03-11" Author="Nic Morris" Comment="Adapted from Showtec City Painter 2500" />
  <History Date="25-02-17" Author="Nic Morris" Comment="Revised c-mix power on, locate, highlight and lowlight values (assumed subtractive)." />
  <History Date="25-02-17" Author="Nic Morris" Comment="Temporarily changed c-mix attribute ID's to 'Subtractive' to solve compatibility issues pending improved colour model support." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="RedSubtractive" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="BlueSubtractive" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="YellowSubtractive" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
  </Control>
  <Mode Name="5 DMX, 8bit" Channels="5">
    <Import PearlRef="ISO_CL2500" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="RedSubtractive" ChannelOffset="3" Wheel="10" />
      <Attribute ID="BlueSubtractive" ChannelOffset="4" Wheel="12" />
      <Attribute ID="YellowSubtractive" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Speed" ChannelOffset="1" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
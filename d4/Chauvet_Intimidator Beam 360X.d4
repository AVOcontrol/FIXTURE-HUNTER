      <Function ID="21" Name="Blu/ CTO" Display="'Blu/ CTO'" Dmx="84~87" WheelPosition="5" Colour="0,0,255" />
      <Function ID="22" Name="CTO/ Cy" Display="'CTO/ Cy'" Dmx="88~91" WheelPosition="6" Colour="255,230,150" />
      <Function ID="23" Name="Cy/ Mag" Display="'Cy/ Mag'" Dmx="92~95" WheelPosition="7" Colour="0,255,255" />
      <Function ID="24" Name="Mag/ Lm" Display="'Mag/ Lm'" Dmx="96~99" WheelPosition="8" Colour="255,0,255" />
      <Function ID="25" Name="Lm/ Ppl" Display="'Lm/ Ppl'" Dmx="100~103" WheelPosition="9" Colour="0,200,0" />
      <Function ID="26" Name="Ppl/ D Yel" Display="'Ppl/ D Yel'" Dmx="104~107" WheelPosition="10" Colour="128,0,255" />
      <Function ID="27" Name="D Yel/ Pk" Display="'D Yel/ Pk'" Dmx="108~111" WheelPosition="11" Colour="180,180,0" />
      <Function ID="28" Name="Pk/ CTB" Display="'Pk/ CTB'" Dmx="112~115" WheelPosition="12" Colour="255,150,150" />
      <Function ID="29" Name="CTB/ UV" Display="'CTB/ UV'" Dmx="116~119" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="UV/ Op" Display="'UV/ Op'" Dmx="120~127" WheelPosition="14" Colour="180,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~128" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="192~255" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~10000" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="0 Green" Display="'0 Green'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="100 Magenta" Display="'100 Magenta'" Dmx="21~33" Colour="0,0,0" />
      <Function ID="3" Name="+ Magenta" Display="'+ Magenta %.f',99~1" Dmx="34~134" Colour="0,0,0" />
      <Function ID="4" Name="0 Green" Display="'0 Green'" Dmx="135~145" Colour="0,0,0" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f',1~99" Dmx="146~244" Colour="0,0,0" />
      <Function ID="6" Name="100 Green" Display="'100 Green'" Dmx="245~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~359.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel" Name="Gel" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="1700K" Display="'1700K'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="3" Name="2000K" Display="'2000K'" Dmx="26~30" Colour="255,255,255" />
      <Function ID="4" Name="2700K" Display="'2700K'" Dmx="31~35" Colour="255,255,255" />
      <Function ID="5" Name="3200K" Display="'3200K'" Dmx="36~40" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="41~45" Colour="255,255,255" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="46~50" Colour="255,0,0" />
      <Function ID="8" Name="Green" Display="'Green'" Dmx="51~55" Colour="0,255,0" />
      <Function ID="9" Name="Blue" Display="'Blue'" Dmx="56~60" Colour="0,0,255" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="61~65" Colour="255,0,255" />
      <Function ID="11" Name="Yellow" Display="'Yellow'" Dmx="66~70" Colour="255,255,0" />
      <Function ID="12" Name="Orange" Display="'Orange'" Dmx="71~75" Colour="255,128,0" />
      <Function ID="13" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="21~25" />
      <Function ID="3" Name="Paparazzi" Display="'Paparazzi'" Dmx="26~30" />
      <Function ID="4" Name="Short-Circuit" Display="'Short-Circuit'" Dmx="31~35" />
      <Function ID="5" Name="Cop Car 1" Display="'Cop Car 1'" Dmx="36~40" />
      <Function ID="6" Name="Cop Car 2" Display="'Cop Car 2'" Dmx="41~45" />
      <Function ID="7" Name="Fire" Display="'Fire'" Dmx="46~50" />
      <Function ID="8" Name="Rainbow" Display="'Rainbow'" Dmx="51~55" />
      <Function ID="9" Name="Breath" Display="'Breath'" Dmx="56~60" />
      <Function ID="10" Name="Pixel Rainbow" Display="'Pixel Rainbow'" Dmx="61~65" />
      <Function ID="11" Name="Meteor" Display="'Meteor'" Dmx="66~70" />
      <Function ID="12" Name="Meteor 2" Display="'Meteor 2'" Dmx="71~75" />
      <Function ID="13" Name="(Meteor 3)" Display="'(Meteor 3)'" Dmx="76~80" />
      <Function ID="14" Name="(Music 1)" Display="'(Music 1)'" Dmx="81~85" />
      <Function ID="15" Name="(Music 2)" Display="'(Music 2)'" Dmx="86~90" />
      <Function ID="16" Name="Random Col" Display="'Random Col'" Dmx="91~95" />
      <Function ID="17" Name="Random Col Meteor" Display="'Random Col Meteor'" Dmx="96~100" />
      <Function ID="18" Name="(Random 3)" Display="'(Random 3)'" Dmx="101~105" />
      <Function ID="19" Name="(Stars)" Display="'(Stars)'" Dmx="106~110" />
      <Function ID="20" Name="Cop Light 3" Display="'Cop Light 3'" Dmx="111~115" />
      <Function ID="21" Name="(Cop Light 4)" Display="'(Cop Light 4)'" Dmx="116~120" />
      <Function ID="22" Name="(Mode 2)" Display="'(Mode 2)'" Dmx="121~125" />
      <Function ID="23" Name="Pile Up" Display="'Pile Up'" Dmx="126~130" />
      <Function ID="24" Name="Pile Up 2" Display="'Pile Up 2'" Dmx="131~135" />
      <Function ID="25" Name="(Pixel Fire)" Display="'(Pixel Fire)'" Dmx="136~140" />
      <Function ID="26" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed_Rate" Name="Speed Rate" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="50%" Display="'50%'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="21~255" />
    </Attribute>
    <Attribute ID="Effect_Colour" Name="Effect Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default (White)" Display="'Default (White)'" Dmx="0~0" />
      <Function ID="2" Name="Random" Display="'Random'" Dmx="21~50" />
      <Function ID="3" Name="Rainbow Cycle" Display="'Rainbow Cycle'" Dmx="51~80" />
      <Function ID="4" Name="Custom" Display="'Custom'" Dmx="81~110" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

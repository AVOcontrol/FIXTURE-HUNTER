      <Function ID="8" Name="Col Macro Fade Time" Display="'Col Macro Fade Time %.f%%',0~100" Dmx="121~141" />
      <Function ID="9" Name="Tungsten Wire Effect Open" Display="'Tungsten Wire Effect Open'" Dmx="150~154" />
      <Function ID="10" Name="Tungsten Wire Effect Off" Display="'Tungsten Wire Effect Off'" Dmx="155~159" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Full Power Output" Display="'Full Power Output'" Dmx="25~34" />
      <Function ID="3" Name="Low Power Output" Display="'Low Power Output'" Dmx="35~44" />

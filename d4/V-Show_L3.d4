      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~37" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="38~74" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="75~111" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="112~148" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="149~195" Colour="255,150,150" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="196~222" Colour="0,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="223~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="1~20" />

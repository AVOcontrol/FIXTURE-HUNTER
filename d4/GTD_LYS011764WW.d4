<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LYS011764WW" ShortName="LYS011764W" Company="GTD">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-12-17" Author="Nic Morris" Comment="Created (note charts have variable colour temp controls yet there are separate CW and WW models - Capture not supported at the moment)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="3159K" Display="'3159K'" Dmx="18~34" Colour="255,255,255" />
      <Function ID="3" Name="3407K" Display="'3407K'" Dmx="35~51" Colour="255,255,255" />
      <Function ID="4" Name="3608K" Display="'3608K'" Dmx="52~68" Colour="255,255,255" />
      <Function ID="5" Name="3796K" Display="'3796K'" Dmx="69~85" Colour="255,255,255" />
      <Function ID="6" Name="4208K" Display="'4208K'" Dmx="86~102" Colour="255,255,255" />
      <Function ID="7" Name="4407K" Display="'4407K'" Dmx="103~119" Colour="255,255,255" />
      <Function ID="8" Name="4597K" Display="'4597K'" Dmx="120~136" Colour="255,255,255" />
      <Function ID="9" Name="4634K" Display="'4634K'" Dmx="137~153" Colour="255,255,255" />
      <Function ID="10" Name="4791K" Display="'4791K'" Dmx="154~170" Colour="255,255,255" />
      <Function ID="11" Name="5010K" Display="'5010K'" Dmx="171~187" Colour="255,255,255" />
      <Function ID="12" Name="5200K" Display="'5200K'" Dmx="188~204" Colour="255,255,255" />
      <Function ID="13" Name="5400K" Display="'5400K'" Dmx="205~221" Colour="255,255,255" />
      <Function ID="14" Name="5600K" Display="'5600K'" Dmx="222~238" Colour="255,255,255" />
      <Function ID="15" Name="5800K" Display="'5800K'" Dmx="239~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 7 DMX" Channels="7">
    <Import PearlRef="UKGT64W7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="3,4" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="5,6" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="7" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="Simplified, 4 DMX" Channels="4">
    <Import PearlRef="UKGT64W4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
    </Include>
  </Mode>
</Fixture>
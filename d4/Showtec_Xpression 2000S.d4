      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="150~164" WheelPosition="4">
        <Swatch>4fa6225e-1281-4e60-8b12-c1d11d67d6bb</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="165~179" WheelPosition="5">
        <Swatch>d6808f0e-849d-4c27-9ec6-072fc0245d24</Swatch>

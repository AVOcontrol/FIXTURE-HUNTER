      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="180~194" WheelPosition="6">
        <Swatch>c27f9606-c616-4e05-9595-4a85387dadfa</Swatch>
      </Function>
      <Function ID="15" Name="Open" Display="'Open'" Dmx="208~211" WheelPosition="0">

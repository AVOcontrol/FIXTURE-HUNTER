      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="90~104" WheelPosition="6">
        <Swatch>c27f9606-c616-4e05-9595-4a85387dadfa</Swatch>
      </Function>
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>648cd77f-eae0-4770-adc8-ac016c49f606</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="105~119" WheelPosition="1">
        <Swatch>8e6b53e3-51a1-46ec-953b-1b52073b18b8</Swatch>

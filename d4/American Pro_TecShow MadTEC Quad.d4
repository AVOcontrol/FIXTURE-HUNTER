      <Function ID="9" Name="Tokyo Blue" Display="'Tokyo Blue'" Dmx="45~49" Colour="0,0,255" />
      <Function ID="10" Name="Deep Blue" Display="'Deep Blue'" Dmx="50~54" Colour="0,0,180" />
      <Function ID="11" Name="Just Blue" Display="'Just Blue'" Dmx="55~59" Colour="0,128,255" />
      <Function ID="12" Name="Medium Blue" Display="'Medium Blue'" Dmx="60~64" Colour="128,255,255" />

      <Function ID="26" Name="Lime Green" Display="'Lime Green'" Dmx="130~134" Colour="128,255,0" />
      <Function ID="27" Name="Spring Yellow" Display="'Spring Yellow'" Dmx="135~139" Colour="255,255,0" />
      <Function ID="28" Name="Deep Amber" Display="'Deep Amber'" Dmx="140~144" Colour="255,100,0" />
      <Function ID="29" Name="Chrome Orange" Display="'Chrome Orange'" Dmx="145~149" Colour="255,128,0" />
      <Function ID="30" Name="Orange" Display="'Orange'" Dmx="150~154" Colour="255,128,0" />
      <Function ID="31" Name="Gold Amber" Display="'Gold Amber'" Dmx="155~159" Colour="255,128,0" />
      <Function ID="32" Name="Millennium Gold" Display="'Millennium Gold'" Dmx="160~164" Colour="255,128,0" />
      <Function ID="33" Name="Deep Golden Amber" Display="'Deep Golden Amber'" Dmx="165~169" Colour="255,100,0" />
      <Function ID="34" Name="Red" Display="'Red'" Dmx="170~174" Colour="255,0,0" />
      <Function ID="35" Name="Open" Display="'Open'" Dmx="230~234" Colour="255,255,255" />
      <Function ID="36" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="180~201" Colour="0,0,0" />
      <Function ID="37" Name="No Scroll" Display="'No Scroll'" Dmx="202~207" Colour="255,255,255" />
      <Function ID="38" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="208~229" Colour="0,0,0" />
      <Function ID="39" Name="Open" Display="'Open'" Dmx="250~255" Colour="255,255,255" />
      <Function ID="40" Name="Rand Slow" Display="'Rand Slow'" Dmx="245~249" Colour="255,255,255" />
      <Function ID="41" Name="Rand Med" Display="'Rand Med'" Dmx="240~244" Colour="255,255,255" />
      <Function ID="42" Name="Rand Fast" Display="'Rand Fast'" Dmx="235~239" Colour="255,255,255" />
      <Function ID="43" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

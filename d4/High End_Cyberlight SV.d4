    <Attribute ID="MSpeed" Name="MSpeed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe 0" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Safe 255" Display="'Safe'" Dmx="255~255" />
      <Function ID="3" Name="Home" Display="'Home'" Dmx="64~64" />
      <Function ID="4" Name="Shutdown" Display="'Shutdown'" Dmx="128~128" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed (Full Spd)" Display="'Fixed (Full Spd)'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Fixed (MSpd)" Display="'Fixed (MSpd)'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Split (Full Spd)" Display="'Split (Full Spd)'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="4" Name="Split (MSpd)" Display="'Split (MSpd)'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="5" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed (Full Spd)" Display="'Fixed (Full Spd)'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed (MSpd)" Display="'Fixed (MSpd)'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake (Full Spd)" Display="'Shake (Full Spd)'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Shake (MSpd)" Display="'Shake (MSpd)'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index (Full Spd)" Display="'Index (Full Spd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="2" Name="Index (MSpd)" Display="'Index (MSpd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="3" Name="Spin CW (Full Spd)" Display="'Spin CW (Full Spd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="4" Name="Spin CW (MSpd)" Display="'Spin CW (MSpd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="5" Name="Spin CCW (Full Spd)" Display="'Spin CCW (Full Spd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="6" Name="Spin CCW (MSpd)" Display="'Spin CCW (MSpd)'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" Update="Effect" />
      <Function ID="2" Name="MSpeed" Display="'MSpeed'" Dmx="0~0" Update="Effect" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Effect" />
    </Attribute>
  </Control>

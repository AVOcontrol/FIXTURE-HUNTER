    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index (Full Spd)" ID="1,2,3,4,5,6" If="'Gobo2Func'==1" />
      <Condition Name="Index (MSpd)" ID="7,8,9,10,11,12" If="'Gobo2Func'==2" />
      <Condition Name="Spin CW (Full Spd)" ID="13,14,15,16,17" If="'Gobo2Func'==3" />

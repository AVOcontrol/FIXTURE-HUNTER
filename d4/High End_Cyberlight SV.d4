<Fixture Name="Cyberlight SV" ShortName="CyberLt SV" Company="High End">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>fd9a756a-24a6-43e8-b589-0db4a84af37d</Thumbnail>
  <History Date="04-09-01" Author="Edward" Comment="Created" />
  <History Date="28-11-02" Author="D.Shelton" Comment="Updated to work with current software version" />
  <History Date="16-12-02" Author="D.Shelton" Comment="Updated referencing of 16-bit channels" />
  <History Date="06-01-03" Author="D.Shelton" Comment="Standardised Display of Channels" />
  <History Date="13-06-03" Author="D.Shelton" Comment="Updated Personality" />
  <History Date="01-11-03" Author="S.Anwar" Comment="Created Macros" />
  <History Date="06-11-03" Author="Oliver Waits" Comment="Checked" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 1. Pan - Different sensitivity to mode 2 + inverted (Mode1)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 2. Tilt - Different sensitivity to mode 2 + inverted (To slow)(Mode1)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 3. Colour - Raw DMX only no levels. Different encoder to mode 2(Mode1)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 4. Yellow - (Locate) 255 (Mode1)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 5. Zoom - (Power On) 255, (Locate) 255, No encoder for it (Mode1+Mode2)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 6. Focus - (Locate) 127 (Mode1)" />
  <History Date="09-02-04" Author="L.Gallagher" Comment="Error Found 7. Iris - (Power On) 0, (Locate) 0 (Mode1+Mode2+Mode3)" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 1: Safe macro does nothing" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 2: No legends on colour (mode 1)" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 3: No legends on gobo (mode 1)" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 4: Zoom is missing" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 5: Frost has no legend (mode 2)" />
  <History Date="04-03-05" Author="Dave Trounce" Comment="Error 6: Could do with Colour/Gobo function wheels." />
  <History Date="17-03-05" Author="Phil" Comment="Can't fix Mode 1 legends - DMX value information isn't available (even in brand new manual)" />
  <History Date="17-03-05" Author="Phil" Comment="Fixed macro problem, zoom wheel and frost legends." />
  <History Date="26-04-05" Author="Phil" Comment="Added Colour1Func wheel" />
  <History Date="05-08-05" Author="Ed" Comment="Added two function wheels for gobo1 and gobo2" />
  <History Date="05-08-05" Author="Ed" Comment="Added a function wheel for effect" />
  <History Date="11-08-05" Author="Phil" Comment="Fixed minor problem with zoom" />
  <History Date="07-07-06" Author="Ed" Comment="Fixed All colour mix attributes to be Cmixes" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Colour Func ID to Colour1Func" />
  <History Date="19-07-06" Author="D4 Pers Fixer" Comment="Updated Gobo Func ID to Gobo1Func" />
  <History Date="05-09-06" Author="Ed" Comment="Fixed CMY channels and fixed locate values" />
  <History Date="23-03-09" Author="Jonathan Moreton" Comment="Removed missing update attributes &amp; fixed illegal control locate &amp; poweron" />
  <History Date="29-03-12" Author="Peter Budd" Comment="Edited for version 6." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Removed RDM ID's.  Split from High End Cyberlight for Capture compatibility.  Added product thumbnail." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Removed invalid updates from Colour Func.  Renamed Gobo Func to Gobo 1 Func" />
  <History Date="18-02-19" Author="Nic Morris" Comment="Standardised conditionals.  Increased wheel resolution." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Changed Mode 2 to use the same fixed colours as Mode 3.  Added missing 'Mspeed' options." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Added function index.  Standardised highlight/lowlight." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Changed mode 2 to use the same gobo 1 as mode 3 (there was essentially no difference)." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Added missing Mspeed options to gobo 1.  Removed invalid updates from Gobo1Func." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Changed mode 2 to use the same gobo 2 as mode 3.  Removed invalid updates from Gobo2Func." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Added missing Mspeed options to gobo 2.  Revised index/spin options.  Added palettes." />
  <History Date="18-02-19" Author="Nic Morris" Comment="Revised effect with missing MSpd options." />
  <Manual Filename="/manual/High-End_CyberLight.pdf" Summary="Created:High End, 20/12/1996" />
  <AtlaBase TypeID="7135c006-3031-45a0-ba90-0b975b0ab428" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed (Full Spd)" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Fixed (MSpd)" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Split (Full Spd)" ID="17,18,19,20,21,22,23,24" If="'Colour1Func'==3" />
      <Condition Name="Split (MSpd)" ID="25,26,27,28,29,30,31,32" If="'Colour1Func'==4" />
      <Condition Name="Scroll" ID="33,34,35,36" If="'Colour1Func'==5" />
      <Else ID="37" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="245~245" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Purple" Display="'Purple'" Dmx="237~237" WheelPosition="2" Colour="150,0,255" />
      <Function ID="4" Name="CL Col Correction" Display="'CL Col Correction'" Dmx="230~230" WheelPosition="3" Colour="255,255,255" />
      <Function ID="5" Name="Aqua" Display="'Aqua'" Dmx="222~222" WheelPosition="4" Colour="0,255,192" />
      <Function ID="6" Name="Dark Blue" Display="'Dark Blue'" Dmx="211~211" WheelPosition="5" Colour="0,0,200" />
      <Function ID="7" Name="Dark Orange" Display="'Dark Orange'" Dmx="204~204" WheelPosition="6" Colour="200,100,0" />
      <Function ID="8" Name="Indigo" Display="'Indigo'" Dmx="196~196" WheelPosition="7" Colour="100,0,200" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="189~189" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="181~181" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="173~173" WheelPosition="2" Colour="150,0,255" />
      <Function ID="12" Name="CL Col Correction" Display="'CL Col Correction'" Dmx="166~166" WheelPosition="3" Colour="255,255,255" />
      <Function ID="13" Name="Aqua" Display="'Aqua'" Dmx="158~158" WheelPosition="4" Colour="0,255,192" />
      <Function ID="14" Name="Dark Blue" Display="'Dark Blue'" Dmx="150~150" WheelPosition="5" Colour="0,0,200" />
      <Function ID="15" Name="Dark Orange" Display="'Dark Orange'" Dmx="143~143" WheelPosition="6" Colour="200,100,0" />
      <Function ID="16" Name="Indigo" Display="'Indigo'" Dmx="133~133" WheelPosition="7" Colour="100,0,200" />
      <Function ID="17" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="250~250" WheelPosition="0" Colour="255,255,255" />
      <Function ID="18" Name="Rd/ Ppl" Display="'Rd/ Ppl'" Dmx="240~240" WheelPosition="1" Colour="255,0,0" />
      <Function ID="19" Name="Ppl/ CL CC" Display="'Ppl/ CL CC'" Dmx="232~232" WheelPosition="2" Colour="150,0,255" />
      <Function ID="20" Name="CL CC/ Aq" Display="'CL CC/ Aq'" Dmx="224~224" WheelPosition="3" Colour="255,255,255" />
      <Function ID="21" Name="Aq/ D Blu" Display="'Aq/ D Blu'" Dmx="217~217" WheelPosition="4" Colour="0,255,192" />
      <Function ID="22" Name="D Blu/ D Org" Display="'D Blu/ D Org'" Dmx="209~209" WheelPosition="5" Colour="0,0,200" />
      <Function ID="23" Name="D Org/ Ind" Display="'D Org/ Ind'" Dmx="201~201" WheelPosition="6" Colour="200,100,0" />
      <Function ID="24" Name="Ind/ Op" Display="'Ind/ Op'" Dmx="194~194" WheelPosition="7" Colour="100,0,200" />
      <Function ID="25" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="186~186" WheelPosition="0" Colour="255,255,255" />
      <Function ID="26" Name="Rd/ Ppl" Display="'Rd/ Ppl'" Dmx="179~179" WheelPosition="1" Colour="255,0,0" />
      <Function ID="27" Name="Ppl/ CL CC" Display="'Ppl/ CL CC'" Dmx="168~168" WheelPosition="2" Colour="150,0,255" />
      <Function ID="28" Name="CL CC/ Aq" Display="'CL CC/ Aq'" Dmx="161~161" WheelPosition="3" Colour="255,255,255" />
      <Function ID="29" Name="Aq/ D Blu" Display="'Aq/ D Blu'" Dmx="156~156" WheelPosition="4" Colour="0,255,192" />
      <Function ID="30" Name="D Blu/ D Org" Display="'D Blu/ D Org'" Dmx="145~145" WheelPosition="5" Colour="0,0,200" />
      <Function ID="31" Name="D Org/ Ind" Display="'D Org/ Ind'" Dmx="138~138" WheelPosition="6" Colour="200,100,0" />
      <Function ID="32" Name="Ind/ Op" Display="'Ind/ Op'" Dmx="130~130" WheelPosition="7" Colour="100,0,200" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="65~65" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="127~66" Colour="0,0,0" />
      <Function ID="35" Name="No Scroll" Display="'No Scroll'" Dmx="65~65" Colour="0,0,0" />
      <Function ID="36" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="64~2" Colour="0,0,0" />
      <Function ID="37" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:255" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo 1" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed (Full Spd)" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Fixed (MSpd)" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Shake (Full Spd)" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==3" />
      <Condition Name="Shake (MSpd)" ID="25,26,27,28,29,30,31,32" If="'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="33,34,35,36" If="'Gobo1Func'==5" />
      <Else ID="37" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0">
        <Swatch>823e3c4d-6e9e-4adc-840a-dbeb293d3c60</Swatch>
      </Function>

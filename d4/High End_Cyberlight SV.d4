    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Full Spd" ID="1,2,3,4,5,6,7,8,9" If="'Effect_Func'==1" />
      <Condition Name="MSpd" ID="10,11,12,13,14,15,16,17,18" If="'Effect_Func'==2" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="255~255" WheelPosition="0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="143~143" WheelPosition="1" />
      <Function ID="3" Name="CMY Tri-col mosaic" Display="'CMY Tri-col mosaic'" Dmx="158~158" WheelPosition="2" />
      <Function ID="4" Name="Yel Col Correction" Display="'Yel Col Correction'" Dmx="171~171" WheelPosition="3" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="186~186" WheelPosition="4" />
      <Function ID="6" Name="Mag Col Correction" Display="'Mag Col Correction'" Dmx="204~204" WheelPosition="5" />
      <Function ID="7" Name="Wide Angle" Display="'Wide Angle'" Dmx="217~217" WheelPosition="6" />
      <Function ID="8" Name="Diffusion" Display="'Diffusion'" Dmx="232~232" WheelPosition="7" />
      <Function ID="9" Name="Cyan Col Correction" Display="'Cyan Col Correction'" Dmx="245~245" WheelPosition="8" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="11" Name="Prism" Display="'Prism'" Dmx="20~20" WheelPosition="1" />
      <Function ID="12" Name="CMY Tri-col mosaic" Display="'CMY Tri-col mosaic'" Dmx="36~36" WheelPosition="2" />
      <Function ID="13" Name="Yel Col Correction" Display="'Yel Col Correction'" Dmx="54~54" WheelPosition="3" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="69~69" WheelPosition="4" />
      <Function ID="15" Name="Mag Col Correction" Display="'Mag Col Correction'" Dmx="84~84" WheelPosition="5" />
      <Function ID="16" Name="Wide Angle" Display="'Wide Angle'" Dmx="94~94" WheelPosition="6" />
      <Function ID="17" Name="Diffusion" Display="'Diffusion'" Dmx="112~112" WheelPosition="7" />
      <Function ID="18" Name="Cyan Col Correction" Display="'Cyan Col Correction'" Dmx="127~127" WheelPosition="8" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost %.1f%%',0.0~100.0" Dmx="255~129" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Frost Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~126" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~247" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />

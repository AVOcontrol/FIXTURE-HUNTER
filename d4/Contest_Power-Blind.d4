    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="11~40" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="41~70" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="71~100" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="101~130" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="131~160" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="161~190" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="191~220" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="1~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>

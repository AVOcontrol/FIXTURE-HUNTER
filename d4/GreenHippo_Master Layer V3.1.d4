<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Master Layer V3.1" ShortName="MLayerV3.1" Company="Green Hippo">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="03-04-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Brightness" Name="Brightness" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Brightness" Display="'Brightness %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Contrast" Name="Contrast" Description="" Group="I">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Contrast" Display="'Contrast %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Live_Mask" Name="Live Mask" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Live Mask" Display="'Live Mask %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Video_Map" Name="Video Map" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Video_Map_Mix" Name="Video Map Mix" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Mixmode" Display="'Mixmode %.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mix_Morph" Name="Mix Morph" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Map_Select_A" Name="Map Select A" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select A" Display="'Select A %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Map_Select_B" Name="Map Select B" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Select B" Display="'Select B %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Volume" Name="Volume" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Volume" Display="'Volume %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Brightness" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Contrast" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Volume" ChannelOffset="10" Wheel="6" />
      <Attribute ID="Map_Select_A" ChannelOffset="8" Wheel="13" />
      <Attribute ID="Map_Select_B" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Live_Mask" ChannelOffset="4" Wheel="28" />
      <Attribute ID="Video_Map_Mix" ChannelOffset="6" Wheel="23" />
      <Attribute ID="Video_Map" ChannelOffset="5" Wheel="22" />
      <Attribute ID="Mix_Morph" ChannelOffset="7" Wheel="29" />
    </Include>
  </Mode>
</Fixture>
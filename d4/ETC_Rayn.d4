  <Copyright Notice="© Avolites Ltd. 2021" />
  <History Date="19-02-21" Author="Nic Morris" Comment="Created (very strange.  channels only.  apparently the white controls need to be fired in parallel.  feels like an unfinished product.  manufacturer and product name questionable)" Version="0" />
  <History Date="19-02-21" Author="Nic Morris" Comment="Deliberately excluded all components from the colour picker and similar colour mix functions as only a small number are currently supported and would likely just be unhelpful." Version="0" />
  <Manual Filename="" Summary="" />
  <Control>

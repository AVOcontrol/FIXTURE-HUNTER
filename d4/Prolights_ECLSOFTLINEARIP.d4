<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="ECLSOFTLINEARIP" ShortName="ECLSFTLNIP" Company="Prolights" Version="68">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>37093381-b8ba-4efd-96c8-1ef5590b0ae1</Thumbnail>
  <History Date="20-03-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="30-06-19" Author="Nic Morris" Comment="Updated to latest charts (completely different.  note pixel layout unavailable.  guessed).  Added product thumbnail." Version="2" />
  <History Date="03-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Changed name from ECLPANELTWC800 to ECLPANELTWC in response to manufacturer request." Version="4" />
  <History Date="18-03-20" Author="Nic Morris" Comment="Revised CCT, Hue and Effect function ranges in line with latest charts in response to manufacturer request." Version="4" />
  <History Date="26-05-20" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWC" Version="5" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Changed CTC to a single variable range and added an 'Open' range to the 10 and 15 channel 'Theatre' modes in response to manufacturer request." Version="6" />
  <History Date="07-07-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />
  <History Date="31-12-21" Author="Nic Morris" Comment="Added Film modes in line with latest charts in response to manufacturer request.  Added 21 channel theatre mode.  Added product thumbnail." Version="7" />
  <History Date="24-06-22" Author="Nic Morris" Comment="Created from Prolights ECLPANELTWCJNR (extremely confusing documentation.  1 and 2 channel 'legacy' theatre modes not included in overview but are in detailed charts.  not clear how 'pixel engine' parts work)" Version="9" />
  <History Date="24-06-22" Author="Nic Morris" Comment="(dynamically changing colour model not currently supported.  HSI modes contain a dimmer and intensity control - this doesn't make sense and isn't fully compatible.  used gels from Arri Skypanel)" Version="17" />
  <History Date="25-06-22" Author="Nic Morris" Comment="Fixed gel condition statements (Gel Category No Function was missing if statement preventing the others from working).  Swapped source and category wheel slots." Version="19" />
  <History Date="01-07-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="20" />
  <History Date="02-07-22" Author="Nic Morris" Comment="Fixed missing DMX values in Control2 functions." Version="21" />
  <History Date="08-08-22" Author="Nic Morris" Comment="Arranged pixel layout in pixel engine extended mode in response to manufacturer feedback." Version="22" />
  <History Date="08-10-22" Author="Nic Morris" Comment="Created from Prolights ECLNANOPANELTWC.  Ridiculous number of modes.  Documentation is extremely confusing, llittered with errors and missing information." Version="23" />
  <History Date="08-10-22" Author="Nic Morris" Comment="(as with ECLNANOPANELTWC dynamically changing colour model not currently supported.  HSI modes contain a dimmer and intensity control - this doesn't make sense and isn't fully compatible)" Version="23" />
  <History Date="08-10-22" Author="Nic Morris" Comment="(RDM mode IDs are missing for 1 and 2 channel theatre modes, pixel engine modes and, unlike the ECLNANOPANELTWC,  the Basic, Standard, Extended and Direct modes all only have one RDM mode ID.  As each of these is actually 4 modes these cannot be used)" Version="23" />
  <History Date="08-10-22" Author="Nic Morris" Comment="(Gel charts have confusing titles and look wrong.  assumed the same as ARRI and left unchanged.  Similarly, source emulation @ fluorescent is identical to incandescent - this is almost certainly wrong)" Version="26" />
  <History Date="10-10-22" Author="Nic Morris" Comment="Added missing White Preset conditions and functions  to Param 1 and 2.  Corrected swapped param 4 and 5 Lightning functions." Version="65" />
  <History Date="12-10-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="68" />
  <Manual Filename="" Summary="" />

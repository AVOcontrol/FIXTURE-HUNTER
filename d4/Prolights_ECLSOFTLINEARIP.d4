    <Attribute ID="Category" Name="Category" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Source" Colour="255,255,255" />
      <Function ID="2" Name="Incandescent" Display="'Incandescent'" Dmx="1~50" Update="Source" Colour="255,255,255" />
      <Function ID="3" Name="Fluorescent" Display="'Fluorescent'" Dmx="51~100" Update="Source" Colour="255,255,255" />
      <Function ID="4" Name="Discharge" Display="'Discharge'" Dmx="101~150" Update="Source" Colour="255,255,255" />
      <Function ID="5" Name="Other" Display="'Other'" Dmx="151~200" Update="Source" Colour="255,255,255" />

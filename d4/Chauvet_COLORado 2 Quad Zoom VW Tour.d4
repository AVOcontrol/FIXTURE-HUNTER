<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORado 2 Quad Zoom VW Tour" ShortName="CR 2Q ZmVW" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="04-07-14" Author="Nic Morris" Comment="Created" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from COLORado 2-Quad Zoom VW Tour to COLORado 2 Quad Zoom VW Tour (removed hyphen for consistency and sorting across range)." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Added channel counts to mode names.  Revised cool and warm white attribute ID's for compatibility." />
  <History Date="04-10-17" Author="Nic Morris" Comment="Added zoom palettes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8f0a6b7d-5d0b-4ce9-8944-942f54cd4d25" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White_Macro" Name="White Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="White 1" Display="'White 1'" Dmx="11~50" Colour="255,255,255" />
      <Function ID="3" Name="White 2" Display="'White 2'" Dmx="51~80" Colour="255,255,255" />
      <Function ID="4" Name="White 3" Display="'White 3'" Dmx="81~110" Colour="255,255,255" />
      <Function ID="5" Name="White 4" Display="'White 4'" Dmx="111~140" Colour="255,255,255" />
      <Function ID="6" Name="White 5" Display="'White 5'" Dmx="141~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="201~220" />
    </Attribute>
  </Control>
  <Mode Name="STD.P, 10 DMX" Channels="10">
    <Import PearlRef="CH2QZVW1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="ea6e4799-6a2b-494f-bc8b-6b7f96bd5d11" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="3,4" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="5,6" Wheel="8" />
      <Attribute ID="White_Macro" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="STD.Y, 10 DMX" Channels="10">
    <Import PearlRef="CH2QZVW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="dbb02179-5f80-4507-aae5-18d181f0b12e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="WarmWhite" ChannelOffset="3,4" Wheel="7" />
      <Attribute ID="ColdWhite" ChannelOffset="5,6" Wheel="8" />
      <Attribute ID="White_Macro" ChannelOffset="7" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="9" Wheel="19" />
      <Attribute ID="Control" ChannelOffset="10" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="STD.W, 6 DMX" Channels="6">
    <Import PearlRef="CH2QZVW3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4dd34d25-9c5a-44d2-bc2e-74fd943dd735" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White_Macro" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="5" Wheel="19" />

  <AtlaBase TypeID="2999d6a2-7f17-4f74-8e08-1e5ee03d655f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="136~145" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="146~155" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="156~165" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="166~175" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="176~185" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="186~195" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="196~205" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="206~215" />
      <Function ID="10" Name="Cycle Auto 1-8" Display="'Cycle Auto 1-8'" Dmx="216~225" />
      <Function ID="11" Name="Yellow Gradient Effect" Display="'Yellow Gradient Effect'" Dmx="226~235" />
      <Function ID="12" Name="Cycle Gradient Effect" Display="'Cycle Gradient Effect'" Dmx="236~245" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_BG_Col" Name="Auto BG Col" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />

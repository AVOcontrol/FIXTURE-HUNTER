  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="4" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15,16" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~14" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~24" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~34" WheelPosition="3" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~44" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="50~54" WheelPosition="5" Colour="255,128,0" />
      <Function ID="7" Name="Light Blue" Display="'Light Blue'" Dmx="60~64" WheelPosition="6" Colour="0,128,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="70~74" WheelPosition="7" Colour="255,0,255" />
      <Function ID="9" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="25~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="13" Name="Yel/ Org" Display="'Yel/ Org'" Dmx="45~49" WheelPosition="4" Colour="255,255,0" />
      <Function ID="14" Name="Org/ L Blu" Display="'Org/ L Blu'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="15" Name="L Blu/ Mag" Display="'L Blu/ Mag'" Dmx="65~69" WheelPosition="6" Colour="0,128,255" />
      <Function ID="16" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="75~79" WheelPosition="7" Colour="255,0,255" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="80~167" Colour="0,0,0" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

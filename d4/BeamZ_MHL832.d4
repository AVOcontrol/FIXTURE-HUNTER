    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Gradual" Display="'Gradual'" Dmx="2~60" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="61~120" />
      <Function ID="4" Name="Gradual+Jump" Display="'Gradual+Jump'" Dmx="121~180" />
      <Function ID="5" Name="Sound Flash" Display="'Sound Flash'" Dmx="181~240" />
      <Function ID="6" Name="Sound Jump" Display="'Sound Jump'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">

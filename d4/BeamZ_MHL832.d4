      <Function ID="2" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="49087~32896" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49344~65535" />

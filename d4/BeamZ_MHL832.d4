      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49344~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

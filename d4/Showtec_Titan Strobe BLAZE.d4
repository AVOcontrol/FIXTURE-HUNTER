  <History Date="29-08-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="23-09-21" Author="Nic Morris" Comment="Changed Shutter Func Blinder to variable range in response to customer feedback (there is no suggestion in the documetation that this is variable)." Version="3" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1ec37933-7839-4b91-ba9f-087649dd2117" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Blinder" Display="'Blinder %.f%%',0~100" Dmx="130~159" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="160~189" />
      <Function ID="4" Name="Lightning" Display="'Lightning'" Dmx="190~229" />
      <Function ID="5" Name="Sync" Display="'Sync'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="LED_Dimmer" Name="LED Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="20~29" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="30~39" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~49" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="50~59" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="60~69" Colour="0,0,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="70~79" Colour="255,150,150" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="80~89" Colour="255,0,255" />
      <Function ID="10" Name="Program 1" Display="'Program 1 %.f%%',0~100" Dmx="90~131" WheelPosition="1" Colour="0,0,0" />
      <Function ID="11" Name="Program 2" Display="'Program 2 %.f%%',0~100" Dmx="132~173" WheelPosition="2" Colour="0,0,0" />
      <Function ID="12" Name="Program 3" Display="'Program 3 %.f%%',0~100" Dmx="174~215" WheelPosition="3" Colour="0,0,0" />
      <Function ID="13" Name="Program 4" Display="'Program 4 %.f%%',0~100" Dmx="216~255" WheelPosition="4" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="LED_Shutter" Name="LED Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~127" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">

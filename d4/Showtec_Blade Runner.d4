<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Blade Runner" ShortName="Bld Runner" Company="Showtec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="30-04-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Programs" Name="Programs" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Speed" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="1~9" Update="Speed" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="10~19" Update="Speed" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="20~29" Update="Speed" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="30~39" Update="Speed" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="40~49" Update="Speed" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="50~59" Update="Speed" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="60~69" Update="Speed" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="70~79" Update="Speed" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="80~89" Update="Speed" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="90~99" Update="Speed" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="100~109" Update="Speed" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="110~119" Update="Speed" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="120~129" Update="Speed" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="130~139" Update="Speed" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="140~149" Update="Speed" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="150~159" Update="Speed" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="160~169" Update="Speed" />
      <Function ID="19" Name="Program 18" Display="'Program 18'" Dmx="170~179" Update="Speed" />
      <Function ID="20" Name="Program 19" Display="'Program 19'" Dmx="180~189" Update="Speed" />
      <Function ID="21" Name="Program 20" Display="'Program 20'" Dmx="190~199" Update="Speed" />
      <Function ID="22" Name="Program 21" Display="'Program 21'" Dmx="200~209" Update="Speed" />
      <Function ID="23" Name="Program 22" Display="'Program 22'" Dmx="210~219" Update="Speed" />
      <Function ID="24" Name="Program 23" Display="'Program 23'" Dmx="220~229" Update="Speed" />
      <Function ID="25" Name="Program 24" Display="'Program 24'" Dmx="230~239" Update="Speed" />
      <Function ID="26" Name="Program 25" Display="'Program 25'" Dmx="240~249" Update="Speed" />
      <Function ID="27" Name="Sound" Display="'Sound'" Dmx="250~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Programs'==27" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==13" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~22" Update="Shutter" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="23~45" Update="Shutter" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="46~68" Update="Shutter" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="69~91" Update="Shutter" />
      <Function ID="6" Name="White" Display="'White'" Dmx="92~114" Update="Shutter" />
      <Function ID="7" Name="Amber+ White" Display="'Amber+ White'" Dmx="115~137" Update="Shutter" />
      <Function ID="8" Name="Red+ Green" Display="'Red+ Green'" Dmx="138~160" Update="Shutter" />
      <Function ID="9" Name="Red+ Blue" Display="'Red+ Blue'" Dmx="161~183" Update="Shutter" />
      <Function ID="10" Name="Green+ Blue" Display="'Green+ Blue'" Dmx="184~206" Update="Shutter" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="207~229" Update="Shutter" />
      <Function ID="12" Name="R+G+B+A+W" Display="'R+G+B+A+W'" Dmx="230~252" Update="Shutter" />
      <Function ID="13" Name="Sound" Display="'Sound'" Dmx="253~255" Update="Shutter" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="SHBLRUN3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Programs" ChannelOffset="1" Wheel="25" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="SHBLRUN2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
      <Function ID="14" Name="Bab Bulb Effect" Display="'Bab Bulb Effect'" Dmx="127~144" Update="Param_2, Param_3, Param_4, Param_5, Param_6" />
      <Function ID="15" Name="Firework Effect" Display="'Firework Effect'" Dmx="145~162" Update="Param_2, Param_3, Param_4, Param_5, Param_6" />

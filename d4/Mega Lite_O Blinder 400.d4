      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="101~150" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="151~200" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

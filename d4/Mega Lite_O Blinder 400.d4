      <Function ID="6" Name="1+2,3+4 Fade" Display="'1+2,3+4 Fade %.f%%',0~100" Dmx="110~134" />
      <Function ID="7" Name="1+2,3+4 Chase" Display="'1+2,3+4 Chase %.f%%',0~100" Dmx="135~159" />
      <Function ID="8" Name="1+3,2+4 Fade" Display="'1+3,2+4 Fade %.f%%',0~100" Dmx="160~184" />
      <Function ID="9" Name="1+3,2+4 Chase" Display="'1+3,2+4 Chase %.f%%',0~100" Dmx="185~209" />
      <Function ID="10" Name="1+4,2+3 Fade" Display="'1+4,2+3 Fade %.f%%',0~100" Dmx="210~234" />
      <Function ID="11" Name="1+4,2+3 Chase" Display="'1+4,2+3 Chase %.f%%',0~100" Dmx="235~255" />

      <Function ID="3" Name="1200Hz" Display="'1200Hz'" Dmx="51~100" />
      <Function ID="4" Name="2000Hz" Display="'2000Hz'" Dmx="101~150" />
      <Function ID="5" Name="4000Hz" Display="'4000Hz'" Dmx="151~200" />
      <Function ID="6" Name="25KHz" Display="'25KHz'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORbank 4" ShortName="COLORbank4" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-07-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="40dea658-b7fe-451e-9446-b59e46a32930" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB Mode" Display="'RGB Mode'" Dmx="210~219" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~0" Update="Red, Green, Blue, Dimmer" WheelPosition="0" Colour="0,0,0" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="10~19" Update="Red, Green, Blue, Dimmer" Colour="255,0,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="20~29" Update="Red, Green, Blue, Dimmer" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="30~39" Update="Red, Green, Blue, Dimmer" Colour="0,0,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="40~49" Update="Red, Green, Blue, Dimmer" Colour="255,255,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="50~59" Update="Red, Green, Blue, Dimmer" Colour="128,0,255" />
      <Function ID="8" Name="Cyan" Display="'Cyan'" Dmx="60~69" Update="Red, Green, Blue, Dimmer" Colour="0,255,255" />
      <Function ID="9" Name="White" Display="'White'" Dmx="70~79" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="10" Name="Col Change 1" Display="'Col Change 1'" Dmx="80~89" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="11" Name="Col Change 2" Display="'Col Change 2'" Dmx="90~99" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="12" Name="Col Change 3" Display="'Col Change 3'" Dmx="100~109" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="Col Change 4" Display="'Col Change 4'" Dmx="110~119" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="14" Name="Col Change 5" Display="'Col Change 5'" Dmx="120~129" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="15" Name="Col Change 6" Display="'Col Change 6'" Dmx="130~139" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="16" Name="Col Chase 1" Display="'Col Chase 1'" Dmx="140~149" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="17" Name="Col Chase 2" Display="'Col Chase 2'" Dmx="150~159" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="18" Name="Col Chase 3" Display="'Col Chase 3'" Dmx="160~169" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="19" Name="Col Chase 4" Display="'Col Chase 4'" Dmx="170~179" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="20" Name="Col Chase 5" Display="'Col Chase 5'" Dmx="180~189" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="21" Name="Col Chase 6" Display="'Col Chase 6'" Dmx="190~199" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="22" Name="Col Chase 7" Display="'Col Chase 7'" Dmx="200~209" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="23" Name="Col Fade" Display="'Col Fade'" Dmx="220~229" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
      <Function ID="24" Name="Sound" Display="'Sound'" Dmx="230~255" Update="Red, Green, Blue, Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;9&amp;&amp;'Colour_Macro'&lt;24" />
      <Condition Name="No Function" ID="3" If="'Colour_Macro'==2||'Colour_Macro'==3||'Colour_Macro'==4||'Colour_Macro'==5||'Colour_Macro'==6||'Colour_Macro'==7||'Colour_Macro'==8||'Colour_Macro'==9||'Colour_Macro'==24" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="3" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Shutter" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Condition Name="No Function" ID="4" If="'Colour_Macro'&gt;13" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~249" Colour="0,0,0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Colour="0,0,0" />
      <Function ID="4" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="No Function" ID="2" If="'Colour_Macro'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="CHCBANK4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="01754d8e-a24f-43bd-860b-40095dfa7471" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
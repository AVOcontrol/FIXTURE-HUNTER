<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="200W LED Beam" ShortName="200W Beam" Company="Rudderstar" Version="1">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>1190f01b-ae34-4a46-8253-c4895d9ae1bf</Thumbnail>
  <History Date="12-11-25" Author="Nic Morris" Comment="Created (poor documentation)" Version="0" />
  <History Date="14-11-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e814c36c-0cf9-4b68-84cb-ab92494fb462" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Colour1Func'==1" />
      <Condition Name="Scroll" ID="2,3,4,5" If="'Colour1Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Colour" Display="'Colour %.1f%%',0.0~100.0" Dmx="0~139" Colour="0,0,0" />
      <Function ID="2" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~197" Colour="0,0,0" />
      <Function ID="4" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="198~255" Colour="0,0,0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="2" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="3,4,5,6" If="'Gobo1Func'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Gobo" Display="'Gobo %.f%%',0~100" Dmx="0~79" />
      <Function ID="2" Name="Gobo Shake" Display="'Gobo Shake %.f%%',0~100" Dmx="80~159" />
      <Function ID="3" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="4" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="160~202" />
      <Function ID="5" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="6" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="203~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="100~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="7_Col_Effect" Name="7 Col Effect" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="7 Col Effect" Display="'7 Col Effect'" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="30~59" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="60~89" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="90~119" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="120~149" />
      <Function ID="6" Name="Sound 1" Display="'Sound 1'" Dmx="150~179" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="180~209" />
      <Function ID="8" Name="Sound 3" Display="'Sound 3'" Dmx="210~239" />
      <Function ID="9" Name="Sound 4" Display="'Sound 4'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto Pan" Display="'Auto Pan'" Dmx="21~100" />
      <Function ID="3" Name="Auto Tilt" Display="'Auto Tilt'" Dmx="101~200" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="8abd378c-9337-4647-a855-4edc4d18ec72">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="41c7259f-b360-4246-8976-d6aa13b61ee2" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="3" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="5" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="7" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="8" Wheel="23" />
      <Attribute ID="7_Col_Effect" ChannelOffset="9" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="10" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13" Id="2ce680db-1a11-463e-b5b0-5eda0e271c52">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="9f1eedec-a037-4e5f-8e56-048584b8ec42" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="5" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="8" Wheel="8" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1" ChannelOffset="9" Wheel="14" />
      <Attribute ID="Prism" ChannelOffset="10" Wheel="23" />
      <Attribute ID="7_Col_Effect" ChannelOffset="11" Wheel="9" />
      <Attribute ID="Auto" ChannelOffset="12" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />

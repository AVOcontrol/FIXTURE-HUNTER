    <Attribute ID="Prism_2_Rot" Name="Prism 2 Rot" Description="" Group="E">
      <Locate Locate="6:0" PowerOn="6:0" />
      <Condition Name="Index" ID="1" If="'Prism'==4||'Prism'==6||'Prism'==9" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'==5||'Prism'==7||'Prism'==8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="6:0" PowerOn="6:0" />
      <Condition Name="Index" ID="1" If="'Prism'==2||'Prism'==4||'Prism'==6" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Prism'==3||'Prism'==5||'Prism'==7" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="1~127" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="128~129" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGB Full" Display="'RGB Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="CTO 1" Display="'CTO 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="CTO 2" Display="'CTO 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="CTO 3" Display="'CTO 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="CTO 4" Display="'CTO 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="CTO 5" Display="'CTO 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="CTO 6" Display="'CTO 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="CTO 7" Display="'CTO 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="CTO 8" Display="'CTO 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="CTO 9" Display="'CTO 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="CTO 10" Display="'CTO 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="CTO 11" Display="'CTO 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~54" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="55~76" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="77~98" />
      <Function ID="6" Name="Auto 5 (1-4)" Display="'Auto 5 (1-4)'" Dmx="99~120" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="121~142" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="143~164" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="165~186" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="187~208" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="209~230" />
      <Function ID="12" Name="Auto 11 (6-10)" Display="'Auto 11 (6-10)'" Dmx="231~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Med" Display="'Med'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Effect_Spd" />
      <Function ID="2" Name="R" Display="'R'" Dmx="1~7" Update="Effect_Spd" />
      <Function ID="3" Name="R+G" Display="'R+G'" Dmx="8~15" Update="Effect_Spd" />
      <Function ID="4" Name="G" Display="'G'" Dmx="16~23" Update="Effect_Spd" />
      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="24~31" Update="Effect_Spd" />
      <Function ID="6" Name="B" Display="'B'" Dmx="32~39" Update="Effect_Spd" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="40~47" Update="Effect_Spd" />
      <Function ID="8" Name="R+G+B" Display="'R+G+B'" Dmx="48~55" Update="Effect_Spd" />
      <Function ID="9" Name="Program 1" Display="'Program 1'" Dmx="56~63" Update="Effect_Spd" />
      <Function ID="10" Name="Program 2" Display="'Program 2'" Dmx="64~71" Update="Effect_Spd" />
      <Function ID="11" Name="Program 3" Display="'Program 3'" Dmx="72~79" Update="Effect_Spd" />

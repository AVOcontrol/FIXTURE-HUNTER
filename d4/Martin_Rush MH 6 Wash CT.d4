  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="39fc79d5-02d5-4e79-8a1d-3a6320b47938" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Variable" Display="'%.fK',2700~7800" Dmx="27~72" Colour="255,240,200" />
      <Function ID="3" Name="7800K" Display="'7800K'" Dmx="73~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset All" Display="'Reset All'" Dmx="10~14" />
      <Function ID="3" Name="Enable Cal" Display="'Enable Cal'" Dmx="55~59" />
      <Function ID="4" Name="P/T Normal" Display="'P/T Normal'" Dmx="75~79" />
      <Function ID="5" Name="P/T Fast" Display="'P/T Fast'" Dmx="80~89" />
      <Function ID="6" Name="P/T Slow" Display="'P/T Slow'" Dmx="90~94" />
      <Function ID="7" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="145~149" />
      <Function ID="8" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="150~154" />
      <Function ID="9" Name="Display On" Display="'Display On'" Dmx="155~159" />
      <Function ID="10" Name="Display Off" Display="'Display Off'" Dmx="160~164" />
      <Function ID="11" Name="Store Zoom Cal" Display="'Store Zoom Cal'" Dmx="230~234" />
      <Function ID="12" Name="Store Pan Cal" Display="'Store Pan Cal'" Dmx="235~239" />
      <Function ID="13" Name="Store Tilt Cal" Display="'Store Tilt Cal'" Dmx="240~244" />
      <Function ID="14" Name="Reset Cal" Display="'Reset Cal'" Dmx="245~249" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="MTRMH6CT" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="220" PanMaxSpeed="0" TiltMaxSpeed="0" />

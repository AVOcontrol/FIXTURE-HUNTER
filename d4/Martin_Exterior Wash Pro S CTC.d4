  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="cc632674-ab29-4b9a-be9f-89c589060dc7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="2400K" Display="'2400K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2450-3950K" Display="'%.fK',2450~3950" Dmx="47~77" Colour="0,0,0" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="78~78" Colour="0,0,0" />
      <Function ID="4" Name="4050-6450K" Display="'%.fK',4050~6450" Dmx="79~127" Colour="0,0,0" />
      <Function ID="5" Name="6500K" Display="'6500K'" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="White" Name="Medium White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="Basic, 3 DMX" Channels="3" Id="b9768f16-f645-4f07-bb9a-baec21165149">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="aca65d23-8137-45da-a223-67329a467323" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

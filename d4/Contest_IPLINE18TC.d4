      <Function ID="16" Name="Blend 8" Display="'Blend 8'" Dmx="184~191" Update="Shutter" />
      <Function ID="17" Name="Chase 1" Display="'Chase 1'" Dmx="192~199" Update="Shutter" />
      <Function ID="18" Name="Chase 2" Display="'Chase 2'" Dmx="200~207" Update="Shutter" />
      <Function ID="19" Name="Chase 3" Display="'Chase 3'" Dmx="208~215" Update="Shutter" />
      <Function ID="20" Name="Chase 4" Display="'Chase 4'" Dmx="216~223" Update="Shutter" />
      <Function ID="21" Name="Chase 5" Display="'Chase 5'" Dmx="224~231" Update="Shutter" />
      <Function ID="22" Name="Chase 6" Display="'Chase 6'" Dmx="232~239" Update="Shutter" />
      <Function ID="23" Name="Chase 7" Display="'Chase 7'" Dmx="240~247" Update="Shutter" />
      <Function ID="24" Name="Chase 8" Display="'Chase 8'" Dmx="248~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2" />
      <Condition Name="Speed" ID="3" If="'Effect'&gt;16" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="189~189" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~249" />
      <Function ID="4" Name="Full" Display="'Full'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Effect1" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~30" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="31~45" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="46~60" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="61~75" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="76~90" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="91~105" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="106~120" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="121~135" />
      <Function ID="10" Name="Cold White (6000K)" Display="'Cold White (6000K)'" Dmx="136~150" />
      <Function ID="11" Name="Warm White (3200K)" Display="'Warm White (3200K)'" Dmx="151~165" />
      <Function ID="12" Name="Col Macro 1" Display="'Col Macro 1'" Dmx="166~180" />
      <Function ID="13" Name="Col Macro 2" Display="'Col Macro 2'" Dmx="181~195" />
      <Function ID="14" Name="Col Macro 3" Display="'Col Macro 3'" Dmx="196~210" />
      <Function ID="15" Name="Col Macro 4" Display="'Col Macro 4'" Dmx="211~225" />
      <Function ID="16" Name="Col Macro 5" Display="'Col Macro 5'" Dmx="226~240" />
      <Function ID="17" Name="Col Macro 6" Display="'Col Macro 6'" Dmx="241~255" />
    </Attribute>
  </Control>

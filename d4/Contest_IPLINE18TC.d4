  <AtlaBase TypeID="4560c8da-363d-4aff-9b09-05991b2c6872" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~31" Update="Shutter" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="32~47" Update="Shutter" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="48~63" Update="Shutter" />

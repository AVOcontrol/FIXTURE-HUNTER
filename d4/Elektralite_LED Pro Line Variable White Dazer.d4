<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Pro Line Variable White Dazer" ShortName="White Dazr" Company="Elektralite">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="23-05-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Sync Slow" Display="'Sync Slow %.f%%',0~100" Dmx="10~49" Intensity="0~0" />
      <Function ID="3" Name="Async Slow" Display="'Async Slow %.f%%',0~100" Dmx="50~99" Intensity="0~0" />
      <Function ID="4" Name="Rnd Sync Slow" Display="'Rnd Sync Slow %.f%%',0~100" Dmx="100~149" Intensity="0~0" />
      <Function ID="5" Name="Rnd Async Fast" Display="'Rnd Async Fast %.f%%',0~100" Dmx="150~199" Intensity="0~0" />
      <Function ID="6" Name="Sync Fast" Display="'Sync Fast %.f%%',0~100" Dmx="200~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~50" />
      <Function ID="2" Name="Curve 1" Display="'Curve 1'" Dmx="51~100" />
      <Function ID="3" Name="Curve 2" Display="'Curve 2'" Dmx="101~150" />
      <Function ID="4" Name="Curve 3" Display="'Curve 3'" Dmx="151~200" />
      <Function ID="5" Name="Curve 4" Display="'Curve 4'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="ID" Display="'ID %.f',1~255" Dmx="1~255" />
    </Attribute>
  </Control>
  <Mode Name="W.A" Channels="3">
    <Import PearlRef="EKPLVWD1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="White" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="Dim_Spd" ChannelOffset="3" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="MA.d" Channels="4">
    <Import PearlRef="EKPLVWD2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Dim_Spd" ChannelOffset="4" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="MA.s" Channels="5">
    <Import PearlRef="EKPLVWD3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Dim_Spd" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="WS.Id" Channels="6">
    <Import PearlRef="EKPLVWD4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Amber" ChannelOffset="3" Wheel="9" />
      <Attribute ID="Dim_Spd" ChannelOffset="5" Wheel="25" />
      <Attribute ID="ID" ChannelOffset="6" Wheel="28" />
    </Include>
  </Mode>
</Fixture>
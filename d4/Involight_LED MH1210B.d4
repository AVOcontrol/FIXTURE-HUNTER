    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="255~1" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Control Relay On" Display="'Control Relay On'" Dmx="1~25" />
      <Function ID="3" Name="Control Relay Off" Display="'Control Relay Off'" Dmx="26~50" />
      <Function ID="4" Name="Col Pulse" Display="'Col Pulse'" Dmx="51~130" />
      <Function ID="5" Name="Col Random" Display="'Col Random'" Dmx="131~170" />
      <Function ID="6" Name="Col Fade" Display="'Col Fade'" Dmx="171~210" />
      <Function ID="7" Name="Auto" Display="'Auto'" Dmx="211~250" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

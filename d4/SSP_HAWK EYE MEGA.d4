      <Function ID="51" Name="Bumping 3" Display="'Bumping 3'" Dmx="59~59" Update="Shape_Speed, Shape_Offset" />
      <Function ID="52" Name="Vert Pix Scrolling" Display="'Vert Pix Scrolling'" Dmx="60~60" Update="Shape_Speed, Shape_Offset" />
      <Function ID="53" Name="Rand Vert Section" Display="'Rand Vert Section'" Dmx="61~61" Update="Shape_Speed, Shape_Offset" />
      <Function ID="54" Name="Rand Cent Section" Display="'Rand Cent Section'" Dmx="62~62" Update="Shape_Speed, Shape_Offset" />

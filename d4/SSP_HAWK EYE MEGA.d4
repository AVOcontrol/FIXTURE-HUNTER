      <Function ID="60" Name="Single Pix Ring 2" Display="'Single Pix Ring 2'" Dmx="68~68" Update="Shape_Speed, Shape_Offset" />
      <Function ID="61" Name="Single Pix Ring 3" Display="'Single Pix Ring 3'" Dmx="69~69" Update="Shape_Speed, Shape_Offset" />
      <Function ID="62" Name="Spiral" Display="'Spiral'" Dmx="70~70" Update="Shape_Speed, Shape_Offset" />
    </Attribute>
    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Ring" ID="2,3,4,5" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Random" ID="6,7,8,9" If="'Shape'==11||'Shape'==12" />
      <Condition Name="Rainbow" ID="10,11,12,13" If="'Shape'==14||'Shape'&gt;21" />
      <Condition Name="Speed" ID="14,15,16,17" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="4" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="6" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="7" Name="Open Pulse" Display="'Open Pulse %.f%%',100~0" Dmx="64~158" />
      <Function ID="8" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="9" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="161~255" />
      <Function ID="10" Name="Stop" Display="'Stop'" Dmx="0~63" />
      <Function ID="11" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="12" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="13" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
      <Function ID="14" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="15" Name="CCW Spin" Display="'CCW Spin %.f%%',100~0" Dmx="64~158" />
      <Function ID="16" Name="Stop" Display="'Stop'" Dmx="159~160" />
      <Function ID="17" Name="CW Spin" Display="'CW Spin %.f%%',0~100" Dmx="161~255" />
    </Attribute>

    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shape_Trans" Name="Shape Trans" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Fade" Display="'No Fade'" Dmx="0~0" />
      <Function ID="2" Name="Fade" Display="'Fade %.fms',100~4000" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shape_Offset" Name="Shape Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Distribution" ID="2,3" If="'Shape'==7||'Shape'==8||'Shape'==9||'Shape'==10" />
      <Condition Name="Random" ID="4" If="'Shape'==11||'Shape'==23||'Shape'==53||'Shape'==54||'Shape'==55||'Shape'==56||'Shape'==57||'Shape'==58" />
      <Condition Name="Density" ID="5" If="'Shape'==12" />
      <Condition Name="Offset" ID="6" If="'Shape'==13||'Shape'==15||'Shape'==16||'Shape'==17||'Shape'==18||'Shape'==19||'Shape'==20||'Shape'==21" />
      <Condition Name="Width" ID="7" If="'Shape'==22||'Shape'==24||'Shape'==28||'Shape'==29||'Shape'==30||'Shape'==31||'Shape'==37||'Shape'==38||'Shape'==39||'Shape'==40||'Shape'==41||'Shape'==42||'Shape'==43||'Shape'==46||'Shape'==47||'Shape'==52||'Shape'==62" />
      <Condition Name="Macro Offset" ID="8" If="'Shape'==25||'Shape'==26||'Shape'==27||'Shape'==32||'Shape'==33||'Shape'==34||'Shape'==35||'Shape'==36||'Shape'==48||'Shape'==49||'Shape'==50||'Shape'==51" />
      <Condition Name="Shape Offset" ID="9" If="'Shape'==44||'Shape'==45" />
      <Condition Name="LEDs" ID="10" If="'Shape'==59||'Shape'==60||'Shape'==61" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Continuous" Display="'Continuous'" Dmx="0~0" />
      <Function ID="3" Name="Random" Display="'Random %.1f%%',0.0~100.0" Dmx="10~255" />
      <Function ID="4" Name="Random" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Density" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="6" Name="Offset" Display="'%.f°',0~360" Dmx="0~255" />
      <Function ID="7" Name="Width" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="8" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="9" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="10" Name="No. of LEDs" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FG_Strobe" Name="FG Strobe" Description="" Group="I">

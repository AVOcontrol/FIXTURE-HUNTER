  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3fd38fcb-6c66-435f-9932-8b39c6bede34" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="4" If="'Program'&gt;1&amp;&amp;'Program'&lt;8" />
      <Condition Name="Sensitivity" ID="3" If="'Program'==8" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~31" Update="Shutter" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Update="Shutter" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Update="Shutter" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" Update="Shutter" />
      <Function ID="5" Name="Fade" Display="'Fade'" Dmx="128~159" Update="Shutter" />
      <Function ID="6" Name="3 Col Snap" Display="'3 Col Snap'" Dmx="160~191" Update="Shutter" />
      <Function ID="7" Name="7 Col Snap" Display="'7 Col Snap'" Dmx="192~223" Update="Shutter" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~51" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="102~152" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="153~203" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="204~255" />
    </Attribute>
  </Control>

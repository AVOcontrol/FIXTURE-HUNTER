<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MC 200" ShortName="MC 200" Company="Rayzr">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>9c835d11-eae5-494c-92fe-4c26f418b5f6</Thumbnail>
  <History Date="16-06-19" Author="Nic Morris" Comment="Created (note it is not practical to dynamically change mode by DMX.  this is a poorly considered concept.  defining as separate modes with fixed values instead.  it is not clear how 8/16bit is selected)" />
  <History Date="17-06-19" Author="Nic Morris" Comment="(note some very strange ranges.  Particularly difference between 8 and 16bit which seems unnecessary.  Gel ranges are not documented)" />
  <History Date="17-06-19" Author="Nic Morris" Comment="(Green-Magenta in Light Strobe Effect has conflicting ranges and makes no sense)" />
  <Manual Filename="" Summary="" />
  <Control>

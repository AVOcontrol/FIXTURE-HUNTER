    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Linear" Display="'Linear'" Dmx="0~0" />
      <Function ID="2" Name="Exponential" Display="'Exponential'" Dmx="64~127" />
      <Function ID="3" Name="Logarithmic" Display="'Logarithmic'" Dmx="128~195" />
      <Function ID="4" Name="S-Curve" Display="'S-Curve'" Dmx="196~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1fK',2400.0~9900.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green-Magenta" Name="Green-Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="- Green" Display="'- Green %.2f',-1.00~0.00" Dmx="0~127" Colour="255,255,255" />
      <Function ID="2" Name="+ Green" Display="'+ Green %.2f',0.00~1.00" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTC1" Name="CTC" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="3200K" Display="'3200K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="5600K" Display="'5600K'" Dmx="128~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Brand" Name="Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rosco" Display="'Rosco'" Dmx="0~0" Update="Series" Colour="255,255,255" />
      <Function ID="2" Name="Lee" Display="'Lee'" Dmx="64~127" Update="Series" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Brand16bit" Name="Brand" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Rosco" Display="'Rosco'" Dmx="0~0" Update="Series16bit" Colour="255,255,255" />
      <Function ID="2" Name="Lee" Display="'Lee'" Dmx="128~255" Update="Series16bit" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Series" Name="Series" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Lee" ID="5,6,7,8,9" If="'Brand'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Filters" Display="'Colour Filters'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Sto Selection" Display="'Sto Selection'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Cine Filters" Display="'Cine Filters'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="Colour Filters" Display="'Colour Filters'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="7" Name="600 Series" Display="'600 Series'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="8" Name="Cosmetic" Display="'Cosmetic'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="9" Name="700 Series" Display="'700 Series'" Dmx="128~159" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Series16bit" Name="Series" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Lee" ID="5,6,7,8,9" If="'Brand16bit'==2" />
      <Else ID="1,2,3,4" />
      <Function ID="1" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour Filters" Display="'Colour Filters'" Dmx="25~49" Colour="255,255,255" />
      <Function ID="3" Name="Sto Selection" Display="'Sto Selection'" Dmx="50~74" Colour="255,255,255" />
      <Function ID="4" Name="Cine Filters" Display="'Cine Filters'" Dmx="75~99" Colour="255,255,255" />
      <Function ID="5" Name="Colour Correction" Display="'Colour Correction'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="6" Name="Colour Filters" Display="'Colour Filters'" Dmx="25~49" Colour="255,255,255" />
      <Function ID="7" Name="600 Series" Display="'600 Series'" Dmx="50~74" Colour="255,255,255" />
      <Function ID="8" Name="Cosmetic" Display="'Cosmetic'" Dmx="75~99" Colour="255,255,255" />
      <Function ID="9" Name="700 Series" Display="'700 Series'" Dmx="125~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Gel" Name="Gel" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="x_Coordinate" Name="x Coordinate" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="X" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="y_Coordinate" Name="y Coordinate" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Y" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f°',0.00~360.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Daylight" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="DayLt C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Tungsten" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Tung C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Status" Name="Status" Description="" Group="E">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="128~255" />
      <Function ID="2" Name="Start" Display="'Start'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:6322" PowerOn="1:6278" />
      <Function ID="1" Name="Speed" Display="'%.fms',600~12000" Dmx="0~255" />
    </Attribute>
    <Attribute ID="CCT_(low)" Name="CCT (low)" Description="" Group="E" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CCT" Display="'%.2fK',2400.00~2700.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT_(high)" Name="CCT (high)" Description="" Group="E" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CCT" Display="'%.2fK',2400.00~2700.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour_Variety" Name="Colour Variety" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="86~170" />
      <Function ID="3" Name="Random" Display="'Random'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="Combination" Name="Combination" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blue" Display="'Blue'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="86~170" />
      <Function ID="3" Name="Red+Blue" Display="'Red+Blue'" Dmx="171~255" />
    </Attribute>
    <Attribute ID="CCT_(low)1" Name="CCT (low)" Description="" Group="E" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CCT" Display="'%.2fK',2400.00~9900.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT_(high)1" Name="CCT (high)" Description="" Group="E" Size="2">
      <Locate Locate="1:2400" PowerOn="1:2400" />
      <Function ID="1" Name="CCT" Display="'%.2fK',2400.00~9900.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Speed1" Name="Speed" Description="" Group="E">
      <Locate Locate="1:13" PowerOn="1:13" />
      <Function ID="1" Name="Speed" Display="'%.1f Hz',1.0~25.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="E">
      <Locate Locate="1:10" PowerOn="1:10" />
      <Function ID="1" Name="Duration" Display="'%.1fms',10.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MAXCYC" ShortName="MAXCYC" Company="SSP" Version="14">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>d2906c39-f49c-40fd-b754-0e5f135ef7d1</Thumbnail>
  <History Date="29-03-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Added Macro dependant conditionals.  Changed shutter locate and power on to open." Version="2" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed ID power on and locate to All IDs." Version="3" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed dimmer speed non-linear to explicit values." Version="4" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed HSV attribute groups and wheel mapping.  Added v-dim to PIXEL mode." Version="5" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado 3P Tour." Version="6" />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed Value and replaced with Dimmer for HTP." Version="7" />
  <History Date="03-01-13" Author="Peter Budd" Comment="Created from Chauvet COLORado Ridge IP" Version="8" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." Version="9" />
  <History Date="04-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Increased wheel resolution." Version="10" />
  <History Date="04-02-18" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" Version="11" />
  <History Date="16-10-18" Author="Nic Morris" Comment="Changed name from SS 809 XCA to Max CYC (SS809XCA)" Version="12" />
  <History Date="29-04-26" Author="Nic Morris" Comment="Created from Silver Star Max CYC (SS809XCA)" Version="13" />
  <History Date="06-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="14" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d4800c2f-fe33-4f2a-b1fd-35ab8b766adb" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="White 3200K" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="White 3400K" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="White 4200K" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="White 4900K" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="White 5600K" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="White 5900K" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="White 6500K" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="White 7200K" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="White 8000K" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="White 8500K" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="White 10000K" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" Intensity="0~0" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green, Blue" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="41~50" Update="Red, Green, Blue" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~60" Update="Red, Green, Blue" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~70" Update="Red, Green, Blue" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="71~80" Update="Red, Green, Blue" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="81~90" Update="Red, Green, Blue" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="91~100" Update="Red, Green, Blue" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="101~110" Update="Red, Green, Blue" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="111~120" Update="Red, Green, Blue" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="121~130" Update="Red, Green, Blue" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="131~140" Update="Red, Green, Blue" />
      <Function ID="12" Name="Custom 1" Display="'Custom 1'" Dmx="141~150" Update="Red, Green, Blue" />
      <Function ID="13" Name="Custom 2" Display="'Custom 2'" Dmx="151~160" Update="Red, Green, Blue" />
      <Function ID="14" Name="Custom 3" Display="'Custom 3'" Dmx="161~170" Update="Red, Green, Blue" />
      <Function ID="15" Name="Custom 4" Display="'Custom 4'" Dmx="171~180" Update="Red, Green, Blue" />
      <Function ID="16" Name="Custom 5" Display="'Custom 5'" Dmx="181~190" Update="Red, Green, Blue" />
      <Function ID="17" Name="Custom 6" Display="'Custom 6'" Dmx="191~200" Update="Red, Green, Blue" />
      <Function ID="18" Name="Custom 7" Display="'Custom 7'" Dmx="201~210" Update="Red, Green, Blue" />
      <Function ID="19" Name="Custom 8" Display="'Custom 8'" Dmx="211~220" Update="Red, Green, Blue" />
      <Function ID="20" Name="Custom 9" Display="'Custom 9'" Dmx="221~230" Update="Red, Green, Blue" />
      <Function ID="21" Name="Custom 10" Display="'Custom 10'" Dmx="231~255" Update="Red, Green, Blue" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="10~29" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="30~69" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="70~129" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="130~189" />
      <Function ID="6" Name="Curve 4" Display="'Curve 4'" Dmx="190~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="10~29" Colour="0,0,0" />
      <Function ID="3" Name="3400K" Display="'3400K'" Dmx="30~49" Colour="0,0,0" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="50~69" Colour="0,0,0" />
      <Function ID="5" Name="4900K" Display="'4900K'" Dmx="70~89" Colour="0,0,0" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="90~109" Colour="0,0,0" />
      <Function ID="7" Name="5900K" Display="'5900K'" Dmx="110~129" Colour="0,0,0" />
      <Function ID="8" Name="6500K" Display="'6500K'" Dmx="130~149" Colour="0,0,0" />
      <Function ID="9" Name="7200K" Display="'7200K'" Dmx="150~169" Colour="0,0,0" />
      <Function ID="10" Name="8000K" Display="'8000K'" Dmx="170~189" Colour="0,0,0" />
      <Function ID="11" Name="8500K" Display="'8500K'" Dmx="190~209" Colour="0,0,0" />
      <Function ID="12" Name="10000K" Display="'10000K'" Dmx="210~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
  </Control>

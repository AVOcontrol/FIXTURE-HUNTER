  <History Date="08-01-21" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="09-01-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="09-09-21" Author="Nic Morris" Comment="Changed name from G300LB IP to GLZ300 IP in response to manufacture request (original name has changed)." Version="2" />
  <History Date="09-09-21" Author="Nic Morris" Comment="Added product thumbnail" Version="2" />
  <History Date="10-09-21" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request." Version="3" />
  <History Date="10-09-21" Author="Nic Morris" Comment=" (significant changes including removal of infinite pan, reduction in colour slots, addition of rotating gobo spot slot, more fixed gobos, separates prism into two contol pairs, changes frost to a single control. feels like completely different fixture)" Version="3" />
  <History Date="14-09-21" Author="Nic Morris" Comment="Revised Atlabase ID's." Version="4" />
  <History Date="24-09-21" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (reorders colour slots and changes prism facets)." Version="5" />
  <History Date="24-12-21" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (changes gobo 2 slot count and DMX values. minor change to tilt range)" Version="6" />

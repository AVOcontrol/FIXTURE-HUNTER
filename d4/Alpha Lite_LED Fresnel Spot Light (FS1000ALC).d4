    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="11~20" Colour="255,255,255" />
      <Function ID="3" Name="- Green" Display="'- Green %.f%%',99~0" Dmx="21~119" Colour="255,255,255" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="120~145" Colour="255,255,255" />
      <Function ID="5" Name="+ Green" Display="'+ Green %.f%%',0~99" Dmx="146~244" Colour="255,255,255" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="245~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Crossfade" Name="Crossfade" Description="" Group="C">

      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="38550~39578" WheelPosition="6" Colour="0,0,0" />
      <Function ID="8" Name="Op/ 1" Display="'Op/ 1'" Dmx="39835~40606" WheelPosition="0" Colour="0,0,0" />
      <Function ID="9" Name="1/ 2" Display="'1/ 2'" Dmx="40863~41891" WheelPosition="1" Colour="0,0,0" />
      <Function ID="10" Name="2/ 3" Display="'2/ 3'" Dmx="42148~42919" WheelPosition="2" Colour="0,0,0" />
      <Function ID="11" Name="3/ 4" Display="'3/ 4'" Dmx="43176~44204" WheelPosition="3" Colour="0,0,0" />
      <Function ID="12" Name="4/ 5" Display="'4/ 5'" Dmx="44461~45232" WheelPosition="4" Colour="0,0,0" />
      <Function ID="13" Name="5/ 6" Display="'5/ 6'" Dmx="45489~46517" WheelPosition="5" Colour="0,0,0" />
      <Function ID="14" Name="6/ 7" Display="'6/ 7'" Dmx="46774~48059" WheelPosition="6" Colour="0,0,0" />
      <Function ID="15" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32639" Colour="0,0,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="56797~57825" Colour="0,0,0" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW %.2f%%',100.00~0.00" Dmx="48316~56540" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="56797~57825" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW %.2f%%',0.00~100.00" Dmx="58082~65535" Colour="0,0,0" />

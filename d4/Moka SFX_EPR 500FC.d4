    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe (1)" Display="'Rnd Strobe (1) %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Rnd Strobe (2)" Display="'Rnd Strobe (2) %.f%%',0~100" Dmx="156~207" />
      <Function ID="6" Name="Fade In" Display="'Fade In %.f%%',0~100" Dmx="108~155" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="15" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==4" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="0,0,0" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="32896~33667" WheelPosition="1" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="33924~34695" WheelPosition="2" Colour="0,0,0" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="34952~35980" WheelPosition="3" Colour="0,0,0" />

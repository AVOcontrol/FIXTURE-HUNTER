<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 GB-1 Reflectabeam" ShortName="GB-1" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="16-01-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="249~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="126~6" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="8~37" Update="Auto_Spd" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="38~67" Update="Auto_Spd" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="68~97" Update="Auto_Spd" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="98~127" Update="Auto_Spd" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="128~157" Update="Auto_Spd" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="158~187" Update="Auto_Spd" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="188~217" Update="Auto_Spd" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="218~247" Update="Auto_Spd" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="PTE8GB12" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Auto" ChannelOffset="1" Wheel="23" />
      <Attribute ID="Auto_Spd" ChannelOffset="2" Wheel="24" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Rotate" Wheel="19" />
        <Attribute ID="Auto" ChannelOffset="7" Wheel="23" />
        <Attribute ID="Auto_Spd" ChannelOffset="8" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="1" ModeLink="Cell" X="2" Y="0">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="2" ModeLink="Cell" X="4" Y="2">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="3" ModeLink="Cell" X="3" Y="4">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="4" ModeLink="Cell" X="1" Y="4">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="5" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="6" ModeLink="Cell" X="2" Y="2">
        <AttributeLink SourceId="Rotate" TargetId="Rotate" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Rotate" ChannelOffset="1" Wheel="19" />
    </Include>
  </Mode>
</Fixture>
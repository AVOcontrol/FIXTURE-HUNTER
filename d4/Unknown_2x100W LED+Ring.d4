  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="3d3500c7-134b-463d-a1ac-7f7a4894fb94" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colours" Display="'Colours'" Dmx="51~100" />
      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="101~150" />
      <Function ID="4" Name="Gradual" Display="'Gradual'" Dmx="151~200" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ring_Colour" Name="Ring Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Fixed Red" Display="'Fixed Red'" Dmx="26~35" Colour="255,0,0" />
      <Function ID="3" Name="Fixed Green" Display="'Fixed Green'" Dmx="36~45" Colour="0,255,0" />
      <Function ID="4" Name="Fixed Blue" Display="'Fixed Blue'" Dmx="46~55" Colour="0,0,255" />
      <Function ID="5" Name="Fixed White" Display="'Fixed White'" Dmx="56~65" Colour="255,255,255" />
      <Function ID="6" Name="Fixed Yellow" Display="'Fixed Yellow'" Dmx="66~75" Colour="255,255,0" />
      <Function ID="7" Name="Fixed Pink" Display="'Fixed Pink'" Dmx="76~85" Colour="255,150,150" />
      <Function ID="8" Name="Rot Colour 1" Display="'Rot Colour 1'" Dmx="86~95" Colour="0,0,0" />
      <Function ID="9" Name="Rot Colour 2" Display="'Rot Colour 2'" Dmx="96~105" Colour="0,0,0" />
      <Function ID="10" Name="Rot Colour 3" Display="'Rot Colour 3'" Dmx="106~115" Colour="0,0,0" />
      <Function ID="11" Name="Rot Colour 4" Display="'Rot Colour 4'" Dmx="116~125" Colour="0,0,0" />
      <Function ID="12" Name="Rot Colour 5" Display="'Rot Colour 5'" Dmx="126~135" Colour="0,0,0" />
      <Function ID="13" Name="Rot Colour 6" Display="'Rot Colour 6'" Dmx="136~145" Colour="0,0,0" />
      <Function ID="14" Name="Rot Colour 7" Display="'Rot Colour 7'" Dmx="146~155" Colour="0,0,0" />
      <Function ID="15" Name="Rot Colour 8" Display="'Rot Colour 8'" Dmx="156~165" Colour="0,0,0" />
      <Function ID="16" Name="Rot Colour 9" Display="'Rot Colour 9'" Dmx="166~175" Colour="0,0,0" />
      <Function ID="17" Name="Rot Colour 10" Display="'Rot Colour 10'" Dmx="176~185" Colour="0,0,0" />
      <Function ID="18" Name="Rot Colour 11" Display="'Rot Colour 11'" Dmx="186~195" Colour="0,0,0" />
      <Function ID="19" Name="Rot Colour 12" Display="'Rot Colour 12'" Dmx="196~205" Colour="0,0,0" />
      <Function ID="20" Name="Rot Colour 13" Display="'Rot Colour 13'" Dmx="206~215" Colour="0,0,0" />
      <Function ID="21" Name="Rot Colour 14" Display="'Rot Colour 14'" Dmx="216~225" Colour="0,0,0" />
      <Function ID="22" Name="Rot Colour 15" Display="'Rot Colour 15'" Dmx="226~235" Colour="0,0,0" />
      <Function ID="23" Name="Rot Colour 16" Display="'Rot Colour 16'" Dmx="236~245" Colour="0,0,0" />
      <Function ID="24" Name="Rot Colour 17" Display="'Rot Colour 17'" Dmx="246~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ring_Col_Spd" Name="Ring Col Spd" Description="" Group="C">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ring_Effect" Name="Ring Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" />
      <Function ID="2" Name="Effect 2" Display="'Effect 2'" Dmx="30~59" />
      <Function ID="3" Name="Effect 3" Display="'Effect 3'" Dmx="60~79" />
      <Function ID="4" Name="Effect 4" Display="'Effect 4'" Dmx="80~120" />
      <Function ID="5" Name="Effect 5" Display="'Effect 5'" Dmx="121~150" />
      <Function ID="6" Name="Effect 6" Display="'Effect 6'" Dmx="151~180" />
      <Function ID="7" Name="Effect 7" Display="'Effect 7'" Dmx="181~220" />
      <Function ID="8" Name="Effect 8" Display="'Effect 8'" Dmx="221~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="11 DMX" Channels="11" Id="a5b1e04b-1a6b-4d9c-861d-b8a06b32fcc1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c6e658c5-1cff-4931-835c-5cfc5b52acf4" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="WarmWhite" Wheel="10" />
        <Attribute ID="ColdWhite" Wheel="11" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
        <Attribute ID="Program" ChannelOffset="7" Wheel="22" />
        <Attribute ID="Program_Spd" ChannelOffset="8" Wheel="23" />
        <Attribute ID="Ring_Colour" ChannelOffset="9" Wheel="7" />
        <Attribute ID="Ring_Col_Spd" ChannelOffset="10" Wheel="8" />
        <Attribute ID="Ring_Effect" ChannelOffset="11" Wheel="24" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="4" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="WarmWhite" TargetId="WarmWhite" />
        <AttributeLink SourceId="ColdWhite" TargetId="ColdWhite" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="2" Hidden="True" Id="83960613-9d49-4fe3-83a0-8f2f064c1ba2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <swatchLibrary>

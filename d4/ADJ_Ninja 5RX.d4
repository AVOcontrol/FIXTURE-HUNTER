      <Function ID="10" Name="Yellow Green" Display="'Yellow Green'" Dmx="72~79" Colour="180,180,0" />
      <Function ID="11" Name="Peacock Blue" Display="'Peacock Blue'" Dmx="80~87" Colour="0,255,128" />

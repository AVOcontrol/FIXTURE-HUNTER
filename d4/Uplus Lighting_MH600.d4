  <History Date="16-08-23" Author="Nic Morris" Comment="Added Atlabase ID for 170 channel mode." Version="4" />
  <History Date="12-04-24" Author="Nic Morris" Comment="Created from ACME Super Dotline (China) (TB 1060 CN) (identical.  poor documentation.  no pixel layout or function ranges)" Version="5" />

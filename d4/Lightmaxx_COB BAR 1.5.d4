<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COB BAR 1.5" ShortName="COB Bar1.5" Company="Lightmaxx">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-02-17" Author="Nic Morris" Comment="Created" />
  <History Date="25-04-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Added vdim to 18 DMX cells." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="51f95dbb-b504-4a93-a8ce-d9cbab948e7c" />
  <Control>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Dimmer" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~23" Update="Dimmer" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="24~31" Update="Dimmer" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="32~39" Update="Dimmer" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~47" Update="Dimmer" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="48~55" Update="Dimmer" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="56~63" Update="Dimmer" />
      <Function ID="8" Name="White" Display="'White'" Dmx="64~71" Update="Dimmer" />
      <Function ID="9" Name="Dark Purple" Display="'Dark Purple'" Dmx="72~79" Update="Dimmer" />
      <Function ID="10" Name="Dark Green" Display="'Dark Green'" Dmx="80~87" Update="Dimmer" />
      <Function ID="11" Name="Dark Blue" Display="'Dark Blue'" Dmx="88~95" Update="Dimmer" />
      <Function ID="12" Name="Amber" Display="'Amber'" Dmx="96~103" Update="Dimmer" />
      <Function ID="13" Name="Steel" Display="'Steel'" Dmx="104~111" Update="Dimmer" />
      <Function ID="14" Name="Bright Purple" Display="'Bright Purple'" Dmx="112~119" Update="Dimmer" />
      <Function ID="15" Name="White" Display="'White'" Dmx="120~127" Update="Dimmer" />
      <Function ID="16" Name="Soft Pink" Display="'Soft Pink'" Dmx="128~135" Update="Dimmer" />
      <Function ID="17" Name="Dream" Display="'Dream'" Dmx="136~143" Update="Dimmer" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer" />
      <Function ID="20" Name="Change" Display="'Change'" Dmx="160~167" Update="Dimmer" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer" />
      <Function ID="30" Name="Flow 10" Display="'Flow 10'" Dmx="240~247" Update="Dimmer" />
      <Function ID="31" Name="Sound" Display="'Sound'" Dmx="248~255" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Effect'&gt;16&amp;&amp;'Effect'&lt;31" />
      <Condition Name="Sensitivity" ID="3" If="'Effect'==31" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="1~5" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKLMC153" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />

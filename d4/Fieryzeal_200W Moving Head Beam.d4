    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto Fast" Display="'Auto Fast'" Dmx="10~104" />
      <Function ID="3" Name="Auto Slow" Display="'Auto Slow'" Dmx="105~194" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="195~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="14 DMX" Channels="14" Id="2a67d9b2-f6a1-41d7-a0c7-eedb2e7570d1">

      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="66~71" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="72~77" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="78~83" WheelPosition="13" />
      <Function ID="15" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="16" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="156~161" WheelPosition="1" />
      <Function ID="17" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="150~155" WheelPosition="2" />
      <Function ID="18" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="144~149" WheelPosition="3" />

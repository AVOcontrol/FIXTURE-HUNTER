      <Function ID="21" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="126~131" WheelPosition="6" />
      <Function ID="22" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="120~125" WheelPosition="7" />
      <Function ID="23" Name="Gobo 8 Shake" Display="'Gobo 8 Shake %.f%%',0~100" Dmx="114~119" WheelPosition="8" />
      <Function ID="24" Name="Gobo 9 Shake" Display="'Gobo 9 Shake %.f%%',0~100" Dmx="108~113" WheelPosition="9" />
      <Function ID="25" Name="Gobo 10 Shake" Display="'Gobo 10 Shake %.f%%',0~100" Dmx="102~107" WheelPosition="10" />
      <Function ID="26" Name="Gobo 11 Shake" Display="'Gobo 11 Shake %.f%%',0~100" Dmx="96~101" WheelPosition="11" />
      <Function ID="27" Name="Gobo 12 Shake" Display="'Gobo 12 Shake %.f%%',0~100" Dmx="90~95" WheelPosition="12" />
      <Function ID="28" Name="Gobo 13 Shake" Display="'Gobo 13 Shake %.f%%',0~100" Dmx="84~89" WheelPosition="13" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="162~207" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="208~255" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="100~127" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Colourful" Name="Colourful" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colourful" Display="'Colourful'" Dmx="127~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">

  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Arming" Name="Arming" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Armed" Display="'Armed'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Flame_Time" Name="Flame Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Ignition" Name="Ignition" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Small Fireballs" Display="'Small Fireballs'" Dmx="26~26" />
      <Function ID="3" Name="Medium Fireballs" Display="'Medium Fireballs'" Dmx="51~51" />
      <Function ID="4" Name="Large Fireballs" Display="'Large Fireballs'" Dmx="76~76" />
      <Function ID="5" Name="Small Jet Flame" Display="'Small Jet Flame'" Dmx="102~102" />
      <Function ID="6" Name="Medium Jet Flame" Display="'Medium Jet Flame'" Dmx="128~128" />
      <Function ID="7" Name="Large Jet Flame" Display="'Large Jet Flame'" Dmx="153~153" />
      <Function ID="8" Name="Long, Large Jet Flame" Display="'Long, Large Jet Flame'" Dmx="178~178" />
      <Function ID="9" Name="Pilot Flame (max 10s)" Display="'Pilot Flame (max 10s)'" Dmx="204~204" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Arming" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Arming" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Flame Time (FZK)" Channels="1">

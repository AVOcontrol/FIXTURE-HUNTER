      <Function ID="3" Name="Jump" Display="'Jump'" Dmx="51~100" />
      <Function ID="4" Name="Gradient" Display="'Gradient'" Dmx="101~150" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="151~200" />
      <Function ID="6" Name="Sound Jump" Display="'Sound Jump'" Dmx="201~220" />
      <Function ID="7" Name="Sound Gradient" Display="'Sound Gradient'" Dmx="221~240" />
      <Function ID="8" Name="Sound Pulse" Display="'Sound Pulse'" Dmx="241~255" />

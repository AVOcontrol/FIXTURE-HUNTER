      <Attribute ID="Green" ChannelOffset="11" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="12" Wheel="12" />
      <Attribute ID="White" ChannelOffset="13" Wheel="7" />
      <Attribute ID="Auto" ChannelOffset="14" Wheel="52" />
      <Attribute ID="Col_Preset" ChannelOffset="15" Wheel="8" />
      <Attribute ID="Col_Preset_Dim" ChannelOffset="16" Wheel="5" />
      <Attribute ID="Chase" ChannelOffset="17" Wheel="22" />
      <Attribute ID="Chase_Spd" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Chase_Fade" ChannelOffset="19" Wheel="24" />
      <Attribute ID="Control" ChannelOffset="20" Wheel="28" />

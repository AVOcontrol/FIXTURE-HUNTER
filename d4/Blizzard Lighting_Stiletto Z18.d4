<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stiletto Z18" ShortName="Stil Z18" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="25-05-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="226~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1" Display="'Mode 1'" Dmx="0~0" />
      <Function ID="2" Name="Mode 2" Display="'Mode 2'" Dmx="50~99" />
      <Function ID="3" Name="Mode 3" Display="'Mode 3'" Dmx="100~149" />
      <Function ID="4" Name="Mode 4" Display="'Mode 4'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~29" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~54" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="55~79" />
      <Function ID="5" Name="White" Display="'White'" Dmx="80~104" />
      <Function ID="6" Name="Mixed 1" Display="'Mixed 1'" Dmx="105~129" />
      <Function ID="7" Name="Mixed 2" Display="'Mixed 2'" Dmx="130~154" />
      <Function ID="8" Name="Mixed 3" Display="'Mixed 3'" Dmx="155~174" />
      <Function ID="9" Name="Mixed 4" Display="'Mixed 4'" Dmx="175~179" />
      <Function ID="10" Name="Mixed 5" Display="'Mixed 5'" Dmx="180~184" />
      <Function ID="11" Name="Mixed 6" Display="'Mixed 6'" Dmx="185~189" />
      <Function ID="12" Name="Mixed 7" Display="'Mixed 7'" Dmx="190~210" />
      <Function ID="13" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Col_Preset" Name="Col Preset" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />

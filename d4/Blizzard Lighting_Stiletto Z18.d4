      <Function ID="23" Name="Mixed 12" Display="'Mixed 12'" Dmx="110~114" Colour="255,255,255" />
      <Function ID="24" Name="Pattern 1" Display="'Pattern 1'" Dmx="115~119" Colour="255,255,255" />
      <Function ID="25" Name="Pattern 2" Display="'Pattern 2'" Dmx="120~124" Colour="255,255,255" />
      <Function ID="26" Name="Pattern 3" Display="'Pattern 3'" Dmx="125~129" Colour="255,255,255" />
      <Function ID="27" Name="Pattern 4" Display="'Pattern 4'" Dmx="130~134" Colour="255,255,255" />
      <Function ID="28" Name="Pattern 5" Display="'Pattern 5'" Dmx="135~139" Colour="255,255,255" />
      <Function ID="29" Name="Pattern 6" Display="'Pattern 6'" Dmx="140~144" Colour="255,255,255" />
      <Function ID="30" Name="Pattern 7" Display="'Pattern 7'" Dmx="145~149" Colour="255,255,255" />
      <Function ID="31" Name="Pattern 8" Display="'Pattern 8'" Dmx="150~154" Colour="255,255,255" />
      <Function ID="32" Name="Pattern 9" Display="'Pattern 9'" Dmx="155~159" Colour="255,255,255" />
      <Function ID="33" Name="Pattern 10" Display="'Pattern 10'" Dmx="160~164" Colour="255,255,255" />
      <Function ID="34" Name="Pattern 11" Display="'Pattern 11'" Dmx="165~169" Colour="255,255,255" />

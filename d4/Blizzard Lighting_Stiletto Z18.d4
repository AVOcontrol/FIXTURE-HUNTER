    <Attribute ID="Col_Preset_Dim" Name="Col Preset Dim" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="15~30" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="31~46" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="47~62" />
      <Function ID="5" Name="Chase 4" Display="'Chase 4'" Dmx="63~78" />
      <Function ID="6" Name="Chase 5" Display="'Chase 5'" Dmx="79~94" />
      <Function ID="7" Name="Chase 6" Display="'Chase 6'" Dmx="95~110" />
      <Function ID="8" Name="Chase 7" Display="'Chase 7'" Dmx="111~126" />
      <Function ID="9" Name="Chase 8" Display="'Chase 8'" Dmx="127~142" />
      <Function ID="10" Name="Chase 9" Display="'Chase 9'" Dmx="143~158" />
      <Function ID="11" Name="Chase 10" Display="'Chase 10'" Dmx="159~174" />
      <Function ID="12" Name="Chase 11" Display="'Chase 11'" Dmx="175~190" />
      <Function ID="13" Name="Chase 12" Display="'Chase 12'" Dmx="191~206" />
      <Function ID="14" Name="Chase 13" Display="'Chase 13'" Dmx="207~222" />
      <Function ID="15" Name="Chase 14" Display="'Chase 14'" Dmx="223~238" />
      <Function ID="16" Name="Chase 15" Display="'Chase 15'" Dmx="239~255" />

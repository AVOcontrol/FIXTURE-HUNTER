<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="YK200 Dual Arm Yoke" ShortName="YK200 Yke" Company="Christie Digital">
  <Copyright Notice="© Avolites Ltd. 2012" />
  <History Date="19-09-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Motor_Mode" Name="Motor Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 0" Display="'Mode 0'" Dmx="0~32" />
      <Function ID="2" Name="Mode 1" Display="'Mode 1'" Dmx="33~64" />
      <Function ID="3" Name="Mode 2" Display="'Mode 2'" Dmx="65~96" />
      <Function ID="4" Name="Mode 3" Display="'Mode 3'" Dmx="97~128" />
      <Function ID="5" Name="Mode 4" Display="'Mode 4'" Dmx="129~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Beam" Display="'Reset Beam'" Dmx="15~15" />
      <Function ID="3" Name="Reset Yoke" Display="'Reset Yoke'" Dmx="20~20" />
      <Function ID="4" Name="Reset Head" Display="'Reset Head'" Dmx="25~25" />
      <Function ID="5" Name="Reset All" Display="'Reset All'" Dmx="30~30" />
      <Function ID="6" Name="Laser On" Display="'Laser On'" Dmx="35~35" />
      <Function ID="7" Name="Laser Off" Display="'Laser Off'" Dmx="40~40" />
      <Function ID="8" Name="Load" Display="'Load'" Dmx="86~86" />
      <Function ID="9" Name="Execute" Display="'Execute'" Dmx="171~171" />
    </Attribute>
    <Attribute ID="Video_Func" Name="Video Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Video Rst" Display="'Video Rst'" Dmx="20~20" />
      <Function ID="3" Name="Power On" Display="'Power On'" Dmx="25~25" />
      <Function ID="4" Name="Power Off" Display="'Power Off'" Dmx="30~30" />
      <Function ID="5" Name="Live Video" Display="'Live Video'" Dmx="35~35" />
      <Function ID="6" Name="Mire Check" Display="'Mire Check'" Dmx="36~36" />
      <Function ID="7" Name="Mire Grey Scale 16" Display="'Mire Grey Scale 16'" Dmx="37~37" />
      <Function ID="8" Name="Mire Grey Scale 256" Display="'Mire Grey Scale 256'" Dmx="38~38" />
      <Function ID="9" Name="Mire White" Display="'Mire White'" Dmx="39~39" />
      <Function ID="10" Name="Mire 50 Grey" Display="'Mire 50 Grey'" Dmx="40~40" />
      <Function ID="11" Name="Mire Black" Display="'Mire Black'" Dmx="41~41" />
      <Function ID="12" Name="Mire Convergence" Display="'Mire Convergence'" Dmx="42~42" />
      <Function ID="13" Name="Mire 13 Point" Display="'Mire 13 Point'" Dmx="43~43" />
      <Function ID="14" Name="Mire Color Bars" Display="'Mire Color Bars'" Dmx="44~44" />
      <Function ID="15" Name="Load" Display="'Load'" Dmx="86~86" />
      <Function ID="16" Name="Execute" Display="'Execute'" Dmx="171~171" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="UK_ChDYK200" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Zoom" ChannelOffset="8" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Motor_Mode" ChannelOffset="5" Wheel="29" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
      <Attribute ID="Video_Func" ChannelOffset="7" Wheel="30" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Beam">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:8" Delay="1000" />
      <Set Channel="Control:9" Delay="1000" />
    </Macro>
    <Macro Name="Reset Yoke">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:8" Delay="1000" />
      <Set Channel="Control:9" Delay="1000" />
    </Macro>
    <Macro Name="Reset Head">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:8" Delay="1000" />
      <Set Channel="Control:9" Delay="1000" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:8" Delay="1000" />
      <Set Channel="Control:9" Delay="1000" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
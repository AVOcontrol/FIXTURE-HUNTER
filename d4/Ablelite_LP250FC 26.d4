    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="4~5" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="6~7" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="8~9" Colour="0,0,255" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="10~11" Colour="0,200,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="12~13" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="14~15" Colour="255,0,255" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="16~17" Colour="255,255,0" />
      <Function ID="9" Name="Orange" Display="'Orange'" Dmx="18~19" Colour="255,128,0" />
      <Function ID="10" Name="Light Yellow" Display="'Light Yellow'" Dmx="20~21" Colour="255,255,128" />
      <Function ID="11" Name="Light Blue" Display="'Light Blue'" Dmx="22~23" Colour="0,128,255" />
      <Function ID="12" Name="Light Pink" Display="'Light Pink'" Dmx="24~25" Colour="255,200,200" />
      <Function ID="13" Name="2000-2700K" Display="'2000-2700K %.fK',2000~2700" Dmx="26~63" Colour="255,255,255" />
      <Function ID="14" Name="2700-3200K" Display="'2700-3200K %.fK',2700~3200" Dmx="64~101" Colour="255,255,255" />
      <Function ID="15" Name="3200-4200K" Display="'3200-4200K %.fK',3200~4200" Dmx="102~139" Colour="255,255,255" />
      <Function ID="16" Name="4200-5600K" Display="'4200-5600K %.fK',4200~5600" Dmx="140~177" Colour="255,255,255" />
      <Function ID="17" Name="5600-8000K" Display="'5600-8000K %.fK',5600~8000" Dmx="178~215" Colour="255,255,255" />
      <Function ID="18" Name="8000-10000K" Display="'8000-10000K %.fK',8000~10000" Dmx="216~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dim_Fade" Name="Dim Fade" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

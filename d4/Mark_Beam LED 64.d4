  <History Date="09-01-19" Author="Nic Morris" Comment="Created (hopeless documentation)" Version="1" />
  <History Date="16-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="10-04-19" Author="Nic Morris" Comment="Created from Shehds Mini LED 60W (poor documentation with the same confusing charts)" Version="3" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Added Atlabase ID's (Capture have implemented 30 channel as 32.  Without proper documentation it is impossible to know how this works)" Version="4" />
  <History Date="10-02-26" Author="Nic Morris" Comment="Created from Hybrid HMH 12" Version="5" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="e9bc3439-8951-43ca-831d-f4a6397ef4a5" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="3" Name="Macro" Display="'Macro'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Ring_FX" Name="Ring FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour Mode" Display="''" Dmx="0~0" Update="Ring_FX_Spd" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="128~135" Update="Ring_FX_Spd" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="136~143" Update="Ring_FX_Spd" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="144~151" Update="Ring_FX_Spd" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="152~159" Update="Ring_FX_Spd" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="160~167" Update="Ring_FX_Spd" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="168~175" Update="Ring_FX_Spd" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="176~183" Update="Ring_FX_Spd" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="184~191" Update="Ring_FX_Spd" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="192~199" Update="Ring_FX_Spd" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="200~207" Update="Ring_FX_Spd" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="208~215" Update="Ring_FX_Spd" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="216~223" Update="Ring_FX_Spd" />
      <Function ID="14" Name="Macro 13" Display="'Macro 13'" Dmx="224~231" Update="Ring_FX_Spd" />
      <Function ID="15" Name="Macro 14" Display="'Macro 14'" Dmx="232~239" Update="Ring_FX_Spd" />
      <Function ID="16" Name="Macro 15" Display="'Macro 15'" Dmx="240~247" Update="Ring_FX_Spd" />
      <Function ID="17" Name="Macro 16" Display="'Macro 16'" Dmx="248~255" Update="Ring_FX_Spd" />
    </Attribute>
    <Attribute ID="Ring_FX_Spd" Name="Ring FX Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3,4,5,6,7" />
      <Condition Name="Speed" ID="8" If="'Ring_FX'&gt;1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="42~83" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="84~125" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="126~167" />
      <Function ID="5" Name="Magenta" Display="'Magenta'" Dmx="168~209" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="210~251" />
      <Function ID="7" Name="White" Display="'White'" Dmx="252~255" />
      <Function ID="8" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

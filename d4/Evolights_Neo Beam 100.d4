      <Function ID="28" Name="CTO 2/ Op" Display="'CTO 2/ Op'" Dmx="124~127" WheelPosition="13" Colour="255,240,200" />
      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~194" Colour="0,0,0" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="189~128" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">

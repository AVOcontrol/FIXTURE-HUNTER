      <Function ID="12" Name="CTO" Display="'CTO'" Dmx="104~107" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="112~115" WheelPosition="12" Colour="128,255,0" />
      <Function ID="14" Name="CTO 2" Display="'CTO 2'" Dmx="120~123" WheelPosition="13" Colour="255,240,200" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="7~11" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="17~21" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel/ Ppl" Display="'Yel/ Ppl'" Dmx="27~31" WheelPosition="2" Colour="255,255,0" />

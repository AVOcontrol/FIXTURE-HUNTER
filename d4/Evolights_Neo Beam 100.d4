      <Function ID="21" Name="Grn/ Amb" Display="'Grn/ Amb'" Dmx="67~71" WheelPosition="6" Colour="0,255,0" />
      <Function ID="22" Name="Amb/ Cy" Display="'Amb/ Cy'" Dmx="76~79" WheelPosition="7" Colour="255,100,0" />
      <Function ID="23" Name="Cy/ UV" Display="'Cy/ UV'" Dmx="84~87" WheelPosition="8" Colour="0,255,255" />
      <Function ID="24" Name="UV/ CTB" Display="'UV/ CTB'" Dmx="92~95" WheelPosition="9" Colour="180,0,255" />
      <Function ID="25" Name="CTB/ CTO" Display="'CTB/ CTO'" Dmx="100~103" WheelPosition="10" Colour="230,230,255" />
      <Function ID="26" Name="CTO/ L Grn" Display="'CTO/ L Grn'" Dmx="108~111" WheelPosition="11" Colour="255,240,200" />

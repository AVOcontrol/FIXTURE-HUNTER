      <Function ID="9" Name="Colour 7" Display="'Colour 7'" Dmx="105~119" WheelPosition="7" />
      <Function ID="10" Name="Colour 8" Display="'Colour 8'" Dmx="120~134" WheelPosition="8" />
      <Function ID="11" Name="Colour 9" Display="'Colour 9'" Dmx="135~149" WheelPosition="9" />
      <Function ID="12" Name="Colour 10" Display="'Colour 10'" Dmx="150~164" WheelPosition="10" />
      <Function ID="13" Name="Colour 11" Display="'Colour 11'" Dmx="165~179" WheelPosition="11" />
      <Function ID="14" Name="Colour 12" Display="'Colour 12'" Dmx="180~194" WheelPosition="12" />
      <Function ID="15" Name="Colour 13" Display="'Colour 13'" Dmx="195~209" WheelPosition="13" />
      <Function ID="16" Name="Colour 14" Display="'Colour 14'" Dmx="210~224" WheelPosition="14" />
      <Function ID="17" Name="Full On" Display="'Full On'" Dmx="225~255" WheelPosition="15" />
      <Function ID="18" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

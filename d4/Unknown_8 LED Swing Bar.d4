  <Mode Name="17 DMX" Channels="17">
    <Import PearlRef="UK_SWING" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Spin" ChannelOffset="7" Wheel="19" />
      <Attribute ID="Spin_Speed" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Lamp_1" ChannelOffset="9" Wheel="23" />
      <Attribute ID="Lamp_2" ChannelOffset="10" Wheel="24" />
      <Attribute ID="Lamp_3" ChannelOffset="11" Wheel="52" />

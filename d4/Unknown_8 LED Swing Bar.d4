      <Function ID="1" Name="All On" Display="'All On'" Dmx="0~50" />
      <Function ID="2" Name="Flow Left" Display="'Flow Left %.f%%',0~100" Dmx="51~100" />
      <Function ID="3" Name="Flow Right" Display="'Flow Right %.f%%',0~100" Dmx="101~155" />

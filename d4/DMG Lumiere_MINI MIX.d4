  <History Date="29-10-18" Author="Nic Morris" Comment="Created (note CTC and Green/ Magenta functions not defined and there are two CRMX unlink control functions)" Version="1" />
  <History Date="29-10-18" Author="Nic Morris" Comment="FX DMX ranges are not properly defined in the charts and look wrong.  Used best guess for safest values." Version="2" />
  <History Date="07-01-20" Author="Nic Morris" Comment="Created from DMG Lumiere Mix Controller (possibly the most confusing charts ever written)" Version="3" />
  <History Date="19-02-22" Author="Nic Morris" Comment="Created from DMG Lumiere MAXI MIX (still probably the most confusing charts ever written.  some contradictory information.)" Version="4" />
  <History Date="20-02-22" Author="Nic Morris" Comment="Corrected global White mode parameter 2 condition (G/M)." Version="18" />
  <History Date="25-02-22" Author="Nic Morris" Comment="Added Atlabase ID's (note personality currently includes MAXI modes which are not available for the Dash.  Atlabase IDs are for Dash modes only)." Version="19" />
  <History Date="01-04-22" Author="Nic Morris" Comment="(Re)created from DMG Lumiere Dash" Version="20" />
  <History Date="01-04-22" Author="Nic Morris" Comment="Created from DMG Lumiere MAXI MIX" Version="21" />
  <History Date="07-04-22" Author="Nic Morris" Comment="Revised Atlabase ID's to latest and added missing." Version="23" />

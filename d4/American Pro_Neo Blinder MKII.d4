      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~40" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="41~80" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="81~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="121~160" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="161~200" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="201~240" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5e86fa3f-34d5-4099-84ee-aaee4afb9c03" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~125" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="126~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="11~32" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="33~76" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="77~120" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="121~164" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="165~208" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="209~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Red Shift Off" Display="'Red Shift Off'" Dmx="29~29" />
      <Function ID="3" Name="Red Shift On" Display="'Red Shift On'" Dmx="31~31" />
      <Function ID="4" Name="Dim Linear" Display="'Dim Linear'" Dmx="76~76" />
      <Function ID="5" Name="Dim Square" Display="'Dim Square'" Dmx="77~77" />
      <Function ID="6" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="78~78" />
      <Function ID="7" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="79~79" />
      <Function ID="8" Name="Dim Mode Off" Display="'Dim Mode Off'" Dmx="86~86" />
      <Function ID="9" Name="Dim Mode 1 (Fast)" Display="'Dim Mode 1 (Fast)'" Dmx="87~87" />
      <Function ID="10" Name="Dim Mode 2" Display="'Dim Mode 2'" Dmx="88~88" />
      <Function ID="11" Name="Dim Mode 3 (Slow)" Display="'Dim Mode 3 (Slow)'" Dmx="89~89" />
      <Function ID="12" Name="Dim Mode Overide" Display="'Dim Mode Overide'" Dmx="90~90" />
      <Function ID="13" Name="Dim Strike Mode" Display="'Dim Strike Mode'" Dmx="91~91" />
      <Function ID="14" Name="Dim Traditional Mode" Display="'Dim Traditional Mode'" Dmx="92~92" />
      <Function ID="15" Name="Display Normal" Display="'Display Normal'" Dmx="130~130" />
      <Function ID="16" Name="Display Invert" Display="'Display Invert'" Dmx="131~131" />
      <Function ID="17" Name="PWM Freq 1000Hz" Display="'PWM Freq 1000Hz'" Dmx="170~170" />
      <Function ID="18" Name="PWM Freq 2000Hz" Display="'PWM Freq 2000Hz'" Dmx="174~174" />
      <Function ID="19" Name="PWM Freq 4000Hz" Display="'PWM Freq 4000Hz'" Dmx="176~176" />
      <Function ID="20" Name="PWM Freq 6000Hz" Display="'PWM Freq 6000Hz'" Dmx="178~178" />
      <Function ID="21" Name="PWM Freq 25000Hz" Display="'PWM Freq 25000Hz'" Dmx="184~184" />
      <Function ID="22" Name="Reset Dimmer" Display="'Reset Dimmer'" Dmx="193~193" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

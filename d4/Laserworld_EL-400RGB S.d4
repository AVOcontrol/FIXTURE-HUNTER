  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default Auto Spd" Display="'Default Auto Spd'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.f%%',0~100" Dmx="27~127" />
      <Function ID="3" Name="Sound Sensitivity" Display="'Sound Sensitivity %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Group" Name="Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Geometric Patterns (1)" Display="'Geometric Patterns (1)'" Dmx="0~0" Update="Pattern/Effect" />
      <Function ID="2" Name="Geometric Patterns (2)" Display="'Geometric Patterns (2)'" Dmx="16~31" Update="Pattern/Effect" />
      <Function ID="3" Name="Geometric Patterns (3)" Display="'Geometric Patterns (3)'" Dmx="32~47" Update="Pattern/Effect" />
      <Function ID="4" Name="Geometric Patterns (Dot Type Pattern)" Display="'Geometric Patterns (Dot Type Pattern)'" Dmx="48~63" Update="Pattern/Effect" />
      <Function ID="5" Name="Location for the Downloaded ILD Programs" Display="'Location for the Downloaded ILD Programs'" Dmx="64~127" Update="Pattern/Effect" />
      <Function ID="6" Name="Animated Programs" Display="'Animated Programs'" Dmx="128~143" Update="Pattern/Effect" />
      <Function ID="7" Name="Dynamic Effects of Program" Display="'Dynamic Effects of Program'" Dmx="144~255" Update="Pattern/Effect" />
    </Attribute>
    <Attribute ID="Pattern/Effect" Name="Pattern/Effect" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Effect" ID="2,3" If="'Group'&gt;5" />
      <Function ID="1" Name="Pattern" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="3" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="2~255" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Built-In Colour 1 (Static Patterns are White)" Display="'Built-In Colour 1 (Static Patterns are White)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Built-In Colour 2" Display="'Built-In Colour 2'" Dmx="1~3" Colour="0,0,0" />
      <Function ID="3" Name="White" Display="'White'" Dmx="4~7" Colour="0,0,0" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="8~11" Colour="0,0,0" />

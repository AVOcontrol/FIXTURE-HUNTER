  <AtlaBase TypeID="3693f328-b068-4bb1-9826-3c8444c8e0ee" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="0~225" Update="Auto_Spd" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="226~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Else ID="1" />
      <Condition Name="Sound" ID="2" If="'Auto'==2" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~127" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="128~245" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Virtual_Colour" Name="Virtual Colour" Description="" Group="C">
      <Locate Locate="1:2000" PowerOn="1:2000" />
      <Function ID="1" Name="Colour Temp" Display="'Colour Temp %.fK',2000~2700" Dmx="0~19" Colour="0,0,0" />
      <Function ID="2" Name="White 3200K" Display="'White 3200K'" Dmx="20~39" Colour="0,0,0" />
      <Function ID="3" Name="White 4200K" Display="'White 4200K'" Dmx="40~59" Colour="0,0,0" />
      <Function ID="4" Name="White 5600K" Display="'White 5600K'" Dmx="60~79" Colour="0,0,0" />
      <Function ID="5" Name="White 8000K" Display="'White 8000K'" Dmx="80~99" Colour="0,0,0" />
      <Function ID="6" Name="Rainbow" Display="'Rainbow %.1f%%',0.0~100.0" Dmx="100~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="8~15" />
      <Function ID="3" Name="Move in Dark On" Display="'Move in Dark On'" Dmx="16~23" />
      <Function ID="4" Name="Move in Dark Off" Display="'Move in Dark Off'" Dmx="24~31" />
      <Function ID="5" Name="Sound P/T On" Display="'Sound P/T On'" Dmx="32~39" />
      <Function ID="6" Name="Sound P/T Off" Display="'Sound P/T Off'" Dmx="40~47" />
      <Function ID="7" Name="Sound Col On" Display="'Sound Col On'" Dmx="48~55" />
      <Function ID="8" Name="Sound Col Off" Display="'Sound Col Off'" Dmx="56~63" />
      <Function ID="9" Name="Display Off" Display="'Display Off'" Dmx="64~71" />
      <Function ID="10" Name="Display On" Display="'Display On'" Dmx="72~79" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~87" />
      <Function ID="12" Name="Fan Full" Display="'Fan Full'" Dmx="88~95" />
      <Function ID="13" Name="Dim Mode Off" Display="'Dim Mode Off'" Dmx="96~103" />
      <Function ID="14" Name="Dim Mode Slow" Display="'Dim Mode Slow'" Dmx="104~111" />
      <Function ID="15" Name="Dim Mode Med" Display="'Dim Mode Med'" Dmx="112~119" />
      <Function ID="16" Name="Dim Mode Fast" Display="'Dim Mode Fast'" Dmx="120~127" />
    </Attribute>
  </Control>

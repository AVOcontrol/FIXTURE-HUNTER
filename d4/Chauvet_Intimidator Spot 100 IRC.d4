      <Function ID="8" Name="All in Dark OFF" Display="'All in Dark OFF'" Dmx="128~147" />
      <Function ID="9" Name="Reset Pan" Display="'Reset Pan'" Dmx="148~167" />
      <Function ID="10" Name="Reset Tilt" Display="'Reset Tilt'" Dmx="168~187" />
      <Function ID="11" Name="Reset Colour" Display="'Reset Colour'" Dmx="188~207" />
      <Function ID="12" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="208~227" />

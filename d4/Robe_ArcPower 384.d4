    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO" Display="'CTO %.f%%',0~100" Dmx="1~15" Colour="255,240,200" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="16~16" Colour="0,0,255" />
      <Function ID="4" Name="Blu - Cy" Display="'Blu - Cy %.f%%',0~100" Dmx="17~55" Colour="0,255,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="56~56" Colour="0,255,255" />
      <Function ID="6" Name="Cy - Grn" Display="'Cy - Grn %.f%%',0~100" Dmx="57~95" Colour="0,255,0" />
      <Function ID="7" Name="Green" Display="'Green'" Dmx="96~96" Colour="0,255,0" />
      <Function ID="8" Name="Grn - Yel" Display="'Grn - Yel %.f%%',0~100" Dmx="97~134" Colour="255,255,0" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="135~135" Colour="255,255,0" />
      <Function ID="10" Name="Yel - Rd" Display="'Yel - Rd %.f%%',0~100" Dmx="136~174" Colour="255,0,0" />
      <Function ID="11" Name="Red" Display="'Red'" Dmx="175~175" Colour="255,0,0" />
      <Function ID="12" Name="Rd - Mag" Display="'Rd - Mag %.f%%',0~100" Dmx="176~214" Colour="255,0,255" />
      <Function ID="13" Name="Magenta" Display="'Magenta'" Dmx="215~215" Colour="255,0,255" />
      <Function ID="14" Name="Mag - Blu" Display="'Mag - Blu %.f%%',0~100" Dmx="216~254" Colour="0,0,255" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="255~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',100~0" Dmx="144~159" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Shadow 2 ILS" ShortName="Shadow2ILS" Company="Chauvet" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>3627ac17-ce9b-4f27-a4bf-e6551cd17143</Thumbnail>
  <History Date="18-02-23" Author="Nic Morris" Comment="Created (note according to the charts, the only time shutter is not strobe is when program is set to strobe. this seems wrong)" Version="0" />
  <History Date="21-02-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="fd1657c8-9b1b-4e99-8d74-fc8fae22ae43" />
  <Control>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="3-Zone Chase 1" Display="'3-Zone Chase 1'" Dmx="5~39" Update="Shutter" />
      <Function ID="3" Name="3-Zone Chase 2" Display="'3-Zone Chase 2'" Dmx="40~79" Update="Shutter" />
      <Function ID="4" Name="3-Zone Fade" Display="'3-Zone Fade'" Dmx="80~119" Update="Shutter" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse'" Dmx="120~159" Update="Shutter" />
      <Function ID="6" Name="Pulse" Display="'Pulse'" Dmx="160~199" Update="Shutter" />
      <Function ID="7" Name="Strobe" Display="'Strobe'" Dmx="200~239" Update="Shutter" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Else ID="1,2,3" />
      <Condition Name="Lightning" ID="4,5,6" If="'Program'==7" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="5" Name="Lightning" Display="'Lightning %.1f%%',0.0~100.0" Dmx="1~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8b5e7caf-da09-46ff-91c8-3c91d8ff7cd8" />
    <Include>
      <Attribute ID="Program" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Program_Spd" ChannelOffset="2" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="3627ac17-ce9b-4f27-a4bf-e6551cd17143"></Swatch>
  </swatchLibrary>
</Fixture>
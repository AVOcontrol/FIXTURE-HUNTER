      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Effect_Rot" />
      <Function ID="2" Name="Effect Index" Display="'Effect Index'" Dmx="30~30" Update="Effect_Rot" />
      <Function ID="3" Name="Effect Spin" Display="'Effect Spin'" Dmx="40~59" Update="Effect_Rot" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Rot" />
    </Attribute>
    <Attribute ID="Effect_Rot" Name="Effect Rot" Description="" Group="E">
      <Locate Locate="7:0" PowerOn="7:0" />
      <Condition Name="Index" ID="1" If="'Effect'==2" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Effect'==3" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'%.f°',0~395" Dmx="0~255" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="127~129" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="130~253" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="254~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="200~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="229~216" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse    %.f%%',0~100" Dmx="243~230" Iris="0~0" Zoom="0~0" />

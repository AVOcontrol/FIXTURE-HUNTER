    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Condition Name="Rnd CMY Fast" ID="2,3,4,5" If="'C/CMY/Gobo'==3||'C/CMY/Gobo'==4||'C/CMY/Gobo'==5" />
      <Else ID="1" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
      <Function ID="2" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="3" Name="Min" Display="'Min %.1f%%',0.0~100.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="4" Name="Max" Display="'Max %.1f%%',0.0~100.0" Dmx="128~254" Colour="0,0,0" />
      <Function ID="5" Name="Normal (Full Range)" Display="'Normal (Full Range)'" Dmx="255~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">

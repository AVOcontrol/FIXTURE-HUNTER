      <Function ID="10" Name="Blu - Grn" Display="'Blu - Grn %.f%%',0~100" Dmx="20~40" WheelPosition="1" Colour="0,0,255" />
      <Function ID="11" Name="Grn - Org" Display="'Grn - Org %.f%%',0~100" Dmx="40~60" WheelPosition="2" Colour="0,255,0" />
      <Function ID="12" Name="Org - MG" Display="'Org - MG %.f%%',0~100" Dmx="60~80" WheelPosition="3" Colour="255,128,0" />
      <Function ID="13" Name="MG - Yel" Display="'MG - Yel %.f%%',0~100" Dmx="80~100" WheelPosition="4" Colour="255,195,210" />
      <Function ID="14" Name="Yel - Cgo" Display="'Yel - Cgo %.f%%',0~100" Dmx="100~120" WheelPosition="5" Colour="255,255,0" />
      <Function ID="15" Name="Cgo - Rd" Display="'Cgo - Rd %.f%%',0~100" Dmx="120~140" WheelPosition="6" Colour="0,0,180" />
      <Function ID="16" Name="Rd - Op" Display="'Rd - Op %.f%%',0~100" Dmx="140~160" WheelPosition="7" Colour="255,0,0" />

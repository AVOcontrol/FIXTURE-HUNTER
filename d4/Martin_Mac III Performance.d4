      <Function ID="20" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="222~243" Colour="0,0,0" />
      <Function ID="21" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="22" Name="Slow" Display="'Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="23" Name="Medium" Display="'Medium'" Dmx="248~251" Colour="0,0,0" />
      <Function ID="24" Name="Fast" Display="'Fast'" Dmx="244~247" Colour="0,0,0" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" GoboSpin="0~0" GoboOrientation="0~0" />

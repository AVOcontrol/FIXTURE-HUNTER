      <Function ID="18" Name="Fan Silent" Display="'Fan Silent'" Dmx="168~175" />
      <Function ID="19" Name="Fan Auto" Display="'Fan Auto'" Dmx="176~183" />
      <Function ID="20" Name="Fan Full" Display="'Fan Full'" Dmx="184~191" />
      <Function ID="21" Name="Display Auto Off" Display="'Display Auto Off'" Dmx="192~199" />
      <Function ID="22" Name="Display On" Display="'Display On'" Dmx="200~207" />
      <Function ID="23" Name="Reset" Display="'Reset'" Dmx="250~250" />

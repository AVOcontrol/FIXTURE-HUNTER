  <History Date="05-01-17" Author="Nic Morris" Comment="Revised P/T Speed locate in line with documentation (0-255 = 'speed increasing') and Capture." Version="3" />
  <History Date="12-07-17" Author="Nic Morris" Comment="Created from Involight LED MH127S" Version="4" />
  <History Date="14-07-17" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="14-07-17" Author="Nic Morris" Comment="Revised gobo scroll wheel directions (note p/t speed, gobo rot and prism rot ranges are not documented fully)." Version="6" />
  <History Date="09-04-20" Author="Nic Morris" Comment="Created from ElectroConcept CLUBSCAN 120" Version="7" />
  <History Date="10-04-20" Author="Nic Morris" Comment="Inverted P/T Speed in attempt to solve customer request (documentation does not provide sufficient details)" Version="8" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="986d24dd-7c4a-4a23-bd8c-cf7f0f10b796" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~251" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="8" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20" If="'Colour1Func'==3" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~14" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="20~24" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~34" WheelPosition="3" Colour="0,255,0" />
      <Function ID="5" Name="Light Blue" Display="'Light Blue'" Dmx="40~44" WheelPosition="4" Colour="0,128,255" />
      <Function ID="6" Name="Violet" Display="'Violet'" Dmx="50~54" WheelPosition="5" Colour="180,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="60~64" WheelPosition="6" Colour="255,255,0" />
      <Function ID="8" Name="Blue" Display="'Blue'" Dmx="70~74" WheelPosition="7" Colour="0,0,255" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="80~84" WheelPosition="8" Colour="255,0,255" />
      <Function ID="10" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="12" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="25~29" WheelPosition="2" Colour="255,128,0" />
      <Function ID="13" Name="Grn/ L Blu" Display="'Grn/ L Blu'" Dmx="35~39" WheelPosition="3" Colour="0,255,0" />
      <Function ID="14" Name="L Blu/ UV" Display="'L Blu/ UV'" Dmx="45~49" WheelPosition="4" Colour="0,128,255" />
      <Function ID="15" Name="UV/ Yel" Display="'UV/ Yel'" Dmx="55~59" WheelPosition="5" Colour="180,0,255" />
      <Function ID="16" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="65~69" WheelPosition="6" Colour="255,255,0" />
      <Function ID="17" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="75~79" WheelPosition="7" Colour="0,0,255" />
      <Function ID="18" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="85~89" WheelPosition="8" Colour="255,0,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="20" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="90~255" Colour="0,0,0" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="17,18,19,20" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="21" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="5~9" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="10~14" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="15~19" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="20~24" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="25~29" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="30~34" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="35~39" WheelPosition="7" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="221~225" WheelPosition="1" />
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="226~230" WheelPosition="2" />
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="231~235" WheelPosition="3" />
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="236~240" WheelPosition="4" />
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="241~245" WheelPosition="5" />
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="246~250" WheelPosition="6" />
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="251~255" WheelPosition="7" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="18" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="220~135" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="130~134" />
      <Function ID="20" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="40~129" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="7" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="64~127" />
      <Function ID="6" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="192~255" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="64~127" />
      <Function ID="4" Name="Shake" Display="'Shake %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fade" Display="'Fade'" Dmx="0~0" />
      <Function ID="2" Name="Snap" Display="'Snap'" Dmx="6~10" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="51~100" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="101~150" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="151~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />

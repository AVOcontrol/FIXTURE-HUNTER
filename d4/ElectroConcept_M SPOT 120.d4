      <Function ID="14" Name="Yel /Blu" Display="'Yel /Blu'" Dmx="65~69" Colour="255,255,0" />
      <Function ID="15" Name="Blue" Display="'Blue'" Dmx="70~74" Colour="0,0,255" />
      <Function ID="16" Name="Blu/ Mag" Display="'Blu/ Mag'" Dmx="75~79" Colour="0,0,255" />
      <Function ID="17" Name="Magenta" Display="'Magenta'" Dmx="80~84" Colour="255,0,255" />
      <Function ID="18" Name="Mag/ Op" Display="'Mag/ Op'" Dmx="85~89" Colour="255,0,255" />

    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="10~14" Colour="255,0,0" />
      <Function ID="4" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="15~19" Colour="255,0,0" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="20~24" Colour="255,128,0" />

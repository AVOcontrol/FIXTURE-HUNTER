      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~123" />
      <Function ID="3" Name="Rnd Sync" Display="'Rnd Sync %.f%%',0~100" Dmx="128~185" />
      <Function ID="4" Name="Rnd Async" Display="'Rnd Async %.f%%',0~100" Dmx="191~249" />
    </Attribute>
  </Control>

      <Function ID="2" Name="Custom Col 1 (CT01)" Display="'Custom Col 1 (CT01)'" Dmx="6~10" />
      <Function ID="3" Name="Custom Col 2 (CT02)" Display="'Custom Col 2 (CT02)'" Dmx="11~15" />
      <Function ID="4" Name="Custom Col 3 (CT03)" Display="'Custom Col 3 (CT03)'" Dmx="16~20" />

      <Function ID="6" Name="Grn" Display="'Grn'" Dmx="91~91" Colour="0,255,0" />
      <Function ID="7" Name="Grn-Yel" Display="'Grn-Yel %.f%%',0~100" Dmx="91~131" Colour="0,255,0" />
      <Function ID="8" Name="Yellow" Display="'Yellow'" Dmx="131~131" Colour="255,255,0" />
      <Function ID="9" Name="Yel-Rd" Display="'Yel-Rd %.f%%',0~100" Dmx="131~171" Colour="255,255,0" />
      <Function ID="10" Name="Red" Display="'Red'" Dmx="171~171" Colour="255,0,0" />
      <Function ID="11" Name="Rd-Mag" Display="'Rd-Mag %.f%%',0~100" Dmx="171~211" Colour="255,0,0" />
      <Function ID="12" Name="Magenta" Display="'Magenta'" Dmx="211~211" Colour="255,0,255" />
      <Function ID="13" Name="Mag-Blu" Display="'Mag-Blu %.f%%',0~100" Dmx="211~251" Colour="255,0,255" />
      <Function ID="14" Name="Blue" Display="'Blue'" Dmx="251~255" Colour="0,0,255" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~251" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />

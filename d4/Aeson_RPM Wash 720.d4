<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="RPM Wash 720" ShortName="RPM Wsh720" Company="Aeson">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="31-07-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-02-15" Author="Nic Morris" Comment="Changed manufacturer from 'Aeson Lighting' to 'Aeson'" />
  <History Date="05-02-15" Author="Nic Morris" Comment="Inverted P/T Speed wheel direction.  Increased wheel resolution." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Custom" Name="Custom" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="0~0" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="0~0" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="0~0" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="0~0" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="0~0" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="0~0" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="0~0" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green" Display="'Red/Green'" Dmx="1~20" Colour="255,0,0" />
      <Function ID="3" Name="Green/Red" Display="'Green/Red'" Dmx="21~40" Colour="255,255,0" />
      <Function ID="4" Name="Green/Blue" Display="'Green/Blue'" Dmx="41~60" Colour="0,255,0" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green'" Dmx="61~80" Colour="0,255,255" />
      <Function ID="6" Name="Blue/Red" Display="'Blue/Red'" Dmx="81~100" Colour="0,0,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue'" Dmx="101~120" Colour="255,0,255" />
      <Function ID="8" Name="Red/Grn/Bl" Display="'Red/Grn/Bl'" Dmx="121~140" Colour="255,0,0" />
      <Function ID="9" Name="RGB" Display="'RGB'" Dmx="141~160" Colour="255,255,255" />
      <Function ID="10" Name="RGBW" Display="'RGBW'" Dmx="161~180" Colour="255,255,255" />
      <Function ID="11" Name="Black" Display="'Black'" Dmx="181~200" Colour="0,0,0" />
      <Function ID="12" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="13" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="14" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="15" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="16" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="17" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="18" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="19" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="20" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="21" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="22" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ID" Name="ID" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~9" />
      <Function ID="2" Name="ID 1" Display="'ID 1'" Dmx="10~19" />
      <Function ID="3" Name="ID 2" Display="'ID 2'" Dmx="20~29" />
      <Function ID="4" Name="ID 3" Display="'ID 3'" Dmx="30~39" />
      <Function ID="5" Name="ID 4" Display="'ID 4'" Dmx="40~49" />
      <Function ID="6" Name="ID 5" Display="'ID 5'" Dmx="50~59" />
      <Function ID="7" Name="ID 6" Display="'ID 6'" Dmx="60~69" />
      <Function ID="8" Name="ID 7" Display="'ID 7'" Dmx="70~79" />
      <Function ID="9" Name="ID 8" Display="'ID 8'" Dmx="80~89" />
      <Function ID="10" Name="ID 9" Display="'ID 9'" Dmx="90~99" />
      <Function ID="11" Name="ID 10" Display="'ID 10'" Dmx="100~109" />
      <Function ID="12" Name="ID 11" Display="'ID 11'" Dmx="110~119" />
      <Function ID="13" Name="ID 12" Display="'ID 12'" Dmx="120~129" />
      <Function ID="14" Name="ID 13" Display="'ID 13'" Dmx="130~139" />
      <Function ID="15" Name="ID 14" Display="'ID 14'" Dmx="140~149" />
      <Function ID="16" Name="ID 15" Display="'ID 15'" Dmx="150~159" />
      <Function ID="17" Name="ID 16" Display="'ID 16'" Dmx="160~169" />
      <Function ID="18" Name="ID 17" Display="'ID 17'" Dmx="170~179" />
      <Function ID="19" Name="ID 18" Display="'ID 18'" Dmx="180~189" />
      <Function ID="20" Name="ID 19" Display="'ID 19'" Dmx="190~199" />
      <Function ID="21" Name="ID 20" Display="'ID 20'" Dmx="200~209" />
      <Function ID="22" Name="ID 21" Display="'ID 21'" Dmx="210~219" />
      <Function ID="23" Name="ID 22" Display="'ID 22'" Dmx="220~229" />
      <Function ID="24" Name="ID 23" Display="'ID 23'" Dmx="230~239" />
      <Function ID="25" Name="ID 24" Display="'ID 24'" Dmx="240~249" />
      <Function ID="26" Name="ID 25" Display="'ID 25'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX, 16bit" Channels="15">
    <Import PearlRef="UK_ARWsh72X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="7,9" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="8,10" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="14" Wheel="7" />
      <Attribute ID="Custom" ChannelOffset="6" Wheel="29" />
      <Attribute ID="PT_Speed" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Macro" ChannelOffset="13" Wheel="30" />
      <Attribute ID="ID" ChannelOffset="15" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="11 DMX, 16bit" Channels="11">
    <Import PearlRef="UK_ARWsh72B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="7,9" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="8,10" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="White" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Custom" ChannelOffset="6" Wheel="29" />
      <Attribute ID="PT_Speed" ChannelOffset="11" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
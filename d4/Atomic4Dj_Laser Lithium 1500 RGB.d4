  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="8" PowerOn="8" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Update="Pattern, Zoom" />
      <Function ID="2" Name="ILD" Display="'ILD'" Dmx="1~40" Update="Pattern, Zoom" />
      <Function ID="3" Name="ILD Sound" Display="'ILD Sound'" Dmx="41~80" Update="Pattern, Zoom" />
      <Function ID="4" Name="PRG" Display="'PRG'" Dmx="81~100" Update="Pattern, Zoom" />
      <Function ID="5" Name="PRG Sound" Display="'PRG Sound'" Dmx="101~120" Update="Pattern, Zoom" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="121~160" Update="Pattern, Zoom" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="161~200" Update="Pattern, Zoom" />
      <Function ID="8" Name="DMX" Display="'DMX'" Dmx="201~240" Update="Pattern, Zoom" />
      <Function ID="9" Name="DMX Sound" Display="'DMX Sound'" Dmx="241~255" Update="Pattern, Zoom" />
    </Attribute>
    <Attribute ID="Sensitivity" Name="Sensitivity" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Patt_Mode" Name="Patt Mode" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Mode 1" Display="'Mode 1'" Dmx="1~49" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Mode 2" Display="'Mode 2'" Dmx="50~99" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Mode 3" Display="'Mode 3'" Dmx="100~149" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Mode 4" Display="'Mode 4'" Dmx="150~199" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Mode 5" Display="'Mode 5'" Dmx="200~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="SD" ID="2" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;6" />
      <Else ID="1" />
      <Function ID="1" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folder" Display="'%.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="SD" ID="6" If="'Mode'&gt;1&amp;&amp;'Mode'&lt;6" />
      <Else ID="1,2,3,4,5" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.f%%',0~100" Dmx="0~63" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1 %.f%%',0~100" Dmx="64~159" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Shrink" Display="'Shrink %.f%%',0~100" Dmx="160~192" Iris="0~0" Zoom="0~0" />

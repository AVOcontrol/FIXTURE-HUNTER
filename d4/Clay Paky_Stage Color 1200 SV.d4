<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stage Color 1200 SV" ShortName="StCol1200S" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-05-05" Author="Tom" Comment="Checked" />
  <History Date="25-07-05" Author="D Trounce" Comment="Error: Control: Half power after 10 mins" />
  <History Date="27-07-05" Author="E Spencer" Comment="Fixed control to locate to lamp off" />
  <History Date="06-04-06" Author="Ed" Comment="Moved CTC to colour group" />
  <History Date="06-04-06" Author="Ed" Comment="Moved Frost into Beam group" />
  <History Date="10-04-06" Author="Ed Spencer" Comment="Moved Ovaliser into Beam Group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-06-17" Author="Nic Morris" Comment="Standardised CMY function names.  Standardised shutter.  Standardised highlight/lowlight." />
  <History Date="14-06-17" Author="Nic Morris" Comment="Revised frost with discreet functions.  Changed CTC to CTO." />
  <History Date="14-06-17" Author="Nic Morris" Comment="Added palettes.  Moved ovalizer and frost into beam wheel slot." />
  <History Date="30-06-17" Author="Nic Morris" Comment="Changed to locate at lamp on as there is no safe value." />
  <Manual Filename="/manual/Clay Paky_Stage Color 1200.pdf" Summary="Creator:Clay Paky, 09-07-2001" />
  <AtlaBase TypeID="a8541b8e-07ca-427f-aca0-0b9e05bd6dd6" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mx" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~25" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="231~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="26~230" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:40" PowerOn="1:40" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour " Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Blue w/hole" Display="'Blue w/hole'" Dmx="43~85" Colour="0,0,0" />
      <Function ID="3" Name="Yellow w/hole" Display="'Yellow w/hole'" Dmx="86~128" Colour="0,0,0" />
      <Function ID="4" Name="Green w/hole" Display="'Green w/hole'" Dmx="129~171" Colour="0,0,0" />
      <Function ID="5" Name="Magenta w/hole" Display="'Magenta w/hole'" Dmx="172~214" Colour="0,0,0" />
      <Function ID="6" Name="UV Filter" Display="'UV Filter'" Dmx="215~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Ovalizer" Name="Ovalizer" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Ovalizer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Light Frost" Display="'Light Frost'" Dmx="84~84" />
      <Function ID="3" Name="Medium Frost" Display="'Medium Frost'" Dmx="168~168" />
      <Function ID="4" Name="Heavy Frost" Display="'Heavy Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="3" PowerOn="1" />
      <Function ID="1" Name="Lamp Off" Display="'Lamp Off'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On (Half)" Display="'Lamp On (Half)'" Dmx="64~127" />
      <Function ID="3" Name="Lamp On (Full)" Display="'Lamp On (Full)'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="255~0" Colour="0,0,255" />
    </Attribute>
  </Control>

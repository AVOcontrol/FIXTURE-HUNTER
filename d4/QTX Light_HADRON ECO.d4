  <Thumbnail>ec1a78b0-d333-482b-b25a-97c91b2fe45a</Thumbnail>
  <History Date="28-11-23" Author="Nic Morris" Comment="Created (poor documentation.  charts contain errors/range conflicts/incomplete ranges)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="RGBWA_LEDs" Name="RGBWA LEDs" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="11~20" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="21~30" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="31~40" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="41~50" Colour="255,255,255" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="51~60" Colour="255,100,0" />
      <Function ID="7" Name="R+G" Display="'R+G'" Dmx="61~70" Colour="255,255,255" />
      <Function ID="8" Name="R+B" Display="'R+B'" Dmx="71~80" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="81~90" Colour="255,255,255" />
      <Function ID="10" Name="R+A" Display="'R+A'" Dmx="91~100" Colour="255,255,255" />
      <Function ID="11" Name="G+B" Display="'G+B'" Dmx="101~110" Colour="255,255,255" />
      <Function ID="12" Name="G+W" Display="'G+W'" Dmx="111~120" Colour="255,255,255" />
      <Function ID="13" Name="G+A" Display="'G+A'" Dmx="121~130" Colour="255,255,255" />
      <Function ID="14" Name="B+W" Display="'B+W'" Dmx="131~140" Colour="255,255,255" />
      <Function ID="15" Name="B+A" Display="'B+A'" Dmx="141~150" Colour="255,255,255" />
      <Function ID="16" Name="R+B+A" Display="'R+B+A'" Dmx="151~160" Colour="255,255,255" />
      <Function ID="17" Name="R+G+A" Display="'R+G+A'" Dmx="161~170" Colour="255,255,255" />
      <Function ID="18" Name="B+W+A" Display="'B+W+A'" Dmx="171~180" Colour="255,255,255" />
      <Function ID="19" Name="G+W+A" Display="'G+W+A'" Dmx="181~190" Colour="255,255,255" />
      <Function ID="20" Name="R+W+A" Display="'R+W+A'" Dmx="191~200" Colour="255,255,255" />
      <Function ID="21" Name="G+B+W+A" Display="'G+B+W+A'" Dmx="201~210" Colour="255,255,255" />
      <Function ID="22" Name="R+B+W+A" Display="'R+B+W+A'" Dmx="211~220" Colour="255,255,255" />
      <Function ID="23" Name="R+G+W+A" Display="'R+G+W+A'" Dmx="221~230" Colour="255,255,255" />
      <Function ID="24" Name="R+G+B+A" Display="'R+G+B+A'" Dmx="231~240" Colour="255,255,255" />
      <Function ID="25" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="241~250" Colour="255,255,255" />
      <Function ID="26" Name="R+G+B+W+A" Display="'R+G+B+W+A'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Motor" Name="Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~11" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="139~255" />
    </Attribute>
    <Attribute ID="Laser" Name="Laser" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Red Laser" Display="'Red Laser'" Dmx="11~100" />
      <Function ID="3" Name="Green Laser" Display="'Green Laser'" Dmx="101~200" />
      <Function ID="4" Name="R+G Laser" Display="'R+G Laser'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Laser_Motor" Name="Laser Motor" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~11" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="139~255" />
    </Attribute>
    <Attribute ID="White_LEDs" Name="White LEDs" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="11~20" Colour="0,0,0" />
      <Function ID="3" Name="2" Display="'2'" Dmx="21~30" Colour="0,0,0" />
      <Function ID="4" Name="3" Display="'3'" Dmx="31~40" Colour="0,0,0" />
      <Function ID="5" Name="4" Display="'4'" Dmx="41~50" Colour="0,0,0" />
      <Function ID="6" Name="5" Display="'5'" Dmx="51~60" Colour="0,0,0" />
      <Function ID="7" Name="6" Display="'6'" Dmx="61~70" Colour="0,0,0" />
      <Function ID="8" Name="7" Display="'7'" Dmx="71~80" Colour="0,0,0" />
      <Function ID="9" Name="8" Display="'8'" Dmx="81~90" Colour="0,0,0" />
      <Function ID="10" Name="1+5" Display="'1+5'" Dmx="91~100" Colour="0,0,0" />
      <Function ID="11" Name="2+6" Display="'2+6'" Dmx="101~110" Colour="0,0,0" />
      <Function ID="12" Name="3+7" Display="'3+7'" Dmx="111~120" Colour="0,0,0" />
      <Function ID="13" Name="4+8" Display="'4+8'" Dmx="121~130" Colour="0,0,0" />
      <Function ID="14" Name="1+2" Display="'1+2'" Dmx="131~140" Colour="0,0,0" />
      <Function ID="15" Name="3+4" Display="'3+4'" Dmx="141~150" Colour="0,0,0" />
      <Function ID="16" Name="5+6" Display="'5+6'" Dmx="151~160" Colour="0,0,0" />
      <Function ID="17" Name="7+8" Display="'7+8'" Dmx="161~170" Colour="0,0,0" />
      <Function ID="18" Name="1+8" Display="'1+8'" Dmx="171~180" Colour="0,0,0" />
      <Function ID="19" Name="4+5" Display="'4+5'" Dmx="181~190" Colour="0,0,0" />
      <Function ID="20" Name="1+3+5+7" Display="'1+3+5+7'" Dmx="191~200" Colour="0,0,0" />
      <Function ID="21" Name="2+4+6+8" Display="'2+4+6+8'" Dmx="201~210" Colour="0,0,0" />
      <Function ID="22" Name="3+4+5+6" Display="'3+4+5+6'" Dmx="211~220" Colour="0,0,0" />
      <Function ID="23" Name="1+2+7+8" Display="'1+2+7+8'" Dmx="221~230" Colour="0,0,0" />
      <Function ID="24" Name="1+2+3+4" Display="'1+2+3+4'" Dmx="231~240" Colour="0,0,0" />
      <Function ID="25" Name="5+6+7+8" Display="'5+6+7+8'" Dmx="241~250" Colour="0,0,0" />
      <Function ID="26" Name="All On" Display="'All On'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Strobe" Name="Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="11~200" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="fb298995-a7d4-4ec2-afe7-3f6c23b4378c">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="RGBWA_LEDs" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Laser" ChannelOffset="2" Wheel="13" />
      <Attribute ID="Motor" ChannelOffset="3" Wheel="19" />
      <Attribute ID="White_LEDs" ChannelOffset="4" Wheel="8" />

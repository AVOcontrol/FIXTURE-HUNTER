      <Function ID="29" Name="CTB/ Blu" Display="'CTB/ Blu'" Dmx="108~108" WheelPosition="13" Colour="230,230,255" />
      <Function ID="30" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="116~116" WheelPosition="14" Colour="0,0,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="191~127" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />

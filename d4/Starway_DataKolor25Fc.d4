    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fade" ID="2" If="'Effect11'&gt;1&amp;&amp;'Effect11'&lt;21" />
      <Condition Name="Speed" ID="3" If="'Effect11'&gt;20&amp;&amp;'Effect11'&lt;34" />

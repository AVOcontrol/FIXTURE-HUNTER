      <Function ID="11" Name="Effect 11" Display="'Effect 11'" Dmx="214~234" />
      <Function ID="12" Name="Effect 12" Display="'Effect 12'" Dmx="235~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">

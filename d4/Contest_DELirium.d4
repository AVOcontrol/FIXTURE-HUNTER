  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="Sync" Display="'Sync'" Dmx="10~129" />
      <Function ID="3" Name="Asycn" Display="'Asycn'" Dmx="130~249" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" />
      <Function ID="2" Name="Effect 2" Display="'Effect 2'" Dmx="22~42" />
      <Function ID="3" Name="Effect 3" Display="'Effect 3'" Dmx="43~63" />
      <Function ID="4" Name="Effect 4" Display="'Effect 4'" Dmx="64~85" />
      <Function ID="5" Name="Effect 5" Display="'Effect 5'" Dmx="86~106" />
      <Function ID="6" Name="Effect 6" Display="'Effect 6'" Dmx="107~127" />
      <Function ID="7" Name="Effect 7" Display="'Effect 7'" Dmx="128~149" />
      <Function ID="8" Name="Effect 8" Display="'Effect 8'" Dmx="150~170" />
      <Function ID="9" Name="Effect 9" Display="'Effect 9'" Dmx="171~191" />

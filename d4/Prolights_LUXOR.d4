    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="BO on P/T" Display="'BO on P/T'" Dmx="70~79" />
      <Function ID="3" Name="Disable BO on P/T" Display="'Disable BO on P/T'" Dmx="80~89" />
      <Function ID="4" Name="BO on Colour" Display="'BO on Colour'" Dmx="90~99" />
      <Function ID="5" Name="Disable BO on Colour" Display="'Disable BO on Colour'" Dmx="100~109" />
      <Function ID="6" Name="BO on Gobo" Display="'BO on Gobo'" Dmx="110~119" />
      <Function ID="7" Name="Disable BO on Gobo" Display="'Disable BO on Gobo'" Dmx="120~129" />
      <Function ID="8" Name="Lamp On" Display="'Lamp On'" Dmx="130~139" />
      <Function ID="9" Name="Reset P/T" Display="'Reset P/T'" Dmx="140~149" />
      <Function ID="10" Name="Reset Colour" Display="'Reset Colour'" Dmx="150~159" />
      <Function ID="11" Name="Reset Gobo" Display="'Reset Gobo'" Dmx="160~169" />
      <Function ID="12" Name="Reset Shutter" Display="'Reset Shutter'" Dmx="170~179" />
      <Function ID="13" Name="Reset Focus" Display="'Reset Focus'" Dmx="180~189" />
      <Function ID="14" Name="Reset Frost" Display="'Reset Frost'" Dmx="190~199" />
      <Function ID="15" Name="Reset All" Display="'Reset All'" Dmx="200~209" />
      <Function ID="16" Name="BO on Change" Display="'BO on Change'" Dmx="210~219" />
      <Function ID="17" Name="Disable BO on Change" Display="'Disable BO on Change'" Dmx="220~229" />

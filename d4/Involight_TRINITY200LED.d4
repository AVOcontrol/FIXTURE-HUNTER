      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op - Rd" Display="'Op - Rd %.f%%',0~100" Dmx="15~80" Colour="255,255,255" />
      <Function ID="3" Name="Red" Display="'Red'" Dmx="80~99" Colour="255,0,0" />
      <Function ID="4" Name="Rd - L Pk" Display="'Rd - L Pk %.f%%',0~100" Dmx="99~160" Colour="255,0,0" />
      <Function ID="5" Name="Light Pink" Display="'Light Pink'" Dmx="160~189" Colour="255,200,200" />
      <Function ID="6" Name="L Pk - D Pk" Display="'L Pk - D Pk %.f%%',0~100" Dmx="189~250" Colour="255,200,200" />
      <Function ID="7" Name="Dark Pink" Display="'Dark Pink'" Dmx="250~255" Colour="255,150,150" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour3" Name="Colour 3" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op - Grn" Display="'Op - Grn %.f%%',0~100" Dmx="15~80" Colour="255,255,255" />

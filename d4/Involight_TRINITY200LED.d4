  <History Date="06-08-17" Author="Nic Morris" Comment="Created" />
  <History Date="09-09-17" Author="Nic Morris" Comment="Created from Diapro DP Spot LED 200 CMY (note range conflict in Gobo Rot.  Assumed CW fast = 130)." />
  <History Date="23-02-18" Author="Nic Morris" Comment="Created from Blizzard Lighting G-Mix 200" />
  <History Date="24-04-18" Author="Nic Morris" Comment="Created from SSP Super BEE BSW CMY" />
  <History Date="21-01-19" Author="Nic Morris" Comment="Created from BSL Pure Hybrid 200 (colour ranges missing - assumed idential but added raw function just in case)" />
  <History Date="22-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="2f91b37b-edac-4a09-84ea-2be2e0982c82" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">

    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Op - Grn" Display="'Op - Grn %.f%%',0~100" Dmx="15~70" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="70~99" Colour="0,255,0" />
      <Function ID="4" Name="Grn - Blu" Display="'Grn - Blu %.f%%',0~100" Dmx="99~155" Colour="0,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="155~180" Colour="0,0,255" />
      <Function ID="6" Name="Blu - L Blu" Display="'Blu - L Blu %.f%%',0~100" Dmx="180~235" Colour="0,0,255" />

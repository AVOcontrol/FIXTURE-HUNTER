  <Control>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~90" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="Macro 1" Display="'Macro 1'" Dmx="91~100" Update="Shutter" Colour="0,0,0" />
      <Function ID="4" Name="Macro 2" Display="'Macro 2'" Dmx="101~110" Update="Shutter" Colour="0,0,0" />
      <Function ID="5" Name="Macro 3" Display="'Macro 3'" Dmx="111~120" Update="Shutter" Colour="0,0,0" />
      <Function ID="6" Name="Macro 4" Display="'Macro 4'" Dmx="121~130" Update="Shutter" Colour="0,0,0" />
      <Function ID="7" Name="Macro 5" Display="'Macro 5'" Dmx="131~140" Update="Shutter" Colour="0,0,0" />
      <Function ID="8" Name="Macro 6" Display="'Macro 6'" Dmx="141~150" Update="Shutter" Colour="0,0,0" />
      <Function ID="9" Name="Macro 7" Display="'Macro 7'" Dmx="151~160" Update="Shutter" Colour="0,0,0" />
      <Function ID="10" Name="Macro 8" Display="'Macro 8'" Dmx="161~170" Update="Shutter" Colour="0,0,0" />
      <Function ID="11" Name="Macro 9" Display="'Macro 9'" Dmx="171~180" Update="Shutter" Colour="0,0,0" />
      <Function ID="12" Name="Macro 10" Display="'Macro 10'" Dmx="181~190" Update="Shutter" Colour="0,0,0" />
      <Function ID="13" Name="RGBW" Display="'RGBW'" Dmx="191~200" Update="Shutter" Colour="0,0,0" />
      <Function ID="14" Name="White 1" Display="'White 1'" Dmx="201~205" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="White 2" Display="'White 2'" Dmx="206~210" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="White 3" Display="'White 3'" Dmx="211~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="White 4" Display="'White 4'" Dmx="216~220" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="White 5" Display="'White 5'" Dmx="221~225" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="White 6" Display="'White 6'" Dmx="226~230" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="White 7" Display="'White 7'" Dmx="231~235" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="White 8" Display="'White 8'" Dmx="236~240" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="White 9" Display="'White 9'" Dmx="241~245" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="White 10" Display="'White 10'" Dmx="246~250" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="White 11" Display="'White 11'" Dmx="251~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;14" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="10~19" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="20~29" />

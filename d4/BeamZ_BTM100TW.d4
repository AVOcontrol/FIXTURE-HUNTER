  <AtlaBase TypeID="cab85d71-04e1-441f-bf0c-5267db526f16" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:2700" PowerOn="1:2700" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',2700~6500" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fade Off" Display="'Fade Off'" Dmx="0~0" />
      <Function ID="2" Name="Low" Display="'Low'" Dmx="31~60" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="61~90" />
      <Function ID="4" Name="High" Display="'High'" Dmx="91~255" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3" Id="e293bc47-12dd-473f-990a-5211db02a3c9">

  <Thumbnail>941ed0a1-ad3c-4af9-9e90-931282eff081</Thumbnail>
  <History Date="02-12-23" Author="Nic Morris" Comment="Created (charts contain range conflicts.  control functions suggest colour, gobo and blade controls change functions in a way that can only be supported by separate modes but these are not documented properly)" Version="0" />
  <History Date="01-07-24" Author="Nic Morris" Comment="Updated in line with latest charts (reduces gobo count to 7, revises autofocus functions and combines animation and animation rot into one control).  Added product thumbnail." Version="3" />
  <History Date="04-07-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="c03e050e-1b2a-4c43-8865-964b758755a9" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />

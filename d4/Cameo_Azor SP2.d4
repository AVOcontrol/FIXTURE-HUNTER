    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10,11,12,13,14,15,16,17,18" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Colour1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="21~21" WheelPosition="1" Colour="200,0,0" />
      <Function ID="3" Name="Medium Blue" Display="'Medium Blue'" Dmx="42~42" WheelPosition="2" Colour="0,0,255" />
      <Function ID="4" Name="Deep Green" Display="'Deep Green'" Dmx="63~63" WheelPosition="3" Colour="0,200,0" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="84~84" WheelPosition="4" Colour="255,255,0" />
      <Function ID="6" Name="High CRI" Display="'High CRI'" Dmx="105~105" WheelPosition="5" Colour="255,255,255" />
      <Function ID="7" Name="Deep Orange" Display="'Deep Orange'" Dmx="126~126" WheelPosition="6" Colour="255,100,0" />
      <Function ID="8" Name="CTO 3200K" Display="'CTO 3200K'" Dmx="148~148" WheelPosition="7" Colour="255,240,200" />
      <Function ID="9" Name="Congo Blue" Display="'Congo Blue'" Dmx="169~169" WheelPosition="8" Colour="180,0,255" />
      <Function ID="10" Name="Op - D Rd" Display="'Op - D Rd %.f%%',0~100" Dmx="0~21" WheelPosition="0" Colour="255,255,255" />
      <Function ID="11" Name="D Rd - M Blu" Display="'D Rd - M Blu %.f%%',0~100" Dmx="21~42" WheelPosition="1" Colour="200,0,0" />
      <Function ID="12" Name="M Blu - D Grn" Display="'M Blu - D Grn %.f%%',0~100" Dmx="42~63" WheelPosition="2" Colour="0,0,255" />
      <Function ID="13" Name="D Grn - Lm" Display="'D Grn - Lm %.f%%',0~100" Dmx="63~84" WheelPosition="3" Colour="0,200,0" />
      <Function ID="14" Name="Lm - HCRI" Display="'Lm - HCRI %.f%%',0~100" Dmx="84~105" WheelPosition="4" Colour="255,255,0" />
      <Function ID="15" Name="HCRI - D Org" Display="'HCRI - D Org %.f%%',0~100" Dmx="105~126" WheelPosition="5" Colour="255,255,255" />
      <Function ID="16" Name="D Org - CTO" Display="'D Org - CTO %.f%%',0~100" Dmx="126~148" WheelPosition="6" Colour="255,100,0" />
      <Function ID="17" Name="CTO - C Blu" Display="'CTO - C Blu %.f%%',0~100" Dmx="148~169" WheelPosition="7" Colour="255,240,200" />
      <Function ID="18" Name="C Blu - Op" Display="'C Blu - Op %.f%%',0~100" Dmx="169~190" WheelPosition="8" Colour="180,0,255" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" Colour="0,0,0" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~223" Colour="0,0,0" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" Colour="0,0,0" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" Colour="0,0,0" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Index Index" Display="'Index Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Index Spin" Display="'Index Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="8" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="9" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Index" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Shake" ID="17,18,19,20,21,22,23,24" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Condition Name="Scroll" ID="25,26,27,28" If="'Gobo1Func'==7||'Gobo1Func'==8" />
      <Else ID="29" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="22~22" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="39~39" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="56~56" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="73~73" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="90~90" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="107~107" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="124~124" WheelPosition="7" />
      <Function ID="9" Name="Op - 1" Display="'Op - 1 %.f%%',0~100" Dmx="0~22" WheelPosition="0" />
      <Function ID="10" Name="1 - 2" Display="'1 - 2 %.f%%',0~100" Dmx="22~39" WheelPosition="1" />
      <Function ID="11" Name="2 - 3" Display="'2 - 3 %.f%%',0~100" Dmx="39~56" WheelPosition="2" />
      <Function ID="12" Name="3 - 4" Display="'3 - 4 %.f%%',0~100" Dmx="56~73" WheelPosition="3" />
      <Function ID="13" Name="4 - 5" Display="'4 - 5 %.f%%',0~100" Dmx="73~90" WheelPosition="4" />
      <Function ID="14" Name="5 - 6" Display="'5 - 6 %.f%%',0~100" Dmx="90~107" WheelPosition="5" />
      <Function ID="15" Name="6 - 7" Display="'6 - 7 %.f%%',0~100" Dmx="107~124" WheelPosition="6" />
      <Function ID="16" Name="7 - Op" Display="'7 - Op %.f%%',0~100" Dmx="124~141" WheelPosition="7" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="160~162" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="163~165" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="166~168" WheelPosition="3" />
      <Function ID="21" Name="Gobo 4 Shake" Display="'Gobo 4 Shake %.f%%',0~100" Dmx="169~171" WheelPosition="4" />
      <Function ID="22" Name="Gobo 5 Shake" Display="'Gobo 5 Shake %.f%%',0~100" Dmx="172~174" WheelPosition="5" />
      <Function ID="23" Name="Gobo 6 Shake" Display="'Gobo 6 Shake %.f%%',0~100" Dmx="175~177" WheelPosition="6" />
      <Function ID="24" Name="Gobo 7 Shake" Display="'Gobo 7 Shake %.f%%',0~100" Dmx="178~180" WheelPosition="7" />
      <Function ID="25" Name="Open" Display="'Open'" Dmx="181~192" WheelPosition="0" />
      <Function ID="26" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="193~223" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" />
      <Function ID="28" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="225~255" />
      <Function ID="29" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5||'Gobo1Func'==7" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6||'Gobo1Func'==8" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~32896" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="33153~49087" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="49344~49344" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="49601~65535" />

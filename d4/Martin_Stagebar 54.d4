<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Stagebar 54" ShortName="StBar 54" Company="Martin">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-04-07" Author="D.Milligan" Comment="Created" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="06-04-09" Author="David Hunt" Comment="Added HTP " />
  <History Date="06-04-09" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="25-09-13" Author="Gregory Haynes" Comment="Added virtual dimmer to RGB and RGBAW modes, removed vDim modes. Added preset palettes. Removed unused Intensity attribute." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="29-05-15" Author="Nic Morris" Comment="Added multi-cell modes.  Changed hue and saturation to colour group.  Standardised wheel mapping." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-11-16" Author="Gregory Haynes" Comment="Corrected Dimmer channel offset in HSIC mode" />
  <History Date="08-01-17" Author="Nic Morris" Comment="Added missing Atlabase ID's." />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed name from StageBar 54 to Stagebar 54" />
  <History Date="15-12-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />

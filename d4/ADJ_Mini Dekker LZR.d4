  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Mini Dekker LZR.d4 to ADJ_Mini Dekker LZR.d4." Version="2" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Show_Mode" Name="Show Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="LED + Laser + Strobe" Display="'LED + Laser + Strobe'" Dmx="10~89" />
      <Function ID="3" Name="LED" Display="'LED'" Dmx="90~169" />
      <Function ID="4" Name="Laser" Display="'Laser'" Dmx="170~255" />
    </Attribute>
    <Attribute ID="RGBW_Col_Macro" Name="RGBW Col Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="15 Cols" Display="'15 Cols %.1f%%',0.0~100.0" Dmx="10~198" Colour="255,255,255" />
      <Function ID="3" Name="1 Col Fade" Display="'1 Col Fade %.f%%',0~100" Dmx="199~225" Colour="255,255,255" />
      <Function ID="4" Name="Mixed Fade" Display="'Mixed Fade %.f%%',0~100" Dmx="226~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Strobe" Name="LED Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Strobe Off" Display="'Strobe Off'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~244" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Laser_Col" Name="Laser Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~49" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="50~89" Colour="255,255,255" />
      <Function ID="4" Name="Red + Green" Display="'Red + Green'" Dmx="90~129" Colour="255,255,255" />
      <Function ID="5" Name="Red On, Green Flash" Display="'Red On, Green Flash'" Dmx="130~169" Colour="255,255,255" />
      <Function ID="6" Name="Green On, Red Flash" Display="'Green On, Red Flash'" Dmx="170~209" Colour="255,255,255" />
      <Function ID="7" Name="Red + Green Flash" Display="'Red + Green Flash'" Dmx="210~249" Colour="255,255,255" />
      <Function ID="8" Name="Red + Green Alt Flash" Display="'Red + Green Alt Flash'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Strobe" Name="Laser Strobe" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~244" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="LED_Rotate" Name="LED Rotate" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Laser_Pattern" Name="Laser Pattern" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Chase" Display="'Chase %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7">
    <Import PearlRef="ADJMDLZR" DiamondRef="" WysiwygRef="" />
    <Physical>

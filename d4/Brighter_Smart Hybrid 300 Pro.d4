      <Function ID="3" Name="Fan Silent" Display="'Fan Silent'" Dmx="72~76" />
      <Function ID="4" Name="Fan Full" Display="'Fan Full'" Dmx="77~81" />
      <Function ID="5" Name="Reset Effect" Display="'Reset Effect'" Dmx="201~215" />

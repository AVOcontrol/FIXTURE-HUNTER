<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Headbanger 10" ShortName="Headbang10" Company="Stagg">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>ed86c986-8790-4326-8824-b9b68c710062</Thumbnail>
  <History Date="14-08-12" Author="Peter Budd" Comment="Created" />
  <History Date="17-12-12" Author="Peter Budd" Comment="Removed closed range from Dimmer." />
  <History Date="26-07-13" Author="john rogers" Comment="Edited locate DMX values of Shutter and Colour Macro." />
  <History Date="06-11-13" Author="Peter Budd" Comment="Created from the Stagg Headbanger." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="26-02-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail." />
  <History Date="22-06-19" Author="Nic Morris" Comment="Added 13 channel v2 mode (not currently documented)" />
  <History Date="25-06-19" Author="Nic Morris" Comment="Added 13 DMX mode Atlabase ID." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4fd48fa5-5974-46db-9402-30952a4460ad" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macros" Display="'Macros %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound Active" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disabled" Display="'Disabled'" Dmx="0~0" />
      <Function ID="2" Name="Enabled" Display="'Enabled'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX, 8bit" Channels="7">
    <Import PearlRef="SA_Headb10B" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4d08fd3a-57c5-4899-a95c-7e70f08e2a54" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="White" ChannelOffset="7" Wheel="9" />
    </Include>
  </Mode>
  <Mode Name="12 DMX, 16bit" Channels="12">
    <Import PearlRef="SA_Headb10X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="57588bc4-0c6a-446d-9348-6ac0d5bb7d64" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="5" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="10" Wheel="8" />
      <Attribute ID="Sound" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7a962c50-1b5b-4199-802f-0d2c9674e1a5" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="White" ChannelOffset="10" Wheel="9" />
      <Attribute ID="Colour_Macro" ChannelOffset="11" Wheel="8" />
      <Attribute ID="Shutter" ChannelOffset="12" Wheel="4" />
      <Attribute ID="Sound" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="BEAMBAR10-RGBW" ShortName="BmBar 10" Company="BriteQ">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="02-02-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="R" Display="'R'" Dmx="0~23" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="G" Display="'G'" Dmx="24~31" Update="Shutter" Colour="255,255,255" />
      <Function ID="3" Name="B" Display="'B'" Dmx="32~39" Update="Shutter" Colour="255,255,255" />
      <Function ID="4" Name="W" Display="'W'" Dmx="40~47" Update="Shutter" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="48~55" Update="Shutter" Colour="255,255,255" />
      <Function ID="6" Name="GB" Display="'GB'" Dmx="56~63" Update="Shutter" Colour="255,255,255" />
      <Function ID="7" Name="BW" Display="'BW'" Dmx="64~71" Update="Shutter" Colour="255,255,255" />
      <Function ID="8" Name="RW" Display="'RW'" Dmx="72~79" Update="Shutter" Colour="255,255,255" />
      <Function ID="9" Name="GW" Display="'GW'" Dmx="80~87" Update="Shutter" Colour="255,255,255" />
      <Function ID="10" Name="RB" Display="'RB'" Dmx="88~95" Update="Shutter" Colour="255,255,255" />
      <Function ID="11" Name="RGB" Display="'RGB'" Dmx="96~103" Update="Shutter" Colour="255,255,255" />
      <Function ID="12" Name="GBW" Display="'GBW'" Dmx="104~111" Update="Shutter" Colour="255,255,255" />
      <Function ID="13" Name="RGW" Display="'RGW'" Dmx="112~119" Update="Shutter" Colour="255,255,255" />
      <Function ID="14" Name="RBW" Display="'RBW'" Dmx="120~127" Update="Shutter" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="128~135" Update="Shutter" Colour="255,255,255" />
      <Function ID="16" Name="CFADE" Display="'CFADE'" Dmx="136~143" Update="Shutter" Colour="255,255,255" />
      <Function ID="17" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Shutter" Colour="255,255,255" />
      <Function ID="18" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Shutter" Colour="255,255,255" />
      <Function ID="19" Name="CHANGE" Display="'CHANGE'" Dmx="160~167" Update="Shutter" Colour="255,255,255" />
      <Function ID="20" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Shutter" Colour="255,255,255" />
      <Function ID="21" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Shutter" Colour="255,255,255" />
      <Function ID="22" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Shutter" Colour="255,255,255" />
      <Function ID="23" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Shutter" Colour="255,255,255" />
      <Function ID="24" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Shutter" Colour="255,255,255" />
      <Function ID="25" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Shutter" Colour="255,255,255" />
      <Function ID="26" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Shutter" Colour="255,255,255" />
      <Function ID="27" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Shutter" Colour="255,255,255" />
      <Function ID="28" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Shutter" Colour="255,255,255" />
      <Function ID="29" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Shutter" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;15&amp;&amp;'Colour_Macro'&lt;29" />
      <Condition Name="Sensitivity" ID="4" If="'Colour_Macro'==29" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~8" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="9~255" Intensity="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="RGB+DIM" ID="2,3,4,5" If="'Dummy'==1" />
      <Condition Name="Speed" ID="6" If="'Effect'&gt;16&amp;&amp;'Effect'&lt;30" />
      <Condition Name="Sensitivity" ID="7" If="'Effect'==30" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="248~255" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" Intensity="0~0" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="191~200" Intensity="0~0" />
      <Function ID="6" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="7" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Sel" ID="2,3,4,5,6,7,8,9" If="'Effect'==28||'Effect'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="RGB" Display="'RGB'" Dmx="0~35" Colour="255,255,255" />
      <Function ID="3" Name="RB" Display="'RB'" Dmx="36~71" Colour="255,255,255" />
      <Function ID="4" Name="GB" Display="'GB'" Dmx="72~107" Colour="255,255,255" />
      <Function ID="5" Name="RG" Display="'RG'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="6" Name="B" Display="'B'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="7" Name="G" Display="'G'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="8" Name="R" Display="'R'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="9" Name="Off" Display="'Off'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Col Sel" ID="2,3,4,5,6,7,8,9" If="'Effect'==28||'Effect'==29" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="0~35" Colour="255,255,255" />
      <Function ID="3" Name="R" Display="'R'" Dmx="36~71" Colour="255,255,255" />
      <Function ID="4" Name="G" Display="'G'" Dmx="72~107" Colour="255,255,255" />
      <Function ID="5" Name="B" Display="'B'" Dmx="108~143" Colour="255,255,255" />
      <Function ID="6" Name="RG" Display="'RG'" Dmx="144~179" Colour="255,255,255" />
      <Function ID="7" Name="GB" Display="'GB'" Dmx="180~215" Colour="255,255,255" />
      <Function ID="8" Name="RB" Display="'RB'" Dmx="216~251" Colour="255,255,255" />
      <Function ID="9" Name="RGB" Display="'RGB'" Dmx="252~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~15" Update="Dimmer, Red, Green" />
      <Function ID="2" Name="R" Display="'R'" Dmx="16~23" Update="Dimmer, Red, Green" />
      <Function ID="3" Name="G" Display="'G'" Dmx="24~31" Update="Dimmer, Red, Green" />
      <Function ID="4" Name="B" Display="'B'" Dmx="32~39" Update="Dimmer, Red, Green" />
      <Function ID="5" Name="R/G" Display="'R/G'" Dmx="40~47" Update="Dimmer, Red, Green" />
      <Function ID="6" Name="G/B" Display="'G/B'" Dmx="48~55" Update="Dimmer, Red, Green" />
      <Function ID="7" Name="R/B" Display="'R/B'" Dmx="56~63" Update="Dimmer, Red, Green" />
      <Function ID="8" Name="RGB" Display="'RGB'" Dmx="64~71" Update="Dimmer, Red, Green" />
      <Function ID="9" Name="Colour 1" Display="'Colour 1'" Dmx="72~79" Update="Dimmer, Red, Green" />
      <Function ID="10" Name="Colour 2" Display="'Colour 2'" Dmx="80~87" Update="Dimmer, Red, Green" />
      <Function ID="11" Name="Colour 3" Display="'Colour 3'" Dmx="88~95" Update="Dimmer, Red, Green" />
      <Function ID="12" Name="Colour 4" Display="'Colour 4'" Dmx="96~103" Update="Dimmer, Red, Green" />
      <Function ID="13" Name="Colour 5" Display="'Colour 5'" Dmx="104~111" Update="Dimmer, Red, Green" />
      <Function ID="14" Name="Colour 6" Display="'Colour 6'" Dmx="112~119" Update="Dimmer, Red, Green" />
      <Function ID="15" Name="Colour 7" Display="'Colour 7'" Dmx="120~127" Update="Dimmer, Red, Green" />
      <Function ID="16" Name="Colour 8" Display="'Colour 8'" Dmx="128~135" Update="Dimmer, Red, Green" />
      <Function ID="17" Name="CFADE" Display="'CFADE'" Dmx="136~143" Update="Dimmer, Red, Green" />
      <Function ID="18" Name="Meteor" Display="'Meteor'" Dmx="144~151" Update="Dimmer, Red, Green" />
      <Function ID="19" Name="Fade" Display="'Fade'" Dmx="152~159" Update="Dimmer, Red, Green" />
      <Function ID="20" Name="CHANGE" Display="'CHANGE'" Dmx="160~167" Update="Dimmer, Red, Green" />
      <Function ID="21" Name="Flow 1" Display="'Flow 1'" Dmx="168~175" Update="Dimmer, Red, Green" />
      <Function ID="22" Name="Flow 2" Display="'Flow 2'" Dmx="176~183" Update="Dimmer, Red, Green" />
      <Function ID="23" Name="Flow 3" Display="'Flow 3'" Dmx="184~191" Update="Dimmer, Red, Green" />
      <Function ID="24" Name="Flow 4" Display="'Flow 4'" Dmx="192~199" Update="Dimmer, Red, Green" />
      <Function ID="25" Name="Flow 5" Display="'Flow 5'" Dmx="200~207" Update="Dimmer, Red, Green" />
      <Function ID="26" Name="Flow 6" Display="'Flow 6'" Dmx="208~215" Update="Dimmer, Red, Green" />
      <Function ID="27" Name="Flow 7" Display="'Flow 7'" Dmx="216~223" Update="Dimmer, Red, Green" />
      <Function ID="28" Name="Flow 8" Display="'Flow 8'" Dmx="224~231" Update="Dimmer, Red, Green" />
      <Function ID="29" Name="Flow 9" Display="'Flow 9'" Dmx="232~239" Update="Dimmer, Red, Green" />
      <Function ID="30" Name="Sound" Display="'Sound'" Dmx="240~247" Update="Dimmer, Red, Green" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~34" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="35~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter3" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~4" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="35~255" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="5~24" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="UKBQBB11" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

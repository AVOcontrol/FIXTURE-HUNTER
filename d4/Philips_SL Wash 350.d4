      <Condition Name="Chase" ID="83,84,85,86,87,88,89,90,91,92,93" If="'Colour1Func'==3" />
      <Condition Name="User Chase" ID="94,95,96,97,98,99,100,101,102" If="'Colour1Func'==4" />
      <Else ID="103" />

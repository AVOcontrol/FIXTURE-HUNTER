<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Byte" ShortName="Byte" Company="LED Creative" Version="5">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="08-12-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Updated in line with latest charts (v1.4).  Revised wheel layout to manufacturer preference." Version="2" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Added 20 and 16 channel modes (not documented)." Version="3" />
  <History Date="21-03-19" Author="Nic Morris" Comment="Swapped Center In and Center Out FX Directions.  Revised FX Size and Speed power on values." Version="4" />
  <History Date="24-09-20" Author="Nic Morris" Comment="Added more FX, changed FX Offset to 16bit, removed Macros 1, removed 20 and 16 DMX modes and added v3 modes in line with latest charts in response to manufacturer request." Version="5" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mix" Display="'Mix'" Dmx="0~0" />
      <Function ID="2" Name="Layer 1 Priority" Display="'Layer 1 Priority'" Dmx="11~20" />
      <Function ID="3" Name="Layer 2 Priority" Display="'Layer 2 Priority'" Dmx="21~30" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="FX_Select" Name="FX Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Running Steps" Display="'Running Steps'" Dmx="1~1" />
      <Function ID="2" Name="Static Steps" Display="'Static Steps'" Dmx="6~6" />
      <Function ID="3" Name="Running Noise" Display="'Running Noise'" Dmx="11~11" />
      <Function ID="4" Name="Static Noise" Display="'Static Noise'" Dmx="16~16" />
      <Function ID="5" Name="Paparazzi" Display="'Paparazzi'" Dmx="21~21" />
      <Function ID="6" Name="Linear Noise" Display="'Linear Noise'" Dmx="26~26" />
      <Function ID="7" Name="Falling Pennies" Display="'Falling Pennies'" Dmx="31~31" />
      <Function ID="8" Name="Trailblazer" Display="'Trailblazer'" Dmx="36~36" />
      <Function ID="9" Name="Shooting Stars" Display="'Shooting Stars'" Dmx="41~41" />
      <Function ID="10" Name="Lit Fuse" Display="'Lit Fuse'" Dmx="46~46" />
      <Function ID="11" Name="Rainbow Steps" Display="'Rainbow Steps'" Dmx="51~51" />
      <Function ID="12" Name="Rainbow Static" Display="'Rainbow Static'" Dmx="56~56" />
      <Function ID="13" Name="Red/Blue Steps" Display="'Red/Blue Steps'" Dmx="61~61" />
      <Function ID="14" Name="Red/Green Steps" Display="'Red/Green Steps'" Dmx="67~67" />
      <Function ID="15" Name="Blue/Green Steps" Display="'Blue/Green Steps'" Dmx="72~72" />
      <Function ID="16" Name="Cyan/Magenta Steps" Display="'Cyan/Magenta Steps'" Dmx="77~77" />
      <Function ID="17" Name="Cyan/Yellow Steps" Display="'Cyan/Yellow Steps'" Dmx="82~82" />
      <Function ID="18" Name="Magenta/Yellow Steps" Display="'Magenta/Yellow Steps'" Dmx="87~87" />
      <Function ID="19" Name="Red/Magenta Steps" Display="'Red/Magenta Steps'" Dmx="92~92" />
      <Function ID="20" Name="Red/Cyan Steps" Display="'Red/Cyan Steps'" Dmx="97~97" />
      <Function ID="21" Name="Red/Yellow Steps" Display="'Red/Yellow Steps'" Dmx="102~102" />
      <Function ID="22" Name="Green/Magenta Steps" Display="'Green/Magenta Steps'" Dmx="107~107" />
      <Function ID="23" Name="Green/Cyan Steps" Display="'Green/Cyan Steps'" Dmx="112~112" />
      <Function ID="24" Name="Green/Yellow Steps" Display="'Green/Yellow Steps'" Dmx="117~117" />
      <Function ID="25" Name="Blue/Magenta Steps" Display="'Blue/Magenta Steps'" Dmx="122~122" />
      <Function ID="26" Name="Blue/Cyan Steps" Display="'Blue/Cyan Steps'" Dmx="127~127" />
      <Function ID="27" Name="Blue/Yellow Steps" Display="'Blue/Yellow Steps'" Dmx="132~132" />
      <Function ID="28" Name="White/Red Steps" Display="'White/Red Steps'" Dmx="137~137" />
      <Function ID="29" Name="White/Green Steps" Display="'White/Green Steps'" Dmx="142~142" />
      <Function ID="30" Name="White/Blue Steps" Display="'White/Blue Steps'" Dmx="147~147" />
      <Function ID="31" Name="White Amber Steps" Display="'White Amber Steps'" Dmx="152~152" />
      <Function ID="32" Name="White Headed Trailblazer" Display="'White Headed Trailblazer'" Dmx="162~162" />
      <Function ID="33" Name="Graphic EQ" Display="'Graphic EQ'" Dmx="167~167" />
      <Function ID="34" Name="Col Wipe Continuous" Display="'Col Wipe Continuous'" Dmx="172~172" />
      <Function ID="35" Name="Col Wipe Nshot Hold" Display="'Col Wipe Nshot Hold'" Dmx="173~173" />
      <Function ID="36" Name="Col Wipe Nshot Off" Display="'Col Wipe Nshot Off'" Dmx="175~175" />
      <Function ID="37" Name="No FX" Display="'No FX'" Dmx="178~178" />
      <Function ID="38" Name="Running Steps v1" Display="'Running Steps v1'" Dmx="200~200" />
    </Attribute>
    <Attribute ID="FX_Size" Name="FX Size" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:20" />
      <Function ID="1" Name="Size" Display="'%.f Pixels',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Copies" Name="FX Copies" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Copies" Display="'No Copies'" Dmx="0~0" />
      <Function ID="2" Name="Copies" Display="'%.f Copies',1~255" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Canvas_Size" Name="Canvas Size" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Ratio" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="FX_Speed" Name="FX Speed" Description="" Group="E">
      <Locate Locate="2:49" PowerOn="1" />
      <Function ID="1" Name="Static" Display="'Static'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="FX_Curve" Name="FX Curve" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Curve" Display="'No Curve'" Dmx="0~0" />
      <Function ID="2" Name="Sine Wave" Display="'Sine Wave'" Dmx="1~10" />
      <Function ID="3" Name="Smooth Fader" Display="'Smooth Fader'" Dmx="11~20" />
    </Attribute>
    <Attribute ID="FX_Direction" Name="FX Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Forward" Display="'Forward'" Dmx="0~0" />
      <Function ID="2" Name="Reverse" Display="'Reverse'" Dmx="11~20" />
      <Function ID="3" Name="Centre Out" Display="'Centre Out'" Dmx="21~30" />
      <Function ID="4" Name="Centre In" Display="'Centre In'" Dmx="31~40" />
    </Attribute>
    <Attribute ID="FX_Offset" Name="FX Offset" Description="" Group="E" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Macros_2" Name="Macros 2" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Macro" Display="'%.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>

      <Function ID="30" Name="Macro 29" Display="'Macro 29'" Dmx="247~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Z_Rot" Name="Patt Z Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="3~126" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~130" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~245" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_XY_Rot" Name="Patt XY Rot" Description="" Group="G">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Horiz" Display="'Horiz %.1f%%',100.0~0.0" Dmx="10~120" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Stop" Display="'Stop'" Dmx="121~134" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Vert" Display="'Vert %.1f%%',0.0~100.0" Dmx="135~245" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Stop" Display="'Stop'" Dmx="246~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'Zoom %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Horiz_Move" Name="Horiz Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Vert_Move" Name="Vert Move" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Beam_Rot" Name="Beam Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~128" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="129~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Beam_Shake" Name="Beam Shake" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~191" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="192~223" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="128~143" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="144~159" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="4" Name="Reset" Display="'Reset'" Dmx="80~89" />
    </Attribute>
  </Control>
  <Mode Name="21 DMX" Channels="21">
    <Import PearlRef="UKDBDRG1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Mirror" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="19" Wheel="1" />

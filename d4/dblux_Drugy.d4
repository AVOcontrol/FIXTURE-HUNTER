      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Pan_Shake" ChannelOffset="3" Wheel="20" />
      <Attribute ID="Tilt_Shake" ChannelOffset="4" Wheel="21" />
      <Attribute ID="Colour1Func" Wheel="7" />

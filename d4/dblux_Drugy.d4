  <Mode Name="17 DMX" Channels="17">
    <Import PearlRef="UKDBDRG2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />

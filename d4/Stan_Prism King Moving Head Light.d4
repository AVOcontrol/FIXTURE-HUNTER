      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="185~131" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="126~130" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="125~75" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />

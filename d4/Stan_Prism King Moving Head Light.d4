      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="55~59" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="60~64" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="65~69" WheelPosition="13" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="70~74" WheelPosition="14" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="186~190" WheelPosition="1" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="191~195" WheelPosition="2" />
      <Function ID="19" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="196~200" WheelPosition="3" />

      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1" />
      <Palette ID="5" Name="Light Green" Number="0" Page="1" SetControl="Colour2:5,Colour1:1,Colour1Func:1" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:5,Colour1Func:1,Colour2:1" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour2:7,Colour1:1,Colour1Func:1" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Colour2:8,Colour1:1,Colour1Func:1" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:9,Colour1Func:1,Colour2:1" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:4,Colour1Func:1,Colour2:1" />
      <Palette ID="13" Name="Light Red" Number="0" Page="1" SetControl="Colour2:2,Colour1:1,Colour1Func:1" />
      <Palette ID="14" Name="Light Magenta" Number="8" Page="1" SetControl="Colour2:4,Colour1:1,Colour1Func:1" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7,Colour1Func:1,Colour2:1" />
    </Group>
    <Group Name="Gobo">
      <Palette ID="1" Name="Open" Number="11" Page="1" SetControl="Gobo1:1,Gobo1Func:1,Gobo2:1" />

    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" Highlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" />
      <Function ID="2" Name="Closed" Display="'Closed'" Dmx="6~10" />
      <Function ID="3" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="32~56" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="55~79" />
      <Function ID="5" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="80~102" />
      <Function ID="6" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="103~127" />
      <Function ID="7" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="128~250" />
      <Function ID="8" Name="Strobe Hz" Display="'Strobe %.f Hz',0~50" Dmx="251~255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="11~33" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="6~11" Colour="180,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="12~17" Colour="0,0,255" />
      <Function ID="4" Name="Deep Green" Display="'Deep Green'" Dmx="18~23" Colour="0,180,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="24~29" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="30~35" Colour="128,0,255" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="36~41" Colour="255,128,0" />
      <Function ID="8" Name="CTO" Display="'CTO'" Dmx="42~47" Colour="255,240,200" />
      <Function ID="9" Name="Dark Blue" Display="'Deep Blue'" Dmx="48~53" Colour="0,0,180" />
      <Function ID="10" Name="Index" Display="'Index %.f%%',0~100" Dmx="54~192" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="193~223" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="224~224" Colour="255,255,255" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="225~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />

      <Function ID="12" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="156~170" WheelPosition="5" />
      <Function ID="13" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="171~185" WheelPosition="6" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="186~192" WheelPosition="0" />
      <Function ID="15" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="193~223" />
      <Function ID="16" Name="No Spin" Display="'No Spin'" Dmx="224~224" />
      <Function ID="17" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="225~255" />

    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:4000" PowerOn="1:4000" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',4000~10000" Dmx="0~255" Colour="255,240,200" />

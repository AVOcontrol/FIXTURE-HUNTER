    <Attribute ID="Test_Pattern" Name="Test Pattern" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dynamic" Display="'Dynamic'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Rainbow" Display="'Rainbow'" Dmx="10~19" Colour="0,0,0" />

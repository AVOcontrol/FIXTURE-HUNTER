      <Function ID="16" Name="Org/ Aq" Display="'Org/ Aq'" Dmx="25~25" WheelPosition="2" Colour="255,128,0" />
      <Function ID="17" Name="Aq/ Grn" Display="'Aq/ Grn'" Dmx="35~35" WheelPosition="3" Colour="0,255,200" />

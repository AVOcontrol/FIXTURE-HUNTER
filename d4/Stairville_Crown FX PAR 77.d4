  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f18ae928-a98e-4fde-a4d0-d9af27bc2924" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~250" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="White_LEDs" Name="White LEDs" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="6~20" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="21~250" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="6~19" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="20~34" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="35~48" />
      <Function ID="5" Name="Program 4" Display="'Program 4'" Dmx="49~63" />
      <Function ID="6" Name="Program 5" Display="'Program 5'" Dmx="64~77" />
      <Function ID="7" Name="Program 6" Display="'Program 6'" Dmx="78~92" />
      <Function ID="8" Name="Program 7" Display="'Program 7'" Dmx="93~106" />
      <Function ID="9" Name="Program 8" Display="'Program 8'" Dmx="107~121" />
      <Function ID="10" Name="Program 9" Display="'Program 9'" Dmx="122~135" />
      <Function ID="11" Name="Program 10" Display="'Program 10'" Dmx="136~150" />
      <Function ID="12" Name="Program 11" Display="'Program 11'" Dmx="151~164" />
      <Function ID="13" Name="Program 12" Display="'Program 12'" Dmx="165~179" />
      <Function ID="14" Name="Program 13" Display="'Program 13'" Dmx="180~193" />
      <Function ID="15" Name="Program 14" Display="'Program 14'" Dmx="194~208" />
      <Function ID="16" Name="Program 15" Display="'Program 15'" Dmx="209~222" />
      <Function ID="17" Name="Program 16" Display="'Program 16'" Dmx="223~237" />
      <Function ID="18" Name="Program 17" Display="'Program 17'" Dmx="238~255" />
    </Attribute>
    <Attribute ID="Program_Spd" Name="Program Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~250" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="4 DMX" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="248~255" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="191~200" />
    </Attribute>
  </Control>

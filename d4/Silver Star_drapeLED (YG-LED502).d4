<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="drapeLED (YG-LED502)" ShortName="drapeLED" Company="Silver Star">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <History Date="13-09-07" Author="D.Milligan" Comment="Created" />
  <History Date="13-09-07" Author="D.Milligan" Comment="Checked" />
  <History Date="27-05-08" Author="Gregory Haynes" Comment="Added 10 channel mode (12 channel mode no longer in specification) - changed PearlRefs" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-11-18" Author="Nic Morris" Comment="Changed name from YG-LED502 drapeLED to drapeLED (YG-LED502).  Changed display name from YG-LED502 to drapeLED" />
  <History Date="05-11-18" Author="Nic Morris" Comment="Added pixel mapper compatibility.  Added palettes.  Fixed program function DMX range conflict (made best guess)" />
  <History Date="05-11-18" Author="Nic Morris" Comment="Removed clear values.  Added virtual dimmer." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Mode 1" Display="'Mode 1'" Dmx="0~0" />

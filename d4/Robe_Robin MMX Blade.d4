<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin MMX Blade" ShortName="MMX  Blade" Company="Robe" Version="17">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <History Date="30-03-11" Author="John Rogers" Comment="Created" Version="1" />
  <History Date="08-06-11" Author="John Rogers" Comment="Added changes/updates from Robe." Version="2" />
  <History Date="19-07-11" Author="John Rogers" Comment="Inverted Hot Spot range in response to Robe." Version="3" />
  <History Date="08-08-11" Author="John Rogers" Comment="Spotted error in Autofocus DMX values. Corrected." Version="4" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Inverted speed controls for wheel direction." Version="5" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Renamed Colour Split Gel to Index.  Simplified index.  Added function index." Version="6" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Adjusted Effect index range to match dmx values.  Fixed Gobo2Func update." Version="7" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Fixed 16bit raw ranges.  Added missing raw function to autofocus." Version="8" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Chnaged all autofocus functions to proportional in response to manufacturer bug report." Version="9" />
  <History Date="21-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added missing macros.  Shortened function names for Expert LCD." Version="10" />
  <History Date="16-02-12" Author="Peter Budd" Comment="Edited added colours to macros" Version="11" />
  <History Date="27-03-13" Author="Peter Budd" Comment="Created from the Robe Robin MMX Spot" Version="12" />
  <History Date="06-08-13" Author="Peter Budd" Comment="Corrected macros and checked against manual." Version="13" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="14" />
  <History Date="10-01-17" Author="Nic Morris" Comment="Fixed control safe range (was value 30-49 instead of 20-39).  Increased colour wheel resolution for 16bit." Version="15" />
  <History Date="10-01-17" Author="Nic Morris" Comment="Standardised conditionals." Version="16" />
  <History Date="22-11-23" Author="Nic Morris" Comment="Added RDM ID's" Version="17" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="15R-Beam Platinum" ShortName="15R-Beam" Company="Triton Blue">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="12-07-13" Author="Peter Budd" Comment="Created" />
  <History Date="04-04-16" Author="Nic Morris" Comment="Removed colour index functions at manufacturer request and changed prism to locate at zero in attempt to fix bug report." />
  <History Date="14-04-16" Author="Nic Morris" Comment="Added missing Raw DMX option from Gobo 1 Func in response to manufacturer bug report." />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Increased 16bit wheel resolution.  Fixed 16bit raw display range." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Standardised Gobo 1 conditionals.  Renamed gobo index functions to show their transition more accurately." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Standardised shutter." />
  <History Date="29-06-17" Author="Nic Morris" Comment="Created from Terbly PT320B (identical)" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="83e70fd1-9718-4354-9a4d-9384f37c4466" />
  <Control>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="3855~7453" Colour="0,0,0" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="7710~11308" Colour="0,0,0" />

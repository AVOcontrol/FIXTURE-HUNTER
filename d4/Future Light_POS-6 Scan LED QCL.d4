  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="21-08-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="24-03-14" Author="Nic Morris" Comment="Inverted speed channel ranges in response to customer bug report (confirmed with fixture manual)" />
  <History Date="28-07-16" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="49d57e6b-7ad9-49ca-93cd-80ac074cff5f" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Music" Display="'Music'" Dmx="1~5" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="6~10" Intensity="0~0" />
      <Function ID="4" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red/Green" Display="'Red/Green'" Dmx="11~30" Colour="255,0,0" />
      <Function ID="3" Name="Green/Red" Display="'Green/Red'" Dmx="31~50" Colour="255,255,0" />
      <Function ID="4" Name="Green/Blue" Display="'Green/Blue'" Dmx="51~70" Colour="0,255,0" />
      <Function ID="5" Name="Blue/Green" Display="'Blue/Green'" Dmx="71~90" Colour="0,255,255" />
      <Function ID="6" Name="Blue/Red" Display="'Blue/Red'" Dmx="91~110" Colour="0,0,255" />
      <Function ID="7" Name="Red/Blue" Display="'Red/Blue'" Dmx="111~130" Colour="255,0,255" />
      <Function ID="8" Name="Red/Grn/Bl" Display="'Red/Grn/Bl'" Dmx="131~150" Colour="255,0,0" />
      <Function ID="9" Name="Blue/Grn/Rd" Display="'Blue/Grn/Rd'" Dmx="151~170" Colour="255,255,255" />
      <Function ID="10" Name="Full" Display="'Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="11" Name="White 1" Display="'White 1'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="12" Name="White 2" Display="'White 2'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="13" Name="White 3" Display="'White 3'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="14" Name="White 4" Display="'White 4'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="15" Name="White 5" Display="'White 5'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="16" Name="White 6" Display="'White 6'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="17" Name="White 7" Display="'White 7'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="18" Name="White 8" Display="'White 8'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="19" Name="White 9" Display="'White 9'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="20" Name="White 10" Display="'White 10'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="21" Name="White 11" Display="'White 11'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1'" Dmx="11~30" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="31~50" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3'" Dmx="51~70" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4'" Dmx="71~90" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="91~110" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="111~130" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="131~150" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8'" Dmx="151~170" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9'" Dmx="171~190" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10'" Dmx="191~210" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11'" Dmx="211~230" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12'" Dmx="231~250" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="DimSpeed" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Neutral" Display="'Neutral'" Dmx="52~101" />
      <Function ID="3" Name="Speed 1" Display="'Speed 1'" Dmx="102~152" />
      <Function ID="4" Name="Speed 2" Display="'Speed 2'" Dmx="153~203" />
      <Function ID="5" Name="Speed 3" Display="'Speed 3'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

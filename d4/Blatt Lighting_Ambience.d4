  <Mode Name="Aura cell" Channels="6" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="8 kg" />
      <Size Height="380 mm" Width="210 mm" Depth="320 mm" />
      <Focus Type="Head" PanMax="540" TiltMax="232" PanMaxSpeed="225" TiltMaxSpeed="300" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="1" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="Extended, 25 DMX" Channels="25">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="8 kg" />
      <Size Height="380 mm" Width="210 mm" Depth="320 mm" />
      <Focus Type="Head" PanMax="540" TiltMax="232" PanMaxSpeed="225" TiltMaxSpeed="300" />
    </Physical>
    <AtlaBase ModeID="05e0ac02-2b3e-4657-b08b-31e5758e3b07" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour1Func" Wheel="7" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Colour1" Wheel="8" />
        <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
        <Attribute ID="Pan" ChannelOffset="4,5" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="6,7" Wheel="3" />
        <Attribute ID="Control" ChannelOffset="8" Wheel="28" />
        <Attribute ID="CTO" ChannelOffset="14" Wheel="9" />
        <Attribute ID="Effect_1" ChannelOffset="15" Wheel="22" />
        <Attribute ID="Effect_1_Speed" ChannelOffset="16" Wheel="23" />
        <Attribute ID="Effect_2" ChannelOffset="17" Wheel="24" />
        <Attribute ID="Effect_2_Speed" ChannelOffset="18" Wheel="52" />
        <Attribute ID="Effect_Switch" ChannelOffset="19" Wheel="53" />
      </Master>
      <Cell ID="Cell1" Name="Beam" ChannelOffset="1" ModeLink="Beam Cell, 15  DMX" X="0" Y="0">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Colour1Func" TargetId="Colour1Func" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
      </Cell>
      <Cell ID="Cell2" Name="Aura" ChannelOffset="20" ModeLink="Aura cell" X="0" Y="1">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Colour1Func" TargetId="Colour1Func" />
        <AttributeLink SourceId="Colour1" TargetId="Colour1" />
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />

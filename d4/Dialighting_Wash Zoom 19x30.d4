      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="91~105" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="106~120" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="121~135" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="136~150" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="151~165" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="166~180" />
      <Function ID="13" Name="Effect 12" Display="'Effect 12'" Dmx="181~195" />
      <Function ID="14" Name="Effect 13" Display="'Effect 13'" Dmx="196~210" />
      <Function ID="15" Name="Effect 14" Display="'Effect 14'" Dmx="211~225" />

      <Function ID="15" Name="Rainbow 2" Display="'Rainbow 2'" Dmx="167~202" Colour="255,255,255" />
      <Function ID="16" Name="Rainbow 3" Display="'Rainbow 3'" Dmx="203~239" Colour="255,255,255" />
      <Function ID="17" Name="Rnd Rainbow" Display="'Rnd Rainbow'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="16~30" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="31~45" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="46~60" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="61~75" />

      <Function ID="5" Name="G+B" Display="'G+B'" Dmx="40~49" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Colour="0,0,255" />
      <Function ID="7" Name="B+W" Display="'B+W'" Dmx="60~69" Colour="0,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Colour="255,255,255" />
      <Function ID="9" Name="R+W" Display="'R+W'" Dmx="80~89" Colour="255,0,0" />

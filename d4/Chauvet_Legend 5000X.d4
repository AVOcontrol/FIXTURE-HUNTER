  <Mode Name="14 DMX" Channels="14">
    <Import PearlRef="CH_Leg5kM2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />

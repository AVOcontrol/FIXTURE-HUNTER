  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="27281f6b-a10d-4680-bb61-17b18a8c69c9" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17,18,19" If="'Colour1Func'==3" />
      <Else ID="20" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="15~22" WheelPosition="1" Colour="255,255,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="30~37" WheelPosition="2" Colour="255,150,150" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="45~52" WheelPosition="3" Colour="255,0,255" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="60~67" WheelPosition="4" Colour="0,0,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="75~82" WheelPosition="5" Colour="0,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="90~97" WheelPosition="6" Colour="255,128,0" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="105~112" WheelPosition="7" Colour="255,0,0" />
      <Function ID="9" Name="Op/ Yel" Display="'Op/ Yel'" Dmx="8~14" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Yel/ Pk" Display="'Yel/ Pk'" Dmx="23~29" WheelPosition="1" Colour="255,255,0" />
      <Function ID="11" Name="Pk/ Mag" Display="'Pk/ Mag'" Dmx="38~44" WheelPosition="2" Colour="255,150,150" />
      <Function ID="12" Name="Mag/ Blu" Display="'Mag/ Blu'" Dmx="53~59" WheelPosition="3" Colour="255,0,255" />
      <Function ID="13" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="68~74" WheelPosition="4" Colour="0,0,255" />
      <Function ID="14" Name="Grn/ Org" Display="'Grn/ Org'" Dmx="83~89" WheelPosition="5" Colour="0,255,0" />
      <Function ID="15" Name="Org/ Rd" Display="'Org/ Rd'" Dmx="98~104" WheelPosition="6" Colour="255,128,0" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="179~189" Colour="255,255,255" />
      <Function ID="17" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="113~178" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="179~189" Colour="255,255,255" />
      <Function ID="19" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="190~255" Colour="0,0,0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func1" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour11" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour11" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="2" Lowlight="5" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func1'==1" />
      <Condition Name="Scroll" ID="9,10,11,12" If="'Colour1Func1'==2" />
      <Else ID="13" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Yellow" Display="'Yellow'" Dmx="15~29" Colour="255,255,0" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="30~42" Colour="255,150,150" />
      <Function ID="4" Name="Magenta" Display="'Magenta'" Dmx="43~56" Colour="255,0,255" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="57~70" Colour="0,0,255" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="71~84" Colour="0,255,0" />
      <Function ID="7" Name="Orange" Display="'Orange'" Dmx="85~98" Colour="255,128,0" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="99~112" Colour="255,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="179~189" Colour="255,255,255" />

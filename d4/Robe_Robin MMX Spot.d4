<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin MMX Spot" ShortName="MMX Spot" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>2b89710b-42bf-4019-b937-1798d900971e</Thumbnail>
  <History Date="30-03-11" Author="John Rogers" Comment="Created" />
  <History Date="08-06-11" Author="John Rogers" Comment="Added changes/updates from Robe." />
  <History Date="19-07-11" Author="John Rogers" Comment="Inverted Hot Spot range in response to Robe." />
  <History Date="08-08-11" Author="John Rogers" Comment="Spotted error in Autofocus DMX values. Corrected." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Increased wheel resolution.  Inverted speed controls for wheel direction." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Renamed Colour Split Gel to Index.  Simplified index.  Added function index." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Adjusted Effect index range to match dmx values.  Fixed Gobo2Func update." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Fixed 16bit raw ranges.  Added missing raw function to autofocus." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Chnaged all autofocus functions to proportional in response to manufacturer bug report." />
  <History Date="21-09-11" Author="Nic Morris" Comment="Fixed power on and locate.  Added missing macros.  Shortened function names for Expert LCD." />
  <History Date="16-02-12" Author="Peter Budd" Comment="Edited added colours to macros" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="03-09-13" Author="Matt Benson" Comment="Edited max and min P/T values" />
  <History Date="08-11-14" Author="Nic Morris" Comment="Changed P/T Speed functions to match documentation." />
  <History Date="08-11-14" Author="Nic Morris" Comment="Updated control functions to latest spec and recreated all macros." />
  <History Date="08-11-14" Author="Nic Morris" Comment="Updated fixed colours in response to manufacturer bug report." />
  <History Date="08-11-14" Author="Nic Morris" Comment="Updated effect index functions.  Inverted iris range and adjusted iris function order." />
  <History Date="08-11-14" Author="Nic Morris" Comment="Added mode 4" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="09-01-17" Author="Nic Morris" Comment="Standardised conditionals.  Added Atlabase ID to mode 4." />
  <History Date="08-11-17" Author="Nic Morris" Comment="Inverted zoom." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Added product thumbnail and gobo swatches." />
  <History Date="17-12-17" Author="Nic Morris" Comment="Simplified frost and iris." />
  <History Date="18-01-18" Author="Nic Morris" Comment="Corrected gobo swatches (wheels were swapped)." />
  <Manual Filename="" Summary="" />

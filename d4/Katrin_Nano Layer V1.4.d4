  <History Date="31-05-12" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Folder" Display="'Folder %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="File" Name="File" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="File" Display="'File %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Play Speed" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PlayMode" Name="Play Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Visible Fwd Loop" Display="'Visible Fwd Loop'" Dmx="0~0" />
      <Function ID="2" Name="Visible Fwd Stop" Display="'Visible Fwd Stop'" Dmx="1~1" />
      <Function ID="3" Name="Visible Fwd Pause" Display="'Visible Fwd Pause'" Dmx="2~2" />
      <Function ID="4" Name="Visible Fwd" Display="'Visible Fwd'" Dmx="3~3" />
      <Function ID="5" Name="Visible Fwd Stop In/Out" Display="'Visible Fwd Stop In/Out'" Dmx="4~4" />
      <Function ID="6" Name="Visible Fwd Pause In/Out" Display="'Visible Fwd Pause In/Out'" Dmx="5~5" />
      <Function ID="7" Name="Fwd Loop" Display="'Fwd Loop'" Dmx="6~6" />
      <Function ID="8" Name="Fwd Stop" Display="'Fwd Stop'" Dmx="7~7" />
      <Function ID="9" Name="Fwd Pause" Display="'Fwd Pause'" Dmx="8~8" />
      <Function ID="10" Name="Fwd In/Out" Display="'Fwd In/Out'" Dmx="9~9" />
      <Function ID="11" Name="Fwd Stop" Display="'Fwd Stop'" Dmx="10~10" />
      <Function ID="12" Name="Fwd Pause" Display="'Fwd Pause'" Dmx="11~11" />
      <Function ID="13" Name="Start Frame" Display="'Start Frame'" Dmx="12~12" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',13~255" Dmx="13~255" />
    </Attribute>
    <Attribute ID="CopyMode" Name="Copy Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Nromal" Display="'Nromal'" Dmx="0~0" />
      <Function ID="2" Name="Add" Display="'Add'" Dmx="1~1" />
      <Function ID="3" Name="Substract" Display="'Substract'" Dmx="2~2" />
      <Function ID="4" Name="Screen" Display="'Screen'" Dmx="3~3" />
      <Function ID="5" Name="Modulate" Display="'Modulate'" Dmx="4~4" />
      <Function ID="6" Name="If lighter" Display="'If lighter'" Dmx="5~5" />
      <Function ID="7" Name="If darker" Display="'If darker'" Dmx="6~6" />
      <Function ID="8" Name="Transparent white" Display="'Transparent white'" Dmx="7~7" />
      <Function ID="9" Name="Transparent black" Display="'Transparent black'" Dmx="8~8" />
      <Function ID="10" Name="Lighten" Display="'Lighten'" Dmx="9~9" />
      <Function ID="11" Name="Darken" Display="'Darken'" Dmx="10~10" />
    </Attribute>
    <Attribute ID="MaskType" Name="Mask Type" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Ellipse" Display="'Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Circle" Display="'Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Rectangle" Display="'Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Square" Display="'Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Vertical" Display="'Vertical'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="7" Name="Horizontal" Display="'Horizontal'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Transparent Ellipse" Display="'Transparent Ellipse'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Transparent Circle" Display="'Transparent Circle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Transparent Rectangle" Display="'Transparent Rectangle'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Transparent Square" Display="'Transparent Square'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Transparent Y" Display="'Transparent Y'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Transparent X" Display="'Transparent X'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Mask_Zoom" Name="Mask Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Mask_Focus" Name="Mask Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Screen3D" Name="Screen Obj 3D" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Screen" Display="'Full Screen'" Dmx="0~0" />
      <Function ID="2" Name="16:9 Correction" Display="'16:9 Correction'" Dmx="1~1" />
      <Function ID="3" Name="4:3 Correction" Display="'4:3 Correction'" Dmx="2~2" />
      <Function ID="4" Name="No Macro" Display="'No Macro'" Dmx="3~3" />
      <Function ID="5" Name="Disk" Display="'Disk'" Dmx="4~4" />
      <Function ID="6" Name="Half Cylinder 1" Display="'Half Cylinder 1'" Dmx="5~5" />
      <Function ID="7" Name="Half Cylinder 2" Display="'Half Cylinder 2'" Dmx="6~6" />
      <Function ID="8" Name="Quarter 1" Display="'Quarter 1'" Dmx="7~7" />
      <Function ID="9" Name="Quater 2" Display="'Quater 2'" Dmx="8~8" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',9~255" Dmx="9~255" />
    </Attribute>
  </Control>
  <Mode Name="10 DMX, 8bit" Channels="10">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>

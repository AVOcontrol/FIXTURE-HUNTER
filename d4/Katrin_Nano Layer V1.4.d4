    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Folder" ChannelOffset="2" Wheel="13" />
      <Attribute ID="File" ChannelOffset="3" Wheel="14" />
      <Attribute ID="MaskType" ChannelOffset="7" Wheel="16" />
      <Attribute ID="Mask_Zoom" ChannelOffset="8" Wheel="17" />
      <Attribute ID="Mask_Focus" ChannelOffset="9" Wheel="18" />
      <Attribute ID="Speed" ChannelOffset="4" Wheel="25" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="D6" ShortName="D6" Company="Acco">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>21dfd513-c36a-472f-bb4e-28447d6f33de</Thumbnail>
  <History Date="21-09-10" Author="John Rogers" Comment="Created from Robe_Robin 600E Wash.d4" />
  <History Date="09-11-10" Author="John Rogers" Comment="Tested against fixture." />
  <History Date="07-01-11" Author="John Rogers" Comment="Added Physical Movement info." />
  <History Date="12-01-11" Author="John Rogers" Comment="Added Robe updates including new modes." />
  <History Date="31-03-11" Author="John Rogers" Comment="Updated Macros." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Removed PT Speed update from Control.  Removed shutter update from colour." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Increased wheel resolution.  Shortened names for Expert LCD.  Reordered shutter." />
  <History Date="19-10-11" Author="Nic Morris" Comment="Added missing macros.  Added pixel mapper compatibility." />
  <History Date="07-11-11" Author="John Rogers" Comment="Removed Virtual Dimmer from Cells." />
  <History Date="07-12-11" Author="John Rogers" Comment="Edited Colour Macro Zone Effects to Value range." />
  <History Date="10-07-12" Author="Peter Budd" Comment="Created from Robe Robin 600 LED Wash" />
  <History Date="17-09-12" Author="Peter Budd" Comment="Corrected number of DMX channels in mode 2 mode name." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="05-02-15" Author="Nic Morris" Comment="Changed manufacturer from 'Acco Light' to 'Acco'.  Changed name and shortname from 'Acco D6' to 'D6'" />
  <History Date="30-11-19" Author="Nic Morris" Comment="Revised wheel mapping for compatibility.  Added vdim to cells.  Added product thumbnail." />
  <History Date="30-11-19" Author="Nic Morris" Comment="Note it seems very unlikely there is a mixture of 8 and 16bit cells- this is probably wrong.  Also note channel count didn't match mode 1 name (37 DMX) but increasing cell 2 to 16bit still wouldn't explain." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">

  <Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:8,Shutter:1" Delay="5000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset Zoom">
      <Set Channel="Control:9,Shutter:1" Delay="5000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:10,Shutter:1" Delay="5000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="P/T Speed Mode">
      <Set Channel="Control:2,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="P/T Time Mode">
      <Set Channel="Control:3,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark On">
      <Set Channel="Control:4,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark Off">
      <Set Channel="Control:5,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Theatre Mode On">
      <Set Channel="Control:6,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Theatre Mode Off">
      <Set Channel="Control:7,Shutter:1" Delay="6000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
  </Macro>

  <Thumbnail>aaf6b1fd-bf46-432c-96df-626da48da387</Thumbnail>
  <History Date="15-01-18" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="17-01-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="25-10-25" Author="Nic Morris" Comment="Added alternative 'V2' mapping in line with latest documentation." Version="3" />
  <History Date="29-10-25" Author="Nic Morris" Comment="Added Atlabase ID for V2 mode mapping" Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="13e262ac-6ae3-4763-83ae-c081ac8cb765" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Auto'&gt;1" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="51~100" Update="Shutter" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="101~150" Update="Shutter" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="151~200" Update="Shutter" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="51~100" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="101~150" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="151~200" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="7 DMX" Channels="7" Id="e03f9511-0ca3-405f-93c9-da4c9fc11fac">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="77aa8a2b-6e64-4c5d-b9e0-3a1b20ac4fd6" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
        <Attribute ID="Auto" ChannelOffset="7" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="2" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="3" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="4" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="5" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />

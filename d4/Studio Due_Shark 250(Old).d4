    </Include>
  </Mode>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="SDSK25O2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="460" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d919a3f3-8463-420a-9b12-86e3825929d5" />
    <Include>
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Gobo1Rot" ChannelOffset="1" Wheel="15" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Gobo1" ChannelOffset="3" Wheel="14" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="5,6" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="7,8" Wheel="3" />
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="PT_Speed" ChannelOffset="10" Wheel="25" />

      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="120~129" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="130~139" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="140~149" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="150~159" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="160~169" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="170~179" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="180~199" />

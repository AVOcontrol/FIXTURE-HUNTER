      <Function ID="6" Name="Macro 5" Display="'Macro 5'" Dmx="140~169" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6'" Dmx="170~199" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7'" Dmx="200~229" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="230~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />

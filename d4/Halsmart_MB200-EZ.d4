      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="64~71" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 9" Display="'Gobo 9'" Dmx="72~79" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="80~87" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="88~95" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="96~103" WheelPosition="12" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="104~111" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="112~119" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="120~126" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="127~133" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="134~140" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="141~147" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="21" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="148~154" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="22" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="155~161" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="23" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="162~168" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="24" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="169~175" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="25" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="176~182" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="26" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="183~189" WheelPosition="10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="27" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="190~196" WheelPosition="11" GoboSpin="0~0" GoboOrientation="0~0" />

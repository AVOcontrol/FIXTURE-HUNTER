      <Attribute ID="Prism" ChannelOffset="7" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="13" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 11 DMX" Channels="11">
    <Import PearlRef="UK_HAM2EZ11" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Shutter" ChannelOffset="7" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="8" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="2" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="3" Wheel="8" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Gobo1" ChannelOffset="4" Wheel="14" />
      <Attribute ID="Gobo1Func" Wheel="13" />
      <Attribute ID="Focus" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Frost" ChannelOffset="9" Wheel="20" />
      <Attribute ID="Prism" ChannelOffset="5" Wheel="23" />
      <Attribute ID="PT_Speed" ChannelOffset="10" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:4" Delay="8500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:5" Delay="8500" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Colour">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Shutter">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Other">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

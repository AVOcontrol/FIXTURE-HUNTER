      <Function ID="30" Name="Gobo 14 Shake" Display="'Gobo 14 Shake %.f%%',0~100" Dmx="211~217" WheelPosition="13" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="31" Name="Open" Display="'Open'" Dmx="0~7" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="32" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="218~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~3" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="4~63" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="64~67" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="68~127" />
      <Function ID="5" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~175" />
      <Function ID="6" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="176~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~65535" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="7" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Frost" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~225" />
      <Function ID="2" Name="Safe" Display="'Safe'" Dmx="226~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~19" />
      <Function ID="2" Name="Colour Index" Display="'Colour Index'" Dmx="20~29" />
      <Function ID="3" Name="Colour + Gobo index" Display="'Colour + Gobo index'" Dmx="30~39" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="40~59" />
      <Function ID="5" Name="Lamp Off" Display="'Lamp Off'" Dmx="60~79" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="80~84" />
      <Function ID="7" Name="Reset P/T" Display="'Reset P/T'" Dmx="85~87" />

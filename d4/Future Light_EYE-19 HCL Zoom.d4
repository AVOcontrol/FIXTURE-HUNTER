  <History Date="10-02-20" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="12-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="27-02-20" Author="Nic Morris" Comment="Created from Futurelight EYE-7 HCL Zoom" Version="3" />
  <History Date="29-02-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="4" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="93708402-c423-4973-9f4d-bba4e9325909" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="P/T_Func" Name="P/T Func" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="16~31" />
    </Attribute>
    <Attribute ID="Shutter_Func" Name="Shutter Func" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="16~31" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="32~47" />
      <Function ID="4" Name="Random" Display="'Random'" Dmx="48~63" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="32~223" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Update="Colour1" Colour="255,255,255" />
      <Function ID="2" Name="CTC" Display="'CTC'" Dmx="16~31" Update="Colour1" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="32~47" Update="Colour1" Colour="255,255,255" />
      <Function ID="4" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="48~63" Update="Colour1" Colour="255,255,255" />
      <Function ID="5" Name="Linear" Display="'Linear'" Dmx="64~79" Update="Colour1" Colour="255,255,255" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="80~95" Update="Colour1" Colour="255,255,255" />
      <Function ID="7" Name="Col Wheel" Display="'Col Wheel'" Dmx="96~111" Update="Colour1" Colour="255,255,255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Colour1Func'==1" />
      <Condition Name="CTC" ID="2,3,4,5,6" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="7" If="'Colour1Func'==3||'Colour1Func'==4" />
      <Condition Name="Linear/Bounce" ID="8,9,10,11,12,13,14,15,16" If="'Colour1Func'==5||'Colour1Func'==6" />
      <Condition Name="Col Wheel" ID="17,18,19,20,21,22,23,24" If="'Colour1Func'==7" />
      <Else ID="25" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2000-2700K" Display="'%.fK',2000~2700" Dmx="0~84" Colour="255,255,255" />
      <Function ID="3" Name="2700-3200K" Display="'%.fK',2700~3200" Dmx="85~127" Colour="255,255,255" />
      <Function ID="4" Name="3200-4200K" Display="'%.fK',3200~4200" Dmx="128~170" Colour="255,255,255" />
      <Function ID="5" Name="4200-5600K" Display="'%.fK',4200~5600" Dmx="171~213" Colour="255,255,255" />
      <Function ID="6" Name="5600-8000K" Display="'%.fK',5600~8000" Dmx="214~255" Colour="255,255,255" />
      <Function ID="7" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="8" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="9" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="11" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="12" Name="Lime" Display="'Lime'" Dmx="4~4" Colour="0,180,0" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="5~5" Colour="255,100,0" />
      <Function ID="14" Name="Cyan" Display="'Cyan'" Dmx="6~6" Colour="0,255,255" />
      <Function ID="15" Name="All" Display="'All'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="16" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~255" Colour="0,0,0" />
      <Function ID="17" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="18" Name="Blue" Display="'Blue'" Dmx="32~63" Colour="0,0,255" />
      <Function ID="19" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="20" Name="Yellow" Display="'Yellow'" Dmx="96~127" Colour="255,255,0" />
      <Function ID="21" Name="Pink" Display="'Pink'" Dmx="128~159" Colour="255,150,150" />
      <Function ID="22" Name="Light Blue" Display="'Light Blue'" Dmx="160~191" Colour="0,128,255" />
      <Function ID="23" Name="Magenta" Display="'Magenta'" Dmx="192~223" Colour="255,0,255" />
      <Function ID="24" Name="Dark Blue" Display="'Dark Blue'" Dmx="224~255" Colour="0,0,180" />
      <Function ID="25" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="1~1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="2~2" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="3~3" Colour="0,0,255" />
      <Function ID="5" Name="Lime" Display="'Lime'" Dmx="4~4" Colour="0,180,0" />
      <Function ID="6" Name="Amber" Display="'Amber'" Dmx="5~5" Colour="255,100,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="6~6" Colour="0,255,255" />
      <Function ID="8" Name="All" Display="'All'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="8~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

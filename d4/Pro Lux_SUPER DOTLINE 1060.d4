  <History Date="26-03-23" Author="Nic Morris" Comment="Changed name from Super Dotline (TB 1060) to Super Dotline (China) (TB 1060 CN) to differentiate from international version in response to manufacturer request." Version="2" />
  <History Date="08-08-23" Author="Nic Morris" Comment="Added 170 channel mode in line with latest documentation in response to manufacturer request." Version="3" />
  <History Date="16-08-23" Author="Nic Morris" Comment="Added Atlabase ID for 170 channel mode." Version="4" />
  <History Date="06-11-24" Author="Nic Morris" Comment="Created from ACME Super Dotline (China) (TB 1060 CN) (effectively identical)" Version="5" />
  <History Date="08-11-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="6" />

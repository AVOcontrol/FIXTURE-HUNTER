      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="32~39" Colour="0,0,255" />
      <Function ID="6" Name="CTO" Display="'CTO'" Dmx="40~47" Colour="255,220,150" />
      <Function ID="7" Name="CTB" Display="'CTB'" Dmx="48~59" Colour="200,200,255" />
      <Function ID="8" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="60~187" Colour="0,0,0" />
      <Function ID="9" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />
      <Function ID="10" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="188~219" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="220~223" Colour="0,0,0" />
      <Function ID="12" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="224~255" Colour="0,0,0" />

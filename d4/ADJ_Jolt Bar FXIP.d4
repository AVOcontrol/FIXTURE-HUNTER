<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Jolt Bar FXIP" ShortName="JoltBrFXIP" Company="ADJ" Version="15">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>773e0a2b-9c88-4b47-b8e7-f3c80ea8d73a</Thumbnail>
  <History Date="08-02-22" Author="Nic Morris" Comment="Created (note 32 and 64 channel layouts don't match implementation.  made best guess)" Version="0" />
  <History Date="15-01-23" Author="Nic Morris" Comment="Updated in line with latest charts in response to customer bug report (document v1.1 added outer colour macro to 42 and 126 channel modes making them 43 and 127 channels respectively)" Version="5" />
  <History Date="15-01-23" Author="Nic Morris" Comment="(note pixel layouts still don't match the DMX implementation - 32 channel implementation has 8x RGB and 8x white.  32 layout is 8x RGB + 4x white.  32A layout is 16xRGB + 8x white.  This doesn't make any sense)" Version="5" />
  <History Date="15-01-23" Author="Nic Morris" Comment="(similarly, the 64 channel mode implementation has 16x RGB + 16x white whereas the layout has 16x RGB + 8x white)" Version="5" />
  <History Date="28-07-23" Author="Nic Morris" Comment="Revised colour macro with discreet functions and added 32A and 78 channel modes in line with latest documentation (v1.8)" Version="6" />
  <History Date="29-07-23" Author="Nic Morris" Comment="Added Atlabase ID's for 32A and 78 channel modes." Version="7" />
  <History Date="18-10-24" Author="Nic Morris" Comment="Created from American DJ Jolt Bar FX" Version="8" />
  <History Date="22-10-24" Author="Nic Morris" Comment="Added missing Atlabase IDs for 20, 34, 45, 80 and 129 channel modes." Version="14" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Jolt Bar FXIP.d4 to ADJ_Jolt Bar FXIP.d4." Version="15" />

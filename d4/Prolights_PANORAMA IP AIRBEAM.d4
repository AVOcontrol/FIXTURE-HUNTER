  <History Date="26-03-17" Author="Nic Morris" Comment="Created (standard mode chart has mapping errors)" />
  <History Date="18-07-17" Author="Nic Morris" Comment="Updated to release spec (note charts missing ranges for P/T speed and conflicts in rotating gobo)" />
  <History Date="19-07-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="06-08-17" Author="Nic Morris" Comment="Revised P/T speed function ranges in response to manufacturer information." />
  <History Date="02-10-17" Author="Nic Morris" Comment="Added 'Open (Wide)' function to basic and standard mode gobo 1 in line with revised charts from manufacturer." />
  <History Date="26-09-18" Author="Nic Morris" Comment="Added product thumbnail.  Added gobo swatches." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="5a8827ba-45d2-4a6e-a211-f50f86887487" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="250~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />

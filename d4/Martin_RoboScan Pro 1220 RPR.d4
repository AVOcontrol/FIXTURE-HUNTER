      <Function ID="15" Name="Cone/ Pling" Display="'Cone/ Pling %.f%%',0~100" Dmx="80~99" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Pling/ Circ" Display="'Pling/ Circ %.f%%',0~100" Dmx="100~119" WheelPosition="5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="17" Name="Circ/ Bells" Display="'Circ/ Bells %.f%%',0~100" Dmx="120~139" WheelPosition="6" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="18" Name="Bells/ Flwr" Display="'Bells/ Flwr %.f%%',0~100" Dmx="140~159" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="19" Name="Flwr/ Turb" Display="'Flwr/ Turb %.f%%',0~100" Dmx="160~179" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="20" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2" Name="Gobo 2" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="6,7,8,9,10" If="'Gobo2Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="25~49" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="50~74" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="75~99" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="100~125" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Gobo 1" Display="'Gobo 1'" Dmx="222~255" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="8" Name="Gobo 2" Display="'Gobo 2'" Dmx="190~221" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Gobo 3" Display="'Gobo 3'" Dmx="158~189" WheelPosition="3" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Gobo 4" Display="'Gobo 4'" Dmx="126~157" WheelPosition="4" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Rot" Name="Gobo 2 Rot" Description="" Group="G">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Index" ID="1" If="'Gobo2Func'==1" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo2Func'==2" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="128~254" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="255~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="1~127" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Focus" Display="'Focus %.1f%%',0.0~100.0" Dmx="10~177" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Far Focus" Display="'Far Focus'" Dmx="178~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="2:100" PowerOn="2:100" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="158~255" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Iris" Display="'Iris %.1f%%',0.0~100.0" Dmx="157~0" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Index" ID="1,2,3,4,5" If="'Prism_Func'==1" />
      <Condition Name="Spin" ID="6,7,8,9,10" If="'Prism_Func'==2" />
      <Else ID="11" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Prism 1" Display="'Prism 1'" Dmx="25~29" WheelPosition="1" />
      <Function ID="3" Name="Prism 2" Display="'Prism 2'" Dmx="50~74" WheelPosition="2" />
      <Function ID="4" Name="Prism 3" Display="'Prism 3'" Dmx="75~99" WheelPosition="3" />
      <Function ID="5" Name="Prism 4" Display="'Prism 4'" Dmx="100~125" WheelPosition="4" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="7" Name="Prism 1" Display="'Prism 1'" Dmx="126~157" WheelPosition="1" />
      <Function ID="8" Name="Prism 2" Display="'Prism 2'" Dmx="158~189" WheelPosition="2" />
      <Function ID="9" Name="Prism 3" Display="'Prism 3'" Dmx="190~221" WheelPosition="3" />
      <Function ID="10" Name="Prism 4" Display="'Prism 4'" Dmx="222~255" WheelPosition="4" />
      <Function ID="11" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="251~1" />
      <Function ID="2" Name="Tracking" Display="'Tracking'" Dmx="0~0" />
      <Function ID="3" Name="Move in Dark" Display="'Move in Dark'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo 1 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Gobo2Func" Name="Gobo 2 Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin" Display="'Spin'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo2, Gobo2Rot" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />

      <Function ID="8" Name="Bells" Display="'Bells'" Dmx="197~204" WheelPosition="7" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Flower" Display="'Flower'" Dmx="189~196" WheelPosition="8" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Turbine" Display="'Turbine'" Dmx="180~188" WheelPosition="9" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Op/ Stars" Display="'Op/ Stars %.f%%',0~100" Dmx="0~19" WheelPosition="0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Stars/ Star" Display="'Stars/ Star %.f%%',0~100" Dmx="20~39" WheelPosition="1" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Stars/ Dots" Display="'Stars/ Dots %.f%%',0~100" Dmx="40~59" WheelPosition="2" GoboSpin="0~0" GoboOrientation="0~0" />

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="04cfac5a-2e1c-4708-bfb4-b12585151835" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Update="Speed" Colour="255,255,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="20~29" Update="Speed" Colour="255,255,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="30~39" Update="Speed" Colour="255,255,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="40~49" Update="Speed" Colour="255,255,255" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" Update="Speed" Colour="255,255,255" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="60~69" Update="Speed" Colour="255,255,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="70~79" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Auto" Display="'Auto %.f',1~16" Dmx="80~239" Update="Speed" Colour="255,255,255" />
      <Function ID="10" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Speed" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Condition Name="Sound" ID="2" If="'Colour_Macro'==10" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="2" Name="Sound" Display="'%.f',1~16" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red1" Name="Red 1" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="COLORband PiX-M USB" ShortName="PiX-M USB" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>e8b64f85-ef04-4f17-bcdd-416ff77364fc</Thumbnail>
  <History Date="02-02-17" Author="Nic Morris" Comment="Created" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed name from COLORband Pix-M USB to COLORband PiX-M USB" />
  <History Date="04-10-17" Author="Nic Morris" Comment="Changed physical type to moving head (range not documented).  Added Atlabase ID's." />
  <History Date="07-04-19" Author="Nic Morris" Comment="Fixed 10 DMX channel mapping (tilt and tilt speed were swapped).  Added product thumbnail." />
  <History Date="07-04-19" Author="Nic Morris" Comment="Added physical tilt range." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="07c1c1dd-18f0-4f75-8135-c43ca8fa067d" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="16~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Auto'&gt;1&amp;&amp;'Auto'&lt;16" />
      <Condition Name="Sensitivity" ID="4,5" If="'Auto'==16" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="5" Name="Sensitivity" Display="'Sensitivity %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Shutter" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="32~45" Update="Shutter" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="46~59" Update="Shutter" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="60~72" Update="Shutter" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="73~86" Update="Shutter" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="87~100" Update="Shutter" />
      <Function ID="7" Name="Auto 6" Display="'Auto 6'" Dmx="101~113" Update="Shutter" />
      <Function ID="8" Name="Auto 7" Display="'Auto 7'" Dmx="114~127" Update="Shutter" />
      <Function ID="9" Name="Auto 8" Display="'Auto 8'" Dmx="128~141" Update="Shutter" />
      <Function ID="10" Name="Auto 9" Display="'Auto 9'" Dmx="142~154" Update="Shutter" />
      <Function ID="11" Name="Auto 10" Display="'Auto 10'" Dmx="155~168" Update="Shutter" />
      <Function ID="12" Name="Auto 11" Display="'Auto 11'" Dmx="169~182" Update="Shutter" />
      <Function ID="13" Name="Auto 12" Display="'Auto 12'" Dmx="183~195" Update="Shutter" />
      <Function ID="14" Name="Auto 13" Display="'Auto 13'" Dmx="196~209" Update="Shutter" />
      <Function ID="15" Name="Auto 14" Display="'Auto 14'" Dmx="210~223" Update="Shutter" />
      <Function ID="16" Name="Sound" Display="'Sound'" Dmx="224~255" Update="Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Fast" Display="'Fast'" Dmx="102~152" />
      <Function ID="4" Name="Medium" Display="'Medium'" Dmx="153~203" />
      <Function ID="5" Name="Slow" Display="'Slow'" Dmx="204~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

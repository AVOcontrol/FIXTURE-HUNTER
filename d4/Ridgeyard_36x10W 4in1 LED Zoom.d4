  <History Date="31-05-16" Author="Nic Morris" Comment="Created" />
  <History Date="17-09-16" Author="Nic Morris" Comment="Added Atlabase ID's for 12 DMX mode." />
  <History Date="20-09-16" Author="Nic Morris" Comment="Added Atlabase ID to 16 DMX mode." />
  <History Date="21-11-19" Author="Nic Morris" Comment="Created from AFX LMH-3610" />
  <History Date="23-11-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="43f73b04-4d6b-48b9-ab6d-861411e67e74" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Preset_Dimmer" Name="Preset Dimmer" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Delay On" Display="'Delay On'" Dmx="1~25" />
      <Function ID="3" Name="Delay Off" Display="'Delay Off'" Dmx="26~50" />
      <Function ID="4" Name="Program" Display="'Program'" Dmx="51~90" />
      <Function ID="5" Name="Pulse" Display="'Pulse'" Dmx="91~130" />
      <Function ID="6" Name="Jump" Display="'Jump'" Dmx="131~170" />
      <Function ID="7" Name="Gradual" Display="'Gradual'" Dmx="171~210" />
      <Function ID="8" Name="Auto" Display="'Auto'" Dmx="211~250" />
      <Function ID="9" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~160" Colour="255,255,255" />
      <Function ID="3" Name="RGBW Full" Display="'RGBW Full'" Dmx="161~170" Colour="255,255,255" />
      <Function ID="4" Name="RGBW Off" Display="'RGBW Off'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="5" Name="White 1" Display="'White 3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="6" Name="White 2" Display="'White 3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="7" Name="White 3" Display="'White 4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="8" Name="White 4" Display="'White 4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="9" Name="White 5" Display="'White 5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="10" Name="White 6" Display="'White 5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="11" Name="White 7" Display="'White 6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="12" Name="White 8" Display="'White 7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="13" Name="White 9" Display="'White 8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="14" Name="White 10" Display="'White 8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="15" Name="White 11" Display="'White 10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="270" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d0908030-a30c-48cb-b946-22a27f9a5aeb" />
    <Include>

      <Attribute ID="Tilt" ChannelOffset="8,10" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="11" Wheel="25" />
      <Attribute ID="Zoom" ChannelOffset="12" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="13" Wheel="4" />
      <Attribute ID="Auto" ChannelOffset="14" Wheel="22" />
      <Attribute ID="Colour_Macro" ChannelOffset="15" Wheel="7" />
      <Attribute ID="Control" ChannelOffset="16" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="12 DMX" Channels="12">

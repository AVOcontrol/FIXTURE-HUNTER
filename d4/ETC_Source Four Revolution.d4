<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Source Four Revolution" ShortName="S4 Rev" Company="ETC">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-01-05" Author="Phil" Comment="Created" />
  <History Date="19-01-05" Author="Tom Peck" Comment="Tested" />
  <History Date="10-04-06" Author="Ed" Comment="Moved all No Funcs into special group" />
  <History Date="11-04-06" Author="Ed Spencer" Comment="Moved all shutter functions into Beam group" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Colour ID to Colour1" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Pan Power on to Locate value" />
  <History Date="18-07-06" Author="D4 Pers Fixer" Comment="Updated Tilt Power on to Locate value" />
  <History Date="08-12-08" Author="David Hunt" Comment="Edited-Fixed duplicate channel values" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="08-01-10" Author="John Rogers" Comment="Added 15 DMX Base + Iris mode for Alex @ RAH." />
  <History Date="01-02-10" Author="John Rogers" Comment="Changed Iris locate value from 100% to 0%." />
  <History Date="16-08-11" Author="John Rogers" Comment="Added Blade Control Attribute IDs." />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information." />
  <History Date="07-07-15" Author="Nic Morris" Comment="Changed shutter rotate locate to 50% in response to customer bug report and in line with manufacturer recommended" />
  <History Date="07-07-15" Author="Nic Morris" Comment="Increased wheel resolution.  Standardised colour func function names" />
  <History Date="07-07-15" Author="Nic Morris" Comment="Standardised iris wheel direction and changed power on to match locate." />
  <History Date="07-07-15" Author="Nic Morris" Comment="Moved reserved 2 from intensity wheel slot to special to match attribute group" />
  <History Date="09-07-15" Author="Nic Morris" Comment="Added hilight/lolight - note no standard colours" />
  <History Date="21-05-17" Author="Nic Morris" Comment="Added physical pan/tilt limits.  Added codes and frame numbers to colour function names." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Changed fixed colour functions to center frame values in manufacturer's documentation." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Revised colour swatches.  Aligned colour locate and power on with associated condition (index)." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Added reset P/T control function and macro." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Recreated palettes.  Changed reserved channel to Fan Speed." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Increased wheel resolution. Revised mode options for Capture compatibility.  Added Atlabase ID's." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Added 16, 20 and 24 colour frame options.  Revised bay position function names as could be gobo or colour." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Added conditions to bay rotate." />
  <History Date="21-05-17" Author="Nic Morris" Comment="Recreated from ETC Source Four Revolution w Wybron" />
  <History Date="21-05-17" Author="Nic Morris" Comment="Swapped Shutter 2 and Shutter 4 blade ID's in line with Capture (Blade 4/ Blade 2 respectively)" />
  <History Date="22-05-17" Author="Nic Morris" Comment="" />
  <History Date="22-05-17" Author="Nic Morris" Comment="Refined colour options to make it easier to adjust from frame centers" />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="25972" />
  </RDM>
  <AtlaBase TypeID="1d33d6d4-7799-42e7-a36f-b70307e764d0" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">

    <Attribute ID="Bay_1_Position" Name="Bay 1 Position" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Position 0 (Open)" Display="'Position 0 (Open)'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Position 1" Display="'Position 1'" Dmx="14~26" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Position 2" Display="'Position 2'" Dmx="27~39" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Position 3" Display="'Position 3'" Dmx="40~50" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Position 3 (Reserved)" Display="'Position 3 (Reserved)'" Dmx="51~255" />
    </Attribute>
    <Attribute ID="Bay_1_Function" Name="Bay 1 Function" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="14~26" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="27~39" Update="Bay_1_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Bay_1_Rotation" />
    </Attribute>
    <Attribute ID="Bay_1_Rotation" Name="Bay 1 Rotation" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Bay_1_Function'==1" />
      <Condition Name="Spin" ID="2" If="'Bay_1_Function'==2||'Bay_1_Function'==3" />
      <Else ID="3" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Bay_2_Position" Name="Bay 2 Position" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Position 0 (Open)" Display="'Position 0 (Open)'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Position 1" Display="'Position 1'" Dmx="14~26" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Position 2" Display="'Position 2'" Dmx="27~39" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Position 3" Display="'Position 3'" Dmx="40~50" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="5" Name="Position 3 (Reserved)" Display="'Position 3 (Reserved)'" Dmx="51~255" />
    </Attribute>
    <Attribute ID="Bay_2_Function" Name="Bay 2 Function" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index" Display="'Index'" Dmx="0~0" Update="Bay_2_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW'" Dmx="14~26" Update="Bay_2_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="27~39" Update="Bay_2_Rotation" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Bay_2_Rotation" />
    </Attribute>
    <Attribute ID="Bay_2_Rotation" Name="Bay 2 Rotation" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Bay_2_Function'==1" />
      <Condition Name="Spin" ID="2" If="'Bay_2_Function'==2||'Bay_2_Function'==3" />
      <Else ID="3" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Speed" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Blade_1" Name="Shutter 1 In" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Position" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />

  <History Date="01-05-20" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4ef0d93a-a058-40ff-9f64-70b20f61bc23" />
  <Control>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="1- Auto" Display="'1- Auto'" Dmx="25~49" Update="Auto_Spd" />
      <Function ID="3" Name="2- CW Dimming" Display="'2- CW Dimming'" Dmx="50~74" Update="Auto_Spd" />
      <Function ID="4" Name="3- WW Dimming" Display="'3- WW Dimming'" Dmx="75~99" Update="Auto_Spd" />
      <Function ID="5" Name="4- CW, WW Dimming" Display="'4- CW, WW Dimming'" Dmx="100~124" Update="Auto_Spd" />
      <Function ID="6" Name="5- CW, WW Dimming" Display="'5- CW, WW Dimming'" Dmx="125~149" Update="Auto_Spd" />
      <Function ID="7" Name="6- CW, WW Hopping" Display="'6- CW, WW Hopping'" Dmx="150~174" Update="Auto_Spd" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="175~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Condition Name="Sensitivity" ID="2" If="'Auto'==8" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="138862fa-87b3-4c49-aad2-76265692d75c" />
    <Include>
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="5f532880-8567-4261-a43c-182f45db38de" />
    <Include>
      <Attribute ID="ColdWhite" ChannelOffset="1" Wheel="11" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Dimmer" ChannelOffset="3" Wheel="1" />
      <Attribute ID="Auto" ChannelOffset="4" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="5" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
    </Group>
  </Palettes>
  <swatchLibrary>

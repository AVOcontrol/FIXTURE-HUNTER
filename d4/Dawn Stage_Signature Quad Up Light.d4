  <History Date="13-05-26" Author="Nic Morris" Comment="Created (note contains custom palettes - do not use auto palette!)" Version="0" />
  <History Date="22-05-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d88b8761-a85d-49d6-b906-b96a1f3a7178" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Pulse" Display="'Pulse %.1f%%',0.0~100.0" Dmx="5~104" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="205~255" />
      <Function ID="4" Name="Gradient" Display="'Gradient %.f%%',0~100" Dmx="105~204" />
    </Attribute>
    <Attribute ID="Colour_Temp" Name="Colour Temp" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2000K" Display="'2000K'" Dmx="10~19" Colour="0,0,0" />
      <Function ID="3" Name="2200K" Display="'2200K'" Dmx="20~29" Colour="0,0,0" />
      <Function ID="4" Name="2400K" Display="'2400K'" Dmx="30~39" Colour="0,0,0" />
      <Function ID="5" Name="2600K" Display="'2600K'" Dmx="40~49" Colour="0,0,0" />
      <Function ID="6" Name="2800K" Display="'2800K'" Dmx="50~59" Colour="0,0,0" />
      <Function ID="7" Name="3200K" Display="'3200K'" Dmx="60~69" Colour="0,0,0" />
      <Function ID="8" Name="3600K" Display="'3600K'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="9" Name="4000K" Display="'4000K'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="10" Name="4400K" Display="'4400K'" Dmx="90~99" Colour="0,0,0" />
      <Function ID="11" Name="4800K" Display="'4800K'" Dmx="100~109" Colour="0,0,0" />
      <Function ID="12" Name="5200K" Display="'5200K'" Dmx="110~119" Colour="0,0,0" />
      <Function ID="13" Name="5600K" Display="'5600K'" Dmx="120~129" Colour="0,0,0" />
      <Function ID="14" Name="6000K" Display="'6000K'" Dmx="130~139" Colour="0,0,0" />
      <Function ID="15" Name="6400K" Display="'6400K'" Dmx="140~149" Colour="0,0,0" />
      <Function ID="16" Name="6800K" Display="'6800K'" Dmx="150~159" Colour="0,0,0" />
      <Function ID="17" Name="7200K" Display="'7200K'" Dmx="160~169" Colour="0,0,0" />
      <Function ID="18" Name="7600K" Display="'7600K'" Dmx="170~179" Colour="0,0,0" />
      <Function ID="19" Name="8000K" Display="'8000K'" Dmx="180~189" Colour="0,0,0" />
      <Function ID="20" Name="8400K" Display="'8400K'" Dmx="190~199" Colour="0,0,0" />
      <Function ID="21" Name="8800K" Display="'8800K'" Dmx="200~209" Colour="0,0,0" />
      <Function ID="22" Name="9200K" Display="'9200K'" Dmx="210~219" Colour="0,0,0" />
      <Function ID="23" Name="9600K" Display="'9600K'" Dmx="220~229" Colour="0,0,0" />
      <Function ID="24" Name="10000K" Display="'10000K'" Dmx="230~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="-" Display="'- %.1f',25.0~0.0" Dmx="1~127" Colour="0,0,0" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="0,0,0" />
      <Function ID="4" Name="+" Display="'+ %.1f',0.0~25.0" Dmx="129~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Colour Macro" Display="'Colour Macro'" Dmx="5~50" />
      <Function ID="3" Name="3 Col Jump" Display="'3 Col Jump'" Dmx="51~60" />
      <Function ID="4" Name="6 Col Jump" Display="'6 Col Jump'" Dmx="61~70" />
      <Function ID="5" Name="9 Col Jump" Display="'9 Col Jump'" Dmx="71~80" />
      <Function ID="6" Name="15 Col Jump" Display="'15 Col Jump'" Dmx="81~90" />
      <Function ID="7" Name="3 Col Fade" Display="'3 Col Fade'" Dmx="91~100" />
      <Function ID="8" Name="6 Col Fade" Display="'6 Col Fade'" Dmx="101~110" />
      <Function ID="9" Name="9 Col Fade" Display="'9 Col Fade'" Dmx="111~120" />
      <Function ID="10" Name="15 Col Fade" Display="'15 Col Fade'" Dmx="121~130" />
      <Function ID="11" Name="Red Breathe" Display="'Red Breathe'" Dmx="131~140" />
      <Function ID="12" Name="Green Breathe" Display="'Green Breathe'" Dmx="141~150" />
      <Function ID="13" Name="Blue Breathe" Display="'Blue Breathe'" Dmx="151~160" />
      <Function ID="14" Name="Amber Breathe" Display="'Amber Breathe'" Dmx="161~170" />
      <Function ID="15" Name="Lime Breathe" Display="'Lime Breathe'" Dmx="171~180" />
      <Function ID="16" Name="Cyan Breathe" Display="'Cyan Breathe'" Dmx="181~190" />
      <Function ID="17" Name="3 Col Breathe" Display="'3 Col Breathe'" Dmx="191~200" />
      <Function ID="18" Name="6 Col Breathe" Display="'6 Col Breathe'" Dmx="201~210" />
      <Function ID="19" Name="9 Col Breathe" Display="'9 Col Breathe'" Dmx="211~220" />
      <Function ID="20" Name="Rainbow Fade" Display="'Rainbow Fade'" Dmx="221~230" />
      <Function ID="21" Name="Sound Col Strobe" Display="'Sound Col Strobe'" Dmx="231~240" />
      <Function ID="22" Name="Sound Col Gradual" Display="'Sound Col Gradual'" Dmx="241~250" />
      <Function ID="23" Name="Sound Col Changing" Display="'Sound Col Changing'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

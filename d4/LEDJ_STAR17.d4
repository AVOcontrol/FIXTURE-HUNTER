<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="STAR17" ShortName="STAR17" Company="LEDJ">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="05-10-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~9" Update="Speed" />
      <Function ID="2" Name="Pattern" Display="'Pattern %.1f%%',0.0~100.0" Dmx="10~255" Update="Speed" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Sound" ID="2,3" If="'Pattern'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Blackout" Display="'Blackout'" Dmx="0~9" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="10~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="LJSTAR17" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Pattern" ChannelOffset="1" Wheel="22" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="23" />
    </Include>
  </Mode>
</Fixture>
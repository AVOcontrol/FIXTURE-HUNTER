      <Condition Name="Index" ID="2" If="'Animation'==2||'Animation'==5||'Animation'==8" />
      <Condition Name="Spin" ID="3,4,5,6" If="'Animation'==3||'Animation'==6||'Animation'==9" />
      <Else ID="7" />
      <Function ID="1" Name="No Func" Display="''" Dmx="0~0" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Mini LED 10W RGBW Beam" ShortName="Mini 10W" Company="Shehds">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>a49b6844-2926-4a7d-b47b-c9fadf6c1212</Thumbnail>
  <History Date="09-01-19" Author="Nic Morris" Comment="Created" />
  <History Date="16-01-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="a22d821f-6e6d-436f-99d4-fb8b89491c1f" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red" Display="'Red'" Dmx="0~0" Colour="255,0,0" />
      <Function ID="2" Name="Green" Display="'Green'" Dmx="18~34" Colour="0,255,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="35~51" Colour="0,0,255" />
      <Function ID="4" Name="White" Display="'White'" Dmx="52~68" Colour="255,255,255" />
      <Function ID="5" Name="R+G" Display="'R+G'" Dmx="69~85" Colour="255,255,255" />
      <Function ID="6" Name="R+B" Display="'R+B'" Dmx="86~102" Colour="255,255,255" />
      <Function ID="7" Name="R+W" Display="'R+W'" Dmx="103~119" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="120~136" Colour="255,255,255" />
      <Function ID="9" Name="G+W" Display="'G+W'" Dmx="137~153" Colour="255,255,255" />
      <Function ID="10" Name="B+W" Display="'B+W'" Dmx="154~170" Colour="255,255,255" />
      <Function ID="11" Name="R+G+B" Display="'R+G+B'" Dmx="171~187" Colour="255,255,255" />
      <Function ID="12" Name="R+G+W" Display="'R+G+W'" Dmx="188~204" Colour="255,255,255" />
      <Function ID="13" Name="R+B+W" Display="'R+B+W'" Dmx="205~221" Colour="255,255,255" />
      <Function ID="14" Name="G+B+W" Display="'G+B+W'" Dmx="222~238" Colour="255,255,255" />
      <Function ID="15" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="239~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f6ae2810-eea7-40ca-8ca6-e4ca6bf18edc" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Colour1" ChannelOffset="6" Wheel="8" />
      <Attribute ID="Dimmer" ChannelOffset="7" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="White" Number="1" Page="1" SetControl="Colour1:4" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:1" />
      <Palette ID="3" Name="Red" Number="3" Page="1" SetControl="Colour1:1" />
      <Palette ID="4" Name="Red" Number="4" Page="1" SetControl="Colour1:1" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:2" />
      <Palette ID="7" Name="Green" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="8" Name="Green" Number="6" Page="1" SetControl="Colour1:2" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:3" />
      <Palette ID="11" Name="Blue" Number="9" Page="1" SetControl="Colour1:3" />
      <Palette ID="12" Name="Red" Number="10" Page="1" SetControl="Colour1:1" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:1" />
      <Palette ID="14" Name="White" Number="8" Page="1" SetControl="Colour1:4" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:3" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="a49b6844-2926-4a7d-b47b-c9fadf6c1212"></Swatch>
  </swatchLibrary>
</Fixture>
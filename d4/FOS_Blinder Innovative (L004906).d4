  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~240" />
      <Function ID="3" Name="Sudden" Display="'Sudden'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Pulse A" Display="'Pulse A'" Dmx="37~71" />
      <Function ID="3" Name="Pulse B" Display="'Pulse B'" Dmx="72~107" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="144~215" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="11~40" />
      <Function ID="3" Name="Medium" Display="'Medium'" Dmx="41~80" />
      <Function ID="4" Name="Slow" Display="'Slow'" Dmx="81~120" />
      <Function ID="5" Name="Default" Display="'Default'" Dmx="121~255" />
    </Attribute>
    <Attribute ID="Dim_Fade_Spd" Name="Dim Fade Spd" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>

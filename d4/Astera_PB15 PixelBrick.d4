<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PB15 PixelBrick" ShortName="PixelBrick" Company="Astera" Version="27">
  <Copyright Notice="© Avolites Ltd. 2021" />
  <Thumbnail>5596f0ed-5bc1-4924-a0c9-fd2ab996cedd</Thumbnail>
  <History Date="29-10-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="11-03-17" Author="Nic Morris" Comment="Created from Astera SPOTMAX (AX10)" Version="2" />
  <History Date="15-03-17" Author="Nic Morris" Comment="Added 4 and 16 cell modes in response to customer request." Version="3" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Added product thumbnail" Version="4" />
  <History Date="16-02-18" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="06-03-18" Author="Nic Morris" Comment="Improved product thumbnail" Version="6" />
  <History Date="19-04-18" Author="Nic Morris" Comment="Changed reserved control to Amber." Version="7" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Renamed existing modes as 'multi-strobe' and added 'no strobe', 'single strobe' and 'SS' modes in line with latest charts (10/10/17)" Version="8" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Note the effect modes seem to have disappeared.  Retained for backwards compatibility or in case this is wrong." Version="9" />
  <History Date="13-05-18" Author="Nic Morris" Comment="Also note charts only have the 'SS' option listed for RGB" Version="10" />
  <History Date="13-05-18" Author="Nic Morris" Comment="'Single Strobe' mode charts have gaps in the offsets.  Very confusing.  Used reserved channels to avoid problems." Version="11" />
  <History Date="13-05-18" Author="Nic Morris" Comment="For 1 pixel modes (no 'Pixel' suffix),'Strobe' is equivalent to 'Single' and 'Multi' versions as there is no difference." Version="12" />
  <History Date="03-11-18" Author="Nic Morris" Comment="Created from Astera AX1 PixelTube" Version="13" />
  <History Date="15-03-19" Author="Nic Morris" Comment="Added Atlabase ID's (currently missing mode 43)" Version="14" />
  <History Date="19-03-19" Author="Nic Morris" Comment="Added missing Atlabase ID to mode 43." Version="15" />
  <History Date="30-05-19" Author="Nic Morris" Comment="Revised CTO display range to Kelvin." Version="16" />
  <History Date="16-10-19" Author="Nic Morris" Comment="Updated in line with May-19 charts.  Far too many modes!" Version="17" />
  <History Date="17-10-19" Author="Nic Morris" Comment="Revised CCT display range." Version="18" />
  <History Date="19-10-19" Author="Nic Morris" Comment="Added Atlabase ID's to new modes." Version="19" />
  <History Date="10-09-20" Author="Nic Morris" Comment="Created from Astera FP1 Titan Tube" Version="20" />
  <History Date="12-09-20" Author="Nic Morris" Comment="Added missing Atlabase ID's to modes 15,16 and 137." Version="24" />
  <History Date="26-11-21" Author="Nic Morris" Comment="Created from Astera FP5 NYX Bulb" Version="25" />
  <History Date="30-11-21" Author="Nic Morris" Comment="Added missing Atlabase ID for mode 94." Version="27" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8a7bd9ac-1f48-412b-8050-431f7c74597c" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="7~255" />
      <Function ID="3" Name="Random" Display="'Random %.f%%',0~100" Dmx="6~4" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="1 Col Static" Display="'1 Col Static'" Dmx="0~0" />
      <Function ID="2" Name="2 Col Static" Display="'2 Col Static'" Dmx="8~15" />
      <Function ID="3" Name="3 Col Static" Display="'3 Col Static'" Dmx="16~23" />
      <Function ID="4" Name="4 Col Static" Display="'4 Col Static'" Dmx="24~31" />
      <Function ID="5" Name="1 Col Fade" Display="'1 Col Fade'" Dmx="32~39" />
      <Function ID="6" Name="2 Col Fade" Display="'2 Col Fade'" Dmx="40~47" />
      <Function ID="7" Name="3 Col Fade" Display="'3 Col Fade'" Dmx="48~55" />
      <Function ID="8" Name="4 Col Fade" Display="'4 Col Fade'" Dmx="56~63" />
      <Function ID="9" Name="Simple Running" Display="'Simple Running'" Dmx="64~71" />
      <Function ID="10" Name="Double Running" Display="'Double Running'" Dmx="72~79" />
      <Function ID="11" Name="2 Col Running" Display="'2 Col Running'" Dmx="80~87" />
      <Function ID="12" Name="Flag Running" Display="'Flag Running'" Dmx="88~95" />
      <Function ID="13" Name="Double Flag Running" Display="'Double Flag Running'" Dmx="96~101" />
      <Function ID="14" Name="Spiral 4 Col" Display="'Spiral 4 Col'" Dmx="102~109" />
      <Function ID="15" Name="Spiral 2 Col" Display="'Spiral 2 Col'" Dmx="110~117" />
      <Function ID="16" Name="Rainbow" Display="'Rainbow'" Dmx="118~125" />
      <Function ID="17" Name="Fire" Display="'Fire'" Dmx="126~133" />
      <Function ID="18" Name="Rotor" Display="'Rotor'" Dmx="134~141" />
      <Function ID="19" Name="Rotor Split 2" Display="'Rotor Split 2'" Dmx="142~149" />
      <Function ID="20" Name="Rotor Split 4" Display="'Rotor Split 4'" Dmx="150~157" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Fade" Name="Effect Fade" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Direction" Name="Direction" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="FWD + Loop" Display="'FWD + Loop'" Dmx="0~0" />
      <Function ID="2" Name="FWD + Stop" Display="'FWD + Stop'" Dmx="64~127" />
      <Function ID="3" Name="REV + Stop" Display="'REV + Stop'" Dmx="128~190" />
      <Function ID="4" Name="REV + Loop" Display="'REV + Loop'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Size" Name="Size" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="1 Group" Display="'1 Group'" Dmx="0~0" />
      <Function ID="2" Name="2 Groups" Display="'2 Groups'" Dmx="64~127" />
      <Function ID="3" Name="3 Groups" Display="'3 Groups'" Dmx="128~190" />
      <Function ID="4" Name="4 Groups" Display="'4 Groups'" Dmx="191~255" />
    </Attribute>
    <Attribute ID="Offset" Name="Offset" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Offset" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Restart" Name="Restart" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Restart" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

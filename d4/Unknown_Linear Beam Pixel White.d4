<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Linear Beam Pixel White" ShortName="Linear Bm" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <History Date="24-04-16" Author="Nic Morris" Comment="Created" />
  <History Date="02-05-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="08-09-17" Author="Nic Morris" Comment="Added alternative modes (at least 3 different manuals containing 2 different charts - no revision or firmware no's)" />
  <History Date="09-09-17" Author="Nic Morris" Comment="Added Atlabase ID's to alternative modes." />
  <History Date="20-04-19" Author="Nic Morris" Comment="Created from American Pro TecShow Octobeam (identical except 6 channel mode)" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~249" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt_Speed" Name="Tilt Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="80~99" />
      <Function ID="3" Name="Program 1" Display="'Program 1'" Dmx="100~119" />
      <Function ID="4" Name="Program 2" Display="'Program 2'" Dmx="120~139" />
      <Function ID="5" Name="Program 3" Display="'Program 3'" Dmx="140~159" />
      <Function ID="6" Name="Program 4" Display="'Program 4'" Dmx="160~179" />
      <Function ID="7" Name="Program 5" Display="'Program 5'" Dmx="180~199" />
      <Function ID="8" Name="Program 6" Display="'Program 6'" Dmx="200~219" />
      <Function ID="9" Name="Program 7" Display="'Program 7'" Dmx="220~239" />
      <Function ID="10" Name="Program 8" Display="'Program 8'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1" Display="'Macro 1 %.f%%',0~100" Dmx="16~35" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2 %.f%%',0~100" Dmx="36~55" />
      <Function ID="4" Name="Macro 3" Display="'Macro 3 %.f%%',0~100" Dmx="56~75" />
      <Function ID="5" Name="Macro 4" Display="'Macro 4 %.f%%',0~100" Dmx="76~95" />
      <Function ID="6" Name="Macro 5" Display="'Macro 5 %.f%%',0~100" Dmx="96~115" />
      <Function ID="7" Name="Macro 6" Display="'Macro 6 %.f%%',0~100" Dmx="116~135" />
      <Function ID="8" Name="Macro 7" Display="'Macro 7 %.f%%',0~100" Dmx="136~155" />
      <Function ID="9" Name="Macro 8" Display="'Macro 8 %.f%%',0~100" Dmx="156~175" />
      <Function ID="10" Name="Macro 9" Display="'Macro 9 %.f%%',0~100" Dmx="176~195" />
      <Function ID="11" Name="Macro 10" Display="'Macro 10 %.f%%',0~100" Dmx="196~215" />
      <Function ID="12" Name="Macro 11" Display="'Macro 11 %.f%%',0~100" Dmx="216~235" />
      <Function ID="13" Name="Macro 12" Display="'Macro 12 %.f%%',0~100" Dmx="236~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 15 DMX" Channels="15">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
        <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
        <Attribute ID="Tilt_Speed" ChannelOffset="5" Wheel="25" />
        <Attribute ID="Control" ChannelOffset="6" Wheel="28" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Macro" ChannelOffset="15" Wheel="22" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="7" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="9" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="10" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell5" Name="Cell 5" ChannelOffset="11" ModeLink="Cell" X="0" Y="4">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell6" Name="Cell 6" ChannelOffset="12" ModeLink="Cell" X="0" Y="5">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell7" Name="Cell 7" ChannelOffset="13" ModeLink="Cell" X="0" Y="6">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell8" Name="Cell 8" ChannelOffset="14" ModeLink="Cell" X="0" Y="7">
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="1" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Tilt" ChannelOffset="3" Wheel="3" />
      <Attribute ID="Tilt_Speed" ChannelOffset="4" Wheel="25" />
      <Attribute ID="Control" ChannelOffset="5" Wheel="28" />
      <Attribute ID="Macro" ChannelOffset="6" Wheel="22" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
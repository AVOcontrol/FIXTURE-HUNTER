      <Condition Name="Scroll" ID="29,30,31,32" If="'Colour1Func'==3" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="7~11" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Dark Green" Display="'Dark Green'" Dmx="12~16" WheelPosition="2" Colour="0,175,0" />

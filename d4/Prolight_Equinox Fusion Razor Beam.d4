  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="bf407ac9-106d-4865-840d-1b194ea0b3f0" />
  <Control>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Auto" Display="'Auto'" Dmx="8~127" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~14" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="15~24" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="25~34" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="35~44" Colour="255,255,255" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="45~54" Colour="255,255,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="55~64" Colour="255,255,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="65~74" Colour="255,255,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="75~84" Colour="255,255,255" />
      <Function ID="10" Name="Purple" Display="'Purple'" Dmx="85~94" Colour="255,255,255" />
      <Function ID="11" Name="Pastel Green" Display="'Pastel Green'" Dmx="95~104" Colour="255,255,255" />
      <Function ID="12" Name="Pastel Red" Display="'Pastel Red'" Dmx="105~114" Colour="255,255,255" />
      <Function ID="13" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="115~124" Colour="255,255,255" />
      <Function ID="14" Name="Pastel Pink" Display="'Pastel Pink'" Dmx="125~134" Colour="255,255,255" />
      <Function ID="15" Name="Warm White" Display="'Warm White'" Dmx="135~144" Colour="255,255,255" />
      <Function ID="16" Name="Blackout" Display="'Blackout'" Dmx="145~150" Colour="255,255,255" />
      <Function ID="17" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="151~200" Colour="255,255,255" />
      <Function ID="18" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="PTEQFRB1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

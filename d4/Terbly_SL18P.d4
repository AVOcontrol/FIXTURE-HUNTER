  <History Date="27-05-15" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="02-11-15" Author="Nic Morris" Comment="Updated to latest spec in response to manufacturer request" Version="2" />
  <History Date="14-04-16" Author="Nic Morris" Comment="Split autofocus into two separate 8bit controls in response to manufacturer request." Version="3" />
  <History Date="20-04-16" Author="Nic Morris" Comment="Added colour index function and increased macro delay in response to manufacturer bug report." Version="4" />
  <History Date="05-05-17" Author="Nic Morris" Comment="Changed All Blade Rot to locate and power on at 50% in response to customer bug report." Version="5" />
  <History Date="11-05-17" Author="Nic Morris" Comment="Reverted blade rot to locate and power on at zero." Version="6" />
  <History Date="21-12-17" Author="Nic Morris" Comment="Added Atlabase ID's.  Added channel counts to mode names." Version="7" />
  <History Date="21-12-17" Author="Nic Morris" Comment="Added product thumbnail" Version="8" />
  <History Date="30-12-17" Author="Nic Morris" Comment="Changed blades to two-point system in response to manufacturer request (documentation is incorrect)." Version="9" />
  <History Date="02-01-18" Author="Nic Morris" Comment="Revised blade ID's in response to manufacturer calibration data." Version="10" />
  <History Date="20-05-18" Author="Nic Morris" Comment="Created from Terbly GL-6" Version="11" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Changed RGB to default at zero in response to manufacturer bug report." Version="12" />
  <History Date="22-05-18" Author="Nic Morris" Comment="Removed RGB from highlight/lowlight in response to manufacturer request." Version="13" />
  <History Date="27-06-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail.  Added gobo swatches." Version="14" />
  <History Date="09-07-20" Author="Nic Morris" Comment="Added RDM ID's" Version="15" />
  <History Date="07-09-22" Author="Nic Morris" Comment="Created from Terbly GL10WP" Version="16" />
  <History Date="08-09-22" Author="Nic Morris" Comment="Revised RDM model ID in response to manufacturer request (documentation had wrong ID)." Version="18" />
  <History Date="10-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="19" />
  <History Date="14-12-22" Author="Nic Morris" Comment="Created from Terbly SL5000PH (note charts say standard mode is 39 channels but have two controls on offset 39.  assumed should be 40 for now)" Version="20" />
  <History Date="18-12-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="21" />
  <History Date="28-02-23" Author="Nic Morris" Comment="Updated in line with latest documentation in response to manufacturer request (animation rot merged into animation, prism rot separated into prism 1 rot and prism 2 rot.  frost function changes. additional fan speed control functions/macros)" Version="22" />
  <History Date="23-02-24" Author="Nic Morris" Comment="Created from Terbly SL5000P IP" Version="23" />
  <History Date="11-04-24" Author="Nic Morris" Comment="Updated in line with full documentataion (revises colour swatches, adds product thumbnail and gobo swatches)" Version="25" />
  <History Date="13-04-24" Author="Nic Morris" Comment="Corrected gobo wheel 2 slot 5 dmx end value." Version="27" />
  <History Date="24-05-24" Author="Nic Morris" Comment="Created from Terbly GL750P" Version="28" />
  <History Date="28-05-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="29" />

      <Function ID="2" Name="Speed Small-&gt;Large" Display="'Speed Small-&gt;Large %.f%%',0~100" Dmx="16~55" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Speed Large-&gt;Small" Display="'Speed Large-&gt;Small %.f%%',0~100" Dmx="56~95" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Size Scaling Speed" Display="'Size Scaling Speed'" Dmx="96~135" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="2-Part Irregular Circular Scaling" Display="'2-Part Irregular Circular Scaling'" Dmx="136~175" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="3-Part Irregular Circular Scaling" Display="'3-Part Irregular Circular Scaling'" Dmx="176~215" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Quadrilateral Irregular Circular Scaling" Display="'Quadrilateral Irregular Circular Scaling'" Dmx="216~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',0~100" Dmx="128~191" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="192~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="B">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Horiz Flip Pos" Display="'Horiz Flip Pos %.1f%%',0.0~100.0" Dmx="0~127" Iris="0~0" Zoom="0~0" />

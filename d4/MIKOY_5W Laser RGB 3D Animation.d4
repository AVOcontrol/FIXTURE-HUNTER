      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Graphic_Group" Name="Graphic Group" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Group 1 (Basic Geomettry)" Display="'Group 1 (Basic Geomettry)'" Dmx="0~0" />
      <Function ID="2" Name="Group 2 (Basic Geomettry)" Display="'Group 2 (Basic Geomettry)'" Dmx="25~49" />
      <Function ID="3" Name="Group 3 (Edge Highlight Pattern)" Display="'Group 3 (Edge Highlight Pattern)'" Dmx="50~74" />
      <Function ID="4" Name="Group 4 (Dot Graphics)" Display="'Group 4 (Dot Graphics)'" Dmx="75~99" />
      <Function ID="5" Name="Group 5 (Christmas Graphics)" Display="'Group 5 (Christmas Graphics)'" Dmx="100~124" />
      <Function ID="6" Name="ILDA Animation Group 1" Display="'ILDA Animation Group 1'" Dmx="125~149" />
      <Function ID="7" Name="ILDA Animation Group 2" Display="'ILDA Animation Group 2'" Dmx="150~174" />
      <Function ID="8" Name="ILDA Animation Group 3" Display="'ILDA Animation Group 3'" Dmx="175~199" />
      <Function ID="9" Name="ILDA Animation Group 4" Display="'ILDA Animation Group 4'" Dmx="200~224" />
      <Function ID="10" Name="ILDA Animation Group 5" Display="'ILDA Animation Group 5'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="Graphic" Name="Graphic" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />

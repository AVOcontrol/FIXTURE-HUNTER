    </Attribute>
    <Attribute ID="Dynamic_FX" Name="Dynamic FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="2~206" />
      <Function ID="3" Name="Rnd Line Effect" Display="'Rnd Line Effect'" Dmx="207~216" />
      <Function ID="4" Name="Rnd Animation Effect" Display="'Rnd Animation Effect'" Dmx="217~226" />
      <Function ID="5" Name="Rnd Christmas Effect" Display="'Rnd Christmas Effect'" Dmx="227~236" />
      <Function ID="6" Name="Rnd Outdoor Effect" Display="'Rnd Outdoor Effect'" Dmx="237~246" />
      <Function ID="7" Name="Rnd All Effect" Display="'Rnd All Effect'" Dmx="247~255" />
    </Attribute>
    <Attribute ID="Dynamic_FX_Spd" Name="Dynamic FX Spd" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />

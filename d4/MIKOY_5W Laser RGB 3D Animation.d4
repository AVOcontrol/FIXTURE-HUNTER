      <Function ID="2" Name="Overall Col Change" Display="'Overall Col Change'" Dmx="70~79" Colour="0,0,0" />
      <Function ID="3" Name="Initial Col of Pattern" Display="'Initial Col of Pattern'" Dmx="80~89" Colour="0,0,0" />
      <Function ID="4" Name="Rainbow Cols" Display="'Rainbow Cols'" Dmx="90~92" Colour="0,0,0" />
      <Function ID="5" Name="2 Segment Col" Display="'2 Segment Col'" Dmx="93~110" Colour="0,0,0" />
      <Function ID="6" Name="3 Segment Col" Display="'3 Segment Col'" Dmx="111~131" Colour="0,0,0" />
      <Function ID="7" Name="4 Segment Col" Display="'4 Segment Col'" Dmx="132~149" Colour="0,0,0" />
      <Function ID="8" Name="8 Segment Col" Display="'8 Segment Col'" Dmx="150~182" Colour="0,0,0" />
      <Function ID="9" Name="16 Segment Col" Display="'16 Segment Col'" Dmx="183~218" Colour="0,0,0" />
      <Function ID="10" Name="32 Segment Col" Display="'32 Segment Col'" Dmx="219~253" Colour="0,0,0" />
      <Function ID="11" Name="Col Gradients" Display="'Col Gradients'" Dmx="254~255" Colour="0,0,0" />

      <Function ID="2" Name="Vert Flip Spd" Display="'Vert Flip Spd %.1f%%',0.0~100.0" Dmx="128~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Horiz Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Position" Display="'Position %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Tilt" Name="Vert Move" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />

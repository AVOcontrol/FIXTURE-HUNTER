    <Attribute ID="Col_Flow_Spd" Name="Col Flow Spd" Description="" Group="C">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~10" Colour="0,0,0" />

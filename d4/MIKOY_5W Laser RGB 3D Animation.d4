      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~128" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Waves" Display="'No Waves'" Dmx="0~0" />
      <Function ID="2" Name="Wave Size/Speed" Display="'Wave Size/Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Drawing" Name="Drawing" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Gradient" Display="'No Gradient'" Dmx="0~0" />
      <Function ID="2" Name="Manual Gradient 1" Display="'Manual Gradient 1'" Dmx="2~63" />
      <Function ID="3" Name="Manual Gradient 2" Display="'Manual Gradient 2'" Dmx="64~127" />
      <Function ID="4" Name="Auto Fade (Increment)" Display="'Auto Fade (Increment)'" Dmx="128~153" />
      <Function ID="5" Name="Auto Fade (Subtract)" Display="'Auto Fade (Subtract)'" Dmx="154~179" />
      <Function ID="6" Name="Auto Fade (Add First, Subtract Later-Reverse)" Display="'Auto Fade (Add First, Subtract Later-Reverse)'" Dmx="180~205" />
      <Function ID="7" Name="Auto Facet (Add Then Subtract-Same Direction)" Display="'Auto Facet (Add Then Subtract-Same Direction)'" Dmx="206~255" />
    </Attribute>
  </Control>

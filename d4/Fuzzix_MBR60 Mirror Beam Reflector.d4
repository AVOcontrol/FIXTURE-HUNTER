<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MBR60 Mirror Beam Reflector" ShortName="MBR60" Company="Fuzzix" Version="0">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>82eebe77-5139-4de9-b5e3-3977ec4d5c0c</Thumbnail>
  <History Date="26-05-25" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Rotate" Name="Rotate" Description="" Group="B">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="6~126" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="127~128" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="129~249" />
      <Function ID="5" Name="No Spin" Display="'No Spin'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="50~99" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="100~199" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="c6a27cf9-2afb-4a4c-a04d-a83033b2f70d">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Rotate" ChannelOffset="1" Wheel="19" />
      <Attribute ID="Auto" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="3" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="4" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <swatchLibrary>
    <Swatch id="82eebe77-5139-4de9-b5e3-3977ec4d5c0c"></Swatch>
  </swatchLibrary>
</Fixture>
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="36~71" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="72~107" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="108~143" />
      <Function ID="5" Name="Col Mix" Display="'Col Mix'" Dmx="144~179" />
      <Function ID="6" Name="4 Cols" Display="'4 Cols'" Dmx="180~215" />
      <Function ID="7" Name="Running Water" Display="'Running Water'" Dmx="216~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="L-Curve" Display="'L-Curve'" Dmx="0~0" />
      <Function ID="2" Name="S-Curve" Display="'S-Curve'" Dmx="64~127" />
      <Function ID="3" Name="I-Curve" Display="'I-Curve'" Dmx="128~191" />
      <Function ID="4" Name="Q-Curve" Display="'Q-Curve'" Dmx="192~255" />
    </Attribute>
  </Control>

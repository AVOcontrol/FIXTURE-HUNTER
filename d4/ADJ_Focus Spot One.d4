<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Focus Spot One" ShortName="Focus Spot" Company="ADJ" Version="3">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <History Date="08-12-16" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="05-01-17" Author="Nic Morris" Comment="Temporarily changed UV attribute ID to UV1 to solve patch exception." Version="2" />
  <History Date="06-02-25" Author="Manufacturer Renaming Utility" Comment="Changed manufacturer from American DJ to ADJ and changed filename from American DJ_Focus Spot One.d4 to ADJ_Focus Spot One.d4." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="59a8c90c-529d-4dca-9081-2eb1b59e4f85" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="5" Lowlight="3" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="10" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour1Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~29" Colour="255,0,0" />
      <Function ID="3" Name="Blue" Display="'Blue'" Dmx="30~44" Colour="0,0,255" />
      <Function ID="4" Name="Green" Display="'Green'" Dmx="45~59" Colour="0,255,0" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~74" Colour="255,255,0" />
      <Function ID="6" Name="Pink" Display="'Pink'" Dmx="75~89" Colour="255,150,150" />
      <Function ID="7" Name="Navy Blue" Display="'Navy Blue'" Dmx="90~104" Colour="0,0,180" />
      <Function ID="8" Name="Navy Green" Display="'Navy Green'" Dmx="105~119" Colour="0,180,0" />
      <Function ID="9" Name="Navy Yellow" Display="'Navy Yellow'" Dmx="120~127" Colour="180,180,0" />
      <Function ID="10" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="11" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="12" Name="Scroll CW" Display="'Scroll CW     %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="13" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="255,255,255" />
      <Function ID="14" Name="Scroll CCW" Display="'Scroll CCW    %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="15" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~19" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="20~29" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="30~39" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="40~49" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="50~59" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="60~63" WheelPosition="6" />
      <Function ID="8" Name="Open Shake" Display="'Open Shake  %.f%%',0~100" Dmx="64~73" WheelPosition="0" />
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="74~82" WheelPosition="1" />
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="83~91" WheelPosition="2" />
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="92~100" WheelPosition="3" />
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="101~109" WheelPosition="4" />
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="110~118" WheelPosition="5" />
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="119~127" WheelPosition="6" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="UV_Shutter" Name="UV Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="UV1" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="1~21" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="22~41" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="42~61" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="62~81" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="82~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Stage" Display="'Stage'" Dmx="21~40" />
      <Function ID="3" Name="TV" Display="'TV'" Dmx="41~60" />
      <Function ID="4" Name="Architectural" Display="'Architectural'" Dmx="61~80" />
      <Function ID="5" Name="Theatre" Display="'Theatre'" Dmx="81~100" />
      <Function ID="6" Name="Default" Display="'Default'" Dmx="101~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="70~79" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="90~99" />
      <Function ID="4" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="110~119" />
      <Function ID="5" Name="Split Col ON" Display="'Split Col ON'" Dmx="130~139" />
      <Function ID="6" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="15 DMX" Channels="15">

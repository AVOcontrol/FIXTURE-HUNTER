  <Thumbnail>918e3a72-1111-4460-8ad8-c07de7b7f7e6</Thumbnail>
  <History Date="04-11-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="08-11-22" Author="Nic Morris" Comment="Revised Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4ea5f61c-7567-403c-93f4-691b85587911" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="4" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="16,17" If="'Colour1Func'==3" />
      <Else ID="18" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="20~29" WheelPosition="2" Colour="255,128,0" />
      <Function ID="4" Name="Lemon Yellow" Display="'Lemon Yellow'" Dmx="30~39" WheelPosition="3" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="40~49" WheelPosition="4" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="50~59" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Pink" Display="'Pink'" Dmx="60~69" WheelPosition="6" Colour="255,150,150" />
      <Function ID="8" Name="Sky Blue" Display="'Sky Blue'" Dmx="70~79" WheelPosition="7" Colour="0,128,255" />
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="10" Name="Rd/ Org" Display="'Rd/ Org'" Dmx="130~139" WheelPosition="1" Colour="255,0,0" />
      <Function ID="11" Name="Org/ L Yel" Display="'Org/ L Yel'" Dmx="120~129" WheelPosition="2" Colour="255,128,0" />
      <Function ID="12" Name="L Yel/ Grn" Display="'L Yel/ Grn'" Dmx="110~119" WheelPosition="3" Colour="255,255,0" />
      <Function ID="13" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="100~109" WheelPosition="4" Colour="0,255,0" />
      <Function ID="14" Name="Blu/ Pk" Display="'Blu/ Pk'" Dmx="90~99" WheelPosition="5" Colour="0,0,255" />
      <Function ID="15" Name="Pk/ S Blu" Display="'Pk/ S Blu'" Dmx="80~89" WheelPosition="6" Colour="255,150,150" />
      <Function ID="16" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="140~255" Colour="0,0,0" />
      <Function ID="18" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="9,10,11,12,13,14,15,16" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="17,18" If="'Gobo1Func'==3" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>e5535707-db81-4a7f-8a86-3efd2d76ad76</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1 (Rose)" Display="'Gobo 1 (Rose)'" Dmx="8~15" WheelPosition="1">
        <Swatch>afdfa344-dc21-4c0c-b452-f68f84106207</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2 (Radial Dots)" Display="'Gobo 2 (Radial Dots)'" Dmx="16~23" WheelPosition="2">
        <Swatch>691b89d0-420f-4346-bca3-a03351e5041f</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3 (Triangle)" Display="'Gobo 3 (Triangle)'" Dmx="24~31" WheelPosition="3">
        <Swatch>59160b74-92e6-4702-a028-1347aaa20e89</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4 (Hexagon)" Display="'Gobo 4 (Hexagon)'" Dmx="32~39" WheelPosition="4">
        <Swatch>8f391be4-849e-4a99-87f0-32d262eddf9e</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5 (Swirl)" Display="'Gobo 5 (Swirl)'" Dmx="40~47" WheelPosition="5">
        <Swatch>862ad22d-c9be-40ff-bb8b-7b0cfb16a55e</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6 (Swirl)" Display="'Gobo 6 (Swirl)'" Dmx="48~55" WheelPosition="6">
        <Swatch>76f539df-814c-4c02-8832-fc855190506f</Swatch>
      </Function>
      <Function ID="8" Name="Gobo 7 (Jigsaw)" Display="'Gobo 7 (Jigsaw)'" Dmx="56~63" WheelPosition="7">
        <Swatch>1760b4e0-c9f8-406a-ad9a-55ffc040336d</Swatch>
      </Function>
      <Function ID="9" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>e5535707-db81-4a7f-8a86-3efd2d76ad76</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="1">
        <Swatch>afdfa344-dc21-4c0c-b452-f68f84106207</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="2">
        <Swatch>691b89d0-420f-4346-bca3-a03351e5041f</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="3">
        <Swatch>59160b74-92e6-4702-a028-1347aaa20e89</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="4">
        <Swatch>8f391be4-849e-4a99-87f0-32d262eddf9e</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="5">
        <Swatch>862ad22d-c9be-40ff-bb8b-7b0cfb16a55e</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="6">
        <Swatch>76f539df-814c-4c02-8832-fc855190506f</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="120~127" WheelPosition="7">
        <Swatch>1760b4e0-c9f8-406a-ad9a-55ffc040336d</Swatch>
      </Function>
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="18" Name="Scroll" Display="'Scroll %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="49~99" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="100~199" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="200~250" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="540" TiltMax="180" PanMaxSpeed="0" TiltMaxSpeed="0" />

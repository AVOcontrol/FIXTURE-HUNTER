  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Chase" Name="Chase" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~29" />
      <Function ID="2" Name="Chase 1" Display="'Chase 1'" Dmx="30~49" />
      <Function ID="3" Name="Chase 2" Display="'Chase 2'" Dmx="50~69" />
      <Function ID="4" Name="Chase 3" Display="'Chase 3'" Dmx="70~89" />

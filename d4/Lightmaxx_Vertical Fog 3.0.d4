  <Thumbnail>49f1a46f-374c-4c44-a4e0-13dbb0826865</Thumbnail>
  <History Date="29-12-25" Author="Nic Morris" Comment="Created (9 channel mode charts contain a 'White' control but according to the specs it is just RGB.  assumed this is actually a dimmer...)" Version="0" />
  <History Date="09-01-26" Author="Nic Morris" Comment="Revised colours in response to customer feedback (these are contrary to the documentation)" Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="77abf8c2-8bbb-4b3e-a17e-e60f68e446e2" />
  <Control>
    <Attribute ID="Fog" Name="Fog" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Output" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Inner Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Inner Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Inner Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Inner_Shutter" Name="Inner Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Inner_Colour" Name="Inner Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~36" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="37~56" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="57~76" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="77~96" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="97~116" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="117~136" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="137~156" Colour="255,255,255" />
      <Function ID="9" Name="RGB Col Change Slow" Display="'RGB Col Change Slow'" Dmx="157~176" Colour="0,0,0" />
      <Function ID="10" Name="7 Col Change Slow" Display="'7 Col Change Slow'" Dmx="177~196" Colour="0,0,0" />
      <Function ID="11" Name="RGB Col Change Fast" Display="'RGB Col Change Fast'" Dmx="197~216" Colour="0,0,0" />
      <Function ID="12" Name="7 Col Change Fast" Display="'7 Col Change Fast'" Dmx="217~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Outer_Colour" Name="Outer Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~50" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="51~85" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="86~120" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="121~155" Colour="255,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="156~190" Colour="0,255,255" />
      <Function ID="7" Name="Magenta" Display="'Magenta'" Dmx="191~225" Colour="255,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="226~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Outer_Change" Name="Outer Change" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Colour Change" Display="'Colour Change %.1f%%',0.0~100.0" Dmx="16~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="3d6f0309-2ac6-4c54-8736-f35ec4835a49">

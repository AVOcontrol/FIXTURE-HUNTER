<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SPC062 LED Marquee Light" ShortName="SPC062" Company="SSP">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="13-10-16" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Speed" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="31~40" Update="Speed" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="41~50" Update="Speed" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~60" Update="Speed" Colour="0,0,255" />
      <Function ID="5" Name="Cyan" Display="'Cyan'" Dmx="61~70" Update="Speed" Colour="0,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="71~80" Update="Speed" Colour="255,255,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="81~90" Update="Speed" Colour="128,0,255" />
      <Function ID="8" Name="White" Display="'White'" Dmx="91~100" Update="Speed" Colour="255,255,255" />
      <Function ID="9" Name="Mode 1" Display="'Mode 1'" Dmx="101~110" Update="Speed" Colour="255,250,230" />
      <Function ID="10" Name="Mode 2" Display="'Mode 2'" Dmx="111~120" Update="Speed" Colour="255,250,230" />
      <Function ID="11" Name="Mode 3" Display="'Mode 3'" Dmx="121~130" Update="Speed" Colour="255,250,230" />
      <Function ID="12" Name="Mode 4" Display="'Mode 4'" Dmx="131~140" Update="Speed" Colour="255,250,230" />
      <Function ID="13" Name="Mode 5" Display="'Mode 5'" Dmx="141~150" Update="Speed" Colour="255,250,230" />
      <Function ID="14" Name="Mode 6" Display="'Mode 6'" Dmx="151~160" Update="Speed" Colour="255,250,230" />
      <Function ID="15" Name="Mode 7" Display="'Mode 7'" Dmx="161~170" Update="Speed" Colour="255,250,230" />
      <Function ID="16" Name="Mode 8" Display="'Mode 8'" Dmx="171~180" Update="Speed" Colour="255,250,230" />
      <Function ID="17" Name="Mode 9" Display="'Mode 9'" Dmx="181~190" Update="Speed" Colour="255,250,230" />
      <Function ID="18" Name="Mode 10" Display="'Mode 10'" Dmx="191~200" Update="Speed" Colour="255,250,230" />
      <Function ID="19" Name="Mode 11" Display="'Mode 11'" Dmx="201~210" Update="Speed" Colour="255,250,230" />
      <Function ID="20" Name="Mode 12" Display="'Mode 12'" Dmx="211~220" Update="Speed" Colour="255,250,230" />
      <Function ID="21" Name="Sound 1" Display="'Sound 1'" Dmx="221~230" Update="Speed" Colour="255,250,230" />
      <Function ID="22" Name="Sound 2" Display="'Sound 2'" Dmx="231~240" Update="Speed" Colour="255,250,230" />
      <Function ID="23" Name="Sound 3" Display="'Sound 3'" Dmx="241~255" Update="Speed" Colour="255,250,230" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;8&amp;&amp;'Colour_Macro'&lt;21" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'&gt;20" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1" Channels="4">
    <Import PearlRef="UKSSP621" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>

  <History Date="12-04-19" Author="Nic Morris" Comment="Created (draft DMX Channels 02/2019 charts)" Version="1" />
  <History Date="01-10-19" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="01-01-20" Author="Nic Morris" Comment="Fixed missing dimmer links in Extended RGB mode in attempt to solve customer bug report.  Added physical pan/tilt ranges." Version="3" />
  <History Date="18-12-20" Author="Nic Morris" Comment="Updated in line with latest charts (2020-12-04) in response to manufacturer request (adds Colour xFade and additional control functions)" Version="4" />
  <History Date="23-05-22" Author="Nic Morris" Comment="Updated in line with latest charts (12/2021.  adds col cal control functions/macros.  revises various control function DMX ranges)" Version="5" />
  <History Date="30-11-22" Author="Nic Morris" Comment="Updated in line with latest charts (06/2022.  revises various function functions/macros again)" Version="6" />
  <History Date="08-03-23" Author="Nic Morris" Comment="Created from Clay Paky MINI B" Version="7" />
  <History Date="11-03-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="8" />
  <History Date="12-03-23" Author="Nic Morris" Comment="Changed colour crossfade to default at 0 (100%) in response to customer feedback.  It is not clear from the documentation what this control does." Version="9" />
  <History Date="09-07-24" Author="Nic Morris" Comment="Created from Uplus Lighting MINI 740 v3 (identical)" Version="10" />
  <History Date="10-07-24" Author="Nic Morris" Comment="Added Atlabase ID's." Version="11" />
  <History Date="11-07-24" Author="Nic Morris" Comment="Swapped 21 channel mode Atlabase ID's (it isn't clear which is which)" Version="12" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1f9f4a72-9965-46f7-b27c-2d38a1fe45c4" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:8500" PowerOn="1:8500" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.fK',2800~8500" Dmx="255~0" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_xFade" Name="Colour xFade" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset" Display="'Reset'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
  </Control>

      <Function ID="11" Name="Chase 9" Display="'Chase 9'" Dmx="100~109" />
      <Function ID="12" Name="Chase 10" Display="'Chase 10'" Dmx="110~119" />
      <Function ID="13" Name="Chase 11" Display="'Chase 11'" Dmx="120~129" />
      <Function ID="14" Name="Chase 12" Display="'Chase 12'" Dmx="130~139" />
      <Function ID="15" Name="Chase 13" Display="'Chase 13'" Dmx="140~149" />
      <Function ID="16" Name="Chase 14" Display="'Chase 14'" Dmx="150~159" />
      <Function ID="17" Name="Chase 15" Display="'Chase 15'" Dmx="160~169" />
      <Function ID="18" Name="Chase 16" Display="'Chase 16'" Dmx="170~179" />
      <Function ID="19" Name="Chase 17" Display="'Chase 17'" Dmx="180~189" />
      <Function ID="20" Name="Chase 18" Display="'Chase 18'" Dmx="190~199" />
      <Function ID="21" Name="Chase 19" Display="'Chase 19'" Dmx="200~209" />
      <Function ID="22" Name="Chase 20" Display="'Chase 20'" Dmx="210~219" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="220~239" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Chase_Spd" Name="Chase Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

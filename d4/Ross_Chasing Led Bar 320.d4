  <AtlaBase TypeID="6b2a24f6-7567-43ba-b99d-95cb0058a813" />
  <Control>
    <Attribute ID="Chase" Name="Chase" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Chase" Display="'No Chase'" Dmx="0~0" />
      <Function ID="2" Name="Macro" Display="'Macro'" Dmx="10~19" />
      <Function ID="3" Name="Chase 1" Display="'Chase 1'" Dmx="20~29" />
      <Function ID="4" Name="Chase 2" Display="'Chase 2'" Dmx="30~39" />
      <Function ID="5" Name="Chase 3" Display="'Chase 3'" Dmx="40~49" />
      <Function ID="6" Name="Chase 4" Display="'Chase 4'" Dmx="50~59" />
      <Function ID="7" Name="Chase 5" Display="'Chase 5'" Dmx="60~69" />
      <Function ID="8" Name="Chase 6" Display="'Chase 6'" Dmx="70~79" />
      <Function ID="9" Name="Chase 7" Display="'Chase 7'" Dmx="80~89" />

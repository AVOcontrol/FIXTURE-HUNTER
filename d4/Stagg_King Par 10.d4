<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="King Par 10" ShortName="King Par10" Company="Stagg">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="01-05-13" Author="Peter Budd" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="0df31c55-a7ea-4f0c-a5f7-61783a2b5426" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~35" Colour="255,255,255" />
      <Function ID="2" Name="Fade" Display="'Fade'" Dmx="36~55" Colour="0,0,0" />
      <Function ID="3" Name="Pulse" Display="'Pulse'" Dmx="56~75" Colour="0,0,0" />
      <Function ID="4" Name="Changer" Display="'Changer'" Dmx="76~95" Colour="0,0,0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse'" Dmx="96~115" Colour="0,0,0" />
      <Function ID="6" Name="Slow In" Display="'Slow In'" Dmx="116~135" Colour="0,0,0" />
      <Function ID="7" Name="Strobe In" Display="'Strobe In'" Dmx="136~155" Colour="0,0,0" />
      <Function ID="8" Name="Fast In" Display="'Fast In'" Dmx="156~175" Colour="0,0,0" />
      <Function ID="9" Name="Strobe In" Display="'Strobe In'" Dmx="176~195" Colour="0,0,0" />
      <Function ID="10" Name="Strobe Change" Display="'Strobe Change'" Dmx="196~215" Colour="0,0,0" />
      <Function ID="11" Name="Sound 1" Display="'Sound 1'" Dmx="216~235" Colour="0,0,0" />
      <Function ID="12" Name="Sound 2" Display="'Sound 2'" Dmx="236~255" Colour="0,0,0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX, 8bit" Channels="3">
    <Import PearlRef="SA_KPar10_3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c02afe59-db1a-4b6c-a0f4-5c63a66bd340" />
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="6 DMX, 8bit" Channels="6">
    <Import PearlRef="SA_KPar10_6" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

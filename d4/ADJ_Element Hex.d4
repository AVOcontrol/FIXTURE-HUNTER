    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="64~95" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~223" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="128~159" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Program Sel" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Colour1, Speed" />
      <Function ID="2" Name="Col Macro" Display="'Col Macro'" Dmx="52~102" Update="Colour1, Speed" />
      <Function ID="3" Name="Col Change" Display="'Col Change'" Dmx="103~153" Update="Colour1, Speed" />
      <Function ID="4" Name="Col Fade" Display="'Col Fade'" Dmx="154~204" Update="Colour1, Speed" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="205~255" Update="Colour1, Speed" />
    </Attribute>

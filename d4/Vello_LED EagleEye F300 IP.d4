      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="2000-10000K" Display="'2000-10000K %.fK',2000~10000" Dmx="5~255" Colour="0,0,0" />

    </Attribute>
    <Attribute ID="Spot_Shutter" Name="Spot Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Fade Strobe" Display="'Fade Strobe %.f%%',0~100" Dmx="4~99" />
      <Function ID="3" Name="Rand Strobe" Display="'Rand Strobe %.f%%',0~100" Dmx="200~249" />
      <Function ID="4" Name="Pulse Strobe" Display="'Pulse Strobe %.f%%',0~100" Dmx="100~149" />

<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="PAR COB 200W LED TW" ShortName="COB200W TW" Company="FOS">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-11-17" Author="Nic Morris" Comment="Created" />
  <History Date="14-11-17" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="da3dfb78-8389-4c8b-aabd-be422cf471b4" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="4~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Chase" Display="'Col Chase'" Dmx="51~100" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="101~150" />
      <Function ID="4" Name="Col Pulse" Display="'Col Pulse'" Dmx="151~200" />
      <Function ID="5" Name="Freeze" Display="'Freeze'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
  </Control>
  <Mode Name="b2CH, 2 DMX" Channels="2">
    <Import PearlRef="UKFOSPC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="11bf9bed-5b79-4454-b724-5ee4bd4db70e" />
    <Include>
      <Attribute ID="WarmWhite" ChannelOffset="1" Wheel="7" VirtualControl="Dimmer" />
      <Attribute ID="ColdWhite" ChannelOffset="2" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="A2CH, 2 DMX" Channels="2">
    <Import PearlRef="UKFOSPC2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />

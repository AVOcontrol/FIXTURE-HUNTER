<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="HMH 285" ShortName="HMH 285" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>98279ead-0a2d-4ff3-bccd-1c8af18c7fff</Thumbnail>
  <History Date="20-09-11" Author="John Rogers" Comment="Created" />
  <History Date="06-10-11" Author="Nic Morris" Comment="Simplified shutter.  Fixed Aura Colour update and conditionals.  Added macros." />
  <History Date="14-10-11" Author="John Rogers" Comment="Added 14 DMX mode." />
  <History Date="25-11-11" Author="John Rogers" Comment="Added display name." />
  <History Date="13-03-12" Author="Peter Budd" Comment="Unhid Cells called them Beam and Aura." />
  <History Date="04-05-12" Author="Peter Budd" Comment="Added a physical pan tilt speed from the Robe 300LED Wash" />
  <History Date="17-05-12" Author="Gregory Haynes" Comment="Renamed cells to 'Beam Part' and 'Aura Part'" />
  <History Date="19-11-12" Author="Peter Budd" Comment="Updated to bring P/T, Zoom, Effects and Control channels back into master fixture in 25 DMX mode." />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="20-03-14" Author="Nic Morris" Comment="Changed 25 DMX pearl ref to match 14 DMX for vis" />
  <History Date="01-07-14" Author="Peter Budd" Comment="Ended the cell with a number so the 25 DMX  mode will exchange in 7." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="07-07-16" Author="Nic Morris" Comment="Created from Martin MAC Aura (identical)" />
  <History Date="07-07-16" Author="Nic Morris" Comment="Removed faulty reset condition from dimmer.  Removed all attribute links from aura cell." />
  <History Date="05-03-18" Author="Nic Morris" Comment="Temporarily removed Atlabase ID's as they were pointing to the Martin MAC Aura." />
  <History Date="05-03-18" Author="Nic Morris" Comment="Added product thumbnail.  Reinstated aura cell links for compatibility.  Removed RDM ID's" />
  <History Date="14-03-18" Author="Nic Morris" Comment="Added revised Atlabase ID's (main modes only)" />
  <History Date="10-04-19" Author="Nic Morris" Comment="Created from Diapro ColorWash 5 (poor documentation. Effect channel details missing - assumed identical)" />
  <History Date="12-04-19" Author="Nic Morris" Comment="Added Atlabase ID's (25 DMX mode only at the moment)" />
  <History Date="13-04-19" Author="Nic Morris" Comment="Added missing Atlabase ID to 14 DMX mode." />
  <Manual Filename="" Summary="" />

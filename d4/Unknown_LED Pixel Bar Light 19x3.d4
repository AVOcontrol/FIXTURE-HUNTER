  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="08-03-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Auto" Name="Auto" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Individual Control" Display="'Individual Control'" Dmx="48~63" />
      <Function ID="3" Name="LED Chase" Display="'LED Chase'" Dmx="64~79" />
      <Function ID="4" Name="LED Run" Display="'LED Run'" Dmx="80~95" />
      <Function ID="5" Name="LED Jump" Display="'LED Jump'" Dmx="96~111" />
      <Function ID="6" Name="LED Edacity" Display="'LED Edacity'" Dmx="112~127" />
      <Function ID="7" Name="LED Grouping" Display="'LED Grouping'" Dmx="128~143" />
      <Function ID="8" Name="Image 1" Display="'Image 1'" Dmx="144~159" />
      <Function ID="9" Name="Image 2" Display="'Image 2'" Dmx="160~175" />
      <Function ID="10" Name="Image 3" Display="'Image 3'" Dmx="176~191" />
      <Function ID="11" Name="Image 4" Display="'Image 4'" Dmx="192~207" />
      <Function ID="12" Name="Image 5" Display="'Image 5'" Dmx="208~223" />
      <Function ID="13" Name="Image 6" Display="'Image 6'" Dmx="224~239" />
      <Function ID="14" Name="Total Program" Display="'Total Program'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Auto_Speed" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Master_Red" Name="Master Red" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Master_Green" Name="Master Green" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Master_Blue" Name="Master Blue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>

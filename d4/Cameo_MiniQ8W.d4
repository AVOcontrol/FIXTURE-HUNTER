<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="MiniQ8W" ShortName="MiniParCan" Company="Cameo">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="23-06-14" Author="Stephen harris" Comment="Created" />
  <History Date="25-06-14" Author="Peter Budd" Comment="Checked and fixed channel layout." />
  <Manual Filename="" Summary="Cameo LED Mini Par Can" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour" Name="Colour" Description="" Group="C">
      <Locate Locate="5" PowerOn="1" Highlight="6" Lowlight="4" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="26~30" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="31~35" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="36~40" Colour="255,0,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="41~45" Colour="255,150,150" />
      <Function ID="10" Name="Bright Green" Display="'Bright Green'" Dmx="46~50" Colour="128,255,0" />
      <Function ID="11" Name="Lavender" Display="'Lavender'" Dmx="51~55" Colour="255,0,127" />
      <Function ID="12" Name="Pale Pink" Display="'Pale Pink'" Dmx="56~60" Colour="255,200,200" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="61~65" Colour="255,100,0" />
      <Function ID="14" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="66~70" Colour="255,128,255" />
      <Function ID="15" Name="Pale Cyan" Display="'Pale Cyan'" Dmx="71~75" Colour="128,255,255" />
      <Function ID="16" Name="Warm White" Display="'Warm White'" Dmx="76~80" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="81~150" Colour="0,0,0" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="151~220" Colour="0,0,0" />
      <Function ID="19" Name="Sound Control" Display="'Sound Control %.f%%',0~100" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Black" Display="'Black'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~10" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="11~15" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="16~20" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="21~25" Colour="255,255,255" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="26~30" Colour="255,255,0" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="31~35" Colour="0,255,255" />
      <Function ID="8" Name="Magenta" Display="'Magenta'" Dmx="36~40" Colour="255,0,255" />
      <Function ID="9" Name="Pink" Display="'Pink'" Dmx="41~45" Colour="255,150,150" />
      <Function ID="10" Name="Bright Green" Display="'Bright Green'" Dmx="46~50" Colour="128,255,0" />
      <Function ID="11" Name="Lavender" Display="'Lavender'" Dmx="51~55" Colour="255,0,127" />
      <Function ID="12" Name="Pale Pink" Display="'Pale Pink'" Dmx="56~60" Colour="255,200,200" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="61~65" Colour="255,100,0" />
      <Function ID="14" Name="Bright Magenta" Display="'Bright Magenta'" Dmx="66~70" Colour="255,128,255" />
      <Function ID="15" Name="Pale Cyan" Display="'Pale Cyan'" Dmx="71~75" Colour="128,255,255" />
      <Function ID="16" Name="Warm White" Display="'Warm White'" Dmx="76~80" Colour="255,255,255" />
      <Function ID="17" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="81~150" Colour="0,0,0" />
      <Function ID="18" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="151~220" Colour="0,0,0" />
      <Function ID="19" Name="Sound Control" Display="'Sound Control %.f%%',0~100" Dmx="221~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Strobe" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX, 8bit" Channels="2">
    <Import PearlRef="UK_CamMQ8W2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Colour" ChannelOffset="2" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX Mode 1" Channels="3">
    <Import PearlRef="UK_CamMQ8W3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Strobe" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Colour" ChannelOffset="3" Wheel="7" />
    </Include>
  </Mode>
  <Mode Name="3 DMX Mode 2" Channels="3">
    <Import PearlRef="Gen_RGB3DMX" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="4 DMX, 8bit" Channels="4">
    <Import PearlRef="UK_CamMQ8W4" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="7 DMX, 8bit" Channels="7">
    <Import PearlRef="UK_CamMQ8W7" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Strobe" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="3" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="4" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="5" Wheel="12" />
      <Attribute ID="White" ChannelOffset="6" Wheel="9" />
      <Attribute ID="Colour1" ChannelOffset="7" Wheel="8" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Shutter" />
  </Palettes>
</Fixture>
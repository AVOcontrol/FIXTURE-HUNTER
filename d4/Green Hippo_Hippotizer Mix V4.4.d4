    <Attribute ID="Effect2Level" Name="Effect 2 Level" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Level" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Eff2Param1" Name="Eff 2 Param 1" Description="" Group="G">
      <Locate Locate="64:128" PowerOn="64:128" />
      <Condition Name="Amount" ID="1" If="'Effect2'==2" />
      <Condition Name="Mask" ID="2" If="'Effect2'==6" />
      <Condition Name="Saturation" ID="3" If="'Effect2'==17" />
      <Condition Name="Size" ID="4" If="'Effect2'==28||'Effect2'==33||'Effect2'==75||'Effect2'==98||'Effect2'==106" />
      <Condition Name="Threshold" ID="5" If="'Effect2'==34" />
      <Condition Name="X" ID="6" If="'Effect2'==8||'Effect2'==12||'Effect2'==46||'Effect2'==74||'Effect2'==96" />
      <Condition Name="Left" ID="7" If="'Effect2'==9||'Effect2'==60" />
      <Condition Name="Hue" ID="8" If="'Effect2'==10||'Effect2'==26||'Effect2'==87" />
      <Condition Name="Squash X" ID="9" If="'Effect2'==11" />
      <Condition Name="Red" ID="10" If="'Effect2'==13||'Effect2'==19||'Effect2'==36" />
      <Condition Name="Shift A" ID="11" If="'Effect2'==14" />
      <Condition Name="Frequency" ID="12" If="'Effect2'==15||'Effect2'==53||'Effect2'==83" />
      <Condition Name="Width" ID="13" If="'Effect2'==16||'Effect2'==49||'Effect2'==85" />
      <Condition Name="Filter" ID="14" If="'Effect2'==110" />
      <Condition Name="Col 1" ID="15" If="'Effect2'==18" />
      <Condition Name="Bloom" ID="16" If="'Effect2'==20" />
      <Condition Name="Stripes" ID="17" If="'Effect2'==21" />
      <Condition Name="Mymul" ID="18" If="'Effect2'==22" />
      <Condition Name="K1" ID="19" If="'Effect2'==23" />
      <Condition Name="Zoom" ID="20" If="'Effect2'==24||'Effect2'==55" />
      <Condition Name="Colouredness" ID="21" If="'Effect2'==25" />
      <Condition Name="Rings" ID="22" If="'Effect2'==27" />
      <Condition Name="Bump" ID="23" If="'Effect2'==29" />
      <Condition Name="Density" ID="24" If="'Effect2'==30" />
      <Condition Name="Pixels" ID="25" If="'Effect2'==31" />
      <Condition Name="Flicker" ID="26" If="'Effect2'==32" />
      <Condition Name="Shift X" ID="27" If="'Effect2'==80||'Effect2'==81||'Effect2'==99||'Effect2'==105" />
      <Condition Name="Blue2Red" ID="28" If="'Effect2'==35" />

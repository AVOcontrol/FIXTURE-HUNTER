    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Col Fade" ID="2" If="'Effect'&gt;1&amp;&amp;'Effect'&lt;28" />
      <Condition Name="Pattern Spd" ID="3,4" If="'Effect'&gt;28&amp;&amp;'Effect'&lt;40" />
      <Else ID="1" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Fade Time" Display="'%.2f Sec',0.00~5.00" Dmx="0~255" />
      <Function ID="3" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="0~127" />
      <Function ID="4" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>

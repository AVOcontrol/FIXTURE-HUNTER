<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ovation F-145WW" ShortName="Ov F-145WW" Company="Chauvet" Version="3">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <Thumbnail>fcddafc6-f5ae-4998-94db-cb492715c342</Thumbnail>
  <History Date="19-10-19" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="15-11-22" Author="Nic Morris" Comment="Added 6 channel 16bit-Full mode in line with latest documentation.  Added 'Legacy' to original 5 channel version to distinguish." Version="2" />
  <History Date="18-11-22" Author="Nic Morris" Comment="Added 6 channel mode Atlabase ID." Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="1d5b80ee-931c-432a-a81a-a4a48531736f" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Motor_Reset" Name="Motor Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Motor" Display="'Reset Motor'" Dmx="201~220" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset Dimmer" Display="'Reset Dimmer'" Dmx="8~15" />
      <Function ID="3" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="16~23" />
      <Function ID="4" Name="Dim Linear" Display="'Dim Linear'" Dmx="24~31" />
      <Function ID="5" Name="Dim Square" Display="'Dim Square'" Dmx="32~39" />
      <Function ID="6" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="40~47" />
      <Function ID="7" Name="Dim Spd Mode Off" Display="'Dim Spd Mode Off'" Dmx="48~55" />
      <Function ID="8" Name="Dim Spd Mode 1" Display="'Dim Spd Mode 1'" Dmx="56~63" />
      <Function ID="9" Name="Dim Spd Mode 2" Display="'Dim Spd Mode 2'" Dmx="64~71" />
      <Function ID="10" Name="Dim Spd Mode 3" Display="'Dim Spd Mode 3'" Dmx="72~79" />
      <Function ID="11" Name="Fan Auto" Display="'Fan Auto'" Dmx="80~87" />
      <Function ID="12" Name="Fan On" Display="'Fan On'" Dmx="88~95" />
      <Function ID="13" Name="Fan Off" Display="'Fan Off'" Dmx="96~103" />
      <Function ID="14" Name="Fan Silent" Display="'Fan Silent'" Dmx="104~111" />
    </Attribute>
  </Control>
  <Mode Name="16bit-Full, 6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d0046c6d-337e-41dd-a95e-ed5fc2f8d8e6" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Motor_Reset" ChannelOffset="5" Wheel="28" />
      <Attribute ID="Control" ChannelOffset="6" Wheel="29" />
    </Include>
  </Mode>
  <Mode Name="16bit-Full (Legacy), 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2a681437-3816-45ec-a898-8377824f1b5c" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="Motor_Reset" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="8bit Dim+Zoom, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="62838861-2f0e-4679-ae47-b3cb0a03d047" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Zoom" ChannelOffset="2" Wheel="19" />
    </Include>
  </Mode>
  <Mode Name="16bit Dim, 2 DMX" Channels="2">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="d8d448a2-78c8-4a6c-9fc6-e811c1af5d10" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="8bit Dim, 1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="cb1c4d4b-25ce-4766-b0c1-92c12a5addf5" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Motor">
      <Set Channel="Motor_Reset:2" Delay="6000" />
      <Set Channel="Motor_Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Dimmer">
      <Set Channel="Control:2" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim S-Curve">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Linear">
      <Set Channel="Control:4" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Square">
      <Set Channel="Control:5" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Inv Square">
      <Set Channel="Control:6" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Mode Off">
      <Set Channel="Control:7" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Mode 1">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Mode 2">
      <Set Channel="Control:9" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Spd Mode 3">
      <Set Channel="Control:10" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control:11" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan On">
      <Set Channel="Control:12" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Off">
      <Set Channel="Control:13" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Silent">
      <Set Channel="Control:14" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b1b5c001-a4d5-4c53-beff-21e4a0bef1fb" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Macro" Display="'Macro %.1f%%',0.0~100.0" Dmx="10~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="70~109" />
      <Function ID="3" Name="Reset" Display="'Reset'" Dmx="130~149" />
      <Function ID="4" Name="Auto" Display="'Auto'" Dmx="170~189" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~29" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~49" Colour="255,255,255" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="50~69" Colour="255,255,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="70~89" Colour="255,255,255" />
      <Function ID="6" Name="Rainbow" Display="'Rainbow %.f%%',0~100" Dmx="90~169" Colour="255,255,255" />
      <Function ID="7" Name="White Strobe" Display="'White Strobe %.f%%',0~100" Dmx="170~249" Colour="255,255,255" />
      <Function ID="8" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="250~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="P/T_Macro" Name="P/T Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 3" Display="'Macro 3'" Dmx="16~44" />
      <Function ID="3" Name="Macro 2" Display="'Macro 2'" Dmx="45~74" />
      <Function ID="4" Name="Macro 1" Display="'Macro 1'" Dmx="75~104" />
      <Function ID="5" Name="Macro 0" Display="'Macro 0'" Dmx="105~128" />
      <Function ID="6" Name="Sound 3" Display="'Sound 3'" Dmx="129~157" />
      <Function ID="7" Name="Sound 2" Display="'Sound 2'" Dmx="158~187" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="188~217" />
      <Function ID="9" Name="Sound 0" Display="'Sound 0'" Dmx="218~255" />
    </Attribute>
    <Attribute ID="P/T_Mac_Spd" Name="P/T Mac Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Gradual Change" Display="'Gradual Change'" Dmx="1~7" />
      <Function ID="3" Name="Auto 1" Display="'Auto 1'" Dmx="8~39" />
      <Function ID="4" Name="Auto 2" Display="'Auto 2'" Dmx="40~72" />
      <Function ID="5" Name="Auto 3" Display="'Auto 3'" Dmx="73~105" />
      <Function ID="6" Name="Auto 4" Display="'Auto 4'" Dmx="106~138" />
      <Function ID="7" Name="Auto 5" Display="'Auto 5'" Dmx="139~140" />
      <Function ID="8" Name="Sound 1" Display="'Sound 1'" Dmx="141~167" />
      <Function ID="9" Name="Sound 2" Display="'Sound 2'" Dmx="168~195" />
      <Function ID="10" Name="Sound 3" Display="'Sound 3'" Dmx="196~223" />
      <Function ID="11" Name="Sound 4" Display="'Sound 4'" Dmx="224~251" />
      <Function ID="12" Name="Sound 5" Display="'Sound 5'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">

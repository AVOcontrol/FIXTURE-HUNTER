<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Equinox DJ Booth Tri-colour Starcloth" ShortName="Tri SCloth" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="05-04-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~14" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="15~29" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="30~44" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="45~59" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="60~74" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="75~89" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="90~104" Colour="0,255,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="105~119" Colour="255,150,150" />
      <Function ID="9" Name="Dark Orange" Display="'Dark Orange'" Dmx="120~134" Colour="255,100,0" />
      <Function ID="10" Name="Light Yellow" Display="'Yellow'" Dmx="135~149" Colour="255,255,128" />
      <Function ID="11" Name="Light Purple" Display="'Light Purple'" Dmx="150~164" Colour="180,0,180" />
      <Function ID="12" Name="Gold" Display="'Gold'" Dmx="165~179" Colour="255,128,0" />
      <Function ID="13" Name="Light Green" Display="'Light Green'" Dmx="180~194" Colour="128,255,0" />
      <Function ID="14" Name="Light Pink" Display="'Light Pink'" Dmx="195~209" Colour="255,200,200" />
      <Function ID="15" Name="Dark Purple" Display="'Dark Purple'" Dmx="210~224" Colour="180,0,255" />
      <Function ID="16" Name="Orange" Display="'Orange'" Dmx="225~239" Colour="255,128,0" />
      <Function ID="17" Name="White" Display="'White'" Dmx="240~254" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Static 1" Display="'Static 1'" Dmx="0~9" />
      <Function ID="2" Name="Static 2" Display="'Static 2'" Dmx="10~19" />
      <Function ID="3" Name="Static 3" Display="'Static 3'" Dmx="20~29" />
      <Function ID="4" Name="Static 4" Display="'Static 4'" Dmx="30~39" />
      <Function ID="5" Name="Static 5" Display="'Static 5'" Dmx="40~49" />
      <Function ID="6" Name="Static 6" Display="'Static 6'" Dmx="50~59" />
      <Function ID="7" Name="Static 7" Display="'Static 7'" Dmx="60~69" />
      <Function ID="8" Name="Static 8" Display="'Static 8'" Dmx="70~79" />
      <Function ID="9" Name="Static Cycle" Display="'Static Cycle'" Dmx="80~119" />
      <Function ID="10" Name="Multi 1" Display="'Multi 1'" Dmx="120~129" />
      <Function ID="11" Name="Multi 2" Display="'Multi 2'" Dmx="130~139" />
      <Function ID="12" Name="Multi 3" Display="'Multi 3'" Dmx="140~149" />
      <Function ID="13" Name="Multi 4" Display="'Multi 4'" Dmx="150~159" />
      <Function ID="14" Name="Multi 5" Display="'Multi 5'" Dmx="160~169" />
      <Function ID="15" Name="Multi 6" Display="'Multi 6'" Dmx="170~179" />
      <Function ID="16" Name="Multi 7" Display="'Multi 7'" Dmx="180~189" />
      <Function ID="17" Name="Multi 8" Display="'Multi 8'" Dmx="190~199" />
      <Function ID="18" Name="Multi 9" Display="'Multi 9'" Dmx="200~209" />
      <Function ID="19" Name="Multi Cycle" Display="'Multi Cycle'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~200" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour " Display="'Colour'" Dmx="0~9" Colour="0,0,0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~19" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="20~29" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="30~39" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="40~49" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="50~59" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="60~69" Colour="0,255,255" />
      <Function ID="8" Name="Pink" Display="'Pink'" Dmx="70~79" Colour="255,150,150" />
      <Function ID="9" Name="Amber" Display="'Amber'" Dmx="80~89" Colour="255,100,0" />
      <Function ID="10" Name="Light Yellow" Display="'Yellow'" Dmx="90~99" Colour="255,255,128" />
      <Function ID="11" Name="Light Purple" Display="'Light Purple'" Dmx="100~109" Colour="180,0,180" />
      <Function ID="12" Name="White" Display="'White'" Dmx="110~119" Colour="255,255,255" />
      <Function ID="13" Name="Pattern 1" Display="'Pattern 1'" Dmx="120~129" Colour="255,255,255" />
      <Function ID="14" Name="Pattern 2" Display="'Pattern 2'" Dmx="130~139" Colour="255,255,255" />
      <Function ID="15" Name="Pattern 3" Display="'Pattern 3'" Dmx="140~149" Colour="255,255,255" />
      <Function ID="16" Name="Pattern 4" Display="'Pattern 4'" Dmx="150~159" Colour="255,255,255" />
      <Function ID="17" Name="Pattern 5" Display="'Pattern 5'" Dmx="160~169" Colour="255,255,255" />
      <Function ID="18" Name="Pattern 6" Display="'Pattern 6'" Dmx="170~179" Colour="255,255,255" />
      <Function ID="19" Name="Pattern 7" Display="'Pattern 7'" Dmx="180~189" Colour="255,255,255" />
      <Function ID="20" Name="Pattern 8" Display="'Pattern 8'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="21" Name="Pattern 9" Display="'Pattern 9'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="22" Name="Cycle" Display="'Cycle'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="220~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~9" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" />
    </Attribute>
    <Attribute ID="Pattern_Spd" Name="Pattern Spd" Description="" Group="S">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Static_Pattern" Name="Static Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern 1" Display="'Pattern 1'" Dmx="0~29" />
      <Function ID="2" Name="Pattern 2" Display="'Pattern 2'" Dmx="30~59" />
      <Function ID="3" Name="Pattern 3" Display="'Pattern 3'" Dmx="60~89" />
      <Function ID="4" Name="Pattern 4" Display="'Pattern 4'" Dmx="90~119" />
      <Function ID="5" Name="Pattern 5" Display="'Pattern 5'" Dmx="120~149" />
      <Function ID="6" Name="Pattern 6" Display="'Pattern 6'" Dmx="150~179" />
      <Function ID="7" Name="Pattern 7" Display="'Pattern 7'" Dmx="180~209" />
      <Function ID="8" Name="Pattern 8" Display="'Pattern 8'" Dmx="210~239" />
      <Function ID="9" Name="Cycle" Display="'Cycle'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Mixed_Pattern" Name="Mixed Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Pattern 1" Display="'Pattern 1'" Dmx="0~29" />
      <Function ID="2" Name="Pattern 2" Display="'Pattern 2'" Dmx="30~59" />
      <Function ID="3" Name="Pattern 3" Display="'Pattern 3'" Dmx="60~89" />
      <Function ID="4" Name="Pattern 4" Display="'Pattern 4'" Dmx="90~119" />
      <Function ID="5" Name="Pattern 5" Display="'Pattern 5'" Dmx="120~149" />
      <Function ID="6" Name="Pattern 6" Display="'Pattern 6'" Dmx="150~179" />
      <Function ID="7" Name="Pattern 7" Display="'Pattern 7'" Dmx="180~209" />
      <Function ID="8" Name="Cycle" Display="'Cycle'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="PTEQTCS3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="8" />
      <Attribute ID="Effect" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Effect_Spd" ChannelOffset="3" Wheel="23" />
    </Include>
  </Mode>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="PTEQTCS8" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Static_Pattern" ChannelOffset="7" Wheel="52" />
      <Attribute ID="Mixed_Pattern" ChannelOffset="8" Wheel="53" />
      <Attribute ID="Col_Mac_Spd" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Pattern_Spd" ChannelOffset="3" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
        <Attribute ID="Col_Mac_Spd" ChannelOffset="2" Wheel="25" />
        <Attribute ID="Pattern_Spd" ChannelOffset="3" Wheel="26" />
        <Attribute ID="Static_Pattern" ChannelOffset="4" Wheel="52" />
        <Attribute ID="Red" Wheel="10" VirtualControl="Dimmer" />
        <Attribute ID="Green" Wheel="11" VirtualControl="Dimmer" />
        <Attribute ID="Blue" Wheel="12" VirtualControl="Dimmer" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="5" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="8" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="11" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell4" Name="Cell 4" ChannelOffset="14" ModeLink="Cell" X="0" Y="3">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="3" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
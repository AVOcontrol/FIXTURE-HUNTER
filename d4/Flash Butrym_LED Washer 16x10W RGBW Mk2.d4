    <Attribute ID="Col_Mac_Spd" Name="Col Mac Spd" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Pulse Spd" ID="2,3" If="'Colour_Macro'&gt;1&amp;&amp;'Colour_Macro'&lt;26" />
      <Condition Name="Macro Spd" ID="4" If="'Colour_Macro'&gt;25&amp;&amp;'Colour_Macro'&lt;48" />
      <Else ID="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No Function" Display="'No Function'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="3" Name="Pulse Spd" Display="'Pulse Spd %.1f%%',0.0~100.0" Dmx="1~255" Colour="255,255,255" />
      <Function ID="4" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>

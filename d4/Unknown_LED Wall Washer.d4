<Fixture Name="LED Wall Washer" ShortName="WallWasher" Company="Unknown" Version="3">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="08-09-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="10-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <History Date="03-04-24" Author="Nic Morris" Comment="Created from Xeos Washer 180 Line" Version="2" />
  <History Date="05-04-24" Author="Nic Morris" Comment="Added Atlabase ID's (Unknown LED Wall Washer (2))" Version="3" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="559badaa-208c-4fae-9988-1a8a030d11d3" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Static Colour" Display="'Static Colour'" Dmx="10~19" Update="Auto_Spd" />
      <Function ID="3" Name="Breathing Effect" Display="'Breathing Effect'" Dmx="20~29" Update="Auto_Spd" />
      <Function ID="4" Name="Jump Change Effect" Display="'Jump Change Effect'" Dmx="30~39" Update="Auto_Spd" />
      <Function ID="5" Name="Gradient Change Effect" Display="'Gradient Change Effect'" Dmx="40~49" Update="Auto_Spd" />
      <Function ID="6" Name="Pulse Change Effect" Display="'Pulse Change Effect'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="7" Name="Auto Effect 1" Display="'Auto Effect 1'" Dmx="60~69" Update="Auto_Spd" />
      <Function ID="8" Name="Auto Effect 2" Display="'Auto Effect 2'" Dmx="70~79" Update="Auto_Spd" />
      <Function ID="9" Name="Auto Effect 3" Display="'Auto Effect 3'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="10" Name="Auto Effect 4" Display="'Auto Effect 4'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="11" Name="Auto Effect 5" Display="'Auto Effect 5'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="12" Name="Auto Effect 6" Display="'Auto Effect 6'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="13" Name="Auto Effect 7" Display="'Auto Effect 7'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="14" Name="Auto Effect 8" Display="'Auto Effect 8'" Dmx="130~139" Update="Auto_Spd" />
      <Function ID="15" Name="Auto Effect 9" Display="'Auto Effect 9'" Dmx="140~149" Update="Auto_Spd" />
      <Function ID="16" Name="Auto Effect 10" Display="'Auto Effect 10'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="17" Name="Auto Effect 11" Display="'Auto Effect 11'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="18" Name="Auto Effect 12" Display="'Auto Effect 12'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="19" Name="Auto Effect 13" Display="'Auto Effect 13'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="20" Name="Auto Effect 14" Display="'Auto Effect 14'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="21" Name="Auto Effect 15" Display="'Auto Effect 15'" Dmx="200~209" Update="Auto_Spd" />
      <Function ID="22" Name="Auto Effect 16" Display="'Auto Effect 16'" Dmx="210~229" Update="Auto_Spd" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="230~233" Update="Auto_Spd" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="234~237" Update="Auto_Spd" />
      <Function ID="25" Name="Sound 3" Display="'Sound 3'" Dmx="238~241" Update="Auto_Spd" />
      <Function ID="26" Name="Sound 4" Display="'Sound 4'" Dmx="242~245" Update="Auto_Spd" />
      <Function ID="27" Name="Sound 5" Display="'Sound 5'" Dmx="246~249" Update="Auto_Spd" />
      <Function ID="28" Name="Sound 6" Display="'Sound 6'" Dmx="250~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Colour" ID="2" If="'Auto'==2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;22" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Colour" Name="Effect Colour" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~0" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="96~127" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="128~159" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="160~191" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="192~223" />
      <Function ID="8" Name="White" Display="'White'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

  <Mode Name="Extended, 18 DMX" Channels="18">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="f4f149db-f64c-404f-b6c7-5cc8c107b9db" />
    <Include>
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Pan_Spin" ChannelOffset="5" Wheel="19" />
      <Attribute ID="Tilt_Spin" ChannelOffset="6" Wheel="20" />
      <Attribute ID="PT_Speed" ChannelOffset="7" Wheel="25" />
      <Attribute ID="Shutter" ChannelOffset="8" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="9" Wheel="1" />
      <Attribute ID="Dim_Fade" ChannelOffset="10" Wheel="27" />
      <Attribute ID="Colour1Func" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Colour1" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Colour2" ChannelOffset="13" Wheel="9" />
      <Attribute ID="Red" ChannelOffset="14" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="15" Wheel="11" />

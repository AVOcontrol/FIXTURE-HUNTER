  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:1850" PowerOn="1:1850" />
      <Else ID="1" />
      <Condition Name="2200-&gt;15000K" ID="2" If="'CCT_Range'==2" />
      <Condition Name="2800-&gt;10000K" ID="3" If="'CCT_Range'==3" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.2fK',1850.00~20000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="2" Name="CCT C-Mix" Display="'%.2fK',2200.00~15000.00" Dmx="0~65535" Colour="255,240,200" />
      <Function ID="3" Name="CCT C-Mix" Display="'%.2fK',2800.00~10000.00" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green_Shift" Name="Green Shift" Description="" Group="C" Size="2">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Full Minus Green" Display="'Full Minus Green'" Dmx="512~1023" Colour="0,0,0" />
      <Function ID="3" Name="- Grn" Display="'- Grn %.2f%%',99.00~1.00" Dmx="1024~32511" Colour="0,0,0" />
      <Function ID="4" Name="Neutral" Display="'Neutral'" Dmx="32768~32768" Colour="0,0,0" />
      <Function ID="5" Name="+ Grn" Display="'+ Grn %.2f%%',1.00~99.00" Dmx="33024~65023" Colour="0,0,0" />
      <Function ID="6" Name="Full Plus Green" Display="'Full Plus Green'" Dmx="65024~65535" Colour="0,0,0" />
    </Attribute>

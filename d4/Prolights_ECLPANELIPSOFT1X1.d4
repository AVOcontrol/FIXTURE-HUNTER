  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>9e22f213-ef04-400a-80a5-1badfe004012</Thumbnail>
  <History Date="16-01-25" Author="Nic Morris" Comment="Created (confusing documentation.  charts contain errors and inconsistencies.  colour macro is not detailed)" Version="0" />
  <History Date="17-01-25" Author="Nic Morris" Comment="(Pixel XY+I mode not documented correctly and doesn't make sense.  omitted for now.  Similarly, the 'Multimode' modes involve dynamically changing control resolution which is currently unsupported.  omitted for now)" Version="16" />
  <History Date="20-01-25" Author="Nic Morris" Comment="Added colour macro ranges based on latest information and missing Atlabase ID for M37-Raw Control 16bit+CCT mode." Version="17" />
  <History Date="22-01-25" Author="Nic Morris" Comment="Updated function ranges for Legacy 2M, 20 DMX based on latest information." Version="18" />
  <History Date="22-01-25" Author="Nic Morris" Comment="Added Pixel XY+I mode based on latest documentation." Version="19" />
  <Manual Filename="" Summary="" />

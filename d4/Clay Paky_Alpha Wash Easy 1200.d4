<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Alpha Wash Easy 1200" ShortName="AWashEasy" Company="Clay Paky">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="01-06-07" Author="D.Milligan" Comment="Created" />
  <History Date="01-06-07" Author="D.Milligan" Comment="Checked" />
  <History Date="15-03-10" Author="John Rogers" Comment="Edited Pan locate value to 40%" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed Standard mode Atlabase ID and added missing ID's to remaining modes." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed duplicate ID's in else conditions." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Revised dimmer, pan and tilt function names." />
  <History Date="14-12-16" Author="Nic Morris" Comment="Fixed lamp macros (referenced non-existant attribute ID and correct ID had wrong values for Lamp On Full)" />
  <History Date="28-05-17" Author="Nic Morris" Comment="Revised mode names to reflect settings more clearly.  Added physical pan/tilt limits." />
  <History Date="28-05-17" Author="Nic Morris" Comment="Standardised shutter.  Revised Ovalizer.  Recreated palettes." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="24dcc0a0-2c0c-4085-9e84-e9062f774717" />
  <Control>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" Intensity="0~0" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="108~207" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Light Frost" Display="'Light Frost'" Dmx="85~169" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Heavy Frost" Display="'Heavy Frost'" Dmx="170~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Ovalizer" Name="Ovalizer" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~127" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="255~193" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="191~192" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="190~128" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:40" PowerOn="1:40" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Reset" Name="Reset" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Reset FX" Display="'Reset FX'" Dmx="26~76" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="77~127" />
      <Function ID="4" Name="Reset All" Display="'Reset All'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off" Display="'Lamp Off'" Dmx="26~100" />
      <Function ID="3" Name="Lamp On Half" Display="'Lamp On Half'" Dmx="101~179" />
      <Function ID="4" Name="Lamp On Full" Display="'Lamp On Full'" Dmx="180~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard (CMY)" Channels="12">
    <Import PearlRef="CP_AWE1K2St" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="c3d1bc61-0c44-4b80-93bd-2c35d6ae7bf0" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="9" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="10" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Frost" ChannelOffset="7" Wheel="21" />
      <Attribute ID="Ovalizer" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Reset" ChannelOffset="11" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="16-Bit (CMY)" Channels="14">
    <Import PearlRef="CP_AWE1K216" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="8afdd38c-bfd0-4919-b71e-51e5b02b9e68" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="9,13" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="10,14" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Frost" ChannelOffset="7" Wheel="21" />
      <Attribute ID="Ovalizer" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Reset" ChannelOffset="11" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Extended (CMY)" Channels="14">
    <Import PearlRef="CP_AWE1K2Ex" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="450" TiltMax="252" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="969ae3b5-2d4d-4bb0-8cc6-284f8b44ece9" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="9,10" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="11,12" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="3" Wheel="12" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="9" />
      <Attribute ID="Frost" ChannelOffset="7" Wheel="21" />
      <Attribute ID="Ovalizer" ChannelOffset="8" Wheel="20" />
      <Attribute ID="Reset" ChannelOffset="13" Wheel="29" />
      <Attribute ID="Lamp" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset Effects">
      <Set Channel="Reset:1" Delay="1000" />
      <Set Channel="Reset:2" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Reset:1" Delay="1000" />
      <Set Channel="Reset:3" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Reset:1" Delay="1000" />
      <Set Channel="Reset:4" Delay="6000" />
      <Set Channel="Reset:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:1" Delay="1000" />
      <Set Channel="Lamp:2" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Half)">
      <Set Channel="Lamp:1" Delay="1000" />
      <Set Channel="Lamp:3" Delay="1000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Full)">
      <Set Channel="Lamp:1" Delay="1000" />
      <Set Channel="Lamp:4" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="5" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="6" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
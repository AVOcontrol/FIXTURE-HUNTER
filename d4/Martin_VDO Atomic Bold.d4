    <Attribute ID="FX_Speed" Name="FX Speed" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1,2,3" />
      <Condition Name="PWM Frequency Adjustment" ID="4,5,6,7" If="'FX_Func'==7" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="255~130" />
      <Function ID="2" Name="Stop" Display="'Stop'" Dmx="128~128" />
      <Function ID="3" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="126~0" />
      <Function ID="4" Name="2400Hz (Default)" Display="'2400Hz (Default)'" Dmx="0~0" />
      <Function ID="5" Name="2400-3000Hz" Display="'2400-3000Hz %.f Hz',2400~3000" Dmx="1~127" />
      <Function ID="6" Name="3000Hz" Display="'3000Hz'" Dmx="128~128" />
      <Function ID="7" Name="High Speed PWM Frequency Mode (24000Hz)" Display="'High Speed PWM Frequency Mode (24000Hz)'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="FX_Sync" Name="FX Sync" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sync" Display="'No Sync'" Dmx="0~0" />

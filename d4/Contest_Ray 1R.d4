      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="58~107" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="108~157" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="158~207" />

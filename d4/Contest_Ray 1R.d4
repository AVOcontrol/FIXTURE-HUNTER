      <Function ID="11" Name="Gobo 10" Display="'Gobo 10'" Dmx="48~51" WheelPosition="10" />
      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="52~55" WheelPosition="11" />
      <Function ID="13" Name="Gobo 12" Display="'Gobo 12'" Dmx="56~59" WheelPosition="12" />
      <Function ID="14" Name="Gobo 13" Display="'Gobo 13'" Dmx="60~63" WheelPosition="13" />
      <Function ID="15" Name="Gobo 14" Display="'Gobo 14'" Dmx="64~67" WheelPosition="14" />
      <Function ID="16" Name="Gobo 15" Display="'Gobo 15'" Dmx="68~71" WheelPosition="15" />
      <Function ID="17" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="18" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="160~167" WheelPosition="1" />
      <Function ID="19" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="168~174" WheelPosition="2" />
      <Function ID="20" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="175~181" WheelPosition="3" />
      <Function ID="21" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="182~189" WheelPosition="4" />
      <Function ID="22" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="190~194" WheelPosition="5" />
      <Function ID="23" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="195~199" WheelPosition="6" />
      <Function ID="24" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="200~204" WheelPosition="7" />
      <Function ID="25" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="205~209" WheelPosition="8" />
      <Function ID="26" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="210~214" WheelPosition="9" />
      <Function ID="27" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="215~219" WheelPosition="10" />
      <Function ID="28" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="220~224" WheelPosition="11" />
      <Function ID="29" Name="Gobo 12 Shake" Display="'Gobo 12 Shake  %.f%%',0~100" Dmx="225~229" WheelPosition="12" />

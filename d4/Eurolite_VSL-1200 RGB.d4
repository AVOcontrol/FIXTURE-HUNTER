<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VSL-1200 RGB" ShortName="VSL1200RGB" Company="Eurolite">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="30-10-13" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Laser Block Out" Display="'Laser Block Out'" Dmx="0~73" Update="Effect_1, Effect_2" />
      <Function ID="2" Name="DMX Mode" Display="'DMX Mode'" Dmx="222~255" Update="Effect_1, Effect_2" />
      <Function ID="3" Name="PRG show in SD Card" Display="'PRG show in SD Card'" Dmx="74~110" Update="Effect_1, Effect_2" />
      <Function ID="4" Name="ILD show in SD Card" Display="'ILD show in SD Card'" Dmx="111~147" Update="Effect_1, Effect_2" />
      <Function ID="5" Name="Auto Show 1" Display="'Auto Show 1'" Dmx="148~165" Update="Effect_1, Effect_2" />
      <Function ID="6" Name="Auto Show 2" Display="'Auto Show 2'" Dmx="166~184" Update="Effect_1, Effect_2" />
      <Function ID="7" Name="Music Show 1" Display="'Music Show 1'" Dmx="185~202" Update="Effect_1, Effect_2" />
      <Function ID="8" Name="Music Show 2" Display="'Music Show 2'" Dmx="203~221" Update="Effect_1, Effect_2" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="2:0" PowerOn="2:0" />
      <Condition Name="Card" ID="1" If="'Mode'==3||'Mode'==4" />
      <Condition Name="DMX" ID="2" If="'Mode'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Folders" Display="'Folders %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Patterns" Display="'Patterns %.f',0~255" Dmx="0~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Condition Name="Card" ID="1" If="'Mode'==3||'Mode'==4" />
      <Condition Name="DMX" ID="2,3,4" If="'Mode'==2" />
      <Else ID="5" />
      <Function ID="1" Name="Shows" Display="'Shows %.f',0~255" Dmx="0~255" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~199" />
      <Function ID="4" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="200~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="X-Pos" Name="X-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rnd Speed" Display="'Rnd Speed %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rnd Pos" Display="'Rnd Pos %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Y-Pos" Name="Y-Pos" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~125" />
      <Function ID="2" Name="Continuous" Display="'Continuous %.f%%',0~100" Dmx="126~185" />
      <Function ID="3" Name="Rnd Speed" Display="'Rnd Speed %.f%%',0~100" Dmx="186~225" />
      <Function ID="4" Name="Rnd Pos" Display="'Rnd Pos %.f%%',0~100" Dmx="226~245" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~10" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed %.1f%%',0.0~100.0" Dmx="11~100" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Zoom Out" Display="'Zoom Out %.f%%',0~100" Dmx="101~150" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Zoom In" Display="'Zoom In %.f%%',0~100" Dmx="151~200" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Zoom In/Out" Display="'Zoom In/Out %.f%%',0~100" Dmx="201~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Y-Rot" Name="Y-Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="X-Rot" Name="X-Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~10" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.f%%',0~100" Dmx="11~110" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin" Display="'Spin %.1f%%',0.0~100.0" Dmx="111~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Z-Rot" Name="Z-Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="1~180" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="181~217" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="218~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Clipping" Name="Clipping" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~0" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Fixed" Display="'Fixed'" Dmx="11~74" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Clipping Out" Display="'Clipping Out'" Dmx="75~104" Iris="0~0" Zoom="0~0" />
      <Function ID="4" Name="Clipping In" Display="'Clipping In'" Dmx="105~144" Iris="0~0" Zoom="0~0" />
      <Function ID="5" Name="Clipping In/Out" Display="'Clipping In/Out'" Dmx="145~184" Iris="0~0" Zoom="0~0" />
      <Function ID="6" Name="Clipping On" Display="'Clipping On'" Dmx="185~224" Iris="0~0" Zoom="0~0" />
      <Function ID="7" Name="Clipping Off" Display="'Clipping Off'" Dmx="225~255" Iris="0~0" Zoom="0~0" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Wave" Name="Wave" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~9" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="Wave Speed" Display="'Wave Speed %.1f%%',0.0~100.0" Dmx="10~199" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Wave Size" Display="'Wave Size %.f%%',0~100" Dmx="200~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~16" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="17~33" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="34~50" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="51~67" Colour="0,0,255" />
      <Function ID="5" Name="Yellow" Display="'Yellow'" Dmx="68~84" Colour="255,255,0" />
      <Function ID="6" Name="Purple" Display="'Purple'" Dmx="85~101" Colour="128,0,255" />
      <Function ID="7" Name="Cyan" Display="'Cyan'" Dmx="102~118" Colour="0,255,255" />
      <Function ID="8" Name="4 Fix WRGB" Display="'4 Fix WRGB'" Dmx="119~135" Colour="255,255,255" />
      <Function ID="9" Name="4 Fix BYPC" Display="'4 Fix BYPC'" Dmx="136~152" Colour="255,255,255" />
      <Function ID="10" Name="7 Col" Display="'7 Col'" Dmx="153~169" Colour="255,255,255" />
      <Function ID="11" Name="4 Loop WRGB" Display="'4 Loop WRGB'" Dmx="170~186" Colour="255,255,255" />
      <Function ID="12" Name="4 Loop BYPC" Display="'4 Loop BYPC'" Dmx="187~203" Colour="255,255,255" />
      <Function ID="13" Name="7 Loop" Display="'7 Loop'" Dmx="204~220" Colour="255,255,255" />
      <Function ID="14" Name="Random" Display="'Random'" Dmx="221~237" Colour="255,255,255" />
      <Function ID="15" Name="Sound" Display="'Sound'" Dmx="238~254" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Original" Display="'Original'" Dmx="0~63" />
      <Function ID="2" Name="Bright Points" Display="'Bright Points'" Dmx="64~127" />
      <Function ID="3" Name="Blanking" Display="'Blanking'" Dmx="128~191" />
      <Function ID="4" Name="Points" Display="'Points'" Dmx="192~255" />
    </Attribute>
  </Control>
  <Mode Name="13 DMX" Channels="13">
    <Import PearlRef="EX_VSL1200" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="X-Pos" ChannelOffset="4" Wheel="2" />
      <Attribute ID="Y-Pos" ChannelOffset="5" Wheel="3" />
      <Attribute ID="Colour1" ChannelOffset="12" Wheel="8" />
      <Attribute ID="Y-Rot" ChannelOffset="7" Wheel="14" />
      <Attribute ID="X-Rot" ChannelOffset="8" Wheel="13" />
      <Attribute ID="Z-Rot" ChannelOffset="9" Wheel="15" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Clipping" ChannelOffset="10" Wheel="20" />
      <Attribute ID="Wave" ChannelOffset="11" Wheel="21" />
      <Attribute ID="Effect_1" ChannelOffset="2" Wheel="22" />
      <Attribute ID="Effect_2" ChannelOffset="3" Wheel="23" />
      <Attribute ID="Pattern" ChannelOffset="13" Wheel="24" />
      <Attribute ID="Mode" ChannelOffset="1" Wheel="25" />
    </Include>
  </Mode>
</Fixture>
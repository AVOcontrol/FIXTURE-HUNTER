    <Attribute ID="Macro_Select" Name="Macro Select" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="All Fire" Display="'All Fire'" Dmx="8~31" />
      <Function ID="3" Name="Center Out" Display="'Center Out'" Dmx="32~63" />
      <Function ID="4" Name="One By One" Display="'One By One'" Dmx="64~95" />
      <Function ID="5" Name="Add One" Display="'Add One'" Dmx="96~127" />
      <Function ID="6" Name="Bounce" Display="'Bounce'" Dmx="128~159" />
      <Function ID="7" Name="Reflect" Display="'Reflect'" Dmx="160~191" />
      <Function ID="8" Name="Random 1" Display="'Random 1'" Dmx="192~223" />
      <Function ID="9" Name="Random 2" Display="'Random 2'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="Macro_Speed" Name="Macro Speed" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="0~255" />

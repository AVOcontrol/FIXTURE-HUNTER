    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="Dimmer1" ChannelOffset="3" Wheel="34" />
      <Attribute ID="Dimmer2" ChannelOffset="4" Wheel="35" />
      <Attribute ID="Dimmer3" ChannelOffset="5" Wheel="36" />
      <Attribute ID="Dimmer4" ChannelOffset="6" Wheel="64" />
    </Include>
    <Cells>

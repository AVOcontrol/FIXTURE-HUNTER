      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~198" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="197~140" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />

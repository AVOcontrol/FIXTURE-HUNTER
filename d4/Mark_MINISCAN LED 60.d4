      <Attribute ID="Program_Spd" ChannelOffset="9" Wheel="23" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:8" Delay="6000" />
      <Set Channel="Shutter:2" Delay="0" />
    </Macro>
  </Macro>

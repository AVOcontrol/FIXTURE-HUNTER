      <Function ID="8" Name="D Fsch - QMG" Display="'D Fsch - QMG %.f%%',0~100" Dmx="109~146" Colour="255,100,0" />
      <Function ID="9" Name="1/4 Minus Green" Display="'1/4 Minus Green'" Dmx="146~146" Colour="220,240,255" />
      <Function ID="10" Name="QMG - M Grn" Display="'QMG - M Grn %.f%%',0~100" Dmx="146~182" Colour="220,240,255" />
      <Function ID="11" Name="Meadow Green" Display="'Meadow Green'" Dmx="182~182" Colour="0,255,0" />
      <Function ID="12" Name="M Grn - Org" Display="'M Grn - Org %.f%%',0~100" Dmx="182~218" Colour="0,255,0" />
      <Function ID="13" Name="Orange" Display="'Orange'" Dmx="218~218" Colour="255,128,0" />
      <Function ID="14" Name="Org - Op" Display="'Org - Op %.f%%',0~100" Dmx="218~255" Colour="255,128,0" />
      <Function ID="15" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="16" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Index Short Path" Display="'Index Short Path'" Dmx="0~0" Update="Colour2" Colour="255,255,255" />
      <Function ID="2" Name="Index Normal Path" Display="'Index Normal Path'" Dmx="6~10" Update="Colour2" Colour="255,255,255" />
      <Function ID="3" Name="Scroll CW" Display="'Scroll CW'" Dmx="11~15" Update="Colour2" Colour="255,255,255" />
      <Function ID="4" Name="No Scroll" Display="'No Scroll'" Dmx="16~20" Update="Colour2" Colour="255,255,255" />
      <Function ID="5" Name="Scroll CCW" Display="'Scroll CCW'" Dmx="21~25" Update="Colour2" Colour="255,255,255" />
      <Function ID="6" Name="Shake Short Path" Display="'Shake Short Path %.f%%',0~100" Dmx="26~56" Update="Colour2" Colour="255,255,255" />
      <Function ID="7" Name="Shake Normal Path" Display="'Shake Normal Path %.f%%',0~100" Dmx="57~87" Update="Colour2" Colour="255,255,255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour2" Colour="0,0,0" />
    </Attribute>

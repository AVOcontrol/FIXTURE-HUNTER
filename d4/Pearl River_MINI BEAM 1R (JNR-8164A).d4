      <Function ID="12" Name="Gobo 11" Display="'Gobo 11'" Dmx="61~65" WheelPosition="11" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="14" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="66~75" WheelPosition="1" />

      <Function ID="12" Name="Colour 11" Display="'Colour 11'" Dmx="151~157" WheelPosition="11" Colour="255,255,255" />
      <Function ID="13" Name="Colour 12" Display="'Colour 12'" Dmx="165~171" WheelPosition="12" Colour="255,255,255" />
      <Function ID="14" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="15" Name="1/ 2" Display="'1/ 2'" Dmx="18~24" WheelPosition="1" Colour="255,255,255" />
      <Function ID="16" Name="2/ 3" Display="'2/ 3'" Dmx="32~38" WheelPosition="2" Colour="255,255,255" />
      <Function ID="17" Name="3/ 4" Display="'3/ 4'" Dmx="46~52" WheelPosition="3" Colour="255,255,255" />
      <Function ID="18" Name="4/ 5" Display="'4/ 5'" Dmx="60~66" WheelPosition="4" Colour="255,255,255" />
      <Function ID="19" Name="5/ 6" Display="'5/ 6'" Dmx="74~80" WheelPosition="5" Colour="255,255,255" />
      <Function ID="20" Name="6/ 7" Display="'6/ 7'" Dmx="88~94" WheelPosition="6" Colour="255,255,255" />
      <Function ID="21" Name="7/ 8" Display="'7/ 8'" Dmx="102~108" WheelPosition="7" Colour="255,255,255" />
      <Function ID="22" Name="8/ 9" Display="'8/ 9'" Dmx="116~122" WheelPosition="8" Colour="255,255,255" />
      <Function ID="23" Name="9/ 10" Display="'9/ 10'" Dmx="130~136" WheelPosition="9" Colour="255,255,255" />
      <Function ID="24" Name="10/ 11" Display="'10/ 11'" Dmx="144~150" WheelPosition="10" Colour="255,255,255" />
      <Function ID="25" Name="11/ 12" Display="'11/ 12'" Dmx="158~164" WheelPosition="11" Colour="255,255,255" />
      <Function ID="26" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="27" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="213~172" Colour="0,0,0" />
      <Function ID="28" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="29" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="214~255" Colour="0,0,0" />
      <Function ID="30" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />

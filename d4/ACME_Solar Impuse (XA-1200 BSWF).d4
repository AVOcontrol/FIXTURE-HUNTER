<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Solar Impuse (XA-1200 BSWF)" ShortName="Slr Implse" Company="ACME">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>648a9176-602e-403c-a63d-fe9b8d6c27d7</Thumbnail>
  <History Date="23-10-18" Author="Nic Morris" Comment="Created (documentation is missing a lot of information.  prism rot ranges look wrong)" />
  <History Date="25-10-18" Author="Nic Morris" Comment="Revised prism rot ranges in response to manufacturer information.  Added 29 channel mode." />
  <History Date="25-10-18" Author="Nic Morris" Comment="Added colour names and swatches.  Added gobo swatches." />
  <History Date="31-10-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Inverted zoom in response to manufacturer information." />
  <History Date="03-11-18" Author="Nic Morris" Comment="Revised prism functions in line with latest charts (previously had two prisms)." />
  <History Date="03-11-18" Author="Nic Morris" Comment="Changed blades to 2-point system and renamed.  Calibration may still need to be revised but at least default should be open beam." />
  <History Date="11-11-18" Author="Nic Morris" Comment="Revised blade assignment for Attribute Editor" />
  <History Date="12-12-18" Author="Nic Morris" Comment="Added default RDM mode ID's in response to manufacturer request." />
  <History Date="21-12-18" Author="Nic Morris" Comment="Revised blade assignments again in line with updated calibration drawings." />
  <History Date="09-01-19" Author="Nic Morris" Comment="Yet another update (adds mode 4)" />
  <History Date="11-01-19" Author="Nic Morris" Comment="Added Atlabase ID to mode 4" />
  <History Date="08-03-19" Author="Nic Morris" Comment="Created from ACME XA-1000 BSWF" />
  <History Date="09-03-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <History Date="10-03-19" Author="Nic Morris" Comment="Corrected animation spin CW wheel direction." />
  <History Date="01-08-19" Author="Nic Morris" Comment="Added LED Freq Setting control functions and macros in response to manufacturer request (not currently documented)" />
  <History Date="15-08-19" Author="Nic Morris" Comment="Added RDM mode ID, default RDM mode ID's and autofocus functions and macros in line with latest charts in response to manufacturer request." />
  <Manual Filename="" Summary="" />
  <RDM>
    <Device ManufacturerID="14342" ModelID="1147" />
  </RDM>
  <AtlaBase TypeID="0ce5b8b8-b233-4bbc-99be-d4de7666d7d5" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Fast" Display="'Fast'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Index" ID="7" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="8,9,10,11" If="'Colour1Func'==3" />
      <Else ID="12" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="10~18" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="19~27" Colour="0,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="28~36" Colour="255,100,150" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="37~45" Colour="255,150,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="46~63" Colour="0,0,255" />
      <Function ID="7" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="64~127" Colour="0,0,0" />
      <Function ID="8" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="9" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="12" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed Index" Display="'Fixed Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="2" Name="Fixed Spin" Display="'Fixed Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="3" Name="Shake Index" Display="'Shake Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="4" Name="Shake Spin" Display="'Shake Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="5" Name="Scroll Index" Display="'Scroll Index'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="6" Name="Scroll Spin" Display="'Scroll Spin'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1, Gobo1Rot" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Gobo1Func'==1||'Gobo1Func'==2" />
      <Condition Name="Shake" ID="8,9,10,11,12,13,14" If="'Gobo1Func'==3||'Gobo1Func'==4" />
      <Condition Name="Scroll" ID="15,16,17,18" If="'Gobo1Func'==5||'Gobo1Func'==6" />
      <Else ID="19" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>23fe8363-0a92-46aa-9654-367a4d3a02aa</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="10~18" WheelPosition="1">
        <Swatch>43a759fc-b0cb-4ee0-afce-88f82c8b3c50</Swatch>
      </Function>
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="19~27" WheelPosition="2">
        <Swatch>33a64929-f36a-46e9-847d-72242c1f0c69</Swatch>
      </Function>
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="28~36" WheelPosition="3">
        <Swatch>5eea1cc8-011a-4837-8840-4e3efa45aa6a</Swatch>
      </Function>
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="37~45" WheelPosition="4">
        <Swatch>b2d87334-6e7f-421a-b785-0a9466abd944</Swatch>
      </Function>
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="46~54" WheelPosition="5">
        <Swatch>326ed1ed-a43c-4b33-a178-57ff1b740049</Swatch>
      </Function>
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="55~63" WheelPosition="6">
        <Swatch>736c1bfb-386a-4e89-bdf8-7741985faa95</Swatch>
      </Function>
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>23fe8363-0a92-46aa-9654-367a4d3a02aa</Swatch>
      </Function>
      <Function ID="9" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="64~74" WheelPosition="1">
        <Swatch>43a759fc-b0cb-4ee0-afce-88f82c8b3c50</Swatch>
      </Function>
      <Function ID="10" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="75~85" WheelPosition="2">
        <Swatch>33a64929-f36a-46e9-847d-72242c1f0c69</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="86~96" WheelPosition="3">
        <Swatch>5eea1cc8-011a-4837-8840-4e3efa45aa6a</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="97~107" WheelPosition="4">
        <Swatch>b2d87334-6e7f-421a-b785-0a9466abd944</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="108~118" WheelPosition="5">
        <Swatch>326ed1ed-a43c-4b33-a178-57ff1b740049</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="119~127" WheelPosition="6">
        <Swatch>736c1bfb-386a-4e89-bdf8-7741985faa95</Swatch>
      </Function>
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="16" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="17" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="18" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="19" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="6" />
      <Function ID="1" Name="Index" Display="'%.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="6" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Animation" Name="Animation" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Animation" Display="'No Animation'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="8~129" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="130~133" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Prism" Name="Prism" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="8~255" />
    </Attribute>
    <Attribute ID="Prism_Rot" Name="Prism Rot" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="190~193" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="194~255" />
    </Attribute>
    <Attribute ID="CRI" Name="CRI" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Close" Display="'Close'" Dmx="0~0" />

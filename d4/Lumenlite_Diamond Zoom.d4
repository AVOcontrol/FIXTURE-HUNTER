  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~1" Intensity="0~0" />
      <Function ID="2" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="2~64" Intensity="0~0" />
      <Function ID="3" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="65~127" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe 1" Display="'Rnd Strobe 1 %.f%%',0~100" Dmx="128~190" Intensity="0~0" />
      <Function ID="5" Name="Rnd Strobe 2" Display="'Rnd Strobe 2 %.f%%',0~100" Dmx="191~253" Intensity="0~0" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="254~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~59" />
      <Function ID="2" Name="Fan Full" Display="'Fan Full'" Dmx="60~64" />
      <Function ID="3" Name="Fan Auto" Display="'Fan Auto'" Dmx="70~74" />
      <Function ID="4" Name="Display Normal" Display="'Display Normal'" Dmx="80~84" />
      <Function ID="5" Name="Display Invert" Display="'Display Invert'" Dmx="90~94" />
      <Function ID="6" Name="Display On" Display="'Display On'" Dmx="100~104" />
      <Function ID="7" Name="Display Auto" Display="'Display Auto'" Dmx="110~114" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="120~124" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~3" Colour="255,255,255" />
      <Function ID="2" Name="Fixed RGB" Display="'Fixed RGB %.f%%',0~100" Dmx="4~67" Colour="255,255,255" />
      <Function ID="3" Name="Fixed RGBW" Display="'Fixed RGBW %.f%%',0~100" Dmx="68~131" Colour="255,255,255" />
      <Function ID="4" Name="LED Macro" Display="'LED Macro %.1f%%',0.0~100.0" Dmx="132~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">

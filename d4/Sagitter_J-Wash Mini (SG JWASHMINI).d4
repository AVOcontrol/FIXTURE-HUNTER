    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="&lt;3200K" Display="'&lt;3200K'" Dmx="16~45" Colour="255,240,200" />
      <Function ID="3" Name="3200-3500K" Display="'3200-3500K %.fK',3200~3500" Dmx="46~75" Colour="255,240,200" />
      <Function ID="4" Name="3500-5000K" Display="'3500-5000K %.fK',3500~5000" Dmx="76~105" Colour="255,240,200" />

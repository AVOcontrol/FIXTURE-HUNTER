      <Function ID="9" Name="7000-8000K" Display="'7000-8000K %.fK',7000~8000" Dmx="226~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Program" Display="'No Program'" Dmx="0~0" Update="Program_Spd" />
      <Function ID="2" Name="Program 1" Display="'Program 1'" Dmx="16~31" Update="Program_Spd" />
      <Function ID="3" Name="Program 2" Display="'Program 2'" Dmx="32~47" Update="Program_Spd" />
      <Function ID="4" Name="Program 3" Display="'Program 3'" Dmx="48~63" Update="Program_Spd" />

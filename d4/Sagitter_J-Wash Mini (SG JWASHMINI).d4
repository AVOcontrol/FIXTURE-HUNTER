      <Function ID="6" Name="5500-6000K" Display="'5500-6000K %.fK',5500~6000" Dmx="136~165" Colour="255,240,200" />
      <Function ID="7" Name="6000-6500K" Display="'6000-6500K %.fK',6000~6500" Dmx="166~195" Colour="255,240,200" />

      <Function ID="15" Name="3200K" Display="'3200K'" Dmx="213~217" Colour="255,255,255" />
      <Function ID="16" Name="3500K" Display="'3500K'" Dmx="218~222" Colour="255,255,255" />
      <Function ID="17" Name="5000K" Display="'5000K'" Dmx="223~227" Colour="255,255,255" />
      <Function ID="18" Name="5500K" Display="'5500K'" Dmx="228~232" Colour="255,255,255" />
      <Function ID="19" Name="6000K" Display="'6000K'" Dmx="233~237" Colour="255,255,255" />
      <Function ID="20" Name="6500K" Display="'6500K'" Dmx="238~242" Colour="255,255,255" />

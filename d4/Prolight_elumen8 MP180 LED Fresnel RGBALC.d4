<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="elumen8 MP180 LED Fresnel RGBALC" ShortName="MP180 Fr" Company="Prolight">
  <Copyright Notice="© Avolites Ltd. 2019" />
  <Thumbnail>3502ceb7-8bae-4efc-932c-4568126dd464</Thumbnail>
  <History Date="11-07-19" Author="Nic Morris" Comment="Created (it is not clear how HSI can coexist with colour mixing and dimmer in the 16channel mode.  This is unsupported)" />
  <History Date="12-07-19" Author="Nic Morris" Comment="Added Atlabase ID's." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="606ce6ab-4b91-4868-b648-d1e957b04034" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="CyanAdditive" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="CTO C-Mix" Display="'%.fK',2800~8000" Dmx="6~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Tint" Name="Tint" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+ Magenta" Display="'+ Magenta %.1f%%',100.0~0.0" Dmx="1~127" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="128~128" Colour="255,255,255" />
      <Function ID="4" Name="+ Green" Display="'+ Green %.1f%%',0.0~100.0" Dmx="129~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xHue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xSaturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="xColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dim_Curve" Name="Dim Curve" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="6~63" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="64~127" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="128~191" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="LED Dimmer Mode" Display="'LED Dimmer Mode'" Dmx="6~63" />
      <Function ID="3" Name="Halogen Dimmer Mode" Display="'Halogen Dimmer Mode'" Dmx="64~127" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="7794c9c0-a70d-4b69-b25f-80260a9c3549" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="3a75f503-6613-4e6c-8c89-ec950ce2755c" />
    <Include>
      <Attribute ID="Hue" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Saturation" ChannelOffset="2" Wheel="8" />
      <Attribute ID="ColourIntensity" ChannelOffset="3" Wheel="9" VirtualControl="Dimmer" />
      <Attribute ID="CTO" ChannelOffset="4" Wheel="37" />
      <Attribute ID="Tint" ChannelOffset="5" Wheel="38" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="810da1fe-2a1c-4a78-b80a-c620a46a8e86" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Amber" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Lime" ChannelOffset="5" Wheel="41" VirtualControl="Dimmer" />
      <Attribute ID="CyanAdditive" ChannelOffset="6" Wheel="42" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="16 DMX" Channels="16">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="dcbea151-8332-4249-9662-7be053de0739" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="3" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="4" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="5" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="6" Wheel="12" />
      <Attribute ID="Amber" ChannelOffset="7" Wheel="40" />
      <Attribute ID="Lime" ChannelOffset="8" Wheel="41" />
      <Attribute ID="CyanAdditive" ChannelOffset="9" Wheel="42" />
      <Attribute ID="CTO" ChannelOffset="10" Wheel="37" />
      <Attribute ID="Tint" ChannelOffset="11" Wheel="38" />
      <Attribute ID="xHue" ChannelOffset="12" Wheel="7" />
      <Attribute ID="xSaturation" ChannelOffset="13" Wheel="8" />
      <Attribute ID="xColourIntensity" ChannelOffset="14" Wheel="9" />
      <Attribute ID="Dim_Curve" ChannelOffset="15" Wheel="25" />
      <Attribute ID="Dim_Mode" ChannelOffset="16" Wheel="26" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Linear">
      <Set Channel="Dim_Curve:2" Delay="6000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="Square">
      <Set Channel="Dim_Curve:3" Delay="6000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="Inv Square">
      <Set Channel="Dim_Curve:4" Delay="6000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="S-Curve">
      <Set Channel="Dim_Curve:5" Delay="6000" />
      <Set Channel="Dim_Curve:1" Delay="0" />
    </Macro>
    <Macro Name="LED Dimmer Mode">
      <Set Channel="Dim_Mode:2" Delay="6000" />
      <Set Channel="Dim_Mode:1" Delay="0" />
    </Macro>
    <Macro Name="Halogen Dimmer Mode">
      <Set Channel="Dim_Mode:3" Delay="6000" />
      <Set Channel="Dim_Mode:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />

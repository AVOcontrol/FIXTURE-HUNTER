    </Attribute>
    <Attribute ID="Lightsource" Name="Lightsource" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Blue Screen" Display="'Blue Screen'" Dmx="1~1" Colour="255,255,255" />
      <Function ID="3" Name="Green Screen" Display="'Green Screen'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="4" Name="Candle" Display="'Candle'" Dmx="3~3" Colour="255,255,255" />
      <Function ID="5" Name="Tungsten" Display="'Tungsten'" Dmx="4~4" Colour="255,255,255" />
      <Function ID="6" Name="Halogen" Display="'Halogen'" Dmx="5~5" Colour="255,255,255" />
      <Function ID="7" Name="Carbon Arc" Display="'Carbon Arc'" Dmx="6~6" Colour="255,255,255" />
      <Function ID="8" Name="Fluorescent Warm" Display="'Fluorescent Warm'" Dmx="7~7" Colour="255,255,255" />
      <Function ID="9" Name="Fluorescent Standard" Display="'Fluorescent Standard'" Dmx="8~8" Colour="255,255,255" />
      <Function ID="10" Name="Fluorescent Cool" Display="'Fluorescent Cool'" Dmx="9~9" Colour="255,255,255" />
      <Function ID="11" Name="Fluorescent Black Light" Display="'Fluorescent Black Light'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="12" Name="HMI" Display="'HMI'" Dmx="11~11" Colour="255,255,255" />
      <Function ID="13" Name="Mercury Vapour" Display="'Mercury Vapour'" Dmx="12~12" Colour="255,255,255" />
      <Function ID="14" Name="Moonlight" Display="'Moonlight'" Dmx="13~13" Colour="255,255,255" />
      <Function ID="15" Name="Sky Blue" Display="'Sky Blue'" Dmx="14~14" Colour="255,255,255" />
      <Function ID="16" Name="Sky Overcast" Display="'Sky Overcast'" Dmx="15~15" Colour="255,255,255" />
      <Function ID="17" Name="Sodium High Pressure" Display="'Sodium High Pressure'" Dmx="16~16" Colour="255,255,255" />
      <Function ID="18" Name="Sodium Vapour" Display="'Sodium Vapour'" Dmx="17~17" Colour="255,255,255" />
      <Function ID="19" Name="Sunlight" Display="'Sunlight'" Dmx="18~18" Colour="255,255,255" />
      <Function ID="20" Name="Sunset Sun" Display="'Sunset Sun'" Dmx="19~19" Colour="255,255,255" />
      <Function ID="21" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Preset" Name="Preset" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Disco" Display="'Disco'" Dmx="0~0" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="2" Name="Flame" Display="'Flame'" Dmx="1~1" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="3" Name="Police" Display="'Police'" Dmx="2~2" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="3~3" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="5" Name="Strobe" Display="'Strobe'" Dmx="4~4" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="6" Name="TV" Display="'TV'" Dmx="5~5" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
      <Function ID="7" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Effect_Param_1, Effect_Param_2, Effect_Param_3, Effect_Param_4" />
    </Attribute>
    <Attribute ID="Effect_Param_1" Name="Effect Param 1" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Loop Speed" ID="1" If="'Effect'==1||'Effect'==3" />
      <Condition Name="Hue" ID="2" If="'Effect'==2||'Effect'==4||'Effect'==6" />
      <Condition Name="Kelvin" ID="3" If="'Effect'==5" />
      <Else ID="4" />
      <Function ID="1" Name="Loop Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Hue" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Kelvin" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_2" Name="Effect Param 2" Description="" Group="E">
      <Locate Locate="5:0" PowerOn="5:0" />
      <Condition Name="Saturation" ID="1" If="'Effect'==2" />
      <Condition Name="Colours" ID="2" If="'Effect'==3" />
      <Condition Name="Flash Time" ID="3" If="'Effect'==4||'Effect'==5" />
      <Condition Name="Loop Speed" ID="4" If="'Effect'==6" />
      <Else ID="5" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colours" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Flash Time" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Loop Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_3" Name="Effect Param 3" Description="" Group="E">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Kelvin" ID="1" If="'Effect'==2" />
      <Condition Name="Loop Speed" ID="2" If="'Effect'==4" />
      <Else ID="3" />
      <Function ID="1" Name="Kelvin" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Loop Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Param_4" Name="Effect Param 4" Description="" Group="E">
      <Locate Locate="3:0" PowerOn="3:0" />
      <Condition Name="Flicker Speed" ID="1" If="'Effect'==2" />
      <Condition Name="Fade Out" ID="2" If="'Effect'==4" />
      <Else ID="3" />
      <Function ID="1" Name="Flicker Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Fade Out" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved1" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Reserved2" Name="Reserved" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Silence" Display="'Silence'" Dmx="0~0" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic'" Dmx="10~19" />
      <Function ID="3" Name="Idle" Display="'Idle'" Dmx="20~29" />
      <Function ID="4" Name="70%" Display="'70%'" Dmx="30~39" />
      <Function ID="5" Name="Full Speed" Display="'Full Speed'" Dmx="40~49" />
    </Attribute>
  </Control>

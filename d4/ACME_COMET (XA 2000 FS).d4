  <Control>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="7" PowerOn="7" />
      <Function ID="1" Name="2700K" Display="'2700K'" Dmx="213~255" Colour="0,0,0" />
      <Function ID="2" Name="3200K" Display="'3200K'" Dmx="172~212" Colour="0,0,0" />
      <Function ID="3" Name="4000K" Display="'4000K'" Dmx="131~171" Colour="0,0,0" />

    </Attribute>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="14~24" />
      <Function ID="3" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="25~35" />
      <Function ID="4" Name="Col in Dark" Display="'Col in Dark'" Dmx="36~46" />
      <Function ID="5" Name="Prism in Dark" Display="'Prism in Dark'" Dmx="47~57" />
      <Function ID="6" Name="Frost in Dark" Display="'Frost in Dark'" Dmx="58~68" />
      <Function ID="7" Name="All in Dark" Display="'All in Dark'" Dmx="69~79" />
      <Function ID="8" Name="All except P/T in dark" Display="'All except P/T in dark'" Dmx="80~90" />
      <Function ID="9" Name="Display Invert" Display="'Display Invert'" Dmx="124~134" />
      <Function ID="10" Name="Display Normal" Display="'Display Normal'" Dmx="135~145" />
      <Function ID="11" Name="Reset no P/T" Display="'Reset no P/T'" Dmx="156~165" />
      <Function ID="12" Name="Reset All" Display="'Reset All'" Dmx="168~189" />
    </Attribute>
    <Attribute ID="Lamp" Name="Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Low Power" Display="'Low Power'" Dmx="32~63" />
      <Function ID="3" Name="Lamp Off" Display="'Lamp Off'" Dmx="160~191" />
      <Function ID="4" Name="Lamp On" Display="'Lamp On'" Dmx="224~255" />
    </Attribute>
  </Control>
  <Mode Name="16 DMX" Channels="16" Id="d4362596-116b-4da6-ad9e-dd39630afbfd">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

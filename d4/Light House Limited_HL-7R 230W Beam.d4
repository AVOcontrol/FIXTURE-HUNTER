      <Attribute ID="Lamp" ChannelOffset="16" Wheel="29" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Lamp:3" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On">
      <Set Channel="Lamp:4" Delay="6000" />
      <Set Channel="Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Display Invert">
      <Set Channel="Function:9" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Display Normal">
      <Set Channel="Function:10" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Function:12" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Reset no P/T">
      <Set Channel="Function:11" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Move in Dark">
      <Set Channel="Function:2" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark">
      <Set Channel="Function:3" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Col in Dark">
      <Set Channel="Function:4" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Prism in Dark">
      <Set Channel="Function:5" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="Frost in Dark">
      <Set Channel="Function:6" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="All in Dark">
      <Set Channel="Function:7" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
    <Macro Name="All except P/T in dark">
      <Set Channel="Function:8" Delay="6000" />
      <Set Channel="Function:1" Delay="0" />
    </Macro>
  </Macro>

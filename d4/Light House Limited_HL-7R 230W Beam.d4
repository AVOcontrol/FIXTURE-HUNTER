      <Function ID="27" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="204~210" WheelPosition="8" />
      <Function ID="28" Name="Gobo 9 Shake" Display="'Gobo 9 Shake  %.f%%',0~100" Dmx="211~216" WheelPosition="9" />
      <Function ID="29" Name="Gobo 10 Shake" Display="'Gobo 10 Shake  %.f%%',0~100" Dmx="217~222" WheelPosition="10" />
      <Function ID="30" Name="Gobo 11 Shake" Display="'Gobo 11 Shake  %.f%%',0~100" Dmx="223~239" WheelPosition="11" />

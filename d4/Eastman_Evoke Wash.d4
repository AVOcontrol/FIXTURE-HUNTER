<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Evoke Wash" ShortName="Evoke Wash" Company="Eastman" Version="1">
  <Copyright Notice="© Avolites Ltd. 2022" />
  <History Date="18-04-22" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="20-04-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9a68eda4-881f-4429-8458-5f51118efb33" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="10~59" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="65~114" />
      <Function ID="4" Name="Strobe 3" Display="'Strobe 3 %.f%%',0~100" Dmx="120~169" />
      <Function ID="5" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="175~224" />
      <Function ID="6" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="7" Name="Reset" Display="'Reset'" Dmx="235~244" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="R" Display="'R'" Dmx="2~2" Colour="255,255,255" />
      <Function ID="3" Name="RW" Display="'RW'" Dmx="3~4" Colour="255,255,255" />
      <Function ID="4" Name="RG" Display="'RG'" Dmx="5~7" Colour="255,255,255" />
      <Function ID="5" Name="RGW" Display="'RGW'" Dmx="8~9" Colour="255,255,255" />
      <Function ID="6" Name="G" Display="'G'" Dmx="10~12" Colour="255,255,255" />
      <Function ID="7" Name="GW" Display="'GW'" Dmx="13~14" Colour="255,255,255" />
      <Function ID="8" Name="GB" Display="'GB'" Dmx="15~17" Colour="255,255,255" />
      <Function ID="9" Name="GBW" Display="'GBW'" Dmx="18~19" Colour="255,255,255" />
      <Function ID="10" Name="B" Display="'B'" Dmx="20~22" Colour="255,255,255" />
      <Function ID="11" Name="BW" Display="'BW'" Dmx="23~24" Colour="255,255,255" />
      <Function ID="12" Name="RB" Display="'RB'" Dmx="25~27" Colour="255,255,255" />
      <Function ID="13" Name="RBW" Display="'RBW'" Dmx="28~29" Colour="255,255,255" />
      <Function ID="14" Name="W" Display="'W'" Dmx="30~39" Colour="255,255,255" />
      <Function ID="15" Name="RGBW" Display="'RGBW'" Dmx="40~49" Colour="255,255,255" />
      <Function ID="16" Name="Effect 1" Display="'Effect 1 %.f%%',0~100" Dmx="50~83" Colour="255,255,255" />
      <Function ID="17" Name="Effect 2" Display="'Effect 2 %.f%%',0~100" Dmx="84~117" Colour="255,255,255" />
      <Function ID="18" Name="Effect 3" Display="'Effect 3 %.f%%',0~100" Dmx="118~151" Colour="255,255,255" />
      <Function ID="19" Name="Effect 4" Display="'Effect 4 %.f%%',0~100" Dmx="152~185" Colour="255,255,255" />
      <Function ID="20" Name="Effect 5" Display="'Effect 5 %.f%%',0~100" Dmx="186~218" Colour="255,255,255" />
      <Function ID="21" Name="Effect 6" Display="'Effect 6 %.f%%',0~100" Dmx="219~252" Colour="255,255,255" />
      <Function ID="22" Name="RGBW" Display="'RGBW'" Dmx="253~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Ring_Macro" Name="Ring Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="All" Display="'All'" Dmx="0~0" />
      <Function ID="2" Name="1" Display="'1'" Dmx="3~7" />
      <Function ID="3" Name="2" Display="'2'" Dmx="8~11" />
      <Function ID="4" Name="3" Display="'3'" Dmx="12~15" />
      <Function ID="5" Name="1+2" Display="'1+2'" Dmx="16~19" />
      <Function ID="6" Name="2+3" Display="'2+3'" Dmx="20~23" />
      <Function ID="7" Name="1+3" Display="'1+3'" Dmx="24~27" />
      <Function ID="8" Name="All" Display="'All'" Dmx="28~31" />
      <Function ID="9" Name="Cycle CW" Display="'Cycle CW %.f%%',100~0" Dmx="87~32" />
      <Function ID="10" Name="Cycle CCW" Display="'Cycle CCW %.f%%',0~100" Dmx="88~143" />
      <Function ID="11" Name="Alt Cycle CW" Display="'Alt Cycle CW %.f%%',100~0" Dmx="199~144" />
      <Function ID="12" Name="Alt Cycle CCW" Display="'Alt Cycle CCW %.f%%',0~100" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto Col" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Gradual Col" Display="'Gradual Col %.1f%%',0.0~100.0" Dmx="6~127" Colour="0,0,0" />
      <Function ID="3" Name="Jump Col" Display="'Jump Col %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Auto1" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Pan Auto" Display="'Pan Auto'" Dmx="50~99" />
      <Function ID="3" Name="Tilt Auto" Display="'Tilt Auto'" Dmx="100~149" />
      <Function ID="4" Name="P/T Auto" Display="'P/T Auto'" Dmx="150~199" />
      <Function ID="5" Name="Sound" Display="'Sound'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="24 DMX" Channels="24">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="18622e27-89cf-4e57-97b4-5d0207df2f91" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Pan" ChannelOffset="1,21" Wheel="2" />
        <Attribute ID="Tilt" ChannelOffset="2,22" Wheel="3" />
        <Attribute ID="Zoom" ChannelOffset="3" Wheel="19" />
        <Attribute ID="Shutter" ChannelOffset="4" Wheel="5" />
        <Attribute ID="Master_Dimmer" ChannelOffset="5" Wheel="4" />
        <Attribute ID="Colour_Macro" ChannelOffset="6" Wheel="7" />
        <Attribute ID="Ring_Macro" ChannelOffset="7" Wheel="22" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="White" Wheel="40" />
        <Attribute ID="Dimmer" Wheel="1" />
        <Attribute ID="Auto" ChannelOffset="20" Wheel="8" />
        <Attribute ID="PT_Speed" ChannelOffset="23" Wheel="25" />
        <Attribute ID="Auto1" ChannelOffset="24" Wheel="23" />
      </Master>
      <Cell ID="Cell1" Name="Cell 1" ChannelOffset="8" ModeLink="Cell" X="0" Y="0">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Cell 2" ChannelOffset="12" ModeLink="Cell" X="0" Y="1">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="Cell 3" ChannelOffset="16" ModeLink="Cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="White" TargetId="White" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Cell" Channels="4" Hidden="True">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="630" TiltMax="265" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Shutter:7" Delay="6000" />
      <Set Channel="Shutter:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:5:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
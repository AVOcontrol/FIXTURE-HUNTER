  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9a0785d2-049c-4a79-b0e8-cbff2cc4771c" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Spot_Col_Func" Name="Spot Col Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
      <Function ID="2" Name="Mixed" Display="'Mixed'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Spot_Colour" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Spot_Colour" Name="Spot Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Spot_Col_Func'==1" />
      <Condition Name="Mixed" ID="2" If="'Spot_Col_Func'==2" />
      <Else ID="3" />
      <Function ID="1" Name="Fixed Col" Display="'Fixed Col %.1f%%',0.0~100.0" Dmx="0~139" Colour="0,0,0" />
      <Function ID="2" Name="Mixed Col" Display="'Mixed Col %.1f%%',0.0~100.0" Dmx="140~255" Colour="0,0,0" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Moving" Display="'Moving'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Mix" Display="'Mix'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Fixed" ID="1" If="'Gobo1Func'==1" />
      <Condition Name="Moving" ID="2" If="'Gobo1Func'==2" />
      <Condition Name="Mix" ID="3" If="'Gobo1Func'==3" />
      <Else ID="4" />
      <Function ID="1" Name="Fixed Gobo" Display="'Fixed Gobo %.f%%',0~100" Dmx="0~63" />
      <Function ID="2" Name="Moving Gobo" Display="'Moving Gobo %.f%%',0~100" Dmx="64~127" />
      <Function ID="3" Name="Mixed Gobo" Display="'Mixed Gobo %.1f%%',0.0~100.0" Dmx="128~255" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Wash Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Wash Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Wash Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="Wash White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Wash_Shutter" Name="Wash Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Preset Colours" Display="'Preset Colours %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,0" />
      <Function ID="2" Name="Auto Effects" Display="'Auto Effects %.1f%%',0.0~100.0" Dmx="128~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.1f%%',0.0~100.0" Dmx="15~127" />
      <Function ID="3" Name="Sound" Display="'Sound %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="Sound" Name="Sound" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto Pan" Display="'Auto Pan'" Dmx="21~100" />
      <Function ID="3" Name="Auto Tilt" Display="'Auto Tilt'" Dmx="101~200" />
      <Function ID="4" Name="Auto P/T" Display="'Auto P/T'" Dmx="201~249" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

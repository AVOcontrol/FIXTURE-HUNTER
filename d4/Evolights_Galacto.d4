  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>209b39c2-da0f-4d57-a5a3-d3a52f8ef656</Thumbnail>
  <History Date="02-07-20" Author="Nic Morris" Comment="Created (based on chart revision 1.5)" Version="0" />
  <History Date="16-08-20" Author="Nic Morris" Comment="Added product thumbnail.  Updated to release spec (revises FX)" Version="11" />
  <History Date="03-09-20" Author="Nic Morris" Comment="Minor change to colour macro function ranges in line with latest documentation." Version="12" />
  <History Date="26-03-21" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="03-12-21" Author="Nic Morris" Comment="Updated in line with Rev B (firmware version 1.2.0) (adds low-noise LED control function and macro and 12 new virtual colours)" Version="14" />
  <History Date="26-09-22" Author="Nic Morris" Comment="Created from Martin Mac Aura PXL" Version="15" />
  <History Date="28-09-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="25" />
  <History Date="06-07-23" Author="Nic Morris" Comment="Moved Aura part to cell in Extended mode and added multi-part patch option." Version="26" />
  <History Date="07-12-23" Author="Nic Morris" Comment="Created from Martin Mac Aura XIP (no pixel layout)" Version="28" />
  <History Date="04-03-24" Author="Nic Morris" Comment="Added Atlabase ID's.  Revised pixel layout in line with latest documentation." Version="31" />
  <History Date="01-04-24" Author="Nic Morris" Comment="Changed DMX 0 in LED Frequency to be 'Hybrid' in line with latest firmware in response to manufacturer request (not yet documented)" Version="32" />
  <History Date="17-05-24" Author="Nic Morris" Comment="Changed All Beam RGB controls to default at full." Version="33" />
  <History Date="19-02-25" Author="Nic Morris" Comment="Updated in line with latest documentation (User Manual Rev. C).  (minor change to CTC range and random colour.  adds P/T Standard control function/macro)" Version="34" />
  <History Date="28-10-25" Author="Nic Morris" Comment="Moved Ludicrous mode beam controls into a cell in attempt to solve customer bug report." Version="36" />
  <History Date="14-12-25" Author="Nic Morris" Comment="Updated in line with firmware 1.3.0 (Adds Beam Tungsten, Beam Tungsten Decay and Virtual Dimmers Square Law effects)" Version="37" />
  <History Date="23-06-26" Author="Nic Morris" Comment="Created from Martin MAC One (effectively identical.  no pixel layout.  assumed the same for now)" Version="38" />
  <History Date="21-07-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="39" />

    </Attribute>
    <Attribute ID="Shutter_Mode" Name="Shutter Mode" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe'" Dmx="3~5" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe'" Dmx="201~255" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse'" Dmx="6~50" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse'" Dmx="51~100" />
      <Function ID="6" Name="Lightning" Display="'Lightning'" Dmx="151~200" />

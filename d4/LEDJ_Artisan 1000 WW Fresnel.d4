  <AtlaBase TypeID="c3980d3d-edfd-42d2-91d2-c8a304281a7e" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear LED" Display="'Linear LED'" Dmx="21~40" />
      <Function ID="3" Name="Square LED" Display="'Square LED'" Dmx="41~60" />
      <Function ID="4" Name="Inv Square LED" Display="'Inv Square LED'" Dmx="61~80" />
      <Function ID="5" Name="S-Curve LED" Display="'S-Curve LED'" Dmx="81~100" />
      <Function ID="6" Name="Linear Halogen" Display="'Linear Halogen'" Dmx="101~120" />
      <Function ID="7" Name="Square Halogen" Display="'Square Halogen'" Dmx="121~140" />
      <Function ID="8" Name="Inv Square Halogen" Display="'Inv Square Halogen'" Dmx="141~160" />
      <Function ID="9" Name="S-Curve Halogen" Display="'S-Curve Halogen'" Dmx="161~180" />
    </Attribute>
    <Attribute ID="Refresh_Rate" Name="Refresh Rate" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="1200Hz" Display="'1200Hz'" Dmx="21~40" />
      <Function ID="3" Name="2400Hz" Display="'2400Hz'" Dmx="41~60" />
      <Function ID="4" Name="4000Hz" Display="'4000Hz'" Dmx="61~80" />
      <Function ID="5" Name="6000Hz" Display="'6000Hz'" Dmx="81~100" />
      <Function ID="6" Name="12000Hz" Display="'12000Hz'" Dmx="101~120" />
    </Attribute>
  </Control>
  <Mode Name="1 DMX" Channels="1" Id="c23ba4af-8c76-47f9-a78f-5c03078d4562">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />

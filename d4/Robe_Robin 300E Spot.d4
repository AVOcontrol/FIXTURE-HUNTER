<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Robin 300E Spot" ShortName="Rob300ESpt" Company="Robe">
  <Copyright Notice="© Avolites Ltd. 2018" />
  <Thumbnail>c2abb402-821a-4f89-bd9c-fcafb6a185c7</Thumbnail>
  <History Date="11-05-09" Author="David Hunt" Comment="Created" />
  <History Date="28-01-10" Author="John Rogers" Comment="Rewrote Gobo 1." />
  <History Date="09-06-10" Author="John Rogers" Comment="Total rewrite of Gobo2Func, Gobo2 and Gobo2Rot." />
  <History Date="14-06-10" Author="Jonathan Moreton" Comment="Fixed Gobo 1" />
  <History Date="03-09-10" Author="John Rogers" Comment="Edited Pan and Tilt movement ranges." />
  <History Date="05-05-11" Author="Nic Morris" Comment="Fixed power on and locate.  Standardised func names." />
  <History Date="05-05-11" Author="Nic Morris" Comment="Added missing macros.  Simplified colour and gobo proportional ranges." />
  <History Date="05-05-11" Author="Nic Morris" Comment="Fixed Gobo1 Random ranges.  Fixed raw ranges.  Increased wheel resolution." />
  <History Date="05-05-11" Author="Nic Morris" Comment="Cannot find macro or shutter faults as reported in bugs but re-exporting anyway." />
  <History Date="19-07-11" Author="John Rogers" Comment="Inverted Hotspot in response to Robe." />
  <History Date="24-07-11" Author="Nic Morris" Comment="Renamed colour split to index.  Removed PT Speed conditions.  Added index/spin options for gobo2 scroll and random" />
  <History Date="19-04-13" Author="RDM Sync Tool" Comment="Added RDM Manufacturer information. Added RDM Fixture information. Added RDM Mode information." />
  <History Date="29-11-13" Author="Peter Budd" Comment="Inverted the Zoom range so 100% corresponds to the maximum beam size." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="02-02-18" Author="Nic Morris" Comment="Added product thumbnail.  Added channel counts to mode names." />
  <History Date="02-02-18" Author="Nic Morris" Comment="Added gobo swatches.  Tidied conditions.  Increased 16bit wheel resolution.  Recreated palettes." />
  <History Date="02-02-18" Author="Nic Morris" Comment="Revised index ranges for full field.  Revised CMY Macro and prism with discreet functions." />
  <History Date="02-02-18" Author="Nic Morris" Comment="Inverted prism CW spin." />

        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="Shutter" Wheel="4" />
        <Attribute ID="Effect" Wheel="22" />
        <Attribute ID="Speed" Wheel="23" />
        <Attribute ID="Dimmer" Wheel="1" />
      </Master>
      <Cell ID="Cell1" Name="Fog" ChannelOffset="1" ModeLink="Dim cell" X="0" Y="0">
        <AttributeLink SourceId="Fog" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell2" Name="Bubble" ChannelOffset="2" ModeLink="Dim cell" X="0" Y="1">
        <AttributeLink SourceId="Bubble" TargetId="Dimmer" />
      </Cell>
      <Cell ID="Cell3" Name="LED" ChannelOffset="5" ModeLink="LED cell" X="0" Y="2">
        <AttributeLink SourceId="Red" TargetId="Red" />
        <AttributeLink SourceId="Green" TargetId="Green" />
        <AttributeLink SourceId="Blue" TargetId="Blue" />
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Effect" TargetId="Effect" />
        <AttributeLink SourceId="Speed" TargetId="Speed" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
      </Cell>
    </Cells>
  </Mode>
  <Mode Name="Dim cell" Channels="1" Hidden="True" Id="f573c006-a1d2-41d9-b802-175c6e5403ed">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>

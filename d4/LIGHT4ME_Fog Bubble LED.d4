    <AtlaBase ModeID="c5496cdf-5ae6-4c80-b70b-03bedafd04f7" />
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Fog" Wheel="5" />
        <Attribute ID="Bubble" Wheel="34" />
        <Attribute ID="Bubble_Volume" ChannelOffset="3" Wheel="35" />

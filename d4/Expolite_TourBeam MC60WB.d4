  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="07-12-16" Author="Nic Morris" Comment="Created" />
  <History Date="12-11-17" Author="Nic Morris" Comment="Created from Showtec Expression 600Z (identical except for shutter functions.  charts have errors)." />
  <History Date="15-11-17" Author="Nic Morris" Comment="Revised Atlabase ID's to Expolite version - probably identical.  (note currently missing 15 channel mode)" />
  <History Date="16-11-17" Author="Nic Morris" Comment="Added missing Atlabase ID to PERSON1, 15 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="9928eaa7-df5a-40cb-a41d-247e8048a8dd" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~1" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="255~255" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="254~128" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Hue" Name="Hue" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="2700K" Display="'2700K'" Dmx="10~40" Colour="255,255,255" />
      <Function ID="3" Name="3200K" Display="'3200K'" Dmx="41~80" Colour="255,255,255" />
      <Function ID="4" Name="4200K" Display="'4200K'" Dmx="81~120" Colour="255,255,255" />
      <Function ID="5" Name="5600K" Display="'5600K'" Dmx="121~160" Colour="255,255,255" />
      <Function ID="6" Name="6500K" Display="'6500K'" Dmx="161~200" Colour="255,255,255" />
      <Function ID="7" Name="8000K" Display="'8000K'" Dmx="201~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="11~99" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" />
      <Function ID="4" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="110~179" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark ON" Display="'Move in Dark ON'" Dmx="10~19" />
      <Function ID="3" Name="Move in Dark OFF" Display="'Move in Dark OFF'" Dmx="20~29" />
      <Function ID="4" Name="Fan Slow" Display="'Fan Slow'" Dmx="30~39" />
      <Function ID="5" Name="Fan Normal" Display="'Fan Normal'" Dmx="40~49" />
      <Function ID="6" Name="Fan Fast" Display="'Fan Fast'" Dmx="50~59" />
      <Function ID="7" Name="Fan Auto" Display="'Fan Auto'" Dmx="60~69" />
      <Function ID="8" Name="Auto 1" Display="'Auto 1'" Dmx="70~79" />
      <Function ID="9" Name="Auto 2" Display="'Auto 2'" Dmx="80~89" />
      <Function ID="10" Name="Custom" Display="'Custom'" Dmx="90~99" />
      <Function ID="11" Name="Test" Display="'Test'" Dmx="100~109" />
      <Function ID="12" Name="Reset" Display="'Reset'" Dmx="110~119" />
      <Function ID="13" Name="Dim Curve 0" Display="'Dim Curve 0'" Dmx="130~139" />
      <Function ID="14" Name="Dim Curve 1" Display="'Dim Curve 1'" Dmx="140~149" />
      <Function ID="15" Name="Dim Curve 2" Display="'Dim Curve 2'" Dmx="150~159" />
      <Function ID="16" Name="Dim Curve 3" Display="'Dim Curve 3'" Dmx="160~169" />
      <Function ID="17" Name="Dim Curve 4" Display="'Dim Curve 4'" Dmx="170~179" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~189" Colour="255,255,255" />
      <Function ID="3" Name="2700K" Display="'2700K'" Dmx="190~199" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="200~209" Colour="255,255,255" />
      <Function ID="5" Name="4200K" Display="'4200K'" Dmx="210~219" Colour="255,255,255" />
      <Function ID="6" Name="5600K" Display="'5600K'" Dmx="220~229" Colour="255,255,255" />
      <Function ID="7" Name="6500K" Display="'6500K'" Dmx="230~239" Colour="255,255,255" />
      <Function ID="8" Name="8000K" Display="'8000K'" Dmx="240~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="ColourIntensity" Name="Intensity" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Intensity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>

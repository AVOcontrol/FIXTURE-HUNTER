  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="180~189" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="120~149" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="150~179" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C">
      <Locate Locate="1:1800" PowerOn="1:1800" />
      <Function ID="1" Name="CCT C-Mix" Display="'%.fK',1800~10000" Dmx="0~255" Colour="255,240,200" />
      <Function ID="2" Name="1800K" Display="'1800K'" Dmx="10~10" Colour="255,255,255" />
      <Function ID="3" Name="2700K" Display="'2700K'" Dmx="79~79" Colour="255,255,255" />
      <Function ID="4" Name="3000K" Display="'3000K'" Dmx="92~92" Colour="255,255,255" />

      <Condition Name="Scroll" ID="29,30,31,32" If="'Gobo1Func'==3" />
      <Else ID="33" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>257681df-5703-420b-86c4-6fd80702e529</Swatch>
      </Function>
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="5~7" WheelPosition="1">

      <Function ID="11" Name="Magenta" Display="'Magenta'" Dmx="86~89" WheelPosition="10" Colour="255,0,255" />
      <Function ID="12" Name="Fluorescence" Display="'Fluorescence'" Dmx="94~98" WheelPosition="11" Colour="50,0,200" />
      <Function ID="13" Name="Sky Blue" Display="'Sky Blue'" Dmx="103~106" WheelPosition="12" Colour="50,125,255" />
      <Function ID="14" Name="Deep Green" Display="'Deep Green'" Dmx="111~115" WheelPosition="13" Colour="0,150,0" />
      <Function ID="15" Name="Deep Blue" Display="'Deep Blue'" Dmx="120~123" WheelPosition="14" Colour="0,0,200" />
      <Function ID="16" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="D Rd/ Org" Display="'D Rd/ Org'" Dmx="13~17" WheelPosition="1" Colour="200,0,0" />
      <Function ID="18" Name="Org/ Grn" Display="'Org/ Grn'" Dmx="22~25" WheelPosition="2" Colour="255,150,0" />
      <Function ID="19" Name="Grn/ Yel" Display="'Grn/ Yel'" Dmx="30~34" WheelPosition="3" Colour="0,255,0" />
      <Function ID="20" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="39~42" WheelPosition="4" Colour="255,255,0" />
      <Function ID="21" Name="Blu/ D Yel" Display="'Blu/ D Yel'" Dmx="47~51" WheelPosition="5" Colour="0,0,255" />
      <Function ID="22" Name="D Yel/ CTB" Display="'D Yel/ CTB'" Dmx="56~59" WheelPosition="6" Colour="200,150,0" />
      <Function ID="23" Name="CTB/ CTO" Display="'CTB/ CTO'" Dmx="64~68" WheelPosition="7" Colour="200,200,255" />
      <Function ID="24" Name="CTO/ Rd" Display="'CTO/ Rd'" Dmx="73~76" WheelPosition="8" Colour="255,220,150" />
      <Function ID="25" Name="Rd/ Mag" Display="'Rd/ Mag'" Dmx="82~85" WheelPosition="9" Colour="255,0,0" />
      <Function ID="26" Name="Mag/ Fl" Display="'Mag/ Fl'" Dmx="90~93" WheelPosition="10" Colour="255,0,255" />
      <Function ID="27" Name="Fl/ S Blu" Display="'Fl/ S Blu'" Dmx="99~102" WheelPosition="11" Colour="50,0,200" />
      <Function ID="28" Name="S Blu/ D Grn" Display="'S Blu/ D Grn'" Dmx="107~110" WheelPosition="12" Colour="50,125,255" />
      <Function ID="29" Name="D Grn/ D Blu" Display="'D Grn/ D Blu'" Dmx="116~119" WheelPosition="13" Colour="0,150,0" />
      <Function ID="30" Name="D Blu/ Op" Display="'D Blu/ Op'" Dmx="124~127" WheelPosition="14" Colour="0,0,200" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~202" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="203~255" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />

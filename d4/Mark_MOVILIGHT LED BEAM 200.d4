      <Function ID="20" Name="Org/ CBO" Display="'Org/ CBO'" Dmx="55~59" WheelPosition="5" Colour="255,128,0" />
      <Function ID="21" Name="CBO/ L Grn" Display="'CBO/ L Grn'" Dmx="65~69" WheelPosition="6" Colour="255,240,200" />
      <Function ID="22" Name="L Grn/ Pk" Display="'L Grn/ Pk'" Dmx="75~79" WheelPosition="7" Colour="128,255,0" />
      <Function ID="23" Name="Pk/ Cy" Display="'Pk/ Cy'" Dmx="85~89" WheelPosition="8" Colour="255,150,150" />
      <Function ID="24" Name="Cy/ Ppl" Display="'Cy/ Ppl'" Dmx="95~99" WheelPosition="9" Colour="0,255,255" />
      <Function ID="25" Name="Ppl/ CTO" Display="'Ppl/ CTO'" Dmx="105~109" WheelPosition="10" Colour="128,0,255" />
      <Function ID="26" Name="CTO/ Amb" Display="'CTO/ Amb'" Dmx="115~119" WheelPosition="11" Colour="255,240,200" />

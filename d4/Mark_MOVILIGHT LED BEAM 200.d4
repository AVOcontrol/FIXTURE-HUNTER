      <Function ID="11" Name="Purple" Display="'Purple'" Dmx="100~104" WheelPosition="10" Colour="128,0,255" />
      <Function ID="12" Name="CTO" Display="'CTO'" Dmx="110~114" WheelPosition="11" Colour="255,240,200" />
      <Function ID="13" Name="Amber" Display="'Amber'" Dmx="120~124" WheelPosition="12" Colour="255,100,0" />
      <Function ID="14" Name="UV" Display="'UV'" Dmx="130~134" WheelPosition="13" Colour="180,0,255" />
      <Function ID="15" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="16" Name="Rd/ Yel" Display="'Rd/ Yel'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="17" Name="Yel/ Blu" Display="'Yel/ Blu'" Dmx="25~29" WheelPosition="2" Colour="255,255,0" />
      <Function ID="18" Name="Blu/ Grn" Display="'Blu/ Grn'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />

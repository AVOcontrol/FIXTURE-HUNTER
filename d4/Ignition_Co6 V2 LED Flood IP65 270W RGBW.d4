  <Macro>
    <Macro Name="Dim LED">
      <Set Channel="Control:2" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Dim Halogen">
      <Set Channel="Control:3" Delay="6000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Silent On">
      <Set Channel="Control:4" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Silent Off">
      <Set Channel="Control:5" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>

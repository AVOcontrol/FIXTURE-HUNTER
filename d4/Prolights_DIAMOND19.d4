      <Function ID="8" Name="Pattern 7" Display="'Pattern 7'" Dmx="128~143" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="9" Name="Pattern 8" Display="'Pattern 8'" Dmx="144~159" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="10" Name="Pattern 9" Display="'Pattern 9'" Dmx="160~175" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="11" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~191" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Pattern 11" Display="'Pattern 11'" Dmx="192~207" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Pattern 12" Display="'Pattern 12'" Dmx="208~223" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Pattern 13" Display="'Pattern 13'" Dmx="224~239" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Pattern 14" Display="'Pattern 14'" Dmx="240~255" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Control" Display="'Control'" Dmx="16~31" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Patt_Spd" Name="Patt Spd" Description="" Group="G">
      <Locate Locate="4" PowerOn="4" />
      <Condition Name="Control" ID="1,2" If="'Pattern'==2" />
      <Condition Name="Effect" ID="3" If="'Pattern'&gt;1&amp;&amp;'Pattern'&lt;16" />
      <Else ID="4" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Effect" Display="'Effect %.f',1~250" Dmx="3~252" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="No Function" Display="''" Dmx="0~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>

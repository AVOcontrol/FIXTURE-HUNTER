      <Function ID="2" Name="On" Display="'On'" Dmx="255~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Pixel_Master" Name="Pixel Master" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

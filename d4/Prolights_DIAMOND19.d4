    <Attribute ID="Pattern" Name="Pattern" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Pattern 1" Display="'Pattern 1'" Dmx="32~47" Update="Patt_Spd" GoboSpin="0~0" GoboOrientation="0~0" />

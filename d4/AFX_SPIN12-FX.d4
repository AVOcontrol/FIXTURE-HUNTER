  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eee07e5b-d75b-468a-b5eb-1a6803797f9b" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Pan_Spin" Name="Pan Spin" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Normal" Display="'Normal'" Dmx="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.f%%',100~0" Dmx="51~151" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.f%%',0~100" Dmx="152~255" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="5" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="24~47" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="48~71" Colour="0,255,0" />
      <Function ID="4" Name="Blue" Display="'Blue'" Dmx="72~95" Colour="0,0,255" />
      <Function ID="5" Name="White" Display="'White'" Dmx="96~119" Colour="255,255,255" />
      <Function ID="6" Name="R+G" Display="'R+G'" Dmx="120~143" Colour="255,255,255" />
      <Function ID="7" Name="R+B" Display="'R+B'" Dmx="144~167" Colour="255,255,255" />
      <Function ID="8" Name="G+B" Display="'G+B'" Dmx="168~191" Colour="255,255,255" />
      <Function ID="9" Name="R+G+B" Display="'R+G+B'" Dmx="192~215" Colour="255,255,255" />
      <Function ID="10" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="216~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="LED_Effect" Name="LED Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Effect 1" Display="'Effect 1'" Dmx="0~0" />
      <Function ID="2" Name="Effect 2" Display="'Effect 2'" Dmx="25~49" />
      <Function ID="3" Name="Effect 3" Display="'Effect 3'" Dmx="50~74" />
      <Function ID="4" Name="Effect 4" Display="'Effect 4'" Dmx="75~99" />
      <Function ID="5" Name="Effect 5" Display="'Effect 5'" Dmx="100~124" />
      <Function ID="6" Name="Effect 6" Display="'Effect 6'" Dmx="125~149" />
      <Function ID="7" Name="Effect 7" Display="'Effect 7'" Dmx="150~174" />
      <Function ID="8" Name="Effect 8" Display="'Effect 8'" Dmx="175~199" />
      <Function ID="9" Name="Effect 9" Display="'Effect 9'" Dmx="200~224" />
      <Function ID="10" Name="Effect 10" Display="'Effect 10'" Dmx="225~255" />
    </Attribute>
    <Attribute ID="LED_Effect_Spd" Name="LED Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="LED Effect" Display="'LED Effect'" Dmx="50~99" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="100~149" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="150~229" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="230~240" />
    </Attribute>
  </Control>

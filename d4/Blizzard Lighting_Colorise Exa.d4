<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Colorise Exa" ShortName="Colrse Exa" Company="Blizzard Lighting">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="25-11-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="UV" Name="UV" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="UV C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,0,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~5" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="21~60" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="101~140" Intensity="0~0" />
      <Function ID="4" Name="Async" Display="'Async %.f%%',0~100" Dmx="6~20" Intensity="0~0" />
      <Function ID="5" Name="Sine" Display="'Sine %.f%%',0~100" Dmx="61~100" Intensity="0~0" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="141~180" Intensity="0~0" />
      <Function ID="7" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="181~220" Intensity="0~0" />
      <Function ID="8" Name="Square" Display="'Square %.f%%',0~100" Dmx="221~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" />
      <Function ID="2" Name="Colour 1" Display="'Colour 1'" Dmx="11~15" />
      <Function ID="3" Name="Colour 2" Display="'Colour 2'" Dmx="16~20" />
      <Function ID="4" Name="Colour 3" Display="'Colour 3'" Dmx="21~25" />
      <Function ID="5" Name="Colour 4" Display="'Colour 4'" Dmx="26~30" />
      <Function ID="6" Name="Colour 5" Display="'Colour 5'" Dmx="31~35" />
      <Function ID="7" Name="Colour 6" Display="'Colour 6'" Dmx="36~40" />
      <Function ID="8" Name="Colour 7" Display="'Colour 7'" Dmx="41~45" />
      <Function ID="9" Name="Colour 8" Display="'Colour 8'" Dmx="46~50" />
      <Function ID="10" Name="Colour 9" Display="'Colour 9'" Dmx="51~55" />
      <Function ID="11" Name="Colour 10" Display="'Colour 10'" Dmx="56~60" />
      <Function ID="12" Name="Auto 1" Display="'Auto 1'" Dmx="61~65" />
      <Function ID="13" Name="Auto 2" Display="'Auto 2'" Dmx="66~70" />
      <Function ID="14" Name="Auto 3" Display="'Auto 3'" Dmx="71~75" />
      <Function ID="15" Name="Auto 4" Display="'Auto 4'" Dmx="76~80" />
      <Function ID="16" Name="Auto 5" Display="'Auto 5'" Dmx="81~85" />
      <Function ID="17" Name="Program 1" Display="'Program 1'" Dmx="86~90" />
      <Function ID="18" Name="Program 2" Display="'Program 2'" Dmx="91~95" />
      <Function ID="19" Name="Program 3" Display="'Program 3'" Dmx="96~100" />
      <Function ID="20" Name="Sound 1" Display="'Sound 1'" Dmx="101~105" />
      <Function ID="21" Name="Sound 2" Display="'Sound 2'" Dmx="106~110" />
      <Function ID="22" Name="Red" Display="'Red'" Dmx="111~115" />
      <Function ID="23" Name="Green" Display="'Green'" Dmx="116~120" />
      <Function ID="24" Name="Blue" Display="'Blue'" Dmx="121~125" />
      <Function ID="25" Name="Amber" Display="'Amber'" Dmx="126~130" />
      <Function ID="26" Name="White" Display="'White'" Dmx="131~135" />
      <Function ID="27" Name="UV" Display="'UV'" Dmx="136~140" />
      <Function ID="28" Name="Yellow" Display="'Yellow'" Dmx="141~145" />
      <Function ID="29" Name="Pink" Display="'Pink'" Dmx="146~150" />
      <Function ID="30" Name="Cyan" Display="'Cyan'" Dmx="151~155" />
      <Function ID="31" Name="Orange" Display="'Orange'" Dmx="156~160" />
      <Function ID="32" Name="Violet" Display="'Violet'" Dmx="161~165" />
      <Function ID="33" Name="Golden" Display="'Golden'" Dmx="166~170" />
      <Function ID="34" Name="2700K" Display="'2700K'" Dmx="171~175" />
      <Function ID="35" Name="3200K" Display="'3200K'" Dmx="176~180" />
      <Function ID="36" Name="4000K" Display="'4000K'" Dmx="181~185" />
      <Function ID="37" Name="5500K" Display="'5500K'" Dmx="186~190" />
      <Function ID="38" Name="6500K" Display="'6500K'" Dmx="191~195" />
      <Function ID="39" Name="R+G+B+W" Display="'R+G+B+W'" Dmx="196~200" />
      <Function ID="40" Name="No Function" Display="'No Function'" Dmx="201~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~10" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Mode" Name="Dim Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~10" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="11~20" />
      <Function ID="3" Name="Square" Display="'Square'" Dmx="21~30" />
      <Function ID="4" Name="Inv Square" Display="'Inv Square'" Dmx="31~40" />
      <Function ID="5" Name="S-Curve" Display="'S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Linear Smooth" Display="'Linear Smooth'" Dmx="51~60" />
      <Function ID="7" Name="Square Smooth" Display="'Square Smooth'" Dmx="61~70" />
      <Function ID="8" Name="Inv Sq Smooth" Display="'Inv Sq Smooth'" Dmx="71~80" />
      <Function ID="9" Name="S Smooth" Display="'S Smooth'" Dmx="81~90" />
      <Function ID="10" Name="Default" Display="'Default'" Dmx="91~255" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="UKBLCEX1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />

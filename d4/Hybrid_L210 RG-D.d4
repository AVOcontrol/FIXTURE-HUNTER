<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="L210 RG-D" ShortName="L210 RG-D" Company="Hybrid">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="08-09-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="4" PowerOn="4" />
      <Function ID="1" Name="Laser Off" Display="'Laser Off'" Dmx="0~0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="50~99" />
      <Function ID="3" Name="Auto" Display="'Auto'" Dmx="100~149" />
      <Function ID="4" Name="DMX" Display="'DMX'" Dmx="150~255" />
    </Attribute>
    <Attribute ID="Rot_Direction" Name="Rot Direction" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW'" Dmx="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="100~199" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Rot_Speed" Name="Rot Speed" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Stop" Display="'Stop'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="255~1" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Red+Green" Display="'Red+Green'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="100~199" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="200~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UKHYL210" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Mode" ChannelOffset="1" Wheel="28" />
      <Attribute ID="Rot_Direction" ChannelOffset="2" Wheel="19" />
      <Attribute ID="Rot_Speed" ChannelOffset="3" Wheel="20" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="7" />
    </Include>
  </Mode>
</Fixture>
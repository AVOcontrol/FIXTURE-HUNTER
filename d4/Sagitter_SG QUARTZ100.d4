    <Attribute ID="Pattern" Name="Pattern" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Pattern" Display="'No Pattern'" Dmx="0~0" Update="Pattern_Ctrl" />
      <Function ID="2" Name="Static" Display="'Static'" Dmx="16~31" Update="Pattern_Ctrl" />
      <Function ID="3" Name="Dynamic" Display="'Dynamic %.1f%%',0.0~100.0" Dmx="32~255" Update="Pattern_Ctrl" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Pattern_Ctrl" />
    </Attribute>
    <Attribute ID="Pattern_Ctrl" Name="Pattern Ctrl" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="No Function" ID="1" If="'Pattern'==1" />
      <Condition Name="Static" ID="2" If="'Pattern'==2" />
      <Condition Name="Dynamic" ID="3,4,5,6,7" If="'Pattern'==3" />
      <Else ID="8" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="2" Name="Pattern" Display="'%.f',0~255" Dmx="0~255" />
      <Function ID="3" Name="Index" Display="'Index %.f%%',0~100" Dmx="0~23" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="138~141" />
      <Function ID="5" Name="FWD" Display="'FWD %.f%%',100~0" Dmx="137~24" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="138~141" />
      <Function ID="7" Name="REV" Display="'REV %.f%%',0~255" Dmx="142~255" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />

      <Function ID="12" Name="CTB" Display="'CTB'" Dmx="55~59" WheelPosition="11" Colour="230,230,255" />
      <Function ID="13" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="60~64" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="65~69" WheelPosition="1" Colour="255,0,0" />
      <Function ID="15" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="70~74" WheelPosition="2" Colour="0,255,0" />

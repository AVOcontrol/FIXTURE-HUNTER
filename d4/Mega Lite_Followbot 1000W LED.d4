<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Followbot 1000W LED" ShortName="Followbot" Company="Mega Lite" Version="1">
  <Copyright Notice="© Avolites Ltd. 2023" />
  <Thumbnail>2792a5dd-ca3a-4a50-afea-d5b1f4304222</Thumbnail>
  <History Date="19-09-23" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="21-09-23" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8761cf31-9661-4a7a-a49a-731dbef29ae5" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="2~127" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="192~255" />
      <Function ID="4" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="128~159" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="160~191" />
    </Attribute>
    <Attribute ID="Iris" Name="Iris" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Iris" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="32~63" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="64~95" Colour="0,255,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="96~127" Colour="255,255,0" />
      <Function ID="5" Name="Blue" Display="'Blue'" Dmx="128~159" Colour="0,0,255" />
      <Function ID="6" Name="Orange" Display="'Orange'" Dmx="160~191" Colour="255,128,0" />
      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="192~223" Colour="128,0,255" />
      <Function ID="8" Name="Aqua" Display="'Aqua'" Dmx="224~255" Colour="0,255,200" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="63K" Display="'63K'" Dmx="64~127" Colour="255,255,255" />
      <Function ID="3" Name="52K" Display="'52K'" Dmx="128~191" Colour="255,255,255" />
      <Function ID="4" Name="33K" Display="'33K'" Dmx="192~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Zoom" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Focus" Name="Focus" Description="" Group="B">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Focus" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Frost" Name="Diffusion" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Diffusion" Display="'Diffusion'" Dmx="255~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8" Id="c32e66a4-7cde-4f30-9293-05b73a2eab0f">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="98bed292-5b86-47bb-9633-d15325f46e6e" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />
      <Attribute ID="Iris" ChannelOffset="3" Wheel="21" />
      <Attribute ID="Colour1" ChannelOffset="4" Wheel="8" />
      <Attribute ID="CTO" ChannelOffset="5" Wheel="9" />
      <Attribute ID="Zoom" ChannelOffset="6" Wheel="19" />
      <Attribute ID="Focus" ChannelOffset="7" Wheel="20" />
      <Attribute ID="Frost" ChannelOffset="8" Wheel="49" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:2" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:4" />
      <Palette ID="5" Name="Green" Number="0" Page="1" SetControl="Colour1:3" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:3" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Colour1:8" />
      <Palette ID="8" Name="Aqua" Number="6" Page="1" SetControl="Colour1:8" />
      <Palette ID="9" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:5" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Colour1:7" />
      <Palette ID="12" Name="Purple" Number="10" Page="1" SetControl="Colour1:7" />
      <Palette ID="13" Name="Red" Number="0" Page="1" SetControl="Colour1:2" />
      <Palette ID="14" Name="Purple" Number="8" Page="1" SetControl="Colour1:7" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:5" />
    </Group>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:1" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:2:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:2:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="6" Name="Slow Pulse" Legend="Slow Pls" Number="36" Page="1" SetControl="Shutter:4:50" />
      <Palette ID="7" Name="Fast Pulse" Legend="Fast Pls" Number="37" Page="1" SetControl="Shutter:4:100" />
    </Group>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
      <Palette ID="4" Name="Iris Small" Number="44" Page="1" SetControl="Iris:1:0" />
      <Palette ID="5" Name="Iris Medium" Legend="Iris Med" Number="45" Page="1" SetControl="Iris:1:50" />
      <Palette ID="6" Name="Iris Large" Number="46" Page="1" SetControl="Iris:1:100" />
    </Group>
  </Palettes>
  <swatchLibrary>
    <Swatch id="2792a5dd-ca3a-4a50-afea-d5b1f4304222"></Swatch>

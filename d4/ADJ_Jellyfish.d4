  <Control>
    <Attribute ID="Effect_Mode" Name="Effect Mode" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Colour" Display="'Colour'" Dmx="0~119" Update="Effect, Shutter" />
      <Function ID="2" Name="Chase" Display="'Chase'" Dmx="120~239" Update="Effect, Shutter" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="240~255" Update="Effect, Shutter" />

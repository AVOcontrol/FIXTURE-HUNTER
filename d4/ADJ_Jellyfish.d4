    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Colour" ID="1,2" If="'Effect_Mode'==1" />
      <Condition Name="Chase" ID="3,4" If="'Effect_Mode'==2" />
      <Else ID="5" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
      <Function ID="3" Name="Open" Display="'Open'" Dmx="0~9" Intensity="0~0" />
      <Function ID="4" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="10~255" Intensity="0~0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">

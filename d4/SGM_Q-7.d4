  <History Date="08-03-14" Author="Nic Morris" Comment="Created" Version="1" />
  <History Date="17-08-16" Author="Nic Morris" Comment="Changed duration and rate to locate at 255 in response to customer bug report." Version="2" />
  <History Date="05-09-16" Author="Nic Morris" Comment="Added Atlabase ID's." Version="3" />
  <History Date="07-08-17" Author="Nic Morris" Comment="Changed name from Q7 to Q-7." Version="4" />
  <History Date="07-08-17" Author="Nic Morris" Comment="Added Full Color Calibrated, 3 DMX and CTC, 6 DMX modes in line with FW v2.43/ Protocol Rev 2 charts." Version="5" />
  <History Date="10-08-17" Author="Nic Morris" Comment="Added Atlabase ID's to CTC, 6 DMX and Full Color Calibrated, 3 DMX modes." Version="6" />
  <History Date="09-11-18" Author="Nic Morris" Comment="Updated in line with FW 3.00/ Protocol Rev.4 charts (note XC-5 Emulation chart has errors - channel conflicts and wrong count)" Version="7" />
  <History Date="09-11-18" Author="Nic Morris" Comment="Revised effect with discreet functions.  Revised CTC functions and default values.  Added product thumbnail" Version="8" />
  <History Date="14-11-18" Author="Nic Morris" Comment="Added 10 DMX mode Atlabase ID" Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d87dafeb-2664-4e6c-8e4a-9434165cd2ce" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~151" Intensity="0~0" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="200~244" Intensity="0~0" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse    %.f%%',0~100" Dmx="152~175" Intensity="0~0" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse   %.f%%',0~100" Dmx="176~199" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Rate" Name="Rate" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Rate" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Duration" Name="Duration" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Duration" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Flicker" Display="'Flicker %.f%%',0~100" Dmx="6~10" />
      <Function ID="3" Name="Lightning" Display="'Lightning %.f%%',0~100" Dmx="11~15" />
      <Function ID="4" Name="Random Strobe" Display="'Random Strobe'" Dmx="16~20" />
      <Function ID="5" Name="Flicker Col" Display="'Flicker Col %.f%%',0~100" Dmx="21~25" />
      <Function ID="6" Name="Rnd Strobe Col" Display="'Rnd Strobe Col'" Dmx="26~30" />
      <Function ID="7" Name="Rnd Spike Col" Display="'Rnd Spike Col %.f%%',0~100" Dmx="31~35" />
      <Function ID="8" Name="Rnd Spike Glow" Display="'Rnd Spike Glow %.f%%',0~100" Dmx="36~40" />
    </Attribute>
    <Attribute ID="CTC" Name="CTC" Description="" Group="C">
      <Locate Locate="3:7664" PowerOn="3:7664" />
      <Function ID="1" Name="5600K" Display="'5600K'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="No CTC (RAW)" Display="'No CTC (RAW)'" Dmx="1~4" Colour="255,255,255" />
      <Function ID="3" Name="CTO C-Mix" Display="'%.fK',2000~10000" Dmx="5~255" Colour="255,240,200" />
    </Attribute>
  </Control>

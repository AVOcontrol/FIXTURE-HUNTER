<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="GFL 500" ShortName="GFL 500" Company="Contest">
  <Copyright Notice="© Avolites Ltd. 2015" />
  <History Date="07-12-15" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Lamp On" Display="'Lamp On'" Dmx="0~8" Colour="255,255,255" />
      <Function ID="2" Name="Off" Display="'Off'" Dmx="9~16" Colour="255,255,255" />
      <Function ID="3" Name="White" Display="'White'" Dmx="17~32" Colour="255,255,255" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="33~48" Colour="255,0,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="49~64" Colour="0,255,0" />
      <Function ID="6" Name="Yellow" Display="'Yellow'" Dmx="65~80" Colour="255,255,0" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="81~96" Colour="0,0,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="97~112" Colour="255,128,0" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="113~128" Colour="0,255,255" />
      <Function ID="10" Name="Magenta" Display="'Magenta'" Dmx="129~144" Colour="255,0,255" />
      <Function ID="11" Name="Turquoise" Display="'Turquoise'" Dmx="145~160" Colour="0,255,128" />
      <Function ID="12" Name="Light Magenta" Display="'Light Magenta'" Dmx="161~176" Colour="255,128,255" />
      <Function ID="13" Name="Bicolour" Display="'Bicolour'" Dmx="177~192" Colour="255,255,255" />
      <Function ID="14" Name="Light Yellow" Display="'Yellow'" Dmx="193~208" Colour="255,255,128" />
      <Function ID="15" Name="Light Green" Display="'Light Green'" Dmx="209~224" Colour="128,255,0" />
      <Function ID="16" Name="Light Red" Display="'Light Red'" Dmx="225~240" Colour="255,100,100" />
      <Function ID="17" Name="White" Display="'White'" Dmx="241~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="B">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="0~120" Iris="0~0" Zoom="0~0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="121~133" Iris="0~0" Zoom="0~0" />
      <Function ID="3" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" Iris="0~0" Zoom="0~0" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="COGFL500" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Speed" ChannelOffset="2" Wheel="19" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Lamp On" Number="1" Page="1" SetControl="Colour1:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:4" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:8" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:6" />
      <Palette ID="5" Name="Light Green" Number="0" Page="1" SetControl="Colour1:15" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Colour1:5" />
      <Palette ID="7" Name="Turquoise" Number="0" Page="1" SetControl="Colour1:11" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Colour1:9" />
      <Palette ID="9" Name="Cyan" Number="0" Page="1" SetControl="Colour1:9" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Colour1:7" />
      <Palette ID="11" Name="Magenta" Number="9" Page="1" SetControl="Colour1:10" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Colour1:10" />
      <Palette ID="13" Name="Light Red" Number="0" Page="1" SetControl="Colour1:16" />
      <Palette ID="14" Name="Light Magenta" Number="8" Page="1" SetControl="Colour1:12" />
      <Palette ID="15" Name="Blue" Number="0" Page="1" SetControl="Colour1:7" />
    </Group>
  </Palettes>
</Fixture>
  <History Date="14-08-16" Author="Nic Morris" Comment="Changed Warm White and Cool White to reserved attribute ID's and revised locate values." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b5bee9e9-dbfa-4f5a-86f6-841d62ff2de7" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="52~101" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="102~152" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="153~203" />
      <Function ID="5" Name="Auto 4" Display="'Auto 4'" Dmx="204~254" />
      <Function ID="6" Name="Auto 5" Display="'Auto 5'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Linear" Display="'Linear'" Dmx="52~101" />
      <Function ID="3" Name="Curve 1" Display="'Curve 1'" Dmx="102~152" />
      <Function ID="4" Name="Curve 2" Display="'Curve 2'" Dmx="153~203" />
      <Function ID="5" Name="Curve 3" Display="'Curve 3'" Dmx="204~255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">

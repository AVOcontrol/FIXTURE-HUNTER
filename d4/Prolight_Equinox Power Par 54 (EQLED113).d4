  <AtlaBase TypeID="0086d7d2-cdfa-4171-bef1-2c35c80db03c" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Effect_1" Name="Effect 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="28~55" />
      <Function ID="3" Name="Col Strobe" Display="'Col Strobe'" Dmx="56~83" />
      <Function ID="4" Name="Red" Display="'Red'" Dmx="84~111" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="112~139" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="140~167" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="168~195" />
      <Function ID="8" Name="Purple" Display="'Purple'" Dmx="196~223" />
      <Function ID="9" Name="Cyan" Display="'Cyan'" Dmx="224~251" />
      <Function ID="10" Name="White" Display="'White'" Dmx="252~255" />
    </Attribute>
    <Attribute ID="Effect_2" Name="Effect 2" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Red Pulse" Display="'Red Pulse'" Dmx="1~2" />
      <Function ID="3" Name="Green Pulse" Display="'Green Pulse'" Dmx="13~25" />

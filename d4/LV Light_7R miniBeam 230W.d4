      <Function ID="29" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" />
      <Function ID="30" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="140~195" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="196~199" />
      <Function ID="32" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="200~255" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Prism" Display="'Prism'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Prism_2" Name="Prism 2" Description="" Group="E">

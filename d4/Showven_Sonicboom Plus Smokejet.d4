      <Function ID="7" Name="Purple" Display="'Purple'" Dmx="121~140" Colour="128,0,255" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="141~160" Colour="255,128,0" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="161~180" Colour="255,255,0" />
      <Function ID="10" Name="Sky Blue" Display="'Sky Blue'" Dmx="181~200" Colour="0,0,255" />
      <Function ID="11" Name="White" Display="'White'" Dmx="201~220" Colour="255,255,255" />

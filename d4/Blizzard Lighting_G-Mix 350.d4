      <Function ID="6" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="14~38" WheelPosition="0" Colour="255,255,255" />
      <Function ID="7" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="65~89" WheelPosition="1" Colour="255,0,0" />
      <Function ID="8" Name="Grn/ UV" Display="'Grn/ UV'" Dmx="115~138" WheelPosition="2" Colour="0,255,0" />
      <Function ID="9" Name="UV/ Yel" Display="'UV/ Yel'" Dmx="165~191" WheelPosition="3" Colour="180,0,255" />
      <Function ID="10" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

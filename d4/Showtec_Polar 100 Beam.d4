    </Attribute>
    <Attribute ID="Gobo1Rot" Name="Gobo Rot" Description="" Group="G" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Index" ID="1" If="'Gobo1Func'==1||'Gobo1Func'==3||'Gobo1Func'==5" />
      <Condition Name="Spin" ID="2,3,4,5,6,7" If="'Gobo1Func'==2||'Gobo1Func'==4||'Gobo1Func'==6" />
      <Else ID="8" />
      <Function ID="1" Name="Index" Display="'%.2f%%',0.00~100.00" Dmx="0~30840" WheelPosition="0" />
      <Function ID="2" Name="No Spin" Display="'No Spin'" Dmx="31097~32125" />
      <Function ID="3" Name="Spin CW" Display="'Spin CW %.2f%%',100.00~0.00" Dmx="43947~53970" />
      <Function ID="4" Name="No Spin" Display="'No Spin'" Dmx="42662~43690" WheelPosition="0" />
      <Function ID="5" Name="Spin CCW" Display="'Spin CCW %.2f%%',0.00~100.00" Dmx="55512~65535" />
      <Function ID="6" Name="No Spin" Display="'No Spin'" Dmx="54227~55255" />
      <Function ID="7" Name="Bounce" Display="'Bounce %.2f%%',0.00~100.00" Dmx="32382~42405" />
      <Function ID="8" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Prism_1" Name="Prism 1" Description="" Group="E">

      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="107~114" WheelPosition="7">
        <Swatch>aa6aa242-854e-440c-ba4e-ff4809f1e200</Swatch>

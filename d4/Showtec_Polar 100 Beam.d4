      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="53~58" WheelPosition="8">
        <Swatch>5b31b89b-1c09-44e3-adda-35ca935192f4</Swatch>
      </Function>
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0">
        <Swatch>fd750ead-500c-49c9-a7ac-56d161519a8a</Swatch>
      </Function>
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="59~66" WheelPosition="1">
        <Swatch>e1ffd85a-a829-4733-9cc5-a5006a04bbf0</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="67~74" WheelPosition="2">
        <Swatch>ba2559ac-704e-4d7b-ab03-3cca33037722</Swatch>
      </Function>
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="75~82" WheelPosition="3">
        <Swatch>99756526-6d8c-4e11-81ba-7ec09e5faf93</Swatch>
      </Function>
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="83~90" WheelPosition="4">
        <Swatch>43f0b7dd-48c4-423b-b560-ba66c356525e</Swatch>
      </Function>
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="91~98" WheelPosition="5">
        <Swatch>6d6c92d9-eed4-4fe8-8762-61b08427dbb1</Swatch>
      </Function>
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="99~106" WheelPosition="6">
        <Swatch>ccc06900-960c-4927-9b21-17f551d105aa</Swatch>

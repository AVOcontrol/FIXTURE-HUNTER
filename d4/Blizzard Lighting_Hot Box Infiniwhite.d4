  <History Date="13-08-16" Author="Nic Morris" Comment="Added Atlabase ID to 3 DMX mode." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="369d44fb-8574-46f3-a78a-99bfb586a02a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~14" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="15~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Open Pulse" Display="'Open Pulse'" Dmx="32~63" Colour="255,255,255" />
      <Function ID="3" Name="Close Pulse" Display="'Close Pulse'" Dmx="64~95" Colour="255,255,255" />
      <Function ID="4" Name="Pulse" Display="'Pulse'" Dmx="96~127" Colour="255,255,255" />
      <Function ID="5" Name="Gradual" Display="'Gradual'" Dmx="128~159" Colour="255,255,255" />
      <Function ID="6" Name="Auto" Display="'Auto'" Dmx="160~191" Colour="255,255,255" />
      <Function ID="7" Name="Jump" Display="'Jump'" Dmx="192~223" Colour="255,255,255" />
      <Function ID="8" Name="Sound" Display="'Sound'" Dmx="224~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Saturation" Name="Saturation" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Saturation" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Preset" Display="'Preset'" Dmx="0~0" />
      <Function ID="2" Name="Mode 0" Display="'Mode 0'" Dmx="6~55" />
      <Function ID="3" Name="Mode 1" Display="'Mode 1'" Dmx="56~105" />
      <Function ID="4" Name="Mode 2" Display="'Mode 2'" Dmx="106~155" />
      <Function ID="5" Name="Mode 3" Display="'Mode 3'" Dmx="156~205" />
      <Function ID="6" Name="Mode 4" Display="'Mode 4'" Dmx="206~255" />
    </Attribute>
  </Control>
  <Mode Name="8 DMX" Channels="8">
    <Import PearlRef="UKBLHBW8" DiamondRef="" WysiwygRef="" />

      <Function ID="27" Name="12/ 13" Display="'12/ 13'" Dmx="100~103" WheelPosition="12" Colour="0,0,0" />
      <Function ID="28" Name="13/ Op" Display="'13/ Op'" Dmx="108~127" WheelPosition="13" Colour="0,0,0" />

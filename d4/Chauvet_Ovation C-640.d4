<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Ovation C-640" ShortName="Ov C-640" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="29-03-11" Author="John Rogers" Comment="Created" />
  <History Date="14-04-11" Author="Nic Morris" Comment="Added Macro dependant conditionals.  Changed shutter locate and power on to open." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Increased wheel resolution.  Changed ID power on and locate to All IDs." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed dimmer speed non-linear to explicit values." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Changed HSV attribute groups and wheel mapping.  Added v-dim to PIXEL mode." />
  <History Date="14-04-11" Author="Nic Morris" Comment="Adapted from COLORado 3P Tour." />
  <History Date="16-06-11" Author="Nic Morris" Comment="Fixed power on and locate.  Removed Value and replaced with Dimmer for HTP." />
  <History Date="03-01-13" Author="Peter Budd" Comment="Created from Chauvet COLORado Ridge IP" />
  <History Date="06-06-13" Author="Peter Budd" Comment="Created from the Silver Star SS 809 XCA." />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="24-08-14" Author="Nic Morris" Comment="Changed name from 'Oviation' to 'Ovation' in response to customer bug report.  Fixed palettes." />
  <History Date="24-08-14" Author="Nic Morris" Comment="Removed Shutter Func as it didn't do anything.  Increased wheel resolution of 16-bit attributes," />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added missing Atlabase ID to ARC3 mode.  Fixed AR3+S mapping." />
  <History Date="04-09-16" Author="Nic Morris" Comment="Added PX16 mode" />
  <History Date="28-10-17" Author="Nic Morris" Comment="Changed dimmer to intensity in HSI modes and linked to vdim for compatibility" />
  <History Date="28-10-17" Author="Nic Morris" Comment="Added channel counts to mode names." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4167e67b-9a99-49da-b898-8e6936a2f3e0" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Step Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
      <Function ID="2" Name="Step Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Fade Time" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
      <Function ID="2" Name="Fade Time" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Condition Name="No Function" ID="2" If="'Auto'&gt;11" />
      <Else ID="1" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="11~170" Colour="255,255,255" />
      <Function ID="3" Name="RGBWA Full" Display="'RGBWA Full'" Dmx="171~200" Colour="255,255,255" />
      <Function ID="4" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="255,255,255" />
      <Function ID="5" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="255,255,255" />
      <Function ID="6" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="255,255,255" />
      <Function ID="7" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="255,255,255" />
      <Function ID="8" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="255,255,255" />
      <Function ID="9" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="255,255,255" />
      <Function ID="10" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="255,255,255" />
      <Function ID="11" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="255,255,255" />
      <Function ID="12" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="255,255,255" />
      <Function ID="13" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="255,255,255" />
      <Function ID="14" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="10~99" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe    %.f%%',0~100" Dmx="190~255" Intensity="0~0" />
      <Function ID="4" Name="Pulse" Display="'Pulse %.f%%',0~100" Dmx="110~179" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Red, Green, Blue" />
      <Function ID="2" Name="Auto 1" Display="'Auto 1'" Dmx="41~50" Update="Red, Green, Blue" />
      <Function ID="3" Name="Auto 2" Display="'Auto 2'" Dmx="51~60" Update="Red, Green, Blue" />
      <Function ID="4" Name="Auto 3" Display="'Auto 3'" Dmx="61~70" Update="Red, Green, Blue" />

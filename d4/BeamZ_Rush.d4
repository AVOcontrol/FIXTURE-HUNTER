    <Attribute ID="Strip_FX_Spd" Name="Strip FX Spd" Description="" Group="E">
      <Locate Locate="2" PowerOn="2" />
      <Else ID="1" />
      <Condition Name="No Effect" ID="2" If="'Strip_FX'==1" />
      <Condition Name="Effect 4-126" ID="3,4" If="'Strip_FX'&gt;4" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="No Function" Display="''" Dmx="0~0" />
      <Function ID="3" Name="Direction 1" Display="'Direction 1 %.1f%%',0.0~100.0" Dmx="0~127" />
      <Function ID="4" Name="Direction 2" Display="'Direction 2 %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>

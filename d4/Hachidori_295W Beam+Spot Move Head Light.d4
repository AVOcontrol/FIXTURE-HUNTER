      <Function ID="13" Name="UV" Display="'UV'" Dmx="120~124" WheelPosition="12" Colour="180,0,255" />
      <Function ID="14" Name="Light Cyan" Display="'Light Cyan'" Dmx="130~134" WheelPosition="13" Colour="128,255,255" />
      <Function ID="15" Name="CTB" Display="'CTB'" Dmx="140~144" WheelPosition="14" Colour="230,230,255" />
      <Function ID="16" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="5~9" WheelPosition="0" Colour="255,255,255" />
      <Function ID="17" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="15~19" WheelPosition="1" Colour="255,0,0" />
      <Function ID="18" Name="Grn/ Blu" Display="'Grn/ Blu'" Dmx="25~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="19" Name="Blu/ Yel" Display="'Blu/ Yel'" Dmx="35~39" WheelPosition="3" Colour="0,0,255" />
      <Function ID="20" Name="Yel/ Amb" Display="'Yel/ Amb'" Dmx="45~49" WheelPosition="4" Colour="255,255,0" />
      <Function ID="21" Name="Amb/ CTO" Display="'Amb/ CTO'" Dmx="55~59" WheelPosition="5" Colour="255,100,0" />
      <Function ID="22" Name="CTO/ Mag" Display="'CTO/ Mag'" Dmx="65~69" WheelPosition="6" Colour="255,240,200" />
      <Function ID="23" Name="Mag/ L Grn" Display="'Mag/ L Grn'" Dmx="75~79" WheelPosition="7" Colour="255,0,255" />
      <Function ID="24" Name="L Grn/ Cy" Display="'L Grn/ Cy'" Dmx="85~89" WheelPosition="8" Colour="128,255,0" />
      <Function ID="25" Name="Cy/ L Yel" Display="'Cy/ L Yel'" Dmx="95~99" WheelPosition="9" Colour="0,255,255" />
      <Function ID="26" Name="L Yel/ L Pk" Display="'L Yel/ L Pk'" Dmx="105~109" WheelPosition="10" Colour="255,255,128" />
      <Function ID="27" Name="L Pk/ UV" Display="'L Pk/ UV'" Dmx="115~119" WheelPosition="11" Colour="255,200,200" />
      <Function ID="28" Name="UV/ L Cy" Display="'UV/ L Cy'" Dmx="125~129" WheelPosition="12" Colour="180,0,255" />
      <Function ID="29" Name="L CY/ CTB" Display="'L CY/ CTB'" Dmx="135~139" WheelPosition="13" Colour="128,255,255" />
      <Function ID="30" Name="CTB/ Op" Display="'CTB/ Op'" Dmx="145~149" WheelPosition="14" Colour="230,230,255" />
      <Function ID="31" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="32" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="150~202" Colour="0,0,0" />
      <Function ID="33" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="34" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="203~255" Colour="0,0,0" />
      <Function ID="35" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="4~103" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="213~251" />
      <Function ID="5" Name="Strobe (Mode 2)" Display="'Strobe (Mode 2) %.f%%',0~100" Dmx="108~207" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />

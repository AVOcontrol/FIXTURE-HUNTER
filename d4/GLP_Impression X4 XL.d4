      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" Intensity="0~0" />
      <Function ID="3" Name="Strobe" Display="'Strobe %.1f Hz',1.0~10.0" Dmx="200~239" Intensity="0~0" />

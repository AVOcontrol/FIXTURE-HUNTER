    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="6~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Delay On" Display="'Delay On'" Dmx="0~0" />
      <Function ID="2" Name="Delay Off" Display="'Delay Off'" Dmx="26~100" />
      <Function ID="3" Name="Fade" Display="'Fade %.f%%',0~100" Dmx="101~150" />
      <Function ID="4" Name="Snap" Display="'Snap %.f%%',0~100" Dmx="151~200" />
      <Function ID="5" Name="xFade" Display="'xFade %.f%%',0~100" Dmx="201~250" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
  </Control>

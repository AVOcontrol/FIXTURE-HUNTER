  <Thumbnail>f6e98898-5074-4131-a267-1c4292a99965</Thumbnail>
  <History Date="12-01-26" Author="Nic Morris" Comment="Created (no pixel layout)" Version="0" />
  <History Date="14-01-26" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="ede6158b-5808-4d3b-b02f-1864578ecc2a" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Auto" Name="Auto" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" Update="Auto_Spd" />
      <Function ID="2" Name="Colour Temp" Display="'Colour Temp'" Dmx="10~19" Update="Auto_Spd" />
      <Function ID="3" Name="CW Breathing" Display="'CW Breathing'" Dmx="20~29" Update="Auto_Spd" />
      <Function ID="4" Name="WW Breathing" Display="'WW Breathing'" Dmx="30~39" Update="Auto_Spd" />
      <Function ID="5" Name="Breathing" Display="'Breathing'" Dmx="40~49" Update="Auto_Spd" />
      <Function ID="6" Name="Gradient Change" Display="'Gradient Change'" Dmx="50~59" Update="Auto_Spd" />
      <Function ID="7" Name="Auto 1 (Cycle Auto)" Display="'Auto 1 (Cycle Auto)'" Dmx="60~69" Update="Auto_Spd" />
      <Function ID="8" Name="Auto 2" Display="'Auto 2'" Dmx="70~79" Update="Auto_Spd" />
      <Function ID="9" Name="Auto 3" Display="'Auto 3'" Dmx="80~89" Update="Auto_Spd" />
      <Function ID="10" Name="Auto 4" Display="'Auto 4'" Dmx="90~99" Update="Auto_Spd" />
      <Function ID="11" Name="Auto 5" Display="'Auto 5'" Dmx="100~109" Update="Auto_Spd" />
      <Function ID="12" Name="Auto 6" Display="'Auto 6'" Dmx="110~119" Update="Auto_Spd" />
      <Function ID="13" Name="Auto 7" Display="'Auto 7'" Dmx="120~129" Update="Auto_Spd" />
      <Function ID="14" Name="Auto 8" Display="'Auto 8'" Dmx="130~139" Update="Auto_Spd" />
      <Function ID="15" Name="Auto 9" Display="'Auto 9'" Dmx="140~149" Update="Auto_Spd" />
      <Function ID="16" Name="Auto 10" Display="'Auto 10'" Dmx="150~159" Update="Auto_Spd" />
      <Function ID="17" Name="Auto 11" Display="'Auto 11'" Dmx="160~169" Update="Auto_Spd" />
      <Function ID="18" Name="Auto 12" Display="'Auto 12'" Dmx="170~179" Update="Auto_Spd" />
      <Function ID="19" Name="Auto 13" Display="'Auto 13'" Dmx="180~189" Update="Auto_Spd" />
      <Function ID="20" Name="Auto 14" Display="'Auto 14'" Dmx="190~199" Update="Auto_Spd" />
      <Function ID="21" Name="Auto 15" Display="'Auto 15'" Dmx="200~219" Update="Auto_Spd" />
      <Function ID="22" Name="Auto 16" Display="'Auto 16'" Dmx="220~229" Update="Auto_Spd" />
      <Function ID="23" Name="Sound 1" Display="'Sound 1'" Dmx="230~239" Update="Auto_Spd" />
      <Function ID="24" Name="Sound 2" Display="'Sound 2'" Dmx="240~255" Update="Auto_Spd" />
    </Attribute>
    <Attribute ID="Auto_Spd" Name="Auto Spd" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Colour Temp" ID="2" If="'Auto'==2" />
      <Condition Name="Sensitivity" ID="3" If="'Auto'&gt;22" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Colour Temp" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cold White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="200,200,255" />
    </Attribute>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="6 DMX" Channels="6" Id="77eda38b-5361-41e5-8e14-9ffa30377f9e">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="aa0510b8-a5bf-41ef-a588-151d0bab1ead" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="5" />

      <Set Channel="Control:4" Delay="10000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:5" Delay="10000" />
      <Set Channel="Control:1:0" Delay="0" />
    </Macro>

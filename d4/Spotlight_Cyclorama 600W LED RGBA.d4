<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Cyclorama 600W LED RGBA" ShortName="Cyc600RGBA" Company="Spotlight" Version="2">
  <Copyright Notice="© Avolites Ltd. 2026" />
  <Thumbnail>47a0fb9b-8e69-4edb-af4d-fb10df3792dd</Thumbnail>
  <History Date="12-03-26" Author="Nic Morris" Comment="Created (datasheet only.  no manual available.  no function ranges)" Version="0" />
  <History Date="13-04-26" Author="Nic Morris" Comment="Split into two fixtures and updated in line with manual.  Extremely confusing documentation.  Very diffcult or impossible to reliably understand what relates to what.  There are two 'Service' controls in the function range details but only one in the charts.  This doesn't make sense and it's impossible to guess.  Left as raw for now." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="8c46ce6e-cfbf-4933-bd1e-5e688a671429" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C" Size="2">

  <AtlaBase TypeID="7ea2f955-07dd-4f12-99da-0caa8b7cffcb" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~240" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Flow_Effect" Name="Flow Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Effect 1" Display="'Effect 1'" Dmx="42~83" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="84~125" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="126~167" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="168~209" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="210~255" />
    </Attribute>
    <Attribute ID="Dim_Spd" Name="Dim Spd" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="254~0" />
      <Function ID="2" Name="Tungsten" Display="'Tungsten'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />

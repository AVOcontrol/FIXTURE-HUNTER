  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="eef2cf96-5c46-471b-a2f4-26c45255ca66" />
  <Control>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~151" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="200~223" />
      <Function ID="5" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="152~175" />
      <Function ID="6" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="176~199" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Macro" Name="Macro" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~0" />
      <Function ID="2" Name="Macro 1 (Rainbow Slow, Stand Time 5s)" Display="'Macro 1 (Rainbow Slow, Stand Time 5s)'" Dmx="128~135" />
      <Function ID="3" Name="Macro 2 (Rainbow Med, Stand Time 5s)" Display="'Macro 2 (Rainbow Med, Stand Time 5s)'" Dmx="136~143" />
      <Function ID="4" Name="Macro 3 (Rainbow Fast, Stand Time 5s)" Display="'Macro 3 (Rainbow Fast, Stand Time 5s)'" Dmx="144~151" />
      <Function ID="5" Name="Macro 4 (Rainbow Slow, No Stand Time)" Display="'Macro 4 (Rainbow Slow, No Stand Time)'" Dmx="152~159" />
      <Function ID="6" Name="Macro 5 (Rainbow Med, No Stand Time)" Display="'Macro 5 (Rainbow Med, No Stand Time)'" Dmx="160~167" />
      <Function ID="7" Name="Macro 6 (Rainbow Fast, No Stand Time)" Display="'Macro 6 (Rainbow Fast, No Stand Time)'" Dmx="168~175" />
      <Function ID="8" Name="Macro 7 (Rainbow Very Slow, No Stand Time)" Display="'Macro 7 (Rainbow Very Slow, No Stand Time)'" Dmx="176~183" />
      <Function ID="9" Name="Macro 8 (Rnd Col Change Slow)" Display="'Macro 8 (Rnd Col Change Slow)'" Dmx="184~191" />
      <Function ID="10" Name="Macro 9 (Rnd Col Change Med)" Display="'Macro 9 (Rnd Col Change Med)'" Dmx="192~199" />
      <Function ID="11" Name="Macro 10 (Rnd Col Change Fast)" Display="'Macro 10 (Rnd Col Change Fast)'" Dmx="200~207" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>

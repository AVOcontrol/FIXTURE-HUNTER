<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="18x10W Pixel LED Bar Wall Washer" ShortName="18x10W Bar" Company="Unknown">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="05-12-17" Author="Nic Morris" Comment="Created (poor documentation - effect and effect func ranges don't make sense - made best guess)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Col Jump" Display="'Col Jump'" Dmx="36~45" />
      <Function ID="3" Name="Col Fade" Display="'Col Fade'" Dmx="46~55" />
      <Function ID="4" Name="Col Sel" Display="'Col Sel'" Dmx="56~65" />
      <Function ID="5" Name="Col Jump" Display="'Col Jump'" Dmx="66~75" />
      <Function ID="6" Name="Col Pulse" Display="'Col Pulse'" Dmx="76~85" />
      <Function ID="7" Name="Pattern 1" Display="'Pattern 1'" Dmx="86~95" />
      <Function ID="8" Name="Pattern 2" Display="'Pattern 2'" Dmx="96~105" />
      <Function ID="9" Name="Pattern 3" Display="'Pattern 3'" Dmx="106~115" />
      <Function ID="10" Name="Pattern 4" Display="'Pattern 4'" Dmx="116~125" />
      <Function ID="11" Name="Pattern 5" Display="'Pattern 5'" Dmx="126~135" />
      <Function ID="12" Name="Pattern 6" Display="'Pattern 6'" Dmx="136~145" />
      <Function ID="13" Name="Pattern 7" Display="'Pattern 7'" Dmx="146~155" />
      <Function ID="14" Name="Pattern 8" Display="'Pattern 8'" Dmx="156~165" />
      <Function ID="15" Name="Pattern 9" Display="'Pattern 9'" Dmx="166~175" />
      <Function ID="16" Name="Pattern 10" Display="'Pattern 10'" Dmx="176~185" />
      <Function ID="17" Name="Pattern 11" Display="'Pattern 11'" Dmx="186~195" />
      <Function ID="18" Name="Pattern 12" Display="'Pattern 12'" Dmx="196~205" />
      <Function ID="19" Name="Pattern 13" Display="'Pattern 13'" Dmx="206~215" />
      <Function ID="20" Name="Pattern 14" Display="'Pattern 14'" Dmx="216~225" />
      <Function ID="21" Name="Pattern 15" Display="'Pattern 15'" Dmx="226~235" />
      <Function ID="22" Name="Pattern 16" Display="'Pattern 16'" Dmx="236~245" />
      <Function ID="23" Name="Sound" Display="'Sound'" Dmx="246~255" />
    </Attribute>
    <Attribute ID="Effect_Func" Name="Effect Func" Description="" Group="E">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4">
    <Import PearlRef="UK1810B4" DiamondRef="" WysiwygRef="" />
    <Physical>

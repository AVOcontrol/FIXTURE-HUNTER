      <Function ID="21" Name="Mag/ Blu" Display="'Mag/ Blu %.f%%',0~100" Dmx="84~96" WheelPosition="7" Colour="255,0,255" />
      <Function ID="22" Name="Blu/ Grn" Display="'Blu/ Grn %.f%%',0~100" Dmx="96~108" WheelPosition="8" Colour="0,0,255" />
      <Function ID="23" Name="Grn/ Ppl" Display="'Grn/ Ppl %.f%%',0~100" Dmx="108~120" WheelPosition="9" Colour="0,255,0" />
      <Function ID="24" Name="Ppl/ Org" Display="'Ppl/ Org %.f%%',0~100" Dmx="120~132" WheelPosition="10" Colour="128,0,255" />
      <Function ID="25" Name="Org/ Blu" Display="'Org/ Blu %.f%%',0~100" Dmx="132~144" WheelPosition="11" Colour="255,128,0" />
      <Function ID="26" Name="Blu/ Op" Display="'Blu/ Op %.f%%',0~100" Dmx="144~150" WheelPosition="12" Colour="0,0,255" />
      <Function ID="27" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="28" Name="Scroll" Display="'Scroll %.f%%',0~100" Dmx="245~208" Colour="255,255,255" />
      <Function ID="29" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="30" Name="Rand. Slow" Display="'Rand. Slow'" Dmx="252~255" Colour="0,0,0" />
      <Function ID="31" Name="Rand. Med." Display="'Rand. Med.'" Dmx="249~251" Colour="0,0,0" />
      <Function ID="32" Name="Rand. Fast" Display="'Rand. Fast'" Dmx="246~248" Colour="0,0,0" />
      <Function ID="33" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>

      <Function ID="2" Name="Full On" Display="'Full On'" Dmx="10~99" />
      <Function ID="3" Name="Erratic" Display="'Erratic'" Dmx="100~129" />
      <Function ID="4" Name="Fade" Display="'Fade'" Dmx="130~159" />

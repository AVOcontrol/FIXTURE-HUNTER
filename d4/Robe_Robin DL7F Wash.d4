  <History Date="01-02-21" Author="Nic Morris" Comment="Inverted zoom." Version="14" />
  <History Date="14-02-25" Author="Nic Morris" Comment="Added product thumbnail (seems to not have happened before!)" Version="15" />
  <History Date="14-02-25" Author="Nic Morris" Comment="Standardised macros in attempt to fix customer bug report.  Also fixed invalid references and renamed/removed control functions/macros that were wrong." Version="15" />

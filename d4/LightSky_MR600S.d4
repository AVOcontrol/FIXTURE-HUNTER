      <Function ID="15" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="140~154" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="16" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="125~139" GoboSpin="0~0" GoboOrientation="0~0" />

      <Function ID="11" Name="Gobo 3" Display="'Gobo 3 %.f%%',0~100" Dmx="205~219" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 4" Display="'Gobo 4 %.f%%',0~100" Dmx="190~204" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="13" Name="Gobo 5" Display="'Gobo 5 %.f%%',0~100" Dmx="175~189" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="14" Name="Gobo 6" Display="'Gobo 6 %.f%%',0~100" Dmx="160~174" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="15" Name="Gobo 7" Display="'Gobo 7 %.f%%',0~100" Dmx="145~159" GoboSpin="0~0" GoboOrientation="0~0" />

  <Macro>
    <Macro Name="Lamp On">
      <Set Channel="Control:8" Delay="6000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
    <Macro Name="Lamp Off">
      <Set Channel="Control:7" Delay="11000" />
      <Set Channel="Control:1" Delay="5000" />
    </Macro>
    <Macro Name="Reset">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="1000" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Colour1:1,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Colour1:8,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="3" Name="Orange" Number="3" Page="1" SetControl="Colour1:6,Colour1Func:1,Colour2:1,Colour2Func:1" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Colour1:3,Colour1Func:1,Colour2:1,Colour2Func:1" />

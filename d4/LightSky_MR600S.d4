      <Function ID="11" Name="Gobo 1" Display="'Gobo 1 %.f%%',0~100" Dmx="200~214" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="12" Name="Gobo 2" Display="'Gobo 2 %.f%%',0~100" Dmx="185~199" GoboSpin="0~0" GoboOrientation="0~0" />

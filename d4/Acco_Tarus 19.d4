      <Function ID="7" Name="Fan Normal" Display="'Fan Normal'" Dmx="70~74" />
      <Function ID="8" Name="RGB Control" Display="'RGB Control'" Dmx="90~94" />
      <Function ID="9" Name="Raw Control" Display="'Raw Control'" Dmx="100~104" />
      <Function ID="10" Name="Fast Dimming" Display="'Fast Dimming'" Dmx="110~114" />
      <Function ID="11" Name="Smooth Dimming" Display="'Smooth Dimming'" Dmx="120~124" />
      <Function ID="12" Name="LCD Display ON" Display="'LCD Display ON'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">

  <History Date="03-06-16" Author="Nic Morris" Comment="Created" />
  <History Date="13-02-17" Author="Nic Morris" Comment="Changed name from irLED64 18x10FIVE to irLED64-18x10FIVE" />
  <History Date="20-03-18" Author="Nic Morris" Comment="Added Atlabase ID's.  Added product thumbnail." />
  <History Date="20-03-18" Author="Nic Morris" Comment="Fixed 5 DMX (RGBWD) channel mapping" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="28be84c3-aff5-44c7-9b46-3330d0e4ae51" />
  <Control>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Amber" Name="Amber" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Amber C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Speed" ID="2" If="'Colour_Macro'&gt;28&amp;&amp;'Colour_Macro'&lt;34" />
      <Condition Name="Sensitivity" ID="3" If="'Colour_Macro'==34" />
      <Condition Name="Mode 3,4,6" ID="4,5,6" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="3" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~189" />
      <Function ID="5" Name="Open" Display="'Open'" Dmx="251~255" />
      <Function ID="6" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Dimmer" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="6~10" Update="Dimmer" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="11~15" Update="Dimmer" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="16~20" Update="Dimmer" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="21~25" Update="Dimmer" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="26~30" Update="Dimmer" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="31~35" Update="Dimmer" Colour="0,0,255" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="36~40" Update="Dimmer" Colour="255,0,127" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="41~45" Update="Dimmer" Colour="255,0,255" />
      <Function ID="10" Name="Cold White" Display="'Cold White'" Dmx="46~50" Update="Dimmer" Colour="230,230,255" />
      <Function ID="11" Name="Warm White" Display="'Warm White'" Dmx="51~55" Update="Dimmer" Colour="255,240,200" />
      <Function ID="12" Name="Open" Display="'Open'" Dmx="56~60" Update="Dimmer" Colour="255,255,255" />
      <Function ID="13" Name="Pale Rose" Display="'Pale Rose'" Dmx="61~65" Update="Dimmer" Colour="255,150,150" />
      <Function ID="14" Name="Pastel Apricot" Display="'Pastel Apricot'" Dmx="66~70" Update="Dimmer" Colour="255,128,0" />
      <Function ID="15" Name="Pastel Ocre" Display="'Pastel Ocre'" Dmx="71~75" Update="Dimmer" Colour="255,100,100" />
      <Function ID="16" Name="Pearl Green" Display="'Pearl Green'" Dmx="76~80" Update="Dimmer" Colour="128,255,0" />
      <Function ID="17" Name="Pearl Grey" Display="'Pearl Grey'" Dmx="81~85" Update="Dimmer" Colour="220,240,255" />
      <Function ID="18" Name="Pearl" Display="'Pearl'" Dmx="86~90" Update="Dimmer" Colour="220,240,255" />
      <Function ID="19" Name="Pearl Blue" Display="'Pearl Blue'" Dmx="91~95" Update="Dimmer" Colour="0,128,255" />
      <Function ID="20" Name="Pastel Verona Geen" Display="'Pastel Verona Geen'" Dmx="96~100" Update="Dimmer" Colour="0,180,0" />
      <Function ID="21" Name="Pastel Lagoon" Display="'Pastel Lagoon'" Dmx="101~105" Update="Dimmer" Colour="0,128,255" />
      <Function ID="22" Name="Sky Blue" Display="'Sky Blue'" Dmx="106~110" Update="Dimmer" Colour="0,0,255" />
      <Function ID="23" Name="Light Blue" Display="'Light Blue'" Dmx="111~115" Update="Dimmer" Colour="0,128,255" />
      <Function ID="24" Name="Pastel Blue" Display="'Pastel Blue'" Dmx="116~120" Update="Dimmer" Colour="0,128,255" />
      <Function ID="25" Name="Fluorescent" Display="'Fluorescent'" Dmx="121~125" Update="Dimmer" Colour="100,0,255" />
      <Function ID="26" Name="Candy" Display="'Candy'" Dmx="126~130" Update="Dimmer" Colour="255,255,255" />
      <Function ID="27" Name="Amber" Display="'Amber'" Dmx="131~135" Update="Dimmer" Colour="255,128,0" />
      <Function ID="28" Name="Sunset" Display="'Sunset'" Dmx="136~140" Update="Dimmer" Colour="255,100,0" />
      <Function ID="29" Name="Macro 1" Display="'Macro 1'" Dmx="141~150" Update="Dimmer" Colour="255,255,255" />
      <Function ID="30" Name="Macro 2" Display="'Macro 2'" Dmx="151~160" Update="Dimmer" Colour="255,255,255" />
      <Function ID="31" Name="Macro 3" Display="'Macro 3'" Dmx="161~170" Update="Dimmer" Colour="255,255,255" />
      <Function ID="32" Name="Macro 4" Display="'Macro 4'" Dmx="171~180" Update="Dimmer" Colour="255,255,255" />
      <Function ID="33" Name="Macro 5" Display="'Macro 5'" Dmx="181~190" Update="Dimmer" Colour="255,255,255" />
      <Function ID="34" Name="Sound" Display="'Sound'" Dmx="191~255" Update="Dimmer" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>

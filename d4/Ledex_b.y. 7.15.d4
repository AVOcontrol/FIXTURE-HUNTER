    <Attribute ID="Shape_Speed" Name="Shape Speed" Description="" Group="G">
      <Locate Locate="17:0" PowerOn="17:0" />
      <Condition Name="Ring" ID="1,2,3,4" If="'Shape'&gt;6&amp;&amp;'Shape'&lt;11" />
      <Condition Name="Random" ID="5,6,7,8" If="'Shape'==11||'Shape'==12" />
      <Condition Name="Rainbow" ID="9,10,11,12" If="'Shape'==13||'Shape'==14" />
      <Condition Name="Speed" ID="13,14,15,16" If="'Shape'&gt;14&amp;&amp;'Shape'&lt;57" />
      <Else ID="17" />
      <Function ID="1" Name="Radius" Display="'Radius %.f%%',0~100" Dmx="0~63" GoboSpin="0~0" GoboOrientation="0~0" />

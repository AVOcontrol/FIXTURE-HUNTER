<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VDPLP1803RGB" ShortName="VDP1803RGB" Company="HQ Power">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="01-07-10" Author="Jonathan Moreton" Comment="Created from Silver Star YG LED 321W " />
  <History Date="23-05-12" Author="Alessandro Fantin" Comment="Created" />
  <History Date="23-05-12" Author="Peter Budd" Comment="Checked" />
  <History Date="11-06-12" Author="Peter Budd" Comment="Created from Prolights ARCLED338" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Colour_Macros" Name="Colour Macros" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~10" Colour="0,0,0" />
      <Function ID="2" Name="Red+Grn" Display="'Red+Grn %.f%%',0~100" Dmx="11~30" Colour="0,0,0" />
      <Function ID="3" Name="Grn-Red" Display="'Grn-Red %.f%%',0~100" Dmx="31~50" Colour="0,0,0" />
      <Function ID="4" Name="Grn+Bl" Display="'Grn+Bl %.f%%',0~100" Dmx="51~70" Colour="0,0,0" />
      <Function ID="5" Name="Bl-Grn" Display="'Bl-Grn %.f%%',0~100" Dmx="71~90" Colour="0,0,0" />
      <Function ID="6" Name="Bl+Red" Display="'Bl+Red %.f%%',0~100" Dmx="91~110" Colour="0,0,0" />
      <Function ID="7" Name="Red-Bl" Display="'Red-Bl %.f%%',0~100" Dmx="111~130" Colour="0,0,0" />
      <Function ID="8" Name="Red+GB" Display="'Red+GB %.f%%',0~100" Dmx="131~150" Colour="0,0,0" />
      <Function ID="9" Name="Bl-RG" Display="'Bl-RG %.f%%',0~100" Dmx="151~170" Colour="0,0,0" />
      <Function ID="10" Name="RGBW 100%" Display="'RGBW 100%'" Dmx="171~200" Colour="0,0,0" />
      <Function ID="11" Name="3200K" Display="'3200K'" Dmx="201~205" Colour="0,0,0" />
      <Function ID="12" Name="3400K" Display="'3400K'" Dmx="206~210" Colour="0,0,0" />
      <Function ID="13" Name="4200K" Display="'4200K'" Dmx="211~215" Colour="0,0,0" />
      <Function ID="14" Name="4900K" Display="'4900K'" Dmx="216~220" Colour="0,0,0" />
      <Function ID="15" Name="5600K" Display="'5600K'" Dmx="221~225" Colour="0,0,0" />
      <Function ID="16" Name="5900K" Display="'5900K'" Dmx="226~230" Colour="0,0,0" />
      <Function ID="17" Name="6500K" Display="'6500K'" Dmx="231~235" Colour="0,0,0" />
      <Function ID="18" Name="7200K" Display="'7200K'" Dmx="236~240" Colour="0,0,0" />
      <Function ID="19" Name="8000K" Display="'8000K'" Dmx="241~245" Colour="0,0,0" />
      <Function ID="20" Name="8500K" Display="'8500K'" Dmx="246~250" Colour="0,0,0" />
      <Function ID="21" Name="10000K" Display="'10000K'" Dmx="251~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No function" Display="'No function'" Dmx="0~10" Intensity="0~0" />
      <Function ID="2" Name="Strobe" Display="'Strobe %.f%%',0~100" Dmx="11~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control1" Name="Auto Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~51" />
      <Function ID="2" Name="Auto1" Display="'Auto1'" Dmx="52~101" />
      <Function ID="3" Name="Auto2" Display="'Auto2'" Dmx="102~152" />
      <Function ID="4" Name="Auto3" Display="'Auto3'" Dmx="153~203" />
      <Function ID="5" Name="Auto4" Display="'Auto4'" Dmx="204~254" />
      <Function ID="6" Name="Auto5" Display="'Auto5'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Auto_Speed" Name="Auto Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',100.0~0.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dim_Speed" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Default" Display="'Default'" Dmx="0~51" />
      <Function ID="2" Name="Linear Dimmer" Display="'Linear Dimmer %.1f%%',100.0~0.0" Dmx="52~101" />
      <Function ID="3" Name="Non Linear1" Display="'Non Linear1 %.1f%%',0.0~255.0" Dmx="102~152" />
      <Function ID="4" Name="Non Linear2" Display="'Non Linear2 %.1f%%',0.0~255.0" Dmx="153~203" />
      <Function ID="5" Name="Non Linear3" Display="'Non Linear3 %.1f%%',0.0~255.0" Dmx="204~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 9 DMX" Channels="9">
    <Import PearlRef="HQ_V1803RG1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="6" Wheel="4" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
      <Attribute ID="Colour_Macros" ChannelOffset="5" Wheel="7" />
      <Attribute ID="Control1" ChannelOffset="7" Wheel="28" />
      <Attribute ID="Auto_Speed" ChannelOffset="8" Wheel="25" />
      <Attribute ID="Dim_Speed" ChannelOffset="9" Wheel="26" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 3 DMX" Channels="3">
    <Import PearlRef="HQ_V1803RG3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 4 DMX" Channels="4">
    <Import PearlRef="HQ_V1803RG2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Red" ChannelOffset="2" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="3" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
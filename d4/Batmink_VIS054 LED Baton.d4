<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="VIS054 LED Baton" ShortName="BMVIS054Bn" Company="Batmink">
  <Copyright Notice="© Avolites Ltd. 2016" />
  <History Date="16-09-13" Author="Matt Benson" Comment="Created" />
  <History Date="11-02-14" Author="RGB Power on Updater" Comment="Updated RGB Power on values to match Locate." />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="06-08-16" Author="Nic Morris" Comment="Changed cell to hidden.  Added virtual dimmer to cells and replaced dimmer with master dimmer." />
  <History Date="06-08-16" Author="Nic Morris" Comment="Added missing links to 51 DMX cells.  Changed layouts from horizontal to vertical." />
  <History Date="06-08-16" Author="Nic Morris" Comment="Removed classic pearl refs from all modes except 7 DMX and deleted assocaited broken files from library." />
  <History Date="18-09-16" Author="Nic Morris" Comment="Revised Function attribute with discrete functions and associated conditionals." />
  <History Date="18-09-16" Author="Nic Morris" Comment="Added compatibility for R20 export." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="4ec150c2-74bd-401a-b832-9b1dbda11b48" />
  <Control>
    <Attribute ID="Function" Name="Function" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" Update="Red, Shutter" />
      <Function ID="2" Name="Dream" Display="'Dream'" Dmx="19~37" Update="Red, Shutter" />
      <Function ID="3" Name="Change" Display="'Change'" Dmx="38~56" Update="Red, Shutter" />
      <Function ID="4" Name="Jump" Display="'Jump'" Dmx="57~75" Update="Red, Shutter" />
      <Function ID="5" Name="Single Flow" Display="'Single Flow'" Dmx="76~94" Update="Red, Shutter" />
      <Function ID="6" Name="Double Flow" Display="'Double Flow'" Dmx="95~113" Update="Red, Shutter" />
      <Function ID="7" Name="Single Flow + Dream 1" Display="'Single Flow + Dream 1'" Dmx="114~132" Update="Red, Shutter" />
      <Function ID="8" Name="Single Flow + Dream 2" Display="'Single Flow + Dream 2'" Dmx="133~151" Update="Red, Shutter" />
      <Function ID="9" Name="Single Section Flow 1" Display="'Single Section Flow 1'" Dmx="152~170" Update="Red, Shutter" />
      <Function ID="10" Name="Single Section Flow 2" Display="'Single Section Flow 2'" Dmx="171~189" Update="Red, Shutter" />
      <Function ID="11" Name="Double Section Flow" Display="'Double Section Flow'" Dmx="190~208" Update="Red, Shutter" />
      <Function ID="12" Name="Mixing" Display="'Mixing'" Dmx="209~227" Update="Red, Shutter" />
      <Function ID="13" Name="Auto" Display="'Auto'" Dmx="228~246" Update="Red, Shutter" />
      <Function ID="14" Name="Sound" Display="'Sound'" Dmx="247~255" Update="Red, Shutter" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Condition Name="Sensitivity" ID="2" If="'Function'==14" />
      <Else ID="1" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
      <Function ID="2" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Condition Name="Speed" ID="2" If="'Function'&gt;1&amp;&amp;'Function'&lt;14" />
      <Else ID="1" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>

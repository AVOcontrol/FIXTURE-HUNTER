      <Function ID="5" Name="CRI" Display="'CRI'" Dmx="49~63" WheelPosition="4" Colour="255,255,255" />
      <Function ID="6" Name="Op/ CTB" Display="'Op/ CTB'" Dmx="70~75" WheelPosition="0" Colour="255,255,255" />
      <Function ID="7" Name="CTB/ Yel" Display="'CTB/ Yel'" Dmx="82~87" WheelPosition="1" Colour="230,230,255" />
      <Function ID="8" Name="Yel/ UV" Display="'Yel/ UV'" Dmx="94~99" WheelPosition="2" Colour="255,255,0" />

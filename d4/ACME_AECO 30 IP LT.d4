      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2" Name="Colour 2" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5" If="'Colour2Func'==1" />
      <Condition Name="Split" ID="6,7,8,9,10" If="'Colour2Func'==2" />
      <Condition Name="Scroll" ID="11,12,13,14" If="'Colour2Func'==3" />
      <Else ID="15" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="CTB" Display="'CTB'" Dmx="8~21" WheelPosition="1" Colour="230,230,255" />
      <Function ID="3" Name="Yellow" Display="'Yellow'" Dmx="22~35" WheelPosition="2" Colour="255,255,0" />

  <Copyright Notice="© Avolites Ltd. 2026" />
  <History Date="10-10-25" Author="Nic Morris" Comment="Created" Version="0" />
  <History Date="12-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="2" />
  <History Date="27-02-26" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (adds control functions/macros)" Version="3" />
  <History Date="06-05-26" Author="Nic Morris" Comment="Updated in line with latest charts in response to manufacturer request (minor revision to some control function/macro names)" Version="4" />
  <History Date="24-07-26" Author="Nic Morris" Comment="Created from ACME SUPERNOVA LT (XA 2000 BSWF IP LT) (charts only.  tilt range is different depending on mode.  colours and gobos not detailed.  left the same for now)" Version="5" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="CRI" Name="CRI" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="CRI" Display="'CRI'" Dmx="8~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="CTO" Name="CTO" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour 1 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour 1" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="7,8,9,10,11,12" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="13,14,15,16" If="'Colour1Func'==3" />
      <Else ID="17" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="8~18" WheelPosition="1" Colour="255,0,0" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="19~29" WheelPosition="2" Colour="0,255,0" />
      <Function ID="4" Name="Pink" Display="'Pink'" Dmx="30~40" WheelPosition="3" Colour="255,150,150" />
      <Function ID="5" Name="Orange" Display="'Orange'" Dmx="41~51" WheelPosition="4" Colour="255,128,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="52~63" WheelPosition="5" Colour="0,0,255" />
      <Function ID="7" Name="Op/ Rd" Display="'Op/ Rd'" Dmx="69~73" WheelPosition="0" Colour="255,255,255" />
      <Function ID="8" Name="Rd/ Grn" Display="'Rd/ Grn'" Dmx="79~83" WheelPosition="1" Colour="255,0,0" />
      <Function ID="9" Name="Grn/ Pk" Display="'Grn/ Pk'" Dmx="89~93" WheelPosition="2" Colour="0,255,0" />
      <Function ID="10" Name="Pk/ Org" Display="'Pk/ Org'" Dmx="99~103" WheelPosition="3" Colour="255,150,150" />
      <Function ID="11" Name="Org/ Blu" Display="'Org/ Blu'" Dmx="109~113" WheelPosition="4" Colour="255,128,0" />
      <Function ID="12" Name="Blu/ Op" Display="'Blu/ Op'" Dmx="119~123" WheelPosition="5" Colour="0,0,255" />
      <Function ID="13" Name="Open" Display="'Open'" Dmx="124~127" WheelPosition="0" Colour="255,255,255" />
      <Function ID="14" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="255~194" Colour="0,0,0" />
      <Function ID="15" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="16" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="189~128" Colour="0,0,0" />
      <Function ID="17" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour2Func" Name="Colour 2 Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour2" Colour="0,0,0" />

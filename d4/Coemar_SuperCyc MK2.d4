<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="SuperCyc MK2" ShortName="SuperCyc 2" Company="Coemar">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="24-09-07" Author="Ion Balan" Comment="Created" />
  <History Date="24-09-07" Author="Ion Balan" Comment="Checked" />
  <History Date="02-02-09" Author="D4 Personality Fixer 2009" Comment="Changed Function Names" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="16-10-17" Author="Nic Morris" Comment="Changed name from SuperCYC_MK2 to SuperCyc MK2.  Changed shutter closed to open." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b71f646e-6c9c-4ebe-a3af-984dafe1ce7a" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="P/T_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Standard" Display="'Standard'" Dmx="0~0" />
      <Function ID="2" Name="Ultra Fast" Display="'Ultra Fast'" Dmx="11~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.1f%%',0.0~100.0" Dmx="127~26" />
      <Function ID="4" Name="Tracking" Display="'Tracking %.1f%%',0.0~100.0" Dmx="247~128" />
      <Function ID="5" Name="Tracking Slow" Display="'Tracking Slow'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Cyan C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,255" />
    </Attribute>
    <Attribute ID="Magenta" Name="Magenta" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:0" Lowlight="1:100" />
      <Function ID="1" Name="Magenta C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,255" />
    </Attribute>
    <Attribute ID="Yellow" Name="Yellow" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" Highlight="1:100" Lowlight="1:20" />
      <Function ID="1" Name="Yellow C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="11~129" Intensity="0~0" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.1f%%',0.0~100.0" Dmx="130~249" Intensity="0~0" />
      <Function ID="4" Name="Move in Dark" Display="'Move in Dark'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Right_Lamp" Name="Right Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off (Right)" Display="'Lamp Off (Right)'" Dmx="11~29" />
      <Function ID="3" Name="Lamp On (Right)" Display="'Lamp On (Right)'" Dmx="241~255" />
    </Attribute>
    <Attribute ID="Left_Lamp" Name="Left Lamp" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Lamp Off (Left/Both)" Display="'Lamp Off (Left/Both)'" Dmx="11~29" />
      <Function ID="3" Name="Reset P/T" Display="'Reset P/T'" Dmx="30~65" />
      <Function ID="4" Name="Reset Col" Display="'Reset Col'" Dmx="66~100" />
      <Function ID="5" Name="Reset no Dimmer" Display="'Reset no Dimmer'" Dmx="101~135" />
      <Function ID="6" Name="Reset All" Display="'Reset All'" Dmx="136~170" />
      <Function ID="7" Name="Lamp On (Both)" Display="'Lamp On (Both)'" Dmx="171~249" />
      <Function ID="8" Name="Lamp On (Left)" Display="'Lamp On (Left)'" Dmx="250~255" />
    </Attribute>
  </Control>
  <Mode Name="Standard, 11 DMX" Channels="11">
    <Import PearlRef="CMSC1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="4151329b-af2a-4672-b7a2-e7be9a06cab9" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="9" Wheel="12" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Right_Lamp" ChannelOffset="10" Wheel="29" />
      <Attribute ID="Left_Lamp" ChannelOffset="11" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Emulation, 12 DMX" Channels="12">
    <Import PearlRef="CMSC2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Head" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="67c1a7f5-029e-4805-a637-15b9b29ad57d" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="6" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="Cyan" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Magenta" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Yellow" ChannelOffset="9" Wheel="12" />
      <Attribute ID="P/T_Speed" ChannelOffset="5" Wheel="25" />
      <Attribute ID="Right_Lamp" ChannelOffset="11" Wheel="29" />
      <Attribute ID="Left_Lamp" ChannelOffset="12" Wheel="28" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Lamp Off (Left/Both)">
      <Set Channel="Left_Lamp:2" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp Off (Right)">
      <Set Channel="Right_Lamp:2" Delay="6000" />
      <Set Channel="Right_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Left)">
      <Set Channel="Left_Lamp:8" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Right)">
      <Set Channel="Right_Lamp:3" Delay="6000" />
      <Set Channel="Right_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Lamp On (Both)">
      <Set Channel="Left_Lamp:7" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Reset All">
      <Set Channel="Left_Lamp:6" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Reset P/T">
      <Set Channel="Left_Lamp:3" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Col">
      <Set Channel="Left_Lamp:4" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
    <Macro Name="Reset no Dimmer">
      <Set Channel="Left_Lamp:5" Delay="6000" />
      <Set Channel="Left_Lamp:1" Delay="0" />
    </Macro>
  </Macro>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:0" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:100" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Cyan:1:0,Magenta:1:50,Yellow:1:100" />
      <Palette ID="4" Name="Yellow" Number="4" Page="1" SetControl="Cyan:1:0,Magenta:1:0,Yellow:1:100" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:0,Yellow:1:100" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:100" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Cyan:1:100,Magenta:1:0,Yellow:1:0" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Cyan:1:100,Magenta:1:50,Yellow:1:0" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Cyan:1:100,Magenta:1:100,Yellow:1:0" />
      <Palette ID="11" Name="Purple" Number="0" Page="1" SetControl="Cyan:1:50,Magenta:1:100,Yellow:1:0" />
      <Palette ID="12" Name="Magenta" Number="10" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:0" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Cyan:1:0,Magenta:1:100,Yellow:1:50" />
      <Palette ID="14" Name="Lavender" Number="8" Page="1" SetControl="Cyan:1:29,Magenta:1:57,Yellow:1:6" />
      <Palette ID="15" Name="Ultra Violet" Number="9" Page="1" SetControl="Cyan:1:80,Magenta:1:100,Yellow:1:0" />
    </Group>
    <Group Name="Position">
      <Palette ID="1" Name="Middle" Number="21" Page="1" SetControl="Pan:1:50,Tilt:1:50" />
      <Palette ID="2" Name="Left" Number="22" Page="1" SetControl="Pan:1:31,Tilt:1:50" />
      <Palette ID="3" Name="Right" Number="23" Page="1" SetControl="Pan:1:69,Tilt:1:50" />
      <Palette ID="4" Name="Top" Number="24" Page="1" SetControl="Pan:1:50,Tilt:1:31" />
      <Palette ID="5" Name="Bottom" Number="25" Page="1" SetControl="Pan:1:50,Tilt:1:69" />
      <Palette ID="6" Name="TLeft" Number="26" Page="1" SetControl="Pan:1:31,Tilt:1:31" />
      <Palette ID="7" Name="TRight" Number="27" Page="1" SetControl="Pan:1:69,Tilt:1:69" />
      <Palette ID="8" Name="BLeft" Number="28" Page="1" SetControl="Pan:1:31,Tilt:1:69" />
      <Palette ID="9" Name="BRight" Number="29" Page="1" SetControl="Pan:1:69,Tilt:1:31" />
    </Group>
  </Palettes>
</Fixture>
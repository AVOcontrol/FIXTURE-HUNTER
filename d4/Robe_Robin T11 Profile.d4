  <Macro>
    <Macro Name="Reset All">
      <Set Channel="Control:13" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Gobo">
      <Set Channel="Control:11" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Reset Iris">
      <Set Channel="Control:12" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Display On">
      <Set Channel="Control:2,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Display Off">
      <Set Channel="Control:3,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark On">
      <Set Channel="Control:4,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Gobo in Dark Off">
      <Set Channel="Control:5,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Fan Auto">
      <Set Channel="Control:6,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Quiet Mode: Fans On at B/O">
      <Set Channel="Control:7,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Quiet Mode: Fans Off at B/O">
      <Set Channel="Control:8,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Fan Convection Passive Cooling - Fans Off">
      <Set Channel="Control:9,Shutter:1" Delay="4000" />
      <Set Channel="Control:1,Shutter:2" Delay="0" />
    </Macro>
    <Macro Name="Simple Mode Off">
      <Set Channel="Control:10" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Green/Blue Correction Cal">
      <Set Channel="Control:14" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo Indexing: Max Spd+Shortcut">
      <Set Channel="Control:15" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo Indexing: Follow Spd+Direction">
      <Set Channel="Control:16" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gobo Indexing: Max Spd+Follow Direction">
      <Set Channel="Control:17" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Theatre Mode Off">
      <Set Channel="Control:18" Delay="4000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="CTC Range Standard (2700-8000K)">
      <Set Channel="Colour_Func:2" Delay="4000" />
      <Set Channel="Colour_Func:1" Delay="0" />
    </Macro>

  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f741be74-adad-4495-aeda-f6cd01704f5c" />
  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="255~0" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~131" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="240~247" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="140~181" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="190~231" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Func" Description="" Group="C" Size="0">
      <Locate Locate="1" PowerOn="1" Highlight="1" Lowlight="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" Highlight="7" Lowlight="6" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="9" If="'Colour1Func'==2" />
      <Condition Name="Scroll" ID="10,11,12,13" If="'Colour1Func'==3" />
      <Else ID="14" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Light Blue" Display="'Light Blue'" Dmx="8~14" Colour="0,128,255" />
      <Function ID="3" Name="Pink" Display="'Pink'" Dmx="15~21" Colour="255,150,150" />
      <Function ID="4" Name="Orange" Display="'Orange'" Dmx="22~28" Colour="255,128,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="29~35" Colour="0,255,0" />
      <Function ID="6" Name="Blue" Display="'Blue'" Dmx="36~42" Colour="0,0,255" />
      <Function ID="7" Name="Yellow" Display="'Yellow'" Dmx="43~49" Colour="255,255,0" />
      <Function ID="8" Name="Red" Display="'Red'" Dmx="50~56" Colour="255,0,0" />
      <Function ID="9" Name="Split" Display="'Split %.f%%',0~100" Dmx="57~127" Colour="0,0,0" />
      <Function ID="10" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="11" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" Colour="0,0,0" />
      <Function ID="12" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" Colour="0,0,0" />
      <Function ID="13" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" Colour="0,0,0" />
      <Function ID="14" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Gobo1Func" Name="Gobo Func" Description="" Group="G" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Gobo1" />
      <Function ID="2" Name="Shake" Display="'Shake'" Dmx="0~0" Update="Gobo1" />
      <Function ID="3" Name="Scroll" Display="'Scroll'" Dmx="0~0" Update="Gobo1" />
      <Function ID="4" Name="Raw DMX" Display="'Raw DMX'" Dmx="0~0" Update="Gobo1" />
    </Attribute>
    <Attribute ID="Gobo1" Name="Gobo" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7,8,9" If="'Gobo1Func'==1" />
      <Condition Name="Shake" ID="10,11,12,13,14,15,16,17,18" If="'Gobo1Func'==2" />
      <Condition Name="Scroll" ID="19,20,21,22" If="'Gobo1Func'==3" />
      <Else ID="23" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="2" Name="Gobo 1" Display="'Gobo 1'" Dmx="8~14" WheelPosition="1" />
      <Function ID="3" Name="Gobo 2" Display="'Gobo 2'" Dmx="15~21" WheelPosition="2" />
      <Function ID="4" Name="Gobo 3" Display="'Gobo 3'" Dmx="22~28" WheelPosition="3" />
      <Function ID="5" Name="Gobo 4" Display="'Gobo 4'" Dmx="29~35" WheelPosition="4" />
      <Function ID="6" Name="Gobo 5" Display="'Gobo 5'" Dmx="36~42" WheelPosition="5" />
      <Function ID="7" Name="Gobo 6" Display="'Gobo 6'" Dmx="43~49" WheelPosition="6" />
      <Function ID="8" Name="Gobo 7" Display="'Gobo 7'" Dmx="50~56" WheelPosition="7" />
      <Function ID="9" Name="Gobo 8" Display="'Gobo 8'" Dmx="57~63" WheelPosition="8" />
      <Function ID="10" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" />
      <Function ID="11" Name="Gobo 1 Shake" Display="'Gobo 1 Shake  %.f%%',0~100" Dmx="64~71" WheelPosition="1" />
      <Function ID="12" Name="Gobo 2 Shake" Display="'Gobo 2 Shake  %.f%%',0~100" Dmx="72~79" WheelPosition="2" />
      <Function ID="13" Name="Gobo 3 Shake" Display="'Gobo 3 Shake  %.f%%',0~100" Dmx="80~87" WheelPosition="3" />
      <Function ID="14" Name="Gobo 4 Shake" Display="'Gobo 4 Shake  %.f%%',0~100" Dmx="88~95" WheelPosition="4" />
      <Function ID="15" Name="Gobo 5 Shake" Display="'Gobo 5 Shake  %.f%%',0~100" Dmx="96~103" WheelPosition="5" />
      <Function ID="16" Name="Gobo 6 Shake" Display="'Gobo 6 Shake  %.f%%',0~100" Dmx="104~111" WheelPosition="6" />
      <Function ID="17" Name="Gobo 7 Shake" Display="'Gobo 7 Shake  %.f%%',0~100" Dmx="112~119" WheelPosition="7" />
      <Function ID="18" Name="Gobo 8 Shake" Display="'Gobo 8 Shake  %.f%%',0~100" Dmx="120~127" WheelPosition="8" />
      <Function ID="19" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="20" Name="Scroll CW" Display="'Scroll CW %.f%%',100~0" Dmx="128~189" />
      <Function ID="21" Name="No Scroll" Display="'No Scroll'" Dmx="190~193" />
      <Function ID="22" Name="Scroll CCW" Display="'Scroll CCW %.f%%',0~100" Dmx="194~255" />
      <Function ID="23" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Move in Dark" Display="'Move in Dark'" Dmx="70~79" />
      <Function ID="3" Name="Col in Dark" Display="'Col in Dark'" Dmx="90~99" />
      <Function ID="4" Name="Gobo in Dark" Display="'Gobo in Dark'" Dmx="110~119" />
      <Function ID="5" Name="Reset" Display="'Reset'" Dmx="200~209" />
      <Function ID="6" Name="Sound" Display="'Sound'" Dmx="250~255" />
    </Attribute>
    <Attribute ID="Show" Name="Show" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" />
      <Function ID="2" Name="Show 1" Display="'Show 1'" Dmx="8~67" />
      <Function ID="3" Name="Show 2" Display="'Show 2'" Dmx="68~127" />
      <Function ID="4" Name="Show 3" Display="'Show 3'" Dmx="128~187" />
      <Function ID="5" Name="Show 4" Display="'Show 4'" Dmx="188~247" />
      <Function ID="6" Name="Random" Display="'Random'" Dmx="248~255" />
    </Attribute>
  </Control>

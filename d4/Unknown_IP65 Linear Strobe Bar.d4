        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="White_FX" TargetId="White_FX" />
        <AttributeLink SourceId="Effect_Spd" TargetId="Effect_Spd" />
      </Cell>
      <Cell ID="Cell3" Name="Golden" ChannelOffset="4" ModeLink="Golden cell" X="0" Y="2">
        <AttributeLink SourceId="Shutter" TargetId="Shutter" />
        <AttributeLink SourceId="Dimmer" TargetId="Dimmer" />
        <AttributeLink SourceId="Golden_FX" TargetId="Golden_FX" />
        <AttributeLink SourceId="Effect_Spd" TargetId="Effect_Spd" />
      </Cell>
    </Cells>
  </Mode>

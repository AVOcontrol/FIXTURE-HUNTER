<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="IP65 Linear Strobe Bar" ShortName="Strobe Bar" Company="Unknown" Version="0">
  <Copyright Notice="© Avolites Ltd. 2024" />
  <History Date="09-07-24" Author="Nic Morris" Comment="Created (poor documentation.  vague.  charts only)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="20~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Golden_FX" Name="Golden FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Scenes 1" Display="'Scenes 1'" Dmx="91~105" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="106~120" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="121~135" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="136~150" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="151~165" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="166~180" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="181~195" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="196~210" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Effect_Spd" Name="Effect Spd" Description="" Group="E">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="FWD" Display="'FWD %.1f%%',100.0~0.0" Dmx="127~0" />
      <Function ID="2" Name="REV" Display="'REV %.1f%%',0.0~100.0" Dmx="128~255" />
    </Attribute>
    <Attribute ID="White_FX" Name="White FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Scenes 1" Display="'Scenes 1'" Dmx="91~105" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="106~120" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="121~135" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="136~150" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="151~165" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="166~180" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="181~195" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="196~210" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="211~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Upper+Lower" Display="'Upper+Lower'" Dmx="0~0" />
      <Function ID="2" Name="Upper" Display="'Upper'" Dmx="64~127" />
      <Function ID="3" Name="Lower" Display="'Lower'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="RGB_FX" Name="RGB FX" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="Scenes 1" Display="'Scenes 1'" Dmx="11~25" />
      <Function ID="3" Name="Effect 2" Display="'Effect 2'" Dmx="26~40" />
      <Function ID="4" Name="Effect 3" Display="'Effect 3'" Dmx="41~55" />
      <Function ID="5" Name="Effect 4" Display="'Effect 4'" Dmx="56~70" />
      <Function ID="6" Name="Effect 5" Display="'Effect 5'" Dmx="71~85" />
      <Function ID="7" Name="Effect 6" Display="'Effect 6'" Dmx="86~100" />
      <Function ID="8" Name="Effect 7" Display="'Effect 7'" Dmx="101~115" />
      <Function ID="9" Name="Effect 8" Display="'Effect 8'" Dmx="116~130" />
      <Function ID="10" Name="Effect 9" Display="'Effect 9'" Dmx="131~145" />
      <Function ID="11" Name="Effect 10" Display="'Effect 10'" Dmx="146~160" />
      <Function ID="12" Name="Effect 11" Display="'Effect 11'" Dmx="161~255" />
    </Attribute>
    <Attribute ID="BG_Dimmer" Name="BG Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="BG_Colour" Name="BG Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Frost" Name="Frost" Description="" Group="B">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Frost" Display="'Frost'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Master_Dimmer" Name="Master Dimmer" Description="" Group="I" Merge="HTP">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="19 DMX" Channels="19" Id="9abecceb-af0c-41cc-9711-622d9230c000">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include />
    <Cells>
      <Master>
        <Attribute ID="Master_Dimmer" ChannelOffset="1" Wheel="4" />
        <Attribute ID="Shutter" Wheel="5" />
        <Attribute ID="Red" Wheel="10" />
        <Attribute ID="Green" Wheel="11" />
        <Attribute ID="Blue" Wheel="12" />
        <Attribute ID="RGB_FX" Wheel="22" />
        <Attribute ID="Effect_Spd" Wheel="52" />

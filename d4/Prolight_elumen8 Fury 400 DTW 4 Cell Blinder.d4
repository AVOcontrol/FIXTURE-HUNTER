  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Linear_Strobe" Name="Linear Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Random_Strobe" Name="Random Strobe" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="11~255" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="All WW" Display="'All WW'" Dmx="11~21" Colour="255,255,255" />
      <Function ID="3" Name="All Amber" Display="'All Amber'" Dmx="22~32" Colour="255,255,255" />
      <Function ID="4" Name="1+3 WW/ 2+4 A" Display="'1+3 WW/ 2+4 A'" Dmx="33~43" Colour="255,255,255" />
      <Function ID="5" Name="1+3 A/ 2+4 WW" Display="'1+3 A/ 2+4 WW'" Dmx="44~54" Colour="255,255,255" />
      <Function ID="6" Name="1+2 WW/ 3+4 A" Display="'1+2 WW/ 3+4 A'" Dmx="55~65" Colour="255,255,255" />
      <Function ID="7" Name="1+2 A/ 3+4 WW" Display="'1+2 A/ 3+4 WW'" Dmx="66~76" Colour="255,255,255" />
      <Function ID="8" Name="All WW+A" Display="'All WW+A'" Dmx="77~87" Colour="255,255,255" />
      <Function ID="9" Name="All Red" Display="'All Red'" Dmx="88~98" Colour="255,0,0" />
      <Function ID="10" Name="All Green" Display="'All Green'" Dmx="99~109" Colour="0,255,0" />
      <Function ID="11" Name="All Blue" Display="'All Blue'" Dmx="110~120" Colour="0,0,255" />
      <Function ID="12" Name="All Orange" Display="'All Orange'" Dmx="121~131" Colour="255,128,0" />
      <Function ID="13" Name="All Medium Yellow" Display="'All Medium Yellow'" Dmx="132~142" Colour="255,255,0" />
      <Function ID="14" Name="All Yellow" Display="'All Yellow'" Dmx="143~153" Colour="255,255,0" />
      <Function ID="15" Name="All Magenta" Display="'All Magenta'" Dmx="154~164" Colour="255,0,255" />

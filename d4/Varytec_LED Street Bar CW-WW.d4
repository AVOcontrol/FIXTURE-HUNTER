<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LED Street Bar CW-WW" ShortName="Street Bar" Company="Varytec">
  <Copyright Notice="© Avolites Ltd. 2014" />
  <History Date="28-06-14" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~9" />
      <Function ID="2" Name="Strobe" Display="'Strobe'" Dmx="10~19" />
      <Function ID="3" Name="Mode" Display="'Mode %.f',1~20" Dmx="20~219" />
      <Function ID="4" Name="Auto 1" Display="'Auto 1'" Dmx="220~229" />
      <Function ID="5" Name="Auto 2" Display="'Auto 2'" Dmx="230~239" />
      <Function ID="6" Name="Auto 3" Display="'Auto 3'" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="WW" Name="WW" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="CW" Name="CW" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="UKVTSBW2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="WW" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="CW" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>

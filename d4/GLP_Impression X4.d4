      <Attribute ID="Pan" ChannelOffset="1,2" Wheel="2" />
      <Attribute ID="Tilt" ChannelOffset="3,4" Wheel="3" />
      <Attribute ID="PT_Macro" ChannelOffset="14" Wheel="26" />
      <Attribute ID="PT_Speed" ChannelOffset="15" Wheel="25" />
      <Attribute ID="Colour1Func" Wheel="7" />
      <Attribute ID="Colour_Macro" ChannelOffset="5" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="9" />
      <Attribute ID="CTO" ChannelOffset="12" Wheel="37" />
      <Attribute ID="Zoom" ChannelOffset="16" Wheel="19" />
      <Attribute ID="Effect" ChannelOffset="17" Wheel="22" />
      <Attribute ID="Pattern_1" ChannelOffset="18" Wheel="23" />
      <Attribute ID="Pattern_2" ChannelOffset="19" Wheel="24" />

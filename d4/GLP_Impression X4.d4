      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Compress, 14 DMX" Channels="14">
    <Import PearlRef="GLP_ImpX4_C" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="RGBW LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="50" />
      <Weight Kg="7.5" />
      <Size Height="385" Width="340" Depth="242" />
      <Focus Type="Head" PanMax="660" TiltMax="300" PanMaxSpeed="330" TiltMaxSpeed="260" />
    </Physical>
    <AtlaBase ModeID="fdba5866-8fc2-4d08-97e6-779b0e4355cf" />
    <Include>
      <Attribute ID="Shutter" ChannelOffset="10" Wheel="4" />
      <Attribute ID="Dimmer" ChannelOffset="11" Wheel="1" />

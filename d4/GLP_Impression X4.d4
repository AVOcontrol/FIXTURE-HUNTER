      <Attribute ID="Control" ChannelOffset="13" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="High Resolution (Ext), 21 DMX" Channels="21">
    <Import PearlRef="GLP_ImpX4_X" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="RGBW LED" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="50" />
      <Weight Kg="7.5" />
      <Size Height="385" Width="340" Depth="242" />
      <Focus Type="Head" PanMax="660" TiltMax="300" PanMaxSpeed="330" TiltMaxSpeed="260" />

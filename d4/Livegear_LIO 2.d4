<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="LIO 2" ShortName="LIO 2" Company="Livegear">
  <Copyright Notice="© Avolites Ltd. 2013" />
  <History Date="08-07-13" Author="Peter Budd" Comment="Created" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="White" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Warm C-Mix" Display="'Warm C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,200" />
    </Attribute>
    <Attribute ID="White1" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Cool C-Mix" Display="'Cool C-Mix %.1f%%',0.0~100.0" Dmx="0~255" Colour="200,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="DimSpeed" Name="Dimmer Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Macro" Display="'No Macro'" Dmx="0~9" />
      <Function ID="2" Name="Dimmer 1" Display="'Dimmer 1'" Dmx="10~69" />
      <Function ID="3" Name="Dimmer 2" Display="'Dimmer 2'" Dmx="70~129" />
      <Function ID="4" Name="Dimmer 3" Display="'Dimmer 3'" Dmx="130~189" />
      <Function ID="5" Name="Dimmer 4" Display="'Dimmer 4'" Dmx="190~255" />
    </Attribute>
  </Control>
  <Mode Name="UNO, 1 DMX" Channels="1">
    <Import PearlRef="UK_LLIO2_Un" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Duo, 2 DMX" Channels="2">
    <Import PearlRef="UK_LLIO2_Du" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" Wheel="1" />
      <Attribute ID="White" ChannelOffset="1" Wheel="8" VirtualControl="Dimmer" />
      <Attribute ID="White1" ChannelOffset="2" Wheel="9" VirtualControl="Dimmer" />
    </Include>
  </Mode>
  <Mode Name="Live 1, 3 DMX" Channels="3">
    <Import PearlRef="UK_LLIO2_L3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="2" Wheel="4" />
      <Attribute ID="DimSpeed" ChannelOffset="3" Wheel="28" />
    </Include>
  </Mode>
  <Mode Name="Live 1, 5 DMX" Channels="5">
    <Import PearlRef="UK_LLIO2_L5" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="Shutter" ChannelOffset="4" Wheel="4" />
      <Attribute ID="White" ChannelOffset="2" Wheel="8" />
      <Attribute ID="White1" ChannelOffset="3" Wheel="9" />
      <Attribute ID="DimSpeed" ChannelOffset="5" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Shutter">
      <Palette ID="1" Name="Open" Number="31" Page="1" SetControl="Shutter:2" />
      <Palette ID="2" Name="Slow Strobe" Legend="Slow Strb" Number="32" Page="1" SetControl="Shutter:3:50" />
      <Palette ID="3" Name="Fast Strobe" Legend="Fast Strb" Number="33" Page="1" SetControl="Shutter:3:100" />
      <Palette ID="4" Name="Slow Random Strobe" Legend="Slow R Stb" Number="34" Page="1" SetControl="Shutter:8:50" />
      <Palette ID="5" Name="Fast Random Strobe" Legend="Fast R Stb" Number="35" Page="1" SetControl="Shutter:8:100" />
      <Palette ID="6" Name="Slow Pulse" Number="36" Page="1" SetControl="Shutter:5:50" />
      <Palette ID="7" Name="Fast Pulse" Number="37" Page="1" SetControl="Shutter:5:100" />
      <Palette ID="8" Name="Closed" Legend="Close" Number="38" Page="1" SetControl="Shutter:1" />
    </Group>
  </Palettes>
</Fixture>
  <Thumbnail>06b6b511-7eb5-4d0b-adae-00da1ec09036</Thumbnail>
  <History Date="13-02-25" Author="Nic Morris" Comment="Created (manual provided by customer appears to be different to the one linked from the product page on the manufacturer's website.  included modes from both for now.  note 7 channel mode can become 11 channels and therefore must actually be an 11 channel mode.  clueless implementation)" Version="0" />
  <History Date="19-02-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="1" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="892459d0-3351-4b8d-990e-01eead1fba38" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Soft Col Mix" ID="2" If="'Soft_Col_Mix'==2" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Else ID="1" />
      <Condition Name="Soft Col Mix" ID="2" If="'Soft_Col_Mix'==2" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Else ID="1" />
      <Condition Name="Soft Col Mix" ID="2" If="'Soft_Col_Mix'==2" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="Soft Col Mix" ID="2" If="'Soft_Col_Mix'==2" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
      <Function ID="2" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fade_Scroll" Name="Fade Scroll" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Fade In+Out" Display="'Fade In+Out %.1f%%',0.0~100.0" Dmx="0~239" Colour="0,0,0" />
      <Function ID="2" Name="Sound" Display="'Sound'" Dmx="240~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Soft_Col_Mix" Name="Soft Col Mix" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Red, Green, Blue, White" Colour="0,0,0" />
      <Function ID="2" Name="Soft Col Mix" Display="'Soft Col Mix %.1f%%',0.0~100.0" Dmx="1~255" Update="Red, Green, Blue, White" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe 1" Display="'Strobe 1 %.f%%',0~100" Dmx="79~1" />
      <Function ID="3" Name="Strobe 2" Display="'Strobe 2 %.f%%',0~100" Dmx="159~80" />
      <Function ID="4" Name="Strobe 3" Display="'Strobe 3 %.f%%',0~100" Dmx="239~160" />
      <Function ID="5" Name="Custom Strobe" Display="'Custom Strobe %.f%%',0~100" Dmx="240~255" />
    </Attribute>
    <Attribute ID="Up_Time" Name="Up Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'%.fms',0~2200" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Hold_Time" Name="Hold Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'%.fms',0~2200" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Down_Time" Name="Down Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'%.fms',0~2200" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Off_Time" Name="Off Time" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Time" Display="'%.fms',0~2200" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="4 DMX" Channels="4" Id="42b446fa-7518-447b-be7a-e73cb90c4b54">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="2a69238b-1fab-4fb4-8945-9dcbe773afdb" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="White" ChannelOffset="4" Wheel="40" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

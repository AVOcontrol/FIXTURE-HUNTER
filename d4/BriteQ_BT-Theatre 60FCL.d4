  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="d5e7e6bf-f8c0-4ebc-b49f-dc5161b35d20" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="Dim+Strobe" ID="2,3,4,5" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~190" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="201~247" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="5" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="191~200" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="68~255" />
      <Function ID="3" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="8~37" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="38~67" />
    </Attribute>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="WW 2700K" Display="'WW 2700K'" Dmx="8~12" Colour="255,255,255" />
      <Function ID="3" Name="WW 3200K" Display="'WW 3200K'" Dmx="13~17" Colour="255,255,255" />
      <Function ID="4" Name="WW 3200K" Display="'WW 3200K'" Dmx="18~22" Colour="255,255,255" />
      <Function ID="5" Name="NW 4000K" Display="'NW 4000K'" Dmx="23~27" Colour="255,255,255" />
      <Function ID="6" Name="CW 5600K" Display="'CW 5600K'" Dmx="28~32" Colour="255,255,255" />
      <Function ID="7" Name="Red" Display="'Red'" Dmx="33~37" Colour="255,0,0" />
      <Function ID="8" Name="Orange" Display="'Orange'" Dmx="38~42" Colour="255,128,0" />
      <Function ID="9" Name="Yellow" Display="'Yellow'" Dmx="43~47" Colour="255,255,0" />
      <Function ID="10" Name="Green" Display="'Green'" Dmx="48~52" Colour="0,255,0" />
      <Function ID="11" Name="Cyan" Display="'Cyan'" Dmx="53~57" Colour="0,255,255" />
      <Function ID="12" Name="Blue" Display="'Blue'" Dmx="58~62" Colour="0,0,255" />
      <Function ID="13" Name="Purple" Display="'Purple'" Dmx="63~67" Colour="128,0,255" />
      <Function ID="14" Name="User Colour" Display="'User Colour'" Dmx="68~72" Colour="255,255,255" />
      <Function ID="15" Name="Col Change" Display="'Col Change %.f%%',0~100" Dmx="73~161" Colour="255,255,255" />
      <Function ID="16" Name="Col Fade" Display="'Col Fade %.f%%',0~100" Dmx="162~250" Colour="255,255,255" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="251~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Lime" Name="Lime" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Lime C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="100,255,100" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Shutter2" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="35~255" />
      <Function ID="3" Name="Sound" Display="'Sound %.f%%',0~100" Dmx="5~24" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="25~34" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S" Size="0">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="8~18" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="19~29" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="30~40" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="41~51" />
      <Function ID="6" Name="Dim Behavior LED" Display="'Dim Behavior LED'" Dmx="52~62" />
      <Function ID="7" Name="Dim Behavior Halogen" Display="'Dim Behavior Halogen'" Dmx="63~73" />
      <Function ID="8" Name="Fan Silent" Display="'Fan Silent'" Dmx="74~84" />
      <Function ID="9" Name="Fan Auto" Display="'Fan Auto'" Dmx="85~95" />
      <Function ID="10" Name="Delay Time 0s" Display="'Delay Time 0s'" Dmx="96~106" />
      <Function ID="11" Name="Delay Time 3s" Display="'Delay Time 3s'" Dmx="107~117" />
    </Attribute>
  </Control>

      </Function>
      <Function ID="10" Name="Gobo 1 Shake" Display="'Gobo 1 Shake %.f%%',0~100" Dmx="221~225" WheelPosition="1">
        <Swatch>210fc8bd-b123-4b3c-9363-7b90771b0183</Swatch>

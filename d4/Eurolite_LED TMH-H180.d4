      <Function ID="11" Name="Gobo 2 Shake" Display="'Gobo 2 Shake %.f%%',0~100" Dmx="226~230" WheelPosition="2">
        <Swatch>9e73b99e-b28c-4c51-a8ab-fa72e2d80654</Swatch>
      </Function>
      <Function ID="12" Name="Gobo 3 Shake" Display="'Gobo 3 Shake %.f%%',0~100" Dmx="231~235" WheelPosition="3">
        <Swatch>05346119-6cd7-4f97-b04f-baf0069cb975</Swatch>

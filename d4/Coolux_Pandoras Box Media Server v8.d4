      <Function ID="3" Name="Pause" Display="'Pause'" Dmx="128~128" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Loop" Display="'Loop'" Dmx="192~192" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="S">
      <Locate Locate="2" PowerOn="2" />

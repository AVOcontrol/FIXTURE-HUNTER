  <Control>
    <Attribute ID="Folder" Name="Folder" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Folder" Display="'No Folder'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Folder" Display="'Folder %.f',1~255" Dmx="1~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Media" Name="Media" Description="" Group="G">

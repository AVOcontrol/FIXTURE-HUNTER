<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Eclipse RGB" ShortName="EclipseRGB" Company="Chauvet">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="13-12-14" Author="Nic Morris" Comment="Created" />
  <History Date="06-10-16" Author="Nic Morris" Comment="Atlabase ID's added" />
  <History Date="14-11-17" Author="Nic Morris" Comment="Removed Atlabase ID's as it doesn't have any dimming or closed shutter on the laser meaning it would be permanently on (lasers not currently supported)." />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="DMX" Display="'DMX'" Dmx="0~0" />
      <Function ID="2" Name="Auto Slow" Display="'Auto Slow'" Dmx="50~99" />
      <Function ID="3" Name="Auto Fast" Display="'Auto Fast'" Dmx="100~149" />
      <Function ID="4" Name="Sound" Display="'Sound'" Dmx="150~199" />
      <Function ID="5" Name="Random" Display="'Random'" Dmx="200~255" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Blackout" Display="'Blackout'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="5~28" Colour="255,255,255" />
      <Function ID="3" Name="Green" Display="'Green'" Dmx="29~56" Colour="255,255,255" />
      <Function ID="4" Name="R+G" Display="'R+G'" Dmx="57~84" Colour="255,255,255" />
      <Function ID="5" Name="R Off/ G Strb" Display="'R Off/ G Strb'" Dmx="85~112" Colour="255,255,255" />
      <Function ID="6" Name="R Strb/ G Off" Display="'R Strb/ G Off'" Dmx="113~140" Colour="255,255,255" />
      <Function ID="7" Name="R On/ G Strb" Display="'R On/ G Strb'" Dmx="141~168" Colour="255,255,255" />
      <Function ID="8" Name="R Strb/ G On" Display="'R Strb/ G On'" Dmx="169~197" Colour="255,255,255" />
      <Function ID="9" Name="R+G Strb" Display="'R+G Strb'" Dmx="198~224" Colour="255,255,255" />
      <Function ID="10" Name="R+G Alt" Display="'R+G Alt'" Dmx="225~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Laser_Shutter" Name="Laser Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Laser_Rot" Name="Laser Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
    <Attribute ID="Vibration" Name="Vibration" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Vibration" Display="'No Vibration'" Dmx="0~0" />
      <Function ID="2" Name="Vibration" Display="'Vibration %.1f%%',0.0~100.0" Dmx="5~255" />
    </Attribute>
    <Attribute ID="Flash" Name="Flash" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Function" Display="'No Function'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Flash" Display="'Flash %.1f%%',0.0~100.0" Dmx="5~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'Red C-Mix %.1f%%',0.0~100.0" Dmx="0~127" Colour="255,0,0" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.f%%',0~100" Dmx="128~169" Colour="255,255,255" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.f%%',100~0" Dmx="170~209" Colour="255,255,255" />
      <Function ID="4" Name="Alt Fade" Display="'Alt Fade %.f%%',0~100" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'Green C-Mix %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,255,0" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.f%%',0~100" Dmx="128~169" Colour="255,255,255" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.f%%',100~0" Dmx="170~209" Colour="255,255,255" />
      <Function ID="4" Name="Alt Fade" Display="'Alt Fade %.f%%',0~100" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'Blue C-Mix %.1f%%',0.0~100.0" Dmx="0~127" Colour="0,0,255" />
      <Function ID="2" Name="Fade In" Display="'Fade In %.f%%',0~100" Dmx="128~169" Colour="255,255,255" />
      <Function ID="3" Name="Fade Out" Display="'Fade Out %.f%%',100~0" Dmx="170~209" Colour="255,255,255" />
      <Function ID="4" Name="Alt Fade" Display="'Alt Fade %.f%%',0~100" Dmx="210~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="LED_Shutter" Name="LED Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Intensity="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="5~249" Intensity="0~0" />
      <Function ID="3" Name="Sound" Display="'Sound'" Dmx="250~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="LED_Rot" Name="LED Rot" Description="" Group="G">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Spin" Display="'No Spin'" Dmx="0~0" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="2" Name="Spin CW" Display="'Spin CW %.1f%%',100.0~0.0" Dmx="127~5" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="3" Name="No Spin" Display="'No Spin'" Dmx="128~133" GoboSpin="0~0" GoboOrientation="0~0" />
      <Function ID="4" Name="Spin CCW" Display="'Spin CCW %.1f%%',0.0~100.0" Dmx="134~255" GoboSpin="0~0" GoboOrientation="0~0" />
    </Attribute>
  </Control>
  <Mode Name="12 DMX" Channels="12">
    <Import PearlRef="CHECLRGB" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Laser_Shutter" ChannelOffset="3" Wheel="5" />
      <Attribute ID="Flash" ChannelOffset="6" Wheel="6" />
      <Attribute ID="Dimmer" ChannelOffset="10" Wheel="1" />
      <Attribute ID="LED_Shutter" ChannelOffset="11" Wheel="4" />
      <Attribute ID="Colour1" ChannelOffset="2" Wheel="8" />
      <Attribute ID="Red" ChannelOffset="7" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="8" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="9" Wheel="12" />
      <Attribute ID="Laser_Rot" ChannelOffset="4" Wheel="13" />
      <Attribute ID="LED_Rot" ChannelOffset="12" Wheel="14" />
      <Attribute ID="Vibration" ChannelOffset="5" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="1" Wheel="28" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Colour">
      <Palette ID="1" Name="Open" Number="1" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:100" />
      <Palette ID="2" Name="Red" Number="2" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:0" />
      <Palette ID="3" Name="Amber" Number="3" Page="1" SetControl="Red:1:100,Green:1:50,Blue:1:0" />
      <Palette ID="4" Name="Yellow" Legend="Yell" Number="4" Page="1" SetControl="Red:1:100,Green:1:100,Blue:1:0" />
      <Palette ID="5" Name="Lime" Number="0" Page="1" SetControl="Red:1:50,Green:1:100,Blue:1:0" />
      <Palette ID="6" Name="Green" Number="5" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:0" />
      <Palette ID="7" Name="Aqua" Number="0" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:50" />
      <Palette ID="8" Name="Cyan" Number="6" Page="1" SetControl="Red:1:0,Green:1:100,Blue:1:100" />
      <Palette ID="9" Name="Light Blue" Number="0" Page="1" SetControl="Red:1:0,Green:1:50,Blue:1:100" />
      <Palette ID="10" Name="Blue" Number="7" Page="1" SetControl="Red:1:0,Green:1:0,Blue:1:100" />
      <Palette ID="11" Name="Purple" Legend="Purpl" Number="9" Page="1" SetControl="Red:1:50,Green:1:0,Blue:1:100" />
      <Palette ID="12" Name="Magenta" Legend="Mag" Number="10" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:100" />
      <Palette ID="13" Name="Rose" Number="0" Page="1" SetControl="Red:1:100,Green:1:0,Blue:1:50" />
      <Palette ID="14" Name="Lavender" Legend="Lav" Number="8" Page="1" SetControl="Red:1:71,Green:1:43,Blue:1:94" />
      <Palette ID="15" Name="Ultra Violet" Legend="UV" Number="0" Page="1" SetControl="Red:1:20,Green:1:0,Blue:1:100" />
    </Group>
  </Palettes>
</Fixture>
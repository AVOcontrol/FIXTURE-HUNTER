      <Attribute ID="Red" ChannelOffset="6" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="7" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="8" Wheel="12" />
      <Attribute ID="White" ChannelOffset="9" Wheel="40" />
      <Attribute ID="Zoom" ChannelOffset="10" Wheel="19" />
      <Attribute ID="Colour_Macro" ChannelOffset="11" Wheel="7" />
      <Attribute ID="Auto" ChannelOffset="12" Wheel="22" />
      <Attribute ID="Auto_Spd" ChannelOffset="13" Wheel="23" />
      <Attribute ID="Control" ChannelOffset="14" Wheel="28" />
    </Include>
  </Mode>

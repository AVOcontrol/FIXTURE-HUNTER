<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Bar Strobo IP" ShortName="BarStrbIP" Company="Miner Light" Version="22">
  <Copyright Notice="© Avolites Ltd. 2025" />
  <Thumbnail>9195e436-7928-40ce-925f-920164ee0d47</Thumbnail>
  <History Date="23-11-21" Author="Nic Morris" Comment="Created (charts are confusing lacking a lot of detail.  it is not clear what all the various controls relate to. no pixel layout.  made best guess)" Version="0" />
  <History Date="07-01-22" Author="Nic Morris" Comment="Added 68 and 117 channel modes in line with latest charts in response to manufacturer request (requested 48 and 117 - assumed 48 is mistake)." Version="4" />
  <History Date="11-01-22" Author="Nic Morris" Comment="Added Atlabase ID's." Version="5" />
  <History Date="19-08-24" Author="Nic Morris" Comment="Updated in line with latest charts (adds mode 11, adds mode number prefix to existing, revises implementation of 7, 15, 21 and 39 channel modes, adds colour functions, revises RGB Macro, White Macro and Macro Spd function ranges and adds pixel layout)" Version="6" />
  <History Date="06-09-24" Author="Nic Morris" Comment="Updated in line with latest charts (adds mode 12)" Version="8" />
  <History Date="07-09-24" Author="Nic Morris" Comment="Added Atlabase ID for mode 12." Version="9" />
  <History Date="10-09-24" Author="Nic Morris" Comment="Changed duration and rate to default at 255 in response to manufacturer request." Version="10" />
  <History Date="26-09-24" Author="Nic Morris" Comment="Revised rate 0 from Open to Closed (labelled 'Blackout' in charts)" Version="11" />
  <History Date="29-01-25" Author="Nic Morris" Comment="Created from ACME PIXEL LINE IP (STROBE 3 IP) (identical except frost is reserved)" Version="12" />
  <History Date="05-02-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="13" />
  <History Date="13-06-25" Author="Nic Morris" Comment="Created from Pro Lux Lux Strobe Bar IP" Version="14" />
  <History Date="15-06-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="15" />
  <History Date="11-08-25" Author="Nic Morris" Comment="Added vdim to 15 DMX RGB element and changed name from Strobe Bar Aqua to PIKE in response to manufacturer request." Version="16" />
  <History Date="01-09-25" Author="Nic Morris" Comment="Created from LightSky PIKE (effectively identical.  no pixel layout.  assumed the same for now)" Version="17" />
  <History Date="02-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="18" />
  <History Date="21-09-25" Author="Nic Morris" Comment="Created from Osten Lyra Frost Line IP (no pixel layout.  assumed the same for now)" Version="19" />
  <History Date="23-09-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="20" />
  <History Date="30-09-25" Author="Nic Morris" Comment="Created from Nouvoled Ara Pixel Bar IP (hopeless documentation.  mostly nonsense.  117 channel mode is missing all of the channel numbers.  identical.  no pixel layout)" Version="21" />
  <History Date="02-10-25" Author="Nic Morris" Comment="Added Atlabase ID's." Version="22" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="77f07711-6d12-4d40-8295-aa91f4d62278" />

    <Attribute ID="Colour_Mode" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="RGB+CCT" Display="'RGB+CCT'" Dmx="0~0" Update="Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="2" Name="HSI+CCT" Display="'HSI+CCT'" Dmx="10~19" Update="Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="3" Name="XY Coordinates" Display="'XY Coordinates'" Dmx="20~29" Update="Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="4" Name="RAW RGBACL" Display="'RAW RGBACL'" Dmx="30~39" Update="Colour_Param_4, Colour_Param_5" Colour="255,255,255" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour_Param_4, Colour_Param_5" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour_Param_4" Name="Colour Param 4" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="HSI+CCT" ID="2" If="'Colour_Mode'==2" />
      <Condition Name="XY Coordinates" ID="3" If="'Colour_Mode'==3" />
      <Condition Name="RAW RGBACL" ID="4" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="2" Name="Hue" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="3" Name="x coordinate" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="0,0,0" />
      <Function ID="4" Name="Amber C-Mix" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" Colour="255,100,0" />
    </Attribute>
    <Attribute ID="Colour_Param_5" Name="Colour Param 5" Description="" Group="C" Size="2">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Else ID="1" />
      <Condition Name="HSI+CCT" ID="2" If="'Colour_Mode'==2" />
      <Condition Name="XY Coordinates" ID="3" If="'Colour_Mode'==3" />
      <Condition Name="RAW RGBACL" ID="4" If="'Colour_Mode'==4" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~65535" Dmx="0~65535" Colour="0,0,0" />

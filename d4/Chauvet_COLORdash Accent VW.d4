  <History Date="21-04-09" Author="David Hunt" Comment="Created" Version="1" />
  <History Date="22-04-09" Author="Jonathan Moreton" Comment="Checked" Version="2" />
  <History Date="27-09-10" Author="John Rogers" Comment="Added Virtual Dimmer to CW mode." Version="3" />
  <History Date="04-05-11" Author="Nic Morris" Comment="Fixed power on and locate.  Changed dimmer to 8bit.  Changed c-mix locate to 100%." Version="4" />
  <History Date="04-05-11" Author="Nic Morris" Comment="Adapted from COLORado 1 VW" Version="5" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" Version="6" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Added missing Atlabase ID's." Version="7" />
  <History Date="21-08-16" Author="Nic Morris" Comment="Revised attribute ID's for CTO and CTB to WarmWhite and ColdWhite respectively." Version="8" />
  <History Date="30-09-24" Author="Nic Morris" Comment="Added product image.  Changed CTO and CTB attribute names to Warm White and Cool White and updated mode names in line with latest documentation." Version="9" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="f406de4d-c0ac-4736-906d-9fd717ed1570" />
  <Control>
    <Attribute ID="WarmWhite" Name="Warm White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="ColdWhite" Name="Cool White" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="230,230,255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
    <Attribute ID="White_Macro" Name="White Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="2" Name="White1: 3200K" Display="'White1: 3200K'" Dmx="11~50" Colour="0,0,0" />
      <Function ID="3" Name="White2: 3400K" Display="'White2: 3400K'" Dmx="51~80" Colour="0,0,0" />
      <Function ID="4" Name="White3: 4200K" Display="'White3: 4200K'" Dmx="81~110" Colour="0,0,0" />
      <Function ID="5" Name="White4: 4900K" Display="'White4: 4900K'" Dmx="111~140" Colour="0,0,0" />
      <Function ID="6" Name="White5: 5600K" Display="'White5: 5600K'" Dmx="141~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Intensity="0~0" />
    </Attribute>
  </Control>
  <Mode Name="S1.DS, 5 DMX" Channels="5" Id="8d3dec54-8b89-429f-8828-ae052c14992e">
    <Import PearlRef="CH_CDAVWD" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="e56617b9-f9e7-4a9b-887a-15f94d2ef920" />
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="WarmWhite" ChannelOffset="2" Wheel="10" />
      <Attribute ID="ColdWhite" ChannelOffset="3" Wheel="11" />
      <Attribute ID="White_Macro" ChannelOffset="4" Wheel="7" />
      <Attribute ID="Shutter" ChannelOffset="5" Wheel="4" />
    </Include>
  </Mode>

  <Control>
    <Attribute ID="Pan" Name="Pan" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Pan" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Tilt" Name="Tilt" Description="" Group="P" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Tilt" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="PT_Speed" Name="P/T Speed" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fast" Display="'Fast'" Dmx="0~0" />
      <Function ID="2" Name="Standard" Display="'Standard'" Dmx="10~25" />
      <Function ID="3" Name="Vector" Display="'Vector %.f%%',0~100" Dmx="127~26" />
      <Function ID="4" Name="Reaction" Display="'Reaction %.1f%%',0.0~100.0" Dmx="247~128" />
      <Function ID="5" Name="Silent" Display="'Silent'" Dmx="248~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="2" PowerOn="2" />
      <Function ID="1" Name="Closed" Display="'Closed'" Dmx="0~0" />
      <Function ID="2" Name="Open" Display="'Open'" Dmx="255~255" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="30~119" />
      <Function ID="4" Name="Rnd Strobe" Display="'Rnd Strobe %.f%%',0~100" Dmx="180~189" />
      <Function ID="5" Name="Open Pulse" Display="'Open Pulse %.f%%',0~100" Dmx="120~149" />
      <Function ID="6" Name="Close Pulse" Display="'Close Pulse %.f%%',0~100" Dmx="150~179" />
      <Function ID="7" Name="Gobo/Col in Dark" Display="'Gobo/Col in Dark'" Dmx="200~209" />
      <Function ID="8" Name="Move in Dark" Display="'Move in Dark'" Dmx="210~219" />
      <Function ID="9" Name="Blades in Dark" Display="'Blades in Dark'" Dmx="220~222" />
      <Function ID="10" Name="Frost/ Prism in Dark" Display="'Frost/ Prism in Dark'" Dmx="223~224" />
      <Function ID="11" Name="Zoom in Dark" Display="'Zoom in Dark'" Dmx="225~226" />
      <Function ID="12" Name="All in Dark" Display="'All in Dark'" Dmx="227~229" />
    </Attribute>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Fixed" ID="1,2,3,4,5,6,7" If="'Colour1Func'==1" />
      <Condition Name="Split" ID="8,9,10,11,12,13,14,15" If="'Colour1Func'==2" />
      <Condition Name="Index" ID="16,17" If="'Colour1Func'==3" />
      <Condition Name="Scroll" ID="18,19,20,21" If="'Colour1Func'==4" />
      <Else ID="22" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="2" Name="Deep Red" Display="'Deep Red'" Dmx="10~49" WheelPosition="2" Colour="180,0,0" />
      <Function ID="3" Name="Deep Blue" Display="'Deep Blue'" Dmx="50~89" WheelPosition="3" Colour="0,0,180" />
      <Function ID="4" Name="Deep Green" Display="'Deep Green'" Dmx="90~129" WheelPosition="4" Colour="0,180,0" />
      <Function ID="5" Name="Amber" Display="'Amber'" Dmx="130~169" WheelPosition="5" Colour="255,100,0" />
      <Function ID="6" Name="Amethyst" Display="'Amethyst'" Dmx="170~209" WheelPosition="6" Colour="180,0,255" />
      <Function ID="7" Name="Higher (CRI&gt;90)" Display="'Higher (CRI&gt;90)'" Dmx="210~255" WheelPosition="7" Colour="230,230,255" />
      <Function ID="8" Name="Open" Display="'Open'" Dmx="0~0" WheelPosition="0" Colour="255,255,255" />
      <Function ID="9" Name="Op/ D Rd" Display="'Op/ D Rd'" Dmx="10~44" WheelPosition="1" Colour="255,255,255" />
      <Function ID="10" Name="D Rd/ D Blu" Display="'D Rd/ D Blu'" Dmx="45~79" WheelPosition="2" Colour="180,0,0" />
      <Function ID="11" Name="D Blu/ D Grn" Display="'D Blu/ D Grn'" Dmx="80~114" WheelPosition="3" Colour="0,0,180" />
      <Function ID="12" Name="D Grn/ Amb" Display="'D Grn/ Amb'" Dmx="115~149" WheelPosition="4" Colour="0,180,0" />
      <Function ID="13" Name="Amb/ Amthst" Display="'Amb/ Amthst'" Dmx="150~184" WheelPosition="5" Colour="255,100,0" />
      <Function ID="14" Name="Amthst/ Higher" Display="'Amthst/ Higher'" Dmx="185~219" WheelPosition="6" Colour="180,0,255" />
      <Function ID="15" Name="Higher/ Op" Display="'Higher/ Op'" Dmx="220~255" WheelPosition="7" Colour="230,230,255" />
      <Function ID="16" Name="Open" Display="'Open'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="17" Name="Index" Display="'Index %.1f%%',0.0~100.0" Dmx="10~255" Colour="0,0,0" />
      <Function ID="18" Name="No Scroll" Display="'No Scroll'" Dmx="0~0" Colour="0,0,0" />
      <Function ID="19" Name="Scroll CW" Display="'Scroll CW %.1f%%',100.0~0.0" Dmx="10~127" Colour="0,0,0" />
      <Function ID="20" Name="No Scroll" Display="'No Scroll'" Dmx="128~137" Colour="0,0,0" />
      <Function ID="21" Name="Scroll CCW" Display="'Scroll CCW %.1f%%',0.0~100.0" Dmx="138~255" Colour="0,0,0" />
      <Function ID="22" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Colour1Func" Name="Colour Mode" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Fixed" Display="'Fixed'" Dmx="0~0" Update="Colour1" Colour="0,0,0" />
      <Function ID="2" Name="Split Gel" Display="'Split Gel'" Dmx="64~127" Update="Colour1" Colour="0,0,0" />
      <Function ID="3" Name="Index" Display="'Index'" Dmx="128~191" Update="Colour1" Colour="0,0,0" />
      <Function ID="4" Name="Scroll" Display="'Scroll'" Dmx="192~255" Update="Colour1" Colour="0,0,0" />
      <Function ID="5" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Update="Colour1" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Cyan" Name="Cyan" Description="" Group="C">

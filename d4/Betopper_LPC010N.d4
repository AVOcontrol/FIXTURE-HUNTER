    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="White" Name="White" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="White C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Strobe %" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Effect" Name="Effect" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Effect" Display="'No Effect'" Dmx="0~0" />
      <Function ID="2" Name="High CRI Cols" Display="'High CRI Cols %.f%%',0~100" Dmx="11~50" />
      <Function ID="3" Name="Col Output" Display="'Col Output'" Dmx="51~100" />
      <Function ID="4" Name="Jump Change" Display="'Jump Change'" Dmx="101~150" />
      <Function ID="5" Name="Col Fade" Display="'Col Fade'" Dmx="151~200" />
      <Function ID="6" Name="Pulse Transform" Display="'Pulse Transform'" Dmx="201~250" />
      <Function ID="7" Name="Sound" Display="'Sound'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Dim Linear" Display="'Dim Linear'" Dmx="11~20" />
      <Function ID="3" Name="Dim Square" Display="'Dim Square'" Dmx="21~30" />
      <Function ID="4" Name="Dim Inv Square" Display="'Dim Inv Square'" Dmx="31~40" />
      <Function ID="5" Name="Dim S-Curve" Display="'Dim S-Curve'" Dmx="41~50" />
      <Function ID="6" Name="Fan Auto" Display="'Fan Auto'" Dmx="51~60" />
      <Function ID="7" Name="Fan Studio" Display="'Fan Studio'" Dmx="61~70" />
      <Function ID="8" Name="Effect Speed" Display="'Effect Speed %.1f%%',0.0~100.0" Dmx="81~255" />
    </Attribute>
  </Control>

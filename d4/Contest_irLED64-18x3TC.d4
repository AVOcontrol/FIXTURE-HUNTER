  <Thumbnail>2fe1e2ae-83b1-4bd3-a1c3-fdfcd9963dd5</Thumbnail>
  <History Date="17-12-17" Author="Nic Morris" Comment="Created" />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="b444d14c-21d1-42b9-89d3-b245066a1c4b" />
  <Control>
    <Attribute ID="Colour_Macro" Name="Colour Macro" Description="" Group="C">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" Update="Shutter" Colour="255,255,255" />
      <Function ID="2" Name="Red" Display="'Red'" Dmx="16~30" Update="Shutter" Colour="255,0,0" />
      <Function ID="3" Name="Orange" Display="'Orange'" Dmx="31~45" Update="Shutter" Colour="255,128,0" />
      <Function ID="4" Name="Yellow" Display="'Yellow'" Dmx="46~60" Update="Shutter" Colour="255,255,0" />
      <Function ID="5" Name="Green" Display="'Green'" Dmx="61~75" Update="Shutter" Colour="0,255,0" />
      <Function ID="6" Name="Cyan" Display="'Cyan'" Dmx="76~90" Update="Shutter" Colour="0,255,255" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="91~105" Update="Shutter" Colour="0,0,255" />
      <Function ID="8" Name="Rose" Display="'Rose'" Dmx="106~120" Update="Shutter" Colour="255,0,127" />
      <Function ID="9" Name="Magenta" Display="'Magenta'" Dmx="121~135" Update="Shutter" Colour="255,0,255" />
      <Function ID="10" Name="Cold White (6000K)" Display="'Cold White (6000K)'" Dmx="136~150" Update="Shutter" Colour="230,230,255" />
      <Function ID="11" Name="Warm White (3000K)" Display="'Warm White (3000K)'" Dmx="151~165" Update="Shutter" Colour="255,240,200" />
      <Function ID="12" Name="Macro 1" Display="'Macro 1'" Dmx="166~180" Update="Shutter" Colour="0,0,0" />
      <Function ID="13" Name="Macro 2" Display="'Macro 2'" Dmx="181~195" Update="Shutter" Colour="0,0,0" />
      <Function ID="14" Name="Macro 3" Display="'Macro 3'" Dmx="196~210" Update="Shutter" Colour="0,0,0" />
      <Function ID="15" Name="Macro 4" Display="'Macro 4'" Dmx="211~225" Update="Shutter" Colour="0,0,0" />
      <Function ID="16" Name="Macro 5" Display="'Macro 5'" Dmx="226~240" Update="Shutter" Colour="0,0,0" />
      <Function ID="17" Name="Sound" Display="'Sound'" Dmx="241~255" Update="Shutter" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Shutter" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Condition Name="Speed" ID="3" If="'Colour_Macro'&gt;11&amp;&amp;'Colour_Macro'&lt;17" />
      <Condition Name="Sensitivity" ID="4" If="'Colour_Macro'==17" />
      <Else ID="1,2" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="16~255" />
      <Function ID="3" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="4" Name="Sensitivity" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Condition Name="4 DMX" ID="2,3,4" If="'Dummy'==1" />
      <Else ID="1" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer %.1f%%',0.0~100.0" Dmx="0~189" />
      <Function ID="3" Name="Strobe %" Display="'Strobe %.f%%',0~100" Dmx="190~250" />
      <Function ID="4" Name="Open" Display="'Open'" Dmx="251~255" />
    </Attribute>
    <Attribute ID="Red" Name="Red" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Red C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="255,0,0" />
    </Attribute>
    <Attribute ID="Green" Name="Green" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:100" Lowlight="1:0" />
      <Function ID="1" Name="Green C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,255,0" />
    </Attribute>
    <Attribute ID="Blue" Name="Blue" Description="" Group="C">
      <Locate Locate="1:100" PowerOn="1:100" Highlight="1:0" Lowlight="1:90" />
      <Function ID="1" Name="Blue C-Mix" Display="'%.1f%%',0.0~100.0" Dmx="0~255" Colour="0,0,255" />
    </Attribute>
    <Attribute ID="Shutter1" Name="Shutter" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Open" Display="'Open'" Dmx="0~0" />
      <Function ID="2" Name="Strobe %" Display="'Strobe %.1f%%',0.0~100.0" Dmx="1~255" />
    </Attribute>
    <Attribute ID="Dummy" Name="Dummy" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Dummy" Display="''" Dmx="0~0" Update="Dimmer" />
    </Attribute>
  </Control>
  <Mode Name="2 DMX" Channels="2">
    <Import PearlRef="COIR1832" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="a79a525b-8298-4b38-a3ef-92782e66bce7" />
    <Include>
      <Attribute ID="Colour_Macro" ChannelOffset="1" Wheel="9" />
      <Attribute ID="Dimmer" ChannelOffset="2" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="3 DMX" Channels="3">
    <Import PearlRef="COIR1833" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="75bee3b5-d90f-4b1e-97d2-ed9b64f12559" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" VirtualControl="Dimmer" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" VirtualControl="Dimmer" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" VirtualControl="Dimmer" />
      <Attribute ID="Dimmer" Wheel="1" />
    </Include>
  </Mode>

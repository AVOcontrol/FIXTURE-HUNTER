    </Physical>
    <AtlaBase ModeID="ee8fed3f-98fe-495b-8f45-a3388ac692ad" />
    <Include>
      <Attribute ID="Red" ChannelOffset="1" Wheel="10" />
      <Attribute ID="Green" ChannelOffset="2" Wheel="11" />
      <Attribute ID="Blue" ChannelOffset="3" Wheel="12" />
      <Attribute ID="Dimmer" ChannelOffset="4" Wheel="1" />
      <Attribute ID="Shutter1" ChannelOffset="5" Wheel="4" />
    </Include>
  </Mode>
  <Mode Name="6 DMX" Channels="6">
    <Import PearlRef="COIR1836" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="0a7d09ff-d886-4a4a-935e-31e704874747" />
    <Include>

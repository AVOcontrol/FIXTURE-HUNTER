<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="KOSMOS Bicolor" ShortName="KOSMOS BiC" Company="VELVETLight" Version="1">
  <Copyright Notice="© Avolites Ltd. 2020" />
  <History Date="03-08-20" Author="Nic Morris" Comment="Created" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="CCT" Name="CCT" Description="" Group="C" Size="2">
      <Locate Locate="1:2500" PowerOn="1:2500" />
      <Function ID="1" Name="CTO C-Mix" Display="'%.1fK',2500.0~10000.0" Dmx="0~65535" Colour="255,240,200" />
    </Attribute>
    <Attribute ID="Green/Magenta" Name="Green/Magenta" Description="" Group="C" Size="2">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Neutral" Display="'Neutral'" Dmx="0~0" Colour="255,255,255" />
      <Function ID="2" Name="+Magenta" Display="'+Magenta %.2f%%',100.00~1.00" Dmx="257~31097" Colour="255,255,255" />
      <Function ID="3" Name="Neutral" Display="'Neutral'" Dmx="31354~33924" Colour="255,255,255" />
      <Function ID="4" Name="+Green" Display="'+Green %.2f%%',1.00~100.00" Dmx="34181~65535" Colour="255,255,255" />
    </Attribute>
    <Attribute ID="Zoom" Name="Zoom" Description="" Group="B" Size="2">
      <Locate Locate="1:50" PowerOn="1:50" />
      <Function ID="1" Name="Zoom" Display="'%.2f%%',0.00~100.00" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="Fan" Name="Fan" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Silence" Display="'Silence'" Dmx="0~0" />
      <Function ID="2" Name="Dynamic" Display="'Dynamic'" Dmx="10~19" />
      <Function ID="3" Name="Idle" Display="'Idle'" Dmx="20~29" />
      <Function ID="4" Name="70%" Display="'70%'" Dmx="30~39" />
      <Function ID="5" Name="Full Speed" Display="'Full Speed'" Dmx="40~49" />
    </Attribute>
  </Control>
  <Mode Name="CCT (8bit), 5 DMX" Channels="5">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="2" Wheel="37" />
      <Attribute ID="Green/Magenta" ChannelOffset="3" Wheel="38" />
      <Attribute ID="Zoom" ChannelOffset="4" Wheel="19" />
      <Attribute ID="Fan" ChannelOffset="5" Wheel="25" />
    </Include>
  </Mode>
  <Mode Name="CCT (16bit), 9 DMX" Channels="9">
    <Import PearlRef="" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <Include>
      <Attribute ID="Dimmer" ChannelOffset="1,2" Wheel="1" />
      <Attribute ID="CCT" ChannelOffset="3,4" Wheel="37" />
      <Attribute ID="Green/Magenta" ChannelOffset="5,6" Wheel="38" />
      <Attribute ID="Zoom" ChannelOffset="7,8" Wheel="19" />
      <Attribute ID="Fan" ChannelOffset="9" Wheel="25" />
    </Include>
  </Mode>
  <Palettes>
    <Group Name="Beam">
      <Palette ID="1" Name="Zoom Small" Number="41" Page="1" SetControl="Zoom:1:0" />
      <Palette ID="2" Name="Zoom Medium" Legend="Zoom Med" Number="42" Page="1" SetControl="Zoom:1:50" />
      <Palette ID="3" Name="Zoom Large" Number="43" Page="1" SetControl="Zoom:1:100" />
    </Group>
  </Palettes>
</Fixture>
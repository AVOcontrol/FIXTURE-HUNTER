<?xml version="1.0" encoding="utf-8"?>
<Fixture Name="Plus" ShortName="Plus" Company="Chroma-Q">
  <Copyright Notice="© Avolites Ltd. 2017" />
  <History Date="11-12-08" Author="David Hunt" Comment="Created" />
  <History Date="11-12-08" Author="Jonathan Moreton" Comment="Checked" />
  <History Date="28-01-09" Author="D4 Personality Fixer 2009" Comment="Changed manufacturer from Chroma-Q to Chroma Q" />
  <History Date="19-04-12" Author="Locate Fix" Comment="Updated locate, power on, highlight and lowlight values to valid values" />
  <History Date="25-05-16" Author="AtlaBaseLibraryUpdater" Comment="Added AltaBase information" />
  <History Date="13-10-17" Author="Nic Morris" Comment="Changed manufacturer name from Chroma Q to Chroma-Q.  Removed manufacturer shortcode from display name." />
  <History Date="13-10-17" Author="Nic Morris" Comment="Added pending dimmer to all modes.  Removed palettes (all colours were the same value)." />
  <Manual Filename="" Summary="" />
  <AtlaBase TypeID="726b63bb-313b-456b-b938-c9fec4bbcf83" />
  <Control>
    <Attribute ID="Colour1" Name="Colour" Description="" Group="C">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" Colour="0,0,0" />
    </Attribute>
    <Attribute ID="Fan_Speed" Name="Fan Speed" Description="" Group="S">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Speed" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Control" Name="Control" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'Safe'" Dmx="0~0" />
      <Function ID="2" Name="Fan Off" Display="'Fan Off'" Dmx="15~39" />
      <Function ID="3" Name="Fan Speed" Display="'Fan Speed %.1f%%',0.0~100.0" Dmx="40~141" />
      <Function ID="4" Name="Gel Saver Off" Display="'Gel Saver Off'" Dmx="142~167" />
      <Function ID="5" Name="Gel Saver On" Display="'Gel Saver On'" Dmx="168~193" />
      <Function ID="6" Name="Motor Speed Normal" Display="'Motor Speed   Normal'" Dmx="194~218" />
      <Function ID="7" Name="Motor Speed Fast" Display="'Motor Speed   Fast'" Dmx="219~244" />
      <Function ID="8" Name="Reset" Display="'Reset'" Dmx="245~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Dimmer" Description="" Group="I">
      <Locate Locate="1:100" PowerOn="1:0" />
      <Function ID="1" Name="Dimmer" Display="'%.1f%%',0.0~100.0" Dmx="0~255" />
    </Attribute>
  </Control>
  <Mode Name="Mode 1, 1 DMX" Channels="1">
    <Import PearlRef="CQ_PlsM1" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="175484bf-eabc-4d60-b5e5-533feee659d7" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Dimmer" ChannelOffset="0" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode 2, 2 DMX" Channels="2">
    <Import PearlRef="CQ_PlsM2" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="6134e4f9-8fbb-4197-b3a3-dd1f06a8d04a" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Fan_Speed" ChannelOffset="2" Wheel="25" />
      <Attribute ID="Dimmer" ChannelOffset="0" Wheel="1" />
    </Include>
  </Mode>
  <Mode Name="Mode 3, 2 DMX" Channels="2">
    <Import PearlRef="CQ_PlsM3" DiamondRef="" WysiwygRef="" />
    <Physical>
      <Bulb Type="" Lumens="" ColourTemp="" />
      <Lens Name="" Degrees="" />
      <Weight Kg="" />
      <Size Height="" Width="" Depth="" />
      <Focus Type="Fixed" PanMax="0" TiltMax="0" PanMaxSpeed="0" TiltMaxSpeed="0" />
    </Physical>
    <AtlaBase ModeID="da70ee1a-8fde-450a-ada3-a9dfbf133586" />
    <Include>
      <Attribute ID="Colour1" ChannelOffset="1" Wheel="7" />
      <Attribute ID="Control" ChannelOffset="2" Wheel="28" />
      <Attribute ID="Dimmer" ChannelOffset="0" Wheel="1" />
    </Include>
  </Mode>
  <Macro>
    <Macro Name="Reset">
      <Set Channel="Control:8" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Fan Off">
      <Set Channel="Control:2" Delay="0" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gel Saver Off">
      <Set Channel="Control:4" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Gel Saver On">
      <Set Channel="Control:5" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Motor Speed Normal">
      <Set Channel="Control:6" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
    <Macro Name="Motor Speed Fast">
      <Set Channel="Control:7" Delay="5000" />
      <Set Channel="Control:1" Delay="0" />
    </Macro>
  </Macro>
</Fixture>
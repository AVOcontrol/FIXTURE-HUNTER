      <Attribute ID="Blue" ChannelOffset="4" Wheel="12" />
    </Include>
  </Mode>
  <Mode Name="ARC2, 4 DMX" Channels="4">
    <Import PearlRef="SH_S2500ZA2" DiamondRef="" WysiwygRef="" />

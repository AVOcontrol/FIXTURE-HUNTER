  <History Date="23-04-22" Author="Nic Morris" Comment="(note ignition needs to be at 100% to fire)" Version="0" />
  <Manual Filename="" Summary="" />
  <Control>
    <Attribute ID="Angle" Name="Angle" Description="" Group="I">
      <Locate Locate="3" PowerOn="3" />
      <Function ID="1" Name="Angle -/+" Display="'Angle -/+ %.1f°',-105.0~105.0" Dmx="0~255" />
      <Function ID="2" Name="Angle -" Display="'Angle - %.1f°',105.0~0.0" Dmx="0~128" />
      <Function ID="3" Name="0°" Display="'0°'" Dmx="128~128" />
      <Function ID="4" Name="Angle +" Display="'Angle + %.1f°',0.0~105.0" Dmx="128~255" />
      <Function ID="5" Name="-105°" Display="'-105°'" Dmx="0~0" />
      <Function ID="6" Name="-90°" Display="'-90°'" Dmx="18~18" />
      <Function ID="7" Name="-75°" Display="'-75°'" Dmx="36~36" />
      <Function ID="8" Name="-60°" Display="'-60°'" Dmx="54~54" />
      <Function ID="9" Name="-45°" Display="'-45°'" Dmx="73~73" />
      <Function ID="10" Name="-40°" Display="'-40°'" Dmx="91~91" />
      <Function ID="11" Name="-15°" Display="'-15°'" Dmx="109~109" />
      <Function ID="12" Name="0°" Display="'0°'" Dmx="128~128" />
      <Function ID="13" Name="15°" Display="'15°'" Dmx="146~146" />
      <Function ID="14" Name="30°" Display="'30°'" Dmx="165~165" />
      <Function ID="15" Name="45°" Display="'45°'" Dmx="183~183" />
      <Function ID="16" Name="60°" Display="'60°'" Dmx="201~201" />
      <Function ID="17" Name="75°" Display="'75°'" Dmx="219~219" />
      <Function ID="18" Name="90°" Display="'90°'" Dmx="237~237" />
      <Function ID="19" Name="105°" Display="'105°'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Speed" Name="Speed" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Full Speed" Display="'Full Speed'" Dmx="0~0" />
      <Function ID="2" Name="Speed" Display="'Speed %.1f%%',0.0~100.0" Dmx="1~254" />
      <Function ID="3" Name="Full Speed" Display="'Full Speed'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Dimmer" Name="Ignition" Description="" Group="I">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Ignition" Display="'%.f%%',0~100" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Opening_Time" Name="Opening Time" Description="" Group="I">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Continuous" Display="'Continuous'" Dmx="0~0" />
      <Function ID="2" Name="Time" Display="'Time %.fms',10~2540" Dmx="1~254" />
      <Function ID="3" Name="Continuous" Display="'Continuous'" Dmx="255~255" />
    </Attribute>
    <Attribute ID="Program" Name="Program" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="No Sequence" Display="'No Sequence'" Dmx="0~0" />
      <Function ID="2" Name="Sequence" Display="'Sequence %.1f%%',0.0~100.0" Dmx="3~255" />
      <Function ID="3" Name="Raw DMX" Display="'Raw DMX %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="Mode" Name="Mode" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Test" Display="'Test'" Dmx="0~0" />
      <Function ID="2" Name="Armed" Display="'Armed'" Dmx="50~200" />
      <Function ID="3" Name="Test" Display="'Test'" Dmx="255~255" />
    </Attribute>
  </Control>
